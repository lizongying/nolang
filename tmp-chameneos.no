// chameneos-redux.no — 多色生物相遇模擬 (Nolang, 依規範實作)
// 順序模擬版本：模擬生物在噴泉相遇並交換顏色的過程。
// 每次相遇消耗一個 meeting quota，總相遇數 = n。
// Nolang 無 pthread，改為順序模擬相遇過程。

BLUE i64 = 0
RED i64 = 1
YELLOW i64 = 2

; complement: 兩色相遇的結果色（三原色體系）
meet = (a i64, b i64) (r i64) {
    {
        a == b -> r = a
        -> r = 3 - a - b
    }
}

n-val ?i64 = arg(1).to-i64()
n i64 = 1000
n-val: {
    ok -> n = it
    err -> n = 1000
    nil -> n = 1000
}

; 3 個生物的顏色
c0 i64 = BLUE
c1 i64 = RED
c2 i64 = YELLOW

; 順序模擬：輪流讓生物相遇
total i64 = 0
i <- [0..n): {
    ; 偶數步：c0 與 c1 相遇
    i % 2 == 0 -> {
        nc = meet(c0, c1)
        c0 = nc
    }
    -> {
        ; 奇數步：c1 與 c2 相遇
        nc = meet(c1, c2)
        c1 = nc
    }
    total = total + 1
}

print(total.to-str())
