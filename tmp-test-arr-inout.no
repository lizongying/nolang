; 測試: 用 in-out 參數代替返回值
helper = (out [32]byte) {
    i <- [0..32): {
        out[i] = i + 1
    }
}

caller = () {
    t-tmp [32]byte
    helper(t-tmp)
    print('t-tmp[0]=' - t-tmp[0].to-str())
    print('t-tmp[31]=' - t-tmp[31].to-str())
}

main = () {
    print('before')
    caller()
    print('after')
    print('done')
}
