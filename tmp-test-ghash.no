; 直接測試 ghash-mul 和 ghash
; 使用 GCM Test Case 2 的值驗證
; Test Case 2:
;   K = 00000000000000000000000000000000
;   IV = 000000000000000000000000
;   P = 00000000000000000000000000000000
;   C = 0388dace60b6a392f328c2b971b2fe78
;   T = ab6e47d42cec13bdf53a67b21257bddf
;
; H = AES(K, 0^128) = AES(0, 0) = 66e94bd4ef8a2c3b884cfa59ca342b2e
; J0 = IV || 0x00000001 = 00000000000000000000000000000001
; AES(J0) = ?
; GHASH(H, "", C) = ?
; T = AES(J0) XOR GHASH

main = () {
    ; 計算 H = AES(0, 0)
    key [16]byte
    i <- [0..16): {
        key[i] = 0
    }
    zero [16]byte
    i <- [0..16): {
        zero[i] = 0
    }
    h [16]byte
    h = aes.aes-128-enc(zero, key)
    print('H = AES(0, 0):')
    i <- [0..16): {
        printf((h[i] & 255).to-str() - ' ')
    }
    print('')

    ; 期望: 102 233 75 212 239 138 44 59 136 76 250 89 202 52 43 46

    ; 計算 AES(J0) where J0 = 0^96 || 0x00000001
    j0 [16]byte
    i <- [0..16): {
        j0[i] = 0
    }
    j0[15] = 1
    j0-enc [16]byte
    j0-enc = aes.aes-128-enc(j0, key)
    print('AES(J0):')
    i <- [0..16): {
        printf((j0-enc[i] & 255).to-str() - ' ')
    }
    print('')

    ; 期望: 58e2fccefa7e3061367f1d57a4e7455a = 88 226 252 206 250 126 48 97 54 127 29 87 164 231 69 90

    ; 計算 GHASH(H, "", C)
    ; C = 0388dace60b6a392f328c2b971b2fe78
    cipher []byte = with-len(16)
    c-vals = [
        3, 136, 218, 206, 96, 182, 163, 146,
        243, 40, 194, 185, 113, 178, 254, 120,
    ]
    i <- [0..16): {
        cipher[i] = c-vals[i]
    }
    aad []byte = with-len(0)

    ghash-out [16]byte
    ghash-out = aes-gcm.ghash(h, aad, cipher)
    print('GHASH(H, "", C):')
    i <- [0..16): {
        printf((ghash-out[i] & 255).to-str() - ' ')
    }
    print('')

    ; 計算 T = AES(J0) XOR GHASH
    print('T = AES(J0) XOR GHASH:')
    i <- [0..16): {
        t = (j0-enc[i] & 255) ^ (ghash-out[i] & 255)
        printf(t.to-str() - ' ')
    }
    print('')

    ; 期望: 171 110 71 212 44 236 19 189 245 58 103 178 18 87 189 223
    ; = ab6e47d42cec13bdf53a67b21257bddf

    ; 直接測試 ghash-mul: X * H where X = C
    print('')
    print('=== ghash-mul test ===')
    x [16]byte
    i <- [0..16): {
        x[i] = c-vals[i]
    }
    result [16]byte
    result = aes-gcm.ghash-mul(x, h)
    print('X * H:')
    i <- [0..16): {
        printf((result[i] & 255).to-str() - ' ')
    }
    print('')

    ; 測試 ghash-mul(0, H) 應為 0
    print('')
    print('=== ghash-mul(0, H) test ===')
    zero-x [16]byte
    i <- [0..16): {
        zero-x[i] = 0
    }
    result2 [16]byte
    result2 = aes-gcm.ghash-mul(zero-x, h)
    print('0 * H:')
    i <- [0..16): {
        printf((result2[i] & 255).to-str() - ' ')
    }
    print('')

    ; 期望: 全部為 0

    ; 測試 ghash-mul(H, H) — 用於驗證非零乘法
    print('')
    print('=== ghash-mul(H, H) test ===')
    result3 [16]byte
    result3 = aes-gcm.ghash-mul(h, h)
    print('H * H:')
    i <- [0..16): {
        printf((result3[i] & 255).to-str() - ' ')
    }
    print('')
}
