; Test fe-mul, fe-sq, fe-invert with simple values
main = () {
    ; Test 1: 2 * 3 = 6
    a []i64 = with-len(10)
    a[0] = 2
    b []i64 = with-len(10)
    b[0] = 3
    r []i64 = with-len(10)
    x25519.fe-mul(r, a, b)
    out [32]byte
    x25519.fe-tobytes(out, r)
    print('Test 1: 2 * 3 = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }

    ; Expected: 6, 0, 0, 0, 0, 0, 0, 0
    (out[0] & 255) == 6 -> print('PASS: 2*3=6')
    (out[0] & 255) != 6 -> print('FAIL: 2*3!=6')

    ; Test 2: 5^2 = 25
    c []i64 = with-len(10)
    c[0] = 5
    x25519.fe-sq(r, c)
    x25519.fe-tobytes(out, r)
    print('Test 2: 5^2 = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }
    (out[0] & 255) == 25 -> print('PASS: 5^2=25')
    (out[0] & 255) != 25 -> print('FAIL: 5^2!=25')

    ; Test 3: 7 * 11 = 77
    a[0] = 7
    b[0] = 11
    x25519.fe-mul(r, a, b)
    x25519.fe-tobytes(out, r)
    print('Test 3: 7 * 11 = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }
    (out[0] & 255) == 77 -> print('PASS: 7*11=77')
    (out[0] & 255) != 77 -> print('FAIL: 7*11!=77')

    ; Test 4: fe-invert(1) = 1
    a[0] = 1
    x25519.fe-invert(r, a)
    x25519.fe-tobytes(out, r)
    print('Test 4: invert(1) = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }
    (out[0] & 255) == 1 -> print('PASS: invert(1)=1')
    (out[0] & 255) != 1 -> print('FAIL: invert(1)!=1')

    ; Test 5: 2 * invert(2) = 1
    a[0] = 2
    x25519.fe-invert(r, a)

    ; r = 2^(-1)
    x25519.fe-mul(r, a, r)

    ; r = 2 * 2^(-1) = 1
    x25519.fe-tobytes(out, r)
    print('Test 5: 2 * invert(2) = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }
    (out[0] & 255) == 1 -> print('PASS: 2*invert(2)=1')
    (out[0] & 255) != 1 -> print('FAIL: 2*invert(2)!=1')

    ; Test 6: fe-mul with negative limb
    ; (10 - 3) * 5 = 35
    a[0] = 10
    b[0] = 3
    x25519.fe-sub(a, a, b); a = 10 - 3 = 7
    b[0] = 5
    x25519.fe-mul(r, a, b); r = 7 * 5 = 35
    x25519.fe-tobytes(out, r)
    print('Test 6: (10-3) * 5 = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }
    (out[0] & 255) == 35 -> print('PASS: (10-3)*5=35')
    (out[0] & 255) != 35 -> print('FAIL: (10-3)*5!=35')

    ; Test 7: Large multiplication
    ; 1000000 * 1000000 = 1000000000000 = 10^12
    a[0] = 1000000
    x25519.fe-sq(r, a)
    x25519.fe-tobytes(out, r)
    print('Test 7: 1000000^2 = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }

    ; 10^12 = 0xE8D4A51000
    ; little-endian: 0x00, 0x10, 0xA5, 0xD4, 0xE8, 0x00, ...
    (out[0] & 255) == 0 -> print('byte 0 ok')
    (out[1] & 255) == 16 -> print('byte 1 ok')
    (out[2] & 255) == 165 -> print('byte 2 ok')
    (out[3] & 255) == 212 -> print('byte 3 ok')
    (out[4] & 255) == 232 -> print('byte 4 ok')
}
