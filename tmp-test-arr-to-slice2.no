; 測試: [32]byte 返回值賦給 []byte 變數
helper = () (out [32]byte) {
    i <- [0..32): {
        out[i] = i + 1
    }
}

caller = () {
    ; 用 []byte 代替 [32]byte
    t-tmp []byte = with-len(32)
    t-tmp = helper()
    print('t-tmp[0]=' - t-tmp[0].to-str())
    print('t-tmp[31]=' - t-tmp[31].to-str())
}

main = () {
    print('before')
    caller()
    print('after')
    print('done')
}
