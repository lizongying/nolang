; from str-byte.no：str.byte / txt.byte 原始位元組存取（MIR 後端回归）
test-str-byte = () {
    s = 'ABC'
    print(s.byte(0))
    print(s.byte(1))
    print(s.byte(2))
    t txt = 'ABC'
    print(t.byte(0))
    print(t.byte(1))
    print(t.byte(2))
    u = 'Aé'
    print(u.byte(0))
    print(u.byte(1))
    print(u.byte(2))
}

; from str-clear.no：str.clear 後長度歸零
print-str-clear = () {
    s = 'hello world'
    print(s.len-bytes())
    s.clear()
    print(s.len-bytes())
    s = ''
    print(s.len-bytes())
}

; from str-concat.no：`-` 拼接五式
print-str-concat = () {
    print('Hello World')
    s = 'Nolang'
    print(s)
    greeting = 'Hello' - ' ' - 'World'
    print(greeting)
    a = 'foo'
    b = 'bar'
    c = a - b
    print(c)
    x = 'Hello'
    y = x - ' ' - 'Nolang'
    print(y)
}

; from str-concat-loop.no：迴圈內逐字節格式化
print-str-concat-loop = () {
    s = 'hello'
    n = s.len-bytes()
    i <- [0..n): {
        b = s[i]
        print('byte={b.to-str()}')
    }
}

; from str-cmp-loop.no：码点扫描分词
print-str-cmp-loop = () {
    s = '  hello'
    n = s.len-bytes()
    i <- [0..n): {
        b = s[i]
        is-ws = false
        {
            b == 32 -> is-ws = true
        }
        {
            is-ws -> print('WS')

            -> print('non-WS')
        }
    }
}

; from str-cmp-loop2.no：空白字节扫描（cmp.no 同形）
print-str-cmp-loop2 = () {
    fstr = '  hello   world  nolang  '
    n = fstr.len-bytes()
    i <- [0..n): {
        b = fstr[i]
        is-ws = false
        {
            b == 32 -> is-ws = true

            b == 9 -> is-ws = true

            b == 10 -> is-ws = true

            b == 13 -> is-ws = true
        }
        {
            is-ws -> print('byte[{i.to-str()}]={b.to-str()} WS')

            -> print('byte[{i.to-str()}]={b.to-str()} non-WS')
        }
    }
}

; from str-eq-minimal.no：str == 比较两分支
test-str-eq-min = () (msg str) {
    s = 'true'
    {
        s == 'true' -> msg = 'equal true'

        -> msg = 'not equal true'
    }
}

test-str-eq-min2 = () (msg str) {
    s = 'false'
    {
        s == 'true' -> msg = 'equal true'

        -> msg = 'not equal true'
    }
}

test-str-eq-min-len = () {
    s = 'true'
    print(s.len-bytes())
}

