; from struct.no：结构体字段赋值
suser {
    name str
    age i64
}

print-struct-fields = () {
    u = suser{
        name: 'abc'
        age: 20
    }
    print('struct:')
    u.name = 'def'
    u.age = 25
    print('struct test ok')
}

; from struct-to-str.no：默认 to-str 渲染（嵌套切片与格式串内插）
spoint {
    x i64
    y i64
}

sgroup {
    name str
    pts []spoint
}

print-struct-to-str = () {
    p = spoint{
        x: 1
        y: 2
    }
    print(p)
    g = sgroup{
        name: 'team'
        pts: [
            spoint{
                x: 1
                y: 2
            },
            spoint{
                x: 3
                y: 4
            },
        ]
    }
    print(g)
    print('p={p}')
    gg = g
    print('g={gg}')
}

; from struct-field-leaf-clone.no：欄位寫入深拷貝行內 str（完整移植，型別加 s 前缀避名冲突）
check-str-leaf = (name str, got str, want str) {
    {
        got == want -> print('ok: {name}')

        -> print('fail: {name} got=[{got}] want=[{want}]')
    }
}

sinner {
    name str
}

souter {
    p sinner
    root i64
}

mk-owned-leaf = () (out souter) {
    p = sinner{
        name: 'alice'
    }
    out = souter{
        p: p
        root: 0
    }
}

mk-opt-leaf = () (out ?souter) {
    p = sinner{
        name: 'alice'
    }
    d = souter{
        p: p
        root: 0
    }
    out = d
}

get-child-leaf = (obj souter, i i64) (c ?souter) {
    c = souter{
        p: obj.p
        root: i
    }
}

test-struct-field-leaf-clone = () {

    ; 情境一：父物件是具名局部變數
    a = mk-owned-leaf()
    check-str-leaf('寫入前父物件', a.p.name, 'alice')
    c1 = get-child-leaf(a, 1)
    c1: {
        nil -> print('fail: c1 nil')

        err -> print('fail: c1 err')

        -> check-str-leaf('子視圖', it.p.name, 'alice')
    }
    check-str-leaf('子視圖釋放後父物件仍完好', a.p.name, 'alice')

    ; 情境二：父物件來自 option
    b = mk-opt-leaf()
    b: {
        nil -> print('fail: b nil')

        err -> print('fail: b err')

        -> {
            doc = it
            check-str-leaf('option 父物件', doc.p.name, 'alice')
            c2 ?souter = get-child-leaf(doc, 1)
            c2: {
                nil -> print('fail: c2 nil')

                err -> print('fail: c2 err')

                -> check-str-leaf('option 子視圖', it.p.name, 'alice')
            }
            check-str-leaf('option 父物件仍完好', doc.p.name, 'alice')
        }
    }

    ; 直接指派（不是字面量）也不能共用緩衝區
    src = mk-owned-leaf()
    dst = mk-owned-leaf()
    dst.p = src.p
    src.p.name = 'bob'
    check-str-leaf('指派後目標不受來源影響', dst.p.name, 'alice')
    check-str-leaf('來源自身正確', src.p.name, 'bob')
}

; from str-vec-push.no：vec push 隐式扩容与结构体 vec 字段赋值
sperson {
    name str
    age i64
}

sgroup2 {
    name str
    members []str
    scores []i64
}

test-vec-push-clone = () (ok bool) {

    ; nested-clone-str：[][]str 赋值后两层仍完好
    s [][]str
    sub1 []str
    sub1.push('hello')
    sub1.push('world')
    s.push(sub1)
    c = s
    ok = sub1[0]: {
        ok -> it == 'hello'

        -> false
    }
    ok = c.len() == 1

    ; struct-clone-vec-field：结构体含 vec 字段赋值
    g1 sgroup2
    g1.name = 'team-a'
    g1.members.push('alice')
    g1.members.push('bob')
    g1.scores.push(100)
    g1.scores.push(200)
    g2 = g1
    g2.name == 'team-a' -> ok = true
    g2.members.len() == 2 -> ok = true
}

; from str-loop-assign.no：迴圈内 str 变量赋值（double-free 回归）
loopy-str = () (out i64) {
    a = 'hello-world'
    b = 'seed'
    i <- [0..5): {
        b = a
    }
    out = b.len()
}

print-str-loop-assign = () {
    print('=== str loop assign ===')
    print('--- for loop: str var -> var ---')
    src = 'hello-world'
    back = 'seed'
    j <- [0..3): {
        back = src
    }
    print(back)
    print(back.len())
    print(src)
    print(src.len())

    print('--- for loop: str var -> var, read inside ---')
    s2 = 'abcdef'
    b2 = 'seed'
    k2 <- [0..3): {
        b2 = s2
        print(b2.len())
    }
    print(b2.len())

    print('--- do-while: str var -> var ---')
    s3 = 'hello-world'
    b3 = 'seed'
    n3 = 0
    (n3 < 5) {
        b3 = s3

        #{overflow=wrap}
        {

            #{overflow=wrap}
            n3-opt = n3 + 1
            n3-opt: {
                ok -> n3 = it

                ->
            }
        }
    }
    print(b3)
    print(b3.len())

    print('--- inside a function ---')
    print(loopy-str())

    print('--- control: i64 (no heap) ---')
    ai = 42
    bi = 0
    i3 <- [0..5): {
        bi = ai
    }
    print(bi)

    print('--- control: txt (inline buffer, no heap) ---')
    at txt = 'hello-txt'
    bt txt = 'seed'
    i4 <- [0..5): {
        bt = at
    }
    print(bt)
    print(bt.len())

    print('--- 20000 iterations (leak / double-free stress) ---')
    ss = 'hello-world-padding-padding'
    bs = 'seed'
    i5 <- [0..20000): {
        bs = ss
    }
    print(bs.len())

    print('--- allocating assignment in a loop stays correct ---')
    sa = 'hello-world'
    ba = 'seed'
    i6 <- [0..5): {
        ba = sa - '-xy'
    }
    print(ba.len())

    print('=== done ===')
}

