test-str-for-index = () {
    s = 'abc'
    i <- [0..3): {
        b = s[i]
        print(b)
    }
}

; from str-index-minimal.no：单码点索引
test-str-index-min = () {
    s = 'abc'
    c = s[0]
    c: {
        ok -> print(it)

        -> print('nil')
    }
}

; from str-minimal2.no：len-bytes / fill / 索引
test-str-minimal2 = () {
    s = 'abcdef'
    n = s.len-bytes()
    print(n)
    print(0)
    s.fill(120)
    print(1)
    c0 = s[0]
    c0: {
        ok -> print(it)

        -> print('nil')
    }
    print(2)
}

; from str-minimal3.no：赋值拷贝 / eq / index / to-upper
test-str-minimal3 = () {
    src = 'abcdef'
    dst = '------'
    dst = src
    c0 = dst[0]
    c1 = dst[1]
    c0: {
        ok -> print(it)

        -> _
    }
    c1: {
        ok -> print(it)

        -> _
    }
    print(0)
    a = 'hello'
    b = 'hello'
    eq1 = a.eq(b, 5)
    print(eq1)
    print(1)
    s = 'hello world'
    pos1 = s.index('world')
    print(pos1)
    pos2 = s.index('xyz')
    print(pos2)
    print(2)
    s2 = 'hello'
    upper = s2.to-upper()
    print(upper)
    print(3)
}

; from str-repeat-only.no / str-repeat2.no：str.repeat 基本
print-str-repeat = () {
    print('start')
    space = ' '
    print('before repeat')
    buf = space.repeat(8)
    print('after repeat')
    b0 = buf[0]
    b0 != 32 -> {
        print('FAIL: expected space')
        return
    }
    print('PASS: str.repeat')
}

; from str-repeat2.no：repeat 后仅创建验证
print-str-repeat2 = () {
    print('=== str.repeat Test 2 ===')
    space = ' '
    print('space created')
    buf = space.repeat(8)
    print('buf created')
    print('=== Done ===')
}

; from str-repeat.no：repeat 后写回首位（模块级直写，函数域需 place-match）
test-str-repeat-write = () {
    print('=== str.repeat Test ===')
    space = ' '
    print('space created')
    buf = space.repeat(8)
    print('buf created')
    buf[0]: {
        ok -> it = 0x12

        -> _
    }
    print('buf[0] set')
    b0 = buf[0]
    b0 != 0x12 -> {
        print('FAIL: buf[0] expected 0x12')
        return
    }
    print('PASS: buf[0] = 0x12')
    print('=== Done ===')
}

