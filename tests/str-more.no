; str-test.no — str 标准库完整测试
;
; 构建: cd src && go run ./cmd/cli/. build ../tests/str-test.no
; 运行: ../dist/test_str

; 测试字符串字节长度 (.len-bytes() 方法)
...
test-str-len = () {
    s = 'hello'
    n = s.len-bytes()
    print(n); expect: 5

    empty = ''
    m = empty.len-bytes()
    print(m); expect: 0
}
test-str-len()
print(0)

; 测试 str-at
...
test-str-at = () {
    s = 'abc'
    c0 = s[0]
    print(c0); expect: 97 (a)
    c1 = s[1]
    print(c1); expect: 98 (b)
    c2 = s[2]
    print(c2); expect: 99 (c)
}
test-str-at()
print(1)

; 测试 str-eq
...
test-str-eq = () {
    a = 'hello'
    b = 'hello'
    eq1 = a.eq(b, 5)
    print(eq1); expect: 1

    c = 'world'
    eq2 = a.eq(c, 5)
    print(eq2); expect: 0

    eq3 = a.eq(b, 3)
    print(eq3); expect: 1

    d = 'hell'
    eq4 = a.eq(d, 5)
    print(eq4); expect: 0
}
test-str-eq()
print(2)

; 测试 str-copy
...
test-str-copy = () {
    src = 'abcdef'
    dst = '------'
    dst = src
    c0 = dst[0]
    c1 = dst[1]
    c2 = dst[2]
    print(c0); expect: 97 (a)
    print(c1); expect: 98 (b)
    print(c2); expect: 99 (c)
}
test-str-copy()
print(3)

; 测试 str.fill
...
test-str-fill = () {
    s = 'abcdef'
    s.fill(120)
    c0 = s[0]
    c3 = s[3]
    print(c0); expect: 120 (x)
    print(c3); expect: 120 (x, filled)
}
test-str-fill()
print(4)

; 测试 str.index (方法)
...
test-str-index = () {
    s = 'hello world'
    pos1 = s.index('world')
    print(pos1); expect: 6

    pos2 = s.index('xyz')
    print(pos2); expect: -1

    pos3 = s.index('hello')
    print(pos3); expect: 0

    pos4 = s.index('')
    print(pos4); expect: 0
}
test-str-index()
print(5)

; 测试 str.contains (方法)
...
test-str-contains = () {
    s = 'hello world'
    c1 = s.contains('world')
    print(c1); expect: 1

    c2 = s.contains('xyz')
    print(c2); expect: 0

    c3 = s.contains('lo wo')
    print(c3); expect: 1
}
test-str-contains()
print(6)

; 测试 str.starts-with (方法)
...
test-str-starts-with = () {
    s = 'hello world'
    sw1 = s.starts-with('hello')
    print(sw1); expect: 1

    sw2 = s.starts-with('world')
    print(sw2); expect: 0

    sw3 = s.starts-with('hell')
    print(sw3); expect: 1

    sw4 = s.starts-with('hello world')
    print(sw4); expect: 1

    sw5 = s.starts-with('hello world!')
    print(sw5); expect: 0
}
test-str-starts-with()
print(7)

; 测试 str.ends-with (方法)
...
test-str-ends-with = () {
    s = 'hello world'
    ew1 = s.ends-with('world')
    print(ew1); expect: 1

    ew2 = s.ends-with('hello')
    print(ew2); expect: 0

    ew3 = s.ends-with('orld')
    print(ew3); expect: 1

    ew4 = s.ends-with('hello world')
    print(ew4); expect: 1

    ew5 = s.ends-with('!hello world')
    print(ew5); expect: 0
}
test-str-ends-with()
print(8)

; 测试 str.trim (方法)
...
test-str-trim = () {
    s1 = '  hello  '
    t1 = s1.trim()
    print(t1.len-bytes()); expect: 5

    s2 = 'hello'
    t2 = s2.trim()
    print(t2.len-bytes()); expect: 5

    s3 = '   '
    t3 = s3.trim()
    print(t3.len-bytes()); expect: 0

    s4 = '\thello\n'
    t4 = s4.trim()
    print(t4.len-bytes()); expect: 5
}
test-str-trim()
print(9)

; 测试 str.to-upper / str.to-lower (方法)
...
test-str-case = () {
    s1 = 'hello'
    u1 = s1.to-upper()
    c0 = u1[0]
    c4 = u1[4]
    print(c0); expect: 72 (H)
    print(c4); expect: 79 (O)

    s2 = 'WORLD'
    l1 = s2.to-lower()
    c5 = l1[0]
    c9 = l1[4]
    print(c5); expect: 119 (w)
    print(c9); expect: 100 (d)

    s3 = 'Hello123'
    u2 = s3.to-upper()
    print(u2.len-bytes()); expect: 8
    c10 = u2[5]
    print(c10); expect: 49 (1, unchanged)
}
test-str-case()
print(10)

; 测试 str.repeat (方法)
...
test-str-repeat = () {
    s = 'ab'
    r1 = s.repeat(3)
    print(r1.len-bytes()); expect: 6

    c0 = r1[0]
    c1 = r1[1]
    c2 = r1[2]
    c3 = r1[3]
    c4 = r1[4]
    c5 = r1[5]
    print(c0); expect: 97 (a)
    print(c1); expect: 98 (b)
    print(c2); expect: 97 (a)
    print(c3); expect: 98 (b)
    print(c4); expect: 97 (a)
    print(c5); expect: 98 (b)
}
test-str-repeat()
print(11)

; 测试 str.slice (方法)
...
test-str-slice = () {
    s = 'hello world'
    sl1 = s.slice(0, 5)
    print(sl1.len-bytes()); expect: 5
    sl2 = s.slice(6, 11)
    print(sl2.len-bytes()); expect: 5
    sl3 = s.slice(3, 8)
    print(sl3.len-bytes()); expect: 5
    sl4 = s.slice(0, 11)
    print(sl4.len-bytes()); expect: 11
    sl5 = s.slice(5, 5)
    print(sl5.len-bytes()); expect: 0
    sl6 = s.slice(10, 11)
    print(sl6.len-bytes()); expect: 1
}
test-str-slice()
print(12)

; 测试 str.to-i64 (方法)
...
test-str-to-i64 = () {
    s1 = '123'
    v1 = s1.to-i64()
    print(v1); expect: 123

    s2 = '0'
    v2 = s2.to-i64()
    print(v2); expect: 0

    s3 = '-42'
    v3 = s3.to-i64()
    print(v3); expect: -42

    s4 = '999'
    v4 = s4.to-i64()
    print(v4); expect: 999
}
test-str-to-i64()
print(13)

; 测试 i64-to-str (非方法)
...
test-i64-to-str = () {
    n = 123
    s1 = n.to-str()
    print(s1.len-bytes()); expect: 3
    n = 0
    s2 = n.to-str()
    print(s2.len-bytes()); expect: 1
    n = -42
    s3 = n.to-str()
    print(s3.len-bytes()); expect: 3
    n = 9999
    s4 = n.to-str()
    print(s4.len-bytes()); expect: 4
}
test-i64-to-str()
print(14)

; 测试 str.to-bytes (方法)
...
test-str-bytes = () {
    s = 'abc'
    out = s.to-bytes()
    print(out.len()); expect: 3

    b0 = out[0]
    b1 = out[1]
    b2 = out[2]
    print(b0); expect: 97 (a)
    print(b1); expect: 98 (b)
    print(b2); expect: 99 (c)
}
test-str-bytes()
print(15)

; 测试 str.reverse (方法)
...
test-str-reverse = () {
    s1 = 'abc'
    r1 = s1.reverse()
    print(r1.len-bytes()); expect: 3
    c0 = r1[0]
    c1 = r1[1]
    c2 = r1[2]
    print(c0); expect: 99 (c)
    print(c1); expect: 98 (b)
    print(c2); expect: 97 (a)

    s2 = 'a'
    r2 = s2.reverse()
    print(r2.len-bytes()); expect: 1
    c3 = r2[0]
    print(c3); expect: 97 (a)

    s3 = 'abcd'
    r3 = s3.reverse()
    c4 = r3[0]
    c5 = r3[3]
    print(c4); expect: 100 (d)
    print(c5); expect: 97 (a)
}
test-str-reverse()
print(16)

; 测试 str.compare (方法)
...
test-str-compare = () {
    r1 = 'abc'.compare('abc')
    print(r1); expect: 0

    r2 = 'abc'.compare('abd')
    print(r2); expect: -1

    r3 = 'abd'.compare('abc')
    print(r3); expect: 1

    r4 = 'ab'.compare('abc')
    print(r4); expect: -1

    r5 = 'abc'.compare('ab')
    print(r5); expect: 1

    r6 = 'a'.compare('b')
    print(r6); expect: -1
}
test-str-compare()
print(17)

; 测试 str.count (方法)
...
test-str-count = () {
    s1 = 'hello'
    cnt1 = s1.count()
    print(cnt1); expect: 5

    s2 = 'aaa'
    cnt2 = s2.count()
    print(cnt2); expect: 3

    s3 = ''
    cnt3 = s3.count()
    print(cnt3); expect: 0
}
test-str-count()
print(18)

; 测试 str.replace-char (方法)
...
test-str-replace-char = () {
    s = 'hello'
    r1 = s.replace-char(101, 120)
    print(r1.len-bytes()); expect: 5
    c0 = r1[0]
    c1 = r1[1]
    c2 = r1[2]
    c3 = r1[3]
    c4 = r1[4]
    print(c0); expect: 104 (h)
    print(c1); expect: 120 (x, replaced)
    print(c2); expect: 108 (l)
    print(c3); expect: 108 (l)
    print(c4); expect: 111 (o)

    ; 多字節 UTF-8：'a' (0x61) → '中' (0x4E2D, 3 bytes UTF-8)
    s2 = 'aTa'
    r2 = s2.replace-char(0x61, 0x4e2d)
    print(r2.len-bytes()); expect: 7 (3+1+3)
}
test-str-replace-char()
print(19)

; 测试 str.trim-char (方法)
...
test-str-trim-char = () {
    s1 = '///hello///'
    tc1 = s1.trim-char(47)
    print(tc1.len-bytes()); expect: 5

    s2 = 'hello'
    tc2 = s2.trim-char(47)
    print(tc2.len-bytes()); expect: 5

    s3 = '//////'
    tc3 = s3.trim-char(47)
    print(tc3.len-bytes()); expect: 0

    s4 = '-hello-'
    tc4 = s4.trim-char(45)
    print(tc4.len-bytes()); expect: 5

    ; 多字節 UTF-8：trim '中' (0x4E2D)
    s5 = '中hello中'
    tc5 = s5.trim-char(0x4e2d)
    print(tc5.len-bytes()); expect: 5 (hello)
}
test-str-trim-char()
print(20)

