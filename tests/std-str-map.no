; std-str-map.no — src/std/collection/str-map.no 回歸測試
;
; str-map 長期沒有任何測試覆蓋（tests/mem-safety/test-minimal-str-map*.no 用的是
; 內建 [str]str，不是這個 struct），所以下列三類 bug 一直沒被發現：
;   1. put() 用 `.keys[idx].len = n` + 逐字節拷貝：`.len = n` 是裸欄位寫入，
;      不會分配緩衝區，新槽位的 data 仍是 null，下一個 [i] = 直接 SIGSEGV。
;   2. hash() 的 `key[i]` 讀到的是多字節（i8 元素被當成目標寬度載入）；而且 h0
;      每次呼叫都不同 —— `h = FNV-OFFSET` 把 h 綁成了全域 FNV-OFFSET 的別名，
;      寫回時污染了常數本身。put 與 get 因此落在不同槽位。
;   3. 承上，get / remove / contains 全部失靈。

main = () {
    m = str-map {}
    m.init()

    m.put('name', 'Alice')
    m.put('city', 'Taipei')

    ; 重複 key 應視為更新，不應增加 size
    m.put('name', 'Bob')
    m.size == 2 -> print('ok: size after 3 puts (1 update)')

    -> print('fail: size after 3 puts got=' - m.size.to-str())

    g = m.get('name')
    g: {
        err -> print('fail: get name -> err')

        nil -> print('fail: get name -> nil')

        -> {
            it == 'Bob' -> print('ok: get name (updated)')

            -> print('fail: get name got=[' - it - ']')
        }
    }

    g2 = m.get('city')
    g2: {
        err -> print('fail: get city -> err')

        nil -> print('fail: get city -> nil')

        -> {
            it == 'Taipei' -> print('ok: get city')

            -> print('fail: get city got=[' - it - ']')
        }
    }

    g3 = m.get('nope')
    g3: {
        err -> print('fail: get missing -> err')

        nil -> print('ok: get missing -> nil')

        -> print('fail: get missing -> found ' - it)
    }

    m.contains('city') -> print('ok: contains city')

    -> print('fail: contains city')

    m.contains('nope') -> print('fail: contains missing')

    -> print('ok: contains missing -> false')

    m.remove('name') -> print('ok: remove name')

    -> print('fail: remove name')

    g4 = m.get('name')
    g4: {
        err -> print('fail: get after remove -> err')

        nil -> print('ok: removed key is gone')

        -> print('fail: get after remove -> still ' - it)
    }

    ; remove 之後 city 必須還在（不能把整個表打壞）
    g5 = m.get('city')
    g5: {
        err -> print('fail: get city after remove -> err')

        nil -> print('fail: get city after remove -> nil')

        -> {
            it == 'Taipei' -> print('ok: city survives remove of another key')

            -> print('fail: city after remove got=[' - it - ']')
        }
    }

    m.clear()
    m.size == 0 -> print('ok: size after clear')

    -> print('fail: size after clear got=' - m.size.to-str())
}
