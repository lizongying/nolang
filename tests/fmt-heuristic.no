; test-fmt-heuristic: verify formatter no longer relies on heuristics

; # std/str

; 1. Inferred types (no type annotation)
n i64 = 42
s = 'hello'
f = 3.14
b = true

; 2. Explicit types
m i64 = 0x1a

; 3. Array literal converted from slice literal
fixed [3]u16 = [1, 2, 3]

; 4. Match with range patterns
grade = n: {
    [0..60) -> 'F'
    [60..80) -> 'C'
    [80..90) -> 'B'
    [90..100] -> 'A'
    -> 'invalid'
}

; 5. Match with raw condition pattern
sign = fixed: {
    ok -> 'positive'
    -> 'zero'
}
