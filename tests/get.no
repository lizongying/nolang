; merged category 'get' -- members: get-pw-gr-name.no, getgrouplist.no, getline.no
; (originals backed up under tests/_archive/get/)
; ===================== merged from tests/get-pw-gr-name.no =====================
; Regression for os.getpwuid-name / os.getgrgid-name (cRetFieldStr: deref the
; struct pointer returned by getpwuid(3)/getgrgid(3) and copy pw_name/gr_name,
; both at offset 0). The current uid/gid always resolve to a non-empty name; an
; out-of-range id must resolve to the empty string (NULL struct pointer guarded).
uid = os.geteuid()
gid = os.getegid()
uname = os.getpwuid-name(uid)
gname = os.getgrgid-name(gid)
uname.len() == 0 -> {
    print('get-pw-gr-name FAILED: current user name empty')
    exit(1)
}
gname.len() == 0 -> {
    print('get-pw-gr-name FAILED: current group name empty')
    exit(1)
}
nobody = os.getpwuid-name(4294967295)
nobody.len() != 0 -> {
    print('get-pw-gr-name FAILED: unknown uid should be empty, got ')
    print(nobody)
    exit(1)
}
print('get-pw-gr-name passed')

; ===================== merged from tests/getgrouplist.no =====================
; Regression for os.getgrouplist(user str, basegid i64) -> (gids []i64, n i64).
; getgrouplist(3) resolves the FULL directory membership (getgroups caps at 16 on
; macOS). The current user's real gid must appear in the list, and the returned
; count must equal the slice length.
ruid = os.getuid()
rgid = os.getgid()
user = os.getpwuid-name(ruid)
gids, n = os.getgrouplist(user, rgid)
gids.len() == 0 -> {
    print('getgrouplist FAILED: empty membership for current user')
    exit(1)
}
n != gids.len() -> {
    print('getgrouplist FAILED: count != slice length')
    exit(1)
}
found = false
i <- [0..gids.len()): {
    gids[i] == rgid -> found = true
}
found == false -> {
    print('getgrouplist FAILED: base gid not present in membership')
    exit(1)
}
print('getgrouplist passed')

; ===================== merged from tests/getline.no =====================
line = ''
ok = false
line, ok = fs.get-line()
ok == false -> {
    print('no input')
    return
}
print('got: {line}')
