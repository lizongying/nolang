// test-strconv.no — 字符串类型转换完整测试
//
// 测试覆盖:
//   str → int (正/负/零)
//   str → uint
//   str → float (通过 f→str 往返验证)
//   str → bool
//   str → byte
//   int → str
//   uint → str
//   float → str
//   bool → str
//   byte → str
//   往返转换 (str ↔ int, str ↔ float)

// ===== str → i64 =====
test-str-to-i64 = () {
    n = '12345'.to-i64()
    print(n)  // 期望: 12345

    n = '-42'.to-i64()
    print(n)  // 期望: -42

    n = '0'.to-i64()
    print(n)  // 期望: 0
}

// ===== str → i32 =====
test-str-to-i32 = () {
    s = '32767'
    n i32 = 0
    s.to-i32(n)
    print(n)  // 期望: 32767

    s = '-32768'
    s.to-i32(n)
    print(n)  // 期望: -32768
}

// ===== str → i16 =====
test-str-to-i16 = () {
    s = '100'
    n i16 = 0
    s.to-i16(n)
    print(n)  // 期望: 100

    s = '-1'
    s.to-i16(n)
    print(n)  // 期望: -1
}

// ===== str → i8 =====
test-str-to-i8 = () {
    s = '127'
    n i8 = 0
    s.to-i8(n)
    print(n)  // 期望: 127

    s = '-128'
    s.to-i8(n)
    print(n)  // 期望: -128
}

// ===== str → u64 =====
test-str-to-u64 = () {
    s = '99999'
    n u64 = 0
    s.to-u64(n)
    print(n)  // 期望: 99999
}

// ===== str → f64 =====
test-str-to-f64 = () {
    s = '3.14'
    f = s.to-f64()
    s2 = f.to-str()
    print(s2)  // 期望: 3.14

    s = '-2.5'
    f = s.to-f64()
    s2 = f.to-str()
    print(s2)  // 期望: -2.5

    s = '0.0'
    f = s.to-f64()
    s2 = f.to-str()
    print(s2)  // 期望: 0
}

// ===== str → bool =====
test-str-to-bool = () {
    b = 'true'.to-bool()
    {
        b -> print(1)
        -> print(0)
    }

    // 期望: 1

    b = 'false'.to-bool()
    {
        b -> print(1)
        -> print(0)
    }
    // 期望: 0
}

// ===== str → byte =====
test-str-to-byte = () {
    b = '65'.to-byte()
    print(b)  // 期望: 65 (ASCII 'A')
}

// ===== i64 → str =====
test-i64-to-str = () {
    s = (42).to-str()
    print(s)  // 期望: 42

    s = (-100).to-str()
    print(s)  // 期望: -100

    s = (0).to-str()
    print(s)  // 期望: 0
}

// ===== i32 → str =====
test-i32-to-str = () {
    s = (999).to-str()
    print(s)  // 期望: 999
}

// ===== u64 → str =====
test-u64-to-str = () {
    s = (12345).to-str()
    print(s)  // 期望: 12345
}

// ===== f64 → str =====
test-f64-to-str = () {
    s = (3.14).to-str()
    print(s)  // 期望: 3.14

    s = (0.0).to-str()
    print(s)  // 期望: 0
}

// ===== bool → str =====
test-bool-to-str = () {
    s = true.to-str()
    print(s)  // 期望: true

    s = false.to-str()
    print(s)  // 期望: false
}

// ===== byte → str =====
test-byte-to-str = () {
    s = (65).to-str()
    print(s)  // 期望: 65

    s = (0).to-str()
    print(s)  // 期望: 0
}

// ===== 往返: i64 → str → i64 =====
test-roundtrip-i64 = () {
    s = (12345).to-str()
    n = s.to-i64()
    print(n)  // 期望: 12345
}

// ===== 往返: f64 → str → f64 =====
test-roundtrip-f64 = () {
    f = '3.14'.to-f64()
    s = f.to-str()
    print(s)  // 期望: 3.14
}

// ===== 边界: i64 极值 =====
test-edge-i64 = () {
    s = (9223372036854775807).to-str()
    print(s)  // 期望: 9223372036854775807

    s = (-9223372036854775807 - 1).to-str()
    print(s)  // 期望: -9223372036854775808
}

// ===== 运行测试 =====
test-str-to-i64()
test-str-to-i32()
test-str-to-i16()
test-str-to-i8()
test-str-to-u64()
test-str-to-f64()
test-str-to-bool()
test-str-to-byte()
test-i64-to-str()
test-i32-to-str()
test-u64-to-str()
test-f64-to-str()
test-bool-to-str()
test-byte-to-str()
test-roundtrip-i64()
test-roundtrip-f64()
test-edge-i64()