; test-strconv.no — 字符串类型转换完整测试
;
; 测试覆盖:
;   str → int (正/负/零) — 返回 Option
;   str → uint
;   str → float (通过 f→str 往返验证)
;   str → bool — 返回 Option
;   str → byte — 返回 Option
;   int → str
;   uint → str
;   float → str
;   bool → str
;   byte → str
;   往返转换 (str ↔ int, str ↔ float)

; ===== str → i64 =====
test-str-to-i64 = () {
    n = '12345'.to-i64()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: 12345
    }

    n = '-42'.to-i64()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: -42
    }

    n = '0'.to-i64()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: 0
    }
}

; ===== str → i32 =====
test-str-to-i32 = () {
    n = '32767'.to-i32()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: 32767
    }

    n = '-32768'.to-i32()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: -32768
    }
}

; ===== str → i16 =====
test-str-to-i16 = () {
    n = '100'.to-i16()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: 100
    }

    n = '-1'.to-i16()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: -1
    }
}

; ===== str → i8 =====
test-str-to-i8 = () {
    n = '127'.to-i8()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: 127
    }

    n = '-128'.to-i8()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: -128
    }
}

; ===== str → u64 =====
test-str-to-u64 = () {
    n = '99999'.to-u64()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: 99999
    }
}

; ===== str → f64 =====
test-str-to-f64 = () {
    f = '3.14'.to-f64()
    {
        f == nil -> print('nil')
        f == err -> print('err')
        -> print(f); 期望: 3.14
    }

    f = '-2.5'.to-f64()
    {
        f == nil -> print('nil')
        f == err -> print('err')
        -> print(f); 期望: -2.5
    }

    f = '0.0'.to-f64()
    {
        f == nil -> print('nil')
        f == err -> print('err')
        -> print(f); 期望: 0
    }
}

; ===== str → bool =====
test-str-to-bool = () {
    b = 'true'.to-bool()
    {
        b == nil -> print('nil')
        b == err -> print('err')
        -> print(b); 期望: 1
    }

    b = 'false'.to-bool()
    {
        b == nil -> print('nil')
        b == err -> print('err')
        -> print(b); 期望: 0
    }
}

; ===== str → byte =====
test-str-to-byte = () {
    b = '65'.to-byte()
    {
        b == nil -> print('nil')
        b == err -> print('err')
        -> print(b); 期望: 65 (ASCII 'A')
    }
}

; ===== i64 → str =====
test-i64-to-str = () {
    s = (42).to-str()
    print(s); 期望: 42

    s = (-100).to-str()
    print(s); 期望: -100

    s = (0).to-str()
    print(s); 期望: 0
}

; ===== i32 → str =====
test-i32-to-str = () {
    s = (999).to-str()
    print(s); 期望: 999
}

; ===== u64 → str =====
test-u64-to-str = () {
    s = (12345).to-str()
    print(s); 期望: 12345
}

; ===== f64 → str =====
test-f64-to-str = () {
    s = (3.14).to-str()
    print(s); 期望: 3.14

    s = (0.0).to-str()
    print(s); 期望: 0
}

; ===== f32 → str =====
test-f32-to-str = () {
    f f32 = f64-to-f32(3.14)
    s = f.to-str()
    print(s); 期望: 3.14

    z f32 = f64-to-f32(0.0)
    s = z.to-str()
    print(s); 期望: 0
}

; ===== bool → str =====
test-bool-to-str = () {
    s = true.to-str()
    print(s); 期望: true

    s = false.to-str()
    print(s); 期望: false
}

; ===== byte → str =====
test-byte-to-str = () {
    s = (65).to-str()
    print(s); 期望: 65

    s = (0).to-str()
    print(s); 期望: 0
}

; ===== 往返: i64 → str → i64 =====
test-roundtrip-i64 = () {
    s = (12345).to-str()
    n = s.to-i64()
    {
        n == nil -> print('nil')
        n == err -> print('err')
        -> print(n); 期望: 12345
    }
}

; ===== 往返: f64 → str → f64 =====
test-roundtrip-f64 = () {
    f = '3.14'.to-f64()
    {
        f == nil -> print('nil')
        f == err -> print('err')
        -> print(f); 期望: 3.14
    }
}

; ===== 边界: i64 极值 =====
test-edge-i64 = () {
    s = (9223372036854775807).to-str()
    print(s); 期望: 9223372036854775807

    s = (-9223372036854775807 - 1).to-str()
    print(s); 期望: -9223372036854775808
}

; ===== 运行测试 =====
test-str-to-i64()
test-str-to-i32()
test-str-to-i16()
test-str-to-i8()
test-str-to-u64()
test-str-to-f64()
test-str-to-bool()
test-str-to-byte()
test-i64-to-str()
test-i32-to-str()
test-u64-to-str()
test-f64-to-str()
test-f32-to-str()
test-bool-to-str()
test-byte-to-str()
test-roundtrip-i64()
test-roundtrip-f64()
test-edge-i64()
