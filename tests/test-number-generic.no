// test/number-generic.no — 測試 std/number 中泛型函數的運行結果
//
// 覆蓋以下函數：
//   - max  (a ..num)  (r num)  — 變參泛型
//   - min  (a ..num)  (r num)  — 變參泛型
//   - abs  (a num)    (r num)  — 非變參泛型
//   - sign (num.sign) (r num)  — 方法泛型
//   - even (a int)    (yes bool) — 整型泛型
//   - odd  (a int)    (yes bool) — 整型泛型
//   - pow  (a int, n int) (r int) — 整型泛型
//   - gcd  (a int, b int) (r int) — 整型泛型
//   - lcm  (a int, b int) (r int) — 整型泛型

# std/number

// ── max：變參泛型，回傳最大值 ──
test-max = () {
    r = max(10, 20)
    print(r)  // expect: 20

    r = max(3, 1, 4, 1, 5)
    print(r)  // expect: 5

    r = max(100, 50)
    print(r)  // expect: 100
}

test-max()
print(0)

// ── min：變參泛型，回傳最小值 ──
test-min = () {
    r = min(10, 20)
    print(r)  // expect: 10

    r = min(3, 1, 4, 1, 5)
    print(r)  // expect: 1
}

test-min()
print(1)

// ── abs：非變參泛型，回傳絕對值 ──
test-abs = () {
    r = abs(-42)
    print(r)  // expect: 42

    r = abs(7)
    print(r)  // expect: 7

    r = abs(0)
    print(r)  // expect: 0
}

test-abs()
print(2)

// ── sign：方法泛型，回傳符號（-1, 0, 1）──
test-sign = () {
    r = sign(5)
    print(r)  // expect: 1

    r = sign(0 - 3)
    print(r)  // expect: -1

    r = sign(0)
    print(r)  // expect: 0
}

test-sign()
print(3)

// ── even / odd：整型泛型，回傳 bool ──
test-even-odd = () {
    yes = even(4)
    print(yes)  // expect: true

    yes = even(7)
    print(yes)  // expect: false

    yes = odd(4)
    print(yes)  // expect: false

    yes = odd(7)
    print(yes)  // expect: true
}

test-even-odd()
print(4)

// ── pow：整型冪 ──
test-pow = () {
    r = pow(2, 10)
    print(r)  // expect: 1024

    r = pow(3, 4)
    print(r)  // expect: 81

    r = pow(5, 0)
    print(r)  // expect: 1

    r = pow(7, 1)
    print(r)  // expect: 7
}

test-pow()
print(5)

// ── gcd：最大公因數 ──
test-gcd = () {
    r = gcd(48, 18)
    print(r)  // expect: 6

    r = gcd(42, 21)
    print(r)  // expect: 21

    r = gcd(17, 23)
    print(r)  // expect: 1

    r = gcd(0, 12)
    print(r)  // expect: 12

    r = gcd(0 - 12, 8)
    print(r)  // expect: 4
}

test-gcd()
print(6)

// ── lcm：最小公倍數 ──
test-lcm = () {
    r = lcm(4, 6)
    print(r)  // expect: 12

    r = lcm(12, 63)
    print(r)  // expect: 252

    r = lcm(0, 5)
    print(r)  // expect: 0

    r = lcm(7, 7)
    print(r)  // expect: 7

    r = lcm(2, 5)
    print(r)  // expect: 10
}

test-lcm()
print(7)
