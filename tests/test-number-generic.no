// test/number_generic.no — 測試 std/number 中泛型函數的運行結果
//
// 覆蓋以下函數：
//   - max  (a ..num)  (r num)  — 變參泛型
//   - min  (a ..num)  (r num)  — 變參泛型
//   - abs  (a num)    (r num)  — 非變參泛型
//   - sign (a num)    (r num)  — 非變參泛型
//   - even (a int)    (yes bool) — 整型泛型
//   - odd  (a int)    (yes bool) — 整型泛型
//   - pow  (a int, n int) (r int) — 整型泛型
//   - gcd  (a int, b int) (r int) — 整型泛型
//   - lcm  (a int, b int) (r int) — 整型泛型

# std/number

// ── max：變參泛型，回傳最大值 ──
test-max = () {
    r = 0

    // i64
    max(10, 20, r)
    print(r)  // expect: 20

    max(3, 1, 4, 1, 5, r)
    print(r)  // expect: 5

    max(100, 50, r)
    print(r)  // expect: 100
}

test-max()
print(0)

// ── min：變參泛型，回傳最小值 ──
test-min = () {
    r = 0

    min(10, 20, r)
    print(r)  // expect: 10

    min(3, 1, 4, 1, 5, r)
    print(r)  // expect: 1
}

test-min()
print(1)

// ── abs：非變參泛型，回傳絕對值 ──
test-abs = () {
    r = 0

    abs(-42, r)
    print(r)  // expect: 42

    abs(7, r)
    print(r)  // expect: 7

    abs(0, r)
    print(r)  // expect: 0
}

test-abs()
print(2)

// ── sign：非變參泛型，回傳符號（-1, 0, 1）──
test-sign = () {
    r = 0

    r = t.sign(5)
    print(r)  // expect: 1

    r = -3.sign()
    print(r)  // expect: -1

    r = 0.sign()
    print(r)  // expect: 0
}

test-sign()
print(3)

// ── even / odd：整型泛型，回傳 bool ──
test-even-odd = () {
    yes = 0

    even(4, yes)
    if yes {
        print(1)
    } elif  {
        // expect: 1

        // expect: 0

        // expect: 1

        // expect: 0

        // ── pow：整型冪 ──

        // expect: 1024

        // expect: 81

        // expect: 1

        // expect: 7

        // ── gcd：最大公因數 ──

        r = 0
        gcd(48, 18, r)
        print(r)  // expect: 6
        gcd(42, 21, r)
        print(r)  // expect: 21
        gcd(17, 23, r)
        print(r)  // expect: 1
        gcd(0, 12, r)
        print(r)  // expect: 12
        gcd(-12, 8, r)
        print(r)  // expect: 4
    }

    test-gcd()
    print(6)

    // ── lcm：最小公倍數 ──
    test-lcm = () {
        r = 0

        lcm(4, 6, r)
        print(r)  // expect: 12

        lcm(12, 63, r)
        print(r)  // expect: 252

        lcm(0, 5, r)
        print(r)  // expect: 0

        lcm(7, 7, r)
        print(r)  // expect: 7

        lcm(2, 5, r)
        print(r)  // expect: 10
    }

    test-lcm()
    print(7)
}