; log-loc.no — #{track-caller} 呼叫點自動注入 迴歸測試
;
; 驗證編譯器對 #{track-caller} 函式「省略末位 loc 參數」時，注入呼叫點
; 「檔案:行:列」常數；且僅對被標記者生效、呼叫端顯式傳入時不被覆寫。
; 另驗證 std/log 的 set-format / 分級輸出整合路徑不崩潰。
;
; 通过判準（no test 以結束碼 0 為通過）：以下任一斷言失敗即 exit(非0)。

; 標記 #{track-caller}，回傳注入的 loc 槽，便於斷言而無需擷取 stderr
; msg str: 訊息內容，本測試傳 'first' / 'second'
; loc str: 由呼叫端位置注入的字串（預設 ''），應以 'log-loc.no:' 開頭
; out str: 原樣回傳 loc，供斷言檢查
#{track-caller}
probe = (msg str, loc str = '') (out str) {
    out = loc
}

; 未標記，省略的末位應維持預設 ''（證明注入只對 track-caller 生效）
; msg str: 訊息內容
; extra str: 末端參數，省略時維持預設 ''
; out str: 原樣回傳 extra
plain = (msg str, extra str = '') (out str) {
    out = extra
}

a = probe('first')
b = probe('second')

; 1. 注入字串必須帶本測試檔名
! a.starts-with('log-loc.no:') -> exit(1)
! b.starts-with('log-loc.no:') -> exit(2)

; 2. 兩個不同呼叫點 → 行號不同 → 位置字串必須不同
a == b -> exit(3)

; 3. 顯式傳入 loc 時不得被覆寫（封裝轉發場景）
c = probe('x', 'MY-LOC')
c != 'MY-LOC' -> exit(4)

; 4. 非 track-caller 省略末位 → 維持預設空字串
d = plain('x')
! d.empty() -> exit(5)

; 5. std/log 整合：格式位 + 分級輸出（含注入呼叫點）正常執行不崩潰
log.set-format(log.F-LEVEL | log.F-LOC)
log.info('integration-ok')
log.warn('integration-warn')

print('log-loc: passed')
