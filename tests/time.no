; time.no — time 模組測試
;
; 測試 now-s, now-ms, duration-between, sleep-ms, since-ms, timer, format-duration

; # std/time

; ── 1. now-s 回傳正值 ──
ts = 0
ts = time.now-s()
{
    ts > 0 -> print('ok: now-s')

    -> print('fail: now-s')
}

; ── 2. now-ms 回傳正值 ──
ms = 0
ms = time.now-ms()
{
    ms > 0 -> print('ok: now-ms')

    -> print('fail: now-ms')
}

; ── 3. duration-between 計算差值 ──
start = 1000
end = 1010
diff = 0
diff = time.duration-between(start, end)
{
    diff == 10 -> print('ok: duration-between')

    -> print('fail: duration-between')
}

; ── 4. sleep-ms(100) 睡眠 ──
time.sleep-ms(100)
print('ok: sleep-ms')

; ── 5. since-ms 計算經過時間 ──
before = 0
before = time.now-ms()
time.sleep-ms(50)
elapsed = 0
elapsed = time.since-ms(before)
{
    elapsed >= 50 -> print('ok: since-ms')

    -> print('fail: since-ms')
}

; ── 6. timer 計時器（需明確宣告型別 t timer 才能正確解析方法）──
t time.timer = timer {
    start-ts: 0
    end-ts: 0
}
t.start()
time.sleep-ms(50)
t.stop()
t-ms = 0
t-ms = t.elapsed-ms()
{
    t-ms >= 50 -> print('ok: timer elapsed-ms')

    -> print('fail: timer elapsed-ms')
}

; ── 7. format-duration(3661) 輸出 '1h1m1s' ──
time.format-duration(3661)
print('ok: format-duration')
