; vec-slice-more.no — 合併自 vec slice / 巢狀 vec 碎片（頂層拼接，非函數包裹）
; 來源：vec-slice.no, nested-vec-test.no
; 保留錨點：vec.no（基名）；vec-more.no（既有合併檔：reverse/elem/assign/u32/len/
;            push-clear/to-str 等，另行保留，regress-vec-to-str.sh 依賴它）
; ── 來自 vec-slice.no ──
; vec-slice test (slice 區間語法全覆蓋)
a = [10, 20, 30, 40, 50]

; full slice: a[..]
b = a[..]
print(b[0])
print(b[1])
print(b[2])
print(b[3])
print(b[4])

; from index: a[2..]
c = a[2..]
print(c[0])
print(c[1])
print(c[2])

; to index inclusive: a[..3]
d = a[..3]
print(d[0])
print(d[1])
print(d[2])

; range: a[1..4]
e = a[1..4]
print(e[0])
print(e[1])
print(e[2])

; range exclusive end: a[1..4)
f = a[1..4)
print(f[0])
print(f[1])
print(f[2])

; range exclusive start: a(1..4]
g = a(1..4]
print(g[0])
print(g[1])
print(g[2])

; range exclusive both: a(1..4) → indices 2,3 (len=2)
h = a(1..4)
print(h[0])
print(h[1])

; till index exclusive: a[..1)
i = a[..1)
print(i[0])

; single element: a[1..2)
j = a[1..2)
print(j[0])

print('---')

; ── 來自 nested-vec-test.no ──
; 巢狀 vec：b 推入 make-vec2 後再拷給 b0，改 b0 內層元素不得影響原始 a[0]
make-vec2 = (a i64, b i64) (v []i64) {
    v.push(a)
    v.push(b)
}

test1 = () (ok bool) {
    a [][]i64
    a.push(make-vec2(1, 2))
    b = a
    b0 = b[0]
    b0.push(100)
    b0.len() == 3 -> ok = true
    b0[2] == 100 -> ok = true
}

ok1 = test1()
print('test1: {ok1}')
