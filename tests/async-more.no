; async-more — 合併自同簇 async 小件（heavy dedup）
;
; 僅併入「函式化、決定性」的協程探針（awy 組與 co 皆封在函式內，末尾依序呼叫）；
; 每個原件頂層符號加前綴避免單態化衝突。
; 保留獨立：async.no(canonical)、async-arg-move/arg-retain(被 src 引用)、
; go-async/module-async(模組級 co 觸發全檔 async 狀態機變換，併檔會改語義)。
; 手寫句柄 / cancel(h) 探針已隨 run 關鍵字一併移除。
;
; `co` 只啟動**過程**（被呼叫者不得有宣告回傳值），所以結果一律走通道：
; 一個生產者一條通道，寫完值即 close，呼叫方用 take-i64 / take-str 讀回。
; 原本靠「讀已 await 的變數」表達的組內資料依賴，改成「讀通道」——同樣是屏障，
; 前者由變數依賴隱含，後者由通道語義顯式表達。

; ── 通用讀回 ────────────────────────────────────────────
; 從單值通道取一筆（生產者已 close，一輪 ok 之後落到 nil 收尾）
; ch: 已關閉的結果通道
; r: 取到的值；一筆都沒有時回 0
take-i64 = (ch chan[i64]) (r i64) {
    r = 0
    <- ch: {
        ok -> r = it

        -> {
        }
    }
}

; ch: 已關閉的結果通道
; r: 取到的字串；一筆都沒有時回空字串
take-str = (ch chan[str]) (r str) {
    r = ''
    <- ch: {
        ok -> r = it

        -> {
        }
    }
}

; from async-cancel.no — cancel / cancelled / async-yield 探針
ac-worker = (n i64) (r i64) {

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt = n * 2
        r-opt: {
            ok -> r = it

            ->
        }
    }
}

; ch: 結果通道（呼叫方建，容量 1）
; n: 來源數值
ac-worker-into = (ch chan[i64], n i64) {
    ch <- ac-worker(n)
    ch.close()
}

ac-test-no-cancel = () {
    ch chan[i64] = with-cap(1)
    awy {
        co ac-worker-into(ch, 21)
    }
    r = take-i64(ch)
    print(r); expect: 42
}

ac-test-cancelled = () {
    c = async.cancelled()
    print(c); expect: 0
}

ac-test-yield = () {
    async-yield()
    print(7); expect: 7
}

; from async-coop.no — 協作式自我取消檢查（cancelled 在 -async 目標內）
ak-selfcheck = (n i64) (r i64) {
    c = async.cancelled()
    r = n
    {
        c -> r = 0
    }
}

; ch: 結果通道（呼叫方建，容量 1）
; n: 來源數值
ak-selfcheck-into = (ch chan[i64], n i64) {
    ch <- ak-selfcheck(n)
    ch.close()
}

ak-test-run-ok = () {
    ch chan[i64] = with-cap(1)
    awy {
        co ak-selfcheck-into(ch, 7)
    }
    r = take-i64(ch)
    print(r); expect: 7
}

; from async-yield.no — async-yield 在協程內（讓出控制權）
ay-yielder = (n i64) (r i64) {
    async-yield()

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt2 = n + 1
        r-opt2: {
            ok -> r = it

            ->
        }
    }
}

; ch: 結果通道（呼叫方建，容量 1）
; n: 來源數值
ay-yielder-into = (ch chan[i64], n i64) {
    ch <- ay-yielder(n)
    ch.close()
}

ay-test-inside = () {
    ch chan[i64] = with-cap(1)
    awy {
        co ay-yielder-into(ch, 5)
    }
    r = take-i64(ch)
    print(r); expect: 6
}

ay-test-plain = () {
    async-yield()
    print(9); expect: 9
}

; from async-group.no — 協程組（coroutine group）
ag-hello = (i i64) (r i64) {
    r = i
}

; ch: 結果通道（呼叫方建，容量 1）
; i: 要原樣送回的數值
ag-hello-into = (ch chan[i64], i i64) {
    ch <- ag-hello(i)
    ch.close()
}

ag-test-independent = () {
    c1 chan[i64] = with-cap(1)
    c2 chan[i64] = with-cap(1)
    awy {
        co ag-hello-into(c1, 1)
        co ag-hello-into(c2, 2)
    }
    r1 = take-i64(c1)
    r2 = take-i64(c2)
    print(r1); expect: 1
    print(r2); expect: 2
}

; 組內資料依賴：第二個 spawn 的實參來自第一個的結果 ⇒ 組內先讀通道（屏障）
ag-test-dependent = () {
    c1 chan[i64] = with-cap(1)
    c2 chan[i64] = with-cap(1)
    r1 = 0
    awy {
        co ag-hello-into(c1, 1)
        r1 = take-i64(c1)
        co ag-hello-into(c2, r1)
    }
    r2 = take-i64(c2)
    print(r1); expect: 1
    print(r2); expect: 1
}

; 三級依賴鏈，每級都靠通道讀回把上一級的結果接到下一級的實參上
ag-test-chain = () {
    c1 chan[i64] = with-cap(1)
    c2 chan[i64] = with-cap(1)
    c3 chan[i64] = with-cap(1)
    r1 = 0
    r2 = 0
    awy {
        co ag-hello-into(c1, 1)
        r1 = take-i64(c1)
        co ag-hello-into(c2, r1)
        r2 = take-i64(c2)
        co ag-hello-into(c3, r2)
    }
    r3 = take-i64(c3)
    print(r3); expect: 1
}

ag-test-read-inside = () {
    ch chan[i64] = with-cap(1)
    awy {
        co ag-hello-into(ch, 7)
        print(take-i64(ch)); expect: 7
    }
}

ag-side = (n i64) {
    print(n); expect: 5
}

ag-test-discarded = () {
    awy {
        co ag-side(5)
    }
}

ag-echo = (s str) (r str) {
    r = s
}

; ch: 結果通道（呼叫方建，容量 1）
; s: 要原樣送回的負載
ag-echo-into = (ch chan[str], s str) {
    ch <- ag-echo(s)
    ch.close()
}

ag-test-heap-arg = () {
    ca chan[str] = with-cap(1)
    cb chan[str] = with-cap(1)
    a = 'hello'
    b = 'world'
    awy {
        co ag-echo-into(ca, a)
        co ag-echo-into(cb, b)
    }
    ra = take-str(ca)
    rb = take-str(cb)
    print(ra); expect: hello
    print(rb); expect: world
}

ac-test-no-cancel()
ac-test-cancelled()
ac-test-yield()
ak-test-run-ok()
ay-test-inside()
ay-test-plain()
ag-test-independent()
ag-test-dependent()
ag-test-chain()
ag-test-read-inside()
ag-test-discarded()
ag-test-heap-arg()
