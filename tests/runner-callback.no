; runner-callback.no — runner.no test-run 回呼測試
;
; 驗證 src/test/runner.no 的 test-run 函式：
;   test-run = (name str, fn fn ()) (passed i64, failed i64)
; 傳入具名函式作為回呼，確認計數正確（執行完成 → passed=1, failed=0）。

# /test/runner

greet = () {
    print('hi from greet')
}

test1 = () {
    print('test1 running')
}
p = 0
f = 0
p, f = runner.test('greet', greet)
{
    p == 1 -> print('ok: test-run greet passed')

    -> print('fail: test-run greet passed')
}
{
    f == 0 -> print('ok: test-run greet failed=0')

    -> print('fail: test-run greet failed=0')
}
p2 = 0
f2 = 0
p2, f2 = runner.test('test1', test1)
{
    p2 == 1 -> print('ok: test-run test1 passed')

    -> print('fail: test-run test1 passed')
}
