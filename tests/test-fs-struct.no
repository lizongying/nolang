// test-fs-struct.no — 驗證 file-opts 結構體 + open() 自由組合旗標
//
// 目標語法：
//   open('test.dat', { mode: write, perm: perm-644, excl: true })

# std/fs

main = () {
    tmp = '/tmp/nolang-fs-test.txt'
    payload = 'hello nolang file struct'
    remove(tmp)

    f-w ?file
    f-w = open(tmp, {
        mode: write
        perm: perm-644
        excl: false
        truncate: false
        append: false
    })
    f-w: {
        err -> print('fail: open-write err')
        nil -> print('fail: open-write nil')
        ->
            it.write(payload, payload.len)
            it.close()
            print('ok: open write')
    }

    f-e ?file
    f-e = open(tmp, {
        mode: write
        perm: perm-644
        excl: true
        truncate: false
        append: false
    })
    f-e: {
        err -> print('fail: open-excl err')
        nil -> print('ok: excl blocks existing file')
        -> print('fail: excl did not block')
    }

    f-r ?file
    f-r = open(tmp, {
        mode: read
        perm: perm-644
        excl: false
        truncate: false
        append: false
    })
    f-r: {
        err -> print('fail: open-read err')
        nil -> print('fail: open-read nil')
        ->
            buf [256]byte
            n = it.read(buf, 256)
            it.close()
            if n == payload.len {
                print('ok: read length matches')
            } else {
                print('fail: read length mismatch')
            }
    }

    remove(tmp)
}

main()
