; test-x25519-dh — 測試 X25519 DH 金鑰交換
; # std/crypto/x25519

; key-holder: 測試用結構體，模擬 tls.conn 的欄位
key-holder {
    priv [32]byte
    pub [32]byte
    shared [32]byte
}

; hex-to-bytes: 將 hex 字串轉為 [32]byte
hex-to-bytes = (hex-str str) (out [32]byte) {
    i <- [0..32): {
        hi = hex-str[i * 2]
        lo = hex-str[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        hi >= 48 && hi <= 57 -> hi-v = hi - 48
        hi >= 97 && hi <= 102 -> hi-v = hi - 87
        hi >= 65 && hi <= 70 -> hi-v = hi - 55
        lo >= 48 && lo <= 57 -> lo-v = lo - 48
        lo >= 97 && lo <= 102 -> lo-v = lo - 87
        lo >= 65 && lo <= 70 -> lo-v = lo - 55
        out[i] = (hi-v << 4) | lo-v
    }
}

; test-dh: 測試 DH 金鑰交換 — 使用 RFC 7748 測試向量
test-dh = () (pass bool) {
    pass = false

    ; Alice
    alice = key-holder {}
    alice.priv = hex-to-bytes('77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a')
    alice.pub = x25519.x25519-scalarmult-base(alice.priv)

    ; Bob
    bob = key-holder {}
    bob.priv = hex-to-bytes('5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb')
    bob.pub = x25519.x25519-scalarmult-base(bob.priv)

    ; 驗證公鑰
    alice-pub-expected = hex-to-bytes('8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a')
    bob-pub-expected = hex-to-bytes('de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f')

    ; 檢查 Alice 公鑰
    alice-pub-ok = true
    i <- [0..32): {
        alice.pub[i] != alice-pub-expected[i] -> {
            alice-pub-ok = false
            break
        }
    }
    alice-pub-ok == false -> {
        print('FAIL: Alice pub mismatch')
        return
    }

    ; 檢查 Bob 公鑰
    bob-pub-ok = true
    i <- [0..32): {
        bob.pub[i] != bob-pub-expected[i] -> {
            bob-pub-ok = false
            break
        }
    }
    bob-pub-ok == false -> {
        print('FAIL: Bob pub mismatch')
        return
    }

    print('PASS: public keys match')

    ; 計算共享金鑰 — 模擬 TLS 的 DH
    alice.shared = x25519.x25519-scalarmult(alice.priv, bob.pub)
    bob.shared = x25519.x25519-scalarmult(bob.priv, alice.pub)

    ; 列印共享金鑰
    eprint('Alice shared: ')
    i <- [0..32): {
        eprint(alice.shared[i] & 255)
        eprint(' ')
    }
    eprint('Bob shared: ')
    i <- [0..32): {
        eprint(bob.shared[i] & 255)
        eprint(' ')
    }

    ; 驗證兩端共享金鑰相同
    shared-match = true
    i <- [0..32): {
        alice.shared[i] != bob.shared[i] -> {
            shared-match = false
            break
        }
    }
    shared-match == false -> {
        print('FAIL: shared secrets differ')
        return
    }

    ; 驗證共享金鑰等於預期值
    shared-expected = hex-to-bytes('4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742')
    shared-ok = true
    i <- [0..32): {
        alice.shared[i] != shared-expected[i] -> {
            shared-ok = false
            break
        }
    }
    shared-ok == false -> {
        print('FAIL: shared secret does not match expected')
        return
    }

    pass = true
}

main = () {
    p = test-dh()
    p == true -> print('PASS: X25519 DH test')
    p == false -> print('FAIL: X25519 DH test')
}
