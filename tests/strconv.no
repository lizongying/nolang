; strconv.no — 字符串類型轉換完整測試
;
; 測試覆蓋:
;   str → int (正/負/零) — 返回 Option
;   str → uint
;   str → float (通過 f→str 往返驗證)
;   str → bool — 返回 Option
;   str → byte — 返回 Option
;   int → str
;   uint → str
;   float → str
;   bool → str
;   byte → str
;   往返轉換 (str ↔ int, str ↔ float)

; ===== str → i64 =====
test-str-to-i64 = () {
    n = '12345'.to-i64()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: 12345
    }
    n = '-42'.to-i64()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: -42
    }
    n = '0'.to-i64()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: 0
    }
}

; ===== str → i32 =====
test-str-to-i32 = () {
    n = '32767'.to-i32()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: 32767
    }
    n = '-32768'.to-i32()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: -32768
    }
}

; ===== str → i16 =====
test-str-to-i16 = () {
    n = '100'.to-i16()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: 100
    }
    n = '-1'.to-i16()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: -1
    }
}

; ===== str → i8 =====
test-str-to-i8 = () {
    n = '127'.to-i8()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: 127
    }
    n = '-128'.to-i8()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: -128
    }
}

; ===== str → u64 =====
test-str-to-u64 = () {
    n = '99999'.to-u64()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: 99999
    }
}

; ===== str → f64 =====
test-str-to-f64 = () {
    f = '3.14'.to-f64()
    {
        f == nil -> print('nil')

        f == err -> print('err')

        -> print(f); 期望: 3.14
    }
    f = '-2.5'.to-f64()
    {
        f == nil -> print('nil')

        f == err -> print('err')

        -> print(f); 期望: -2.5
    }
    f = '0.0'.to-f64()
    {
        f == nil -> print('nil')

        f == err -> print('err')

        -> print(f); 期望: 0
    }
}

; ===== str → bool =====
test-str-to-bool = () {
    b = 'true'.to-bool()
    {
        b == nil -> print('nil')

        b == err -> print('err')

        -> print(b); 期望: 1
    }
    b = 'false'.to-bool()
    {
        b == nil -> print('nil')

        b == err -> print('err')

        -> print(b); 期望: 0
    }
}

; ===== str → byte =====
test-str-to-byte = () {
    b = '65'.to-byte()
    {
        b == nil -> print('nil')

        b == err -> print('err')

        -> print(b); 期望: 65 (ASCII 'A')
    }
}

; ===== i64 → str =====
test-i64-to-str = () {
    n = 42
    s = n.to-str()
    print(s); 期望: 42

    n = -100
    s = n.to-str()
    print(s); 期望: -100

    n = 0
    s = n.to-str()
    print(s); 期望: 0
}

; ===== i32 → str =====
test-i32-to-str = () {
    n i32 = 999
    s = n.to-str()
    print(s); 期望: 999
}

; ===== u64 → str =====
test-u64-to-str = () {
    n u64 = 12345
    s = n.to-str()
    print(s); 期望: 12345
}

; ===== f64 → str =====
test-f64-to-str = () {
    f = 3.14
    s = f.to-str()
    print(s); 期望: 3.14

    f = 0.0
    s = f.to-str()
    print(s); 期望: 0
}

; ===== f32 → str =====
test-f32-to-str = () {
    f f32 = 3.14
    s = f.to-str()
    print(s); 期望: 3.14

    z f32 = 0.0
    s = z.to-str()
    print(s); 期望: 0
}

; ===== bool → str =====
test-bool-to-str = () {
    b = true
    s = b.to-str()
    print(s); 期望: true

    b = false
    s = b.to-str()
    print(s); 期望: false
}

; ===== byte → str =====
test-byte-to-str = () {
    b byte = 65
    s = b.to-str()
    print(s); 期望: 65

    b = 0
    s = b.to-str()
    print(s); 期望: 0
}

; ===== 往返: i64 → str → i64 =====
test-roundtrip-i64 = () {
    n0 = 12345
    s = n0.to-str()
    n = s.to-i64()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> print(n); 期望: 12345
    }
}

; ===== 往返: f64 → str → f64 =====
test-roundtrip-f64 = () {
    f = '3.14'.to-f64()
    {
        f == nil -> print('nil')

        f == err -> print('err')

        -> print(f); 期望: 3.14
    }
}

; ===== 邊界: i64 極值 =====
test-edge-i64 = () {
    n = 9223372036854775807
    s = n.to-str()
    print(s); 期望: 9223372036854775807

    s = (-9223372036854775807 - 1).to-str()
    print(s); 期望: -9223372036854775808
}

; ===== str → []byte (from-hex) =====
test-from-hex-odd = () {
    b = 'abc'.from-hex()
    {
        b == nil -> print('nil')

        b == err -> {
            print('err - odd length'); 期望: err
        }

        -> print('unexpected ok')
    }
}

; 測試 from-hex-even
test-from-hex-even = () {
    b = '6162'.from-hex()
    b: {
        nil -> print('nil')

        err -> print('err')

        -> {
            print(it[0]); 期望: 97 (0x61 'a')
            print(it[1]); 期望: 98 (0x62 'b')
        }
    }
}

; ===== str → f32 =====
test-to-f32-valid = () {
    f = '3.14'.to-f32()
    {
        f == nil -> print('nil')

        f == err -> print('err')

        -> print('ok'); 期望: ok (非 nil/err)
    }
}

; 測試 to-f32-invalid
test-to-f32-invalid = () {
    f = 'abc'.to-f32()
    {
        f == nil -> print('nil'); 期望: nil 或 err

        f == err -> print('err'); 期望: nil 或 err

        -> print('unexpected ok')
    }
}

; ===== 運行測試 =====
test-str-to-i64()
test-str-to-i32()
test-str-to-i16()
test-str-to-i8()
test-str-to-u64()
test-str-to-f64()
test-str-to-bool()
test-str-to-byte()
test-i64-to-str()
test-i32-to-str()
test-u64-to-str()
test-f64-to-str()
test-f32-to-str()
test-bool-to-str()
test-byte-to-str()
test-roundtrip-i64()
test-roundtrip-f64()
test-edge-i64()
test-from-hex-odd()
test-from-hex-even()
test-to-f32-valid()
test-to-f32-invalid()
