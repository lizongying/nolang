; 無色 async：`go` 關鍵字會單態化出 worker-async，並與同步版本共存。
;
; 覆蓋：
;   - coroutine group 內的 `go` 並發（b、c 重疊執行）
;   - 同步呼叫 worker(10) 與 `co worker(...)` 共存（worker 與 worker-async 兩個方法）
;   - 傳遞性：worker-with-child 內部 `co child` → 自動生成 child-async
;
; 期望輸出：a=11 b=21 c=31 d=55
worker = (n i64) (r i64) {
    #{overflow=wrap}
    r = n + 1
}
child = (n i64) (r i64) {
    #{overflow=wrap}
    r = n * 10
}
; worker 內部呼叫異步 child：worker 因此也被單態為 worker-async（傳遞性）
worker-with-child = (n i64) (r i64) {
    #{overflow=wrap}
    c i64
    c = co child(n)
    #{overflow=wrap}
    r = n + c
}
main = () {
    a i64
    b i64
    c i64
    d i64
    a = worker(10)                  ; 同步呼叫 -> 11
    {
        b = co worker(20)           ; 單態 worker-async -> 21
        c = co worker(30)           ; 單態 worker-async -> 31
    }
    d = co worker-with-child(5)     ; 5 + (5*10) = 55
    print('a=' + a.to-str() + ' b=' + b.to-str() + ' c=' + c.to-str() + ' d=' + d.to-str())
}
