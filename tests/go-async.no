; 無色 async：`awy { }` 協程組內的 `co` 啟動**過程**（被呼叫者不得有宣告回傳值），
; 由 MonomorphizeGo 單態出對應的 `-async` 變體，並與同步呼叫共存。
;
; 覆蓋：
;   - 協程組內的 `co` 並發（b、c 重疊執行）
;   - 同一個過程既被同步呼叫、又被 `co` 啟動（`bump-into` 與 `bump-into-async` 兩份）
;   - 傳遞性：`pair-into` 內部再 `co child-into` → 自動生成 `pair-into-async`
;
; 期望輸出：a=11 b=21 c=31 d=55

; n: 輸入值，本檔用 10 / 20 / 30 等呼叫
; r: n + 1（overflow 採 wrap）
add1 = (n i64) (r i64) {

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt = n + 1
        r-opt: {
            ok -> r = it

            ->
        }
    }
}

; n: 來源數值
; r: n * 10（#{overflow=wrap}）
mul10 = (n i64) (r i64) {

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt2 = n * 10
        r-opt2: {
            ok -> r = it

            ->
        }
    }
}

; 過程：把 add1(n) 送回通道再關閉。同一個過程既能同步呼叫、也能被 co 啟動。
; out: 結果通道（呼叫方建，容量 1）
; n: 來源數值
bump-into = (out chan[i64], n i64) {
    out <- add1(n)
    out.close()
}

; 過程：把 mul10(n) 送回通道
; out: 結果通道（呼叫方建，容量 1）
; n: 來源數值
child-into = (out chan[i64], n i64) {
    out <- mul10(n)
    out.close()
}

; 過程內部再 spawn 一個過程：本函式因此也被單態為 pair-into-async（傳遞性）
; out: 結果通道（呼叫方建，容量 1）
; n: 來源數值；送回 n + n*10
pair-into = (out chan[i64], n i64) {
    inner chan[i64] = with-cap(1)
    awy {
        co child-into(inner, n)
    }
    cv = 0
    <- inner: {
        ok -> cv = it

        -> {
        }
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt3 = n + cv
        r-opt3: {
            ok -> {
                out <- it
            }

            ->
        }
    }
    out.close()
}

; 從單值通道取一筆（生產者已 close，所以一輪 ok 後落到 nil 收尾）
; ch: 已關閉的結果通道
; r: 取到的值；一筆都沒有時回 0
take1 = (ch chan[i64]) (r i64) {
    r = 0
    <- ch: {
        ok -> r = it

        -> {
        }
    }
}

a i64
b i64
c i64
d i64

ch1 chan[i64] = with-cap(1)
ch2 chan[i64] = with-cap(1)
ch3 chan[i64] = with-cap(1)
ch4 chan[i64] = with-cap(1)

bump-into(ch1, 10); 同步呼叫同一過程 -> 11
a = take1(ch1)

awy {
    co bump-into(ch2, 20); 單態 bump-into-async -> 21
    co bump-into(ch3, 30); 單態 bump-into-async -> 31
}
b = take1(ch2)
c = take1(ch3)

awy {
    co pair-into(ch4, 5); 5 + (5*10) = 55
}
d = take1(ch4)

print('a=' - a.to-str() - ' b=' - b.to-str() - ' c=' - c.to-str() - ' d=' - d.to-str())
