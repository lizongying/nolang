// test-sha256-step19 — 測試冒號循環在函數內部
// # std/hash/sha256

my-fn = (data []byte) (hash [32]byte) {
    total-len i64 = 64
    padded []byte
    i = 0
    i < total-len: {
        padded[i] = 0
        i = i + 1
    }
    hash[0] = padded[0]
    hash[1] = padded[1]
}

main = () {
    print('start')
    msg []byte
    msg[0] = 0x61
    print('before my-fn')
    h [32]byte
    h = my-fn(msg)
    print('after my-fn')
    print(h[0])
    print(h[1])
    print('done')
}
