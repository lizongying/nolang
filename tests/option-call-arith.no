; option-call-arith.no — 值位 match 的主語是「呼叫參與的算術」時必須真正解包
;
; `n = data.len() - 1: { ok -> it  -> 0 }` 這類主語曾經恆得 0：option 算術主語
; 要在 resolveSubjectMatch 裡歸一化成 `__match_subj ?T = <orig>`（少了這步就沒有
; tag 比較、沒有 ok 臂的 `let it`），而歸一化的型別推斷只認「字面量 / 識別字 /
; 巢狀中綴」，**呼叫一律拒收** ⇒ 推不出 ⇒ 不歸一化 ⇒ 觀測值恆為兜底臂。
; 識別字形態（`len - 1`）早就被覆蓋，只有呼叫形態漏掉（test/README.md §5.2v）。
;
; ⚠️ 已知缺陷（未修）：值位 match 形態**不會**把運算元自己的 nil 往外傳 ——
; `n = v - 1: { ok -> it  -> 0 }`（v 是 ?i64 且已是 nil）當下得 -1 而不是 0。
; 需要失敗傳播時用塊形態 `?=`，它走的是守衛鏈，語意正確：
;
;   { n ?= v - 1 }: { err -> _  -> _ }
;
; 本檔只釘「ok 路徑取到真實值」與「位元運算要走 ?=」兩件事。

; name str: 檢查名稱
; got i64: 實際值
; want i64: 期望值
check = (name str, got i64, want i64) {
    {
        got == want -> print('ok: {name}')

        -> {
            print('fail: {name} got=[{got}] want=[{want}]')
            exit(1)
        }
    }
}

; 回傳 ?i64 的呼叫：供 call-opt 使用
;
; v ?i64: 要原樣帶出的 option
; out ?i64: 同一個 option
echo-opt = (v ?i64) (out ?i64) {
    out = v
}

; 1. 內建容器方法（回傳 i64）參與算術
;
; data []i64: 受測容器
; out i64: len - 1
call-sub = (data []i64) (out i64) {
    n = data.len() - 1: {
        ok -> it

        -> 0
    }
    out = n
}

; 2. 回傳 ?i64 的呼叫參與算術：payload 是 i64
;
; v ?i64: 傳給 echo-opt
; out i64: 解包後的值減一
call-opt = (v ?i64) (out i64) {
    n = echo-opt(v) - 1: {
        ok -> it

        -> 0
    }
    out = n
}

; 3. 兩側都是呼叫
;
; a []i64: 被減數
; b []i64: 減數
; out i64: 兩個長度相減
call-diff = (a []i64, b []i64) (out i64) {
    n = a.len() - b.len(): {
        ok -> it

        -> 0
    }
    out = n
}

; 4. 位元運算：`&` 不是 option 算術（D6 只含 `+ - * / %`），
;    寫成值位 match 會把純量當標籤比對、永遠走兜底臂，必須用 ?=。
;
; data []i64: 受測容器
; out i64: (-len) & 3
pad-bits = (data []i64) (out i64) {
    pad = 0
    {
        pad ?= (0 - data.len()) & 0x3
    }: {
        err -> _

        -> _
    }
    out = pad
}

data []i64
data.push(1)
data.push(2)
data.push(3)

other []i64
other.push(9)

check('call-sub', call-sub(data), 2)
check('call-opt', call-opt(ok(5)), 4)
check('call-diff', call-diff(data, other), 2)
check('pad-bits', pad-bits(data), 1)
print('option-call-arith: all ok')
