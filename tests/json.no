; merged category 'json' -- members: json-crosspool-mutate.no, json.no
; (originals backed up under tests/_archive/json/)
; merged from tests/json-crosspool-mutate.no
; json-crosspool-mutate.no — KNOWN-BUG 最小複現（審計 §5.3）
;
; 状態：预期失败（expected-fail）。**故意不接入 CI**（CI 的 corpus-smoke 只 `build`
;       不 `run`，本檔可正常編譯；std-test 不引用本檔）。僅作為回歸锚點，
;       待 `src/std/json.no` 的跨池 builder 修複後，本檔應轉為全部 PASS。
;
; 複現的缺陷（baked bin/no @ adc925d4 實測）：
;   1. arr-push：把來自**另一個 pool** 的 json 值 push 進目標數組，返回 ok=true
;      但目標數組看不到該元素（子節點索引未 copy-tree 進目標池 → 悬空索引）。
;      源碼根因：src/std/json.no:1336 `arr-push = (val json){ ok = .arr-push-idx(val.root) }`
;      直接把 `val.root`（val 自己池里的索引）交給 `.pool.add-child`，缺跨池 copy-tree。
;   2. set-key / delete-key：對 `json.parse(...)` 建的接收者同樣靜默不改動。
;   3. （附注）對 `json.new()`（null 根 root=-1）調用 arr-push 會 SIGSEGV，
;      故本檔不複現崩溃路径，只锁死「靜默 no-op」這條可穩定觀測的路径。
;
; 執行：no run tests/json-crosspool-mutate.no
...

; case 1: 跨池 arr-push 應當讓目標數組增長
...
a = json.parse('[1,2]')
len-before = a.arr-len()
pushed = a.arr-push(json.parse('3'))
len-after = a.arr-len()
s-after = a.stringify()

print('case1 arr-push cross-pool:')
print('  push returned ok =', pushed, '(expect 1)')
print('  arr-len before/after =', len-before, '/', len-after, '(expect 2 / 3)')
print('  stringify =', s-after, '(expect [1,2,3])')
{
    len-after == 3 -> print('  => PASS')

    -> print('  => FAIL (KNOWN BUG §5.3: element lost, cross-pool index not copied)')
}

; case 2: set-key 對 parse 建的接收者應當新增键
...
o = json.parse('{"x":1}')
len-before2 = o.obj-len()
ok2 = o.set-key('y', json.parse('2'))
len-after2 = o.obj-len()
s2 = o.stringify()

print('case2 set-key on parse receiver:')
print('  set-key returned ok =', ok2, '(expect 1)')
print('  obj-len before/after =', len-before2, '/', len-after2, '(expect 1 / 2)')
print('  stringify =', s2, '(expect {"x":1,"y":2})')
{
    len-after2 == 2 -> print('  => PASS')

    -> print('  => FAIL (KNOWN BUG §5.3: key not visible on parse-built receiver)')
}

; case 3: delete-key 對 parse 建的接收者應當移除键
...
d = json.parse('{"a":1,"b":2}')
len-before3 = d.obj-len()
ok3 = d.delete-key('a')
len-after3 = d.obj-len()

print('case3 delete-key on parse receiver:')
print('  delete-key returned ok =', ok3, '(expect 1)')
print('  obj-len before/after =', len-before3, '/', len-after3, '(expect 2 / 1)')
{
    len-after3 == 1 -> print('  => PASS')

    -> print('  => FAIL (KNOWN BUG §5.3: key not removed on parse-built receiver)')
}

print('DONE — any FAIL above is the tracked §5.3 defect, not a new regression.')

; merged from tests/json.no
; json.no — JSON 模組測試
;
; 測試 json-pool 的剖析、存取、序列化功能。
; 本測試為純計算，不需網路，可實際執行。
...

print('start')

; ── 所有變數頂層宣告（遵循 http-no 慣例）──
json-str = '{"name":"Alice","age":30,"items":[1,2,3],"active":true}'
root = -1
next = 0
ok = false
val-idx = -1
found = false
str-val = ''
num-val = 0.0
bool-val = false
arr-idx = -1
n = 0
elem-idx = -1
out-buf = ''
out-n = 0
result = ''

; ── 測試 1: 剖析物件 ──
p = json-pool{}
p.init()
root, next, ok = p.parse(json-str, 0)
{
    ok -> print('ok: parse object')

    -> {
        print('fail: parse object')
        return
    }
}
name-opt = p.get-key(root, 'name')
name-opt: {
    ok -> {
        val-idx = it
        str-opt = p.get-str(val-idx)
        str-opt: {
            ok -> {
                str-val = it
                print('ok: name={str-val}')
            }

            -> print('fail: get-str name')
        }
    }

    -> print('fail: get-key name')
}
age-opt = p.get-key(root, 'age')
age-opt: {
    ok -> {
        val-idx = it
        num-opt = p.get-num(val-idx)
        num-opt: {
            ok -> {
                num-val = it

                ; 用比較驗證，避免 f64.to-str 的 codegen bug
                {
                    num-val == 30.0 -> print('ok: age=30')

                    -> print('fail: age should be 30')
                }
            }

            -> print('fail: get-num age')
        }
    }

    -> print('fail: get-key age')
}
items-opt = p.get-key(root, 'items')
items-opt: {
    ok -> {
        arr-idx = it
        n = p.arr-len(arr-idx)
        {
            n == 3 -> print('ok: items len=3')

            -> {
                print('fail: items len')
                print(n)
            }
        }
        elem-opt = p.arr-get(arr-idx, 0)
        elem-opt: {
            ok -> {
                elem-idx = it
                num-opt = p.get-num(elem-idx)
                num-opt: {
                    ok -> {
                        num-val = it
                        {
                            num-val == 1.0 -> print('ok: items[0]=1')

                            -> print('fail: items[0] should be 1')
                        }
                    }

                    -> print('fail: get-num items[0]')
                }
            }

            -> print('fail: arr-get items[0]')
        }
    }

    -> print('fail: get-key items')
}
active-opt = p.get-key(root, 'active')
active-opt: {
    ok -> {
        val-idx = it
        bool-opt = p.get-bool(val-idx)
        bool-opt: {
            ok -> {
                bool-val = it
                {
                    bool-val -> print('ok: active=true')

                    -> print('fail: active should be true')
                }
            }

            -> print('fail: get-bool active')
        }
    }

    -> print('fail: get-key active')
}

; ── 測試 6: stringify ──
; json-pool.stringify(node-idx) → str（舊的三參 out-buf 版本已移除）
result = p.stringify(root)
{
    result.len() > 0 -> print('ok: stringify={result}')

    -> print('fail: stringify')
}
ne-opt = p.get-key(root, 'nonexistent')
ne-opt: {
    ok -> print('fail: nonexistent key should not be found')

    -> print('ok: nonexistent key not found')
}
print('ok: all tests done')
