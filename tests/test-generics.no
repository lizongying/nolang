// test-generics.no — 驗證 Nolang 泛型概念
//
// Nolang 不支援隱式泛型型別參數（如 t），且函式內的比較運算子（== != > <）
// 有編譯器 bug 會回傳 false。故本測試改用：
// 1. 型別特定函式（gen-add-i64, gen-sub-i64 等）模擬泛型
// 2. 函式內只做算術（+ - *），比較在 main() 中進行
// 3. 相等判斷透過減法：a == b 等價於 (a - b) == 0

// ── i64 型別的「泛型」函式 ──

gen-add-i64 = (a i64, b i64) (r i64) {
    r = a + b
}

gen-sub-i64 = (a i64, b i64) (d i64) {
    d = a - b
}

gen-mul-i64 = (a i64, b i64) (r i64) {
    r = a * b
}

// ── i32 型別的「泛型」函式 ──

gen-add-i32 = (a i32, b i32) (r i32) {
    r = a + b
}

gen-sub-i32 = (a i32, b i32) (d i32) {
    d = a - b
}

// ── 1. gen-add-i64 加法 ──
r i64 = 0
r = gen-add-i64(40, 2)
if r == 42 {
    print('ok: gen-add-i64')
} else {
    print('fail: gen-add-i64')
}

// ── 2. gen-eq i64（透過 sub + == 0）──
d i64 = 0
d = gen-sub-i64(42, 42)
if d == 0 {
    print('ok: gen-eq i64 true')
} else {
    print('fail: gen-eq i64 true')
}

// ── 3. gen-ne i64（透過 sub + != 0）──
d = gen-sub-i64(42, 43)
if d != 0 {
    print('ok: gen-ne i64')
} else {
    print('fail: gen-ne i64')
}

// ── 4. gen-mul-i64 乘法 ──
r = gen-mul-i64(6, 7)
if r == 42 {
    print('ok: gen-mul-i64')
} else {
    print('fail: gen-mul-i64')
}

// ── 5. gen-add-i32 跨型別 ──
r32 i32 = 0
r32 = gen-add-i32(40, 2)
if r32 == 42 {
    print('ok: gen-add-i32')
} else {
    print('fail: gen-add-i32')
}

// ── 6. gen-eq i32（透過 sub + == 0）──
d32 i32 = 0
d32 = gen-sub-i32(100, 100)
if d32 == 0 {
    print('ok: gen-eq i32')
} else {
    print('fail: gen-eq i32')
}

