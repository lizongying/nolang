; test-x25519-struct — 測試 X25519 與結構體欄位
; # std/crypto/x25519

; key-holder: 測試用結構體，模擬 tls.server-conn 的欄位
key-holder {
    priv [32]byte
    pub [32]byte
}

; test-struct-field: 測試從結構體欄位讀取私鑰並計算公鑰
test-struct-field = () (pass bool) {
    pass = false

    kh = key-holder {}

    ; 內聯解析 Alice 的私鑰
    hex-str = '77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a'
    i <- [0..32): {
        hi = hex-str[i * 2]
        lo = hex-str[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        hi >= 48 && hi <= 57 -> hi-v = hi - 48
        hi >= 97 && hi <= 102 -> hi-v = hi - 87
        hi >= 65 && hi <= 70 -> hi-v = hi - 55
        lo >= 48 && lo <= 57 -> lo-v = lo - 48
        lo >= 97 && lo <= 102 -> lo-v = lo - 87
        lo >= 65 && lo <= 70 -> lo-v = lo - 55
        kh.priv[i] = (hi-v << 4) | lo-v
    }

    ; 從結構體欄位計算公鑰
    kh.pub = x25519.x25519-scalarmult-base(kh.priv)

    ; 驗證公鑰
    ; 預期: 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
    ; = [133, 32, 240, 9, 137, 48, 167, 84, 116, 139, 125, 220, 180, 62, 247, 90, 13, 191, 58, 13, 38, 56, 26, 244, 235, 164, 169, 142, 170, 155, 78, 106]
    expected = [
        133, 32, 240, 9, 137, 48, 167, 84,
        116, 139, 125, 220, 180, 62, 247, 90,
        13, 191, 58, 13, 38, 56, 26, 244,
        235, 164, 169, 142, 170, 155, 78, 106,
    ]

    eprint('Struct field test pub:')
    i <- [0..32): {
        eprint(' ')
        eprint(kh.pub[i])
    }

    1
    i <- [0..32): {
        (kh.pub[i]) != expected[i] -> {
            0
            break
        }
    }

    0 -> {
        print('FAIL: struct field scalarmult-base mismatch')
        return
    }

    pass = true
}

; test-func-output: 測試從函數輸出參數取得 [32]byte 後傳給 scalarmult-base
; hex-to-bytes: 將 hex 字串轉為 [32]byte
hex-to-bytes = (hex-str str) (out [32]byte) {
    i <- [0..32): {
        hi = hex-str[i * 2]
        lo = hex-str[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        hi >= 48 && hi <= 57 -> hi-v = hi - 48
        hi >= 97 && hi <= 102 -> hi-v = hi - 87
        hi >= 65 && hi <= 70 -> hi-v = hi - 55
        lo >= 48 && lo <= 57 -> lo-v = lo - 48
        lo >= 97 && lo <= 102 -> lo-v = lo - 87
        lo >= 65 && lo <= 70 -> lo-v = lo - 55
        out[i] = (hi-v << 4) | lo-v
    }
}

test-func-output = () (pass bool) {
    pass = false

    alice-priv = hex-to-bytes('77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a')

    ; 驗證 alice-priv 本身是否正確
    eprint('alice-priv[0..7]: ')
    i <- [0..8): {
        eprint(alice-priv[i])
        eprint(' ')
    }

    ; 用函數輸出的 [32]byte 呼叫 scalarmult-base
    alice-pub = x25519.x25519-scalarmult-base(alice-priv)

    ; 驗證公鑰
    expected = [
        133, 32, 240, 9, 137, 48, 167, 84,
        116, 139, 125, 220, 180, 62, 247, 90,
        13, 191, 58, 13, 38, 56, 26, 244,
        235, 164, 169, 142, 170, 155, 78, 106,
    ]

    eprint('Func output test pub:')
    i <- [0..32): {
        eprint(' ')
        eprint(alice-pub[i])
    }

    1
    i <- [0..32): {
        (alice-pub[i]) != expected[i] -> {
            0
            break
        }
    }

    0 -> {
        print('FAIL: func output scalarmult-base mismatch')
        return
    }

    pass = true
}

main = () {
    p1 = test-struct-field()
    p1 == true -> print('PASS: struct-field scalarmult')
    p1 == false -> print('FAIL: struct-field scalarmult')

    p2 = test-func-output()
    p2 == true -> print('PASS: func-output scalarmult')
    p2 == false -> print('FAIL: func-output scalarmult')
}
