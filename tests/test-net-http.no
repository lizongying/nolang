// test-net-http.no — HTTP 客戶端測試
//
// 本測試為 vet-only，需要實際 HTTP 伺服器才能執行。
// 測試 http-do、http-get、http-post 及 URL 解析。


// 測試 1: http-response 結構體
r http-response = http-response{}
r.status-code = 200
r.status-text = 'OK'
r.headers = 'Content-Type: text/html'
r.body = '<html></html>'
{
    r.status-code == 200 -> print('ok: http-response struct')
    -> print('fail: http-response struct')
}

// 測試 2: http-get（需要網路連線，僅驗證語法）
resp = http.http-get('http://example.com/')
resp: {
    nil -> print('skip: http-get (no network)')
    -> {
        print('ok: http-get connected')
        print(it.status-code)
        print(it.status-text)
        print(it.body)
    }
}

// 測試 3: http-post（需要網路連線，僅驗證語法）
resp2 = http.http-post('http://example.com/api', '{"key":"value"}')
resp2: {
    nil -> print('skip: http-post (no network)')
    -> print('ok: http-post connected')
}

// 測試 4: http-do 一般請求
resp3 = http.http-do('PUT', 'http://example.com/item', 'data')
resp3: {
    nil -> print('skip: http-do (no network)')
    -> print('ok: http-do connected')
}

// 測試 5: 帶埠號的 URL
resp4 = http.http-get('http://localhost:8080/path')
resp4: {
    nil -> print('skip: http-get with port (no server)')
    -> print('ok: http-get with port')
}

print('ok: all tests done')
