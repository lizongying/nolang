test-struct {
    result i64
}

; 方法分派的最小復現：按 quant 逐值比對寫入 .result，其餘值落到 99
; quant i64: 要分派的數量，0 / 42 / 43 / 63 有專門分支
test-struct.dispatch = (quant i64) {
    {
        quant == 0 -> .result = 0

        quant == 42 -> .result = 42

        quant == 43 -> .result = 43

        quant == 63 -> .result = 63

        -> .result = 99
    }
}
t = test-struct {
    result: 0
}

t.dispatch(0)
r0 = t.result
print('dispatch(0) => {r0}')

t.dispatch(42)
r42 = t.result
print('dispatch(42) => {r42}')

t.dispatch(43)
r43 = t.result
print('dispatch(43) => {r43}')

t.dispatch(99)
r99 = t.result
print('dispatch(99) => {r99}')
