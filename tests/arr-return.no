; test-arr-return — 測試 [32]byte 陣列作為返回值是否正確
; 重現 X25519 中前 8 bytes 為零的 bug

; 填充 [32]byte 陣列，每個位置填入 i+1
; 測試函數返回的 [32]byte 是否正確
; out [32]byte: 第 i 個位元組為 (i + 1) & 255，前 8 bytes 不得為零
fill-bytes = () (out [32]byte) {
    i <- [0..32): {

        out[i] = (i + 1) & 255
    }
}

; 輸出填充好的 [32]byte
; out [32]byte: 第 i 個位元組為 (i + 100) & 255
fill-bytes-param = () (out [32]byte) {
    i <- [0..32): {

        out[i] = (i + 100) & 255
    }
}

; 測試直接返回 [32]byte：fill-bytes() 的返回值直接接到 arr
; pass bool: true=arr[0..8) 依序為 1..8；false=返回值丟失或錯位
test-direct-return = () (pass bool) {
    pass = false

    ; 呼叫 fill-bytes，應返回 [1,2,3,...,32]
    arr [32]byte
    arr = fill-bytes()

    ; 檢查前 8 bytes 是否為 1..8
    i <- [0..8): {

        expected = (i + 1) & 255
        arr[i] != expected -> {
            print('FAIL: direct return byte mismatch at index')
            eprint('  index=')
            eprint(i)
            eprint('  expected=')
            eprint(expected)
            eprint('  got=')
            eprint(arr[i])
            return
        }
    }

    ; 打印所有 bytes 用於 debug
    hex = ''
    i <- [0..32): {

        hex = hex - (arr[i]).to-str() - ' '
    }
    eprint('direct return bytes:')
    eprint(hex)

    pass = true
}

; 測試通過參數填充 [32]byte：fill-bytes-param() 在函式內寫入 out 再回傳
; pass bool: true=arr[0..8) 依序為 100..107（i+100）；false=寫入未回到呼叫端
test-param-pass = () (pass bool) {
    pass = false

    arr [32]byte
    arr = fill-bytes-param()

    ; 檢查前 8 bytes
    i <- [0..8): {

        expected = (i + 100) & 255
        arr[i] != expected -> {
            print('FAIL: param pass byte mismatch at index')
            eprint('  index=')
            eprint(i)
            eprint('  expected=')
            eprint(expected)
            eprint('  got=')
            eprint(arr[i])
            return
        }
    }
    pass = true
}

; main
p1 = test-direct-return()
{
    p1 == true -> print('PASS: direct return')

    p1 == false -> print('FAIL: direct return')
}
p2 = test-param-pass()
{
    p2 == true -> print('PASS: param pass')

    p2 == false -> print('FAIL: param pass')
}
