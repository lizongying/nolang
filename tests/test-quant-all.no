// 測試所有量詞
; # std/regexp
print('=== quantifier tests ===')

// * 測試
m1 = regexp.regexp-match('a*', 'aaa')
print('a* vs aaa: {m1}')

m1b = regexp.regexp-match('a*', 'bbb')
print('a* vs bbb (empty match): {m1b}')

// + 測試
m2 = regexp.regexp-match('a+', 'aaa')
print('a+ vs aaa: {m2}')

m2b = regexp.regexp-match('a+', 'bbb')
print('a+ vs bbb (no match): {m2b}')

// ? 測試
m3 = regexp.regexp-match('a?', 'a')
print('a? vs a: {m3}')

m3b = regexp.regexp-match('a?', 'b')
print('a? vs b (empty match): {m3b}')

// .+ 測試
m4 = regexp.regexp-match('.+', 'abc')
print('.+ vs abc: {m4}')

// .* 測試
m5 = regexp.regexp-match('.*', 'abc')
print('.* vs abc: {m5}')

// dump a? 的指令
print('')
print('=== a? compiled ===')
re3 = regexp{
    pattern: 'a?'
}
re3.compile()
print('n =', re3.n)
i <- [0..re3.n): {
    op = re3.op[i]
    a1 = re3.arg1[i]
    a2 = re3.arg2[i]
    op == 1 -> print(i, ': CHAR', a1)
    op == 2 -> print(i, ': ANY')
    op == 3 -> print(i, ': CLASS', a1)
    op == 7 -> print(i, ': JUMP', a1)
    op == 8 -> print(i, ': SPLIT', a1, ',', a2)
    op == 9 -> print(i, ': MATCH')
}

print('')
print('=== .* compiled ===')
re5 = regexp{
    pattern: '.*'
}
re5.compile()
print('n =', re5.n)
i <- [0..re5.n): {
    op = re5.op[i]
    a1 = re5.arg1[i]
    a2 = re5.arg2[i]
    op == 1 -> print(i, ': CHAR', a1)
    op == 2 -> print(i, ': ANY')
    op == 3 -> print(i, ': CLASS', a1)
    op == 7 -> print(i, ': JUMP', a1)
    op == 8 -> print(i, ': SPLIT', a1, ',', a2)
    op == 9 -> print(i, ': MATCH')
}
