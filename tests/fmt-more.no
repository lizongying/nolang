; fmt-more — 合併自同簇 fmt/to-str/format 小件（heavy dedup）
;
; 每個原件整段包成函式（頂層語義在函式內等價，格式插值讀區域變數照舊），末尾依序呼叫。
; 保留獨立（併入風險高／原樣最妥）：
;   fmt-heuristic(hir_subform_coverage_test)、print-int-named-format(checker.go)、
;   fmt-field-chain / print-eprint-to-str(含模組級 struct 型別宣告)、
;   format-concat-fold / format-plain(頂層未加括號的 `cond -> / -> else`，包進函式會破解析)。
;
; ── from tests/fmt-helpers.no ──
fmh-run = () {
    ; fmt-helpers.no — 測試 fmt-parse-spec/fmt-apply-spec/fmt-int/fmt-uint/fmt-f64/fmt-str/fmt-bool/fmt-uint-base
    ; 注意：因編譯器 bug（print 直接接收函數返回值時 @print 未宣告），
    ; 所有用例先將結果賦值給變數再 print。
    ; 為了讓填充空白可見，部分用例以 '[' 與 ']' 包夾輸出。

    print('=== fmt-parse-spec ===')
    fill, align, sign, alt, zero, width, grouping, precision, typ = fmt.fmt-parse-spec('<+08.2f')
    print(fill)
    print(align)
    print(sign)
    print(alt)
    print(zero)
    print(width)
    print(grouping)
    print(precision)
    print(typ)
    print()

    print('=== fmt-apply-spec ===')
    s = fmt.fmt-apply-spec('42', 32, 0, 5)

    print('[{s}]')
    s = fmt.fmt-apply-spec('42', 32, 60, 5)

    print('[{s}]')
    s = fmt.fmt-apply-spec('42', 32, 94, 5)

    print('[{s}]')
    s = fmt.fmt-apply-spec('42', 42, 94, 8)

    print('[{s}]')
    print()

    print('=== fmt-int ===')
    s = fmt.fmt-int(42, '')
    print(s)
    s = fmt.fmt-int(42, '5')

    print('[{s}]')
    s = fmt.fmt-int(42, '<5')

    print('[{s}]')
    s = fmt.fmt-int(42, '^5')

    print('[{s}]')
    s = fmt.fmt-int(42, '05')
    print(s)
    s = fmt.fmt-int(-42, '5')

    print('[{s}]')
    s = fmt.fmt-int(42, '+5')

    print('[{s}]')
    s = fmt.fmt-int(42, '*^8')
    print(s)
    s = fmt.fmt-int(0, '')
    print(s)
    s = fmt.fmt-int(-7, '03')
    print(s)
    print()

    print('=== fmt-uint-base ===')
    s = fmt.fmt-uint-base(255, 16, false)
    print(s)
    s = fmt.fmt-uint-base(255, 16, true)
    print(s)
    s = fmt.fmt-uint-base(255, 2, false)
    print(s)
    s = fmt.fmt-uint-base(255, 8, false)
    print(s)
    s = fmt.fmt-uint-base(0, 16, false)
    print(s)
    print()

    print('=== fmt-uint ===')
    s = fmt.fmt-uint(255, 'x')
    print(s)
    s = fmt.fmt-uint(255, 'X')
    print(s)
    s = fmt.fmt-uint(255, '#x')
    print(s)
    s = fmt.fmt-uint(255, 'b')
    print(s)
    s = fmt.fmt-uint(255, 'o')
    print(s)
    s = fmt.fmt-uint(255, '08x')
    print(s)
    s = fmt.fmt-uint(0, 'x')
    print(s)
    s = fmt.fmt-uint(4095, '#X')
    print(s)
    print()

    print('=== fmt-f64 ===')
    s = fmt.fmt-f64(3.14159, '.2f')
    print(s)
    s = fmt.fmt-f64(3.14159, '.4f')
    print(s)
    s = fmt.fmt-f64(12345.678, '.2e')
    print(s)
    s = fmt.fmt-f64(3.14159, '.3g')
    print(s)
    s = fmt.fmt-f64(3.14159, '')
    print(s)
    s = fmt.fmt-f64(-3.14, '8.2f')

    print('[{s}]')
    s = fmt.fmt-f64(3.14, '+.2f')
    print(s)
    s = fmt.fmt-f64(3.14, '08.2f')
    print(s)
    s = fmt.fmt-f64(0.0, '.2f')
    print(s)
    print()

    print('=== fmt-str ===')
    s = fmt.fmt-str('hello', '10')

    print('[{s}]')
    s = fmt.fmt-str('hello', '<10')

    print('[{s}]')
    s = fmt.fmt-str('hello', '.3')
    print(s)
    s = fmt.fmt-str('hello', '^10')

    print('[{s}]')
    s = fmt.fmt-str('hi', '')
    print(s)
    print()

    print('=== fmt-bool ===')
    s = fmt.fmt-bool(true, '')
    print(s)
    s = fmt.fmt-bool(false, '')
    print(s)
    s = fmt.fmt-bool(true, '6')

    print('[{s}]')
    s = fmt.fmt-bool(false, '<6')

    print('[{s}]')
}

; ── from tests/fmt-spec.no ──
fspec-run = () {
    pi = 3.14159
    print('pi = {pi:.2f}')
}

; ── from tests/named-format.no ──
nf-run = () {
    ; named-format.no — 測試具名字串格式 {name:spec}
    ;
    ; 驗證 print/eprint/format 支援 {name:spec} 語法，
    ; 並呼叫 fmt-int/fmt-uint/fmt-f64/fmt-str/fmt-bool 進行格式化。
    ; printf/eprintf/sprintf 已廢棄，改用 print/eprint/format；
    ; 若需輸出無換行符，可使用底層命令 io.out / io.err。

    ; 整數格式化
    x = 42
    print('x={x}')
    print('x={x:5}')
    print('x={x:<5}')
    print('x={x:^5}')
    print('x={x:05}')

    ; 負數
    n = -7
    print('n={n:03}')

    ; 無號整數（hex）
    u u64 = 255
    print('u={u:x}')
    print('u={u:X}')
    print('u={u:#x}')
    print('u={u:08x}')

    ; byte (u8)
    b byte = 65
    print('b={b}')

    ; 浮點數
    pi = 3.14159
    print('pi={pi:.2f}')
    print('pi={pi:.4f}')
    print('pi={pi:8.2f}')
    print('pi={pi:.3g}')
    print('pi={pi:.3e}')

    ; 字串
    s = 'hello'
    print('s={s:10}')
    print('s={s:<10}')
    print('s={s:.3}')
    print('s={s:^10}')

    ; 布林值
    flag = true
    print('flag={flag}')
    print('flag={flag:6}')

    ; 混合多個欄位
    print('x={x}, u={u:x}, pi={pi:.2f}, s={s}, flag={flag}')

    ; 字面文字含 {{ 與 }} 轉義
    print('literal {{x}}={x}')

    ; format 返回格式化字串（替代 sprintf）
    formatted = format('formatted: x={x}, pi={pi:.2f}')
    print(formatted)

    ; eprint（stderr，自動換行）
    eprint('err: x={x}')
    eprint('err-line')

    ; io.out / io.err：底層命令，輸出無換行符
    io.out('no-newline-here')
    io.out('\n')
}

fmh-run()
fspec-run()
nf-run()

; ── from format-vso.no — vso.tmp 型別不一致編譯探針（原檔只定義 test-fmt 不呼叫＝無輸出）──
fmvso-test-fmt = () {
    size = 42
    size-str = format('{size:8d}')
    print(size-str)
}
