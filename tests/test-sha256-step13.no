// test-sha256-step13 — []byte 參數 + [32]byte 返回
// # std/hash/sha256

my-fn = (data []byte) (hash [32]byte) {
    hash[0] = data[0]
    hash[1] = data[1]
    hash[2] = data[2]
}

main = () {
    print('start')
    msg []byte
    msg[0] = 0x61
    msg[1] = 0x62
    msg[2] = 0x63
    print('before my-fn')
    h [32]byte
    h = my-fn(msg)
    print('after my-fn')
    print(h[0])
    print('done')
}
