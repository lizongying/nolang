; index-compare — 索引讀取直接作為比較運算元（`a[i] == 5` / `s[0] == 'a'`）
;
; 語言契約（docs/docs/lang/syntax.md 〈安全索引〉）：
;   「對 arr / vec / slice / 定長陣列 / str / txt 的索引 v[i]，結果一律是 ?T：
;     越界時回傳 nil，在界內回傳 ok(值)，絕不會 abort。」
;
; 因此 `a[i] == 5` 是 **option 與字面量的比較**：比的是 payload，越界（nil）
; 永遠不等於任何字面量。修復前比較語境的 `a[i]` 走的是裸讀
; （MIR `index dst:i64`，沒有界檢查、沒有 nil），越界即讀野內存，實測
; `if a[oob] != 5 { … }` 會 SIGTRAP；`s[0] == 'a'` 則是 char payload 沒被取出，
; 退化成比判別值，恆為 false（同一個 bug 讓 `?char == 'a'` 也恆假）。
;
; 本檔是那兩個修復的回歸門禁：界內比對正確、越界確定性（不崩潰）、
; str / byte / `[]?T` 元素與 option-vs-字串字面量全部按 payload 比。

; expect：cond 必須為 true，否則 exit(code)。
; 避開 `->` 兩臂都跑的老問題（見 iter-place-write.no 的說明）。
expect = (cond bool, code i64) () {
    if cond {
        return
    }
    exit(code)
}

; reject：cond 必須為 false，否則 exit(code)。
reject = (cond bool, code i64) () {
    if cond {
        exit(code)
    }
}

; 1. 字面量下標，界內：`==` / `!=` 都必須正確
a []i64 = [5, 6, 7]
expect(a[0] == 5, 1)
reject(a[0] != 5, 2)
expect(a[1] == 6, 3)
reject(a[2] != 7, 4)
print('ok: literal subscript comparison')

; 2. 變量下標，界內
i i64 = 1
expect(a[i] == 6, 5)
i = 2
reject(a[i] != 7, 6)
print('ok: variable subscript comparison')

; 3. 越界：回 nil ⇒ 不等於任何字面量；且**不得崩潰**（修復前 SIGTRAP）
oob i64 = 9
expect(a[oob] != 5, 7)
reject(a[oob] == 5, 8)
; nil 的 payload 是零值，與 `?i64 == 0` 同語義（既有規則，不是本檔引入的）
expect(a[oob] == 0, 9)
print('ok: out-of-range read yields nil (no crash, never equal)')

; 4. 負下標同樣是越界
neg i64 = -1
expect(a[neg] != 5, 10)
expect(a[neg] == 0, 11)
print('ok: negative index is out of range')

; 5. 關係比較也要有界檢查（`<` 的兩側都是讀取/字面量）
expect(a[0] < a[1], 12)
expect(a[2] > a[1], 13)
expect(a[oob] < 6, 14)
print('ok: relational comparison')

; 6. 定長陣列
f [3]i64 = [9, 8, 7]
expect(f[0] == 9, 15)
expect(f[2] != 9, 16)
print('ok: fixed array element comparison')

; 7. str 下標：碼點讀取 vs 單字元字串字面量（char ↔ str 隱式轉換）
s str = 'abc'
expect(s[0] == 'a', 17)
reject(s[1] == 'a', 18)
expect(s[2] == 'c', 19)
soob i64 = 9
expect(s[soob] != 'a', 20)
print('ok: str code-point comparison')

; 8. `[]?T` 元素：元素本身就是 option，與純量比 payload
b []?i64 = [ok(5), nil, ok(7)]
expect(b[0] == 5, 21)
reject(b[1] == 5, 22)
expect(b[2] == 7, 23)
expect(b[1] == 0, 24)
print('ok: []?T element comparison')

; 9. byte / str 元素容器
c []byte = [65, 66]
expect(c[0] == 65, 25)
reject(c[1] == 65, 26)
d []str = ['aa', 'bb']
expect(d[0] == 'aa', 27)
reject(d[1] == 'aa', 28)
print('ok: byte and str element comparison')

; 10. place-match 寫入之後的比較（最初暴露此 bug 的場景）
e []i64 = [1, 2, 3]
e[0]: {
    ok -> it = 5
    -> {}
}
expect(e[0] == 5, 29)
reject(e[0] != 5, 30)
print('ok: comparison after a place-match write')

; 11. 讀-改-寫之後的比較（迭代形式）
g []i64 = [1, 2, 3]
x <- g: {
    x = x + 10
}
expect(g[0] == 11, 31)
expect(g[2] == 13, 32)
print('ok: comparison after a read-modify-write')

; 12. 綁定形式（顯式 plain / option）與直接比較同值
h []i64 = [4, 5]
plain i64 = h[0]
opt ?i64 = h[0]
expect(plain == 4, 33)
expect(h[0] == plain, 34)
expect(opt == h[0], 35)
print('ok: bound and direct forms agree')

; 13. 巢狀下標（`a[i][j]`）的比較：容器本身就是一次索引讀取。
; 這一格是回歸鎖 —— 給內層讀取加 option 提示會被容器 lowering 繼承下去，把外層
; 讀取的結果（`str`）再包一層（`?char`），內層於是對 `?char` 取 len/下標，
; 後端直接報 "lencap kind: len/cap unsupported on ?char"（src/std/net/http.no 的
; `.header-names[i][j] != name.byte(j)` 就是這個形狀）。巢狀比較維持既有 lowering。
tbl [2]str = ['ab', 'cd']
n i64 = 1
expect(tbl[n][0] == 'c', 36)
reject(tbl[n][0] != 'c', 37)
reject(tbl[0][0] == 'c', 38)
print('ok: nested subscript comparison')

print('index-compare OK')
