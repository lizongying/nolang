; index-compare — 索引讀取直接作為比較運算元（`a[i] == 5` / `s[0] == 'a'`）
;
; 語言契約（docs/docs/lang/syntax.md 〈安全索引〉）：
;   「對 arr / vec / slice / 定長陣列 / str / txt 的索引 v[i]，結果一律是 ?T：
;     越界時回傳 nil，在界內回傳 ok(值)，絕不會 abort。」
;
; 因此 `a[i] == 5` 是 **option 與字面量的比較**：比的是 payload，越界（nil）
; 永遠不等於任何字面量。修復前比較語境的 `a[i]` 走的是裸讀
; （MIR `index dst:i64`，沒有界檢查、沒有 nil），越界即讀野內存，實測
; `if a[oob] != 5 { … }` 會 SIGTRAP；`s[0] == 'a'` 則是 char payload 沒被取出，
; 退化成比判別值，恆為 false（同一個 bug 讓 `?char == 'a'` 也恆假）。
;
; 本檔是那兩個修復的回歸門禁：界內比對正確、越界確定性（不崩潰）、
; str / byte / `[]?T` 元素與 option-vs-字串字面量全部按 payload 比。

; expect：cond 必須為 true，否則 exit(code)。
; 避開 `->` 兩臂都跑的老問題（見 iter-place-write.no 的說明）。
expect = (cond bool, code i64) {
    if cond {
        return
    }
    exit(code)
}

; reject：cond 必須為 false，否則 exit(code)。
reject = (cond bool, code i64) {
    if cond {
        exit(code)
    }
}

; 1. 字面量下標，界內：`==` / `!=` 都必須正確
a = [5, 6, 7]
expect(a[0] == 5, 1)
reject(a[0] != 5, 2)
expect(a[1] == 6, 3)
reject(a[2] != 7, 4)
print('ok: literal subscript comparison')

; 2. 變量下標，界內
i = 1
expect(a[i] == 6, 5)
i = 2
reject(a[i] != 7, 6)
print('ok: variable subscript comparison')

; 3. 越界：回 nil ⇒ 不等於任何字面量；且**不得崩潰**（修復前 SIGTRAP）
oob = 9
expect(a[oob] != 5, 7)
reject(a[oob] == 5, 8)

; nil 的 payload 是零值，與 `?i64 == 0` 同語義（既有規則，不是本檔引入的）
expect(a[oob] == 0, 9)
print('ok: out-of-range read yields nil (no crash, never equal)')

; 4. 負下標同樣是越界
neg = -1
expect(a[neg] != 5, 10)
expect(a[neg] == 0, 11)
print('ok: negative index is out of range')

; 5. 關係比較也要有界檢查（`<` 的兩側都是讀取/字面量）
expect(a[0] < a[1], 12)
expect(a[2] > a[1], 13)
expect(a[oob] < 6, 14)
print('ok: relational comparison')

; 6. 定長陣列
f [3]i64 = [9, 8, 7]
expect(f[0] == 9, 15)
expect(f[2] != 9, 16)
print('ok: fixed array element comparison')

; 7. str 下標：碼點讀取 vs 單字元字串字面量（char ↔ str 隱式轉換）
s = 'abc'
expect(s[0] == 'a', 17)
reject(s[1] == 'a', 18)
expect(s[2] == 'c', 19)
soob = 9
expect(s[soob] != 'a', 20)
print('ok: str code-point comparison')

; 8. `[]?T` 元素：元素本身就是 option，與純量比 payload
b []?i64 = [ok(5), nil, ok(7)]
expect(b[0] == 5, 21)
reject(b[1] == 5, 22)
expect(b[2] == 7, 23)
expect(b[1] == 0, 24)
print('ok: []?T element comparison')

; 9. byte / str 元素容器
c []byte = [65, 66]
expect(c[0] == 65, 25)
reject(c[1] == 65, 26)
d = [
    'aa',
    'bb',
]
expect(d[0] == 'aa', 27)
reject(d[1] == 'aa', 28)
print('ok: byte and str element comparison')

; 10. place-match 寫入之後的比較（最初暴露此 bug 的場景）
e = [1, 2, 3]
e[0]: {
    ok -> it = 5

    -> {
    }
}
expect(e[0] == 5, 29)
reject(e[0] != 5, 30)
print('ok: comparison after a place-match write')

; 11. 讀-改-寫之後的比較（迭代形式）
g = [1, 2, 3]
x <- g: {
    x = x + 10
}
expect(g[0] == 11, 31)
expect(g[2] == 13, 32)
print('ok: comparison after a read-modify-write')

; 12. 綁定形式（顯式 plain / option）與直接比較同值
h = [4, 5]
plain i64 = h[0]
opt ?i64 = h[0]
expect(plain == 4, 33)
expect(h[0] == plain, 34)
expect(opt == h[0], 35)
print('ok: bound and direct forms agree')

; 13. 巢狀下標（`a[i][j]`）的比較：容器本身就是一次索引讀取。
; 兩層都必須是安全讀取：外層 `tbl[n]` → `?str`（界檢查 + 存在性判斷），
; 內層 `outer[0]` → `?char`。這一格是回歸鎖，釘住兩種壞形態：
;   (a) 提示被容器 lowering 繼承 ⇒ 內層對 `?char` 取 len/下標，後端報
;       "lencap kind: len/cap unsupported on ?char"（src/std/net/http.no 的
;       `.header-names[i][j] != name.byte(j)` 就是這個形狀）；
;   (b) 兩層都裸讀 ⇒ 越界直接 SIGTRAP（見第 14 節）。
tbl [2]str = ['ab', 'cd']
n = 1
expect(tbl[n][0] == 'c', 36)
reject(tbl[n][0] != 'c', 37)
reject(tbl[0][0] == 'c', 38)
print('ok: nested subscript comparison')

; 14. 巢狀下標越界：兩層都帶界檢查，越界回傳 nil（絕不 abort）。
; 修復前這裡是裸讀，`tbl[nest-oob][0]` 直接讀野內存。
nest-oob = 5
reject(tbl[nest-oob][0] == 'c', 39)
expect(tbl[nest-oob][0] != 'c', 40)
expect(tbl[n][nest-oob] != 'a', 41)
print('ok: nested subscript out of range yields nil')

; 15. `?txt == txt`：txt 是 { [255 x i8], i8 } 聚合，payload 型別必須是 %txt，
; 否則 option 的載荷被當成 i64（判別值比較 + 讀錯位元組，實測 SIGSEGV / 恆假）。
; %txt 有 256 位元組，超過 option 的 24 位元組載荷槽 ⇒ 一律走堆上 BOXED 載荷。
t txt = 'hello'
ot ?txt = t
expect(ot == t, 42)
reject(ot != t, 43)
other txt = 'hello!'
reject(ot == other, 44)

; 長字串（> 255 會被截斷，這裡取 40）確認 boxed 載荷的長度前綴也正確。
lt txt = 'the-quick-brown-fox-jumps-over-a-lazy-dog'
olt ?txt = lt
expect(olt == lt, 54)
reject(olt == t, 55)

; option 對 option：比的是載荷，不是判別值
otx ?txt = t
expect(ot == otx, 60)
reject(olt == otx, 61)
print('ok: ?txt compares its txt payload')

; 16. 容器元素的比較：`[]T == []T` 走結構比較（先比長度、再比元素）。
; 修復前 emitCmp 對 %vec 發出 `icmp eq %vec`，LLVM 直接拒絕
; （"icmp requires integer operands"）—— 連編譯都過不了。
va = [1, 2]
vb = [1, 2]
vc = [1, 3]
vd = [1, 2, 3]
expect(va == vb, 45)
reject(va == vc, 46)
reject(va == vd, 47)
expect(va != vc, 48)

; 元素本身是容器（`[][]i64` 的元素是 `[]i64`）
m1 = [[1, 2], [3, 4]]
m2 = [[1, 2], [9, 9]]
expect(m1[0] == m2[0], 49)
reject(m1[1] == m2[1], 50)
reject(m1 == m2, 51)

; 元素是 str：必須比內容，不是比 data 指標
sa = [
    'ab',
    'cd',
]
sb = [
    'ab',
    'cd',
]
sc = [
    'ab',
    'ce',
]
expect(sa == sb, 52)
reject(sa == sc, 53)
print('ok: container equality is structural')

; 17. txt 下標的碼點比較：`t[0]` 與 `str` 下標一樣是**碼點**（checker 也這麼判：
; `b byte = t[0]` 會被拒為 "cannot assign char value to byte"）。
; 修復前比較語境把它定型成 `?i8`（後端載入的原始位元組），於是 `t[0] == 'c'`
; 把 99 渲染成十進位文字 "99" 去比 "c" —— **靜默為假**，沒有任何診斷。
ttxt txt = 'cd'
expect(ttxt[0] == 'c', 56)
reject(ttxt[0] == 'd', 57)
expect(ttxt[0] == 99, 58)
reject(ttxt[1] == 'c', 59)
print('ok: txt code-point comparison')

print('index-compare OK')
