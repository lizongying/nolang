# std/json - 測試鏈式存取

json-value {
    kind i64
    str-val str
    num-val f64
    bool-val i64
    children [16]i64
    keys [16]str
    count i64
}

json-pool {
    nodes [4]json-value
    count i64
}

KIND-NULL = 0
KIND-STR = 3
KIND-OBJ = 5

json-pool.init = () {
    .count = 0
    i = 0
    for i < 4 {
        .nodes[i].count = 0
        .nodes[i].kind = KIND-NULL
        .nodes[i].str-val.len = 0
        j = 0
        for j < 16 {
            .nodes[i].keys[j].len = 0
            j = j + 1
        }
        i = i + 1
    }
}

json-pool.alloc = () (idx i64) {
    idx = -1
    if .count >= 4 {
        return
    }
    idx = .count
    .count = .count + 1
    .nodes[idx].count = 0
    .nodes[idx].kind = KIND-NULL
    .nodes[idx].str-val.len = 0
}

main = () {
    print('start')
    p = json-pool{}
    p.init()

    node-idx i64 = 0
    key-idx i64 = 0

    node-idx = p.alloc()
    key-idx = p.alloc()

    p.nodes[key-idx].kind = KIND-STR
    p.nodes[key-idx].str-val.len = 1
    p.nodes[key-idx].str-val[0] = 97

    print('before copy')

    cnt i64 = 0
    p.nodes[node-idx].keys[cnt].len = p.nodes[key-idx].str-val.len
    print('set len ok')
    j i64 = 0
    for j < p.nodes[key-idx].str-val.len {
        p.nodes[node-idx].keys[cnt][j] = p.nodes[key-idx].str-val[j]
        j = j + 1
    }
    print('copy ok')

    val i64 = p.nodes[node-idx].keys[cnt][0]
    print('val=')
    print(val)
}
main()
