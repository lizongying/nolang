// 測試鏈式存取

json-kind {
    null,
    bool,
    num,
    str,
    arr,
    obj,
}

json-value {
    kind json-kind
    str-val str
    num-val f64
    bool-val bool
    children [16]i64
    keys [16]str
    count i64
}

json-pool {
    nodes [4]json-value
    count i64
}

json-pool.init = () {
    .count = 0
    i <- [0..4): {
        .nodes[i].count = 0
        .nodes[i].kind = json-kind.null
        .nodes[i].str-val.len = 0
        j <- [0..16): {
            .nodes[i].keys[j].len = 0
        }
    }
}

json-pool.alloc = () (idx i64) {
    idx = -1
    if .count >= 4 {
        return
    }
    idx = .count
    .count = .count + 1
    .nodes[idx].count = 0
    .nodes[idx].kind = json-kind.null
    .nodes[idx].str-val.len = 0
}

main = () {
    print('start')
    p = json-pool{}
    p.init()

    node-idx i64 = 0
    key-idx i64 = 0

    node-idx = p.alloc()
    key-idx = p.alloc()

    p.nodes[key-idx].kind = json-kind.str
    p.nodes[key-idx].str-val.len = 1
    p.nodes[key-idx].str-val[0] = 97

    print('before copy')

    cnt i64 = 0
    p.nodes[node-idx].keys[cnt].len = p.nodes[key-idx].str-val.len
    print('set len ok')
    j <- [0..p.nodes[key-idx].str-val.len): {
        p.nodes[node-idx].keys[cnt][j] = p.nodes[key-idx].str-val[j]
    }
    print('copy ok')

    val i64 = p.nodes[node-idx].keys[cnt][0]
    print('val=')
    print(val)
}
main()
