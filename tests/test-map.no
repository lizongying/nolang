// test-map.no — 測試 map 關鍵字與 hashmap 實作

# std/map/map

test-map-str-i64 = () {
    m map[str]i64 = { 'a':0, 'b':1 }
    m.put('c', 2)

    v = m.get('a')
    v: {
        ok -> print(it)  // expect: 0
    }

    v = m.get('c')
    v: {
        ok -> print(it)  // expect: 2
    }
}

test-map-str-i64()
