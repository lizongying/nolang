; i8-debug2.no — 調試 i8.MIN/MAX 直接訪問
test1 = () {
    -128 == -128 -> print('-128 == -128 ok') -> print('-128 == -128 bad')
}

; 讀取 i8.MIN：-128 經型別映射取回仍須是 -128（不得因字面量邊界變成 127）
test2 = () {

    ; 嘗試訪問 i8.MIN
    m = i8.MIN
    {
        m == -128 -> print('i8.MIN access ok')

        -> print('i8.MIN access bad')
    }
    print(m)
}

; 讀取 i8.MAX：127 須原樣取回（與 MIN 分開，避免一個錯掩蓋另一個）
test3 = () {

    ; 嘗試訪問 i8.MAX
    m = i8.MAX
    {
        m == 127 -> print('i8.MAX access ok')

        -> print('i8.MAX access bad')
    }
    print(m)
}
test1()
test2()
test3()
