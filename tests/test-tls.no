; test-tls — TLS 1.2 客戶端測試
; # std/net/tls

; test-tls-put-u16: 測試 16-bit 大端序寫入
test-tls-put-u16 = () {
    buf []byte
    tls.tls-put-u16(buf, 0, 0x1234)
    buf[0] != 0x12 -> {
        print('FAIL: expected 0x12')
        return
    }
    buf[1] != 0x34 -> {
        print('FAIL: expected 0x34')
        return
    }
    print('PASS: tls-put-u16')
}

; test-tls-get-u16: 測試 16-bit 大端序讀取
test-tls-get-u16 = () {
    buf []byte = with-cap(2)
    buf[0] = 0xAB
    buf[1] = 0xCD
    val i64 = 0
    val = tls.tls-get-u16(buf, 0)
    val != 0xABCD -> {
        print('FAIL: expected 0xABCD')
        return
    }
    print('PASS: tls-get-u16')
}

; test-tls-put-u24: 測試 24-bit 大端序寫入
test-tls-put-u24 = () {
    buf []byte
    tls.tls-put-u24(buf, 0, 0x123456)
    buf[0] != 0x12 -> {
        print('FAIL: expected 0x12')
        return
    }
    buf[1] != 0x34 -> {
        print('FAIL: expected 0x34')
        return
    }
    buf[2] != 0x56 -> {
        print('FAIL: expected 0x56')
        return
    }
    print('PASS: tls-put-u24')
}

; test-tls-get-u24: 測試 24-bit 大端序讀取
test-tls-get-u24 = () {
    buf []byte = with-cap(3)
    buf[0] = 0x12
    buf[1] = 0x34
    buf[2] = 0x56
    val i64 = 0
    val = tls.tls-get-u24(buf, 0)
    val != 0x123456 -> {
        print('FAIL: expected 0x123456')
        return
    }
    print('PASS: tls-get-u24')
}

; test-tls-bytes-cat: 測試位元組陣列串接
test-tls-bytes-cat = () {
    a []byte = with-cap(3)
    a[0] = 1
    a[1] = 2
    a[2] = 3
    b []byte = with-cap(2)
    b[0] = 4
    b[1] = 5
    out []byte
    out = tls.tls-bytes-cat(a, b)
    out.len != 5 -> {
        print('FAIL: expected out.len=5')
        return
    }
    out[0] != 1 -> {
        print('FAIL: expected out[0]=1')
        return
    }
    out[3] != 4 -> {
        print('FAIL: expected out[3]=4')
        return
    }
    print('PASS: tls-bytes-cat')
}

; test-tls-bytes-to-bn: 測試 big-endian 位元組 → 大整數轉換
test-tls-bytes-to-bn = () {
    data []byte = with-cap(4)
    data[0] = 0x01
    data[1] = 0x02
    data[2] = 0x03
    data[3] = 0x04
    out []i64
    out = tls.tls-bytes-to-bn(data)

    ; 4 bytes → 1 limb
    out.len != 1 -> {
        print('FAIL: expected out.len=1')
        return
    }

    ; little-endian base 2^32: 0x01020304
    out[0] != 0x01020304 -> {
        print('FAIL: expected 0x01020304')
        return
    }
    print('PASS: tls-bytes-to-bn')
}

; test-tls-bn-to-bytes: 測試大整數 → big-endian 位元組轉換
test-tls-bn-to-bytes = () {
    num []i64 = with-cap(1)
    num[0] = 0x01020304
    out []byte
    out = tls.tls-bn-to-bytes(num)

    ; 1 limb → 4 bytes, then strip leading zeros (0x01 is not zero)
    out.len != 4 -> {
        print('FAIL: expected out.len=4')
        return
    }
    out[0] != 0x01 -> {
        print('FAIL: expected out[0]=0x01')
        return
    }
    out[3] != 0x04 -> {
        print('FAIL: expected out[3]=0x04')
        return
    }
    print('PASS: tls-bn-to-bytes')
}

; test-tls-rand-bytes: 測試隨機位元組生成
test-tls-rand-bytes = () {
    state i64 = 12345
    out []byte
    out = tls.tls-rand-bytes(state, 16)

    ; 驗證長度（透過檢查不崩潰即可）
    i <- [0..16): {
        out[i] < 0 -> {
            print('FAIL: negative byte')
            return
        }
    }
    print('PASS: tls-rand-bytes')
}

; test-tls-prf: 測試 TLS PRF（P_SHA256）
test-tls-prf = () {
    secret []byte = with-cap(4)
    secret[0] = 1
    secret[1] = 2
    secret[2] = 3
    secret[3] = 4
    seed []byte = with-cap(3)
    seed[0] = 0xAA
    seed[1] = 0xBB
    seed[2] = 0xCC
    out []byte
    out = tls.tls-prf(secret, 'test label', seed, 32)

    ; PRF 輸出應為 32 bytes，驗證不為全零
    has-nonzero = 0
    i <- [0..32): {
        out[i] != 0 -> has-nonzero = 1
    }
    has-nonzero == 0 -> {
        print('FAIL: PRF output all zeros')
        return
    }
    print('PASS: tls-prf')
}

; test-tls-conn-init: 測試 tls-conn 初始化
test-tls-conn-init = () {
    c tls-conn
    c.init()
    c.connected != false -> {
        print('FAIL: expected connected=false')
        return
    }
    c.encrypted != false -> {
        print('FAIL: expected encrypted=false')
        return
    }
    c.fd != -1 -> {
        print('FAIL: expected fd=-1')
        return
    }
    c.write-seq != 0 -> {
        print('FAIL: expected write-seq=0')
        return
    }
    print('PASS: tls-conn-init')
}

; test-https-url-detection: 測試 http-do 的 https:// 偵測（編譯時驗證）
test-https-url-detection = () {
    ; 這個測試僅驗證 https:// URL 能被 http-do 接受（不會因 scheme 不匹配而 return）
    ; 實際網路連線需要真實伺服器，這裡只做編譯/vet 驗證
    ; 不實際呼叫，僅驗證型別檢查通過
    resp = http.http-do('GET', 'https://example.com/', '')
    resp != nil -> {
        print('FAIL: expected nil')
        return
    }
    print('PASS: https-url-detection')
}

; main: 執行所有測試
print('=== TLS Tests ===')
test-tls-put-u16()
print('1 done')
test-tls-get-u16()
print('2 done')
test-tls-put-u24()
print('3 done')
test-tls-get-u24()
print('4 done')
test-tls-bytes-cat()
print('5 done')
test-tls-bytes-to-bn()
print('6 done')
test-tls-bn-to-bytes()
print('7 done')
test-tls-rand-bytes()
print('8 done')
test-tls-prf()
print('9 done')
test-tls-conn-init()
print('10 done')
test-https-url-detection()
print('11 done')
print('=== TLS Tests Done ===')
