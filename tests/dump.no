; merged category 'dump' -- members: dump-ast.no, dump2.no
; (originals backed up under tests/_archive/dump/)
; ===================== merged from tests/dump-ast.no =====================
; Simple test to dump parser AST
; val i64: 固定 0（本檔只用來 dump AST，佔住 str.to-i64 的方法槽）
str.to-i64 = () (val i64) {
    val = 0
}
s = '12345'
n = s.to-i64()
print(n)

; ===================== merged from tests/dump2.no =====================
re = regexp {
    pattern: 'a*'
}
re.compile()
print('n =', re.n)
i <- [0..re.n): {
    op = re.op[i]
    a1 = re.arg1[i]
    a2 = re.arg2[i]
    {
        op == 1 -> print(i, ': CHAR', a1)

        op == 2 -> print(i, ': ANY')

        op == 3 -> print(i, ': CLASS', a1)

        op == 7 -> print(i, ': JUMP', a1)

        op == 8 -> print(i, ': SPLIT', a1, ',', a2)

        op == 9 -> print(i, ': MATCH')
    }
}
