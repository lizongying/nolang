; test-tls-prf-only — 只測試 prf
; # std/net/tls

print('before prf')
secret []byte = with-cap(4)
secret[0] = 1
secret[1] = 2
secret[2] = 3
secret[3] = 4
seed []byte = with-cap(3)
seed[0] = 0xAA
seed[1] = 0xBB
seed[2] = 0xCC
prf-out []byte
prf-out = tls.tls-prf(secret, 4, 'test label', seed, 3, 32)
print('after prf')
has-nonzero = 0
i <- [0..32): {
    prf-out[i] != 0 -> has-nonzero = 1
}
has-nonzero == 0 -> {
    print('FAIL: prf all zeros')
    return
}
print('PASS: prf')
