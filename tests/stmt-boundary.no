; stmt-boundary.no — 語句層兩個靜默誤編譯的端到端釘子（2026-09-30）
;
; 兩者都 pre-existing、rc=0、無任何診斷，且 AST 仍「型別正確」，所以型別檢查器
; 完全看不到。修復前的實測輸出（對照組 d1943b6e = v0.3.12）：
;
;   1. 裸 `{ ... }` 區塊出現在語句位置
;        修復前：區塊被 classifyBlockAtCurrent 判成宣告（blockEnum /
;                blockIface），送進 parseExpressionStatement；expr.go 的
;                LBRACE 分支只認 blockStruct / blockMatch，其餘走
;                `p.nextToken(); return nil` —— `{` 被吃掉，區塊內語句變成
;                外層主體的「兄弟」，區塊自己的 `}` 反而關掉了外層區塊。
;                於是裸區塊之後的每一條語句都往外漏一層。
;                test-bare-block 修復前只印 `99`（`print(x)` 漏到頂層）。
;
;   2. `awy` / `co` 不是區塊第一條語句時，關鍵字被上一條語句的
;      skipToStatementEnd() 吃掉（NEWLINE 刻意不是語句邊界）。
;        `co f(x)` 被吃掉 ⇒ 退化成同步 `f(x)`，編譯照過、輸出照印，
;        只是**不再 spawn**（這條由 src/parser/stmt_boundary_block_test.go
;        的 AST 斷言釘住）；`awy { }` 被吃掉則整組語義丟失。
;        注意：`co` 現在只啟動**過程**（被呼叫者不得有宣告回傳值）且是不可
;        當值的語句，所以「被吃掉」的形態一旦再現會直接編不過（c0nostmt），
;        本檔仍從輸出端釘一次，確保整組語義沒被靜默丟棄。

; 被協程衍生的簡單過程：把輸入乘 2（overflow 採 wrap）寫進結果通道再關閉。
; `co` 只啟動過程、結果走通道，所以呼叫方在組外排空。
; out: 結果通道（呼叫方建，容量 1）
; n: 輸入值
dbl-into = (out chan[i64], n i64) {

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt = n * 2
        r-opt: {
            ok -> out <- it

            ->
        }
        out.close()
    }
}

; 缺陷 1：裸 { } 區塊不吞後續語句
...

; 測試 bare-block
test-bare-block = () {
    x = 1
    {
        x = 2
    }
    print(x); expect: 2
    print(99); expect: 99
}

; 首條語句是呼叫 ⇒ 修復前分類為 blockIface，同樣吞掉後續語句
test-bare-block-call-first = () {
    print(1); expect: 1
    {
        print(2); expect: 2
    }
    print(3); expect: 3
}

; 頂層裸區塊（無外層函式）
x-top = 1
{
    x-top = 2
}
print(x-top); expect: 2

; 缺陷 2：非首條語句的 awy / co
...

; if 鏈臂體包含 awy 組，臂尾是組內的 co（非臂內首條語句）
test-awy-in-ifchain = () {
    x = true -> {
        out chan[i64] = with-cap(1)
        y = 1
        awy {
            co dbl-into(out, 21)
        }
        r = 0
        <- out: {
            ok -> r = it

            -> {
            }
        }
        r
    }
    print(x); expect: 42
}

; 同樣的缺陷，但 awy 組出現在 **match 臂** 而非 if 鏈臂
test-awy-in-match = () {
    v = 1
    x = v: {
        1 -> {
            out chan[i64] = with-cap(1)
            y = 1
            awy {
                co dbl-into(out, 21)
            }
            r = 0
            <- out: {
                ok -> r = it

                -> {
                }
            }
            r
        }

        -> 0
    }
    print(x); expect: 42
}

; awy 組不是第一條語句，且組內 co 也不是組內第一條語句
test-co-nonfirst = () {
    out chan[i64] = with-cap(1)
    y = 1
    awy {
        z = 2
        co dbl-into(out, 21)
    }
    print(y + z); expect: 3
    r = 0
    <- out: {
        ok -> r = it

        -> {
        }
    }
    print(r); expect: 42
}

; 過度修正守門員：非首條 awy 組之後的語句仍要正常解析
test-awy-nonfirst-then-use = () {
    out chan[i64] = with-cap(1)
    y = 1
    awy {
        co dbl-into(out, 21)
    }
    print(y); expect: 1
    r = 0
    <- out: {
        ok -> r = it

        -> {
        }
    }
    print(r); expect: 42
}

test-bare-block()
test-bare-block-call-first()
test-awy-in-ifchain()
test-awy-in-match()
test-co-nonfirst()
test-awy-nonfirst-then-use()
