; float-ne-nan.no — 浮點 `!=` 必須是無序比較（une），不是有序比較（one）
;
; 回歸：`!=` 曾經被降成 `fcmp one`，導致 `NaN != NaN` 為 false。
; 後果不只是比較錯：`f64-to-str` 用 `x != x` 判斷 NaN，於是 NaN 被印成 "0"，
; 看起來像「後端用 fast-math、運行期產生不出 NaN」。實際上 NaN 一直都存在。

check = (name str, cond bool) {
    cond -> print('ok: ' - name)

    -> print('fail: ' - name)
}

nan-of = () (v f64) {
    zero f64 = 0.0
    v = zero / zero
}

inf-of = () (v f64) {
    v = 1.0 / 0.0
}

main = () {
    n = nan-of()
    i = inf-of()

    ; NaN 與任何值都不相等，包括它自己
    check('nan != nan', n != n)
    check('nan == nan 為假', (n == n) == false)
    check('nan != 0', n != 0.0)
    check('nan != inf', n != i)

    ; 有序比較對 NaN 一律為假，這點不變
    check('nan > 0 為假', (n > 0.0) == false)
    check('nan < 0 為假', (n < 0.0) == false)
    check('nan >= 0 為假', (n >= 0.0) == false)
    check('nan <= 0 為假', (n <= 0.0) == false)

    ; 字串化
    check('nan 印成 nan', n.to-str() == 'nan')
    check('inf 印成 inf', i.to-str() == 'inf')
    check('-inf 印成 -inf', (0.0 - i).to-str() == '-inf')

    ; NaN 的傳播
    check('inf - inf 是 nan', (i - i) != (i - i))
    check('0 * inf 是 nan', (0.0 * i) != (0.0 * i))
    check('inf / inf 是 nan', (i / i) != (i / i))

    ; 常數折疊路徑也不能退化成 0
    check('常數 0.0/0.0 是 nan', (0.0 / 0.0).to-str() == 'nan')

    ; 一般數值不受影響
    check('1.5 != 2.5', 1.5 != 2.5)
    check('1.5 == 1.5', 1.5 == 1.5)
    check('1.5 < 2.5', 1.5 < 2.5)
}
