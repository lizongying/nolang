; merged category 'fd' -- members: fd-newtype-negative.no, fd-newtype.no
; (originals backed up under tests/_archive/fd/)
; merged from tests/fd-newtype-negative.no
; fd-newtype-negative.no — 驗證 fd newtype 互斥語義（應報錯）
;
; 測試所有 newtype 互斥場景：
;   1. i64 變量不能賦值給 fd 變量
;   2. fd 變量不能作為 i64 參數傳遞
...

; 1. i64 變量賦值給 fd 變量（應報錯）
x = 10

; bad fd = x

; 2. fd 變量傳給 i64 參數（應報錯）
; n: 宣告為 i64 的參數；故意不改接受 fd，以驗證 newtype 不會隱式互換（呼叫已註釋）
takes-i64 = (n i64) {
    n
}
my-fd fd = 0

; takes-i64(my-fd)

print('should not reach here')

; merged from tests/fd-newtype.no
; fd-newtype.no — 驗證 fd newtype 語義
;
; 測試項目：
;   1. 整數字面量可賦值給 fd 類型（含負值）
;   2. fd 可與整數字面量比較
;   3. fd 可作為 fd 參數傳遞（write 內建函數）
;   4. fd 變量之間賦值（同類型賦值）
;   5. STDOUT-FD 標準常量使用
...

; ── 1. 整數字面量賦值給 fd（含負值） ──
my-stdin fd = 0
my-stdout fd = 1
bad-fd fd = -1

; ── 2. fd 與整數字面量比較（含負值） ──
my-stdin == 0 -> print('ok: fd == 0')
my-stdin >= 0 -> print('ok: fd >= 0')
my-stdout > 0 -> print('ok: fd > 0')
bad-fd < 0 -> print('ok: fd < 0 negative')
bad-fd == -1 -> print('ok: fd == -1 negative')

; ── 3. fd 作為 fd 參數傳遞（write 內建函數） ──
msg = 'hello fd\n'.to-bytes()
n = fs.write(my-stdout, msg, msg.len())
n == 9 -> print('ok: write fd param')

; ── 4. fd 變量之間賦值（同類型賦值） ──
copy-fd = my-stdin
copy-fd == 0 -> print('ok: fd-to-fd assignment')

; ── 5. STDOUT-FD 標準常量使用 ──
n2 = fs.write(STDOUT-FD, 'std-ok\n'.to-bytes(), 7)
n2 == 7 -> print('ok: STDOUT-FD standard constant')
print('all fd newtype positive tests passed')
