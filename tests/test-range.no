; test-range.no — 測試 range-for 各種情況
; 包含遞增、遞減、常量、變量邊界

; 遞增 range (變量邊界)
test-ascending = () (r i64) {
    sum i64 = 0
    n i64 = 5
    i <- [0..n): {
        sum = sum + i
    }
    r = sum
}

; 遞減 range (變量邊界)
test-descending = () (r i64) {
    sum i64 = 0
    n i64 = 0
    i <- [5..n): {
        sum = sum + i
    }
    r = sum
}

; 常量邊界 range
test-constant = () (r i64) {
    sum i64 = 0
    i <- [0..10): {
        sum = sum + i
    }
    r = sum
}

; 常量遞減 range
test-constant-desc = () (r i64) {
    sum i64 = 0
    i <- [5..0): {
        sum = sum + i
    }
    r = sum
}

; 嵌套 range
test-nested = () (r i64) {
    sum i64 = 0
    n i64 = 3
    m i64 = 4
    i <- [0..n): {
        j <- [0..m): {
            sum = sum + i * 10 + j
        }
    }
    r = sum
}

; range with break
test-break = () (r i64) {
    sum i64 = 0
    n i64 = 100
    i <- [0..n): {
        i >= 5 -> break
        sum = sum + i
    }
    r = sum
}
a = test-ascending()
print(a)

; 0+1+2+3+4 = 10

b = test-descending()
print(b)

; 5+4+3+2+1 = 15

c = test-constant()
print(c)

; 0+1+2+...+9 = 45

d = test-constant-desc()
print(d)

; 5+4+3+2+1 = 15

e = test-nested()
print(e)

; (0*10+0)+(0*10+1)+(0*10+2)+(0*10+3)+(1*10+0)+...+(2*10+3)
; = 0+1+2+3 + 10+11+12+13 + 20+21+22+23 = 6+46+86 = 138

f = test-break()
print(f)
; 0+1+2+3+4 = 10
