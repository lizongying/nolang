; zz-strindex-lint.no — 验证 s[i] 性能告警（STR_INDEX_COMPLEXITY）的**不告警**侧
;   - 单独一次 s[i]（循环外）：不告警（即使非 ASCII）
;   - 手动按下标遍历但串可证明 ASCII：for j <- [0..a.count()): { x = a[j] } → 不告警
;   - 直接遍历字符串 for c <- s：无 s[i]，不告警（内部按码点迭代）
;   - 字节访问 s.byte(i)：不是 IndexExpression，不告警（非 ASCII 串按下标遍历的推荐写法）
;
; ⚠️ 本語料已不再保留「故意違規」的分支：告警側（未證明 ASCII 的 str 在迴圈內
; 用 s[i]）由 Go 單測 src/checker/str_index_complexity_test.go 把守——
;   TestStrIndexComplexity_FiresForUnprovenAsciiParam（該報的要報）
;   TestStrIndexComplexity_NotSuppressedByOtherFunction（真正的回歸守衛：同名
;     變數不得跨作用域消音；修復前 FAIL）
;   TestStrIndexComplexity_TopLevelNonAsciiLiteral
; 語料裡留一條「必然告警」的寫法會讓 `no vet tests` 永遠非零退出，反而使
; CI 門禁失去意義，故改由單測承擔覆蓋。
test-str-index-lint = () {

    ; ASCII 字面量：a[i] 单独一次，不告警
    a = 'hello'
    xa char = a[1]

    ; 非 ASCII 字面量（é 多字节）：b[i] 单独一次，不告警（不在循环里）
    b = 'héllo'
    yb char = b[1]

    ; 标识符传播：c 继承 b 的非 ASCII，c[i] 单独一次，不告警
    c = b
    zc char = c[2]

    ; 手动按下标遍历 非 ASCII 串 → 走字节访问逃生舱 s.byte(i)，不告警
    sum-b = 0
    for i <- [0..b.count()): {
        _ = b.byte(i)

        #{overflow=wrap}
        sum-b = sum-b + 1
    }
    print(sum-b)

    ; 手动按下标遍历 ASCII 串 → 不告警（可证明 ASCII，O(1)）
    sum-a = 0
    for j <- [0..a.count()): {
        ch2 char = a[j]

        #{overflow=wrap}
        sum-a = sum-a + 1
    }
    print(sum-a)

    ; 直接遍历字符串：无 s[i]，不告警
    sum-c = 0
    for cc <- b: {

        #{overflow=wrap}
        sum-c = sum-c + 1
    }
    print(sum-c)

    ; 字节访问逃生舱：不是 IndexExpression，不告警
    w = b.byte(0)

    print(xa)
    print(yb)
    print(zc)
    print(w)
}
test-str-index-lint()
