; f64-str.no — 測試 f64.to-str-fixed/-sci/-general 方法
; 注意：因編譯器 bug（print 直接接收函數返回值時 @print 未宣告），
; 所有用例先將結果賦值給變數再 print。
; 注意：Nolang 中 ';' 是註解符號，不可用作語句分隔。

; 特殊值（使用顯式 f64 型別，繞過編譯器對直接除法表達式的型別推導 bug）
nan-val = 0.0

nan-val = nan-val / nan-val
inf-val = 1.0

inf-val = inf-val / 0.0
neg-inf-val = 0.0

neg-inf-val = neg-inf-val - 1.0

neg-inf-val = neg-inf-val / 0.0

; 主體呼叫：先把 f64 值綁到顯式型別變數再走方法，避免字面量後接 `.` 的解析歧義
print('=== f64-to-str-fixed ===')
v = 3.14159
p = 4
s = v.to-str-fixed(p)
print(s)
p = 2
s = v.to-str-fixed(p)
print(s)
p = 0
s = v.to-str-fixed(p)
print(s)
v = -3.14
p = 2
s = v.to-str-fixed(p)
print(s)
v = 0.0
p = 4
s = v.to-str-fixed(p)
print(s)
v = -0.0
s = v.to-str-fixed(p)
print(s)
v = 100.0
p = 2
s = v.to-str-fixed(p)
print(s)
v = 0.005
p = 3
s = v.to-str-fixed(p)
print(s)
v = 9.99
p = 1
s = v.to-str-fixed(p)
print(s)
v = 12345.6789
p = 2
s = v.to-str-fixed(p)
print(s)
p = 2
s = nan-val.to-str-fixed(p)
print(s)
s = inf-val.to-str-fixed(p)
print(s)
s = neg-inf-val.to-str-fixed(p)
print(s)
print()

print('=== f64-to-str-sci ===')
v = 3.14159
p = 4
s = v.to-str-sci(p)
print(s)
v = 12345.678
p = 2
s = v.to-str-sci(p)
print(s)
v = 0.000123
s = v.to-str-sci(p)
print(s)
v = -5.5
p = 1
s = v.to-str-sci(p)
print(s)
v = 1.0
p = 0
s = v.to-str-sci(p)
print(s)
v = 0.0
p = 3
s = v.to-str-sci(p)
print(s)
v = -0.0
s = v.to-str-sci(p)
print(s)
p = 2
s = nan-val.to-str-sci(p)
print(s)
s = inf-val.to-str-sci(p)
print(s)
s = neg-inf-val.to-str-sci(p)
print(s)
print()

print('=== f64-to-str-general ===')
v = 3.14159
p = 6
s = v.to-str-general(p)
print(s)
v = 123456.789
s = v.to-str-general(p)
print(s)
v = 0.0001234
p = 4
s = v.to-str-general(p)
print(s)
v = 0.00001234
s = v.to-str-general(p)
print(s)
v = 100.0
s = v.to-str-general(p)
print(s)
v = -3.14
p = 3
s = v.to-str-general(p)
print(s)
v = 0.0
p = 4
s = v.to-str-general(p)
print(s)
v = -0.0
s = v.to-str-general(p)
print(s)
s = nan-val.to-str-general(p)
print(s)
s = inf-val.to-str-general(p)
print(s)
s = neg-inf-val.to-str-general(p)
print(s)
