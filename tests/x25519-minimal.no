; test-x25519-minimal — 最小化 X25519 測試
; # std/crypto/x25519

; key-holder: 測試用結構體
key-holder {
    priv [32]byte
}

; 將 hex 字串轉為 [32]byte
; hex-str str: 64 字元 hex 字串（每 2 字元一個位元組）
; out [32]byte: 解析出的 32 位元組
hex-to-bytes = (hex-str str) (out [32]byte) {

    ; #{ascii} 證明此 hex 串為純 ASCII：s[i] 由 O(n) 碼點迭代退化為 O(1) 定址
    #{ascii}
    hex-src = hex-str
    i <- [0..32): {

        #{overflow=wrap}
        hi char = hex-src[i * 2]

        #{overflow=wrap}
        lo char = hex-src[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        {
            hi >= 48 && hi <= 57 -> {
                hi-v = hi - 48
            }

            hi >= 97 && hi <= 102 -> {
                hi-v = hi - 87
            }

            hi >= 65 && hi <= 70 -> {
                hi-v = hi - 55
            }
        }
        {
            lo >= 48 && lo <= 57 -> {
                lo-v = lo - 48
            }

            lo >= 97 && lo <= 102 -> {
                lo-v = lo - 87
            }

            lo >= 65 && lo <= 70 -> {
                lo-v = lo - 55
            }
        }
        out[i] = (hi-v << 4) | lo-v
    }
}

; 測試 min：最小重現——在同一作用域內先讀 alice-priv 的位元組，再呼叫 scalarmult-base
; pass bool: true=alice-pub[0] 為 133（金標 0x85）；false=公鑰首 byte 不符
test-min = () (pass bool) {
    pass = false
    alice-priv = hex-to-bytes('77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a')

    ; 关键：在两次函数调用之间访问 alice-priv 的元素
    eprint('alice-priv[0..7]: ')
    i <- [0..8): {
        eprint(alice-priv[i])
        eprint(' ')
    }
    alice-pub = x25519.x25519-scalarmult-base(alice-priv)

    eprint('alice-pub: ')
    i <- [0..32): {
        eprint(alice-pub[i])
        eprint(' ')
    }

    ; 預期: 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
    alice-pub[0] == 133 -> pass = true
}

p = test-min()
{
    p == true -> print('PASS: minimal test')

    p == false -> print('FAIL: minimal test')
}
