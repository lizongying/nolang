// ═══════════════════════════════════════════
// AES-128（NIST test vector）
// ═══════════════════════════════════════════

aes-key [16]byte = [0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6, 0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c]
aes-plain [16]byte = [0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96, 0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a]

aes-out [16]byte
aes-out = hash.aes.aes-128-enc(aes-plain, aes-key)

fmt.print('aes-enc=')
i = 0
i < 16: {
    fmt.print-hex8(aes-out[i] & 255)
    i = i + 1
}
fmt.println('')

aes-dec [16]byte
aes-dec = hash.aes.aes-128-dec(aes-out, aes-key)

fmt.print('aes-dec=')
i = 0
i < 16: {
    fmt.print-hex8(aes-dec[i] & 255)
    i = i + 1
}
fmt.println('')

// ═══════════════════════════════════════════
// DES
// ═══════════════════════════════════════════

des-key [8]byte = [0x13, 0x34, 0x57, 0x79, 0x9b, 0xbc, 0xdf, 0xf1]
des-plain = '\x01\x23\x45\x67\x89\xab\xcd\xef'

des-out = '\x00\x00\x00\x00\x00\x00\x00\x00'
des-out = hash.des.des-enc(des-plain, 8, des-key)

fmt.print('des-enc=')
i = 0
i < 8: {
    fmt.print-hex8(des-out[i] & 255)
    i = i + 1
}
fmt.println('')

des-dec = '\x00\x00\x00\x00\x00\x00\x00\x00'
des-dec = hash.des.des-dec(des-out, 8, des-key)

fmt.print('des-dec=')
i = 0
i < 8: {
    fmt.print-hex8(des-dec[i] & 255)
    i = i + 1
}
fmt.println('')

// ═══════════════════════════════════════════
// 輔助函數
// ═══════════════════════════════════════════

make-str-16 = () (s str) {
    s = '                '
}