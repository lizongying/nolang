    print('{h5:016x}')
    print('{h6:016x}')
    print('{h7:016x}')
    print('')
}

test-sha512()

; ═══════════════════════════════════════════
; AES-128（NIST test vector）
; ═══════════════════════════════════════════

aes-key [16]byte = [
    0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6,
    0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c,
]
aes-plain [16]byte = [
    0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96,
    0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a,
]

aes-out [16]byte
aes-out = aes.aes-128-enc(aes-plain, aes-key)

io.out('aes-enc=')
i <- [0..16): {
    print('{aes-out[i] & 255:02x}')
}
print('')

aes-dec [16]byte
aes-dec = aes.aes-128-dec(aes-out, aes-key)

io.out('aes-dec=')
i <- [0..16): {
    print('{aes-dec[i] & 255:02x}')
}
print('')

; ═══════════════════════════════════════════
; DES
; ═══════════════════════════════════════════

des-key [8]byte = [0x13, 0x34, 0x57, 0x79, 0x9b, 0xbc, 0xdf, 0xf1]
des-plain = '\x01\x23\x45\x67\x89\xab\xcd\xef'

des-out []byte
des-out = des.des-enc(des-plain, 8, des-key)

io.out('des-enc=')
i <- [0..8): {
    print('{des-out[i] & 255:02x}')
}
print('')

des-decrypted []byte
des-decrypted = des.des-dec(des-out, 8, des-key)

io.out('des-dec=')
i <- [0..8): {
    print('{des-decrypted[i] & 255:02x}')
}
print('')
