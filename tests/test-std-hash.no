; # std/crypto/sha1
; # std/crypto/sha256
; # std/crypto/sha512
; # std/crypto/md5
; # std/crypto/aes
; # std/crypto/des
; # std/crypto/crc-32
; # std/crypto/fnv-1a-32
; # std/io

; test-std-hash.no — 標準庫 hash 模組測試
;
; 輸出 KEY=VALUE 格式，與 tests/compare/compare.go 一致。
; 執行：nolang run tests/test-std-hash.no > tests/nolang-output.txt
; 比對：diff tests/compare/go-output.txt tests/nolang-output.txt

; ═══════════════════════════════════════════
; CRC32
; ═══════════════════════════════════════════

; crc32("")=00000000
h = crc-32.crc-32('', 0)
io.out('crc32("")=')
print('{h:08x}')
print('')

; crc32("hello")=3610a686
h = crc-32.crc-32('hello', 5)
io.out('crc32("hello")=')
print('{h:08x}')
print('')

; crc32("fox")=414fa339
s = 'The quick brown fox jumps over the lazy dog'
h = crc-32.crc-32(s, 43)
io.out('crc32("fox")=')
print('{h:08x}')
print('')

; ═══════════════════════════════════════════
; FNV-1a-32
; ═══════════════════════════════════════════

; fnv1a32("")=811c9dc5
h = fnv-1a-32.fnv-1a-32('', 0)
io.out('fnv1a32("")=')
print('{h:08x}')
print('')

; fnv1a32("hello")=4f9f2cab
h = fnv-1a-32.fnv-1a-32('hello', 5)
io.out('fnv1a32("hello")=')
print('{h:08x}')
print('')

; fnv1a32("fox")=048fff90
h = fnv-1a-32.fnv-1a-32(s, 43)
io.out('fnv1a32("fox")=')
print('{h:08x}')
print('')

; ═══════════════════════════════════════════
; MD5
; ═══════════════════════════════════════════

md5-out [16]byte

; md5("")=d41d8cd98f00b204e9800998ecf8427e
md5-out = md5.md5('')
io.out('md5("")=')
i <- [0..16): {
    print('{md5-out[i] & 255:02x}')
}
print('')

; md5("hello")=5d41402abc4b2a76b9719d911017c592
md5-out = md5.md5('hello')
io.out('md5("hello")=')
i <- [0..16): {
    print('{md5-out[i] & 255:02x}')
}
print('')

; md5("fox")=9e107d9d372bb6826bd81d3542a419d6
md5-out = md5.md5(s)
io.out('md5("fox")=')
i <- [0..16): {
    print('{md5-out[i] & 255:02x}')
}
print('')

