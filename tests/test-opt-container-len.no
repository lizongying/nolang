; test-opt-container-len.no — option 承載容器時，容器 method 的 self 必須剝殼
;
; `?[]i64` / `?str` 這類「option 包住容器」的值呼叫 `v.len()` 時，method 的 self
; out-param 是**內層型別**（`[]i64` / `str`），但呼叫端原本直接把 option 的槽位
; 地址當成 `%vec*` / `%str-long*` 傳出去。
;
; 兩個佈局的第一個欄位剛好不同：
;   %vec       = { len, cap, data }   → 欄位 0 是 len
;   %option    = { tag, slot[3] }     → 欄位 0 是 tag
; 於是 `v.len()` 讀到的是 **tag**＝0（ok），而不是 payload 的 len。
;
; 修法：receiver 是 option 而 self 是內層型別時，改傳 payload 地址
; （optPayloadTypedAddr，與 emitGetField 處理 `?T.field` 的剝殼一致）。

fill-slice = () (out ?[]i64) {
    out = [10, 20, 30]
}

fill-str = () (out ?str) {
    out = 'hello'
}

main = () {
    ; (1) option 包 slice：.len() 必須是 3，不是 tag 0
    v = fill-slice()
    v.len() == 3 -> print('ok: ?[]i64 len peels the option')

    -> print('fail: ?[]i64 len got=' - v.len().to-str())

    ; (2) 讀回元素也要正確（走同一個 self 剝殼）
    v[0] == 10 && v[2] == 30 -> print('ok: ?[]i64 element read')

    -> print('fail: ?[]i64 element read')

    ; (3) option 包 str：.len() 是位元組數 5
    s = fill-str()
    s.len() == 5 -> print('ok: ?str len peels the option')

    -> print('fail: ?str len got=' - s.len().to-str())

    ; (4) 標量 option 不受影響（本來就走別的路徑）
    n = scalar-opt()
    n == 42 -> print('ok: ?i64 scalar unchanged')

    -> print('fail: ?i64 scalar got=' - n.to-str())

    ; (5) nil option 的 .len() 不應崩潰
    e = empty-slice()
    e.len() == 0 -> print('ok: nil ?[]i64 len is 0')

    -> print('fail: nil ?[]i64 len got=' - e.len().to-str())

    ; (6) 剝殼出來的 slice 是**借用**，不是所有權轉移：先讀 .len() 再取元素，
    ;     緩衝區不能被中途釋放（曾經把 option 當成 move source，讀出的副本
    ;     成了唯一的釋放點 → 後面的 v[i] 讀到已釋放的記憶體，印出 0）
    w = fill-slice()
    print('peel len=' - w.len().to-str())
    i <- [0..3): {
        w[i] == 10 + i * 10 -> {}

        -> print('fail: borrow peel freed the buffer at ' - i.to-str())
    }
    print('ok: peel borrows, buffer survives len()')
}

scalar-opt = () (out ?i64) {
    out = 42
}

empty-slice = () (out ?[]i64) {
}
