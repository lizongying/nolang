print('=== TLS Part 1 ===')

; test-tls-put-u16
buf []byte
tls.put-u16(buf, 0, 0x1234)
buf[0] != 0x12 -> {
    print('FAIL: put-u16')
    return
}
print('PASS: put-u16')

; test-tls-get-u16
val = 0
val = tls.get-u16(buf, 0)
val != 0x1234 -> {
    print('FAIL: get-u16')
    return
}
print('PASS: get-u16')

; test-tls-put-u24
tls.put-u24(buf, 0, 0x123456)
buf[0] != 0x12 -> {
    print('FAIL: put-u24')
    return
}
print('PASS: put-u24')

; test-tls-get-u24
val = tls.get-u24(buf, 0)
val != 0x123456 -> {
    print('FAIL: get-u24')
    return
}
print('PASS: get-u24')

print('=== Done ===')

; merged from tests/tls-part2.no
; test-tls-part2 — bytes 相關測試
; # std/net/tls
...

print('=== TLS Part 2 ===')

; test-tls-bytes-cat
a []byte = with-cap(3)
a[0] = 1
a[1] = 2
a[2] = 3
b []byte = with-cap(2)
b[0] = 4
b[1] = 5
out []byte
out = tls.bytes-cat(a, b)
out.len() != 5 -> {
    print('FAIL: bytes-cat len')
    return
}
out[0] != 1 -> {
    print('FAIL: bytes-cat out[0]')
    return
}
out[3] != 4 -> {
    print('FAIL: bytes-cat out[3]')
    return
}
print('PASS: bytes-cat')

; test-tls-bytes-to-bn
data []byte = with-cap(4)
data[0] = 0x01
data[1] = 0x02
data[2] = 0x03
data[3] = 0x04
bn-out []i64
bn-out = tls.bytes-to-bn(data)
bn-out.len() != 1 -> {
    print('FAIL: bytes-to-bn n')
    return
}
bn-out[0] != 0x01020304 -> {
    print('FAIL: bytes-to-bn val')
    return
}
print('PASS: bytes-to-bn')

; test-tls-bn-to-bytes
num []i64 = with-cap(1)
num[0] = 0x01020304
bb-out []byte
bb-out = tls.bn-to-bytes(num)
bb-out.len() != 4 -> {
    print('FAIL: bn-to-bytes n')
    return
}
bb-out[0] != 0x01 -> {
    print('FAIL: bn-to-bytes out[0]')
    return
}
print('PASS: bn-to-bytes')

; test-tls-rand-bytes
state = 12345
r-out []byte
r-out = tls.rand-bytes(state, 16)
print('PASS: rand-bytes')

print('=== Done ===')

; merged from tests/tls-part3.no
; test-tls-part3 — prf 和 conn-init
; # std/net/tls
...

print('=== TLS Part 3 ===')

; test-tls-prf
print('before prf')
secret []byte = with-cap(4)
secret[0] = 1
secret[1] = 2
secret[2] = 3
secret[3] = 4
seed []byte = with-cap(3)
seed[0] = 0xaa
seed[1] = 0xbb
seed[2] = 0xcc
prf-out []byte
prf-out = tls.prf(secret, 'test label', seed, 32)
print('after prf')
has-nonzero = 0
i <- [0..32): {
    prf-out[i] != 0 -> has-nonzero = 1
}
has-nonzero == 0 -> {
    print('FAIL: prf all zeros')
    return
}
print('PASS: prf')

; test-tls-conn-init
print('before conn-init')
c tls.conn
c.init()
c.connected != false -> {
    print('FAIL: conn-init connected')
    return
}
c.fd != 0 -> {
    print('FAIL: conn-init fd')
    return
}
c.write-seq != 0 -> {
    print('FAIL: conn-init write-seq')
    return
}
print('PASS: conn-init')

print('=== Done ===')
