; Test str.fields and str.replace-str
main = () () {
    ; Test str.fields
    s = '  hello   world  nolang  '
    fields = s.fields()
    n = fields.len
    println('fields count: ' + n.to-str())
    i <- [0..n): {
        println('  [' + i.to-str() + '] ' + fields[i])
    }

    ; Test str.replace-str
    s2 = 'hello world hello'
    r = s2.replace-str('hello', 'HI')
    println('replace: ' + r)

    ; Test str.replace-str with no match
    r2 = s2.replace-str('xyz', 'ABC')
    println('no-match: ' + r2)

    ; Test str.replace-str with empty old
    r3 = s2.replace-str('', 'X')
    println('empty-old: ' + r3)
}
