; tests/safe-index-more.no — consolidated safe-index fragment
; from: tests/safe-index-utl.no
; NOTE: tests/safe-index-zero.no is currently a compile-fail (u8 narrow regression,
; pre-existing baseline staleness) and is left standalone until that is fixed; it is
; intentionally NOT folded in here so this file stays a clean rc=0 run.

safe-utl = (i i64) (res ?i64) {
    a = [10, 20, 30, 40]
    x = a[i]; 未標型別區域變數承接安全索引 → 捕獲 x: ?i64
    x: {
        nil -> {
        }

        err -> {
        }

        -> {
            io.out('untyped-local x = ')
            io.out(it); 應印出 20（ib=1），證明 payload 正確推論為 i64 而非被污染成 str
            print('')
        }
    }
    res = x
}

ib = 1
oob = 9

safe-utl(ib)

safe-utl(oob)
io.out('utl OOB: no-crash')
print('')
