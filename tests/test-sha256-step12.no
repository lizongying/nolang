// test-sha256-step12 — sha256 傳入賦值的 []byte
// # std/hash/sha256

main = () {
    print('start')
    msg []byte
    msg[0] = 0x61
    msg[1] = 0x62
    msg[2] = 0x63
    print('before sha256')
    h [32]byte
    h = sha256(msg)
    print('after sha256')
    print(h[0])
    print(h[1])
    print(h[2])
    print('done')
}
