; test-ffi-sqlite.no — SQLite FFI 驅動完整流程測試
;
; 測試 open/exec/query/scan/prepare/bind 完整流程。
; 需系統安裝 libsqlite3（macOS/Linux 通常已內建）。
; 驅動包 example/sqlite-driver 使用 #{c} FFI 註解直接呼叫 SQLite C API。

# /example/sqlite-driver/sqlite

; 測試 1: 開啟記憶體資料庫
d db = fs.open(':memory:')
d.handle == 0 -> {
    print('fail: open database')
    return
}
print('ok: open database')

; 測試 2: 建表
r result = d.exec('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age REAL)')
print('ok: create table')

; 測試 3: 插入資料
r = d.exec('INSERT INTO users (name, age) VALUES (\'Alice\', 30.5)')
{
    r.affected == 1 -> print('ok: insert')
    -> {
        print('fail: insert affected=')
        print(r.affected)
    }
}

; 測試 4: 查詢並掃描
rs rows = d.query('SELECT id, name, age FROM users')
rs.stmt == 0 -> {
    print('fail: query')
    d.close()
    return
}

count i64 = 0
{
    id i64 = rs.scan-int(0)
    name = rs.scan-str(1)
    age = rs.scan-float(2)
    {
        id == 1 -> {
            name == 'Alice' -> {
                age > 30.0 -> {
                    age < 31.0 -> print('ok: query scan')
                    -> print('fail: age too high')
                }
                -> print('fail: age too low')
            }
            -> print('fail: name mismatch')
        }
        -> print('fail: id mismatch')
    }
    count = count + 1
} (rs.next())
rs.close()

; 測試 5: 預編譯陳述式（插入）
s stmt = d.prepare('INSERT INTO users (name, age) VALUES (?, ?)')
s.handle == 0 -> {
    print('fail: prepare insert')
    d.close()
    return
}
s.bind-str(1, 'Bob')
s.bind-int(2, 25)
r2 result = s.exec()
{
    r2.affected == 1 -> print('ok: prepared insert')
    -> print('fail: prepared insert')
}
s.close()

; 測試 6: 預編譯陳述式（查詢）
s2 stmt = d.prepare('SELECT name FROM users WHERE id = ?')
s2.handle == 0 -> {
    print('fail: prepare select')
    d.close()
    return
}
s2.bind-int(1, 2)
rs2 rows = s2.query()
rs2.stmt == 0 -> {
    print('fail: prepared query')
    s2.close()
    d.close()
    return
}
{
    name2 = rs2.scan-str(0)
    {
        name2 == 'Bob' -> print('ok: prepared query scan')
        -> print('fail: prepared query name mismatch')
    }
} (rs2.next())
rs2.close()
s2.close()

; 測試 7: 驗證總列數
rs3 rows = d.query('SELECT id FROM users')
rs3.stmt != 0 -> {
    total i64 = 0
    {
        total = total + 1
    } (rs3.next())
    {
        total == 2 -> print('ok: total rows')
        -> {
            print('fail: total rows=')
            print(total)
        }
    }
    rs3.close()
}

d.close()
print('ok: all tests done')
