; ===================== merged from tests/2.no =====================
probs = [1, 2, 3]
m = 1

bit, probs[m] = decode-bit(probs[m])

; bit, tmp = decode-bit(probs[m])
; probs[m] = tmp

; 解碼 bit
; prob i64: 目前的機率狀態值
; bit i64: 解出的位元（本實作固定給 0）
; new-prob i64: 更新後的機率，prob - (prob >> 5)（overflow 採 wrap）
decode-bit = (prob i64) (bit i64, new-prob i64) {
    bit = 0

    #{overflow=wrap}
    new-prob = prob - (prob >> 5)
}
