; nil 預宣告探針：驗證 `x ?T = nil` 可作為捕獲 desugar 的預宣告形式
; （nil 槽無堆指標，後續各臂覆寫安全），並確認 match 三臂消費正確。
main = () {
    x ?i64 = nil
    x: {
        ok -> io.out('x=ok ')
        nil -> io.out('x=nil ')
        err -> io.out('x=err ')
    }
    print('')

    y ?i64 = nil
    y = 5
    y: {
        ok -> print(y)
        nil -> print('nil')
        err -> print('err')
    }

    s ?str = nil
    s: {
        ok -> print(s)
        nil -> print('s=nil')
        err -> print('s=err')
    }
}
