; test-tls-part3 — prf 和 conn-init
; # std/net/tls

print('=== TLS Part 3 ===')

; test-tls-prf
print('before prf')
secret []byte = with-cap(4)
secret[0] = 1
secret[1] = 2
secret[2] = 3
secret[3] = 4
seed []byte = with-cap(3)
seed[0] = 0xaa
seed[1] = 0xbb
seed[2] = 0xcc
prf-out []byte
prf-out = tls.prf(secret, 4, 'test label', seed, 3, 32)
print('after prf')
has-nonzero = 0
i <- [0..32): {
    prf-out[i] != 0 -> has-nonzero = 1
}
has-nonzero == 0 -> {
    print('FAIL: prf all zeros')
    return
}
print('PASS: prf')

; test-tls-conn-init
print('before conn-init')
c tls.conn
c.init()
c.connected != false -> {
    print('FAIL: conn-init connected')
    return
}
c.fd != 0 -> {
    print('FAIL: conn-init fd')
    return
}
c.write-seq != 0 -> {
    print('FAIL: conn-init write-seq')
    return
}
print('PASS: conn-init')

print('=== Done ===')
