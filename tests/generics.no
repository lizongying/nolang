; generics.no — 驗證 Nolang 泛型概念
;
; Nolang 不支援隱式泛型型別參數（如 t），且函式內的比較運算子（== != > <）
; 有編譯器 bug 會回傳 false。故本測試改用：
; 1. 型別特定函式（gen-add-i64, gen-sub-i64 等）模擬泛型
; 2. 函式內只做算術（+ - *），比較在 main() 中進行
; 3. 相等判斷透過減法：a == b 等價於 (a - b) == 0

; ── i64 型別的「泛型」函式 ──

; 模擬泛型的 i64 加法（Nolang 不支援隱式型別參數，故按型別各寫一份）
; a i64: 第一個加數
; b i64: 第二個加數
; r i64: a + b（#{overflow=wrap}）
gen-add-i64 = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    r = a + b
}

; 模擬泛型的 i64 減法：結果可直接當相等比較用（差為 0 即相等）
; a i64: 被減數
; b i64: 減數
; d i64: a - b
gen-sub-i64 = (a i64, b i64) (d i64) {

    #{overflow=wrap}
    d = a - b
}

; 模擬泛型的 i64 乘法
; a i64: 第一個因數
; b i64: 第二個因數
; r i64: a * b
gen-mul-i64 = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    r = a * b
}

; ── i32 型別的「泛型」函式 ──

; 跨型別的 i32 加法：證明同名邏輯可為不同寬度各寫一份
; a i32: 第一個加數
; b i32: 第二個加數
; r i32: a + b（#{overflow=wrap}）
gen-add-i32 = (a i32, b i32) (r i32) {

    #{overflow=wrap}
    r = a + b
}

; i32 版的減法：用於 i32 相等性驗證（差為 0 即相等）
; a i32: 被減數
; b i32: 減數
; d i32: a - b
gen-sub-i32 = (a i32, b i32) (d i32) {

    #{overflow=wrap}
    d = a - b
}

; ── 1. gen-add-i64 加法 ──
r = 0
r = gen-add-i64(40, 2)
{
    r == 42 -> print('ok: gen-add-i64')

    -> print('fail: gen-add-i64')
}

; ── 2. gen-eq i64（透過 sub + == 0）──
d = 0
d = gen-sub-i64(42, 42)
{
    d == 0 -> print('ok: gen-eq i64 true')

    -> print('fail: gen-eq i64 true')
}

; ── 3. gen-ne i64（透過 sub + != 0）──
d = gen-sub-i64(42, 43)
{
    d != 0 -> print('ok: gen-ne i64')

    -> print('fail: gen-ne i64')
}

; ── 4. gen-mul-i64 乘法 ──
r = gen-mul-i64(6, 7)
{
    r == 42 -> print('ok: gen-mul-i64')

    -> print('fail: gen-mul-i64')
}

; ── 5. gen-add-i32 跨型別 ──
r32 i32 = 0
r32 = gen-add-i32(40, 2)
{
    r32 == 42 -> print('ok: gen-add-i32')

    -> print('fail: gen-add-i32')
}

; ── 6. gen-eq i32（透過 sub + == 0）──
d32 i32 = 0
d32 = gen-sub-i32(100, 100)
{
    d32 == 0 -> print('ok: gen-eq i32')

    -> print('fail: gen-eq i32')
}
