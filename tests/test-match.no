status {
    status1,
    status2,
    status3,
    status4,
}

test-match = () {
    x ?i64

    ; 直接->是else
    x: {
        err -> log(); it的型態是err
        nil -> log(); it的型態是nil
        ok -> log(); it的型態是i64
        -> log()
    }

    ; 全部列舉
    x: {
        err -> log()
        nil -> log()
        ok -> log()
    }

    ; it的型態是err
    ; it的型態是nil
    ; it的型態是i64

    ; 這裡-> 有else的意思
    x: {
        ok -> log()
        -> log()
    }

    x: {
        ok -> log()
        nil -> log()
        -> log()
    }

    x: {
        -> log()
    }

    a i64

    x: {
        err -> log()
        ok -> {
            a == 1 -> log()
            -> log('else')
        }
        -> log()
    }

    x: {
        err -> log()
        -> log()
    }

    s status
    s: {
        status1 -> log()
        status2 -> log()
        status3 -> log()
        status4 -> log()
        -> log()
    }

    ; 這是if/else
    {
        a == 1 -> log('1')
        -> log('else')
    }

    a == 2 -> log('2')
}
