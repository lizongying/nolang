status {status1, status2, status3, status4}

test-match = () {
    x ?i64

    // 直接->是else
    x: {
        err -> log(it)  // it的型態是err
        nil -> log(it)  // it的型態是nil
        -> log(it)  // it的型態是i64
    }

    // 全部列舉
    x: {
        err -> log(it)
        nil -> log(it)
        ok -> log(it)
    }

    // it的型態是err
    // it的型態是nil
    // it的型態是i64

    // 這裡-> 有else的意思
    x: {
        ok -> log(it)
        -> log(it)
    }

    x: {
        ok -> log(it)
        nil -> log(it)
        -> log(it)
    }

    x: {
        -> log(it)
    }

    x: {
        err -> log(it)
        ok -> log(it)
        -> log(it)
    }

    x: {
        err -> log(it)
        -> log(it)
    }

    s status
    s: {
        status1 -> log(it)
        status2 -> log(it)
        status3 -> log(it)
        status4 -> log(it)
        -> log(it)
    }

    a i64

    // 這是if/else
    {
        a == 1 -> log('1')
        -> log('else')
    }

    a == 2; log('2')
}