// ✅ match 语句：分支体是代码块
x = 1
if x ==
1 {
    .
    
    x
    a = 1
    b = 2
} elif x ==
2 {
    .
    
    x
} elif  {
    .
    
    x
    c = 0
}
// 多行，不返回值

// do-something()

// ✅ match 表达式：分支体是单一表达式
result = if x ==
1 {
    .
    
    x
    1
} elif x ==
2 {
    .
    
    x
    2 + 1
} elif  {
    .
    
    x
    a + b
}
// 单一值
// 簡單表達式

// 特殊match
if a == 1 {
    a = 1
    b = 2
    a == 2
} elif  {
    c = 0
} else {
    do-something()
}
// 多行，不返回值

// 判讀返回值可能有錯的情況
if x ==
err {
    .
    
    x
    log(.)
} elif x ==
nil {
    .
    
    x
    log('nil')
} elif  {
    .
    
    x
    do-right-thing()
}