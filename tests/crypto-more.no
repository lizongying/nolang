print('hello')

; ── from tests/hash-deps.no ──
print('hash deps ok')

; ── from tests/fe-cswap.no ──
; test-fe-cswap — 驗證 fe-cswap 是否正確交換兩個陣列
; # std/crypto/x25519

; 建立兩個不同的域元素
fec-a []i64 = with-len(10)
fec-a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4; a[4] = 5
fec-a[5] = 6; a[6] = 7; a[7] = 8; a[8] = 9; a[9] = 10

fec-b []i64 = with-len(10)
fec-b[0] = 100; b[1] = 200; b[2] = 300; b[3] = 400; b[4] = 500
fec-b[5] = 600; b[6] = 700; b[7] = 800; b[8] = 900; b[9] = 1000

eprint('Before swap: a[0]=')
eprint(fec-a[0])
eprint(' b[0]=')
eprint(fec-b[0])

; 交換 (mask=1)
x25519.fe-cswap(fec-a, fec-b, 1)

eprint('After swap(1): a[0]=')
eprint(fec-a[0])
eprint(' b[0]=')
eprint(fec-b[0])

; 驗證
{
    fec-a[0] == 100 -> print('PASS: a swapped')

    fec-a[0] != 100 -> print('FAIL: a not swapped')
}
{
    fec-b[0] == 1 -> print('PASS: b swapped')

    fec-b[0] != 1 -> print('FAIL: b not swapped')
}

; 不交換 (mask=0)
x25519.fe-cswap(fec-a, fec-b, 0)

eprint('After swap(0): a[0]=')
eprint(fec-a[0])
eprint(' b[0]=')
eprint(fec-b[0])

{
    fec-a[0] == 100 -> print('PASS: a not swapped (mask=0)')

    fec-a[0] != 100 -> print('FAIL: a swapped (mask=0)')
}
{
    fec-b[0] == 1 -> print('PASS: b not swapped (mask=0)')

    fec-b[0] != 1 -> print('FAIL: b swapped (mask=0)')
}

; ── from tests/fe-mul-simple.no ──
; test-fe-mul-simple — 驗證 fe-mul 基本正確性

; 測試 1: 2 * 3 = 6
fem-f []i64 = with-len(10)
fem-f[0] = 2
fem-g []i64 = with-len(10)
fem-g[0] = 3
fem-h []i64 = with-len(10)
x25519.fe-mul(fem-h, fem-f, fem-g)

eprint('2*3 = ')
i <- [0..10): {
    eprint(fem-h[i])
    eprint(' ')
}
{
    fem-h[0] == 6 -> {
        print('PASS: 2*3=6')
    }

    fem-h[0] != 6 -> {
        print('FAIL: 2*3')
    }
}

; 測試 2: 大數乘法 — f = [0, 1, 0, ...] (值 = 2^26), g = [0, 1, 0, ...] (值 = 2^26)
; h = 2^52 = [0, 0, 2, 0, ...] (shift 51, limb 2 = 2*2^0 = 2? No...)
; 2^26 * 2^26 = 2^52. shift 52 is in limb 2 (bits 51-76). 2^52 = 2 * 2^51. So h[2] = 2.
fem-f2 []i64 = with-len(10)
fem-f2[1] = 1
fem-g2 []i64 = with-len(10)
fem-g2[1] = 1
fem-h2 []i64 = with-len(10)
x25519.fe-mul(fem-h2, fem-f2, fem-g2)

eprint('2^26 * 2^26 = ')
i <- [0..10): {
    eprint(fem-h2[i])
    eprint(' ')
}
{
    fem-h2[2] == 2 -> {
        print('PASS: 2^26*2^26=2^52')
    }

    fem-h2[2] != 2 -> {
        print('FAIL: 2^26*2^26')
    }
}

; 測試 3: (p-1) * 1 = p-1 = 2^255 - 20
; p-1 in limbs: 2^255 - 1 (all limbs maxed) minus 19
;   limb 0 (26 bits): 2^26 - 1 = 67108863; 67108863 - 19 = 67108844
;   limb 1 (25 bits): 2^25 - 1 = 33554431
;   ... etc
; NOTE: p = 2^255 - 19, so p-1 = 2^255 - 20, NOT 2^255 - 19
; NOTE: fe-mul 不保證規約到 [0, 2^bits-1]，可能產生半規約形式（如 -1 = p-1）
;       必須用 fe-tobytes 轉成 canonical bytes 後比較
fem-pm1 []i64 = with-len(10)
fem-pm1[0] = 67108844
fem-pm1[1] = 33554431
fem-pm1[2] = 67108863
fem-pm1[3] = 33554431
fem-pm1[4] = 67108863
fem-pm1[5] = 33554431
fem-pm1[6] = 67108863
fem-pm1[7] = 33554431
fem-pm1[8] = 67108863
fem-pm1[9] = 33554431

fem-one []i64 = with-len(10)
fem-one[0] = 1

fem-h3 []i64 = with-len(10)
x25519.fe-mul(fem-h3, fem-pm1, fem-one)

; 將結果轉為 canonical bytes 比較
fem-fem-h3-bytes [32]byte
x25519.fe-tobytes(fem-fem-h3-bytes, fem-h3)
fem-fem-pm1-bytes [32]byte
x25519.fe-tobytes(fem-fem-pm1-bytes, fem-pm1)

fem-ok3 = true
i <- [0..32): {
    fem-fem-h3-bytes[i] != fem-fem-pm1-bytes[i] -> fem-ok3 = false
}
{
    fem-ok3 == true -> {
        print('PASS: (p-1)*1=p-1')
    }

    fem-ok3 == false -> {
        print('FAIL: (p-1)*1')
        eprint('h3 bytes: ')
        i <- [0..32): {
            eprint(fem-fem-h3-bytes[i])
            eprint(' ')
        }
        eprint('pm1 bytes: ')
        i <- [0..32): {
            eprint(fem-fem-pm1-bytes[i])
            eprint(' ')
        }
    }
}

; 測試 4: (p-1) * (p-1) = 1 (mod p), by Fermat's little theorem
fem-h4 []i64 = with-len(10)
x25519.fe-mul(fem-h4, fem-pm1, fem-pm1)

eprint('(p-1)*(p-1) = ')
i <- [0..10): {
    eprint(fem-h4[i])
    eprint(' ')
}
{
    fem-h4[0] == 1 -> print('PASS: (p-1)^2=1 mod p')

    fem-h4[0] != 1 -> print('FAIL: (p-1)^2')
}

; ── from tests/fe-ops.no ──
; test-fe-ops — 測試 X25519 域元素基本操作

; 列印域元素
; label str: 行首標籤
; h []i64: 域元素的 10 個 limb，以空格分隔逐個 eprint
feo-fe-print = (label str, h []i64) {
    eprint(label)
    eprint(': ')
    i <- [0..10): {
        eprint(h[i])
        eprint(' ')
    }
}

; 測試 fe-mul(2, 3) = 6
; pass bool: true=r[0] 為 6 且 limb 1..9 全為 0；false=任一斷言失敗（已印 FAIL）
feo-test-fe-mul = () (pass bool) {
    pass = false

    ; 2 = [2, 0, 0, 0, 0, 0, 0, 0, 0, 0]
    a []i64 = with-len(10)
    a[0] = 2

    ; 3 = [3, 0, 0, 0, 0, 0, 0, 0, 0, 0]
    b []i64 = with-len(10)
    b[0] = 3

    ; result = a * b
    r []i64 = with-len(10)
    x25519.fe-mul(r, a, b)
    feo-fe-print('fe-mul(2,3)', r)

    ; 預期: 6 = [6, 0, 0, 0, 0, 0, 0, 0, 0, 0]
    r[0] != 6 -> {
        print('FAIL: fe-mul(2,3) != 6')
        return
    }
    i <- [1..10): {
        r[i] != 0 -> {
            print('FAIL: fe-mul(2,3) has non-zero high limbs')
            return
        }
    }
    pass = true
}

; 測試 fe-sq(3) = 9
; pass bool: true=r[0] 為 9；false=平方結果不等於 9
feo-test-fe-sq = () (pass bool) {
    pass = false

    a []i64 = with-len(10)
    a[0] = 3

    r []i64 = with-len(10)
    x25519.fe-sq(r, a)
    feo-fe-print('fe-sq(3)', r)

    r[0] != 9 -> {
        print('FAIL: fe-sq(3) != 9')
        return
    }
    pass = true
}

; 測試 fe-add(2, 3) = 5
; pass bool: true=r[0] 為 5；false=相加結果不等於 5
feo-test-fe-add = () (pass bool) {
    pass = false

    a []i64 = with-len(10)
    a[0] = 2

    b []i64 = with-len(10)
    b[0] = 3

    r []i64 = with-len(10)
    x25519.fe-add(r, a, b)
    feo-fe-print('fe-add(2,3)', r)

    r[0] != 5 -> {
        print('FAIL: fe-add(2,3) != 5')
        return
    }
    pass = true
}

; 測試載入 basepoint (9)
; pass bool: true=r[0] 為 9 且 limb 1..9 全為 0；false=載入錯位或殘留高位
feo-test-fe-frombytes = () (pass bool) {
    pass = false

    base [32]byte
    e <- base: {
        e: {
            ok -> it = 0

            -> _
        }
    }
    base[0]: {
        ok -> it = 9

        -> _
    }

    r []i64 = with-len(10)
    x25519.fe-frombytes(r, base)
    feo-fe-print('fe-frombytes(9)', r)

    r[0] != 9 -> {
        print('FAIL: fe-frombytes(9)[0] != 9')
        return
    }
    i <- [1..10): {
        r[i] != 0 -> {
            print('FAIL: fe-frombytes(9) has non-zero high limbs')
            return
        }
    }
    pass = true
}

; 測試 scalarmult(1, base) — 應為 9 * 2^254 mod p
; pass bool: true=算出的 32-byte 公鑰與 RFC 7748 Alice 金標逐位元組相同；false=不匹配
feo-test-scalarmult-base = () (pass bool) {
    pass = false

    ; 使用 Alice 的金鑰
    scalar [32]byte
    hex-str = '77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a'
    i <- [0..32): {

        #{overflow=wrap}
        hi char = hex-str[i * 2]

        #{overflow=wrap}
        lo char = hex-str[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        {
            hi >= 48 && hi <= 57 -> {
                hi-v = hi - 48
            }

            hi >= 97 && hi <= 102 -> {
                hi-v = hi - 87
            }

            hi >= 65 && hi <= 70 -> {
                hi-v = hi - 55
            }
        }
        {
            lo >= 48 && lo <= 57 -> {
                lo-v = lo - 48
            }

            lo >= 97 && lo <= 102 -> {
                lo-v = lo - 87
            }

            lo >= 65 && lo <= 70 -> {
                lo-v = lo - 55
            }
        }
        scalar[i]: {
            ok -> it = (hi-v << 4) | lo-v

            -> _
        }
    }
    pub = x25519.x25519-scalarmult-base(scalar)

    ; 預期: 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
    ; = [133, 32, 240, 9, 137, 48, 167, 84, 116, 139, 125, 220, 180, 62, 247, 90,
    ;    13, 191, 58, 13, 38, 56, 26, 244, 235, 164, 169, 142, 170, 155, 78, 106]
    expected = [
        133, 32, 240, 9, 137, 48, 167, 84,
        116, 139, 125, 220, 180, 62, 247, 90,
        13, 191, 58, 13, 38, 56, 26, 244,
        235, 164, 169, 142, 170, 155, 78, 106,
    ]

    eprint('Computed pub:')
    i <- [0..32): {
        eprint(' ')
        eprint(pub[i])
    }
    eprint('Expected pub:')
    i <- [0..32): {
        eprint(' ')
        eprint(expected[i])
    }
    match-val = 1
    i <- [0..32): {
        (pub[i]) != expected[i] -> {
            match-val = 0
            break
        }
    }
    match-val: {
        0 -> {
            print('FAIL: scalarmult-base does not match expected')
            return
        }
    }
    pass = true
}

feo-p1 = feo-test-fe-add()
{
    feo-p1 == true -> print('PASS: fe-add')

    feo-p1 == false -> print('FAIL: fe-add')
}
feo-p2 = feo-test-fe-mul()
{
    feo-p2 == true -> print('PASS: fe-mul')

    feo-p2 == false -> print('FAIL: fe-mul')
}
feo-p3 = feo-test-fe-sq()
{
    feo-p3 == true -> print('PASS: fe-sq')

    feo-p3 == false -> print('FAIL: fe-sq')
}
feo-p4 = feo-test-fe-frombytes()
{
    feo-p4 == true -> print('PASS: fe-frombytes')

    feo-p4 == false -> print('FAIL: fe-frombytes')
}
feo-p5 = feo-test-scalarmult-base()
{
    feo-p5 == true -> print('PASS: scalarmult-base')

    feo-p5 == false -> print('FAIL: scalarmult-base')
}
