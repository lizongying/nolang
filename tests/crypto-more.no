; crypto-more — 合併自同簇 crypto/hmac/fe 小件（heavy dedup）
;
; 含 std 模組導入者以模組級片段串接（導入行留在頂層並去重），頂層符號加 per-file 前綴避免衝突。
; golden/引用件保留獨立：i-sha256、aes-enc、aes-vectors。
;
; ── from tests/hmac.no ──
; test-hmac — 測試 hmac-sha256
; # std/crypto/hmac

print('start')
hmac-key []byte = with-cap(2)
hmac-key[0] = 1
hmac-key[1] = 2
hmac-msg []byte = with-cap(2)
hmac-msg[0] = 0xaa
hmac-msg[1] = 0xbb
print('before hmac')
hmac-a [32]byte
hmac-a = hmac.hmac-sha256(hmac-key, hmac-msg)
print('after hmac')
print(hmac-a[0])
print('done')

; ── from tests/hmac2.no ──
; test-hmac2 — 測試 hmac-sha256 輸出參數形式

print('start')
hmac2-key []byte
hmac2-key[0] = 1
hmac2-key[1] = 2
hmac2-msg []byte
hmac2-msg[0] = 0xaa
hmac2-msg[1] = 0xbb
print('before hmac')
hmac2-a [32]byte
hmac2-a = hmac.hmac-sha256(hmac2-key, hmac2-msg)
print('after hmac')
print(hmac2-a[0])
print('done')

; ── from tests/hash-crc.no ──
