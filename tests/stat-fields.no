; test-stat-fields — 新增 fs.stat-{nlink,ino,atime,ctime,blocks,blksize} 內建
;
; 這些 builtin 走 cRetField 路径：按 struct stat 的「字段偏移 + 原生位寬」讀取。
; 位寬讀錯會把相鄰字段折進結果（stat-mode 曾因按 64-bit 讀 16-bit st_mode 返回垃圾）。
; 本測試驗證：(a) 每個字段讀出合理值；(b) 不同文件的 st_ino 不同——若 ino 被摺疊/
; 讀成常數就會相等，可借此钉住偏移/位寬正確性。所有值已在 darwin 上逐一對照 BSD
; `stat -f` 確認一致（nlink/ino/atime/ctime/blocks/blksize 全等）。

ls = '/bin/ls'

nlink = fs.stat-nlink(ls)
ino = fs.stat-ino(ls)
blksize = fs.stat-blksize(ls)
blocks = fs.stat-blocks(ls)
mtime = fs.stat-mtime(ls)
ctime = fs.stat-ctime(ls)
atime = fs.stat-atime(ls)

nlink < 1 -> exit(2)
ino <= 0 -> exit(3)
blksize <= 0 -> exit(4)
blocks <= 0 -> exit(5)
mtime <= 0 -> exit(6)
ctime <= 0 -> exit(7)

; atime 在 noatime/relatime 掛載下可能為 0，只讀取不強求 >0
atime < 0 -> exit(8)

; 不同 inode：ino 字段未被摺疊成常數
tmp = '/tmp'
dino = fs.stat-ino(tmp)
dino == ino -> exit(9)

dnlink = fs.stat-nlink(tmp)
dnlink < 1 -> exit(10)

print('stat-fields passed')
