; async.no — 測試無色 async 模型（`awy { }` 協程組 + `co` spawn）
;
; `co f(x)` 只能出現在 `awy { }` 協程組內，會自動單態化出 f-async 變體並在
; 底層以染色無棧協程執行。組內的 `co` 默認並發 spawn，遇到依賴則退化成 await。

; 同步函數：返回輸入值的兩倍
; n: 輸入值，本檔用 21 / 10 / 20 / 25 等值呼叫
; r: n * 2（overflow 採 wrap）
compute = (n i64) (r i64) {

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt = n * 2
        r-opt: {
            ok -> r = it

            ->
        }
    }
}

; 多參數
; a: 第一個加數，本測試傳 15
; b: 第二個加數，本測試傳 27
; r: a + b（overflow 採 wrap），即 42
add = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    {

        #{overflow=wrap}
        r-opt2 = a + b
        r-opt2: {
            ok -> r = it

            ->
        }
    }
}

; 條件邏輯
; n: 待分類的數值，本檔用 5 / -3 / 0
; r: n > 0 為 1、n < 0 為 -1、n == 0 為 0
classify = (n i64) (r i64) {
    {
        n > 0 -> r = 1

        n < 0 -> r = -1

        n == 0 -> r = 0
    }
}

; 1. 單一 spawn（最簡）— awy 組內 r = co f()
test-serial = () {
    awy {
        r = co compute(21)
    }
    print(r); expect: 42
}

; 2. 多參數
test-multi-params = () {
    awy {
        r = co add(15, 27)
    }
    print(r); expect: 42
}

; 3. 條件邏輯
test-conditional = () {
    awy {
        r1 = co classify(5)
        r2 = co classify(-3)
        r3 = co classify(0)
    }
    print(r1); expect: 1
    print(r2); expect: -1
    print(r3); expect: 0
}

; 4. 並發：協程組內兩個 co 並發 spawn，最後一起 await
test-concurrent = () {
    r1 i64
    r2 i64
    awy {
        r1 = co compute(10)
        r2 = co compute(20)
    }

    #{overflow=wrap}
    print(r1 + r2); expect: 60
}

; 5. 順序執行：兩個獨立的 awy 組先後 spawn + await
test-statement-level = () {
    awy {
        r = co compute(10)
    }
    awy {
        s = co compute(20)
    }

    #{overflow=wrap}
    print(r + s); expect: 60
}

; 6. 協程組內讀取結果：print(r1) 是屏障，r1 必須先落地
test-group-read = () {
    r1 i64
    awy {
        r1 = co compute(25)
        print(r1); expect: 50
    }
}
test-serial()
test-multi-params()
test-conditional()
test-concurrent()
test-statement-level()
test-group-read()
