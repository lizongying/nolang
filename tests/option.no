; ✅ match 語句：分支是代碼塊

x-1 = 3
x: {
    1 -> print(11)

    2 -> print(22)

    -> print(33)
}
x-1 = 4
x: {
    1 -> print(111)

    2 -> print(222)

    -> print(333)
}

; ✅ match 表達式：分支體是單一表達式
a-1 = 100
b = 101

#{overflow=wrap}
result = x: {
    ; 單一值
    1 -> 1

    2 -> 2 + 1; 簡單表達式

    -> a-1 + b
}
print(result)

