; from f64-option.no — str.to-f64 的 Option 化實現
f64-print = (s str) {
    f = s.to-f64()
    {
        f == nil -> print('nil')

        f == err -> print('err')

        -> print(f)
    }
}

; from option-simple-minimal.no — 最小化 val/err 測試
osm-simple = () {
    n ?i64 = ok(42)
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> {
            print('val=')
            print(n)
        }
    }
}

osm-simple2 = () {
    n ?i64 = nil
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> {
            print('val=')
            print(n)
        }
    }
}

osm-simple3 = () {
    n ?i64 = err('oops')
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> {
            print('val=')
            print(n)
        }
    }
}

; from option-struct-payload-drop.no — 內聯 owning struct payload 每次重綁必釋放
; 頂層片段：last 為模組全域，迴圈內覆寫（原檔即如此）。
ospd-person {
    name str
}
ospd-last = ''
i <- [0..2000): {
    p ospd-person
    p.name = i.to-str()
    ip ?ospd-person = p
    q ospd-person = ip
    ospd-last = q.name
}
print(ospd-last)
j <- [0..2000): {
    r = json.parse('{"name":"Alice"}')
    r: {
        ok -> {
            s-opt = it.get-str('name')
            s-opt: {
                ok -> {
                    ospd-last = it
                }

                -> _
            }
        }

        err -> {
            ospd-last = 'err'
        }

        nil -> {
            ospd-last = 'nil'
        }
    }
}
print(ospd-last)

