; from opt-match-all.no — option match 的所有分支
oma-test-err = () {
    n ?i64 = err('boom')
    r = n: {
        err -> 'got-err'

        nil -> 'got-nil'

        -> 'got-val'
    }
    print(r)
}

oma-test-nil = () {
    n ?i64 = nil
    r = n: {
        err -> 'got-err'

        nil -> 'got-nil'

        -> 'got-val'
    }
    print(r)
}

oma-test-val = () {
    n ?i64 = 42
    r = n: {
        err -> 'got-err'

        nil -> 'got-nil'

        -> 'got-val'
    }
    print(r)
}

oma-test-err-only = () {
    n ?i64 = err('oops')
    r = n: {
        err -> 'only-err'

        -> 'otherwise'
    }
    print(r)
}

