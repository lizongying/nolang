; test-fmt-helpers.no — 測試 fmt-parse-spec/fmt-apply-spec/fmt-int/fmt-uint/fmt-f64/fmt-str/fmt-bool/fmt-uint-base
; 注意：因編譯器 bug（print 直接接收函數返回值時 @print 未宣告），
; 所有用例先將結果賦值給變數再 print。
; 為了讓填充空白可見，部分用例以 '[' 與 ']' 包夾輸出。

main = () {
    print('=== fmt-parse-spec ===')
    fill, align, sign, alt, zero, width, grouping, precision, typ = fmt-parse-spec('<+08.2f')
    print(fill)
    print(align)
    print(sign)
    print(alt)
    print(zero)
    print(width)
    print(grouping)
    print(precision)
    print(typ)
    print()

    print('=== fmt-apply-spec ===')
    s = fmt-apply-spec('42', 32, 0, 5)
    print('[' - s - ']')
    s = fmt-apply-spec('42', 32, 60, 5)
    print('[' - s - ']')
    s = fmt-apply-spec('42', 32, 94, 5)
    print('[' - s - ']')
    s = fmt-apply-spec('42', 42, 94, 8)
    print('[' - s - ']')
    print()

    print('=== fmt-int ===')
    s = fmt-int(42, '')
    print(s)
    s = fmt-int(42, '5')
    print('[' - s - ']')
    s = fmt-int(42, '<5')
    print('[' - s - ']')
    s = fmt-int(42, '^5')
    print('[' - s - ']')
    s = fmt-int(42, '05')
    print(s)
    s = fmt-int(-42, '5')
    print('[' - s - ']')
    s = fmt-int(42, '+5')
    print('[' - s - ']')
    s = fmt-int(42, '*^8')
    print(s)
    s = fmt-int(0, '')
    print(s)
    s = fmt-int(-7, '03')
    print(s)
    print()

    print('=== fmt-uint-base ===')
    s = fmt-uint-base(255, 16, false)
    print(s)
    s = fmt-uint-base(255, 16, true)
    print(s)
    s = fmt-uint-base(255, 2, false)
    print(s)
    s = fmt-uint-base(255, 8, false)
    print(s)
    s = fmt-uint-base(0, 16, false)
    print(s)
    print()

    print('=== fmt-uint ===')
    s = fmt-uint(255, 'x')
    print(s)
    s = fmt-uint(255, 'X')
    print(s)
    s = fmt-uint(255, '#x')
    print(s)
    s = fmt-uint(255, 'b')
    print(s)
    s = fmt-uint(255, 'o')
    print(s)
    s = fmt-uint(255, '08x')
    print(s)
    s = fmt-uint(0, 'x')
    print(s)
    s = fmt-uint(4095, '#X')
    print(s)
    print()

    print('=== fmt-f64 ===')
    s = fmt-f64(3.14159, '.2f')
    print(s)
    s = fmt-f64(3.14159, '.4f')
    print(s)
    s = fmt-f64(12345.678, '.2e')
    print(s)
    s = fmt-f64(3.14159, '.3g')
    print(s)
    s = fmt-f64(3.14159, '')
    print(s)
    s = fmt-f64(-3.14, '8.2f')
    print('[' - s - ']')
    s = fmt-f64(3.14, '+.2f')
    print(s)
    s = fmt-f64(3.14, '08.2f')
    print(s)
    s = fmt-f64(0.0, '.2f')
    print(s)
    print()

    print('=== fmt-str ===')
    s = fmt-str('hello', '10')
    print('[' - s - ']')
    s = fmt-str('hello', '<10')
    print('[' - s - ']')
    s = fmt-str('hello', '.3')
    print(s)
    s = fmt-str('hello', '^10')
    print('[' - s - ']')
    s = fmt-str('hi', '')
    print(s)
    print()

    print('=== fmt-bool ===')
    s = fmt-bool(true, '')
    print(s)
    s = fmt-bool(false, '')
    print(s)
    s = fmt-bool(true, '6')
    print('[' - s - ']')
    s = fmt-bool(false, '<6')
    print('[' - s - ']')
}

main()
