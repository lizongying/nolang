// test-sha256-step10 — 只有 [32]byte 返回值，無參數
// # std/hash/sha256

my-fn = () (hash [32]byte) {
    hash[0] = 0x61
    hash[1] = 0x62
    hash[2] = 0x63
}

main = () {
    print('start')
    print('before my-fn')
    h [32]byte
    h = my-fn()
    print('after my-fn')
    print(h[0])
    print(h[1])
    print(h[2])
    print('done')
}
