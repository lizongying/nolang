; merged category 'err' -- members: err-structured.no, err.no, fs-error-complete.no, fs-error-simple.no
; (originals backed up under tests/_archive/err/)
; merged from tests/err-structured.no
; err-structured.no — option 的 err 載荷是結構化的 err.err
;
; 回歸：err 載荷從「訊息字串」換成 std 的 err.err（code / msg / file / line / col）
; 之後，它 ~72 字節裝不進 24 字節的載荷槽，改走 tag==2 堆裝箱。整套機制必須咬合：
;   - 構造器：err(msg[, code]) 建出 err.err，file/line/col 由構造點自動注入；
;   - 讀側：optPayloadAddrAs 在 tag == 2 解箱，err 臂的 it 拿到完整的 err.err；
;   - drop：emitOptionDropHelper 的 err 分支釋放 box 與其擁有的字串；
;   - 拷貝：option → option 必須重新裝箱，否則兩側釋放同一塊（雙重釋放）。
;
; 只改其中任一處的症狀：讀到指標（亂碼）、漏釋放、或 trace/BPT trap。
...

; 檢查
; name str: 這項檢查的名稱，輸出時原樣印出
; got str: 實際取得的值
; want str: 預期值；兩者相等印 'ok'，否則印 'fail' 並附上二者
check = (name str, got str, want str) {
    {
        got == want -> print('ok: {name}')

        -> print('fail: {name} got=[{got}] want=[{want}]')
    }
}

; 固定失敗的函式：用 err 狀態帶上訊息 'boom' 與錯誤碼 code.io
; out ?i64: 必為 err（不提供 ok 值），供上層 match 驗證 err 分支
fail-i64 = () (out ?i64) {
    out = err('boom', code.io)
}

; ── 1. 訊息 ──
a = fail-i64()
got1 = ''
got1 = a: {
    err -> it.msg()

    -> 'ok'
}
check('msg', got1, 'boom')

; ── 2. 錯誤碼 ──
a2 = fail-i64()
got2 = ''
a2: {
    err -> {
        yes = it.is(code.io)
        {
            yes -> got2 = 'io'

            -> got2 = 'other'
        }
    }

    -> got2 = 'ok'
}
check('code', got2, 'io')

; ── 3. 位置：file 由編譯器在 err(...) 構造點注入 ──
a3 = fail-i64()
got3 = ''
got3 = a3: {
    err -> it.file

    -> 'ok'
}
check('file', got3, 'err-structured.no')

; ── 4. 透傳：err(err.err) 必須保留 code 與位置，不能退化成「重建一則訊息」 ──
; out ?bool: 收到 err 時原樣透傳（保留 code）；非 err 時為 ok(true)
rethrow = () (out ?bool) {
    m = fail-i64()
    m: {
        err -> out = err(it)

        -> out = true
    }
}
b = rethrow()
got4 = ''
got4 = b: {
    err -> it.msg() - '@' - it.file

    -> 'ok'
}
check('rethrow', got4, 'boom@err-structured.no')

; ── 5. option → option 拷貝：兩側都要讀得到訊息，且不能雙重釋放 ──
c = fail-i64()
d = c
got5 = ''
got6 = ''
got5 = c: {
    err -> it.msg()

    -> 'ok'
}
got6 = d: {
    err -> it.msg()

    -> 'ok'
}
check('copy-src', got5, 'boom')
check('copy-dst', got6, 'boom')

; merged from tests/err.no
; err.no — err 模組測試
;
; 測試 new, error.is, error.msg, error.code, from-errno, error.format
; 注意：str-long value type 跨函式邊界傳遞時長度不一致，
; 故 msg 相關測試只驗證呼叫完成，不檢查字串長度。
...

; # std/err

; ── 1. new 建立錯誤，檢查 code ──
e = err.new('disk full', code.io)

yes = e.is(code.io)
{
    yes -> print('ok: new code')

    -> print('fail: new code')
}

; ── 2. error.msg 取得訊息（只驗證呼叫完成）──
msg = e.msg()
print('ok: error.msg')

; ── 3. error.is 比對錯誤碼（true 和 false）──
yes = e.is(code.io)
{
    yes -> print('ok: error.is true')

    -> print('fail: error.is true')
}
yes = e.is(code.not-found)
{
    yes == false -> print('ok: error.is false')

    -> print('fail: error.is false')
}

; ── 4. error.code 取得錯誤碼 ──
mc = e.code()
{
    mc == code.io -> print('ok: error.code')

    -> print('fail: error.code')
}

; ── 5. from-errno(2) 建立錯誤（errno 2 = ENOENT → code.not-found）──
e2 = err.from-errno(2)
yes2 = e2.is(code.not-found)
{
    yes2 -> print('ok: from-errno code')

    -> print('fail: from-errno code')
}
errno-msg = e2.msg()
print('ok: from-errno msg')

; ── 6. error.format 格式化錯誤（含錯誤碼）──
s = e.format()
{
    s == 'code.io: disk full' -> print('ok: error.format')

    -> print('fail: error.format')
}

; ── 7. code.to-name 取得變體名 ──
tc = e.code()
ns = tc.to-name()
{
    ns == 'io' -> print('ok: code.to-name')

    -> print('fail: code.to-name')
}

; merged from tests/fs-error-complete.no
; 测试文件操作错误信息细分
; 验证 fs.open 失败时返回详细的错误信息
...

print('--- 测试 fs.open 错误信息 ---')
print('')

; 测试 1: 文件不存在 (ENOENT = 2)
print('测试 1: 文件不存在')
print('  路径: /nonexistent/file-12345.txt')
f1 ?fs.file = fs.open('/nonexistent/file-12345.txt', {
    mode: file-mode.read
})
f1: {
    err -> print('  错误: {it}')

    nil -> print('  结果: nil')

    -> print('  结果: 文件已打开')
}
print('')

; 测试 2: 尝试打开目录作为文件
print('测试 2: 尝试打开目录')
print('  路径: /tmp')
f2 ?fs.file = fs.open('/tmp', {
    mode: file-mode.read
})
f2: {
    err -> print('  错误: {it}')

    nil -> print('  结果: nil')

    -> print('  结果: 文件已打开')
}
print('')

; 测试 3: 成功创建并打开文件
print('测试 3: 成功打开文件')
print('  路径: /tmp/nolang-test-err.txt')
f3 ?fs.file = fs.open('/tmp/nolang-test-err.txt', {
    mode: file-mode.write
    perm: file-perm.perm-644
})
f3: {
    err -> print('  错误: {it}')

    nil -> print('  结果: nil')

    -> {
        print('  结果: 文件已打开成功')

        .write-str('hello')

        .close()
    }
}
print('')
print('--- 测试完成 ---')

i <- [12..3): {
}

; merged from tests/fs-error-simple.no
; 简单测试文件操作错误信息
...
print('测试: 打开不存在的文件')
f ?fs.file = fs.open('/nonexistent/file.txt', {
    mode: 0
})

; 使用 match 匹配不同错误情况
f: {
    nil -> print('  结果: nil (未修改的版本)')

    -> print('  结果: 文件已打开')
}
print('测试完成')
