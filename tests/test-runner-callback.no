// test-runner-callback.no — runner.no test-run 回呼測試
//
// 驗證 src/test/runner.no 的 test-run 函式：
//   test-run = (name str, fn fn ()) (passed i64, failed i64)
// 傳入具名函式作為回呼，確認計數正確（執行完成 → passed=1, failed=0）。

# /src/test/runner

greet = () {
    print('hi from greet')
}

test1 = () {
    print('test1 running')
}

p i64 = 0
f i64 = 0
p, f = test-run('greet', greet)
if p == 1 {
    print('ok: test-run greet passed')
} else {
    print('fail: test-run greet passed')
}
if f == 0 {
    print('ok: test-run greet failed=0')
} else {
    print('fail: test-run greet failed=0')
}

p2 i64 = 0
f2 i64 = 0
p2, f2 = test-run('test1', test1)
if p2 == 1 {
    print('ok: test-run test1 passed')
} else {
    print('fail: test-run test1 passed')
}

