; tagged-enum.no — 任意標籤列舉（帶載荷 / 多欄位 / 命名空間 / 表達式位置建構）
#{overflow = wrap}
;
; 覆蓋：
;   - 單元變體（無載荷）
;   - 單欄位載荷 + 析構綁定
;   - 多欄位載荷 + 按位置析構綁定
;   - 表達式位置建構（函數引數 / 枚舉載荷為另一枚舉）
;   - 命名空間：不同枚舉的同名變體、不同 tag 順序互不干擾

; --- 單元 + 單欄位 ---
color {
    red,
    green,
    blue,
}

box {
    full(v i64),
    empty,
}

color-name = (c color) (s str) {
    c: {
        red -> s = 'red'
        green -> s = 'green'
        blue -> s = 'blue'
    }
}

; --- 多欄位 ---
shape {
    circle(r f64),
    rect(w f64, h f64),
    dot,
}

area = (s shape) (a f64) {
    s: {
        circle(r) -> { a = r * 3.0 #{overflow = wrap} }
        rect(w, h) -> { a = w * h #{overflow = wrap} }
        dot -> a = 0.0
    }
}

; --- 命名空間：兩個枚舉都有 ok/fail，tag 順序不同 ---
a-res {
    fail,
    ok(v i64),
}

b-res {
    ok(v str),
    fail,
}

; --- 枚舉作為參數 / 回傳值 ---
make-rect = () (s shape) {
    s = rect(3.0, 4.0)
}

main = () {
    ; 單元變體匹配
    c color = green
    print(color-name(c))

    ; 單欄位載荷綁定
    b box = full(7)
    b: {
        full(v) -> print('full')
        empty -> print('empty')
    }

    ; 多欄位載荷 + 表達式位置建構（內聯傳參）
    x f64 = area(rect(2.0, 3.0))
    print(x)

    ; 枚舉作為回傳值，再以變數匹配
    s shape = make-rect()
    y f64 = area(s)
    print(y)

    ; 命名空間：同名變體、不同 tag 順序
    p a-res = ok(5)
    p: {
        fail -> print('a-fail')
        ok(v) -> print('a-ok')
    }
    q b-res = ok('hi')
    q: {
        ok(v) -> print(v)
        fail -> print('b-fail')
    }
}
