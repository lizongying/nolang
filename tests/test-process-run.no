; test-process-run.no — exercise the cross-platform process-run API.
;
; Covers: basic args, working directory, environment, stdin,
; stderr merge, timeout, and start/exec failure.
;
; process-run signature (flat args, no struct — nolang does not forward
; struct definitions across module boundaries):
;   process.cmd(program, args, dir, stdin, env, timeout, merge-err)

; shared empty-args slice
noArgs []str = with-len(0)

; 1) basic echo with args
args1 []str = with-len(2)
args1[0] = 'hello'
args1[1] = 'world'
out, code, err = process.cmd('echo', args1, '', '', noArgs, 0, 0)
ok1 = out == 'hello world\n' && code == 0
ok1 -> print('[1] basic args ................... PASS')
ok1 == false -> print('[1] basic args ................... FAIL out=' - out.trim() - ' code=' - code.to-str())

; 2) working directory
out, code, err = process.cmd('pwd', noArgs, '/tmp', '', noArgs, 0, 0)
ok2 = code == 0 && out.contains('/tmp')
ok2 -> print('[2] working dir .................. PASS')
ok2 == false -> print('[2] working dir .................. FAIL out=' - out.trim())

; 3) environment variable (passed as K=V slice)
env3 []str = with-len(1)
env3[0] = 'MY_TEST_VAR=secret'
printenvArgs []str = with-len(1)
printenvArgs[0] = 'MY_TEST_VAR'
out, code, err = process.cmd('printenv', printenvArgs, '', '', env3, 0, 0)
ok3 = code == 0 && out == 'secret\n'
ok3 -> print('[3] environment .................. PASS')
ok3 == false -> print('[3] environment .................. FAIL out=' - out.trim())

; 4) stdin fed to child
out, code, err = process.cmd('cat', noArgs, '', 'piped-stdin-data', noArgs, 0, 0)
ok4 = code == 0 && out == 'piped-stdin-data'
ok4 -> print('[4] stdin ........................ PASS')
ok4 == false -> print('[4] stdin ........................ FAIL out=' - out)

; 5) merge stderr into captured output
shArgs []str = with-len(2)
shArgs[0] = '-c'
shArgs[1] = 'echo STDOUT_LINE; echo STDERR_LINE 1>&2'
out, code, err = process.cmd('sh', shArgs, '', '', noArgs, 0, 1)
ok5 = code == 0 && out.contains('STDOUT_LINE') && out.contains('STDERR_LINE')
ok5 -> print('[5] merge stderr ................. PASS')
ok5 == false -> print('[5] merge stderr ................. FAIL out=' - out.trim())

; 5b) without merge, stderr must NOT appear in captured stdout
out, code, err = process.cmd('sh', shArgs, '', '', noArgs, 0, 0)
ok5b = code == 0 && out.contains('STDOUT_LINE') && out.contains('STDERR_LINE') == false
ok5b -> print('[5b] separate stderr .............. PASS')
ok5b == false -> print('[5b] separate stderr .............. FAIL out=' - out.trim())

; 6) timeout kills the child (status == -2)
sleepArgs []str = with-len(1)
sleepArgs[0] = '5'
out, code, err = process.cmd('sleep', sleepArgs, '', '', noArgs, 200, 0)
ok6 = code == -2
ok6 -> print('[6] timeout ....................... PASS')
ok6 == false -> print('[6] timeout ....................... FAIL code=' - code.to-str())

; 7) start/exec failure (status == -1, err populated)
badArgs []str = with-len(1)
badArgs[0] = 'program-xyz'
out, code, err = process.cmd('/no/such/program-xyz', badArgs, '', '', noArgs, 0, 0)
ok7 = code == -1 && err != ''
ok7 -> print('[7] start failure ................ PASS')
ok7 == false -> print('[7] start failure ................ FAIL code=' - code.to-str() - ' err=' - err)

all = ok1 && ok2 && ok3 && ok4 && ok5 && ok5b && ok6 && ok7
all -> print('ALL PASS')
all == false -> {
    print('SOME TESTS FAILED')
    os.exit(1)
}
