; 第二半前4个测试
test-arr-index-of = () {
    b [3] = [1, 2, 3]
    print(b.index-of(2))
    print(b.index-of(99))
}

test-arr-last-first = () {
    b [3] = [10, 20, 30]
    print(b.first())
    print(b.last())
}

test-arr-sort-asc = () {
    b [5] = [3, 1, 4, 1, 5]
    b.sort-asc()
    print(b[0])
    print(b[1])
    print(b[2])
    print(b[3])
    print(b[4])
}

test-arr-sort-desc = () {
    b [5] = [3, 1, 4, 1, 5]
    b.sort-desc()
    print(b[0])
    print(b[1])
    print(b[2])
    print(b[3])
    print(b[4])
}

test-arr-index-of()
print('---')
test-arr-last-first()
print('---')
test-arr-sort-asc()
print('---')
test-arr-sort-desc()
