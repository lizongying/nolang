; 第二半前4个测试
test-arr-index-of = () {
    a [3] = [1, 2, 3]
    print(a.index-of(2))
    print(a.index-of(99))
}

test-arr-last-first = () {
    a [3] = [10, 20, 30]
    print(a.first())
    print(a.last())
}

test-arr-sort-asc = () {
    a [5] = [3, 1, 4, 1, 5]
    a.sort-asc()
    print(a[0])
    print(a[1])
    print(a[2])
    print(a[3])
    print(a[4])
}

test-arr-sort-desc = () {
    a [5] = [3, 1, 4, 1, 5]
    a.sort-desc()
    print(a[0])
    print(a[1])
    print(a[2])
    print(a[3])
    print(a[4])
}

test-arr-index-of()
print('---')
test-arr-last-first()
print('---')
test-arr-sort-asc()
print('---')
test-arr-sort-desc()
