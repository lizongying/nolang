// test-open-perm.no — 驗證 open() 檔案權限

# std/fs

tmp = '/tmp/nolang-perm-test.txt'
remove(tmp)

f ?file
f = fs.open(tmp, {
    mode: file-mode.write
    perm: file-perm.perm-600
    excl: false
    truncate: false
    append: false
})
f: {
    err -> print('fail')
    nil -> print('fail')
    -> {
        it.write('x', 1)
        it.close()
        print('ok')
    }
}

remove(tmp)

