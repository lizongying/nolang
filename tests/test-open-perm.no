; test-open-perm.no — 驗證 open() 檔案權限

tmp = '/tmp/nolang-perm-test.txt'
fs.remove(tmp)

f ?fs.file
f = fs.open(tmp,  {
    mode: file-mode.write
    perm: file-perm.perm-600
    excl: false
    truncate: false
    append: false
})
f: {
    err -> print('fail')
    nil -> print('fail')
    -> {
        .write('x', 1)

        .close()
        print('ok')
    }
}

fs.remove(tmp)
