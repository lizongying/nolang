; Two tasks that each suspend inside their own awy group, with a flow-arm `co`
; in each group. The trace is a-enter, b-enter, a-leave, b-leave: with one global
; join stack the second resume pops the FIRST task's frame and double-retires a
; handle. Per-task frames (task.join_top) keep the two leaves independent.

# /test/runner

wake-a chan[i64] = with-cap(1)
wake-b chan[i64] = with-cap(1)

helper = (c chan[i64]) {
    c <- 1
    c.close()
}

a = (c chan[i64]) {
    one = 1
    awy {
        one == 1 -> {
            co helper(c)
        }
        <- c: {
            ok -> {
            }

            -> {
            }
        }
    }
}

b = (c chan[i64]) {
    one = 1
    awy {
        one == 1 -> {
            co helper(c)
        }
        <- c: {
            ok -> {
            }

            -> {
            }
        }
    }
}

awy {
    co a(wake-a)
    co b(wake-b)
}
runner.eq(1, 1, 'two suspended groups did not corrupt each other')
runner.summary()
fails = runner.failed-count()
fails > 0 -> exit(1)
exit(0)
