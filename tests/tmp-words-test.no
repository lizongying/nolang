words []str = with-cap(256)
counts []i64 = with-cap(256)
word [64]byte
wlen i64 = 0
n i64 = 0
tmp-word str = ''

; 模擬單詞 "hello"
word[0] = 104
word[1] = 101
word[2] = 108
word[3] = 108
word[4] = 111
wlen = 5

; 構造 str
tmp-word = with-cap(64)
k = 0
k <- [0..wlen): {
    tmp-word[k] = word[k]
}
words.push(tmp-word)
counts.push(1)
n = 1

; 模擬第二個單詞 "world"
word[0] = 119
word[1] = 111
word[2] = 114
word[3] = 108
word[4] = 100
wlen = 5

tmp-word = with-cap(64)
k <- [0..wlen): {
    tmp-word[k] = word[k]
}

; 線性搜尋
found i64 = 0
cmp-result i64 = 0
k <- [0..n): {
    found == 0 -> {
        cmp-result = tmp-word.compare(words[k])
        cmp-result == 0 -> {
            counts[k] = counts[k] + 1
            found = 1
        }
    }
}
found == 0 -> {
    words.push(tmp-word)
    counts.push(1)
    n = n + 1
}

; 輸出
k <- [0..n): {
    print(words[k] - ' ' - counts[k].to-str())
}
