// test-hmac2 — 測試 hmac-sha256 輸出參數形式
// # std/hash/hmac

main = () {
    print('start')
    key []byte
    key[0] = 1
    key[1] = 2
    msg []byte
    msg[0] = 0xAA
    msg[1] = 0xBB
    print('before hmac')
    a [32]byte
    hmac-sha256(key, 2, msg, 2)(a)
    print('after hmac')
    print(a[0])
    print('done')
}
