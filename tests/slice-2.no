; originals recoverable from git HEAD (ed7b5236)

; merged from tests/slice1.no
; 取得 slice
...

; out: local[1..3] 逃逸到輸出，必須 clone 成 [200, 300]（不受 local 重賦值影響）
get-slice = () (out []i64) {
    local = [100, 200, 300, 400]
    out = local[1..3]
    local = [100, 200, 300]
}
v = get-slice()
print(v[0])
print(v[1])

; merged from tests/move-slice.no
; 取字串切片並回傳，同時印出原字串（驗證切片是獨立副本而非懸掛視圖）
...

; x: 來源字串，至少 1 個字元；本測試先傳 'abc' 再傳 'def'
; res: x 的前 1 個字元，'abc' → 'a'、'def' → 'd'
foo = (x str) (res str) {

    ; 字符串切片截取属于生成独立副本，必须分配新堆、拷贝字符：
    y = x[0..1]
    res = y
    print(x)
}

; 先定义res
; foo 赋值''
res = foo('abc')

; 第二次调用，res已经有值，是新赋值
; foo 赋值
x = 'def'
res = foo(x)

; merged from tests/vec-slice-more.no
; vec-slice-more.no — 合併自 vec slice / 巢狀 vec 碎片（頂層拼接，非函數包裹）
; 來源：vec-slice.no, nested-vec-test.no
; 保留錨點：vec.no（基名）；vec-more.no（既有合併檔：reverse/elem/assign/u32/len/
;            push-clear/to-str 等，另行保留，regress-vec-to-str.sh 依賴它）
; ── 來自 vec-slice.no ──
; vec-slice test (slice 區間語法全覆蓋)
...
a = [10, 20, 30, 40, 50]

; full slice: a[..]
b = a[..]
print(b[0])
print(b[1])
print(b[2])
print(b[3])
print(b[4])

; from index: a[2..]
c = a[2..]
print(c[0])
print(c[1])
print(c[2])

; to index inclusive: a[..3]
d = a[..3]
print(d[0])
print(d[1])
print(d[2])

; range: a[1..4]
e = a[1..4]
print(e[0])
print(e[1])
print(e[2])

; range exclusive end: a[1..4)
f = a[1..4)
print(f[0])
print(f[1])
print(f[2])

; range exclusive start: a(1..4]
g = a(1..4]
print(g[0])
print(g[1])
print(g[2])

; range exclusive both: a(1..4) → indices 2,3 (len=2)
h = a(1..4)
print(h[0])
print(h[1])

; till index exclusive: a[..1)
i = a[..1)
print(i[0])

; single element: a[1..2)
j = a[1..2)
print(j[0])

print('---')

; ── 來自 nested-vec-test.no ──
; 巢狀 vec：b 推入 make-vec2 後再拷給 b0，改 b0 內層元素不得影響原始 a[0]
make-vec2 = (a i64, b i64) (v []i64) {
    v.push(a)
    v.push(b)
}

test1 = () (ok bool) {
    a [][]i64
    a.push(make-vec2(1, 2))
    b = a
    ; b 是 a 的深拷貝，`b[0]` 與任何下標讀取一樣回 ?[]i64，必須解包
    b0 = b[0]: {
        ok -> it

        -> []
    }
    b0.push(100)
    b0.len() == 3 -> ok = true
    b0[2] == 100 -> ok = true
}

ok1 = test1()
print('test1: {ok1}')
