; test_path_char2 — 驗證 path.no 使用 char 字面量常量後正常工作
; # std/path
print('=== path char test ===')

p = path {
    p: '/usr/local/bin'
}
print(p.p)

; ⚠️ path.join() 也是**原地修改 .p**（無回傳值）；
; 原本 `joined = p2.join(...)` 只會拿到空字串。
p2 = path {
    p: '/usr'
}
p2.join('local/bin')
print(p2.p)

print('=== done ===')
