; # std/regexp

matched = regexp.regexp-match('hello.*world', 'hello nolang world')
print('regexp-match test 1: {matched}')

not_matched = regexp.regexp-match('foo.*bar', 'hello world')
print('regexp-match test 2: {not_matched}')

match_str = regexp.regexp-find('[0-9]+', 'abc123def456')
print('regexp-find test: {match_str}')
