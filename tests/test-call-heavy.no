add = (a i64, b i64) (r i64) {
  r = a + b
}
sub = (a i64, b i64) (r i64) {
  r = a - b
}
mul = (a i64, b i64) (r i64) {
  r = a * b
}
fib = (n i64) (r i64) {
  n < 2 -> r = n
  n >= 2 -> r = fib(n - 1) + fib(n - 2)
}
swap = (a i64, b i64) (x i64, y i64) {
  x = b
  y = a
}
str-id = (s str) (out str) {
  out = s
}
sum-to = (n i64) (r i64) {
  r = 0
  for i in [0, 1, 2, 3, 4] {
    r = r + i
  }
}
main = () () {
  x = add(3, 4)
  y = sub(x, 2)
  z = add(sub(1, 1), add(2, 2))
  w = add(z, y)
  print(x)
  print(y)
  print(z)
  print(w)
  print(fib(10))
  m, n = swap(3, 4)
  print(m)
  print(n)
  print(str-id('hello, nolang'))
  print(sum-to(5))
  acc = 0
  for i in [1, 2, 3, 4, 5] {
    acc = add(acc, mul(i, i))
  }
  print(acc)
}
main()
