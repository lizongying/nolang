; map-more.no — 合併自 map 轉換 / 深拷貝碎片（頂層拼接，非函數包裹）
; 來源：map-to-str.no, map-struct-deep-copy.no
; 保留錨點：map.no（基名）；map-generics.no（泛型 map 獨立）
; ── 來自 map-to-str.no ──
; A [str]i64 / [str]bool map must render as `{key: value, ...}` (order is
; hashmap-internal and stable per build, so the regression script pins it).
; An empty map renders as `{}`. Format fields also work.

m [str]i64 = { 'a': 1, 'b': 2, 'c': 3 }
print(m); expect: {c: 3, b: 2, a: 1}

me [str]i64 = { }
print(me); expect: {}

mb [str]bool = { 'x': true, 'y': false }
print(mb); expect: {y: 0, x: 1}

print('m={m}'); expect: m={c: 3, b: 2, a: 1}

print('---')

; ── 來自 map-struct-deep-copy.no ──
; Regression: a struct copy of a map must not share its backing arrays.
; Updating an existing value mutates vals[idx] in place, so reading the copied
; map after the write distinguishes a deep copy from a shallow map alias.

original [str]str = { 'a': '1' }
copied = original
original.put('a', 'X')

copied-value = copied.get('a')
copied-value: {
    ok -> print('copied[a] =', copied-value)

    nil -> print('copied[a] = nil')

    err -> print('copied[a] = err')
}

original-value = original.get('a')
original-value: {
    ok -> print('original[a] =', original-value)

    nil -> print('original[a] = nil')

    err -> print('original[a] = err')
}
