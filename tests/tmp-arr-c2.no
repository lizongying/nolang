test-arr-sort-asc = () {
    a [5] = [3, 1, 4, 1, 5]
    a.sort-asc()
    print(a[0])
    print(a[1])
    print(a[2])
    print(a[3])
    print(a[4])
}

test-arr-at = () {
    a [3] = [1, 2, 3]
    print(a.at(0))
    print(a.at(5))
    print(a.at(-1))
}

test-arr-sort-asc()
print('---')
test-arr-at()
