; Nolang 综合测试
x = 1; int64
y = 1.0; float64
name = 'hello'; string
flag = true; bool

; 显式类型标注
a i8 = 2; int8 类型

; 中连接符变量名
foo-bar = 42
hello-world = 'Hello World'

; 函数定义
; a i64: 第一個加數
; b i64: 第二個加數
add = (a i64, b i64) {

    #{overflow=wrap}
    result = a + b
    print('result: {result}')
}

; 帶輸出參數的版本：c、d 宣告為輸出，但體內只置 0，未寫回和
; a i64: 第一個加數（只參與印出）
; b i64: 第二個加數（只參與印出）
; c i64: 固定寫入 0
; d i64: 固定寫入 0
add1 = (a i64, b i64) (c i64, d i64) {
    c = 0
    d = 0

    #{overflow=wrap}
    result = a + b
    print('result: {result}')
}

; 匿名函数赋值
; 匿名函式賦值給 f：兩個參數都只讀，本體只印出 out
; x i64: 第一個參數，本體未使用
; out i64: 要印出的數值
f = (x i64, out i64) {
    print('doubled: {out}')
}

; 条件循环
sum = 0
j <- [0..5): {

    #{overflow=wrap}
    sum = sum + j
}
i = 5
print('sum: {sum}')

; 数组和切片
arr [3] = [1, 2, 3]
slice = [4, 5, 6]
print('array:', arr)
s0 = slice[0]
print('slice[0]: {s0}')

; 三元表达式
max = sum > 10 ? sum : 10
print('max: {max}')

; 调用函数
add(10, 20)
f(5, 0)
f(a, 10)

; 5 次循環
{

    #{overflow=wrap}
    sum = sum + i

    #{overflow=wrap}
    i = i + 1
}
5
