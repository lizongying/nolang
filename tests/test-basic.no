; test-basic.no — 核心編譯驗證

i64-max = (a i64, b i64, r i64) {
    d = a - b
    {
        d > 0 -> r = a
        -> r = b
    }
}

i64-min = (a i64, b i64, r i64) {
    d = a - b
    {
        d > 0 -> r = b
        -> r = a
    }
}

abs-i64 = (a i64, r i64) {
    {
        a < 0 -> r = 0 - a
        -> r = a
    }
}

gcd = (a i64, b i64, r i64) {
    a < 0: {
        a = 0 - a
    }
    b < 0: {
        b = 0 - b
    }
    b != 0: {
        t = b
        b = a % b
        a = t
    }
    r = a
}

caller = () {
    r = 0

    i64-max(10, 20, r)
    print(r)

    i64-min(10, 20, r)
    print(r)

    abs-i64(-42, r)
    print(r)

    gcd(12, 18, r)
    print(r)
}

caller()
