; test-basic.no — 核心編譯驗證

i64-max = (a i64, b i64) (r i64) {
    #{overflow = wrap}
    d = a - b
    {
        d > 0 -> r = a
        -> r = b
    }
}

i64-min = (a i64, b i64) (r i64) {
    #{overflow = wrap}
    d = a - b
    {
        d > 0 -> r = b
        -> r = a
    }
}

abs-i64 = (a i64) (r i64) {
    {
        #{overflow = wrap}
        a < 0 -> r = 0 - a
        -> r = a
    }
}

gcd = (a i64, b i64) (r i64) {
    ra = a
    rb = b
    {
        #{overflow = wrap}
        ra = 0 - ra
    } (ra < 0)
    {
        #{overflow = wrap}
        rb = 0 - rb
    } (rb < 0)
    {
        t = rb
        rb = ra % rb
        ra = t
    } (rb != 0)
    r = ra
}

caller = () {
    r = 0

    r = i64-max(10, 20)
    print(r)

    r = i64-min(10, 20)
    print(r)

    r = abs-i64(-42)
    print(r)

    r = gcd(12, 18)
    print(r)

    print('ok: all tests done')
}
caller()
