; map.no — 測試 map 類型與 hashmap 實作

test-map-str-i64 = () {
    m [str]i64 = { 'a': 0, 'b': 1 }
    m.put('c', 2)

    v = m.get('a')
    v: {
        ok -> print(); expect: 0

        nil -> print('nil')

        err -> print('err')
    }
    v = m.get('c')
    v: {
        ok -> print(); expect: 2

        nil -> print('nil')

        err -> print('err')
    }
}
test-map-str-i64()
