; ===================== merged from tests/number-generic.no =====================
; test/number-generic.no — 測試 std/math、std/num 與 std/number 中泛型函數的運行結果
;
; 覆蓋以下函數：
;   - max  (a ..num)  (r num)  — 變參泛型（math 模組）
;   - min  (a ..num)  (r num)  — 變參泛型（math 模組）
;   - abs  ()         (r num)  — num 方法（num 模組）
;   - sign (a num)    (r num)  — 方法泛型（num 模組）
;   - even (a int)    (yes bool) — 整型泛型
;   - odd  (a int)    (yes bool) — 整型泛型
;   - pow  (a int, n int) (r int) — 整型泛型
;   - gcd  (a int, b int) (r int) — 整型泛型
;   - lcm  (a int, b int) (r int) — 整型泛型

; ── max：變參泛型，回傳最大值 ──
test-max = () {
    r = math.max(10, 20)
    print(r); expect: 20

    r = math.max(3, 1, 4, 1, 5)
    print(r); expect: 5

    r = math.max(100, 50)
    print(r); expect: 100
}
test-max()
print(0)

; ── min：變參泛型，回傳最小值 ──
test-min = () {
    r = math.min(10, 20)
    print(r); expect: 10

    r = math.min(3, 1, 4, 1, 5)
    print(r); expect: 1
}
test-min()
print(1)

; ── abs：num 方法（裸函數形式 abs(x)，x 為接收者），回傳絕對值 ──
test-abs = () {

    #{overflow=wrap}
    r = abs(0 - 42)
    print(r); expect: 42
    r = abs(7)
    print(r); expect: 7
    r = abs(0)
    print(r); expect: 0
}
test-abs()
print(2)

; ── sign：方法泛型，回傳符號（-1, 0, 1）──
test-sign = () {
    r = sign(5)
    print(r); expect: 1

    #{overflow=wrap}
    r = sign(0 - 3)
    print(r); expect: -1
    r = sign(0)
    print(r); expect: 0
}
test-sign()
print(3)

; ── even / odd：整型泛型，回傳 bool ──
test-even-odd = () {
    yes = math.even(4)
    print(yes); expect: true
    yes = math.even(7)
    print(yes); expect: false
    yes = math.odd(4)
    print(yes); expect: false
    yes = math.odd(7)
    print(yes); expect: true
}
test-even-odd()
print(4)

; ── pow：整型冪 ──
test-pow = () {
    r = number.pow(2, 10)
    print(r); expect: 1024
    r = number.pow(3, 4)
    print(r); expect: 81
    r = number.pow(5, 0)
    print(r); expect: 1
    r = number.pow(7, 1)
    print(r); expect: 7
}
test-pow()
print(5)

; ── gcd：最大公因數 ──
test-gcd = () {
    r = math.gcd(48, 18)
    print(r); expect: 6
    r = math.gcd(42, 21)
    print(r); expect: 21
    r = math.gcd(17, 23)
    print(r); expect: 1
    r = math.gcd(0, 12)
    print(r); expect: 12

    #{overflow=wrap}
    r = math.gcd(0 - 12, 8)
    print(r); expect: 4
}
test-gcd()
print(6)

; ── lcm：最小公倍數 ──
test-lcm = () {
    r = math.lcm(4, 6)
    print(r); expect: 12
    r = math.lcm(12, 63)
    print(r); expect: 252
    r = math.lcm(0, 5)
    print(r); expect: 0
    r = math.lcm(7, 7)
    print(r); expect: 7
    r = math.lcm(2, 5)
    print(r); expect: 10
}
test-lcm()
print(7)

