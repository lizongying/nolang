; number.no — 數字操作測試（max/min 已移至 math 模組）

; 示範 math.max / math.min：結果經輸出參數回寫，不做斷言
; （max → 20， min → 10，依序印出）
demo-number = () {
    r = 0
    math.max(10, 20, r)
    print(r)

    math.min(10, 20, r)
    print(r)
}
demo-number()

; ===================== merged from tests/number-div-mod-clamp.no =====================
; math.div-mod-clamp.no — 測試 div, mod, clamp（現行 API）
;
; 覆蓋以下函數 / 運算：
;   - 整數除法：直接運算元 / （int.div 內部即 . / b）
;   - 整數取模：直接運算元 % （int.mod 內部即 . % b）
;   - clamp：num.clamp = (lo num, hi num) (r num) 方法，結果經結果參數 r 回傳
;
; 註：原測試使用已移除的舊 API `math.div(a, b, r)` / `math.mod(a, b, r)`
; （以 r 作為第 3 個 out-argument）。現行 std 為 `int.div=(b int)(q ?int)`、
; `int.mod=(b int)(r ?int)`，且 clamp 以結果參數接收，故改寫如下。

; ── div：整數除法 ──
test-div = () {
    r = 0

    #{overflow=wrap}
    r = 10 / 3
    print(r); expect: 3

    #{overflow=wrap}
    r = 7 / 2
    print(r); expect: 3

    #{overflow=wrap}
    r = 100 / 4
    print(r); expect: 25

    #{overflow=wrap}
    r = 1 / 1
    print(r); expect: 1

    #{overflow=wrap}
    r = 0 / 5
    print(r); expect: 0
}
test-div()
print(111)

; ── mod：整數取模 ──
test-mod = () {
    r = 0

    r = 10 % 3
    print(r); expect: 1

    r = 7 % 2
    print(r); expect: 1

    r = 100 % 4
    print(r); expect: 0

    r = 5 % 5
    print(r); expect: 0

    r = 1 % 3
    print(r); expect: 1
}
test-mod()
print(222)

; ── clamp：數值限幅（方法，結果參數 r）──
test-clamp = () {
    r = 0

    ; Within bounds
    x = 5
    r = x.clamp(1, 10)
    print(r); expect: 5

    ; Below lower bound
    y = -3
    r = y.clamp(0, 5)
    print(r); expect: 0

    ; Above upper bound
    z = 20
    r = z.clamp(0, 5)
    print(r); expect: 5

    ; Exactly at lower bound
    w = 1
    r = w.clamp(1, 10)
    print(r); expect: 1

    ; Exactly at upper bound
    v = 10
    r = v.clamp(1, 10)
    print(r); expect: 10
}
test-clamp()
print(333)

