; test-typeowner-ws-only.no
; 最小測試：只引用 ws.client，驗證 typeOwner 改動後 ws 模組正確編譯。

test-ws-client = () {
    c = ws.connect('ws://127.0.0.1:8080/path')
    c: {
        nil -> return
        -> {
            c.send-text('hello')
            c.close()
        }
    }
}

main = () {
    print('typeOwner ws-only test: ok')
}
