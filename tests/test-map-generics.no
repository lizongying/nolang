// test-map-generics.no — 測試 map 泛型特化

# std/map/map

// str → i64
test-str-i64 = () {
    m map[str]i64 = { 'a':0, 'b':1 }
    m.put('c', 2)

    v = m.get('a')
    v: {
        ok -> print(it)  // expect: 0
    }

    v = m.get('c')
    v: {
        ok -> print(it)  // expect: 2
    }

    found = m.contains('b')
    print(found)  // expect: 1

    removed = m.remove('b')
    found = m.contains('b')
    print(found)  // expect: 0
}

// str → str
test-str-str = () {
    m map[str]str = { 'name':'Alice' }

    v = m.get('name')
    v: {
        ok -> print(it)  // expect: Alice
    }
}

// i64 → i64
test-i64-i64 = () {
    m map[i64]i64 = { 10:20 }
    m.put(42, 100)

    v = m.get(42)
    v: {
        ok -> print(it)  // expect: 100
    }

    v = m.get(10)
    v: {
        ok -> print(it)  // expect: 20
    }
}

// i32 → str (非預設 int 鍵寬度)
test-i32-str = () {
    m map[i32]str = { 7:'seven' }

    v = m.get(7)
    v: {
        ok -> print(it)  // expect: seven
    }
}

// bool → i64
test-bool-i64 = () {
    m map[bool]i64 = { }
    m.put(true, 1)
    m.put(false, 0)

    v = m.get(true)
    v: {
        ok -> print(it)  // expect: 1
    }

    v = m.get(false)
    v: {
        ok -> print(it)  // expect: 0
    }
}

// 非預設組合: str → bool
test-str-bool = () {
    m map[str]bool = { 'yes':true }

    v = m.get('yes')
    v: {
        ok -> print(it)  // expect: 1
    }
}

// 非預設組合: u8 → i64
test-u8-i64 = () {
    m map[u8]i64 = { 200:200 }

    v = m.get(200)
    v: {
        ok -> print(it)  // expect: 200
    }
}

test-str-i64()
test-str-str()
test-i64-i64()
test-i32-str()
test-bool-i64()
test-str-bool()
test-u8-i64()
