i64min-test-min-i64()

; ── from tests/i8-debug.no ──
; i8-debug.no — 調試 str.to-i8
i8d-test-to-i8-127 = () {
    s = '127'
    n = s.to-i8()
    {
        n == nil -> print('nil')

        n == err -> print('err')

        -> {
            print('val=')
            print(n)
        }
    }
}

; 測試 to-i8-minmax
i8d-test-to-i8-minmax = () {

    ; 直接測試 i8.MIN 和 i8.MAX 常數
    {
        i8.MIN == -128 -> print('i8.MIN ok')

        -> print('i8.MIN bad')
    }
    {
        i8.MAX == 127 -> print('i8.MAX ok')

        -> print('i8.MAX bad')
    }
}

; 測試 to-i8-range
i8d-test-to-i8-range = () {
    n = 127
    {
        n >= i8.MIN && n <= i8.MAX -> print('127 in range')

        -> print('127 not in range')
    }
}
i8d-test-to-i8-127()
i8d-test-to-i8-minmax()
i8d-test-to-i8-range()

; ── from tests/i8-debug2.no ──
; i8-debug2.no — 調試 i8.MIN/MAX 直接訪問
i8d2-test1 = () {
    -128 == -128 -> print('-128 == -128 ok') -> print('-128 == -128 bad')
}

; 讀取 i8.MIN：-128 經型別映射取回仍須是 -128（不得因字面量邊界變成 127）
i8d2-test2 = () {

    ; 嘗試訪問 i8.MIN
    m = i8.MIN
    {
        m == -128 -> print('i8.MIN access ok')

        -> print('i8.MIN access bad')
    }
    print(m)
}

; 讀取 i8.MAX：127 須原樣取回（與 MIN 分開，避免一個錯掩蓋另一個）
i8d2-test3 = () {

    ; 嘗試訪問 i8.MAX
    m = i8.MAX
    {
        m == 127 -> print('i8.MAX access ok')

        -> print('i8.MAX access bad')
    }
    print(m)
}
i8d2-test1()
i8d2-test2()
i8d2-test3()

