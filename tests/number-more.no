u128t-a u128 = 1
u128t-b i128 = 1

; ── from tests/minmax-debug.no ──
; minmax-debug.no — 調試 i8.MIN
mm-test1 = () {
    m ?i64 = nil
    m = -128
    {
        m == -128 -> print('var == -128 ok')

        -> print('var == -128 bad')
    }
}

; 對照組：直接把 i8.MIN 當值印出（應為 -128），驗證極值常數不經變數也能正確取值
mm-test2 = () {

    ; 嘗試作為函數定義
    print(i8.MIN)
}
mm-test1()
mm-test2()

