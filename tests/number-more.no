; number-more — 合併自同簇 number/int 邊角小件（heavy dedup）
;
; 每個原件的頂層符號（函式名／全域）加 per-file 前綴避免衝突，其餘逐字保留；
; 原件為「模組級函式定義＋頂層呼叫」結構，故以模組級片段串接而非包成函式。
; 保護/被 src 引用件保留獨立：number-div-mod-clamp(hir2mir)、number-generic(ast_write_gate_test)、
; strconv(hir2mir)、push-narrow(funcargs/std_method_arg_test)。
;
; ── from tests/edge-i64.no ──
; 边界: i64 极值
...
edge-test-edge-i64 = () {
    n = 9223372036854775807
    s = n.to-str()
    print(s); 期望: 9223372036854775807

    {
        n-opt = -9223372036854775807 - 1
        n-opt: {
            ok -> n = it

            ->
        }
    }
    s = n.to-str()
    print(s); 期望: -9223372036854775808
}

; 运行测试
...
edge-test-edge-i64()

; ── from tests/i64-max.no ──
