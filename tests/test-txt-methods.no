; test-txt-methods — txt 型別的「以 txt 為 receiver」的方法呼叫
; # std/txt
;
; 為什麼需要這個測試：在 2026-09-21 之前，整個 repo **沒有任何測試**覆蓋
; `t txt = '...'` 之後 `t.method(...)` 這種呼叫，於是三個互相獨立的 codegen bug
; 一直潛伏著：
;
;   1. `emitTxtFromStr` 拿 %str-long 的欄位索引 (0=len, 2=data) 去 extract
;      一個 %txt 值 -> opt-verify: '[255 x i8]' but expected 'i64'（編不過）。
;   2. 呼叫參數沒有 str->txt 轉換：宣告為 `txt` 的參數直接收到呼叫方的
;      %str-long 槽位指標，callee 讀到垃圾。
;   3. `out.len = n` 在 %txt 上寫 i64（%txt 的 len 是 field 1 的 **i8**），
;      變成越界的 8-byte 寫入（UB）-> 長度讀回 0 -> 所有回傳 txt 的方法都回空字串。
;
; 三者疊起來的症狀就是：`t.replace-n('-','+',2)` 先是編不過，修掉 1+2 之後
; 變成**靜默回空字串**（比編不過更糟）。以下每一行都對應上面某一條。
;
; 注意：str 也有同名的 replace-n，走的是另一條特化（str_replace_n），
; 一直是好的 —— 這個測試刻意只用 txt receiver。

; bug 6：txt 當**結構體欄位**。emitSetField 的 fieldLT 是從**右值**推出來的
;（c.ptype(inst.Args[1])），不是欄位宣告型別，所以 txt 欄位拿到 %str-long：
; clone/store 按 24 bytes 寫進 256 bytes 的 %txt 欄位，i8 長度 byte 保持 0
; -> 讀出來永遠是空的。str 欄位不受影響（那時 fieldLT 剛好就是欄位型別）。
point {
    s txt
}
inner {
    t txt
}
outer {
    i inner
    name str
}
mkbox = (v str) (b box) {
    b.s = v
}
box {
    s txt
}

print('=== txt methods ===')

t txt = 'Hello, World'
print(t.len())
print(t.to-upper())
print(t.to-lower())

; bug 3：slice 靠 `out.len = n` 發佈結果，先前回空字串
print(t.slice(0, 5))
print(t.slice(7, 12))
print(t.slice(0, 5).len())

; bug 1：方法回傳 txt 後再賦值會走 OpTxtFromStr
u txt = t.slice(0, 5)
print(u)

print(t.index('World'))
print(t.index-from('o', 5))
print(t.contains('lo'))
print(t.starts-with('Hello'))
print(t.ends-with('World'))
print(t.reverse())
print(t.at(0))
print(t.count())

; bug 2：參數是 txt（'o' / '0' 這種 str 字面量要轉成 txt）
print(t.replace-n('o', '0', 1))
print(t.replace-n('o', '0', 2))
print(t.replace-n('z', '0', 2))
print(t.replace-n('o', '0', 0))

; bug 3 再驗一次：split 回傳 []txt，每個元素都要有內容
p = t.split(', ')
print(p.len())
print(p[0])
print(p[1])

print(t.eq('Hello, World'))
print(t.to-str())
print(t.trim())

q txt = '  padded  '
print(q.trim())
print(q.len())
print(q.truncate(4))
print(q.len())

r txt = t.copy()
print(r)
r.append-str('!')
print(r)

; bug 4：[]txt 的元素是 256-byte 的 %txt，但 str 字面量降成 %str-long（24 bytes）。
; push / 索引寫入若沿用引數型別，就會「按 24 bytes 寫、按 256 bytes 讀」——
; 元素讀回來全是空的；索引寫入則直接被 opt-verify 擋下
;（'%str-long' but expected '%txt'）。
vt []txt
vt.push('alpha')
vt.push('beta')
print(vt.len())
print(vt[0])
print(vt[1])
print(vt[0].len())
print(vt[1].slice(1, 3))

vt[0] = 'gamma'
print(vt[0])
print(vt[0].len())
print(vt[1])

va [2]txt
va[0] = 'one'
va[1] = 'two'
print(va[0])
print(va[1])
print(va[1].len())

pt = point {
    s: 'a-b-c'
}
print(pt.s)
print(pt.s.len())
print(pt.s.slice(0, 1))
print(pt.s.replace-n('-', '+', 2))
pt.s = 'x-y'
print(pt.s)
print(pt.s.len())
pt.s = pt.s.replace-n('-', '+', 2)
print(pt.s)

o = outer {
    i: inner { t: 'deep' }
    name: 'outer'
}
print(o.name)
print(o.i.t)
print(o.i.t.len())

bx = mkbox('hello')
print(bx.s)
print(bx.s.len())

; bug 7：str <-> txt 的**變數 / 出參賦值**。emitMove 的收尾用「目的端型別」載入來源
;（`load %T, %T* srcSlot`）—— 兩端同型別沒事，一端是 %txt 就越界：
;   - str -> txt：`load %txt, %txt* <24 bytes 的 str slot>` 讀 256 bytes 出來，
;     而且長度 byte 還是**舊值**（緩衝區塞的是 {len,cap,data}）-> 印出空白、
;     長度回報上一個值。
;   - txt -> str：把 txt 內聯緩衝區的前 24 bytes 當 {len,cap,data}
;     -> 長度是文字位元組、data 是垃圾指標，drop 時 free 野指標 -> trace/BPT trap。
src7 str = 'from-str'
dst7 txt = 'seed-txt'
dst7 = src7
print(dst7)
print(dst7.len())

back7 str = 'seed-str'
back7 = dst7
print(back7)
print(back7.len())

mk7 = (v str) (out txt) {
    out = v
}
o7 = mk7('via-out-param')
print(o7)
print(o7.len())

; bug 8：`txt == txt` 之前會降成 `icmp eq %txt`（聚合體），opt-verify 直接拒絕
;（"icmp requires integer operands"）。現在走無分支的 memcmp 結構比較。
e1 txt = 'aa'
e2 txt = 'aa'
e3 txt = 'ab'
print(e1 == e2)
print(e1 == e3)
print(e1 != e3)

; bug 8b：**混合** txt / str 比較。hir2mir 只在「左運算元的 raw type 是 str」時
; 把比較導向 OpStrEq，所以 `s == t`（str 在左）會繞過 emitCmp，直接降成
; `call i1 @str_eq(%str-long %a, %txt %b)` —— 型別不匹配的呼叫，靜默回傳 false
;（`'hello' == 'hello'` -> 0）。兩個方向都要各自正確。
ms str = 'aa'
md str = 'ab'
print(e1 == ms)
print(e1 == md)
print(ms == e1)
print(md == e1)
print(e1 != ms)
print(ms != e1)
print(ms != e3)

; bug 9（std/txt.no）：txt.eq 舊實作只在**最後一個 byte** 才回頭判定，
; 所以「長度相同、內容不同」永遠回傳 true（`'hello'.eq('world')` == 1，
; 而且這個錯值還被凍進了 golden baseline 的 tests/test-txt.no）。
; 現改為複用 txt.compare。
print(e1.eq(e2))
print(e1.eq(e3))

; bug 11：txt 傳給宣告為 **str** 的參數（bug 2 的**反向**）。
; 參數 marshal 只有 int/double/bool -> %str-long 的轉換，%txt 一路落到
; `store %str-long %txt_value, %str-long* %carg` → opt-verify 拒絕。
take-str = (s str) (n i64) {
    n = s.len()
}
tt txt = 'hello-txt'
print(take-str(tt))

; bug 12：txt 指派給 **str 出參**。emitMove 的「借用參數必須 clone」guard 排在
; txt guard 前面，對 %txt 也照樣呼叫 `call %str-long @str_clone(%str-long %v)`
; —— 型別不匹配的呼叫（%txt 沒有 heap，本來就不需要 clone）。
to-str-out = (v txt) (out str) {
    out = v
}
print(to-str-out(tt))

; bug 13：txt 做 `+` 串接。結果是 str（txt 定長、長不大），但 emitArith 直接把
; %txt 餵給 `@str_concat(%str-long, %str-long)` → opt-verify 拒絕。
u13 txt = 'ab'
w13 = u13 + '-cd'
print(w13)

print('=== done ===')
