; test-named-format.no — 測試具名字串格式 {name:spec}
;
; 驗證 print/eprint/format 支援 {name:spec} 語法，
; 並呼叫 fmt-int/fmt-uint/fmt-f64/fmt-str/fmt-bool 進行格式化。
; printf/eprintf/sprintf 已廢棄，改用 print/eprint/format；
; 若需輸出無換行符，可使用底層命令 io.out / io.err。

main = () {

    ; 整數格式化
    x i64 = 42
    print('x={x}')
    print('x={x:5}')
    print('x={x:<5}')
    print('x={x:^5}')
    print('x={x:05}')

    ; 負數
    n i64 = -7
    print('n={n:03}')

    ; 無號整數（hex）
    u u64 = 255
    print('u={u:x}')
    print('u={u:X}')
    print('u={u:#x}')
    print('u={u:08x}')

    ; byte (u8)
    b byte = 65
    print('b={b}')

    ; 浮點數
    pi f64 = 3.14159
    print('pi={pi:.2f}')
    print('pi={pi:.4f}')
    print('pi={pi:8.2f}')
    print('pi={pi:.3g}')
    print('pi={pi:.3e}')

    ; 字串
    s str = 'hello'
    print('s={s:10}')
    print('s={s:<10}')
    print('s={s:.3}')
    print('s={s:^10}')

    ; 布林值
    flag bool = true
    print('flag={flag}')
    print('flag={flag:6}')

    ; 混合多個欄位
    print('x={x}, u={u:x}, pi={pi:.2f}, s={s}, flag={flag}')

    ; 字面文字含 {{ 與 }} 轉義
    print('literal {{x}}={x}')

    ; format 返回格式化字串（替代 sprintf）
    formatted = format('formatted: x={x}, pi={pi:.2f}')
    print(formatted)

    ; eprint（stderr，自動換行）
    eprint('err: x={x}')
    eprint('err-line')

    ; io.out / io.err：底層命令，輸出無換行符
    io.out('no-newline-here')
    io.out('\n')
}
main()
