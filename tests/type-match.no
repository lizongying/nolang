; 類型解構 match（union / type-set 靜態單態化派發）端到端測試
num = i32 | i64 | f64

; 用戶範例：按被匹配值的具體型別靜態選臂
num.clamp0 = (lo num, hi num) (r num) {
  r = r: {
    i32 -> lo
    i64 -> hi
    -> r
  }
}

; 帶綁定型別臂 + 預設臂
classify = (x num) {
  y = x: {
    v i64 -> v.to-str()
    v i32 -> v.to-str()
    v f64 -> v.to-str()
    -> 'other'
  }
  print(y)
}

; 各臂回傳不同值，驗證確實選對臂
add1 = (x num) {
  r = x: {
    w i64 -> w + 1
    w i32 -> w + 2
    w f64 -> w + 3.0
    -> 0
  }
  print(r)
}

main = {
  ; ---- clamp0 ----
  ai64 i64 = 5
  hi64 i64 = 10
  a = clamp0(ai64, hi64)           ; -> i64 臂 -> hi = 10
  print(a)
  bi32 i32 = 3
  hi32 i32 = 9
  b = clamp0(bi32, hi32)           ; -> i32 臂 -> lo = 3
  print(b)
  bf64 f64 = 2.5
  hf64 f64 = 9.0
  c = clamp0(bf64, hf64)           ; -> 無 f64 臂 -> 預設臂 -> r = 2.5
  print(c)

  ; ---- classify ----
  bi64 i64 = 7
  classify(bi64)                 ; -> "7"
  classify(bi32)                 ; -> "7"
  classify(bf64)                 ; -> "7.5"

  ; ---- add1 ----
  add1(bi64)                    ; -> 11
  add1(bi32)                    ; -> 12
  add1(bf64)                    ; -> 13
}
