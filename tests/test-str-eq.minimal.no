; 簡單測試 str == 比較
test-str-eq = () {
    s = 'true'
    {
        s == 'true' -> print('equal true')
        -> print('not equal true')
    }
}

test-str-eq-2 = () {
    s = 'false'
    {
        s == 'true' -> print('equal true')
        -> print('not equal true')
    }
}

test-str-len = () {
    s = 'true'
    print(s.len)
}
test-str-eq()
test-str-eq-2()
test-str-len()
