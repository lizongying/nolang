// 簡單測試 str == 比較
test-str-eq = () {
    s = 'true'
    if s == 'true' {
        print('equal true')
    } else {
        print('not equal true')
    }
}

test-str-eq-2 = () {
    s = 'false'
    if s == 'true' {
        print('equal true')
    } else {
        print('not equal true')
    }
}

test-str-len = () {
    s = 'true'
    print(s.len)
}

test-str-eq()
test-str-eq-2()
test-str-len()
