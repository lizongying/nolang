test-arr-sort-asc = () {
    a [5] = [3, 1, 4, 1, 5]
    a.sort-asc()
    print(a[0])
    print(a[1])
    print(a[2])
    print(a[3])
    print(a[4])
}

test-arr-swap = () {
    a [3] = [1, 2, 3]
    a.swap(0, 2)
    print(a[0])
    print(a[1])
    print(a[2])
}

test-arr-sort-asc()
print('---')
test-arr-swap()
