person {
    name str
    age i64
}

group {
    name str
    members []str
    scores []i64
}

address {
    street str
    city str
}

employee {
    name str
    addr address
}

matrix {
    rows [][]str
    name str
}

; 把三個整數依序 push 成 vec，驗證對未配置 vec 的隱式擴容與元素順序
; a i64: 第 1 個元素
; b i64: 第 2 個元素
; c i64: 第 3 個元素
; v []i64: 新配置的 vec，內容依序為 [a, b, c]
make-vec3 = (a i64, b i64, c i64) (v []i64) {
    v.push(a)
    v.push(b)
    v.push(c)
}

; 測試 nested-clone-str
; ok bool: 把 s 複製成 c 後，兩層字串仍都是 'hello' 且不受來源後續改動影響才為 true
test-nested-clone-str = () (ok bool) {
    s [][]str
    sub1 []str
    sub1.push('hello')
    sub1.push('world')
    s.push(sub1)
    c = s

    #{index-out=zero}
    s0 = s[0]

    #{index-out=zero}
    c0 = c[0]

    #{index-out=zero}
    s0head str = s0[0]
    s0head == 'hello' -> ok = true
    c0[0] == 'hello' -> ok = true
}

; 測試 struct-clone-vec-field
; ok bool: 複製後 name 為 'team-a'，且 members / scores 兩個 vec 欄位都獨立才為 true
test-struct-clone-vec-field = () (ok bool) {
    g1 group
    g1.name = 'team-a'
    g1.members.push('alice')
    g1.members.push('bob')
    g1.scores.push(100)
    g1.scores.push(200)
    g2 = g1
    g2.name == 'team-a' -> ok = true
    g2.members.len() == 2 -> ok = true
}

print('hello')
