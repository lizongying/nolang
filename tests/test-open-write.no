; test-open-write.no — 驗證 open() 寫入


tmp = '/tmp/nolang-write-test.txt'
remove(tmp)

f ?file
f = fs.open(tmp, {
    mode: file-mode.write
    perm: file-perm.perm-600
    excl: false
    truncate: false
    append: false
})
f: {
    err -> print('fail: open-write err')
    nil -> print('fail: open-write nil')
    -> {
        it.write('hello', 5)
        it.close()
        print('ok: write')
    }
}

remove(tmp)
