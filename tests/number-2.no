; merged from tests/test-div-mod-option.no
; Division and remainder are option-producing integer operations.
; A zero divisor must become err instead of reaching LLVM sdiv/srem UB.
...

; 運算元用具體型別 i64：union 別名（int）的方法派發是編譯期按成員進行的，
; `a int = 10` 這種寫法在 `a / b`、`a.mod(b)` 上既選不出成員、也無法在 MIR 裡
; 當作標量參與 sdiv/srem 與零比較（實測 LLVM 型別不匹配）。本測試驗證的是
; 「除零 -> err」，不需要 union 派發。
a = 10
b = 2

#{overflow=wrap}
q = a / b
q: {
    err -> print('div-err')

    nil -> print('div-nil')

    -> print(it)
}
z = 0

#{overflow=wrap}
q0 = a / z
q0: {
    err -> print('div-zero-err')

    nil -> print('div-zero-nil')

    -> print(it)
}
r0 = a % z
r0: {
    err -> print('mod-zero-err')

    nil -> print('mod-zero-nil')

    -> print(it)
}
m = a.mod(b)
m: {
    err -> print('method-mod-err')

    nil -> print('method-mod-nil')

    -> print(it)
}
d = a.div(z)
d: {
    err -> print('method-div-zero-err')

    nil -> print('method-div-zero-nil')

    -> print(it)
}

; merged from tests/f64-str.no
; f64-str.no — 測試 f64.to-str-fixed/-sci/-general 方法
; 注意：因編譯器 bug（print 直接接收函數返回值時 @print 未宣告），
; 所有用例先將結果賦值給變數再 print。
; 注意：Nolang 中 ';' 是註解符號，不可用作語句分隔。
...

; 特殊值（使用顯式 f64 型別，繞過編譯器對直接除法表達式的型別推導 bug）
nan-val = 0.0

nan-val = nan-val / nan-val
inf-val = 1.0

inf-val = inf-val / 0.0
neg-inf-val = 0.0

neg-inf-val = neg-inf-val - 1.0

neg-inf-val = neg-inf-val / 0.0

; 主體呼叫：先把 f64 值綁到顯式型別變數再走方法，避免字面量後接 `.` 的解析歧義
print('=== f64-to-str-fixed ===')
v = 3.14159
p = 4
s = v.to-str-fixed(p)
print(s)
p = 2
s = v.to-str-fixed(p)
print(s)
p = 0
s = v.to-str-fixed(p)
print(s)
v = -3.14
p = 2
s = v.to-str-fixed(p)
print(s)
v = 0.0
p = 4
s = v.to-str-fixed(p)
print(s)
v = -0.0
s = v.to-str-fixed(p)
print(s)
v = 100.0
p = 2
s = v.to-str-fixed(p)
print(s)
v = 0.005
p = 3
s = v.to-str-fixed(p)
print(s)
v = 9.99
p = 1
s = v.to-str-fixed(p)
print(s)
v = 12345.6789
p = 2
s = v.to-str-fixed(p)
print(s)
p = 2
s = nan-val.to-str-fixed(p)
print(s)
s = inf-val.to-str-fixed(p)
print(s)
s = neg-inf-val.to-str-fixed(p)
print(s)
print()

