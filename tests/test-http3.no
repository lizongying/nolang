; ═══════════════════════════════════════════════
; QUIC 金鑰推導測試
; ═══════════════════════════════════════════════

; test-quic-derive-initial-keys: 測試 Initial 金鑰推導
test-quic-derive-initial-keys = () {

    ; 使用 RFC 9001 Appendix A 的測試向量
    ; dst_cid = 0x8394c8f03e515708
    dst-cid []byte
    dst-cid[0] = 0x83
    dst-cid[1] = 0x94
    dst-cid[2] = 0xc8
    dst-cid[3] = 0xf0
    dst-cid[4] = 0x3e
    dst-cid[5] = 0x51
    dst-cid[6] = 0x57
    dst-cid[7] = 0x08

    key [16]byte
    iv [12]byte
    hp [16]byte
    key, iv, hp = quic.derive-initial-keys(dst-cid, true)

    ; 檢查金鑰不為全零
    has-nonzero = 0
    i <- [0..16): {
        key[i] != 0 -> has-nonzero = 1
    }
    has-nonzero == 0 -> {
        print('FAIL: quic-derive-initial-keys client key all zeros')
        return
    }

    ; 驗證 RFC 9001 Appendix A 的金鑰
    ; client_initial_key = 0xb99d6cd1c3d9c78c
    ;                     0c3f8d37c09d68a1
    expected-key []byte
    expected-key[0] = 0xb9
    expected-key[1] = 0x9d
    expected-key[2] = 0x6c
    expected-key[3] = 0xd1
    expected-key[4] = 0xc3
    expected-key[5] = 0xd9
    expected-key[6] = 0xc7
    expected-key[7] = 0x8c
    expected-key[8] = 0x0c
    expected-key[9] = 0x3f
    expected-key[10] = 0x8d
    expected-key[11] = 0x37
    expected-key[12] = 0xc0
    expected-key[13] = 0x9d
    expected-key[14] = 0x68
    expected-key[15] = 0xa1

    1
    i <- [0..16): {
        key[i] != expected-key[i] -> {
        }
        0
    }
    0 -> {
        print('FAIL: quic-derive-initial-keys client key mismatch')
        i <- [0..16): {
            print(key[i].to-hex())
        }
        print('')
        return
    }
    print('PASS: quic-derive-initial-keys')
}

; ═══════════════════════════════════════════════
; QUIC CID 生成測試
; ═══════════════════════════════════════════════

; test-quic-gen-cid: 測試 Connection ID 生成
test-quic-gen-cid = () {
    cid = quic.gen-cid(8)
    cid.len != 8 -> {
        print('FAIL: quic-gen-cid expected len=8, got ')
        print(cid.len.to-str())
        return
    }

    ; 檢查不為全零（機率極低）
    has-nonzero = 0
    i <- [0..8): {
        cid[i] != 0 -> has-nonzero = 1
    }
    has-nonzero == 0 -> {
        print('FAIL: quic-gen-cid all zeros')
        return
    }
    print('PASS: quic-gen-cid')
}

; ═══════════════════════════════════════════════
; HTTP/3 影格編解碼測試
; ═══════════════════════════════════════════════

; test-http3-frame-encode-decode: 測試 HTTP/3 影格編解碼
test-http3-frame-encode-decode = () {

    ; 編碼一個 SETTINGS 影格
    payload []byte
    payload[0] = 0x42
    payload[1] = 0x43

    buf []byte
    n = 0
    buf, n = http3.encode-frame(http3.HTTP3-FRAME-SETTINGS, payload)
    n != 4 -> {
        print('FAIL: http3-encode-frame expected n=4, got ')
        print(n.to-str())
        return
    }

    ; 解碼
    ft = 0
    decoded-payload []byte
    np = 0
    ft, decoded-payload, np = http3.parse-frame(buf, 0)
    ft != http3.HTTP3-FRAME-SETTINGS -> {
        print('FAIL: http3-parse-frame expected SETTINGS, got ')
        print(ft.to-str())
        return
    }
    np != 4 -> {
        print('FAIL: http3-parse-frame expected np=4, got ')
        print(np.to-str())
        return
    }
    print('PASS: http3-frame-encode-decode')
}

; ═══════════════════════════════════════════════
; QPACK 編解碼測試
; ═══════════════════════════════════════════════

; test-qpack-encode-decode: 測試 QPACK 標頭編解碼
test-qpack-encode-decode = () {

    ; 編碼單個標頭
    names [16]str
    values [16]str
    names[0] = 'content-type'
    values[0] = 'text/plain'
    buf []byte
    n = 0
    buf, n = http3.encode-headers(names, values, 1)
    n == 0 -> {
        print('FAIL: encode-headers returned n=0')
        return
    }

    ; 解碼
    name = ''
    value = ''
    np = 0
    name, value, np = http3.decode-header(buf, 0)
    np < 0 -> {
        print('FAIL: decode-header failed')
        return
    }
    name != 'content-type' -> {
        print('FAIL: decode-header name mismatch: ')
        print(name)
        return
    }
    value != 'text/plain' -> {
        print('FAIL: decode-header value mismatch: ')
        print(value)
        return
    }
    print('PASS: qpack-encode-decode')
}

; ═══════════════════════════════════════════════
; UDP 連接測試
; ═══════════════════════════════════════════════

; test-udp-open-close: 測試 UDP socket 建立和關閉
test-udp-open-close = () {
    fd = net.net-udp-open()
    fd < 0 -> {
        print('FAIL: net-udp-open returned ')
        print(fd.to-str())
        return
    }
    fs.close(fd)
    print('PASS: udp-open-close')
}

; ═══════════════════════════════════════════════
; URL 解析測試
; ═══════════════════════════════════════════════

; test-http3-parse-url: 測試 URL 解析
test-http3-parse-url = () {
    host = ''
    port i64 = 0
    path = ''
    ok = false
    host, port, path, ok = http3.parse-url('https://example.com:8443/api/v1')
    ok == false -> {
        print('FAIL: http3-parse-url returned ok=false')
        return
    }
    host != 'example.com' -> {
        print('FAIL: http3-parse-url host mismatch: ')
        print(host)
        return
    }
    port != 8443 -> {
        print('FAIL: http3-parse-url port mismatch: ')
        print(port.to-str())
        return
    }
    path != '/api/v1' -> {
        print('FAIL: http3-parse-url path mismatch: ')
        print(path)
        return
    }

    ; 測試無埠號的 URL
    host2 = ''
    port2 i64 = 0
    path2 = ''
    ok2 = false
    host2, port2, path2, ok2 = http3.parse-url('https://example.com/')
    ok2 == false -> {
        print('FAIL: http3-parse-url (no port) returned ok=false')
        return
    }
    port2 != 443 -> {
        print('FAIL: http3-parse-url expected default port 443, got ')
        print(port2.to-str())
        return
    }
    print('PASS: http3-parse-url')
}

; ═══════════════════════════════════════════════
; 主函數
; ═══════════════════════════════════════════════

print('=== HTTP/3 Test Suite ===')
print('')

print('--- QUIC Variable-Length Integer ---')
test-quic-varint-1byte()
test-quic-varint-2byte()
test-quic-varint-4byte()
test-quic-varint-8byte()

print('')
print('--- QUIC Key Derivation ---')
test-quic-derive-initial-keys()

print('')
print('--- QUIC CID ---')
test-quic-gen-cid()

print('')
print('--- HTTP/3 Frame ---')
test-http3-frame-encode-decode()

print('')
print('--- QPACK ---')
test-qpack-encode-decode()

print('')
print('--- UDP ---')
test-udp-open-close()

print('')
print('--- URL Parsing ---')
test-http3-parse-url()

print('')
print('=== All tests completed ===')
