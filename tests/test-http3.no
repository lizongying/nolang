; test-http3 — HTTP/3 和 QUIC 模組測試
; 驗證 QUIC 變長整數、影格解析、金鑰推導、HTTP/3 影格編解碼

; # std/net/http3
; # std/net/quic

; ═══════════════════════════════════════════════
; QUIC 變長整數測試
; ═══════════════════════════════════════════════

; test-quic-varint-1byte: 測試 1 位元組變長整數
test-quic-varint-1byte = () {
    buf []byte
    n = 0
    buf, n = quic.varint-encode(37)
    n != 1 -> {
        print('FAIL: quic-varint-encode(37) expected n=1, got ')
        print(n.to-str())
        return
    }
    (buf[0]) != 37 -> {
        print('FAIL: quic-varint-encode(37) expected byte=37, got ')
        print((buf[0]).to-str())
        return
    }
    val = 0
    np = 0
    val, np = quic.varint-decode(buf, 0)
    val != 37 -> {
        print('FAIL: quic-varint-decode expected 37, got ')
        print(val.to-str())
        return
    }
    np != 1 -> {
        print('FAIL: quic-varint-decode expected np=1, got ')
        print(np.to-str())
        return
    }
    print('PASS: quic-varint-1byte')
}

