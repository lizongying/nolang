main = () {
    a = 'hello'
    b = 'world'
    n = 123
    pi = 3.14
    flag = true

    ; 多参数空格分隔
    print(a, b)
    print(a, b, n)
    print('x=', n, 'pi=', pi, 'flag=', flag)

    ; 单参数
    print(a)
    print(n)

    ; 空参数（只输出换行）
    print()

    ; eprint 多参数
    eprint('err:', a, b)
}
main()
