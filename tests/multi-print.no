main = () {
    a = 'hello'
    b = 'world'
    n = 123
    pi = 3.14
    flag = true

    ; 多参数空格分隔
    print(a, b)
    print(a, b, n)
    print('x=', n, 'pi=', pi, 'flag=', flag)

    ; 单参数
    print(a)
    print(n)

    ; 空参数（只输出换行）
    print()

    ; eprint 多参数
    eprint('err:', a, b)

    ; ─────────────────────────────────────────────
    ; 多参数 + 具名字面量：**每个字符串字面量各自是一个模板**
    ;
    ; 这是语言契约（使用者 2026-09-26 指定）：
    ;   字面量默认是模板，**不是** C 风格 printf 的格式串。
    ;   即 'result={val}' 里的 {val} 从**调用点作用域**取值，
    ;   而不是去描述/消费同一调用里的其它参数。
    ;   非字面量的参数（变量、表达式）按普通可变参数处理：空格分隔。
    ; ─────────────────────────────────────────────
    val = 42
    print('result={val}', 42, 'result={val}')

    ; 变量持有的「看起来像模板」的字符串是**纯文字**，不做替换
    tmpl = '{val}'
    print(tmpl)
    print('tpl=', tmpl)

    ; 字面量是模板，变量是值 —— 两种参数可以混用
    print('a={val}', val)

    ; 同一个调用里两个字面量各自独立替换
    print('{val}', '{val}')

    ; 纯字面量串接折叠后仍是模板（见 tests/format-concat-fold.no）
    print('x' - '{val}')

    ; {{ }} 转义：字面量里**同时存在真实字段**时生效
    print('lit {{val}} field {val}')

    ; eprint 多参数 + 模板（stderr）
    eprint('e={val}', val)
}
main()
