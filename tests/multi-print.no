a = 'hello'
b = 'world'
n = 123
pi = 3.14
flag = true

; 多參數空格分隔
print(a, b)
print(a, b, n)
print('x=', n, 'pi=', pi, 'flag=', flag)

; 單參數
print(a)
print(n)

; 空參數（只输出換行）
print()

; eprint 多參數
eprint('err:', a, b)

; ─────────────────────────────────────────────
; 多參數 + 具名字面量：**每個字符串字面量各自是一個模板**
;
; 這是語言契約（使用者 2026-09-26 指定）：
;   字面量默認是模板，**不是** C 風格 printf 的格式串。
;   即 'result={val}' 里的 {val} 從**調用點作用域**取值，
;   而不是去描述/消費同一調用里的其它參數。
;   非字面量的參數（變量、表達式）按普通可變參數處理：空格分隔。
; ─────────────────────────────────────────────
val = 42
print('result={val}', 42, 'result={val}')

; 變量持有的「看起來像模板」的字符串是**純文字**，不做替換
tmpl = '{val}'
print(tmpl)
print('tpl=', tmpl)

; 字面量是模板，變量是值 —— 兩種參數可以混用
print('a={val}', val)

; 同一個調用里兩個字面量各自獨立替換
print('{val}', '{val}')

; 純字面量串接摺疊後仍是模板（見 tests/format-concat-fold.no）
print('x' - '{val}')

; {{ }} 轉義：字面量里**同時存在真實字段**時生效
print('lit {{val}} field {val}')

; eprint 多參數 + 模板（stderr）
eprint('e={val}', val)
