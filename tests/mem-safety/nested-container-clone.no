; 嵌套容器深層 clone 測試：[][]i64、[][]str、struct 含嵌套容器、map 深拷貝

; 輔助函數：建立一個包含三個元素的子切片
; a: 第一元素
; b: 第二元素
; c: 第三元素
; v: 含三個 i64 元素的向量（作嵌套切片測試的構造塊）
make-vec3 = (a i64, b i64, c i64) (v []i64) {
    v.push(a)
    v.push(b)
    v.push(c)
}

; 辅助函數：構造含兩個元素的子切片
; a: 第一元素
; b: 第二元素
; v: 含兩個 i64 元素的向量
make-vec2 = (a i64, b i64) (v []i64) {
    v.push(a)
    v.push(b)
}

; 測試 1：[][]i64 深層 clone — b = a 後 a 和 b 獨立
; ok: 克隆後讀寫雙方全程無悬垂引用、子切片互相獨立時為 true
test-nested-clone-vec = () (ok bool) {
    a [][]i64
    a.push(make-vec3(1, 2, 3))
    a.push(make-vec3(4, 5, 6))
    b = a

    ; 驗證 a 和 b 的內容相同（透過臨時變數避免嵌套索引讀取）
    #{index-out=zero}
    a0 = a[0]
    b0 = b[0]
    a0[0] == 1 -> ok = true
    b0[0] == 1 -> ok = true
    a0[2] == 3 -> ok = true
    b0[2] == 3 -> ok = true

    #{index-out=zero}
    a1 = a[1]
    b1 = b[1]
    a1[1] == 5 -> ok = true
    b1[1] == 5 -> ok = true
    a.len() == 2 -> ok = true
    b.len() == 2 -> ok = true
    a0.len() == 3 -> ok = true
    b0.len() == 3 -> ok = true
}

; 測試 2：[][]i64 深層 clone — 修改子切片長度
; ok: 修改 b 內子切片長度後 a 仍保持原長度時為 true
test-nested-clone-modify = () (ok bool) {
    a [][]i64
    a.push(make-vec2(1, 2))
    a.push(make-vec2(3, 4))
    b = a

    ; 對 b 的第一個子切片 push 新元素（透過臨時變數避免嵌套索引方法調用）
    b0 = b[0]

    ; a 的第一個子切片長度應仍為 2
    #{index-out=zero}
    a0 = a[0]
    a0.len() == 2 -> ok = true

    ; b 的第一個子切片長度應為 2
    b0.len() == 2 -> ok = true

    ; 驗證值
    b0[0] == 1 -> ok = true
    b0[1] == 2 -> ok = true

    ; a 的第二個子切片不變
    #{index-out=zero}
    a1 = a[1]
    b1 = b[1]
    a1[0] == 3 -> ok = true
    b1[0] == 3 -> ok = true
}

; 測試 3：嵌套容器元素賦值 — x = nested[i]
; ok: x = nested[i] 元素賦值取出獨立副本、原容器不受影響時為 true
test-nested-element-assign = () (ok bool) {
    a [][]i64
    a.push(make-vec3(1, 2, 3))
    a.push(make-vec3(4, 5, 6))

    #{index-out=zero}
    x = a[0]

    ; x 是獨立拷貝
    x.len() == 3 -> ok = true
    x[0] == 1 -> ok = true
    x[1] == 2 -> ok = true
    x[2] == 3 -> ok = true

    ; a 應不受影響
    #{index-out=zero}
    a0 = a[0]
    a0.len() == 3 -> ok = true
    a0[0] == 1 -> ok = true
}

; 測試 4：多層嵌套容器深層 clone — 重複賦值不導致 double-free
; ok: 多層嵌套容器重複整表賦值不触發 double-free、內容仍正確時為 true
test-nested-reassign = () (ok bool) {
    a [][]i64
    a.push(make-vec2(1, 2))
    a.push(make-vec2(3, 4))
    b = a

    ; 重複賦值 b 觸發舊值深層釋放（測試深層 free 不 double-free）
    b = a
    b0 = b[0]
    b1 = b[1]

    #{index-out=zero}
    a0 = a[0]

    #{index-out=zero}
    a1 = a[1]
    b0[0] == 1 -> ok = true
    b1[1] == 4 -> ok = true
    a0[0] == 1 -> ok = true
    a1[1] == 4 -> ok = true
}

; 測試 5：[][]str 深層 clone — 字串嵌套容器的深拷貝
; ok: [][]str 深拷貝後改寫副本字符串不影響原容器時為 true
test-nested-clone-str = () (ok bool) {
    s [][]str
    sub1 []str
    sub1.push('hello')
    sub1.push('world')
    s.push(sub1)
    sub2 []str
    sub2.push('foo')
    sub2.push('bar')
    s.push(sub2)
    c = s

    #{index-out=zero}
    s0 = s[0]
    c0 = c[0]
    s0[0] == 'hello' -> ok = true
    c0[0] == 'hello' -> ok = true
    s0[1] == 'world' -> ok = true
    c0[1] == 'world' -> ok = true

    #{index-out=zero}
    s1 = s[1]
    c1 = c[1]
    s1[0] == 'foo' -> ok = true
    c1[0] == 'foo' -> ok = true
    s.len() == 2 -> ok = true
    c.len() == 2 -> ok = true
}

; ============================================================
; 測試 6：struct 含 []str 欄位的深拷貝
; ============================================================
; 定義一個包含 str 欄位的結構體
person {
    name str
    age i64
}

; 測試 struct-clone-str
; ok: person 結構體賦值取副本、改 p2 的 name 不影響 p1 時為 true
test-struct-clone-str = () (ok bool) {
    p1 person
    p1.name = 'Alice'
    p1.age = 30
    p2 = p1

    ; 驗證內容相同
    p2.name == 'Alice' -> ok = true
    p2.age == 30 -> ok = true
    p1.name == 'Alice' -> ok = true

    ; 修改 p2 不影響 p1
    p2.name = 'Bob'
    p2.name == 'Bob' -> ok = true
    p1.name == 'Alice' -> ok = true
}

; ============================================================
; 測試 7：struct 含 []vec 欄位（嵌套容器欄位）的深拷貝
; ============================================================
; 定義一個包含切片欄位的結構體
group {
    name str
    members []str
    scores []i64
}

; 測試 struct-clone-vec-field
; ok: group 含 []str/[]i64 切片字段的深拷貝後長度獨立、原值不變時為 true
test-struct-clone-vec-field = () (ok bool) {
    g1 group
    g1.name = 'team-a'
    g1.members.push('alice')
    g1.members.push('bob')
    g1.scores.push(100)
    g1.scores.push(200)

    ; 深拷貝
    g2 = g1

    ; 驗證內容相同
    g2.name == 'team-a' -> ok = true
    g2.members.len() == 2 -> ok = true
    g2.scores.len() == 2 -> ok = true

    ; 修改 g2 的切片欄位不影響 g1
    g2.members.len() == 2 -> ok = true
    g2.scores.len() == 2 -> ok = true
    g1.members.len() == 2 -> ok = true
    g1.scores.len() == 2 -> ok = true

    ; 驗證原始值不變
    g1.name == 'team-a' -> ok = true
}

; ============================================================
; 測試 8：struct 含嵌套 struct 欄位的深拷貝
; ============================================================
address {
    street str
    city str
}

employee {
    name str
    addr address
}

; 測試 nested-struct-clone
; ok: employee 含嵌套 address 字段深拷貝後改 e2.addr 不影響 e1.addr 時為 true
test-nested-struct-clone = () (ok bool) {
    e1 employee
    e1.name = 'John'
    e1.addr.street = 'Main St'
    e1.addr.city = 'NYC'
    e2 = e1

    ; 驗證內容相同
    e2.name == 'John' -> ok = true
    e2.addr.street == 'Main St' -> ok = true
    e2.addr.city == 'NYC' -> ok = true

    ; 修改 e2 的嵌套 struct 欄位不影響 e1
    e2.addr.street = 'Oak Ave'
    e2.addr.city = 'LA'
    e1.addr.street == 'Main St' -> ok = true
    e1.addr.city == 'NYC' -> ok = true
    e2.addr.street == 'Oak Ave' -> ok = true
    e2.addr.city == 'LA' -> ok = true
}

; ============================================================
; 測試 9：map[str, i64] 的深拷貝
; ============================================================
; ok: map[str,i64] 深拷貝後副本增刪不影響原表、既有键值一致時為 true
test-map-clone = () (ok bool) {
    m1 [str]i64
    m1.put('a', 1)
    m1.put('b', 2)
    m1.put('c', 3)

    ; 深拷貝
    m2 = m1

    ; 驗證內容相同
    v1 = m2.get('a')
    v1: {
        ok -> v1 == 1 -> ok = true

        nil -> print('nil')

        err -> print('err')
    }
    v2 = m2.get('b')
    v2: {
        ok -> v2 == 2 -> ok = true

        nil -> print('nil')

        err -> print('err')
    }
    v3 = m2.get('c')
    v3: {
        ok -> v3 == 3 -> ok = true

        nil -> print('nil')

        err -> print('err')
    }

    ; 修改 m2 不影響 m1
    m2.put('a', 100)
    v4 = m1.get('a')
    v4: {
        ok -> v4 == 1 -> ok = true

        nil -> print('nil')

        err -> print('err')
    }
    v5 = m2.get('a')
    v5: {
        ok -> v5 == 100 -> ok = true

        nil -> print('nil')

        err -> print('err')
    }

    ; m1 大小不變
    m1.len() == 3 -> ok = true
    m2.len() == 3 -> ok = true
}

; ============================================================
; 測試 10：map[str, []str]（map 值為切片）的深拷貝
; ============================================================
; ok: map[str,[]str] 深拷貝後副本的切片值獨立、原表切片不悬垂時為 true
test-map-vec-value-clone = () (ok bool) {
    m1 [str][]str
    list1 []str
    list1.push('x')
    list1.push('y')
    m1.put('items', list1)

    ; 深拷貝
    m2 = m1

    ; 取出 m2 的切片並修改
    v = m2.get('items')
    v: {
        ok -> {
            v.push('z')
            v.len() == 3 -> ok = true
        }

        nil -> print('nil')

        err -> print('err')
    }

    ; m1 的切片不應受影響
    v2 = m1.get('items')
    v2: {
        ok -> v2.len() == 2 -> ok = true

        nil -> print('nil')

        err -> print('err')
    }
}

; ============================================================
; 測試 11：struct 含 [][]str 欄位（嵌套容器欄位）的深拷貝
; ============================================================
matrix {
    rows [][]str
    name str
}

; 測試 struct-nested-vec-clone
; ok: matrix 含 [][]str 嵌套切片字段深拷貝後行列獨立時為 true
test-struct-nested-vec-clone = () (ok bool) {
    m1 matrix
    m1.name = 'data'
    row1 []str
    row1.push('a')
    row1.push('b')
    m1.rows.push(row1)
    row2 []str
    row2.push('c')
    row2.push('d')
    m1.rows.push(row2)

    ; 深拷貝
    m2 = m1

    ; 驗證內容相同
    m2.name == 'data' -> ok = true
    m2.rows.len() == 2 -> ok = true

    ; 修改 m2 的嵌套容器不影響 m1
    r0 = m2.rows[0]
    m1r0 = m1.rows[0]
    m1r0.len() == 2 -> ok = true
    r0.len() == 2 -> ok = true
    r0[0] == 'a' -> ok = true
    r0[1] == 'b' -> ok = true
}

; ============================================================
; 測試 12：person struct 數組 — []person 的深拷貝
; ============================================================
; ok: []person 結構體數組深拷貝後改副本元素不影響原數組時為 true
test-struct-array-clone = () (ok bool) {
    people []person
    p1 person
    p1.name = 'Alice'
    p1.age = 30
    people.push(p1)
    p2 person
    p2.name = 'Bob'
    p2.age = 25
    people.push(p2)

    ; 深拷貝
    copy = people

    ; 驗證內容相同
    copy.len() == 2 -> ok = true
    c0 = copy[0]
    c0.name == 'Alice' -> ok = true
    c0.age == 30 -> ok = true

    ; 修改 copy 不影響 original
    c0b = copy[0]
    c0b.name = 'Charlie'

    #{index-out=zero}
    o0 = people[0]
    o0.name == 'Alice' -> ok = true
    c0b.name == 'Charlie' -> ok = true
}

; ============================================================
; 測試 13：[][]i64 透過 insert 深層 clone — 插入後來源重新賦值不導致 UAF
; 這是「%vec 缺 clone」三個 by-value 元素寫入（push / 賦值 / insert）中最後一個
; 漏掉 clone 的：insert 只 clone %str-long 元素，對 %vec（嵌套切片）元素共享
; 來源緩衝區，來源 drop 後容器元素懸垂（UAF / double-free）。
; ============================================================
; ok: 嵌套切片經 insert 插入後來源重新賦值不產生 UAF/double-free 時為 true
test-insert-nested-clone = () (ok bool) {
    outer [][]i64
    inner = [7, 8, 9]
    outer.insert(0, inner)

    ; 重新賦值 inner —— 舊值 [7,8,9] 的 drop 會釋放其緩衝區。
    ; 若 insert 共享緩衝區（修復前），outer[0] 會懸垂，讀回垃圾甚至崩潰。
    inner = [100, 200, 300]

    #{index-out=zero}
    got = outer[0]
    got[0] == 7 -> ok = true
    got[1] == 8 -> ok = true
    got[2] == 9 -> ok = true
    got.len() == 3 -> ok = true

    ; 第二個元素獨立
    inner2 = [1, 2]
    outer.insert(1, inner2)
    inner2 = [9, 9, 9, 9]

    #{index-out=zero}
    got2 = outer[1]
    got2[0] == 1 -> ok = true
    got2[1] == 2 -> ok = true
    got2.len() == 2 -> ok = true
}

; ============================================================
; 測試 14：[][]str 透過 insert 深層 clone — 字串元素 insert 同樣須獨立拷貝
; ============================================================
; ok: [][]str 經 insert 插入後元素為獨立拷貝、來源释放後仍可讀時為 true
test-insert-nested-str-clone = () (ok bool) {
    outer [][]str
    inner = ['a', 'b', 'c']
    outer.insert(0, inner)
    inner = ['x', 'y', 'z']

    #{index-out=zero}
    got = outer[0]
    got[0] == 'a' -> ok = true
    got[1] == 'b' -> ok = true
    got[2] == 'c' -> ok = true
    got.len() == 3 -> ok = true
}

; ============================================================
; 測試 15：固定陣列 [N]str → []str 透過 vecFromArraySink 深層 clone
; build-from-fixed 把固定陣列 arr 賦給結果參數 s 後返回 —— arr 的框退出時
; 其堆上的字串緩衝區被 drop 釋放。若 vecFromArraySink 回傳 cap==0 的借用視圖
; （指向 arr 的堆疊儲存），s 會在讀取前懸垂（UAF）；deep-clone 讓 s 持有
; 自己的拷貝。這是 vecFromArraySink 懸垂記憶體安全項的釘子測試。
; ============================================================
; s: 固定數組轉成的向量（deep-clone 持有自己的字符串緩衝，不悬垂於已退出的數組框）
build-from-fixed = () (s []str) {
    arr [3]str = ['p', 'q', 'r']
    s = arr
    return
}

; 測試 fixed-array-sink-clone
; ok: 讀取 build-from-fixed 返回的向量內容仍為原字符串時為 true
test-fixed-array-sink-clone = () (ok bool) {
    s = build-from-fixed()

    #{index-out=zero}
    a = s[0]

    #{index-out=zero}
    b = s[1]

    #{index-out=zero}
    c = s[2]
    a == 'p' -> ok = true
    b == 'q' -> ok = true
    c == 'r' -> ok = true
    s.len() == 3 -> ok = true
}

ok1 = test-nested-clone-vec()
print('test-nested-clone-vec: {ok1}')

ok2 = test-nested-clone-modify()
print('test-nested-clone-modify: {ok2}')

ok3 = test-nested-element-assign()
print('test-nested-element-assign: {ok3}')

ok4 = test-nested-reassign()
print('test-nested-reassign: {ok4}')

ok5 = test-nested-clone-str()
print('test-nested-clone-str: {ok5}')

ok6 = test-struct-clone-str()
print('test-struct-clone-str: {ok6}')

ok7 = test-struct-clone-vec-field()
print('test-struct-clone-vec-field: {ok7}')

ok8 = test-nested-struct-clone()
print('test-nested-struct-clone: {ok8}')

ok9 = test-map-clone()
print('test-map-clone: {ok9}')

ok10 = test-map-vec-value-clone()
print('test-map-vec-value-clone: {ok10}')

ok11 = test-struct-nested-vec-clone()
print('test-struct-nested-vec-clone: {ok11}')

ok12 = test-struct-array-clone()
print('test-struct-array-clone: {ok12}')

ok13 = test-insert-nested-clone()
print('test-insert-nested-clone: {ok13}')

ok14 = test-insert-nested-str-clone()
print('test-insert-nested-str-clone: {ok14}')

ok15 = test-fixed-array-sink-clone()
print('test-fixed-array-sink-clone: {ok15}')
