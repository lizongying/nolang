; %str-long 下標寫護欄測試
;
; 歷史（此路徑已不可達，保留記錄）：`s[i] = c` 直寫在 i >= cap 時曾越界寫入已分配
;   緩衝之外 → 堆溢出 / SIGSEGV。codegen 的 ensureStrLongBuffer 增長分支
;   （idxV+1 > cap 時 realloc 並拷貝）就是那次修補。
;
; 2026-11-11 起 `s[i] = v` 全域禁用（連 with-cap 基底也不再豁免 idxwrite 檢查），
;   源碼只剩 place-match `s[i]: { ok -> it = v }` 一種下標寫形態。place-match 以
;   「讀」作閘門：i >= len 時整條寫入靜默跳過 —— 既不寫、不改長度、也不越界。
;   因此：
;     - ensureStrLongBuffer 的增長分支不再是源碼可達路徑；其正確性改由 Go 單元
;       測試 src/mir/str_index_grow_test.go 直接對 codegen 輸出驗證，增長分支
;       保留為防禦性代碼（FFI 或未來 str.append 落地後仍可能被觸達）。
;     - 本檔案改為驗證「現在真正可達」的語義。

; ① 範圍內 place-match：with-cap-len(8,8)（len == cap 的滿長 owned 緩衝）
;    逐位元組寫入必須落盤；未寫位置保持零初始化值。
test-str-place-in-range = () (ok bool) {
    s str = with-cap-len(8, 8)
    s[0]: { ok -> it = "a"
           -> _ }
    s[3]: { ok -> it = "d"
           -> _ }
    s[7]: { ok -> it = "h"
           -> _ }

    n = s.len-bytes()
    b0 = s.byte(0)
    b3 = s.byte(3)
    b7 = s.byte(7)
    b1 = s.byte(1)

    ok = n == 8
    ok = ok && b0 == 97; 'a'
    ok = ok && b3 == 100; 'd'
    ok = ok && b7 == 104; 'h'
    ok = ok && b1 == 0
}

; ② 範圍外 place-match：字串字面量 len=cap=3 動態遠越界（offset 100000 跨分頁）。
;    必須是安全 no-op —— 不寫、長度不變、不 SIGSEGV。
;    讀回 s[i] 與整串比較，使該 store 存活（避免被 opt 當死代碼刪除）。
test-str-place-far-oob = () (ok bool) {
    s = 'abc'; len=3, cap=3, 非 null 3 字節堆緩衝
    i = 100000
    s[i]: {
        ok -> it = "X"; 遠越界 → place-match 閘門判定越界，寫入被跳過

        -> _
    }
    n = s.len-bytes()
    same = s == 'abc'
    ok = n == 3
    ok = ok && same
}

ok1 = test-str-place-in-range()
print('test-str-place-in-range: {ok1}')

ok2 = test-str-place-far-oob()
print('test-str-place-far-oob: {ok2}')

print('all done')
