; C 標準函式 strchr 的外部宣告：在 s 中找字元 c 首次出現的位置
; s str: 搜尋來源字串，C 端以 NUL 結尾讀取
; c i64: 要找的字元碼（ASCII）；本檔用到 111('o')、122('z')、97('a')、108('l')
; r str: 命中時是把該位置起的內容拷貝成的新 str，未命中為 nil
#{c}
strchr = (s str, c i64) (r str)

; 測試 1：strchr 找到字元，返回指向 s 內部的指標
; ok bool: 找到 'o' 且回傳字串非空才為 true
test-found = () (ok bool) {
    s = 'hello world'

    ; 尋找 'o'（ASCII 111），返回指向第一個 'o' 的指標
    r = strchr(s, 111)
    r.len-bytes() > 0 -> ok = true
}

; 測試 2：strchr 找不到字元，返回 NULL
; ok bool: 找不到 'z' 且回傳為 nil 才為 true
test-not-found = () (ok bool) {
    s = 'hello'

    ; 尋找 'z'（ASCII 122），不存在 → C 返回 NULL
    r = strchr(s, 122)
    r == nil -> ok = true
}

; 測試 3：多次調用（驗證每次 malloc 新 buffer，無累積）
; ok bool: 10 次呼叫每次都拿到非空結果才為 true
test-repeat = () (ok bool) {
    s = 'abcabc'
    i <- [0..10): {
        r = strchr(s, 97)
        r.len-bytes() > 0 -> ok = true
    }
}

; 測試 4：返回值在函數間傳遞
; s str: 搜尋來源字串，本測試傳 'hello'
; c i64: 要找的字元碼，本測試傳 108('l')
; r str: strchr 的結果，命中為子字串、未命中為 nil
find-char = (s str, c i64) (r str) {
    r = strchr(s, c)
}

; 測試 pass-str
; ok bool: find-char('hello', 108) 回傳非空才為 true
test-pass-str = () (ok bool) {
    s = 'hello'
    r = find-char(s, 108)
    r.len-bytes() > 0 -> ok = true
}

ok1 = test-found()
print('test-found: {ok1}')

ok2 = test-not-found()
print('test-not-found: {ok2}')

ok3 = test-repeat()
print('test-repeat: {ok3}')

ok4 = test-pass-str()
print('test-pass-str: {ok4}')
; 四項都應印 true；重點是 C 回傳的指標被包成新 str 後，跨函式傳遞與多次呼叫都不懸空、不累積
