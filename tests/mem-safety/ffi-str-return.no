; 測試 FFI extern str 返回值的安全釋放
; 修復前：C 字串指標被 emitHeapFree free → UB（若指向靜態/外部記憶體）
; 修復後：malloc+memcpy 複製到獨立緩衝區，安全 free

#{c}
strchr = (s str, c i64) (r str)

; 測試 1：strchr 找到字元，返回指向 s 內部的指標
test-found = () (ok bool) {
    s = 'hello world'
    ; 尋找 'o'（ASCII 111），返回指向第一個 'o' 的指標
    r = strchr(s, 111)
    r.len > 0 -> ok = true
}

; 測試 2：strchr 找不到字元，返回 NULL
test-not-found = () (ok bool) {
    s = 'hello'
    ; 尋找 'z'（ASCII 122），不存在 → C 返回 NULL
    r = strchr(s, 122)
    r == nil -> ok = true
}

; 測試 3：多次調用（驗證每次 malloc 新 buffer，無累積）
test-repeat = () (ok bool) {
    s = 'abcabc'
    i <- [0..10): {
        r = strchr(s, 97)
        r.len > 0 -> ok = true
    }
}

; 測試 4：返回值在函數間傳遞
find-char = (s str, c i64) (r str) {
    r = strchr(s, c)
}

test-pass-str = () (ok bool) {
    s = 'hello'
    r = find-char(s, 108)
    r.len > 0 -> ok = true
}

main = () {
    ok1 = test-found()
    print('test-found: ', ok1)

    ok2 = test-not-found()
    print('test-not-found: ', ok2)

    ok3 = test-repeat()
    print('test-repeat: ', ok3)

    ok4 = test-pass-str()
    print('test-pass-str: ', ok4)
}
