; ═════════════════════════════════════════════════════════════════
; 切片視圖逃逸到輸出參數（Identifier 路徑）：out = view
; ═════════════════════════════════════════════════════════════════
;
; 觸發條件：
;   local []i64 = [100, 200, 300, 400]   ; vec，堆分配
;   view = local[1..3]                    ; view 是切片視圖，指向 local 的堆數據
;   out = view                            ; 視圖賦值給輸出參數（RHS 是 Identifier）
;
; 修復前：
;   - out = view 中，stmt.Value 是 Identifier(view)，不進入
;     generateSliceViewAssignment（只處理 SliceExpression）
;   - 走 expr.go materializeSliceView（共享數據，無克隆）
;   - view 不在 heapVars 中，不標記 moved
;   - 函數結束時 emitHeapFree 釋放 local 的 data
;   - out 仍指向已釋放的 data → 懸垂指針（use-after-free）
;
; 修復後：
;   - generateLet 中檢測 RHS 是 Identifier 且 isSliceViewVar
;   - 若目標是輸出參數或顯式 []T 型別，走 emitSliceClone 路徑
;   - out 獨立擁有 data，原數組 free 不影響 out
;
; 對比：
;   - out = local[1..3]（直接 SliceExpression）有 emitSliceClone 保護 ✓
;   - out = view（Identifier）修復前保護缺失 ✗，修復後走 clone 路徑 ✓
;
; ═════════════════════════════════════════════════════════════════

; 測試 1：out = view（view 是 vec 切片視圖，目標是輸出參數）
get-view = () (out []i64) {
    local []i64 = [100, 200, 300, 400]
    view = local[1..3]
    out = view
}
v = get-view()
print(v[0]); 預期 200
print(v[1]); 預期 300

; 測試 2：v []i64 = view（view 是切片視圖，目標是顯式 []T 型別）
test-explicit-type = () {
    local []i64 = [10, 20, 30, 40, 50]
    view = local[1..4]
    v []i64 = view; 顯式 []T 型別，應 clone
    print(v[0]); 預期 20
    print(v[1]); 預期 30
    print(v[2]); 預期 40
}
test-explicit-type()

; 測試 3：多次調用確認不會 double-free
v2 = get-view()
print(v2[0]); 預期 200
print(v2[1]); 預期 300

; 測試 4：view 來自固定陣列（堆分配的 vec）
get-view2 = () (out []i64) {
    arr [4]i64 = [1, 2, 3, 4]
    view = arr[0..2]
    out = view
}
v3 = get-view2()
print(v3[0]); 預期 1
print(v3[1]); 預期 2

; 測試 5：view = arr[1..3] 後重新賦值 arr — view 應保持獨立（總是 clone）
; 對應原「slice-view + 原數組 move 懸空」問題，新設計下已自動解決
test-reassign-after-view = () {
    arr = [10, 20, 30, 40, 50]
    view = arr[1..3]; view 總是 clone，獨立擁有 [20, 30]
    arr = [99, 88, 77]; arr 重新賦值，舊 data 被 free
    print(view[0]); 預期 20（view 不受影響）
    print(view[1]); 預期 30
}
test-reassign-after-view()

print('PASS')
