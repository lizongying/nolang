; 跨函数返回 str 的双重释放测试
; 根因：@main 调用 _nolang_main() 时未传递输出参数指针，
; 导致 LLVM -O3 inline 后 store 到 null → unreachable →
; 全局变量释放和 ret i32 0 被删除 → SIGTRAP。

; 測試 1：函數返回 str
; out str: 'hello world'（11 位元組），所有權交給呼叫端
f = () (out str) {
    s = 'hello world'
    out = s
}

; 測試 2：函數返回 vec
; out []i64: [10, 20, 30]，所有權交給呼叫端
g = () (out []i64) {
    v = [10, 20, 30]
    out = v
}

; 入口（頂層語句自動合成）：out 為普通局部變數，最終重設為 0，與原 main 行為一致。
out = 0
a = f()
a.len-bytes() == 11 -> out = 1
print(a.len-bytes())

b = g()
b.len() == 3 -> out = 2
print(b.len())

out = 0
