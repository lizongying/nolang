; 最简单的 option match 测试

main = () {
    print('start')
    v ?str = 'hello'
    print('assigned')
    ; match 形式
    v: {
        ok -> {
            print('ok branch')
        }
        nil -> {
            print('nil branch')
        }
        err -> {
            print('err branch')
        }
    }
    print('end')
}

main()
