; 測試 go 取回 %str-long / []i64 結果的懸空指針問題
; （底層仍 desugar 成 run/awy，所以與手寫 run/awy 的行為一致）
; 場景 1：簡單字串返回

str-producer = () (s str) {
    s = 'hello from async'
}

; 場景 2：局部變數 move 到輸出參數
str-producer2 = () (s str) {
    local = 'world from local'
    s = local
}

; 場景 3：vec 返回
vec-producer = () (v []i64) {
    v = [10, 20, 30]
}

; 場景 4：多個 go 連續調用
consumer = () {
    s1 = co str-producer()
    print(s1)

    s2 = co str-producer2()
    print(s2)

    v = co vec-producer()
    print(v.len())
    print(v[0])
    print(v[1])
    print(v[2])
}
consumer()
print('done')
