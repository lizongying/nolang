; 測試 awy 協程組取回 %str-long / []i64 結果的懸空指針問題
; （底層 desugar 成 KRun/KAwait，與語義等價）

; 場景 1：協程直接回傳字面量字串，驗證 awy 取回後指標仍有效
; s: 固定的 'hello from async'
str-producer = () (s str) {
    s = 'hello from async'
}

; 場景 2：局部變數 move 到輸出參數
; s: 協程返回的字串 'world from local'（先在函式內建立局部再 move 到輸出，驗證 transfer 後仍完整）
str-producer2 = () (s str) {
    local = 'world from local'
    s = local
}

; 場景 3：vec 返回
; v: 協程返回的 vec，內容固定為 [10, 20, 30]
vec-producer = () (v []i64) {
    v = [10, 20, 30]
}

; 場景 4：多個 co 連續調用
consumer = () {
    awy {
        s1 = co str-producer()
    }
    print(s1)

    awy {
        s2 = co str-producer2()
    }
    print(s2)

    awy {
        v = co vec-producer()
    }
    print(v.len())
    print(v[0])
    print(v[1])
    print(v[2])
}
consumer()
print('done')
