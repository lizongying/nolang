; 測試 awy 取回 %str-long 結果的懸空指針問題
; 場景 1：簡單字串返回

str-producer-async = () (s str) {
    s = 'hello from async'
}

; 場景 2：局部變數 move 到輸出參數
str-producer2-async = () (s str) {
    local = 'world from local'
    s = local
}

; 場景 3：vec 返回
vec-producer-async = () (v []i64) {
    v = [10, 20, 30]
}

; 場景 4：多個 awy 連續調用
consumer = () {
    task1 = run str-producer-async()
    s1 = awy task1
    print(s1)

    task2 = run str-producer2-async()
    s2 = awy task2
    print(s2)

    task3 = run vec-producer-async()
    v = awy task3
    print(v.len)
    print(v[0])
    print(v[1])
    print(v[2])
}
consumer()
print('done')
