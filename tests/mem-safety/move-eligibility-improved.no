; ═════════════════════════════════════════════════════════════════
; 改进版 moveEligible liveness 分析测试
; 验证三项改进：
;   1. 读写区分：纯赋值目标（a = [1,2,3]）不阻止 move
;   2. 分支感知：互斥分支中的读引用不阻止 move
;   3. 循环体引用阻止 move（保守，正确）
; ═════════════════════════════════════════════════════════════════

; ---- 改进 1：读写区分 ----
; b = a 后 a 被重赋值（纯写），move 应被允许。
; 旧版分析：a = [1,2,3] 被视为引用 → clone（性能损失）
; 新版分析：a = [1,2,3] 是纯写 → move（安全，freeOldHeapValue 跳过 moved 变量）

; 改進 1：b = a 後 a 只被純寫重賦值（無讀引用），應允許 move 而非多餘的 clone
; out []i64: 原 a 的 [1, 2, 3]（已搬進 out）
reassign-after-move = () (out []i64) {
    a = [1, 2, 3]
    b = a; move a→b（a 后续只有纯写重赋值，无读引用）
    a = [4, 5, 6]; 纯写重赋值，freeOldHeapValue 跳过 moved 的 a
    out = b
}
r1 = reassign-after-move()
r1[0] == 1 -> print('test1 pass: reassign-after-move')
r1.len() == 3 -> print('test1 pass: len=3')

; ---- 改进 1b：读写区分，RHS 引用源变量仍然阻止 move ----
; a = a.len() 这种 RHS 引用 a 的情况，move 应被拒绝。

; 改進 1b：a 在後續 RHS（a.len()）中被讀，move 必須被拒絕，b 應拿到獨立副本
; out []i64: [1, 2, 3] 的副本
rhs-read-source = () (out []i64) {
    a = [1, 2, 3]
    b = a; 应 clone（a 在后续 RHS 中被读取）
    a = [a.len()]; RHS 读取 a.len() → 阻止 move
    out = b
}
r1b = rhs-read-source()
r1b[0] == 1 -> print('test1b pass: rhs-read-source')
r1b.len() == 3 -> print('test1b pass: len=3')

; ---- 改进 2：分支感知 — 互斥分支中的读引用不阻止 move ----
; out = a 在 then 分支内，a 在 else 分支被读取。
; 旧版分析：展平后 a 的读引用在 out=a 之后 → clone
; 新版分析：then 和 else 互斥 → move（then 分支的 out=a 运行时，else 不执行）
; 注意：分支感知仅对 move-to-out 安全（有运行时位图追踪）

; 改進 2：then 分支 move a 到 out、else 分支只讀 a，兩者互斥故不阻擋 move
; flag bool: true 走 then（move），false 走 else（讀 a.len() 後再 out = a）
; out []i64: a 的內容 [10, 20, 30]
mutual-exclusive-branch = (flag bool) (out []i64) {
    a = [10, 20, 30]
    {
        flag -> {
            out = a; then 分支: move a→out（输出参数，有运行时位图）
        }

        -> {
            print(a.len()); else 分支: 读 a（与 then 互斥，不阻止 then 的 move）
            out = a
        }
    }
}
r2a = mutual-exclusive-branch(true)
r2a[0] == 10 -> print('test2a pass: mutual-exclusive then')
r2a.len() == 3 -> print('test2a pass: len=3')
r2b = mutual-exclusive-branch(false)
r2b[0] == 10 -> print('test2b pass: mutual-exclusive else')
r2b.len() == 3 -> print('test2b pass: len=3')

; ---- 改进 3：循环体引用阻止 move ----
; b = a 后 a 在循环体内被读取，move 应被拒绝。
; 保守策略：循环体可能多次执行，move 后 a 不再拥有 data → use-after-free

; 改進 3：a 在迴圈體內被讀，保守策略必須拒絕 move（b 拿副本），避免 use-after-free
; out i64: 迴圈後 a[0]，應為 1
loop-body-read = () (out i64) {
    a = [1, 2, 3]
    b = a; 应 clone（a 在循环体内被读取）
    i <- [0, 1, 2]: {
        print(a[i]); 循环体内读 a → 阻止 move
    }

    #{index-out=zero}
    out = a[0]
}
r3 = loop-body-read()
r3 == 1 -> print('test3 pass: loop-body-read')

; ---- 回归测试：非互斥分支中的读引用仍阻止 move ----
; b = a 在顶层（不在分支内），if 分支内读 a → 阻止 move
; 因为 if 分支在运行时可能执行

; 回歸：b = a 在頂層，之後的 if 分支會讀 a，move 必須被拒絕
; flag bool: 為 true 時分支內讀 a.len()（真假都不影響 b 是副本）
; out []i64: b，內容 [1, 2, 3]
non-exclusive-branch = (flag bool) (out []i64) {
    a = [1, 2, 3]
    b = a; 应 clone（a 在后续 if 分支中被读取）
    {
        flag -> {
            print(a.len()); 顶层 b=a 之后，if 分支读 a → 阻止 move
        }
    }
    out = b
}
r4 = non-exclusive-branch(true)
r4[0] == 1 -> print('test4 pass: non-exclusive-branch')
r4.len() == 3 -> print('test4 pass: len=3')

; ---- 回归测试：move-clone-liveness 场景 ----
; 同一源变量先 clone 再 move

; 複製 then-move
; a []i64: 獨立擁有的 [10, 20, 30]（clone，x 後面還要被 b = x 引用）
; b []i64: 接管 x 原 data（move，x 後續未引用）
clone-then-move = () (a []i64, b []i64) {
    x = [10, 20, 30]
    a = x; clone（x 后续被 b = x 引用）
    b = x; move（x 后续未引用）
}
ra, rb = clone-then-move()
ra[0] == 10 -> print('test5 pass: clone-then-move a')
ra.len() == 3 -> print('test5 pass: clone-then-move a len')
rb[0] == 10 -> print('test5 pass: clone-then-move b')
rb.len() == 3 -> print('test5 pass: clone-then-move b len')

print('done')
