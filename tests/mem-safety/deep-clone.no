; 深層 clone 測試：b = a 後 a 和 b 各自獨立

; 測試 1：[]i64 深層 clone
; ok: 改 b[0] 為 99 後，a[0] 仍是 10、b[0] 是 99 才為 true
test-clone-vec = () (ok bool) {
    a = [10, 20, 30]
    b = a
    b[0]: {
        ok -> it = 99

        -> _
    }
    ; 同 test-clone-str-vec：clone 之後不要用 `?=` 塊讀元素（§5.2q），改值位 match
    original = a[0]: {
        ok -> it

        -> 0
    }
    changed = b[0]: {
        ok -> it

        -> 0
    }
    original == 10 -> ok = true
    changed == 99 -> ok = true
}

; 測試 2：[]str 深層 clone
; ok: 兩份 vec 都保持 ['hello', 'world'] 且長度 2 才為 true
test-clone-str-vec = () (ok bool) {
    s []str
    s.push('hello')
    s.push('world')
    c = s
    ; ⚠️ 不要寫成 `{ s0 ?= s[0] … }: { err -> _  -> _ }`：`c = s`（[]str 深拷貝）
    ;   之後，塊內 `?=` 綁定的變數再讀會拿到 void，MIR 發出
    ;   `icmp eq void undef, <'hello'>` ⇒ LLVM 驗證失敗（最小複現見
    ;   test/README.md §5.2q）。`?=` 只適合緊接著用，這裡改成值位 match。
    s0 = s[0]: {
        ok -> it

        -> ''
    }
    c0 = c[0]: {
        ok -> it

        -> ''
    }
    s1 = s[1]: {
        ok -> it

        -> ''
    }
    c1 = c[1]: {
        ok -> it

        -> ''
    }
    s0 == 'hello' -> ok = true
    c0 == 'hello' -> ok = true
    s1 == 'world' -> ok = true
    c1 == 'world' -> ok = true
    s.len() == 2 -> ok = true
    c.len() == 2 -> ok = true
}

; 測試 3：str 深層 clone
; ok: 來源與副本的 len-bytes() 都是 5 才為 true
test-clone-str = () (ok bool) {
    s = 'hello'
    c = s
    s.len-bytes() == 5 -> ok = true
    c.len-bytes() == 5 -> ok = true
}

; 測試 4：用戶結構體深層 clone
my-data {
    name str
    value i64
}

; 測試 clone-struct
; ok: 來源與副本的 value 都是 42、name 都是 'test' 才為 true
test-clone-struct = () (ok bool) {
    d = my-data{
        name: 'test'
        value: 42
    }
    c = d
    d.value == 42 -> ok = true
    c.value == 42 -> ok = true
    d.name == 'test' -> ok = true
    c.name == 'test' -> ok = true
}

ok1 = test-clone-vec()
print('test-clone-vec: {ok1}')

ok2 = test-clone-str-vec()
print('test-clone-str-vec: {ok2}')

ok3 = test-clone-str()
print('test-clone-str: {ok3}')

ok4 = test-clone-struct()
print('test-clone-struct: {ok4}')
