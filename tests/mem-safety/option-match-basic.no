; 测试 option match 是否正常工作

; 測試 fn
; result ?str: 先設 nil 再改為 'hello'，回傳時應為 ok('hello')
test-fn = () (result ?str) {
    result = nil
    result = 'hello'
}

print('start')
v1 = test-fn()
print('got result')
{
    v1: {
        ok -> {
            print('ok branch')
            print(it)
        }

        nil -> {
            print('FAIL: nil')
        }

        err -> {
            print('FAIL: err')
        }
    }
}
print('end')
