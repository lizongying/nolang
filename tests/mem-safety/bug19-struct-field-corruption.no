; Bug 19 regression test: local struct with str field passed to another function
; that does str-range on the struct's str field. Without the fix, the str-range
; result shares the struct's heap data, and when the struct is freed at function
; exit, the result becomes a dangling pointer → crash on free.

data {
    raw str
    n i64
}

; Bug: creating local struct then passing to another function — crash
; raw: 原始記錄字串 '100644 file1.txt\0<20 bytes>'
; s: 空格之後、NUL 之前的子串，預期 'file1.txt'
pass-struct = (raw str) (s str) {
    t = data{
        raw: raw
        n: 5
    }
    s = use-struct(t)
}

; Access struct field and do str-range — previously crashed
; t: 帶 raw 與 n 的結構體；本測試 raw 同上、n 固定為 5
; s: t.raw 中空格之後的子串（拷貝，不可指向結構體的堆）
use-struct = (t data) (s str) {
    sp = -1
    i <- [0..t.raw.len-bytes()): {
        t.raw[i] == 32 -> {
            sp = i
            break
        }
    }
    nl i64 = t.raw.len-bytes()

    j <- [sp + 1..t.raw.len-bytes()): {
        t.raw[j] == 0 -> {
            nl = j
            break
        }
    }

    s = t.raw[sp + 1..nl)
}

; Safe: directly use parameter — works
; raw: 直接傳入的記錄字串（不經結構體）
; s: 同樣取空格後到 NUL 的子串，預期 'file1.txt'
pass-direct = (raw str) (s str) {

    ; #{ascii} 證明此串為純 ASCII：s[i] 由 O(n) 碼點迭代退化為 O(1) 定址
    #{ascii}
    src = raw
    sp = -1
    i <- [0..src.len-bytes()): {
        src[i] == 32 -> {
            sp = i
            break
        }
    }
    nl = src.len-bytes()

    j <- [sp + 1..src.len-bytes()): {
        src[j] == 0 -> {
            nl = j
            break
        }
    }

    s = raw[sp + 1..nl)
}

; Build test data: "100644 file1.txt\0<20 bytes>"
; 2026-11-11：str 下標直寫已全域禁用 ⇒ 用 []byte 緩衝承接，收尾整體轉回 str。
test-raw-b []byte = with-cap-len(37, 37)
test-raw-b[0] = 49; 1
test-raw-b[1] = 48; 0
test-raw-b[2] = 48; 0
test-raw-b[3] = 54; 6
test-raw-b[4] = 52; 4
test-raw-b[5] = 52; 4
test-raw-b[6] = 32; space
test-raw-b[7] = 102; f
test-raw-b[8] = 105; i
test-raw-b[9] = 108; l
test-raw-b[10] = 101; e
test-raw-b[11] = 49; 1
test-raw-b[12] = 46; .
test-raw-b[13] = 116; t
test-raw-b[14] = 120; x
test-raw-b[15] = 116; t
test-raw-b[16] = 0; null

; 尾端 20 個位元組補 0：with-cap-len 的緩衝不保證清零，補上才與原本的
; 「<20 bytes>」語義一致（解析在 NUL 就停，但不留未定義內容）。
k <- [17..37): {
    test-raw-b[k] = 0
}
test-raw = test-raw-b.to-bytes-str()

; Safe: directly use parameter
good-result = pass-direct(test-raw)

print('good: {good-result}')

; Expected: good: file1.txt

; Bug: through struct
bad-result = pass-struct(test-raw)

print('bad: {bad-result}')

; Expected: bad: file1.txt
; Without fix: trace/BPT trap (crash)

; Verify result correctness
{
    bad-result == 'file1.txt' -> { print('bug19: PASS') }
    -> { print('bug19: FAIL') }
}
