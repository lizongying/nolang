; ═════════════════════════════════════════════════════════════════
; 問題 6：map 無 free/deinit，鍵的 data 全部洩漏
; 嚴重等級：嚴重（系統性內存洩漏）
; ═════════════════════════════════════════════════════════════════
;
; 觸發條件：
;   m [str]i64 = { 'a': 1, 'b': 2, 'c': 3 }
;   ; m 離開作用域時，256 個鍵槽位的 data 指針全部洩漏
;
; 根本原因：
;   - std/collection/map.no 的 hashmap-str-tmpl 包含 keys [256]str
;   - 256 個 %str-long 內聯在 map 結構體內
;   - MapType 初始化路徑未呼叫 trackLocalHeapVar，hashmap 不在 heapVars
;   - emitStructFieldsFree 的 default 分支不識別 [N x T] 內聯固定陣列字段
;   - 256 個 keys[i].data 永不釋放
;
; 相關文件：
;   src/build/llvm/stmt.go:4716-4745（MapType 初始化，補 trackLocalHeapVar）
;   src/build/llvm/stmt.go:970-998（emitStructFieldsFree，補 [N x T] 分支）
;   src/build/llvm/stmt.go:1000-1054（parseInlineArrayType + emitInlineArrayFieldFree）
;   src/build/llvm/stmt.go:1378-1454（emitStructClone + emitInlineArrayFieldClone）
;
; 預期行為：
;   map 作用域結束時應釋放所有鍵的 data（遍歷 256 個 slot）
;
; 修復方向：
;   - MapType 初始化路徑補 trackLocalHeapVar(name, llvmType)
;   - emitStructFieldsFree default 分支識別 [N x T]，遍歷 N 元素遞迴釋放
;   - emitStructClone default 分支識別 [N x T]，遍歷 N 元素遞迴 clone
;
; ═════════════════════════════════════════════════════════════════

; 測試 1：map 作用域結束釋放（涵蓋 emitStructFieldsFree 的 [N x T] 分支）
test-scope = () {
    m1 [str]i64 = { 'apple': 1, 'banana': 2, 'cherry': 3 }
    v1 = m1.get('apple')
    v1: {
        ok -> print(v1)
    }
    ; m1 離開作用域時應釋放 256 個 keys slot 的 data
}

test-scope()
print('test-scope: ok')

; 測試 2：map 賦值到 out 參數走 move（涵蓋 hashmap move 路徑）
make-map = () (out [str]i64) {
    out = { 'x': 10, 'y': 20 }
    ; out 走 move，由呼叫者管理
}

m2 = make-map()
v2 = m2.get('x')
v2: {
    ok -> print(v2)
}
print('test-move-out: ok')

; 測試 3：map 重新賦值覆蓋舊 map（涵蓋 freeOldHeapValue 路徑）
test-reassign = () {
    m3 [str]i64 = { 'first': 1 }
    m3.put('second', 2)
    v3 = m3.get('second')
    v3: {
        ok -> print(v3)
    }
    ; m3 離開作用域時應釋放所有 keys data
}

test-reassign()
print('test-reassign: ok')

; 測試 4：map-to-map 局部賦值走深層 clone（涵蓋 emitInlineArrayFieldClone）
test-clone = () {
    a4 [str]i64 = { 'key': 99 }
    b4 [str]i64 = a4
    va4 = a4.get('key')
    va4: {
        ok -> print(va4)
        nil -> print('va4-nil')
    }
    vb4 = b4.get('key')
    vb4: {
        ok -> print(vb4)
        nil -> print('vb4-nil')
    }
    ; a4 和 b4 應各自獨立擁有 256 個 keys 的 data，離開作用域時各自 free
}

test-clone()
print('test-clone: ok')

print('done')
