; ── from tests/move.no ──
; 單一輸出參數：體內寫入 1，用於驗證輸出參數 move 給呼叫方變數
; res: 固定寫入 1 的輸出參數
mv-foo = () (mv-res i8) {
    mv-res = 1
}

; 兩側輸出參數：a 與 b 型別不同，用於驗證一次可 move 回多個值
; a: 固定寫入 2 的第一個輸出
; b: 固定寫入 3 的第二個輸出
mv-bar = () (a i8, b i16) {
    a = 2
    b = 3
}

; 先定义res i8 i8初始0值
; foo 赋值1 
mv-res = mv-foo()

; 第二次调用，res已经有值，是新赋值
; foo 赋值1 
mv-res = mv-foo()
mv-res, res1 = mv-bar()

; ── from tests/move1.no ──
; 單一輸出參數：res 取自區域變數 x 的當下值，函式結束時才 move 給呼叫方
; res: 固定寫入 1 的輸出參數
mv1-foo = () (mv1-res i64) {
    x = 1
    mv1-res = x
    print(x)
}

; 返回值延迟move，函数结束时move。
; 所以a == 4
; 这里由于b也=x  所以a、b实际是一个值
; a: 讀 x 第一次的值 1（之後 x 改為 4 不影響它）
; b: 讀 x 第二次的值 4（證明輸出是 move 當下快照）
mv1-bar = () (a i64, b i64) {
    x = 1
    a = x
    print(x)
    x = 4
    b = x
    print(x)
}

; 先定义res i8 i8初始0值
; foo 赋值1 
mv1-res = mv1-foo()

; 第二次调用，res已经有值，是新赋值
; foo 赋值1 
mv1-res = mv1-foo()
mv1-res, res1 = mv1-bar()

; ── from tests/move2.no ──
; 字串輸出參數：把輸入 x 搬到輸出 res（呼叫方變數重複賦值不得造成懸垂）
; x: 來源字串（只讀）
; res: 與 x 內容相同的字串
mv2-foo = (mv2-x str) (mv2-res str) {
    mv2-res = mv2-x
    print(mv2-x)
}

; 先定义res 
; foo 赋值''
mv2-res = mv2-foo('')

; 第二次调用，res已经有值，是新赋值
; foo 赋值
mv2-x = 'a'
mv2-res = mv2-foo(mv2-x)

