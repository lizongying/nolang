; ── from tests/func1.no ──
; 泛型最小範例：兩參數比較後回傳較小者（型別參數 t 在呼叫點單態化）
; a: 第一個運算元，型別由呼叫點決定
; b: 第二個運算元，必須與 a 同型別
; r: 較小的值（兩者相等時為 a）
fc1-min = (a t, b t) (r t) {
    r = a > b ? b : a
}

; ── from tests/if-str.no ──
; if 表達式形式：條件為真時取 then 區塊的值 'hello'，否則取 'world'，結果存進 r 再印出
ifstr-test1 = () {
    r = if 1 {
        'hello'
    } else {
        'world'
    }
    print(r)
}
ifstr-test1()

