; misc-syntax-more — 合併自各語法/控制流殘片小件（heavy dedup）
;
; 每個原件以模組級片段串接，頂層符號（函式／全域／迴圈變數）加 per-file 前綴避免衝突；
; 字串與註解內容不動。保留獨立：bool-render(struct 型別)、ifelse(頂層未加括號 else)、
; guard(具名格式欄位 {q}/{q2} 綁定區域變數，改檔會破壞插值)、
; diff-debug / minimal-ok(被 src 引用)。
;
; ── from tests/basic.no ──
; basic.no — 核心編譯驗證

; 兩數較大者（改用 a-b 的符號判斷，避免直接比較時的溢出）
; a: 第一個運算元
; b: 第二個運算元
; r: 較大的運算元（兩者相等時為 b）
b-i64-max = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    d = a - b
    {
        d > 0 -> r = a

        -> r = b
    }
}

; 兩數較小者（同樣靠 a-b 的符號判斷）
; a: 第一個運算元
; b: 第二個運算元
; r: 較小的運算元（兩者相等時為 a）
b-i64-min = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    d = a - b
    {
        d > 0 -> r = b

        -> r = a
    }
}

; 取絕對值 i64（i64.MIN 因溢出回繞仍為自身）
; a: 來源數值，可為負
; r: a >= 0 時為 a，否則為 0 - a
b-abs-i64 = (a i64) (r i64) {
    {
        a < 0 -> {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                r-opt = 0 - a
                r-opt: {
                    ok -> r = it

                    ->
                }
            }
        }

        -> r = a
    }
}

; 歐幾里得演算法求最大公因數：先取絕對值，再輾轉相除
; a: 第一個整數，允許負數
; b: 第二個整數，允許負數
; r: |a| 與 |b| 的最大公因數；其中一個為 0 時取另一個的絕對值
b-gcd = (a i64, b i64) (r i64) {
    ra = a
    rb = b
    (ra < 0) {

        #{overflow=wrap}
        {

            #{overflow=wrap}
            ra-opt = 0 - ra
            ra-opt: {
                ok -> ra = it

                ->
            }
        }
    }
    (rb < 0) {

        #{overflow=wrap}
        {

            #{overflow=wrap}
            rb-opt = 0 - rb
            rb-opt: {
                ok -> rb = it

                ->
            }
        }
    }
    (rb != 0) {
        t = rb
        {
            rb-opt2 = ra % rb
            rb-opt2: {
                ok -> rb = it

                ->
            }
        }
        ra = t
    }
    r = ra
}

; 驅動函式：依次呼叫上面四個函式並印出結果（無輸出參數，自驗端到端可用）
b-caller = () {
    r = 0

    r = b-i64-max(10, 20)
    print(r)

    r = b-i64-min(10, 20)
    print(r)

    r = b-abs-i64(-42)
    print(r)

    r = b-gcd(12, 18)
    print(r)

    print('ok: all tests done')
}
b-caller()

; ── from tests/bool-debug.no ──
; bool-debug.no — 調試 str.to-bool
boold-test-bool-true = () {
    s = 'true'
    b = s.to-bool()
    {
        b == nil -> print('nil')

        b == err -> print('err')

        -> {
            print('val=')
            print(b)
        }
    }
}

; 測試 bool-false
boold-test-bool-false = () {
    s = 'false'
    b = s.to-bool()
    {
        b == nil -> print('nil')

        b == err -> print('err')

        -> {
            print('val=')
            print(b)
        }
    }
}
boold-test-bool-true()
boold-test-bool-false()

