; ── from tests/zz-strindex-lint.no ──
; zz-strindex-lint.no — 驗證 s[i] 性能告警（STR_INDEX_COMPLEXITY）的**不告警**侧
;   - 單獨一次 s[i]（循环外）：不告警（即使非 ASCII）
;   - 手動按下標遍歷但串可證明 ASCII：for j <- [0..a.count()): { x = a[j] } → 不告警
;   - 直接遍歷字符串 for c <- s：無 s[i]，不告警（內部按碼點迭代）
;   - 字節訪問 s.byte(i)：不是 IndexExpression，不告警（非 ASCII 串按下標遍歷的推荐寫法）
;
; ⚠️ 本語料已不再保留「故意違規」的分支：告警側（未證明 ASCII 的 str 在迴圈內
; 用 s[i]）由 Go 單測 src/checker/str_index_complexity_test.go 把守——
;   TestStrIndexComplexity_FiresForUnprovenAsciiParam（該報的要報）
;   TestStrIndexComplexity_NotSuppressedByOtherFunction（真正的回歸守衛：同名
;     變數不得跨作用域消音；修復前 FAIL）
;   TestStrIndexComplexity_TopLevelNonAsciiLiteral
; 語料裡留一條「必然告警」的寫法會讓 `no vet tests` 永遠非零退出，反而使
; CI 門禁失去意義，故改由單測承擔覆蓋。
zsi-test-str-index-lint = () {

    ; ASCII 字面量：a[i] 單獨一次，不告警
    a = 'hello'
    xa char = a[1]

    ; 非 ASCII 字面量（é 多字節）：b[i] 單獨一次，不告警（不在循环里）
    b = 'héllo'
    yb char = b[1]

    ; 標識符傳播：c 繼承 b 的非 ASCII，c[i] 單獨一次，不告警
    c = b
    zc char = c[2]

    ; 手動按下標遍歷 非 ASCII 串 → 走字節訪問逃生舱 s.byte(i)，不告警
    sum-b = 0
    i <- [0..b.count()): {
        _ = b.byte(i)

        #{overflow=wrap}
        {

            #{overflow=wrap}
            sum-b-opt = sum-b + 1
            sum-b-opt: {
                ok -> sum-b = it

                ->
            }
        }
    }
    print(sum-b)

    ; 手動按下標遍歷 ASCII 串 → 不告警（可證明 ASCII，O(1)）
    sum-a = 0
    j <- [0..a.count()): {
        ch2 char = a[j]

        #{overflow=wrap}
        {

            #{overflow=wrap}
            sum-a-opt = sum-a + 1
            sum-a-opt: {
                ok -> sum-a = it

                ->
            }
        }
    }
    print(sum-a)

    ; 直接遍歷字符串：無 s[i]，不告警
    sum-c = 0
    cc <- b: {

        #{overflow=wrap}
        {

            #{overflow=wrap}
            sum-c-opt = sum-c + 1
            sum-c-opt: {
                ok -> sum-c = it

                ->
            }
        }
    }
    print(sum-c)

    ; 字節訪問逃生舱：不是 IndexExpression，不告警
    w = b.byte(0)

    print(xa)
    print(yb)
    print(zc)
    print(w)
}
zsi-test-str-index-lint()
