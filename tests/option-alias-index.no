; option-alias-index.no — 「別名容器」的下標讀取仍是 ?T（且值必須正確）
;
; `c = s` 這類無型別標註的容器別名，parse 期的純別名推斷（inferAliasType）
; 只登記純量（容器帶所有權語意，寫進 sem.VarTypes 會打亂 MIR 的
; retain/release 配對），所以 `c` 的容器型別不會進 sem.VarTypes /
; sem.FuncVarTypes。若 idxLocalTypes 也不登記，indexBaseVarType 的三層查表
; 全 miss ⇒ `c[0]` 被當成**裸讀**，於是
;
;   * `c0 ?= c[0]` 的 `__unwrap_N` 拿不到元素型別 ⇒ ok 臂的 `c0 = it`
;     綁成 `const c0:void` ⇒ `icmp eq void undef, …`，整個函式 LLVM 驗證
;     失敗（test/README.md §5.2q 的 t4）；
;   * `c0 = c[0]: { ok -> it … }` 走不到 ok 臂 ⇒ 靜默取默認值。
;
; 本檔把這兩種形態都釘成「必須拿到真實元素值」，涵蓋 []str / []i64 /
; [][]i64 三種元素，以及「別名的別名」（d = c）。

; name str: 檢查名稱
; got str: 實際值
; want str: 期望值
check = (name str, got str, want str) {
    {
        got == want -> print('ok: {name}')

        -> {
            print('fail: {name} got=[{got}] want=[{want}]')
            exit(1)
        }
    }
}

; 1. 塊 match 的 `?=`：別名容器的下標要能解包出真實元素
;
; out str: 塊體內 `?=` 綁定到的元素值
alias-unwrap = () (out str) {
    s []str
    s.push('hello')
    c = s
    out = ''
    {
        c0 ?= c[0]
        out = c0
    }: {
        err -> out = 'err'

        -> _
    }
}

; 2. 值位 match：ok 臂必須被走到（修復前會靜默走默認臂）
;
; out str: 匹配到的元素值
alias-value-match = () (out str) {
    s []str
    s.push('world')
    c = s
    c0 = c[0]: {
        ok -> it

        -> 'default'
    }
    out = c0
}

; 3. 別名的別名：型別鏈要走得過去
;
; out str: 二級別名取到的元素值
alias-chain = () (out str) {
    s []str
    s.push('deep')
    c = s
    d = c
    c0 = d[0]: {
        ok -> it

        -> 'default'
    }
    out = c0
}

; 4. []i64 元素：數字要對，不能是 0
;
; out i64: 別名容器第一個元素
alias-i64 = () (out i64) {
    nums []i64
    nums.push(7)
    nums.push(9)
    n = nums
    v = n[0]: {
        ok -> it

        -> -1
    }
    out = v
}

; 5. [][]i64：元素的元素仍是 ?i64
;
; out i64: 巢狀別名容器取到的內層元素
alias-nested = () (out i64) {
    grid [][]i64
    inner []i64
    inner.push(42)
    grid.push(inner)
    g = grid
    row = g[0]: {
        ok -> it

        -> []
    }
    v = row[0]: {
        ok -> it

        -> -1
    }
    out = v
}

; 6. 比較語境：解包後的元素與字面量比對（別名容器同樣要正確）
;
; out bool: 別名容器元素與字面量的比較結果
alias-compare = () (yes bool) {
    s []str
    s.push('cmp')
    c = s
    yes = false
    {
        item ?= c[0]
        item == 'cmp' -> yes = true
    }: {
        err -> _

        -> _
    }
}

check('alias-unwrap', alias-unwrap(), 'hello')
check('alias-value-match', alias-value-match(), 'world')
check('alias-chain', alias-chain(), 'deep')
a4 = alias-i64()
check('alias-i64', a4.to-str(), '7')
a5 = alias-nested()
check('alias-nested', a5.to-str(), '42')
{
    alias-compare() -> print('ok: alias-compare')

    -> {
        print('fail: alias-compare')
        exit(1)
    }
}
print('option-alias-index: all ok')
