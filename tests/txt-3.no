; merged from tests/txt-more.no
; txt-more.no — 合併自 txt 碎片（頂層拼接，非函數包裹）
;
; 來源：txt-slice.no, txt-codepoint.no
; 保留錨點：txt.no（基名，原樣保留，未併入）
;
; 採頂層拼接：txt-slice 的頂層變數 t/t2/m 加 _sl 後綴避免與 txt-codepoint 的 t 衝突；
; 片段間以 print('---') 分隔以保全 stdout 指紋確定性（golden 比對用）。
...

; ── 來自 txt-slice.no ──
; txt 原始切片語法 t[a..b]。txt 索引是「碼點」語義（與 str 一致），
; 切片結果仍是 txt，內容必須與 str 逐字一致。此檔在 txt 切片支援前無法編譯。

t-sl txt = 'HelloWorld'

; 邊界開合 + 無界上界：全部 16 種區間寫法的長度
print(t-sl[..].len())
print(t-sl[1..].len())
print(t-sl[1..).len())
print(t-sl(1..].len())
print(t-sl(1..).len())
print(t-sl[..4].len())
print(t-sl[..4).len())
print(t-sl(..4].len())
print(t-sl(1..4].len())
print(t-sl(1..4).len())

; 內容檢查（`]` 為右閉，含端點）
; t[..5]  -> 'HelloW'（碼點 0..5）  t[5..] -> 'World'  t[1..4] -> 'ello'
print(t-sl[..5])
print(t-sl[5..])
print(t-sl[1..4])

; 無界上界的包含性必須等於排除性（都表示「到結尾」）
; 修復前 [1..] 會多算一個元素（越界讀取）
t2-sl txt = 'abcde'
print(t2-sl[1..].len())
print(t2-sl[1..).len())
print(t2-sl[..].len())

; 多字节码点：切片按下标为码点（非字节），结果必与 str 逐字一致
; 'héllo世界' = h é l l o 世 界 （7 个码点）
m-sl txt = 'héllo世界'
print(m-sl.len())
print(m-sl[1..3])
print(m-sl[5..])
print(m-sl(0..2))
print('---')

; ── 來自 txt-codepoint.no ──
; test-txt-codepoint: txt 码点索引回归（读 + 写，MIR 后端）
; 每次 `no run` 输出应为纯 ok 行；任何 FAIL 行都代表回归。

ck = (label str, cond bool) {
    ! cond -> print('FAIL', label)
    cond -> print('ok', label)
}

; 越界读现在是**带检查**的（idxhndld 收口之后）：回 err('index out of range')，
; 不再是 -1 哨兵。用三臂 match 断言 tag，避免把某一路径的兜底值写成期望值。
oob-is-err = (t txt, i i64) (bad bool) {
    t[i]: {
        ok -> bad = false

        nil -> bad = false

        err -> bad = true
    }
}

; ── 读取：码点索引 → char（UTF-8 解码）──
t txt = 'A中B'
ck('read-ascii-0', t[0] == 65)
ck('read-cjk-1', t[1] == 20013)
ck('read-ascii-2', t[2] == 66)
ck('read-oob-err', oob-is-err(t, 3))

; 4 字节码点（🌍 = U+1F30D）
e txt = '🌍x'
ck('read-emoji-0', e[0] == 127757)
ck('read-emoji-1', e[1] == 120)
ck('count-mixed', e.count() == 2)
ck('bytes-mixed', e.len-bytes() == 5)

; ── 写入：增长（1 字节 → 3 字节，后移尾部）──
; 2026-11-12 起 `t[i] = v` 被 idxwrite 全域禁用（索引写会隐式改变长度）。
; 就地改值的合法通道是 place-match：以「读」作闸门，只在该索引可读时写回。
g txt = 'aX'
g[0]: {
    ok -> it = "中"

    -> _
}
ck('grow-cp0', g[0] == 20013)
ck('grow-cp1', g[1] == 88)
ck('grow-bytes', g.len-bytes() == 4)
ck('grow-count', g.count() == 2)

; ── 写入：收缩（3 字节 → 1 字节）──
s txt = '中X'
s[0]: {
    ok -> it = "a"

    -> _
}
ck('shrink-cp0', s[0] == 97)
ck('shrink-cp1', s[1] == 88)
ck('shrink-bytes', s.len-bytes() == 2)

; ── 写入：在 count 处追加 ──
; i == count 时 place-match 的闸门返 nil（读越界），天然跳过；追加必须走显式的 push。
w txt = 'ab'
w.push("中")
ck('append-cp2', w[2] == 20013)
ck('append-bytes', w.len-bytes() == 5)
ck('append-count', w.count() == 3)

; ── 255 字节上限：填满后超界的码点写入被丢弃 ──
b txt = ''
i <- [0..300): {
    b.push("a")
}
ck('cap-full-bytes', b.len-bytes() == 255)
ck('cap-full-count', b.count() == 255)
b[255]: {
    ok -> it = "中"

    -> _
}
ck('cap-drop-bytes', b.len-bytes() == 255)
ck('cap-tail-intact', b[254] == 97)

; ── 码点写入 / byte 读取：原位改一个 ASCII 字元，长度不变 ──
; 原本用 `r.set-byte(0, 90)`；該內建已於 2026-11-11 私有化為 `_set-byte`，
; 公開面 2026-11-11 曾由碼點直寫 `r[0] = <char>` 承擔；2026-11-12 起直寫也被
; idxwrite 禁用，一律改用 place-match。
r txt = 'abc'
r[0]: {
    ok -> it = "Z"

    -> _
}
ck('setbyte-raw', r.byte(0) == 90)
ck('setbyte-cp', r[0] == 90)
ck('setbyte-len', r.len-bytes() == 3)
print('done')

; merged from tests/jp8.no
...

t-join = () {
    s txt = 'a-b-c-d'
    parts = s.split('-')
    j = parts.join('.')
    print('J=[{j.to-str()}] len={j.len-bytes()}')
}

t-first = () {
    s txt = 'a-b-c-d'
    r = s.replace-n('-', '.', 2)
    runner.str-eq(r.to-str(), 'a.b.c-d', 7, 'x')
}
runner.test('first', t-first)
runner.test('join', t-join)
total = runner.summary()
