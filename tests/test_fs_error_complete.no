; 测试文件操作错误信息细分
; 验证 fs.open 失败时返回详细的错误信息

print('--- 测试 fs.open 错误信息 ---')
print('')

; 测试 1: 文件不存在 (ENOENT = 2)
print('测试 1: 文件不存在')
print('  路径: /nonexistent/file-12345.txt')
f1 ?fs.file = fs.open('/nonexistent/file-12345.txt',  {
    mode: file-mode.read
})
f1: {
    err -> print('  错误: ' - it)
    nil -> print('  结果: nil')
    -> print('  结果: 文件已打开')
}
print('')

; 测试 2: 尝试打开目录作为文件
print('测试 2: 尝试打开目录')
print('  路径: /tmp')
f2 ?fs.file = fs.open('/tmp',  {
    mode: file-mode.read
})
f2: {
    err -> print('  错误: ' - it)
    nil -> print('  结果: nil')
    -> print('  结果: 文件已打开')
}
print('')

; 测试 3: 成功创建并打开文件
print('测试 3: 成功打开文件')
print('  路径: /tmp/nolang-test-err.txt')
f3 ?fs.file = fs.open('/tmp/nolang-test-err.txt',  {
    mode: file-mode.write
    perm: file-perm.perm-644
})
f3: {
    err -> print('  错误: ' - it)
    nil -> print('  结果: nil')
    -> {
        print('  结果: 文件已打开成功')

        .write('hello', 5)

        .close()
    }
}
print('')
print('--- 测试完成 ---')

i <- [12..3): {
}
