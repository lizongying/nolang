// test-sha256-step20 — 測試箭頭條件在函數內部
// # std/hash/sha256

my-fn = (data []byte) (hash [32]byte) {
    dlen = data.len
    mod-val = (dlen + 9) % 64
    pad-len = 0
    mod-val != 0 -> {
        pad-len = 64 - mod-val
    }
    hash[0] = pad-len & 255
    hash[1] = (pad-len >> 8) & 255
}

main = () {
    print('start')
    msg []byte
    msg[0] = 0x61
    msg[1] = 0x62
    msg[2] = 0x63
    print('before my-fn')
    h [32]byte
    h = my-fn(msg)
    print('after my-fn')
    print(h[0])
    print(h[1])
    print('done')
}
