// test-sha256-step9 — 只有 []byte 參數，無返回
// # std/hash/sha256

my-fn = (data []byte) {
    print(data[0])
    print(data[1])
    print(data[2])
}

main = () {
    print('start')
    msg []byte
    msg[0] = 0x61
    msg[1] = 0x62
    msg[2] = 0x63
    print('before my-fn')
    my-fn(msg)
    print('after my-fn')
    print('done')
}
