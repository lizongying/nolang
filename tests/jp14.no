# /test/runner

t-join = () {
    s txt = 'a-b-c-d'
    parts = s.split('-')
    print('n={parts.len()}')
    i <- [0..parts.len()): {
        parts[i]: {
            ok -> {
                q = it
            }

            -> {
                q = ''
            }
        }
        print('  part[{i}] len={q.len-bytes()} val={q.to-str()}')
    }
    j = parts.join('.')
    print('J=[{j.to-str()}] len={j.len-bytes()}')
}
t-join()
