// test-bool-debug.no — 調試 str.to-bool
test-bool-true = () {
    s = 'true'
    b = s.to-bool()
        {
        b == nil -> print('nil')
        b == err -> print('err')
        -> {
            print('val=')
                    print(b)
        }
    }
}

test-bool-false = () {
    s = 'false'
    b = s.to-bool()
        {
        b == nil -> print('nil')
        b == err -> print('err')
        -> {
            print('val=')
                    print(b)
        }
    }
}

test-bool-true()
test-bool-false()