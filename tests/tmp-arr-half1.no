; 第一半测试
test-arr-len = () {
    b [3] = [10, 20, 30]
    print(b.len)
}

test-arr-clone = () {
    b [3] = [10, 20, 30]
    b = b.clone()
    print(b[0])
    print(b[1])
    print(b[2])
}

test-arr-eq = () {
    e [3] = [10, 20, 30]
    b [3] = [10, 20, 30]
    c [3] = [10, 20, 31]
    print(e.eq(b))
    print(e.eq(c))
}

test-arr-fill = () {
    b [3] = [0, 0, 0]
    b.fill(99)
    print(b[0])
    print(b[1])
    print(b[2])
}

test-arr-reverse = () {
    b [4] = [1, 2, 3, 4]
    b.reverse()
    print(b[0])
    print(b[1])
    print(b[2])
    print(b[3])
}

test-arr-contains = () {
    b [3] = [1, 2, 3]
    print(b.contains(2))
    print(b.contains(99))
}

test-arr-to-vec = () {
    b [3] = [10, 20, 30]
    v = b.to-vec()
    print(v[0])
    print(v[1])
    print(v[2])
}

test-arr-max-min-sum = () {
    b [5] = [3, 1, 4, 1, 5]
    print(b.max())
    print(b.min())
    print(b.sum())
}

test-arr-len()
print('---')
test-arr-clone()
print('---')
test-arr-eq()
print('---')
test-arr-fill()
print('---')
test-arr-reverse()
print('---')
test-arr-contains()
print('---')
test-arr-to-vec()
print('---')
test-arr-max-min-sum()
