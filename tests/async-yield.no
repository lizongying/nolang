; async-yield.no — async-yield 在協程內（讓出控制權）
; `co f(x)` 單態化出的 f-async 繼承 f 的內容，包括 async-yield() 調用。

yielder = (n i64) (r i64) {
    async-yield()

    #{overflow=wrap}
    r = n + 1
}

; 目標執行中讓出一次後繼續，最終返回 n+1
test-yield-inside = () {
    r = co yielder(5)
    print(r); expect: 6
}

; 非協程上下文的退化路徑
test-yield-plain = () {
    async-yield()
    print(9); expect: 9
}

test-yield-inside()
test-yield-plain()
