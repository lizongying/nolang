; test-sha3.no — SHA-3 (Keccak) 回歸測試
;
; 測試向量取自 NIST FIPS 202 的已知答案（空字串、'abc'、'The quick brown fox...'），
; 另含一組長度跨越 rate 邊界的長訊息，用來守住吸收／填充的分塊邏輯。
;
; 執行：./bin/no run tests/test-sha3.no
; 通過時每一行皆為 PASS。

# std/crypto/sha3

; check: 比對 got 與 want，輸出 PASS 或 FAIL
check = (label str, got str, want str) {
    got == want -> {
        print('PASS ')
        print(label)
        return
    }
    print('FAIL ')
    print(label)
    print('  got  = ')
    print(got)
    print('  want = ')
    print(want)
}

; ── 空字串 ──────────────────────────────────────
check('sha3-224("")', sha3.sha3-224-hex(''),
    '6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7')
check('sha3-256("")', sha3.sha3-256-hex(''),
    'a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a')
check('sha3-384("")', sha3.sha3-384-hex(''),
    '0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004')
check('sha3-512("")', sha3.sha3-512-hex(''),
    'a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26')

; ── 'abc' ──────────────────────────────────────
check('sha3-224("abc")', sha3.sha3-224-hex('abc'),
    'e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf')
check('sha3-256("abc")', sha3.sha3-256-hex('abc'),
    '3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532')
check('sha3-384("abc")', sha3.sha3-384-hex('abc'),
    'ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25')
check('sha3-512("abc")', sha3.sha3-512-hex('abc'),
    'b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0')

; ── 43 位元組訊息 ────────────────────────────────
fox = 'The quick brown fox jumps over the lazy dog'
check('sha3-224(fox)', sha3.sha3-224-hex(fox),
    'd15dadceaa4d5d7bb3b48f446421d542e08ad8887305e28d58335795')
check('sha3-256(fox)', sha3.sha3-256-hex(fox),
    '69070dda01975c8c120c3aada1b282394e7f032fa9cf32f4cb2259a0897dfc04')
check('sha3-384(fox)', sha3.sha3-384-hex(fox),
    '7063465e08a93bce31cd89d2e3ca8f602498696e253592ed26f07bf7e703cf328581e1471a7ba7ab119b1a9ebdf8be41')
check('sha3-512(fox)', sha3.sha3-512-hex(fox),
    '01dedd5de4ef14642445ba5f5b97c15e47b9ad931326e4b0727cd94cefc44fff23f07bf543139939b49128caf436dc1bdee54fcb24023a08d9403f9b4bf0d450')

; ── 200 位元組訊息（跨越多個 rate 區塊）──────────────
; rate 分別為 144 / 136 / 104 / 72，200 位元組對四者都需切兩塊以上
m = '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd'
check('sha3-224(m200)', sha3.sha3-224-hex(m),
    '9f6120fbf45f1e2f9f7a0e0c6cabfcb8fa3b75293c8c36a5d59237b6')
check('sha3-256(m200)', sha3.sha3-256-hex(m),
    '477ecabd74a84887f2d34cfd802f5a652ba422818aeac604f3db57f9103960fe')
check('sha3-384(m200)', sha3.sha3-384-hex(m),
    '80557eb0316e7ac0b5febecb5fbbdfadf01ff92b9e12f97456a7e03f3536fd89b46ed2efe0492672104b56cb69106cc1')
check('sha3-512(m200)', sha3.sha3-512-hex(m),
    '863a1b14ef2b001f1300443ad4fd0a780721c62c45e9193939189376733c0c75db83ba76f30d9dd2905384fdc83630adf0904ad940b2e970bd5b85341b572da3')

; ── 位元組介面 ───────────────────────────────────
; sha3-256('abc') 應等於 3a985da7...，確認 [32]byte 版本與 hex 版本一致
h = sha3.sha3-256('abc')
hex-chars = '0123456789abcdef'
got str = with-len(64)
i <- [0..32): {
    #{overflow=wrap}
    #{index-out = 0}
    got[i * 2] = hex-chars[(h[i] >> 4) & 15]
    #{overflow=wrap}
    #{index-out = 0}
    got[i * 2 + 1] = hex-chars[h[i] & 15]
}
check('sha3-256("abc") via [32]byte', got,
    '3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532')
