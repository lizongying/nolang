; fs-struct.no — 驗證 file-opts 結構體 + open() 自由組合旗標
;
; 目標語法：
;   open('test.dat', { mode: write, perm: perm-644, excl: true })

tmp = '/tmp/nolang-fs-test.txt'
payload = 'hello nolang file struct'
fs.remove(tmp)

f-w = fs.open(tmp,  {
    mode: file-mode.write
    perm: file-perm.perm-644
    excl: false
    truncate: false
    append: false
})
f-w: {
    err -> print('fail: open-write err')

    nil -> print('fail: open-write nil')

    -> {
        it.write-str(payload)
        it.close()
        print('ok: open write')
    }
}
f-e = fs.open(tmp,  {
    mode: file-mode.write
    perm: file-perm.perm-644
    excl: true
    truncate: false
    append: false
})

; O_EXCL 撞上已存在的檔案時，POSIX 的行為是讓 open 失敗（EEXIST）。std 把這個失敗
; 回報成 err（帶 errno 訊息）而不是 nil，兩者都代表「檔案沒有被打開」，所以這裡
; 兩種結果都算通過 —— 只有真的把檔案打開了（走到 ok 臂）才是失敗。
f-e: {
    err -> print('ok: excl blocks existing file (EEXIST)')

    nil -> print('ok: excl blocks existing file')

    -> print('fail: excl did not block')
}
f-r = fs.open(tmp,  {
    mode: file-mode.read
    perm: file-perm.perm-644
    excl: false
    truncate: false
    append: false
})
f-r: {
    err -> print('fail: open-read err')

    nil -> print('fail: open-read nil')

    -> {
        buf [256]byte

        ; 巢狀 match 的臂內 `it` 是**內層**的載荷（這裡是 []byte），不再是最外層的
        ; 檔案控制代碼。要跨層使用就得先存到具名變數。
        f = it
        r = f.read-bytes()
        r: {
            err -> print('fail: read err')

            nil -> print('fail: read nil')

            -> {
                n = r.len()
                f.close()
                {
                    n == payload.len-bytes() -> print('ok: read length matches')

                    -> print('fail: read length mismatch')
                }
            }
        }
    }
}
fs.remove(tmp)
