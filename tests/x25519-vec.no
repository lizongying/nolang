; test-x25519-vec — X25519 RFC 7748 測試向量驗證
; # std/crypto/x25519

; 將 hex 字串轉為 [32]byte
; hex-str str: 64 字元 hex 字串（每 2 字元一個位元組）
; out [32]byte: 解析出的 32 位元組
hex-to-bytes = (hex-str str) (out [32]byte) {

    ; #{ascii} 證明此 hex 串為純 ASCII：s[i] 由 O(n) 碼點迭代退化為 O(1) 定址
    #{ascii}
    hex-src = hex-str
    i <- [0..32): {

        #{overflow=wrap}
        hi char = hex-src[i * 2]

        #{overflow=wrap}
        lo char = hex-src[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        {
            hi >= 48 && hi <= 57 -> {
                hi-v = hi - 48
            }

            hi >= 97 && hi <= 102 -> {
                hi-v = hi - 87
            }

            hi >= 65 && hi <= 70 -> {
                hi-v = hi - 55
            }
        }
        {
            lo >= 48 && lo <= 57 -> {
                lo-v = lo - 48
            }

            lo >= 97 && lo <= 102 -> {
                lo-v = lo - 87
            }

            lo >= 65 && lo <= 70 -> {
                lo-v = lo - 55
            }
        }
        out[i] = (hi-v << 4) | lo-v
    }
}

; 比較兩個 [32]byte 是否相等
; a [32]byte: 第一個緩衝區
; b [32]byte: 第二個緩衝區
; eq bool: 32 個位元組全部相同才為 true（遇到差異立即 break）
bytes-eq = (a [32]byte, b [32]byte) (eq bool) {
    eq = true
    i <- [0..32): {
        a[i] != b[i] -> {
            eq = false
            break
        }
    }
}

; RFC 7748 第一組測試向量
; pass bool: true=Alice/Bob 公鑰與共享金鑰皆與檔案頂部註解的金標 hex 完全相同；
;           false=任一項不匹配（會逐位元組 eprint 差異）
test-vec-1 = () (pass bool) {
    pass = false

    ; Alice private: 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
    ; Alice public:  8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
    ; Bob private:   5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb
    ; Bob public:    de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f
    ; Shared:        4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742

    alice-priv = hex-to-bytes('77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a')

    ; 計算 Alice 公鑰（在第二次呼叫 hex-to-bytes 之前）
    alice-pub = x25519.x25519-scalarmult-base(alice-priv)

    alice-pub-expected = hex-to-bytes('8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a')

    ok = bytes-eq(alice-pub, alice-pub-expected)
    ok == false -> {
        print('FAIL: Alice public key mismatch')
        i <- [0..32): {

            ; 索引讀取返回 option：宣告具體型別即取載荷（OOB 依註解補零）。
            e byte = alice-pub-expected[i]

            #{index-out=zero}
            c byte = alice-pub[i]
            eprint('  idx=')
            eprint(i)
            eprint(' expected=')
            eprint(e)
            eprint(' computed=')
            eprint(c)
        }
        return
    }
    print('PASS: Alice public key matches')

    ; Bob 的金鑰
    bob-priv = hex-to-bytes('5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb')
    bob-pub-expected = hex-to-bytes('de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f')
    bob-pub = x25519.x25519-scalarmult-base(bob-priv)

    ok = bytes-eq(bob-pub, bob-pub-expected)
    ok == false -> {
        print('FAIL: Bob public key mismatch')
        return
    }
    print('PASS: Bob public key matches')

    ; 計算共享金鑰
    shared-alice = x25519.x25519-scalarmult(alice-priv, bob-pub)
    shared-bob = x25519.x25519-scalarmult(bob-priv, alice-pub)

    ; 驗證兩端共享金鑰相同
    ok = bytes-eq(shared-alice, shared-bob)
    ok == false -> {
        print('FAIL: shared secrets differ between Alice and Bob')
        eprint('Alice shared:')
        i <- [0..32): {
            eprint(' ')
            b byte = shared-alice[i]
            eprint(b)
        }
        eprint('Bob shared:')
        i <- [0..32): {
            eprint(' ')
            b byte = shared-bob[i]
            eprint(b)
        }
        return
    }
    print('PASS: shared secrets match between Alice and Bob')

    ; 驗證共享金鑰等於預期值
    shared-expected = hex-to-bytes('4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742')
    ok = bytes-eq(shared-alice, shared-expected)
    ok == false -> {
        print('FAIL: shared secret does not match expected value')
        eprint('Computed:')
        i <- [0..32): {
            eprint(' ')
            b byte = shared-alice[i]
            eprint(b)
        }
        eprint('Expected:')
        i <- [0..32): {
            eprint(' ')
            b byte = shared-expected[i]
            eprint(b)
        }
        return
    }
    print('PASS: shared secret matches expected value')

    pass = true
}

p1 = test-vec-1()
{
    p1 == true -> print('PASS: X25519 RFC 7748 test vector')

    p1 == false -> print('FAIL: X25519 RFC 7748 test vector')
}
