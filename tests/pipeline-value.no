; `->` 是短路管道；寫在賦值右側時，管道的結果就是末尾的值節點。
; 失敗（條件不成立 / 被 ?T 節點短路）時賦值不生效：變數保留原值，首次宣告則為零值。

might-fail = (n i64) (r ?i64) {
    n > 0 -> {
        r = nil
        return
    }
    r = n
}

print('1 trailing value')
x = 2 > 1 -> 42
print(x)

print('2 false cond keeps previous value')
y = 7
y = 1 > 2 -> 42
print(y)

print('3 fresh binding, false cond -> zero')
z = 1 > 2 -> 42
print(z)

print('4 owned value')
s = 'old'
s = 1 > 2 -> 'new'
print(s)
s2 = 'old2'
s2 = 2 > 1 -> 'new2'
print(s2)

print('5 ?T node short-circuits the tail')
bad = 7

; D1：`-` 的結果恆為 `?i64`，plain i64 標註不再抑制 option 化（那是硬錯
; 15w45dqk）。此處要的是回繞的普通整數（本測試只驗證管道短路，不取用
; good），故用兩段式解包：先推斷為 ?T，再 match 取 ok 值，err/nil 臂
; 空轉（good 保持預宣告的零值）。
#{overflow=wrap}
good-opt = 0 - 3
good i64 = 0
good-opt: {
    ok -> good = it
    ->
}
r = 5
r = print('A')
might-fail(bad) -> 99
print(r)
r = print('B')
might-fail(good) -> 99
print(r)

print('6 arm body is a pipeline, both nodes run')
v ?i64
v = 5
v: {
    nil -> print('nil')

    err -> print('err')

    ok -> print('C') -> print('D')
}

print('7 guard chain inside one arm')
v: {
    nil -> print('nil2')

    err -> print('err2')

    ok -> v == 5 -> print('YES')
}

print('done')
