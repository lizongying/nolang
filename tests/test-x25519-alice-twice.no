; test-x25519-alice-twice — 測試 Alice 金鑰計算兩次（檢查狀態累積）
; # std/crypto/x25519

hex-to-bytes = (hex-str str) (out [32]byte) {
    i <- [0..32): {
        hi = hex-str[i * 2]
        lo = hex-str[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        hi >= 48 && hi <= 57 -> hi-v = hi - 48
        hi >= 97 && hi <= 102 -> hi-v = hi - 87
        hi >= 65 && hi <= 70 -> hi-v = hi - 55
        lo >= 48 && lo <= 57 -> lo-v = lo - 48
        lo >= 97 && lo <= 102 -> lo-v = lo - 87
        lo >= 65 && lo <= 70 -> lo-v = lo - 55
        out[i] = (hi-v << 4) | lo-v
    }
}

bytes-eq = (a [32]byte, b [32]byte) (eq bool) {
    eq = true
    i <- [0..32): {
        a[i] != b[i] -> {
            eq = false
            break
        }
    }
}

print-bytes = (label str, a [32]byte) {
    eprint(label)
    i <- [0..32): {
        eprint(' ')
        eprint(a[i] & 255)
    }
}

main = () {

    ; Alice private: 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
    ; Alice public:  8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a

    alice-priv = hex-to-bytes('77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a')
    alice-pub-expected = hex-to-bytes('8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a')

    ; 第一次計算
    alice-pub-1 = x25519.x25519-scalarmult-base(alice-priv)
    print-bytes('pub-1:', alice-pub-1)

    ok1 = bytes-eq(alice-pub-1, alice-pub-expected)
    ok1 == true -> print('PASS: Alice first call')
    ok1 == false -> print('FAIL: Alice first call')

    ; 第二次計算（相同輸入）
    alice-pub-2 = x25519.x25519-scalarmult-base(alice-priv)
    print-bytes('pub-2:', alice-pub-2)

    ok2 = bytes-eq(alice-pub-2, alice-pub-expected)
    ok2 == true -> print('PASS: Alice second call')
    ok2 == false -> print('FAIL: Alice second call')

    ; 檢查兩次結果是否相同
    same = bytes-eq(alice-pub-1, alice-pub-2)
    same == true -> print('SAME: both calls produce same result')
    same == false -> print('DIFF: calls produce different results')
}
