words []str = with-cap(256)
counts []i64 = with-cap(256)
word [64]byte
wlen = 0
n = 0
tmp-word = ''

; 模擬單詞 "hello"
word[0] = 104
word[1] = 101
word[2] = 108
word[3] = 108
word[4] = 111
wlen = 5

; 構造 str（str 下標直寫已全域禁用 ⇒ []byte 緩衝 + 整體轉回）
tmp-b []byte = with-cap-len(64, 64)
k = 0
k <- [0..wlen): {
    tmp-b[k] = word[k]
}
tmp-word = tmp-b.slice(0, wlen).to-bytes-str()
words.push(tmp-word)
counts.push(1)
n = 1

; 模擬第二個單詞 "world"
word[0] = 119
word[1] = 111
word[2] = 114
word[3] = 108
word[4] = 100
wlen = 5

tmp-b2 []byte = with-cap-len(64, 64)
k <- [0..wlen): {
    tmp-b2[k] = word[k]
}
tmp-word = tmp-b2.slice(0, wlen).to-bytes-str()

; 線性搜尋
found = 0
cmp-result = 0
k <- [0..n): {
    found == 0 -> {
        cmp-result = tmp-word.compare(words[k])
        cmp-result == 0 -> {

            #{overflow=wrap}
            counts[k] = counts[k] + 1
            found = 1
        }
    }
}
found == 0 -> {
    words.push(tmp-word)
    counts.push(1)

    #{overflow=wrap}
    {

        #{overflow=wrap}
        n-opt = n + 1
        n-opt: {
            ok -> n = it

            ->
        }
    }
}

; 輸出
k <- [0..n): {
    print('{words[k]} {counts[k]}')
}
