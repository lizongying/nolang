; test-open-read.no — 驗證 open() 讀取

tmp = '/tmp/nolang-read-test.txt'
payload = 'hello nolang'
fs.remove(tmp)

; 先寫入
f-w = fs.open(tmp,  {
    mode: file-mode.write
    perm: file-perm.perm-600
    excl: false
    truncate: false
    append: false
})
f-w: {
    err -> print('fail: write err')
    nil -> print('fail: write nil')
    -> {
        it.write-str(payload)
        it.close()
        print('ok: write')
    }
}

; 再讀取
f-r = fs.open(tmp,  {
    mode: file-mode.read
    perm: file-perm.perm-600
    excl: false
    truncate: false
    append: false
})
f-r: {
    err -> print('fail: read err')
    nil -> print('fail: read nil')
    -> {
        r = it.read-str()
        r: {
            err -> print('fail: read-str err')
            nil -> print('ok: read empty')
            -> print('ok: read')
        }
        it.close()
    }
}
fs.remove(tmp)
