// test-open-read.no — 驗證 open() 讀取

# std/fs

main = () {
    tmp = '/tmp/nolang-read-test.txt'
    payload = 'hello nolang'
    remove(tmp)

    // 先寫入
    f-w ?file
    f-w = open(tmp, {
        mode: file-mode.write
        perm: file-perm.perm-600
        excl: false
        truncate: false
        append: false
    })
    f-w: {
        err -> print('fail: write err')
        nil -> print('fail: write nil')
        -> {
            it.write(payload, payload.len)
            it.close()
            print('ok: write')
        }
    }

    // 再讀取
    f-r ?file
    f-r = open(tmp, {
        mode: file-mode.read
        perm: file-perm.perm-600
        excl: false
        truncate: false
        append: false
    })
    f-r: {
        err -> print('fail: read err')
        nil -> print('fail: read nil')
        -> {
            buf [256]byte
            n = it.read(buf, 256)
            it.close()
            print('ok: read')
        }
    }

    remove(tmp)
}

main()
