// test-open-read.no — 驗證 open() 讀取

main = () {
    tmp = '/tmp/nolang-read-test.txt'
    payload = 'hello nolang'
    remove(tmp)

    // 先寫入
    f-w ?file
    f-w = open(tmp, {
        perm: FilePerm.PERM_600,
        mode: FileMode.WRITE | FileMode.CREATE,
        excl: false
    })
    f-w: {
        err -> print('fail: write err')
        nil -> print('fail: write nil')
        ok ->
            it.write(payload, payload.len)
            it.close()
            print('ok: write')
    }

    // 再讀取
    f-r ?file
    f-r = open(tmp, {
        perm: FilePerm.PERM_600,
        mode: FileMode.READ,
        excl: false
    })
    f-r: {
        err -> print('fail: read err')
        nil -> print('fail: read nil')
        ok ->
            buf [256]byte
            n = it.read(buf, 256)
            it.close()
            print('ok: read')
    }

    remove(tmp)
}

main()
