f = (buf []byte, pos i64) (name str, value str, next-pos i64) {
    r-pos = pos
    next-pos = -1
    r-pos >= buf.len() -> return

    prefix = buf[r-pos]: {
        ok -> it

        -> 0
    }
    {
        r-pos-opt = r-pos + 1
        r-pos-opt: {
            ok -> r-pos = it

            ->
        }
    }
    (prefix & 0xe0) != 0x20 -> return

    buf-r-pos = buf[r-pos]: {
        ok -> it

        -> _
    }

    name-len = buf-r-pos & 63
    {
        r-pos-opt2 = r-pos + 1
        r-pos-opt2: {
            ok -> r-pos = it

            ->
        }
    }
    r-pos + name-len > buf.len() -> return

    nameopt = buf[r-pos..r-pos + name-len).to-str()
    name = nameopt: {
        ok -> it

        -> ''
    }
    r-pos = r-pos + name-len
    r-pos >= buf.len() -> return

    buf-r-pos-2 = buf[r-pos]: {
        ok -> it

        -> _
    }

    value-len = buf-r-pos-2 & 63
    {
        r-pos-opt3 = r-pos + 1
        r-pos-opt3: {
            ok -> r-pos = it

            ->
        }
    }
    r-pos + value-len > buf.len() -> return
    valueopt = buf[r-pos..r-pos + value-len).to-str()
    value = valueopt: {
        ok -> it

        -> ''
    }
    r-pos = r-pos + value-len
    next-pos = r-pos
}
print(f([
    0x23, 0x03, 0x66, 0x6f, 0x6f, 0x03, 0x62, 0x61,
    0x72,
], 0))
