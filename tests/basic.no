; basic.no — 核心編譯驗證

; 兩數較大者（改用 a-b 的符號判斷，避免直接比較時的溢出）
; a i64: 第一個運算元
; b i64: 第二個運算元
; r i64: 較大的運算元（兩者相等時為 b）
i64-max = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    d = a - b
    {
        d > 0 -> r = a

        -> r = b
    }
}

; 兩數較小者（同樣靠 a-b 的符號判斷）
; a i64: 第一個運算元
; b i64: 第二個運算元
; r i64: 較小的運算元（兩者相等時為 a）
i64-min = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    d = a - b
    {
        d > 0 -> r = b

        -> r = a
    }
}

; 取絕對值 i64（i64.MIN 因溢出回繞仍為自身）
; a i64: 來源數值，可為負
; r i64: a >= 0 時為 a，否則為 0 - a
abs-i64 = (a i64) (r i64) {
    {
        a < 0 -> {

            #{overflow=wrap}
            r = 0 - a
        }

        -> r = a
    }
}

; 歐幾里得演算法求最大公因數：先取絕對值，再輾轉相除
; a i64: 第一個整數，允許負數
; b i64: 第二個整數，允許負數
; r i64: |a| 與 |b| 的最大公因數；其中一個為 0 時取另一個的絕對值
gcd = (a i64, b i64) (r i64) {
    ra = a
    rb = b
    (ra < 0) {

        #{overflow=wrap}
        ra = 0 - ra
    }
    (rb < 0) {

        #{overflow=wrap}
        rb = 0 - rb
    }
    (rb != 0) {
        t = rb
        rb = ra % rb
        ra = t
    }
    r = ra
}

; 驅動函式：依次呼叫上面四個函式並印出結果（無輸出參數，自驗端到端可用）
caller = () {
    r = 0

    r = i64-max(10, 20)
    print(r)

    r = i64-min(10, 20)
    print(r)

    r = abs-i64(-42)
    print(r)

    r = gcd(12, 18)
    print(r)

    print('ok: all tests done')
}
caller()
