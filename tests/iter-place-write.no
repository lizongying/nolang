; iter-place-write — `x <- a` 的迭代變數是元素「位置」，不是每輪的載入副本
;
; 兩種寫法必須完全等價：
;   i <- [0..n): { a[i]: { ok -> it = v ... } }   ; D9 place-match（本來就可用）
;   x <- a:      { x:   { ok -> it = v ... } }    ; 迭代變數（本檔修復對象）
;
; 修復前第二種完全靜默，兩處各自出錯：
;   1) 臂條件退化：`x: { ok -> ... }` 對非 option 元素降成 `x == 0`
;      （裸 `ok` 變體的判別值）⇒ 只有元素值恰為 0 才進臂；
;   2) 寫入丟失：`it = v` 只重綁每輪的局部副本，元素本身沒動。
; 迭代變數既然就是元素，讀要重新下標、寫要落回元素（同 `a[i]`）。
;
; 斷言口徑：索引讀取恆為 `?T`（安全索引），`a[0] != 5` 這種「索引讀 vs 字面量」
; 的比較**是文檔口徑內的合法寫法**，比的是 payload（見 tests/index-compare.no）。
; 本檔仍用「顯式 plain 型別」綁定再比，只是為了讓斷言讀起來更像「元素值」，
; 不是因為直接比較不可用。

; 1. 迭代變數 + place-match 寫入；元素含 0 與非 0 —— 兩種都要進臂
;    （非 0 元素鎖定臂條件折疊，修復前它們根本不會進臂）
a = [0, 3, 0, 3]
x <- a: {
    x: {
        ok -> it = 5

        -> {
        }
    }
}
a0 i64 = a[0]
a1 i64 = a[1]
a2 i64 = a[2]
a3 i64 = a[3]
a0 != 5 -> exit(1)
a1 != 5 -> exit(2)
a2 != 5 -> exit(3)
a3 != 5 -> exit(4)

; 2. 對照組：下標 + place-match 寫入（本來就可用，不得被改壞）
b = [0, 0, 0, 0]
i <- [0..4): {
    b[i]: {
        ok -> it = 6

        -> {
        }
    }
}
b0 i64 = b[0]
b3 i64 = b[3]
b0 != 6 -> exit(5)
b3 != 6 -> exit(6)

; 3. 普通賦值同樣寫回元素，且是讀-改-寫
c = [1, 2, 3]
y <- c: {
    y = y + 10
}
c0 i64 = c[0]
c1 i64 = c[1]
c2 i64 = c[2]
c0 != 11 -> exit(7)
c1 != 12 -> exit(8)
c2 != 13 -> exit(9)

; 4. 臂內的讀-改-寫：`it = it + 1` 的讀也必須重新下標
h = [1, 2, 3]
w <- h: {
    w: {
        ok -> it = it + 1

        -> {
        }
    }
}
h0 i64 = h[0]
h1 i64 = h[1]
h2 i64 = h[2]
h0 != 2 -> exit(10)
h1 != 3 -> exit(11)
h2 != 4 -> exit(12)

; 5. 定長陣列 + byte 元素
d [3]byte = [0, 0, 0]
z <- d: {
    z = 7
}
d0 byte = d[0]
d2 byte = d[2]
d0 != 7 -> exit(13)
d2 != 7 -> exit(14)

; 6. 巢狀迴圈：內層位置不污染外層，外層位置在內層結束後仍然有效
e = [0, 0]
f = [0, 0]
p <- e: {
    q <- f: {
        q = 3
    }
    p = 8
}
e0 i64 = e[0]
e1 i64 = e[1]
f0 i64 = f[0]
f1 i64 = f[1]
e0 != 8 -> exit(15)
e1 != 8 -> exit(16)
f0 != 3 -> exit(17)
f1 != 3 -> exit(18)

; 7. 元素本身是 option（`[]?T`）：`ok` 臂的 `it` 是載荷，寫回時要包回 `ok`
;    （`[]?T` 的 MIR 元素型別是載荷型別，故存在性折疊同樣生效；臂分派與下標
;     形態一致，由 §7b 鎖定）
g []?i64 = [ok(1), ok(2)]
gv <- g: {
    gv: {
        ok -> it = 9

        -> {
        }
    }
}

;    一行形式 `k = <expr>: { … }` 只在 <expr> 是**裸識別符**時才會附著，且必須列齊
;    ok/nil/err；這裡先綁定再解包，並用 `-> {}` 兜底（與 §7b 同一寫法）。
gk0 = g[0]
gk1 = g[1]
g0 = 0
g1 = 0
gk0: {
    ok -> g0 = it

    -> {
    }
}
gk1: {
    ok -> g1 = it

    -> {
    }
}
g0 != 9 -> exit(19)
g1 != 9 -> exit(20)

; 7b. 兩形態的臂分派必須一致：同一語料下 `ok` / `nil` 臂的命中次數相等
;     （`[]?T` 的臂分派本身是既有行為，本檔只鎖「兩種寫法等價」）
oa []?i64 = [ok(1), nil, ok(3)]
sub-ok = 0
sub-nil = 0
ii <- [0..3): {
    oa[ii]: {
        ok -> {
            {
                sub-ok-opt = sub-ok + 1
                sub-ok-opt: {
                    ok -> sub-ok = it

                    ->
                }
            }
        }

        nil -> {
            {
                sub-nil-opt = sub-nil + 1
                sub-nil-opt: {
                    ok -> sub-nil = it

                    ->
                }
            }
        }

        -> {
        }
    }
}
ob []?i64 = [ok(1), nil, ok(3)]
iter-ok = 0
iter-nil = 0
ov <- ob: {
    ov: {
        ok -> {
            {
                iter-ok-opt = iter-ok + 1
                iter-ok-opt: {
                    ok -> iter-ok = it

                    ->
                }
            }
        }

        nil -> {
            {
                iter-nil-opt = iter-nil + 1
                iter-nil-opt: {
                    ok -> iter-nil = it

                    ->
                }
            }
        }

        -> {
        }
    }
}
sub-ok != iter-ok -> exit(21)
sub-nil != iter-nil -> exit(22)

; 8. 擁有所有權的元素（str）：覆蓋寫入必須丟棄舊元素、只丟一次
t = [
    'x',
    'y',
    'z',
]
tv <- t: {
    tv = 'q'
}
t0 str = t[0]
t2 str = t[2]
t0 != 'q' -> exit(23)
t2 != 'q' -> exit(24)

; 9. 字串迭代不是位置：元素是解碼出的碼點（無存儲），寫入只留在局部
s = 'abc'
ch <- s: {
    ch = "z"
}
s != 'abc' -> exit(25)

print('iter-place-write ALL PASSED')
