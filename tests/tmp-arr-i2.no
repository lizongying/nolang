test-arr-index-of = () {
    b [3] = [1, 2, 3]
    print(b.index-of(2))
}

test-arr-last-first = () {
    b [3] = [10, 20, 30]
    print(b.first())
}

test-arr-sort-asc = () {
    b [5] = [3, 1, 4, 1, 5]
    b.sort-asc()
    print(b[3])
}

test-arr-index-of()
print('---')
test-arr-last-first()
print('---')
test-arr-sort-asc()
