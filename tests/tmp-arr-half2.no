; 第二半測試
test-arr-index-of = () {
    a1 [3] = [1, 2, 3]
    print(a1.index-of(2))
    print(a1.index-of(99))
}

test-arr-last-first = () {
    a2 [3] = [10, 20, 30]
    print(a2.first())
    print(a2.last())
}

test-arr-sort-asc = () {
    a3 [5] = [3, 1, 4, 1, 5]
    a3.sort-asc()
    print(a3[0])
    print(a3[1])
    print(a3[2])
    print(a3[3])
    print(a3[4])
}

test-arr-sort-desc = () {
    a4 [5] = [3, 1, 4, 1, 5]
    a4.sort-desc()
    print(a4[0])
    print(a4[1])
    print(a4[2])
    print(a4[3])
    print(a4[4])
}

test-arr-swap = () {
    a5 [3] = [1, 2, 3]
    a5.swap(0, 2)
    print(a5[0])
    print(a5[1])
    print(a5[2])
}

test-arr-count = () {
    a6 [5] = [1, 2, 1, 3, 1]
    print(a6.count(1))
    print(a6.count(99))
}

test-arr-at = () {
    a7 [3] = [1, 2, 3]
    print(a7.at(0))
    print(a7.at(5))
    print(a7.at(-1))
}

test-arr-to-str = () {
    a8 [3] = [1, 2, 3]
    print(a8.to-str())
}

test-arr-index-of()
print('---')
test-arr-last-first()
print('---')
test-arr-sort-asc()
print('---')
test-arr-sort-desc()
print('---')
test-arr-swap()
print('---')
test-arr-count()
print('---')
test-arr-at()
print('---')
test-arr-to-str()
