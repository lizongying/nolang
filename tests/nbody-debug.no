sm = 39.478417604357432
px []f64 = with-cap(5)
py []f64 = with-cap(5)
pz []f64 = with-cap(5)
vx []f64 = with-cap(5)
vy []f64 = with-cap(5)
vz []f64 = with-cap(5)
mass []f64 = with-cap(5)
