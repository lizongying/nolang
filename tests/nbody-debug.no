px2 = 0.0
py2 = 0.0
pz2 = 0.0
mi = 0.0
vi = 0.0
i <- [0..5): {
    mi = mass[i]
    vi = vx[i]
    px2 = px2 + mi * vi
    mi = mass[i]
    vi = vy[i]
    py2 = py2 + mi * vi
    mi = mass[i]
    vi = vz[i]
    pz2 = pz2 + mi * vi
}
vx[0] = -px2 / sm
vy[0] = -py2 / sm
vz[0] = -pz2 / sm

; print initial values for debugging
tvx f64 = vx[0]
tvy f64 = vy[0]
tvz f64 = vz[0]
print('vx[0] = {tvx:.17g}')
print('vy[0] = {tvy:.17g}')
print('vz[0] = {tvz:.17g}')
