// test-http-rest.no — HTTP REST 層測試
//
// 本測試為 vet-only，需要實際 HTTP 伺服器才能執行。
// 測試 Phase 3 新增的 REST 支援：http-request struct、自訂標頭、
// http-put / http-delete / http-patch 便捷函數、http-do-req、
// http-response.parse-headers / get-header。

# std/net/http

main = () {
    // ── 測試 1: http-request 結構體與 init ──
    req http-request = http-request{}
    req.init('PUT', 'http://example.com/api/item', '{"name":"test"}')
    if req.method == 'PUT' {
        print('ok: http-request.init method')
    } else {
        print('fail: http-request.init method')
    }
    if req.url == 'http://example.com/api/item' {
        print('ok: http-request.init url')
    } else {
        print('fail: http-request.init url')
    }
    if req.body == '{"name":"test"}' {
        print('ok: http-request.init body')
    } else {
        print('fail: http-request.init body')
    }
    if req.header-count == 0 {
        print('ok: http-request.init header-count')
    } else {
        print('fail: http-request.init header-count')
    }

    // ── 測試 2: add-header ──
    ok1 bool = req.add-header('Content-Type', 'application/json')
    if ok1 {
        print('ok: add-header Content-Type')
    } else {
        print('fail: add-header Content-Type')
    }
    if req.header-count == 1 {
        print('ok: header-count after add')
    } else {
        print('fail: header-count after add')
    }
    ok2 bool = req.add-header('Authorization', 'Bearer token123')
    if ok2 && req.header-count == 2 {
        print('ok: add-header Authorization')
    } else {
        print('fail: add-header Authorization')
    }

    // ── 測試 3: http-response 擴充欄位 ──
    r http-response = http-response{}
    r.status-code = 200
    r.status-text = 'OK'
    r.headers = 'Content-Type: text/html\r\nContent-Length: 13'
    r.body = '<html></html>'
    if r.status-code == 200 {
        print('ok: http-response status-code')
    } else {
        print('fail: http-response status-code')
    }

    // ── 測試 4: parse-headers（手動填充 headers 後解析）
    r.parse-headers()
    if r.header-count == 2 {
        print('ok: parse-headers count=2')
    } else {
        print('fail: parse-headers count')
        print(r.header-count)
    }

    // ── 測試 5: get-header ──
    ct str = ''
    ct-ok bool = false
    r.get-header('Content-Type')(ct, ct-ok)
    if ct-ok {
        if ct == 'text/html' {
            print('ok: get-header Content-Type')
        } else {
            print('fail: get-header Content-Type value')
            print(ct)
        }
    } else {
        print('fail: get-header Content-Type not found')
    }

    cl str = ''
    cl-ok bool = false
    r.get-header('Content-Length')(cl, cl-ok)
    if cl-ok && cl == '13' {
        print('ok: get-header Content-Length')
    } else {
        print('fail: get-header Content-Length')
    }

    // 不存在的標頭
    none str = ''
    none-ok bool = true
    r.get-header('X-Nonexistent')(none, none-ok)
    if none-ok == false {
        print('ok: get-header nonexistent returns false')
    } else {
        print('fail: get-header nonexistent should return false')
    }

    // ── 測試 6: http-put 便捷函數（vet-only，需網路才能執行）
    resp http-response = http-response{}
    put-ok bool = false
    http-put('http://example.com/api/item', 'data')(resp, put-ok)
    if put-ok {
        print('ok: http-put connected')
        print(resp.status-code)
    } else {
        print('skip: http-put (no network)')
    }

    // ── 測試 7: http-delete 便捷函數
    del-ok bool = false
    http-delete('http://example.com/api/item/1')(resp, del-ok)
    if del-ok {
        print('ok: http-delete connected')
    } else {
        print('skip: http-delete (no network)')
    }

    // ── 測試 8: http-patch 便捷函數
    patch-ok bool = false
    http-patch('http://example.com/api/item/1', '{"key":"v"}')(resp, patch-ok)
    if patch-ok {
        print('ok: http-patch connected')
    } else {
        print('skip: http-patch (no network)')
    }

    // ── 測試 9: http-do-req（自訂標頭）
    req2 http-request = http-request{}
    req2.init('POST', 'http://example.com/api/auth', '{"user":"admin"}')
    req2.add-header('Content-Type', 'application/json')
    req2.add-header('X-Request-Id', 'abc123')
    do-req-ok bool = false
    http-do-req(req2)(resp, do-req-ok)
    if do-req-ok {
        print('ok: http-do-req connected')
    } else {
        print('skip: http-do-req (no network)')
    }

    print('ok: all tests done')
}
main()
