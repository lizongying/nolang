[]txt.myjoin = (sep txt) (out txt) {
    parts = .
    n = parts.len()
    n == 0 -> return
    cap = 255
    pos = 0
    i <- [0..n): {
        i > 0 -> {
            sj <- [0..sep.len-bytes()): {
                pos < cap -> {
                    out.set-byte(pos, sep.byte(sj))
                    pos = pos + 1
                }
            }
        }
        parts[i]: {
            ok -> {
                q = it
            }

            -> {
                q = ''
            }
        }
        sl i64 = q.len-bytes()
        sj <- [0..sl): {
            pos < cap -> {
                out.set-byte(pos, q.byte(sj))
                pos = pos + 1
            }
        }
    }
    out.len = pos
}

s txt = 'a-b-c-d'
parts = s.split('-')
print('real :', parts.join('.').to-str())
print('mine :', parts.myjoin('.').to-str())

