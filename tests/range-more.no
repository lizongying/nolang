; ── from tests/min-print.no ──
mp-run = () {
    print('start')
    print('done')
}

ro-run()
sp-run()
fr-run()
fl-run()
fl2-run()
fl3-run()
r3-run()
r4-run()
mp-run()

; ── from tests/range-test.no ──
; range-test.no — 測試 range-for 各種情況
; 包含遞增、遞減、常量、變量邊界

; 遞增 range (變量邊界)
; r i64: i 走 [0..5) 的總和，0+1+2+3+4 = 10
rt-test-ascending = () (r i64) {
    sum = 0
    n = 5
    i <- [0..n): {

        #{overflow=wrap}
        sum = sum + i
    }
    r = sum
}

; 遞減 range (變量邊界)
; r i64: i 走 [5..0) 的總和，5+4+3+2+1 = 15
rt-test-descending = () (r i64) {
    sum = 0
    n = 0
    i <- [5..n): {

        #{overflow=wrap}
        sum = sum + i
    }
    r = sum
}

; 常量邊界 range
; r i64: i 走 [0..10) 的總和，0+…+9 = 45
rt-test-constant = () (r i64) {
    sum = 0
    i <- [0..10): {

        #{overflow=wrap}
        sum = sum + i
    }
    r = sum
}

; 常量遞減 range
; r i64: i 走 [5..0) 的總和，5+4+3+2+1 = 15
rt-rt-test-constant-desc = () (r i64) {
    sum = 0
    i <- [5..0): {

        #{overflow=wrap}
        sum = sum + i
    }
    r = sum
}

; 嵌套 range
; r i64: 雙層 3×4 的累加值 (i*10+j)，6+46+86 = 138
rt-test-nested = () (r i64) {
    sum = 0
    n = 3
    m = 4
    i <- [0..n): {
        j <- [0..m): {

            #{overflow=wrap}
            sum = sum + i * 10 + j
        }
    }
    r = sum
}

; range with break
; r i64: i 走到 5 就跳出，累加 0+1+2+3+4 = 10
rt-test-break = () (r i64) {
    sum = 0
    n = 100
    i <- [0..n): {
        i >= 5 -> break

        #{overflow=wrap}
        sum = sum + i
    }
    r = sum
}
rt-a = rt-test-ascending()
print(rt-a)

; 0+1+2+3+4 = 10

rt-b = rt-test-descending()
print(rt-b)

; 5+4+3+2+1 = 15

rt-c = rt-test-constant()
print(rt-c)

; 0+1+2+...+9 = 45

rt-d = rt-rt-test-constant-desc()
print(rt-d)

; 5+4+3+2+1 = 15

rt-e = rt-test-nested()
print(rt-e)

; (0*10+0)+(0*10+1)+(0*10+2)+(0*10+3)+(1*10+0)+...+(2*10+3)
; = 0+1+2+3 + 10+11+12+13 + 20+21+22+23 = 6+46+86 = 138

rt-f = rt-test-break()
print(rt-f)
; 0+1+2+3+4 = 10

