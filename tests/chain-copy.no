; 測試鏈式存取
;
; 註：原版本用 `x.len = n` 直接寫字串長度（再用 `[i] = b` 逐字節填）。那種寫法對
; 一般變數會被擋（「cannot modify read-only field 'len' of string」），只是在
; 巢狀路徑 `p.nodes[i].str-val.len` 上沒被擋到，於是 len 被改成 1 但 data 仍是
; null，下一個 `[0] = 97` 就 SIGSEGV。這裡改用正常的字串指派，一樣能測到
; `p.nodes[i].keys[j]` 這種多層鏈式存取。

chain-kind {
    null,
    bool,
    num,
    str,
    arr,
    obj,
}

chain-value {
    kind chain-kind
    str-val str
    num-val f64
    bool-val bool
    children [16]i64
    keys [16]str
    count i64
}

chain-pool {
    nodes [4]chain-value
    count i64
}

; 初始化
chain-pool.init = () {
    .count = 0
    i <- [0..4): {
        .nodes[i]: {
            ok -> {
                it.count = 0
                it.kind = chain-kind.null
                it.str-val = ''
                j <- [0..16): {
                    it.keys[j]: {
                        ok -> it = ''

                        -> _
                    }
                }
            }

            -> _
        }
    }
}

; 配置下一個節點槽並回傳索引，同時把新節點的 count / kind / str-val 重設為初值
; idx: 新節點的索引；池已滿（.count >= 4）時為 -1 且 .count 不變
chain-pool.alloc = () (idx i64) {
    idx = -1
    .count >= 4 -> return
    idx = .count

    #{overflow=wrap}
    .count = .count + 1: {
        ok -> it

        ->
    }
    .nodes[idx].count = 0
    .nodes[idx].kind = chain-kind.null
    .nodes[idx].str-val = ''
}
print('start')
p = chain-pool{}
p.init()

node-idx = 0
key-idx = 0

node-idx = p.alloc()
key-idx = p.alloc()

p.nodes[key-idx].kind = chain-kind.str
p.nodes[key-idx].str-val = 'a'

print('before copy')

cnt = 0
p.nodes[node-idx].keys[cnt] = p.nodes[key-idx].str-val
print('copy ok')

val i64 = p.nodes[node-idx].keys[cnt][0]
print('val=')
print(val)
