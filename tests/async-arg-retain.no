; async-arg-retain.no — spawn 參數的「共享 + 第二引用」(NOLANG-OWNERSHIP-MODEL.md §4.2 b)
;
; 背景：`co f(x)`（`awy` 組內）預設在 spawn 邊界把每個「擁有堆」的參數深拷貝進
; 任務自己的 buffer（P0），讓任務看到 spawn 當下的快照。當 x 在 spawn 之後
; **仍活著**、但呼叫端**可證明從未原位寫入**它時，那份拷貝可以省掉：改成共享
; 同一塊 buffer 再加一個引用（@str_retain / @vec_retain），由任務 wrapper 的
; w_free 還回去。因為 @nolang_free 只在計數歸零時釋放，緩衝區剛好被釋放一次
; ——與呼叫端 drop 的順序無關。
;
; 本檔以 `awy { }` 協程組內的無色 `co f(x)` 書寫：`co` 自動單態出 f-async 並 spawn。
; `co` 只啟動**過程**（無宣告回傳值），所以每個被 spawn 的形態都有一份 `-into`
; 版本——把結果寫進通道再 close，呼叫方在組外用 take-i64 / take-str 讀回。
; 讀回發生在原本「組末 await 取回結果」的同一位置，所以閘門看到的生命週期不變。
;
; ⚠️ 這個檔案只是端到端煙霧測試：共享與深拷貝的**輸出完全相同**（這正是閘門的
; 意義），所以 stdout 分不出兩者。真正的守門員是
;   - src/mir/spawn_arg_retain_test.go：檢查 spawnArgRetains、IR 裡是
;     @vec_retain 還是 vec_clone、以及呼叫端是否仍保留自己的 drop；
;   - 第 3 例（原位寫入）是 §4.2(b) 的快照守門員：閘門若失效會印 99 而不是 1；
;   - 第 4 例（迴圈）若 retain 與 wrapper 的 release 不平衡，會洩漏或 double free。

; 取首個
; v: 來源 vec，由 co spawn 深拷貝後交給協程
; r: v[0]；索引讀取回傳 ?T，以值 match 顯式消費、越界由 nil 臂補零
first = (v []i64) (r i64) {
    r = v[0]: {
        ok -> it

        -> 0
    }
}

; 協程：把輸入字串原樣回傳（驗證 spawn 後父側對同一字串 retain/release 正確）
; s: 來源字串
; r: 與 s 相同的內容
echo = (s str) (r str) {
    r = s
}

; ── 過程形態（`co` 的目標）────────────────────────────────
; out: 結果通道（呼叫方建，容量 1）
; v: 取首元素用的向量
first-into = (out chan[i64], v []i64) {
    out <- first(v)
    out.close()
}

; out: 結果通道（str 版）
; s: 要搬過去的字串
echo-into = (out chan[str], s str) {
    out <- echo(s)
    out.close()
}

; 從單值通道取一筆
; ch: 已關閉的結果通道
; r: 取到的值；一筆都沒有時回 0
take-i64 = (ch chan[i64]) (r i64) {
    r = 0
    <- ch: {
        ok -> r = it

        -> {
        }
    }
}

; ch: 已關閉的結果通道
; r: 取到的字串；一筆都沒有時回空字串
take-str = (ch chan[str]) (r str) {
    r = ''
    <- ch: {
        ok -> r = it

        -> {
        }
    }
}

; 1. vec 參數在 spawn 之後只被「直接索引讀取」、從未被寫 -> 共享（retain）。
test-vec-share = () {
    a = [7, 8, 9]
    ch chan[i64] = with-cap(1)
    awy {
        co first-into(ch, a)
    }
    m = a[1]: {
        ok -> it

        -> 0
    }
    n = take-i64(ch)
    print(n); expect: 7
    print(m); expect: 8
}

; 2. str 參數同理：直接索引讀取 -> 共享。
test-str-share = () {
    s = 'ABC'
    ch chan[str] = with-cap(1)
    awy {
        co echo-into(ch, s)
    }
    c = s[0]
    v = take-str(ch)
    print(v); expect: ABC
    print(c); expect: 65
}

; 3. 原位寫入 -> 必須維持深拷貝，任務看到 spawn 當下的值（1），不是寫入後的 99。
;    閘門若失效（無條件 retain）這一例就會印 99。
test-inplace-keeps-copy = () {
    a = [1, 2, 3]
    ch chan[i64] = with-cap(1)
    awy {
        co first-into(ch, a)
    }
    a[0]: {
        ok -> it = 99

        -> _
    }
    n = take-i64(ch)
    print(n); expect: 1
}

; 4. 迴圈反覆共享：retain 與 wrapper 的 release 若不平衡，這裡會洩漏或 double free。
test-share-loop = () {
    total = 0
    i <- [0..20): {
        a []i64 = [i, i + 1]
        ch chan[i64] = with-cap(1)
        awy {
            co first-into(ch, a)
        }

        {
            m-opt = a[1]: {
                ok -> it

                -> 0
            }
            m-opt: {
                ok -> m = it

                ->
            }
        }

        n = take-i64(ch)

        #{overflow=wrap}
        {

            #{overflow=wrap}
            total-opt = total + n
            total-opt: {
                ok -> total = it

                ->
            }
        }
    }
    print(total); expect: 190
}

test-vec-share()
test-str-share()
test-inplace-keeps-copy()
test-share-loop()
