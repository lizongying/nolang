; async-arg-retain.no — spawn 參數的「共享 + 第二引用」(NOLANG-OWNERSHIP-MODEL.md §4.2 b)
;
; 背景：`run f(x)` 預設在 spawn 邊界把每個「擁有堆」的參數深拷貝進任務自己的
; buffer（P0），讓任務看到 spawn 當下的快照。當 x 在 spawn 之後**仍活著**、
; 但呼叫端**可證明從未原位寫入**它時，那份拷貝可以省掉：改成共享同一塊 buffer
; 再加一個引用（@str_retain / @vec_retain），由任務 wrapper 的 w_free 還回去。
; 因為 @nolang_free 只在計數歸零時釋放，緩衝區剛好被釋放一次——與呼叫端 drop
; 的順序無關。
;
; 本檔以無色 `go` 關鍵字書寫：底下仍 desugar 成 `run`/`awy`，所以 retain 優化
; 與手寫 `run` 完全一致。`co f(x)` 自動單態出 f-async 並 spawn。
;
; ⚠️ 這個檔案只是端到端煙霧測試：共享與深拷貝的**輸出完全相同**（這正是閘門的
; 意義），所以 stdout 分不出兩者。真正的守門員是
;   - src/mir/spawn_arg_retain_test.go：檢查 spawnArgRetains、IR 裡是
;     @vec_retain 還是 vec_clone、以及呼叫端是否仍保留自己的 drop；
;   - 第 3 例（原位寫入）是 §4.2(b) 的快照守門員：閘門若失效會印 99 而不是 1；
;   - 第 4 例（迴圈）若 retain 與 wrapper 的 release 不平衡，會洩漏或 double free。

first = (v []i64) (r i64) {
    #{index-out=zero}
    r = v[0]
}

echo = (s str) (r str) {
    r = s
}

; 1. vec 參數在 spawn 之後只被「直接索引讀取」、從未被寫 -> 共享（retain）。
test-vec-share = () {
    a []i64 = [7, 8, 9]
    n = co first(a)
    m = a[1]
    print(n); expect: 7
    print(m); expect: 8
}

; 2. str 參數同理：直接索引讀取 -> 共享。
test-str-share = () {
    s str = 'ABC'
    v = co echo(s)
    c = s[0]
    print(v); expect: ABC
    print(c); expect: 65
}

; 3. 原位寫入 -> 必須維持深拷貝，任務看到 spawn 當下的值（1），不是寫入後的 99。
;    閘門若失效（無條件 retain）這一例就會印 99。
test-inplace-keeps-copy = () {
    a []i64 = [1, 2, 3]
    n = co first(a)
    a[0] = 99
    print(n); expect: 1
}

; 4. 迴圈反覆共享：retain 與 wrapper 的 release 若不平衡，這裡會洩漏或 double free。
test-share-loop = () {
    total = 0
    i <- [0..20) {
        a []i64 = [i, i + 1]
        n = co first(a)
        m = a[1]
        #{overflow=wrap}
        total = total + n
    }
    print(total); expect: 190
}

test-vec-share()
test-str-share()
test-inplace-keeps-copy()
test-share-loop()
