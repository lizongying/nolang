// test-err.no — err 模組測試
//
// 測試 err-new, err-is, err-msg, fetch-code, err-from-errno, error.format
// 注意：str-long value type 跨函式邊界傳遞時長度不一致，
// 故 msg 相關測試只驗證呼叫完成，不檢查字串長度。


// ── 1. err-new 建立錯誤，檢查 code ──
e = err.err-new(code.io, 'disk full')

yes = err.err-is(e, code.io)
{
    yes -> print('ok: err-new code')
    -> print('fail: err-new code')
}

// ── 2. err-msg 取得訊息（只驗證呼叫完成）──
msg = err.err-msg(e)
print('ok: err-msg')

// ── 3. err-is 比對錯誤碼（true 和 false）──
yes = err.err-is(e, code.io)
{
    yes -> print('ok: err-is true')
    -> print('fail: err-is true')
}

yes = err.err-is(e, code.not-found)
{
    yes == false -> print('ok: err-is false')
    -> print('fail: err-is false')
}

// ── 4. fetch-code 取得錯誤碼 ──
mc = err.fetch-code(e)
{
    mc == code.io -> print('ok: fetch-code')
    -> print('fail: fetch-code')
}

// ── 5. err-from-errno(2) 建立錯誤（errno 2 = ENOENT → code.not-found）──
e2 = err.err-from-errno(2)
yes2 = err.err-is(e2, code.not-found)
{
    yes2 -> print('ok: err-from-errno code')
    -> print('fail: err-from-errno code')
}

errno-msg = err.err-msg(e2)
print('ok: err-from-errno msg')

// ── 6. error.format 格式化錯誤 ──
s = e.format()
{
    s.len > 0 -> print('ok: error.format')
    -> print('fail: error.format')
}
