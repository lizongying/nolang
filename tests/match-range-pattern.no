; match-range-pattern.no — P3: match 臂 range 模式（[a..b)）端到端
;
; 覆盖说明：range 模式 match 在语料中早有 fixture（tests/fmt-heuristic.no 的
; [0..60)/[60..80)/[80..90)、tests/str-order.no 的 [1..10) 与 ["a".."z")），
; 本文件是补强而非补洞——它把 range 模式放进「带回传值的函式」并用 4 个臂
; （含默认臂）覆盖，与上述两文件的用法不同。
; 由 src/parser/dump/hir_subform_coverage_test.go 的 TestS1RangePatternFixtureIsExercised 钉住。

score-of = (score i64) {
    grade = score: {
        [0..60) -> 'low'
        [60..70) -> 'pass'
        [70..100) -> 'high'
        -> 'invalid'
    }
    print(grade)
}

score-of(55)
score-of(65)
score-of(85)
score-of(120)
