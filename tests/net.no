; merged from tests/http2.no
; test-http2 — HTTP/2 影格與連線測試（vet-only，需伺服器才能執行）
; # std/net/http2
...

; 影格標頭解析
test-frame-parse = () {
    space = ' '
    data = space.repeat(16)

    ; 構建一個 HEADERS 影格標頭
    ; length = 10 (0x00000a), type = 1 (HEADERS), flags = 4 (END_HEADERS)
    ; stream-id = 1
    data[0]: {
        ok -> it = 0

        -> _
    }
    data[1]: {
        ok -> it = 0

        -> _
    }
    data[2]: {
        ok -> it = 10

        -> _
    }
    data[3]: {
        ok -> it = 1

        -> _
    }
    data[4]: {
        ok -> it = 4

        -> _
    }
    data[5]: {
        ok -> it = 0

        -> _
    }
    data[6]: {
        ok -> it = 0

        -> _
    }
    data[7]: {
        ok -> it = 0

        -> _
    }
    data[8]: {
        ok -> it = 1

        -> _
    }
    f http2.frame
    np = f.parse(data, 0)
    np == nil -> {
        print('FAIL: parse returned error')
        return
    }
    f.length != 10 -> {
        print('FAIL: expected length=10')
        return
    }
    f.frame-type != 1 -> {
        print('FAIL: expected frame-type=1')
        return
    }
    f.flags != 4 -> {
        print('FAIL: expected flags=4')
        return
    }
    f.stream-id != 1 -> {
        print('FAIL: expected stream-id=1')
        return
    }
    print('PASS: frame-parse')
}

; 影格標頭序列化
test-frame-serialize = () {
    space = ' '
    f http2.frame
    f.length = 10
    f.frame-type = 1
    f.flags = 4
    f.stream-id = 1
    buf = space.repeat(16)
    next = 0
    next = f.serialize(buf, 0)
    next != 9 -> {
        print('FAIL: expected next=9')
        return
    }
    buf[0] != 0 -> {
        print('FAIL: expected buf[0]=0')
        return
    }
    buf[1] != 0 -> {
        print('FAIL: expected buf[1]=0')
        return
    }
    buf[2] != 10 -> {
        print('FAIL: expected buf[2]=10')
        return
    }
    buf[3] != 1 -> {
        print('FAIL: expected buf[3]=1')
        return
    }
    buf[4] != 4 -> {
        print('FAIL: expected buf[4]=4')
        return
    }
    buf[8] != 1 -> {
        print('FAIL: expected buf[8]=1')
        return
    }
    print('PASS: frame-serialize')
}

; 連線初始化
test-conn-init = () {
    conn http2.conn
    conn.init()
    conn.fd != -1 -> {
        print('FAIL: expected fd=-1')
        return
    }
    conn.next-stream-id != 1 -> {
        print('FAIL: expected next-stream-id=1')
        return
    }
    conn.send-window != 65535 -> {
        print('FAIL: expected send-window=65535')
        return
    }
    conn.initialized != true -> {
        print('FAIL: expected initialized=true')
        return
    }
    print('PASS: conn-init')
}

; http2-do-req 函數簽名驗證（vet-only）
test-http2-do-req-signature = () {

    ; 此測試只驗證函數可被正確呼叫，不實際連線
    ; 這行會嘗試連線並失敗，但驗證了函數簽名正確
    resp = http2.do-req('GET', 'http://127.0.0.1:1/test', '')

    ; 預期 nil（連線失敗）
    resp != nil -> {
        print('FAIL: expected connection failure')
        return
    }
    print('PASS: http2-do-req-signature')
}

; http2-get 函數簽名驗證（vet-only）
test-http2-get-signature = () {
    resp = http2.get('http://127.0.0.1:1/test')
    resp != nil -> {
        print('FAIL: expected connection failure')
        return
    }
    print('PASS: http2-get-signature')
}

; http2-post 函數簽名驗證（vet-only）
test-http2-post-signature = () {
    resp = http2.post('http://127.0.0.1:1/test', 'body')
    resp != nil -> {
        print('FAIL: expected connection failure')
        return
    }
    print('PASS: http2-post-signature')
}

; 執行所有測試
test-run-all = () {
    print('=== HTTP/2 Tests ===')
    test-frame-parse()
    test-frame-serialize()
    test-conn-init()
    test-http2-do-req-signature()
    test-http2-get-signature()
    test-http2-post-signature()

    print('=== HTTP/2 Tests Done ===')
}

; merged from tests/tcp-fork.no
; test-tcp-fork — 測試 TCP listen/accept/dial with fork
; # std/net
; # std/process
...

; 基本 TCP fork 測試：父進程 fork 出子進程做 server，父進程當 client 連上並互發訊息
; pass bool: true=父進程從 socket 收到位元組（子進程回的 'hello from server'）；
;           false=listen / fork / dial 任一失敗，或父進程 recv 回 0
; 註：listen 埠固定 9555，失敗時直接 return（pass 保持 false）
test-tcp-fork-basic = () (pass bool) {
    pass = false

    ; 1. 監聽
    listen-fd = net.net-listen('127.0.0.1', 9555)
    listen-fd < 0 -> {
        io.errln('[TEST] tcp: listen failed')
        return
    }
    io.errln('[TEST] tcp: listening on 9555')

    ; 2. fork
    pid = process.process-fork()
    {
        pid < 0 -> {
            io.errln('[TEST] tcp: fork failed')
            fs.close(listen-fd)
            return
        }

        pid == 0 -> {

            ; 子進程: 伺服器
            ...

            io.errln('[TEST] tcp: child accepting')
            client-fd = net.net-accept(listen-fd)
            client-fd < 0 -> {
                io.errln('[TEST] tcp: child accept failed')
                exit(1)
            }
            io.errln('[TEST] tcp: child accepted')

            ; 接收資料
            buf = ' '.repeat(64)
            n = net.net-recv(client-fd, buf, 64)

            io.errln('[TEST] tcp: child recv n=' - n.to-str())

            ; 回應
            net.net-send(client-fd, 'hello from server', 17)
            fs.close(client-fd)
            exit(0)
        }
    }

    ; 父進程: 客戶端
    ...
    time.sleep-ns(100000000)

    io.errln('[TEST] tcp: parent dialing')
    fd = net.net-dial('127.0.0.1', 9555)
    fd < 0 -> {
        io.errln('[TEST] tcp: parent dial failed')
        fs.close(listen-fd)
        process.process-waitpid(pid, 0)
        return
    }
    io.errln('[TEST] tcp: parent connected')

    ; 發送
    net.net-send(fd, 'hello from client', 17)

    ; 接收
    buf = ' '.repeat(64)
    n = net.net-recv(fd, buf, 64)

    io.errln('[TEST] tcp: parent recv n=' - n.to-str())

    n > 0 -> {
        resp = buf.slice(0, n)

        io.errln('[TEST] tcp: parent got=' - resp)
        pass = true
    }
    fs.close(fd)
    fs.close(listen-fd)
    process.process-waitpid(pid, 0)
}

io.errln('=== TCP Fork Tests ===')
p = test-tcp-fork-basic()
{
    p -> print('PASS: tcp-fork-basic')

    p == false -> print('FAIL: tcp-fork-basic')
}
io.errln('=== TCP Fork Tests Done ===')
