; Test 1: Declare and set nil
test-option-1 = () {
    x1 ?str
    x1 = nil
    print(x1)
}

; Test 2: Set value via val()
test-option-2 = () {
    x2 ?str
    x2 = 'hello'
    print(x2)
}

; Test 3: Set error
test-option-3 = () {
    x3 ?str
    x3 = err('error msg')
    print(x3)
}

; Test 4: Match on option with err-> nil-> -> patterns
test-option-4 = () {
    x4 ?str
    x4 = err('error msg')
    x4: {
        err -> print(it)
        nil -> print(0)
        -> print(1)
    }
}

; Test 5: Match on nil
test-option-5 = () {
    x5 ?str
    x5 = nil
    x5: {
        err -> print(100)
        nil -> print(200)
        -> print(300)
    }
}

; Test 6: Match on val
test-option-6 = () {
    x6 ?str
    x6 = 'test'
    x6: {
        err -> print(1000)
        nil -> print(2000)
        -> print(3000)
    }
}

test-option-1()
print(0)
test-option-2()
print(1)
test-option-3()
print(2)
test-option-4()
print(3)
test-option-5()
print(4)
test-option-6()
print(5)
