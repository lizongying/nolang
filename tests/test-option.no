// Test 1: Declare and set nil
test-option-1 = () {
    x ?str
    x = nil
    print(x)
}

// Test 2: Set value via val()
test-option-2 = () {
    x ?str
    x = val('hello')
    print(x)
}

// Test 3: Set error
test-option-3 = () {
    x ?str
    x = err('error msg')
    print(x)
}

// Test 4: Match on option with err-> nil-> -> patterns
test-option-4 = () {
    x ?str
    x = err('error msg')
    x: {
        err ->
            print(.)
        nil ->
            print(0)
        ->
            print(1)
    }
}

// Test 5: Match on nil
test-option-5 = () {
    x ?str
    x = nil
    x: {
        err ->
            print(100)
        nil ->
            print(200)
        ->
            print(300)
    }
}

// Test 6: Match on val
test-option-6 = () {
    x ?str
    x = val('test')
    x: {
        err ->
            print(1000)
        nil ->
            print(2000)
        ->
            print(3000)
    }
}

test-option-1()
print(0)
test-option-2()
print(1)
test-option-3()
print(2)
test-option-4()
print(3)
test-option-5()
print(4)
test-option-6()
print(5)
