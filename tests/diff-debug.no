; diff-debug.no — debug diff engine
; Build: no run tests/diff-debug.no

; diff-op struct
diff-op {
    kind i64
    line str
    a-no i64
    b-no i64
}

; split content into lines
; content str: 要切分的多行文字（以 '\n' 分隔）
; lines []str: 每行一個元素的 vec；末尾行不足換行時也會被 push，空輸入得空 vec
diff-split-lines = (content str) (lines []str) {

    ; #{ascii} 證明此串為純 ASCII：s[i] 由 O(n) 碼點迭代退化為 O(1) 定址
    #{ascii}
    src = content
    eprint('SPLIT: entered, content.len={content.len-bytes()}')
    start = 0
    i <- [0..src.len-bytes()): {
        src[i] == 10 -> {
            lines.push(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len-bytes() -> lines.push(content.slice(start, content.len-bytes()))
    ll = lines.len()
    eprint('SPLIT: done, lines.len={ll}')
}

; dp 表讀：越界給 0
; dp []i64: DP 表
; k i64: 攤平後的索引
; val i64: 該格的值，越界為 0
dp-at = (dp []i64, k i64) (val i64) {
    val = dp[k]: {
        ok -> it

        -> 0
    }
}

; dp 表寫：越界靜默忽略
; dp []i64: DP 表
; k i64: 攤平後的索引
; val i64: 要寫入的值
dp-set = (dp []i64, k i64, val i64) {
    dp[k]: {
        ok -> it = val

        -> _
    }
}

; 取第 k 行，越界給空串
; lines []str: 行表
; k i64: 行號
; line str: 該行內容，越界為空串
line-at = (lines []str, k i64) (line str) {
    line = lines[k]: {
        ok -> it

        -> ''
    }
}

; full LCS-based diff
; a []str: 舊版每一行的 vec
; b []str: 新版每一行的 vec
; ops []diff-op: 最小編輯序列，每項記錄 keep / delete / insert 及對應行號
diff-engine-lcs = (a []str, b []str) (ops []diff-op) {
    na = a.len()
    nb = b.len()

    #{overflow=wrap}
    cols = nb + 1

    #{overflow=wrap}
    total = (na + 1) * cols
    dp []i64 = with-len(total)

    #{overflow=wrap}
    ai <- [na - 1..0]: {

        #{overflow=wrap}
        aj <- [nb - 1..0]: {

            #{overflow=wrap}
            cur = dp-at(dp, ai * cols + aj)

            #{overflow=wrap}
            below = dp-at(dp, (ai + 1) * cols + aj)

            #{overflow=wrap}
            right = dp-at(dp, ai * cols + (aj + 1))
            line-a = line-at(a, ai)
            line-b = line-at(b, aj)
            line-a.compare(line-b) == 0 -> {

                #{overflow=wrap}
                step = dp-at(dp, (ai + 1) * cols + (aj + 1)) + 1
                step: {
                    ok -> cur = it

                    -> _
                }
            }
            below > cur -> cur = below
            right > cur -> cur = right

            #{overflow=wrap}
            dp-set(dp, ai * cols + aj, cur)
        }
    }

    ; Debug: print dp table
    eprint('DEBUG dp table:')
    eprint('  na={na} nb={nb} cols={cols} total={total}')

    #{overflow=wrap}
    ai <- [0..na + 1): {
        row = ''

        #{overflow=wrap}
        aj <- [0..nb + 1): {

            #{overflow=wrap}
            v = dp[ai * cols + aj]: {
                ok -> it

                -> 0
            }

            row = row - ' ' - v.to-str()
        }
        eprint('  {row}')
    }
    i = 0
    j = 0
    (i < na || j < nb) {
        line-a = line-at(a, i)
        line-b = line-at(b, j)
        i < na && j < nb -> {
            line-a.compare(line-b) == 0 -> {
                op = diff-op{}
                op.kind = 0

                tmp-line = a[i]: {
                    ok -> it

                    -> ''
                }
                op.line = tmp-line

                #{overflow=wrap}
                op.a-no = i + 1: {
                    ok -> it

                    ->
                }

                #{overflow=wrap}
                op.b-no = j + 1: {
                    ok -> it

                    ->
                }
                ops.push(op)

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    i-opt = i + 1
                    i-opt: {
                        ok -> i = it

                        ->
                    }
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    j-opt = j + 1
                    j-opt: {
                        ok -> j = it

                        ->
                    }
                }
            }

            #{overflow=wrap}
            down = dp-at(dp, (i + 1) * cols + j)

            #{overflow=wrap}
            across = dp-at(dp, i * cols + (j + 1))
            down >= across -> {
                op = diff-op{}
                op.kind = 1

                tmp-line = a[i]: {
                    ok -> it

                    -> ''
                }
                op.line = tmp-line

                #{overflow=wrap}
                op.a-no = i + 1: {
                    ok -> it

                    ->
                }
                ops.push(op)

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    i-opt2 = i + 1
                    i-opt2: {
                        ok -> i = it

                        ->
                    }
                }
            }

            down < across -> {
                op = diff-op{}
                op.kind = 2

                tmp-line = b[j]: {
                    ok -> it

                    -> ''
                }
                op.line = tmp-line

                #{overflow=wrap}
                op.b-no = j + 1: {
                    ok -> it

                    ->
                }
                ops.push(op)

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    j-opt2 = j + 1
                    j-opt2: {
                        ok -> j = it

                        ->
                    }
                }
            }
        }
        i < na -> {
            op = diff-op{}
            op.kind = 1

            tmp-line = a[i]: {
                ok -> it

                -> ''
            }
            op.line = tmp-line

            #{overflow=wrap}
            op.a-no = i + 1: {
                ok -> it

                ->
            }
            ops.push(op)

            #{overflow=wrap}
            {

                #{overflow=wrap}
                i-opt3 = i + 1
                i-opt3: {
                    ok -> i = it

                    ->
                }
            }
        }
        j < nb -> {
            op = diff-op{}
            op.kind = 2

            tmp-line = b[j]: {
                ok -> it

                -> ''
            }
            op.line = tmp-line

            #{overflow=wrap}
            op.b-no = j + 1: {
                ok -> it

                ->
            }
            ops.push(op)

            #{overflow=wrap}
            {

                #{overflow=wrap}
                j-opt3 = j + 1
                j-opt3: {
                    ok -> j = it

                    ->
                }
            }
        }
    }
}

c1 = 'a
b
c'
c2 = 'a
X
c'

lines1 []str
lines2 []str
lines1 = diff-split-lines(c1)
lines2 = diff-split-lines(c2)

n1 = lines1.len()
n2 = lines2.len()
eprint('lines1.len={n1}')
eprint('lines2.len={n2}')
cl = c1.len-bytes()
eprint('c1.len={cl}')
i <- [0..cl): {
    b = c1[i]
    eprint('  c1[{i}]={b}')
}
i <- [0..n1): {
    s = lines1[i]: {
        ok -> it

        -> ''
    }
    eprint('  L1[{i}]={s}')
}
i <- [0..n2): {
    s = lines2[i]: {
        ok -> it

        -> ''
    }
    eprint('  L2[{i}]={s}')
}
ops []diff-op
ops = diff-engine-lcs(lines1, lines2)

on = ops.len()
eprint('ops.len={on}')
i <- [0..on): {
    op = ops[i]: {
        ok -> it

        -> _
    }
    k = op.kind
    eprint('  op[{i}] kind={k}')
}
