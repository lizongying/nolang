main = () {
    tmp = '/tmp/nolang-fs-test.txt'
    remove(tmp)

    fd-w = open-file(tmp, 577, 384)
    if fd-w < 0 {
        print('fail: open-file write')
        return
    }
    print('ok: open-file write')
    close(fd-w)

    fd-r = open-read(tmp)
    if fd-r < 0 {
        print('fail: open-read')
        return
    }
    print('ok: open-read')
    close(fd-r)

    remove(tmp)
}

main()
