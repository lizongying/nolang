; 第二半后4个测试
test-arr-swap = () {
    a [3] = [1, 2, 3]
    a.swap(0, 2)
    print(a[0])
    print(a[1])
    print(a[2])
}

test-arr-count = () {
    a [5] = [1, 2, 1, 3, 1]
    print(a.count(1))
    print(a.count(99))
}

test-arr-at = () {
    a [3] = [1, 2, 3]
    print(a.at(0))
    print(a.at(5))
    print(a.at(-1))
}

test-arr-to-str = () {
    a [3] = [1, 2, 3]
    print(a.to-str())
}

test-arr-swap()
print('---')
test-arr-count()
print('---')
test-arr-at()
print('---')
test-arr-to-str()
