get-at = (arr [5]i64, i i64) (r i64) {
  r = arr[i]
}
sum-at = (arr [5]i64, i i64, j i64) (r i64) {
  r = arr[i] + arr[j]
}
main = () () {
  a [5]i64 = [10, 20, 30, 40, 50]
  print(a[0])
  print(a[2])
  print(a[4])
  print(get-at(a, 1))
  print(get-at(a, 3))
  print(sum-at(a, 0, 4))
  print(sum-at(a, 1, 3))
  s = 'hello, nolang'
  print(s[0])
  print(s[7])
  v [3]i64 = [1, 2, 3]
  print(v[v[0] - 1])
  acc = 0
  for i in [0, 1, 2, 3, 4] {
    acc = acc + a[i]
  }
  print(acc)
}
main()
