; format('a=' - '{x}') —— 具名格式字串的編譯期折疊
;
; 具名格式（`print('{x}')` / `format('{x}')`）的攔截只認**單一字串字面量**，
; 因為欄位是原始碼文字，到 codegen 階段已經不存在。所以把 '{x}' 拿去跟別的
; 字面量 `-` 串接（`format('a=' - '{x}')`）時，攔截看不到完整格式串，'{x}'
; 落在 KStrLit  lowering、且 inPrintArgs > 0 —— 舊行為是硬錯誤：
;     interp: string interpolation not lowered: {x}
;
; 但 `-`（以及 `+`）在 Nolang 是字串串接，兩邊都是字面量時 ` 'a=' - '{x}' `
; **就是**常數 ` 'a={x}' `。本檔釘住這個折疊：字面量串成的格式串必須先合併，
; 再做欄位替換，而不是報錯。
;
; ⚠️ 只折疊「每一部分都是字面量」的串接。摻了執行期值的寫法
;    （`print('a=' - '{x}' - name)`）不是常數，無法在編譯期替換欄位，
;    仍然必須保留「interpolation not lowered」這個錯誤——直接把大括號印出去
;    是靜默的錯。反向保護見 src/mir/str_concat_fold_test.go。

main = () {

    x = 42

    ; ─────────────────────────────────────────────
    ; 1. 兩段字面量折疊後替換
    ; ─────────────────────────────────────────────
    a = format('a=' - '{x}')
    (a == 'a=42') -> print('PASS: 1a format literal concat folds')
    -> print('FAIL: 1a a=[' - a - ']')

    ; ─────────────────────────────────────────────
    ; 2. 三段鏈（`-` 左結合，整條鏈都是常數）
    ; ─────────────────────────────────────────────
    b = format('a=' - '{x}' - '!')
    (b == 'a=42!') -> print('PASS: 2 format literal chain folds')
    -> print('FAIL: 2 b=[' - b - ']')

    ; ─────────────────────────────────────────────
    ; 3. `+` 也是字串串接，必須一樣折疊
    ; ─────────────────────────────────────────────
    c = format('a=' + '{x}')
    (c == 'a=42') -> print('PASS: 3 plus concat folds')
    -> print('FAIL: 3 c=[' - c - ']')

    ; ─────────────────────────────────────────────
    ; 4. 括號子運算式（KGrouped）也要穿透
    ; ─────────────────────────────────────────────
    d = format('[' - ('a=' - '{x}') - ']')
    (d == '[a=42]') -> print('PASS: 4 grouped concat folds')
    -> print('FAIL: 4 d=[' - d - ']')

    ; ─────────────────────────────────────────────
    ; 5. 折疊後的 {{ }} 轉義仍然保留字面大括號
    ; ─────────────────────────────────────────────
    e = format('{{' - '{x}' - '}}')
    (e == '{42}') -> print('PASS: 5 brace escaping survives the fold')
    -> print('FAIL: 5 e=[' - e - ']')

    ; ─────────────────────────────────────────────
    ; 6. print 家族共用同一個攔截點：折疊後直接輸出
    ;    （golden 指紋把關：這一行必須是 `p=42`）
    ; ─────────────────────────────────────────────
    print('p=' - '{x}')

    ; ─────────────────────────────────────────────
    ; 7. 對照組：純字面量串接本來就能用，折疊不能改變結果
    ; ─────────────────────────────────────────────
    g = 'ab' - 'cd'
    (g == 'abcd') -> print('PASS: 7 plain literal concat unchanged')
    -> print('FAIL: 7 g=[' - g - ']')

    ; ─────────────────────────────────────────────
    ; 8. 對照組：含執行期值的串接不是常數，不能折疊
    ; ─────────────────────────────────────────────
    name = 'bob'
    h = 'hi ' - name
    (h == 'hi bob') -> print('PASS: 8 runtime concat unchanged')
    -> print('FAIL: 8 h=[' - h - ']')

    ; ─────────────────────────────────────────────
    ; 9. 反向保護：兩段「普通文字」拼起來剛好長得像格式串時，不可被當成插值。
    ;    `'{' - 'x}'` 合併後是 `{x}`，但作者寫的是兩段字面文字，
    ;    必須照字面印出（這是拼 JSON 常見的寫法）。
    ;    golden 指紋把關：這一行必須是 `{x}`。
    ; ─────────────────────────────────────────────
    print('{' - 'x}')
    j = '{' - '"k": 1}'
    (j == '{"k": 1}') -> print('PASS: 9 brace-shaped join stays verbatim')
    -> print('FAIL: 9 j=[' - j - ']')

    ; ─────────────────────────────────────────────
    ; 10. `str * n` 是重複，不是串接 —— 不可折疊
    ; ─────────────────────────────────────────────
    k = 'ab' * 3
    (k == 'ababab') -> print('PASS: 10 repeat not folded')
    -> print('FAIL: 9 k=[' - k - ']')
}
main()
