; merged category 'option' -- 2 source files
; sources: opt-box-drop.no, option-capture.no
; originals recoverable from git HEAD (ed7b5236)

; merged from tests/opt-box-drop.no
; test-opt-box-drop — ?T 的裝箱載荷（以及載荷內容）必須被释放
;
; 為什麼需要這個測試：統一 32 字節 %option 布局下，放不進 slot 的載荷由 codegen
; malloc 裝箱。2026-09-21 之前 `?T` 從不被認作 owned（ClassifyOwnership 不把結構體
; 算作 owned），於是 insertDrops 不給 option 插 drop —— 裝箱載荷**永不释放**，
; 而且 optBoxClone 每次 option 拷貝還會再 malloc 一塊。
;
; 修法見 docs/MIR_DESIGN.md §4.1.2：
;   - Module.OptionOwnsHeap 把「載荷本身 owned」與「載荷必須堆裝箱」都算作擁有堆；
;   - @__nolang_opt_drop_<payload> 按 tag 释放載荷內容與箱子（tag 1 = nil 不動；
;     默認 slot 下 err 消息內聯，其前 8 字節是字符串長度而非箱子指針，所以 tag
;     守衛必須留着）；
;   - 載荷內容是否共享交給 insertDrops 既有的 liveness 規则（optionCopySharesHeap）：
;     源還活着 -> OpClone 深拷進 option；源已死 -> 按位 move（所有權轉移）；
;   - 剥殼（x = opt）**不消耗** option，所以剥出來的值必須自己擁有一份內存
;     （§4.3）：?str -> @str_clone、?[]T -> vecDeepClone，以及 err 臂的 it
;     （類型雙關出來的 %str-long）同樣要 @str_clone —— 否则 option 與 it 共用
;     同一條消息 buffer，兩邊各释放一次。
;
; 本測試是行為 + 內存雙重回歸：末尾兩個大循环若重新開始泄漏，RSS 會明顯上漲
; （修前 20 万次約 104 MB，修後約 1.7 MB）。
;
; 注意：每個小節刻意用自己的一套變量。同一 option 上再叠一次 option->option
; 拷貝會触發一個**既有的** match 讀取異常（與本次改動無關：HEAD 與修後输出
; 完全一致，見 §4.1.2 末注），所以不把它寫進本回歸測試的期望里。
...

print('=== opt box drop ===')

; big 是 24 + 32 = 56 字節 > 默認阈值 24 -> 裝箱，且帶一個 owned 的 str 叶子
big {
    name str
    pad [4]i64
}

; person 正好 24 字節 -> 內聯，不裝箱
person {
    name str
}

print('--- boxed payload round-trip ---')
b big
b.name = 'hello world'
b.pad[0] = 7
o ?big = b
o: {
    err -> {
        print('err')
    }

    nil -> {
        print('nil')
    }

    -> {
        print(it.name)
        print(it.pad[0])
    }
}

; 源在 wrap 之後仍被讀取 -> 必須是深拷，兩邊各自擁有自己的 name
print(b.name)

print('--- option -> option copy, both sides live ---')
sb big
sb.name = 'copy me'
o1 ?big = sb
q1 = o1
print(q1.name)
print(o1.name)

print('--- inline payload (?person 不装箱) ---')
p person
p.name = 'inline'
ip ?person = p
ip: {
    err -> {
        print('err')
    }

    nil -> {
        print('nil')
    }

    -> {
        print(it.name)
    }
}
print(p.name)

print('--- wrap into an already-bound option (EmitMoveInto shape) ---')
c big
c.name = 'first'
w ?big
w = c
w: {
    err -> {
        print('err')
    }

    nil -> {
        print('nil')
    }

    -> {
        print(it.name)
    }
}

print('--- err message in a narrow option ---')
e ?i64 = err('boom')
e: {
    err -> {
        print('got err')
    }

    nil -> {
        print('nil')
    }

    -> {
        print(it)
    }
}

print('--- 200000 boxed wraps in a loop (leak / double-free stress) ---')
t = 0
j <- [0..200000): {
    bb big
    bb.name = 'loop'
    bb.pad[0] = 3
    v ?big = bb
    v: {
        err -> {
            t = t
        }

        nil -> {
            t = t
        }

        -> {
            t = it.pad[0]
        }
    }
}
print(t)

print('--- 50000 boxed option -> option copies ---')
s2 big
s2.name = 'seed'
o2 ?big = s2
u = 0
k <- [0..50000): {
    q2 ?big = o2
    q2: {
        err -> {
            u = u
        }

        nil -> {
            u = u
        }

        -> {
            u = it.pad[0]
        }
    }
}
print(u)
print(o2.name)

print('--- err arm of a std call: it must own its own message ---')

; json.parse('') 返回 err，調用方 match 到 err 臂。剥出來的 it 是 option 載荷的
; 按位副本，而 option 自己仍然要 drop —— 修前兩者共用同一條消息 buffer：drop it
; 释放一次、option 的 drop 再释放一次 -> trace/BPT trap。這不是邊角情形：
; 任何返回 err(...) 的 std 調用只要被 match 到 err 臂就會踩到
; （tests/mem-safety/json-parse-option.no 與 tests/sse.no 就是這麼掛的）。
; 見 docs/MIR_DESIGN.md §4.3。
j1 = json.parse('')
j1: {
    ok -> {
        print('fail: expected err')
    }

    nil -> {
        print('fail: expected err')
    }

    err -> {
        print(it)
    }
}

print('--- err arm without reading it ---')
j2 = json.parse('')
j2: {
    ok -> {
        print('fail: expected err')
    }

    nil -> {
        print('fail: expected err')
    }

    err -> {
        print('err arm')
    }
}

print('=== done ===')

; merged from tests/option-capture.no
; 回歸測試：「Option 捕獲賦值」（`=` 就地捕獲錯誤，見 docs/docs/lang/syntax.md）。
;
; 語意：`a = expr` 中 expr 含可錯源（`/` `%`、安全索引、option 運算元）時，a 自動
; 推斷為 `?T`，nil/err 就地存進 a、流程繼續，之後用 `a: { ok -> ... }` 消費。
; 純算術（`+ - * <<` 取負）本身不是可錯源，但在 option 路徑上帶運行期溢出檢查。
...

; 1. 內部除零捕獲：`a = b + c / d`
...

; 缺陷修正：以前 `a ?i64 = b + c / d` 會把 c/d 的 payload 無條件解包再包 ok，
; 除零得到錯誤數值、錯誤完全遺失。現在 c/d 被就地捕獲成 __cap_N。
; b: 加法左運算元
; c: 被除數
; d: 除數（0 時 c/d 被就地捕獲成 err）
div-capture = (b i64, c i64, d i64) {

    #{overflow=wrap}
    a = b + c / d
    a: {
        err -> print('div-capture: err')

        nil -> print('div-capture: nil')

        -> print('div-capture: ok')
    }
}

; 2. 越界捕獲：`a = v[100]` → nil
...

; 安全索引的捕獲以「所在函式有 option 結果參數」為閘門（鏡像被取代的
; maybeAutoPropagateIndex 的既有範圍）。
; i: 下標（容器只有 3 個元素，100 越界得到 nil）
; res: 把捕獲後的 x 上拋給呼叫方
oob-capture = (i i64) (res ?i64) {
    a = [10, 20, 30]
    x = a[i]
    x: {
        err -> print('oob: err')

        nil -> print('oob: nil')

        -> print('oob: ok')
    }
    res = x
}

; 3. 溢出捕獲：option 包裝路徑上的 sadd/ssub/smul/neg
...

; 顯式 `?T` 標註讓算術結果落在 option 包裝路徑，溢出 → err（而非靜默回繞）。
; x: 要加 1 的數值（i64.MAX 觸發溢出）
overflow-add = (x i64) {
    a ?i64 = x + 1
    a: {
        err -> print('ovf-add: err')

        nil -> print('ovf-add: nil')

        -> print('ovf-add: ok')
    }
}

; 乘法溢出捕獲：x * 2 落在 option 包裝路徑上，x = i64.MAX 時得 err 而非回繞
; x: 要乘 2 的數值（1 走 ok、i64.MAX 觸發溢出）
overflow-mul = (x i64) {
    a ?i64 = x * 2
    a: {
        err -> print('ovf-mul: err')

        nil -> print('ovf-mul: nil')

        -> print('ovf-mul: ok')
    }
}

; 取負溢出捕獲：-x 同樣走 option 包裝路徑，溢出則得 err
; x: 要取負的數值（本檔只傳 1，驗證 ok 分支）
overflow-neg = (x i64) {
    a ?i64 = -x
    a: {
        err -> print('ovf-neg: err')

        nil -> print('ovf-neg: nil')

        -> print('ovf-neg: ok')
    }
}

; 4. option 函式內 `?=` 仍上拋；plain 函式內捕獲；`_ =` 捨棄
...

; `out ?= c / d`：上拋語義（要求函式有 option 結果參數），nil/err 提前 return。
; c: 被除數
; d: 除數（0 時產生除零 err 並提前 return）
; out: 成功時為 c/d 的 ok 值；失敗保留 err 或 nil
propagate = (c i64, d i64) (out ?i64) {
    out = nil
    out ?= c / d
}

; 用 `_ =` 捨棄可錯結果：除零不得中斷流程，後續語句照常執行
; b: 被除數
; c: 除數（本檔傳 0，錯誤被丟棄）
discard = (b i64, c i64) {
    _ = b / c
    print('discard: no-error')
}

print('-- div-capture --')
div-capture(1, 6, 2)
div-capture(1, 6, 0)

print('-- oob-capture --')
oob-capture(1)
oob-capture(100)

print('-- overflow --')
overflow-add(1)
overflow-add(9223372036854775807)
overflow-mul(1)
overflow-mul(9223372036854775807)
overflow-neg(1)

print('-- propagate --')
p1 = propagate(6, 2)
p1: {
    err -> print('prop: err')

    nil -> print('prop: nil')

    -> print('prop: ok')
}
p2 = propagate(6, 0)
p2: {
    err -> print('prop: err')

    nil -> print('prop: nil')

    -> print('prop: ok')
}

print('-- discard --')
discard(1, 0)
