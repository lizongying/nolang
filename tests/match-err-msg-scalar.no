; match-err-msg-scalar.no — 標量 option 的 err 臂必須能讀到完整的錯誤訊息
;
; 回歸：`option { ok(v t), nil, err(e str) }` 的 err 載荷**永遠是 str**，但舊的
; 扁平佈局 `%option = { i64 tag, i64 data }` 的載荷槽只有 8 字節，塞不下 24 字節的
; %str-long。當時 `err('msg')` 只能把字串的 data 指標塞進去，len/cap 全丟：
;   - err 臂讀 `it` 會拿到整顆 option（型別是 i64/bool），任何 str 用法都產生
;     LLVM 拒收的 IR（「defined with type 'i1' but expected '%str-long'」）；
;   - 就算硬讀，印出來也是一個整數（例如 `err=4385955280`），不是訊息。
;
; 統一佈局 `%option = { i64 tag, [3 x i64] slot }`（24 字節載荷槽，err 一律 inline）
; 讓訊息放得下；搭配 hir2mir 對標量 option 也做 err 載荷 peel，`it` 現在就是訊息。
;
; 註：err 臂的合成綁定帶 `t=err` 這個**變體標記**（不是真型別）。checker 會把它正規化成
; `str`（err 載荷永遠是 str），所以 `msg = it` 可以直接指派；否則會誤報
; 「cannot assign err value to str variable」。

check-str = (name str, got str, want str) {
    got == want -> print('ok: ' - name)

    -> print('fail: ' - name - ' got=[' - got - '] want=[' - want - ']')
}

fail-i64 = () (out ?i64) {
    out = err('boom-i64')
}

fail-bool = () (out ?bool) {
    out = err('boom-bool')
}

fail-str = () (out ?str) {
    out = err('boom-str')
}

main = () {
    ; 1. ?i64：err 臂的 it 是訊息，不是整數也不是整顆 option
    a ?i64 = fail-i64()
    got1 = ''
    a: {
        err -> got1 = it

        nil -> got1 = 'nil'

        -> got1 = 'val=' - it.to-str()
    }
    check-str('?i64 err message', got1, 'boom-i64')

    ; 2. ?bool：同上（bool 的載荷只有 1 位元，最能逼出這個 bug）
    b ?bool = fail-bool()
    got2 = ''
    b: {
        err -> got2 = it

        nil -> got2 = 'nil'

        -> got2 = 'val=' - it.to-str()
    }
    check-str('?bool err message', got2, 'boom-bool')

    ; 3. 對照組：?str 本來就讀得到（非純量載荷槽塞得下）
    c ?str = fail-str()
    got3 = ''
    c: {
        err -> got3 = it

        nil -> got3 = 'nil'

        -> got3 = 'val=' - it
    }
    check-str('?str err message', got3, 'boom-str')

    ; 4. 訊息必須完整（len 正確），不能被截斷成前幾個字節
    d ?i64 = fail-i64()
    got4 = ''
    d: {
        err -> got4 = 'len=' - it.len().to-str()

        nil -> got4 = 'nil'

        -> got4 = 'val'
    }
    check-str('?i64 err message len', got4, 'len=8')

    ; 5. 對照組：ok 臂的 it 仍然是原本的純量值（不能被 err 的處理邏輯污染）
    e ?i64 = 42
    got5 = ''
    e: {
        err -> got5 = 'err'

        nil -> got5 = 'nil'

        -> got5 = it.to-str()
    }
    check-str('?i64 ok payload', got5, '42')

    ; 6. 對照組：nil 臂
    f ?i64 = nil
    got6 = ''
    f: {
        err -> got6 = 'err'

        nil -> got6 = 'nil'

        -> got6 = 'val=' - it.to-str()
    }
    check-str('?i64 nil', got6, 'nil')
}
