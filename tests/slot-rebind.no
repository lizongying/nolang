; test-slot-rebind: 栈类型 move 的 can_slot_rebind 约束验证
; 覆盖：i64/u64/i128/u128/txt 的栈槽重绑定（rebind）、
;      降级为完整 copy（源后续被引用）、目标重新赋值后别名失效、
;      参数 move（源是参数 → 禁用重绑定）、consume 传参。
; 期望输出（每行一个）:
; 42 7 1 1 17 5 5 10 100 99 84

; 源是函式參數：禁用棧槽重綁定，必須降級成完整 copy，回傳 100 不受後續影響
; val i64: 來源參數（唯讀）
; ret i64: 與 val 相同的值
pm_fn = (val i64) (ret i64) {
    local = val; val 是参数 → 禁用重绑定 → 降级 copy
    ret = local
}

; 重綁後又對目標重新賦值：舊別名必須失效，ret 回傳 99（不是先前的 1）
; ret i64: 重新賦值後的值 99
rr_fn = () (ret i64) {
    a = 1
    b = a; rebind b->a（a 后续无引用）
    b = 99; 重新赋值目标，旧别名失效
    ret = b
}

; 傳參消費：用 x + 42 驗證重綁後的 m 值仍完整（42 + 42 = 84）
; x i64: 傳入的數值
; ret i64: x + 42（#{overflow=wrap}）
consume = (x i64) (ret i64) {

    #{overflow=wrap}
    ret = x + 42
}

; 1. i64 栈槽重绑定
n = 42
m = n
print(m); 42

; 2. u64 栈槽重绑定
wu u64 = 7
v = wu
print(v); 7

; 3. i128 栈槽重绑定 → 比较验证值正确
pi i128 = 123
qi = pi
ri i128 = 123
x1 = qi == ri ? 1 : 0
print(x1); 1

; 4. u128 栈槽重绑定 → 比较验证值正确
ps u128 = 456
qs = ps
rs u128 = 456
x2 = qs == rs ? 1 : 0
print(x2); 1

; 5. txt 栈槽重绑定 → .len() 验证
tx txt = 'hello-slot-rebind'
tx2 = tx
print(tx2.len-bytes()); 17

; 6/7. 降级为完整 copy：源后续被引用 → 不可重绑定
da = 5
db = da; da 后续被引用（dc = da）→ copy
dc = da
a2 = db
c = db
print(a2); 5
print(c); 5

; 8. 重绑定后目标被重新赋值（别名必须失效）
ra_a = 10
ra_b = ra_a; rebind ra_b->ra_a
ra = ra_b; ra = 10
ra_b = 5; 重新赋值目标，别名失效，ra 不受影响
print(ra); 10

; 9. 参数 move：源是参数 → 禁用重绑定 → 降级 copy
pm = pm_fn(100)
print(pm); 100

; 10. 重绑定后重新赋值（rebind-reassign）
rr = rr_fn()
print(rr); 99

; 11. consume(m)：m 经重绑定后传参正确
cm = consume(m)
print(cm); 84
