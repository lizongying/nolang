; test-x25519-alice-only — 只測試 Alice 的公鑰
; # std/crypto/x25519

; 將 hex 字串轉為 [32]byte
; hex-str str: 64 字元 hex 字串（每 2 字元一個位元組）
; out [32]byte: 解析出的 32 位元組
hex-to-bytes = (hex-str str) (out [32]byte) {

    ; #{ascii} 證明此 hex 串為純 ASCII：s[i] 由 O(n) 碼點迭代退化為 O(1) 定址
    #{ascii}
    hex-src = hex-str
    i <- [0..32): {

        #{overflow=wrap}
        hi char = hex-src[i * 2]

        #{overflow=wrap}
        lo char = hex-src[i * 2 + 1]
        hi-v = 0
        lo-v = 0
        {
            hi >= 48 && hi <= 57 -> {
                hi-v = hi - 48
            }

            hi >= 97 && hi <= 102 -> {
                hi-v = hi - 87
            }

            hi >= 65 && hi <= 70 -> {
                hi-v = hi - 55
            }
        }
        {
            lo >= 48 && lo <= 57 -> {
                lo-v = lo - 48
            }

            lo >= 97 && lo <= 102 -> {
                lo-v = lo - 87
            }

            lo >= 65 && lo <= 70 -> {
                lo-v = lo - 55
            }
        }
        out[i] = (hi-v << 4) | lo-v
    }
}

; 比較兩個 [32]byte 是否相等
; a [32]byte: 第一個緩衝區（例如預期值）
; b [32]byte: 第二個緩衝區（例如實算結果）
; eq bool: 32 個位元組全部相同才為 true（遇差異立即 break）
bytes-eq = (a [32]byte, b [32]byte) (eq bool) {
    eq = true
    i <- [0..32): {
        a[i] != b[i] -> {
            eq = false
            break
        }
    }
}

; Alice private: 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
; Alice public:  8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a

alice-priv = hex-to-bytes('77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a')

eprint('alice-priv: ')
i <- [0..32): {
    eprint(alice-priv[i])
    eprint(' ')
}
alice-pub = x25519.x25519-scalarmult-base(alice-priv)

eprint('alice-pub: ')
i <- [0..32): {
    eprint(alice-pub[i])
    eprint(' ')
}
alice-pub-expected = hex-to-bytes('8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a')

ok = bytes-eq(alice-pub, alice-pub-expected)
{
    ok == true -> print('PASS: Alice only')

    ok == false -> {
        print('FAIL: Alice only')
        eprint('expected: ')
        i <- [0..32): {
            eprint(alice-pub-expected[i])
            eprint(' ')
        }
    }
}
