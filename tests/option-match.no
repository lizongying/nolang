; option-match.no — 測試 option 變數的 match 語法
;
; match 語法（每個臂獨立一行）：
;     n: { err -> body
;          nil -> body
;          -> body }
; 其中 err/nil 為 option 分支，-> 為預設（ok/val）分支

; 測試 err
test-err = () {
    n ?str
    n = err('boom')
    r = ''
    n: {
        err -> r = 'got-err'

        nil -> r = 'got-nil'

        -> r = 'got-val'
    }
    print(r)
}

; 測試 nil
test-nil = () {
    n ?str
    n = nil
    r = ''
    n: {
        err -> r = 'got-err'

        nil -> r = 'got-nil'

        -> r = 'got-val'
    }
    print(r)
}

; 測試 val
test-val = () {
    n ?i64
    n = 42
    r = ''
    n: {
        err -> r = 'got-err'

        nil -> r = 'got-nil'

        -> r = 'got-val'
    }
    print(r)
}

; 測試 err-only
test-err-only = () {
    n ?str
    n = err('boom')
    r = ''
    n: {
        err -> r = 'only-err'

        -> r = 'otherwise'
    }
    print(r)
}
test-err()
test-nil()
test-val()
test-err-only()
