; test-aes-vectors.no — AES 已知答案測試（NIST SP 800-38A / GCM 測試向量）
;
; 預期輸出見 tests/golden/aes-vectors.expected.txt，由 tmp/gen_aes_kat.py 產生。

g-aad-empty []byte = with-len(0)

dump = (label str, b []byte) {
    s str = format('{label}=')
    i <- [0..b.len()): {
        s = s + format('{b[i]:02x}')
    }
    print(s)
}

dump16 = (label str, b [16]byte) {
    s str = format('{label}=')
    i <- [0..16): {
        s = s + format('{b[i]:02x}')
    }
    print(s)
}

ecb-pt [16]byte = [
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb,
    0xcc, 0xdd, 0xee, 0xff,
]
ecb-k128 [16]byte = [
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b,
    0x0c, 0x0d, 0x0e, 0x0f,
]
ecb-k256 [32]byte = [
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b,
    0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
    0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
]

o [16]byte
o = aes.enc-128(ecb-pt, ecb-k128)
dump16('ecb128', o)
o = aes.dec-128(o, ecb-k128)
dump16('ecb128back', o)
o = aes.enc-256(ecb-pt, ecb-k256)
dump16('ecb256', o)
o = aes.dec-256(o, ecb-k256)
dump16('ecb256back', o)

cbc-pt [48]byte = [
    0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96, 0xe9, 0x3d, 0x7e, 0x11,
    0x73, 0x93, 0x17, 0x2a, 0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c,
    0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51, 0x30, 0xc8, 0x1c, 0x46,
    0xa3, 0x5c, 0xe4, 0x11, 0xe5, 0xfb, 0xc1, 0x19, 0x1a, 0x0a, 0x52, 0xef,
]
cbc-iv [16]byte = [
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b,
    0x0c, 0x0d, 0x0e, 0x0f,
]
cbc-k128 [16]byte = [
    0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6, 0xab, 0xf7, 0x15, 0x88,
    0x09, 0xcf, 0x4f, 0x3c,
]
cbc-k256 [32]byte = [
    0x60, 0x3d, 0xeb, 0x10, 0x15, 0xca, 0x71, 0xbe, 0x2b, 0x73, 0xae, 0xf0,
    0x85, 0x7d, 0x77, 0x81, 0x1f, 0x35, 0x2c, 0x07, 0x3b, 0x61, 0x08, 0xd7,
    0x2d, 0x98, 0x10, 0xa3, 0x09, 0x14, 0xdf, 0xf4,
]

ct []byte
ct = aes-cbc.enc-128(cbc-pt, cbc-k128, cbc-iv)
dump('cbc128enc', ct)
pt []byte
pt = aes-cbc.dec-128(ct, cbc-k128, cbc-iv)
dump('cbc128dec', pt)
ct = aes-cbc.enc-256(cbc-pt, cbc-k256, cbc-iv)
dump('cbc256enc', ct)
pt = aes-cbc.dec-256(ct, cbc-k256, cbc-iv)
dump('cbc256dec', pt)

ctr-iv [16]byte = [
    0xf0, 0xf1, 0xf2, 0xf3, 0xf4, 0xf5, 0xf6, 0xf7, 0xf8, 0xf9, 0xfa, 0xfb,
    0xfc, 0xfd, 0xfe, 0xff,
]
ct = aes-ctr.crypt-128(cbc-pt, cbc-k128, ctr-iv)
dump('ctr128', ct)
pt = aes-ctr.crypt-128(ct, cbc-k128, ctr-iv)
dump('ctr128back', pt)
ct = aes-ctr.crypt-256(cbc-pt, cbc-k256, ctr-iv)
dump('ctr256', ct)
pt = aes-ctr.crypt-256(ct, cbc-k256, ctr-iv)
dump('ctr256back', pt)

g-zero-key [16]byte = [
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00,
]
g-zero-iv [12]byte = [
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
]
g-zero-pt [16]byte = [
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00,
]
g-k3 [16]byte = [
    0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c, 0x6d, 0x6a, 0x8f, 0x94,
    0x67, 0x30, 0x83, 0x08,
]
g-k15 [32]byte = [
    0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c, 0x6d, 0x6a, 0x8f, 0x94,
    0x67, 0x30, 0x83, 0x08, 0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c,
    0x6d, 0x6a, 0x8f, 0x94, 0x67, 0x30, 0x83, 0x08,
]
g-iv3 [12]byte = [
    0xca, 0xfe, 0xba, 0xbe, 0xfa, 0xce, 0xdb, 0xad, 0xde, 0xca, 0xf8, 0x88,
]
g-aad3 [20]byte = [
    0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef, 0xfe, 0xed, 0xfa, 0xce,
    0xde, 0xad, 0xbe, 0xef, 0xab, 0xad, 0xda, 0xd2,
]
g-p3 [60]byte = [
    0xd9, 0x31, 0x32, 0x25, 0xf8, 0x84, 0x06, 0xe5, 0xa5, 0x59, 0x09, 0xc5,
    0xaf, 0xf5, 0x26, 0x9a, 0x86, 0xa7, 0xa9, 0x53, 0x15, 0x34, 0xf7, 0xda,
    0x2e, 0x4c, 0x30, 0x3d, 0x8a, 0x31, 0x8a, 0x72, 0x1c, 0x3c, 0x0c, 0x95,
    0x95, 0x68, 0x09, 0x53, 0x2f, 0xcf, 0x0e, 0x24, 0x49, 0xa6, 0xb5, 0x25,
    0xb1, 0x6a, 0xed, 0xf5, 0xaa, 0x0d, 0xe6, 0x57, 0xba, 0x63, 0x7b, 0x39,
]

sealed []byte
sealed = aes-gcm.seal-128(g-zero-key, g-zero-iv, g-aad-empty, g-zero-pt)
dump('gcm128c2', sealed)
pt = aes-gcm.open-128(g-zero-key, g-zero-iv, g-aad-empty, sealed)
dump('gcm128c2open', pt)

sealed = aes-gcm.seal-128(g-k3, g-iv3, g-aad3, g-p3)
dump('gcm128c3', sealed)
pt = aes-gcm.open-128(g-k3, g-iv3, g-aad3, sealed)
dump('gcm128c3open', pt)

sealed = aes-gcm.seal-256(g-k15, g-iv3, g-aad3, g-p3)
dump('gcm256c15', sealed)
pt = aes-gcm.open-256(g-k15, g-iv3, g-aad3, sealed)
dump('gcm256c15open', pt)

; 認證失敗應回傳長度 0
bad []byte = with-len(sealed.len())
i <- [0..sealed.len()): {
    bad[i] = sealed[i]
}
bad[0] = bad[0] ^ 1
pt = aes-gcm.open-256(g-k15, g-iv3, g-aad3, bad)
print('gcm256tamper={pt.len()}')

