; async-group.no — 協程組（coroutine group）：裸 `{ ... }` 塊內用 `go` 呼叫無色函式，
; 默認 spawn，有依賴則退化成 await。底層仍是染色的 `-async` 無棧協程。
; `co f(x)` 自動單態化出 f-async 並 spawn。

hello = (i i64) (r i64) {
    r = i
}

; 1. 無依賴：兩個 go 都先發出，再一起 await
test-independent = () {
    r1 i64
    r2 i64
    {
        r1 = co hello(1)
        r2 = co hello(2)
    }
    print(r1); expect: 1
    print(r2); expect: 2
}

; 2. 有依賴：r2 讀 r1，不能並發，退化成 await 後順序執行
test-dependent = () {
    r1 i64
    r2 i64
    {
        r1 = co hello(1)
        r2 = co hello(r1)
    }
    print(r1); expect: 1
    print(r2); expect: 1
}

; 3. 傳遞依賴：r3 讀 r2、r2 讀 r1，整條鏈順序執行
test-chain = () {
    r1 i64
    r2 i64
    r3 i64
    {
        r1 = co hello(1)
        r2 = co hello(r1)
        r3 = co hello(r2)
    }
    print(r3); expect: 1
}

; 4. 組內讀取結果：print(r1) 是屏障，r1 必須先落地，否則讀到的是句柄而非值
test-read-inside = () {
    r1 i64
    {
        r1 = co hello(7)
        print(r1); expect: 7
    }
}

; 5. 丟棄結果的 go 仍然要 await，否則任務的參數緩衝區會洩漏
side = (n i64) {
    print(n); expect: 5
}
test-discarded = () {
    {
        co side(5)
    }
}

; 6. 堆擁有參數：spawn 時深拷貝進任務自己的緩衝區
echo = (s str) (r str) {
    r = s
}
test-heap-arg = () {
    a str = 'hello'
    b str = 'world'
    ra str
    rb str
    {
        ra = co echo(a)
        rb = co echo(b)
    }
    print(ra); expect: hello
    print(rb); expect: world
}

; 7. 語句級 go（協程組之外）：每個 go 即 spawn + 立即 await，順序執行。
;    與協程組內的並發 spawn 不同，這裡不會與其他任務重疊。
test-statement-level = () {
    f = co hello(1)
    print(f); expect: 1
}

test-independent()
test-dependent()
test-chain()
test-read-inside()
test-discarded()
test-heap-arg()
test-statement-level()
