; async-group.no — 協程組（coroutine group）：裸 `{ ... }` 塊默認 spawn，有依賴則退化成 await
;
; 協程組是語句位置的裸塊：塊內每條「直接調用 -async 函數」的語句會被 spawn（run），
; 結果在需要它的地方才 await。沒有依賴時全部並發；後面的語句讀到前面的結果時，
; 前面的任務必須先落地，於是退化成順序執行。

hello-async = (i i64) (r i64) {
    r = i
}

; 1. 無依賴：兩個 spawn 都先發出，再一起 await
test-independent = () {
    r1 i64
    r2 i64
    {
        r1 = hello-async(1)
        r2 = hello-async(2)
    }
    print(r1); expect: 1
    print(r2); expect: 2
}

; 2. 有依賴：r2 讀 r1，不能並發，退化成 await 後順序執行
test-dependent = () {
    r1 i64
    r2 i64
    {
        r1 = hello-async(1)
        r2 = hello-async(r1)
    }
    print(r1); expect: 1
    print(r2); expect: 1
}

; 3. 傳遞依賴：r3 讀 r2、r2 讀 r1，整條鏈順序執行
test-chain = () {
    r1 i64
    r2 i64
    r3 i64
    {
        r1 = hello-async(1)
        r2 = hello-async(r1)
        r3 = hello-async(r2)
    }
    print(r3); expect: 1
}

; 4. 組內讀取結果：print(r1) 是屏障，r1 必須先落地，否則讀到的是句柄而非值
test-read-inside = () {
    r1 i64
    {
        r1 = hello-async(7)
        print(r1); expect: 7
    }
}

; 5. 丟棄結果的 spawn 仍然要 await，否則任務的參數緩衝區會洩漏
side-async = (n i64) {
    print(n); expect: 5
}
test-discarded = () {
    {
        side-async(5)
    }
}

; 6. 堆擁有參數：spawn 時深拷貝進任務自己的緩衝區
echo-async = (s str) (r str) {
    r = s
}
test-heap-arg = () {
    a str = 'hello'
    b str = 'world'
    ra str
    rb str
    {
        ra = echo-async(a)
        rb = echo-async(b)
    }
    print(ra); expect: hello
    print(rb); expect: world
}

; 7. 函數體不是協程組：`f = hello-async(1)` 仍然只是建出一個 future，不自動 await
test-fn-body-not-a-group = () {
    f = hello-async(1)
    print(1); expect: 1
}

test-independent()
test-dependent()
test-chain()
test-read-inside()
test-discarded()
test-heap-arg()
test-fn-body-not-a-group()
