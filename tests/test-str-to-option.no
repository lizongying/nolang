// test-str-to-option.no — 驗證 str.to-i8/i16/i32/u8/u16/u32/u64/byte/bool 返回 Option
//
// 使用 if n == err / if n == nil 模式處理 Option（不依賴 match 語法）

// ===== str.to-i64 =====
test-to-i64-ok = () {
    n = '12345'.to-i64()
    if n == nil {
        print('nil')
    } elif n == err {
        print('err')
    } else {
        print('val=')
        print(n)
    }
}

test-to-i64-neg = () {
    n = '-42'.to-i64()
    if n == nil {
        print('nil')
    } elif n == err {
        print('err')
    } else {
        print('val=')
        print(n)
    }
}

test-to-i64-empty = () {
    n = ''.to-i64()
    if n == nil {
        print('nil')
    } elif n == err {
        print('err')
    } else {
        print('val=')
        print(n)
    }
}

test-to-i64-invalid = () {
    n = 'abc'.to-i64()
    if n == nil {
        print('nil')
    } elif n == err {
        print('err')
    } else {
        print('val=')
        print(n)
    }
}

