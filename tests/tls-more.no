; tls-more — 合併自同簇 tls 除錯殘片（heavy dedup）
; # std/net/tls
;
; 保護件 tls.no / tls-partial.no / tls-prf-only.no / tls13-crypto.no /
; tls-part1~3.no / tls-import.no 均維持獨立（原始碼註解或計畫指定）。此檔只吸收
; 四個最小除錯殘片：tls-minimal / tls-simple / tls-import-repeat / tls-debug。

; from tls-minimal.no — 隔離 TLS 測試崩潰
tm-minimal = () {
    print('start')
    print('done')
}

; from tls-simple.no — 最簡單 TLS 測試
ts-simple = () {
    print('=== TLS Simple Test ===')
    print('=== Done ===')
}

; from tls-import-repeat.no — import tls 後 str.repeat 是否正常
; 頂層片段：字串索引比較與 return 於模組作用域。
tir-space = ' '
print('start')
print('before repeat')
tir-buf = tir-space.repeat(8)
print('after repeat')
{
    tir-buf[0] != 32 -> print('FAIL: expected space')

    -> print('PASS: str.repeat with tls import')
}

; from tls-debug.no — 逐個測試 TLS 功能
; 頂層片段：[]byte 逐位元組寫入（寫入增長語義）僅在模組作用域合法。
print('=== TLS Debug Test ===')

print('test 1: tls-put-u16')
td-buf []byte
tls.put-u16(td-buf, 0, 0x1234)
td-buf[0] != 0x12 -> print('FAIL: expected 0x12')
print('PASS: tls-put-u16')

print('test 2: tls-get-u16')
td-val = tls.get-u16(td-buf, 0)
td-val != 0x1234 -> print('FAIL: expected 0x1234')
print('PASS: tls-get-u16')

print('test 3: tls-bytes-cat')
td-a []byte
td-a[0] = 1
td-a[1] = 2
td-b []byte
td-b[0] = 3
td-b[1] = 4
td-out = tls.bytes-cat(td-a, td-b)
td-out.len() != 4 -> print('FAIL: expected out.len=4')
print('PASS: tls-bytes-cat')

print('test 4: tls-rand-bytes')
td-r-out = tls.rand-bytes(12345, 8)
print('PASS: tls-rand-bytes')

print('=== Done ===')

tm-minimal()
ts-simple()
