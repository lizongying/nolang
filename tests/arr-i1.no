; 測試 arr-sort-asc
test-arr-sort-asc = () {
    a [5] = [3, 1, 4, 1, 5]
    a.asc()
    print(a[0])
    print(a[1])
    print(a[2])
    print(a[3])
    print(a[4])
}

; 測試 arr-index-of
test-arr-index-of = () {
    b [3] = [1, 2, 3]
    print(b.index-of(2))
}
test-arr-sort-asc()
print('---')
test-arr-index-of()
