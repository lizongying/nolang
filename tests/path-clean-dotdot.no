; path.clean 的 '..' 回退 —— 回歸測試
;
; 修復前（`c0ed3d6f`）：`dot-count == 2` 的臂向後搜尋到 '/' 時直接 `break`，**沒有**把
; out-n 指回去，所以前一段從未被丟掉。連純 ASCII 路徑都錯：
;     /tmp/aaa/bbb/../a.txt  →  /tmp/aaa/bbba.txt      修復後 → /tmp/aaa/a.txt
; 搜尋起點也晚了一段：out-n-1 是「剛結束」的那個 '/'，要找的是「前一段之前」的 '/'，
; 故起點改為 out-n-2，並在命中時設 out-n = j+1（保留那個 '/'）。
; 邊界：找不到前一段時，絕對路徑保留根 '/'，相對路徑清空。
;
; 本檔釘住 11 組，含非 ASCII 與根路徑邊界。

main = () {

    ; ─────────────────────────────────────────────
    ; 1. 主要 bug：中間的 '..' 必須丟掉前一段
    ; ─────────────────────────────────────────────
    p1 = path { p: '/tmp/aaa/bbb/../a.txt' }
    p1.clean()
    p1.p == '/tmp/aaa/a.txt' -> print('PASS: 1 dotdot drops the previous segment')
    -> print('FAIL: 1 got=[' - p1.p - '] expect=/tmp/aaa/a.txt')

    ; ─────────────────────────────────────────────
    ; 2. 根路徑邊界：'/a/..' 收斂到 '/'
    ; ─────────────────────────────────────────────
    p2 = path { p: '/a/..' }
    p2.clean()
    p2.p == '/' -> print('PASS: 2 /a/.. collapses to root')
    -> print('FAIL: 2 got=[' - p2.p - '] expect=/')

    ; ─────────────────────────────────────────────
    ; 3. 連續回退到根
    ; ─────────────────────────────────────────────
    p3 = path { p: '/a/b/../..' }
    p3.clean()
    p3.p == '/' -> print('PASS: 3 /a/b/../.. collapses to root')
    -> print('FAIL: 3 got=[' - p3.p - '] expect=/')

    ; ─────────────────────────────────────────────
    ; 4. 相對路徑
    ; ─────────────────────────────────────────────
    p4 = path { p: 'a/b/../c' }
    p4.clean()
    p4.p == 'a/c' -> print('PASS: 4 relative a/b/../c')
    -> print('FAIL: 4 got=[' - p4.p - '] expect=a/c')

    ; ─────────────────────────────────────────────
    ; 5. 末尾段是 '..'（走迴圈後的收尾分支）
    ; ─────────────────────────────────────────────
    p5 = path { p: '/tmp/aaa/bbb/..' }
    p5.clean()
    p5.p == '/tmp/aaa' -> print('PASS: 5 trailing dotdot drops the last segment')
    -> print('FAIL: 5 got=[' - p5.p - '] expect=/tmp/aaa')

    ; ─────────────────────────────────────────────
    ; 6. 非 ASCII 路徑：'//' 折疊仍須正確（原本已釘住的行為，不可回歸）
    ; ─────────────────────────────────────────────
    p6 = path { p: '日本語//ファイル.txt' }
    p6.clean()
    p6.p == '日本語/ファイル.txt' -> print('PASS: 6 collapse // on non-ascii path')
    -> print('FAIL: 6 got=[' - p6.p - '] expect=日本語/ファイル.txt')

    ; ─────────────────────────────────────────────
    ; 7. 前一段就是第一段：回退後只留後面的部分
    ; ─────────────────────────────────────────────
    p7 = path { p: 'a/../b' }
    p7.clean()
    p7.p == 'b' -> print('PASS: 7 a/../b reduces to b')
    -> print('FAIL: 7 got=[' - p7.p - '] expect=b')

    ; ─────────────────────────────────────────────
    ; 8. 絕對路徑且已在根：'..' 不可越過根
    ; ─────────────────────────────────────────────
    p8 = path { p: '/../b' }
    p8.clean()
    p8.p == '/b' -> print('PASS: 8 /../b cannot escape root')
    -> print('FAIL: 8 got=[' - p8.p - '] expect=/b')

    ; ─────────────────────────────────────────────
    ; 9. 整條就是 '/..'
    ; ─────────────────────────────────────────────
    p9 = path { p: '/..' }
    p9.clean()
    p9.p == '/' -> print('PASS: 9 /.. stays at root')
    -> print('FAIL: 9 got=[' - p9.p - '] expect=/')

    ; ─────────────────────────────────────────────
    ; 10. '.' 段仍要被移除
    ; ─────────────────────────────────────────────
    p10 = path { p: 'a/./b' }
    p10.clean()
    p10.p == 'a/b' -> print('PASS: 10 dot segment removed')
    -> print('FAIL: 10 got=[' - p10.p - '] expect=a/b')

    ; ─────────────────────────────────────────────
    ; 11. '.' 與 '..' 混合
    ; ─────────────────────────────────────────────
    p11 = path { p: '/tmp/a/./b/../c.txt' }
    p11.clean()
    p11.p == '/tmp/a/c.txt' -> print('PASS: 11 mixed dot and dotdot')
    -> print('FAIL: 11 got=[' - p11.p - '] expect=/tmp/a/c.txt')
}
