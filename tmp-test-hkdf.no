; 最小測試: hkdf-expand-label-vec
main = () {
    print('--- hkdf test ---')

    ; 構造一個 32-byte PRK
    prk-arr [32]byte
    i <- [0..32): {
        prk-arr[i] = i + 1
    }

    ; 構造一個 32-byte context
    ctx []byte = with-len(32)
    i <- [0..32): {
        ctx[i] = i
    }

    print('before expand-label-vec')
    out []byte
    out = hkdf.hkdf-expand-label-vec(prk-arr[..], 'derived', ctx, 32)
    print('after expand-label-vec out.len=' - out.len.to-str())

    print('done')
}
