; 最小測試: 函數返回 slice, 主程式接收後 cleanup
make-slice = (n i64) (out []byte) {
    out = with-len(n)
    i <- [0..n): {
        out[i] = i & 255
    }
}

main = () {
    print('before')
    s []byte
    s = make-slice(32)
    print('after len=' - s.len.to-str())
    print('s[0]=' - s[0].to-str())
    print('done')
}
