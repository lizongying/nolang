; 測試: []byte 參數
helper = (out []byte) {
    i <- [0..32): {
        out[i] = i + 1
    }
}

caller = () {
    t-tmp []byte = with-len(32)
    helper(t-tmp)
    print('t-tmp[0]=' - t-tmp[0].to-str())
    print('t-tmp[31]=' - t-tmp[31].to-str())
}

main = () {
    print('before')
    caller()
    print('after')
    print('done')
}
