    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v'), 1, 'opt-i64-wrap some emit')
    runner.eq(ir.contains('define %option @q9a'), 1, 'opt-i64-wrap define %option')
}

; nil 字面量降级：?i64 回值位 r = nil ⇒ OP-OPTNONE（tag=1）
test-opt-i64-nil-return = () {
    src = 'q9b = () (r ?i64) {\n    r = nil\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-i64-nil unsup')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }'), 1, 'opt-i64-nil none emit')
}

; 延迟零值：?i64 输出参全程未赋值 ⇒ 回值位补 OPTNONE（tag=1，非 zeroinitializer）
test-opt-i64-deferred-zero = () {
    src = 'q9c = () (r ?i64) {\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-i64-zero unsup')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }'), 1, 'opt-i64-zero none emit')
}

; capture 标注放行：`z = q9d()`（q9d 回 ?i64）的 let 标注合成成 NullableType{i64} ⇒ 同口径入形
test-opt-i64-capture-call = () {
    src = 'q9d = () (r ?i64) {\n    r = nil\n}\nw9d = () (res ?i64) {\n    z = q9d()\n    res = z\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-i64-capture unsup')
    runner.eq(ir.contains('call %option @q9d('), 1, 'opt-i64-capture call %option')
}

; ?i64 形参入形：option 输入参直传（vty TY-OPT ⇒ %option/%op 命名空间）
test-opt-i64-param-tycode = () {
    src = 'q9f = (o ?i64) (r ?i64) {\n    r = o\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-i64-param unsup')
    runner.eq(ir.contains('define %option @q9f(%option'), 1, 'opt-i64-param %option formal')
}

; 口径同形锁：?i64 与 ?u64 同体（some-wrap）回值位 IR 逐字节相等——[3 x i64] 槽不分盆
test-opt-i64-u64-samecaliber = () {
    src64 = 'qa = (n u64) (r ?u64) {\n    r = n\n}\n'
    srci64 = 'qa = (n i64) (r ?i64) {\n    r = n\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src64.to-bytes()))
    agg = h2m-new()
    ir64 = h2m-lower-program(t, agg, r)
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(srci64.to-bytes()))
    agg2 = h2m-new()
    iri64 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg.unsup, 0, 'opt-samecaliber u64 unsup')
    runner.eq(agg2.unsup, 0, 'opt-samecaliber i64 unsup')
    runner.eq(iri64 == ir64, 1, 'opt-samecaliber i64==u64 IR')
}

; s98：option 主体三态臂解构（ok(v)/nil/err(e)）——撤销 s63 门禁，镜像 Go desugar 的 tag 顺序比较
;   覆盖面：TY-OPT 主体 + ok(v) 绑定 payload（OP-OPTGET：extractvalue %option %vN, 1, 0）、nil/err 仅比 tag
;   （ok=0 / nil=1 / err=2，OP-CONST + icmp eq i64）；err(e) 的 e 暂不可绑（无 TY-ERR），体未引用 e 时照降
;   （引用 e ⇒ h2m-var-read 查不到 ⇒ unsup，安全）。⚠️ 本件依赖 compiler 包可编译（idxwrite 迁移落地）后运行。
test-opt-match-arms = () {
    src = 'qS = (o ?i64) (r i64) {\n    o: {\n        ok(v) -> r = v\n        nil -> r = -1\n        err(e) -> r = -2\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)

    ; 关键行为改变：s98 前 option match 走门禁 ⇒ unsup > 0；撤销门禁后整函数产码 ⇒ unsup == 0
    runner.eq(agg.unsup, 0, 's98 optmatch unsup==0 (gate lifted)')

    ; ok(v) payload 读取（OP-OPTGET）：extractvalue %option %vN, 1, 0
    runner.eq(ir.contains(', 1, 0') > 0, 1, 's98 ok(v) payload OPTGET emitted')

    ; 三态 tag 读取与比较（OP-OPTTAG：extractvalue %option %vN, 0；OP-CONST：add i64 0, {0,1,2}）
    runner.eq(ir.contains('extractvalue %option') > 0, 1, 's98 option tag reads emitted')
    runner.eq(ir.contains('add i64 0, 0') > 0, 1, 's98 ok tag const 0')
    runner.eq(ir.contains('add i64 0, 1') > 0, 1, 's98 nil tag const 1')
    runner.eq(ir.contains('add i64 0, 2') > 0, 1, 's98 err tag const 2')
}

; s97：控制流 + ?i64 输出参入形——取路 some(n)、else 路 nil，汇聚 OPTLOAD 读出（两写皆落 %option 槽）
test-opt-i64-flow-slot = () {
    src = 'q9g = (n i64) (r ?i64) {\n    {\n        n > 0 -> r = n\n        -> r = nil\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-i64-flow-slot unsup')
    runner.eq(ir.contains('alloca %option'), 1, 'opt-i64-flow-slot OPTALLOC')
    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v'), 1, 'opt-i64-flow-slot some arm')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }'), 1, 'opt-i64-flow-slot nil form')
    runner.eq(ir.contains('load %option'), 1, 'opt-i64-flow-slot OPTLOAD')
    runner.eq(ir.contains('ret %option'), 1, 'opt-i64-flow-slot ret')
}

; 负例门禁：非整宽載荷不包（str 右值进 ?i64 回值位 ⇒ ty-match 门禁）
test-opt-i64-payload-gate = () {
    src = 'q9h = (s str) (r ?i64) {\n    r = s\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'opt-i64-payload counted')
    runner.eq(ir.contains('@q9h'), 0, 'opt-i64-payload no code')
}

; s96：?f64 option 三件套——内层 f64 放宽（h2m-tynode-code 认 'f64'）
;   %option 載荷槽 [3 x i64]，double 舆槽元素等宽⇒回值位走 OP-OPTMKF64（bitcast double→i64）而非 OP-OPTSOME
;   镜像 Go：optionPayloadCoerced 对 f64 内层不转（MIR 层无分岔），位形转换发生在 codegen 的 bitcast

; 回值位隐式 some 包裹：?f64 输出参 + f64 右值 ⇒ OP-OPTMKF64（bitcast double %fd→i64 落 slot[0]）
test-opt-f64-wrap-return = () {
    src = 'qfa = (x f64) (r ?f64) {\n    r = x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-f64-wrap unsup')
    runner.eq(ir.contains('bitcast double %fd'), 1, 'opt-f64-wrap bitcast emit')
    runner.eq(ir.contains('define %option @qfa'), 1, 'opt-f64-wrap define %option')
}

; 載荷形制鉴别：?f64 回值位用 bitcast（OP-OPTMKF64），而非整型的 OP-OPTSOME 裸 %v insertvalue
;   若误走 OPTSOME 会把 double SSA 名当 i64 喂（%v vs %fd 命名空间分岔）⇒ 锁定不同形制
test-opt-f64-not-i64-some = () {
    src = 'qfb = (x f64) (r ?f64) {\n    r = x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-f64-some unsup')
    runner.eq(ir.contains('bitcast double %fd'), 1, 'opt-f64-some has bitcast')
    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v'), 0, 'opt-f64-some no bare %v some')
}

; nil 字面量降级：?f64 回值位 r = nil ⇒ OP-OPTNONE（tag=1，与内层型别无关）
test-opt-f64-nil-return = () {
    src = 'qfc = () (r ?f64) {\n    r = nil\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-f64-nil unsup')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }'), 1, 'opt-f64-nil none emit')
}

; 延迟零值：?f64 输出参全程未赋值 ⇒ 回值位补 OPTNONE（tag=1）
test-opt-f64-deferred-zero = () {
    src = 'qfd = () (r ?f64) {\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-f64-zero unsup')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }'), 1, 'opt-f64-zero none emit')
}

; capture 标注放行：`z = qfe()`（qfe 回 ?f64）的 let 标注合成成 NullableType{f64} ⇒ 同口径入形
test-opt-f64-capture-call = () {
    src = 'qfe = () (r ?f64) {\n    r = nil\n}\nwe = () (res ?f64) {\n    z = qfe()\n    res = z\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-f64-capture unsup')
    runner.eq(ir.contains('call %option @qfe('), 1, 'opt-f64-capture call %option')
}

; ?f64 形参入形：option 输入参直传（vty TY-OPT ⇒ %option/%op 命名空间）
test-opt-f64-param-tycode = () {
    src = 'qff = (o ?f64) (r ?f64) {\n    r = o\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-f64-param unsup')
    runner.eq(ir.contains('define %option @qff(%option'), 1, 'opt-f64-param %option formal')
}

; s97：控制流 + ?f64 输出参入形——取路写点 OP-OPTMKF64 bitcast 落槽（非裸 %v some）
test-opt-f64-flow-slot = () {
    src = 'qfg = (x f64) (r ?f64) {\n    x > 0.0 -> r = x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-f64-flow-slot unsup')
    runner.eq(ir.contains('alloca %option'), 1, 'opt-f64-flow-slot OPTALLOC')
    runner.eq(ir.contains('bitcast double %fd'), 1, 'opt-f64-flow-slot bitcast')

    ; 載荷专属：f64 走 %mb bitcast insertvalue，不发裸 %v some（口径鉴别）
    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v'), 0, 'opt-f64-flow-slot no bare %v some')
    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %mb'), 1, 'opt-f64-flow-slot mkf64 some')
    runner.eq(ir.contains('load %option'), 1, 'opt-f64-flow-slot OPTLOAD')
}

; 负例门禁：非 64 位宽載荷不包（str 右值进 ?f64 回值位 ⇒ ty-match 门禁）
test-opt-f64-payload-gate = () {
    src = 'qfh = (s str) (r ?f64) {\n    r = s\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'opt-f64-payload counted')
    runner.eq(ir.contains('@qfh'), 0, 'opt-f64-payload no code')
}

; s97：控制流全程未写 ?i64 输出参——铺 nil-init 槽、汇聚 OPTLOAD 读出 tag=1（与 Go 延迟零值 nil 一致，非 some(0)）
test-opt-slot-deferred-nil = () {
    src = 'qfb = (n i64) (r ?i64) {\n    a = 0\n    n > 0 -> a = 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-slot-deferred unsup')
    runner.eq(ir.contains('alloca %option'), 1, 'opt-slot-deferred OPTALLOC')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 1, 0'), 1, 'opt-slot-deferred nil-init')

    ; 未写路径绝无 some(0)：槽内不存在 tag=0 的裸零包裹
    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v'), 0, 'opt-slot-deferred no some(0)')
    runner.eq(ir.contains('load %option'), 1, 'opt-slot-deferred OPTLOAD')
    runner.eq(ir.contains('ret %option'), 1, 'opt-slot-deferred ret')
}

; s97 负例：控制流里 str 載荷写进 ?i64 option 槽——h2m-opt-wrap 不可包⇒写点计 unsup，宁缺勿错
test-opt-slot-str-payload-gate = () {
    src = 'qc = (n i64, s str) (r ?i64) {\n    {\n        n > 0 -> r = n\n        -> r = s\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'opt-slot-str-payload counted')
    runner.eq(ir.contains('@qc'), 0, 'opt-slot-str-payload no code')
}

; f64 前缀负号（s70）：-x（x 为 f64 形参）⇒ fneg double %fd…，仅 widened 的 '-' 臂
;   ⚠ 无 f64 字面量降级（OP-CONST 只发 i64）⇒ 操作数必为 f64 形参
;   ⚠ 直线式（无控制流）⇒ 寄存器模式，f64 值以 %fd SSA 流动，不落 alloca double 槽
test-neg-f64-var = () {
    src = 'n6x = (x f64) (r f64) {\n    r = -x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'neg-f64-var unsup')
    runner.eq(ir.contains('fneg double'), 1, 'neg-f64-var fneg')
    runner.eq(ir.contains('define double'), 1, 'neg-f64-var define double')
    runner.eq(ir.contains('ret double'), 1, 'neg-f64-var ret double')
}

; f64 双负：-(-x) ⇒ 两颗 fneg double
test-neg-f64-nested = () {
    src = 'n7x = (x f64) (r f64) {\n    r = -(-x)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'neg-f64-nested unsup')
    runner.eq(ir.contains('fneg double'), 1, 'neg-f64-nested fneg')
}

; 门控：! 与 ~ 仅 i64——!x（x 为 f64）不在覆盖面 ⇒ unsup（s70 只 widened '-'，不动 '!'/'~'）
test-neg-f64-gate = () {
    src = 'n8x = (x f64) (r i64) {\n    r = !x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'neg-f64-gate counted')
    runner.eq(ir.contains('define'), 0, 'neg-f64-gate no code')
}

; ── u64 前缀 -x / ~x（s81）────────────────────────────────────────
; s81：u64 主体的 '-' ⇒ OP-NEG（dest TY-U64），cg 整数臂发 sub i64 0（二补回绕，与 i64 同 IR 形）
;   镜像 src/mir/codegen.go emitNeg 非 option 非 float 路径；s76–s80 u64 族收尾（前缀 NEG/bit-not）
test-pfx-u64-neg = () {
    src = 'p8a = (x u64) (r u64) {\n    r = -x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'pfx-u64-neg unsup')
    runner.eq(ir.contains('sub i64 0'), 1, 'pfx-u64-neg sub')
    runner.eq(ir.contains('define'), 1, 'pfx-u64-neg code')
}

; s81：u64 主体的 '~' ⇒ OP-CONST(-1)+OP-XOR（dest TY-U64），发 add i64 0, -1 与 xor i64 %v
test-pfx-u64-not = () {
    src = 'p8b = (x u64) (r u64) {\n    r = ~x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'pfx-u64-not unsup')
    runner.eq(ir.contains('add i64 0, -1'), 1, 'pfx-u64-not const -1')
    runner.eq(ir.contains('xor i64 %v'), 1, 'pfx-u64-not xor')
}

; s81：u64 嵌套 -(-x) ⇒ 两颗 sub
test-pfx-u64-nested = () {
    src = 'p8c = (x u64) (r u64) {\n    r = -(-x)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'pfx-u64-nested unsup')
    runner.eq(ir.contains('sub i64 0'), 1, 'pfx-u64-nested sub')
}

; s81 🔴 槽宽耦合靶：mem 模式 f=-x; n>0->f=~f; r=f——f 由 h2m-ty-of 前扫描递归操作元型别注册 TY-U64，
;   降级侧两臂 dest 皆 TY-U64，写 f 不撞 st==vt；跨块 alloca/load 喂 sub 与 xor
test-pfx-u64-mem = () {
    src = 'p8d = (x u64, n i64) (r u64) {\n    f = -x\n    n > 0 -> f = ~f\n    r = f\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'pfx-u64-mem unsup')
    runner.eq(ir.contains('alloca i64'), 1, 'pfx-u64-mem alloca')
    runner.eq(ir.contains('sub i64 0'), 1, 'pfx-u64-mem sub')
    runner.eq(ir.contains('xor i64'), 1, 'pfx-u64-mem xor')
}

; s81：u64 前缀喂无符號 add：r = ~x + ~y（前缀 dest TY-U64 流入 s78 u64 算术）
test-pfx-u64-in-expr = () {
    src = 'p8e = (x u64, y u64) (r u64) {\n    r = ~x + ~y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'pfx-u64-expr unsup')
    runner.eq(ir.contains('xor i64'), 1, 'pfx-u64-expr xor')
    runner.eq(ir.contains('add i64'), 1, 'pfx-u64-expr add')
}

; s88 翻正：'!' 于 u64 放行——s81 门禁尾款（当时理由「裸 xor 1 ≠ 逻辑非，非 0/1 值会错」正解
;   为先归位低 bit 再 xor，非门禁）；Go 对 u64 与 i64 同走 emitNot 的 `xor i1 1, trunc`，
;   值面 oracle tmp/probe-s88-a.no 实钉 54（!2=1、!5=0、!255=0、!0=1、!1=0）
test-pfx-u64-lnot = () {
    src = 'p8f = (x u64) (r i64) {\n    r = !x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'pfx-u64-lnot unsup')
    runner.eq(ir.contains('and i64'), 1, 'pfx-u64-lnot mask')
    runner.eq(ir.contains('xor i64 1'), 1, 'pfx-u64-lnot xor')
}

; f64 二元算术（s71）：x + y（两 f64 形参）⇒ fadd double %fd…
;   ⚠ 无 f64 字面量降级（OP-CONST 只发 i64）⇒ 两侧操作数必为 f64 形参
;   ⚠ 直线式（无控制流）⇒ 寄存器模式，f64 值以 %fd SSA 流动，不落 alloca double 槽
test-arith-f64-add = () {
    src = 'f6a = (x f64, y f64) (r f64) {\n    r = x + y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-f64-add unsup')
    runner.eq(ir.contains('fadd double'), 1, 'arith-f64-add fadd')
    runner.eq(ir.contains('define double'), 1, 'arith-f64-add define double')
    runner.eq(ir.contains('ret double'), 1, 'arith-f64-add ret double')
}

; f64 嵌套：(x + y) * z ⇒ fadd double ＋ fmul double（内层子表达式型别经 h2m-vty-at 递归传至外层）
test-arith-f64-mul-nested = () {
    src = 'f6m = (x f64, y f64, z f64) (r f64) {\n    r = (x + y) * z\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-f64-mul unsup')
    runner.eq(ir.contains('fadd double'), 1, 'arith-f64-mul fadd')
    runner.eq(ir.contains('fmul double'), 1, 'arith-f64-mul fmul')
}

; f64 除法：x / y ⇒ fdiv double（IEEE 除零得 inf/nan，无需 option 護栏）
test-arith-f64-div = () {
    src = 'f6d = (x f64, y f64) (r f64) {\n    r = x / y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-f64-div unsup')
    runner.eq(ir.contains('fdiv double'), 1, 'arith-f64-div fdiv')
}

; s87：f64 模 x % y ⇒ frem double（镜像 Go codegen.go:6083 OpMod isFloat⇒frem）；
;   AArch64 llc 将 frem double 降为 libm fmod（trunc 语义，7.0%2.5=2.0，oracle 实钉），
;   与 Go 侧同 IR 形制同 lowering ⇒ 语义自动对齐，无需護欄
test-arith-f64-mod = () {
    src = 'f6m = (x f64, y f64) (r f64) {\n    r = x % y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-f64-mod unsup')
    runner.eq(ir.contains('frem double'), 1, 'arith-f64-mod frem')
}

; 门控一：混合操作数（一 f64 一 i64）⇒ unsup（两侧须同为 f64）
test-arith-f64-mixed-gate = () {
    src = 'f6x = (x f64, y i64) (r f64) {\n    r = x + y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'arith-f64-mixed counted')
    runner.eq(ir.contains('define'), 0, 'arith-f64-mixed no code')
}

; s75 转正：i64 '/' 放行——dest 纯 i64 ⇒ cg 发除零 select 護欄（镜像 Go plain 路径）：
;   %dz icmp、%ds 安全除数 select、sdiv、除零结果定义化为 0、div_zero_report 追发
test-arith-i64-div-plain = () {
    src = 'i6d = (x i64, y i64) (r i64) {\n    r = x / y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-i64-div-plain unsup')
    runner.eq(ir.contains('sdiv i64'), 1, 'arith-i64-div-plain sdiv')
    runner.eq(ir.contains('= select i1 %dz.'), 1, 'arith-i64-div-plain safe-divisor select')
    runner.eq(ir.contains('call void @__nolang_div_zero_report'), 1, 'arith-i64-div-plain report')
}

; s75：i64 '%' 放行 ⇒ srem i64 + 同一除零護欄（镜像 Go plain 路径的 OpMod 分支）
test-arith-i64-mod-plain = () {
    src = 'i6m = (x i64, y i64) (r i64) {\n    r = x % y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-i64-mod-plain unsup')
    runner.eq(ir.contains('srem i64'), 1, 'arith-i64-mod-plain srem')
    runner.eq(ir.contains('= select i1 %dz.'), 1, 'arith-i64-mod-plain safe-divisor select')
}

; s75：mem 模式（控制流）下的 i64 除法——除数出自前扫描推断的 i64 槽，跨块 LOAD 后喂護欄 sdiv
test-arith-i64-div-mem = () {
    src = 'i6n = (x i64) (r i64) {\n    d = 3 - x\n    r = 100 / d\n    r > 0 -> r = r + x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-i64-div-mem unsup')
    runner.eq(ir.contains('alloca i64'), 1, 'arith-i64-div-mem alloca')
    runner.eq(ir.contains('sdiv i64'), 1, 'arith-i64-div-mem sdiv')
    runner.eq(ir.contains('load i64, i64*'), 1, 'arith-i64-div-mem load')
}

; ── (MIN,-1) 護欄翼（s85）────────────────────────────────
; s85 實釘：i64 '/' '%' 端到端 IR 必含 (MIN,-1) 翼（%dmn/%dn1/%db/%dall 四臂）——
;   鏡像 Go codegen.go emitArith OpDiv/OpMod 有符號分支；執行面值見 tmp/probe-s85-ir
;   （MIN/-1⇒MIN、MIN%-1⇒0、除零錨共存 exit 7 == oracle）；u64 側負向斷言已在 s76 釘住
test-arith-i64-div-min-wing = () {
    src = 'i6w = (x i64, y i64) (r i64) {\n    r = x / y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-i64-div-min-wing unsup')
    runner.eq(ir.contains('%dmn.'), 1, 'arith-i64-div-min-wing isMin')
    runner.eq(ir.contains('%dn1.'), 1, 'arith-i64-div-min-wing isNeg1')
    runner.eq(ir.contains('= and i1 %dmn.'), 1, 'arith-i64-div-min-wing minAnd')
    runner.eq(ir.contains('= or i1 %dz.'), 1, 'arith-i64-div-min-wing badOr')
    runner.eq(ir.contains('select i1 %dall.'), 1, 'arith-i64-div-min-wing safe-divisor fed by dall')
}

test-arith-i64-mod-min-wing = () {
    src = 'i6v = (x i64, y i64) (r i64) {\n    r = x % y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-i64-mod-min-wing unsup')
    runner.eq(ir.contains('srem i64'), 1, 'arith-i64-mod-min-wing srem')
    runner.eq(ir.contains('%dmn.'), 1, 'arith-i64-mod-min-wing isMin')
    runner.eq(ir.contains('%dn1.'), 1, 'arith-i64-mod-min-wing isNeg1')
    runner.eq(ir.contains('%dall.'), 1, 'arith-i64-mod-min-wing badAll')
    runner.eq(ir.contains('= or i1 %dz.'), 1, 'arith-i64-mod-min-wing badOr')
    runner.eq(ir.contains('select i1 %dz.'), 1, 'arith-i64-mod-min-wing zero result select')
    runner.eq(ir.contains('call void @__nolang_div_zero_report(i1 %dz.'), 1, 'arith-i64-mod-min-wing report on zeroDiv not dall')
}

; ── u64 除／模（s76）────────────────────────────────────────
; s76：u64 '/' 放行 ⇒ udiv i64 ＋ 除零護欄（镜像 Go plain 路径 OpUDiv 分支：
;   護欄仅零检、无 (MIN,-1)——负向断言 %dmn. 不现；且不得混发有符號 sdiv）
test-arith-u64-div-plain = () {
    src = 'u6d = (x u64, y u64) (r u64) {\n    r = x / y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-div-plain unsup')
    runner.eq(ir.contains('udiv i64'), 1, 'arith-u64-div-plain udiv')
    runner.eq(ir.contains('sdiv i64'), 0, 'arith-u64-div-plain not sdiv')
    runner.eq(ir.contains('= select i1 %dz.'), 1, 'arith-u64-div-plain safe-divisor select')
    runner.eq(ir.contains('call void @__nolang_div_zero_report'), 1, 'arith-u64-div-plain report')
    runner.eq(ir.contains('%dmn.'), 0, 'arith-u64-div-plain no MIN check')
}

; s76：u64 '%' 放行 ⇒ urem i64 ＋ 同一除零護欄（OpUMod 分支；负向断言 -1 检查不现）
test-arith-u64-mod-plain = () {
    src = 'u6m = (x u64, y u64) (r u64) {\n    r = x % y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-mod-plain unsup')
    runner.eq(ir.contains('urem i64'), 1, 'arith-u64-mod-plain urem')
    runner.eq(ir.contains('srem i64'), 0, 'arith-u64-mod-plain not srem')
    runner.eq(ir.contains('%dn1.'), 0, 'arith-u64-mod-plain no -1 check')
}

; s76：一侧 u64 × 整字面量同走无符號（镜像 Go hir2mir sourceUnsigned(lv) || sourceUnsigned(rv) 的任一侧判据）
test-arith-u64-div-lit = () {
    src = 'u6l = (x u64) (r u64) {\n    r = x / 2\n}\n'
    t = ast.make()
