; h2m-test.no — compiler/src/h2m.no（M4-e AST→MIR 降级）单元测试
;
; 执行： ./bin/no run compiler/tests/h2m-test.no
; ⚠️ runner 断言失败不改退出码，本档结尾必须自己 exit(1)。
;
; 与 cg-test.no 的分工：cg-test.no 喂【手写 op 数组】验发射；本档喂【真实源码】——
; 走 ps.no 解析 → h2m.no 降级 → cg.no 发射，断言的是「源码文本 → IR 文本」这条链路。
; 每个用例都同时钉 unsup 计数器：产码 ≠ 产对码，不支持的构造必须被计数抓住。
;
; s55 覆盖：表达式（+ - *）/ 变量绑定与重绑 / 括號下钻 / 多函数
; s56 覆盖：输入参数占形参值 id / 返回值型别决定 retty / 零参与多参调用 / 签名表前向解析
; s57 覆盖：比较家族（六个比较符 → icmp 族）/ 单行 guard 的 if（entry+then+merge 切块）/
;         前置条件循环（hdr/body/exit + 回边）/ mem 模式的 alloca 槽（跳块写回同一变量）/
;         合成 AST 的 else 臂（IfExpression 的三 kid 形制——真实单行 guard 的 Alternative 恒 0，
;         所以带 else 的 if 只能靠 ast.add/kid-add 搭出来跑同一段降级）
; s58 覆盖：花括号短路链 K-SURFACE-MATCH（语句位）——三臂含 wildcard / 无 wildcard 的两臂链
;         （假路直落汇聚块）/ 单 wildcard 臂（无条件判定故整链不应出现 icmp）/ 循环体内的链
;         （链的汇聚块只拿到回边）/ 表达式位的链仍计 unsup
; s59 覆盖：块终结形 return / break / continue——共享 ret 块（懒开，BR 过去再 LOAD+RET）、
;         循环目标栈（continue 回 hdr、break 落 exit 且其后继语句照跑）、链臂体裸终结形、
;         无输出参函数的延迟零值 RET；负例：终结形非本块末条 / 循环外 break / 带标签跳出
; s60m 覆盖：计数循环 `N * { }` 与 `{ } * N`（两形在 parser 归一）——合成计数器槽 / header 判 >0 /
;         update 块自减回跳 / continue 落 update 而非 hdr / break 落 exit 且后继照跑 / 嵌套双计数器槽；
;         非正计数（-2 与 0）照发 header 判定；负例：标识符计数位 / 计数与条件同时存在 / 计数位是字符串
; s61 覆盖：区间遍历 `i <- [a..b]`——四括号组合（右开 slt/sgt、右闭 sle/sge、左开起始值偏一格）／
;         自动双向（11 块方向分派）／变量端点／体内 break 落 exit 且后继照跑、continue 落 update／
;         关键字形 for 与运算符形同形；负例：开边界 / 嵌套同名区间循环 / 无标注的 let vec 容器遍历
; s62 覆盖：容器遍历 `i <- xs`（[]i64 形参作源）——五块 pre/hdr/body/upd/exit／长度只求一次／
;         索引落合成槽 @idx<node>／vec 形参不铺 alloca %vec 而靠 entry 支配直接跳块引用／体内 break
;         落 exit 且后继照跑、continue 落 update／嵌套异名四颗独立槽；负例：str 源／标量源／[]str 元素源／
;         无标注的 let vec／体内改写循环变量（Go bindElemPlace 写回元素）／嵌套同名／vec 作返回值
; s63 覆盖：值匹配 `x: { 1 -> …  2 -> …  -> … }`（语句位主体存）——逐臂「本臂判定块内 LOAD 主体 +
;         OP-CMPEQ 型样」／单臂无兜底（假路直落汇聚块）／主体是局部量／臂体多陈述块／区间遍历变量
;         作主体／值匹配臂体内再套值匹配；负例：str 主体／负数前缀型样／具名型样／表达式主体／
;         未登记主体／布尔字面量型样
; s64 覆盖：实参侧池 args（摘掉连续 id 契约 §11 B16）——次位/中间实参是算式／单嵌套调用实参／
;         双嵌套调用实参（外层池基址落在内层池项之后，值 id 跳号）／str 混排实参／循环体内算式实参；
;         回归靶：初版边降边推时嵌套入池挤偏外层基址（c6 发成 @f(%v1,%v2)），现整段入池后必须为 @f(%v2,%v3)

# /test/runner.eq
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok
# /compiler/src/ps
# /compiler/src/h2m
# /compiler/src/mir

; ⚠️ 導入清單必須含 ps 的【傳遞依賴】（asp / lx / tok）——實測（s55）：只導入
;    ast / ps / h2m 時，跨模組常量（asp.K-INTEGER-LITERAL 等）解析不到，行程
;    表現為【無限循環掛起】而非報錯；補全直接導入後恢復。同族缺陷的報錯形態見
;    compiler/tests/ps-test.no 檔頭（oracle 端跨模組常量解析範圍缺陷，先於本檔存在）。

; ── f = () (r i64) { r = 2 + 3 * 4 } ──
; 证明 AST → MIR 的第一条真实路径：优先级由 parser 建成嵌套 InfixExpression，
; 降级只需后序遍历——先算右侧乘法（id2/id3/id4），再算加法（id5），末 RET id5。
test-prec = () {
    src = 'f = () (r i64) {\n    r = 2 + 3 * 4\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'prec unsup')
    runner.eq(ir.contains('define i64 @f()'), 1, 'prec define')
    runner.eq(ir.contains('%v1 = add i64 0, 2'), 1, 'prec const 2')
    runner.eq(ir.contains('%v2 = add i64 0, 3'), 1, 'prec const 3')
    runner.eq(ir.contains('%v3 = add i64 0, 4'), 1, 'prec const 4')
    runner.eq(ir.contains('%v4 = mul i64 %v2, %v3'), 1, 'prec mul')
    runner.eq(ir.contains('%v5 = add i64 %v1, %v4'), 1, 'prec add')
    runner.eq(ir.contains('ret i64 %v5'), 1, 'prec ret')

    ; 鉴别力：结果 id 必须是 5（多算/漏算一条都会挪动它）；不碰内存指令
    runner.eq(ir.contains('%v6'), 0, 'prec no extra id')
    runner.eq(ir.contains('alloca'), 0, 'prec no alloca')
    runner.eq(ir.contains('load '), 0, 'prec no load')
}

; ── g = () (r i64) { x = 5; r = x - 1 } ──
; 证明标识符按名字查到先前绑定的值 id（无槽、直接 SSA 引用）。
test-var = () {
    src = 'g = () (r i64) {\n    x = 5\n    r = x - 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'var unsup')
    runner.eq(ir.contains('%v1 = add i64 0, 5'), 1, 'var const 5')
    runner.eq(ir.contains('%v2 = add i64 0, 1'), 1, 'var const 1')
    runner.eq(ir.contains('%v3 = sub i64 %v1, %v2'), 1, 'var sub refs v1')
    runner.eq(ir.contains('ret i64 %v3'), 1, 'var ret')
}

; ── h = () (r i64) { r = 1; r = r + 2 } ──
; 证明同名重复绑定 = 覆盖重赋值（§3.11）：第二条语句读到的是第一条的值 id 1，
; 且 r 的最终绑定挪到 id3，RET 取 id3——不是 RET 旧的 id1。
test-rebind = () {
    src = 'h = () (r i64) {\n    r = 1\n    r = r + 2\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rebind unsup')
    runner.eq(ir.contains('%v1 = add i64 0, 1'), 1, 'rebind const 1')
    runner.eq(ir.contains('%v3 = add i64 %v1, %v2'), 1, 'rebind add')
    runner.eq(ir.contains('ret i64 %v3'), 1, 'rebind ret latest')
}

; ── k = () (r i64) { r = (2 + 3) * 4 } ──
; 证明 GroupedExpression 透明降级（只下钻第一个 kid，不额外产生值）。
test-group = () {
    src = 'k = () (r i64) {\n    r = (2 + 3) * 4\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'group unsup')
    runner.eq(ir.contains('%v3 = add i64 %v1, %v2'), 1, 'group inner add')
    runner.eq(ir.contains('%v4 = add i64 0, 4'), 1, 'group const 4')
    runner.eq(ir.contains('%v5 = mul i64 %v3, %v4'), 1, 'group mul of add')
    runner.eq(ir.contains('ret i64 %v5'), 1, 'group ret')
}

; ── 两个函数：拼接 + 各自独立的值 id arena ──
test-multi-func = () {
    src = 'a = () (r i64) {\n    r = 1 + 2\n}\n\nz = () (r i64) {\n    r = 7\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'multi unsup')
    runner.eq(ir.contains('define i64 @a()'), 1, 'multi define a')
    runner.eq(ir.contains('define i64 @z()'), 1, 'multi define z')

    ; 第二个函数的 id 从 1 重新起算（私有 arena），其常量写的是 %v1 = add i64 0, 7
    runner.eq(ir.contains('%v1 = add i64 0, 7'), 1, 'multi fresh arena')
}

; ── 负例门禁：不支持的构造必须计入 unsup，不得静默产码 ──
test-gate = () {

    ; s75：整型 / 已放行（護欄 plain 路：除零→0 + stderr 报告），此例转正
    src-div = 'd = () (r i64) {\n    r = 6 / 2\n}\n'
    t1 = ast.make()
    p1 = ps.new(src-div.to-bytes())
    r1 = ps.parse(t1, p1)
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup, 0, 'gate div unsup')
    runner.eq(ir1.contains('sdiv i64'), 1, 'gate div sdiv')

    ; 未定义标识符
    src-unk = 'u = () (r i64) {\n    r = zz\n}\n'
    t2 = ast.make()
    p2 = ps.new(src-unk.to-bytes())
    r2 = ps.parse(t2, p2)
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'gate unknown name counted')

    ; 參數默認值語法已移除：ps.no 仍消費 `= expr`（保證 token 流前進）但不寫入 AST，
    ;   因此定義自身仍按「單形參」降級產碼；缺參呼叫由下面的門禁測試覆蓋。
    src-def = 'i = (x i64 = 5) (r i64) {\n    r = x\n}\n'
    t3 = ast.make()
    p3 = ps.new(src-def.to-bytes())
    r3 = ps.parse(t3, p3)
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup, 0, 'default param def lowered')
    runner.eq(ir3.contains('define'), 1, 'default param def code')

    ; 未知型别名 ⇒ 签名不合格
    src-ty = 'j = (x foo) (r i64) {\n    r = 1\n}\n'
    t5 = ast.make()
    p5 = ps.new(src-ty.to-bytes())
    r5 = ps.parse(t5, p5)
    agg5 = h2m-new()
    ir5 = h2m-lower-program(t5, agg5, r5)
    runner.eq(agg5.unsup > 0, 1, 'gate unknown type counted')
    runner.eq(ir5.contains('define'), 0, 'gate unknown type no code')

    ; 非函数定义语句（结构体定义）⇒ 计入 unsup
    src-struct = 'pt {\n    x i64\n}\n\ns = () (r i64) {\n    r = 3\n}\n'
    t4 = ast.make()
    p4 = ps.new(src-struct.to-bytes())
    r4 = ps.parse(t4, p4)
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)

    ; s99：结构体定义不再计入 unsup（前扫描登记进模块表，不计不支持构造）
    runner.eq(agg4.unsup, 0, 'struct def not counted')
    runner.eq(ir4.contains('define i64 @s()'), 1, 'gate sibling still emitted')
}

; ── s99：结构体定义 + 字段读/写（局部变量）──
; 证明：前扫描登记结构体表 ⇒ 模块 IR 前置 `%struct.s0 = type { i64, i64 }`；
;   struct 字面量降级成 OP-STRUCT-MK（字段值 id 连续，insertvalue 链式装配）；
;   点号读降级成 extractvalue（OP-STRUCT-GET）；字段写降级成 insertvalue 出新值
;   （OP-STRUCT-SET，新字段值 id = 旧结构体值 + 1 连续约定）并 rebind 回变量。
;   字段写后 p.y 由 2 改 5，故末句 r = p.x + p.y = 1 + 5 = 6（验证 SET rebind 真生效）。
test-s99-struct = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = () (r i64) {\n    p = Point { x: 1, y: 2 }\n    a = p.x + p.y\n    p.y = 5\n    r = p.x + p.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 's99 unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, i64 }'), 1, 's99 struct decl emitted')
    runner.eq(ir.contains('define i64 @f()'), 1, 's99 define f')

    ; MK：首步 insertvalue 以 zeroinitializer 起手
    runner.eq(ir.contains('insertvalue %struct.s0 zeroinitializer'), 1, 's99 mk')

    ; GET：extractvalue 读字段
    runner.eq(ir.contains('extractvalue %struct.s0'), 1, 's99 get')

    ; SET：insertvalue 以 %st<旧值> 为输入产生新值
    runner.eq(ir.contains('insertvalue %struct.s0 %st'), 1, 's99 set')

    ; 末句 r = p.x + p.y 必须降级成 add（读两个字段后相加）
    runner.eq(ir.contains('ret i64 %v'), 1, 's99 ret present')
}

; ── s99b：结构体作形参（字段读）+ 作返回值（MK） + 形参字段写后返回 ──
; 证明：h2m-tynode-code 在 h2m-ty-code 回 -1 时回退查模块级结构体表，把具名结构体型别
;   解析成 TY-STRUCT-BASE + sid；h2m-func-sig / h2m-param-ty / h2m-lower-let 透传 agg 上下文后，
;   函数签名（形参 ptys、retty）即可携带结构体码，cg 按 cg-ty-name 渲染 %struct.s0 签名。
;   pre-pass 拆两段（先登记全部结构体、再解析函数签名）保证书写序无关。
test-s99b-param-get = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = (p Point) (r i64) {\n    r = p.x + p.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99b param-get unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, i64 }'), 1, 's99b struct decl')
    runner.eq(ir.contains('define i64 @f(%struct.s0 %st1)'), 1, 's99b param sig')
    runner.eq(ir.contains('extractvalue %struct.s0 %st1, 0'), 1, 's99b get x')
    runner.eq(ir.contains('extractvalue %struct.s0 %st1, 1'), 1, 's99b get y')
    runner.eq(ir.contains('add i64 %v2, %v3'), 1, 's99b add')
    runner.eq(ir.contains('ret i64 %v4'), 1, 's99b ret')
}

test-s99b-return-mk = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = () (p Point) {\n    p = Point { x: 1, y: 2 }\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99b return-mk unsup')
    runner.eq(ir.contains('define %struct.s0 @f()'), 1, 's99b return sig')
    runner.eq(ir.contains('insertvalue %struct.s0 zeroinitializer'), 1, 's99b mk')
    runner.eq(ir.contains('ret %struct.s0 %st3'), 1, 's99b ret struct')
}

test-s99b-param-set-return = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = (p Point) (p Point) {\n    p.y = p.y + 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99b param-set-return unsup')
    runner.eq(ir.contains('define %struct.s0 @f(%struct.s0 %st1)'), 1, 's99b param+ret sig')
    runner.eq(ir.contains('insertvalue %struct.s0 %st1, i64 %v4, 1'), 1, 's99b set rebind')
    runner.eq(ir.contains('ret %struct.s0 %st5'), 1, 's99b ret')
}

; ── s99c：结构体跨基本块槽（STALLOC / STSTORE / STLOAD）──
; 证明：mem 模式下（函数体含循环）局部量落 entry 的 alloca %struct.sN 槽（%sts<id>）；
;   MK 把字面量值 store 进槽、GET 从槽 load 后再 extractvalue、SET 先 load 旧值再 insertvalue 后 store 回槽，
;   槽在循环迭代间正确携带 mutation；循环后读字段得到的是改后的值。
;   h2m-struct-find / h2m-tynode-code / h2m-ty-of(DOT) 链路把结构体名与字段型别解析进局部量表，
;   槽声明、读、写三处均已接 struct 分支（与 i64/str/opt 同形）。
test-s99c-local-loop = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = () (r i64) {\n    p = Point { x: 1, y: 2 }\n    n = 0\n    (n < 5) {\n        p.y = p.y + 1\n        n = n + 1\n    }\n    r = p.x + p.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99c local-loop unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, i64 }'), 1, 's99c struct decl')
    runner.eq(ir.contains('define i64 @f()'), 1, 's99c define f')

    ; mem 模式：槽声明 + 控制流块
    runner.eq(ir.contains('alloca %struct.s0'), 1, 's99c slot alloca')
    runner.eq(ir.contains('br label %bb1'), 1, 's99c control flow')

    ; 字面量 MK 写入槽、循环内 SET 写回槽、循环后 GET 从槽读
    runner.eq(ir.contains('store %struct.s0 %st'), 1, 's99c store to slot')
    runner.eq(ir.contains('load %struct.s0, %struct.s0* %sts'), 1, 's99c load from slot')
    runner.eq(ir.contains('ret i64 %v'), 1, 's99c ret')
}

test-s99c-param-loop = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = (p Point) (r Point) {\n    n = 0\n    (n < 5) {\n        p.y = p.y + 1\n        n = n + 1\n    }\n    r = p\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99c param-loop unsup')
    runner.eq(ir.contains('define %struct.s0 @f(%struct.s0 %st1)'), 1, 's99c param sig')
    runner.eq(ir.contains('alloca %struct.s0'), 1, 's99c slot alloca')

    ; 形参 incoming 值落槽
    runner.eq(ir.contains('store %struct.s0 %st1, %struct.s0* %sts'), 1, 's99c param init slot')

    ; 循环内：从槽 load、insertvalue 改 y、store 回槽
    runner.eq(ir.contains('load %struct.s0, %struct.s0* %sts'), 1, 's99c load from slot')
    runner.eq(ir.contains('store %struct.s0 %st'), 1, 's99c store to slot')
    runner.eq(ir.contains('ret %struct.s0 %st'), 1, 's99c ret')
}

; ── s99d：结构体跨函数调用（mem 模式，含控制流）──
; 证明：结构体在 mem 模式下作为实参按值穿过 call、被调按值返 struct、调用方读出/改写字段，
;   整条链路（MK 落槽 → load → call by-value → store 返回 → extractvalue → insertvalue 改写 → store 回槽）
;   在 h2m 侧完整降级且 UNSUP=0；call 发射对 struct 实参/返回值的型别码（TY-STRUCT-BASE+sid）正确。
;   与前三档（s99 本地槽 / s99b 形参返值 / s99c 跨基本块槽）衔接，覆盖 struct 完整生命周期的「调用集成点」。
test-s99d-local-call = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = (p Point) (r Point) {\n    r = p\n}\n\ng = () (z i64) {\n    q = Point { x: 1, y: 2 }\n    n = 0\n    (n < 3) {\n        n = n + 1\n    }\n    s = f(q)\n    z = s.x + s.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99d local-call unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, i64 }'), 1, 's99d struct decl')

    ; 被调函数按值收/返 struct
    runner.eq(ir.contains('define %struct.s0 @f(%struct.s0 %st1)'), 1, 's99d callee sig by-value')
    runner.eq(ir.contains('ret %struct.s0 %st1'), 1, 's99d callee ret by-value')

    ; 调用点：本地 struct 字面量落槽后 load，按值传入 call，call 按值返回
    runner.eq(ir.contains('store %struct.s0 %st'), 1, 's99d store struct to slot')
    runner.eq(ir.contains('call %struct.s0 @f(%struct.s0 %st'), 1, 's99d call passes struct by value')

    ; 返回后读字段
    runner.eq(ir.contains('extractvalue %struct.s0 %st'), 1, 's99d read fields after call')
}

test-s99d-param-call = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = (p Point) (r Point) {\n    r = p\n}\n\ng = (inp Point) (z i64) {\n    n = 0\n    (n < 3) {\n        n = n + 1\n    }\n    s = f(inp)\n    z = s.x + s.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99d param-call unsup')

    ; 形参 struct 落槽
    runner.eq(ir.contains('define i64 @g(%struct.s0 %st1)'), 1, 's99d param sig')
    runner.eq(ir.contains('store %struct.s0 %st1, %struct.s0* %sts'), 1, 's99d param init slot')

    ; 循环后在调用点把形参槽 load 出来按值传给 f
    runner.eq(ir.contains('call %struct.s0 @f(%struct.s0 %st'), 1, 's99d call passes param struct')
    runner.eq(ir.contains('extractvalue %struct.s0 %st'), 1, 's99d read fields after call')
}

test-s99d-return-call = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nmk = () (r Point) {\n    r = Point { x: 5, y: 7 }\n}\n\ng = () (z i64) {\n    n = 0\n    (n < 3) {\n        n = n + 1\n    }\n    s = mk()\n    s.y = s.y + 1\n    z = s.x + s.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99d return-call unsup')

    ; 被调按值返 struct
    runner.eq(ir.contains('define %struct.s0 @mk()'), 1, 's99d mk ret sig')
    runner.eq(ir.contains('ret %struct.s0 %st'), 1, 's99d mk ret value')

    ; 调用方：call 按值接回 struct → 落槽 → load → insertvalue 改写 y → store 回槽
    runner.eq(ir.contains('call %struct.s0 @mk()'), 1, 's99d call returns struct')
    runner.eq(ir.contains('insertvalue %struct.s0 %st'), 1, 's99d caller mutates field')
    runner.eq(ir.contains('extractvalue %struct.s0 %st'), 1, 's99d read fields after mutate')
}

; ── s99e：结构體欄位型別擴充（str / f64 / 嵌套結構體）（M4-e 第四十五件續）──
; 證明：s99/s99b/s99c/s99d 只收 i64 欄位，本件把欄位型別擴到 str / f64 / 嵌套結構體。
;   關鍵在 h2m 側兩處：(1) `h2m-struct-register` 改兩遍——第一遍只登欄位「型別節點 id」，
;   第二遍 `h2m-struct-resolve` 等全部結構體名就位後再解析成型別碼（支持「欄位引用較後定義的結構體」）；
;   (2) `h2m-lower-expr` 補 `K-STRING-LITERAL` 分支發 `OP-STRCONST`（此前 str 字面量直落預設 mark）。
;   cg 側 MK/GET/SET/STALLOC/STSTORE/STLOAD 本就依 vty/cty 選 %str-long / %vc / %struct.sN，零改。
test-s99e-str-field = () {
    src = 'User {\n    id i64\n    name str\n}\n\nf = () (r str) {\n    u = User { id: 1, name: \'alice\' }\n    u.name = \'bob\'\n    r = u.name\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99e str-field unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, %str-long }'), 1, 's99e str field decl')

    ; MK：str 字面量落 %str-long 後 insertvalue 進結構體槽（索引 1）
    runner.eq(ir.contains('insertvalue %struct.s0 %sm2_0, %str-long %sv2, 1'), 1, 's99e MK str field')

    ; SET：把 name 欄位改成另一 %str-long
    runner.eq(ir.contains('insertvalue %struct.s0 %st3, %str-long %sv4, 1'), 1, 's99e SET str field')

    ; GET：從結構體讀 str 欄位（結果落 %sv 命名空間）
    runner.eq(ir.contains('extractvalue %struct.s0 %st5, 1'), 1, 's99e GET str field')
    runner.eq(ir.contains('ret %str-long %sv6'), 1, 's99e ret str')
}

test-s99e-f64-field = () {
    src = 'Rec {\n    a i64\n    b f64\n}\n\nf = () (r f64) {\n    x = Rec { a: 1, b: 2.5 }\n    r = x.b\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99e f64-field unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, double }'), 1, 's99e f64 field decl')
    runner.eq(ir.contains('insertvalue %struct.s0 %sm2_0, double %fd2, 1'), 1, 's99e MK f64 field')
    runner.eq(ir.contains('extractvalue %struct.s0 %st3, 1'), 1, 's99e GET f64 field')
    runner.eq(ir.contains('ret double %fd4'), 1, 's99e ret f64')
}

test-s99e-nested-struct-field = () {
    src = 'Point {\n    x i64\n    y i64\n}\n\nBox {\n    p Point\n    tag i64\n}\n\nf = () (r i64) {\n    b = Box { p: Point { x: 3, y: 4 }, tag: 9 }\n    r = b.p.x + b.p.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99e nested-field unsup')

    ; 嵌套結構體：Box 含 Point 欄位（定義序 Point 先於 Box，但兩遍註冊與序無關）
    runner.eq(ir.contains('%struct.s1 = type { %struct.s0, i64 }'), 1, 's99e nested struct decl')

    ; MK：嵌套結構體值 insertvalue 進外層槽（索引 0；首步以 zeroinitializer 起手）
    runner.eq(ir.contains('insertvalue %struct.s1 zeroinitializer, %struct.s0 %st3, 0'), 1, 's99e MK nested field')

    ; GET：先取 Point 欄位、再取內層 x / y
    runner.eq(ir.contains('extractvalue %struct.s1 %st5, 0'), 1, 's99e GET nested struct field')
    runner.eq(ir.contains('extractvalue %struct.s0 %st6, 0'), 1, 's99e GET inner x')
    runner.eq(ir.contains('extractvalue %struct.s0 %st8, 1'), 1, 's99e GET inner y')
    runner.eq(ir.contains('add i64 %v7, %v9'), 1, 's99e sum inner fields')
}

test-s99e-mixed-field = () {

    ; ⚠️ 嵌套結構體欄位特意放首位：MK 目前假設欄位值 id 連續（xa[k]+j），當某欄位值的
    ;   降級多分配了 id（如嵌套結構體字面量多分配內層欄位 id），非首欄位會讀到錯 id。
    ;   本用例把嵌套欄位置首，避開該既有缺陷（見 §5.3.4.ef 後續），證明三種欄位型別可共存。
    src = 'Point {\n    x i64\n    y i64\n}\n\nUser {\n    home Point\n    id i64\n    name str\n}\n\nf = () (r i64) {\n    u = User { home: Point { x: 1, y: 2 }, id: 7, name: \'amy\' }\n    u.name = \'ann\'\n    r = u.id + u.home.x\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99e mixed-field unsup')

    ; 單一結構體混合三種欄位型別：嵌套 %struct.s0 + i64 + %str-long
    runner.eq(ir.contains('%struct.s1 = type { %struct.s0, i64, %str-long }'), 1, 's99e mixed struct decl')

    ; MK：嵌套欄位在索引 0、str 字面量在索引 2
    runner.eq(ir.contains('insertvalue %struct.s1 zeroinitializer, %struct.s0 %st3, 0'), 1, 's99e MK nested field at idx 0')

    ; SET：把 str 欄位（索引 2）改成另一字面量
    runner.eq(ir.contains('insertvalue %struct.s1 %st6, %str-long %sv7, 2'), 1, 's99e SET str field at idx 2')

    ; GET：讀 i64 欄位（索引 1）與嵌套內層 x（索引 0 → %struct.s0 → 字段 0）
    runner.eq(ir.contains('extractvalue %struct.s1 %st8, 0'), 1, 's99e GET nested field at idx 0')
    runner.eq(ir.contains('extractvalue %struct.s0 %st10, 0'), 1, 's99e GET inner x')
}

; ── s99f：結構體欄位型別支援 []i64（vec 欄位）（M4-e 第四十六件續）──
; 證明：s99e 收 i64/str/f64/嵌套結構體欄位；本件把欄位型別擴到 []i64（vec）。
;   關鍵在 h2m 側一處：`h2m-tynode-code` 補 K-SLICE-TYPE → TY-VEC（僅收元素 i64，與 s62 形參口径一致）；
;   `h2m-struct-resolve` 調它解析欄位型別，故欄位自動落到 TY-VEC，cg 側 MK/GET/SET/STALLOC 零改
;   （cg-runtime-ty-name 把 TY-VEC → %vec，欄位就是一個 3 字 i64 值，按值搬移）。
;   ⚠️ 限制（M4-e 既有門禁，非本件引入）：
;     ① vec 返回不入形（L3164 `rb==0 && rc==TY-VEC -> bad=1`）⇒ 欄位值須由 []i64 形參注入，
;        不能本地構造 vec 字面量（無 %vec 槽、無 vec 字面量降級）；
;     ② 容器遍歷 `v <- xs` 只收裸識別符源（L2563/L2574），故 `v <- b.data` 不入形——
;        本件改用「extractvalue %vec 後作 %vec 實參傳給 []i64 形參函數」驗 GET + call-by-value；
;     ③ 元素非 i64 的 vec（[]str 等）不攜元素型別且會被 i64 helper 誤讀 ⇒ 欄位解析回 -1 计 unsup。
test-s99f-vec-field-mk = () {

    ; MK：以 []i64 形參 d 注入 vec 值，按值 insertvalue 進結構體欄位（索引 0）
    src = 'Buf {\n    data []i64\n    id i64\n}\n\nmk = (d []i64, id i64) (r Buf) {\n    r = Buf { data: d, id: id }\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99f vec-field MK unsup')

    ; 結構體布局：vec 欄位佔 %vec（3 字 i64 值）
    runner.eq(ir.contains('%struct.s0 = type { %vec, i64 }'), 1, 's99f vec field decl')

    ; 形參：[]i64 形參是 %vec、i64 形參是 i64
    runner.eq(ir.contains('define %struct.s0 @mk(%vec %vc1, i64 %v2)'), 1, 's99f mk sig')

    ; MK：vec 欄位在索引 0（insertvalue %vec），i64 欄位在索引 1
    runner.eq(ir.contains('insertvalue %struct.s0 zeroinitializer, %vec %vc1, 0'), 1, 's99f MK vec field at idx 0')
    runner.eq(ir.contains('insertvalue %struct.s0 %sm0_0, i64 %v2, 1'), 1, 's99f MK i64 field at idx 1')

    ; 返回含 vec 欄位的結構體（按值）
    runner.eq(ir.contains('ret %struct.s0 %st3'), 1, 's99f mk ret struct with vec field')
}

test-s99f-vec-field-get = () {

    ; GET：讀 vec 欄位（extractvalue %vec）→ 作 %vec 實參傳給 consume（其形參 v 是 []i64，裸識別符可遍歷）
    ; 驗 GET + call-by-value 傳 vec 欄位；避開 vec 返回門禁與「v <- b.data」裸識別符限制
    src = 'Buf {\n    data []i64\n    id i64\n}\n\nconsume = (v []i64) (r i64) {\n    r = 0\n    x <- v: {\n        r = r + x\n    }\n}\n\nsum = (b Buf) (r i64) {\n    r = consume(b.data)\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99f vec-field GET unsup')
    runner.eq(ir.contains('%struct.s0 = type { %vec, i64 }'), 1, 's99f get struct decl')

    ; consume 以 []i64 形參 v 遍歷（裸識別符源，s62 路徑）
    runner.eq(ir.contains('define i64 @consume(%vec %vc1)'), 1, 's99f consume sig')

    ; sum 收結構體形參 → GET vec 欄位（extractvalue %vec %st1, 0）→ %vc2
    runner.eq(ir.contains('define i64 @sum(%struct.s0 %st1)'), 1, 's99f sum sig')
    runner.eq(ir.contains('%vc2 = extractvalue %struct.s0 %st1, 0'), 1, 's99f GET vec field extractvalue')

    ; vec 欄位按值傳給 consume（%vec %vc2 實參）
    runner.eq(ir.contains('call i64 @consume(%vec %vc2)'), 1, 's99f pass vec field by value')
    runner.eq(ir.contains('ret i64 %v3'), 1, 's99f sum ret i64')
}

test-s99f-vec-field-gate = () {

    ; 門禁：元素非 i64 的 vec 欄位（[]str）不攜元素型別 ⇒ 欄位解析回 -1 ⇒ 整模組計 unsup 不產碼
    src = 'Buf {\n    data []str\n    id i64\n}\n\nmk = (id i64) (r Buf) {\n    r = Buf { id: id }\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup > 0, 1, 's99f vec-str-field counted unsup')
    runner.eq(ir.contains('define'), 0, 's99f vec-str-field no code')
}

; ── s99g：結構體 str 欄位 RC——MK 後緊接 OP-STRUCT-RETAIN（欄位掩碼由 h2m 設置）（M4-e 第四十七件續）──
; 證明：③str 欄位 RC 的「取得所有權」半邊——h2m 在結構體字面量 MK 後，對含 str 欄位的結構體
;   發 OP-STRUCT-RETAIN（bs[k]=欄位掩碼，bit j 置位 ⇔ 欄位 j 是 str）；cg 依掩碼對每個 str 欄位
;   call @nolang_rc_retain。純 h2m 改動（cg 的 OP-STRUCT-RETAIN/RELEASE 與 @nolang_rc_retain/release
;   早已就位）。無 str 欄位的結構體不發 retain。
;   釋放半邊已由 s99j（§5.3.4.ek）補上：函數退出時 h2m-emit-releases 對同一 %st 值發 OP-STRUCT-RELEASE（mem==0）。
test-s99g-struct-str-retain = () {

    ; str 欄位在索引 1 ⇒ 掩碼 = 1<<1 = 2；retain 必須抽欄位 1（非 0）
    src = 'User {\n    id i64\n    name str\n}\n\nf = () (r str) {\n    u = User { id: 1, name: \'alice\' }\n    r = u.name\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99g str-field retain unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, %str-long }'), 1, 's99g struct decl')

    ; MK：str 欄位在索引 1（insertvalue %str-long）
    runner.eq(ir.contains('insertvalue %struct.s0 %sm2_0, %str-long %sv2, 1'), 1, 's99g MK str field at idx 1')

    ; retain：抽欄位 1 → %str-long → data ptr(2) → call @nolang_rc_retain
    runner.eq(ir.contains('%rf3_1 = extractvalue %struct.s0 %st3, 1'), 1, 's99g retain extracts str field idx 1')
    runner.eq(ir.contains('%rp3_1 = extractvalue %str-long %rf3_1, 2'), 1, 's99g retain gets data ptr')
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp3_1)'), 1, 's99g retain call')
}

test-s99g-struct-mixed-mask = () {

    ; str 欄位在索引 2 ⇒ 掩碼 = 1<<2 = 4；retain 必須抽欄位 2（非 0/1），證明掩碼位位置正確
    src = 'Rec {\n    a i64\n    b i64\n    c str\n}\n\nf = () (r str) {\n    u = Rec { a: 1, b: 2, c: \'x\' }\n    r = u.c\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99g mixed-mask retain unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, i64, %str-long }'), 1, 's99g mixed struct decl')
    runner.eq(ir.contains('insertvalue %struct.s0 %sm3_1, %str-long %sv3, 2'), 1, 's99g MK str field at idx 2')

    ; 掩碼只置位 bit 2 ⇒ 只抽欄位 2 retain，不碰 a/b
    runner.eq(ir.contains('%rf4_2 = extractvalue %struct.s0 %st4, 2'), 1, 's99g retain extracts str field idx 2')
    runner.eq(ir.contains('%rp4_2 = extractvalue %str-long %rf4_2, 2'), 1, 's99g retain gets data ptr')
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp4_2)'), 1, 's99g retain call')
}

test-s99g-struct-no-retain = () {

    ; 無 str 欄位 ⇒ 掩碼 = 0 ⇒ 不發任何 OP-STRUCT-RETAIN
    src = 'Point {\n    x i64\n    y i64\n}\n\nf = () (r i64) {\n    p = Point { x: 1, y: 2 }\n    r = p.x + p.y\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99g no-str unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, i64 }'), 1, 's99g no-str struct decl')

    ; 關鍵：不含任何 retain 呼叫（str 欄位 RC 只對含 str 的結構體生效）
    runner.eq(ir.contains('call void @nolang_rc_retain('), 0, 's99g no retain for non-str struct')
}

; ── s99i：vec 欄位就地索引 b.data[i] / 本地 vec 變量 v[i]（M4-e 第四十九件續）──
; 核心：h2m-lower-expr 新增 K-INDEX-EXPRESSION 分支——base 降級出 %vec 值 id 後發 OP-VECGET 取第 i 個 i64 元素；
;   base 須是 TY-VEC（[]i64 欄位 / vec 形參 / mem==0 下綁定的 vec 局部），其餘型別（str/struct/arr）計 unsup。
;   cg 早已支援 OP-VECGET（→ call i64 @vec_get_i64(%vec, i64)），本件是純 h2m 改動。
test-s99i-vec-index-param = () {

    ; 本地 vec 變量（形參 v: []i64）就地索引：r = v[i]
    src = 'consume = (v []i64, i i64) (r i64) {\n    r = v[i]\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99i vec param index unsup')
    runner.eq(ir.contains('define i64 @consume(%vec %vc1'), 1, 's99i consume sig')

    ; 就地索引：vec 形參 %vc1 直接 OP-VECGET，下標是形參 i（%v2），結果 i64 %v3
    runner.eq(ir.contains('call i64 @vec_get_i64(%vec %vc1, i64 %v2)'), 1, 's99i vec param index VECGET')
    runner.eq(ir.contains('ret i64 %v3'), 1, 's99i consume ret i64')
}

test-s99i-vec-field-index = () {

    ; vec 欄位就地索引：r = b.data[i]（結構體欄位 GET + 索引，兩步皆 %vec 值流轉，無槽）
    src = 'Buf {\n    data []i64\n    id i64\n}\n\nconsume = (v []i64, i i64) (r i64) {\n    r = v[i]\n}\n\nsum = (b Buf, i i64) (r i64) {\n    r = b.data[i]\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99i vec field index unsup')
    runner.eq(ir.contains('%struct.s0 = type { %vec, i64 }'), 1, 's99i struct decl')
    runner.eq(ir.contains('define i64 @sum(%struct.s0 %st1'), 1, 's99i sum sig')

    ; b.data → OP-STRUCT-GET 抽 %vec（%vc3 = extractvalue %struct.s0 %st1, 0）
    runner.eq(ir.contains('%vc3 = extractvalue %struct.s0 %st1, 0'), 1, 's99i GET vec field')

    ; 就地索引：被抽出的 %vc3 直接 OP-VECGET，下標是形參 i（%v2）
    runner.eq(ir.contains('call i64 @vec_get_i64(%vec %vc3, i64 %v2)'), 1, 's99i vec field index VECGET')
    runner.eq(ir.contains('ret i64 %v4'), 1, 's99i sum ret i64')
}

test-s99i-vec-local-bind = () {

    ; 本地 vec 變量：d = b.data；r = d[i]（mem==0 直綁值 id，無槽；d 綁定到 GET 抽出的 %vec）
    src = 'Buf {\n    data []i64\n    id i64\n}\n\ng = (b Buf, i i64) (r i64) {\n    d = b.data\n    r = d[i]\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99i vec local bind unsup')
    runner.eq(ir.contains('define i64 @g(%struct.s0 %st1'), 1, 's99i g sig')

    ; d = b.data → GET 抽 %vec（%vc3）
    runner.eq(ir.contains('%vc3 = extractvalue %struct.s0 %st1, 0'), 1, 's99i local bind GET')

    ; r = d[i] → 直接對綁定的 %vc3 做 OP-VECGET（下標 %v2）
    runner.eq(ir.contains('call i64 @vec_get_i64(%vec %vc3, i64 %v2)'), 1, 's99i local bind VECGET')
    runner.eq(ir.contains('ret i64 %v4'), 1, 's99i g ret i64')
}

test-s99i-index-scalar-gate = () {

    ; 門禁：對非 vec 基底索引（x 是 i64 標量）→ 計 unsup，不產 OP-VECGET
    src = 'f = (x i64, i i64) (r i64) {\n    r = x[i]\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup > 0, 1, 's99i scalar index counted unsup')
    runner.eq(ir.contains('call i64 @vec_get_i64('), 0, 's99i no VECGET for scalar base')
}

; ── s99j：結構體 str 欄位 RC——scope-exit 釋放半邊（與 s99g 取得所有權配對）（M4-e 第五十件續）──
; 核心：s99g 在 MK 後發 OP-STRUCT-RETAIN，本件在函數退出時由 h2m-emit-releases 對同一 %st 值發
;   OP-STRUCT-RELEASE（欄位掩碼同 s99g）。跳過「已被回傳佔用」的值防雙重釋放。僅 mem==0 放行。
;   ⚠️ 運行時驗證受 15w45dqk 門禁阻塞（同 s99h/s99i），IR 文本斷言為本件主要驗證手段。
test-s99j-struct-release = () {

    ; 本地結構體（非回傳值，含 str 欄位@idx1 ⇒ 掩碼=2）：MK 取得所有權 + scope-exit 釋放
    src = 'User {\n    id i64\n    name str\n}\n\nf = () (r i64) {\n    u = User { id: 1, name: \'alice\' }\n    r = u.id\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99j struct release unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, %str-long }'), 1, 's99j struct decl')

    ; 取得所有權（s99g）：retain 抽欄位 1
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp'), 1, 's99j retain still emitted')

    ; 釋放半邊（本件）：同一值退出時發 release（retain 與 release 各一次，掩碼同 s99g）
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %rp'), 1, 's99j release emitted at scope exit')
}

test-s99j-struct-ret-no-release = () {

    ; 結構體即回傳值（r: User）：RETAIN 仍發（取得所有權），但 scope-exit 釋放須跳過回傳值防雙重釋放
    src = 'User {\n    id i64\n    name str\n}\n\nf = () (r User) {\n    r = User { id: 1, name: \'alice\' }\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99j ret struct unsup')

    ; 取得所有權仍發
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp'), 1, 's99j retain emitted for returned struct')

    ; 關鍵：回傳值被 skip ⇒ 不得發 release（否則呼叫方 double-free）
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %rp'), 0, 's99j NO release for returned struct')
}

test-s99j-struct-mixed-release = () {

    ; 混合掩碼（str@idx2 ⇒ 掩碼=4）：release 須抽欄位 2（與 retain 同掩碼），證明掩碼正確傳遞到釋放側
    src = 'Rec {\n    a i64\n    b i64\n    c str\n}\n\nf = () (r i64) {\n    u = Rec { a: 1, b: 2, c: \'x\' }\n    r = u.a\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99j mixed-mask release unsup')
    runner.eq(ir.contains('%struct.s0 = type { i64, i64, %str-long }'), 1, 's99j mixed struct decl')
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp'), 1, 's99j retain emitted (mask 4)')

    ; 掩碼只置位 bit 2 ⇒ retain 與 release 皆只抽欄位 2（釋放半邊與取得所有權半邊同掩碼，結構上由 rlsm 保證）
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %rp'), 1, 's99j mixed-mask release emitted')
}

; ── 单个输入参数：形参占值 id 1，body 从 id 2 起 ──
; 证明 s56 的签名侧降级：不建 alloca，名字直接绑到形参 id（与 §3.11 重绑模型一致）。
test-param-one = () {
    src = 'p1 = (x i64) (r i64) {\n    r = x + 1\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'param1 unsup')
    runner.eq(ir.contains('define i64 @p1(i64 %v1)'), 1, 'param1 sig')
    runner.eq(ir.contains('%v2 = add i64 0, 1'), 1, 'param1 const starts at 2')
    runner.eq(ir.contains('%v3 = add i64 %v1, %v2'), 1, 'param1 body uses %v1')
    runner.eq(ir.contains('ret i64 %v3'), 1, 'param1 ret')
}

; ── 两个输入参数：形参序 = 值 id 序 ──
test-param-two = () {
    src = 'p2 = (x i64, y i64) (r i64) {\n    r = x * y\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'param2 unsup')
    runner.eq(ir.contains('define i64 @p2(i64 %v1, i64 %v2)'), 1, 'param2 sig')
    runner.eq(ir.contains('%v3 = mul i64 %v1, %v2'), 1, 'param2 body')
    runner.eq(ir.contains('alloca'), 0, 'param2 no alloca')
}

; ── str 形参：签名侧按型别选命名空间（值语义仍限 i64）──
test-param-str = () {
    src = 'sp = (s str) (r i64) {\n    r = 1\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'pstr unsup')
    runner.eq(ir.contains('define i64 @sp(%str-long %sv1)'), 1, 'pstr sig')
    runner.eq(ir.contains('%v2 = add i64 0, 1'), 1, 'pstr body id after param')
    runner.eq(ir.contains('ret i64 %v2'), 1, 'pstr ret')

    ; 鉴别力：str 形参不得误入 %v 命名空间
    runner.eq(ir.contains('i64 %v1'), 0, 'pstr no i64 param')
}

; ── 输出参数的型别决定 retty（str 透传，不新增 id）──
test-ret-str = () {
    src = 'stw = (s str) (t str) {\n    t = s\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rets unsup')
    runner.eq(ir.contains('define %str-long @stw(%str-long %sv1)'), 1, 'rets sig')
    runner.eq(ir.contains('ret %str-long %sv1'), 1, 'rets ret value')

    ; 鉴别力：本函数只有一个值 id（形参），body 不产生新指令
    runner.eq(ir.contains('%v'), 0, 'rets no i64 id')
}

; ── 零参调用 + 前向引用（调用者写在被调用者之前）──
; 证明前置 pass 先登记全模块签名，调用点能查到返回型别与 arity。
test-call-fwd = () {
    src = 'cc = () (r i64) {\n    r = cf0()\n}\n\ncf0 = () (r i64) {\n    r = 9\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'callfwd unsup')
    runner.eq(ir.contains('%v1 = call i64 @cf0()'), 1, 'callfwd zero arg')
    runner.eq(ir.contains('ret i64 %v1'), 1, 'callfwd ret')
    runner.eq(ir.contains('define i64 @cf0()'), 1, 'callfwd callee emitted')
    runner.eq(ir.contains('%v1 = add i64 0, 9'), 1, 'callfwd callee body')
}

; ── 单参调用 + 两参连续调用 ──
test-call-args = () {
    src = 'dbl = (x i64) (r i64) {\n    r = x + x\n}\n\nad = (x i64, y i64) (r i64) {\n    r = x + y\n}\n\nm1 = () (r i64) {\n    a = 3\n    r = dbl(a)\n}\n\nm2 = () (r i64) {\n    a = 1\n    b = 2\n    r = ad(a, b)\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'callargs unsup')
    runner.eq(ir.contains('define i64 @dbl(i64 %v1)'), 1, 'callargs dbl sig')
    runner.eq(ir.contains('%v2 = add i64 %v1, %v1'), 1, 'callargs dbl body')
    runner.eq(ir.contains('%v2 = call i64 @dbl(i64 %v1)'), 1, 'callargs one arg')
    runner.eq(ir.contains('%v3 = call i64 @ad(i64 %v1, i64 %v2)'), 1, 'callargs two args')

    ; 鉴别力：多参实参必须按序（反序则 IR 文本不同）
    runner.eq(ir.contains('@ad(i64 %v2, i64 %v1)'), 0, 'callargs order not swapped')
}

; ── 调用侧门禁：arity 不符 / 未知被调用者 / 返回型别不符 都计 unsup ──
; ⚠️ s64 前这里还钉「实参 id 不连续计 unsup」；侧池 args 落地后该门禁摘除（§11 B16 销帐），
;   不连续形制翻转为正向用例 test-call-s64-*。
test-call-gate = () {

    ; 次位实参是算式（旧契约下实参 1 与 4 不连续 ⇒ 撞门禁）：s64 侧池寻址后放行
    src-gap = 'ad = (x i64, y i64) (r i64) {\n    r = x + y\n}\n\nk = () (r i64) {\n    a = 1\n    r = ad(a, 2 + 3)\n}\n'
    t1 = ast.make()
    p1 = ps.new(src-gap.to-bytes())
    r1 = ps.parse(t1, p1)
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup, 0, 'gap not counted (s64 pool)')
    runner.eq(ir1.contains('%v5 = call i64 @ad(i64 %v1, i64 %v4)'), 1, 'gap args via pool')

    ; arity 不符：dbl 只要一个参数
    src-ary = 'dbl = (x i64) (r i64) {\n    r = x + x\n}\n\nk = () (r i64) {\n    r = dbl(1, 2)\n}\n'
    t2 = ast.make()
    p2 = ps.new(src-ary.to-bytes())
    r2 = ps.parse(t2, p2)
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'arity counted')
    runner.eq(ir2.contains('call i64 @dbl'), 0, 'arity no call code')

    ; 未知被调用者（未在本模块定义）
    src-unk = 'k = () (r i64) {\n    r = zzz(1)\n}\n'
    t3 = ast.make()
    p3 = ps.new(src-unk.to-bytes())
    r3 = ps.parse(t3, p3)
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'unknown callee counted')
    runner.eq(ir3.contains('call'), 0, 'unknown callee no code')

    ; 返回值型别不符：a 是 i64，却赋给声明为 str 的输出参数
    src-rt = 'rr = (a i64) (s str) {\n    s = a\n}\n'
    t4 = ast.make()
    p4 = ps.new(src-rt.to-bytes())
    r4 = ps.parse(t4, p4)
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)
    runner.eq(agg4.unsup > 0, 1, 'rettype counted')
    runner.eq(ir4.contains('define'), 0, 'rettype no code')
}

; ── s64 正向形制：实参值 id 任意散布（侧池寻址）──────────
; 每个用例的锚点 IR 直取自 tmp/s64-dump-after2.txt（探针实测）。

; 三实参、后两个是算式：值 id 1/3/5 跳号（旧契约 unsup=2）
test-call-s64-scatter = () {
    src = 'f = (a i64, b i64, c i64) (r i64) {\n    r = a + b + c\n}\n\ng = (x i64) (r i64) {\n    t = f(x, x * 2, x - 3)\n    r = t\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's64-scatter unsup')
    runner.eq(ir.contains('%v6 = call i64 @f(i64 %v1, i64 %v3, i64 %v5)'), 1, 's64-scatter scatter ids')
    runner.eq(ir.contains('call i64 @f(i64 %v1, i64 %v2)'), 0, 's64-scatter not contiguous assumption')
}

; 单嵌套调用实参：内层降期自己入池，外层基址必须整段入池后才取（回归挤偏 bug）
test-call-s64-nested = () {
    src = 'f = (a i64, b i64) (r i64) {\n    r = a + b\n}\n\nh = (x i64) (r i64) {\n    r = x\n}\n\ng = () (r i64) {\n    t = f(h(3), 1)\n    r = t\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's64-nested unsup')
    runner.eq(ir.contains('%v4 = call i64 @f(i64 %v2, i64 %v3)'), 1, 's64-nested base not skewed')
    runner.eq(ir.contains('call i64 @f(i64 %v1, i64 %v2)'), 0, 's64-nested skew regression')
}

; 双嵌套调用同作实参：内层各自入池 ⇒ 外层池段 [2,4] 值 id 跳号且基址非 0
test-call-s64-double-nested = () {
    src = 'f = (a i64, b i64) (r i64) {\n    r = a + b\n}\n\nh = (x i64) (r i64) {\n    r = x\n}\n\nk = (y i64) (r i64) {\n    r = y + 1\n}\n\ng = () (r i64) {\n    t = f(h(5), k(6))\n    r = t\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's64-dbl unsup')
    runner.eq(ir.contains('%v2 = call i64 @h(i64 %v1)'), 1, 's64-dbl inner h')
    runner.eq(ir.contains('%v4 = call i64 @k(i64 %v3)'), 1, 's64-dbl inner k')
    runner.eq(ir.contains('%v5 = call i64 @f(i64 %v2, i64 %v4)'), 1, 's64-dbl outer scatter')
}

; str 混排实参：型别按值 id 查 vty，与池位置无关
test-call-s64-str = () {
    src = 'f = (s str, n i64) (r i64) {\n    r = n\n}\n\ng = (a str) (r i64) {\n    t = f(a, 4)\n    r = t\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's64-str unsup')
    runner.eq(ir.contains('%v3 = call i64 @f(%str-long %sv1, i64 %v2)'), 1, 's64-str typed args')
}

; 循环体内算式实参（mem 模式）：LOAD＋ADD 混排，旧契约 unsup=1
test-call-s64-loop = () {
    src = 'f = (a i64, b i64) (r i64) {\n    r = a + b\n}\n\ng = (n i64) (r i64) {\n    r = 0\n    i <- [0..3): {\n        u = f(i, i + 1)\n        r = r + u\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's64-loop unsup')
    runner.eq(ir.contains('%v27 = call i64 @f(i64 %v23, i64 %v26)'), 1, 's64-loop body call')
}

test-prec()
test-var()
test-rebind()
test-group()
test-multi-func()
test-param-one()
test-param-two()
test-param-str()
test-ret-str()
test-call-fwd()
test-call-args()

; ═══ s57：控制流降级 ═══════════════════════════════════════════

; 跳块写回 ⇒ 体内有分支/循环时全部局部量（含形参）落 entry alloca 槽（-O0 风格）
test-flow-if = () {
    src = 'f = (n i64) (r i64) {\n    r = 0\n    n > 0 -> r = n\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'if unsup')

    ; entry：两个槽（n ← %v1、r 零初始化）——s55/s56 的直线式从来不发 alloca，本件是第一处
    runner.eq(ir.contains('%s2 = alloca i64'), 1, 'if slot n')
    runner.eq(ir.contains('store i64 %v1, i64* %s2'), 1, 'if param into slot')
    runner.eq(ir.contains('%s4 = alloca i64'), 1, 'if slot r')

    ; 条件侧：load 取 n → icmp sgt → zext → condbr（非零为真）
    runner.eq(ir.contains('%v7 = load i64, i64* %s2'), 1, 'if cond loads slot')
    runner.eq(ir.contains('%c11 = icmp sgt i64 %v7, %v8'), 1, 'if icmp')
    runner.eq(ir.contains('%v9 = zext i1 %c11 to i64'), 1, 'if zext')

    ; 无 else 臂 ⇒ 假路直接接汇聚块（bb3），不留 bb2
    runner.eq(ir.contains('br i1 %c12, label %bb1, label %bb3'), 1, 'if condbr skips else')
    runner.eq(ir.contains('bb2:'), 0, 'if no empty else block')
    runner.eq(ir.contains('bb1:'), 1, 'if then label')
    runner.eq(ir.contains('bb3:'), 1, 'if merge label')

    ; then 臂写回槽并无条件回汇聚块；汇聚块 load 后才 ret（而不是 ret 一个 then 块的 SSA 名）
    runner.eq(ir.contains('%v10 = load i64, i64* %s2'), 1, 'if arm loads n')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'if arm stores r')
    runner.eq(ir.contains('br label %bb3'), 1, 'if arm br merge')
    runner.eq(ir.contains('%v11 = load i64, i64* %s4'), 1, 'if merge loads r')
    runner.eq(ir.contains('ret i64 %v11'), 1, 'if ret from load')

    ; 鉴别力：汇聚块不能拿 then 块内部的 %v10 直接 ret（跨块引用会被 opt 的支配树拒）
    runner.eq(ir.contains('ret i64 %v10'), 0, 'if no cross-block ret')
}

; ── 前置条件循环：(cond) { body } ⇒ entry→hdr、hdr→(body|exit)、body→hdr 回边 ──
test-flow-loop = () {
    src = 'g = (n i64) (r i64) {\n    r = 0\n    (n > 0) {\n        r = r + 1\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'loop unsup')

    ; entry 无条件跳到条件块（hdr = bb1），不在 entry 求值条件（回边要落回它）
    runner.eq(ir.contains('br label %bb1'), 1, 'loop entry br hdr')
    runner.eq(ir.contains('bb1:'), 1, 'loop hdr label')
    runner.eq(ir.contains('br i1 %c13, label %bb2, label %bb3'), 1, 'loop condbr body/exit')

    ; 鉴别力（本件核心）：体内 `r = r + 1` 必须 load 槽而不是引用 entry 旧值——
    ;   若退回 SSA 重绑语义，这里会变成 `add i64 %v6, %v11`（永远只加第一轮的值）
    runner.eq(ir.contains('%v10 = load i64, i64* %s4'), 1, 'loop body loads r')
    runner.eq(ir.contains('%v12 = add i64 %v10, %v11'), 1, 'loop body adds loaded')
    runner.eq(ir.contains('%v12 = add i64 %v6, %v11'), 0, 'loop body not stale ssa')
    runner.eq(ir.contains('store i64 %v12, i64* %s4'), 1, 'loop body stores r')

    ; 回边 + 后继落在 exit 块
    runner.eq(ir.contains('br label %bb1\n'), 1, 'loop back edge')
    runner.eq(ir.contains('bb3:'), 1, 'loop exit label')
    runner.eq(ir.contains('ret i64 %v13'), 1, 'loop ret in exit block')
}

; ── 比较家族：六个比较符各自落到对应的 icmp predicate ──
test-flow-cmp = () {
    src = 'a = (n i64) (r i64) {\n    r = 0\n    n < 5 -> r = 1\n    n <= 5 -> r = 2\n    n >= 5 -> r = 3\n    n == 5 -> r = 4\n    n != 5 -> r = 5\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cmp unsup')

    ; 五条 guard 各一条 icmp；谓词不能串位（slt 写反成 sgt 就全反了）
    runner.eq(ir.contains('icmp slt i64'), 1, 'cmp lt')
    runner.eq(ir.contains('icmp sle i64'), 1, 'cmp le')
    runner.eq(ir.contains('icmp sge i64'), 1, 'cmp ge')
    runner.eq(ir.contains('icmp eq i64'), 1, 'cmp eq')
    runner.eq(ir.contains('icmp ne i64 %v'), 1, 'cmp ne')
    runner.eq(ir.contains('icmp ule i64'), 0, 'cmp no unsigned leak')

    ; 5 条 guard ⇒ 5 个 then 块（bb1/4/7/10/13 形式：每条 if 新开 3 个 id，无 else 时中间那个不落地）
    runner.eq(ir.contains('bb13:'), 1, 'cmp fifth then block')
    runner.eq(ir.contains('bb14:'), 0, 'cmp block count stops')
}

; 合成 AST 造 else 臂：`sf = (n i64) (r i64) { n > 0 -> { r = 7 } else { r = 9 } }`
; ⚠️ 真实源路造不出这个形状（`{c -> a -> b}` 被 ps.no 建成 K-SURFACE-MATCH，臂群在 aux 阵），
;   而 h2m-lower-if 按 Go/HIR 的 IfExpression 三 kid 形制写，故用 ast.add/kid-add 直接搭同形节点
mk-ident = (t ast, name str) (x i64) {
    x = ast.add(t, asp.K-IDENTIFIER)
    ast.set-slot(t, x, 0, ast.put-str(t, name))
}

mk-int = (t ast, lit str) (x i64) {
    x = ast.add(t, asp.K-INTEGER-LITERAL)
    ast.set-slot(t, x, 0, ast.put-str(t, lit))
}

; InfixExpression：kids = [左][右]，s0 = 运算符文本
mk-infix = (t ast, op str, a i64, b i64) (x i64) {
    x = ast.add(t, asp.K-INFIX-EXPRESSION)
    ast.kid-add(t, x, a)
    ast.kid-add(t, x, b)
    ast.set-slot(t, x, 0, ast.put-str(t, op))
}

; BlockStatement：kids = 单条语句（本件合成用例只需一条 let）
mk-block1 = (t ast, s i64) (x i64) {
    x = ast.add(t, asp.K-BLOCK-STATEMENT)
    ast.kid-add(t, x, s)
}

; LetStatement：kids = [型别 0][值]，s0 = 名字（与实测解析形状一致）
mk-let-int = (t ast, name str, lit str) (x i64) {
    v = mk-int(t, lit)
    x = ast.add(t, asp.K-LET-STATEMENT)
    ast.kid-add(t, x, 0)
    ast.kid-add(t, x, v)
    ast.set-slot(t, x, 0, ast.put-str(t, name))
}

; Parameter：kids = [K-NAMED-TYPE][默认值 0]，s0 = 名字
mk-param = (t ast, name str, ty str) (x i64) {
    tn = ast.add(t, asp.K-NAMED-TYPE)
    ast.set-slot(t, tn, 0, ast.put-str(t, ty))
    x = ast.add(t, asp.K-PARAMETER)
    ast.kid-add(t, x, tn)
    ast.kid-add(t, x, 0)
    ast.set-slot(t, x, 0, ast.put-str(t, name))
}

test-flow-else-syn = () {
    t = ast.make()

    ; 自下而上建，且【每个子节点先落具名局部】再 kid-add：实测（s57）把调用直接嵌在
    ;   另一调用的实参位（ast.kid-add(t, iff, mk-block1(t, then-s))）会传错值——拿到的是
    ;   内层函数的【输入参数】而非它的【输出参数】（本档只做记录，依 AGENTS.md §2 不改他人代码）
    idn = mk-ident(t, 'n')
    iz = mk-int(t, '0')
    cond = mk-infix(t, '>', idn, iz)
    then-s = mk-let-int(t, 'r', '7')
    then-blk = mk-block1(t, then-s)
    else-s = mk-let-int(t, 'r', '9')
    else-blk = mk-block1(t, else-s)
    iff = ast.add(t, asp.K-IF-EXPRESSION)
    ast.kid-add(t, iff, cond)
    ast.kid-add(t, iff, then-blk)
    ast.kid-add(t, iff, else-blk)
    pin = mk-param(t, 'n', 'i64')
    pout = mk-param(t, 'r', 'i64')
    body = mk-block1(t, iff)
    fd = ast.add(t, asp.K-FUNCTION-DEFINITION)
    ast.kid-add(t, fd, pin)
    ast.kid-add(t, fd, pout)
    ast.kid-add(t, fd, body)
    ast.set-sig(t, fd, 0, 1, 1)
    ast.set-slot(t, fd, 0, ast.put-str(t, 'sf'))
    pr = ast.add(t, asp.K-PROGRAM)
    ast.kid-add(t, pr, fd)
    ast.set-count(t, pr, 0, 1)

    agg = h2m-new()
    ir = h2m-lower-program(t, agg, pr)

    runner.eq(agg.unsup, 0, 'else-syn unsup')
    runner.eq(ir.contains('define i64 @sf(i64 %v1)'), 1, 'else-syn define')

    ; 有 else 臂 ⇒ 假路落 bb2（与无 else 时直落汇聚块形成对照），三块都落地
    runner.eq(ir.contains('br i1 %c10, label %bb1, label %bb2'), 1, 'else-syn condbr both arms')
    runner.eq(ir.contains('bb2:'), 1, 'else-syn else block emitted')
    runner.eq(ir.contains('bb3:'), 1, 'else-syn merge block emitted')

    ; 两臂各写自己的常量进同一槽 %s4，各自无条件回汇聚块；汇聚块只 load 一次
    runner.eq(ir.contains('%v9 = add i64 0, 7'), 1, 'else-syn then const 7')
    runner.eq(ir.contains('store i64 %v9, i64* %s4'), 1, 'else-syn then stores 7')
    runner.eq(ir.contains('%v10 = add i64 0, 9'), 1, 'else-syn else const 9')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'else-syn else stores 9')
    runner.eq(ir.contains('br label %bb3'), 1, 'else-syn arm br merge')
    runner.eq(ir.contains('%v11 = load i64, i64* %s4'), 1, 'else-syn merge loads')
    runner.eq(ir.contains('ret i64 %v11'), 1, 'else-syn ret loaded')

    ; 鉴别力：任一臂自己的 SSA 名都不能被 ret（跨块引用会被 opt 支配树拒）
    runner.eq(ir.contains('ret i64 %v9'), 0, 'else-syn no cross-block ret then')
    runner.eq(ir.contains('ret i64 %v10'), 0, 'else-syn no cross-block ret else')
}

; ── s58：花括号短路链（K-SURFACE-MATCH）三臂含 wildcard──
; 实测量：臂体块 bb2/bb4/bb5 各写自己的常量进同一槽 %s4 并无条件回汇聚块 bb1；第二臂的判定落 bb3
test-flow-chain3 = () {
    src = 'f = (n i64) (r i64) {\n    r = 0\n    {\n        n > 3 -> r = 1\n        n > 1 -> { r = 2 }\n        -> r = 3\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'chain3 unsup')
    runner.eq(ir.contains('define i64 @f(i64 %v1)'), 1, 'chain3 define')

    ; 逐臂一条 CONDBR：真路进臂体，假路进下一臂的判定块（wildcard 臂就是那个假路块）
    runner.eq(ir.contains('br i1 %c12, label %bb2, label %bb3'), 1, 'chain3 arm1 condbr to arm2 test')
    runner.eq(ir.contains('br i1 %c19, label %bb4, label %bb5'), 1, 'chain3 arm2 condbr to wildcard')

    ; 三臂各写自己的常量到同一槽（跳块传值靠槽，不靠 SSA 名）
    runner.eq(ir.contains('%v10 = add i64 0, 1'), 1, 'chain3 arm1 const')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'chain3 arm1 store')
    runner.eq(ir.contains('%v14 = add i64 0, 2'), 1, 'chain3 arm2 const')
    runner.eq(ir.contains('store i64 %v14, i64* %s4'), 1, 'chain3 arm2 store')
    runner.eq(ir.contains('%v15 = add i64 0, 3'), 1, 'chain3 wildcard const')
    runner.eq(ir.contains('store i64 %v15, i64* %s4'), 1, 'chain3 wildcard store')

    ; 汇聚块只读一次槽；每臂都无条件跳回它（整块形制逐段钉住）
    runner.eq(ir.contains('bb2:\n\t%v10 = add i64 0, 1\n\tstore i64 %v10, i64* %s4\n\tbr label %bb1'), 1, 'chain3 arm1 block shape')
    runner.eq(ir.contains('bb5:\n\t%v15 = add i64 0, 3\n\tstore i64 %v15, i64* %s4\n\tbr label %bb1'), 1, 'chain3 wildcard block shape')
    runner.eq(ir.contains('bb1:\n\t%v16 = load i64, i64* %s4\n\tret i64 %v16'), 1, 'chain3 merge block shape')
    runner.eq(ir.contains('%v16 = load i64, i64* %s4'), 1, 'chain3 merge loads')
    runner.eq(ir.contains('ret i64 %v16'), 1, 'chain3 ret loaded')

    ; 鉴别力：块数恰为 entry + bb1..bb5（多开一块就是假路指了空块）；臂内 SSA 名不得被 ret
    runner.eq(ir.contains('bb6:'), 0, 'chain3 no spare block')
    runner.eq(ir.contains('ret i64 %v10'), 0, 'chain3 no cross-block ret')
}

; ── s58：无 wildcard 的两臂链——最后一臂的假路直接落汇聚块，不留空判定块──
test-flow-chain-nowild = () {
    src = 'g = (n i64) (r i64) {\n    r = 7\n    {\n        n > 3 -> r = 1\n        n > 1 -> r = 2\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'nowild unsup')
    runner.eq(ir.contains('br i1 %c12, label %bb2, label %bb3'), 1, 'nowild arm1 condbr arm2 test')
    runner.eq(ir.contains('br i1 %c19, label %bb4, label %bb1'), 1, 'nowild last arm false to merge')
    runner.eq(ir.contains('bb5:'), 0, 'nowild no empty test block')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'nowild arm1 store')
    runner.eq(ir.contains('store i64 %v14, i64* %s4'), 1, 'nowild arm2 store')
    runner.eq(ir.contains('ret i64 %v15'), 1, 'nowild ret loaded')
}

; ── s58：单 wildcard 臂链——无条件判定，臂体直落当前块，整链不应出现任何 icmp──
test-flow-chain-wild1 = () {
    src = 'w = (n i64) (r i64) {\n    r = 5\n    {\n        -> r = 9\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'wild1 unsup')
    runner.eq(ir.contains('store i64 %v7, i64* %s4'), 1, 'wild1 body in entry')
    runner.eq(ir.contains('br label %bb1'), 1, 'wild1 br merge')
    runner.eq(ir.contains('%v8 = load i64, i64* %s4'), 1, 'wild1 merge loads')
    runner.eq(ir.contains('ret i64 %v8'), 1, 'wild1 ret loaded')
    runner.eq(ir.contains('icmp'), 0, 'wild1 no condition evaluated')
    runner.eq(ir.contains('br i1'), 0, 'wild1 no condbr')
}

; ── s58：循环体内的链——链的汇聚块只拿到循环的回边（连续段纪律的叠块例）──
test-flow-chain-nest = () {
    src = 'h = (n i64) (r i64) {\n    r = 0\n    (r < 10) {\n        {\n            r > 5 -> r = r + 3\n            -> r = r + 1\n        }\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'nest unsup')
    runner.eq(ir.contains('br i1 %c13, label %bb2, label %bb3'), 1, 'nest loop condbr')
    runner.eq(ir.contains('br i1 %c17, label %bb5, label %bb6'), 1, 'nest chain condbr')
    runner.eq(ir.contains('store i64 %v15, i64* %s4'), 1, 'nest arm1 store')
    runner.eq(ir.contains('store i64 %v18, i64* %s4'), 1, 'nest wildcard store')

    ; 链的汇聚块 bb4 既不算条件也不写值，只拿到循环回边——证明块序合法
    runner.eq(ir.contains('bb4:\n\tbr label %bb1'), 1, 'nest merge carries back edge')
    runner.eq(ir.contains('bb7:'), 0, 'nest no spare block')
    runner.eq(ir.contains('ret i64 %v19'), 1, 'nest exit ret')
}

; ── s103：值位 SurfaceMatch（`r = { c -> 1  -> 0 }`）——逐臂 STORE 进 entry 结果槽、汇聚块 LOAD ──
; 槽位实测：%s2 = 形参 n、%s4 = 合成结果槽 @smv<let-id>、%s6 = 输出参 r 的槽。
;   结果槽必须【独立于】目标变量槽：两者合一的话，无兜底臂且全不命中时会读到 r 的旧值
;   而不是 Go 权威的零初始化 0。
test-smv-wild3 = () {
    src = 'v = (n i64) (r i64) {\n    r = {\n        n > 3 -> 1\n        n > 1 -> 2\n        -> 3\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'smv-wild3 unsup')
    runner.eq(ir.contains('define i64 @v(i64 %v1)'), 1, 'smv-wild3 define')

    ; 三颗槽：形参 / 合成结果槽 / 输出参——结果槽是中间那颗
    runner.eq(ir.contains('%s4 = alloca i64'), 1, 'smv-wild3 result slot')
    runner.eq(ir.contains('%s6 = alloca i64'), 1, 'smv-wild3 out slot')

    ; 逐臂：先算臂值，再 STORE 进结果槽，再无条 BR 回汇聚块
    runner.eq(ir.contains('bb2:\n\t%v11 = add i64 0, 1\n\tstore i64 %v11, i64* %s4\n\tbr label %bb1'), 1, 'smv-wild3 arm1 block')
    runner.eq(ir.contains('bb4:\n\t%v15 = add i64 0, 2\n\tstore i64 %v15, i64* %s4\n\tbr label %bb1'), 1, 'smv-wild3 arm2 block')
    runner.eq(ir.contains('bb5:\n\t%v16 = add i64 0, 3\n\tstore i64 %v16, i64* %s4\n\tbr label %bb1'), 1, 'smv-wild3 wildcard block')

    ; 汇聚块只读一次槽，再写进目标变量槽；RET 取的是目标变量槽的读值
    runner.eq(ir.contains('bb1:\n\t%v17 = load i64, i64* %s4\n\tstore i64 %v17, i64* %s6'), 1, 'smv-wild3 merge block')
    runner.eq(ir.contains('ret i64 %v18'), 1, 'smv-wild3 ret loaded')

    ; 鉴别力：臂内 SSA 值不得被 RET 直接引用（那说明结果槽被绕过）；块数恰为 entry + bb1..bb5
    runner.eq(ir.contains('ret i64 %v11'), 0, 'smv-wild3 no direct arm ret')
    runner.eq(ir.contains('bb6:'), 0, 'smv-wild3 no spare block')
}

; ── s103：无兜底臂的两臂值链——最后一臂的假路直接落汇聚块，不留空判定块 ──
test-smv-nowild2 = () {
    src = 'w = (n i64) (r i64) {\n    r = {\n        n > 3 -> 1\n        n > 1 -> 2\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'smv-nowild2 unsup')
    runner.eq(ir.contains('br i1 %c20, label %bb4, label %bb1'), 1, 'smv-nowild2 last arm false to merge')
    runner.eq(ir.contains('bb5:'), 0, 'smv-nowild2 no empty test block')
    runner.eq(ir.contains('store i64 %v11, i64* %s4'), 1, 'smv-nowild2 arm1 store')
    runner.eq(ir.contains('store i64 %v15, i64* %s4'), 1, 'smv-nowild2 arm2 store')
    runner.eq(ir.contains('ret i64 %v17'), 1, 'smv-nowild2 ret loaded')

    ; 全不命中时结果槽保留 entry 的零初始化 0（与 Go 权威同口径）
    runner.eq(ir.contains('%v5 = add i64 0, 0\n\tstore i64 %v5, i64* %s4'), 1, 'smv-nowild2 zero init')
}

; ── s103：值位 + i64 主体（`r = n: { 1 -> 10  -> 0 }`）——逐臂「本臂判定块内 LOAD 主体 + CMPEQ」 ──
test-smv-subj = () {
    src = 'u = (n i64) (r i64) {\n    r = n: {\n        1 -> 10\n        3 -> 30\n        -> 0\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'smv-subj unsup')
    runner.eq(ir.contains('%v8 = add i64 0, 1'), 1, 'smv-subj pattern 1')
    runner.eq(ir.contains('%c12 = icmp eq i64 %v9, %v8'), 1, 'smv-subj cmpeq arm1')
    runner.eq(ir.contains('%c19 = icmp eq i64 %v13, %v12'), 1, 'smv-subj cmpeq arm2')
    runner.eq(ir.contains('store i64 %v11, i64* %s4'), 1, 'smv-subj arm1 store')
    runner.eq(ir.contains('store i64 %v15, i64* %s4'), 1, 'smv-subj arm2 store')
    runner.eq(ir.contains('store i64 %v16, i64* %s4'), 1, 'smv-subj wildcard store')
    runner.eq(ir.contains('bb1:\n\t%v17 = load i64, i64* %s4'), 1, 'smv-subj merge load')
    runner.eq(ir.contains('ret i64 %v18'), 1, 'smv-subj ret loaded')
}

; ── s103 负例：臂体不是「inline 块包单表达式陈述」⇒ 计 unsup 整函数不产码 ──
test-smv-gate = () {
    src = 'p2 = (n i64) (r i64) {\n    r = {\n        n > 3 -> {\n            x = 1\n            x\n        }\n        -> 0\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup > 0, 1, 'smv-multistmt counted')
    runner.eq(ir.contains('define'), 0, 'smv-multistmt no code')
}

; ── 控制流侧门禁：surface match 链 / 计数循环 / 区间遍历 / 无槽型别都计 unsup 且不产码 ──
test-flow-gate = () {

    ; s103 转正：值位链 `r = { c -> v  -> d }` 已放行（逐臂 STORE 进 entry 结果槽、汇聚块 LOAD）；
    ;   负例换成【臂值不是 i64】——结果槽按 i64 铺，str 臂值无处可落 ⇒ 计 unsup 整函数不产码
    src-sm = 'a = (n i64) (r i64) {\n    r = {\n        n > 0 -> \'x\'\n        -> 0\n    }\n}\n'
    t1 = ast.make()
    p1 = ps.new(src-sm.to-bytes())
    r1 = ps.parse(t1, p1)
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'str-arm-value counted')
    runner.eq(ir1.contains('define'), 0, 'str-arm-value no code')

    ; 计数循环的【标识符计数位】`n * { }`：实测 ps.no 不把它建成 ForStatement（退化成
    ;   EXPR-STATEMENT{n} + LET 块），h2m 不认识该形状 ⇒ 计 unsup 整函数不产码。
    ;   ⚠️ s60m 起字面量计数形已入覆盖面，本例仍是负例但理由换成【计数位必须是字面量】
    src-ct = 'b = (n i64) (r i64) {\n    r = 0\n    n * {\n        r = r + 1\n    }\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-ct.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'count-loop counted')
    runner.eq(ir2.contains('br label'), 0, 'count-loop no code')

    ; 区间的【开边界】`i <- [0..]`：缺位的那一端 Go 取 i64 型别极值补齐（实测量级不可验证），
    ;   h2m 宁缺勿错 ⇒ 计 unsup 整函数不产码（s61 起闭区间两端齐全才入覆盖面）
    src-rg = 'c = (n i64) (r i64) {\n    r = 0\n    i <- [0..]: {\n        r = r + 1\n    }\n}\n'
    t3 = ast.make()
    r3 = ps.parse(t3, ps.new(src-rg.to-bytes()))
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'range-open-bound counted')
    runner.eq(ir3.contains('alloca'), 0, 'range-open-bound no slot emitted')

    ; 臂内放不了的东西：带标签的跳出（break # 1 形——ps.no 把 BREAK 留 'none' 且标签落为
    ;   孤儿节点 kind 71/27，h2m 不认识 kind 71 ⇒ 计 unsup 整函数不产码）
    src-rt = 'd = (n i64) (r i64) {\n    r = 0\n    (r < 10) {\n        r = r + 1\n        break # 1\n    }\n}\n'
    t4 = ast.make()
    r4 = ps.parse(t4, ps.new(src-rt.to-bytes()))
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)
    runner.eq(agg4.unsup > 0, 1, 'labeled-break counted')
    runner.eq(ir4.contains('define'), 0, 'labeled-break no code')

    ; s74 转正：mem 模式下 f64 形参铺 alloca double 槽（旧负例『宁缺勿错』已解锁）——x == x ⇒ store/load double + fcmp oeq double
    src-f64 = 'e = (x f64) (r i64) {\n    r = 0\n    x == x -> r = 1\n}\n'
    t5 = ast.make()
    r5 = ps.parse(t5, ps.new(src-f64.to-bytes()))
    agg5 = h2m-new()
    ir5 = h2m-lower-program(t5, agg5, r5)
    runner.eq(agg5.unsup, 0, 'f64 slot unsup')
    runner.eq(ir5.contains('alloca double'), 1, 'f64 slot alloca double')
    runner.eq(ir5.contains('load double'), 1, 'f64 slot load double')
    runner.eq(ir5.contains('fcmp oeq double'), 1, 'f64 slot fcmp')

    ; 兜底臂不在末位：其后的臂恒不可达，臂体里的 return 会被链的 stop 静默吞掉 ⇒ 形状校验计 unsup
    src-wmid = 'f2 = (n i64) (r i64) {\n    r = 0\n    {\n        n > 3 -> r = 1\n        -> r = 9\n        n > 1 -> return\n    }\n}\n'
    t6 = ast.make()
    r6 = ps.parse(t6, ps.new(src-wmid.to-bytes()))
    agg6 = h2m-new()
    ir6 = h2m-lower-program(t6, agg6, r6)
    runner.eq(agg6.unsup > 0, 1, 'wild-not-last counted')
    runner.eq(ir6.contains('define'), 0, 'wild-not-last no code')
}

; ── s59：guard 块里的 return——共享 ret 块懒开，终结处只发 BR；尾块再 BR 过去 LOAD+RET ──
; 形制钉自 tmp/probe-s59-ir.no（SRC-RET）：then 块 store 42 后 br bb4＋不可达 br bb3；
; bb3 后继语句照降；bb4 只读一次槽。若无 return 块形制（s57 的 ret 落当前块）被误用，
; bb4 的 define 尾形与双 BR 序列都会断言失败。
test-term-ret = () {
    src = 'f59 = (n i64) (r i64) {\n    r = 0\n    n > 0 -> {\n        r = 42\n        return\n    }\n    r = n\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'ret unsup')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'ret then stores 42')
    runner.eq(ir.contains('\tbr label %bb4\n\tbr label %bb3'), 1, 'ret dead-br pair')
    runner.eq(ir.contains('bb4:\n\t%v13 = load i64, i64* %s4\n\tret i64 %v13'), 1, 'ret shared block')

    ; 后继语句落在 bb3（未返回路径），且汇聚块 bb3 自己只 BR 不再 RET
    runner.eq(ir.contains('bb3:\n\t%v11 = load i64, i64* %s2'), 1, 'ret trailing in bb3')
    runner.eq(ir.contains('br label %bb4'), 1, 'ret trailing br merge-to-ret')

    ; 懒开验证：只有 bb4 一个 ret 块，不应另开空块
    runner.eq(ir.contains('bb5:'), 0, 'ret no spare block')
}

; ── s59：循环体内 continue——guard 块 BR 回 hdr（重判条件），不可达汇聚 BR 同块尾 ──
test-term-cont = () {
    src = 'g59 = (n i64) (r i64) {\n    r = 0\n    i = n\n    (i > 0) {\n        i = i - 1\n        i > 3 -> continue\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cont unsup')

    ; continue 的目标是 hdr（bb1）：guard 臂块只拿到回边＋不可达汇聚 BR
    runner.eq(ir.contains('bb4:\n\tbr label %bb1\n\tbr label %bb6'), 1, 'cont arm back-edge pair')

    ; 跳过的陈述落在 bb6（if 汇聚块）：体内累加仍在回边之前
    runner.eq(ir.contains('bb6:\n\t%v19 = load i64, i64* %s4'), 1, 'cont skipped stmt in merge')
    runner.eq(ir.contains('store i64 %v21, i64* %s4'), 1, 'cont accumulate stored')

    ; exit 块（bb3）只读槽返回——continue 不得把 RET 提前到循环区
    runner.eq(ir.contains('bb3:\n\t%v22 = load i64, i64* %s4\n\tret i64 %v22'), 1, 'cont exit ret')
}

; ── s59：循环体内 break——BR 落 exit，且循环后的继语句在 exit 块照跑 ──
test-term-brk = () {
    src = 'h59 = (n i64) (r i64) {\n    r = 0\n    i = n\n    (i > 0) {\n        i = i - 1\n        i < 2 -> break\n        r = r + i\n    }\n    r = r + 100\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'brk unsup')

    ; break 的目标是 exit（bb3）——不是回边 hdr
    runner.eq(ir.contains('bb4:\n\tbr label %bb3\n\tbr label %bb6'), 1, 'brk arm exits loop')

    ; 循环后的继语句落在 exit 块（+100 在 RET 之前），证明 break 跳过循环而非跳过函数
    runner.eq(ir.contains('bb3:\n\t%v22 = load i64, i64* %s4'), 1, 'brk trailing after loop')
    runner.eq(ir.contains('%v23 = add i64 0, 100'), 1, 'brk trailing add 100')
    runner.eq(ir.contains('ret i64 %v25'), 1, 'brk ret trailing value')
}

; ── s59：链臂体的裸终结形（单陈述 inline 臂 `n > 9 -> return`）＋共享 ret 块多入口 ──
test-term-chain = () {
    src = 'k59 = (n i64) (r i64) {\n    {\n        n > 9 -> return\n        -> r = 5\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'chain unsup')

    ; 臂块 bb2 直接 BR 共享 ret 块 bb4（经 h2m-lower-branch 的终结形臂）
    runner.eq(ir.contains('bb2:\n\tbr label %bb4\n\tbr label %bb1'), 1, 'chain arm br ret')

    ; 兜底臂正常落 bb3 并 BR 链汇聚块 bb1，bb1 再 BR 到 ret 块——两个入口共享同一 RET
    runner.eq(ir.contains('bb1:\n\t%v10 = load i64, i64* %s4'), 1, 'chain merge loads')
    runner.eq(ir.contains('bb4:\n\t%v11 = load i64, i64* %s4\n\tret i64 %v11'), 1, 'chain shared ret')
}

; ── s59：无输出参函数的 return——延迟零值由 ret 块的 CONST 0 落地（Go 的 void ret 形不在覆盖面）──
test-term-ret-noout = () {
    src = 'q59 = (n i64) {\n    n > 0 -> return\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'noout unsup')
    runner.eq(ir.contains('bb4:\n\t%v8 = add i64 0, 0\n\tret i64 %v8'), 1, 'noout ret zero')
}

; ── s59 门禁：终结形非末条 / 循环外 break / 输出参槽型不符都计 unsup 且不产码 ──
test-term-gate = () {

    ; return 后面还有陈述 ⇒ 其后不可达，末位门禁计 unsup
    src-nl = 'm59 = (n i64) (r i64) {\n    r = 0\n    return\n    r = 1\n}\n'
    t1 = ast.make()
    r1 = ps.parse(t1, ps.new(src-nl.to-bytes()))
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'nonlast counted')
    runner.eq(ir1.contains('define'), 0, 'nonlast no code')

    ; 循环外的 break：栈空无目标 ⇒ 计 unsup（与 Go 的循环外跳出报错同调，宁缺勿错）
    src-out = 'p59 = (n i64) (r i64) {\n    r = 1\n    break\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-out.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'outer-break counted')
    runner.eq(ir2.contains('define'), 0, 'outer-break no code')
}

; ── s60m：计数循环前置形 `3 * { }`——四块轮转（hdr/body/update/exit）+ 合成计数器槽 ──
; 形制钉自 tmp/probe-s60m-ir.no（函数 a）：计数器是 entry 的第三个 alloca（%s6），计数值只在
; 进循环前算一次并 STORE，header 每次重新 LOAD 判 >0，body 结尾 BR 到 update（不是 hdr）。
; 若把回边直接接回 hdr（漏掉自减），update 块就不会出现 sub；若沿用 SSA 重绑，body 里就是旧值。
test-cnt-fwd = () {
    src = 'ca = (n i64) (r i64) {\n    r = 0\n    3 * {\n        r = r + 1\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cnt-fwd unsup')
    runner.eq(ir.contains('define i64 @ca(i64 %v1)'), 1, 'cnt-fwd define')

    ; 计数器槽落在 entry（cg 要求 alloca 只能在 entry，离开后回不去）
    runner.eq(ir.contains('%s6 = alloca i64'), 1, 'cnt-fwd counter slot in entry')

    ; 计数值只算一次：常量 3 紧跟一次 STORE，然后无条件跳 header
    runner.eq(ir.contains('store i64 %v8, i64* %s4\n\t%v9 = add i64 0, 3\n\tstore i64 %v9, i64* %s6\n\tbr label %bb1'), 1, 'cnt-fwd seed then br hdr')

    ; header：每次重新 LOAD 计数器并与 0 比——谓词必须是 sgt（N <= 0 首判即假）
    runner.eq(ir.contains('bb1:\n\t%v10 = load i64, i64* %s6\n\t%v11 = add i64 0, 0\n\t%c17 = icmp sgt i64 %v10, %v11'), 1, 'cnt-fwd hdr loads and sgt')
    runner.eq(ir.contains('icmp sle i64 %v10'), 0, 'cnt-fwd hdr predicate not flipped')
    runner.eq(ir.contains('br i1 %c18, label %bb2, label %bb4'), 1, 'cnt-fwd condbr body/exit')

    ; body：读的是槽而不是 entry 的旧 SSA 值
    runner.eq(ir.contains('bb2:\n\t%v13 = load i64, i64* %s4'), 1, 'cnt-fwd body loads slot')

    ; 关键鉴别：body 结尾 BR 到 update（bb3）而不是 hdr（bb1）——否则计数器永不递减、死循环
    runner.eq(ir.contains('store i64 %v15, i64* %s4\n\tbr label %bb3'), 1, 'cnt-fwd body br update')
    runner.eq(ir.contains('store i64 %v15, i64* %s4\n\tbr label %bb1'), 0, 'cnt-fwd body not br hdr')

    ; update：cnt = cnt - 1 后跳回 hdr
    runner.eq(ir.contains('bb3:\n\t%v16 = load i64, i64* %s6\n\t%v17 = add i64 0, 1\n\t%v18 = sub i64 %v16, %v17\n\tstore i64 %v18, i64* %s6\n\tbr label %bb1'), 1, 'cnt-fwd update decrements and loops')

    ; exit：循环后继语句（此处即隐式 RET）落在 exit 块
    runner.eq(ir.contains('bb4:\n\t%v19 = load i64, i64* %s4\n\tret i64 %v19'), 1, 'cnt-fwd exit ret')
    runner.eq(ir.contains('bb5:'), 0, 'cnt-fwd no spare block')
}

; ── s60m：后置形 `{ } * 3` 与前置形归一为同一 AST ⇒ 降级出的 IR 逐字节同形 ──
; 实测（tmp/probe-s60m-ast.no）：ps.no 的两个 builder 把块体统一落在 kid[5]、字面量落在 kid[3]，
; 故本例的断言集合与 test-cnt-fwd 完全一致（只有函数名不同）——这同时钉住「两种写法不会各走一路」。
test-cnt-postfix = () {
    src = 'cb = (n i64) (r i64) {\n    r = 0\n    {\n        r = r + 1\n    } * 3\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cnt-post unsup')
    runner.eq(ir.contains('define i64 @cb(i64 %v1)'), 1, 'cnt-post define')
    runner.eq(ir.contains('store i64 %v8, i64* %s4\n\t%v9 = add i64 0, 3\n\tstore i64 %v9, i64* %s6\n\tbr label %bb1'), 1, 'cnt-post seed same as prefix')
    runner.eq(ir.contains('%c17 = icmp sgt i64 %v10, %v11'), 1, 'cnt-post hdr sgt')
    runner.eq(ir.contains('store i64 %v15, i64* %s4\n\tbr label %bb3'), 1, 'cnt-post body br update')
    runner.eq(ir.contains('bb3:\n\t%v16 = load i64, i64* %s6\n\t%v17 = add i64 0, 1\n\t%v18 = sub i64 %v16, %v17'), 1, 'cnt-post update decrements')
    runner.eq(ir.contains('bb4:\n\t%v19 = load i64, i64* %s4\n\tret i64 %v19'), 1, 'cnt-post exit ret')
}

; ── s60m：非正计数（-2 与 0）照发 header 判定——语义「N <= 0 时体一次不进」由 sgt 保证 ──
test-cnt-nonpos = () {
    src = 'cn = (n i64) (r i64) {\n    r = 0\n    -2 * {\n        r = r + 1\n    }\n}\n\ncz = (n i64) (r i64) {\n    r = 0\n    0 * {\n        r = r + 1\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cnt-nonpos unsup')

    ; 负字面量在 parser 侧就拼进 token（s0 = '-2'），降级走 to-i64 得 -2
    runner.eq(ir.contains('%v9 = add i64 0, -2'), 1, 'cnt-nonpos negative const')
    runner.eq(ir.contains('store i64 %v9, i64* %s6'), 1, 'cnt-nonpos negative seeded')

    ; 两个函数的 header 谓词都是 sgt（不是 ne）——否则 0 会进一次体、负数会死循环
    runner.eq(ir.contains('icmp sgt i64 %v10, %v11'), 1, 'cnt-nonpos hdr sgt')
    runner.eq(ir.contains('icmp ne i64 %v10, %v11'), 0, 'cnt-nonpos not nonzero-test')
    runner.eq(ir.contains('define i64 @cz(i64 %v1)'), 1, 'cnt-nonpos zero-count func emitted')
}

; ── s60m：计数循环内 break——BR 落 exit（不是 hdr），循环后的继语句在 exit 块照跑 ──
test-cnt-break = () {
    src = 'cc = (n i64) (r i64) {\n    r = 0\n    5 * {\n        r = r + 1\n        r > 3 -> break\n    }\n    r = r + 100\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cnt-brk unsup')

    ; break 臂块 bb5 首条 BR 落 exit（bb4）；同块尾是不可达的链汇聚 BR（s59 同款双 BR 形）
    runner.eq(ir.contains('bb5:\n\tbr label %bb4\n\tbr label %bb7'), 1, 'cnt-brk arm exits loop')

    ; 鉴别力：break 绝不能落 hdr（那是 continue 的目标）或 update
    runner.eq(ir.contains('bb5:\n\tbr label %bb1'), 0, 'cnt-brk not hdr')
    runner.eq(ir.contains('bb5:\n\tbr label %bb3'), 0, 'cnt-brk not update')

    ; 链的汇聚块 bb7 接回 update——未触发的轮次仍要自减
    runner.eq(ir.contains('bb7:\n\tbr label %bb3'), 1, 'cnt-brk merge to update')

    ; 后继语句 +100 落在 exit 块：证明 break 是跳出循环而不是跳出函数
    runner.eq(ir.contains('bb4:\n\t%v22 = load i64, i64* %s4\n\t%v23 = add i64 0, 100'), 1, 'cnt-brk trailing after loop')
    runner.eq(ir.contains('ret i64 %v25'), 1, 'cnt-brk ret trailing value')
}

; ── s60m：计数循环内 continue——目标是 update 块（先自减再重判），不是 hdr ──
; 与条件循环的 continue（test-term-cont 回 hdr）形成对照：计数循环若把 continue 接回 hdr，
; 计数器永不递减 ⇒ 活锁。循环栈存的因此是 (continue 目标, exit) 而非固定的 (hdr, exit)。
test-cnt-cont = () {
    src = 'cd = (n i64) (r i64) {\n    r = 0\n    4 * {\n        r = r + 1\n        r > 2 -> continue\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cnt-cont unsup')

    ; continue 臂块 BR 到 update（bb3），同块尾是不可达的汇聚 BR
    runner.eq(ir.contains('bb5:\n\tbr label %bb3\n\tbr label %bb7'), 1, 'cnt-cont arm br update')

    ; 鉴别力：continue 不得直回 hdr（跳过自减 = 活锁）
    runner.eq(ir.contains('bb5:\n\tbr label %bb1'), 0, 'cnt-cont not hdr')

    ; update 块确实是自减而非重算计数值
    runner.eq(ir.contains('bb3:\n\t%v19 = load i64, i64* %s6\n\t%v20 = add i64 0, 1\n\t%v21 = sub i64 %v19, %v20'), 1, 'cnt-cont update decrements')
    runner.eq(ir.contains('bb4:\n\t%v22 = load i64, i64* %s4\n\tret i64 %v22'), 1, 'cnt-cont exit ret')
}

; ── s60m：嵌套计数循环——两个独立的计数器槽，内层 exit 接回外层 update ──
test-cnt-nested = () {
    src = 'ce = (n i64) (r i64) {\n    r = 0\n    2 * {\n        3 * {\n            r = r + 1\n        }\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cnt-nest unsup')

    ; 每层各占一个合成槽（槽名带 ForStatement 节点 id）：外层 %s6、内层 %s8
    runner.eq(ir.contains('%s6 = alloca i64'), 1, 'cnt-nest outer slot')
    runner.eq(ir.contains('%s8 = alloca i64'), 1, 'cnt-nest inner slot')
    runner.eq(ir.contains('%v11 = add i64 0, 2'), 1, 'cnt-nest outer const 2')

    ; 内层计数值在外层 body 块（bb2）里播种后跳内层 hdr（bb5）——不在 entry 一次算完
    runner.eq(ir.contains('bb2:\n\t%v15 = add i64 0, 3\n\tstore i64 %v15, i64* %s8\n\tbr label %bb5'), 1, 'cnt-nest inner seeded in outer body')

    ; 内层 header / update 各自闭环于 %s8
    runner.eq(ir.contains('bb5:\n\t%v16 = load i64, i64* %s8'), 1, 'cnt-nest inner hdr loads inner slot')
    runner.eq(ir.contains('bb7:\n\t%v22 = load i64, i64* %s8\n\t%v23 = add i64 0, 1\n\t%v24 = sub i64 %v22, %v23\n\tstore i64 %v24, i64* %s8\n\tbr label %bb5'), 1, 'cnt-nest inner update loops inner')

    ; 内层 exit（bb8）接回外层 update（bb3）——不是外层 hdr，也不是函数尾
    runner.eq(ir.contains('bb8:\n\tbr label %bb3'), 1, 'cnt-nest inner exit to outer update')
    runner.eq(ir.contains('bb3:\n\t%v25 = load i64, i64* %s6'), 1, 'cnt-nest outer update loads outer slot')
    runner.eq(ir.contains('bb4:\n\t%v28 = load i64, i64* %s4\n\tret i64 %v28'), 1, 'cnt-nest exit ret')
}

; ── s60m 门禁：计数与条件同时存在 / 计数位是字符串字面量，都计 unsup 且不产码 ──
; 真实源路造不出这两个形状（Go lowerFor 是 count 优先、条件被静默丢弃），故按 s57 的先例用
; ast.add/kid-add 合成同形 ForStatement 节点，钉住「宁缺勿错」而非跟着 Go 静默丢条件。
test-cnt-gate = () {

    ; 合成：CountExpr 与 Condition 同时非 0 ⇒ 拒绝降整函数
    t1 = ast.make()
    idn1 = mk-ident(t1, 'n')
    iz1 = mk-int(t1, '0')
    cond1 = mk-infix(t1, '>', idn1, iz1)
    cnt1 = mk-int(t1, '3')
    st1 = mk-let-int(t1, 'r', '1')
    blk1 = mk-block1(t1, st1)
    for1 = ast.add(t1, asp.K-FOR-STATEMENT)
    ast.kid-add(t1, for1, 0)
    ast.kid-add(t1, for1, cond1)
    ast.kid-add(t1, for1, 0)
    ast.kid-add(t1, for1, cnt1)
    ast.kid-add(t1, for1, 0)
    ast.kid-add(t1, for1, blk1)
    pin1 = mk-param(t1, 'n', 'i64')
    pout1 = mk-param(t1, 'r', 'i64')
    fbody1 = mk-block1(t1, for1)
    fd1 = ast.add(t1, asp.K-FUNCTION-DEFINITION)
    ast.kid-add(t1, fd1, pin1)
    ast.kid-add(t1, fd1, pout1)
    ast.kid-add(t1, fd1, fbody1)
    ast.set-sig(t1, fd1, 0, 1, 1)
    ast.set-slot(t1, fd1, 0, ast.put-str(t1, 'gcnt1'))
    pr1 = ast.add(t1, asp.K-PROGRAM)
    ast.kid-add(t1, pr1, fd1)
    ast.set-count(t1, pr1, 0, 1)
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, pr1)
    runner.eq(agg1.unsup > 0, 1, 'cnt-plus-cond counted')
    runner.eq(ir1.contains('define'), 0, 'cnt-plus-cond no code')

    ; 合成：计数位是字符串字面量（非 i64 值进不了计数器）⇒ 计 unsup
    t2 = ast.make()
    snode = ast.add(t2, asp.K-STRING-LITERAL)
    ast.set-slot(t2, snode, 0, ast.put-str(t2, 'abc'))
    st2 = mk-let-int(t2, 'r', '1')
    blk2 = mk-block1(t2, st2)
    for2 = ast.add(t2, asp.K-FOR-STATEMENT)
    ast.kid-add(t2, for2, 0)
    ast.kid-add(t2, for2, 0)
    ast.kid-add(t2, for2, 0)
    ast.kid-add(t2, for2, snode)
    ast.kid-add(t2, for2, 0)
    ast.kid-add(t2, for2, blk2)
    pin2 = mk-param(t2, 'n', 'i64')
    pout2 = mk-param(t2, 'r', 'i64')
    fbody2 = mk-block1(t2, for2)
    fd2 = ast.add(t2, asp.K-FUNCTION-DEFINITION)
    ast.kid-add(t2, fd2, pin2)
    ast.kid-add(t2, fd2, pout2)
    ast.kid-add(t2, fd2, fbody2)
    ast.set-sig(t2, fd2, 0, 1, 1)
    ast.set-slot(t2, fd2, 0, ast.put-str(t2, 'gcnt2'))
    pr2 = ast.add(t2, asp.K-PROGRAM)
    ast.kid-add(t2, pr2, fd2)
    ast.set-count(t2, pr2, 0, 1)
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, pr2)
    runner.eq(agg2.unsup > 0, 1, 'str-counter counted')
    runner.eq(ir2.contains('define'), 0, 'str-counter no code')
}

; ── s61：区间遍历升序右开 `i <- [0..5)`——11 块方向分派（init 双臂／hdr 双臂／upd 双臂）──
; 形制钉自 tmp/probe-s61-ir.no（用例 A）：两端点只求值一次（%v12／%v13），方向由 lo <= hi 的
; 运行期分支决定（IR 无 select ⇒ 不能像计数循环那样单块轮转），循环变量是 entry 的 alloca 槽 %s9
; （体内 LOAD 取当前值，跨迭代存活）；三个方向判定点都复用同一对端点值 id ⇒ 端点不会每轮重算
test-rng-asc = () {
    src = 'ra = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [0..5): {\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-asc unsup')
    runner.eq(ir.contains('define i64 @ra(i64 %v1, i64 %v2)'), 1, 'rng-asc define')

    ; 循环变量槽落在 entry（cg 要求 alloca 只能在 entry）
    runner.eq(ir.contains('%s9 = alloca i64'), 1, 'rng-asc loop-var slot in entry')

    ; pre：端点各算一次，紧接着比较方向；输出参槽 %s7 与循环变量槽 %s9 是两颗不同的槽
    runner.eq(ir.contains('%v12 = add i64 0, 0\n\t%v13 = add i64 0, 5\n\t%c18 = icmp sle i64 %v12, %v13'), 1, 'rng-asc endpoints then direction')
    runner.eq(ir.contains('br i1 %c19, label %bb1, label %bb2'), 1, 'rng-asc direction condbr')

    ; 起始值两臂：升序 lo + off、降序 lo - off（左闭 '[' ⇒ off = 0）
    runner.eq(ir.contains('bb1:\n\t%v15 = add i64 0, 0\n\t%v16 = add i64 %v12, %v15\n\tstore i64 %v16, i64* %s9\n\tbr label %bb3'), 1, 'rng-asc init ascending')
    runner.eq(ir.contains('bb2:\n\t%v17 = add i64 0, 0\n\t%v18 = sub i64 %v12, %v17\n\tstore i64 %v18, i64* %s9\n\tbr label %bb3'), 1, 'rng-asc init descending')
    runner.eq(ir.contains('bb3:\n\tbr label %bb4'), 1, 'rng-asc join to header')

    ; header：再判一次方向，两臂各比 i 与 hi；右开 ')' ⇒ 升序用 slt／降序用 sgt
    runner.eq(ir.contains('bb4:\n\t%c29 = icmp sle i64 %v12, %v13'), 1, 'rng-asc header re-tests direction')
    runner.eq(ir.contains('bb5:\n\t%v20 = load i64, i64* %s9\n\t%c32 = icmp slt i64 %v20, %v13'), 1, 'rng-asc hd-asc loads slot and slt')
    runner.eq(ir.contains('bb6:\n\t%v22 = load i64, i64* %s9\n\t%c35 = icmp sgt i64 %v22, %v13'), 1, 'rng-asc hd-desc sgt')

    ; 两臂汇入同一对目标：真进体 bb7、假出循环 bb11
    runner.eq(ir.contains('br i1 %c33, label %bb7, label %bb11'), 1, 'rng-asc hd-asc condbr body/exit')
    runner.eq(ir.contains('br i1 %c36, label %bb7, label %bb11'), 1, 'rng-asc hd-desc condbr body/exit')

    ; 体：读的是槽（%s9）而不是 entry 的旧 SSA 值；结尾 BR 到 upd（bb8）
    runner.eq(ir.contains('bb7:\n\t%v24 = load i64, i64* %s7\n\t%v25 = load i64, i64* %s9\n\t%v26 = add i64 %v24, %v25'), 1, 'rng-asc body reads slot')
    runner.eq(ir.contains('store i64 %v26, i64* %s7\n\tbr label %bb8'), 1, 'rng-asc body br update')

    ; update：第三处方向判定 + 两臂各 ±1 后跳回 header
    runner.eq(ir.contains('bb8:\n\t%c42 = icmp sle i64 %v12, %v13'), 1, 'rng-asc update re-tests direction')
    runner.eq(ir.contains('bb9:\n\t%v28 = load i64, i64* %s9\n\t%v29 = add i64 0, 1\n\t%v30 = add i64 %v28, %v29\n\tstore i64 %v30, i64* %s9\n\tbr label %bb4'), 1, 'rng-asc upd-asc steps and loops')
    runner.eq(ir.contains('bb10:\n\t%v31 = load i64, i64* %s9\n\t%v32 = add i64 0, 1\n\t%v33 = sub i64 %v31, %v32\n\tstore i64 %v33, i64* %s9\n\tbr label %bb4'), 1, 'rng-asc upd-desc steps and loops')

    ; exit：循环后继语句（此处即隐式 RET）落在 exit 块；块数恰好 11（bb0..bb11 中 bb0 为 entry）
    runner.eq(ir.contains('bb11:\n\t%v34 = load i64, i64* %s7\n\tret i64 %v34'), 1, 'rng-asc exit ret')
    runner.eq(ir.contains('bb12:'), 0, 'rng-asc no spare block')
    runner.eq(ir.contains('icmp sle i64 %v20'), 0, 'rng-asc right-open not inclusive')
}

; ── s61：右闭 ']' 把两臂的比较谓词换成 sle／sge（差一个端点是否进体）──
test-rng-closed = () {
    src = 'rb = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [0..5]: {\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-closed unsup')
    runner.eq(ir.contains('define i64 @rb(i64 %v1, i64 %v2)'), 1, 'rng-closed define')
    runner.eq(ir.contains('%c32 = icmp sle i64 %v20, %v13'), 1, 'rng-closed hd-asc uses sle')
    runner.eq(ir.contains('%c35 = icmp sge i64 %v22, %v13'), 1, 'rng-closed hd-desc uses sge')

    ; 鉴别力：右闭绝不能沿用右开的 slt／sgt（否则少跑最后一轮）
    runner.eq(ir.contains('icmp slt i64 %v20'), 0, 'rng-closed not slt')
    runner.eq(ir.contains('icmp sgt i64 %v22'), 0, 'rng-closed not sgt')
}

; ── s61：左开 '(' 只改起始值的偏移量（两臂各 ±1），比较谓词仍由右括号决定 ──
test-rng-openleft = () {
    src = 'rc = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- (0..5]: {\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-openleft unsup')
    runner.eq(ir.contains('define i64 @rc(i64 %v1, i64 %v2)'), 1, 'rng-openleft define')
    runner.eq(ir.contains('bb1:\n\t%v15 = add i64 0, 1\n\t%v16 = add i64 %v12, %v15'), 1, 'rng-openleft ascending start skips lo')
    runner.eq(ir.contains('bb2:\n\t%v17 = add i64 0, 1\n\t%v18 = sub i64 %v12, %v17'), 1, 'rng-openleft descending start skips lo')
    runner.eq(ir.contains('%v15 = add i64 0, 0'), 0, 'rng-openleft offset not dropped')

    ; 右端是 ']' ⇒ 谓词仍是 sle／sge（左开不影响终止比较）
    runner.eq(ir.contains('%c32 = icmp sle i64 %v20, %v13'), 1, 'rng-openleft hd-asc sle')
}

; ── s61：降序区间 `[5..0)`——方向不在编译期折成常量，仍发运行期分支选臂 ──
; Go 同形（hir2mir.go:5103 起：三处 OpLe(start,end) 各开一次分支），opt 才会把不变谓词提出循环
test-rng-desc = () {
    src = 'rd = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [5..0): {\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-desc unsup')
    runner.eq(ir.contains('define i64 @rd(i64 %v1, i64 %v2)'), 1, 'rng-desc define')

    ; lo=5／hi=0：方向判定写成 icmp sle 5, 0（首判即假 ⇒ 走降序臂），而不是降级器直接选臂
    runner.eq(ir.contains('%v12 = add i64 0, 5\n\t%v13 = add i64 0, 0\n\t%c18 = icmp sle i64 %v12, %v13'), 1, 'rng-desc runtime direction test')

    ; 两臂齐发：升序臂存在但运行期不被选中（宁多发不可少发，静态裁剪会让 lo<=hi 的调用点丢臂）
    runner.eq(ir.contains('bb5:\n\t%v20 = load i64, i64* %s9\n\t%c32 = icmp slt i64 %v20, %v13'), 1, 'rng-desc asc arm still emitted')
    runner.eq(ir.contains('bb6:\n\t%v22 = load i64, i64* %s9\n\t%c35 = icmp sgt i64 %v22, %v13'), 1, 'rng-desc desc arm emitted')
    runner.eq(ir.contains('bb10:\n\t%v31 = load i64, i64* %s9\n\t%v32 = add i64 0, 1\n\t%v33 = sub i64 %v31, %v32'), 1, 'rng-desc desc step decrements')
}

; ── s61：变量端点 `i <- [lo..hi)`——端点从形参槽 LOAD 一次，其后各块复用同一对值 id ──
test-rng-var = () {
    src = 're = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [lo..hi): {\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-var unsup')
    runner.eq(ir.contains('define i64 @re(i64 %v1, i64 %v2)'), 1, 'rng-var define')

    ; 端点不是字面量：pre 块各发一条 LOAD，随即比较方向
    runner.eq(ir.contains('%v12 = load i64, i64* %s3\n\t%v13 = load i64, i64* %s5\n\t%c18 = icmp sle i64 %v12, %v13'), 1, 'rng-var endpoints loaded once')

    ; 关键鉴别：header 与 update 的方向判定直接引用 %v12／%v13（不是重新 LOAD 形参槽）
    runner.eq(ir.contains('bb4:\n\t%c29 = icmp sle i64 %v12, %v13'), 1, 'rng-var header reuses endpoint values')
    runner.eq(ir.contains('bb8:\n\t%c42 = icmp sle i64 %v12, %v13'), 1, 'rng-var update reuses endpoint values')

    ; 鉴别力：header 与 update 的首条不是新的端点 LOAD（每轮重读形参槽会把不变谓词变依赖循环）
    runner.eq(ir.contains('bb4:\n\t%v19 = load'), 0, 'rng-var header not reloading bounds')
    runner.eq(ir.contains('bb8:\n\t%v27 = load'), 0, 'rng-var update not reloading bounds')
}

; ── s61：区间遍历体内 break——BR 落 exit，循环后继语句仍在 exit 块照跑 ──
test-rng-break = () {
    src = 'rf = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [0..4): {\n        i == 2 -> break\n        r = r + i\n    }\n    r = r + 100\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-brk unsup')
    runner.eq(ir.contains('bb7:\n\t%v24 = load i64, i64* %s9\n\t%v25 = add i64 0, 2\n\t%c39 = icmp eq i64 %v24, %v25'), 1, 'rng-brk guard reads loop var slot')

    ; break 臂块 bb12 首条 BR 落 exit（bb11）；同块尾是不可达的链汇聚 BR（s59 同款双 BR 形）
    runner.eq(ir.contains('bb12:\n\tbr label %bb11\n\tbr label %bb14'), 1, 'rng-brk arm exits loop')

    ; 鉴别力：break 不得落 hdr（bb4）或 upd（bb8）
    runner.eq(ir.contains('bb12:\n\tbr label %bb4'), 0, 'rng-brk not hdr')
    runner.eq(ir.contains('bb12:\n\tbr label %bb8'), 0, 'rng-brk not update')

    ; 链汇聚块 bb14 接回 update——未触发的轮次仍要步进
    runner.eq(ir.contains('bb14:\n\t%v27 = load i64, i64* %s7\n\t%v28 = load i64, i64* %s9\n\t%v29 = add i64 %v27, %v28\n\tstore i64 %v29, i64* %s7\n\tbr label %bb8'), 1, 'rng-brk merge to update')

    ; 后继语句 +100 落在 exit 块：证明 break 是跳出循环而不是跳出函数
    runner.eq(ir.contains('bb11:\n\t%v37 = load i64, i64* %s7\n\t%v38 = add i64 0, 100'), 1, 'rng-brk trailing after loop')
    runner.eq(ir.contains('ret i64 %v40'), 1, 'rng-brk ret trailing value')
}

; ── s61：区间遍历体内 continue——目标是 update 块（先步进再重判），不是 hdr ──
; 与计数循环同口径：若把 continue 接回 hdr，本轮的 ±1 被跳过 ⇒ 活锁
test-rng-cont = () {
    src = 'rg = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [0..4): {\n        i == 1 -> continue\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-cont unsup')

    ; continue 臂块 BR 到 update（bb8），同块尾是不可达的汇聚 BR
    runner.eq(ir.contains('bb12:\n\tbr label %bb8\n\tbr label %bb14'), 1, 'rng-cont arm br update')

    ; 鉴别力：既不得直回 hdr（跳过步进 = 活锁），也不得落 exit（那是 break 的目标）
    runner.eq(ir.contains('bb12:\n\tbr label %bb4'), 0, 'rng-cont not hdr')
    runner.eq(ir.contains('bb12:\n\tbr label %bb11'), 0, 'rng-cont not exit')
}

; ── s61：`for i <- [0..3) { }` 关键字形（Condition 就是循环变量自身）──
; ps.no:5762 会同时写下 Condition=IDENT{i} 与 IterRange，两者同义不矛盾 ⇒ 不另计形位；
; 降级结果与 `<-` 运算符形同形（只差端点常量），钉住「两种写法走同一条路」
test-rng-kw = () {
    src = 'rk = (lo i64, hi i64) (r i64) {\n    r = 0\n    for i <- [0..3) {\n        r = r + i\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rng-kw unsup')
    runner.eq(ir.contains('define i64 @rk(i64 %v1, i64 %v2)'), 1, 'rng-kw define')
    runner.eq(ir.contains('%v13 = add i64 0, 3\n\t%c18 = icmp sle i64 %v12, %v13'), 1, 'rng-kw endpoints and direction')
    runner.eq(ir.contains('br i1 %c19, label %bb1, label %bb2'), 1, 'rng-kw same block shape as operator form')
    runner.eq(ir.contains('bb11:\n\t%v34 = load i64, i64* %s7\n\tret i64 %v34'), 1, 'rng-kw exit ret')
}

; ── s61 门禁：嵌套同名区间循环／容器遍历／开边界都计 unsup 且不产码 ──
; 嵌套同名：两层若共用一颗循环变量槽，内层会把外层的计数踩掉（Go 给内层另开一颗槽并改
;   l.locals，但循环后再读该名仍指向内层槽），语义两边都不干净 ⇒ 宁缺勿错
test-rng-gate = () {

    ; 内外层同名 i ⇒ 活动名栈命中，整函数不产码
    src-nest = 'gn = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [0..3): {\n        i <- [0..2): {\n            r = r + 1\n        }\n    }\n}\n'
    t1 = ast.make()
    r1 = ps.parse(t1, ps.new(src-nest.to-bytes()))
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'rng-nest-samename counted')
    runner.eq(ir1.contains('define'), 0, 'rng-nest-samename no code')

    ; 容器遍历 `x <- xs`（无型别标注的 let 名）：s62 后仍不产码——h2m-ty-of 推不出 xs 的型别
    ;   （K-SLICE-LITERAL 无降级路径）⇒ 铺槽阶段即计 unsup；s62 收的是 []i64 形参作源
    src-coll = 'gc = (lo i64, hi i64) (r i64) {\n    r = 0\n    xs = [1, 2, 3]\n    x <- xs: {\n        r = r + 1\n    }\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-coll.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'rng-container counted')
    runner.eq(ir2.contains('define'), 0, 'rng-container no code')

    ; 开边界 `[0..]` 与 `(0..)`：任一端缺位即不产码（Go 用型别极值补齐，量级不可验证）
    src-open = 'gz = (lo i64, hi i64) (r i64) {\n    r = 0\n    i <- [0..]: {\n        r = r + 1\n    }\n}\n'
    t3 = ast.make()
    r3 = ps.parse(t3, ps.new(src-open.to-bytes()))
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'rng-open-bound counted2')
    runner.eq(ir3.contains('define'), 0, 'rng-open-bound no code')
}

; ── s62：容器遍历 `v <- xs`（[]i64 形参）——五块 pre/hdr/body/upd/exit，复用 OP-VECLEN/OP-VECGET ──
; 形制钉自 tmp/probe-s62-ir.no（用例 A）：容器是【形参】⇒ 不铺槽，各块直接引用 entry 就存在的
; %vc1（SSA 支配关系合法）；长度只求一次（%v9），hdr 拿 %v11（索引槽 LOAD）与它比；
; 两颗 i64 槽：%s4 = 循环变量同名槽（体内 LOAD 取当前元素）、%s6 = 合成索引槽 @idx<node>
test-coll-basic = () {
    src = 'va = (xs []i64) (r i64) {\n    r = 0\n    v <- xs: {\n        r = r + v\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'coll-basic unsup')
    runner.eq(ir.contains('define i64 @va(%vec %vc1)'), 1, 'coll-basic define vec param')

    ; entry：三颗 i64 槽（r / v / @idx）按 loc 序铺开；vec 形参【不得】出现 alloca %vec
    runner.eq(ir.contains('%s2 = alloca i64'), 1, 'coll-basic out slot')
    runner.eq(ir.contains('%s4 = alloca i64'), 1, 'coll-basic loop-var slot')
    runner.eq(ir.contains('%s6 = alloca i64'), 1, 'coll-basic index slot')
    runner.eq(ir.contains('alloca %vec'), 0, 'coll-basic no vec alloca')

    ; pre：索引置 0 + 长度只求一次（紧接着 BR hdr）
    runner.eq(ir.contains('%v10 = add i64 0, 0\n\tstore i64 %v10, i64* %s6\n\tbr label %bb1'), 1, 'coll-basic idx zero')
    runner.eq(ir.contains('%v9 = call i64 @vec_len(%vec %vc1)'), 1, 'coll-basic len once')

    ; hdr：LOAD 索引 → slt(len) → CONDBR(body bb2, exit bb4)
    runner.eq(ir.contains('bb1:\n\t%v11 = load i64, i64* %s6\n\t%c16 = icmp slt i64 %v11, %v9'), 1, 'coll-basic header cmp against single len')
    runner.eq(ir.contains('br i1 %c17, label %bb2, label %bb4'), 1, 'coll-basic condbr body/exit')

    ; body：VECGET(vec, idx) 落进循环变量槽，体内读的是槽
    runner.eq(ir.contains('bb2:\n\t%v13 = call i64 @vec_get_i64(%vec %vc1, i64 %v11)\n\tstore i64 %v13, i64* %s4'), 1, 'coll-basic body get+store')
    runner.eq(ir.contains('%v14 = load i64, i64* %s2\n\t%v15 = load i64, i64* %s4\n\t%v16 = add i64 %v14, %v15'), 1, 'coll-basic body reads slot')
    runner.eq(ir.contains('store i64 %v16, i64* %s2\n\tbr label %bb3'), 1, 'coll-basic body br update')

    ; upd：索引 +1 后跳回 hdr；exit：后继即隐式 RET
    runner.eq(ir.contains('bb3:\n\t%v17 = load i64, i64* %s6\n\t%v18 = add i64 0, 1\n\t%v19 = add i64 %v17, %v18\n\tstore i64 %v19, i64* %s6\n\tbr label %bb1'), 1, 'coll-basic update steps and loops')
    runner.eq(ir.contains('bb4:\n\t%v20 = load i64, i64* %s2\n\tret i64 %v20'), 1, 'coll-basic exit ret')

    ; 鉴别力：块数恰好 5（entry+bb1..bb4）；长度不得被第二次求出（再求会挤掉后续值 id）
    runner.eq(ir.contains('bb5:'), 0, 'coll-basic no spare block')
    runner.eq(ir.contains('%v9 = call i64 @vec_len(%vec %vc1)\n\t%v10 = add i64 0, 0'), 1, 'coll-basic len not recomputed')
}

; ── s62：`for v <- xs { }` 关键字形（cond 位 = 循环变量自身 IDENT）与运算符形走同一条路 ──
test-coll-kw = () {
    src = 'vb = (xs []i64) (r i64) {\n    r = 0\n    for v <- xs {\n        r = r + v\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'coll-kw unsup')
    runner.eq(ir.contains('define i64 @vb(%vec %vc1)'), 1, 'coll-kw define')

    ; 与运算符形同形：同一个 hdr 比较、同一个 body get、同一个 upd 回跳（只差函数名）
    runner.eq(ir.contains('bb1:\n\t%v11 = load i64, i64* %s6\n\t%c16 = icmp slt i64 %v11, %v9'), 1, 'coll-kw same header as operator form')
    runner.eq(ir.contains('%v13 = call i64 @vec_get_i64(%vec %vc1, i64 %v11)'), 1, 'coll-kw same body')
    runner.eq(ir.contains('bb4:\n\t%v20 = load i64, i64* %s2\n\tret i64 %v20'), 1, 'coll-kw same exit')
}

; ── s62：体内 guard break——跳出落 exit，循环后继语句照跑（与 s60m/s61 同口径）──
test-coll-break = () {
    src = 'vc = (xs []i64) (r i64) {\n    r = 0\n    v <- xs: {\n        v == 2 -> break\n        r = r + v\n    }\n    r = r + 100\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'coll-break unsup')
    runner.eq(ir.contains('bb2:\n\t%v13 = call i64 @vec_get_i64(%vec %vc1, i64 %v11)\n\tstore i64 %v13, i64* %s4\n\t%v14 = load i64, i64* %s4'), 1, 'coll-break body loads element')

    ; break 目标 = exit（bb4），不是 update（bb3）；其后后继语句也在 bb4 照跑
    runner.eq(ir.contains('bb5:\n\tbr label %bb4'), 1, 'coll-break br to exit not update')
    runner.eq(ir.contains('bb4:\n\t%v23 = load i64, i64* %s2\n\t%v24 = add i64 0, 100'), 1, 'coll-break exit runs successor')
}

; ── s62：体内 guard continue——落 update（先自增再判），本轮累加被跳过 ──
test-coll-cont = () {
    src = 'vd = (xs []i64) (r i64) {\n    r = 0\n    v <- xs: {\n        v == 1 -> continue\n        r = r + v\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'coll-cont unsup')

    ; continue 目标 = update（bb3）：落它就能自增索引，不会活锁
    runner.eq(ir.contains('bb5:\n\tbr label %bb3'), 1, 'coll-cont br to update not exit')
    runner.eq(ir.contains('bb7:\n\t%v17 = load i64, i64* %s2\n\t%v18 = load i64, i64* %s4'), 1, 'coll-cont merge after guard')
}

; ── s62：嵌套异名容器遍历——四颗独立槽（两颗循环变量 + 两颗索引），内层 exit 落到外层 update ──
test-coll-nested = () {
    src = 've = (xs []i64, ys []i64) (r i64) {\n    r = 0\n    a <- xs: {\n        b <- ys: {\n            r = r + 1\n        }\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'coll-nested unsup')
    runner.eq(ir.contains('define i64 @ve(%vec %vc1, %vec %vc2)'), 1, 'coll-nested define')

    ; 两个容器各取一次长度，各用自己的 %vc（索引槽 %s7 属外层、%s11 属内层）
    runner.eq(ir.contains('%v14 = call i64 @vec_len(%vec %vc1)'), 1, 'coll-nested outer len')
    runner.eq(ir.contains('%v19 = call i64 @vec_len(%vec %vc2)'), 1, 'coll-nested inner len')
    runner.eq(ir.contains('bb1:\n\t%v16 = load i64, i64* %s7'), 1, 'coll-nested outer hdr uses outer idx slot')
    runner.eq(ir.contains('bb5:\n\t%v21 = load i64, i64* %s11'), 1, 'coll-nested inner hdr uses inner idx slot')

    ; 内层 exit（bb8）后继即外层 update（bb3）⇒ 外层计数照走
    runner.eq(ir.contains('bb8:\n\tbr label %bb3'), 1, 'coll-nested inner exit falls to outer update')
}

; ── s62 门禁：容器源／用法的入形边界 ──
;   五类仍不入形（str 源 / 体内改写循环变量 / 嵌套同名 / 标量源 / 元素非 i64）：
;   均计 unsup 且不产码；第六类「vec 作返回值」已由切片 6 ② 放行，末条反过来钉住它。
test-coll-gate = () {

    ; str 源：Go 逐码点走 lowerStrRangeFor（utf8_at + 宽度三颗槽），noc 无该 op
    src-str = 'ga = (s str) (r i64) {\n    r = 0\n    c <- s: {\n        r = r + 1\n    }\n}\n'
    t1 = ast.make()
    r1 = ps.parse(t1, ps.new(src-str.to-bytes()))
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'coll-gate-str counted')
    runner.eq(ir1.contains('define'), 0, 'coll-gate-str no code')

    ; 体内改写循环变量：Go bindElemPlace 写回容器元素，noc 的 VECGET 交出副本 ⇒ 语义分岔
    src-w = 'gb = (xs []i64) (r i64) {\n    r = 0\n    v <- xs: {\n        v = 9\n    }\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-w.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'coll-gate-write counted')
    runner.eq(ir2.contains('define'), 0, 'coll-gate-write no code')

    ; 嵌套同名：两层共用一颗循环变量槽 ⇒ 内层踩掉外层遍历，整函数不产码
    src-n = 'gc2 = (xs []i64) (r i64) {\n    r = 0\n    v <- xs: {\n        v <- xs: {\n            r = r + 1\n        }\n    }\n}\n'
    t3 = ast.make()
    r3 = ps.parse(t3, ps.new(src-n.to-bytes()))
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'coll-gate-nest counted')
    runner.eq(ir3.contains('define'), 0, 'coll-gate-nest no code')

    ; 标量源（i64 形参）：容器位不是 vec ⇒ 无 OP-VECLEN 的合法实参
    src-s = 'gd = (x i64) (r i64) {\n    r = 0\n    v <- x: {\n        r = r + 1\n    }\n}\n'
    t4 = ast.make()
    r4 = ps.parse(t4, ps.new(src-s.to-bytes()))
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)
    runner.eq(agg4.unsup > 0, 1, 'coll-gate-scalar counted')
    runner.eq(ir4.contains('define'), 0, 'coll-gate-scalar no code')

    ; vec 作返回值：切片 6 ② 起**放行**（h2m-func-sig 的 return 侧不再拒 TY-VEC）。
    ;   OP-RET 走 cg 通用分支，返回的 %vec 由调用方持有，所有权移交、不双 free。
    ;   本条是「门禁已撤」的反向钉子：再有人在签名侧把 TY-VEC 挡回去，这里会红。
    src-r = 'ge = (xs []i64) (r []i64) {\n    r = xs\n}\n'
    t5 = ast.make()
    r5 = ps.parse(t5, ps.new(src-r.to-bytes()))
    agg5 = h2m-new()
    ir5 = h2m-lower-program(t5, agg5, r5)
    runner.eq(agg5.unsup, 0, 'coll-gate-ret-vec gate lifted (unsup==0)')
    runner.eq(ir5.contains('define %vec @ge'), 1, 'coll-gate-ret-vec returns %vec')

    ; 元素非 i64 的 vec（[]str）：@vec_get_i64 是单型 helper ⇒ 签名侧就不入形
    src-e = 'gf = (xs []str) (r i64) {\n    r = 0\n    v <- xs: {\n        r = r + 1\n    }\n}\n'
    t6 = ast.make()
    r6 = ps.parse(t6, ps.new(src-e.to-bytes()))
    agg6 = h2m-new()
    ir6 = h2m-lower-program(t6, agg6, r6)
    runner.eq(agg6.unsup > 0, 1, 'coll-gate-elem-str counted')
    runner.eq(ir6.contains('define'), 0, 'coll-gate-elem-str no code')
}

; ── s63：三臂值匹配——逐臂在本臂判定块内 LOAD 主体并与型样发 icmp eq──
; ⚠️ 收闸前的错码形是「型样字面量直接当布尔条件」（%c = icmp ne i64 <pat>, 0 且主体从不 load），
;     本例同时钉住【错码形不得出现】
test-vm-arm3 = () {
    src = 'f = (x i64) (r i64) {\n    r = 0\n    x: {\n        1 -> r = 10\n        2 -> r = 20\n        -> r = 30\n    }\n}\n'
    t = ast.make()
    root = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'vm3 unsup')
    runner.eq(ir.contains('%v8 = load i64, i64* %s2'), 1, 'vm3 arm1 loads subject')
    runner.eq(ir.contains('%c11 = icmp eq i64 %v8, %v7'), 1, 'vm3 arm1 subject eq pattern')
    runner.eq(ir.contains('br i1 %c12, label %bb2, label %bb3'), 1, 'vm3 arm1 condbr')
    runner.eq(ir.contains('%c18 = icmp eq i64 %v12, %v11'), 1, 'vm3 arm2 re-loads and compares')
    runner.eq(ir.contains('br i1 %c19, label %bb4, label %bb5'), 1, 'vm3 arm2 condbr')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'vm3 arm1 body store')
    runner.eq(ir.contains('store i64 %v14, i64* %s4'), 1, 'vm3 arm2 body store')
    runner.eq(ir.contains('store i64 %v15, i64* %s4'), 1, 'vm3 wildcard body store')
    runner.eq(ir.contains('ret i64 %v16'), 1, 'vm3 merge loads result')

    ; 旧错码形：拿型样字面量 %v7 本身当条件判非零 ⇒ 恒真，不得再现
    runner.eq(ir.contains('%c11 = icmp ne i64 %v7, 0'), 0, 'vm3 pattern-not-used-as-condition')
}

; ── s63：单值样臂无兜底——假路直落汇聚块，不留空判定块──
test-vm-nowild = () {
    src = 'g = (x i64) (r i64) {\n    r = 7\n    x: {\n        3 -> r = 1\n    }\n}\n'
    t = ast.make()
    root = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'vmnw unsup')
    runner.eq(ir.contains('%c11 = icmp eq i64 %v8, %v7'), 1, 'vmnw compare')
    runner.eq(ir.contains('br i1 %c12, label %bb2, label %bb1'), 1, 'vmnw false to merge')
    runner.eq(ir.contains('bb3:'), 0, 'vmnw no spare block')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'vmnw arm body store')
    runner.eq(ir.contains('ret i64 %v11'), 1, 'vmnw ret loaded')
}

; ── s63：主体是局部量（不只有形参）——槽表前扫描已登记，校验期查到同名 i64 槽即可──
; ⚠️ 主体初始化用【拷贝】y i64 = x 而非 y i64 = x - 1：实测 Go 侧 checker 拒「把 ?i64 赋给 i64 变量」
;     （算术结果带 option，需就地解包），语料必须两侧都合法才能对拍
test-vm-local = () {
    src = 'p = (x i64) (r i64) {\n    y i64 = x\n    r = 0\n    y: {\n        1 -> r = 3\n        -> r = 4\n    }\n}\n'
    t = ast.make()
    root = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'vmlocal unsup')
    runner.eq(ir.contains('store i64 %v8, i64* %s4'), 1, 'vmlocal subject slot initialized')
    runner.eq(ir.contains('%v11 = load i64, i64* %s4'), 1, 'vmlocal loads the local slot')
    runner.eq(ir.contains('%c16 = icmp eq i64 %v11, %v10'), 1, 'vmlocal compare')
    runner.eq(ir.contains('br i1 %c17, label %bb2, label %bb3'), 1, 'vmlocal condbr')
    runner.eq(ir.contains('ret i64 %v15'), 1, 'vmlocal ret loaded')
}

; ── s63：臂体是多陈述块——两条陈述同块发射，块尾单条 BR 回汇聚──
test-vm-block = () {
    src = 'q = (x i64) (r i64) {\n    r = 0\n    x: {\n        1 -> {\n            r = 5\n            r = r * 2\n        }\n        -> r = 1\n    }\n}\n'
    t = ast.make()
    root = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'vmblock unsup')
    runner.eq(ir.contains('%c11 = icmp eq i64 %v8, %v7'), 1, 'vmblock compare')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'vmblock first stmt store')
    runner.eq(ir.contains('%v13 = mul i64 %v11, %v12'), 1, 'vmblock second stmt mul')
    runner.eq(ir.contains('store i64 %v13, i64* %s4'), 1, 'vmblock second stmt store back')
    runner.eq(ir.contains('br label %bb1'), 1, 'vmblock arm tail br merge')
    runner.eq(ir.contains('ret i64 %v15'), 1, 'vmblock ret loaded')
}

; ── s63：区间遍历体内套值匹配（s61 × s63）——主体就是遍历变量槽──
test-vm-in-range = () {
    src = 's = (n i64) (r i64) {\n    r = 0\n    i <- [0..3): {\n        i: {\n            0 -> r = r + 1\n            1 -> r = r + 10\n            -> r = r + 100\n        }\n    }\n}\n'
    t = ast.make()
    root = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'vmrange unsup')
    runner.eq(ir.contains('%c35 = icmp eq i64 %v22, %v21'), 1, 'vmrange arm1 compares loop var')
    runner.eq(ir.contains('br i1 %c36, label %bb13, label %bb14'), 1, 'vmrange arm1 condbr')
    runner.eq(ir.contains('%c44 = icmp eq i64 %v28, %v27'), 1, 'vmrange arm2 compares')
    runner.eq(ir.contains('%v32 = add i64 %v30, %v31'), 1, 'vmrange arm2 body adds 10')
    runner.eq(ir.contains('%v35 = add i64 %v33, %v34'), 1, 'vmrange wildcard body adds 100')
    runner.eq(ir.contains('%v39 = add i64 %v37, %v38'), 1, 'vmrange loop update still runs')
    runner.eq(ir.contains('ret i64 %v43'), 1, 'vmrange exit ret')
}

; ── s63：值匹配臂体内再套值匹配（嵌套链）——内链汇聚块只拿到外链臂体的尾 BR──
test-vm-nested = () {
    src = 'u = (x i64, y i64) (r i64) {\n    r = 0\n    x: {\n        1 -> {\n            y: {\n                2 -> r = 8\n                -> r = 9\n            }\n        }\n        -> r = 7\n    }\n}\n'
    t = ast.make()
    root = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'vmnest unsup')
    runner.eq(ir.contains('%c15 = icmp eq i64 %v11, %v10'), 1, 'vmnest outer compare')
    runner.eq(ir.contains('br i1 %c16, label %bb2, label %bb3'), 1, 'vmnest outer condbr')
    runner.eq(ir.contains('%c19 = icmp eq i64 %v14, %v13'), 1, 'vmnest inner compare in outer arm')
    runner.eq(ir.contains('br i1 %c20, label %bb5, label %bb6'), 1, 'vmnest inner condbr')
    runner.eq(ir.contains('bb4:\n\tbr label %bb1'), 1, 'vmnest inner merge carries outer arm br')
    runner.eq(ir.contains('ret i64 %v19'), 1, 'vmnest ret loaded')
}

; ── s63 值匹配形状门禁：主体与型样只要超出「i64 变量名 + 裸整型字面量」一律整函数不产码──
test-vm-gate = () {

    ; 主体是 str：cg 的 OP-CMPEQ 只会发 icmp i64，%str 比不了
    src-s = 'h = (s str) (r i64) {\n    r = 0\n    s: {\n        1 -> r = 1\n        -> r = 2\n    }\n}\n'
    t1 = ast.make()
    r1 = ps.parse(t1, ps.new(src-s.to-bytes()))
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'vm-gate-str-subj counted')
    runner.eq(ir1.contains('define'), 0, 'vm-gate-str-subj no code')

    ; 型样是负数前缀式（UnaryExpression 包字面量）：本件不拆前缀，宁缺勿错
    src-n = 'i = (x i64) (r i64) {\n    r = 0\n    x: {\n        -1 -> r = 1\n        -> r = 2\n    }\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-n.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'vm-gate-neg-pattern counted')
    runner.eq(ir2.contains('define'), 0, 'vm-gate-neg-pattern no code')

    ; 具名型样 `y ->`：Go 侧是绑定／变体判定而非相等比较，错当变量读会静默改语义
    src-m = 'j = (x i64) (r i64) {\n    r = 0\n    x: {\n        y -> r = 1\n        -> r = 2\n    }\n}\n'
    t3 = ast.make()
    r3 = ps.parse(t3, ps.new(src-m.to-bytes()))
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'vm-gate-named-pattern counted')
    runner.eq(ir3.contains('define'), 0, 'vm-gate-named-pattern no code')

    ; 主体是表达式 `n + 1: { … }`：实测 ps.no 不把它建进 Matched（主体丢失）⇒ 退化形照样计 unsup
    src-e = 'k = (n i64) (r i64) {\n    r = 0\n    n + 1: {\n        1 -> r = 1\n        -> r = 2\n    }\n}\n'
    t4 = ast.make()
    r4 = ps.parse(t4, ps.new(src-e.to-bytes()))
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)
    runner.eq(agg4.unsup > 0, 1, 'vm-gate-expr-subj counted')
    runner.eq(ir4.contains('define'), 0, 'vm-gate-expr-subj no code')

    ; 主体未登记（既非形参也非局部量）：槽表查不到 ⇒ 无法证明它是可读的 i64
    src-u = 'm = (x i64) (r i64) {\n    r = 0\n    zz: {\n        1 -> r = 1\n        -> r = 2\n    }\n}\n'
    t5 = ast.make()
    r5 = ps.parse(t5, ps.new(src-u.to-bytes()))
    agg5 = h2m-new()
    ir5 = h2m-lower-program(t5, agg5, r5)
    runner.eq(agg5.unsup > 0, 1, 'vm-gate-unknown-subj counted')
    runner.eq(ir5.contains('define'), 0, 'vm-gate-unknown-subj no code')

    ; 布尔字面量型样 `true ->`：Go 侧同样包成 subj == true，但 subj 是 i64 而 true 另建节点⇒不在本件
    src-b = 'v = (x i64) (r i64) {\n    r = 0\n    x: {\n        true -> r = 1\n        -> r = 2\n    }\n}\n'
    t6 = ast.make()
    r6 = ps.parse(t6, ps.new(src-b.to-bytes()))
    agg6 = h2m-new()
    ir6 = h2m-lower-program(t6, agg6, r6)
    runner.eq(agg6.unsup > 0, 1, 'vm-gate-bool-pattern counted')
    runner.eq(ir6.contains('define'), 0, 'vm-gate-bool-pattern no code')
}

; ── s65 前置：循環目標棧出栈時必须真刪除——只减计数留陈项 ⇒ 兄弟循環第二顆的 break/continue
;    查到第一顆的 block（實測 tmp/s65-sib-ir.txt：arm 块 %bb7 → br label %bb3，運行即死循環回跳）──
test-sib-loop-target = () {

    ; 第二個兄弟前置循環體內 break ⇒ BR 落自己的 exit（%bb6），不是第一顆的 %bb3
    src-b = 'z65b = (n i64) (r i64) {\n    r = 0\n    i = n\n    (i > 0) {\n        i = i - 1\n    }\n    j = n\n    (j > 0) {\n        j = j - 1\n        j < 2 -> break\n    }\n    r = r + 100\n}\n'
    t1 = ast.make()
    r1 = ps.parse(t1, ps.new(src-b.to-bytes()))
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup, 0, 'sib-brk unsup')
    runner.eq(ir1.contains('bb7:\n\tbr label %bb6'), 1, 'sib-brk targets own exit')
    runner.eq(ir1.contains('bb7:\n\tbr label %bb3'), 0, 'sib-brk not stale exit')

    ; 同一位置換成 continue ⇒ BR 落自己的 hdr（%bb4），不是第一顆的 %bb1
    src-c = 'z65c = (n i64) (r i64) {\n    r = 0\n    i = n\n    (i > 0) {\n        i = i - 1\n    }\n    j = n\n    (j > 0) {\n        j = j - 1\n        j < 2 -> continue\n    }\n    r = r + 100\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-c.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup, 0, 'sib-cont unsup')
    runner.eq(ir2.contains('bb7:\n\tbr label %bb4'), 1, 'sib-cont targets own hdr')
    runner.eq(ir2.contains('bb7:\n\tbr label %bb1'), 0, 'sib-cont not stale hdr')
}

; ── s65 前置：epl 元素位名栈陈项 ⇒ 第二個兄弟容器遍历改写循環变量遯漏門禁（静默错码）──
test-coll-sibling-write-gate = () {
    src = 'gs65 = (xs []i64, ys []i64) (r i64) {\n    r = 0\n    v <- xs: {\n        r = r + 1\n    }\n    w <- ys: {\n        w = 9\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'coll-sib-write counted')
    runner.eq(ir.contains('define'), 0, 'coll-sib-write no code')
}

; ── s65 前置：rnms 栈名陈项 ⇒ 已退出的外层循環名被兄弟循環的内层同名误拒 ──
test-rng-sibling-rnms-false-gate = () {

    ; 第一颗区间遍历用 i（已退出）；第二颗用 j，其体内再开 i ——i 与活栈上只有 j 可比 ⇒ 应合法
    src = 'gr65 = (n i64) (r i64) {\n    r = 0\n    i <- [0..3]: {\n        r = r + 1\n    }\n    j <- [0..3]: {\n        i <- [0..2]: {\n            r = r + i\n        }\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'rng-sib-rnms unsup')
    runner.eq(ir.contains('define'), 1, 'rng-sib-rnms code')
}

; ── s65：值匹配臂体里的 `it` 隐式绑定——判定块 LOAD 的主体值压栈后在臂体内直读────
test-it-basic = () {
    src = 'i1x = (n i64) (r i64) {\n    r = 0\n    n: {\n        1 -> r = it\n        -> r = 0\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'it-basic unsup')
    runner.eq(ir.contains('define'), 1, 'it-basic code')
    runner.eq(ir.contains('icmp eq'), 1, 'it-basic cmp')

    ; 臂体读的是判定块 load 的主体值（同一 %vN 存进 r 槽），全程只多这一颗 load
    runner.eq(ir.contains('load i64'), 1, 'it-basic load')
}

; 兜底臂单独吃 it：无判定块 ⇒ 体首块补一次 LOAD
test-it-wild = () {
    src = 'i2x = (n i64) (r i64) {\n    n: {\n        -> r = it\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'it-wild unsup')
    runner.eq(ir.contains('load i64'), 1, 'it-wild load')
    runner.eq(ir.contains('define'), 1, 'it-wild code')
}

; it 参与算术：`r = it + 1` ⇒ add 吃栈顶值 id
test-it-arith = () {
    src = 'i3x = (n i64) (r i64) {\n    r = 0\n    n: {\n        1 -> r = it + 1\n        -> r = 0\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'it-arith unsup')
    runner.eq(ir.contains('add i64'), 1, 'it-arith add')
}

; 嵌套 match：内层臂里 `it` = 内层主体；外层臂退栈后恢复（先拷具名局部 t0 再过内层 match）
test-it-nested = () {
    src = 'i4x = (n i64, m i64) (r i64) {\n    r = 0\n    n: {\n        1 -> {\n            t0 = it\n            m: {\n                2 -> r = it\n                -> r = 9\n            }\n            r = r + t0\n        }\n        -> r = 0\n    }\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'it-nested unsup')
    runner.eq(ir.contains('define'), 1, 'it-nested code')
    runner.eq(ir.contains('icmp eq i64 %v'), 1, 'it-nested cmp')
}

; 门禁：写 `it` / 裸链臂里读 `it` / match 外读 `it` ⇒ 计 unsup 且整函数不产码
test-it-gate = () {
    src-w = 'i5w = (n i64) (r i64) {\n    n: {\n        1 -> {\n            it = 5\n            r = it\n        }\n        -> r = 0\n    }\n}\n'
    t1 = ast.make()
    r1 = ps.parse(t1, ps.new(src-w.to-bytes()))
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'it-gate-write counted')
    runner.eq(ir1.contains('define'), 0, 'it-gate-write no code')

    src-b = 'i5b = (n i64) (r i64) {\n    r = 0\n    {\n        n == 1 -> r = it\n        -> r = 0\n    }\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-b.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'it-gate-bare counted')
    runner.eq(ir2.contains('define'), 0, 'it-gate-bare no code')

    src-o = 'i5o = (n i64) (r i64) {\n    r = it\n}\n'
    t3 = ast.make()
    r3 = ps.parse(t3, ps.new(src-o.to-bytes()))
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'it-gate-outside counted')
    runner.eq(ir3.contains('define'), 0, 'it-gate-outside no code')
}

; ── s66：前缀表达式 -x / !x ──────────────────────────────────────

; 前缀负号作用于变量：r = -x ⇒ sub i64 0, %vx
test-neg-var = () {
    src = 'n1x = (x i64) (r i64) {\n    r = -x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'neg-var unsup')
    runner.eq(ir.contains('sub i64 0'), 1, 'neg-var sub')
    runner.eq(ir.contains('define'), 1, 'neg-var code')
}

; 前缀负号作用于字面量：r = -(5) ⇒ CONST 5 再 NEG
test-neg-lit = () {
    src = 'n2x = () (r i64) {\n    r = -(5)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'neg-lit unsup')
    runner.eq(ir.contains('sub i64 0'), 1, 'neg-lit sub')
}

; 前缀逻辑非：!x ⇒ 先归位低 bit（and i64 1）再 xor i64 1（s88 对齐 Go emitNot 的 `xor i1 1, trunc i64→i1`）
test-not-var = () {
    src = 'n3x = (x i64) (r i64) {\n    r = !x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'not-var unsup')
    runner.eq(ir.contains('xor i64 1'), 1, 'not-var xor')
}

; s88：i64 主体 `!x` 值语义对齐 i1 低位列——Go hir2mir prefixOp '!' ⇒ OpNot、dest 型别 bool
;   （MIR 把 bool 映射为 i1）；codegen.go:6408 emitNot 先 coerceInt(i64→i1) = `trunc i64 … to i1`
;   （取最低位）再 `xor i1 1` ⇒ 值恒 (x&1)^1。自举槽宽统一 i64 ⇒ 以 `and i64 x, 1` 表达 trunc、
;   `xor i64 1` 表达 xor（同值域 {0,1}，型别正确性不靠 IR 文本鑑別，口径同 s83）。
;   分岔靶：tmp/probe-s88-ir.no exit 362（旧全宽形）vs tmp/s88-oracle-i64.no exit 117（态 T）
test-not-i64-lowbit = () {
    src = 'n9x = (x i64) (r i64) {\n    r = !x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'not-i64-lowbit unsup')
    runner.eq(ir.contains('and i64'), 1, 'not-i64-lowbit mask')
    runner.eq(ir.contains('xor i64 1'), 1, 'not-i64-lowbit xor')
}

; 嵌套双负：-(-x) ⇒ 两颗 sub
test-neg-nested = () {
    src = 'n4x = (x i64) (r i64) {\n    r = -(-x)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'neg-nested unsup')
    runner.eq(ir.contains('sub i64 0'), 1, 'neg-nested sub present')
}

; 前缀参与二元：r = -x + 3 ⇒ NEG 再 ADD
test-neg-in-expr = () {
    src = 'n5x = (x i64) (r i64) {\n    r = -x + 3\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'neg-expr unsup')
    runner.eq(ir.contains('sub i64 0'), 1, 'neg-expr sub')
    runner.eq(ir.contains('add i64'), 1, 'neg-expr add')
}

; 位非（s69）：~x ⇒ xor i64 %v, %v 且上数 CONST -1（add i64 0, -1），区别于 !x 的 xor i64 %v, 1
test-bitnot-var = () {
    src = 'q1x = (x i64) (r i64) {\n    r = ~x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bitnot-var unsup')
    runner.eq(ir.contains('add i64 0, -1'), 1, 'bitnot-var const -1')
    runner.eq(ir.contains('xor i64 %v'), 1, 'bitnot-var xor reg')
    runner.eq(ir.contains('define'), 1, 'bitnot-var code')
}

; 位非嵌套：~(~x) ⇒ 两颗 xor（值 id 不同，均对 -1）
test-bitnot-nested = () {
    src = 'q2x = (x i64) (r i64) {\n    r = ~(~x)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bitnot-nested unsup')
    runner.eq(ir.contains('xor i64 %v'), 1, 'bitnot-nested xor')
    runner.eq(ir.contains('add i64 0, -1'), 1, 'bitnot-nested const')
}

; 位非参与二元：r = ~x + 3 ⇒ XOR 再 ADD
test-bitnot-in-expr = () {
    src = 'q3x = (x i64) (r i64) {\n    r = ~x + 3\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bitnot-expr unsup')
    runner.eq(ir.contains('xor i64 %v'), 1, 'bitnot-expr xor')
    runner.eq(ir.contains('add i64'), 1, 'bitnot-expr add')
}

; 门控：~s（str 主體）不在 i64 覆盖面 ⇒ unsup（s69 把旧 ~x(i64) 门控改为 str 门控，因 ~x 已支持）
test-prefix-gate = () {
    src = 'q4x = (s str) (r str) {\n    r = ~s\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'prefix-gate counted')
    runner.eq(ir.contains('define'), 0, 'prefix-gate no code')
}

; ── f64 主体位非 ~x 负向门禁哨兵（s86）──────────────────────────
;   Go 侧 f64 `~` 属未定义区：运行路 hir2mir.go:8878 OpXor(rt=f64) 经 emitBitwise
;   发 `xor double`（LLVM 非法指令，s86 实测 clang "instruction requires integer or
;   integer vector operands" build fail，见 tmp/probe-s86-b.no）；
;   常量路 hir2mir.go:7152 comptime 用 cvInt 域 ^ 折叠 float 字面量（s86 实测
;   tmp/probe-s86-a.no 四比较全折成 false）⇒ 无可镜像的权威执行语义。
;   自举端维持 unsup 门禁（h2m.no K-PREFIX 臂 ok-p==0 → h2m-mark），本测试钉死防误放行
test-prefix-not-f64-gate = () {
    src = 'q5x = (x f64) (r f64) {\n    r = ~x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'prefix-~f64-gate counted')
    runner.eq(ir.contains('define'), 0, 'prefix-~f64-gate no code')
}

; s89 裁定纪实：f64 主体 '!' 维持门禁——Go 侧 double→i1 无权威可镜像：
;   运行路 codegen.go coerceInt(i64→i1) 对 f64 截出 poison 再 xor i1 1 ⇒ 恒 true（s88 d1 实钉）；
;   自举端 '!' 臂（h2m.no K-PREFIX）只认 TY-I64/TY-U64，f64 主体落 ok-p==0 → h2m-mark
;   本哨兵钉死门禁在位（实作零改件，红相缺席即门禁证据，镜像 s86 裁定族纪律）
test-prefix-lnot-f64-gate = () {
    src = 'q5y = (x f64) (r i64) {\n    r = !x\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'prefix-!f64-gate counted')
    runner.eq(ir.contains('define'), 0, 'prefix-!f64-gate no code')
}

; s89 裁定纪实：str 主体 '!' 维持门禁——Go 侧同样无路：
;   运行路 str 形参 intWidth 查不到 ⇒ coerceInt 原样返回，emitNot 发 `xor i1 1, %str-long`
;   类型错 build fail（trace d8en6a9j，tmp/s89-env-str.no 实测）；
;   字面量路 hir inline comptime 折叠恒 true（空串也 true，证伪任何空检语义）
test-prefix-lnot-str-gate = () {
    src = 'q5z = (s str) (r i64) {\n    r = !s\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'prefix-!str-gate counted')
    runner.eq(ir.contains('define'), 0, 'prefix-!str-gate no code')
}

; s90 裁决：bool 字面量降级——镜像 Go hir2mir.go KBoolLit ⇒ EmitInt(OpConst, 0/1)
;   自举表示走 TY-I64 0/1（Go MIR 层载荷本就是 int64、i1 形属后端类型环境）；
;   true ⇒ OP-CONST(TY-I64, 1) ⇒ cg 发 `%v = add i64 0, 1`
test-bool-lit-true = () {
    src = 'q6a = () (r i64) {\n    r = true\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bool-lit-true unsup')
    runner.eq(ir.contains('add i64 0, 1'), 1, 'bool-lit-true const 1')
    runner.eq(ir.contains('define'), 1, 'bool-lit-true code')
}

; false ⇒ OP-CONST(TY-I64, 0) ⇒ `%v = add i64 0, 0`
test-bool-lit-false = () {
    src = 'q6b = () (r i64) {\n    r = false\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bool-lit-false unsup')
    runner.eq(ir.contains('add i64 0, 0'), 1, 'bool-lit-false const 0')
    runner.eq(ir.contains('define'), 1, 'bool-lit-false code')
}

; s90：h2m-ty-code('bool') ⇒ TY-I64——bool 形参可铺槽（与整族共用 i64 宽口径同 s78/s83/s88）
test-bool-param-tycode = () {
    src = 'q6c = (b bool) (r i64) {\n    r = 0\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bool-param unsup')
    runner.eq(ir.contains('define'), 1, 'bool-param code')
}

; s91 裁决：char 字面量降级——镜像 Go lowerCharLit（KCharLit ⇒ EmitInt(OpConst, 首码点)）
;   自举 char⇒TY-I64 码点（Go i32，自举无 i32 槽、码点 ≤0x10FFFF 落 i64 精确，同 bool 宽口径）
;   ASCII："a" ⇒ 97 ⇒ cg 发 `%v = add i64 0, 97`
test-char-lit-ascii = () {
    src = 'q7a = () (r i64) {\n    r = "a"\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'char-lit-ascii unsup')
    runner.eq(ir.contains('add i64 0, 97'), 1, 'char-lit-ascii const 97')
    runner.eq(ir.contains('define'), 1, 'char-lit-ascii code')
}

; 多字节 UTF-8："中" ⇒ 首码点 20013（E4 B8 AD ⇒ (0xE4&0xF)<<12 | (0xB8&0x3F)<<6 | (0xAD&0x3F)）
test-char-lit-cjk = () {
    src = 'q7b = () (r i64) {\n    r = "中"\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'char-lit-cjk unsup')
    runner.eq(ir.contains('add i64 0, 20013'), 1, 'char-lit-cjk const 20013')
    runner.eq(ir.contains('define'), 1, 'char-lit-cjk code')
}

; s91：h2m-ty-code('char') ⇒ TY-I64——char 形参可铺槽（与整族共用 i64 宽口径）
test-char-param-tycode = () {
    src = 'q7c = (c char) (r i64) {\n    r = 0\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'char-param unsup')
    runner.eq(ir.contains('define'), 1, 'char-param code')
}

; 參數默認值已從語言移除（Go 側是 E_DEFAULT_PARAM 硬錯）：
;   自舉解析器只消費並丟棄 `= expr`，因此「缺參呼叫」沒有任何可回填的表達式 ⇒ 入門禁。
;   本測試釘住：帶默認值語法的定義本身仍可降級（單形參），但 `q7d()` 這種缺參呼叫被拒。
test-default-param-removed = () {
    src = 'q7d = (n i64 = 5) (r i64) {\n    r = n\n}\nw7d = () (r i64) {\n    r = q7d()\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'default-removed missing counted')
    runner.eq(ir.contains('call i64 @q7d'), 0, 'default-removed no call')
}

; 顯式傳齊實參仍正常產碼（可選性改由 ?T + 呼叫端顯式傳 nil/ok(...) 表達）
test-explicit-arg-ok = () {
    src = 'q7e = (a i64, b i64) (r i64) {\n    r = a + b\n}\nw7e = () (r i64) {\n    r = q7e(1, 20)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'explicit-arg unsup')
    runner.eq(ir.contains('call i64 @q7e('), 1, 'explicit-arg call')
    runner.eq(ir.contains('define'), 1, 'explicit-arg code')
}

; 负例门禁：缺参 ⇒ 拒（对齐 Go：parser/checker 前置拒，自举无 checker 在此兜住）
test-default-param-missing-gate = () {
    src = 'q7f = (n i64) (r i64) {\n    r = n\n}\nw7f = () (r i64) {\n    r = q7f()\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'default-missing counted')
    runner.eq(ir.contains('call i64 @q7f'), 0, 'default-missing no call')
}

; s93 语句位调用（镜像 Go hir2mir.go KExprStmt 的 lowerExpr(child) 路——结果丢弃）
;   无输出参被调沿用既有「void ⇒ define i64 + ret 0」约定，调用发 call i64 并把结果值丢掉
test-stmt-call-void = () {
    src = 's7v = (n i64) {\n    x = n\n}\ns7w = () (r i64) {\n    s7v(3)\n    r = 8\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'stmt-call-void unsup')
    runner.eq(ir.contains('call i64 @s7v('), 1, 'stmt-call-void call emitted')
    runner.eq(ir.contains('add i64 0, 8'), 1, 'stmt-call-void caller body')
}

; 非 void 被调在陈述位：结果不绑变量 ⇒ 照样发调用（副作用在序）、呼叫者自身结果不受扰
test-stmt-call-discard = () {
    src = 's7q = () (q i64) {\n    q = 3\n}\ns7u = () (r i64) {\n    s7q()\n    r = 5\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'stmt-disc unsup')
    runner.eq(ir.contains('call i64 @s7q('), 1, 'stmt-disc call emitted')
}

; guard 单陈述臂体里的调用（`n > 0 -> s7v(1)`）：走 lower-if → lower-block 同一条回填路
test-stmt-call-guard = () {
    src = 's7y = (n i64) {\n    x = n\n}\ns7z = (n i64) (r i64) {\n    r = 0\n    n > 0 -> s7y(1)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'stmt-guard unsup')
    runner.eq(ir.contains('call i64 @s7y('), 1, 'stmt-guard call emitted')
}

; 负例门禁：语句位裸字面量仍拒——Go 在 checker 层 checkBareExprStatement 专拒
test-stmt-expr-bare-gate = () {
    src = 's7b = () (r i64) {\n    7\n    r = 9\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'stmt-bare counted')
    runner.eq(ir.contains('@s7b'), 0, 'stmt-bare no code')
}

; s94：?u64 option 三件套（镜像 Go wrapOptionIfNeeded／lowerNilLit／延迟零值 option→nil）
;   覆盖面限直线式（mem==0）；TY-OPT 铺槽、option match 臂均在门外（哨兵钉住门禁）

; 回值位隐式 some 包裹：?u64 输出参 + u64 右值 ⇒ OP-OPTSOME（tag=0 + slot[0]=%v）
test-opt-wrap-return = () {
    src = 'q8a = (n u64) (r ?u64) {\n    r = n\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-wrap unsup')
    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v'), 1, 'opt-wrap some emit')
    runner.eq(ir.contains('define %option @q8a'), 1, 'opt-wrap define %option')
}

; nil 字面量降级：r = nil ⇒ OP-OPTNONE（tag=1 的 none 判别式，镜像 Go lowerNilLit）
test-opt-nil-return = () {
    src = 'q8b = () (r ?u64) {\n    r = nil\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-nil unsup')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }'), 1, 'opt-nil none emit')
}

; 延迟零值：?u64 输出参全程未赋值 ⇒ 回值位补 OPTNONE（option→nil = tag=1，非 zeroinitializer 的 tag=0）
test-opt-deferred-zero = () {
    src = 'q8c = () (r ?u64) {\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-zero unsup')
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }'), 1, 'opt-zero none emit')
}

; capture 标注放行：`z = q8d()`（q8d 回 ?u64）的 let 标注被解析期合成成 NullableType ⇒ 调用+回绑皆入形
test-opt-capture-call = () {
    src = 'q8d = () (r ?u64) {\n    r = nil\n}\nw8d = () (res ?u64) {\n    z = q8d()\n    res = z\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-capture unsup')
    runner.eq(ir.contains('call %option @q8d('), 1, 'opt-capture call %option')
}

; ?u64 形参入形：option 输入参直传（vty TY-OPT ⇒ %option/%op 命名空间）
test-opt-param-tycode = () {
    src = 'q8f = (o ?u64) (r ?u64) {\n    r = o\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-param unsup')
    runner.eq(ir.contains('define %option @q8f(%option'), 1, 'opt-param %option formal')
}

; s97：控制流 + ?u64 输出参入形（TY-OPT 铺槽）——nil-init + 写点 some-wrap，未写路径读回 nil（非 some(0)）
test-opt-flow-slot = () {
    src = 'q8g = (n u64) (r ?u64) {\n    n > 0 -> r = n\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'opt-flow-slot unsup')
    runner.eq(ir.contains('%os4 = alloca %option'), 1, 'opt-flow-slot OPTALLOC')

    ; entry 槽 tag=1 nil-init（正是 s94 门禁所防：误做 zeroinitializer/some(0) ⇒ tag=0）
    runner.eq(ir.contains('insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 1, 0'), 1, 'opt-flow-slot nil-init')

    ; 取路写点包裹：payload %v → some（OP-OPTSOME）落槽
    runner.eq(ir.contains('insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v'), 1, 'opt-flow-slot write wrap')
    runner.eq(ir.contains('store %option'), 1, 'opt-flow-slot OPTSTORE')
    runner.eq(ir.contains('load %option'), 1, 'opt-flow-slot OPTLOAD')
    runner.eq(ir.contains('ret %option'), 1, 'opt-flow-slot ret %option')
}

; 负例门禁：非 i64 宽載荷不包（str 右值进 ?u64 回值位 ⇒ ty-match 门禁，不发 opt-vs-%sv 垃圾 IR）
test-opt-payload-gate = () {
    src = 'q8h = (s str) (r ?u64) {\n    r = s\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'opt-payload counted')
    runner.eq(ir.contains('@q8h'), 0, 'opt-payload no code')
}

; s95：?i64 option 三件套——内层整型放宽（h2m-tynode-code 认 'i64'）
;   %option 載荷槽 [3 x i64]，i64／u64 同 64 位整宽⇒与 ?u64 逐字节同形；镜像 Go wrapOptionIfNeeded 整型内层分岔

; 回值位隐式 some 包裹：?i64 输出参 + i64 右值 ⇒ OP-OPTSOME（p-ty TY-I64 走 some-wrap 已放行分支）
test-opt-i64-wrap-return = () {
    src = 'q9a = (n i64) (r ?i64) {\n    r = n\n}\n'
