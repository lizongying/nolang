; ── s99k：控制流函數（mem==1）的 scope-exit 釋放（解除 s99j 的 mem==0 限制）──
;   證明：mem==1 下輸出參住槽、退出重讀是 STLOAD 新 id，故 s99j 原本只放行 mem==0；本件
;   (1) 追蹤「最後寫入輸出槽的值 id = outsv」於釋放時跳過（正確跳過回傳值，防雙重釋放）；
;   (2) 加保守閘門——mem==1 且函數【含 OP-CALL】時不放行（本地結構體 move 給被調後 caller/callee
;       雙釋放需 move 分析，留待未來），保持 leak 而非引入 double-free。

test-s99k-local-release = () {

    ; mem==1（含循环）下，本地結構體（非回傳值，含 str 欄位）仍須 scope-exit 釋放
    src = 'User {\n    id i64\n    name str\n}\n\nf = () (r i64) {\n    u = User { id: 1, name: \'alice\' }\n    n = 0\n    (n < 5) { n = n + 1 }\n    r = 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99k local-release unsup')

    ; mem 模式：槽聲明證明確實走 mem==1 路徑
    runner.eq(ir.contains('alloca %struct.s0'), 1, 's99k local-release mem mode (slot)')

    ; 取得所有權（s99g）與 scope-exit 釋放（本件）皆發：retain 1 次、release 1 次
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp'), 1, 's99k local-release retain emitted')
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %rp'), 1, 's99k local-release release emitted (mem==1 path)')
}

test-s99k-return-no-release = () {

    ; mem==1 下結構體即回傳值：RETAIN 仍發，但 scope-exit 釋放須跳過回傳值（outsv）防雙重釋放
    src = 'User {\n    id i64\n    name str\n}\n\nf = () (r User) {\n    n = 0\n    (n < 5) { n = n + 1 }\n    r = User { id: 1, name: \'alice\' }\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99k return-no-release unsup')
    runner.eq(ir.contains('alloca %struct.s0'), 1, 's99k return-no-release mem mode (slot)')

    ; 取得所有權仍發
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp'), 1, 's99k return retain emitted')

    ; 關鍵：回傳值被 outsv 跳過 ⇒ 不得發 release（否則呼叫方 double-free）
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %rp'), 0, 's99k return NO release (outsv skip)')
}

; ── s99m：解除 s99k 的 hc 整函數閘門（§5.6.1 鐵律：傳參不 retain／callee 不 release 參數／caller 最後使用後
;   release）⇒ call 是借用而非 move，含 OP-CALL 的 mem==1 函數亦可釋放局部自擁有值；雙重釋放改由 retset
;   兜住「間接回傳 r = u」（mem==1 下 STLOAD 新 id ≠ owner，舊 skip/outsv 覆蓋不到）。──

test-s99m-call-borrow-release = () {

    ; mem==1 + 含 OP-CALL，本地結構體【傳給被調】（借用）：caller 仍擁有 ⇒ scope-exit 必須釋放（不再因 call 而 leak）
    src = 'User {\n    id i64\n    name str\n}\n\ng = (x User) (z i64) { z = x.id }\n\nf = () (r i64) {\n    u = User { id: 1, name: \'alice\' }\n    n = 0\n    (n < 3) {\n        r = g(u)\n        n = n + 1\n    }\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99m call-borrow unsup')
    runner.eq(ir.contains('alloca %struct.s0'), 1, 's99m call-borrow mem mode (slot)')

    ; 取得所有權（MK of u）
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp'), 1, 's99m call-borrow retain emitted')

    ; s99m：撤除 hc 閘門 ⇒ 含 call 亦釋放（g 借用 u，caller 釋放不雙重釋放）
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %rp'), 1, 's99m call-borrow release emitted (gate removed)')
}

test-s99m-indirect-return-no-release = () {

    ; 間接回傳 r = u：mem==1 下 STLOAD 交出新 id ≠ owner，舊 skip/outsv 失效 ⇒ 本件用 owner provenance 跳過防雙重釋放
    src = 'User {\n    id i64\n    name str\n}\n\nf = () (r User) {\n    u = User { id: 1, name: \'alice\' }\n    n = 0\n    (n < 3) { n = n + 1 }\n    r = u\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99m indirect-return unsup')
    runner.eq(ir.contains('alloca %struct.s0'), 1, 's99m indirect-return mem mode (slot)')

    ; 取得所有權仍發（MK of u）
    runner.eq(ir.contains('call void @nolang_rc_retain(i8* %rp'), 1, 's99m indirect-return retain emitted')

    ; 關鍵：u 經 r 回傳 ⇒ owner 併入 outsv/retset ⇒ 不得釋放（否則呼叫方拿到懸垂串 / 雙重釋放）
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %rp'), 0, 's99m indirect-return NO release (owner skip)')
}

; ── s99l：純 str RC 的取得所有權站點（str 拼接 'a' + 'b' / 'a' - 'b' ⇒ OP-STRCAT）──
;   @str_concat 造 rc=1 自擁有（兩操作數各 memcpy 一份、不消耗）⇒ 結果登記 scope-exit 釋放；
;   操作數按只讀不釋放（字面量指向靜態常量）。混合 str/i64、str/txt（Go 會先轉標量再拼）
;   h2m 未建模 ⇒ 落默認 mark 計 unsup（寧缺勿錯）。

test-s99l-strcat-release = () {

    ; 非返回值：STRCAT 結果必被 scope-exit 釋放（OP-RELEASE，%dp 命名空間）
    src = 'f = () (r i64) {\n    s = \'a\' + \'b\'\n    r = 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99l strcat-release unsup')
    runner.eq(ir.contains('call %str-long @str_concat('), 1, 's99l strcat emitted')
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %dp'), 1, 's99l strcat result released')
}

test-s99l-strcat-return-no-release = () {

    ; '-' 亦为拼接（镜像 Go emitBinary：非 '*' 一律 @str_concat）；返回值被 skip 跳过 ⇒ 不释放
    src = 'f = () (r str) {\n    r = \'a\' - \'b\'\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99l strcat-return unsup')
    runner.eq(ir.contains('call %str-long @str_concat('), 1, 's99l strcat(-) emitted')
    runner.eq(ir.contains('call i1 @nolang_rc_release(i8* %dp'), 0, 's99l strcat return NO release (skip)')
}

test-s99l-strcat-nested-release = () {

    ; 嵌套拼接 ('a' + 'b') + 'c' ⇒ 两条 STRCAT、两次 release（内层被外层 memcpy 复制后即可释放）
    src = 'f = () (r i64) {\n    s = (\'a\' + \'b\') + \'c\'\n    r = 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99l nested unsup')

    ; contains 只回布林，不能计数 ⇒ 用 split 段数 - 1 得出现次数（2 次 ⇒ 3 段）
    runner.eq(ir.split('call %str-long @str_concat(').len(), 3, 's99l nested 2 strcat')
    runner.eq(ir.split('call i1 @nolang_rc_release(i8* %dp').len(), 3, 's99l nested 2 release')
}

test-s99l-strcat-mixed-gate = () {

    ; 'a' + 1（str + i64）：Go 会把 1 转 '1' 再拼，h2m 未建模 ⇒ 计 unsup、不产码
    src = 'f = () (r i64) {\n    s = \'a\' + 1\n    r = 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup > 0, 1, 's99l mixed str+i64 counted unsup')
    runner.eq(ir.contains('call %str-long @str_concat('), 0, 's99l mixed no strcat')
}

; ── s104：str 相等/不等（'==' ⇒ OP-STEREQ / '!=' ⇒ OP-STNEQ）──
; 镜像 Go 专用 OpStrEq：icmp %str-long 非法 ⇒ 降运行时 helper @str_eq（cg-runtime-str-eq）。
; 本件零改 cg / 零改 mir——OP-STEREQ=63 / OP-STNEQ=64 早已就位，缺的只是 h2m 这条降级臂。
; 结果恒 TY-I64（0/1）：与 s72 f64 比较、s77 u64 比较同口径——比较结果不是 str，
; 故落 %v 命名空间（`zext i1 → i64`）而非 %sv。
test-s104-streq = () {

    ; 两侧皆 str ⇒ 一条 @str_eq 调用 + zext 到 i64；实参走 %sv 命名空间
    src = 'f = () (r i64) {\n    a = \'x\'\n    b = \'y\'\n    c = a == b\n    r = c\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's104 streq unsup')
    runner.eq(ir.contains('%se2 = call i1 @str_eq(%str-long %sv1, %str-long %sv2)'), 1, 's104 streq call')
    runner.eq(ir.contains('%v3 = zext i1 %se2 to i64'), 1, 's104 streq zext')
    runner.eq(ir.contains('icmp eq %str-long'), 0, 's104 streq no illegal icmp')
}

test-s104-strne = () {

    ; '!=' ⇒ 同一 @str_eq 调用，i1 结果先 xor true 再 zext（cg OP-STNEQ 臂）
    src = 'f = () (r i64) {\n    a = \'x\'\n    b = \'y\'\n    c = a != b\n    r = c\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's104 strne unsup')
    runner.eq(ir.contains('%se2 = call i1 @str_eq(%str-long %sv1, %str-long %sv2)'), 1, 's104 strne call')
    runner.eq(ir.contains('%sn2 = xor i1 %se2, true'), 1, 's104 strne xor true')
    runner.eq(ir.contains('%v3 = zext i1 %sn2 to i64'), 1, 's104 strne zext')
}

test-s104-streq-gate = () {

    ; 混合形（str == i64）：权威靠 checker 先转标量再比，自举无 checker ⇒ 计 unsup、不产码
    src = 'f = () (r i64) {\n    a = \'x\'\n    c = a == 1\n    r = 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup > 0, 1, 's104 mixed str+i64 counted')
    runner.eq(ir.contains('@str_eq(%str-long %sv'), 0, 's104 mixed no str_eq call')

    ; 排序（str < str）：@str_eq 只判等，Go 侧无对应降级 ⇒ 不放行
    src2 = 'f = () (r i64) {\n    a = \'x\'\n    b = \'y\'\n    c = a < b\n    r = 1\n}\n'
    t2 = ast.make()
    b2 = src2.to-bytes()
    p2 = ps.new(b2)
    root2 = ps.parse(t2, p2)
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, root2)
    runner.eq(agg2.unsup > 0, 1, 's104 str lt counted')
    runner.eq(ir2.contains('@str_eq(%str-long %sv'), 0, 's104 str lt no str_eq call')
}

; s104 续：h2m-ty-of 的 str 双侧分支（与降级侧 dest 型别同步）。
;   🔴 缺这一支时 str 比较/拼接落在【含控制流（mem==1）】的函数里必挂：槽宽推不出（留 -1）
;      ⇒ h2m-slot-decl 计 unsup、整函数不产码；同一份代码在直线式（mem==0）下不铺槽 ⇒ 正常产码。
;      两种 mem 模式行为分岔，只有走控制流的那支暴露——故本测试必须带 `cond -> stmt` 造出 mem==1。
test-s104-streq-mem = () {

    ; 比较结果绑到变量、再在条件里读 ⇒ 变量必须落 i64 槽（不是 str 槽、也不能推不出）
    ;   实测：%ss1/%ss3 = a/b 的 %str-long 槽、%s5 = c 的 i64 槽、%se18 = @str_eq 的 i1
    src = 'f = () (r i64) {\n    a = \'x\'\n    b = \'y\'\n    c = a == b\n    c == 1 -> r = 1\n    r = 0\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's104 streq mem unsup')
    runner.eq(ir.split('call i1 @str_eq(%str-long %sv').len(), 2, 's104 streq mem one str_eq')
    runner.eq(ir.contains('%s5 = alloca i64'), 1, 's104 streq mem i64 slot for result var')
    runner.eq(ir.contains('zext i1 %se'), 1, 's104 streq mem zext')

    ; 拼接结果绑到变量、再在条件里用 ⇒ 变量必须落 %str-long 槽（不是 i64 槽）
    ;   实测：%ss4 = s 的 %str-long 槽、%sv10 = @str_concat 的结果
    src2 = 'f = (n i64) (r i64) {\n    s = \'a\' + \'b\'\n    n > 0 -> print(s)\n    r = 0\n}\n'
    t2 = ast.make()
    b2 = src2.to-bytes()
    p2 = ps.new(b2)
    root2 = ps.parse(t2, p2)
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, root2)
    runner.eq(agg2.unsup, 0, 's104 strcat mem unsup')
    runner.eq(ir2.split('call %str-long @str_concat(').len(), 2, 's104 strcat mem one concat')
    runner.eq(ir2.contains('%ss4 = alloca %str-long'), 1, 's104 strcat mem str slot')
    runner.eq(ir2.contains('store %str-long %sv10, %str-long* %ss4'), 1, 's104 strcat mem store to str slot')
}

; ── s99n：vec 的取得所有權站點 + scope-exit 釋放（M4-e 最後一件）──
; 核心：切片字面量 K-SLICE-LITERAL（元素限 i64）降 OP-VECNEW + 逐元素 OP-VECPUSH，**最終** %vec
;   登記釋放清單；函數退出時 h2m-emit-releases 對 TY-VEC 發 OP-VEC-FREE（cg → `call void @vec_free`）。
; ⚠️ vec 緩衝無 RC 頭（§11 B5）⇒ 無 retain、只有一次性 free ⇒ 所有權必須唯一：
;   ① 中間 push 值不入清單（@vec_push_i64 已自 free 舊緩衝）⇒ 只 free 最後那個 %vec；
;   ② 所有權外流（結構體字面量欄位 / 欄位寫 / 返回值）一律計 unsup——外流後 exit 仍 free 就是 UAF。
test-s99n-vec-literal-release = () {

    ; v = [1, 2, 3] 非回傳 ⇒ VECNEW 1、PUSH 3、VECFREE 1（只 free 最終 %vc8，不 free 中間值）
    src = 'sum = (x i64) (r i64) {\n    v = [1, 2, 3]\n    r = v[0] + x\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99n vec literal unsup')

    ; contains 只回布林 ⇒ 用 split 段數 − 1 計數（1 次 ⇒ 2 段、3 次 ⇒ 4 段）
    runner.eq(ir.split('call %vec @vec_new()').len(), 2, 's99n one vec_new')
    runner.eq(ir.split('call %vec @vec_push_i64(').len(), 4, 's99n three pushes')
    runner.eq(ir.split('call void @vec_free(%vec ').len(), 2, 's99n one vec_free')

    ; 中間值（%vc4 / %vc6）不得被 free —— 只 free 最後那次 push 的結果 %vc8
    runner.eq(ir.contains('call void @vec_free(%vec %vc8)'), 1, 's99n frees final vec only')
}

test-s99n-vec-empty-literal = () {

    ; 空切片 []：只發 VECNEW（無 PUSH）；仍登記釋放（@vec_free 對 dat==0 內部短路）
    src = 'z = () (r i64) {\n    w []i64 = []\n    r = w[0]\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup, 0, 's99n empty literal unsup')
    runner.eq(ir.split('call %vec @vec_new()').len(), 2, 's99n empty one vec_new')
    runner.eq(ir.split('call %vec @vec_push_i64(').len(), 1, 's99n empty no push')
    runner.eq(ir.split('call void @vec_free(%vec ').len(), 2, 's99n empty still frees')
}

test-s99n-vec-elem-type-gate = () {

    ; 元素非 i64（['a', 'b']）：@vec_push_i64 是單型 helper ⇒ 計 unsup、整函數不產碼
    src = 'f = () (r i64) {\n    v = [\'a\', \'b\']\n    r = 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup > 0, 1, 's99n str elements counted unsup')
    runner.eq(ir.contains('@vec_new'), 0, 's99n no vec_new for str elements')
}

test-s99n-vec-field-mk-gate = () {

    ; 逃逸門禁①：切片字面量放進結構體欄位（P { v: [1, 2], id: 7 }）⇒ 所有權外流、無 vec retain ⇒ unsup
    src = 'P {\n    v []i64\n    id i64\n}\n\nmk = () (r i64) {\n    p = P { v: [1, 2], id: 7 }\n    r = p.id\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup > 0, 1, 's99n vec into field counted unsup')
    runner.eq(ir.contains('@vec_new'), 0, 's99n no vec_new when escaping into field')
}

test-s99n-vec-field-set-gate = () {

    ; 逃逸門禁②：欄位寫 b.data = [1, 2]（OP-STRUCT-SET）⇒ 同款外流 ⇒ unsup
    src = 'B {\n    data []i64\n    id i64\n}\n\nset = (b B) (r i64) {\n    b.data = [1, 2]\n    r = b.id\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    runner.eq(agg.unsup > 0, 1, 's99n vec into field-set counted unsup')
    runner.eq(ir.contains('@vec_new'), 0, 's99n no vec_new when escaping via field-set')
}

runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
