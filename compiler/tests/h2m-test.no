; h2m-test.no — compiler/src/h2m.no（M4-e AST→MIR 降级）单元测试
;
; 执行： ./bin/no run compiler/tests/h2m-test.no
; ⚠️ runner 断言失败不改退出码，本档结尾必须自己 exit(1)。
;
; 与 cg-test.no 的分工：cg-test.no 喂【手写 op 数组】验发射；本档喂【真实源码】——
; 走 ps.no 解析 → h2m.no 降级 → cg.no 发射，断言的是「源码文本 → IR 文本」这条链路。
; 每个用例都同时钉 unsup 计数器：产码 ≠ 产对码，不支持的构造必须被计数抓住。
;
; s55 覆盖：表达式（+ - *）/ 变量绑定与重绑 / 括號下钻 / 多函数
; s56 覆盖：输入参数占形参值 id / 返回值型别决定 retty / 零参与多参调用 / 签名表前向解析
; s57 覆盖：比较家族（六个比较符 → icmp 族）/ 单行 guard 的 if（entry+then+merge 切块）/
;         前置条件循环（hdr/body/exit + 回边）/ mem 模式的 alloca 槽（跳块写回同一变量）/
;         合成 AST 的 else 臂（IfExpression 的三 kid 形制——真实单行 guard 的 Alternative 恒 0，
;         所以带 else 的 if 只能靠 ast.add/kid-add 搭出来跑同一段降级）
; s58 覆盖：花括号短路链 K-SURFACE-MATCH（语句位）——三臂含 wildcard / 无 wildcard 的两臂链
;         （假路直落汇聚块）/ 单 wildcard 臂（无条件判定故整链不应出现 icmp）/ 循环体内的链
;         （链的汇聚块只拿到回边）/ 表达式位的链仍计 unsup

# /test/runner.eq
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok
# /compiler/src/ps
# /compiler/src/h2m
# /compiler/src/mir

; ⚠️ 導入清單必須含 ps 的【傳遞依賴】（asp / lx / tok）——實測（s55）：只導入
;    ast / ps / h2m 時，跨模組常量（asp.K-INTEGER-LITERAL 等）解析不到，行程
;    表現為【無限循環掛起】而非報錯；補全直接導入後恢復。同族缺陷的報錯形態見
;    compiler/tests/ps-test.no 檔頭（oracle 端跨模組常量解析範圍缺陷，先於本檔存在）。

; ── f = () (r i64) { r = 2 + 3 * 4 } ──
; 证明 AST → MIR 的第一条真实路径：优先级由 parser 建成嵌套 InfixExpression，
; 降级只需后序遍历——先算右侧乘法（id2/id3/id4），再算加法（id5），末 RET id5。
test-prec = () {
    src = 'f = () (r i64) {\n    r = 2 + 3 * 4\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'prec unsup')
    runner.eq(ir.contains('define i64 @f()'), 1, 'prec define')
    runner.eq(ir.contains('%v1 = add i64 0, 2'), 1, 'prec const 2')
    runner.eq(ir.contains('%v2 = add i64 0, 3'), 1, 'prec const 3')
    runner.eq(ir.contains('%v3 = add i64 0, 4'), 1, 'prec const 4')
    runner.eq(ir.contains('%v4 = mul i64 %v2, %v3'), 1, 'prec mul')
    runner.eq(ir.contains('%v5 = add i64 %v1, %v4'), 1, 'prec add')
    runner.eq(ir.contains('ret i64 %v5'), 1, 'prec ret')

    ; 鉴别力：结果 id 必须是 5（多算/漏算一条都会挪动它）；不碰内存指令
    runner.eq(ir.contains('%v6'), 0, 'prec no extra id')
    runner.eq(ir.contains('alloca'), 0, 'prec no alloca')
    runner.eq(ir.contains('load '), 0, 'prec no load')
}

; ── g = () (r i64) { x = 5; r = x - 1 } ──
; 证明标识符按名字查到先前绑定的值 id（无槽、直接 SSA 引用）。
test-var = () {
    src = 'g = () (r i64) {\n    x = 5\n    r = x - 1\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'var unsup')
    runner.eq(ir.contains('%v1 = add i64 0, 5'), 1, 'var const 5')
    runner.eq(ir.contains('%v2 = add i64 0, 1'), 1, 'var const 1')
    runner.eq(ir.contains('%v3 = sub i64 %v1, %v2'), 1, 'var sub refs v1')
    runner.eq(ir.contains('ret i64 %v3'), 1, 'var ret')
}

; ── h = () (r i64) { r = 1; r = r + 2 } ──
; 证明同名重复绑定 = 覆盖重赋值（§3.11）：第二条语句读到的是第一条的值 id 1，
; 且 r 的最终绑定挪到 id3，RET 取 id3——不是 RET 旧的 id1。
test-rebind = () {
    src = 'h = () (r i64) {\n    r = 1\n    r = r + 2\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rebind unsup')
    runner.eq(ir.contains('%v1 = add i64 0, 1'), 1, 'rebind const 1')
    runner.eq(ir.contains('%v3 = add i64 %v1, %v2'), 1, 'rebind add')
    runner.eq(ir.contains('ret i64 %v3'), 1, 'rebind ret latest')
}

; ── k = () (r i64) { r = (2 + 3) * 4 } ──
; 证明 GroupedExpression 透明降级（只下钻第一个 kid，不额外产生值）。
test-group = () {
    src = 'k = () (r i64) {\n    r = (2 + 3) * 4\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'group unsup')
    runner.eq(ir.contains('%v3 = add i64 %v1, %v2'), 1, 'group inner add')
    runner.eq(ir.contains('%v4 = add i64 0, 4'), 1, 'group const 4')
    runner.eq(ir.contains('%v5 = mul i64 %v3, %v4'), 1, 'group mul of add')
    runner.eq(ir.contains('ret i64 %v5'), 1, 'group ret')
}

; ── 两个函数：拼接 + 各自独立的值 id arena ──
test-multi-func = () {
    src = 'a = () (r i64) {\n    r = 1 + 2\n}\n\nz = () (r i64) {\n    r = 7\n}\n'
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'multi unsup')
    runner.eq(ir.contains('define i64 @a()'), 1, 'multi define a')
    runner.eq(ir.contains('define i64 @z()'), 1, 'multi define z')

    ; 第二个函数的 id 从 1 重新起算（私有 arena），其常量写的是 %v1 = add i64 0, 7
    runner.eq(ir.contains('%v1 = add i64 0, 7'), 1, 'multi fresh arena')
}

; ── 负例门禁：不支持的构造必须计入 unsup，不得静默产码 ──
test-gate = () {

    ; 除法不在本切片（除零的 option 语义降级属 §11 B14 语义半项）
    src-div = 'd = () (r i64) {\n    r = 6 / 2\n}\n'
    t1 = ast.make()
    p1 = ps.new(src-div.to-bytes())
    r1 = ps.parse(t1, p1)
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'gate div counted')

    ; 未定义标识符
    src-unk = 'u = () (r i64) {\n    r = zz\n}\n'
    t2 = ast.make()
    p2 = ps.new(src-unk.to-bytes())
    r2 = ps.parse(t2, p2)
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'gate unknown name counted')

    ; 带默认值的参数 ⇒ 签名不合格（整函数不产码）：默认值会让调用点 arity 判定失效
    src-def = 'i = (x i64 = 5) (r i64) {\n    r = x\n}\n'
    t3 = ast.make()
    p3 = ps.new(src-def.to-bytes())
    r3 = ps.parse(t3, p3)
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'gate default param counted')
    runner.eq(ir3.contains('define'), 0, 'gate default param no code')

    ; 未知型别名 ⇒ 签名不合格
    src-ty = 'j = (x foo) (r i64) {\n    r = 1\n}\n'
    t5 = ast.make()
    p5 = ps.new(src-ty.to-bytes())
    r5 = ps.parse(t5, p5)
    agg5 = h2m-new()
    ir5 = h2m-lower-program(t5, agg5, r5)
    runner.eq(agg5.unsup > 0, 1, 'gate unknown type counted')
    runner.eq(ir5.contains('define'), 0, 'gate unknown type no code')

    ; 非函数定义语句（结构体定义）⇒ 计入 unsup
    src-struct = 'pt {\n    x i64\n}\n\ns = () (r i64) {\n    r = 3\n}\n'
    t4 = ast.make()
    p4 = ps.new(src-struct.to-bytes())
    r4 = ps.parse(t4, p4)
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)
    runner.eq(agg4.unsup > 0, 1, 'gate non-func counted')
    runner.eq(ir4.contains('define i64 @s()'), 1, 'gate sibling still emitted')
}

; ── 单个输入参数：形参占值 id 1，body 从 id 2 起 ──
; 证明 s56 的签名侧降级：不建 alloca，名字直接绑到形参 id（与 §3.11 重绑模型一致）。
test-param-one = () {
    src = 'p1 = (x i64) (r i64) {\n    r = x + 1\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'param1 unsup')
    runner.eq(ir.contains('define i64 @p1(i64 %v1)'), 1, 'param1 sig')
    runner.eq(ir.contains('%v2 = add i64 0, 1'), 1, 'param1 const starts at 2')
    runner.eq(ir.contains('%v3 = add i64 %v1, %v2'), 1, 'param1 body uses %v1')
    runner.eq(ir.contains('ret i64 %v3'), 1, 'param1 ret')
}

; ── 两个输入参数：形参序 = 值 id 序 ──
test-param-two = () {
    src = 'p2 = (x i64, y i64) (r i64) {\n    r = x * y\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'param2 unsup')
    runner.eq(ir.contains('define i64 @p2(i64 %v1, i64 %v2)'), 1, 'param2 sig')
    runner.eq(ir.contains('%v3 = mul i64 %v1, %v2'), 1, 'param2 body')
    runner.eq(ir.contains('alloca'), 0, 'param2 no alloca')
}

; ── str 形参：签名侧按型别选命名空间（值语义仍限 i64）──
test-param-str = () {
    src = 'sp = (s str) (r i64) {\n    r = 1\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'pstr unsup')
    runner.eq(ir.contains('define i64 @sp(%str-long %sv1)'), 1, 'pstr sig')
    runner.eq(ir.contains('%v2 = add i64 0, 1'), 1, 'pstr body id after param')
    runner.eq(ir.contains('ret i64 %v2'), 1, 'pstr ret')

    ; 鉴别力：str 形参不得误入 %v 命名空间
    runner.eq(ir.contains('i64 %v1'), 0, 'pstr no i64 param')
}

; ── 输出参数的型别决定 retty（str 透传，不新增 id）──
test-ret-str = () {
    src = 'stw = (s str) (t str) {\n    t = s\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'rets unsup')
    runner.eq(ir.contains('define %str-long @stw(%str-long %sv1)'), 1, 'rets sig')
    runner.eq(ir.contains('ret %str-long %sv1'), 1, 'rets ret value')

    ; 鉴别力：本函数只有一个值 id（形参），body 不产生新指令
    runner.eq(ir.contains('%v'), 0, 'rets no i64 id')
}

; ── 零参调用 + 前向引用（调用者写在被调用者之前）──
; 证明前置 pass 先登记全模块签名，调用点能查到返回型别与 arity。
test-call-fwd = () {
    src = 'cc = () (r i64) {\n    r = cf0()\n}\n\ncf0 = () (r i64) {\n    r = 9\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'callfwd unsup')
    runner.eq(ir.contains('%v1 = call i64 @cf0()'), 1, 'callfwd zero arg')
    runner.eq(ir.contains('ret i64 %v1'), 1, 'callfwd ret')
    runner.eq(ir.contains('define i64 @cf0()'), 1, 'callfwd callee emitted')
    runner.eq(ir.contains('%v1 = add i64 0, 9'), 1, 'callfwd callee body')
}

; ── 单参调用 + 两参连续调用 ──
test-call-args = () {
    src = 'dbl = (x i64) (r i64) {\n    r = x + x\n}\n\nad = (x i64, y i64) (r i64) {\n    r = x + y\n}\n\nm1 = () (r i64) {\n    a = 3\n    r = dbl(a)\n}\n\nm2 = () (r i64) {\n    a = 1\n    b = 2\n    r = ad(a, b)\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'callargs unsup')
    runner.eq(ir.contains('define i64 @dbl(i64 %v1)'), 1, 'callargs dbl sig')
    runner.eq(ir.contains('%v2 = add i64 %v1, %v1'), 1, 'callargs dbl body')
    runner.eq(ir.contains('%v2 = call i64 @dbl(i64 %v1)'), 1, 'callargs one arg')
    runner.eq(ir.contains('%v3 = call i64 @ad(i64 %v1, i64 %v2)'), 1, 'callargs two args')

    ; 鉴别力：多参实参必须按序（反序则 IR 文本不同）
    runner.eq(ir.contains('@ad(i64 %v2, i64 %v1)'), 0, 'callargs order not swapped')
}

; ── 调用侧门禁：实参 id 不连续 / arity 不符 / 未知被调用者 / 返回型别不符 都计 unsup ──
test-call-gate = () {

    ; 嵌套调用挤占中间 id ⇒ 实参 1 与 4 不连续（cg 的 OP-CALL 要求 xa..xa+bs-1）
    src-gap = 'ad = (x i64, y i64) (r i64) {\n    r = x + y\n}\n\nk = () (r i64) {\n    a = 1\n    r = ad(a, 2 + 3)\n}\n'
    t1 = ast.make()
    p1 = ps.new(src-gap.to-bytes())
    r1 = ps.parse(t1, p1)
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'gap counted')
    runner.eq(ir1.contains('call i64 @ad'), 0, 'gap no call code')

    ; arity 不符：dbl 只要一个参数
    src-ary = 'dbl = (x i64) (r i64) {\n    r = x + x\n}\n\nk = () (r i64) {\n    r = dbl(1, 2)\n}\n'
    t2 = ast.make()
    p2 = ps.new(src-ary.to-bytes())
    r2 = ps.parse(t2, p2)
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'arity counted')
    runner.eq(ir2.contains('call i64 @dbl'), 0, 'arity no call code')

    ; 未知被调用者（未在本模块定义）
    src-unk = 'k = () (r i64) {\n    r = zzz(1)\n}\n'
    t3 = ast.make()
    p3 = ps.new(src-unk.to-bytes())
    r3 = ps.parse(t3, p3)
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'unknown callee counted')
    runner.eq(ir3.contains('call'), 0, 'unknown callee no code')

    ; 返回值型别不符：a 是 i64，却赋给声明为 str 的输出参数
    src-rt = 'rr = (a i64) (s str) {\n    s = a\n}\n'
    t4 = ast.make()
    p4 = ps.new(src-rt.to-bytes())
    r4 = ps.parse(t4, p4)
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)
    runner.eq(agg4.unsup > 0, 1, 'rettype counted')
    runner.eq(ir4.contains('define'), 0, 'rettype no code')
}

test-prec()
test-var()
test-rebind()
test-group()
test-multi-func()
test-param-one()
test-param-two()
test-param-str()
test-ret-str()
test-call-fwd()
test-call-args()

; ═══ s57：控制流降级 ═══════════════════════════════════════════

; 跳块写回 ⇒ 体内有分支/循环时全部局部量（含形参）落 entry alloca 槽（-O0 风格）
test-flow-if = () {
    src = 'f = (n i64) (r i64) {\n    r = 0\n    n > 0 -> r = n\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'if unsup')

    ; entry：两个槽（n ← %v1、r 零初始化）——s55/s56 的直线式从来不发 alloca，本件是第一处
    runner.eq(ir.contains('%s2 = alloca i64'), 1, 'if slot n')
    runner.eq(ir.contains('store i64 %v1, i64* %s2'), 1, 'if param into slot')
    runner.eq(ir.contains('%s4 = alloca i64'), 1, 'if slot r')

    ; 条件侧：load 取 n → icmp sgt → zext → condbr（非零为真）
    runner.eq(ir.contains('%v7 = load i64, i64* %s2'), 1, 'if cond loads slot')
    runner.eq(ir.contains('%c11 = icmp sgt i64 %v7, %v8'), 1, 'if icmp')
    runner.eq(ir.contains('%v9 = zext i1 %c11 to i64'), 1, 'if zext')

    ; 无 else 臂 ⇒ 假路直接接汇聚块（bb3），不留 bb2
    runner.eq(ir.contains('br i1 %c12, label %bb1, label %bb3'), 1, 'if condbr skips else')
    runner.eq(ir.contains('bb2:'), 0, 'if no empty else block')
    runner.eq(ir.contains('bb1:'), 1, 'if then label')
    runner.eq(ir.contains('bb3:'), 1, 'if merge label')

    ; then 臂写回槽并无条件回汇聚块；汇聚块 load 后才 ret（而不是 ret 一个 then 块的 SSA 名）
    runner.eq(ir.contains('%v10 = load i64, i64* %s2'), 1, 'if arm loads n')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'if arm stores r')
    runner.eq(ir.contains('br label %bb3'), 1, 'if arm br merge')
    runner.eq(ir.contains('%v11 = load i64, i64* %s4'), 1, 'if merge loads r')
    runner.eq(ir.contains('ret i64 %v11'), 1, 'if ret from load')

    ; 鉴别力：汇聚块不能拿 then 块内部的 %v10 直接 ret（跨块引用会被 opt 的支配树拒）
    runner.eq(ir.contains('ret i64 %v10'), 0, 'if no cross-block ret')
}

; ── 前置条件循环：(cond) { body } ⇒ entry→hdr、hdr→(body|exit)、body→hdr 回边 ──
test-flow-loop = () {
    src = 'g = (n i64) (r i64) {\n    r = 0\n    (n > 0) {\n        r = r + 1\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'loop unsup')

    ; entry 无条件跳到条件块（hdr = bb1），不在 entry 求值条件（回边要落回它）
    runner.eq(ir.contains('br label %bb1'), 1, 'loop entry br hdr')
    runner.eq(ir.contains('bb1:'), 1, 'loop hdr label')
    runner.eq(ir.contains('br i1 %c13, label %bb2, label %bb3'), 1, 'loop condbr body/exit')

    ; 鉴别力（本件核心）：体内 `r = r + 1` 必须 load 槽而不是引用 entry 旧值——
    ;   若退回 SSA 重绑语义，这里会变成 `add i64 %v6, %v11`（永远只加第一轮的值）
    runner.eq(ir.contains('%v10 = load i64, i64* %s4'), 1, 'loop body loads r')
    runner.eq(ir.contains('%v12 = add i64 %v10, %v11'), 1, 'loop body adds loaded')
    runner.eq(ir.contains('%v12 = add i64 %v6, %v11'), 0, 'loop body not stale ssa')
    runner.eq(ir.contains('store i64 %v12, i64* %s4'), 1, 'loop body stores r')

    ; 回边 + 后继落在 exit 块
    runner.eq(ir.contains('br label %bb1\n'), 1, 'loop back edge')
    runner.eq(ir.contains('bb3:'), 1, 'loop exit label')
    runner.eq(ir.contains('ret i64 %v13'), 1, 'loop ret in exit block')
}

; ── 比较家族：六个比较符各自落到对应的 icmp predicate ──
test-flow-cmp = () {
    src = 'a = (n i64) (r i64) {\n    r = 0\n    n < 5 -> r = 1\n    n <= 5 -> r = 2\n    n >= 5 -> r = 3\n    n == 5 -> r = 4\n    n != 5 -> r = 5\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'cmp unsup')

    ; 五条 guard 各一条 icmp；谓词不能串位（slt 写反成 sgt 就全反了）
    runner.eq(ir.contains('icmp slt i64'), 1, 'cmp lt')
    runner.eq(ir.contains('icmp sle i64'), 1, 'cmp le')
    runner.eq(ir.contains('icmp sge i64'), 1, 'cmp ge')
    runner.eq(ir.contains('icmp eq i64'), 1, 'cmp eq')
    runner.eq(ir.contains('icmp ne i64 %v'), 1, 'cmp ne')
    runner.eq(ir.contains('icmp ule i64'), 0, 'cmp no unsigned leak')

    ; 5 条 guard ⇒ 5 个 then 块（bb1/4/7/10/13 形式：每条 if 新开 3 个 id，无 else 时中间那个不落地）
    runner.eq(ir.contains('bb13:'), 1, 'cmp fifth then block')
    runner.eq(ir.contains('bb14:'), 0, 'cmp block count stops')
}

; 合成 AST 造 else 臂：`sf = (n i64) (r i64) { n > 0 -> { r = 7 } else { r = 9 } }`
; ⚠️ 真实源路造不出这个形状（`{c -> a -> b}` 被 ps.no 建成 K-SURFACE-MATCH，臂群在 aux 阵），
;   而 h2m-lower-if 按 Go/HIR 的 IfExpression 三 kid 形制写，故用 ast.add/kid-add 直接搭同形节点
mk-ident = (t ast, name str) (x i64) {
    x = ast.add(t, asp.K-IDENTIFIER)
    ast.set-slot(t, x, 0, ast.put-str(t, name))
}

mk-int = (t ast, lit str) (x i64) {
    x = ast.add(t, asp.K-INTEGER-LITERAL)
    ast.set-slot(t, x, 0, ast.put-str(t, lit))
}

; InfixExpression：kids = [左][右]，s0 = 运算符文本
mk-infix = (t ast, op str, a i64, b i64) (x i64) {
    x = ast.add(t, asp.K-INFIX-EXPRESSION)
    ast.kid-add(t, x, a)
    ast.kid-add(t, x, b)
    ast.set-slot(t, x, 0, ast.put-str(t, op))
}

; BlockStatement：kids = 单条语句（本件合成用例只需一条 let）
mk-block1 = (t ast, s i64) (x i64) {
    x = ast.add(t, asp.K-BLOCK-STATEMENT)
    ast.kid-add(t, x, s)
}

; LetStatement：kids = [型别 0][值]，s0 = 名字（与实测解析形状一致）
mk-let-int = (t ast, name str, lit str) (x i64) {
    v = mk-int(t, lit)
    x = ast.add(t, asp.K-LET-STATEMENT)
    ast.kid-add(t, x, 0)
    ast.kid-add(t, x, v)
    ast.set-slot(t, x, 0, ast.put-str(t, name))
}

; Parameter：kids = [K-NAMED-TYPE][默认值 0]，s0 = 名字
mk-param = (t ast, name str, ty str) (x i64) {
    tn = ast.add(t, asp.K-NAMED-TYPE)
    ast.set-slot(t, tn, 0, ast.put-str(t, ty))
    x = ast.add(t, asp.K-PARAMETER)
    ast.kid-add(t, x, tn)
    ast.kid-add(t, x, 0)
    ast.set-slot(t, x, 0, ast.put-str(t, name))
}

test-flow-else-syn = () {
    t = ast.make()

    ; 自下而上建，且【每个子节点先落具名局部】再 kid-add：实测（s57）把调用直接嵌在
    ;   另一调用的实参位（ast.kid-add(t, iff, mk-block1(t, then-s))）会传错值——拿到的是
    ;   内层函数的【输入参数】而非它的【输出参数】（本档只做记录，依 AGENTS.md §2 不改他人代码）
    idn = mk-ident(t, 'n')
    iz = mk-int(t, '0')
    cond = mk-infix(t, '>', idn, iz)
    then-s = mk-let-int(t, 'r', '7')
    then-blk = mk-block1(t, then-s)
    else-s = mk-let-int(t, 'r', '9')
    else-blk = mk-block1(t, else-s)
    iff = ast.add(t, asp.K-IF-EXPRESSION)
    ast.kid-add(t, iff, cond)
    ast.kid-add(t, iff, then-blk)
    ast.kid-add(t, iff, else-blk)
    pin = mk-param(t, 'n', 'i64')
    pout = mk-param(t, 'r', 'i64')
    body = mk-block1(t, iff)
    fd = ast.add(t, asp.K-FUNCTION-DEFINITION)
    ast.kid-add(t, fd, pin)
    ast.kid-add(t, fd, pout)
    ast.kid-add(t, fd, body)
    ast.set-sig(t, fd, 0, 1, 1)
    ast.set-slot(t, fd, 0, ast.put-str(t, 'sf'))
    pr = ast.add(t, asp.K-PROGRAM)
    ast.kid-add(t, pr, fd)
    ast.set-count(t, pr, 0, 1)

    agg = h2m-new()
    ir = h2m-lower-program(t, agg, pr)

    runner.eq(agg.unsup, 0, 'else-syn unsup')
    runner.eq(ir.contains('define i64 @sf(i64 %v1)'), 1, 'else-syn define')

    ; 有 else 臂 ⇒ 假路落 bb2（与无 else 时直落汇聚块形成对照），三块都落地
    runner.eq(ir.contains('br i1 %c10, label %bb1, label %bb2'), 1, 'else-syn condbr both arms')
    runner.eq(ir.contains('bb2:'), 1, 'else-syn else block emitted')
    runner.eq(ir.contains('bb3:'), 1, 'else-syn merge block emitted')

    ; 两臂各写自己的常量进同一槽 %s4，各自无条件回汇聚块；汇聚块只 load 一次
    runner.eq(ir.contains('%v9 = add i64 0, 7'), 1, 'else-syn then const 7')
    runner.eq(ir.contains('store i64 %v9, i64* %s4'), 1, 'else-syn then stores 7')
    runner.eq(ir.contains('%v10 = add i64 0, 9'), 1, 'else-syn else const 9')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'else-syn else stores 9')
    runner.eq(ir.contains('br label %bb3'), 1, 'else-syn arm br merge')
    runner.eq(ir.contains('%v11 = load i64, i64* %s4'), 1, 'else-syn merge loads')
    runner.eq(ir.contains('ret i64 %v11'), 1, 'else-syn ret loaded')

    ; 鉴别力：任一臂自己的 SSA 名都不能被 ret（跨块引用会被 opt 支配树拒）
    runner.eq(ir.contains('ret i64 %v9'), 0, 'else-syn no cross-block ret then')
    runner.eq(ir.contains('ret i64 %v10'), 0, 'else-syn no cross-block ret else')
}

; ── s58：花括号短路链（K-SURFACE-MATCH）三臂含 wildcard──
; 实测量：臂体块 bb2/bb4/bb5 各写自己的常量进同一槽 %s4 并无条件回汇聚块 bb1；第二臂的判定落 bb3
test-flow-chain3 = () {
    src = 'f = (n i64) (r i64) {\n    r = 0\n    {\n        n > 3 -> r = 1\n        n > 1 -> { r = 2 }\n        -> r = 3\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'chain3 unsup')
    runner.eq(ir.contains('define i64 @f(i64 %v1)'), 1, 'chain3 define')

    ; 逐臂一条 CONDBR：真路进臂体，假路进下一臂的判定块（wildcard 臂就是那个假路块）
    runner.eq(ir.contains('br i1 %c12, label %bb2, label %bb3'), 1, 'chain3 arm1 condbr to arm2 test')
    runner.eq(ir.contains('br i1 %c19, label %bb4, label %bb5'), 1, 'chain3 arm2 condbr to wildcard')

    ; 三臂各写自己的常量到同一槽（跳块传值靠槽，不靠 SSA 名）
    runner.eq(ir.contains('%v10 = add i64 0, 1'), 1, 'chain3 arm1 const')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'chain3 arm1 store')
    runner.eq(ir.contains('%v14 = add i64 0, 2'), 1, 'chain3 arm2 const')
    runner.eq(ir.contains('store i64 %v14, i64* %s4'), 1, 'chain3 arm2 store')
    runner.eq(ir.contains('%v15 = add i64 0, 3'), 1, 'chain3 wildcard const')
    runner.eq(ir.contains('store i64 %v15, i64* %s4'), 1, 'chain3 wildcard store')

    ; 汇聚块只读一次槽；每臂都无条件跳回它（整块形制逐段钉住）
    runner.eq(ir.contains('bb2:\n\t%v10 = add i64 0, 1\n\tstore i64 %v10, i64* %s4\n\tbr label %bb1'), 1, 'chain3 arm1 block shape')
    runner.eq(ir.contains('bb5:\n\t%v15 = add i64 0, 3\n\tstore i64 %v15, i64* %s4\n\tbr label %bb1'), 1, 'chain3 wildcard block shape')
    runner.eq(ir.contains('bb1:\n\t%v16 = load i64, i64* %s4\n\tret i64 %v16'), 1, 'chain3 merge block shape')
    runner.eq(ir.contains('%v16 = load i64, i64* %s4'), 1, 'chain3 merge loads')
    runner.eq(ir.contains('ret i64 %v16'), 1, 'chain3 ret loaded')

    ; 鉴别力：块数恰为 entry + bb1..bb5（多开一块就是假路指了空块）；臂内 SSA 名不得被 ret
    runner.eq(ir.contains('bb6:'), 0, 'chain3 no spare block')
    runner.eq(ir.contains('ret i64 %v10'), 0, 'chain3 no cross-block ret')
}

; ── s58：无 wildcard 的两臂链——最后一臂的假路直接落汇聚块，不留空判定块──
test-flow-chain-nowild = () {
    src = 'g = (n i64) (r i64) {\n    r = 7\n    {\n        n > 3 -> r = 1\n        n > 1 -> r = 2\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'nowild unsup')
    runner.eq(ir.contains('br i1 %c12, label %bb2, label %bb3'), 1, 'nowild arm1 condbr arm2 test')
    runner.eq(ir.contains('br i1 %c19, label %bb4, label %bb1'), 1, 'nowild last arm false to merge')
    runner.eq(ir.contains('bb5:'), 0, 'nowild no empty test block')
    runner.eq(ir.contains('store i64 %v10, i64* %s4'), 1, 'nowild arm1 store')
    runner.eq(ir.contains('store i64 %v14, i64* %s4'), 1, 'nowild arm2 store')
    runner.eq(ir.contains('ret i64 %v15'), 1, 'nowild ret loaded')
}

; ── s58：单 wildcard 臂链——无条件判定，臂体直落当前块，整链不应出现任何 icmp──
test-flow-chain-wild1 = () {
    src = 'w = (n i64) (r i64) {\n    r = 5\n    {\n        -> r = 9\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'wild1 unsup')
    runner.eq(ir.contains('store i64 %v7, i64* %s4'), 1, 'wild1 body in entry')
    runner.eq(ir.contains('br label %bb1'), 1, 'wild1 br merge')
    runner.eq(ir.contains('%v8 = load i64, i64* %s4'), 1, 'wild1 merge loads')
    runner.eq(ir.contains('ret i64 %v8'), 1, 'wild1 ret loaded')
    runner.eq(ir.contains('icmp'), 0, 'wild1 no condition evaluated')
    runner.eq(ir.contains('br i1'), 0, 'wild1 no condbr')
}

; ── s58：循环体内的链——链的汇聚块只拿到循环的回边（连续段纪律的叠块例）──
test-flow-chain-nest = () {
    src = 'h = (n i64) (r i64) {\n    r = 0\n    (r < 10) {\n        {\n            r > 5 -> r = r + 3\n            -> r = r + 1\n        }\n    }\n}\n'
    t = ast.make()
    p = ps.new(src.to-bytes())
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)

    runner.eq(agg.unsup, 0, 'nest unsup')
    runner.eq(ir.contains('br i1 %c13, label %bb2, label %bb3'), 1, 'nest loop condbr')
    runner.eq(ir.contains('br i1 %c17, label %bb5, label %bb6'), 1, 'nest chain condbr')
    runner.eq(ir.contains('store i64 %v15, i64* %s4'), 1, 'nest arm1 store')
    runner.eq(ir.contains('store i64 %v18, i64* %s4'), 1, 'nest wildcard store')

    ; 链的汇聚块 bb4 既不算条件也不写值，只拿到循环回边——证明块序合法
    runner.eq(ir.contains('bb4:\n\tbr label %bb1'), 1, 'nest merge carries back edge')
    runner.eq(ir.contains('bb7:'), 0, 'nest no spare block')
    runner.eq(ir.contains('ret i64 %v19'), 1, 'nest exit ret')
}

; ── 控制流侧门禁：surface match 链 / 计数循环 / 区间遍历 / 无槽型别都计 unsup 且不产码 ──
test-flow-gate = () {

    ; 表达式位的链 `r = { c -> a -> b }`：须各臂汇成同一个结果值，s58 只收语句位 ⇒ 仍计 unsup
    src-sm = 'a = (n i64) (r i64) {\n    r = { n > 0 -> n -> 0 }\n}\n'
    t1 = ast.make()
    p1 = ps.new(src-sm.to-bytes())
    r1 = ps.parse(t1, p1)
    agg1 = h2m-new()
    ir1 = h2m-lower-program(t1, agg1, r1)
    runner.eq(agg1.unsup > 0, 1, 'expr-surface counted')
    runner.eq(ir1.contains('define'), 0, 'expr-surface no code')

    ; 计数循环 `n * { }`：CountExpr 非 0 ⇒ 不在覆盖面
    src-ct = 'b = (n i64) (r i64) {\n    r = 0\n    n * {\n        r = r + 1\n    }\n}\n'
    t2 = ast.make()
    r2 = ps.parse(t2, ps.new(src-ct.to-bytes()))
    agg2 = h2m-new()
    ir2 = h2m-lower-program(t2, agg2, r2)
    runner.eq(agg2.unsup > 0, 1, 'count-loop counted')
    runner.eq(ir2.contains('br label'), 0, 'count-loop no code')

    ; 区间遍历 `i <- [0..n]:`：IterRange 非 0 ⇒ 不在覆盖面
    src-rg = 'c = (n i64) (r i64) {\n    r = 0\n    i <- [0..n]: {\n        r = r + i\n    }\n}\n'
    t3 = ast.make()
    r3 = ps.parse(t3, ps.new(src-rg.to-bytes()))
    agg3 = h2m-new()
    ir3 = h2m-lower-program(t3, agg3, r3)
    runner.eq(agg3.unsup > 0, 1, 'range-loop counted')
    runner.eq(ir3.contains('alloca'), 0, 'range-loop no slot emitted')

    ; 臂内放不了的东西：break / continue / return 仍计 unsup（不静默略过）
    src-rt = 'd = (n i64) (r i64) {\n    r = 0\n    n > 0 -> return\n}\n'
    t4 = ast.make()
    r4 = ps.parse(t4, ps.new(src-rt.to-bytes()))
    agg4 = h2m-new()
    ir4 = h2m-lower-program(t4, agg4, r4)
    runner.eq(agg4.unsup > 0, 1, 'return counted')
    runner.eq(ir4.contains('define'), 0, 'return no code')

    ; mem 模式的槽型别边界：f64 局部量在 cg 无 alloca double 的 op ⇒ 宁缺勿错
    src-f64 = 'e = (x f64) (r i64) {\n    r = 0\n    x == x -> r = 1\n}\n'
    t5 = ast.make()
    r5 = ps.parse(t5, ps.new(src-f64.to-bytes()))
    agg5 = h2m-new()
    ir5 = h2m-lower-program(t5, agg5, r5)
    runner.eq(agg5.unsup > 0, 1, 'f64 slot counted')
    runner.eq(ir5.contains('define'), 0, 'f64 slot no code')
}

; 调用入口（保持与下方新增函数定义的顺序无关）
test-call-gate()
test-flow-if()
test-flow-loop()
test-flow-cmp()
test-flow-else-syn()
test-flow-chain3()
test-flow-chain-nowild()
test-flow-chain-wild1()
test-flow-chain-nest()
test-flow-gate()
test-gate()

runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
