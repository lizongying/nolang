    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-div-lit unsup')
    runner.eq(ir.contains('udiv i64'), 1, 'arith-u64-div-lit udiv')
}

; s76：mem 模式下的 u64 除法——u64 操作数出自 entry 块 alloca 槽，跨块 LOAD 后喂護欄 udiv
test-arith-u64-div-mem = () {
    src = 'u6n = (x u64, y u64, n i64) (r u64) {\n    r = x / y\n    n > 0 -> n = n - 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-div-mem unsup')
    runner.eq(ir.contains('alloca i64'), 1, 'arith-u64-div-mem alloca')
    runner.eq(ir.contains('udiv i64'), 1, 'arith-u64-div-mem udiv')
    runner.eq(ir.contains('load i64, i64*'), 1, 'arith-u64-div-mem load')
}

; s78：u64 的 '+' 放行——add/sub/mul 在 64 位宽下签／无签位元相同，Go 侧 MIR 算子表
;   无 OpAddU/OpSubU/OpMulU（只有除模与序比较重映射），plain 路径恒发裸 add i64
;   （溢出变 err 的 with.overflow 内在函数只在 option 路径、由声明的 elemRaw 定 s*/u*，自举端不建模 ?u64）
;   （s76 曾以此钉「u64 '+' 不放行」的门禁，s78 解除；位运算族 s79 解除；逻辑族 && || s79 曾同码门禁、s83 解除见 test-logic-u64-*）
test-arith-u64-add-plain = () {
    src = 'u6a = (x u64, y u64) (r u64) {\n    r = x + y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-add-plain unsup')
    runner.eq(ir.contains('add i64'), 1, 'arith-u64-add-plain add')
    runner.eq(ir.contains('fadd double'), 0, 'arith-u64-add-plain not fadd')
}

; s78：u64 '-' 放行 ⇒ sub i64（2's 补数回绕，与有符號同指令；无 fsub 翼）
test-arith-u64-sub-plain = () {
    src = 'u6b = (x u64, y u64) (r u64) {\n    r = x - y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-sub-plain unsup')
    runner.eq(ir.contains('sub i64'), 1, 'arith-u64-sub-plain sub')
    runner.eq(ir.contains('fsub double'), 0, 'arith-u64-sub-plain not fsub')
}

; s78：u64 '*' 放行 ⇒ mul i64（只取低 64 位，签／无签同值；无 fmul 翼）
test-arith-u64-mul-plain = () {
    src = 'u6c = (x u64, y u64) (r u64) {\n    r = x * y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-mul-plain unsup')
    runner.eq(ir.contains('mul i64'), 1, 'arith-u64-mul-plain mul')
    runner.eq(ir.contains('fmul double'), 0, 'arith-u64-mul-plain not fmul')
}

; s78：一侧 u64 × 整字面量同走（沿用 s76 的 uty「任一侧 TY-U64」判据，镜像 Go sourceUnsigned 或路由）
test-arith-u64-add-lit = () {
    src = 'u6d = (x u64) (r u64) {\n    r = x + 2\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-add-lit unsup')
    runner.eq(ir.contains('add i64'), 1, 'arith-u64-add-lit add')
}

; s78：嵌套 u64 算术（(x + y) * 2）——内层 dest TY-U64，外层读它再乘 ⇒ 三 op 皆落无符號整族
test-arith-u64-arith-nested = () {
    src = 'u6e = (x u64, y u64) (r u64) {\n    r = (x + y) * 2\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-nested unsup')
    runner.eq(ir.contains('add i64'), 1, 'arith-u64-nested add')
    runner.eq(ir.contains('mul i64'), 1, 'arith-u64-nested mul')
}

; s78：mem 模式下的 u64 加法——u64 操作数出自 entry 块 alloca 槽，跨块 LOAD 后喂 add i64
test-arith-u64-add-mem = () {
    src = 'u6f = (x u64, y u64, n i64) (r u64) {\n    r = x + y\n    n > 0 -> n = n - 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-add-mem unsup')
    runner.eq(ir.contains('alloca i64'), 1, 'arith-u64-add-mem alloca')
    runner.eq(ir.contains('add i64'), 1, 'arith-u64-add-mem add')
    runner.eq(ir.contains('load i64, i64*'), 1, 'arith-u64-add-mem load')
}

; s78 🔴 槽宽耦合靶（s76 ④ 的同类）：let 目标 f 由 h2m-ty-of 前扫描注册为 TY-U64，
;   降级侧算术臂 dest 也须 TY-U64——否则 h2m-var-write 的 st == vt 门禁在第二次写（f - 1）上 mark
test-arith-u64-slot-u64 = () {
    src = 'u6g = (x u64, y u64, n i64) (r u64) {\n    f = x + y\n    n > 0 -> f = f - 1\n    r = f\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-u64-slot-u64 unsup')
    runner.eq(ir.contains('add i64'), 1, 'arith-u64-slot-u64 add')
    runner.eq(ir.contains('sub i64'), 1, 'arith-u64-slot-u64 sub')
    runner.eq(ir.contains('store i64'), 1, 'arith-u64-slot-u64 store')
}

; s78 门禁：u64 × f64 混合仍不放行——uty 要求双侧整族、fty 要求双侧 f64，混合两者皆 0 ⇒ 诚实 unsup
test-arith-u64-mixed-gate = () {
    src = 'u6h = (x u64, f f64) (r u64) {\n    r = x + f\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'arith-u64-mixed-gate counted')
    runner.eq(ir.contains('define'), 0, 'arith-u64-mixed-gate no code')
}

; ── u64 逻辑族 && ||（s83）────────────────────────────
; s83：u64 逻辑族放行——探针实钉（tmp/probe-s83-a/c.no 走 Go oracle）：12 && 10 ⇒ 8、12 || 10 ⇒ 14、
;   0 || 5 ⇒ 5、5 && 0 ⇒ 0、0 && 1 ⇒ 0——Go 对 u64 的 && || 发裸位形 and/or 且**非短路**；
;   镜像 src/mir/codegen.go emitLogic（裸 and/or <lt>）+ hir2mir typeOfNode KInfix（cmp=false ⇒ 结果型=左操作数型 u64）；
;   与位运算族同码（OP-AND/OR，s68 复用），bop 层无需分流
;   （s79 test-arith-u64-bit-gate 所钉「同码⇒不等价逻辑语义、与真短路一起后置」的假设被探针推翻：
;    Go 权威本无短路语义，放行即镜像；原门禁测试改写为放行断言）
test-logic-u64-and-plain = () {
    src = 'u9a = (x u64, y u64) (r u64) {\n    r = x && y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'logic-u64-and-plain unsup')
    runner.eq(ir.contains('and i64'), 1, 'logic-u64-and-plain and')
}

; s83：u64 的 '||' 放行 ⇒ or i64（src 隔离，同 test-bit-u64-or-plain 口径）
test-logic-u64-or-plain = () {
    src = 'u9b = (x u64, y u64) (r u64) {\n    r = x || y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'logic-u64-or-plain unsup')
    runner.eq(ir.contains('or i64'), 1, 'logic-u64-or-plain or')
}

; s83：u64 && 整字面量同走（uty「任一侧 TY-U64」；Go 探针对 0 && 1 ⇒ 0 已验收）
test-logic-u64-and-lit = () {
    src = 'u9c = (x u64) (r u64) {\n    r = x && 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'logic-u64-and-lit unsup')
    runner.eq(ir.contains('and i64'), 1, 'logic-u64-and-lit and')
}

; ── u64 位运算／移位族（s79）────────────────────────────────
; s79：u64 的 '&' 放行——and/or/xor/shl 与签／无签无关（逐位运算，64 位宽位元相同），
;   Go 侧无 OpBitAndU 等衍生算子（无符號路由表只有除模与序比较），恒发裸 and i64
;
;   （镜像 src/mir/codegen.go emitBitwise：and/or/xor/shl 逐位无符號性；OpShr 恒 lshr——
;    「nolang >> is a logical shift」；唯一衍生是 '>>' ⇒ OP-SHRU，cg s36 已备 lshr 臂）
test-bit-u64-and-plain = () {
    src = 'u8a = (x u64, y u64) (r u64) {\n    r = x & y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-and-plain unsup')
    runner.eq(ir.contains('and i64'), 1, 'bit-u64-and-plain and')
}

; s79：u64 的 '|' 放行 ⇒ or i64
;   （注意断言只用于本函数 src 仅有 or 的场景；xor 也含子串 'or i64'，靠 src 隔离）
test-bit-u64-or-plain = () {
    src = 'u8b = (x u64, y u64) (r u64) {\n    r = x | y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-or-plain unsup')
    runner.eq(ir.contains('or i64'), 1, 'bit-u64-or-plain or')
}

; s79：u64 的 '^' 放行 ⇒ xor i64
test-bit-u64-xor-plain = () {
    src = 'u8c = (x u64, y u64) (r u64) {\n    r = x ^ y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-xor-plain unsup')
    runner.eq(ir.contains('xor i64'), 1, 'bit-u64-xor-plain xor')
}

; s79：u64 的 '<<' 放行 ⇒ shl i64（左移高位丢弃，签／无签同值；Go 明文定义 shl 回绕非溢出）
test-bit-u64-shl-plain = () {
    src = 'u8d = (x u64, y u64) (r u64) {\n    r = x << y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-shl-plain unsup')
    runner.eq(ir.contains('shl i64'), 1, 'bit-u64-shl-plain shl')
}

; s79 🔴 本件唯一重映射靶：u64 的 '>>' ⇒ OP-SHRU ⇒ lshr i64（镜像 Go OpShr 恒发 lshr；
;   有符號 OP-SHR/ashr 是 i64 路专属，u64 若误走 ashr 对最高位为 1 的值错填 1）
test-bit-u64-shr-lshr = () {
    src = 'u8e = (x u64, y u64) (r u64) {\n    r = x >> y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-shr-lshr unsup')
    runner.eq(ir.contains('lshr i64'), 1, 'bit-u64-shr-lshr lshr')
    runner.eq(ir.contains('ashr'), 0, 'bit-u64-shr-lshr not ashr')
}

; s79：u64 >> 整字面量同走（沿用 uty「任一侧 TY-U64」——移位量为 TY-I64 亦入无符號路）
test-bit-u64-shr-lit = () {
    src = 'u8f = (x u64) (r u64) {\n    r = x >> 3\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-shr-lit unsup')
    runner.eq(ir.contains('lshr i64'), 1, 'bit-u64-shr-lit lshr')
}

; s79：嵌套位运算 ((x & y) | 1)——内层 dest TY-U64，外层读它再 or ⇒ 皆落无符號整族
test-bit-u64-nested = () {
    src = 'u8g = (x u64, y u64) (r u64) {\n    r = (x & y) | 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-nested unsup')
    runner.eq(ir.contains('and i64'), 1, 'bit-u64-nested and')
    runner.eq(ir.contains('or i64'), 1, 'bit-u64-nested or')
}

; s79 🔴 槽宽耦合靶（s77/s78 同族）：let 目标 f 由 h2m-ty-of 前扫描注册为 TY-U64
;   （非比较符⇒U64，s77 拆路后天然满足），降级侧位运算臂 dest 亦 TY-U64——第二次写 f = f ^ y 不撞 st == vt 门禁
test-bit-u64-slot-u64 = () {
    src = 'u8h = (x u64, y u64, n i64) (r u64) {\n    f = x & y\n    n > 0 -> f = f ^ y\n    r = f\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-slot-u64 unsup')
    runner.eq(ir.contains('and i64'), 1, 'bit-u64-slot-u64 and')
    runner.eq(ir.contains('xor i64'), 1, 'bit-u64-slot-u64 xor')
    runner.eq(ir.contains('store i64'), 1, 'bit-u64-slot-u64 store')
}

; s79：mem 模式下的 u64 位运算——跨块 alloca/load 链喂 and i64
test-bit-u64-and-mem = () {
    src = 'u8i = (x u64, y u64, n i64) (r u64) {\n    r = x & y\n    n > 0 -> n = n - 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-u64-and-mem unsup')
    runner.eq(ir.contains('alloca i64'), 1, 'bit-u64-and-mem alloca')
    runner.eq(ir.contains('and i64'), 1, 'bit-u64-and-mem and')
    runner.eq(ir.contains('load i64, i64*'), 1, 'bit-u64-and-mem load')
}

; ── u64 比较族（s77）────────────────────────────────────────
; s77：u64 的 '<' 放行 ⇒ OP-CMPLTU（icmp ult i64 + zext i1→i64），dest 恒 TY-I64
;   （镜像 Go hir2mir.go 的 post-lowering 路由 OpLt⇒OpULt：任一侧 sourceUnsigned 即走无符號；
;    有符號 slt 会把最高位为 1 的 u64 当负数而误序）
test-cmp-u64-lt = () {
    src = 'u7t = (x u64, y u64) (r i64) {\n    r = x < y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-lt unsup')
    runner.eq(ir.contains('icmp ult i64'), 1, 'cmp-u64-lt ult')
    runner.eq(ir.contains('icmp slt i64'), 0, 'cmp-u64-lt not slt')
    runner.eq(ir.contains('zext i1'), 1, 'cmp-u64-lt zext')
}

; s77：u64 的 '<=' 放行 ⇒ OP-CMPLEU（icmp ule i64）
test-cmp-u64-le = () {
    src = 'u7u = (x u64, y u64) (r i64) {\n    r = x <= y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-le unsup')
    runner.eq(ir.contains('icmp ule i64'), 1, 'cmp-u64-le ule')
    runner.eq(ir.contains('icmp sle i64'), 0, 'cmp-u64-le not sle')
}

; s77：u64 的 '>' 放行 ⇒ OP-CMPGTU（icmp ugt i64）
test-cmp-u64-gt = () {
    src = 'u7v = (x u64, y u64) (r i64) {\n    r = x > y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-gt unsup')
    runner.eq(ir.contains('icmp ugt i64'), 1, 'cmp-u64-gt ugt')
    runner.eq(ir.contains('icmp sgt i64'), 0, 'cmp-u64-gt not sgt')
}

; s77：u64 的 '>=' 放行 ⇒ OP-CMPGEU（icmp uge i64）
test-cmp-u64-ge = () {
    src = 'u7w = (x u64, y u64) (r i64) {\n    r = x >= y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-ge unsup')
    runner.eq(ir.contains('icmp uge i64'), 1, 'cmp-u64-ge uge')
    runner.eq(ir.contains('icmp sge i64'), 0, 'cmp-u64-ge not sge')
}

; s77：u64 的 '==' 走原路 OP-CMPEQ——Go 口径「eq/ne 与符号无关（同位比较）」，
;   hir2mir 的无符號重映射刻意不含 OpEq/OpNe ⇒ 断言不得出现任何 u* 谓词
test-cmp-u64-eq = () {
    src = 'u7x = (x u64, y u64) (r i64) {\n    r = x == y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-eq unsup')
    runner.eq(ir.contains('icmp eq i64'), 1, 'cmp-u64-eq eq')
    runner.eq(ir.contains('icmp ult i64'), 0, 'cmp-u64-eq no ult')
}

; s77：u64 的 '!=' 走原路 OP-CMPNE（同上：ne 亦与符号无关）
test-cmp-u64-ne = () {
    src = 'u7y = (x u64, y u64) (r i64) {\n    r = x != y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-ne unsup')
    runner.eq(ir.contains('icmp ne i64'), 1, 'cmp-u64-ne ne')
    runner.eq(ir.contains('icmp ule i64'), 0, 'cmp-u64-ne no ule')
}

; s77：一侧 u64 × 整字面量同走无符號比较（镜像 sourceUnsigned(lv) || sourceUnsigned(rv) 的任一侧判据）
test-cmp-u64-lit = () {
    src = 'u7z = (x u64) (r i64) {\n    r = x < 2\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-lit unsup')
    runner.eq(ir.contains('icmp ult i64'), 1, 'cmp-u64-lit ult')
}

; s77：mem 模式下的 u64 比较——操作数出自 entry 块 alloca 槽，跨块 LOAD 后喂 icmp uge
test-cmp-u64-mem = () {
    src = 'u7n = (x u64, y u64, n i64) (r i64) {\n    r = x >= y\n    n > 0 -> n = n - 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-mem unsup')
    runner.eq(ir.contains('alloca i64'), 1, 'cmp-u64-mem alloca')
    runner.eq(ir.contains('load i64, i64*'), 1, 'cmp-u64-mem load')
    runner.eq(ir.contains('icmp uge i64'), 1, 'cmp-u64-mem uge')
}

; s77 🔴 前扫描耦合：比较 infix 的槽宽必推 TY-I64（不是 TY-U64）——
;   h2m-scan 用 h2m-ty-of(RHS) 独立登记 let 目标，而降级侧 dest 恒 TY-I64；
;   若 ty-of 沿用 s76 的「整族含 u64 ⇒ U64」，f 会铺成 U64 槽，随后 f = f + 1 写 I64 值
;   ⇒ h2m-var-write 型别不符计 unsup（注册模式绿、mem 模式红的正是这条耦合）
test-cmp-u64-slot-i64 = () {
    src = 'u7s = (x u64, y u64) (r i64) {\n    f = x > y\n    x > 0 -> f = f + 1\n    r = f\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-u64-slot-i64 unsup')
    runner.eq(ir.contains('icmp ugt i64'), 1, 'cmp-u64-slot-i64 ugt')
    runner.eq(ir.contains('add i64'), 1, 'cmp-u64-slot-i64 i64 add')
    runner.eq(ir.contains('store i64'), 1, 'cmp-u64-slot-i64 store')
}

; s87 翻正：f64 '%' 字面量形（形参×f64 字面量，s73 已备 OP-CONST TY-F64）放行 ⇒ frem double
;   （旧 s75 门禁哨兵 test-arith-f64-mod-gate 锚「is-arith 不含 OP-MOD」，放行后语义过时，翻正为正向）
test-arith-f64-mod-lit = () {
    src = 'i6p = (x f64) (r f64) {\n    r = x % 2.0\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'arith-f64-mod-lit unsup')
    runner.eq(ir.contains('frem double'), 1, 'arith-f64-mod-lit frem')
}

; ── f64 比较（s72）──────────────────────────────────────────
; f64 小于：x < y（两 f64 形参）⇒ fcmp olt double ＋ zext i1→i64（比较结果恒 i64，走 %v 命名空间）
;   ⚠ 与 f64 算术臂分岔：算术 dest 记 TY-F64（发 fadd 等），比较 dest 记 TY-I64（zext 到 i64）
test-cmp-f64-lt = () {
    src = 'c6l = (x f64, y f64) (r i64) {\n    r = x < y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-f64-lt unsup')
    runner.eq(ir.contains('fcmp olt double'), 1, 'cmp-f64-lt fcmp olt')
    runner.eq(ir.contains('zext i1'), 1, 'cmp-f64-lt zext')
    runner.eq(ir.contains('define i64'), 1, 'cmp-f64-lt define i64')
    runner.eq(ir.contains('ret i64'), 1, 'cmp-f64-lt ret i64')
}

; f64 相等：x == y ⇒ fcmp oeq double
test-cmp-f64-eq = () {
    src = 'c6e = (x f64, y f64) (r i64) {\n    r = x == y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-f64-eq unsup')
    runner.eq(ir.contains('fcmp oeq double'), 1, 'cmp-f64-eq fcmp oeq')
}

; f64 不等：x != y ⇒ fcmp une double（une 保 NaN 语义）
test-cmp-f64-ne = () {
    src = 'c6n = (x f64, y f64) (r i64) {\n    r = x != y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-f64-ne unsup')
    runner.eq(ir.contains('fcmp une double'), 1, 'cmp-f64-ne fcmp une')
}

; f64 嵌套比较：(x + y) < z ⇒ 内层 fadd double（TY-F64）后外层 fcmp olt double（TY-I64 结果）
test-cmp-f64-arith-nested = () {
    src = 'c6a = (x f64, y f64, z f64) (r i64) {\n    r = (x + y) < z\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'cmp-f64-nested unsup')
    runner.eq(ir.contains('fadd double'), 1, 'cmp-f64-nested fadd')
    runner.eq(ir.contains('fcmp olt double'), 1, 'cmp-f64-nested fcmp olt')
}

; 门控：混合操作数（一 f64 一 i64）比较 ⇒ unsup（两侧须同为 f64 或同为 i64）
test-cmp-f64-mixed-gate = () {
    src = 'c6x = (x f64, y i64) (r i64) {\n    r = x < y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'cmp-f64-mixed counted')
    runner.eq(ir.contains('define'), 0, 'cmp-f64-mixed no code')
}

; 门控：位运算 & 于 f64 仍门禁（s72 收紧 f64 放行臂至仅算术＋比较；用 r f64 确保不是靠赋值型别不匹配而并靠显式 mark 拦截）
test-bit-f64-gate = () {
    src = 'b6x = (x f64, y f64) (r f64) {\n    r = x & y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'bit-f64 counted')
    runner.eq(ir.contains('define'), 0, 'bit-f64 no code')
}

; 门控：逻辑 && 于 f64 仍门禁（s68 所记 f64/u64 逻辑操作数门禁，s72 收紧后铉住；r f64 同避开型别不匹配假拦截）
test-logic-f64-gate = () {
    src = 'l6x = (x f64, y f64) (r f64) {\n    r = x && y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'logic-f64 counted')
    runner.eq(ir.contains('define'), 0, 'logic-f64 no code')
}

; ── f64 字面量（s73）────────────────────────────────────────
; f64 字面量参与算术：x * 2.0 ⇒ 字面量经 OP-CONST(TY-F64) 物化为 %fd = fadd double 0.0, 2.0，再 fmul double
;   ⚠ 与 i64 字面量分岔：i64 走 add i64 0, <int>；f64 走 fadd double 0.0, <raw>（raw 取 slot1 源文，含小数点）
test-f64-lit-arith = () {
    src = 'l6a = (x f64) (r f64) {\n    r = x * 2.0\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'f64-lit-arith unsup')
    runner.eq(ir.contains('fadd double 0.0, 2.0'), 1, 'f64-lit-arith const')
    runner.eq(ir.contains('fmul double'), 1, 'f64-lit-arith fmul')
    runner.eq(ir.contains('define double'), 1, 'f64-lit-arith define double')
    runner.eq(ir.contains('ret double'), 1, 'f64-lit-arith ret double')
}

; f64 字面量参与比较：x < 3.0 ⇒ 字面量 fadd double 0.0, 3.0 后 fcmp olt double ＋ zext i1→i64（结果恒 i64）
test-f64-lit-cmp = () {
    src = 'l6c = (x f64) (r i64) {\n    r = x < 3.0\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'f64-lit-cmp unsup')
    runner.eq(ir.contains('fadd double 0.0, 3.0'), 1, 'f64-lit-cmp const')
    runner.eq(ir.contains('fcmp olt double'), 1, 'f64-lit-cmp fcmp olt')
    runner.eq(ir.contains('zext i1'), 1, 'f64-lit-cmp zext')
    runner.eq(ir.contains('define i64'), 1, 'f64-lit-cmp define i64')
}

; 门控：无小数点的裸指数面字面量（如 1e5）raw 不含 '.' ⇒ LLVM double 字面量文法拒绝 ⇒ 诚实 unsup
test-f64-lit-gate = () {
    src = 'l6g = (x f64) (r f64) {\n    r = x * 1e5\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'f64-lit-gate counted')
    runner.eq(ir.contains('define'), 0, 'f64-lit-gate no code')
}

; ── f64 局部变量 / 控制流（s74）──────────────────────────────
; mem 模式下 f64 局部量铺 alloca double 槽：带标注声明 `y f64 = 1.5` + guard 改写 + 末尾读回 ⇒
;   alloca double / store double / load double 全套（字面量零初始化走 sym='0.0' 的 fadd 物化）
test-f64-slot-flow = () {
    src = 's6f = (x f64) (r f64) {\n    y f64 = 1.5\n    x > 2.0 -> y = x + y\n    r = y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'f64-slot-flow unsup')
    runner.eq(ir.contains('alloca double'), 1, 'f64-slot-flow alloca')
    runner.eq(ir.contains('store double'), 1, 'f64-slot-flow store')
    runner.eq(ir.contains('load double'), 1, 'f64-slot-flow load')
    runner.eq(ir.contains('fadd double 0.0, 1.5'), 1, 'f64-slot-flow init const')
    runner.eq(ir.contains('define double'), 1, 'f64-slot-flow define double')
    runner.eq(ir.contains('ret double'), 1, 'f64-slot-flow ret double')
}

; 无前扫描标注的 f64 局部量靠初值推断定槽宽：`y = x * 2.0` ⇒ h2m-ty-of 认 f64 字面量与 f64 算术 infix ⇒ TY-F64 槽
test-f64-slot-infer = () {
    src = 's6g = (x f64) (r f64) {\n    y = x * 2.0\n    x > 1.0 -> y = y + x\n    r = y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'f64-slot-infer unsup')
    runner.eq(ir.contains('alloca double'), 1, 'f64-slot-infer alloca')
    runner.eq(ir.contains('fmul double'), 1, 'f64-slot-infer fmul')
    runner.eq(ir.contains('fadd double'), 1, 'f64-slot-infer fadd')
}

; 门控：f64 与 i64 混合的局部初值（`y = x + 1`）前扫描推不出型别（一 F64 一 I64）⇒ 槽宽 -1 ⇒ 诚实 unsup
test-f64-slot-mixed-gate = () {
    src = 's6h = (x f64) (r f64) {\n    y = x + 1\n    x > 1.0 -> y = y + x\n    r = y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'f64-slot-mixed-gate counted')
    runner.eq(ir.contains('define'), 0, 'f64-slot-mixed-gate no code')
}

; 位与：x & y ⇒ and i64
test-bit-and = () {
    src = 'b1x = (x i64, y i64) (r i64) {\n    r = x & y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-and unsup')
    runner.eq(ir.contains('and i64'), 1, 'bit-and and')
    runner.eq(ir.contains('define'), 1, 'bit-and code')
}

; 位或：x | y ⇒ or i64
test-bit-or = () {
    src = 'b2x = (x i64, y i64) (r i64) {\n    r = x | y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-or unsup')
    runner.eq(ir.contains('or i64'), 1, 'bit-or or')
}

; 位异或：x ^ y ⇒ xor i64（双变量 ⇒ xor i64 %v, %v）
test-bit-xor = () {
    src = 'b3x = (x i64, y i64) (r i64) {\n    r = x ^ y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-xor unsup')
    runner.eq(ir.contains('xor i64'), 1, 'bit-xor xor')
}

; 左移：x << 2 ⇒ shl i64
test-bit-shl = () {
    src = 'b4x = (x i64) (r i64) {\n    r = x << 2\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-shl unsup')
    runner.eq(ir.contains('shl i64'), 1, 'bit-shl shl')
}

; 右移：x >> 1 ⇒ lshr i64（s80 裁定：镜像 Go codegen.go emitBitwise——OpShr 对所有整型恒发
;   lshr，注释 7212「nolang >> is a logical shift (lshr), matching the legacy backend」；
;   s35 的「i64=ashr」设计与 Go 失真被推翻，ashr 不得再出现于自举产物）
test-bit-shr = () {
    src = 'b5x = (x i64) (r i64) {\n    r = x >> 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-shr unsup')
    runner.eq(ir.contains('lshr i64'), 1, 'bit-shr lshr')
    runner.eq(ir.contains('ashr'), 0, 'bit-shr not ashr')
}

; s80 mem 槽路：i64 '>>' 走 var-write/store 也恒发 lshr（重映射在 op 层、与 SSA/mem 路无关；
;   contains 是存在性而非计数——双移位皆降发由 unsup==0 钉住，路旁残留 ashr 由零出现钉住）
test-shr-i64-mem = () {
    src = 'b5m = (x i64, n i64) (r i64) {\n    f = x >> 2\n    k = 0\n    n > 0 -> k = f >> 1\n    r = k\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'shr-i64-mem unsup')
    runner.eq(ir.contains('lshr i64'), 1, 'shr-i64-mem lshr present')
    runner.eq(ir.contains('ashr'), 0, 'shr-i64-mem not ashr')
}

; 位运算嵌算术：r = (x & 15) + 1 ⇒ AND 再 ADD（验优先级树降级）
test-bit-chain = () {
    src = 'b6x = (x i64) (r i64) {\n    r = (x & 15) + 1\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'bit-chain unsup')
    runner.eq(ir.contains('and i64'), 1, 'bit-chain and')
    runner.eq(ir.contains('add i64'), 1, 'bit-chain add')
}

; 门控：x &^ y（位清除）仍无对应 op ⇒ unsup（s67 旧例用 '/' 演示，s75 已放行除法，改由 &^ 守住本门禁）
test-bit-gate = () {
    src = 'b7x = (x i64, y i64) (r i64) {\n    r = x &^ y\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup > 0, 1, 'bit-gate counted')
    runner.eq(ir.contains('define'), 0, 'bit-gate no code')
}

; 逻辑与：r = (x > 0) && (y < 10) ⇒ 两个 cmp 后 and i64（操作数在 i64 子集为 0/1）
test-log-and = () {
    src = 'g1x = (x i64, y i64) (r i64) {\n    r = (x > 0) && (y < 10)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'log-and unsup')
    runner.eq(ir.contains('and i64'), 1, 'log-and and')
    runner.eq(ir.contains('define'), 1, 'log-and code')
}

; 逻辑或：r = (x > 0) || (y < 10) ⇒ 两个 cmp 后 or i64
test-log-or = () {
    src = 'g2x = (x i64, y i64) (r i64) {\n    r = (x > 0) || (y < 10)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'log-or unsup')
    runner.eq(ir.contains('or i64'), 1, 'log-or or')
}

; 逻辑链优先级：r = (x > 0) && (y > 0) || (x > 5) ⇒ && 紧于 || ⇒ ((and) || cmp)
test-log-chain = () {
    src = 'g3x = (x i64, y i64) (r i64) {\n    r = (x > 0) && (y > 0) || (x > 5)\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'log-chain unsup')
    runner.eq(ir.contains('and i64'), 1, 'log-chain and')
    runner.eq(ir.contains('or i64'), 1, 'log-chain or')
}

; s83：原 s67 门禁测试 test-log-gate（u64 && 计 unsup）被探針推翻——Go 对 u64 的 && || 即裸位形
;   and/or 非短路（12 && 10 ⇒ 8、0 || 5 ⇒ 5）⇒ 改写为 mem 放行靶：跨块两写 f 不撞 st == vt
;   （同 test-bit-u64-slot-u64 的槽寬耦合族；plain/lit 形见 test-logic-u64-*）
test-log-u64-mem = () {
    src = 'g4x = (x u64, y u64, n i64) (r u64) {\n    f = x && y\n    n > 0 -> f = f || y\n    r = f\n}\n'
    t = ast.make()
    r = ps.parse(t, ps.new(src.to-bytes()))
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, r)
    runner.eq(agg.unsup, 0, 'log-u64-mem unsup')
    runner.eq(ir.contains('and i64'), 1, 'log-u64-mem and')
    runner.eq(ir.contains('or i64'), 1, 'log-u64-mem or')
    runner.eq(ir.contains('store i64'), 1, 'log-u64-mem store')
}

