; s115 勘察探针：显式 match（表达式主体）的 SurfaceMatch 形制
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok
# /compiler/src/ps
# /compiler/src/ix

kname = (k i64) (s str) {
    s = k.to-str()
    k == 14 -> s = '14:BLOCK'
    k == 30 -> s = '30:FOR'
    k == 35 -> s = '35:IDENT'
    k == 36 -> s = '36:IF-EXPR'
    k == 38 -> s = '38:INFIX'
    k == 39 -> s = '39:INT-LIT'
    k == 40 -> s = '40:EXPR-STAT'
    k == 42 -> s = '42:LET'
    k == 56 -> s = '56:RETURN'
    k == 61 -> s = '61:STR-LIT'
    k == 65 -> s = '65:SURFACE-MATCH'
}

aname = (j i64) (s str) {
    s = j.to-str()
    j == 0 -> s = '0:binding'
    j == 1 -> s = '1:bindingVariant'
    j == 2 -> s = '2:typePattern'
    j == 3 -> s = '3:typeBinding'
    j == 4 -> s = '4:wildcard'
    j == 5 -> s = '5:dot-val'
    j == 6 -> s = '6:rawCond'
    j == 7 -> s = '7:blockBody'
    j == 8 -> s = '8:typeArm'
    j == 9 -> s = '9:valueCtx'
    j == 10 -> s = '10:Condition'
    j == 11 -> s = '11:Body'
}

dump-arms = (t ast, n i64) {
    d = ast.nd-at(t, n)
    cnt = ''
    d.s0 > 0 -> cnt = ast.str-at(t, d.s0)
    print('    SM node=' - n.to-str() - ' s0(arms)="' - cnt - '" nkid=' - d.nkid.to-str() - ' kid0=' - d.kid0.to-str() - ' hcount=' - d.hcount.to-str() - ' hbase=' - d.hbase.to-str())
    subj = ast.kid-at(t, d.kid0)
    subj > 0 -> print('      subject kind=' - kname(ast.kind-at(t, subj)) - ' str=' - ast.node-string(t, subj))
    subj <= 0 -> print('      subject = 0 (placeholder)')
    arms = d.hcount
    j = 0
    (j < arms) {
        hb = d.hbase + 12 * j
        print('    arm' - j.to-str() - ':')
        q = 0
        (q < 12) {
            v = ast.aux-at(t, hb + q)
            txt = ' 0'
            v > 0 -> {
                txt = ' raw=' - v.to-str()
                sv = ast.str-at(t, v)
                sv != '' -> txt = txt - ' str="' - sv - '"'
                kk = ast.kind-at(t, v)
                kk > 0 -> txt = txt - ' nk=' - kname(kk) - ' ns=' - ast.node-string(t, v)
            }
            an = aname(q)
            print('      ' - an - ' =' - txt)
            q = ix.inc(q)
        }
        j = ix.inc(j)
    }
}

find-sm = (t ast, n i64) (r i64) {
    d = ast.nd-at(t, n)
    d.kind == asp.K-SURFACE-MATCH -> r = n
    d.kind != asp.K-SURFACE-MATCH -> {
        r = 0
        i = 0
        (i < d.nkid && r == 0) {
            p = d.kid0
            #{overflow=wrap}
            p = p + i
            kid = ast.kid-at(t, p)
            kid > 0 -> r = find-sm(t, kid)
            i = ix.inc(i)
        }
    }
}

one = (name str) {
    print('=== form ' - name - ' ===')
    bb = fs.read-file('compiler/tests/t8/' - name - '.no')
    bb.len() <= 0 -> {
        print('  READ FAIL')
        return
    }
    t = ast.make()
    p = ps.new(bb)
    root = ps.parse(t, p)
    print('  root=' - root.to-str())
    sm = find-sm(t, root)
    sm > 0 -> dump-arms(t, sm)
    sm <= 0 -> print('  NO SURFACE-MATCH')
}

one('f1')
one('f2')
one('f3')
print('done')
