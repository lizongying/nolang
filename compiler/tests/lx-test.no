; lx-test.no — compiler/src/lx 的 scan-all 單元測試
;
; 執行： ./bin/no run compiler/tests/lx-test.no
;
; ⚠️ 測試 runner 的斷言失敗【不會】自動改變行程退出碼，本檔結尾必須自己
;    exit(1)，否則差分 harness 會把失敗讀成通過。
;
; ── 為什麼需要本檔（L1 門禁不夠嗎？）──
; L1 比的是 **dump()** 的輸出。M2 起解析器改用 **scan-all()**（token 陣列）。
; 兩者共用 lx-scan-token，但陣列化多了一步「把 t push 進 []tk」。若 push 是
; **別名**而不是深拷貝，scan-all 會全錯而 dump 全對 ⇒ **L1 完全照不到**。
; test-no-alias 就是為了釘死這件事：三個識別符的字面量必須互不相同。
;
; ⚠️ 期望值不是「我以為應該是什麼」，而是**已由 L1 驗證過**的 token 流
;    （用 `noc tokens <檔>` 與 oracle 逐位元組比對過）。改動 lx.no 後若本檔紅，
;    先確認是 lx.no 錯還是期望值過期 —— **不要直接改期望值**。
;
; ⚠️ 訊息一律用單引號字串。nolang 的 "..." 是【char 字面量】，不是字串；
;    要在字串裡放單引號必須轉義：'\'x\'' 是三個位元組 ' x '。
;
; ⚠️ 每一次「讀取」切片元素都回傳 ?T，需以值 match / `?=` 顯式消費，**即使是字面量索引**
;    （實測：`t = ts[0]` 未消費 ?T 會報錯並拒絕編譯）。

# /test/runner.eq
# /test/runner.str-eq
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/tok
# /compiler/src/lx

; ═══════════════════════════════════════════════
; 1. 空輸入：恰好一個 EOF
; ═══════════════════════════════════════════════

; 測試 empty
test-empty = () {
    ts = lx.scan-all('')
    runner.eq(ts.len(), 1, 'empty source -> exactly 1 token')

    t = ts[0]: {
        ok -> it

        -> _
    }
    runner.eq(t.typ, tok.EOF, 'empty source -> that token is EOF')
    runner.eq(t.ln, 1, 'EOF at line 1')
    runner.eq(t.cl, 1, 'EOF at col 1')
}

; ═══════════════════════════════════════════════
; 2. 別名偵測（本檔最重要的測試）
;    三個識別符的字面量必須互不相同。若 push 只存指標/reference，
;    三個元素都會讀到最後一次的 'ghi'。
; ═══════════════════════════════════════════════

; 測試 no-alias
test-no-alias = () {
    ts = lx.scan-all('abc def ghi')
    runner.eq(ts.len(), 4, 'abc def ghi -> 4 tokens')

    t0 = ts[0]: {
        ok -> it

        -> _
    }

    t1 = ts[1]: {
        ok -> it

        -> _
    }

    t2 = ts[2]: {
        ok -> it

        -> _
    }
    runner.str-eq(t0.lit, 'abc', 3, 'elem 0 literal is abc (not aliased)')
    runner.str-eq(t1.lit, 'def', 3, 'elem 1 literal is def (not aliased)')
    runner.str-eq(t2.lit, 'ghi', 3, 'elem 2 literal is ghi (not aliased)')
    runner.eq(t0.typ, tok.IDENT, 'elem 0 is IDENT')
    runner.eq(t1.typ, tok.IDENT, 'elem 1 is IDENT')
    runner.eq(t2.typ, tok.IDENT, 'elem 2 is IDENT')
    runner.eq(t0.cl, 1, 'abc at col 1')
    runner.eq(t1.cl, 5, 'def at col 5')
    runner.eq(t2.cl, 9, 'ghi at col 9')
}

; ═══════════════════════════════════════════════
; 3. 型別序列：a = 1
; ═══════════════════════════════════════════════

; 測試 assign
test-assign = () {
    ts = lx.scan-all('a = 1')
    runner.eq(ts.len(), 4, 'a = 1 -> 4 tokens')

    a = ts[0]: {
        ok -> it

        -> _
    }

    b = ts[1]: {
        ok -> it

        -> _
    }

    c = ts[2]: {
        ok -> it

        -> _
    }

    d = ts[3]: {
        ok -> it

        -> _
    }
    runner.eq(a.typ, tok.IDENT, 'tok0 IDENT')
    runner.eq(b.typ, tok.ASSIGN, 'tok1 ASSIGN')
    runner.eq(c.typ, tok.INT, 'tok2 INT')
    runner.eq(d.typ, tok.EOF, 'tok3 EOF')
    runner.str-eq(b.lit, '=', 1, 'ASSIGN literal is =')
    runner.eq(b.cl, 3, 'ASSIGN at col 3')
    runner.eq(c.cl, 5, 'INT at col 5')
    runner.eq(d.cl, 6, 'EOF at col 6')
}

; ═══════════════════════════════════════════════
; 4. 換行 token：'1 + 2\n'
; ═══════════════════════════════════════════════

; 測試 newline
test-newline = () {
    ts = lx.scan-all('1 + 2\n')
    runner.eq(ts.len(), 5, '1 + 2 NL -> 5 tokens')

    a = ts[0]: {
        ok -> it

        -> _
    }

    b = ts[1]: {
        ok -> it

        -> _
    }

    c = ts[2]: {
        ok -> it

        -> _
    }

    d = ts[3]: {
        ok -> it

        -> _
    }

    e = ts[4]: {
        ok -> it

        -> _
    }
    runner.eq(a.typ, tok.INT, 'tok0 INT')
    runner.eq(b.typ, tok.ADD, 'tok1 ADD')
    runner.eq(c.typ, tok.INT, 'tok2 INT')
    runner.eq(d.typ, tok.NEWLINE, 'tok3 NEWLINE')
    runner.eq(e.typ, tok.EOF, 'tok4 EOF')
    runner.eq(d.ln, 2, 'NEWLINE is on line 2')
    runner.eq(d.cl, 0, 'NEWLINE column is always 0')
}

; ═══════════════════════════════════════════════
; 5. char（雙引號）vs string（單引號）
; ═══════════════════════════════════════════════

; 測試 char-vs-string
test-char-vs-string = () {
    cs = lx.scan-all('"x"')
    runner.eq(cs.len(), 2, 'char literal -> 2 tokens')

    c = cs[0]: {
        ok -> it

        -> _
    }
    runner.eq(c.typ, tok.CHAR, 'double quotes -> CHAR')
    runner.str-eq(c.lit, 'x', 1, 'char value is x')
    runner.str-eq(c.raw, '"x"', 3, 'char raw keeps its quotes')

    ss = lx.scan-all('\'x\'')
    runner.eq(ss.len(), 2, 'string literal -> 2 tokens')

    s = ss[0]: {
        ok -> it

        -> _
    }
    runner.eq(s.typ, tok.STRING, 'single quotes -> STRING')
    runner.str-eq(s.lit, 'x', 1, 'string value is x')
    runner.str-eq(s.raw, '\'x\'', 3, 'string raw keeps its quotes')
}

; ═══════════════════════════════════════════════
; 6. 註釋：marker 欄位區分 `;` 與 `//`
; ═══════════════════════════════════════════════

; 測試 comment-marker
test-comment-marker = () {
    ts = lx.scan-all('; hi\n')
    runner.eq(ts.len(), 3, 'semicolon comment + NL -> 3 tokens')

    c = ts[0]: {
        ok -> it

        -> _
    }
    runner.eq(c.typ, tok.COMMENT, 'tok0 COMMENT')
    runner.str-eq(c.mk, ';', 1, 'semicolon comment marker is ;')
    runner.str-eq(c.lit, ' hi', 3, 'comment text keeps the leading space')

    ts2 = lx.scan-all('// hi\n')

    c2 = ts2[0]: {
        ok -> it

        -> _
    }
    runner.eq(c2.typ, tok.COMMENT, 'slash comment -> COMMENT')
    runner.str-eq(c2.mk, '//', 2, 'slash comment marker is //')
}

; ═══════════════════════════════════════════════
; 7. 科學計數 ILLEGAL 檢測（s82：鏡像 Go lexer.go:999-1008）
;    期望行形由 L3 oracle 實測釘死（/tmp/nolang-v413/bin/no vet /tmp/orb-p*.no）：
;      `x = 1e5` ⇒ 1:5 sci ErrMsg【一條】；`0x1e5` 合法（hex loop 吞 e）；
;      `1e`【不是】sci（e 後無指數位 ⇒ INT+IDENT）
; ═══════════════════════════════════════════════

; 測試 sci-notation
test-sci-notation = () {
    SCI = 'scientific notation literals (e.g. 1e40) are not supported; write the value in full (100000000000000000000000000000.0) or build it with math.pow(10.0, 40.0)'
    ts = lx.scan-all('x = 1e5')
    runner.eq(ts.len(), 5, 'x = 1e5 -> ILLEGAL + residual IDENT e5')

    a = ts[2]: {
        ok -> it

        -> _
    }

    b = ts[3]: {
        ok -> it

        -> _
    }
    runner.eq(a.typ, tok.ILLEGAL, 'sci tok2 is ILLEGAL')
    runner.eq(a.ln, 1, 'sci line')
    runner.eq(a.cl, 5, 'sci col')
    runner.str-eq(a.lit, '1', 1, 'sci lit keeps the consumed number')
    runner.str-eq(a.emsg, SCI, 156, 'sci emsg exact wording')
    runner.eq(b.typ, tok.IDENT, 'e5 residual is IDENT')
    runner.str-eq(b.lit, 'e5', 2, 'e5 literal')
    runner.eq(b.cl, 6, 'e5 starts at the e')

    ; 有點形（3.5e-2）：先 FLOAT 後被 sci 檢測覆寫為 ILLEGAL；游標停在 e 不消耗
    ts2 = lx.scan-all('3.5e-2')
    runner.eq(ts2.len(), 3, '3.5e-2 -> ILLEGAL + IDENT e-2')

    a2 = ts2[0]: {
        ok -> it

        -> _
    }
    runner.eq(a2.typ, tok.ILLEGAL, 'dotted sci is ILLEGAL not FLOAT')
    runner.str-eq(a2.lit, '3.5', 3, 'dotted sci lit is the number part')
    runner.str-eq(a2.emsg, SCI, 156, 'dotted sci emsg')

    b2 = ts2[1]: {
        ok -> it

        -> _
    }
    runner.str-eq(b2.lit, 'e-2', 3, 'e-2 residual IDENT (isLetter includes -)')

    ; 1e+5：'+' 後跟指數位 ⇒ sci
    ts3 = lx.scan-all('1e+5')

    a3 = ts3[0]: {
        ok -> it

        -> _
    }
    runner.eq(a3.typ, tok.ILLEGAL, '1e+5 is sci')
    runner.str-eq(a3.emsg, SCI, 156, '1e+5 emsg')

    ; 大寫 E 同檢
    ts4 = lx.scan-all('2E7')

    a4 = ts4[0]: {
        ok -> it

        -> _
    }
    runner.eq(a4.typ, tok.ILLEGAL, '2E7 is sci')

    ; 反例保衛：e 後無指數位 ⇒ 普通 INT（Go：x = 1e ⇒ 1 + IDENT e）
    ts5 = lx.scan-all('1e')
    runner.eq(ts5.len(), 3, '1e -> INT + IDENT + EOF')

    a5 = ts5[0]: {
        ok -> it

        -> _
    }
    runner.eq(a5.typ, tok.INT, '1e is NOT sci (no exponent digit)')

    b5 = ts5[1]: {
        ok -> it

        -> _
    }
    runner.str-eq(b5.lit, 'e', 1, '1e residual IDENT')

    ; 反例保衛：hex 的 e 被 isHex loop 吞掉，尾字符不可能是 e ⇒ 絕不觸發
    ts6 = lx.scan-all('0x1e5')
    runner.eq(ts6.len(), 2, '0x1e5 single hex token')

    a6 = ts6[0]: {
        ok -> it

        -> _
    }
    runner.eq(a6.typ, tok.INT, 'hex 0x1e5 stays INT')
    runner.str-eq(a6.lit, '0x1e5', 5, 'hex lit intact')

    ; 裸 ILLEGAL（未知字符）無 emsg —— Go 走 ps 側 'illegal token %q' 第二句
    ts7 = lx.scan-all('$')

    a7 = ts7[0]: {
        ok -> it

        -> _
    }
    runner.eq(a7.typ, tok.ILLEGAL, 'dollar is bare ILLEGAL')
    runner.str-eq(a7.emsg, '', 0, 'bare ILLEGAL has no emsg')
}

; ═══════════════════════════════════════════════
; 8. `..` vs `...`（s101）
;    `..` = 範圍運算符（tok.ELLIPSIS，歷史命名）；`...` = 佔位陳述（tok.ELLIPSIS3）。
;    兩者必須是**不同** token：混用會讓 `[0...n)` 這種誤寫靜默成為合法範圍，
;    而 Go lexer.go:906 刻意把它收成單一 token 正是為了擋這條。
; ═══════════════════════════════════════════════

; 測試 ellipsis-vs-ellipsis3
test-ellipsis = () {
    t2 = lx.scan-all('a..b')
    runner.eq(t2.len(), 4, 'a..b -> 4 tokens')

    d2 = t2[1]: {
        ok -> it

        -> _
    }
    runner.eq(d2.typ, tok.ELLIPSIS, 'a..b middle token is ELLIPSIS (..)')
    runner.str-eq(d2.lit, '..', 2, '.. literal is two dots')

    t3 = lx.scan-all('...')
    runner.eq(t3.len(), 2, '... -> 2 tokens (ELLIPSIS3 + EOF)')

    d3 = t3[0]: {
        ok -> it

        -> _
    }
    runner.eq(d3.typ, tok.ELLIPSIS3, '... is ELLIPSIS3, not ELLIPSIS')
    runner.str-eq(d3.lit, '...', 3, '... literal is three dots')

    ; 三個點後面接識別符也必須整體成一個 ELLIPSIS3（不得切成 .. + .ident）
    t4 = lx.scan-all('[0...n)')
    runner.eq(t4.len(), 6, '[0...n) -> 6 tokens')

    d4 = t4[2]: {
        ok -> it

        -> _
    }
    runner.eq(d4.typ, tok.ELLIPSIS3, '[0...n) has ELLIPSIS3 at slot 2')

    ; 四個點：`...` 吃掉前三，剩下一個 `.`
    t5 = lx.scan-all('....')
    runner.eq(t5.len(), 3, '.... -> ELLIPSIS3 + DOT + EOF')

    d5 = t5[0]: {
        ok -> it

        -> _
    }

    d6 = t5[1]: {
        ok -> it

        -> _
    }
    runner.eq(d5.typ, tok.ELLIPSIS3, '.... first is ELLIPSIS3')
    runner.eq(d6.typ, tok.DOT, '.... second is DOT')
}

; ═══════════════════════════════════════════════

test-empty()
test-no-alias()
test-assign()
test-newline()
test-char-vs-string()
test-comment-marker()
test-sci-notation()
test-ellipsis()

runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
