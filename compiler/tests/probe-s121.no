SRC = 'f = (s str) (v []byte) {\n    v = s.bytes()\n}\n'
ll = drv.build-ll(SRC.to-bytes())
eprint('bytes len=' - ll.len-bytes().to-str() - ' define=' - ll.contains('define').to-str())

SRC2 = 'f = (s str) (v []byte) {\n    v = s.to-bytes()\n}\n'
ll2 = drv.build-ll(SRC2.to-bytes())
eprint('to-bytes len=' - ll2.len-bytes().to-str() - ' define=' - ll2.contains('define').to-str())
