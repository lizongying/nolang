; ── option：构造（some/none）+ 返回 %option 的签名 ──────
;   pick(n) = n < 10 ? some(n) : none
test-option = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    blks []i64 = []
    ops.push(OP-CONST)
    dsts.push(2)
    xa.push(10)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-CMPLT)
    dsts.push(3)
    xa.push(1)
    bs.push(2)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONDBR)
    dsts.push(2)
    xa.push(3)
    bs.push(1)
    syms.push('')
    blks.push(0)
    ops.push(OP-OPTSOME)
    dsts.push(4)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(1)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(4)
    bs.push(0)
    syms.push('')
    blks.push(1)
    ops.push(OP-OPTNONE)
    dsts.push(5)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(5)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ty []i64 = []
    ty.push(TY-I64)
    vt []i64 = []
    vt.push(TY-I64)
    vt.push(TY-I64)
    vt.push(TY-I64)
    vt.push(TY-I64)
    vt.push(TY-OPT)
    vt.push(TY-OPT)
    ct []i64 = []
    ct.push(TY-I64)
    ct.push(TY-I64)
    ct.push(TY-I64)
    ct.push(TY-OPT)
    ct.push(TY-I64)
    ct.push(TY-OPT)
    ct.push(TY-I64)
    s = cg-emit-cfg-t('pick', TY-OPT, 1, ty, vt, ct, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define %option @pick(i64 %v1)'), 1, 'option sig')
    runner.eq(s.contains('%op4 = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v1, 1, 0'), 1, 'some packs payload')
    runner.eq(s.contains('%op5 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 1, 0'), 1, 'none sets tag 1')
    runner.eq(s.contains('br i1 %c2, label %bb1, label %bb2'), 1, 'branch')
    runner.eq(s.contains('ret %option %op4'), 1, 'ret some')
    runner.eq(s.contains('ret %option %op5'), 1, 'ret none')
}

; ── option：读取（tag / is-ok / i64 载荷）───────────────
test-option-read = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
