    ops.push(OP-CONDBR)
    dsts.push(2)
    xa.push(3)
    bs.push(1)
    syms.push('')
    blks.push(0)
    ops.push(OP-OPTSOME)
    dsts.push(4)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(1)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(4)
    bs.push(0)
    syms.push('')
    blks.push(1)
    ops.push(OP-OPTNONE)
    dsts.push(5)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(5)
    bs.push(0)
