    ops.push(OP-OPTISOK)
    dsts.push(3)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-OPTGET)
    dsts.push(4)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-ADD)
    dsts.push(5)
    xa.push(2)
    bs.push(3)
    syms.push('')
    blks.push(0)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(5)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ty []i64 = []
    ty.push(TY-OPT)
    vt []i64 = []
    vt.push(TY-I64)
    vt.push(TY-OPT)
    vt.push(TY-I64)
    vt.push(TY-I64)
    vt.push(TY-I64)
    vt.push(TY-I64)
    ct []i64 = []
    ct.push(TY-I64)
    ct.push(TY-I64)
    ct.push(TY-I64)
    ct.push(TY-I64)
    ct.push(TY-I64)
    s = cg-emit-cfg-t('rd', TY-I64, 1, ty, vt, ct, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @rd(%option %op1)'), 1, 'option param sig')
    runner.eq(s.contains('%v2 = extractvalue %option %op1, 0'), 1, 'raw tag')
    runner.eq(s.contains('%ot1 = extractvalue %option %op1, 0'), 1, 'isok temp')
    runner.eq(s.contains('%c1 = icmp eq i64 %ot1, 0'), 1, 'isok compare')
    runner.eq(s.contains('%v3 = zext i1 %c1 to i64'), 1, 'isok zext')
    runner.eq(s.contains('%v4 = extractvalue %option %op1, 1, 0'), 1, 'payload slot0')
}

