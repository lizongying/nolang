; cg-test.no — compiler/src/cg.no（M4-b emit 骨架）单元测试
;
; 执行： ./bin/no run compiler/tests/cg-test.no
; ⚠️ runner 断言失败不改退出码，本档结尾必须自己 exit(1)。
;
; 断言取自 Go authority（src/mir/codegen.go emitMIR）的最小闭包形状。

# /test/runner.eq
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/cg
# /compiler/src/mir
# /compiler/src/cg-rc

; ── func three() -> 3 ───────────────────────────────────
test-alu = () {

    ; 12 条 ALU op 各钉一条**指令文本**：v<dst> ← 运算(a, b)。
    ; 值 id：v1 = 左、v2 = 右；每条 op 的 dst 顺次取 3..14。
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; k0/k1: CONST v1 = 100、v2 = 7
    ops.push(OP-CONST)
    dsts.push(1)
    xa.push(100)
    bs.push(0)
    syms.push('')
    ops.push(OP-CONST)
    dsts.push(2)
    xa.push(7)
    bs.push(0)
    syms.push('')

    ; k2..k13: 位运算 / 移位 / 除余 / 比较
    ops.push(OP-AND)
    dsts.push(3)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-OR)
    dsts.push(4)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-XOR)
    dsts.push(5)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-SHL)
    dsts.push(6)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-SHR)
    dsts.push(7)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-DIV)
    dsts.push(8)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-MOD)
    dsts.push(9)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-CMPEQ)
    dsts.push(10)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-CMPNE)
    dsts.push(11)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-CMPLE)
    dsts.push(12)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-CMPGT)
    dsts.push(13)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-CMPGE)
    dsts.push(14)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(14)
    bs.push(0)
    syms.push('')
    ptyps []i64 = []
    vty []i64 = []
    j = 0
    (j < 15) {
        vty.push(TY-I64)

        #{overflow=wrap}
        j = j + 1
    }
    cty []i64 = []
    blks []i64 = []
    n = ops.len()
    i <- [0..n): {
        cty.push(TY-I64)
        blks.push(0)
    }
    s = cg-emit-cfg-t('alu', TY-I64, 0, ptyps, vty, cty, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('%v3 = and i64 %v1, %v2'), 1, 'and')
    runner.eq(s.contains('%v4 = or i64 %v1, %v2'), 1, 'or')
    runner.eq(s.contains('%v5 = xor i64 %v1, %v2'), 1, 'xor')
    runner.eq(s.contains('%v6 = shl i64 %v1, %v2'), 1, 'shl')

    ; 移位必须是有符号（ashr），不是 lshr
    runner.eq(s.contains('%v7 = ashr i64 %v1, %v2'), 1, 'shr ashr')
    runner.eq(s.contains('lshr'), 0, 'shr not lshr')
    runner.eq(s.contains('%v8 = sdiv i64 %v1, %v2'), 1, 'div sdiv')
    runner.eq(s.contains('%v9 = srem i64 %v1, %v2'), 1, 'mod srem')

    ; 比较：icmp <pred> + zext，结果 0/1；中间名 %c<k> 按下标
    runner.eq(s.contains('%c9 = icmp eq i64 %v1, %v2'), 1, 'cmpeq icmp')
    runner.eq(s.contains('%v10 = zext i1 %c9 to i64'), 1, 'cmpeq zext')
    runner.eq(s.contains('%c10 = icmp ne i64 %v1, %v2'), 1, 'cmpne icmp')
    runner.eq(s.contains('%c11 = icmp sle i64 %v1, %v2'), 1, 'cmple icmp')
    runner.eq(s.contains('%c12 = icmp sgt i64 %v1, %v2'), 1, 'cmpgt icmp')
    runner.eq(s.contains('%c13 = icmp sge i64 %v1, %v2'), 1, 'cmpge icmp')
}

test-struct-param-ret = () {

    ; 形参侧：nargs=1、ptyps[0] = TY-STRUCT-BASE ⇒ define 签名里是 %struct.s0 %st1
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; k0: STRUCT-GET v2 = st1.0
    ops.push(OP-STRUCT-GET)
    dsts.push(2)
    xa.push(1)
    bs.push(0)
    syms.push('')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(2)
    bs.push(0)
    syms.push('')
    ptyps []i64 = []
    ptyps.push(TY-STRUCT-BASE)
    vty []i64 = []
    vty.push(TY-I64)
    vty.push(TY-STRUCT-BASE)
    vty.push(TY-I64)
    cty []i64 = []
    cty.push(TY-I64)
    cty.push(TY-I64)
    blks []i64 = []
    blks.push(0)
    blks.push(0)
    s = cg-emit-cfg-t('take', TY-I64, 1, ptyps, vty, cty, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @take(%struct.s0 %st1) {'), 1, 'struct param sig')
    runner.eq(s.contains('%v2 = extractvalue %struct.s0 %st1, 0'), 1, 'struct param get')

    ; 返回值侧：retty = TY-STRUCT-BASE ⇒ define ... %struct.s0、ret %struct.s0 %st1
    ops2 []i64 = []
    dsts2 []i64 = []
    xa2 []i64 = []
    bs2 []i64 = []
    syms2 []str = []
    ops2.push(OP-RET)
    dsts2.push(0)
    xa2.push(1)
    bs2.push(0)
    syms2.push('')
    vty2 []i64 = []
    vty2.push(TY-I64)
    vty2.push(TY-STRUCT-BASE)
    cty2 []i64 = []
    cty2.push(TY-I64)
    blks2 []i64 = []
    blks2.push(0)
    s2 = cg-emit-cfg-t('give', TY-STRUCT-BASE, 1, ptyps, vty2, cty2, blks2, ops2, dsts2, xa2, bs2, syms2)
    runner.eq(s2.contains('define %struct.s0 @give(%struct.s0 %st1) {'), 1, 'struct ret sig')
    runner.eq(s2.contains('ret %struct.s0 %st1'), 1, 'struct ret value')

    ; 调用侧：实参型别取 vty[q]、结果取 cty[k] ⇒ call %struct.s0 ... 落 %st
    ops3 []i64 = []
    dsts3 []i64 = []
    xa3 []i64 = []
    bs3 []i64 = []
    syms3 []str = []
    ops3.push(OP-CALL)
    dsts3.push(2)
    xa3.push(1)
    bs3.push(1)
    syms3.push('give')
    ops3.push(OP-RET)
    dsts3.push(0)
    xa3.push(2)
    bs3.push(0)
    syms3.push('')
    vty3 []i64 = []
    vty3.push(TY-I64)
    vty3.push(TY-STRUCT-BASE)
    vty3.push(TY-STRUCT-BASE)
    cty3 []i64 = []
    cty3.push(TY-STRUCT-BASE)
    cty3.push(TY-I64)
    blks3 []i64 = []
    blks3.push(0)
    blks3.push(0)
    s3 = cg-emit-cfg-t('roundtrip', TY-STRUCT-BASE, 1, ptyps, vty3, cty3, blks3, ops3, dsts3, xa3, bs3, syms3)
    runner.eq(s3.contains('define %struct.s0 @roundtrip(%struct.s0 %st1) {'), 1, 'struct call sig')
    runner.eq(s3.contains('%st2 = call %struct.s0 @give(%struct.s0 %st1)'), 1, 'struct call arg')
    runner.eq(s3.contains('ret %struct.s0 %st2'), 1, 'struct call ret')
}

test-struct-nested = () {

    ; 声明侧：struct#1 的字段 0 是 struct#0（sft 里就是 TY-STRUCT-BASE + 0）
    sfc = [1, 2]
    sft []i64 = [TY-I64, TY-STRUCT-BASE, TY-I64]
    d = cg-runtime-struct-decls(sfc, sft)
    runner.eq(d.contains('%struct.s0 = type { i64 }'), 1, 'nested child decl')
    runner.eq(d.contains('%struct.s1 = type { %struct.s0, i64 }'), 1, 'nested parent decl')

    ; 发射侧：MK 的字段值 id 是结构体 ⇒ 型别名与前缀取自 vty（%struct.s0 + %st）
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; k0: CONST v1 = 7
    ops.push(OP-CONST)
    dsts.push(1)
    xa.push(7)
    bs.push(0)
    syms.push('')

    ; k1: STRUCT-MK st2 = struct#0{ v1 }
    ops.push(OP-STRUCT-MK)
    dsts.push(2)
    xa.push(1)
    bs.push(1)
    syms.push('')

    ; k2: CONST v3 = 9
    ops.push(OP-CONST)
    dsts.push(3)
    xa.push(9)
    bs.push(0)
    syms.push('')

    ; k3: STRUCT-MK st4 = struct#1{ st2, v3 }
    ops.push(OP-STRUCT-MK)
    dsts.push(4)
    xa.push(2)
    bs.push(2)
    syms.push('')

    ; k4: STRUCT-GET st5 = st4.0（字段是结构体 ⇒ dst 落 %st）
    ops.push(OP-STRUCT-GET)
    dsts.push(5)
    xa.push(4)
    bs.push(0)
    syms.push('')

    ; k5: STRUCT-GET v6 = st5.0
    ops.push(OP-STRUCT-GET)
    dsts.push(6)
    xa.push(5)
    bs.push(0)
    syms.push('')

    ; k6: STRUCT-GET v7 = st4.1
    ops.push(OP-STRUCT-GET)
    dsts.push(7)
    xa.push(4)
    bs.push(1)
    syms.push('')

    ; k7: ADD v8 = v6 + v7
    ops.push(OP-ADD)
    dsts.push(8)
    xa.push(6)
    bs.push(7)
    syms.push('')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(8)
    bs.push(0)
    syms.push('')
    ptyps []i64 = []
    vty []i64 = []
    vty.push(TY-I64)
    vty.push(TY-I64)
    vty.push(TY-STRUCT-BASE)
    vty.push(TY-I64)
    vty.push(TY-STRUCT-BASE + 1)
    vty.push(TY-STRUCT-BASE)
    vty.push(TY-I64)
    vty.push(TY-I64)
    vty.push(TY-I64)
    cty []i64 = []
    cty.push(TY-I64)
    cty.push(TY-I64)
    cty.push(TY-STRUCT-BASE)
    cty.push(TY-STRUCT-BASE + 1)
    cty.push(TY-STRUCT-BASE)
    cty.push(TY-I64)
    cty.push(TY-I64)
    cty.push(TY-I64)
    cty.push(TY-I64)
    blks []i64 = []
    j = 0
    n = ops.len()
    (j < n) {
        blks.push(0)

        #{overflow=wrap}
        j = j + 1
    }
    s = cg-emit-cfg-t('nest', TY-I64, 0, ptyps, vty, cty, blks, ops, dsts, xa, bs, syms)

    ; 嵌套字段的 insertvalue：型别名 %struct.s0、值前缀 %st2
    runner.eq(s.contains('%sm3_0 = insertvalue %struct.s1 zeroinitializer, %struct.s0 %st2, 0'), 1, 'nested field mk')
    runner.eq(s.contains('%st4 = insertvalue %struct.s1 %sm3_0, i64 %v3, 1'), 1, 'nested second field')

    ; 取嵌套字段：dst 由 cty 决定 ⇒ %st5（不是 %v5）
    runner.eq(s.contains('%st5 = extractvalue %struct.s1 %st4, 0'), 1, 'nested field get struct')
    runner.eq(s.contains('%v6 = extractvalue %struct.s0 %st5, 0'), 1, 'nested field get leaf')
}

test-const-ret = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    ops.push(OP-CONST)
    dsts.push(1)
    xa.push(3)
    bs.push(0)
    syms.push('')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(1)
    bs.push(0)
    syms.push('')
    s = cg-emit-func('three', 0, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @three()'), 1, 'signature')
    runner.eq(s.contains('add i64 0, 3'), 1, 'const 3')
    runner.eq(s.contains('ret i64 %v1'), 1, 'ret v1')
}

; ── func dbl(x) -> x + x ────────────────────────────────
test-arith = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    ops.push(OP-ADD)
    dsts.push(2)
    xa.push(1)
    bs.push(1)
    syms.push('')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(2)
    bs.push(0)
    syms.push('')
    s = cg-emit-func('dbl', 1, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @dbl(i64 %v1)'), 1, 'param sig')
    runner.eq(s.contains('add i64 %v1, %v1'), 1, 'add operands')
    runner.eq(s.contains('ret i64 %v2'), 1, 'ret v2')
}

; ── func caller() -> dbl(2) ─────────────────────────────
test-call = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    ops.push(OP-CONST)
    dsts.push(1)
    xa.push(2)
    bs.push(0)
    syms.push('')
    ops.push(OP-CALL)
    dsts.push(2)
    xa.push(1)
    bs.push(1)
    syms.push('dbl')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(2)
    bs.push(0)
    syms.push('')
    s = cg-emit-func('caller', 0, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @caller()'), 1, 'signature')
    runner.eq(s.contains('call i64 @dbl(i64 %v1)'), 1, 'call dbl')
    runner.eq(s.contains('ret i64 %v2'), 1, 'ret v2')
}

; ── 双参函数 + 双参调用（M4-c 多参 CALL）──────────────────
; add2(a,b) = a+b；caller2() = add2(3,4)
test-call2 = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    ops.push(OP-ADD)
    dsts.push(3)
    xa.push(1)
    bs.push(2)
    syms.push('')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(3)
    bs.push(0)
    syms.push('')
    s = cg-emit-func('add2', 2, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @add2(i64 %v1, i64 %v2)'), 1, 'two params')
    runner.eq(s.contains('add i64 %v1, %v2'), 1, 'add operands')

    ops2 []i64 = []
    dsts2 []i64 = []
    xa2 []i64 = []
    bs2 []i64 = []
    syms2 []str = []
    ops2.push(OP-CONST)
    dsts2.push(1)
    xa2.push(3)
    bs2.push(0)
    syms2.push('')
    ops2.push(OP-CONST)
    dsts2.push(2)
    xa2.push(4)
    bs2.push(0)
    syms2.push('')
    ops2.push(OP-CALL)
    dsts2.push(3)
    xa2.push(1)
    bs2.push(2)
    syms2.push('add2')
    ops2.push(OP-RET)
    dsts2.push(0)
    xa2.push(3)
    bs2.push(0)
    syms2.push('')
    t = cg-emit-func('caller2', 0, ops2, dsts2, xa2, bs2, syms2)
    runner.eq(t.contains('call i64 @add2(i64 %v1, i64 %v2)'), 1, 'two-arg call')
    runner.eq(t.contains('ret i64 %v3'), 1, 'ret v3')
}

; ── func let-add() { x = 3; return x + x } ─────────────
test-let = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    ops.push(OP-ALLOC)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('')
    ops.push(OP-CONST)
    dsts.push(1)
    xa.push(3)
    bs.push(0)
    syms.push('')
    ops.push(OP-STORE)
    dsts.push(0)
    xa.push(1)
    bs.push(1)
    syms.push('')
    ops.push(OP-LOAD)
    dsts.push(2)
    xa.push(1)
    bs.push(0)
    syms.push('')
    ops.push(OP-ADD)
    dsts.push(3)
    xa.push(2)
    bs.push(2)
    syms.push('')
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(3)
    bs.push(0)
    syms.push('')
    s = cg-emit-func('let-add', 0, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('%s1 = alloca i64'), 1, 'alloca slot')
    runner.eq(s.contains('store i64 %v1, i64* %s1'), 1, 'store')
    runner.eq(s.contains('%v2 = load i64, i64* %s1'), 1, 'load')
    runner.eq(s.contains('ret i64 %v3'), 1, 'ret v3')
}

; ── func lt10(x) { x < 10 ? 1 : 2 }（多基本块）──────────
test-cfg = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; k0: CONST v2 = 10
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(2)
    xa.push(10)
    bs.push(0)
    syms.push('')

    ; k1: CMPLT v3 = (v1 < v2)
    blks.push(0)
    ops.push(OP-CMPLT)
    dsts.push(3)
    xa.push(1)
    bs.push(2)
    syms.push('')

    ; k2: CONDBR cond=v3, true=bb1, false=bb2
    blks.push(0)
    ops.push(OP-CONDBR)
    dsts.push(2)
    xa.push(3)
    bs.push(1)
    syms.push('')

    ; k3: bb1: CONST v4 = 1
    blks.push(1)
    ops.push(OP-CONST)
    dsts.push(4)
    xa.push(1)
    bs.push(0)
    syms.push('')

    ; k4: bb1: RET v4
    blks.push(1)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(4)
    bs.push(0)
    syms.push('')

    ; k5: bb2: CONST v5 = 2
    blks.push(2)
    ops.push(OP-CONST)
    dsts.push(5)
    xa.push(2)
    bs.push(0)
    syms.push('')

    ; k6: bb2: RET v5
    blks.push(2)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(5)
    bs.push(0)
    syms.push('')
    s = cg-emit-cfg('lt10', 1, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @lt10(i64 %v1)'), 1, 'sig')
    runner.eq(s.contains('icmp slt i64 %v1, %v2'), 1, 'cmplt')
    runner.eq(s.contains('br i1 %c2, label %bb1, label %bb2'), 1, 'condbr')
    runner.eq(s.contains('bb1:'), 1, 'bb1 label')
    runner.eq(s.contains('bb2:'), 1, 'bb2 label')
    runner.eq(s.contains('ret i64 %v4'), 1, 'then ret')
    runner.eq(s.contains('ret i64 %v5'), 1, 'else ret')
}

; ── func sum4() { s=0; i=0; while i<4 { s+=i; i+=1 }; return s } ──
; 证明 CFG 支持回边（bb2 的 br 跳回 bb1）。
test-loop = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; bb0: alloc s(s1), alloc i(s2), s=0, i=0, br bb1
    blks.push(0)
    ops.push(OP-ALLOC)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-ALLOC)
    dsts.push(2)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(3)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-STORE)
    dsts.push(0)
    xa.push(3)
    bs.push(1)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(4)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-STORE)
    dsts.push(0)
    xa.push(4)
    bs.push(2)
    syms.push('')
    blks.push(0)
    ops.push(OP-BR)
    dsts.push(0)
    xa.push(1)
    bs.push(0)
    syms.push('')

    ; bb1: i<4 ? bb2 : bb3
    blks.push(1)
    ops.push(OP-LOAD)
    dsts.push(5)
    xa.push(2)
    bs.push(0)
    syms.push('')
    blks.push(1)
    ops.push(OP-CONST)
    dsts.push(6)
    xa.push(4)
    bs.push(0)
    syms.push('')
    blks.push(1)
    ops.push(OP-CMPLT)
    dsts.push(7)
    xa.push(5)
    bs.push(6)
    syms.push('')
    blks.push(1)
    ops.push(OP-CONDBR)
    dsts.push(3)
    xa.push(7)
    bs.push(2)
    syms.push('')

    ; bb2: s=s+i; i=i+1; br bb1
    blks.push(2)
    ops.push(OP-LOAD)
    dsts.push(8)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-LOAD)
    dsts.push(9)
    xa.push(2)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-ADD)
    dsts.push(10)
    xa.push(8)
    bs.push(9)
    syms.push('')
    blks.push(2)
    ops.push(OP-STORE)
    dsts.push(0)
    xa.push(10)
    bs.push(1)
    syms.push('')
    blks.push(2)
    ops.push(OP-LOAD)
    dsts.push(11)
    xa.push(2)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-CONST)
    dsts.push(12)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-ADD)
    dsts.push(13)
    xa.push(11)
    bs.push(12)
    syms.push('')
    blks.push(2)
    ops.push(OP-STORE)
    dsts.push(0)
    xa.push(13)
    bs.push(2)
    syms.push('')
    blks.push(2)
    ops.push(OP-BR)
    dsts.push(0)
    xa.push(1)
    bs.push(0)
    syms.push('')

    ; bb3: return s
    blks.push(3)
    ops.push(OP-LOAD)
    dsts.push(14)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(3)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(14)
    bs.push(0)
    syms.push('')
    s = cg-emit-cfg('sum4', 0, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define i64 @sum4()'), 1, 'sig')
    runner.eq(s.contains('br label %bb1'), 1, 'back-edge br')
    runner.eq(s.contains('bb1:'), 1, 'loop head')
    runner.eq(s.contains('bb3:'), 1, 'exit')
    runner.eq(s.contains('ret i64 %v14'), 1, 'ret s')
}

; ── func slen() -> 'abc'.len（首个非 i64 型别：%str-long）──
; 证明：全局字面量 @.s0 + insertvalue 构造 %str-long + extractvalue 取 len。
test-string = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; k0: STRCONST sv1 = 'abc'
    blks.push(0)
    ops.push(OP-STRCONST)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('abc')

    ; k1: STRLEN v2 = sv1.len
    blks.push(0)
    ops.push(OP-STRLEN)
    dsts.push(2)
    xa.push(1)
    bs.push(0)
    syms.push('')

    ; k2: RET v2
    blks.push(0)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(2)
    bs.push(0)
    syms.push('')
    s = cg-emit-cfg('slen', 0, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('@.s.slen.0 = private unnamed_addr constant [4 x i8] c"abc\\00"'), 1, 'global literal')
    runner.eq(s.contains('getelementptr inbounds [4 x i8]'), 1, 'gep')
    runner.eq(s.contains('%q0 = insertvalue %str-long undef, i64 3, 0'), 1, 'len field')
    runner.eq(s.contains('%r0 = insertvalue %str-long %q0, i64 3, 1'), 1, 'cap field')
    runner.eq(s.contains('%sv1 = insertvalue %str-long %r0, i8* %p0, 2'), 1, 'data field')
    runner.eq(s.contains('%v2 = extractvalue %str-long %sv1, 0'), 1, 'strlen')
    runner.eq(s.contains('ret i64 %v2'), 1, 'ret v2')
}

; ── func cat() -> ('ab' + 'cd').len（堆拼接 + RC 头）──────
; 证明：@str_concat 调用形状；结果仍是 %str-long（住在 %sv 命名空间）。
test-strcat = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; k0: STRCONST sv1 = 'ab'
    blks.push(0)
    ops.push(OP-STRCONST)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('ab')

    ; k1: STRCONST sv2 = 'cd'
    blks.push(0)
    ops.push(OP-STRCONST)
    dsts.push(2)
    xa.push(0)
    bs.push(0)
    syms.push('cd')

    ; k2: STRCAT sv3 = sv1 + sv2
    blks.push(0)
    ops.push(OP-STRCAT)
    dsts.push(3)
    xa.push(1)
    bs.push(2)
    syms.push('')

    ; k3: STRLEN v4 = sv3.len
    blks.push(0)
    ops.push(OP-STRLEN)
    dsts.push(4)
    xa.push(3)
    bs.push(0)
    syms.push('')

    ; k4: RET v4
    blks.push(0)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(4)
    bs.push(0)
    syms.push('')
    s = cg-emit-cfg('cat', 0, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('@.s.cat.0 = private unnamed_addr constant [3 x i8] c"ab\\00"'), 1, 'left literal')
    runner.eq(s.contains('@.s.cat.1 = private unnamed_addr constant [3 x i8] c"cd\\00"'), 1, 'right literal')
    runner.eq(s.contains('%sv3 = call %str-long @str_concat(%str-long %sv1, %str-long %sv2)'), 1, 'strcat call')
    runner.eq(s.contains('%v4 = extractvalue %str-long %sv3, 0'), 1, 'len of result')
    runner.eq(s.contains('ret i64 %v4'), 1, 'ret v4')
}

; ── func optstr() -> (some('ab'+'cd') 取出 str).len；option 内联 str 载荷 ──
; 证明 option 的 str 载荷读写（B8，s28）：%str-long 恰 24B，内联进 [3 x i64] 槽，
; 逐字段 extractvalue + data 指针 bitcast 互转（槽是 i64 数组、字段 2 是 i8*，必須 bitcast）；
; 选项取得所有权须紧接 RETAIN（rc=2），scope 退出释放其份额 + 原拥有者份额（rc=0）。
test-option-str = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    ptyps []i64 = []

    ; vty 按值 id 索引：0 占位 / 1=sv1(STR)/2=sv2(STR)/3=sv3(STR,STRCAT)/4=op1(OPT)/5=sv6(STR)/6=v7(I64)
    vty []i64 = []
    vty.push(TY-I64)
    vty.push(TY-STR)
    vty.push(TY-STR)
    vty.push(TY-STR)
    vty.push(TY-OPT)
    vty.push(TY-STR)
    vty.push(TY-I64)
    cty []i64 = []
    cty.push(TY-STR); k0 STRCONST sv1
    cty.push(TY-STR); k1 STRCONST sv2
    cty.push(TY-STR); k2 STRCAT sv3
    cty.push(TY-I64); k3 RETAIN sv3（@str_concat 隐式 rc=1）
    cty.push(TY-OPT); k4 OPTMKSTR op1（src sv3，内联存储，不 retain）
    cty.push(TY-I64); k5 RETAIN sv3（选项取得所有权，rc=2）
    cty.push(TY-STR); k6 OPTGETSTR sv6（src op1，共享 data 指针）
    cty.push(TY-I64); k7 STRLEN v7
    cty.push(TY-I64); k8 RELEASE sv3（选项释放份额，rc=1）
    cty.push(TY-I64); k9 RELEASE sv3（原拥有者释放，rc=0）
    cty.push(TY-I64); k10 RET v7

    ; k0: STRCONST sv1 = 'ab'
    blks.push(0)
    ops.push(OP-STRCONST)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('ab')

    ; k1: STRCONST sv2 = 'cd'
    blks.push(0)
    ops.push(OP-STRCONST)
    dsts.push(2)
    xa.push(0)
    bs.push(0)
    syms.push('cd')

    ; k2: STRCAT sv3 = sv1 + sv2（堆上、rc=1、拥有）
    blks.push(0)
    ops.push(OP-STRCAT)
    dsts.push(3)
    xa.push(1)
    bs.push(2)
    syms.push('')

    ; k3: RETAIN sv3（记录 @str_concat 的隐式 rc=1 拥有）
    blks.push(0)
    ops.push(OP-RETAIN)
    dsts.push(0)
    xa.push(3)
    bs.push(0)
    syms.push('')

    ; k4: OPTMKSTR op1 = some(sv3)（内联存储 %str-long 到 [3 x i64] 槽；本 op 不 retain）
    blks.push(0)
    ops.push(OP-OPTMKSTR)
    dsts.push(4)
    xa.push(3)
    bs.push(0)
    syms.push('')

    ; k5: RETAIN sv3（选项取得所有权份额，rc=2）
    blks.push(0)
    ops.push(OP-RETAIN)
    dsts.push(0)
    xa.push(3)
    bs.push(0)
    syms.push('')

    ; k6: OPTGETSTR sv6 = 从 op1 取出 str（共享同一 data 指针）
    blks.push(0)
    ops.push(OP-OPTGETSTR)
    dsts.push(5)
    xa.push(4)
    bs.push(0)
    syms.push('')

    ; k7: STRLEN v7 = sv6.len = 4
    blks.push(0)
    ops.push(OP-STRLEN)
    dsts.push(6)
    xa.push(5)
    bs.push(0)
    syms.push('')

    ; k8: RELEASE sv3（选项释放其所有权份额，rc=1）
    blks.push(0)
    ops.push(OP-RELEASE)
    dsts.push(0)
    xa.push(3)
    bs.push(0)
    syms.push('')

    ; k9: RELEASE sv3（原拥有者释放，rc=0）
    blks.push(0)
    ops.push(OP-RELEASE)
    dsts.push(0)
    xa.push(3)
    bs.push(0)
    syms.push('')

    ; k10: RET v7
    blks.push(0)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(6)
    bs.push(0)
    syms.push('')
    s = cg-emit-cfg-t('optstr', TY-I64, 0, ptyps, vty, cty, blks, ops, dsts, xa, bs, syms)

    ; OPTMKSTR：tag=0 + 逐字段内联进槽（data 指针须 ptrtoint i8* -> i64；中间步用 %om0/%om1/%om2，末步落到 %op4）
    runner.eq(s.contains('%om04 = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 0, 0'), 1, 'optmkstr tag')
    runner.eq(s.contains('%ol2b4 = ptrtoint i8* %ol24 to i64'), 1, 'optmkstr data ptrtoint to i64')
    runner.eq(s.contains('%op4 = insertvalue %option %om24, i64 %ol2b4, 1, 2'), 1, 'optmkstr store data field')

    ; OPTGETSTR：从槽取字段 + 重建 %str-long（data 指针 inttoptr 回 i8*；末步落到 %sv5）
    runner.eq(s.contains('%ol2b6 = inttoptr i64 %ol26 to i8*'), 1, 'optgetstr data inttoptr to i8*')
    runner.eq(s.contains('%sv5 = insertvalue %str-long %og16, i8* %ol2b6, 2'), 1, 'optgetstr rebuild data field')

    ; RC 平衡：sv3 两次 RETAIN（strcat 隐式 + 选项拥有）对应两次 RELEASE
    ev []i64 = []
    eo []i64 = []
    ev.push(3)
    eo.push(RC-RETAIN)
    ev.push(3)
    eo.push(RC-RETAIN)
    ev.push(3)
    eo.push(RC-RELEASE)
    ev.push(3)
    eo.push(RC-RELEASE)
    bal = cg-rc-check-balance(ev, eo)
    runner.eq(bal.len-bytes(), 0, 'rc balanced (option str payload)')

    ; 选项取得所有权后对 sv3 发了 RELEASE 却无对应 RETAIN（释放多于拥有 ⇒ UAF 方向）⇒ 欠计数，必须报错。
    ; ⚠️ 注意「忘 release 选项的拥有份额」属【过计数＝泄漏】，依 §1.3.1 不被本校验器报；
    ;   此处用真正 UAF 方向（release 无对应 retain）验证逐值账本对 str 载荷场景仍生效。
    ev2 []i64 = []
    eo2 []i64 = []
    ev2.push(3)
    eo2.push(RC-RELEASE)
    bad = cg-rc-check-balance(ev2, eo2)
    runner.eq(bad.len-bytes() > 0, 1, 'rc under-count on option share caught')
    runner.eq(bad.contains('under-count'), 1, 'under-count message')
}

; ── func pick(c) { s='ab'; c ? s='abcdef'; return s.len } ──
; 证明 %str-long 跨基本块（bb1 → bb2）走 alloca/store/load 而非 PHI。
test-str-slot = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; bb0: SALLOC ss1; STRCONST sv1='ab'; SSTORE sv1->ss1; CONDBR v1 -> bb1/bb2
    blks.push(0)
    ops.push(OP-SALLOC)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-STRCONST)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('ab')
    blks.push(0)
    ops.push(OP-SSTORE)
    dsts.push(0)
    xa.push(1)
    bs.push(1)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONDBR)
    dsts.push(2)
    xa.push(1)
    bs.push(1)
    syms.push('')

    ; bb1: STRCONST sv2='abcdef'; SSTORE sv2->ss1; BR bb2
    blks.push(1)
    ops.push(OP-STRCONST)
    dsts.push(2)
    xa.push(0)
    bs.push(0)
    syms.push('abcdef')
    blks.push(1)
    ops.push(OP-SSTORE)
    dsts.push(0)
    xa.push(2)
    bs.push(1)
    syms.push('')
    blks.push(1)
    ops.push(OP-BR)
    dsts.push(0)
    xa.push(2)
    bs.push(0)
    syms.push('')

    ; bb2: SLOAD sv3=ss1; STRLEN v4=sv3.len; RET v4
    blks.push(2)
    ops.push(OP-SLOAD)
    dsts.push(3)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-STRLEN)
    dsts.push(4)
    xa.push(3)
    bs.push(0)
    syms.push('')
    blks.push(2)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(4)
    bs.push(0)
    syms.push('')
    s = cg-emit-cfg('pick', 1, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('%ss1 = alloca %str-long'), 1, 'str slot alloca')
    runner.eq(s.contains('store %str-long %sv1, %str-long* %ss1'), 1, 'sstore')
    runner.eq(s.contains('store %str-long %sv2, %str-long* %ss1'), 1, 'sstore in bb1')
    runner.eq(s.contains('%sv3 = load %str-long, %str-long* %ss1'), 1, 'sload in bb2')
    runner.eq(s.contains('%v4 = extractvalue %str-long %sv3, 0'), 1, 'len of loaded')
    runner.eq(s.contains('br i1 %c3, label %bb1, label %bb2'), 1, 'condbr')
}

; ── func vecsum() { v=[1,2,3]; return v[0]+v[1]+v[2] } ────
; 证明 %vec 值命名空间 %vc 与 push/get/len 的发射形状。
test-vec = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []

    ; k0: VECNEW vc1
    blks.push(0)
    ops.push(OP-VECNEW)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('')

    ; k1..k6: CONST 1/2/3 与三次 push
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(1)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-VECPUSH)
    dsts.push(2)
    xa.push(1)
    bs.push(1)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(2)
    xa.push(2)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-VECPUSH)
    dsts.push(3)
    xa.push(2)
    bs.push(2)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(3)
    xa.push(3)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-VECPUSH)
    dsts.push(4)
    xa.push(3)
    bs.push(3)
    syms.push('')

    ; k7..k9: CONST 0/1/2 作下标
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(4)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(5)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(6)
    xa.push(2)
    bs.push(0)
    syms.push('')

    ; k10..k12: 三次 get
    blks.push(0)
    ops.push(OP-VECGET)
    dsts.push(7)
    xa.push(4)
    bs.push(4)
    syms.push('')
    blks.push(0)
    ops.push(OP-VECGET)
    dsts.push(8)
    xa.push(4)
    bs.push(5)
    syms.push('')
    blks.push(0)
    ops.push(OP-VECGET)
    dsts.push(9)
    xa.push(4)
    bs.push(6)
    syms.push('')

    ; k13..k15: 求和
    blks.push(0)
    ops.push(OP-ADD)
    dsts.push(10)
    xa.push(7)
    bs.push(8)
    syms.push('')
    blks.push(0)
    ops.push(OP-ADD)
    dsts.push(11)
    xa.push(10)
    bs.push(9)
    syms.push('')
    blks.push(0)
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(11)
    bs.push(0)
    syms.push('')
    s = cg-emit-cfg('vecsum', 0, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('%vc1 = call %vec @vec_new()'), 1, 'vec_new')
    runner.eq(s.contains('%vc2 = call %vec @vec_push_i64(%vec %vc1, i64 %v1)'), 1, 'push 1')
    runner.eq(s.contains('%vc4 = call %vec @vec_push_i64(%vec %vc3, i64 %v3)'), 1, 'push 3')
    runner.eq(s.contains('%v7 = call i64 @vec_get_i64(%vec %vc4, i64 %v4)'), 1, 'get 0')
    runner.eq(s.contains('ret i64 %v11'), 1, 'ret sum')
}

; ── func veclen() { v=[9]; return v.len } ──────────────────
test-vec-len = () {
    blks []i64 = []
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    blks.push(0)
    ops.push(OP-VECNEW)
    dsts.push(1)
    xa.push(0)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-CONST)
    dsts.push(1)
    xa.push(9)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-VECPUSH)
    dsts.push(2)
    xa.push(1)
    bs.push(1)
    syms.push('')
    blks.push(0)
    ops.push(OP-VECLEN)
    dsts.push(2)
    xa.push(2)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ops.push(OP-RET)
