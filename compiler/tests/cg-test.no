    runner.eq(s.contains('ret i64 %v2'), 1, 'ret len')
}

; ── 型别签名：str 形参 + str 返回（纯转发）──────────────
test-sig-str = () {
    ops []i64 = []
    dsts []i64 = []
    xa []i64 = []
    bs []i64 = []
    syms []str = []
    blks []i64 = []
    ops.push(OP-RET)
    dsts.push(0)
    xa.push(1)
    bs.push(0)
    syms.push('')
    blks.push(0)
    ty []i64 = []
    ty.push(TY-STR)
    vt []i64 = []
    vt.push(TY-I64)
    vt.push(TY-STR)
    ct []i64 = []
    ct.push(TY-I64)
    s = cg-emit-cfg-t('sident', TY-STR, 1, ty, vt, ct, blks, ops, dsts, xa, bs, syms)
    runner.eq(s.contains('define %str-long @sident(%str-long %sv1)'), 1, 'str sig')
    runner.eq(s.contains('ret %str-long %sv1'), 1, 'str ret')
    runner.eq(s.contains('i64 %v1'), 0, 'no i64 leak')
}

