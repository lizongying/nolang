    runner.eq(s.contains('define %option @pick(i64 %v1)'), 1, 'option sig')
    runner.eq(s.contains('%op4 = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v1, 1, 0'), 1, 'some packs payload')
    runner.eq(s.contains('%op5 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 1, 0'), 1, 'none sets tag 1')
    runner.eq(s.contains('br i1 %c2, label %bb1, label %bb2'), 1, 'branch')
    runner.eq(s.contains('ret %option %op4'), 1, 'ret some')
    runner.eq(s.contains('ret %option %op5'), 1, 'ret none')
