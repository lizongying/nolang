; cg-runtime-test.no — compiler/src/cg-runtime.no + cg-rc.no 的单元测试（M4-a）
;
; 执行： ./bin/no run compiler/tests/cg-runtime-test.no
;
; ⚠️ runner 断言失败【不会】自动改变行程退出码，本档结尾必须自己 exit(1)。
; ⚠️ 讯息一律用单引号字串；nolang 的 "..." 是 char 字面量，不是字串。
;
; 断言取自 Go authority（src/mir/codegen.go emitPrelude / 14712-14818）的实测形状，
; 不是手写猜的。改动 prelude 文本后本档会红——这是刻意的盘点气闩。

# /test/runner.eq
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/cg-runtime
# /compiler/src/cg-rc

; 类型/声明
...
test-runtime-types = () {
    p = cg-runtime-prelude()
    runner.eq(p.contains('%nolang_hdr = type { i64, i64 }'), 1, 'hdr type present')
    runner.eq(p.contains('%task = type'), 1, 'task type present')

    ; B28（2026-11-11 後端變更）：%str-long 是 16B { i32, i32, i8* }，外部 API 仍是 i64。
    runner.eq(p.contains('%str-long = type { i32, i32, i8* }'), 1, 'str type present (16B u32 header)')
    runner.eq(p.contains('%str-long = type { i64, i64, i8* }'), 0, 'no legacy 24B str type')
    runner.eq(p.contains('%vec = type { i32, i32, i64 }'), 1, 'vec type present (16B u32 header)')
    runner.eq(p.contains('%vec = type { i64, i64, i64 }'), 0, 'no legacy 24B vec type')

    ; ⚠️ option 的 24B inline payload 槽【未變】（Go optSlotDefaultBytes = 24）；
    ;    16B 的 %vec / %str-long 都裝得下，只是不再是 [3 x i64] 的 1:1 對應。
    runner.eq(p.contains('%option = type { i64, [3 x i64] }'), 1, 'option type present (24B slot unchanged)')

    ; 结构体型别**不在** prelude：由 cg-runtime-struct-decls(sfc) 按描述符唯一发射
    ; （具名型别模块内唯一，§11 B10 ⇒ 各函式不得自发型别）。
    runner.eq(p.contains('%struct.'), 0, 'struct types not in prelude')
    sfc []i64 = []
    sfc.push(2)
    sfc.push(3)
    sfc.push(0)

    ; sft = 各结构体字段型别码的拼接（按 id 升序）：s0 = {i64, i64}，s1 = {str, i64, i64}
    sft []i64 = []
    sft.push(TY-I64)
    sft.push(TY-I64)
    sft.push(TY-STR)
    sft.push(TY-I64)
    sft.push(TY-I64)
    d = cg-runtime-struct-decls(sfc, sft)
    runner.eq(d.contains('%struct.s0 = type { i64, i64 }'), 1, 'struct 0 decl')
    runner.eq(d.contains('%struct.s1 = type { %str-long, i64, i64 }'), 1, 'struct 1 decl (str field)')
    runner.eq(d.contains('%struct.s2'), 0, 'unused struct skipped')
    runner.eq(p.contains('@malloc'), 1, 'malloc decl present')
    runner.eq(p.contains('@free'), 1, 'free decl present')
    runner.eq(p.contains('@write'), 1, 'write decl present')
}

; RC helper IR 文本
...
test-rc-ir = () {
    a = cg-rc-alloc()
    runner.eq(a.contains('@nolang_rc_alloc'), 1, 'alloc define')
    runner.eq(a.contains('7957698232306827265'), 1, 'alloc writes magic decimal')
    t = cg-rc-retain()
    runner.eq(t.contains('@nolang_rc_retain'), 1, 'retain define')
    runner.eq(t.contains('7957698232306827265'), 1, 'retain checks magic')
    d = cg-rc-release()
    runner.eq(d.contains('@nolang_rc_release'), 1, 'release define')
    f = cg-rc-nolang-free()
    runner.eq(f.contains('@nolang_free'), 1, 'free define')
    runner.eq(cg-rc-hdr-size(), 16, 'hdr size')
    runner.eq(cg-rc-hdr-magic(), 7957698232306827265, 'hdr magic')
}

; check-rc-balance：平衡通过
...
test-balance-pass = () {
    vids []i64 = []
    ops []i64 = []
    vids.push(1)
    ops.push(0)
    vids.push(1)
    ops.push(1)
    e = cg-rc-check-balance(vids, ops)
    runner.eq(e.len-bytes(), 0, 'balanced passes')
}

; check-rc-balance：欠计数（release 多于 retain）⇒ 报错
...
test-balance-under = () {
    vids []i64 = []
    ops []i64 = []
    vids.push(2)
    ops.push(1)
    e = cg-rc-check-balance(vids, ops)
    runner.eq(e.len-bytes() > 0, 1, 'under-count fails')
    runner.eq(e.contains('under-count'), 1, 'under-count message')
}

; check-rc-balance：过计数是接受的泄漏，不报错
...
test-balance-over-ok = () {
    vids []i64 = []
    ops []i64 = []
    vids.push(3)
    ops.push(0)
    vids.push(3)
    ops.push(0)
    vids.push(3)
    ops.push(1)
    e = cg-rc-check-balance(vids, ops)
    runner.eq(e.len-bytes(), 0, 'over-count allowed')
}

; prelude-full：完整 prelude 的组成与顺序
...

; @str_concat 调 @nolang_rc_alloc ⇒ 顺序必须是 RC 在前。
test-prelude-full = () {
    p = cg-runtime-prelude-full()
    runner.eq(p.contains('declare void @llvm.memcpy.p0i8.p0i8.i64'), 1, 'memcpy decl')
    runner.eq(p.contains('define i8* @nolang_rc_alloc'), 1, 'rc_alloc present')
    runner.eq(p.contains('define %str-long @str_concat'), 1, 'str_concat present')
    ia = p.index('define i8* @nolang_rc_alloc')
    ic = p.index('define %str-long @str_concat')
    runner.eq(ia >= 0, 1, 'rc_alloc found')
    runner.eq(ic > ia, 1, 'rc_alloc before str_concat')

    ; s39：除零报告所需三符号均需落在完整 prelude（与 Go emitPrelude/divZeroReport 对齐）
    runner.eq(p.contains('declare i64 @write(i32, i8*, i64)'), 1, 'write decl')
    runner.eq(p.contains('@nolang_msg_div_zero = private unnamed_addr constant'), 1, 'div-zero msg global')
    runner.eq(p.contains('define void @__nolang_div_zero_report(i1 %bad)'), 1, 'div-zero report helper')

    ; s42：str 相等所需两符号（@str_eq 定义 + libc @memcmp 声明）均需落在完整 prelude
    runner.eq(p.contains('declare i32 @memcmp(i8*, i8*, i64)'), 1, 'memcmp decl')
    runner.eq(p.contains('define i1 @str_eq(%str-long %a, %str-long %b)'), 1, 'str_eq present')
    runner.eq(p.contains('define i1 @__nolang_vec_eq_i64(%vec %a, %vec %b)'), 1, 'vec_eq present')
}

; str 相等 helper IR 文本（s42；B28 後為 u32 header）
...

; 逐字对照 Go @str_eq：len 欄先 extractvalue 到 i32、zext 回 i64 → icmp → memcmp → phi。
; 2 空格缩进。
test-str-eq-helper = () {
    e = cg-runtime-str-eq()
    runner.eq(e.contains('define i1 @str_eq(%str-long %a, %str-long %b)'), 1, 'str_eq signature')
    runner.eq(e.contains('%la.i32 = extractvalue %str-long %a, 0'), 1, 'len a field 0 (i32)')
    runner.eq(e.contains('%la = zext i32 %la.i32 to i64'), 1, 'len a widened to i64')
    runner.eq(e.contains('%lb.i32 = extractvalue %str-long %b, 0'), 1, 'len b field 0 (i32)')
    runner.eq(e.contains('%lb = zext i32 %lb.i32 to i64'), 1, 'len b widened to i64')
    runner.eq(e.contains('%da = extractvalue %str-long %a, 2'), 1, 'data a field 2')
    runner.eq(e.contains('%cmp = call i32 @memcmp(i8* %da, i8* %db, i64 %la)'), 1, 'memcmp on len')
    runner.eq(e.contains('%res = phi i1 [ 0, %noteq ], [ %same, %cmpto ]'), 1, 'result phi')
    m = cg-runtime-memcmp-decl()
    runner.eq(m.contains('declare i32 @memcmp(i8*, i8*, i64)'), 1, 'memcmp decl helper')

    ; 绝不对 %str-long 本体发 icmp（非法）：str_eq 体内只比 zext 後的 i64 len 与 memcmp
    runner.eq(e.contains('icmp %str-long'), 0, 'no icmp on struct')

    ; B28：u32 欄不可直接當 i64 用 ⇒ 不得殘留舊的 i64 extractvalue
    runner.eq(e.contains('%la = extractvalue %str-long %a, 0'), 0, 'no legacy i64 len extract')
}

; B28：%str-long 16B 佈局氣闩（對齊 Go emitPrelude）
...

; 目標：型別宣告、@str_eq 的 zext、@str_concat 的 trunc + i32 聚合常數，
;       以及「24B 殘片完全消失」四件事一次釘住。%option slot / %vec 不得被改動。
test-str16-layout = () {
    f = cg-runtime-prelude-full()
    c = cg-runtime-str-concat()

    ; 型別：%str-long 與 %vec 都是 16B { u32, u32, ... }；24B option slot 維持原樣
    runner.eq(f.contains('%str-long = type { i32, i32, i8* }'), 1, 'B28 str type is 16B')
    runner.eq(f.contains('%option = type { i64, [3 x i64] }'), 1, 'B28 option slot still 24B')
    runner.eq(f.contains('%vec = type { i32, i32, i64 }'), 1, 'B28b vec is 16B')

    ; @str_eq：len 讀出後 zext i32→i64
    runner.eq(f.contains('%la = zext i32 %la.i32 to i64'), 1, 'B28 str_eq widens len')
    runner.eq(f.contains('%lenEq = icmp eq i64 %la, %lb'), 1, 'B28 str_eq compares i64 len')

    ; @str_concat：讀出 zext、寫回 trunc、聚合常數改 i32
    runner.eq(c.contains('%la = zext i32 %la.i32 to i64'), 1, 'B28 concat widens len a')
    runner.eq(c.contains('%lb = zext i32 %lb.i32 to i64'), 1, 'B28 concat widens len b')
    runner.eq(c.contains('%r0.i32 = trunc i64 %total to i32'), 1, 'B28 concat truncs total')
    runner.eq(c.contains('%r0 = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %r0.i32, 0'), 1, 'B28 concat i32 len field')
    runner.eq(c.contains('%r1 = insertvalue %str-long %r0, i32 %r1.i32, 1'), 1, 'B28 concat i32 cap field')

    ; 負向氣闩：完整 prelude 內不得殘留任何 24B str 描述子寫法
    runner.eq(f.contains('{ i64 0, i64 0, i8* null }'), 0, 'B28 no 24B aggregate const left')
    runner.eq(f.contains('insertvalue %str-long undef, i64'), 0, 'B28 no i64 literal insert left')
    runner.eq(f.contains('%r0 = insertvalue %str-long { i64 0, i64 0, i8* null }, i64 %total, 0'), 0, 'B28 no legacy concat len insert')
}

; s43：@__nolang_vec_eq_i64 helper 形状断言（镜像 Go vecDeepEq 的 i64 分支）
test-vec-eq-helper = () {
    e = cg-runtime-vec-eq()
    runner.eq(e.contains('define i1 @__nolang_vec_eq_i64(%vec %a, %vec %b)'), 1, 'vec_eq signature')
    runner.eq(e.contains('%la32 = extractvalue %vec %a, 0'), 1, 'len a field 0 (u32)')
    runner.eq(e.contains('%la = zext i32 %la32 to i64'), 1, 'len a widened to i64')
    runner.eq(e.contains('%leneq = icmp eq i64 %la, %lb'), 1, 'len eq branch')
    runner.eq(e.contains('%pa = inttoptr i64 %da to i8*'), 1, 'data a inttoptr')
    runner.eq(e.contains('%bytes = mul i64 %la, 8'), 1, 'bytes = len*8')
    runner.eq(e.contains('%mr = call i32 @memcmp(i8* %pa, i8* %pb, i64 %bytes)'), 1, 'memcmp on bytes')
    runner.eq(e.contains('%same = icmp eq i32 %mr, 0'), 1, 'same = memcmp==0')
    runner.eq(e.contains('ret i1 false'), 1, 'no-path ret false')

    ; 绝不对 %vec 本体发 icmp（非法）：vec_eq 体内只比 i64 len 与 memcmp
    runner.eq(e.contains('icmp %vec'), 0, 'no icmp on vec')
}

; 向量 helper IR 文本
...
test-vec-helpers = () {
    p = cg-runtime-prelude()
    runner.eq(p.contains('%vec = type { i32, i32, i64 }'), 1, 'vec type')
    n = cg-runtime-vec-new()
    runner.eq(n.contains('define %vec @vec_new()'), 1, 'vec_new')
    l = cg-runtime-vec-len()
    runner.eq(l.contains('define i64 @vec_len(%vec %v)'), 1, 'vec_len')
    g = cg-runtime-vec-get()
    runner.eq(g.contains('define i64 @vec_get_i64(%vec %v, i64 %i)'), 1, 'vec_get')
    u = cg-runtime-vec-push()
    runner.eq(u.contains('define %vec @vec_push_i64(%vec %v, i64 %x)'), 1, 'vec_push')
    runner.eq(u.contains('phi i64 [ %cap, %entry ], [ %ncap, %grow ], [ %ncap, %copy ]'), 1, 'push cap phi')
    runner.eq(u.contains('br i1 %empty, label %store, label %copy'), 1, 'push skips memcpy when empty')
    runner.eq(u.contains('call void @free(i8* %old)'), 1, 'push frees old buffer')

    ; s99n：vec 释放 helper——缓冲无 RC 头（§11 B5）⇒ 一次性 free，dat==0 短路
    q = cg-runtime-vec-free()
    runner.eq(q.contains('define void @vec_free(%vec %v)'), 1, 'vec_free signature')
    runner.eq(q.contains('%dat = extractvalue %vec %v, 2'), 1, 'vec_free reads dat')
    runner.eq(q.contains('br i1 %nul, label %done, label %freeme'), 1, 'vec_free short-circuits null dat')
    runner.eq(q.contains('call void @free(i8* %p)'), 1, 'vec_free frees buffer')
    runner.eq(q.contains('@nolang_rc_release'), 0, 'vec_free is not RC release')
    f = cg-runtime-prelude-full()
    runner.eq(f.contains('define %vec @vec_push_i64'), 1, 'full has vec_push')
    runner.eq(f.contains('define void @vec_free(%vec %v)'), 1, 'full has vec_free')
}

; 切片 B 底座：str-vec 助手 IR 文本（元素 %str-long 16B，所有权 clone/release）
...
test-strvec-helpers = () {

    ; push：元素 clone 成独立 rc 塊（字面量无 rc 頭亦可持有）；stride 16；扩容只 free 舊陣列緩衝
    ps = cg-runtime-vec-push-str()
    runner.eq(ps.contains('define %vec @vec_push_str(%vec %v, %str-long %x)'), 1, 'push_str sig')
    runner.eq(ps.contains('%nb = mul i64 %ncap, 16'), 1, 'push_str stride 16')
    runner.eq(ps.contains('call i8* @nolang_rc_alloc(i64 %xl64)'), 1, 'push_str clones element into rc block')
    runner.eq(ps.contains('call void @llvm.memcpy.p0i8.p0i8.i64(i8* %nbuf, i8* %xd'), 1, 'push_str copies element bytes')
    runner.eq(ps.contains('call void @free(i8* %old)'), 1, 'push_str frees old array buffer')
    runner.eq(ps.contains('%cap2 = phi i64 [ %cap, %entry ], [ %ncap, %grow ], [ %ncap, %copy ]'), 1, 'push_str cap phi')

    ; get：借用視圖，stride 16
    gs = cg-runtime-vec-get-str()
    runner.eq(gs.contains('define %str-long @vec_get_str(%vec %v, i64 %i)'), 1, 'get_str sig')
    runner.eq(gs.contains('%off = mul i64 %i, 16'), 1, 'get_str stride 16')
    runner.eq(gs.contains('load %str-long, %str-long* %sp'), 1, 'get_str loads str-long')

    ; free：逐元素 release data + free 陣列緩衝，dat==0 短路
    fs = cg-runtime-vec-free-str()
    runner.eq(fs.contains('define void @vec_free_str(%vec %v)'), 1, 'free_str sig')
    runner.eq(fs.contains('call void @nolang_rc_release(i8* %ed)'), 1, 'free_str releases each element')
    runner.eq(fs.contains('%off = mul i64 %i, 16'), 1, 'free_str stride 16')
    runner.eq(fs.contains('call void @free(i8* %p)'), 1, 'free_str frees array buffer')
    runner.eq(fs.contains('br i1 %nul, label %done, label %init'), 1, 'free_str short-circuits null dat')

    ; prelude-full 已含三助手
    pf = cg-runtime-prelude-full()
    runner.eq(pf.contains('define %vec @vec_push_str'), 1, 'full has vec_push_str')
    runner.eq(pf.contains('define %str-long @vec_get_str'), 1, 'full has vec_get_str')
    runner.eq(pf.contains('define void @vec_free_str'), 1, 'full has vec_free_str')
}

; 切片 B 第三层：with-cap 容量预留助手（cap 有真实语义，不可当空 vec）
...
test-withcap-helpers = () {
    ci = cg-runtime-vec-new-cap-i64()
    runner.eq(ci.contains('define %vec @vec_new_cap_i64(i64 %cap)'), 1, 'cap_i64 sig')
    runner.eq(ci.contains('%nb = mul i64 %cap, 8'), 1, 'cap_i64 stride 8')
    runner.eq(ci.contains('%c32 = trunc i64 %cap to i32'), 1, 'cap_i64 writes cap field')
    runner.eq(ci.contains('ret %vec { i32 0, i32 0, i64 0 }'), 1, 'cap_i64 zero short-circuit')
    runner.eq(ci.contains('call i8* @malloc(i64 %nb)'), 1, 'cap_i64 malloc')

    cs = cg-runtime-vec-new-cap-str()
    runner.eq(cs.contains('define %vec @vec_new_cap_str(i64 %cap)'), 1, 'cap_str sig')
    runner.eq(cs.contains('%nb = mul i64 %cap, 16'), 1, 'cap_str stride 16')
    runner.eq(cs.contains('call void @llvm.memset.p0i8.i64'), 1, 'cap_str zeroes slots')
    runner.eq(cs.contains('%c32 = trunc i64 %cap to i32'), 1, 'cap_str writes cap field')

    pf = cg-runtime-prelude-full()
    runner.eq(pf.contains('define %vec @vec_new_cap_i64'), 1, 'full has cap_i64')
    runner.eq(pf.contains('define %vec @vec_new_cap_str'), 1, 'full has cap_str')
}

; s158：str 子串【值方法】四件套的 IR 文本（starts-with / ends-with / contains / index）
;   逐字鏡像 src/std/str.no：find-byte-from(:230) / starts-with(:460) / ends-with(:481) /
;   contains(:450) / index(:420)。全部【純計算、不分配、無 RC】。
;   ⚠️ B28：len 欄 u32 ⇒ 一律 zext i32→i64 後才做 icmp / gep 偏移。
...
test-str-substr-helpers = () {
    fb = cg-runtime-str-find-byte()
    runner.eq(fb.contains('define i64 @str_find_byte(%str-long %a, %str-long %b)'), 1, 'find_byte sig')
    runner.eq(fb.contains('%m0 = icmp eq i64 %lb, 0'), 1, 'find_byte empty-target test')
    runner.eq(fb.contains('ret i64 0'), 1, 'find_byte empty target returns 0')
    runner.eq(fb.contains('%nge = icmp sge i64 %la, %lb'), 1, 'find_byte n<m guard')
    runner.eq(fb.contains('ret i64 -1'), 1, 'find_byte no-match returns -1')
    runner.eq(fb.contains('%limit = sub i64 %la, %lb'), 1, 'find_byte window = n-m')
    runner.eq(fb.contains('%go = icmp sle i64 %i, %limit'), 1, 'find_byte scans [0, n-m]')
    runner.eq(fb.contains('%eq = icmp eq i8 %ba, %bb'), 1, 'find_byte byte compare')

    sw = cg-runtime-str-startswith()
    runner.eq(sw.contains('define i1 @str_starts_with(%str-long %a, %str-long %b)'), 1, 'starts_with sig')
    runner.eq(sw.contains('%le = icmp sle i64 %lb, %la'), 1, 'starts_with len guard')
    runner.eq(sw.contains('ret i1 false'), 1, 'starts_with too-long false')
    runner.eq(sw.contains('ret i1 true'), 1, 'starts_with all-match true')

    ew = cg-runtime-str-endswith()
    runner.eq(ew.contains('define i1 @str_ends_with(%str-long %a, %str-long %b)'), 1, 'ends_with sig')
    runner.eq(ew.contains('%off = sub i64 %la, %lb'), 1, 'ends_with offset = la-lb')
    runner.eq(ew.contains('%idx = add i64 %off, %i'), 1, 'ends_with index = off+i')
    runner.eq(ew.contains('ret i1 true'), 1, 'ends_with all-match true')

    ct = cg-runtime-str-contains()
    runner.eq(ct.contains('define i1 @str_contains(%str-long %a, %str-long %b)'), 1, 'contains sig')
    runner.eq(ct.contains('%p = call i64 @str_find_byte(%str-long %a, %str-long %b)'), 1, 'contains delegates to find_byte')
    runner.eq(ct.contains('%r = icmp sge i64 %p, 0'), 1, 'contains = index >= 0')

    ix = cg-runtime-str-index()
    runner.eq(ix.contains('define i64 @str_index(%str-long %a, %str-long %b)'), 1, 'index sig')
    runner.eq(ix.contains('%p = call i64 @str_find_byte(%str-long %a, %str-long %b)'), 1, 'index delegates to find_byte')
    runner.eq(ix.contains('ret i64 -1'), 1, 'index miss returns -1')
    runner.eq(ix.contains('%lo = icmp slt i64 %bw, 128'), 1, 'index lead-byte low test')
    runner.eq(ix.contains('%hi = icmp eq i64 %and, 192'), 1, 'index lead-byte high test')
    runner.eq(ix.contains('%nnext = select i1 %inc, i64 %nadd, i64 %n'), 1, 'index conditional count')

    ; prelude-full 已含五助手；@str_find_byte 必須排在 @str_contains / @str_index 之前
    pf = cg-runtime-prelude-full()
    runner.eq(pf.contains('define i64 @str_find_byte'), 1, 'full has find_byte')
    runner.eq(pf.contains('define i1 @str_starts_with'), 1, 'full has starts_with')
    runner.eq(pf.contains('define i1 @str_ends_with'), 1, 'full has ends_with')
    runner.eq(pf.contains('define i1 @str_contains'), 1, 'full has contains')
    runner.eq(pf.contains('define i64 @str_index'), 1, 'full has index')
    i1 = pf.index('define i64 @str_find_byte')
    i2 = pf.index('define i1 @str_contains')
    i3 = pf.index('define i64 @str_index')
    runner.eq(i1 >= 0, 1, 'find_byte found')
    runner.eq(i2 > i1, 1, 'find_byte before contains')
    runner.eq(i3 > i1, 1, 'find_byte before index')
}

; s159：@str_to_bytes —— str.to-bytes() 的 O(N) 複製助手（i64 寬槽、自有緩衝）。
;   語義逐字鏡像 src/std/str.no:694。⚠️ []byte 元素在 noc 運行期是 i64 寬槽（stride 8）。
;   🔴 命名紀律：s158 收尾時 @str_index 曾因【形參 %b 與 load 暫存器 %b 同名】被 clang 拒收
;      （模組驗證要求同一函式內區域值名唯一）⇒ 本測試釘住「不得再與形參同名」。
...
test-strtobytes-helper = () {
    tb = cg-runtime-str-to-bytes()
    runner.eq(tb.contains('define %vec @str_to_bytes(%str-long %a)'), 1, 'to_bytes sig')
    runner.eq(tb.contains('%z = icmp eq i64 %la, 0'), 1, 'to_bytes empty test')
    runner.eq(tb.contains('ret %vec { i32 0, i32 0, i64 0 }'), 1, 'to_bytes empty short-circuit')
    runner.eq(tb.contains('%nb = mul i64 %la, 8'), 1, 'to_bytes alloc n*8 slots')
    runner.eq(tb.contains('%off = mul i64 %i, 8'), 1, 'to_bytes stride 8 per element')
    runner.eq(tb.contains('%bi = load i8, i8* %sp'), 1, 'to_bytes loads source byte')
    runner.eq(tb.contains('%bw = zext i8 %bi to i64'), 1, 'to_bytes widens byte to i64 slot')
    runner.eq(tb.contains('%dpp = bitcast i8* %dp to i64*'), 1, 'to_bytes casts slot ptr')
    runner.eq(tb.contains('store i64 %bw, i64* %dpp'), 1, 'to_bytes stores into slot')
    runner.eq(tb.contains('%c32 = trunc i64 %la to i32'), 1, 'to_bytes writes u32 len/cap')
    runner.eq(tb.contains('%v1 = insertvalue %vec %v0, i32 %c32, 1'), 1, 'to_bytes cap = len')

    ; 🔴 命名碰撞哨兵：除形參 %a 自身外，不得再定義同名區域值（%a／%b 皆然）。
    ;    （s158 的教訓——文字斷言全綠但模組組不起來。）
    runner.eq(tb.contains('%a = '), 0, 'to_bytes has no local %a collision')
    runner.eq(tb.contains('%b = '), 0, 'to_bytes has no local %b collision')

    pf = cg-runtime-prelude-full()
    runner.eq(pf.contains('define %vec @str_to_bytes'), 1, 'full has to_bytes')
    j1 = pf.index('define i64 @str_index')
    j2 = pf.index('define %vec @str_to_bytes')
    runner.eq(j1 >= 0, 1, 'index found')
    runner.eq(j2 > j1, 1, 'to_bytes registered after index')
}

; s160：@str_slice_bytes —— str.slice-bytes(start,end) 的子串副本助手（新配置、走 rc_alloc）。
;   語意逐字鏡像 src/std/str.no:642：鉗制後 n=end-start，逐元 1:1 複製。
;   ⚠️ 与 s159 @str_to_bytes 的差別：本 helper 走 @nolang_rc_alloc（rc=1 自有），
;      且回 %str-long（不是 %vec）⇒ h2m 側登記 OP-RELEASE 而非 OP-VEC-FREE。
;   🔴 命名紀律：區域值名不得與形參 %a／%s／%e 同名（s158 教訓：clang 要求函式內唯一）。
test-strsliceb-helper = () {
    tb = cg-runtime-str-slice-bytes()
    runner.eq(tb.contains('define %str-long @str_slice_bytes(%str-long %a, i64 %s, i64 %e)'), 1, 'slice_b sig')
    runner.eq(tb.contains('%la.i32 = extractvalue %str-long %a, 0'), 1, 'slice_b reads u32 len field')
    runner.eq(tb.contains('%la = zext i32 %la.i32 to i64'), 1, 'slice_b widens len to i64')
    runner.eq(tb.contains('%da = extractvalue %str-long %a, 2'), 1, 'slice_b reads data ptr')
    ; 鉗制：start<0 ⇒ 0；end>len ⇒ len（select，不寫分支）
    runner.eq(tb.contains('%sneg = icmp slt i64 %s, 0'), 1, 'slice_b start<0 test')
    runner.eq(tb.contains('%s0 = select i1 %sneg, i64 0, i64 %s'), 1, 'slice_b clamps start')
    runner.eq(tb.contains('%egt = icmp sgt i64 %e, %la'), 1, 'slice_b end>len test')
    runner.eq(tb.contains('%e0 = select i1 %egt, i64 %la, i64 %e'), 1, 'slice_b clamps end')
    ; start>=end ⇒ 空：以 n<0 ⇒ 0 的 select 收斂（仍給 rc_alloc(0) 非空緩衝，無獨立空支路）
    runner.eq(tb.contains('%nraw = sub i64 %e0, %s0'), 1, 'slice_b n = end - start')
    runner.eq(tb.contains('%nneg = icmp slt i64 %nraw, 0'), 1, 'slice_b negative n test')
    runner.eq(tb.contains('%n = select i1 %nneg, i64 0, i64 %nraw'), 1, 'slice_b n clamped to 0')
    ; 自有緩衝：走 rc_alloc（非裸 malloc），故Result 要讓 h2m 發 OP-RELEASE
    runner.eq(tb.contains('%buf = call i8* @nolang_rc_alloc(i64 %n)'), 1, 'slice_b allocates via rc_alloc')
    ; 逐元 1:1 複製（不加寬：str 緩衝是 i8 元素）
    runner.eq(tb.contains('%sp = getelementptr i8, i8* %da, i64 %src'), 1, 'slice_b src ptr at start+i')
    runner.eq(tb.contains('%by = load i8, i8* %sp'), 1, 'slice_b loads one byte')
    runner.eq(tb.contains('store i8 %by, i8* %dp'), 1, 'slice_b stores one byte 1:1')
    runner.eq(tb.contains('%i = phi i64 [ 0, %entry ], [ %inext, %body ]'), 1, 'slice_b copy loop phi')
    ; 結果：{len=n, cap=n, data=buf}
    runner.eq(tb.contains('%l0.i32 = trunc i64 %n to i32'), 1, 'slice_b writes u32 len')
    runner.eq(tb.contains('%r1 = insertvalue %str-long %r0, i32 %l0.i32, 1'), 1, 'slice_b cap = len')
    runner.eq(tb.contains('%r2 = insertvalue %str-long %r1, i8* %buf, 2'), 1, 'slice_b data = buf')

    ; 🔴 命名碰撞哨兵：不得與形參同名（%a／%s／%e 皆然）
    runner.eq(tb.contains('%a = '), 0, 'slice_b has no local %a collision')
    runner.eq(tb.contains('%s = '), 0, 'slice_b has no local %s collision')
    runner.eq(tb.contains('%e = '), 0, 'slice_b has no local %e collision')

    pf = cg-runtime-prelude-full()
    runner.eq(pf.contains('define %str-long @str_slice_bytes'), 1, 'full has slice_b')
    j1 = pf.index('define %vec @str_to_bytes')
    j2 = pf.index('define %str-long @str_slice_bytes')
    runner.eq(j1 >= 0, 1, 'to_bytes found')
    runner.eq(j2 > j1, 1, 'slice_b registered after to_bytes')
}

test-runtime-types()
test-rc-ir()
test-balance-pass()
test-balance-under()
test-balance-over-ok()
test-prelude-full()
test-str-eq-helper()
test-str16-layout()
test-vec-eq-helper()
test-vec-helpers()
test-strvec-helpers()
test-withcap-helpers()
test-str-substr-helpers()
test-strtobytes-helper()
test-strsliceb-helper()

runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
