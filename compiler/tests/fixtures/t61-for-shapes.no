; s57 fixture：for 族語法——range-for 匿名切片字面量源 + 計數循環雙形
;   覆蓋：`[a, b]`/`[a]` 切片源（vs `[a..b]` range 源）、`N * { }` 前置計數循環、
;   `{ } * N` 後置計數循環（含負計數）、標籤形 `#1 N * { }`。
;   本體保持極簡（單一 print），避免疊加其他 lowering 桶。

; 1) 匿名切片字面量源（逗號形 / 單元素形）
i <- [1, 2, 3]: {
    print(i)
}
j <- [7]: {
    print(j)
}

; 2) range 源（對照組：`..` 分類仍走 RangeExpression）
k <- [1..4): {
    print(k)
}

; 3) 前置計數循環 `N * { }`
n = 0
3 * {
    print(n)
}

; 4) 後置計數循環 `{ } * N` 與負計數 `{ } * -M`（≤0 不執行）
2 * {
    print(n)
}
-1 * {
    print(n)
}

; 5) 標籤 + 前置計數循環 `#1 N * { }`
#1 2 * {
    print(n)
}
