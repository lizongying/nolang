worker {
    i i64
    flag bool
}

worker.loops = () {
    .i = 0

    ; `!! { }` 恆真無限循環
    !! {
        .i = 1
    }

    ; `! { }` 恆假、不執行
    ! {
        .i = 0
    }

    ; `(expr) { }` 前置條件循環
    (.i < 3) {
        .i = 1
    }

    ; `() { }` 空括號 ⇒ 恆假、不執行
    () {
        .i = 0
    }

    ; `(flag) { }` 單 IDENT 條件（非參數列）
    (.flag) {
        .i = 1
    }
}
