box {
    n i64
}

; 無值明示型別裸宣告（NamedType / SliceType / ArrayType）—— 對齊 oracle 的
;   LetStatement{name: X, type: T, value: }（Value 缺席以 0 佔位）。
box.f = () {
    result []byte
    z [16]byte
    items []str
    x box
    i8 i8

    ; 對照：含值宣告仍走既有含值臂（`a []i64 = [...]` → SliceLiteral 值）。
    a []i64 = [1, 2, 3]
    x.n = a.len()
}
