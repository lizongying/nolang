; ps-err-test.no — compiler/src/ps 語法錯誤收集器（s10/M3-c 首族）的 L0 測試
;
; 執行： ./bin/no run compiler/tests/ps-err-test.no
;
; ⚠️ 測試 runner 的斷言失敗【不會】自動改變行程退出碼，本檔結尾必須自己
;    exit(1)，否則差分 harness 會把失敗讀成通過。
; ⚠️ 訊息一律用單引號字串。nolang 的 "..." 是【char 字面量】，不是字串。
;
; ── 這些期望字串從哪來 ────────────────────────────────────────────
; 全部由 L3 oracle 實測釘死（`./bin/no vet <檔>`），**不是**手寫猜的：
;   'x = foo(1 2)'  ⇒ 1:11 expected comma or right parenthesis, got INT instead
;   'y =\n'         ⇒ 2:1  expected expression, got nil instead
;   'x = (1 + 2\n'  ⇒ 2:0  expected right parenthesis, got NEWLINE instead
;                     （s11 游標對齊後與 oracle 逐字元全等；舊 s10 釘的是 noc
;                     現況 2:1 EOF，坐標族缺口已清）
;   'x = foo(1\n2)' ⇒ 2:1  expected comma or right parenthesis, got INT instead
;                     （s11：Go 實參循環 arg 後只跳 NEWLINE 再分派 ⇒ 報錯落在
;                     換行後首個非換行 token，oracle 錨點 p14）
;   ⚠️ s12 起括號/逗號報錯【不再抑制】同位級聯第二条「expected expression, got
;   nil instead」——Go 的抑制閘門只數 ILLEGAL 詞法錯（stmt.go:1308 reportedIllegal），
;   分組/實參錯後表達式以 nil 落進 let 站點照報（探針 p12/p14/p60-p64 釘死）。
;   僅 let 形級聯；表達式語句（如 print(…)）不級聯（探針 p62）。
;
; ⚠️ 本檔只測【收集器】（ps.eLn/eCl/eMsg/eCode + ps-err-count）；
;    渲染行形已由 diag-test.no 釘死，端到端 CLI 契約由 L3 差分覆蓋。

# /test/runner.eq
# /test/runner.str-eq
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok
# /compiler/src/ps

; ═══════════════════════════════════════════════
; helper：parse 一段源碼，回傳收集器（呼叫端負責讀欄位）
; ═══════════════════════════════════════════════

parse-err = (src str) (p psst) {
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)
    _ = root
}

; ═══════════════════════════════════════════════
; 1. 實參缺逗號：'x = foo(1 2)' ⇒ 恰 2 條（s12：逗號錯 + 同位級聯 nil 錯）
; ═══════════════════════════════════════════════

test-call-missing-comma = () {
    p = parse-err('x = foo(1 2)')
    runner.eq(ps-err-count(p), 2, 'call-comma count')
    runner.eq(p.eLn[0], 1, 'call-comma line')
    runner.eq(p.eCl[0], 11, 'call-comma col')
    runner.str-eq(p.eMsg[0], 'expected comma or right parenthesis, got INT instead', 52, 'call-comma msg')
    runner.str-eq(p.eCode[0], 'E_GENERAL', 9, 'call-comma code')
    runner.eq(p.eLn[1], 1, 'call-comma cascade line')
    runner.eq(p.eCl[1], 11, 'call-comma cascade col')
    runner.str-eq(p.eMsg[1], 'expected expression, got nil instead', 36, 'call-comma cascade msg')
}

; ═══════════════════════════════════════════════
; 2. let RHS 落空：'y =\n' ⇒ expected expression, got nil instead
; ═══════════════════════════════════════════════

test-let-nil-value = () {
    p = parse-err('y =\n')
    runner.eq(ps-err-count(p), 1, 'let-nil count')
    runner.eq(p.eLn[0], 2, 'let-nil line')
    runner.eq(p.eCl[0], 1, 'let-nil col')
    runner.str-eq(p.eMsg[0], 'expected expression, got nil instead', 36, 'let-nil msg')
}

; ═══════════════════════════════════════════════
; 3. 分組缺 RPAREN：'x = (1 + 2\n' ⇒ 恰 2 條（s12：2:0 括號錯 + 同位級聯 nil 錯）
; ═══════════════════════════════════════════════

test-group-missing-rparen = () {
    p = parse-err('x = (1 + 2\n')
    runner.eq(ps-err-count(p), 2, 'group count')
    runner.eq(p.eLn[0], 2, 'group line')
    runner.eq(p.eCl[0], 0, 'group col (oracle 2:0 NEWLINE — s11 游標對齊)')
    runner.str-eq(p.eMsg[0], 'expected right parenthesis, got NEWLINE instead', 47, 'group msg')
    runner.eq(p.eLn[1], 2, 'group cascade line')
    runner.eq(p.eCl[1], 0, 'group cascade col (oracle p12: 級聯同位 2:0)')
    runner.str-eq(p.eMsg[1], 'expected expression, got nil instead', 36, 'group cascade msg')
}

; ═══════════════════════════════════════════════
; 4. 去重鍵 (ln, cl, msg)：同鍵只留一條（Go saveError 同形）；異鍵新增
;    （s12 基線：'x = (1 + 2\n' 錄 2 條——括號錯與級聯 nil 錯同位不同文，
;      異鍵故都在；重報任一條才觸發同鍵去重）
; ═══════════════════════════════════════════════

test-dedup = () {
    t = ast.make()
    p = ps.new('x = (1 + 2\n')
    root = ps.parse(t, p)
    _ = root
    n0 = ps-err-count(p)
    n0 == 2 -> {

        ; 分組錯報在 NEWLINE（2:0），parse 收尾後游標已停到別處 ⇒
        ;   回溯游標到已錄錯誤所在 token，重報才命中同 (ln,cl,msg) 鍵
        ;   ⚠️ 必須用塊形 while——單語句形 `(cond) q = q + 1` 只執行一次非循環
        q = 0
        (p.toks[q].ln != p.eLn[0] || p.toks[q].cl != p.eCl[0]) {
            q = q + 1
        }
        p.pos = q

        ; 同坐標同文重報 ⇒ 不新增（Go saveError 去重；restoreState 重試即此形態）
        ; ⚠️ 先 .copy()：把 vec 元素的 str 欄位直接交給 ps-error 的 push 會產生別名）
        m = p.eMsg[0].copy()
        ps-error(p, m, 'E_GENERAL')
        runner.eq(ps-err-count(p), 2, 'dedup: same (ln,cl,msg) kept once')

        ; 同坐標異文 ⇒ 新鍵，須新增
        ps-error(p, 'different message', 'E_GENERAL')
        runner.eq(ps-err-count(p), 3, 'dedup: different message recorded')
    }

    n0 != 2 -> runner.eq(n0, 2, 'dedup: baseline two errors (group + cascade)')
}

; ═══════════════════════════════════════════════
; 5. 合法源碼零錯誤 + 空參呼叫不誤報
; ═══════════════════════════════════════════════

test-clean-no-errors = () {
    p = parse-err('x = foo(1, 2)\ny = bar()\nz = (1 + 2) * 3\n')
    runner.eq(ps-err-count(p), 0, 'clean count')
}

; ═══════════════════════════════════════════════
; 6. 多行呼叫（實參前後換行）不誤報——實參循環重寫的回歸釘樁
; ═══════════════════════════════════════════════

test-multiline-call = () {
    p = parse-err('x = foo(\n    1,\n    2)\n')
    runner.eq(ps-err-count(p), 0, 'multiline-call count')
}

; ═══════════════════════════════════════════════
; 7. 表達式語句不級聯：'print((1 + 2\n' ⇒ 2 條皆為括號族、無 nil 錯
;    （oracle p62：2:0 分組錯 + 2:1 逗號錯；Go「got nil」只住 parseLetStatement）
; ═══════════════════════════════════════════════

test-expr-stmt-no-cascade = () {
    p = parse-err('print((1 + 2\n')
    runner.eq(ps-err-count(p), 2, 'expr-stmt-cascade count')
    runner.str-eq(p.eMsg[0], 'expected right parenthesis, got NEWLINE instead', 47, 'expr-stmt-cascade msg0')
    runner.str-eq(p.eMsg[1], 'expected comma or right parenthesis, got EOF instead', 52, 'expr-stmt-cascade msg1')
}

; ═══════════════════════════════════════════════
test-call-missing-comma()
test-let-nil-value()
test-group-missing-rparen()
test-dedup()
test-clean-no-errors()
test-multiline-call()
test-expr-stmt-no-cascade()

runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
