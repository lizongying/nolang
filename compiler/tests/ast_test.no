; ast_test.no — compiler/src/ast.no 的單元測試
;
; 執行： ./bin/no run compiler/tests/ast_test.no
;
; ⚠️ 測試 runner 的斷言失敗【不會】自動改變行程退出碼，本檔結尾必須自己
;    os.exit(1)，否則差分 harness 會把失敗讀成通過。
;
; ⚠️ 訊息一律用單引號字串。nolang 的 "..." 是【char 字面量】，不是字串。
;
; ── 這些期望字串從哪來 ────────────────────────────────────────────
; 全部由 L2 oracle 實測取得，**不是**手寫猜的。重跑方式：
;     printf '42\n' > /tmp/t1.no && ./bin/no ast /tmp/t1.no
; 得到：
;     Program{}
;         ExpressionStatement{42}
;             IntegerLiteral{value: 42, raw: 42}
;
; ── 這支測試釘住什麼 ──────────────────────────────────────────────
; ast.no 是「解譯 asp.no 的指令帶」的解釋器。沒有這支測試時，它只能被
; 編譯器檢查型別，**無法**證明解譯語意正確。這裡手工組出 arena，
; 逐位元組比對 dump 結果，於是：
;   * 槽位編碼（label | ref<<24、slot 序號）錯 → 這裡就會紅；
;   * OP-HDR 的 node_of / absent 分支寫反 → 這裡就會紅；
;   * KIDS 的 count 槽對錯 → 這裡就會紅；
;   * 未接線的 opcode 被靜默略過 → ast.unsupported 的斷言會紅。

# /test/runner.eq
# /test/runner.is-true
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/util/sb.sb

; ═══════════════════════════════════════════════
; 手工組裝 arena
; ═══════════════════════════════════════════════
;
; 對應 Go 端的 `*parser.Program{ Statements: [ *ExpressionStatement{
; Expression: *IntegerLiteral{Value: 42, Raw: "42"} } ] }`
;
; 各節點要填哪些槽，完全由 asp.no 的指令帶決定：
;   IntegerLiteral    HDR 有 2 個純量：value(sprintf→s0)、raw(field→s1)
;   ExpressionStatement HDR 無純量、node_of=Expression（CHILD 序號 0）
;   Program           HDR 有 1 個純量：warnings(len→s0)，KIDS=Statements
build-forty-two = () (t ast, root i64) {
    t = ast.make()

    lit = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, lit, 0, ast.put-str(t, '42'))
    ast.set-slot(t, lit, 1, ast.put-str(t, '42'))

    es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
    ast.kid-add(t, es, lit)

    root = ast.add(t, asp.K_PROGRAM)
    ast.set-count(t, root, 0, 1)
    ast.set-slot(t, root, 0, ast.put-str(t, '0'))
    ast.kid-add(t, root, es)
}

; ═══════════════════════════════════════════════
; 1. 最小程式：逐位元組比對
; ═══════════════════════════════════════════════

test-minimal = () {
    t, root = build-forty-two()
    got = ast.dump(t, root)
    want = 'Program{}\n    ExpressionStatement{42}\n        IntegerLiteral{value: 42, raw: 42}'
    runner.is-true(got.eq-full(want), 'minimal dump is byte-identical to no ast')
    runner.eq(ast.unsupported(t), 0, 'minimal program uses no unwired opcode')
    runner.eq(ast.gaps(t), 0, 'minimal program hits no unreproducible summary branch')
}

; ═══════════════════════════════════════════════
; 2. 尾端換行必須被剪掉（dump.go 的 strings.TrimRight）
; ═══════════════════════════════════════════════
;
; 少了這一步，每個 fixture 都會多一個空行，而 `rc` 完全測不出來。

test-trim = () {
    t, root = build-forty-two()
    got = ast.dump(t, root)
    ; ⚠️ CLI 的 `no ast` 會多印一個尾端 \n（od 實測 81 位元組）；Dump 本身
    ;    只有 80。ast.dump 對齊的是 Dump，所以這裡必須是 80、且尾位元組是 '}'。
    runner.eq(got.len-bytes(), 80, 'dump length is 80 bytes (no trailing newline)')
    last = got.byte(79)
    runner.eq(last, 125, 'last byte is ASCII 125, the closing brace of IntegerLiteral')
    runner.eq(ast.trim-nl('abc\n\n\n').len-bytes(), 3, 'trim-nl strips all trailing newlines')
    runner.eq(ast.trim-nl('').len-bytes(), 0, 'trim-nl of empty stays empty')
    runner.eq(ast.trim-nl('\n').len-bytes(), 0, 'trim-nl of newline-only is empty')
}

; ═══════════════════════════════════════════════
; 3. nodeString / typeString 的 nil 不對稱
; ═══════════════════════════════════════════════
;
; ⚠️ 這是最容易寫錯的一條：dump.go 的 nodeString **沒有** nil 守衛
;    （`%T` of nil 是 "<nil>"），typeString 有（回 ""）。
;    兩者若混為一談，`ReturnStatement{}` 這種節點會多印或少印東西。

test-nil-asymmetry = () {
    t = ast.make()
    runner.is-true(ast.node-string(t, 0).eq-full('<nil>'), 'nodeString(nil) = <nil>')
    runner.is-true(ast.type-string(t, 0).eq-full(''), 'typeString(nil) = empty')
    runner.is-true(ast.type-string(t, 999999).eq-full(''), 'typeString(out of range) = empty')
}

; ═══════════════════════════════════════════════
; 4. wanted：五種印出政策
; ═══════════════════════════════════════════════
;
; 對照 dump.go 的 kv / kvs / kvb / kvn / kvc：
;   always→1  nonempty→val!=""  true→val=="true"  nonzero→val!="0"  count→val!="0"

test-wanted = () {
    runner.eq(ast.wanted(asp.P-ALWAYS, ''), 1, 'always prints empty')
    runner.eq(ast.wanted(asp.P-NON-EMPTY, ''), 0, 'nonempty drops empty')
    runner.eq(ast.wanted(asp.P-NON-EMPTY, 'x'), 1, 'nonempty keeps x')
    runner.eq(ast.wanted(asp.P-TRUE, 'false'), 0, 'true drops false')
    runner.eq(ast.wanted(asp.P-TRUE, 'true'), 1, 'true keeps true')
    runner.eq(ast.wanted(asp.P-NON-ZERO, '0'), 0, 'nonzero drops 0')
    runner.eq(ast.wanted(asp.P-NON-ZERO, '1'), 1, 'nonzero keeps 1')
    runner.eq(ast.wanted(asp.P-COUNT, '0'), 0, 'count drops 0')
    runner.eq(ast.wanted(asp.P-COUNT, '3'), 1, 'count keeps 3')
}

; ═══════════════════════════════════════════════
; 5. type-string：型別的摘要印法
; ═══════════════════════════════════════════════

test-type-string = () {
    t = ast.make()

    ; []str
    el = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, el, 0, ast.put-str(t, 'str'))
    sl = ast.add(t, asp.K_SLICE_TYPE)
    ast.kid-add(t, sl, el)
    runner.is-true(ast.type-string(t, sl).eq-full('[]str'), 'SliceType -> []str')

    ; ?i64
    nt = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, nt, 0, ast.put-str(t, 'i64'))
    nu = ast.add(t, asp.K_NULLABLE_TYPE)
    ast.kid-add(t, nu, nt)
    runner.is-true(ast.type-string(t, nu).eq-full('?i64'), 'NullableType -> ?i64')

    ; *i64 / &i64
    nt2 = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, nt2, 0, ast.put-str(t, 'i64'))
    pt = ast.add(t, asp.K_POINTER_TYPE)
    ast.kid-add(t, pt, nt2)
    runner.is-true(ast.type-string(t, pt).eq-full('*i64'), 'PointerType -> *i64')

    nt3 = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, nt3, 0, ast.put-str(t, 'i64'))
    vt = ast.add(t, asp.K_VIEW_TYPE)
    ast.kid-add(t, vt, nt3)
    runner.is-true(ast.type-string(t, vt).eq-full('&i64'), 'ViewType -> &i64')

    ; [str]i64
    k = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, k, 0, ast.put-str(t, 'str'))
    v = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, v, 0, ast.put-str(t, 'i64'))
    mp = ast.add(t, asp.K_MAP_TYPE)
    ast.kid-add(t, mp, k)
    ast.kid-add(t, mp, v)
    runner.is-true(ast.type-string(t, mp).eq-full('[str]i64'), 'MapType -> [str]i64')

    ; [4]i64（大小是 IntegerLiteral ⇒ exprToString 走 value 分支）
    sz = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, sz, 0, ast.put-str(t, '4'))
    ast.set-slot(t, sz, 1, ast.put-str(t, '4'))
    e2 = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, e2, 0, ast.put-str(t, 'i64'))
    ar = ast.add(t, asp.K_ARRAY_TYPE)
    ast.kid-add(t, ar, sz)
    ast.kid-add(t, ar, e2)
    runner.is-true(ast.type-string(t, ar).eq-full('[4]i64'), 'ArrayType -> [4]i64')

    ; [?]i64（Size == nil）
    e3 = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, e3, 0, ast.put-str(t, 'i64'))
    ar2 = ast.add(t, asp.K_ARRAY_TYPE)
    ast.kid-add(t, ar2, 0)
    ast.kid-add(t, ar2, e3)
    runner.is-true(ast.type-string(t, ar2).eq-full('[?]i64'), 'ArrayType with nil Size -> [?]i64')

    ; UnionType 不在 typeString 的 switch 內 ⇒ Go 的 default 印 %T
    un = ast.add(t, asp.K_UNION_TYPE)
    runner.is-true(ast.type-string(t, un).eq-full('*parser.UnionType'), 'UnionType -> *parser.UnionType (%T)')
    runner.eq(ast.gaps(t), 0, 'type-string does not count gaps')
}

; ═══════════════════════════════════════════════
; 6. expr-string：ArrayType 大小運算式的常數折疊
; ═══════════════════════════════════════════════
;
; parser.exprToString 對 InfixExpression 會先試 evalConstIntExpr：
;   160+16 → 176（折疊成功），a+b → "a + b"（折疊失敗，退回拼接）。

test-expr-string = () {
    t = ast.make()

    ; 160 + 16 → 176
    l = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, l, 0, ast.put-str(t, '160'))
    r = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, r, 0, ast.put-str(t, '16'))
    ie = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, ie, 0, ast.put-str(t, '+'))
    ast.kid-add(t, ie, l)
    ast.kid-add(t, ie, r)
    runner.is-true(ast.expr-string(t, ie).eq-full('176'), '160+16 folds to 176')

    ; 160 - 16 → 144
    l2 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, l2, 0, ast.put-str(t, '160'))
    r2 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, r2, 0, ast.put-str(t, '16'))
    ie2 = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, ie2, 0, ast.put-str(t, '-'))
    ast.kid-add(t, ie2, l2)
    ast.kid-add(t, ie2, r2)
    runner.is-true(ast.expr-string(t, ie2).eq-full('144'), '160-16 folds to 144')

    ; 160 * 16 → 2560
    l3 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, l3, 0, ast.put-str(t, '160'))
    r3 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, r3, 0, ast.put-str(t, '16'))
    ie3 = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, ie3, 0, ast.put-str(t, '*'))
    ast.kid-add(t, ie3, l3)
    ast.kid-add(t, ie3, r3)
    runner.is-true(ast.expr-string(t, ie3).eq-full('2560'), '160*16 folds to 2560')

    ; 160 / 16 → 10
    l4 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, l4, 0, ast.put-str(t, '160'))
    r4 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, r4, 0, ast.put-str(t, '16'))
    ie4 = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, ie4, 0, ast.put-str(t, '/'))
    ast.kid-add(t, ie4, l4)
    ast.kid-add(t, ie4, r4)
    runner.is-true(ast.expr-string(t, ie4).eq-full('10'), '160/16 folds to 10')

    ; 160 / 0 → 不折疊（Go 的 evalConstIntExpr 在除數為 0 時回 false）
    l5 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, l5, 0, ast.put-str(t, '160'))
    r5 = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, r5, 0, ast.put-str(t, '0'))
    ie5 = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, ie5, 0, ast.put-str(t, '/'))
    ast.kid-add(t, ie5, l5)
    ast.kid-add(t, ie5, r5)
    runner.is-true(ast.expr-string(t, ie5).eq-full('160 / 0'), '160/0 does NOT fold')

    ; a + b → 不折疊（運算元不是整數字面量）
    la = ast.add(t, asp.K_IDENTIFIER)
    ast.set-slot(t, la, 0, ast.put-str(t, 'a'))
    rb = ast.add(t, asp.K_IDENTIFIER)
    ast.set-slot(t, rb, 0, ast.put-str(t, 'b'))
    ie6 = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, ie6, 0, ast.put-str(t, '+'))
    ast.kid-add(t, ie6, la)
    ast.kid-add(t, ie6, rb)
    runner.is-true(ast.expr-string(t, ie6).eq-full('a + b'), 'a+b does not fold')

    ; 'x' 字串字面量：Raw 空 ⇒ 用單引號包住 value
    ; ⚠️ nolang 的 "..." 是 char 字面量，所以「單引號字元」寫成 "'"，
    ;    不能寫成 '\''（也不必跳脫）。
    ss = ast.add(t, asp.K_STRING_LITERAL)
    ast.set-slot(t, ss, 0, ast.put-str(t, 'x'))
    runner.is-true(ast.expr-string(t, ss).eq-full("'" - 'x' - "'"), 'StringLiteral without Raw -> quoted x')
}

; ═══════════════════════════════════════════════
; 7. unsupported：未接線的 opcode 必須被計數，不能靜默略過
; ═══════════════════════════════════════════════
;
; InterfaceDefinition 的指令帶含 OP-IMPLEMENTS 與 OP-HELPER(interfaceMethod)。
; 前者已接線，後者未接線 ⇒ unsupported 必須 > 0。這條同時證明
; 「計數器真的會被觸發」（否則它是個永遠為 0 的假斷言）。

test-unsupported-is-live = () {
    t = ast.make()
    id = ast.add(t, asp.K_INTERFACE_DEFINITION)
    ast.set-slot(t, id, 0, ast.put-str(t, 'shape'))
    ast.set-slot(t, id, 1, ast.put-str(t, '0'))
    ast.set-slot(t, id, 2, ast.put-str(t, '0'))
    _ = ast.dump(t, id)
    runner.eq(ast.unsupported(t), 1, 'interfaceMethod helper is counted as unsupported')
}

; ═══════════════════════════════════════════════
; 8. 語料覆蓋：71 種節點都有 id 且名字唯一
; ═══════════════════════════════════════════════

test-kind-table = () {
    ; ⚠️ 這裡必須先把跨模組常量落到區域變數。
    ;    已實測的 src/ 缺陷（bug #85 家族，見 docs/design/nolang-selfhost.md §9）：
    ;       runner.is-true(asp.kind-name(asp.K_PROGRAM).eq-full('Program'), 'a')
    ;       ⇒ EmitLLVM: MIR->LLVM: func tk: consumer reads value 0 (NoVal)
    ;    把常量參數換成**字面量**（asp.kind-name(53)）或先存成區域變數都正常；
    ;    `print(asp.kind-name(asp.K_PROGRAM))` 也正常。
    ;    觸發條件＝「跨模組常量當作**嵌套呼叫**的引數」。
    kprog = asp.K_PROGRAM
    runner.eq(asp.KIND-COUNT, 71, 'KIND-COUNT = 71')
    runner.eq(kprog, 53, 'Program is kind 53')
    runner.eq(asp.K_IDENTIFIER, 35, 'Identifier is kind 35')
    runner.eq(asp.K_INTEGER_LITERAL, 39, 'IntegerLiteral is kind 39')
    runner.eq(asp.kind-id('Program'), kprog, 'kind-id(Program) round-trips')
    runner.is-true(asp.kind-name(kprog).eq-full('Program'), 'kind-name(53) = Program')
    runner.eq(asp.kind-id('NoSuchNode'), 0, 'kind-id of an unknown name is 0')
}

; ═══════════════════════════════════════════════

test-minimal()
test-trim()
test-nil-asymmetry()
test-wanted()
test-type-string()
test-expr-string()
test-unsupported-is-live()
test-kind-table()

runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)
    -> os.exit(0)
}
