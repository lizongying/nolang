; s115 探针：逐形跑 pkg-ll-cov，看 LF/ID 歸因
# /compiler/src/drv
# /compiler/src/ix
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/ps
# /compiler/src/tok
# /compiler/src/mir
# /compiler/src/cg
# /compiler/src/cg-runtime
# /compiler/src/cg-rc
# /compiler/src/h2m
# /compiler/src/link
# /compiler/src/util/sb.sb
# /compiler/src/diag
# /compiler/src/ck
# /compiler/src/ck-sig

names []str = ['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8', 'f9']
i = 0
(i < names.len()) {
    nm = names[i]
    print('=== ' - nm - ' ===')
    ll = drv.pkg-ll-cov('compiler/tests/t8/' - nm - '.no')
    print('  IR bytes ' - ll.len-bytes().to-str())
    k = 0
    ln = ll.split('\n')
    (k < ln.len()) {
        l = ln[k]
        l.starts-with('define ') && l.contains('@' - nm - '(') -> print('  DEF ' - l)
        k = ix.inc(k)
    }
    i = ix.inc(i)
}
