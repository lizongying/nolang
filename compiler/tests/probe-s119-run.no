; probe-s119-run.no — 臨時：vmode 變體臂語义端到端（參數由命令列传入）
; 用法：./bin/no run compiler/tests/probe-s119-run.no <x>
; ⚠️ 臨時探針，追記前刪除。

# /test/runner.eq
# /compiler/src/drv.build-to
# /compiler/src/drv.run-temp
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/ps
# /compiler/src/tok
# /compiler/src/mir
# /compiler/src/cg
# /compiler/src/cg-runtime
# /compiler/src/cg-rc
# /compiler/src/h2m
# /compiler/src/link
# /compiler/src/util/sb.sb
# /compiler/src/diag
# /compiler/src/ck
# /compiler/src/ck-sig

SRC = 'f = (x i64) (r i64) {\n    r = x: {\n        ok -> 5\n\n        -> 0\n    }\n}\n\nexit(f(' - drv.arg-at(1) - '))\n'

fs.write-file('/tmp/s119run/main.no', SRC.to-bytes())
ok = drv.build-to('/tmp/s119run/main.no', '/tmp/s119run.out')
runner.eq(ok, true, 's119 build vmode variant arm')
