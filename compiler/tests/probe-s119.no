out = ''
i = 1
(i < 10) {
    fn = 'compiler/tests/t8/f' - i.to-str() - '.no'
    src = fs.read-file(fn)
    ll = drv.build-ll(src)
    okk = ll.contains('define').to-str()
    out = out - 'f' - i.to-str() - ' len=' - ll.len-bytes().to-str() - ' define=' - okk - '\n'
    i = ix.inc(i)
}

fs.write-file('/tmp/s119-t8.txt', out.to-bytes())
print('done')
