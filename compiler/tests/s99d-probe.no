# /test/runner.eq
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok
# /compiler/src/ps
# /compiler/src/h2m
# /compiler/src/mir

test-one = (label str, src str) {
    t = ast.make()
    b = src.to-bytes()
    p = ps.new(b)
    root = ps.parse(t, p)
    agg = h2m-new()
    ir = h2m-lower-program(t, agg, root)
    print(label, ' UNSUP=', agg.unsup)
}

test-s99d = () {
    ; 本地 struct 在 mem 模式（含循环）下作为实参穿过函数调用：q 建好→传给 f→返回 s→读字段
    test-one('da', 'Point {\n    x i64\n    y i64\n}\n\nf = (p Point) (r Point) {\n    r = p\n}\n\ng = () (z i64) {\n    q = Point { x: 1, y: 2 }\n    n = 0\n    (n < 3) {\n        n = n + 1\n    }\n    s = f(q)\n    z = s.x + s.y\n}\n')
    ; 形参 struct 在 mem 模式（含循环）下传给另一函数并返回
    test-one('db', 'Point {\n    x i64\n    y i64\n}\n\nf = (p Point) (r Point) {\n    r = p\n}\n\ng = (inp Point) (z i64) {\n    n = 0\n    (n < 3) {\n        n = n + 1\n    }\n    s = f(inp)\n    z = s.x + s.y\n}\n')
    ; 函数返回 struct（mem 模式），调用方再改其字段
    test-one('dc', 'Point {\n    x i64\n    y i64\n}\n\nmk = () (r Point) {\n    r = Point { x: 5, y: 7 }\n}\n\ng = () (z i64) {\n    n = 0\n    (n < 3) {\n        n = n + 1\n    }\n    s = mk()\n    s.y = s.y + 1\n    z = s.x + s.y\n}\n')
}

test-s99d()
