; tok-test.no — compiler/src/tok 的單元測試
;
; 執行： ./bin/no run compiler/tests/tok-test.no
;
; ⚠️ 測試 runner 的斷言失敗【不會】自動改變行程退出碼，本檔結尾必須自己
;    exit(1)，否則差分 harness 會把失敗讀成通過。
;
; ⚠️ 本檔驗的是「常量的值與名字表」；它**不能**取代 L1 全語料差分 ——
;    這裡只釘住幾個代表值，真正保證 tok.no 與 src/lexer/token.go 一致的是
;    scripts/selfhost_diff.sh 的 L1（逐 token 比對）。
;
; ⚠️ 訊息一律用單引號字串。nolang 的 "..." 是【char 字面量】，不是字串。

# /test/runner.eq
# /test/runner.str-eq
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/tok

; ═══════════════════════════════════════════════
; 編號（iota 順序，錯一位就會讓 L1 全線 DIFF）
; ═══════════════════════════════════════════════

test-numbering = () {
    runner.eq(tok.ILLEGAL, 0, 'ILLEGAL = 0')
    runner.eq(tok.EOF, 1, 'EOF = 1')
    runner.eq(tok.NEWLINE, 2, 'NEWLINE = 2')
    runner.eq(tok.COMMENT, 3, 'COMMENT = 3')
    runner.eq(tok.NIL, 12, 'NIL = 12')
    runner.eq(tok.IF, 13, 'IF = 13')
    runner.eq(tok.HASH-LBRACE, 26, 'HASH_LBRACE = 26')
    runner.eq(tok.CO, 37, 'CO = 37')
    runner.eq(tok.ASSIGN, 38, 'ASSIGN = 38')
    runner.eq(tok.LAND, 50, 'LAND = 50')
    runner.eq(tok.AND-NOT, 62, 'AND_NOT = 62')
    runner.eq(tok.ELLIPSIS, 65, 'ELLIPSIS = 65')
    runner.eq(tok.AND-NOT-ASSIGN, 76, 'AND_NOT_ASSIGN = 76')
    runner.eq(tok.QUESTION-ASSIGN, 77, 'QUESTION_ASSIGN = 77')
    runner.eq(tok.LPAREN, 78, 'LPAREN = 78')
    runner.eq(tok.UNDERSCORE, 88, 'UNDERSCORE = 88')
    runner.eq(tok.QUESTION, 90, 'QUESTION = 90')
    runner.eq(tok.TILDE, 91, 'TILDE = 91')
}

; ═══════════════════════════════════════════════
; 名字表：0..91 全部有名字（不得回 UNKNOWN）
; ═══════════════════════════════════════════════

test-names-cover-all = () {
    bad = 0
    i <- [0..92): {
        nm = tok.name(i)
        unk = tok.str-eq(nm, 'UNKNOWN')
        unk -> {
            #{overflow=wrap}
            bad = bad + 1
        }
    }
    runner.eq(bad, 0, 'every code 0..91 has a name, no UNKNOWN')

    runner.str-eq(tok.name(tok.ILLEGAL), 'ILLEGAL', 7, 'name of code 0')
    runner.str-eq(tok.name(tok.IF), 'IF', 2, 'name of IF')
    runner.str-eq(tok.name(tok.NOT-EQUALS), 'NOT_EQUALS', 10, 'name of NOT_EQUALS')
    runner.str-eq(tok.name(tok.HASH-LBRACE), 'HASH_LBRACE', 11, 'name of HASH_LBRACE')
    runner.str-eq(tok.name(tok.TILDE), 'TILDE', 5, 'name of TILDE')
}

; ═══════════════════════════════════════════════
; str-eq：位元組相等，且**前綴不得誤判**（少了長度比較就會錯）
; ═══════════════════════════════════════════════

test-str-eq = () {
    runner.eq(tok.str-eq('', ''), true, 'empty equals empty')
    runner.eq(tok.str-eq('a', 'a'), true, 'single byte equal')
    runner.eq(tok.str-eq('abc', 'abc'), true, 'same string')
    runner.eq(tok.str-eq('ab', 'abc'), false, 'prefix is NOT equal, shorter')
    runner.eq(tok.str-eq('abc', 'ab'), false, 'prefix is NOT equal, longer')
    runner.eq(tok.str-eq('abc', 'abd'), false, 'differs at last byte')
    runner.eq(tok.str-eq('', 'a'), false, 'empty vs nonempty')
    runner.eq(tok.str-eq('中', '中'), true, 'multibyte equal')
    runner.eq(tok.str-eq('中', '中中'), false, 'multibyte prefix')
}

; ═══════════════════════════════════════════════
; keyword：23 個關鍵字 + while 別名 FOR + 非關鍵字回 ILLEGAL
; ═══════════════════════════════════════════════

test-keyword = () {
    runner.eq(tok.keyword('if'), tok.IF, 'kw if')
    runner.eq(tok.keyword('elif'), tok.ELIF, 'kw elif')
    runner.eq(tok.keyword('else'), tok.ELSE, 'kw else')
    runner.eq(tok.keyword('switch'), tok.SWITCH, 'kw switch')
    runner.eq(tok.keyword('case'), tok.CASE, 'kw case')
    runner.eq(tok.keyword('default'), tok.DEFAULT, 'kw default')
    runner.eq(tok.keyword('match'), tok.MATCH, 'kw match')
    runner.eq(tok.keyword('for'), tok.FOR, 'kw for')
    runner.eq(tok.keyword('while'), tok.FOR, 'kw while aliases FOR')
    runner.eq(tok.keyword('in'), tok.IN, 'kw in')
    runner.eq(tok.keyword('return'), tok.RETURN, 'kw return')
    runner.eq(tok.keyword('break'), tok.BREAK, 'kw break')
    runner.eq(tok.keyword('continue'), tok.CONTINUE, 'kw continue')
    runner.eq(tok.keyword('true'), tok.TRUE, 'kw true')
    runner.eq(tok.keyword('false'), tok.FALSE, 'kw false')
    runner.eq(tok.keyword('nil'), tok.NIL, 'kw nil')
    runner.eq(tok.keyword('as'), tok.AS, 'kw as')
    runner.eq(tok.keyword('ptr'), tok.PTR, 'kw ptr')
    runner.eq(tok.keyword('chan'), tok.CHAN, 'kw chan')
    runner.eq(tok.keyword('use'), tok.USE, 'kw use')
    runner.eq(tok.keyword('run'), tok.RUN, 'kw run')
    runner.eq(tok.keyword('awy'), tok.AWY, 'kw awy')
    runner.eq(tok.keyword('co'), tok.CO, 'kw co')

    ; 非關鍵字
    runner.eq(tok.keyword('foo'), tok.ILLEGAL, 'foo is not a keyword')
    runner.eq(tok.keyword(''), tok.ILLEGAL, 'empty is not a keyword')
    runner.eq(tok.keyword('IF'), tok.ILLEGAL, 'keywords are case sensitive')
    runner.eq(tok.keyword('iff'), tok.ILLEGAL, 'iff is not if')
    runner.eq(tok.keyword('i'), tok.ILLEGAL, 'i is not if')
    ; 前綴陷阱：in 是關鍵字，int 不是
    runner.eq(tok.keyword('int'), tok.ILLEGAL, 'int is not in, prefix trap')
}

; ═══════════════════════════════════════════════

test-numbering()
test-names-cover-all()
test-str-eq()
test-keyword()

runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)
    -> exit(0)
}
