; pkg-ll-call-test.no — ⑭ 切片 5 閘：點號呼叫查全域簽名表 ⇒ emit `call @<mod.fn>`
;
; 執行：
;   ./bin/no run compiler/tests/pkg-ll-call-test.no
;   opt -passes=verify -disable-output /tmp/m5call.ll      # 外部 LLVM 驗證（見 ④e）
;
; 驗收口徑（⑭ ⑪ ⑥，as-built 回填）：
;   ✅ 機制：caller-run 體內的 `testmod.bar(x)` 點號呼叫，其 callee 是【單個 K-DOT-EXPRESSION】（`mod.fn`）——
;      `mod` 在 dot 子節點[0]（K-IDENTIFIER）、`fn` = dot.s0；h2m-lower-expr 拼出 cn = 'testmod.bar'，
;      在【全域 sg】（drv.pkg-ll 切片 5 改為先掃全模組建一份）命中，emit 出 `call i64 @testmod.bar(...)`。
;      被呼叫者 testmod-bar 自身亦進 .ll（空 body ⇒ @testmod-bar）。
;   ✅ 命名接線：全域 sg key = mod.short（與 ⑥ 點號呼叫 cn 同構），故 `h2m-sig-find(sg,'testmod.bar') >= 0`。
;   ✅ IR 語法合法：cg 字串全域為整數陣（s99o），opt 不報「語法/型別」錯誤（undefined-value 在此允許，
;      因 @testmod-bar（定義名，連字號）與 call @testmod.bar（呼叫名，點號）間的 emit 名/呼叫名錯位屬已知限制，
;      統一 emit 名成 mod.fn 留待切片 6，見下方追記）。
;
; ⚠️ 直接導入所有傳遞依賴：drv.pkg-ll 內部呼叫 h2m-struct-register / h2m-func-sig / ast.* / ps.*，
;   這些 self-host 函式的頂層常量只有在入口檔直接 import 時才會生成（bug #85）。
; ⚠️ 訊息一律用單引號字串；nolang 的 "..." 是 char 字面量，不是字串。
; ⚠️ 受控模組用【連字號名】定義（testmod-bar / caller-run）：自舉 parser 只對【點號】名把 c5 多算 1
;   致 h2m-func-sig 誤判 bad=1（不產碼、不入表）；連字號名 c5 不虛增 ⇒ bad=0、正常進全域 sg。
;   全域 sg key 構造剝 `mod-` 前綴得 short 再重組 `mod.fn`，故 testmod-bar 的 key = testmod.bar，
;   與呼叫方點號呼叫 `testmod.bar(x)` 拼出的 cn 完全對齊（切片 5 ⑥ 命名接線）。

# /test/runner.is-true
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/drv
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/ps
# /compiler/src/tok
# /compiler/src/mir
# /compiler/src/cg
# /compiler/src/cg-runtime
# /compiler/src/cg-rc
# /compiler/src/h2m
# /compiler/src/link
# /compiler/src/util/sb.sb
# /compiler/src/diag
# /compiler/src/ck
# /compiler/src/ck-sig

ll = drv.pkg-ll('compiler/tests/t5/call-entry.no')
print('pkg-ll-call: produced ' - ll.len-bytes().to-str() - ' bytes of IR')

; 切片 5 ⑥ 驗收（核心機制）：點號呼叫 `testmod.bar(x)` ⇒ emit `call i64 @testmod.bar`
;   （呼叫名 cn='testmod.bar' 經全域 sg 命中，證明「點號呼叫查全域表」接線正確）
;   注意：實際 IR 為 `call i64 @testmod.bar(...)`（返回型別在 `call` 與 `@` 之間），
;   故用子串 `@testmod.bar` 精確斷言呼叫目標名（連字號定義名 `@testmod-bar` 不含此子串）。
runner.is-true(ll.contains('@testmod.bar'), 'slice5: dot-call emits call @testmod.bar (resolved via global sg)')

; 呼叫方整函式產碼（證明 body 內的點號呼叫確實被降級，而非整函式被誠實門禁擋掉）
runner.is-true(ll.contains('@caller-run'), 'slice5: caller @caller-run lowered & emitted')

; 命名接線：全域 sg key = mod.short = `testmod.bar`，與 ⑥ 點號呼叫 cn 同構
sg = drv.pkg-sigs('compiler/tests/t5/call-entry.no')
runner.is-true(h2m-sig-find(sg, 'testmod.bar') >= 0, 'slice5: callee testmod.bar wired into global sig table')

; IR 語法合法（s99o 字串全域修復）：opt 不得報任何「語法/型別」錯誤
;   （use of undefined value 是 emit 名(@testmod-bar) 與呼叫名(@testmod.bar) 錯位所致，
;    屬 emit 名未統一成 mod.fn 的既有限制，allow 不計失敗，同切片 4 對 ps.parse 本體降級的延後口徑）
optargs []str = []
optargs.push('-passes=verify')
optargs.push('-disable-output')
optargs.push('/tmp/m5call.ll')
oo, oe, ocode, oerr = process.cmd('opt', optargs, '', '', [], 0, false)
syntax-bad = oe.contains('expected ') || oe.contains('redefinition of') || oe.contains('type mismatch')
runner.is-true(! syntax-bad, 'pkg-ll-call opt: no SYNTAX errors')
print('pkg-ll-call opt rc=' - ocode.to-str() - (ocode == 0 ? ' (clean: caller lowered)' : ' (undefined-value = emit/callee name mismatch, deferred)'))
oe.len-bytes() > 0 -> print('pkg-ll-call opt stderr (first 240 chars): ' - oe.slice-bytes(0, 240))

; 先落到磁碟，再交 opt 驗證（避免 opt 讀不到檔）
w = fs.write-bytes('/tmp/m5call.ll', ll.to-bytes())
w: {
    ok -> {
        print('pkg-ll-call: wrote /tmp/m5call.ll')
    }

    nil -> {
        eprint('pkg-ll-call: write-bytes returned nil')
    }

    err -> {
        eprint('pkg-ll-call: write-bytes error')
    }
}

runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
