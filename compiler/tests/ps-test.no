; ps-test.no — compiler/src/ps 的 parser 迴歸測試
;
; 執行： ./bin/no run compiler/tests/ps-test.no
;
; ⚠️ 測試 runner 的斷言失敗【不會】自動改變行程退出碼，本檔結尾必須自己
;    exit(1)，否則差分 harness 會把失敗讀成通過。
;
; ⚠️ 訊息一律用單引號字串。nolang 的 "..." 是【char 字面量】，不是字串。
;
; ── 這些期望字串從哪來 ────────────────────────────────────────────
; 全部由 L2 oracle 實測取得（`./bin/no ast <檔>`），**不是**手寫猜的。
;
; ── 本檔釘住什麼（s59：IN 上下文關鍵字）─────────────────────────
; Go expr.go:96 把 IN 與 IDENT 同軌（`case IDENT, IN, MATCH: parseIdentifier`），
; `in` 在表達式位是合法識別字（std/crypto 大量用作參數名）。ps.no 的
; ps-parse-expr-prec 曾缺 IN 臂 ⇒ 表達式位的 `in` 無 primary 可取（回 idx=0
; 且不吃 token）：
;   · `it = in[i]` ⇒ let RHS 丟失，`[i]` 被拆成獨立 SliceLiteral 陳述；
;   · `enc-block(in, ek)` ⇒ 引數從 2 變 1（靜默丟參！）；
;   · `(in[i]) != pad-len -> { … }`（陳述層）⇒ LPAREN 臂建出空殼
;     GroupedExpression 後 pos 卡在 IN 不動，陳述級進度守則每輪強制 bump
;     一 token ⇒ 一行被撕成「41+ 深 GroupedExpression 鏈」+ SliceLiteral
;     + 左值 nil 的 InfixExpression 三個陳述；深鏈使 dump 縮排呈二次方
;     ⇒ GB 級輸出 ⇒ 表現為掛起（aes-cbc.no / tls.no 實測 rc=124）。
; 根因鏈與實證見 docs/design/nolang-selfhost.md §5.3.3。

; ⚠️ 導入清單必須包含 ps 的【傳遞依賴】（tok / asp / lx / util/sb）——实测：
;    入口檔只導入 ps 時，lx.no 裡的 `tok.NEWLINE` 等跨模組常量解析不到
;    （MIR 降成 const void + eq NoVal ⇒ bug #85 類 EmitLLVM 失敗）；補上直接
;    導入後即恢復。这是 oracle 端的跨模組常量解析範圍缺陷（先於本檔存在），
;    此處以導入清單繞開，缺陷本身待獨立立项。
# /test/runner.eq
# /test/runner.is-true
# /test/runner.failed-count
# /test/runner.summary
# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok
# /compiler/src/ps

; ═══════════════════════════════════════════════
; helper：parse + dump（對齊 drv.cmd-ast 的管線）
; ═══════════════════════════════════════════════

parse-dump = (src str) (out str) {
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)
    out = ast.dump(t, root)
}

; ═══════════════════════════════════════════════
; 1. let RHS 索引：`it = in[i]` ⇒ IndexExpression{in, i}
;    （舊缺陷：value 丟失 + `[i]` 被拆成獨立 SliceLiteral 陳述）
; ═══════════════════════════════════════════════

test-in-index-rhs = () {
    got = parse-dump('it = in[i]')
    want = 'Program{}\n    LetStatement{name: it, value: IndexExpression}\n        IndexExpression\n            Identifier{name: in}\n            Identifier{name: i}'
    runner.is-true(got.eq-full(want), 'it = in[i] -> IndexExpression{Identifier{in}, Identifier{i}}')
}

; ═══════════════════════════════════════════════
; 2. call 引數：`out = enc-block(in, ek)` ⇒ args: 2
;    （舊缺陷：args: 1 —— `in` 引數被靜默丟棄）
; ═══════════════════════════════════════════════

test-in-call-arg = () {
    got = parse-dump('out = enc-block(in, ek)')
    want = 'Program{}\n    LetStatement{name: out, value: CallExpression}\n        CallExpression{fn: enc-block, args: 2}\n            Identifier{name: enc-block}\n            Identifier{name: in}\n            Identifier{name: ek}'
    runner.is-true(got.eq-full(want), 'enc-block(in, ek) -> CallExpression args: 2 with Identifier{in}')
}

; ═══════════════════════════════════════════════
; 3. 掛起觸發形（本檔最重要的回歸測試）：
;    `(in[i]) != pad-len -> { out-n = -1; return }` 陳述層
;    ⇒ 單一 ExpressionStatement{IfExpression}，GroupedExpression 包住
;    IndexExpression；【不能】被撕成多個陳述、不能出深鏈、不能掛起。
;    期望值 = oracle 對 tests 用的 a1 最小復現檔的實測輸出。
; ═══════════════════════════════════════════════

test-in-grouped-inline-if = () {
    got = parse-dump('pad-len = 16\ni = 0\n(in[i]) != pad-len -> {\n    out-n = -1\n    return\n}')
    want = 'Program{}\n    LetStatement{name: pad-len, type: i64, value: 16}\n        NamedType{name: i64, inferred: true}\n        IntegerLiteral{value: 16, raw: 16}\n    LetStatement{name: i, type: i64, value: 0}\n        NamedType{name: i64, inferred: true}\n        IntegerLiteral{value: 0, raw: 0}\n    ExpressionStatement{IfExpression}\n        IfExpression\n            InfixExpression{op: !=}\n                GroupedExpression\n                    IndexExpression\n                        Identifier{name: in}\n                        Identifier{name: i}\n                Identifier{name: pad-len}\n            BlockStatement{}\n                LetStatement{name: out-n, value: PrefixExpression}\n                    PrefixExpression{op: -}\n                        IntegerLiteral{value: 1, raw: 1}\n                ReturnStatement{}'
    runner.is-true(got.eq-full(want), '(in[i]) != pad-len -> { ... } -> single IfExpression statement (no shredding)')
}

; ═══════════════════════════════════════════════
; 4. let RHS 比較（c2 形式，無 inline-if）：同樣曾掛起
; ═══════════════════════════════════════════════

test-in-grouped-compare-let = () {
    got = parse-dump('x = (in[i]) != pad-len')
    want = 'Program{}\n    LetStatement{name: x, value: InfixExpression}\n        InfixExpression{op: !=}\n            GroupedExpression\n                IndexExpression\n                    Identifier{name: in}\n                    Identifier{name: i}\n            Identifier{name: pad-len}'
    runner.is-true(got.eq-full(want), 'x = (in[i]) != pad-len -> InfixExpression over GroupedExpression')
}

; ═══════════════════════════════════════════════
; 5. 對照組：無 `in` 的同等構造必須不受影響（零回歸錨點）
; ═══════════════════════════════════════════════

test-control-no-in = () {
    got = parse-dump('x = (ab[i]) != pad-len')
    want = 'Program{}\n    LetStatement{name: x, value: InfixExpression}\n        InfixExpression{op: !=}\n            GroupedExpression\n                IndexExpression\n                    Identifier{name: ab}\n                    Identifier{name: i}\n            Identifier{name: pad-len}'
    runner.is-true(got.eq-full(want), 'control: (ab[i]) != pad-len parses identically (no regression)')
}

; ═══════════════════════════════════════════════
; 6. s64：泛型陣列接收者 `[n]t.method = (…) { … }`
;    （舊缺陷：無臂 ⇒ `[n]t` 被當 SliceLiteral 幽靈陳述、方法名丟 `[n]` 前綴、
;     self 降成 NamedType{t}、泛型 `n` 缺席）
;    期望含 `GenericParams: n, t` 與 self 的 ArrayType{size: n, elem t}。
; ═══════════════════════════════════════════════

test-array-recv-generic = () {
    got = parse-dump('[n]t.len = () (out i64) {\n    out = n\n}')
    want = 'Program{}\n    FunctionDefinition{name: [n]t.len, methodDef: true}\n        GenericParams: n, t\n        Parameter{name: self, type: [n]t}\n            ArrayType{size: n}\n                Identifier{name: n}\n                NamedType{name: t}\n        Parameter{name: out, type: i64}\n            NamedType{name: i64}\n        BlockStatement{}\n            LetStatement{name: out, value: n}\n                Identifier{name: n}'
    runner.is-true(got.eq-full(want), '[n]t.len -> methodDef with ArrayType receiver + GenericParams: n, t')
}

; ═══════════════════════════════════════════════
; 7. s65a：參數位的陣列型別 `[n]t`（尺寸為 IDENT，非 INT）
;    （舊缺陷：ps-parse-type 的 ArrayType 臂只收 INT 尺寸 ⇒ `(dst [n]t)`
;    退化成 dst / n / t 三個參數）
; ═══════════════════════════════════════════════

test-array-param-generic-size = () {
    got = parse-dump('[n]t.clone = () (dst [n]t) {\n    dst[0] = .[0]\n}')
    want = 'Program{}\n    FunctionDefinition{name: [n]t.clone, methodDef: true}\n        GenericParams: n, t\n        Parameter{name: self, type: [n]t}\n            ArrayType{size: n}\n                Identifier{name: n}\n                NamedType{name: t}\n        Parameter{name: dst, type: [n]t}\n            ArrayType{size: n}\n                Identifier{name: n}\n                NamedType{name: t}\n        BlockStatement{}\n            ExpressionStatement{AssignExpression}\n                AssignExpression\n                    IndexExpression\n                        Identifier{name: dst}\n                        IntegerLiteral{value: 0, raw: 0}\n                    IndexExpression\n                        Identifier{name: self}\n                        IntegerLiteral{value: 0, raw: 0}'
    runner.is-true(got.eq-full(want), '(dst [n]t) -> one Parameter with ArrayType (not three params)')
}

; ═══════════════════════════════════════════════
; 8. s65b：切片接收者 `[]t.method = (…) { … }` —— 且【無】GenericParams
;    ⚠️ 本測試是 s65b 的關鍵反回歸錨點：Go 只在 `[n]t` 分支播種隱式泛型，
;       `[]t` 分支不播種，且 self 在三條方法路徑裡都在 detectImplicitGeneric
;       【之後】才插入 ⇒ self 的 SliceType{t} 不得貢獻泛型。若把 self 也算進去
;       或對 SliceType 接收者播種，本檔就會多出 `GenericParams: t` 而失敗。
; ═══════════════════════════════════════════════

test-slice-recv-no-generic = () {
    got = parse-dump('[]t.len = () (out i64) {\n    out = 0\n}')
    want = 'Program{}\n    FunctionDefinition{name: []t.len, methodDef: true}\n        Parameter{name: self, type: []t}\n            SliceType{}\n                NamedType{name: t}\n        Parameter{name: out, type: i64}\n            NamedType{name: i64}\n        BlockStatement{}\n            LetStatement{name: out, type: i64, value: 0}\n                NamedType{name: i64, inferred: true}\n                IntegerLiteral{value: 0, raw: 0}'
    runner.is-true(got.eq-full(want), '[]t.len -> SliceType receiver and NO GenericParams (self must not seed generics)')
}

; ═══════════════════════════════════════════════
; 9. 切片接收者 + 泛型來自參數：`[]t.eq = (b []t) (eq bool)`
;    ⇒ GenericParams: t（來自 param `b []t`，順序在 self 之前）
; ═══════════════════════════════════════════════

test-slice-recv-generic-from-param = () {
    got = parse-dump('[]t.eq = (b []t) (eq bool) {\n    eq = true\n}')
    want = 'Program{}\n    FunctionDefinition{name: []t.eq, methodDef: true}\n        GenericParams: t\n        Parameter{name: b, type: []t}\n            SliceType{}\n                NamedType{name: t}\n        Parameter{name: self, type: []t}\n            SliceType{}\n                NamedType{name: t}\n        Parameter{name: eq, type: bool}\n            NamedType{name: bool}\n        BlockStatement{}\n            LetStatement{name: eq, type: bool, value: true}\n                NamedType{name: bool, inferred: true}\n                BooleanLiteral{true}'
    runner.is-true(got.eq-full(want), '[]t.eq -> GenericParams: t sourced from param b []t')
}

; ═══════════════════════════════════════════════
; 9b. s8s：`[?]T` 回傳參數 —— ArrayType{size: <nil>}（尺寸 unknown），
;     非 SliceType、非 NullableType 包裹。且 NamedType{t} 元素為【隱式泛型】
;     來源（s63 走訪 Results 型別），故 `[]t` 接收者本不播種，泛型 `t` 由
;     此 `[?]t` 回傳參數取得 → GenericParams: t（鏡像 vec.no:182）。
; ═══════════════════════════════════════════════

test-param-nullable-size-array = () {
    got = parse-dump('[]t.to-arr = () (out [?]t) {\n    out = 0\n}')
    want = 'Program{}\n    FunctionDefinition{name: []t.to-arr, methodDef: true}\n        GenericParams: t\n        Parameter{name: self, type: []t}\n            SliceType{}\n                NamedType{name: t}\n        Parameter{name: out, type: [?]t}\n            ArrayType{size: <nil>}\n                NamedType{name: t}\n        BlockStatement{}\n            LetStatement{name: out, type: i64, value: 0}\n                NamedType{name: i64, inferred: true}\n                IntegerLiteral{value: 0, raw: 0}'
    runner.is-true(got.eq-full(want), '(out [?]t) -> one Parameter ArrayType{size:<nil>} + GenericParams: t (not split into out/t)')
}

; ═══════════════════════════════════════════════

test-in-index-rhs()
test-in-call-arg()
test-in-grouped-inline-if()
test-in-grouped-compare-let()
test-control-no-in()
test-array-recv-generic()
test-array-param-generic-size()
test-slice-recv-no-generic()
test-slice-recv-generic-from-param()
test-param-nullable-size-array()

; ═══════════════════════════════════
; 10. S7 裁定①（2026-10-21）：match 產 SurfaceMatch（預設開 PS-SURFACE-MATCH=1）
;     `z: { 1 -> a = 1 / _ -> a = 2 }` 舊缺陷（s66c claim B）：內聯臂體用
;     ps-parse-expr-prec 只能吃到 `a`，`= 1` 遺留成幻影臂 ⇒ 產出 4 個巢狀
;     IfExpression、主體切碎。修復後（內聯臂體改以 ps-parse-stmt 解析）：
;     正好 2 臂、主體完整。
;     期望值 = L2 oracle 實測（`./bin/no ast`）的 SurfaceMatch 輸出——裁定① 後
;     noc 預設與 oracle 同形，本測試同時釘住「臂迴圈不碎」與「surface 形
;     逐位元組對齊 oracle」。
; ═══════════════════════════════════

test-match-arm-loop-fix = () {
    got = parse-dump('z = 1\nz: {\n    1 -> a = 1\n    _ -> a = 2\n}')
    want = 'Program{}\n    LetStatement{name: z, type: i64, value: 1}\n        NamedType{name: i64, inferred: true}\n        IntegerLiteral{value: 1, raw: 1}\n    ExpressionStatement{SurfaceMatch}\n        SurfaceMatch{arms: 2}\n            Identifier{name: z}\n            MatchArm{binding: , bindingVariant: }\n                IntegerLiteral{value: 1, raw: 1}\n                BlockStatement{inline: true}\n                    LetStatement{name: a, type: i64, value: 1}\n                        NamedType{name: i64, inferred: true}\n                        IntegerLiteral{value: 1, raw: 1}\n            MatchArm{wildcard: true, binding: , bindingVariant: }\n                BlockStatement{inline: true}\n                    LetStatement{name: a, type: i64, value: 2}\n                        NamedType{name: i64, inferred: true}\n                        IntegerLiteral{value: 2, raw: 2}'
    runner.is-true(got.eq-full(want), 'z: {…} -> SurfaceMatch 2 arms byte-identical to oracle (S7 ruling 1)')
}

test-match-arm-loop-fix()

; ═══════════════════════════════════
; 11. S7 裁定①續：裸 match（{ cond -> body }）產 SurfaceMatch{**無 Matched**}。
;     舊缺陷：ps-parse-bare-match 只組 if/else 鏈、無 surface 發射 ⇒ 與 oracle
;     的 SurfaceMatch 形 100% 分歧（L2 殘差最大單一來源，169 檔 count_gap）。
;     期望值 = L2 oracle 實測。⚠️ Matched 必須佔一個 0 kid（不佔位 ⇒ kid0 與
;     下一節點 kid 槽別名 ⇒ dump 無限遞迴 SIGSEGV，實測踩過）。
; ═══════════════════════════════════

test-bare-match-surface = () {
    got = parse-dump('f = (i i64, n i64) (val ?i64) {\n    {\n        i < 0 -> val = nil\n\n        i >= n -> val = nil\n\n        -> val = 1\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: f}\n        Parameter{name: i, type: i64}\n            NamedType{name: i64}\n        Parameter{name: n, type: i64}\n            NamedType{name: i64}\n        Parameter{name: val, type: ?i64}\n            NullableType\n                NamedType{name: i64}\n        BlockStatement{}\n            ExpressionStatement{SurfaceMatch}\n                SurfaceMatch{arms: 3}\n                    MatchArm{binding: , bindingVariant: }\n                        InfixExpression{op: <}\n                            Identifier{name: i}\n                            IntegerLiteral{value: 0, raw: 0}\n                        BlockStatement{inline: true}\n                            LetStatement{name: val, value: nil}\n                                NilLiteral\n                    MatchArm{binding: , bindingVariant: }\n                        InfixExpression{op: >=}\n                            Identifier{name: i}\n                            Identifier{name: n}\n                        BlockStatement{inline: true}\n                            LetStatement{name: val, value: nil}\n                                NilLiteral\n                    MatchArm{wildcard: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            LetStatement{name: val, type: i64, value: 1}\n                                NamedType{name: i64, inferred: true}\n                                IntegerLiteral{value: 1, raw: 1}'
    runner.is-true(got.eq-full(want), '{ cond -> … } -> SurfaceMatch 3 arms, no Matched (S7 ruling 1)')
}

; ═══════════════════════════════════
; 12. S7 裁定①續：裸 match 的 `ok->`（dotVal 臂）——oracle match.go:347-357
;     產 wildcard+dotVal 且【保留】Condition=Identifier{ok}（P1 不丟源碼識別字）。
;     明示 match 的 ok-> 則 cond=0——兩路口徑不同，各自對齊各自的 oracle。
;     舊缺陷：ps-parse-bare-match 對 ok-> 整體 fail=1 退讓。
; ═══════════════════════════════════

test-bare-match-ok-dotval = () {
    got = parse-dump('ok = true\n{\n    ok -> print(1)\n\n    -> print(2)\n}')
    want = 'Program{}\n    LetStatement{name: ok, type: bool, value: true}\n        NamedType{name: bool, inferred: true}\n        BooleanLiteral{true}\n    ExpressionStatement{SurfaceMatch}\n        SurfaceMatch{arms: 2}\n            MatchArm{wildcard: true, dotVal: true, binding: , bindingVariant: }\n                Identifier{name: ok}\n                BlockStatement{inline: true}\n                    ExpressionStatement{CallExpression}\n                        CallExpression{fn: print, args: 1}\n                            Identifier{name: print}\n                            IntegerLiteral{value: 1, raw: 1}\n            MatchArm{wildcard: true, binding: , bindingVariant: }\n                BlockStatement{inline: true}\n                    ExpressionStatement{CallExpression}\n                        CallExpression{fn: print, args: 1}\n                            Identifier{name: print}\n                            IntegerLiteral{value: 2, raw: 2}'
    runner.is-true(got.eq-full(want), 'bare ok-> -> wildcard+dotVal with Condition=Identifier{ok} kept (S7 ruling 1)')
}

; ═══════════════════════════════════
; 13. s67 讀點修正（s7）：明示 match 值語境 valueCtx 必須【入函快照】。
;     舊缺陷：發射時尾讀活 p.valCtx，但臂體 ps-parse-stmt 每陳述把它重置為 0
;     ⇒ `r = n: { -> 1 }` 漏 valueCtx: true（L2 flag_gap 一源）。
; ═══════════════════════════════════

test-match-valuectx-snapshot = () {
    got = parse-dump('test1 = () {\n    n = 42\n    r = n: {\n        -> 1\n    }\n    print(r)\n}')
    want = 'Program{}\n    FunctionDefinition{name: test1}\n        BlockStatement{}\n            LetStatement{name: n, type: i64, value: 42}\n                NamedType{name: i64, inferred: true}\n                IntegerLiteral{value: 42, raw: 42}\n            LetStatement{name: r, value: SurfaceMatch}\n                SurfaceMatch{arms: 1}\n                    Identifier{name: n}\n                    MatchArm{wildcard: true, valueCtx: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{1}\n                                IntegerLiteral{value: 1, raw: 1}\n            ExpressionStatement{CallExpression}\n                CallExpression{fn: print, args: 1}\n                    Identifier{name: print}\n                    Identifier{name: r}'
    runner.is-true(got.eq-full(want), 'r = n: { -> 1 } -> MatchArm valueCtx: true survives arm-body stmt resets')
}

test-bare-match-surface()
test-bare-match-ok-dotval()
test-match-valuectx-snapshot()


; ═══════════════════════════════════════════════════════════════════════
; s7 裁定①續 C：型別臂 `v T ->` 三槽（typeArm/typePattern/typeBinding）。
;     舊缺陷：generic expr 臂吞掉 `v bool` 兩 IDENT 後見 -> 當空 pattern
;     ⇒ typeArm/typePattern/typeBinding 全空（L2 flag_gap 一源）。
; ═══════════════════════════════════════════════════════════════════════

test-match-type-arm = () {
    got = parse-dump('classify = (v i64) (out i64) {\n    out = v: {\n        v bool -> 1\n\n        -> 2\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: classify}\n        Parameter{name: v, type: i64}\n            NamedType{name: i64}\n        Parameter{name: out, type: i64}\n            NamedType{name: i64}\n        BlockStatement{}\n            LetStatement{name: out, value: SurfaceMatch}\n                SurfaceMatch{arms: 2}\n                    Identifier{name: v}\n                    MatchArm{typeArm: true, typePattern: bool, typeBinding: v, valueCtx: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{1}\n                                IntegerLiteral{value: 1, raw: 1}\n                    MatchArm{wildcard: true, valueCtx: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{2}\n                                IntegerLiteral{value: 2, raw: 2}'
    runner.is-true(got.eq-full(want), 'v bool -> typeArm/typePattern/typeBinding 三槽齊')
}

; ═══════════════════════════════════════════════════════════════════════
; s7 裁定①續 D：列舉變體解構 `circle(r) ->` 保持 CallExpression pattern。
;     舊缺陷：PS-SURFACE-MATCH==1 仍走 parse-time 變體歸一 ⇒ binding 被填
;     （oracle 解析期不歸一，留空 binding + CallExpression 子樹）。
; ═══════════════════════════════════════════════════════════════════════

test-match-enum-variant-pattern = () {
    got = parse-dump('kind = (s Shape) (out i64) {\n    out = s: {\n        circle(r) -> 1\n\n        rect(w, h) -> 2\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: kind}\n        Parameter{name: s, type: Shape}\n            NamedType{name: Shape}\n        Parameter{name: out, type: i64}\n            NamedType{name: i64}\n        BlockStatement{}\n            LetStatement{name: out, value: SurfaceMatch}\n                SurfaceMatch{arms: 2}\n                    Identifier{name: s}\n                    MatchArm{valueCtx: true, binding: , bindingVariant: }\n                        CallExpression{fn: circle, args: 1}\n                            Identifier{name: circle}\n                            Identifier{name: r}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{1}\n                                IntegerLiteral{value: 1, raw: 1}\n                    MatchArm{valueCtx: true, binding: , bindingVariant: }\n                        CallExpression{fn: rect, args: 2}\n                            Identifier{name: rect}\n                            Identifier{name: w}\n                            Identifier{name: h}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{2}\n                                IntegerLiteral{value: 2, raw: 2}'
    runner.is-true(got.eq-full(want), 'circle(r) -> CallExpression pattern 保持、binding 空')
}

test-match-type-arm()
test-match-enum-variant-pattern()


; ═══════════════════════════════════════════════════════════════════════
; s7 續 E：NEWLINE 臂體形 + 空臂體（oracle expr.go:1251-1376 第二支）。
;     舊缺陷：`->` 後 ps-skip-trivia 吞換行 ⇒ NEWLINE 形不可見，`err ->\n\nnil ->`
;     空臂體被下臂吸成 if 陳述（map.no count_gap）；blockBody+inline 雙旗漏。
; ═══════════════════════════════════════════════════════════════════════

test-match-newline-empty-arms = () {
    got = parse-dump('f = (val ?i64) (found bool) {\n    val: {\n        ok -> found = true\n\n        err ->\n\n        nil ->\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: f}\n        Parameter{name: val, type: ?i64}\n            NullableType\n                NamedType{name: i64}\n        Parameter{name: found, type: bool}\n            NamedType{name: bool}\n        BlockStatement{}\n            ExpressionStatement{SurfaceMatch}\n                SurfaceMatch{arms: 3}\n                    Identifier{name: val}\n                    MatchArm{wildcard: true, dotVal: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            LetStatement{name: found, type: bool, value: true}\n                                NamedType{name: bool, inferred: true}\n                                BooleanLiteral{true}\n                    MatchArm{blockBody: true, binding: , bindingVariant: }\n                        Identifier{name: err}\n                        BlockStatement{inline: true}\n                    MatchArm{blockBody: true, binding: , bindingVariant: }\n                        NilLiteral\n                        BlockStatement{inline: true}'
    runner.is-true(got.eq-full(want), 'err ->\n\nnil -> 空臂體 + blockBody/inline 雙旗齊')
}

; ═══════════════════════════════════════════════════════════════════════
; s7 續 F：range 型樣 `[a..b)`（Go parseSliceLiteral range 分支）。
;     舊缺陷：LBRACKET primary 一律建 SliceLiteral ⇒ `[0..60) ->` 被吞成
;     SliceLiteral4（match-range-pattern.no / fmt-heuristic.no / str-order.no）。
; ═══════════════════════════════════════════════════════════════════════

test-match-range-pattern = () {
    got = parse-dump('grade = (score i64) (g i64) {\n    g = score: {\n        [0..60) -> 1\n\n        -> 2\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: grade}\n        Parameter{name: score, type: i64}\n            NamedType{name: i64}\n        Parameter{name: g, type: i64}\n            NamedType{name: i64}\n        BlockStatement{}\n            LetStatement{name: g, value: SurfaceMatch}\n                SurfaceMatch{arms: 2}\n                    Identifier{name: score}\n                    MatchArm{valueCtx: true, binding: , bindingVariant: }\n                        RangeExpression{start: 0, end: 60, leftInc: true}\n                            IntegerLiteral{value: 0, raw: 0}\n                            IntegerLiteral{value: 60, raw: 60}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{1}\n                                IntegerLiteral{value: 1, raw: 1}\n                    MatchArm{wildcard: true, valueCtx: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{2}\n                                IntegerLiteral{value: 2, raw: 2}'
    runner.is-true(got.eq-full(want), '[0..60) -> RangeExpression 型樣臂（leftInc=true）')
}

test-match-newline-empty-arms()
test-match-range-pattern()


; ═══════════════════════════════════════════════════════════════════════
; s7 續 G：`name ?T` 裸宣告（無 `=`）不得吞後隨陳述當 RHS。
;     舊缺陷：ps-expect(ASSIGN) 失敗不退 ⇒ `x: {…}` 被吃成 LetStatement.value
;     且 valCtx=1 污染 MatchArm.valueCtx（match-test.no flag_gap 根因）。
; ═══════════════════════════════════════════════════════════════════════

test-nullable-let-no-value = () {
    got = parse-dump('test = () {\n    x ?i64\n    x: {\n        ok -> print(1)\n\n        -> print(2)\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: test}\n        BlockStatement{}\n            LetStatement{name: x, type: ?i64, value: }\n                NullableType\n                    NamedType{name: i64}\n            ExpressionStatement{SurfaceMatch}\n                SurfaceMatch{arms: 2}\n                    Identifier{name: x}\n                    MatchArm{wildcard: true, dotVal: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: print, args: 1}\n                                    Identifier{name: print}\n                                    IntegerLiteral{value: 1, raw: 1}\n                    MatchArm{wildcard: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: print, args: 1}\n                                    Identifier{name: print}\n                                    IntegerLiteral{value: 2, raw: 2}'
    runner.is-true(got.eq-full(want), 'x ?i64 裸宣告 value 缺席、match 獨立陳述、valueCtx 不污染')
}

; ═══════════════════════════════════════════════════════════════════════
; s7 續 H/H2：blockMatch 分類臂體的回退塊提取口徑（err-binding.no 形）。
;     `err(m) -> { b: {…} … }`：classify=blockMatch（labelled block/match）但
;     內層裸 match 失敗 ⇒ oracle parseStatement 落 parseBlockStatement 回退並
;     【提取】陳述：IsBlockBody 保持 false、IsInline=true。加 bodyDone 防
;     NEWLINE 形分支誤觸發抬 hd2。
; ═══════════════════════════════════════════════════════════════════════

test-match-blockmatch-fallback-extract = () {
    got = parse-dump('f = (val ?i64) (found bool) {\n    val: {\n        ok -> found = true\n\n        err(m) -> {\n            b: {\n                ok -> found = true\n            }\n        }\n\n        nil -> found = false\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: f}\n        Parameter{name: val, type: ?i64}\n            NullableType\n                NamedType{name: i64}\n        Parameter{name: found, type: bool}\n            NamedType{name: bool}\n        BlockStatement{}\n            ExpressionStatement{SurfaceMatch}\n                SurfaceMatch{arms: 3}\n                    Identifier{name: val}\n                    MatchArm{wildcard: true, dotVal: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            LetStatement{name: found, type: bool, value: true}\n                                NamedType{name: bool, inferred: true}\n                                BooleanLiteral{true}\n                    MatchArm{binding: m, bindingVariant: err}\n                        Identifier{name: err}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{SurfaceMatch}\n                                SurfaceMatch{arms: 1}\n                                    Identifier{name: b}\n                                    MatchArm{wildcard: true, dotVal: true, binding: , bindingVariant: }\n                                        BlockStatement{inline: true}\n                                            LetStatement{name: found, type: bool, value: true}\n                                                NamedType{name: bool, inferred: true}\n                                                BooleanLiteral{true}\n                    MatchArm{binding: , bindingVariant: }\n                        NilLiteral\n                        BlockStatement{inline: true}\n                            LetStatement{name: found, type: bool, value: false}\n                                NamedType{name: bool, inferred: true}\n                                BooleanLiteral{false}'
    runner.is-true(got.eq-full(want), 'err(m) -> { b: {…} } 提取形：無 blockBody + inline 體')
}

test-nullable-let-no-value()
test-match-blockmatch-fallback-extract()

; ═══════════════════════════════════════════════════════════════════════
; s7 續 I：嵌套 cond-if 鏈（`a -> b -> { … }`）內層 if 的本體不得丟失。
;     舊缺陷：ps-wrap-chain 遞迴呼叫把 `linkIdx + 1`（option 算術 ?i64 雙字）
;     內聯作實參 ⇒ 呼叫 ABI 實參錯位，callee 收到 blk=0/tail=0 ⇒ 最內層
;     IfExpression 本體被靜默丟棄（bzip2 `sym > 1 -> sym < eob -> { … }`
;     整塊消失、內含 match 陳述組全沒——gap I 根因）。修復：預計算 lid。
; ═══════════════════════════════════════════════════════════════════════

test-match-nested-cond-if-chain = () {
    got = parse-dump('f = (x i64) (r i64) {\n    a [4]i64\n    x > 1 -> x < 10 -> {\n        a[0]: {\n            ok -> it = 1\n            -> _\n        }\n    }\n}')
    want = 'Program{}\n    FunctionDefinition{name: f}\n        Parameter{name: x, type: i64}\n            NamedType{name: i64}\n        Parameter{name: r, type: i64}\n            NamedType{name: i64}\n        BlockStatement{}\n            LetStatement{name: a, type: [4]i64, value: }\n                ArrayType{size: 4}\n                    IntegerLiteral{value: 4, raw: 4}\n                    NamedType{name: i64}\n            ExpressionStatement{IfExpression}\n                IfExpression\n                    InfixExpression{op: >}\n                        Identifier{name: x}\n                        IntegerLiteral{value: 1, raw: 1}\n                    BlockStatement{inline: true}\n                        ExpressionStatement{IfExpression}\n                            IfExpression\n                                InfixExpression{op: <}\n                                    Identifier{name: x}\n                                    IntegerLiteral{value: 10, raw: 10}\n                                BlockStatement{}\n                                    ExpressionStatement{SurfaceMatch}\n                                        SurfaceMatch{arms: 2}\n                                            IndexExpression\n                                                Identifier{name: a}\n                                                IntegerLiteral{value: 0, raw: 0}\n                                            MatchArm{wildcard: true, dotVal: true, binding: , bindingVariant: }\n                                                BlockStatement{inline: true}\n                                                    LetStatement{name: it, type: i64, value: 1}\n                                                        NamedType{name: i64, inferred: true}\n                                                        IntegerLiteral{value: 1, raw: 1}\n                                            MatchArm{wildcard: true, binding: , bindingVariant: }\n                                                BlockStatement{inline: true}\n                                                    ExpressionStatement{nil}'
    runner.is-true(got.eq-full(want), '嵌套 cond-if 鏈內層體完整（複雜主體 match 在內層塊中不丟）')
}

test-match-nested-cond-if-chain()

; ═══════════════════════════════════════════════════════════════════════
; s7 續 J：`for v <- range: stmt` 行內迴圈體——只綁一條陳述、inline: true、
;     不偷外層收束括號。舊缺陷：ps-expect(LBRACE) 靜默放行 + ps-parse-block
;     開區間 ⇒ 行內形吞到下一個 `}`，後隨陳述進迴圈體、外層 `}` 被偷
;     （yaml.no parse-block-scalar 級聯誤解析根因：13,831 行 dump 發散）。
; ═══════════════════════════════════════════════════════════════════════

test-for-inline-body = () {
    got = parse-dump('f = (x i64) (r i64) {\n    n = 5\n    k <- [0..n):\n        r = r + 1\n        r = r + 2\n    r = 1\n}')
    want = 'Program{}\n    FunctionDefinition{name: f}\n        Parameter{name: x, type: i64}\n            NamedType{name: i64}\n        Parameter{name: r, type: i64}\n            NamedType{name: i64}\n        BlockStatement{}\n            LetStatement{name: n, type: i64, value: 5}\n                NamedType{name: i64, inferred: true}\n                IntegerLiteral{value: 5, raw: 5}\n            ForStatement{label: }\n                IterationExpr{var: k}\n                    RangeExpression{start: 0, end: n, leftInc: true}\n                        IntegerLiteral{value: 0, raw: 0}\n                        Identifier{name: n}\n                BlockStatement{inline: true}\n                    LetStatement{name: r, value: InfixExpression}\n                        InfixExpression{op: +}\n                            Identifier{name: r}\n                            IntegerLiteral{value: 1, raw: 1}\n            LetStatement{name: r, value: InfixExpression}\n                InfixExpression{op: +}\n                    Identifier{name: r}\n                    IntegerLiteral{value: 2, raw: 2}\n            LetStatement{name: r, type: i64, value: 1}\n                NamedType{name: i64, inferred: true}\n                IntegerLiteral{value: 1, raw: 1}'
    runner.is-true(got.eq-full(want), 'for v <- range: stmt 行內體只綁一條陳述 + inline: true')
}

test-for-inline-body()

; ═══════════════════════════════════════════════════════════════════════
; s7 續 K：賦值 RHS 位裸 match 運算式（`result = { pat -> … }`）——
;     value 掛 LetStatement、臂帶 valueCtx: true。舊缺陷：ps-parse-expr-prec
;     primary 位無 LBRACE 臂 ⇒ RHS 回空、裸 match 落回陳述位重解析
;     ⇒ valueCtx 全丟（build-mo flag_gap 根因）。
; ═══════════════════════════════════════════════════════════════════════

test-let-rhs-bare-match = () {
    got = parse-dump('x = 0\nresult = {\n    x == 0 -> 1\n\n    x == x -> 0\n}')
    want = 'Program{}\n    LetStatement{name: x, type: i64, value: 0}\n        NamedType{name: i64, inferred: true}\n        IntegerLiteral{value: 0, raw: 0}\n    LetStatement{name: result, value: SurfaceMatch}\n        SurfaceMatch{arms: 2}\n            MatchArm{valueCtx: true, binding: , bindingVariant: }\n                InfixExpression{op: ==}\n                    Identifier{name: x}\n                    IntegerLiteral{value: 0, raw: 0}\n                BlockStatement{inline: true}\n                    ExpressionStatement{1}\n                        IntegerLiteral{value: 1, raw: 1}\n            MatchArm{valueCtx: true, binding: , bindingVariant: }\n                InfixExpression{op: ==}\n                    Identifier{name: x}\n                    Identifier{name: x}\n                BlockStatement{inline: true}\n                    ExpressionStatement{0}\n                        IntegerLiteral{value: 0, raw: 0}'
    runner.is-true(got.eq-full(want), 'RHS 裸 match 掛 value + 臂 valueCtx: true')
}

test-let-rhs-bare-match()

; ═══════════════════════════════════════════════════════════════════
; s7 續 L：let RHS 陣列/切片索引推元素型別（Go stmt.go:1462-1494）。
;     全域 receiver（[]i64/[]char）⇒ 補 type + NamedType{inferred}；
;     函式內 receiver 不推（Go setVarType 函式內只寫 FuncVarTypes，
;     IndexExpression 臂只讀全域 p.sem.VarTypes）。
;     ⚠️ 本測試同時看守 s7l 教訓：ps-parse-let 的 IndexExpression 臂
;     局部變數不得與 catch-all 的 tn 同名——同名會讓 codegen 串型別，
;     ps-infer-type 回傳值被截成形別名長度（i64→"3"），汙染全域。
; ═══════════════════════════════════════════════════════════════════

test-let-idx-elem-infer = () {
    got = parse-dump('v = [1, 2, 3]\ne0 = v[0]\ns = ["a", "b"]\ne2 = s[0]\ng = () {\n    w = [1.5, 2.5]\n    e1 = w[0]\n}')
    want = 'Program{}\n    LetStatement{name: v, type: []i64, value: SliceLiteral}\n        SliceType{inferred: true}\n            NamedType{name: i64, inferred: true}\n        SliceLiteral{elements: 3}\n            IntegerLiteral{value: 1, raw: 1}\n            IntegerLiteral{value: 2, raw: 2}\n            IntegerLiteral{value: 3, raw: 3}\n    LetStatement{name: e0, type: i64, value: IndexExpression}\n        NamedType{name: i64, inferred: true}\n        IndexExpression\n            Identifier{name: v}\n            IntegerLiteral{value: 0, raw: 0}\n    LetStatement{name: s, type: []char, value: SliceLiteral}\n        SliceType{inferred: true}\n            NamedType{name: char, inferred: true}\n        SliceLiteral{elements: 2}\n            CharLiteral{value: a}\n            CharLiteral{value: b}\n    LetStatement{name: e2, type: char, value: IndexExpression}\n        NamedType{name: char, inferred: true}\n        IndexExpression\n            Identifier{name: s}\n            IntegerLiteral{value: 0, raw: 0}\n    FunctionDefinition{name: g}\n        BlockStatement{}\n            LetStatement{name: w, type: []f64, value: SliceLiteral}\n                SliceType{inferred: true}\n                    NamedType{name: f64, inferred: true}\n                SliceLiteral{elements: 2}\n                    FloatLiteral{value: 1.5, raw: 1.5}\n                    FloatLiteral{value: 2.5, raw: 2.5}\n            LetStatement{name: e1, value: IndexExpression}\n                IndexExpression\n                    Identifier{name: w}\n                    IntegerLiteral{value: 0, raw: 0}'
    runner.is-true(got.eq-full(want), '索引推元素型別：全域 []i64→i64/[]char→char；函式內 receiver 不推')
}

test-let-idx-elem-infer()

; ═══════════════════════════════════════════════════════════════════
; s8q：let RHS 的 pipeline 同位——`x = A -> B`【整條鏈】是 let 的 value
;     （包成 IfExpression），不是「let 吃掉 A、`-> B` 另起獨立陳述」。
;     鏡像 Go parseLetStatement（stmt.go:1242-1260）。覆蓋：
;       · 推論型 `x = 2 > 1 -> 42`（ps-parse-let）；
;       · 鏈式 `q = a > 0 -> 8 -> 9`（右接 `if a>0 { if 8 { 9 } }`）；
;       · 明示型別 `p i64 = a > 1 -> 42`（ps-parse-stmt 明示型別臂，型別仍保留）。
;     舊缺陷：value 解析後未檢查同位 `->` ⇒ LetStatement{value: InfixExpression}
;     + 分離 ExpressionStatement{IfExpression}（且推論臂誤傳 i64 型別）。
;     want 由 L2 oracle 實測取得（`./bin/no ast`）。
; ═══════════════════════════════════════════════════════════════════

test-let-pipeline-value = () {
    got = parse-dump('a i64 = 5\nx = 2 > 1 -> 42\nq = a > 0 -> 8 -> 9\np i64 = a > 1 -> 42\n')
    want = 'Program{}\n    LetStatement{name: a, type: i64, value: 5}\n        NamedType{name: i64}\n        IntegerLiteral{value: 5, raw: 5}\n    LetStatement{name: x, value: IfExpression}\n        IfExpression\n            InfixExpression{op: >}\n                IntegerLiteral{value: 2, raw: 2}\n                IntegerLiteral{value: 1, raw: 1}\n            BlockStatement{inline: true}\n                ExpressionStatement{42}\n                    IntegerLiteral{value: 42, raw: 42}\n    LetStatement{name: q, value: IfExpression}\n        IfExpression\n            InfixExpression{op: >}\n                Identifier{name: a}\n                IntegerLiteral{value: 0, raw: 0}\n            BlockStatement{inline: true}\n                ExpressionStatement{IfExpression}\n                    IfExpression\n                        IntegerLiteral{value: 8, raw: 8}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{9}\n                                IntegerLiteral{value: 9, raw: 9}\n    LetStatement{name: p, type: i64, value: IfExpression}\n        NamedType{name: i64}\n        IfExpression\n            InfixExpression{op: >}\n                Identifier{name: a}\n                IntegerLiteral{value: 1, raw: 1}\n            BlockStatement{inline: true}\n                ExpressionStatement{42}\n                    IntegerLiteral{value: 42, raw: 42}'
    runner.is-true(got.eq-full(want), 'let RHS pipeline 同位為 IfExpression value（推論/鏈式/明示型別）')
}

test-let-pipeline-value()

; s8q 反向看守：`a \n -> b`（arrow 換行）【不】構成 pipeline——對齊 Go
;     只看 currentToken==RARROW（活 ps-peek 不跳 trivia）。let 值後換行、
;     下個非 trivia 才是 `->` ⇒ let 只吃 `a`，`-> b` 另起 wildcard 陳述。
test-let-pipeline-no-newline = () {
    got = parse-dump('a i64 = 5\nx = a\n-> b\n')
    want = 'Program{}\n    LetStatement{name: a, type: i64, value: 5}\n        NamedType{name: i64}\n        IntegerLiteral{value: 5, raw: 5}\n    LetStatement{name: x, type: i64, value: a}\n        NamedType{name: i64, inferred: true}\n        Identifier{name: a}\n    ExpressionStatement{IfExpression}\n        IfExpression\n            IntegerLiteral{value: 1}\n            BlockStatement{inline: true}\n                ExpressionStatement{b}\n                    Identifier{name: b}'
    runner.is-true(got.eq-full(want), 'arrow 換行不構成 pipeline let（活 ps-peek 守則）')
}

test-let-pipeline-no-newline()

; ═══════════════════════════════════════════════════════════════════
; s8t（Family F / match-test.no）：兩項 parse 期缺陷。
;   (A) warnUnreachableArms（Go match_warn.go）：主語為 option（ok/err/nil 全列）
;       或 enum（全變體列舉）、含裸 wildcard `->` 臂、且無 raw-cond 臂 ⇒ 該 `->`
;       臂為死碼，parse 期 saveWarning ⇒ dump 現 `Program{warnings: N}`。
;       noc 鏡像：ps-parse-match 既有 `dead` 旗標（option 8541 / enum 8597）累加
;       deadTotal，臂迴圈走完后以 matchHasRaw==0 閘控入 p.warn。
;   (B) 裸可空宣告 `x ?i64`（ps-parse-stmt QUESTION 臂）舊行為 destructive
;       ps-skip-trivia 吞掉型別後換行＋行前註解 ⇒ 註解無法成下一陳述 Doc。
;       修：鏡像 ps-parse-typedecl 非破壞性 ps-peek 判 `=`（去 ps-skip-trivia）。
;   want 由 L2 oracle 實測取得（`./bin/no ast`）。
; ═══════════════════════════════════════════════════════════════════

test-match-unreachable-warn-option = () {
    got = parse-dump('f = () {\n    x ?i64\n    x: {\n        err -> log()\n        nil -> log()\n        ok -> log()\n        -> log()\n    }\n}')
    want = 'Program{warnings: 1}\n    FunctionDefinition{name: f}\n        BlockStatement{}\n            LetStatement{name: x, type: ?i64, value: }\n                NullableType\n                    NamedType{name: i64}\n            ExpressionStatement{SurfaceMatch}\n                SurfaceMatch{arms: 4}\n                    Identifier{name: x}\n                    MatchArm{binding: , bindingVariant: }\n                        Identifier{name: err}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: log}\n                                    Identifier{name: log}\n                    MatchArm{binding: , bindingVariant: }\n                        NilLiteral\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: log}\n                                    Identifier{name: log}\n                    MatchArm{wildcard: true, dotVal: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: log}\n                                    Identifier{name: log}\n                    MatchArm{wildcard: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: log}\n                                    Identifier{name: log}'
    runner.is-true(got.eq-full(want), 'option 主語 ok/err/nil 全列＋裸 -> 死碼臂 ⇒ warnings:1')
}

test-match-unreachable-warn-option()

test-match-unreachable-warn-enum = () {
    got = parse-dump('status {\n    status1,\n    status2,\n}\ng = () {\n    s status\n    s: {\n        status1 -> log()\n        status2 -> log()\n        -> log()\n    }\n}')
    want = 'Program{warnings: 1}\n    EnumDefinition{name: status, values: 2}\n        EnumValue{name: status1, value: 0}\n        EnumValue{name: status2, value: 1}\n    FunctionDefinition{name: g}\n        BlockStatement{}\n            LetStatement{name: s, type: status, value: }\n                NamedType{name: status}\n            ExpressionStatement{SurfaceMatch}\n                SurfaceMatch{arms: 3}\n                    Identifier{name: s}\n                    MatchArm{binding: , bindingVariant: }\n                        Identifier{name: status1}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: log}\n                                    Identifier{name: log}\n                    MatchArm{binding: , bindingVariant: }\n                        Identifier{name: status2}\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: log}\n                                    Identifier{name: log}\n                    MatchArm{wildcard: true, binding: , bindingVariant: }\n                        BlockStatement{inline: true}\n                            ExpressionStatement{CallExpression}\n                                CallExpression{fn: log}\n                                    Identifier{name: log}'
    runner.is-true(got.eq-full(want), 'enum 主語全變體列舉＋裸 -> 死碼臂 ⇒ warnings:1')
}

test-match-unreachable-warn-enum()

test-bare-nullable-doc-attach = () {
    got = parse-dump('d = () {\n    x ?i64\n\n    ; 這是下一陳述的 Doc\n    a i64 = 1\n}')
    want = 'Program{}\n    FunctionDefinition{name: d}\n        BlockStatement{}\n            LetStatement{name: x, type: ?i64, value: }\n                NullableType\n                    NamedType{name: i64}\n            LetStatement{name: a, type: i64, value: 1}\n                Doc: // 這是下一陳述的 Doc\n                NamedType{name: i64}\n                IntegerLiteral{value: 1, raw: 1}'
    runner.is-true(got.eq-full(want), '裸可空宣告後行前註解保留為下一陳述 Doc（非破壞性 peek）')
}

test-bare-nullable-doc-attach()

; ═══════════════════════════════════════════════════════════════════
; s8u（vec-elem-ownership.no）：map 標註 let `name [K]V = { … }`——舊 map 臂只認
;     單 IDENT 值型別（+4==IDENT +5==ASSIGN），複合 V（`[]i64`/`?i64`/`[N]i64`）
;     落到通用 ps-parse-typedecl ⇒ `{ }` 被 ps-is-struct-lit 誤判 StructLiteral。
;     修：V【經 ps-parse-type 遞迴】、以 ps-is-map-assign-let 前探確認 `=`（裸 map
;     宣告 `m1 [str]i64` 無 `=` 不得誤入），再型別導向：RHS 起於 { ⇒ MapLiteral。
;     ⚠️ 教訓（見 §5.3.4.ag）：塊內各 `cond -> stmt` 為獨立 bare-if，裸 `-> else`
;     僅掛在最末臂 ⇒ 掃描迴圈的 catch-all 須顯式列全【已處理 token 補集】。
;     want 由 L2 oracle 實測取得。
; ═══════════════════════════════════════════════════════════════════

test-map-annotated-composite-value-literal = () {
    got = parse-dump('f = () {\n    m [str][]i64 = { }\n    n [str]i64 = { \'a\': 1, \'b\': 2 }\n}')
    want = 'Program{}\n    FunctionDefinition{name: f}\n        BlockStatement{}\n            LetStatement{name: m, type: [str][]i64, value: MapLiteral}\n                MapType{}\n                    NamedType{name: str}\n                    SliceType{}\n                        NamedType{name: i64}\n                MapLiteral{}\n                    MapType{}\n                        NamedType{name: str}\n                        SliceType{}\n                            NamedType{name: i64}\n            LetStatement{name: n, type: [str]i64, value: MapLiteral}\n                MapType{}\n                    NamedType{name: str}\n                    NamedType{name: i64}\n                MapLiteral{pairs: 2}\n                    MapPair\n                        StringLiteral{value: a}\n                        IntegerLiteral{value: 1, raw: 1}\n                    MapPair\n                        StringLiteral{value: b}\n                        IntegerLiteral{value: 2, raw: 2}\n                    MapType{}\n                        NamedType{name: str}\n                        NamedType{name: i64}'
    runner.is-true(got.eq-full(want), 'map 標註 let 複合值型別 []i64/單 ident ⇒ MapLiteral（型別導向）')
}

test-map-annotated-composite-value-literal()

