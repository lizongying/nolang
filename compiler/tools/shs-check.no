; ═══════════════════════════════════════════════════════════════════
; shs-check — SHS（Self-Hosting Subset）白名單守護
; ═══════════════════════════════════════════════════════════════════
;
; 構建：  ./bin/no build -o /tmp/shs-check compiler/tools/shs-check.no
; 執行：  /tmp/shs-check compiler/src compiler/tests compiler/tools
; 退出碼：0 乾淨 / 1 有違規 / 2 用法錯誤
;
; ── 為什麼不是「正則掃描」──
; Nolang 有三種註釋（`;` 行 / `//` 行 / `;;…;;` 塊），且 `/` 上下文敏感
; （正則字面量 vs 除法）。一個只認 `//` 與 `/* */` 的掃描器會把 `;` 註釋裡的
; 中文當成程式碼。所以本檔先做**字符級狀態機**：把註釋整段換成空白、把字面量
; 的**內容**換成 `x`（保留引號），輸出與原檔**等長、等行**。所有檢查都在遮罩
; 後的文本上做。
;
; 註釋語義照抄 `src/lexer/lexer.go`（`isBlockCommentStart` / `readBlockComment`
; / `case ';'` / `case '/'`），不是猜的：
;   `;`     行註釋到行尾
;   `//`    行註釋到行尾（永遠優先於正則）
;   `;;`    其後（跳過空白）是換行/EOF ⇒ 塊註釋，直到另一個同樣條件的 `;;`
;   `;;`    其後還有內容              ⇒ 行註釋到行尾
;
; ── 已知近似（寫明，不隱藏）──
; `/` 的正則判定在字符層無法完全複製 `src/lexer` 的 `prevTokenType` 規則
; （`a-b` 是識別符而 `a - b` 是減法，字符層分不出）。近似規則見
; `shs-slash-regex`。**`compiler/` 的 SHS 源碼不使用正則字面量**，所以這個近似
; 不影響門禁；但若把 `shs-mask` 用於含正則的檔案，需人工複核。
;
; ── SHS 規則（本工具強制）──
;   S1  型別名（struct / enum / interface）長度 >= 2
;   S2  型別名不得是 t / n / v / k / s（與泛型型別變數衝突）
;   S3  禁止 `#{c}` FFI 宣告
;   S4  禁止 `any` / `obj`
;   S5  禁止「帶 [K]V map 欄位的型別 + 方法」——跨模組必炸，見
;       docs/design/nolang-selfhost.md §2.2.8
;   S6  含 `.` 的**自由函式**定義名，out-param 至多 1 個——否則 SIGSEGV。
;       擁有者是本檔宣告型別的（= 方法）不在此限。見 docs 附錄 A.6。
;
; ⚠️ 本檔自身也必須是 SHS 合規的（它就在 compiler/ 底下）。
;    本檔曾因兩個自身缺陷而靜默誤報「0 違規」，詳見 `shs-mask` 與
;    `shs-sort-strs` 的註解 —— 驗證器必須先證明它**會壞**。

# /compiler/src/util/sb.sb

; ── 退出碼 ──
EXIT-OK = 0
EXIT-BAD = 1
EXIT-USAGE = 2

; ── 遮罩狀態 ──
; ⚠️ 編號必須與 `shs-mask` 的 match 臂逐個對應（0=字串 … 6=程式碼）。
;    這裡曾經把 ST-CODE 寫成 0，於是初始狀態落進「字串」臂，整份檔案被塗成 x，
;    所有檢查因此靜默通過（長度不變 ⇒ 只比長度看不出來）。
ST-STR = 0
ST-CHR = 1
ST-RAW = 2
ST-REGEX = 3
ST-LINE = 4
ST-BLOCK = 5
ST-CODE = 6

; ── 位元組常量 ──
B-TAB = 9
B-LF = 10
B-CR = 13
B-SP = 32
B-DQ = 34
B-HASH = 35
B-SQ = 39
B-LP = 40
B-RP = 41
B-STAR = 42
B-COMMA = 44
B-MINUS = 45
B-DOT = 46
B-SLASH = 47
B-DIG0 = 48
B-DIG9 = 57
B-COLON = 58
B-SEMI = 59
B-EQ = 61
B-GT = 62
B-QM = 63
B-UP-A = 65
B-UP-Z = 90
B-LB = 91
B-BS = 92
B-RB = 93
B-US = 95
B-BT = 96
B-LO-A = 97
B-LO-Z = 122
B-LC = 123
B-RC = 125
B-LOWER-C = 99
B-LOWER-K = 107
B-LOWER-N = 110
B-LOWER-O = 111
B-LOWER-S = 115
B-LOWER-T = 116
B-LOWER-V = 118

; ── 資料結構 ──
; 一筆違規。⚠️ 結構體名 >= 2 字元（SHS S1）。
finding {
    file str
    line i64
    rule str
    msg str
}

; ═══════════════════════════════════════════════════════════════════
; 位元組分類
; ═══════════════════════════════════════════════════════════════════

; 取 s 的第 i 個位元組（越界折成 0）。
;
; `s.byte(i)` 自 2026-10-21 起回傳 `?byte`（越界為 nil，見 docs/design/option-unified.md
; §3.1）。本檔所有讀取都落在 `i < len` 的守衛迴圈內，nil 分支不可達；但型別上仍是
; option，直接餵給 shs-is-*（`(c i64)`）會被 fxxoptarg 拒絕。這支 helper 是唯一
; 的解包點，讓 40 餘個呼叫點維持原本的一行寫法。
; s: 字串
; i: 索引
; b: 結果位元組
shs-byte = (s str, i i64) (b i64) {
    o = s.byte(i)
    b = o: {
        ok -> it
        ->
    }
}

; 功能待補充
; c: 運算元
; yes: 是否成立
shs-is-blank = (c i64) (yes bool) {
    yes = false
    c == B-SP -> yes = true
    c == B-TAB -> yes = true
    c == B-CR -> yes = true
}

; 功能待補充
; c: 運算元
; yes: 是否成立
shs-is-digit = (c i64) (yes bool) {
    yes = false
    c >= B-DIG0 -> {
        c <= B-DIG9 -> yes = true
    }
}

; 功能待補充
; c: 運算元
; yes: 是否成立
shs-is-alpha = (c i64) (yes bool) {
    yes = false
    c >= B-UP-A -> {
        c <= B-UP-Z -> yes = true
    }
    c >= B-LO-A -> {
        c <= B-LO-Z -> yes = true
    }
}

; nolang 的識別符可含 `-`（read-dir / to-str / is-no-file）
; c: 運算元
; yes: 是否成立
shs-is-ident-char = (c i64) (yes bool) {
    yes = false
    shs-is-alpha(c) -> yes = true
    shs-is-digit(c) -> yes = true
    c == B-US -> yes = true
    c == B-MINUS -> yes = true
}

; 功能待補充
; c: 運算元
; yes: 是否成立
shs-is-ident-start = (c i64) (yes bool) {
    yes = false
    shs-is-alpha(c) -> yes = true
    c == B-US -> yes = true
}

; ═══════════════════════════════════════════════════════════════════
; 小工具
; ═══════════════════════════════════════════════════════════════════

; sub: 取 s[a..b)（用 sb 組，不依賴 str 的 substring API）
; s: 字串
; a: 運算元
; b: 運算元
; r: 結果字串
shs-sub = (s str, a i64, b i64) (r str) {
    t = sb.init(16)
    i = a

    #{overflow=wrap}
    (i < b) {
        ; ⚠️ `str.byte(i)` 回傳 **?byte**：直接 push 進 []byte 會寫進 option 的
        ;   內聯佈局而非碼點值（與 compiler/src/util/sb.no 的 sb.push 同一個坑），
        ;   產出的切片內容全 NUL ⇒ 上層 `shs-byte(xs, …)` 型別判讀連鎖失真。
        so = s.byte(i)
        sv = so: {
            ok -> it

            -> 0
        }
        t.push-byte(sv)

        #{overflow=wrap}
        i = i + 1
    }
    r = t.str()
}

; rest-blank: 從 j 起到行尾（不含換行）是否全為空白
; s: 字串
; j: 索引
; yes: 是否成立
shs-rest-blank = (s str, j i64) (yes bool) {
    n = s.len-bytes()
    yes = true

    #{overflow=wrap}
    (j < n) {

        #{index-out=zero}
        c = shs-byte(s, j)
        c == B-LF -> j = n
        c != B-LF -> {
            shs-is-blank(c) -> {

                #{overflow=wrap}
                j = j + 1
            }
            shs-is-blank(c) == false -> {
                yes = false
                j = n
            }
        }
    }
}

; slash-regex: '/' 是否為正則字面量的開頭（近似）
;
; prev 是前一個「顯著」位元組；0 表示行首/檔案開頭。
; 產生值的位元組（其後的 `/` 是除法）：識別符字元 / 收尾引號 / `) ] } .`
; prev: 數值
; yes: 是否成立
shs-slash-regex = (prev i64) (yes bool) {
    yes = true
    prev == 0 -> return
    shs-is-ident-char(prev) -> {
        yes = false
        return
    }
    prev == B-SQ -> yes = false
    prev == B-DQ -> yes = false
    prev == B-BT -> yes = false
    prev == B-RP -> yes = false
    prev == B-RB -> yes = false
    prev == B-RC -> yes = false
    prev == B-DOT -> yes = false
}

; semi-block: s[i] == ';' 且 s[i+1] == ';' 且其後僅空白/換行 ⇒ 塊註釋開始
; s: 字串
; i: 索引
; yes: 是否成立
shs-semi-block = (s str, i i64) (yes bool) {
    yes = false
    n = s.len-bytes()

    #{overflow=wrap}
    (i + 1 < n) -> {

        #{index-out=zero}
        c = shs-byte(s, i + 1)
        c == B-SEMI -> {

            #{overflow=wrap}
            r = shs-rest-blank(s, i + 2)
            r -> yes = true
        }
    }
}

; slash-line: s[i] == '/' 且 s[i+1] == '/' ⇒ 行註釋
; s: 字串
; i: 索引
; yes: 是否成立
shs-slash-line = (s str, i i64) (yes bool) {
    yes = false
    n = s.len-bytes()

    #{overflow=wrap}
    (i + 1 < n) -> {

        #{index-out=zero}
        c = shs-byte(s, i + 1)
        c == B-SLASH -> yes = true
    }
}

; block-end: 在塊註釋中，s[i] == ';'，是否為結束定界符（`;;` + 其後僅空白/換行）
; s: 字串
; i: 索引
; yes: 是否成立
shs-block-end = (s str, i i64) (yes bool) {
    yes = false
    n = s.len-bytes()

    #{overflow=wrap}
    (i + 1 < n) -> {

        #{index-out=zero}
        c = shs-byte(s, i + 1)
        c == B-SEMI -> {

            #{overflow=wrap}
            r = shs-rest-blank(s, i + 2)
            r -> yes = true
        }
    }
}

; ═══════════════════════════════════════════════════════════════════
; 遮罩（本工具的正確性核心）
; ═══════════════════════════════════════════════════════════════════
;
; 不變量：
;   1. out.len-bytes() == s.len-bytes()
;   2. out 與 s 的 '\n' 位置逐個相同
;   3. 註釋區段 → 空白；字面量內容 → 'x'（引號本身保留）
;
; 每個狀態臂都以 `continue` 收尾 ⇒ 狀態機不會在同一輪重複處理同一位元組。
; s: 字串
; out: 輸出結果
shs-mask = (s str) (out str) {
    n = s.len-bytes()
    b = sb.init(n)
    i = 0
    st = ST-CODE
    prev = 0

    #{overflow=wrap}
    (i < n) {

        #{index-out=zero}
        c = shs-byte(s, i)
        st: {
            0 -> {
                c == B-BS -> {
                    b.push-byte(B-BS)

                    #{overflow=wrap}
                    i = i + 1
                    i < n -> b.push-byte(s.byte(i))

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-LF -> {
                    b.push-byte(B-LF)
                    st = ST-CODE
                    prev = 0

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-SQ -> {
                    b.push-byte(B-SQ)
                    st = ST-CODE
                    prev = B-SQ

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                b.push-byte(120)

                #{overflow=wrap}
                i = i + 1
                continue
            }

            1 -> {
                c == B-BS -> {
                    b.push-byte(B-BS)

                    #{overflow=wrap}
                    i = i + 1
                    i < n -> b.push-byte(s.byte(i))

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-LF -> {
                    b.push-byte(B-LF)
                    st = ST-CODE
                    prev = 0

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-DQ -> {
                    b.push-byte(B-DQ)
                    st = ST-CODE
                    prev = B-DQ

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                b.push-byte(120)

                #{overflow=wrap}
                i = i + 1
                continue
            }

            2 -> {
                c == B-BT -> {
                    b.push-byte(B-BT)
                    st = ST-CODE
                    prev = B-BT

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-LF -> {
                    b.push-byte(B-LF)
                    st = ST-CODE
                    prev = 0

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                b.push-byte(120)

                #{overflow=wrap}
                i = i + 1
                continue
            }

            3 -> {
                c == B-BS -> {
                    b.push-byte(B-BS)

                    #{overflow=wrap}
                    i = i + 1
                    i < n -> b.push-byte(s.byte(i))

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-LF -> {
                    b.push-byte(B-LF)
                    st = ST-CODE
                    prev = 0

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-SLASH -> {
                    b.push-byte(B-SLASH)
                    st = ST-CODE
                    prev = B-SLASH

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                b.push-byte(120)

                #{overflow=wrap}
                i = i + 1
                continue
            }

            4 -> {
                c == B-LF -> {
                    b.push-byte(B-LF)
                    st = ST-CODE
                    prev = 0

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                b.push-byte(B-SP)

                #{overflow=wrap}
                i = i + 1
                continue
            }

            5 -> {
                c == B-LF -> {
                    b.push-byte(B-LF)

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-SEMI -> {
                    en = shs-block-end(s, i)
                    en -> {
                        b.push-byte(B-SP)
                        b.push-byte(B-SP)
                        st = ST-CODE
                        prev = 0

                        #{overflow=wrap}
                        i = i + 2
                        continue
                    }
                }
                b.push-byte(B-SP)

                #{overflow=wrap}
                i = i + 1
                continue
            }

            6 -> {
                c == B-LF -> {
                    b.push-byte(B-LF)
                    prev = 0

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                shs-is-blank(c) -> {
                    b.push-byte(c)

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-SQ -> {
                    b.push-byte(B-SQ)
                    st = ST-STR

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-DQ -> {
                    b.push-byte(B-DQ)
                    st = ST-CHR

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-BT -> {
                    b.push-byte(B-BT)
                    st = ST-RAW

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-SEMI -> {
                    blk = shs-semi-block(s, i)
                    blk -> {
                        st = ST-BLOCK
                        b.push-byte(B-SP)
                        b.push-byte(B-SP)

                        #{overflow=wrap}
                        i = i + 2
                        continue
                    }
                    st = ST-LINE
                    b.push-byte(B-SP)

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                c == B-SLASH -> {
                    sl = shs-slash-line(s, i)
                    sl -> {
                        st = ST-LINE
                        b.push-byte(B-SP)
                        b.push-byte(B-SP)

                        #{overflow=wrap}
                        i = i + 2
                        continue
                    }
                    rx = shs-slash-regex(prev)
                    rx -> {
                        b.push-byte(B-SLASH)
                        st = ST-REGEX

                        #{overflow=wrap}
                        i = i + 1
                        continue
                    }
                    b.push-byte(B-SLASH)
                    prev = B-SLASH

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                b.push-byte(c)
                prev = c

                #{overflow=wrap}
                i = i + 1
                continue
            }
        }
    }
    out = b.str()
}

; ═══════════════════════════════════════════════════════════════════
; 切行 / 行內工具
; ═══════════════════════════════════════════════════════════════════
; s: 字串
; out: 輸出結果
shs-lines = (s str) (out []str) {
    out = []
    str str
    n = s.len-bytes()
    cur = sb.init(64)
    i = 0

    #{overflow=wrap}
    (i < n) {

        #{index-out=zero}
        c = shs-byte(s, i)
        c == B-LF -> {
            out.push(cur.str())
            cur = sb.init(64)
        }
        c != B-LF -> cur.push-byte(c)

        #{overflow=wrap}
        i = i + 1
    }
    out.push(cur.str())
}

; trim-range: 回 [a, b) = 第一個非空白 .. 最後一個非空白之後
; ln: 字串
; a: 結果數值
; b: 結果位元組
shs-trim-range = (ln str) (a i64, b i64) {
    n = ln.len-bytes()
    a = 0
    b = n
    i <- [0..n): {

        #{index-out=zero}
        c = shs-byte(ln, i)
        shs-is-blank(c) -> {

            #{overflow=wrap}
            a = i + 1
        }
        shs-is-blank(c) == false -> break
    }
    a >= n -> {
        b = n
        return
    }
    j = a
    k <- [a..n): {

        #{index-out=zero}
        c2 = shs-byte(ln, k)
        shs-is-blank(c2) == false -> j = k
    }

    #{overflow=wrap}
    b = j + 1
}

; ═══════════════════════════════════════════════════════════════════
; 行分類
; ═══════════════════════════════════════════════════════════════════

; type-decl: `name {` 且在第 0 欄 ⇒ 型別宣告
; ln: 字串
; yes: 是否成立
; name: 名稱
shs-type-decl = (ln str) (yes bool, name str) {
    yes = false
    name = ''
    a, b = shs-trim-range(ln)
    a >= b -> return
    a != 0 -> return

    #{index-out=zero}
    c0 = shs-byte(ln, a)
    shs-is-ident-start(c0) == false -> return
    je = a
    k <- [a..b): {

        #{index-out=zero}
        ch = shs-byte(ln, k)
        shs-is-ident-char(ch) -> {

            #{overflow=wrap}
            je = k + 1
        }
        shs-is-ident-char(ch) == false -> break
    }
    je >= b -> return

    ; 識別符與 '{' 之間允許空白（實際寫法就是 `name {`，不是 `name{`）
    ; ⚠️ 不可用「把 j 設成 b 當哨兵」來結束迴圈 —— 那會與下面的
    ;    `j >= b -> return` 撞在一起，於是永遠回 yes=false。
    j = je
    hit = false
    k2 <- [je..b): {

        #{index-out=zero}
        sp = shs-byte(ln, k2)
        shs-is-blank(sp) == false -> {
            j = k2
            hit = true
            break
        }
    }
    hit == false -> return

    #{index-out=zero}
    ch2 = shs-byte(ln, j)
    ch2 == B-LC -> {

        #{overflow=wrap}
        (j + 1 == b) -> {
            name = shs-sub(ln, a, je)
            yes = true
        }
    }
}

; meth-decl: `owner.f = ...` 且在第 0 欄 ⇒ 方法宣告（回 owner）
; ln: 字串
; yes: 是否成立
; owner: 結果字串
shs-meth-decl = (ln str) (yes bool, owner str) {
    yes = false
    owner = ''
    a, b = shs-trim-range(ln)
    a >= b -> return
    a != 0 -> return

    #{index-out=zero}
    c0 = shs-byte(ln, a)
    shs-is-ident-start(c0) == false -> return
    j = a
    k <- [a..b): {

        #{index-out=zero}
        ch = shs-byte(ln, k)
        shs-is-ident-char(ch) -> {

            #{overflow=wrap}
            j = k + 1
        }
        shs-is-ident-char(ch) == false -> break
    }
    j >= b -> return

    #{index-out=zero}
    ch2 = shs-byte(ln, j)
    ch2 == B-DOT -> {
        owner = shs-sub(ln, a, j)
        yes = true
    }
}

; def-sig: 頂層定義 `name = (in) (out) {` / `name = (in) {`
;   回 (yes, dotted, nout)。
;     dotted = 定義名裡含 `.`
;     nout   = 第二組括號的參數個數（沒有第二組 ⇒ 0）
;   空括號 `()` 會被算成 1，但那只影響「是否 >= 2」的判定，不會誤報，故不特判。
; ln: 字串
; yes: 是否成立
; dotted: 布林結果
; nout: 結果數值
shs-def-sig = (ln str) (yes bool, dotted bool, nout i64) {
    yes = false
    dotted = false
    nout = 0
    a, b = shs-trim-range(ln)
    a >= b -> return
    a != 0 -> return

    #{index-out=zero}
    c0 = shs-byte(ln, a)
    shs-is-ident-start(c0) == false -> return

    je = a
    k <- [a..b): {

        #{index-out=zero}
        ch = shs-byte(ln, k)
        ok = false
        oc = shs-is-ident-char(ch)
        oc -> ok = true
        ch == B-DOT -> {
            dotted = true
            ok = true
        }
        ok -> {

            #{overflow=wrap}
            je = k + 1
        }
        ok == false -> break
    }

    ; 下一個非空白必須是 '='
    j = je
    hit = false
    k2 <- [je..b): {

        #{index-out=zero}
        sp = shs-byte(ln, k2)
        shs-is-blank(sp) == false -> {
            j = k2
            hit = true
            break
        }
    }
    hit == false -> return

    #{index-out=zero}
    ce = shs-byte(ln, j)
    ce != B-EQ -> return

    ; 下一個非空白必須是 '('（從 '=' 之後開始找）
    p1 = -1
    hit2 = false

    #{overflow=wrap}
    q0 = j + 1
    k3 <- [q0..b): {

        #{index-out=zero}
        sp2 = shs-byte(ln, k3)
        shs-is-blank(sp2) == false -> {
            p1 = k3
            hit2 = true
            break
        }
    }
    hit2 == false -> return

    #{index-out=zero}
    cp = shs-byte(ln, p1)
    cp != B-LP -> return

    ; 找第一組的配對 ')'
    depth = 0
    e1 = -1
    k4 <- [p1..b): {

        #{index-out=zero}
        q = shs-byte(ln, k4)
        q == B-LP -> {

            #{overflow=wrap}
            depth = depth + 1
        }
        q == B-RP -> {

            #{overflow=wrap}
            depth = depth - 1
            (depth == 0) -> {
                e1 = k4
                break
            }
        }
    }
    e1 < 0 -> return

    ; 第一組之後還有 '(' ⇒ 有 out 組（從 ')' 之後開始找）
    p2 = -1
    hit3 = false

    #{overflow=wrap}
    q1 = e1 + 1
    k5 <- [q1..b): {

        #{index-out=zero}
        sp3 = shs-byte(ln, k5)
        shs-is-blank(sp3) == false -> {
            p2 = k5
            hit3 = true
            break
        }
    }
    hit3 == false -> {
        yes = true
        return
    }

    #{index-out=zero}
    cp2 = shs-byte(ln, p2)
    cp2 != B-LP -> {
        yes = true
        return
    }

    ; 數 out 組的頂層逗號
    commas = 0
    depth2 = 0
    k6 <- [p2..b): {

        #{index-out=zero}
        r2 = shs-byte(ln, k6)
        r2 == B-LP -> {

            #{overflow=wrap}
            depth2 = depth2 + 1
        }
        r2 == B-RP -> {

            #{overflow=wrap}
            depth2 = depth2 - 1
            (depth2 == 0) -> break
        }
        r2 == B-COMMA -> {
            (depth2 == 1) -> {

                #{overflow=wrap}
                commas = commas + 1
            }
        }
    }

    #{overflow=wrap}
    nout = commas + 1
    yes = true
}

; map-at: ln[i] == '['，是否為 map 型別 [X]Y
;   X 非空、非全數字、非 '?'  ⇒ map
;   X 為空（[]）/ 全數字（[3]）/ '?'（[?]）⇒ 切片或定長陣列
; ln: 字串
; i: 索引
; yes: 是否成立
shs-map-at = (ln str, i i64) (yes bool) {
    yes = false
    n = ln.len-bytes()

    #{overflow=wrap}
    j = i + 1

    ; ⚠️ 必須記住 ']' 的**位置**。曾經把 j 直接設成 n 當作迴圈終止，
    ;    於是 xs 變成 `]byte` 而非 `str` ⇒ 每個切片都被誤判成 map。
    rb = -1
    closed = false

    #{overflow=wrap}
    (j < n) {

        #{index-out=zero}
        ch = shs-byte(ln, j)
        ch == B-RB -> {
            rb-opt = j
            rb-opt: {
                ok -> rb = it
                ->
            }
            closed = true
            j = n
        }
        ch != B-RB -> {

            #{overflow=wrap}
            j = j + 1
        }
    }
    closed == false -> return
    rb < 0 -> return

    ; xs = ln[i+1 .. rb)；空內容 ⇒ 切片，不是 map
    (rb > i + 1) -> {

        #{overflow=wrap}
        xs-opt = shs-sub(ln, i + 1, rb)

        ; 兩段式解包（同 ps-hash 的 c-opt 慣用法）：shs-sub 的實參 `i + 1` 是裸
        ;   算術（本身產生 option）⇒ 捕獲 pass 把 xs-opt 弄成 `?str`。方法呼叫
        ;   （xs-opt.len-bytes()）有 receiver 剝離可隱式收，但函數實參沒有——
        ;   直接拿 xs-opt 餵給 shs-byte（`(s str, i i64)`）會被 fxxoptarg 擋，
        ;   必須先解包成 plain str。nil/err 臂折成空串：空串 len-bytes() 為 0，
        ;   下面 `m == 0 -> return` 直接收住（空內容 ⇒ 切片，語義正確）。
        xs = xs-opt: {
            ok -> it
            -> ''
        }
        m = xs.len-bytes()
        m == 0 -> return
        alld = true
        k <- [0..m): {

            #{index-out=zero}
            d = shs-byte(xs, k)
            shs-is-digit(d) == false -> alld = false
        }
        alld -> return

        #{index-out=zero}
        d0 = shs-byte(xs, 0)
        (m == 1) -> {
            d0 == B-QM -> return
        }
        yes = true
    }
}

; line-has-map: 該行是否出現 map 型別
; ln: 字串
; yes: 是否成立
shs-line-has-map = (ln str) (yes bool) {
    yes = false
    n = ln.len-bytes()
    i <- [0..n): {

        #{index-out=zero}
        ch = shs-byte(ln, i)
        ch == B-LB -> {
            r = shs-map-at(ln, i)
            r -> {
                yes = true
                return
            }
        }
    }
}

; find-word: 在行內找「整詞」（前後都不是識別符字元）
; ln: 字串
; w: 字串
; found: 是否找到
; col: 結果數值
shs-find-word = (ln str, w str) (found bool, col i64) {
    found = false
    col = 0
    n = ln.len-bytes()
    wn = w.len-bytes()
    wn == 0 -> return
    n < wn -> return
    i = 0

    #{overflow=wrap}
    (i + wn <= n) {
        hit = true
        k <- [0..wn): {

            #{index-out=zero}
            ca = shs-byte(ln, i + k)

            #{index-out=zero}
            cb = shs-byte(w, k)
            ca != cb -> hit = false
        }
        hit -> {
            before-ok = false
            before-ok = i == 0
            (i > 0) -> {

                #{index-out=zero}
                p-opt = shs-byte(ln, i - 1)
                ; ⚠️ 實參 `i - 1` 是裸算術（D6：本身產生 option）⇒ 捕獲 pass 會把
                ;   p-opt 預宣告成 `?i64` 並在 ok 臂才賦真值。直接拿 p-opt 餵給
                ;   shs-is-ident-char（`(c i64)`）會被 fxxoptarg 拒絕，必須兩段式
                ;   解包（與 shs-sub / sb.push 的 ?byte 解包同形）。nil/err 折成 0
                ;   ——`i > 0` 已保證 `i - 1` 不會underflow，該兩臂實際不可達。
                p = p-opt: {
                    ok -> it

                    -> 0
                }
                shs-is-ident-char(p) == false -> before-ok = true
            }
            after-ok = false

            #{overflow=wrap}
            ae = i + wn
            ae == n -> after-ok = true
            (ae < n) -> {

                #{index-out=zero}
                q = shs-byte(ln, ae)
                shs-is-ident-char(q) == false -> after-ok = true
            }
            before-ok -> {
                after-ok -> {
                    found = true
                    col = i
                    return
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; has-ffi-c: 該行是否出現 `#{c` 形式
; ln: 字串
; yes: 是否成立
shs-has-ffi-c = (ln str) (yes bool) {
    yes = false
    n = ln.len-bytes()
    n < 4 -> return
    i = 0

    #{overflow=wrap}
    (i + 3 < n) {

        #{index-out=zero}
        c0 = shs-byte(ln, i)
        c0 == B-HASH -> {

            #{index-out=zero}
            c1 = shs-byte(ln, i + 1)
            c1 == B-LC -> {

                #{index-out=zero}
                c2 = shs-byte(ln, i + 2)
                c2 == B-LOWER-C -> {

                    #{index-out=zero}
                    c3 = shs-byte(ln, i + 3)
                    c3 == B-RC -> yes = true
                    c3 == B-SP -> yes = true
                    c3 == B-TAB -> yes = true
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ═══════════════════════════════════════════════════════════════════
; 名字規則
; ═══════════════════════════════════════════════════════════════════
; nm: 字串
; yes: 是否成立
shs-name-short = (nm str) (yes bool) {
    yes = false
    n = nm.len-bytes()
    n < 2 -> yes = true
}

; 功能待補充
; nm: 字串
; yes: 是否成立
shs-name-reserved = (nm str) (yes bool) {
    yes = false
    n = nm.len-bytes()
    n != 1 -> return

    #{index-out=zero}
    c = shs-byte(nm, 0)
    c == B-LOWER-T -> yes = true
    c == B-LOWER-N -> yes = true
    c == B-LOWER-V -> yes = true
    c == B-LOWER-K -> yes = true
    c == B-LOWER-S -> yes = true
}

; str-gt: 字典序 a > b
; a: 運算元
; b: 運算元
; yes: 是否成立
shs-str-gt = (a str, b str) (yes bool) {
    yes = false
    na = a.len-bytes()
    nb = b.len-bytes()
    m = na
    nb < na -> m = nb
    i <- [0..m): {

        #{index-out=zero}
        ca = shs-byte(a, i)

        #{index-out=zero}
        cb = shs-byte(b, i)
        ca > cb -> {
            yes = true
            return
        }
        ca < cb -> return
    }
    na > nb -> yes = true
}

; str-eq: a 與 b 逐位元組相等
; （S5 要比的是「方法擁有者」與「型別名」，是相等而非前綴 —— 曾誤用前綴比較，
;   於是 S5 永遠不觸發。）
; a: 運算元
; b: 運算元
; yes: 是否成立
shs-str-eq = (a str, b str) (yes bool) {
    yes = true
    na = a.len-bytes()
    nb = b.len-bytes()
    na != nb -> {
        yes = false
        return
    }
    i <- [0..na): {

        #{index-out=zero}
        ca = shs-byte(a, i)

        #{index-out=zero}
        cb = shs-byte(b, i)
        ca != cb -> {
            yes = false
            return
        }
    }
}

; sort-strs: 選擇排序（確定性；檔案數小）
;
; ⚠️ 這裡原本是插入排序，但它**算錯了**（輸入 delta/alpha/charlie/bravo
;    ⇒ 回 bravo/charlie/delta/delta，元素既重複又遺失）。
;    教訓：那個錯**不是編譯器的錯**。原本的內層迴圈在「不再搬移」的分支寫
;    `j = -1`，把「停下來」與「j 走到 -1」混為一談，於是 `arr[j+1] = key`
;    永遠寫進 arr[0]。改成 `break` 後同一個插入排序就完全正確（已驗證
;    [4,1,3,2] ⇒ [1,2,3,4]）。
;    ⇒ 別把「預期值有歧義的重現」當成編譯器缺陷，先確認演算法本身對不對。
;    本檔改用選擇排序：形狀更簡單、不需 loop-carried 索引，較難寫錯。
;    排序作用在**索引陣列**上，字串本身不搬移。
; arr: 容器
; r: 結果容器
shs-sort-strs = (arr []str) (r []str) {
    n = arr.len()
    idx []i64 = []
    i <- [0..n): {

        #{index-out=zero}
        idx.push(i)
    }
    a <- [0..n): {
        best = a
        b <- [a..n): {

            #{index-out=zero}
            ib = idx[b]

            #{index-out=zero}
            ibest = idx[best]

            #{index-out=zero}
            kb = arr[ib]

            #{index-out=zero}
            kbest = arr[ibest]
            g = shs-str-gt(kbest, kb)
            g -> best = b
        }

        #{index-out=zero}
        t = idx[a]

        ; D9 place-write：`idx[a] = idx[best]` 這種「下標直接賦值」被 idxwrite 拒絕
        ;   （越界寫會變成未檢查的 OOB 寫）。改用 place-match：ok 臂的 it 是元素
        ;   「位置」，可讀可寫；越界走 `_` 臂什麼都不做。本函式無 option 結果參數，
        ;   用不了 `?=` 上拋。a/best 皆 < n，ok 臂必然到達。
        idx[a]: {
            ok -> it = idx[best]
            -> _
        }

        idx[best]: {
            ok -> it = t
            -> _
        }
    }
    out []str = []
    k <- [0..n): {

        #{index-out=zero}
        pos = idx[k]

        #{index-out=zero}
        out.push(arr[pos])
    }
    r = out
}

; ═══════════════════════════════════════════════════════════════════
; 檔案走訪
; ═══════════════════════════════════════════════════════════════════
; p: 字串
; yes: 是否成立
shs-is-no-file = (p str) (yes bool) {
    yes = false
    n = p.len-bytes()
    n < 3 -> return

    #{overflow=wrap}
    i = n - 3

    #{index-out=zero}
    c1 = shs-byte(p, i)

    #{index-out=zero, overflow=wrap}
    c2 = shs-byte(p, i + 1)

    #{index-out=zero, overflow=wrap}
    c3 = shs-byte(p, n - 1)
    c1 == B-DOT -> {
        c2 == B-LOWER-N -> {
            c3 == B-LOWER-O -> yes = true
        }
    }
}

; collect: 遞迴收集 .no 檔
; p: 字串
; out: 輸出結果
; r: 結果容器
shs-collect = (p str, out []str) (r []str) {
    r = out
    d = fs.is-dir(p)
    d -> {
        sub = fs.walk(p)
        i <- [0..sub.len()): {

            #{index-out=zero}
            f = sub[i]
            nf = shs-is-no-file(f)
            nf -> r.push(f)
        }
        return
    }
    nf2 = shs-is-no-file(p)
    nf2 -> r.push(p)
}

; ═══════════════════════════════════════════════════════════════════
; 檢查
; ═══════════════════════════════════════════════════════════════════
; acc: 容器
; file: 檔案
; line: 行號
; rule: 字串
; msg: 訊息
; r: 結果容器
shs-add = (acc []finding, file str, line i64, rule str, msg str) (r []finding) {
    f = finding {
        file: file
        line: line
        rule: rule
        msg: msg
    }
    acc.push(f)
    r = acc
}

; 功能待補充
; f: 回呼函式
; r: 結果字串
shs-render = (f finding) (r str) {
    b = sb.init(128)
    b.push(f.file)
    b.push(':')
    b.push(f.line.to-str())
    b.push(': [')
    b.push(f.rule)
    b.push('] ')
    b.push(f.msg)
    r = b.str()
}

; check-file: 掃一個檔案，把違規併入 acc
; path: 路徑
; acc: 容器
; r: 結果容器
shs-check-file = (path str, acc []finding) (r []finding) {
    r = acc
    c = fs.read-str(path)
    src = ''
    got = false
    c: {
        ok -> {
            src-opt = c
            src-opt: {
                ok -> src = it
                ->
            }
            got = true
        }

        nil -> {
        }

        err -> {
        }
    }
    got == false -> {
        r = shs-add(r, path, 0, 'IO', 'cannot read file')
        return
    }

    masked = shs-mask(src)
    lines = shs-lines(masked)
    nl = lines.len()

    ; ── Pass 1：收集型別 / map 欄位 / 方法，同時報 S1 / S2 ──
    tnames []str = []
    tmaps []bool = []
    meths []str = []
    meth-line []i64 = []
    cur = -1
    li <- [0..nl): {

        #{index-out=zero}
        ln = lines[li]

        #{overflow=wrap}
        lineno = li + 1
        a, b = shs-trim-range(ln)
        a >= b -> continue

        #{index-out=zero}
        c0 = shs-byte(ln, a)
        cur >= 0 -> {
            c0 == B-RC -> {

                #{overflow=wrap}
                (b == a + 1) -> cur = -1
                continue
            }
            hm = shs-line-has-map(ln)
            hm -> {

                ; 同 shs-sort-strs：下標直接賦值須走 place-match（idxwrite）。
                ; cur >= 0 已由外層守衛保證，ok 臂必然到達。
                tmaps[cur]: {
                    ok -> it = true
                    -> _
                }
            }
            continue
        }
        yes1, nm1 = shs-type-decl(ln)
        yes1 -> {
            tnames.push(nm1)
            tmaps.push(false)

            #{overflow=wrap}
            cur = tnames.len() - 1
            s1 = shs-name-short(nm1)
            s1 -> {
                r = shs-add(r, path, lineno, 'S1', 'type name too short (< 2): ' + nm1)
            }
            s2 = shs-name-reserved(nm1)
            s2 -> {
                r = shs-add(r, path, lineno, 'S2', 'type name collides with a generic type variable: ' + nm1)
            }
            continue
        }
        yes2, nm2 = shs-meth-decl(ln)
        yes2 -> {
            meths.push(nm2)
            meth-line.push(lineno)
            continue
        }
    }

    ; ── Pass 2：逐行查 S3 / S4 ──
    li2 <- [0..nl): {

        #{index-out=zero}
        ln2 = lines[li2]

        #{overflow=wrap}
        lineno2 = li2 + 1
        f1 = shs-has-ffi-c(ln2)
        f1 -> {
            r = shs-add(r, path, lineno2, 'S3', 'FFI declaration #{c} is forbidden in SHS')
        }
        w1, wc1 = shs-find-word(ln2, 'any')
        w1 -> {
            r = shs-add(r, path, lineno2, 'S4', '`any` is forbidden in SHS')
        }
        w2, wc2 = shs-find-word(ln2, 'obj')
        w2 -> {
            r = shs-add(r, path, lineno2, 'S4', '`obj` is forbidden in SHS')
        }
        _ = wc1
        _ = wc2
    }

    ; ── S5：帶 map 欄位的型別不得有方法 ──
    ; meths 存的是 `shs-meth-decl` 回傳的【擁有者】（`hashy.put1` ⇒ `hashy`），
    ; 所以這裡用相等比較。
    i <- [0..tnames.len()): {

        #{index-out=zero}
        tm = tmaps[i]
        tm -> {

            #{index-out=zero}
            tn = tnames[i]
            k <- [0..meths.len()): {

                #{index-out=zero}
                mf = meths[k]
                eq = shs-str-eq(mf, tn)
                eq -> {

                    #{index-out=zero}
                    mln = meth-line[k]
                    r = shs-add(r, path, mln, 'S5', 'type `' + tn + '` has a [K]V map field AND a method - forbidden, see docs/design/nolang-selfhost.md §2.2.8')
                    return
                }
            }
        }
    }

    ; ── S6：含 `.` 的頂層定義名，out-param 至多 1 個 ──
    ;
    ; 2026-10-09 實測（見 docs/design/nolang-selfhost.md 附錄 A.6）：
    ;   `shs.g = (s str) (a i64, b i64)` 這種**自由函式** + 呼叫 `shs.g('x')`
    ;   ⇒ SIGSEGV（rc=-11，無輸出）。同形狀但名字無 `.` ⇒ 正常。
    ;   名字含 `.` 但只有 1 個 out-param ⇒ 正常（`sb.init` 即此形）。
    ; 方法（擁有者是本檔宣告的型別）走的是另一條路徑，實測 2 個 out-param 正常，
    ; 故排除。
    li3 <- [0..nl): {

        #{index-out=zero}
        ln3 = lines[li3]

        #{overflow=wrap}
        lineno3 = li3 + 1
        dy, dd, dn = shs-def-sig(ln3)
        dy -> {
            dd -> {
                (dn >= 2) -> {

                    ; 取 `.` 前的擁有者，若它是本檔宣告的型別 ⇒ 方法，放行
                    ismeth = false
                    a3, b3 = shs-trim-range(ln3)
                    j3 = a3
                    k3 <- [a3..b3): {

                        #{index-out=zero}
                        ch3 = shs-byte(ln3, k3)
                        shs-is-ident-char(ch3) -> {

                            #{overflow=wrap}
                            j3 = k3 + 1
                        }
                        shs-is-ident-char(ch3) == false -> break
                    }
                    own = shs-sub(ln3, a3, j3)
                    m <- [0..tnames.len()): {

                        #{index-out=zero}
                        t3 = tnames[m]
                        e3 = shs-str-eq(t3, own)
                        e3 -> ismeth = true
                    }
                    ismeth == false -> {
                        r = shs-add(r, path, lineno3, 'S6', 'definition name contains `.` and has ' + dn.to-str() + ' out-params - the compiler miscompiles this shape (SIGSEGV); use a dot-free name or at most 1 out-param')
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════════════════════════
; 入口
; ═══════════════════════════════════════════════════════════════════
; code: 狀態碼
shs-main = () (code i64) {
    code = EXIT-OK
    n = os.args().len()
    n < 2 -> {
        print('usage: shs-check <path>...')
        code = EXIT-USAGE
        return
    }
    paths []str = []
    i <- [1..n): {

        #{index-out=zero}
        opt-p = os.arg(i)
        p str = ''
        opt-p: {
            ok -> p = it
            -> _
        }
        paths = shs-collect(p, paths)
    }
    paths = shs-sort-strs(paths)
    acc []finding = []
    j <- [0..paths.len()): {

        #{index-out=zero}
        fp = paths[j]
        acc = shs-check-file(fp, acc)
    }
    k <- [0..acc.len()): {

        #{index-out=zero}
        f = acc[k]
        print(shs-render(f))
    }
    nf = acc.len()
    print('shs-check: scanned', paths.len(), 'file(s), violations =', nf)
    nf > 0 -> {
        code = EXIT-BAD
        return
    }
    print('shs-check: OK')
}

code = shs-main()
exit(code)
