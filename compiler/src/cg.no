; cg — MIR → LLVM IR 文本（M4-b 单块 + M4-c 控制流骨架）
;
; Authority：src/mir/codegen.go emitMIR / EmitLLVM（逐 op 发 IR 文本）。
;
; 覆盖 op（M4-b 单块 + M4-c 控制流/字符串）：
;   CONST / ADD / SUB / MUL / CALL / ALLOC / STORE / LOAD / RET
;   BR / CONDBR / CMPLT（多基本块；跨块传值用 alloca/store/load，不用 PHI）
;   STRCONST / STRLEN / STRCAT（非 i64 型别 %str-long）
;   SALLOC / SSTORE / SLOAD（%str-long 跨基本块走 alloca，无 PHI）
;   VECNEW / VECPUSH / VECLEN / VECGET（%vec，元素仅 i64）
;   OPTNONE / OPTSOME / OPTTAG / OPTISOK / OPTGET（%option，i64 载荷）
;   OPTMKSTR / OPTGETSTR（%option，str 载荷内联；B28：16B %str-long 只占 24B [3 x i64] 槽前 16B，len/cap 走 zext/trunc）
;   OPTMKVEC / OPTGETVEC（%option，vec 载荷内联 s40；B28b：%vec 是 16B { u32, u32, i64 }，只占 24B [3 x i64] 槽前 16B，len/cap 走 zext/trunc）
;   OPTMKF64 / OPTGETF64（%option，f64/double 载荷内联 s46；f64 与 [3 x i64] 槽元素等宽，bitcast double<->i64 落/取 slot[0]，无需 ptrtoint/helper）
;   OPTALLOC / OPTSTORE / OPTLOAD（%option 跨基本块走 alloca %option，第八命名空间 %os，无 PHI s41）
;   STRUCT-MK / STRUCT-GET / STRUCT-SET（%struct.point，值语义；SET 是「读旧出新值」）
;   STALLOC / STSTORE / STLOAD（%struct.point 跨基本块走 alloca %struct.point，无 PHI）
;   RETAIN / RELEASE（%str-long 的 RC 发射原语；取 data 指针 call @nolang_rc_retain/release）
;   有符号 ALU：ADD/SUB/MUL / AND/OR/XOR/SHL/SHR(ashr) / CMP*(icmp s*)；DIV/MOD 发 sdiv/srem
;     但裹除零 select 護欄（s38，见 cg-div-guard）
;   无符号 ALU（s36）：SHRU(lshr) / CMP*U(icmp u*)；DIVU/MODU 发 udiv/urem 亦裹同一護欄（s38）
;   STEREQ / STNEQ（str 结构相等 s42：操作数在 %sv，走运行时 @str_eq；icmp %str-long 非法故用专用 op）
;   VECEQ（vec 元素相等 s43：操作数在 %vc，走运行时 @__nolang_vec_eq_i64；icmp %vec 非法故用专用 op，仅适用元素型 i64）
;   OPTEQ / OPTNEQ（option 值相等 s44：操作数在 %op，发 tag icmp eq AND payload(i64) icmp eq 再 and；单块降级无需 helper，仅适用 i64 载荷）
;   OPTEQSTR / OPTNEQSTR（option 的 str 载荷相等 s45：操作数在 %op，发 tag icmp eq AND 从 [3 x i64] 槽重建 %str-long 后 call @str_eq 再 and；单块降级，复用 s42 @str_eq 无需新增 helper，仅适用 str 载荷）。B28：重建前 slot[0..1] 须 trunc i64→i32
;   OPTEQF64 / OPTNEQF64（option 的 f64/double 载荷相等 s47：操作数在 %op，发 tag icmp eq AND 取 slot[0]（i64）各 bitcast i64→double 后 fcmp oeq 再 and；单块降级无需 helper，仅适用 f64 载荷；镜像 Go emitOptionValueEq 的 double 分支）
;   OPTLT / OPTLE / OPTGT / OPTGE（option 排序 s51：操作数在 %op，只取两侧 slot[0]（i64 载荷）发 icmp slt/sle/sgt/sge 再 zext；【无 tag 项、无 and】——Go emitOptionValueOrder 原函即只比值；单块降级无 helper，仅适用 i64 载荷）
;   OPTLTF64 / OPTLEF64 / OPTGTF64 / OPTGEF64（option 的 f64/double 载荷排序 s52：操作数在 %op，取两侧 slot[0] 循 s47 bitcast i64→double 后发 fcmp olt/ole/ogt/oge 再 zext；【无 tag 项、无 and】同 s51 int 翼纪律，镜像 Go emitOptionValueOrder 的 double 分支；单块降级无 helper，仅适用 f64 载荷）
;   OPTLTSC / OPTLESC / OPTGTSC / OPTGESC（option 与纯量排序 s53：一侧 %op 一侧普通 %v，方向由 vty 判定（镜像 Go emitCmp 的 aOpt/bOpt 动态判侧）；只提 option 侧 slot[0] 载荷与纯量直接 icmp slt/sle/sgt/sge 再 zext——【无 tag 项、无 and、谓词不翻转】，操作数次序随源表达式不变；单块降级无 helper，仅适用 i64 载荷×i64 纯量）
;   OPTLTSCF / OPTLESCF / OPTGTSCF / OPTGESCF（option 与 f64 纯量排序 s54：镜像 Go emitCmp aOpt/bOpt 提取后落 double 翼 codegen.go:6686-6714；vty 双护栏判向且非 option 侧须 TY-F64；提 option 侧 slot[0] bitcast i64→double（等价 Go 对载荷 typed load double）后与 %fd 纯量 fcmp olt/ole/ogt/oge 再 zext；【无 tag 项、无 and、谓词不翻转】同 s53 纪律；双护栏皆不满足时不发射，护栏不过不回退（呼叫方保证））
;     ——与有符号族共用 %v 命名空间与 i64 型别，只差助记符；TY-U64 型别码走 cg-ty-name/cg-val-prefix 默认臂
;   浮点 ALU（s37）：ADD/SUB/MUL/DIV/MOD 与 CMP* 按**值型别分派**——vty 为 TY-F64 时发
;     fadd/fsub/fmul/fdiv/frem double %fd… / fcmp <oeq/une/olt/ole/ogt/oge> double（忠实 Go
;     emitArith 的 isFloat；ADD/SUB/MUL/位运算走原 i64/%v 分支不变，整数 DIV/MOD 另加 s38 護欄、
;     但 fdiv/frem 无護栏）。TY-F64 是真独立型别，须进两张映射
;   一元 ALU（s48）：NEG / NOT——NEG 复用 s37 的值型别分派（vty[d]==TY-F64⇒fneg double %fd…，否则⇒sub i64 0, %v…），
;     NOT⇒xor i64 1, %v…（翻转 0/1 布尔）。均单块降级、无 helper；忠实 Go emitNeg（非 option 路不插溢出护栏）／emitNot
;   vec→str 重interpret（s49）：OP-STRFROMVEC——%vec 三欄位（len/cap/dat）逐欄位拷进 %str-long，dat（i64 整数指针）走 inttoptr→i8*（同 s28 OPTGETSTR 纪律）；单块降级、无 helper；忠实 Go emitStrFromVec。B28b：len/cap 本就是 i32（%vec 16B），直接 insertvalue，无需 trunc
;   str 容量欄（s50）：OP-STRCAP——extractvalue %str-long field 1（与 OP-STRLEN 的 field 0 成对，Go 原以 fieldIdx 分派）；单块降级、无 helper；忠实 Go emitLenCap 的 OpCap/KindStr 分支。B28：讀出後 zext i32→i64
; 签名（M4-c 第七件）：cg-emit-cfg-t 接受 retty + ptyps[]，形参与返回值可按型别
;   取 i64 / %str-long / %vec / %option；cg-emit-cfg 是「全 i64」的便捷壳（旧 API 零改动）。
; 值 id → SSA 名 %v<id>；槽 id → %s<id>；字符串值 → %sv<id>；字符串槽 → %ss<id>；
; 向量值 → %vc<id>；option 值 → %op<id>；浮点值 → %fd<id>；结构体值 → %st<id>；结构体槽 → %sts<id>；
; 函数参数即值 id 1..nargs，其命名空间由 ptyps[] 决定。
; 块标签：id 0 → entry，其余 → bb<id>。
;
; ⚠️ 本模块刻意【惰性】：目前只被 compiler/tests/cg-test.no 引用，尚未接 drv。

# /compiler/src/util/sb.sb
# /compiler/src/mir
# /compiler/src/cg-runtime

; 块 id → LLVM 标签名（0 → entry，其余 → bb<id>）。
; id: 數值
; s: 結果字串
cg-label = (id i64) (s str) {
    s = 'bb' - id.to-str()
    id == 0 -> s = 'entry'
}

; 字符串字面量的数组长度（字节数 + 1，含结尾 NUL）。
; t: 字串
; n: 數量
cg-strlen1 = (t str) (n i64) {
    n = t.len-bytes()

    #{overflow=wrap}
    n = n + 1
}

; 字面量全局符号名：`@.s.<函式名>.<指令下标>`（s34）。
;   ⚠️ 全局符号在**模块**内唯一，而发射器是**逐函式**调用的 ⇒ 只按下标命名时，
;      两个函数各自第 k 条 STRCONST 会撞成同名 ⇒ `opt: redefinition of global '@.s1'`。
;      函式名在同一模块内唯一，前缀它即可零状态（不需要模块级计数器）。
;   ⚠️ 带函式名还顺带让 IR 可读：一眼能看出字面量属于哪个函数。
; fname: 字串
; k: 數值
; r: 結果字串
cg-lit-name = (fname str, k i64) (r str) {
    r = '@.s.' - fname - '.' - k.to-str()
}

; 单块便捷入口（全部指令属块 0）。保留 M4-b 的 7 参数 API，
;   ⚠️ s64 起多一个【必填】的实参侧池 args——宁可让呼叫点编译不过，也不给隐式空池：
;   空池碰上 CALL 会发未 define 的 %v0（旧口径「空即默认」的静默退化教训见本档 s20 纪律）。
; 造一個「長度 n、全 0」的 i64 容器（型別表 / 基本塊表的零初始化）。
;   ⚠️ `[] .with-len(n)` **只保留容量、不設長度**（實測 `.len()` 仍為 0、`.at(0)` 為 nil），
;   底層緩衝未初始化；而發射器按下標直接讀 `ptyps[q]`／`blks[k]`／`cty[k]` ⇒
;   讀到亂數 → `cg-ty-name` 把它當 struct 型別碼，產出 `%struct.s<亂數>` 這種非法署名
;   （2026-11-12 修，詳 §11 後 ⑦）。一律走本函式明確 push 0。
; n: 數值
; r: 結果容器
cg-zeros = (n i64) (r []i64) {
    r = []
    i <- [0..n): {
        r.push(0)
    }
}

; name: 名稱
; nargs: 數值
; ops: 容器
; dsts: 容器
; xa: 容器
; bs: 容器
; syms: 容器
; args: 實參值 id 側池（OP-CALL 用，其余传空池）
; r: 結果字串
cg-emit-func = (name str, nargs i64, ops []i64, dsts []i64, xa []i64, bs []i64, syms []str, args []i64) (r str) {
    n = ops.len()
    z = cg-zeros(n)
    r = cg-emit-cfg(name, nargs, z, ops, dsts, xa, bs, syms, args)
}

; 型别码 → LLVM 型别名（TY-I64 → 'i64'，其余是 prelude 里的具名型）。
;   ⚠️ 实现已迁到 cg-runtime（s32）：结构体型别声明也要用它，而声明属于模块级装配点，
;      不能反向依赖发射器 ⇒ 全库只有 cg-runtime-ty-name 一份映射，这里只做转发。
; t: 數值
; s: 結果字串
cg-ty-name = (t i64) (s str) {
    s = cg-runtime-ty-name(t)
}

; 型别码 → 值命名空间前缀（%v / %sv / %vc / %op / %st）。
;   LLVM 里 SSA 名全局唯一，同名不同型直接报错 ⇒ 前缀必须跟着型别走。
; t: 數值
; s: 結果字串
cg-val-prefix = (t i64) (s str) {
    s = '%v'
    t == TY-STR -> s = '%sv'
    t == TY-VEC -> s = '%vc'
    t == TY-OPT -> s = '%op'
    t == TY-F64 -> s = '%fd'
    t >= TY-STRUCT-BASE -> s = '%st'
}

; 越界安全地读 vty[id]（s37）：算术/比较按值型别分派后要读 vty[d]/vty[x]，而直接调
;   cg-emit-cfg-t 的调用方未必把 vty 铺到覆盖每个结果 id（旧契约只对 CALL/struct 强制）。
;   越界时返回元素零值 0 = TY-I64 ⇒ 走原整数路径（与 cg-ty-name/cg-val-prefix 的「未知即 i64」默认一致）。
; vty: 容器
; id: 數值
; t: 型别码（越界 → TY-I64）
cg-vty-at = (vty []i64, id i64) (t i64) {
    t = vty[id]: {
        ok -> it

        -> _
    }
}

; 整數除法除零 select 護欄（s38 / §11 B14）：對齊 Go 權威 emitArith 的 plain 路徑護欄。
;   每條整數 / %（非 float）都不再發裸 sdiv/srem/udiv/urem——LLVM 定義除零（及有符號
;   sdiv/srem 的 (MIN,-1)）為 UB，優化器據此折疊。護欄分三步：
;     ① zeroDiv = icmp eq divisor, 0；有符號另加 isMin/isNeg1 → and → or 得 badDiv
;     ② safeDivisor = select badDiv, 1, divisor（永非零），用它發 <mn>
;     ③ %v<dst> = select zeroDiv, 0, raw（除零結果定義化為 0；(MIN,-1) 由安全除數 1 得定義值）
;   中間量按指令下標 k 命名（%dz.<k>/%dmn.<k>/…，與 Go %dz.<seq> 同構、互不衝突）。
;   ⚠️ 自舉整型 ALU 恆為 i64（u64 共用 i64 LLVM 型別），故 MIN 恆取 -9223372036854775808。
;   s39（§11 B14 補全）：除零結果定義化後追發 call void @__nolang_div_zero_report(i1 %dz.<k>)，
;     該 helper 與 @nolang_msg_div_zero 字串由 cg-runtime prelude 每模組發一次，write(2,…) 到 stderr（對齊 Go divZeroReport）。
; mn: 助記符（sdiv/srem/udiv/urem）
; d: 結果值 id；x: 被除數 id；y: 除數 id；k: 指令下標；sgn: 1=有符號含 (MIN,-1)
cg-div-guard = (mn str, d i64, x i64, y i64, k i64, sgn i64) (r str) {
    g = sb.init(256)
    ks = k.to-str()
    g.push('\t%dz.')
    g.push(ks)
    g.push(' = icmp eq i64 %v')
    g.push(y.to-str())
    g.push(', 0\n')
    badv = '%dz.' - ks
    sgn == 1 -> {
        g.push('\t%dmn.')
        g.push(ks)
        g.push(' = icmp eq i64 %v')
        g.push(x.to-str())
        g.push(', -9223372036854775808\n')
        g.push('\t%dn1.')
        g.push(ks)
        g.push(' = icmp eq i64 %v')
        g.push(y.to-str())
        g.push(', -1\n')
        g.push('\t%db.')
        g.push(ks)
        g.push(' = and i1 %dmn.')
        g.push(ks)
        g.push(', %dn1.')
        g.push(ks)
        g.push('\n')
        g.push('\t%dall.')
        g.push(ks)
        g.push(' = or i1 %dz.')
        g.push(ks)
        g.push(', %db.')
        g.push(ks)
        g.push('\n')
        badv = '%dall.' - ks
    }
    g.push('\t%ds.')
    g.push(ks)
    g.push(' = select i1 ')
    g.push(badv)
    g.push(', i64 1, i64 %v')
    g.push(y.to-str())
    g.push('\n')
    g.push('\t%cr.')
    g.push(ks)
    g.push(' = ')
    g.push(mn)
    g.push(' i64 %v')
    g.push(x.to-str())
    g.push(', %ds.')
    g.push(ks)
    g.push('\n')
    g.push('\t%v')
    g.push(d.to-str())
    g.push(' = select i1 %dz.')
    g.push(ks)
    g.push(', i64 0, i64 %cr.')
    g.push(ks)
    g.push('\n')
    g.push('\tcall void @__nolang_div_zero_report(i1 %dz.')
    g.push(ks)
    g.push(')\n')
    r = g.str()
}

; 全部形参/返回值/值都是 i64 的便捷入口（M4-b 起的 8 参数 API）。
;   ⚠️ 这里**自己构造**全 0 的型别表（而不是让发射器「空表就当 i64」）——
;   s20 的教训：靠「空/0 即默认」的隐式约定，漏填就是静默退化。
; name: 名稱
; nargs: 數值
; blks: 容器
; ops: 容器
; dsts: 容器
; xa: 容器
; bs: 容器
; syms: 容器
; args: 實參值 id 側池（轉發給 cg-emit-cfg-t；無 CALL 的體傳空池）
; r: 結果字串
cg-emit-cfg = (name str, nargs i64, blks []i64, ops []i64, dsts []i64, xa []i64, bs []i64, syms []str, args []i64) (r str) {
    n = ops.len()

    #{overflow=wrap}
    m = n + 1
    ty = cg-zeros(nargs)
    vt = cg-zeros(m)
    ct = cg-zeros(n)
    r = cg-emit-cfg-t(name, TY-I64, nargs, ty, vt, ct, blks, ops, dsts, xa, bs, syms, args)
}

; 发射一个带型别签名的函数（可多基本块）。
; ptyps[q] = 第 q 个形参（值 id q+1）的型别码；retty = 返回值型别码。
; vty[id]  = 第 id 号值的型别码（**按值 id 索引**，长度 ≥ 最大值 id + 1）；
;            CALL 的实参型别与值命名空间都从这里取，不需要额外的调用点签名。
; cty[k]   = 第 k 条指令**结果**的型别码（CALL 的结果型别靠它）。
; blks[k]  = 第 k 条指令所属块 id；块切换处发标签。
; name: 名稱
; retty: 數值
; nargs: 數值
; ptyps: 容器
; vty: 容器
; cty: 容器
; blks: 容器
; ops: 容器
; dsts: 容器
; xa: 容器
; bs: 容器
; syms: 容器
; args: 实参值 id 侧池（s64）——只有 OP-CALL 读它：xa[k] = 池内基址下标、bs[k] = 个数
; r: 結果字串
cg-emit-cfg-t = (name str, retty i64, nargs i64, ptyps []i64, vty []i64, cty []i64, blks []i64, ops []i64, dsts []i64, xa []i64, bs []i64, syms []str, args []i64) (r str) {
    b = sb.init(1024)
    n = ops.len()

    ; 前置：每个 OP-STRCONST 的字符串字面量全局（顶层实体，必须在 define 之前）。
    ; ⚠️ 结构体型别 `%struct.point` **不在这里发**——它由 prelude（cg-runtime-struct-type）
    ;    唯一发射。若每函式各发一次，多函式模块会报 "redefinition of type named"。
    g <- [0..n): {
        ops[g] == OP-STRCONST -> {
            t = syms[g]
            b.push(cg-lit-name(name, g))
            b.push(' = private unnamed_addr constant [')
            b.push(cg-strlen1(t).to-str())
            b.push(' x i8] [')

            ; s99o：以「i8 整數陣」形式逐位元組寫入，對任意位元組（含反斜線、NUL、控制字元）都合法，
            ;   避免 c"..." 形式把字串內的 \6E 等文字誤當跳脫序列（自舉碼產生器把 IR 片段存成字串常數，
            ;   其內含 \6E 等，原 c"..." 形式會讓 opt 報 constant expression type mismatch）。
            nb = t.len-bytes()
            si = 0
            (si < nb) {
                si > 0 -> b.push(', ')
                bv = t.byte(si)
                bv: {
                    ok(v) -> b.push('i8 ' - v.to-str())

                    -> _
                }

                #{overflow=wrap}
                si = si + 1
            }
            nb > 0 -> b.push(', i8 0')
            nb == 0 -> b.push('i8 0')
            b.push(']')
            b.push('\n')
        }
    }
    b.push('define ')
    b.push(cg-ty-name(retty))
    b.push(' @')
    b.push(name)
    b.push('(')
    q = 0
    p = 1

    #{overflow=wrap}
    (q < nargs) {
        q > 0 -> b.push(', ')
        pt = ptyps[q]
        b.push(cg-ty-name(pt))
        b.push(' ')
        b.push(cg-val-prefix(pt))
        b.push(p.to-str())

        #{overflow=wrap}
        q = q + 1

        #{overflow=wrap}
        p = p + 1
    }
    b.push(') {\n')
    cur = -1
    k <- [0..n): {
        bk = blks[k]
        bk != cur -> {
            b.push(cg-label(bk) - ':\n')
            cur = bk
        }
        op = ops[k]
        d = dsts[k]
        x = xa[k]
        y = bs[k]
        op == OP-CONST -> {

            ; s73：dest 为 TY-F64 ⇒ 常量源于 f64 字面量（raw 存 syms[k]）⇒ 以 fadd double 0.0, <raw> 物化为 %fd SSA
            ;   ⚠ s74 后两条路可达：字面量降级与 slot-decl 的 f64 零初始化（sym 固定 '0.0'）；空 sym 会产非法 IR，呼叫方保证 sym 非空
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
                b.push(d.to-str())
                b.push(' = fadd double 0.0, ')
                b.push(syms[k])
                b.push('\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push('\t%v')
                b.push(d.to-str())
                b.push(' = add i64 0, ')
                b.push(x.to-str())
                b.push('\n')
            }
        }
        op == OP-ADD -> {
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
                b.push(d.to-str())
                b.push(' = fadd double %fd')
                b.push(x.to-str())
                b.push(', %fd')
                b.push(y.to-str())
                b.push('\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push('\t%v')
                b.push(d.to-str())
                b.push(' = add i64 %v')
                b.push(x.to-str())
                b.push(', %v')
                b.push(y.to-str())
                b.push('\n')
            }
        }
        op == OP-SUB -> {
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
                b.push(d.to-str())
                b.push(' = fsub double %fd')
                b.push(x.to-str())
                b.push(', %fd')
                b.push(y.to-str())
                b.push('\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push('\t%v')
                b.push(d.to-str())
                b.push(' = sub i64 %v')
                b.push(x.to-str())
                b.push(', %v')
                b.push(y.to-str())
                b.push('\n')
            }
        }
        op == OP-MUL -> {
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
                b.push(d.to-str())
                b.push(' = fmul double %fd')
                b.push(x.to-str())
                b.push(', %fd')
                b.push(y.to-str())
                b.push('\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push('\t%v')
                b.push(d.to-str())
                b.push(' = mul i64 %v')
                b.push(x.to-str())
                b.push(', %v')
                b.push(y.to-str())
                b.push('\n')
            }
        }
        op == OP-AND -> {
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = and i64 %v')
            b.push(x.to-str())
            b.push(', %v')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-OR -> {
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = or i64 %v')
            b.push(x.to-str())
            b.push(', %v')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-XOR -> {
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = xor i64 %v')
            b.push(x.to-str())
            b.push(', %v')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-SHL -> {
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = shl i64 %v')
            b.push(x.to-str())
            b.push(', %v')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-DIV -> {
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
                b.push(d.to-str())
                b.push(' = fdiv double %fd')
                b.push(x.to-str())
                b.push(', %fd')
                b.push(y.to-str())
                b.push('\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push(cg-div-guard('sdiv', d, x, y, k, 1))
            }
        }
        op == OP-MOD -> {
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
                b.push(d.to-str())
                b.push(' = frem double %fd')
                b.push(x.to-str())
                b.push(', %fd')
                b.push(y.to-str())
                b.push('\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push(cg-div-guard('srem', d, x, y, k, 1))
            }
        }

        ; ── 無符號 ALU（s36）：同 %v 命名空間、同 i64 型別，只換助記符 ──
        op == OP-SHRU -> {
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = lshr i64 %v')
            b.push(x.to-str())
            b.push(', %v')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-DIVU -> {
            b.push(cg-div-guard('udiv', d, x, y, k, 0))
        }
        op == OP-MODU -> {
            b.push(cg-div-guard('urem', d, x, y, k, 0))
        }

        ; ── 一元 ALU（s48）：NEG 按值型别分派（double⇒fneg／否则⇒sub 0,x）、NOT⇒xor 1；均单块无 helper ──
        op == OP-NEG -> {

            ; dst = 结果值 id；x = 操作数 id。镜像 Go emitNeg：非 option 路径 float⇒fneg double、int⇒sub 0,x（不插溢出护栏）。
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
                b.push(d.to-str())
                b.push(' = fneg double %fd')
                b.push(x.to-str())
                b.push('\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push('\t%v')
                b.push(d.to-str())
                b.push(' = sub i64 0, %v')
                b.push(x.to-str())
                b.push('\n')
            }
        }
        op == OP-NOT -> {

            ; dst = i64 结果值 id；x = 布尔值 id（i64 0/1）。镜像 Go emitNot：xor 1 翻转最低位。
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = xor i64 1, %v')
            b.push(x.to-str())
            b.push('\n')
        }
        op == OP-CALL -> {
            rt = cty[k]
            b.push('\t')
            b.push(cg-val-prefix(rt))
            b.push(d.to-str())
            b.push(' = call ')
            b.push(cg-ty-name(rt))
            b.push(' @')
            b.push(syms[k])
            b.push('(')

            ; 实参：从侧池 args 取 y = bs[k] 个，第 j 个的值 id = args[x + j]（x = xa[k] = 基址下标）；
            ;   型别与命名空间按【值 id】查 vty[]（与 s64 前的旧连续口径同源，只是值 id 可任意散布）。
            ; ⚠️ 越界读到空 ⇒ 拿到哑元 id 0，发 %v0；id 0 从未 define ⇒ LLVM verify 报错（响亮失败，不静默）
            j = 0
            (j < y) {
                j > 0 -> b.push(', ')
                q = args[x + j]: {
                    ok -> it

                    -> _
                }
                at = vty[q]
                b.push(cg-ty-name(at))
                b.push(' ')
                b.push(cg-val-prefix(at))
                b.push(q.to-str())

                #{overflow=wrap}
                j = j + 1
            }
            b.push(')\n')
        }
        op == OP-ALLOC -> {
            b.push('\t%s')
            b.push(d.to-str())

            ; s74：dest 值型别 TY-F64 ⇒ alloca double（槽 id 由 h2m-alloc 携 ty 登记进 vty）；其余仍 alloca i64（含 TY-U64 同宽共路）
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push(' = alloca double\n')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push(' = alloca i64\n')
            }
        }
        op == OP-STORE -> {

            ; s74：按【源值型别】分派——TY-F64 ⇒ store double %fd…；其余 ⇒ store i64 %v…（目标槽前缀 %s 共路）
            cg-vty-at(vty, x) == TY-F64 -> {
                b.push('\tstore double %fd')
            }
            cg-vty-at(vty, x) != TY-F64 -> {
                b.push('\tstore i64 %v')
            }
            b.push(x.to-str())
            cg-vty-at(vty, x) == TY-F64 -> {
                b.push(', double* %s')
            }
            cg-vty-at(vty, x) != TY-F64 -> {
                b.push(', i64* %s')
            }
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-LOAD -> {

            ; s74：按【dest 值型别】分派——TY-F64 ⇒ %fd… = load double；其余 ⇒ %v… = load i64
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push('\t%fd')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push('\t%v')
            }
            b.push(d.to-str())
            cg-vty-at(vty, d) == TY-F64 -> {
                b.push(' = load double, double* %s')
            }
            cg-vty-at(vty, d) != TY-F64 -> {
                b.push(' = load i64, i64* %s')
            }
            b.push(x.to-str())
            b.push('\n')
        }
        op == OP-CMPLT -> {
            b.push('\t%c')
            b.push(k.to-str())
            cg-vty-at(vty, x) == TY-F64 -> b.push(' = fcmp olt double %fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push(' = icmp slt i64 %v')
            b.push(x.to-str())
            b.push(', ')
            cg-vty-at(vty, x) == TY-F64 -> b.push('%fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push('%v')
            b.push(y.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %c')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-CMPEQ -> {
            b.push('\t%c')
            b.push(k.to-str())
            cg-vty-at(vty, x) == TY-F64 -> b.push(' = fcmp oeq double %fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push(' = icmp eq i64 %v')
            b.push(x.to-str())
            b.push(', ')
            cg-vty-at(vty, x) == TY-F64 -> b.push('%fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push('%v')
            b.push(y.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %c')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-CMPNE -> {
            b.push('\t%c')
            b.push(k.to-str())
            cg-vty-at(vty, x) == TY-F64 -> b.push(' = fcmp une double %fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push(' = icmp ne i64 %v')
            b.push(x.to-str())
            b.push(', ')
            cg-vty-at(vty, x) == TY-F64 -> b.push('%fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push('%v')
            b.push(y.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %c')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-CMPLE -> {
            b.push('\t%c')
            b.push(k.to-str())
            cg-vty-at(vty, x) == TY-F64 -> b.push(' = fcmp ole double %fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push(' = icmp sle i64 %v')
            b.push(x.to-str())
            b.push(', ')
            cg-vty-at(vty, x) == TY-F64 -> b.push('%fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push('%v')
            b.push(y.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %c')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-CMPGT -> {
            b.push('\t%c')
            b.push(k.to-str())
            cg-vty-at(vty, x) == TY-F64 -> b.push(' = fcmp ogt double %fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push(' = icmp sgt i64 %v')
            b.push(x.to-str())
            b.push(', ')
            cg-vty-at(vty, x) == TY-F64 -> b.push('%fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push('%v')
            b.push(y.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %c')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-CMPGE -> {
            b.push('\t%c')
            b.push(k.to-str())
            cg-vty-at(vty, x) == TY-F64 -> b.push(' = fcmp oge double %fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push(' = icmp sge i64 %v')
            b.push(x.to-str())
            b.push(', ')
            cg-vty-at(vty, x) == TY-F64 -> b.push('%fd')
            cg-vty-at(vty, x) != TY-F64 -> b.push('%v')
            b.push(y.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %c')
            b.push(k.to-str())
            b.push(' to i64\n')
        }

        ; ── str 结构相等（s42）：操作数在 %sv，走运行时 @str_eq，绝不对 %str-long 发 icmp ──
        op == OP-STEREQ -> {

            ; xa[k] = 左 str 值 id；bs[k] = 右 str 值 id；dst = i64 结果（0/1）。
            b.push('\t%se')
            b.push(k.to-str())
            b.push(' = call i1 @str_eq(%str-long %sv')
            b.push(x.to-str())
            b.push(', %str-long %sv')
            b.push(y.to-str())
            b.push(')\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %se')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-STNEQ -> {

            ; 同 STEREQ，但 i1 结果先 xor true 取反再 zext。
            b.push('\t%se')
            b.push(k.to-str())
            b.push(' = call i1 @str_eq(%str-long %sv')
            b.push(x.to-str())
            b.push(', %str-long %sv')
            b.push(y.to-str())
            b.push(')\n\t%sn')
            b.push(k.to-str())
            b.push(' = xor i1 %se')
            b.push(k.to-str())
            b.push(', true\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %sn')
            b.push(k.to-str())
            b.push(' to i64\n')
        }

        ; ── vec 元素相等（s43）：call @__nolang_vec_eq_i64 + zext；操作数在 %vc，icmp %vec 非法故走 helper ──
        op == OP-VECEQ -> {
            b.push('\t%veq')
            b.push(k.to-str())
            b.push(' = call i1 @__nolang_vec_eq_i64(%vec %vc')
            b.push(x.to-str())
            b.push(', %vec %vc')
            b.push(y.to-str())
            b.push(')\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %veq')
            b.push(k.to-str())
            b.push(' to i64\n')
        }

        ; ── option 值相等（s44）：tag eq AND payload(i64) eq → and → zext；操作数在 %op，单块降级无需 helper ──
        op == OP-OPTEQ -> {

            ; xa[k] = 左 option 值 id；bs[k] = 右 option 值 id；dst = i64 结果（0/1）。
            ; 镜像 Go emitOptionValueEq 的 i64 载荷分支：先比 tag（field 0），再比载荷（field 1,0），两者 and。
            b.push('\t%otx')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 0\n\t%oty')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(y.to-str())
            b.push(', 0\n\t%otq')
            b.push(k.to-str())
            b.push(' = icmp eq i64 %otx')
            b.push(k.to-str())
            b.push(', %oty')
            b.push(k.to-str())
            b.push('\n\t%opx')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n\t%opy')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(y.to-str())
            b.push(', 1, 0\n\t%opq')
            b.push(k.to-str())
            b.push(' = icmp eq i64 %opx')
            b.push(k.to-str())
            b.push(', %opy')
            b.push(k.to-str())
            b.push('\n\t%oa')
            b.push(k.to-str())
            b.push(' = and i1 %otq')
            b.push(k.to-str())
            b.push(', %opq')
            b.push(k.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %oa')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-OPTNEQ -> {

            ; 同 OPTEQ，但 and 结果先 xor i1 true 取反再 zext。
            b.push('\t%otx')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 0\n\t%oty')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(y.to-str())
            b.push(', 0\n\t%otq')
            b.push(k.to-str())
            b.push(' = icmp eq i64 %otx')
            b.push(k.to-str())
            b.push(', %oty')
            b.push(k.to-str())
            b.push('\n\t%opx')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n\t%opy')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(y.to-str())
            b.push(', 1, 0\n\t%opq')
            b.push(k.to-str())
            b.push(' = icmp eq i64 %opx')
            b.push(k.to-str())
            b.push(', %opy')
            b.push(k.to-str())
            b.push('\n\t%oa')
            b.push(k.to-str())
            b.push(' = and i1 %otq')
            b.push(k.to-str())
            b.push(', %opq')
            b.push(k.to-str())
            b.push('\n\t%on')
            b.push(k.to-str())
            b.push(' = xor i1 %oa')
            b.push(k.to-str())
            b.push(', true\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %on')
            b.push(k.to-str())
            b.push(' to i64\n')
        }

        ; ── option 排序（s51）：只比载荷（field 1,0）icmp slt/sle/sgt/sge，【无 tag 项】；镜像 Go emitOptionValueOrder 的有符号 int 分支 ──
        op == OP-OPTLT -> {

            ; xa[k] = 左 option 值 id；bs[k] = 右 option 值 id；dst = i64 结果（0/1）。
            ; 镜像 Go emitOptionValueOrder（codegen.go:6294）的 icmp slt 分支：只比载荷，无 tag 项无 and（异于 s44 OPTEQ）。
            ; nil 槽为 zeroinitializer（值 0），nil<some(7)=1、nil<nil=0，与 Go 同形。
            b.push('\t%opx')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n\t%opy')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(y.to-str())
            b.push(', 1, 0\n\t%oq')
            b.push(k.to-str())
            b.push(' = icmp slt i64 %opx')
            b.push(k.to-str())
            b.push(', %opy')
            b.push(k.to-str())
            b.push('\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %oq')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-OPTLE -> {

            ; 同 OPTLT，谓词换 sle（Go 同函 OpLe⇒slt/sle 映射的有符号 int 翼）。
            b.push('\t%opx')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n\t%opy')
            b.push(k.to-str())
