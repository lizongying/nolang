            b.push('\tcall void @vec_free(%vec %vc')
            b.push(x.to-str())
            b.push(')\n')
        }
        op == OP-PRINT -> {

            ; s100：语句位内建输出。dst 恒 0（无结果值）；y = kind 码；x = 值 id（kind 2/3/6/7 为 0）。
            ;   kind → 助手：0 @print_i64 / 1 @print_str / 2 @print_nl / 3 @print_space
            ;               4 @eprint_i64 / 5 @eprint_str / 6 @eprint_nl / 7 @eprint_space
            ;   ⚠️ 实参型别按 vty[x] 取前缀（%v / %sv），不硬编码——与 Go 的 argT 分派同义。
            y == 0 -> {
                b.push('\tcall void @print_i64(i64 %v')
                b.push(x.to-str())
                b.push(')\n')
            }
            y == 1 -> {
                b.push('\tcall void @print_str(%str-long %sv')
                b.push(x.to-str())
                b.push(')\n')
            }
            y == 2 -> b.push('\tcall void @print_nl()\n')
            y == 3 -> b.push('\tcall void @print_space()\n')
            y == 4 -> {
                b.push('\tcall void @eprint_i64(i64 %v')
                b.push(x.to-str())
                b.push(')\n')
            }
            y == 5 -> {
                b.push('\tcall void @eprint_str(%str-long %sv')
                b.push(x.to-str())
                b.push(')\n')
            }
            y == 6 -> b.push('\tcall void @eprint_nl()\n')
            y == 7 -> b.push('\tcall void @eprint_space()\n')
        }
        op == OP-STRFROMVEC -> {

            ; s49（鏡像 Go emitStrFromVec, codegen.go:13069）：dst = 字符串值 id；x = 向量值 id（TY-VEC）。
            ; %vec→%str-long 逐欄位重interpret：f0/f1 已是 i32 的 len/cap（16B 佈局，無需 trunc）；f2=dat 是整數指針（i64）⇒ inttoptr i64→i8*。
            ; ⚠️ 同 OPTGETSTR：bitcast 不能指針⇄整數，故 f2 必須 inttoptr；中間步 %sfl/%sfc/%sfd/%sfp/%sfs0/%sfs1 按下標 k，最後一步才落規範 %sv<d>（規避 multiple definition）。
            ; ⚠️ 純單块降級、無需 helper；僅存欄位，dat 與原 vec 共享同一緩冲（不拷貝、不 retain）。
            b.push('\t%sfl')
            b.push(k.to-str())
            b.push(' = extractvalue %vec %vc')
            b.push(x.to-str())
            b.push(', 0\n\t%sfc')
            b.push(k.to-str())
            b.push(' = extractvalue %vec %vc')
            b.push(x.to-str())
            b.push(', 1\n\t%sfd')
            b.push(k.to-str())
            b.push(' = extractvalue %vec %vc')
            b.push(x.to-str())
            b.push(', 2\n\t%sfp')
            b.push(k.to-str())
            b.push(' = inttoptr i64 %sfd')
            b.push(k.to-str())
            b.push(' to i8*\n\t%sfs0')
            b.push(k.to-str())
            b.push(' = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %sfl')
            b.push(k.to-str())
            b.push(', 0\n\t%sfs1')
            b.push(k.to-str())
            b.push(' = insertvalue %str-long %sfs0')
            b.push(k.to-str())
            b.push(', i32 %sfc')
            b.push(k.to-str())
            b.push(', 1\n\t%sv')
            b.push(d.to-str())
            b.push(' = insertvalue %str-long %sfs1')
            b.push(k.to-str())
            b.push(', i8* %sfp')
            b.push(k.to-str())
            b.push(', 2\n')
        }
        op == OP-OPTNONE -> {
            b.push('\t%op')
            b.push(d.to-str())
            b.push(' = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 1, 0\n')
        }
        op == OP-OPTSOME -> {
            b.push('\t%op')
            b.push(d.to-str())
            b.push(' = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %v')
            b.push(x.to-str())
            b.push(', 1, 0\n')
        }
        op == OP-OPTTAG -> {
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 0\n')
        }
        op == OP-OPTISOK -> {
            b.push('\t%ot')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 0\n\t%c')
            b.push(k.to-str())
            b.push(' = icmp eq i64 %ot')
            b.push(k.to-str())
            b.push(', 0\n\t%v')
            b.push(d.to-str())
            b.push(' = zext i1 %c')
            b.push(k.to-str())
            b.push(' to i64\n')
        }
        op == OP-OPTGET -> {
            b.push('\t%v')
            b.push(d.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n')
        }
        op == OP-OPTMKSTR -> {

            ; dst = option 值 id；x = 字符串值 id。tag=0 + 把 %str-long 逐欄位 insertvalue 进 slot[0..2]。
            ; ⚠️ B28：%str-long 是 16B { i32, i32, i8* }，但 slot 仍是 24B [3 x i64] ⇒ 不再 1:1。
            ;    field 0/1 是 i32，須 zext i32→i64 才存得進 slot；field 2 是 i8* ⇒ ptrtoint。
            ; ⚠️ 不能把同一本地名 %op<d> 复用为多步 insertvalue 的输出（LLVM 报 multiple definition），
            ;   故中间步用 %om0<k>/%om1<k>/%om2<k>，最后一步才落到规范的 %op<d>。
            ; ⚠️ 字段 2 是 i8*（data 指针），但槽是 i64 数组 ⇒ 必须 ptrtoint/inttoptr（bitcast 不能指针<->整数）。
            ; 命名空间 %ol0<k>/%ol1<k>/%ol2<k>/%ol2b<k>/%om0<k>/%om1<k>/%om2<k> 按指令下标 k。
            b.push('\t%om0')
            b.push(k.to-str())
            b.push(' = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 0, 0\n')
            b.push('\t%ol0')
            b.push(k.to-str())
            b.push(' = extractvalue %str-long %sv')
            b.push(x.to-str())
            b.push(', 0\n\t%ol1')
            b.push(k.to-str())
            b.push(' = extractvalue %str-long %sv')
            b.push(x.to-str())
            b.push(', 1\n\t%ol2')
            b.push(k.to-str())
            b.push(' = extractvalue %str-long %sv')
            b.push(x.to-str())
            b.push(', 2\n\t%ol2b')
            b.push(k.to-str())
            b.push(' = ptrtoint i8* %ol2')
            b.push(k.to-str())
            b.push(' to i64\n\t%ol0w')
            b.push(k.to-str())
            b.push(' = zext i32 %ol0')
            b.push(k.to-str())
            b.push(' to i64\n\t%ol1w')
            b.push(k.to-str())
            b.push(' = zext i32 %ol1')
            b.push(k.to-str())
            b.push(' to i64\n\t%om1')
            b.push(k.to-str())
            b.push(' = insertvalue %option %om0')
            b.push(k.to-str())
            b.push(', i64 %ol0w')
            b.push(k.to-str())
            b.push(', 1, 0\n\t%om2')
            b.push(k.to-str())
            b.push(' = insertvalue %option %om1')
            b.push(k.to-str())
            b.push(', i64 %ol1w')
            b.push(k.to-str())
            b.push(', 1, 1\n\t%op')
            b.push(d.to-str())
            b.push(' = insertvalue %option %om2')
            b.push(k.to-str())
            b.push(', i64 %ol2b')
            b.push(k.to-str())
            b.push(', 1, 2\n')
        }
        op == OP-OPTGETSTR -> {

            ; dst = 字符串值 id；x = option 值 id。从 slot[0..2] 取 3 个 i64 字段，逐字段 insertvalue 重建 %str-long。
            ; ⚠️ B28：slot[0..1] 存的是 zext 過的 i64 ⇒ 重建前須 trunc i64→i32；field 2 仍 inttoptr 還原 i8*。
            ; ⚠️ 同 OPTMKSTR：中间步用 %og0<k>/%og1<k>，最后一步才落到规范的 %sv<d>；data 指针字段须 inttoptr。
            ; 命名空间 %ol0<k>/%ol1<k>/%ol2<k>/%ol2b<k>/%og0<k>/%og1<k> 按指令下标 k。
            b.push('\t%ol0')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n\t%ol1')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 1\n\t%ol2')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 2\n\t%ol2b')
            b.push(k.to-str())
            b.push(' = inttoptr i64 %ol2')
            b.push(k.to-str())
            b.push(' to i8*\n\t%ol0i')
            b.push(k.to-str())
            b.push(' = trunc i64 %ol0')
            b.push(k.to-str())
            b.push(' to i32\n\t%ol1i')
            b.push(k.to-str())
            b.push(' = trunc i64 %ol1')
            b.push(k.to-str())
            b.push(' to i32\n\t%og0')
            b.push(k.to-str())
            b.push(' = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %ol0i')
            b.push(k.to-str())
            b.push(', 0\n\t%og1')
            b.push(k.to-str())
            b.push(' = insertvalue %str-long %og0')
            b.push(k.to-str())
            b.push(', i32 %ol1i')
            b.push(k.to-str())
            b.push(', 1\n\t%sv')
            b.push(d.to-str())
            b.push(' = insertvalue %str-long %og1')
            b.push(k.to-str())
            b.push(', i8* %ol2b')
            b.push(k.to-str())
            b.push(', 2\n')
        }
        op == OP-OPTMKVEC -> {

            ; s40（§11 B8「option 的 vec 载荷」）：dst = option 值 id；x = 向量值 id（TY-VEC）。
            ;   %vec 是 16B { i32 len, i32 cap, i64 data }，但 slot 仍是 24B [3 x i64] ⇒ 不再 1:1：
            ;   field 0/1 是 i32，須 zext i32→i64 才存得進 slot；field 2（dat 已是整数指针）直接落 i64。
            ; ⚠️ 中间步 %vu0w/%vu1w 与 %mv0..%mv2 落规范 %op<d>（同 OPTMKSTR 规避 multiple definition）；命名空间按指令下标 k。
            ; ⚠️ 本 op 只【存储】不自动 retain；取得所有权须调用方紧接 OP-RETAIN（s28/s40 规矩）。
            b.push('\t%mv0')
            b.push(k.to-str())
            b.push(' = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 0, 0\n')
            b.push('\t%vu0')
            b.push(k.to-str())
            b.push(' = extractvalue %vec %vc')
            b.push(x.to-str())
            b.push(', 0\n\t%vu1')
            b.push(k.to-str())
            b.push(' = extractvalue %vec %vc')
            b.push(x.to-str())
            b.push(', 1\n\t%vu2')
            b.push(k.to-str())
            b.push(' = extractvalue %vec %vc')
            b.push(x.to-str())
            b.push(', 2\n\t%vu0w')
            b.push(k.to-str())
            b.push(' = zext i32 %vu0')
            b.push(k.to-str())
            b.push(' to i64\n\t%vu1w')
            b.push(k.to-str())
            b.push(' = zext i32 %vu1')
            b.push(k.to-str())
            b.push(' to i64\n\t%mv1')
            b.push(k.to-str())
            b.push(' = insertvalue %option %mv0')
            b.push(k.to-str())
            b.push(', i64 %vu0w')
            b.push(k.to-str())
            b.push(', 1, 0\n\t%mv2')
            b.push(k.to-str())
            b.push(' = insertvalue %option %mv1')
            b.push(k.to-str())
            b.push(', i64 %vu1w')
            b.push(k.to-str())
            b.push(', 1, 1\n\t%op')
            b.push(d.to-str())
            b.push(' = insertvalue %option %mv2')
            b.push(k.to-str())
            b.push(', i64 %vu2')
            b.push(k.to-str())
            b.push(', 1, 2\n')
        }
        op == OP-OPTGETVEC -> {

            ; s40：dst = 向量值 id（TY-VEC）；x = option 值 id。从 slot[0..2] 取 3 个 i64，
            ;   slot[0..1] 存的是 zext 過的 i64 ⇒ 重建 %vec 前須 trunc i64→i32；field 2 直接落 i64。
            ;   中间步 %vb0/%vb1 落规范 %vc<d>（同 OPTMKVEC 的 multiple-definition 规避）。
            b.push('\t%vo0')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n\t%vo1')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 1\n\t%vo2')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 2\n\t%vo0i')
            b.push(k.to-str())
            b.push(' = trunc i64 %vo0')
            b.push(k.to-str())
            b.push(' to i32\n\t%vo1i')
            b.push(k.to-str())
            b.push(' = trunc i64 %vo1')
            b.push(k.to-str())
            b.push(' to i32\n\t%vb0')
            b.push(k.to-str())
            b.push(' = insertvalue %vec zeroinitializer, i32 %vo0i')
            b.push(k.to-str())
            b.push(', 0\n\t%vb1')
            b.push(k.to-str())
            b.push(' = insertvalue %vec %vb0')
            b.push(k.to-str())
            b.push(', i32 %vo1i')
            b.push(k.to-str())
            b.push(', 1\n\t%vc')
            b.push(d.to-str())
            b.push(' = insertvalue %vec %vb1')
            b.push(k.to-str())
            b.push(', i64 %vo2')
            b.push(k.to-str())
            b.push(', 2\n')
        }

        ; ── option 的 f64（double）载荷内联写（s46）：bitcast double→i64 落 slot[0]；无 helper ──
        op == OP-OPTMKF64 -> {

            ; dst = option 值 id；x = 浮点值 id（TY-F64，住 %fd）。
            ; 同 OPTSOME 一步 insertvalue（tag 已内建于字面 { i64 0, ... }），只是喂进 slot[0] 的是 bitcast double→i64。
            ; ⚠ f64 与槽元素等宽（64↔64），bitcast 合法且无需 ptrtoint/inttoptr（异于 str 的 i8* data）。
            b.push('\t%mb')
            b.push(k.to-str())
            b.push(' = bitcast double %fd')
            b.push(x.to-str())
            b.push(' to i64\n\t%op')
            b.push(d.to-str())
            b.push(' = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 %mb')
            b.push(k.to-str())
            b.push(', 1, 0\n')
        }

        ; ── option 的 f64（double）载荷内联读（s46）：extractvalue slot[0] 再 bitcast i64→double；无 helper ──
        op == OP-OPTGETF64 -> {

            ; dst = 浮点值 id（TY-F64）；x = option 值 id。取 slot[0]（i64）后 bitcast 回 double 落规范 %fd<dst>。
            ; 命名空间 %mb<k>/%mg<k> 按指令下标 k，与 %op/%fd/%v 值名不冲突。
            b.push('\t%mg')
            b.push(k.to-str())
            b.push(' = extractvalue %option %op')
            b.push(x.to-str())
            b.push(', 1, 0\n\t%fd')
            b.push(d.to-str())
            b.push(' = bitcast i64 %mg')
            b.push(k.to-str())
            b.push(' to double\n')
        }
        op == OP-OPTALLOC -> {

            ; dst = option 槽 id（本 op 无值操作数）。第八命名空间 %os，与值 %op 只差一个 s。
            b.push('\t%os')
            b.push(d.to-str())
            b.push(' = alloca %option\n')
        }
        op == OP-OPTSTORE -> {

            ; xa[k] = option 值 id；bs[k] = 槽 id。%option 型别固定，无需解 cty/vty（比 struct 槽更简单）。
            b.push('\tstore %option %op')
            b.push(x.to-str())
            b.push(', %option* %os')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-OPTLOAD -> {

            ; dst = option 值 id；xa[k] = 槽 id（与 SLOAD/STLOAD 同形：槽在 a、结果在 dst）。
            b.push('\t%op')
            b.push(d.to-str())
            b.push(' = load %option, %option* %os')
            b.push(x.to-str())
            b.push('\n')
        }
        op == OP-STRUCT-MK -> {

            ; dst = 结构体值 id；xa[k] = args 侧池基址、bs[k] = 字段数 nf；
            ;   第 j 个字段值 id = args[xa[k] + j]（s64 同形的侧池机制，解除「xa[k]+j 连续」假设：
            ;   嵌套结构体字面量作非首位字段值时字段值 id 不连续，连续假设会读错 id）。
            ;   结构体 id 取 cty[k] - TY-STRUCT-BASE（型别码里编了 id，见 mir.no）。
            ; 初值用 zeroinitializer：字段数由型别声明决定，不必逐字段写 0 字面量（s31 泛化）；
            ;   s29 用的 `{ i64 0, i64 0 }` 只能表达 2 字段，已废弃。
            ; ⚠️ 中间步名 %sm<k>_<j>（k = 指令下标、j = 字段下标），**最后一步**才落 %st<dst>：
            ;   同一本地名复用为多步 insertvalue 的输出会报 multiple definition。
            tn = cg-ty-name(cty[k])
            nf = y
            prev = ''
            j = 0
            (j < nf) {
                nm = '%sm' - k.to-str() - '_' - j.to-str()
                j + 1 == nf -> nm = '%st' - d.to-str()
                fvx = args[x + j]: {
                    ok -> it

                    -> _
                }
                fv = fvx
                b.push('\t')
                b.push(nm)
                b.push(' = insertvalue ')
                b.push(tn)
                b.push(' ')
                prev.len-bytes() == 0 -> b.push('zeroinitializer')
                prev.len-bytes() > 0 -> b.push(prev)
                b.push(', ')
                b.push(cg-ty-name(vty[fv]))
                b.push(' ')
                b.push(cg-val-prefix(vty[fv]))
                b.push(fv.to-str())
                b.push(', ')
                b.push(j.to-str())
                b.push('\n')
                prev = nm

                #{overflow=wrap}
                j = j + 1
            }
        }
        op == OP-STRUCT-GET -> {

            ; dst 的型别 = cty[k]（字段可能是 i64，也可能是 %str-long ⇒ 命名空间随之变）
            ; ⚠️ 结构体值住 %st 命名空间，读出的字段按**字段型别**落 %v / %sv / %vc / %op。
            b.push('\t')
            b.push(cg-val-prefix(cty[k]))
            b.push(d.to-str())
            b.push(' = extractvalue ')
            b.push(cg-ty-name(vty[x]))
            b.push(' %st')
            b.push(x.to-str())
            b.push(', ')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-STRUCT-SET -> {

            ; dst = 新结构体值 id；xa[k] = 旧结构体值 id；bs[k] = 新字段值 id；cty[k] = 字段下标。
            ; ⚠️ 与 MK 不同：新字段值由 h2m 显式传入 bs[k]，不再依赖 xa[k]+1 连续约定——
            ;   h2m 顺序分配下旧结构体值 id+1 通常已被首字段值占用，强制连续会读取错误值（见 compiler/src/h2m.no s99）。
            ;   LLVM 结构不可变 ⇒ 只能是「读旧 + insertvalue 出新值」，旧值仍可用。
            ;   结构体 id 取 vty[xa[k]] - TY-STRUCT-BASE。
            vf = y
            b.push('\t%st')
            b.push(d.to-str())
            b.push(' = insertvalue ')
            b.push(cg-ty-name(vty[x]))
            b.push(' %st')
            b.push(x.to-str())
            b.push(', ')
            b.push(cg-ty-name(vty[vf]))
            b.push(' ')
            b.push(cg-val-prefix(vty[vf]))
            b.push(vf.to-str())
            b.push(', ')
            b.push(cty[k].to-str())
            b.push('\n')
        }
        op == OP-STALLOC -> {

            ; dst = 结构体槽 id；bs[k] = 结构体 id（本 op 无值操作数，故 id 放 bs）。
            ; 槽住 %sts<id>，与结构体值 %st<id> 只差一个 s，写错就是拿值名当指针（LLVM 报 not a pointer）。
            b.push('\t%sts')
            b.push(d.to-str())
            b.push(' = alloca ')
            b.push(cg-ty-name(TY-STRUCT-BASE + y))
            b.push('\n')
        }
        op == OP-STSTORE -> {

            ; xa[k] = 结构体值 id；bs[k] = 槽 id。无结果（与 str 的 SSTORE 同形）。
            ; 结构体 id 取 vty[xa[k]] - TY-STRUCT-BASE。
            tn = cg-ty-name(vty[x])
            b.push('\tstore ')
            b.push(tn)
            b.push(' %st')
            b.push(x.to-str())
            b.push(', ')
            b.push(tn)
            b.push('* %sts')
            b.push(y.to-str())
            b.push('\n')
        }
        op == OP-STLOAD -> {

            ; dst = 结构体值 id；xa[k] = 槽 id（与 SLOAD 同形：槽在 a、结果在 dst）。
            ; 结构体 id 取 cty[k] - TY-STRUCT-BASE（**结果**的型别）。
            tn = cg-ty-name(cty[k])
            b.push('\t%st')
            b.push(d.to-str())
            b.push(' = load ')
            b.push(tn)
            b.push(', ')
            b.push(tn)
            b.push('* %sts')
            b.push(x.to-str())
            b.push('\n')
        }
        op == OP-STRUCT-RETAIN -> {

            ; xa[k] = 结构体值 id；bs[k] = 字段掩码（bit j ⇒ 字段 j 持有堆，且必须是 str 字段）。
            ; 每个置位字段发三步：struct → %str-long → i8* data → call @nolang_rc_retain。
            ; ⚠️ 这是**机械动作**，不做策略判断（MK 不自动 retain，见 mir.no 的说明）。
            tnr = cg-ty-name(vty[x])
            mkr = y
            jr = 0
            (jr < 64) {
                bitr = mkr >> jr
                bitr = bitr & 1
                bitr == 1 -> {
                    b.push('\t%rf')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jr.to-str())
                    b.push(' = extractvalue ')
                    b.push(tnr)
                    b.push(' %st')
                    b.push(x.to-str())
                    b.push(', ')
                    b.push(jr.to-str())
                    b.push('\n\t%rp')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jr.to-str())
                    b.push(' = extractvalue %str-long %rf')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jr.to-str())
                    b.push(', 2\n\tcall void @nolang_rc_retain(i8* %rp')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jr.to-str())
                    b.push(')\n')
                }

                #{overflow=wrap}
                jr = jr + 1
            }
        }
        op == OP-STRUCT-RELEASE -> {

            ; 同 RETAIN，改 call @nolang_rc_release（返回 i1，丢弃）。临时值 %rl<k>_<j>。
            tnl = cg-ty-name(vty[x])
            mkl = y
            jl = 0
            (jl < 64) {
                bitl = mkl >> jl
                bitl = bitl & 1
                bitl == 1 -> {
                    b.push('\t%rf')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jl.to-str())
                    b.push(' = extractvalue ')
                    b.push(tnl)
                    b.push(' %st')
                    b.push(x.to-str())
                    b.push(', ')
                    b.push(jl.to-str())
                    b.push('\n\t%rp')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jl.to-str())
                    b.push(' = extractvalue %str-long %rf')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jl.to-str())
                    b.push(', 2\n\t%rl')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jl.to-str())
                    b.push(' = call i1 @nolang_rc_release(i8* %rp')
                    b.push(k.to-str())
                    b.push('_')
                    b.push(jl.to-str())
                    b.push(')\n')
                }

                #{overflow=wrap}
                jl = jl + 1
            }
        }
        op == OP-RETAIN -> {

            ; x = 字符串值 id（TY-STR）。取 data 指针（%str-long 字段 2 = i8* data = RC 头 +16），call retain。
            ; 命名空间 %dp<k> 与 OPTISOK 的 %c<k> 不冲突（RETAIN/RELEASE 各自独占一条指令的 k）。
            b.push('\t%dp')
            b.push(k.to-str())
            b.push(' = extractvalue %str-long %sv')
            b.push(x.to-str())
            b.push(', 2\n\tcall void @nolang_rc_retain(i8* %dp')
            b.push(k.to-str())
            b.push(')\n')
        }
        op == OP-RELEASE -> {

            ; x = 字符串值 id（TY-STR）。取 data 指针 + call release（返回 i1，丢弃）。
            b.push('\t%dp')
            b.push(k.to-str())
            b.push(' = extractvalue %str-long %sv')
            b.push(x.to-str())
            b.push(', 2\n\t%rel')
            b.push(k.to-str())
            b.push(' = call i1 @nolang_rc_release(i8* %dp')
            b.push(k.to-str())
            b.push(')\n')
        }
        op == OP-RET -> {
            b.push('\tret ')
            b.push(cg-ty-name(retty))
            b.push(' ')
            b.push(cg-val-prefix(retty))
            b.push(x.to-str())
            b.push('\n')
        }
    }
    b.push('}\n')
    r = b.str()
}
