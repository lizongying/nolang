; intern — 識別符號／字串駐留表
;
; ═══════════════════════════════════════════════════════════════════
; 為什麼是【普通函式 + 顯式傳結構體】，而不是方法？
; ═══════════════════════════════════════════════════════════════════
; 2026-10-09 實測（`bin/no` @ 4feaaf70）。完整邊界矩陣、最小重現腳本與觀測值見
; docs/design/nolang-selfhost.md §2.2.5 / §2.2.8 / 附錄 A.5。
; 摘要：
;   A. 結構體帶 [K]V map 欄位 + 方法（隱式接收者 .tab.put/.tab.get）
;      + 跨模組  =>  EmitLLVM: unknown callee [str]i64.put / [str]i64.get
;      （根因：src/mir/codegen.go:12178 把「map 接收者型別 + 方法名」當成真實函式名）
;   已排除的假線索：曾一度懷疑是「跨模組同級函式呼叫 + 結果存局部變數」，
;   後以最小重現否證——`i = intern.find(t, s)` 這種形狀跨模組完全正常；
;   當時的失敗全部來自 map 欄位（A）。
; 已驗證【安全】的形狀（本檔只用這些）：
;   ✅ 普通函式（非方法）+ 結構體作參數（引用語義，修改會回傳）
;   ✅ 讀寫結構體的純量欄位
;   ✅ 讀寫 []T 欄位的元素（讀取需 #{index-out=zero}）
;   ✅ 對 []T 欄位 push
;   ✅ 對 []T 欄位整體重新賦值（= with-len(n)）
;   ✅ 在 []T 上做 range-for、帶 return 提前退出
;   ✅ 方法 + 非 map 欄位（如 []byte；見 src/util/sb.no）
;
; 本檔刻意【不用】雜湊表：先用線性掃描把正確性釘死（O(n) 查找對關鍵字表
; 與小型符號表足夠），雜湊版等缺陷修復後再換（見 docs 的 M0 後續項）。
;
; ⚠️ 必要註解（實測規則，不是風格偏好）：
;   #{overflow=wrap}   整數運算預設回 option<int>；只作用於緊跟的一條陳述。
;   #{index-out=zero}  只有「x = arr[i]（i 非字面量，x 非 option）」需要；
;                      索引出現在【條件】或【寫入】位置時不需要。
;
; ⚠️ SHS：無模組級可變狀態、無一等函式值、無指針。

; itab 而非 intern：避免結構體名與模組短名（util/intern 的短名是 intern）衝突
itab {
    pool []str
    cnt i64
}

; 建立空的駐留表
; r: 返回結果
intern.make = () (r itab) {
    r = itab {
        pool: []str
        cnt: 0
    }
}

; 回傳 s 在 pool 中的下標；不存在回 -1
; t: 輸入
; s: 字串
; slot: 結果數值
intern.find = (t itab, s str) (slot i64) {
    slot = -1
    n = t.cnt
    i <- [0..n): {
        #{index-out=zero}
        cur = t.pool[i]
        cur.eq-full(s) -> {
            slot = i
            return
        }
    }
}

; 取得 s 的駐留 id；未駐留回 0（不登記）
; id 從 1 開始，0 是保留值（「無／空字串」）
; t: 輸入
; s: 字串
; id: 結果數值
intern.get = (t itab, s str) (id i64) {
    id = 0
    s.len-bytes() == 0 -> return
    i = intern.find(t, s)
    i < 0 -> return
    #{overflow=wrap}
    id = i + 1
}

; 取得 s 的駐留 id；未駐留則登記
; t: 輸入
; s: 字串
; id: 結果數值
intern.put = (t itab, s str) (id i64) {
    id = 0
    s.len-bytes() == 0 -> return
    i = intern.find(t, s)
    {
        i >= 0 -> {
            #{overflow=wrap}
            id = i + 1
            return
        }
        -> { }
    }
    t.pool.push(s)
    #{overflow=wrap}
    t.cnt = t.cnt + 1
    id = t.cnt
}

; 已駐留的字串數
; t: 輸入
; n: 數量
intern.count = (t itab) (n i64) {
    n = t.cnt
}

; 取回 id 對應的字串（id 從 1 開始；越界回空字串）
; t: 輸入
; id: 數值
; r: 結果字串
intern.at = (t itab, id i64) (r str) {
    r = ''
    {
        id < 1 -> return
        id > t.cnt -> return
        -> { }
    }
    #{overflow=wrap}
    i = id - 1
    #{index-out=zero}
    r = t.pool[i]
}
