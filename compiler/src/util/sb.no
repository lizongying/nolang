; sb — 字串構建器（以 []byte 支撐）
;
; 為什麼自己寫：str 的 + 是 @str_concat，每次 O(n) 拷貝。用它拼 IR 文本是
; O(n^2)。sb 以 []byte 攤還 O(1) 追加，最後一次 to-bytes-str 轉回 str。
;
; SHS 合規（見 docs/design/nolang-selfhost.md §2.3）：
;   - 無模組級可變狀態
;   - 無一等函式值、無指針、無匿名函式型別
;   - 結構體名 >= 2 字元
;
; ⚠️ 位元組邊界：一律以 []byte 為載體，取長度用 .len()（= 位元組數）。
;    不要用 str.len() —— 它回的是【碼點數】，不是位元組數（src/std/str.no:41-44，
;    實作為 n = .cp-index(.len-bytes())）；
;    也不必用 len-bytes()，見 docs/design/nolang-selfhost.md §2.1.2。

sb {
    buf []byte
}

; init: 建立預分配 cap 位元組的構建器
sb.init = (cap i64) (r sb) {
    r = sb {
        buf: with-cap(cap)
    }
}

; push: 追加 str 的全部 UTF-8 位元組（原樣，不解碼）
;
; ⚠️ `str.byte(i)` 回傳 **?byte**（不是 byte）。直接把 option 塞進 []byte 會寫進
;    option 的【內聯佈局】而不是碼點值——sb.str() 長度對、內容卻幾乎全 NUL
;    （'hello-world' ⇒ len=11、內容只有一個 104），ast.dump 全線失真，複雜樹
;    甚至 SIGTRAP / SIGKILL。故必須先解包，nil ⇒ 0。
;    同源 bug 見 tok.no str-eq（兩個 ?byte 比較永不等 ⇒ 只比長度）。
sb.push = (s str) {
    i <- [0..s.len-bytes()): {
        b-opt = s.byte(i)
        b = b-opt: {
            ok -> it

            -> 0
        }
        .buf.push(b)
    }
}

; push-byte: 追加單一位元組
sb.push-byte = (b i64) {
    .buf.push(b)
}

; str: 轉為 str（一次拷貝）
sb.str = () (r str) {
    r = .buf.to-bytes-str()
}

; len: 目前位元組數
sb.len = () (n i64) {
    n = .buf.len()
}

; clear: 清空內容（保留已配置容量）
sb.clear = () {
    .buf.clear()
}
