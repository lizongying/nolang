; ix — 下標與計數器自增的固定解包點
...

;
; D6 之後 `a + b` / `a - b` 恆回 `?T`，`#{overflow=wrap}` 只宣告溢出行為、
; 並不解包。編譯器原始碼裡的迴圈計數器都是「必然回繞、且呼叫點已自行檢查
; 上界」的形態，需要一個固定解包點；本模組即為此而設：溢出行為宣告回繞，
; 失敗臂回原值（回繞語義下走不到，僅為型別完整）。
;
; 同理 D11 之後 `a[k]` 恆回 `?T`，必須顯式消費；`at-i` / `at-s` 把越界臂固定
; 成零值／空串，讓被上界檢查守住的呼叫點維持單行。

; i + 1，回繞
ix.inc = (i i64) (r i64) {

    #{overflow=wrap}
    r = i + 1: {
        ok -> it

        -> i
    }
}

; i - 1，回繞
ix.dec = (i i64) (r i64) {

    #{overflow=wrap}
    r = i - 1: {
        ok -> it

        -> i
    }
}

; 下標讀取（[]i64）：越界回零值
; a: 被讀取的切片
; k: 下標
; v: 元素值
ix.at-i = (a []i64, k i64) (v i64) {
    v = a[k]: {
        ok -> it

        -> _
    }
}

; 下標讀取（[]str）：越界回空串
; a: 被讀取的切片
; k: 下標
; v: 元素值
ix.at-s = (a []str, k i64) (v str) {
    v = a[k]: {
        ok -> it

        -> _
    }
}
