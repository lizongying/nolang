; mir — MIR 表示（M4-b 骨架；67 op 的最小闭包子集）
;
; Authority：src/mir/mir.go（Op enum / Inst / Func / Module）。
;
; 表示约定（扁平 arena，遵 §5.3.4.as「结构体不跨模块按值传」）：
;   一个函数 = 平行数组（ops/dsts/xa/bs/syms/blks），同下标成一条指令。
;   - ops[k]  = OP-*
;   - dsts[k] = 目标值 id（0 = 无结果）；值 id 1..nargs 是函数参数
;   - xa[k] / bs[k] = 操作数 a / b（⚠️ 不叫 as——as 是保留字）
;   - syms[k] = 符号（仅 OP-CALL / OP-STRCONST 用；其余占位 ''，与 ops 等长）
;   - blks[k] = 所属基本块 id（M4-c 起）
;   指令按顺序发射。

; ── 型别码（M4-c 第七件：带型别的函数签名）──────────────────
; 值 id 的 SSA 名由「型别」决定，不住同一个命名空间：
;   TY-I64 → %v<id>（i64）、TY-STR → %sv<id>（%str-long）、TY-VEC → %vc<id>（%vec）。
; LLVM 不允许同名不同型，故形参/返回值的命名必须按型别选前缀。
TY-I64 = 0
TY-STR = 1
TY-VEC = 2

; TY-OPT → %op<id>（%option）。`?T` 只有**一个** LLVM 型别，元素型别只活在高层
; 语义里（payload 到底是 i64 还是 %str-long，由读它的 op 决定）。
TY-OPT = 3

; TY-U64（M4-c 續件 s36）：無符號整數。⚠️ 它在 LLVM 裡與 TY-I64 **同一型別、同一命名空間**
;   （都是 i64 / %v）——符號性只活在 op 的助記符（lshr/udiv/urem/ult… vs ashr/sdiv/srem/slt…）。
;   故 cg-ty-name / cg-val-prefix 對 TY-U64 走默認臂（i64/%v）即正確，無需額外映射。
;   型別碼存在的意義是給語義層（hir2mir）標記「該值按無符號降級」，讓它選無符號 op——本件把
;   TY-U64 與無符號 op 家族**同時**落地，規避 s35 §5.3.4.bo 警示的「型別碼存在但無人發射」空洞。
TY-U64 = 4

; TY-F64（M4-c 續件 s37）：雙精度浮點。⚠️ 與 TY-U64 **相反**——它在 LLVM 裡是**獨立型別 `double`**、
;   且須住**獨立值命名空間 `%fd<id>`**（SSA 名全域唯一，`double` 不能與 `i64` 共用 `%v`，否則同名
;   不同型opt 直接報錯）。故 TY-F64 必須進 cg-ty-name（→'double'）與 cg-val-prefix（→'%fd'）兩張映射。
;   ⚠️ **不加獨立 op**：與 Go 後端 emitArith 一致（`isFloat := resLT=="double"` 按**結果型別**在
;   OP-ADD/SUB/MUL/DIV/MOD 內分派 fadd/fsub/fmul/fdiv/frem；比較按**操作數型別**分派 fcmp）——
;   型別是唯一的「整數 vs 浮點」真相，op 只說「加」不說「什麼型別的加」，避免把型別判斷複製進 op
;   （§11 B7「型別碼與發射臂須成對」的正解）。⚠️ 浮點除零**不是** UB（IEEE 定義為 ±inf/nan），
;   故 fdiv/frem 不需整數族的除零護欄（§11 B14 只關整數）。
TY-F64 = 5

; 结构体型别（M4-c 续件 s31）：**型别码 = TY-STRUCT-BASE + 结构体 id**，值住 %st<id>（第七个
;   命名空间之外的「值」空间，与 %sv/%vc/%op 并列）。结构体 id 0..N 由语义层登记
;   （`cg-runtime-struct-decls(sfc)`：sfc[id] = 字段数，0 = 未使用）。
;   ⚠️ 为什么用「基址 + 偏移」而不是再开一个数组：cg-ty-name/cg-val-prefix 的入参只有一个
;      型别码，而平铺 arena 的 API 已经 12 个参数（s24 加 vty/cty 时已到边界）。把 id 编进
;      型别码 ⇒ 型别名 %struct.s<id> 与值前缀都能从**一个整数**推出来，零 API 变更。
;   ⚠️ 结构体多于 1 个时**必须**由 prelude 之后的 `cg-runtime-struct-decls` 一次性发全部
;      型别声明（具名型别模块内唯一，见 §11 B10）。
TY-STRUCT-BASE = 100

OP-CONST = 0
OP-ADD = 1
OP-SUB = 2
OP-MUL = 3
OP-RET = 4

; dst = 结果值 id；syms[k] = 被调函数名；
;   a = 首个参数值 id（连续），bs[k] = 参数个数（0 表示无参调用）。
;   ⚠️ M4-b 时 a 是「唯一参数」、bs 恒 0；M4-c 起 bs 是【参数个数】，
;      无参调用必须写 bs=0，单参调用必须写 bs=1（不再是占位）。
OP-CALL = 5
OP-ALLOC = 6
OP-STORE = 7
OP-LOAD = 8

; ── 控制流（M4-c 首件）────────────────────────────────────
; blks[k] 给出每条指令所属的基本块 id（0 = entry）。块切换处发 bb<id>: 标签。
; 跨块传值用 alloca/store/load（-O0 风格），不引入 PHI（PHI 留后续）。
OP-BR = 9; a = 目标块 id
OP-CONDBR = 10; a = 条件值 id（i64，非零为真）；bs[k] = 真块 id；dsts[k] = 假块 id
OP-CMPLT = 11; dst = (a < b)；发 icmp slt + zext 到 i64

; ── ALU 家族（M4-c 续件 s35）：位运算 / 移位 / 除法 / 其余比较 ──────
; 约定与 ADD/SUB/MUL 完全一致：dst = i64 结果值 id；a = 左操作数；bs[k] = 右操作数。
;   位运算：OP-AND / OP-OR / OP-XOR  ⇒ and / or / xor i64
;   移位　：OP-SHL ⇒ shl i64；OP-SHR ⇒ **ashr** i64（算术右移，与 i64 有符号语义一致；
;           逻辑右移要等 u64 型别进场后用独立 op，别在这里「按需」改成 lshr）
;   除余　：OP-DIV ⇒ sdiv i64；OP-MOD ⇒ srem i64（与 Go 后端的 sdiv/srem 对齐；
;           s38 起裹除零 select 護欄——见 cg-div-guard，与 Go emitArith plain 路径一致，§11 B14）
;   比较　：OP-CMPEQ / OP-CMPNE / OP-CMPLE / OP-CMPGT / OP-CMPGE
;           ⇒ icmp <pred> i64 + zext i1 → i64（与 OP-CMPLT 同形，结果 0/1）
; ⚠️ 全是**有符号**语义（slt/sgt/sle/sge/sdiv/srem/ashr）。无符号族要等 u64 型别，不在本族。
; ⚠️ ast.no 的字符串驻留用的正是 `* + % < ==`（djb2 + 开放寻址）⇒ 本族是 AST arena 的前置。
OP-CMPEQ = 39
OP-CMPNE = 40
OP-CMPLE = 41
OP-CMPGT = 42
OP-CMPGE = 43
OP-AND = 44
OP-OR = 45
OP-XOR = 46
OP-SHL = 47
OP-SHR = 48
OP-DIV = 49
OP-MOD = 50

; ── 無符號 ALU 家族（M4-c 續件 s36）：s35 預留——「邏輯右移要等 u64 型別進場後用獨立 op」──────
; 約定與有符號族完全一致：dst = i64 結果值 id；a = 左；bs[k] = 右；結果走 %v（與 TY-I64 同命名空間）。
;   OP-SHRU ⇒ lshr i64（邏輯右移，高位填 0；有符號版是 OP-SHR⇒ashr）
;   OP-DIVU ⇒ udiv i64；OP-MODU ⇒ urem i64（s38 起裹除零 select 護欄，同有符號族；無 (MIN,-1)，§11 B14）
;   OP-CMPLTU/LEU/GTU/GEU ⇒ icmp <ult/ule/ugt/uge> i64 + zext i1→i64（與有符號 cmp 同形）
; ⚠️ CMPEQ/CMPNE 與符號無關（icmp eq/ne 對同一 i64 位元組模式結果一致），沿用 s35 的 OP-CMPEQ/NE。
OP-SHRU = 51
OP-DIVU = 52
OP-MODU = 53
OP-CMPLTU = 54
OP-CMPLEU = 55
OP-CMPGTU = 56
OP-CMPGEU = 57

; ── 字符串（M4-c 非 i64 型别首件）──────────────────────────
; 字符串值住在独立命名空间 %sv<id>（类型 %str-long）；i64 值住 %v<id>。
; dst = 字符串值 id；syms[k] = 字面量文本（限可打印 ASCII，无引号/反斜线）。
;   发射：全局 @.s<k> + getelementptr + insertvalue 构造 %str-long。
; OP-STRLEN：dst = i64 值 id；a = 字符串值 id。发射 extractvalue %str-long, 0（取 len）。
; OP-STRCAT：dst = 字符串值 id；a = 左串值 id；bs[k] = 右串值 id。
;   发射 call %str-long @str_concat(...)；结果在堆上、带 RC 头（rc=1，拥有）。
OP-STRCONST = 12
OP-STRLEN = 13
OP-STRCAT = 14

; ── 字符串槽（跨基本块保存 %str-long，M4-c 第五件）──────────
; %str-long 是【值型别】，跨块不能用 SSA 名直接续命（除非 PHI）⇒ 走 alloca。
; 槽住在独立命名空间 %ss<id>（类型 %str-long*），与 i64 槽 %s<id> 区分。
; dst = 槽 id。发射 alloca %str-long。
; OP-SSTORE：a = 字符串值 id；bs[k] = 槽 id。发射 store %str-long %sv<a>, %str-long* %ss<bs>。
; OP-SLOAD ：dst = 字符串值 id；a = 槽 id。发射 %sv<dst> = load %str-long, %str-long* %ss<a>。
OP-SALLOC = 15
OP-SSTORE = 16
OP-SLOAD = 17

; ── 向量（M4-c 第六件；%vec = { i64, i64, i64 }，元素目前只有 i64）──────
; 向量值住在第四个命名空间 %vc<id>（类型 %vec）。
; dst = 向量值 id。发 call %vec @vec_new()。
; OP-VECPUSH：dst = 新向量值 id；a = 旧向量值 id；bs[k] = 被压入的 i64 值 id。
;             发 call %vec @vec_push_i64(...)（返回新 %vec，**不是**原地改）。
; OP-VECLEN ：dst = i64 值 id；a = 向量值 id。发 call i64 @vec_len(...)。
; OP-VECGET ：dst = i64 值 id；a = 向量值 id；bs[k] = 下标 i64 值 id。
;             发 call i64 @vec_get_i64(...)（下标必须是值 id，不能是立即数）。
OP-VECNEW = 18
OP-VECPUSH = 19
OP-VECLEN = 20
OP-VECGET = 21

; ── option（M4-c 第十件；%option = { i64 tag, [3 x i64] slot }，tag 0=ok/1=nil/2=err）──
; option 值住在第五个命名空间 %op<id>（类型 %option）。
; dst = option 值 id。发 tag=1（nil）的常量。
; OP-OPTSOME：dst = option 值 id；a = i64 值 id。发 tag=0 + slot[0] = %v<a>
;             （Go codegen.go:2530 的 `insertvalue ..., i64 %pi, 1, 0` 同形）。
; OP-OPTTAG ：dst = i64 值 id；a = option 值 id。发 extractvalue %option, 0（原始 tag）。
; OP-OPTISOK：dst = i64 值 id；a = option 值 id。tag==0 ? 1 : 0（icmp eq + zext）。
; OP-OPTGET ：dst = i64 值 id；a = option 值 id。发 extractvalue %option, 1, 0（slot[0] 当 i64）。
;             ⚠️ 只覆盖 **i64 载荷**；str/vec 载荷由 OP-OPTMKSTR/OP-OPTGETSTR 走内联
;             （%str-long/%vec 恰 24 字节 = [3 x i64] 槽，逐字段 extractvalue/insertvalue 互转），见上。
OP-OPTNONE = 22
OP-OPTSOME = 23
OP-OPTTAG = 24
OP-OPTISOK = 25
OP-OPTGET = 26

; ── option 的 str 载荷（M4-c 续件 s28；%str-long 恰 24 字节，内联进 [3 x i64] 槽，无堆装箱）──
; %option 的 payload slot 是 [3 x i64] = 24 字节；%str-long = { i64, i64, i8* } 也恰 24 字节、
; 全 8 字节字段无 padding ⇒ 二者布局兼容，可逐字段 extractvalue/insertvalue 互转，免内存；
; ⚠️ 但 data 指针字段（i8*）与 i64 槽的型别不同，不能用 bitcast（LLVM 不允许指针<->整数），
;   须 ptrtoint/inttoptr 在「i8* ⇄ i64」之间转换（见 cg.no 的 OPTMKSTR/OPTGETSTR）。
; OP-OPTMKSTR：dst = option 值 id；a = 字符串值 id（TY-STR）。发 tag=0 + 把 %str-long 的 3 个 i64
;              字段（len/cap/data）逐字段 insertvalue 进 slot[0..2]。⚠️ 本 op 只【存储】，不自动 retain；
;              选项取得所有权须由调用方紧接 OP-RETAIN（与 s26/s27 的 RC 原语同一规矩）。
; OP-OPTGETSTR：dst = 字符串值 id（TY-STR）；a = option 值 id。从 slot[0..2] 取 3 个 i64 字段，
;               逐字段 insertvalue 重建 %str-long。读出的 %str-long 与原串共享同一 data 指针。
; ⚠️ vec 载荷（%vec = { i64, i64, i64 } 也恰 24 字节）走完全同构的内联路径，本件只做 str；
;    >24 字节的载荷（tag==0 才解引用）仍走堆上装箱，属后续。
OP-OPTMKSTR = 29
OP-OPTGETSTR = 30

; ── option 的 vec 载荷（M4-c 续件 s40；补齐上面 173–174 行 s28 预告的同构内联路径）──────
; %vec = { i64, i64, i64 }（f0=len、f1=cap、f2=dat），其中 dat 已是 ptrtoint 后的**整数指针**
; （见 cg-runtime-vec-get/push 内部才 inttoptr 还原），三字段全 i64 且恰 24 字节 ⇒ 与 %option 的
;   [3 x i64] 槽 1:1 布局兼容，逐字段 extractvalue/insertvalue 互转，**连 ptrtoint/inttoptr 都不需要**
;   （比 str 载荷更简单：str 的 data 是 i8*，须 ptrtoint/inttoptr）。
; OP-OPTMKVEC ：dst = option 值 id；x = 向量值 id（TY-VEC）。发 tag=0 + 把 %vec 的 3 个 i64 字段
;               逐字段 insertvalue 进 slot[0..2]。⚠️ 只【存储】不自动 retain；取得所有权须紧接 OP-RETAIN。
; OP-OPTGETVEC：dst = 向量值 id（TY-VEC）；x = option 值 id。从 slot[0..2] 取 3 个 i64 字段，
;               逐字段 insertvalue 重建 %vec（zeroinitializer 起）。读出的 %vec 与原 vec 共享同一 dat。
; ⚠️ op 码接在既有最大码 OP-CMPGEU=57 之后（取 58/59），刻意不重排 22..57 以免影响既有 arena 数据。
OP-OPTMKVEC = 58
OP-OPTGETVEC = 59

; ── option 跨基本块槽（M4-c 续件 s41；补齐 §11 B8 里 option 值跨块的 alloca 通路）──
; option 值住 %op<id>；本件新增**第八个命名空间** %os<id>（option slot），与值 %op 只差一个 s，
;   写错就是把值名当指针（LLVM 报 not a pointer），与 str 的 %sv/%ss、struct 的 %st/%sts 同规。
; %option 型别固定（{ i64 tag, [3 x i64] payload }），故三件套无需 cty/vty 解型别——比 struct 槽更简单。
; 跨块传 option 值走 alloca+store+load（在入口分配槽、各分支 store、汇聚块 load），而非 %option 的 PHI。
; OP-OPTALLOC ：dst = option 槽 id（本 op 无值操作数）。发 `%os<id> = alloca %option`。
; OP-OPTSTORE ：xa[k] = option 值 id；bs[k] = 槽 id。发 store，无结果（与 SSTORE/STSTORE 同形）。
; OP-OPTLOAD  ：dst = option 值 id；xa[k] = 槽 id。发 load（与 SLOAD/STLOAD 同形：槽在 a、结果在 dst）。
; ⚠️ op 码接在既有最大码 OP-OPTGETVEC=59 之后（取 60/61/62），刻意不重排既有码以免影响 arena 数据。
OP-OPTALLOC = 60
OP-OPTSTORE = 61
OP-OPTLOAD = 62

; ── str 结构相等（M4-c 续件 s42；补齐 §11 字符串比较，镜像 Go 专用 OpStrEq）──
; Go 对 str 相等不用 icmp（icmp %str-long 非法），而是专用 MIR op 降级到运行时
; helper @str_eq（见 cg-runtime.no cg-runtime-str-eq）。本层同形新增两条 op：
; OP-STEREQ ：dst = i64 结果 id（0/1）；xa[k] = 左 str 值 id；bs[k] = 右 str 值 id。
;            发 `%se<k> = call i1 @str_eq(%str-long %sv<xa>, %str-long %sv<bs>)` + zext 到 %v<dst>。
; OP-STNEQ  ：同上，但结果取反（xor i1 true）。两op 的操作数均在 str 命名空间 %sv，结果落 i64 %v。
; ⚠️ op 码接在既有最大码 OP-OPTLOAD=62 之后（取 63/64），不重排既有码以免影响 arena 数据。
OP-STEREQ = 63
OP-STNEQ = 64

; ── vec 元素相等（M4-c 续件 s43；补齐 §11 向量比较，镜像 Go vecDeepEq 的 i64 分支）──
; Go 对 []i64 相等不用 icmp（icmp %vec 非法），降级到运行时 helper @__nolang_vec_eq_i64
; （见 cg-runtime.no cg-runtime-vec-eq）。本层同形新增一条 op：
; OP-VECEQ ：dst = i64 结果 id（0/1）；xa[k] = 左 vec 值 id；bs[k] = 右 vec 值 id。
;            发 `%veq<k> = call i1 @__nolang_vec_eq_i64(%vec %vc<xa>, %vec %vc<bs>)` + zext 到 %v<dst>。
;            操作数均在 vec 命名空间 %vc，结果落 i64 %v（仅适用元素型为 i64 的 vec）。
; ⚠️ op 码接在既有最大码 OP-STNEQ=64 之后（取 65），不重排既有码。
OP-VECEQ = 65

; ── option 值相等（M4-c 续件 s44；补齐 §11 option 比较，镜像 Go emitOptionValueEq 的 i64 载荷分支）──
; Go 对 ?i64 相等发「tag icmp eq AND payload(i64) icmp eq」再 and（src/mir/codegen.go:6247），
; 纯单块降级、无需运行时 helper（区别于 str/vec 需 call helper）。本层同形新增两条 op：
; OP-OPTEQ ：dst = i64 结果 id（0/1）；xa[k] = 左 option 值 id；bs[k] = 右 option 值 id。
;            发 extractvalue tag（field 0）各 icmp eq、extractvalue 载荷（field 1,0）各 icmp eq、and i1 → zext 到 %v<dst>。
; OP-OPTNEQ：同上，and 结果先 xor i1 true 取反再 zext。两 op 的操作数均在 option 命名空间 %op，结果落 i64 %v（仅适用 i64 载荷）。
; ⚠️ op 码接在既有最大码 OP-VECEQ=65 之后（取 66/67），不重排既有码。
; ⚠️ 载荷非 i64（str/vec）时 slot[0] 只是首字，本 op 不覆盖（留作后续，见 §11）。
OP-OPTEQ = 66
OP-OPTNEQ = 67

; ── option 的 `str` 载荷相等（M4-c 續件 s45；補齊 §11 option 非 i64 載荷比較，鏡像 Go emitOptionValueEq 的 %str-long 分支）──
; Go 對 ?str 相等仍走 emitOptionValueEq（src/mir/codegen.go:6247）：tag icmp eq AND 載荷 call @str_eq 再 and；
; 載荷內聯（optionPayloadOf 回呼已負載值），故無需控制流。noc 的 %option 載荷槽是 [3 x i64]（s28 把 %str-long 的
; len/cap/data 逐欄位打包，data 指針 ptrtoint），故相等前需先用與 OPTGETSTR 同形的三步 insertvalue 從槽重建 %str-long，
; 再喂給既有 helper @str_eq（s42，**無需新增 helper**）。本層同形新增兩條 op：
; OP-OPTEQSTR ：dst = i64 結果 id（0/1）；xa[k] = 左 option 值 id；bs[k] = 右 option 值 id。
;                發 extractvalue tag（field 0）各 icmp eq；左/右各從槽（field 1,0/1/2）重建 %str-long（inttoptr 還原 data）；
;                call i1 @str_eq(両邊重建的 %str-long)；and i1 tag-eq · str-eq → zext 到 %v<dst>。
; OP-OPTNEQSTR：同上，and 結果先 xor i1 true 取反再 zext。兩 op 的操作數均在 option 命名空間 %op，結果落 i64 %v（僅適用 str 載荷）。
; ⚠ op 碼接在既有最大碼 OP-OPTNEQ=67 之後（取 68/69），不重排既有碼。
; ⚠ 與 s44 的 OPTEQ 互斥：s44 直接取 slot[0] 當 i64 比，僅適用 i64 載荷；本件從槽重建 %str-long 再 call @str_eq，適用 str 載荷。
; ⚠ 載荷為 nil（OPTNONE，槽=zeroinitializer）時重建成 {0,0,null}，@str_eq 走 len0→memcmp(null,null,0)=0 判等，nil==nil→1（與 Go 同形）。
OP-OPTEQSTR = 68
OP-OPTNEQSTR = 69

; ── option 的 `f64`（double）載荷內聯讀寫（M4-c 續件 s46；補齊 §11 option 標量載荷家族，鏡像 Go 對 double 載荷的存取）──
; Go 對 ?f64 的載荷存取走 optPayloadTypedAddr（把槽地址重類型為 double*）＋ store/load double；
; emitOptionValueEq 的 double 分支即 fcmp oeq（src/mir/codegen.go:6263）。noc 的 %option 載荷槽是 [3 x i64]，
; 無法直接 insertvalue 一個 double（欄位型別是 i64），故以等宽 bitcast 落槽：**double→i64 寫入 slot[0]、i64→double 讀回**
; （bitcast 是 LLVM 允许的等宽标量重interpret，64↔64，無需 ptrtoint/inttoptr，也無需任何 runtime helper）。
; 與 s28(str)/s40(vec) 同属「先建載荷讀寫、後建相等」節律：本件先落地 f64 的 MK/GET，為後續 OPTEQF64 預備可測基底。
; OP-OPTMKF64 ：dst = option 值 id；x = 浮點值 id（TY-F64，住 %fd）。發 %mb<k> = bitcast double→i64；再同 OPTSOME 形 insertvalue 進 slot[0]（tag 已內建於字面 0）。
; OP-OPTGETF64：dst = 浮點值 id（TY-F64）；x = option 值 id。發 extractvalue slot[0]（i64）→ %mg<k>；再 bitcast i64→double 落到規範 %fd<dst>。
; ⚠ op 碼接在既有最大碼 OP-OPTNEQSTR=69 之後（取 70/71），不重排既有碼。
; ⚠ 與 s28/s40 不同處：f64 舆槽元素等宽（皆 64 位），只需 bitcast，不需 ptrtoint/inttoptr（舆 str 的 i8* data 指針不同）。
OP-OPTMKF64 = 70
OP-OPTGETF64 = 71

; ── option 的 `f64`（double）載荷相等（M4-c 續件 s47；鏡像 Go emitOptionValueEq 的 double 分支，延續 s44(i64)／s45(str)「先建讀寫、後建相等」節律）──
; Go 對 ?f64 相等走 emitOptionValueEq（src/mir/codegen.go:6263）：載荷 fcmp oeq ＋ tag icmp eq 再 and i1；!= 為整體取反（xor i1 true）。
; 本件復用 s46 的 slot[0] 讀取路徑：兩側各 extractvalue slot[0]（i64）→ bitcast i64→double → fcmp oeq；聚合體不可直接 icmp，故拆 tag／載荷兩比再 and。
; OP-OPTEQF64 ：dst = i64 結果（0/1）；x = 左 option 值 id；y = 右 option 值 id。發 tag icmp eq AND（bitcast 後 fcmp oeq double）→ zext。
; OP-OPTNEQF64：同 OPTEQF64，但 and 結果先 xor i1 true 取反再 zext。
; ⚠ op 碼接在既有最大碼 OP-OPTGETF64=71 之後（取 72/73），不重排既有碼。
OP-OPTEQF64 = 72
OP-OPTNEQF64 = 73

; ── 一元 ALU：NEG / NOT（M4-c 續件 s48；鏡像 Go emitNeg／emitNot，補齊 emitInst 裡 arith 之後緊接的兩條一元 op）──
; Go：emitNeg（codegen.go:5503）float ⇒ `fneg double`、int ⇒ `sub <lt> 0, x`（非 option 路徑不插溢出護欄，與 s35 有符號 ALU 同紀律）；
;     emitNot（5505）⇒ `xor <lt> 1, x`（翻轉 0/1 布林，noc 布林即 i64 0/1）。
; OP-NEG：dst = 結果值 id；x = 操作數 id（vty[d]==TY-F64 ⇒ 發 %fd<dst> = fneg double %fd<x>，否則 %v<dst> = sub i64 0, %v<x>）。
; OP-NOT：dst = i64 結果值 id；x = 布林值 id。發 %v<dst> = xor i64 1, %v<x>。
; ⚠ op 碼接在既有最大碼 OP-OPTNEQF64=73 之後（取 74/75），不重排既有碼。
OP-NEG = 74
OP-NOT = 75

; ── vec → str 重interpret（M4-c 續件 s49；鏡像 Go emitStrFromVec，codegen.go:13069）──
; Go 把 %vec 就地重reinterpret 成 %str-long（用於 `data str = fs.read-file(path)` 一类把 %vec 直 store 進 %str-long 槽的語料）。
; %vec = { i64 f0=len, i64 f1=cap, i64 f2=dat(整數指針) }；%str-long = { i64 f0=len, i64 f1=cap, i8* f2=data }。
; 兩者前三欄位皆 8 字節、僅 f2 型別不同（i64 ⇄ i8*）⇒ 逐欄位 extractvalue/insertvalue，f2 走 inttoptr（LLVM 不允許 bitcast 指針⇄整數，同 s28 OPTGETSTR 紀律）。
; OP-STRFROMVEC：dst = 字符串值 id（TY-STR，落 %sv）；x = 向量值 id（TY-VEC，住 %vc）；bs[k] 不用（0）。
;   發：%sfl<k>=extractvalue %vec,0；%sfc<k>=…,1；%sfd<k>=…,2；%sfp<k>=inttoptr i64→i8*；
;       %sfs0<k>=insertvalue %str-long{0,0,null},%sfl,0；%sfs1<k>=insertvalue…, %sfc,1；%sv<dst>=insertvalue…, %sfp,2
; ⚠️ 純單块降級、無需 helper（extractvalue/inttoptr/insertvalue 皆 LLVM 合法指令）；僅【存儲欄位】，不拷貝緩沖、不 retain（dat 與原 vec 共享同一緩冲）。
; ⚠ op 碼接在既有最大碼 OP-NOT=75 之後（取 76），不重排既有碼。
OP-STRFROMVEC = 76

; ── str 容量欄讀取（M4-c 續件 s50；鏡像 Go emitLenCap 的 OpCap/KindStr 分支，codegen.go:11848）──
; %str-long = { i64 f0=len, i64 f1=cap, i8* f2=data }；Go 以 fieldIdx 分派：OpLen⇒0、OpCap⇒1。
; noc 已有 OP-STRLEN（f0），本件補 f1：dst = i64 值 id；x = 字符串值 id（TY-STR，住 %sv）；bs[k] 不用（0）。
; 發射：%v<dst> = extractvalue %str-long %sv<x>, 1（純單塊、無 helper）。
; ⚠ Go 的 OpLen/OpCap 無 %vec 分支（vec 長度走 vec_len helper call），故本代次刻意不造 OP-VECCAP——無忠實鏡像對象。
; ⚠ op 碼接在既有最大碼 OP-STRFROMVEC=76 之後（取 77），不重排既有碼。
OP-STRCAP = 77

; ── 结构体（M4-c 续件 s29/s30/s31；型别码 = TY-STRUCT-BASE + 结构体 id）────
; 结构体值住 %st<id>；IR 型别名 %struct.s<结构体 id>，由 cg-runtime-struct-decls(sfc)
; 一次性发射（sfc[结构体 id] = 字段数）。本层支持【构造 + 读字段 + 写字段 + 跨块槽】。
; 字段型别当前**只有 i64**（ADD/MUL 等分支硬编 %v）；str/vec/option 字段需逐字段 RC，属后续。
; OP-STRUCT-MK ：dst = 结构体值 id；xa[k] = 字段0 值 id；bs[k] = 字段个数；
;               字段值 id 连续（xa..xa+count-1）。发射 count 步链式 insertvalue，
;               初值用 `zeroinitializer`（字段数由型别声明决定，不必逐字段写 0）。
;               结构体 id 取 cty[k] - TY-STRUCT-BASE。
; ⚠️ 中间步用 %sm<k>_<j>（k = 指令下标、j = 字段下标），最后一步才落到规范的 %st<dst>
;    （避免 multiple definition of local value）。
; OP-STRUCT-GET：dst = i64 值 id；xa[k] = 结构体值 id；bs[k] = 字段下标（编译期常量）。
;               发射 extractvalue %struct.s<id> %st<xa>, <bs>；id 取 vty[xa[k]] - TY-STRUCT-BASE。
OP-STRUCT-MK = 31
OP-STRUCT-GET = 32

; ── 结构体写字段与结构体槽（M4-c 续件 s30）────────────────────────────
; OP-STRUCT-SET：dst = 新结构体值 id；xa[k] = 旧结构体值 id；
;               xa[k]+1 = 新字段值 id（i64，**连续**，与 OP-CALL 的实参约定同形）；
;               bs[k] = 字段下标（编译期常量）。
;               LLVM 结构不可变 ⇒ 发 `insertvalue %struct.s<id> %st<xa>, i64 %v<xa+1>, <bs>`，
;               结果是**新值**（旧值仍可用），不是就地改写。要「就地」效果须配合槽三件套。
;               结构体 id 取 vty[xa[k]] - TY-STRUCT-BASE（旧值的型别）。
; OP-STALLOC ：dst = 结构体槽 id；bs[k] = 结构体 id（本 op 无值操作数，故 id 放 bs）。
;              发 `%sts<id> = alloca %struct.s<结构体 id>`。
;               ⚠️ 槽住第七个命名空间 %sts<id>，与结构体**值** %st<id> 必须区分——
;                  两者差一个字符，写错就是 load 到一个值名（LLVM 报 not a pointer）。
; OP-STSTORE ：xa[k] = 结构体值 id；bs[k] = 槽 id。发 store，无结果；id 取 vty[xa[k]] - TY-STRUCT-BASE。
; OP-STLOAD  ：dst = 结构体值 id；xa[k] = 槽 id。发 load；id 取 cty[k] - TY-STRUCT-BASE。
;              三者与 str 的 SALLOC/SSTORE/SLOAD 一一对应，只是型别换成 %struct.s<id>。
OP-STRUCT-SET = 33
OP-STALLOC = 34
OP-STSTORE = 35
OP-STLOAD = 36

; ── 结构体字段的 RC 原语（M4-c 续件 s33；§11 B11 的第一块）──────────────
; 语义：结构体**值**对它的每个「持有堆的字段」各算一份拥有权。这两个 op 只做**机械动作**，
;   **不做策略判断**：要不要 retain、何时 release 由调用方（未来的 hir2mir）决定。
;   ⚠️ 刻意**不**让 OP-STRUCT-MK 自动 retain：MK 的操作数可能是全局常量（STRCONST，无 RC 头），
;      对常量做 retain 会去读 data-16 的「头」——那是全局对象之外的内存。Go 侧靠静态
;      「这个值是否拥有堆」决定，MIR 目前没有这个信息（vty 只说型别，不说所有权）。
; OP-STRUCT-RETAIN ：xa[k] = 结构体值 id；bs[k] = **字段掩码**（bit j 置位 ⇒ 字段 j 持有堆）。
;                    对每个置位字段：extractvalue 取 %str-long → 取 data(i8*) → call retain。
; OP-STRUCT-RELEASE：同上，call release（返回 i1 丢弃）。
; ⚠️ 掩码的 bit 只允许落在 **str 字段**上：发射端按「%struct.s<id> 的字段 j 就是 %str-long」
;    取 data 指针，落在 i64 字段上会让 opt 报 insertvalue/extractvalue 型别不符。
; ⚠️ 掩码放 bs 而不是 xa：xa 已被结构体值 id 占用；且 bs 在同族 op 里本来就「各 op 自定义」
;    （MK=字段数、GET/SET=字段下标、这里=位掩码）。
; ⚠️ 位宽：bs 是 i64 ⇒ 一条 op 最多描述 64 个字段；超过的结构体必须分块发多条
;    （当前 AST 节点远未到 64，先不实现；与「掩码自证型别」同一处约束）。
OP-STRUCT-RETAIN = 37
OP-STRUCT-RELEASE = 38

; ── RC 发射原语（M4-c 第十一件：STRCAT 的 retain/release）────────
;   STRCAT 的结果在堆上、带 RC 头（rc=1，拥有）；本编译器必须在别名传递时
;   retain、在 scope 退出时 release，否则 UAF（§5.6.1 铁律）。这两个 op 是
;   hir2mir 后续组合 RC 的原子（见 §5.3.4.bf）。
;   ⚠️ 当前只作用于 TY-STR：extractvalue %str-long, 2 取 data 指针（= RC 头 +16），
;      再 call @nolang_rc_retain / @nolang_rc_release。vec 走裸 malloc（B5，暂不 RC）、
;      option 尚未堆装箱（B8），故两者暂不进这里。
;   ⚠️ @str_concat 返回的 rc=1 视为「隐式 retain」——拿到结果即记一次 RETAIN 事件
;      （见 §5.3.4.bf 与 cg-runtime-test 的平衡校验），scope 退出再 RELEASE。
;   ⚠️ 编码与 cg-rc.no 的校验事件码（RC-RETAIN=0 / RC-RELEASE=1）刻意错开：
;       MIR op 是「发射什么」，事件码是「喂给 check-rc-balance 的账本条目」，二者
;       语义相同但命名空间独立（避免跨模块同名冲突）。
; OP-RETAIN ：x = 字符串值 id（TY-STR）。发射 extractvalue 取 data ptr + call retain。
; OP-RELEASE：x = 字符串值 id（TY-STR）。发射 extractvalue 取 data ptr + call release。
OP-RETAIN = 27
OP-RELEASE = 28
