; ═══════════════════════════════════════════════════════════════════
; tok — TokenType 常量、名字表、關鍵字查找
; ═══════════════════════════════════════════════════════════════════
;
; ⚠️ 常量區與 name() **由生成器產出，不要手改**。
;    權威來源：src/lexer/token.go 的 iota 區塊。
;    生成器：/tmp/notok/gen（以 lexer.TokenType(i).String() 取值；任何 UNKNOWN
;    或缺名都讓生成**失敗**，而不是產出殘表）。
;    為什麼要生成：92 常量 + 92 名字手抄必有轉錄風險，而「編號錯一位」肉眼最難發現。
;    生成 + L1 全語料差分是兩道獨立的鎖。
;
; 命名：常量名照抄 Go 的識別符，但底線改中劃線（如 NOT-EQUALS）；
;    name() 回傳的字串仍照 Go 原樣（含底線），L1 差分比對的是字串值。
;    跨模組引用寫 tok.IF / tok.NOT-EQUALS。
;
; ⚠️ 順序即編號，**不得重排**。
;
; SHS 合規：無結構體（避開方法命名雷區）、無一等函式值、無 map 欄位。
; 三個自由函式的定義名**不含半形句點**（SHS S6）；跨模組呼叫寫 tok.name(c)。
;
; ⚠️ 定義順序：str-eq 必須在 keyword **之前**（本 repo 的呼叫一律向後引用）。

; ── 常量（ILLEGAL=0 … TILDE=91）──
ILLEGAL = 0
EOF = 1
NEWLINE = 2
COMMENT = 3
IDENT = 4
INT = 5
FLOAT = 6
STRING = 7
CHAR = 8
REGEX = 9
TRUE = 10
FALSE = 11
NIL = 12
IF = 13
ELIF = 14
ELSE = 15
RETURN = 16
FOR = 17
IN = 18
BREAK = 19
CONTINUE = 20
SUPER = 21
SELF = 22
IT = 23
USE = 24
LABEL = 25
HASH-LBRACE = 26
AS = 27
CHAN = 28
PTR = 29
SWITCH = 30
CASE = 31
DEFAULT = 32
MATCH = 33
MAP = 34
RUN = 35
AWY = 36
CO = 37
ASSIGN = 38
ADD = 39
SUB = 40
MUL = 41
QUO = 42
MOD = 43
EQUALS = 44
NOT-EQUALS = 45
LESS = 46
LESS-EQUALS = 47
GREATER = 48
GREATER-EQUALS = 49
LAND = 50
LOR = 51
INC = 52
DEC = 53
NOT = 54
XOR = 55
SHL = 56
SHR = 57
ARROW = 58
RARROW = 59
AND = 60
OR = 61
AND-NOT = 62
STAR-STAR = 63
BANG-BANG = 64
ELLIPSIS = 65
ADD-ASSIGN = 66
SUB-ASSIGN = 67
MUL-ASSIGN = 68
QUO-ASSIGN = 69
MOD-ASSIGN = 70
AND-ASSIGN = 71
OR-ASSIGN = 72
XOR-ASSIGN = 73
SHL-ASSIGN = 74
SHR-ASSIGN = 75
AND-NOT-ASSIGN = 76
QUESTION-ASSIGN = 77
LPAREN = 78
RPAREN = 79
LBRACE = 80
RBRACE = 81
LBRACKET = 82
RBRACKET = 83
COMMA = 84
SEMICOLON = 85
COLON = 86
DOT = 87
UNDERSCORE = 88
AT = 89
QUESTION = 90
TILDE = 91

; ── str-eq：逐位元組比較 ──
; ⚠️ 必須先比 len-bytes()，否則前綴相同的短字串會誤判相等。
;    注意 str.len() 回的是【碼點數】，不是位元組數。
; a: 運算元
; b: 運算元
; yes: 是否成立
str-eq = (a str, b str) (yes bool) {
    yes = false
    na = a.len-bytes()
    nb = b.len-bytes()
    na != nb -> return
    i <- [0..na): {

        ; ⚠️ str.byte 現回傳 ?byte（可為空，越界回 nil）⇒ 必須解包成純 byte 再比：
        ;   直接比兩個 option 永不「不等」（比較的是 option 本身而非位元組），
        ;   會讓 str-eq 退化成【只比長度】——實測 `it`/`ab` 被誤判成最後一個
        ;   二字元關鍵字 `co`（tok.CO=37），導致所有多字元識別字不再是 IDENT，
        ;   ps-parse-stmt 的 `tk.typ == tok.IDENT` 臂全不命中（let 全失效）。
        ca-opt = a.byte(i)
        ca = ca-opt: {
            ok -> it
            -> 0
        }
        cb-opt = b.byte(i)
        cb = cb-opt: {
            ok -> it
            -> 0
        }
        ca != cb -> return
    }
    yes = true
}

; ── name：code -> 識別符名（L1 差分實際比較的就是它）──
; c: 運算元
; r: 結果字串
name = (c i64) (r str) {
    r = c: {
        ILLEGAL -> 'ILLEGAL'
        EOF -> 'EOF'
        NEWLINE -> 'NEWLINE'
        COMMENT -> 'COMMENT'
        IDENT -> 'IDENT'
        INT -> 'INT'
        FLOAT -> 'FLOAT'
        STRING -> 'STRING'
        CHAR -> 'CHAR'
        REGEX -> 'REGEX'
        TRUE -> 'TRUE'
        FALSE -> 'FALSE'
        NIL -> 'NIL'
        IF -> 'IF'
        ELIF -> 'ELIF'
        ELSE -> 'ELSE'
        RETURN -> 'RETURN'
        FOR -> 'FOR'
        IN -> 'IN'
        BREAK -> 'BREAK'
        CONTINUE -> 'CONTINUE'
        SUPER -> 'SUPER'
        SELF -> 'SELF'
        IT -> 'IT'
        USE -> 'USE'
        LABEL -> 'LABEL'
        HASH-LBRACE -> 'HASH_LBRACE'
        AS -> 'AS'
        CHAN -> 'CHAN'
        PTR -> 'PTR'
        SWITCH -> 'SWITCH'
        CASE -> 'CASE'
        DEFAULT -> 'DEFAULT'
        MATCH -> 'MATCH'
        MAP -> 'MAP'
        RUN -> 'RUN'
        AWY -> 'AWY'
        CO -> 'CO'
        ASSIGN -> 'ASSIGN'
        ADD -> 'ADD'
        SUB -> 'SUB'
        MUL -> 'MUL'
        QUO -> 'QUO'
        MOD -> 'MOD'
        EQUALS -> 'EQUALS'
        NOT-EQUALS -> 'NOT_EQUALS'
        LESS -> 'LESS'
        LESS-EQUALS -> 'LESS_EQUALS'
        GREATER -> 'GREATER'
        GREATER-EQUALS -> 'GREATER_EQUALS'
        LAND -> 'LAND'
        LOR -> 'LOR'
        INC -> 'INC'
        DEC -> 'DEC'
        NOT -> 'NOT'
        XOR -> 'XOR'
        SHL -> 'SHL'
        SHR -> 'SHR'
        ARROW -> 'ARROW'
        RARROW -> 'RARROW'
        AND -> 'AND'
        OR -> 'OR'
        AND-NOT -> 'AND_NOT'
        STAR-STAR -> 'STAR_STAR'
        BANG-BANG -> 'BANG_BANG'
        ELLIPSIS -> 'ELLIPSIS'
        ADD-ASSIGN -> 'ADD_ASSIGN'
        SUB-ASSIGN -> 'SUB_ASSIGN'
        MUL-ASSIGN -> 'MUL_ASSIGN'
        QUO-ASSIGN -> 'QUO_ASSIGN'
        MOD-ASSIGN -> 'MOD_ASSIGN'
        AND-ASSIGN -> 'AND_ASSIGN'
        OR-ASSIGN -> 'OR_ASSIGN'
        XOR-ASSIGN -> 'XOR_ASSIGN'
        SHL-ASSIGN -> 'SHL_ASSIGN'
        SHR-ASSIGN -> 'SHR_ASSIGN'
        AND-NOT-ASSIGN -> 'AND_NOT_ASSIGN'
        QUESTION-ASSIGN -> 'QUESTION_ASSIGN'
        LPAREN -> 'LPAREN'
        RPAREN -> 'RPAREN'
        LBRACE -> 'LBRACE'
        RBRACE -> 'RBRACE'
        LBRACKET -> 'LBRACKET'
        RBRACKET -> 'RBRACKET'
        COMMA -> 'COMMA'
        SEMICOLON -> 'SEMICOLON'
        COLON -> 'COLON'
        DOT -> 'DOT'
        UNDERSCORE -> 'UNDERSCORE'
        AT -> 'AT'
        QUESTION -> 'QUESTION'
        TILDE -> 'TILDE'
        -> 'UNKNOWN'
    }
}

; ── keyword：識別符 -> 關鍵字 code（照抄 src/lexer/token.go 的 lookupKeyword）──
; 回 ILLEGAL(0) 表示不是關鍵字，呼叫端應視為 IDENT。
; 刻意用值匹配而非 map：SHS 禁「map 欄位 + 方法」，且只有 23 個關鍵字。
; s: 字串
; r: 結果數值
keyword = (s str) (r i64) {
    r = s: {
        'if' -> IF
        'elif' -> ELIF
        'else' -> ELSE
        'switch' -> SWITCH
        'case' -> CASE
        'default' -> DEFAULT
        'match' -> MATCH
        'for' -> FOR
        'while' -> FOR
        'in' -> IN
        'return' -> RETURN
        'break' -> BREAK
        'continue' -> CONTINUE
        'true' -> TRUE
        'false' -> FALSE
        'nil' -> NIL
        'as' -> AS
        'ptr' -> PTR
        'chan' -> CHAN
        'use' -> USE
        'run' -> RUN
        'awy' -> AWY
        'co' -> CO
        -> ILLEGAL
    }
}
