; kind-name: 節點種類 id → 型別名（供 <unknown> 與除錯用）
kind-name = (id i64) (r str) {
    r = id: {
        1 -> 'AnnotationArrayValue'

        2 -> 'AnnotationBoolValue'

        3 -> 'AnnotationEntry'

        4 -> 'AnnotationIdentValue'

        5 -> 'AnnotationIntValue'

        6 -> 'AnnotationRangeValue'

        7 -> 'AnnotationStatement'

        8 -> 'AnnotationStringValue'

        9 -> 'AnnotationStructValue'

        10 -> 'ArrayLiteral'

        11 -> 'ArrayType'

        12 -> 'AssignExpression'

        13 -> 'BlockMatchStatement'

        14 -> 'BlockStatement'

        15 -> 'BooleanLiteral'

        16 -> 'BreakStatement'

        17 -> 'CallExpression'

        18 -> 'CastExpression'

        19 -> 'ChanSendStatement'

        20 -> 'ChanType'

        21 -> 'CharLiteral'

        22 -> 'CoExpression'

        23 -> 'ConditionalExpression'

        24 -> 'ContinueStatement'

        25 -> 'DotExpression'

        26 -> 'EmptyStatement'

        27 -> 'EnumDefinition'

        28 -> 'EnumValue'

        29 -> 'ExportStatement'

        30 -> 'ExpressionStatement'

        31 -> 'ExternStatement'

        32 -> 'FloatLiteral'

        33 -> 'ForStatement'

        34 -> 'FunctionDefinition'

        35 -> 'FunctionLiteral'

        36 -> 'FunctionType'

        37 -> 'GroupedExpression'

        38 -> 'Identifier'

        39 -> 'IfExpression'

        40 -> 'IndexExpression'

        41 -> 'InfixExpression'

        42 -> 'IntegerLiteral'

        43 -> 'InterfaceDefinition'

        44 -> 'IterationExpr'

        45 -> 'LetStatement'

        46 -> 'MapLiteral'

        47 -> 'MapPair'

        48 -> 'MapType'

        49 -> 'MultiAssignStatement'

        50 -> 'NamedType'

        51 -> 'NilLiteral'

        52 -> 'NullableType'

        53 -> 'Parameter'

        54 -> 'PointerType'

        55 -> 'PrefixExpression'

        56 -> 'Program'

        57 -> 'RangeExpression'

        58 -> 'RegexLiteral'

        59 -> 'ReturnStatement'

        60 -> 'SliceExpression'

        61 -> 'SliceLiteral'

        62 -> 'SliceType'

        63 -> 'StringLiteral'

        64 -> 'StructDefinition'

        65 -> 'StructField'

        66 -> 'StructLiteral'

        67 -> 'SurfaceMatch'

        68 -> 'TaggedEnumDefinition'

        69 -> 'TaggedEnumVariant'

        70 -> 'TypeAlias'

        71 -> 'UnionType'

        72 -> 'UnwrapAssignStatement'

        73 -> 'UseStatement'

        74 -> 'ViewType'

        -> 'UNKNOWN-KIND'
    }
}

; kind-id: 型別名 → 節點種類 id（找不到回 0）
kind-id = (name str) (r i64) {
    r = name: {
        'AnnotationArrayValue' -> 1

        'AnnotationBoolValue' -> 2

        'AnnotationEntry' -> 3

        'AnnotationIdentValue' -> 4

