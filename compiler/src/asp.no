; ── 節點種類 id ──
; 命名照 tok.no 的風格：大寫 + 底線，跨模組寫 asp.K_IDENTIFIER。
K_ANNOTATION_ARRAY_VALUE = 1
K_ANNOTATION_BOOL_VALUE = 2
K_ANNOTATION_ENTRY = 3
K_ANNOTATION_IDENT_VALUE = 4
K_ANNOTATION_INT_VALUE = 5
K_ANNOTATION_RANGE_VALUE = 6
K_ANNOTATION_STATEMENT = 7
K_ANNOTATION_STRING_VALUE = 8
K_ANNOTATION_STRUCT_VALUE = 9
K_ARRAY_LITERAL = 10
K_ARRAY_TYPE = 11
K_ASSIGN_EXPRESSION = 12
K_AWAIT_EXPRESSION = 13
K_BLOCK_STATEMENT = 14
K_BOOLEAN_LITERAL = 15
K_BREAK_STATEMENT = 16
K_CALL_EXPRESSION = 17
K_CAST_EXPRESSION = 18
K_CHAR_LITERAL = 19
K_CO_EXPRESSION = 20
K_CONDITIONAL_EXPRESSION = 21
K_CONTINUE_STATEMENT = 22
K_DOT_EXPRESSION = 23
