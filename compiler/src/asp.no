K_FUNCTION_TYPE = 33
K_GROUPED_EXPRESSION = 34
K_IDENTIFIER = 35
K_IF_EXPRESSION = 36
K_INDEX_EXPRESSION = 37
K_INFIX_EXPRESSION = 38
K_INTEGER_LITERAL = 39
K_INTERFACE_DEFINITION = 40
K_ITERATION_EXPR = 41
K_LET_STATEMENT = 42
K_MAP_LITERAL = 43
K_MAP_PAIR = 44
K_MAP_TYPE = 45
K_MULTI_ASSIGN_STATEMENT = 46
K_NAMED_TYPE = 47
K_NIL_LITERAL = 48
K_NULLABLE_TYPE = 49
K_PARAMETER = 50
K_POINTER_TYPE = 51
K_PREFIX_EXPRESSION = 52
K_PROGRAM = 53
K_RANGE_EXPRESSION = 54
K_REGEX_LITERAL = 55
K_RETURN_STATEMENT = 56
K_RUN_EXPRESSION = 57
K_SLICE_EXPRESSION = 58
K_SLICE_LITERAL = 59
