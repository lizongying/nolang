K-REGEX-LITERAL = 57
K-RETURN-STATEMENT = 58
K-RUN-EXPRESSION = 59
K-SLICE-EXPRESSION = 60
K-SLICE-LITERAL = 61
K-SLICE-TYPE = 62
K-STRING-LITERAL = 63
K-STRUCT-DEFINITION = 64
K-STRUCT-FIELD = 65
