K-SURFACE-MATCH = 67
K-TAGGED-ENUM-DEFINITION = 68
K-TAGGED-ENUM-VARIANT = 69
K-TYPE-ALIAS = 70
K-UNION-TYPE = 71
K-UNWRAP-ASSIGN-STATEMENT = 72
K-USE-STATEMENT = 73
K-VIEW-TYPE = 74

; kind-name: 節點種類 id → 型別名（供 <unknown> 與除錯用）
kind-name = (id i64) (r str) {
    r = id: {
        1 -> 'AnnotationArrayValue'

        2 -> 'AnnotationBoolValue'

        3 -> 'AnnotationEntry'

        4 -> 'AnnotationIdentValue'

        5 -> 'AnnotationIntValue'

        6 -> 'AnnotationRangeValue'

        7 -> 'AnnotationStatement'

        8 -> 'AnnotationStringValue'

        9 -> 'AnnotationStructValue'

        10 -> 'ArrayLiteral'

        11 -> 'ArrayType'

        12 -> 'AssignExpression'

        13 -> 'AwaitExpression'

        14 -> 'BlockMatchStatement'

        15 -> 'BlockStatement'

        16 -> 'BooleanLiteral'

        17 -> 'BreakStatement'

        18 -> 'CallExpression'

        19 -> 'CastExpression'

        20 -> 'CharLiteral'

        21 -> 'CoExpression'

        22 -> 'ConditionalExpression'

        23 -> 'ContinueStatement'

        24 -> 'DotExpression'

        25 -> 'EmptyStatement'

        26 -> 'EnumDefinition'

        27 -> 'EnumValue'

        28 -> 'ExportStatement'

        29 -> 'ExpressionStatement'

        30 -> 'ExternStatement'

        31 -> 'FloatLiteral'

        32 -> 'ForStatement'

        33 -> 'FunctionDefinition'

        34 -> 'FunctionLiteral'

        35 -> 'FunctionType'

        36 -> 'GroupedExpression'

        37 -> 'Identifier'

        38 -> 'IfExpression'

        39 -> 'IndexExpression'

        40 -> 'InfixExpression'

        41 -> 'IntegerLiteral'

        42 -> 'InterfaceDefinition'

        43 -> 'IterationExpr'

        44 -> 'LetStatement'

        45 -> 'MapLiteral'

        46 -> 'MapPair'

        47 -> 'MapType'

        48 -> 'MultiAssignStatement'

        49 -> 'NamedType'

        50 -> 'NilLiteral'

        51 -> 'NullableType'

        52 -> 'Parameter'

        53 -> 'PointerType'

        54 -> 'PrefixExpression'

        55 -> 'Program'

        56 -> 'RangeExpression'

        57 -> 'RegexLiteral'

        58 -> 'ReturnStatement'

        59 -> 'RunExpression'

        60 -> 'SliceExpression'

        61 -> 'SliceLiteral'

        62 -> 'SliceType'

        63 -> 'StringLiteral'

        64 -> 'StructDefinition'

        65 -> 'StructField'

        66 -> 'StructLiteral'

        67 -> 'SurfaceMatch'

        68 -> 'TaggedEnumDefinition'

        69 -> 'TaggedEnumVariant'

        70 -> 'TypeAlias'

        71 -> 'UnionType'

        72 -> 'UnwrapAssignStatement'

        73 -> 'UseStatement'

        74 -> 'ViewType'

        -> 'UNKNOWN-KIND'
    }
}

; kind-id: 型別名 → 節點種類 id（找不到回 0）
kind-id = (name str) (r i64) {
    r = name: {
        'AnnotationArrayValue' -> 1

        'AnnotationBoolValue' -> 2

        'AnnotationEntry' -> 3

        'AnnotationIdentValue' -> 4

        'AnnotationIntValue' -> 5

        'AnnotationRangeValue' -> 6

        'AnnotationStatement' -> 7

        'AnnotationStringValue' -> 8

        'AnnotationStructValue' -> 9

        'ArrayLiteral' -> 10

        'ArrayType' -> 11

        'AssignExpression' -> 12

        'AwaitExpression' -> 13

