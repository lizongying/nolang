; kind-name: 節點種類 id → 型別名（供 <unknown> 與除錯用）
kind-name = (id i64) (r str) {
    r = 'UNKNOWN-KIND'
    id == 1 -> r = 'AnnotationArrayValue'
    id == 2 -> r = 'AnnotationBoolValue'
    id == 3 -> r = 'AnnotationEntry'
    id == 4 -> r = 'AnnotationIdentValue'
    id == 5 -> r = 'AnnotationIntValue'
    id == 6 -> r = 'AnnotationRangeValue'
    id == 7 -> r = 'AnnotationStatement'
