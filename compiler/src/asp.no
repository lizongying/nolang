K-SLICE-TYPE = 61
K-STRING-LITERAL = 62
K-STRUCT-DEFINITION = 63
K-STRUCT-FIELD = 64
K-STRUCT-LITERAL = 65
K-SURFACE-MATCH = 66
K-TAGGED-ENUM-DEFINITION = 67
K-TAGGED-ENUM-VARIANT = 68
K-TYPE-ALIAS = 69
K-UNION-TYPE = 70
K-UNWRAP-ASSIGN-STATEMENT = 71
K-USE-STATEMENT = 72
K-VIEW-TYPE = 73

; kind-name: 節點種類 id → 型別名（供 <unknown> 與除錯用）
kind-name = (id i64) (r str) {
    r = id: {
        1 -> 'AnnotationArrayValue'

        2 -> 'AnnotationBoolValue'

        3 -> 'AnnotationEntry'

        4 -> 'AnnotationIdentValue'

        5 -> 'AnnotationIntValue'

        6 -> 'AnnotationRangeValue'

        7 -> 'AnnotationStatement'

        8 -> 'AnnotationStringValue'

        9 -> 'AnnotationStructValue'

        10 -> 'ArrayLiteral'

        11 -> 'ArrayType'

        12 -> 'AssignExpression'

        13 -> 'AwaitExpression'

        14 -> 'BlockMatchStatement'

        15 -> 'BlockStatement'

        16 -> 'BooleanLiteral'

        17 -> 'BreakStatement'

        18 -> 'CallExpression'

        19 -> 'CastExpression'

        20 -> 'CharLiteral'

        21 -> 'CoExpression'

        22 -> 'ConditionalExpression'

        23 -> 'ContinueStatement'

        24 -> 'DotExpression'

        25 -> 'EnumDefinition'

        26 -> 'EnumValue'

        27 -> 'ExportStatement'

        28 -> 'ExpressionStatement'

        29 -> 'ExternStatement'

        30 -> 'FloatLiteral'

        31 -> 'ForStatement'

        32 -> 'FunctionDefinition'

        33 -> 'FunctionLiteral'

        34 -> 'FunctionType'

        35 -> 'GroupedExpression'

        36 -> 'Identifier'

        37 -> 'IfExpression'

        38 -> 'IndexExpression'

        39 -> 'InfixExpression'

        40 -> 'IntegerLiteral'

        41 -> 'InterfaceDefinition'

        42 -> 'IterationExpr'

        43 -> 'LetStatement'

        44 -> 'MapLiteral'

        45 -> 'MapPair'

        46 -> 'MapType'

        47 -> 'MultiAssignStatement'

        48 -> 'NamedType'

        49 -> 'NilLiteral'

        50 -> 'NullableType'

        51 -> 'Parameter'

        52 -> 'PointerType'

        53 -> 'PrefixExpression'

        54 -> 'Program'

        55 -> 'RangeExpression'

        56 -> 'RegexLiteral'

        57 -> 'ReturnStatement'

        58 -> 'RunExpression'

        59 -> 'SliceExpression'

        60 -> 'SliceLiteral'

        61 -> 'SliceType'

        62 -> 'StringLiteral'

        63 -> 'StructDefinition'

        64 -> 'StructField'

        65 -> 'StructLiteral'

        66 -> 'SurfaceMatch'

        67 -> 'TaggedEnumDefinition'

        68 -> 'TaggedEnumVariant'

        69 -> 'TypeAlias'

        70 -> 'UnionType'

        71 -> 'UnwrapAssignStatement'

        72 -> 'UseStatement'

        73 -> 'ViewType'

        -> 'UNKNOWN-KIND'
    }
}

; kind-id: 型別名 → 節點種類 id（找不到回 0）
kind-id = (name str) (r i64) {
    r = name: {
        'AnnotationArrayValue' -> 1

        'AnnotationBoolValue' -> 2

        'AnnotationEntry' -> 3

        'AnnotationIdentValue' -> 4

        'AnnotationIntValue' -> 5

        'AnnotationRangeValue' -> 6

        'AnnotationStatement' -> 7

        'AnnotationStringValue' -> 8

        'AnnotationStructValue' -> 9

        'ArrayLiteral' -> 10

        'ArrayType' -> 11

        'AssignExpression' -> 12

        'AwaitExpression' -> 13

        'BlockMatchStatement' -> 14

        'BlockStatement' -> 15

        'BooleanLiteral' -> 16

        'BreakStatement' -> 17

        'CallExpression' -> 18

        'CastExpression' -> 19

        'CharLiteral' -> 20

        'CoExpression' -> 21

        'ConditionalExpression' -> 22

        'ContinueStatement' -> 23

        'DotExpression' -> 24

        'EnumDefinition' -> 25

        'EnumValue' -> 26

        'ExportStatement' -> 27

        'ExpressionStatement' -> 28

        'ExternStatement' -> 29

        'FloatLiteral' -> 30

        'ForStatement' -> 31

        'FunctionDefinition' -> 32

        'FunctionLiteral' -> 33

        'FunctionType' -> 34

        'GroupedExpression' -> 35

        'Identifier' -> 36

        'IfExpression' -> 37

        'IndexExpression' -> 38

        'InfixExpression' -> 39

        'IntegerLiteral' -> 40

        'InterfaceDefinition' -> 41

        'IterationExpr' -> 42

        'LetStatement' -> 43

        'MapLiteral' -> 44

        'MapPair' -> 45

        'MapType' -> 46

        'MultiAssignStatement' -> 47

        'NamedType' -> 48

        'NilLiteral' -> 49

