K-TAGGED-ENUM-DEFINITION = 66
K-TAGGED-ENUM-VARIANT = 67
K-TYPE-ALIAS = 68
K-UNION-TYPE = 69
K-UNWRAP-ASSIGN-STATEMENT = 70
K-USE-STATEMENT = 71
K-VIEW-TYPE = 72

; 節點種類 id → 型別名（供 <unknown> 與除錯用）
; id: 數值
; r: 結果字串
kind-name = (id i64) (r str) {
    r = id: {
        1 -> 'AnnotationArrayValue'

        2 -> 'AnnotationBoolValue'

        3 -> 'AnnotationEntry'

        4 -> 'AnnotationIdentValue'

        5 -> 'AnnotationIntValue'

        6 -> 'AnnotationRangeValue'

        7 -> 'AnnotationStatement'

        8 -> 'AnnotationStringValue'

        9 -> 'AnnotationStructValue'

        10 -> 'ArrayLiteral'

        11 -> 'ArrayType'

        12 -> 'AssignExpression'

        13 -> 'AwaitExpression'

        14 -> 'BlockStatement'

        15 -> 'BooleanLiteral'

        16 -> 'BreakStatement'

        17 -> 'CallExpression'

        18 -> 'CastExpression'

        19 -> 'CharLiteral'

        20 -> 'CoExpression'

        21 -> 'ConditionalExpression'

        22 -> 'ContinueStatement'

        23 -> 'DotExpression'

        24 -> 'EnumDefinition'

        25 -> 'EnumValue'

        26 -> 'ExportStatement'

        27 -> 'ExpressionStatement'

        28 -> 'ExternStatement'

        29 -> 'FloatLiteral'

        30 -> 'ForStatement'

        31 -> 'FunctionDefinition'

        32 -> 'FunctionLiteral'

        33 -> 'FunctionType'

        34 -> 'GroupedExpression'

        35 -> 'Identifier'

        36 -> 'IfExpression'

        37 -> 'IndexExpression'

        38 -> 'InfixExpression'

        39 -> 'IntegerLiteral'

        40 -> 'InterfaceDefinition'

        41 -> 'IterationExpr'

        42 -> 'LetStatement'

        43 -> 'MapLiteral'

        44 -> 'MapPair'

        45 -> 'MapType'

        46 -> 'MultiAssignStatement'

        47 -> 'NamedType'

        48 -> 'NilLiteral'

        49 -> 'NullableType'

        50 -> 'Parameter'

        51 -> 'PointerType'

        52 -> 'PrefixExpression'

        53 -> 'Program'

        54 -> 'RangeExpression'

        55 -> 'RegexLiteral'

        56 -> 'ReturnStatement'

        57 -> 'RunExpression'

        58 -> 'SliceExpression'

        59 -> 'SliceLiteral'

        60 -> 'SliceType'

        61 -> 'StringLiteral'

        62 -> 'StructDefinition'

        63 -> 'StructField'

        64 -> 'StructLiteral'

        65 -> 'SurfaceMatch'

        66 -> 'TaggedEnumDefinition'

        67 -> 'TaggedEnumVariant'

        68 -> 'TypeAlias'

        69 -> 'UnionType'

        70 -> 'UnwrapAssignStatement'

        71 -> 'UseStatement'

        72 -> 'ViewType'

        -> 'UNKNOWN-KIND'
    }
}

; 型別名 → 節點種類 id（找不到回 0）
; name: 名稱
; r: 結果數值
kind-id = (name str) (r i64) {
    r = name: {
        'AnnotationArrayValue' -> 1

        'AnnotationBoolValue' -> 2

        'AnnotationEntry' -> 3

        'AnnotationIdentValue' -> 4

        'AnnotationIntValue' -> 5

        'AnnotationRangeValue' -> 6

        'AnnotationStatement' -> 7

        'AnnotationStringValue' -> 8

        'AnnotationStructValue' -> 9

        'ArrayLiteral' -> 10

        'ArrayType' -> 11

        'AssignExpression' -> 12

        'AwaitExpression' -> 13

        'BlockStatement' -> 14

        'BooleanLiteral' -> 15

        'BreakStatement' -> 16

        'CallExpression' -> 17

        'CastExpression' -> 18

        'CharLiteral' -> 19

        'CoExpression' -> 20

        'ConditionalExpression' -> 21

        'ContinueStatement' -> 22

        'DotExpression' -> 23

        'EnumDefinition' -> 24

        'EnumValue' -> 25

        'ExportStatement' -> 26

        'ExpressionStatement' -> 27

        'ExternStatement' -> 28

        'FloatLiteral' -> 29

        'ForStatement' -> 30

        'FunctionDefinition' -> 31

        'FunctionLiteral' -> 32

        'FunctionType' -> 33

        'GroupedExpression' -> 34

        'Identifier' -> 35

        'IfExpression' -> 36

        'IndexExpression' -> 37

        'InfixExpression' -> 38

        'IntegerLiteral' -> 39

        'InterfaceDefinition' -> 40

        'IterationExpr' -> 41

        'LetStatement' -> 42

        'MapLiteral' -> 43

        'MapPair' -> 44

        'MapType' -> 45

        'MultiAssignStatement' -> 46

        'NamedType' -> 47

        'NilLiteral' -> 48

        'NullableType' -> 49

        'Parameter' -> 50

        'PointerType' -> 51

        'PrefixExpression' -> 52

        'Program' -> 53

        'RangeExpression' -> 54

        'RegexLiteral' -> 55

        'ReturnStatement' -> 56

        'RunExpression' -> 57

        'SliceExpression' -> 58

        'SliceLiteral' -> 59

        'SliceType' -> 60

        'StringLiteral' -> 61

        'StructDefinition' -> 62

        'StructField' -> 63

        'StructLiteral' -> 64

        'SurfaceMatch' -> 65

        'TaggedEnumDefinition' -> 66

        'TaggedEnumVariant' -> 67

        'TypeAlias' -> 68

        'UnionType' -> 69

        'UnwrapAssignStatement' -> 70

        'UseStatement' -> 71

        'ViewType' -> 72

        -> 0
    }
}
