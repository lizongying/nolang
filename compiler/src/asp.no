        'BlockStatement' -> 15

        'BooleanLiteral' -> 16

        'BreakStatement' -> 17

        'CallExpression' -> 18

        'CastExpression' -> 19

        'CharLiteral' -> 20

        'CoExpression' -> 21

        'ConditionalExpression' -> 22

        'ContinueStatement' -> 23

        'DotExpression' -> 24

        'EmptyStatement' -> 25

        'EnumDefinition' -> 26

        'EnumValue' -> 27

        'ExportStatement' -> 28

