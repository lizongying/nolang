            wildA.push(wild)
            patA.push(pat)
            blkA.push(blk)
            ; s66c surface collection
            ;   wildcard 規則（對齊 oracle）：_/bare-> 與 ok/ok(v) ⇒ wildcard:true；
            ;   err/nil（含綁定 err(e)/nil）一律非 wildcard，保留 Condition 型樣節點。
            sw = wild
            kvar == 'ok' -> sw = 1
            dotVal = 0
            kvar == 'ok' -> dotVal = 1
            ; bindingVariant：僅解構綁定名存在時填（ok(v)⇒ok / err(e)⇒err）
            bvar = ''
            kvar == 'ok' -> {
                bname != '' -> bvar = 'ok'
            }
            kvar == 'err' -> {
                bname != '' -> bvar = 'err'
            }
            swA.push(sw)
            dotValA.push(dotVal)
            bindA.push(bname)
            bvarA.push(bvar)
