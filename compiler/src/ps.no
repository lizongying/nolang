            bshape = 0; s61：每臂重置（避免上一臂 blockMatch 泄漏至本臂）
            hd2 = 0
            bodyDone = 0; s7：blockMatch 內層裸 match 體已收旗標
            hasTrail = 0
            ps-peek(p) == tok.LBRACE -> {

                ; s7 續：blockMatch 分類臂體（oracle expr.go:1302-1333 的 LBRACE-blockMatch
                ;   成功路）——整體是內層裸 match（`-> { cond -> …; -> … }`）時，oracle 收成
