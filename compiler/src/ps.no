; ═════════════════════════════════════════════════════════════════
; ps — Nolang 語法分析器（M2 的第一片）
; ═════════════════════════════════════════════════════════════════
;
; 目標（M2，見 docs/design/nolang-selfhost.md §5.3）：把 token 串
; （lx.scan-all 的產物）解析成 ast 的 arena，使 `noc ast <file>` 的 dump
; 與 L2 oracle `no ast <file>` **逐位元組相同**。
;
; ⚠️ 本檔是【第一片】——只涵蓋足以重現下列最小 fixture 的子集合：
;   * `42`                                  ExpressionStatement + IntegerLiteral
;   * `main = () { 42 }`                    FunctionDefinition + BlockStatement
;   * `x = 1` / `b = true` / `s = 'hi'`     LetStatement + 型別推論（i64/bool/str）
;   尚未涵蓋：明示型別標註、infix/前綴運算式、多數陳述與運算式種類、參數
;   型別與預設值、註解、annotations。這些是後續增量擴充的目標。
;
; ── arena 的建構順序（關鍵不變式）──────────────────────────────────
; `ast.add` 在呼叫當下把 `kid0` 固定成「目前 kids 陣列的長度」。因此必須
; **先建子節點（含它們的子樹），再建父節點並 kid-add 子節點**（自底向上），
; 這樣每個節點的 kid0 才會正確指到它在 kids 陣列裡的子樹起點。所有
; ps-parse-* 都遵守這個順序。
;
; ── 必須複製的是「建構路徑」，不只是語義（§5.3.2）──────────────────
;   `x = 1` 的型別不是寫在原始碼裡的，而是 Go 端 lowering 推論出 `i64`、
;   並在 NamedType 上標 `inferred: true`。noc 要綠燈就必須在同一路徑上
;   合成這個 NamedType——本檔的 ps-infer-type 就是做這件事。
;
; ── SHS 合規 ──────────────────────────────────────────────────────
;   無模組級可變狀態、無一等函式值、無指針、無 map 欄位。
; ⚠️ 整數運算預設回 option<int>：每條算術陳述都要 #{overflow=wrap}。
; ⚠️ 讀 `arr[i]`（i 非字面量）要 #{index-out=zero}。
; ⚠️ `;` 是**行註解**，不是陳述分隔符。
; ⚠️ `(cond) { … }` 才是迴圈；`v: { … }` 是 match 臂。
;
; ── 結構體回傳值的釋放陷阱（oracle 後端缺陷，見 docs/design/
;    nolang-selfhost.md §2.2.x / 記憶）─────────────────────────────
;   tk 結構體含 7 個 str 欄位。**實測（noc 編譯产物，M2）**：「把
;   []tk 的元素讀進一個結構體暫存值」是**淺別名**（`t = p.toks[i]` 不
;   深拷貝 str 欄位），於是任何持有這份別名的區域變數在作用域結束時
;   會釋放**仍住在 toks 向量裡**的字串緩衝：第一次釋放僥倖無事，第二
;   次（同一元素的另一份別名、或向量自身解構時）就是 malloc abort
;   （RC=134「pointer being freed was not allocated」）。「先指派給區
;   域變數」並**不能**防住這個坑。
;   ⇒ 本檔守則（已驗證有效）：
;     · 只需型別時用 `ps-peek` / `ps-peek-at`（回傳 i64，用鏈式欄位讀
;       `p.toks[i].typ`，不產生結構體別名）；
;     · 需要完整 token 時 `ps-peek-token` 逐欄位重建，str 欄位一律
;       `.copy()`（強制新分配，切斷與向量元素的共享）；
;     · `ps-bump` 只前進 pos，**不得**用 `_ = ps-peek-token(p)` 來表達
;       「吃 token」的意圖。

# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok

; ── 解析器狀態 ──
; ⚠️ 結構體名 psst（不是 ps）：模組短名是 ps（來自 `# /compiler/src/ps`），
;    若結構體也叫 ps 會和模組名撞名，導致 EmitLLVM: unknown callee ps.new。
;   跨模組呼叫寫 ps.new / ps.parse —— 必須對應【裸】函式名 `new` / `parse`
;   （lx.no 的 lx.dump → 裸 `dump` 是同樣規則）。
psst {
    toks []tk
    pos i64
    warn i64
    inBlk i64
    inMatch i64
    valCtx i64; s67：值語境標記（對齊 Go CTX_EXPR）——賦值 RHS 期間為 1，驅動 MatchArm.valueCtx
    fn str
    lastTp i64
    sigN []str
    sigP []i64
    msN []str
    msP []i64
    dclF []str
    dclV []str
    gclN []str
    fvF []str
    fvV []str
    fvT []str
    gvN []str
    gvT []str
    alN []str
    dclT []str
    enN []str
    evN []str
    evP []str
    evC []i64
    efE []str
    efV []str
    efT []str
    htK []str; O(1) lookup: key -> value (open addressing; grows on demand)
    htV []i64
    htTy []str; type strings, indexed by htV value
    htN i64; live entry count in htK/htV (drives load-factor growth)
    aeLn i64; s7w：AssignExpression `=` token 行（__idx_out_L_C 寫形命名用）
    aeCl i64; s7w：AssignExpression `=` token 列
    aoVal str; s7t2：AnnotationStatement 攜帶的 index-out DEF 值（跨陳述傳遞）
    aoTy i64; s7t2：index-out DEF token 型別
    aoOvf str; s7x：AnnotationStatement 攜帶的 overflow 模式（跨陳述傳遞；Go 對 `(cond) { }` 前置條件循環等「不可附著」形，既產 AnnotationStatement 又把 overflow 寫進緊後 ForStatement，見 /tmp/twhile.no 實測）
    rwDoc i64; s8a：本條陳述被 ps-apply-index-out 降糖改寫 ⇒ 行前 Doc 須丟棄（Go 的 Doc 掛在 parse 期原 LetStatement，降糖另建 BlockStatement 取代之；見 /tmp/tdoc.no）
    docLn i64; s8c：最近一次 ps-skip-trivia-doc 取到行前 Doc 的**行號**（對齊 Go stmt.go:2187 的 openBraceLine 判定）
    aoDoc i64; s8d：「註解行與目標陳述之間」的註釋（Go annotation.go:229-267 between）⇒ 掛成目標陳述的 Doc 並覆寫外層行前 Doc
    ifdFn str; s8g：IsFuncDeclared 追蹤鍵（''⇒用 p.fn；`recv.method = (…)` 形 Go 以**裸方法名**為鍵且事後不隨 FuncVarTypes 遷移，decl.go:56-82 ⇒ 同名方法跨接收者共享宣告集，實測 mD/mE）
    varFlag i64; 變參標記（ps-parse-param 檢測 `name ..T` 時置 1；呼叫端建 FunctionDefinition 時寫入 varflag 槽，對齊 Go IsVariadic / dump 的 Variadic{}）
    resParam i64; 解析**回傳值**參數時為 1（Go decl.go:1693-1698 的 Results 路徑**不**解析默認值；只有 Parameters 路徑 decl.go:362-366 / :1631-1635 才解析 `= expr`）
    eLn []i64; s10：診斷收集器（對齊 Go parser.diags []Diagnostic）——錯誤行號
    eCl []i64; 錯誤列號
    eMsg []str; 錯誤正文（【不含】位置前綴；渲染由呼叫端負責）
    eCode []str; 穩定錯誤碼（saveError 系的字面 'E_GENERAL'，見 parser.go:1698）
}

; s58：方法簽名表鍵 'recv.method'（Go methodSignatures）
; s58：值=回傳值型別起始 token 下標（-1=無型別）

; ── s51：parse 期型別推斷表（對齊 Go parser 的 funcSignatures / VarTypes / FuncVarTypes / DeclaredVars）──
; 當前函式名（'' = 頂層）；Go p.curFuncName
; ps-parse-param 最近一次型別起始 token 下標（-1=無型別）
; 同檔函式簽名：函式名（最後註冊覆蓋先前的）
; 對應回傳值型別起始 token 下標
; FuncDeclaredVars 對：(函式名, 變數名)

; DeclaredVars（全域，頂層 let 亦記此）
; FuncVarTypes 對：(函式名, 變數名) → 型別字串

; VarTypes（模組級）

; ── S7 match 表示開關（2026-10-20，見 docs/design/nolang-selfhost.md §5.3.4）──
;   0 = 降糖成 if/else 鏈（舊預設，保留為 A/B 基線）；1 = 直接產 SurfaceMatch（預設）。
;   **S7 裁定①（2026-10-21，使用者拍板）**：noc 改產 SurfaceMatch（parser 忠實，P1），
;   降糖留待 M4 的 hir.no 重新實作。開關保留作回歸對照（翻 0 重編即得降糖基線）。
PS-SURFACE-MATCH = 1

; new：掃描原始碼，建立解析器（跨模組呼叫寫 ps.new → 必須是裸函式名 `new`）
new = (src []byte) (r psst) {
    r = psst {
        toks: lx.scan-all(src)
        pos: 0
        warn: 0
        inBlk: 0
        inMatch: 0
        valCtx: 0; s67：值語境標記（對齊 Go CTX_EXPR）——賦值 RHS 期間為 1，驅動 MatchArm.valueCtx
        fn: ''
        lastTp: -1
        sigN: with-cap(4)
        sigP: with-cap(4)
        msN: with-cap(4)
        msP: with-cap(4)
        dclF: with-cap(8)
        dclV: with-cap(8)
        gclN: with-cap(8)
        fvF: with-cap(8)
        fvV: with-cap(8)
        fvT: with-cap(8)
        gvN: with-cap(8)
        gvT: with-cap(8)
        alN: with-cap(4)
        dclT: with-cap(8)
        enN: with-cap(4)
        evN: with-cap(4)
        evP: with-cap(4)
        evC: with-cap(4)
        efE: with-cap(4)
        efV: with-cap(4)
        efT: with-cap(4)
        htK: with-cap(256)
        htV: with-cap(256)
        htTy: with-cap(256)
        htN: 0
        eLn: with-cap(4)
        eCl: with-cap(4)
        eMsg: with-cap(4)
        eCode: with-cap(4)
    }
    ; pre-fill initial hash slots (open addressing; grows on demand via ps-ht-put)
    hi = 0
    (hi < 256) {
        r.htK.push('')
        r.htV.push(0)
        hi = hi + 1
    }
}

; s60：tagged-enum 登記表（Go sem.EnumVariants / SetEnumVariantPayload / SetEnumVariantFields，
;   decl.go:1196-1224）——行 i = (enN[i] 枚舉名, evN[i] 變體名)：evP=載荷型別文字（單元=''、
;   多欄位='enum.variant' 合成結構名）、evC=欄位數；欄位型別另存 ef* 行（依枚舉定義序）。
;   ps-parse-enum-def（kind==2）填表；ps-parse-match 據此判定變體臂 decomp 與補集。
ps-enum-row = (p psst, en str, v str) (r i64) {
    r = -1
    i = 0
    (i < p.evN.len() && r < 0) {

        #{index-out=zero}
        p.enN[i].copy() == en && p.evN[i].copy() == v -> r = i

        #{overflow=wrap}
        i = i + 1
    }

    ; 限定名剝落（Go enumVariantPayload：raw key 不中再試最後 '.' 後的裸名）
    r < 0 -> {
        d = -1
        j = en.len-bytes() - 1
        (j >= 0 && d < 0) {

            #{index-out=zero}
            eb-opt = en.byte(j)
            eb = eb-opt: {
                ok -> it
                -> 0
            }
            eb == 46 -> d = j

            #{overflow=wrap}
            j = j - 1
        }
        d >= 0 -> {
            tail = en.slice-bytes(d + 1, en.len-bytes())
            k = 0
            (k < p.evN.len() && r < 0) {

                #{index-out=zero}
                p.enN[k].copy() == tail && p.evN[k].copy() == v -> r = k

                #{overflow=wrap}
                k = k + 1
            }
        }
    }
    r
}

; ps-enum-has：en 是否為已登記枚舉（任一變體行即算）
ps-enum-has = (p psst, en str) (r i64) {
    r = 0
    i = 0
    (i < p.enN.len() && r == 0) {

        #{index-out=zero}
        p.enN[i].copy() == en -> r = 1

        #{overflow=wrap}
        i = i + 1
    }
    r == 0 -> {
        d = -1
        j = en.len-bytes() - 1
        (j >= 0 && d < 0) {

            #{index-out=zero}
            eb-opt = en.byte(j)
            eb = eb-opt: {
                ok -> it
                -> 0
            }
            eb == 46 -> d = j

            #{overflow=wrap}
            j = j - 1
        }
        d >= 0 -> {
            tail = en.slice-bytes(d + 1, en.len-bytes())
            k = 0
            (k < p.enN.len() && r == 0) {

                #{index-out=zero}
                p.enN[k].copy() == tail -> r = 1

                #{overflow=wrap}
                k = k + 1
            }
        }
    }
    r
}

; ps-enum-payload：變體載荷型別文字（無行或單元變體 ⇒ ''）
ps-enum-payload = (p psst, en str, v str) (s str) {
    s = ''
    r = ps-enum-row(p, en, v)
    r >= 0 -> {

        #{index-out=zero}
        s = p.evP[r].copy()
    }
}

; ps-enum-ncols：變體欄位數（無行 ⇒ 0；Go enumVariantFieldTypes 長度）
ps-enum-ncols = (p psst, en str, v str) (n i64) {
    n = 0
    r = ps-enum-row(p, en, v)
    r >= 0 -> {

        #{index-out=zero}
        n = p.evC[r]
    }
}

; ps-enum-ftype：變體第 j 欄位型別文字（越界 ⇒ ''）——依 (enN[r],evN[r]) 匹配行計數定位
ps-enum-ftype = (p psst, en str, v str, j i64) (s str) {
    s = ''
    r = ps-enum-row(p, en, v)
    r >= 0 -> {
        cnt = 0
        k = 0
        (k < p.efT.len() && s == '') {

            #{index-out=zero}
            p.efE[k].copy() == p.enN[r] && p.efV[k].copy() == p.evN[r] -> {
                cnt == j -> s = p.efT[k].copy()

                #{overflow=wrap}
                cnt = cnt + 1
            }

            #{overflow=wrap}
            k = k + 1
        }
    }
}

; ps-enum-variants：依登記序輸出枚舉全部變體名（補集計算用）
ps-enum-variants = (p psst, en str, out []str) {
    i = 0
    (i < p.evN.len()) {

        #{index-out=zero}
        p.enN[i].copy() == en -> out.push(p.evN[i].copy())

        #{overflow=wrap}
        i = i + 1
    }
}

; ps-peek：目前 token 的型別（越界視為 EOF）。回傳 i64——避免回傳帶字串欄位
;   的 tk 結構體當作暫存值（會觸發釋放崩潰）。
ps-peek = (p psst) (typ i64) {
    i = p.pos
    i >= p.toks.len() -> {
        typ = tok.EOF
        return
    }

    #{index-out=zero}
    typ = p.toks[i].typ
}

; ps-peek-token：目前 token 的完整結構體。逐欄位重建 + str `.copy()`，
;   回傳的 tk 持有全新字串，呼叫端可安全指派/讀欄位（見檔頭守則）。
ps-peek-token = (p psst) (t tk) {
    t = tk {
        ln: 0
        cl: 0
        typ: 0
        lit: ''
        raw: ''
        mk: ''
        emsg: ''
    }
    p.pos >= p.toks.len() -> return

    #{index-out=zero}
    t.ln = p.toks[p.pos].ln
    t.cl = p.toks[p.pos].cl
    t.typ = p.toks[p.pos].typ
    t.lit = p.toks[p.pos].lit.copy()
    t.raw = p.toks[p.pos].raw.copy()
    t.mk = p.toks[p.pos].mk.copy()
    t.emsg = p.toks[p.pos].emsg.copy()
}

; ps-peek-at：向前看 k 個 token（0 = 目前）的型別（越界視為 EOF）。
ps-peek-at = (p psst, k i64) (typ i64) {

    #{overflow=wrap}
    i = p.pos + k
    i >= p.toks.len() -> {
        typ = tok.EOF
        return
    }

    #{index-out=zero}
    typ = p.toks[i].typ
}

; ps-is-func：判斷【目前 pos（LPAREN）】起是否為 `(...) {` 形式（即
;   `name = ` 右側是 FunctionLiteral）。⚠️ 單看首個 LPAREN 不够：實測
;   `a = (x)` 被误判成函式定義 → 進入 ps-parse-block 後找不到 RBRACE 永轉。
;   從 LPAREN 掃到平衡的 RPAREN，再確認下一個非 trivia token 是 LBRACE。
ps-is-func = (p psst) (r i64) {
    r = 0
    depth = 0
    i = 0
    go = true
    (go) {
        t = ps-peek-at(p, i)
        t == tok.EOF -> go = false
        go -> {
            t == tok.LPAREN -> {

                #{overflow=wrap}
                depth = depth + 1
            }
            t == tok.RPAREN -> {

                #{overflow=wrap}
                depth = depth - 1
                depth == 0 -> {

                    ; 閉合瞭：往後找第一個非 trivia token

                    #{overflow=wrap}
                    k = i + 1
                    nt = ps-peek-at(p, k)
                    (nt == tok.NEWLINE) {

                        #{overflow=wrap}
                        k = k + 1
                        nt = ps-peek-at(p, k)
                    }
                    (nt == tok.COMMENT) {

                        #{overflow=wrap}
                        k = k + 1
                        nt = ps-peek-at(p, k)
                    }

                    ; 群組閉合後第一個非 trivia：`{` ⇒ 函式；`(` ⇒ 回傳元組（續掃）；其他 ⇒ 非函式
                    nt == tok.LBRACE -> {
                        r = 1
                        go = false
                    }

                    ; 回傳元組：`(...)` 後接 `(` ⇒ 不中斷（go 保持 true），續掃下一群組
                    nt == tok.LPAREN -> {}

                    ; 既非 `{` 亦非 `(`（含 EOF）⇒ 不是函式定義，停止（r 維持 0）
                    nt != tok.LBRACE && nt != tok.LPAREN -> go = false
                }
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
}

; ps-bump：消費目前 token 並前進（回傳 void）。
; ⚠️ 這裡**不能**寫 `_ = ps-peek-token(p)`「消費暫存值」：捨棄回傳的 tk
;    會觸發「釋放不存在的指標」（見檔頭「結構體回傳值的釋放陷阱」）。
;    bump 只需要前進 pos，不讀 token。
ps-bump = (p psst) {

    #{overflow=wrap}
    p.pos = p.pos + 1
}

; ps-skip-trivia：跳過 NEWLINE / COMMENT（詞法上不影響 AST 結構）
ps-skip-trivia = (p psst) {
    go = true
    (go) {
        t = ps-peek(p)
        {
            t == tok.NEWLINE -> ps-bump(p)

            t == tok.COMMENT -> ps-bump(p)

            -> go = false
        }
    }
}

; ps-cur-lit：複製目前 token 的 lit（字串欄位）回傳，供讀取註解文字。
;   .copy() 切斷與 toks 向量元素的共享（見檔頭釋放守則）。
ps-cur-lit = (p psst) (s str) {
    s = ''
    p.pos < p.toks.len() -> {

        #{index-out=zero}
        s = p.toks[p.pos].lit.copy()
    }
}

; ps-lit-at：向前看 k 個 token（0 = 目前）的 lit（字串）。
;   .copy() 切斷與 toks 向量元素的共享（見檔頭釋放守則）。
ps-lit-at = (p psst, k i64) (s str) {
    s = ''

    #{overflow=wrap}
    i = p.pos + k
    i < p.toks.len() -> {

        #{index-out=zero}
        s = p.toks[i].lit.copy()
    }
}

; ps-skip-trivia-doc：跳過 NEWLINE / COMMENT，同時完成「註解歸位」——
;   · 行前註解（其前已見換行，或無前兄弟 prevIdx==0）⇒ 取【首條】作為回傳 docId
;     （dump.go 只渲染群組第一條，故 docTaken 守衛只留一條）
;   · 行尾註解（緊接前一兄弟陳述的同一行、其前無換行）⇒ 掛到 prevIdx 的 Comment:
; 回傳 0 表示無 doc 群組。對齊 Go collectDocComments + attachInlineComment：
;   Doc 附著於【其後】那條陳述、行尾 Comment 附著於【其前】那條陳述。
; ⚠️ 換行偵測靠【保留在 token 串中的 NEWLINE token】（本解析器不預先丟棄換行）。
ps-skip-trivia-doc = (t ast, p psst, prevIdx i64) (docId i64) {
    docId = 0
    p.docLn = 0; s8c：每次收集重設，呼叫端據行號判斷是否為「開括號同行的註解」
    docTaken = 0
    cmtTaken = 0
    sawNL = 0
    go = true
    (go) {
        tt = ps-peek(p)
        {
            tt == tok.NEWLINE -> {
                sawNL = 1
                ps-bump(p)
            }

            tt == tok.COMMENT -> {
                isTrailing = sawNL == 0 && prevIdx > 0
                isTrailing -> {
                    cmtTaken == 0 -> {
                        ast.set-cmt(t, prevIdx, ast.put-doc-str(t, ps-cur-lit(p)))
                        cmtTaken = 1
                    }
                }
                isTrailing == false -> {
                    docTaken == 0 -> {
                        docId = ast.put-doc-str(t, ps-cur-lit(p))
                        p.docLn = p.toks[p.pos].ln; s8c：記錄行號（開括號同行判定用）
                        docTaken = 1
                    }
                }
                ps-bump(p)
            }

            -> go = false
        }
    }
    docId
}

; ps-trail-region：向前掃描（不消費 token）——若跳過全部 NEWLINE/COMMENT 後首個
;   實 token 是 RBRACE 或 EOF，回 1，代表當前處於「尾註解區」：其後不會再有陳述，
;   因此緊接的 standalone 註解应歸本區塊/程式的 TrailingComments（對齊 Go stmt.go:2141
;   block.TrailingComments = collectDocComments()，其後无语句）。回 0 = 其後仍有陳述
;   （那些 standalone 註解是下一條陳述的 leading Doc，不在此處理）。
ps-trail-region = (p psst) (r i64) {
    r = 0
    k = 0
    go = true
    (go) {
        tt = ps-peek-at(p, k)
        {
            tt == tok.NEWLINE -> {

                #{overflow=wrap}
                k = k + 1
            }

            tt == tok.COMMENT -> {

                #{overflow=wrap}
                k = k + 1
            }

            tt == tok.RBRACE -> {
                r = 1
                go = false
            }

            tt == tok.EOF -> {
                r = 1
                go = false
            }

            -> go = false
        }
    }
}

; ps-collect-tail：消費「尾註解區」的 NEWLINE/COMMENT 直到 RBRACE/EOF。
;   · 緊接 prev 同一行、其前無換行的首條註解 → 掛 prev 的 inline Comment（對齊 Go 行尾註解）；
;   · 其餘 standalone 註解 → 其 str-id 依序收集進 trail（本區塊/程式的 TrailingComments 各條）。
;   ⚠️ 與 ps-skip-trivia-doc 同形（用旗標 sawNL/cmtTaken，非互斥補集重取），只在 ps-trail-region
;   回 1 時由呼叫端使用；對無尾註解的區塊 trail 空 → 後續 ps-attach-trailing 不建節點（零回歸）。
ps-collect-tail = (t ast, p psst, prev i64, trail []i64) {
    sawNL = 0
    cmtTaken = 0
    go = true
    (go) {
        tt = ps-peek(p)
        {
            tt == tok.NEWLINE -> {
                sawNL = 1
                ps-bump(p)
            }

            tt == tok.COMMENT -> {
                inline = sawNL == 0 && prev > 0 && cmtTaken == 0
                inline -> {
                    ast.set-cmt(t, prev, ast.put-doc-str(t, ps-cur-lit(p)))
                    cmtTaken = 1
                }
                inline == false -> {
                    trail.push(ast.put-str(t, ps-cur-lit(p)))
                }
                sawNL = 0
                ps-bump(p)
            }

            -> go = false
        }
    }
}

; ps-attach-trailing：把 trail（註解文字 str-id 向量）落成區塊/程式節點的 TrailingComments。
;   對應 ast.no trailing-comments 渲染（OP-TRAILING）：節點需 ct0（aux 起點）+ ntrail（條數）。
;   子先於父原則下 aux 區段獨立於 kids，故於節點 add 之後再 aux-begin/aux-add/set-aux-counts。
;   trail 空 → 不建任何 aux、不設 ntrail（維持預設 -1 → dumper 跳過印出，零回歸）。
ps-attach-trailing = (t ast, idx i64, trail []i64) {
    trail.len() > 0 -> {
        base = ast.aux-begin(t, idx)
        base >= 0 -> {
            k = 0
            (k < trail.len()) {
                ast.aux-add(t, trail[k])

                #{overflow=wrap}
                k = k + 1
            }
        }
        ast.set-aux-counts(t, idx, trail.len(), -1, 0)
    }
}

; ps-premerge-trailing：s59——把 armDoc 置前併入既有 TrailingComments 群
;   （Go match.go:443-451：merged = armDoc ++ existing；無既有群⇒等同 ps-attach-trailing
;   單條）。aux 只append：新區段複製舊條目，舊區段成孤兒（不影走訪，零回歸）。
ps-premerge-trailing = (t ast, blk i64, head i64) {
    head != 0 -> {
        d = ast.nd-at(t, blk)
        d.ntrail < 0 -> {
            tr []i64 = with-cap(1)
            tr.push(head)
            ps-attach-trailing(t, blk, tr)
        }
        d.ntrail >= 0 -> {

            #{overflow=wrap}
            nt = d.ntrail
            c0 = d.ct0
            ast.aux-begin(t, blk)
            ast.aux-add(t, head)
            j = 0
            (j < nt) {
                ast.aux-add(t, ast.aux-at(t, c0 + j))

                #{overflow=wrap}
                j = j + 1
            }
            ast.set-aux-counts(t, blk, nt + 1, d.nclos, d.nimp)
        }
    }
}

; ps-expect：若目前 token 是 want 就消費它（容錯：不符也繼續）
ps-expect = (p psst, want i64) {
    ps-peek(p) == want -> ps-bump(p)

    -> {}
}

; ── s10：語法錯誤收集器（M3-c 首族）───────────────────────────────
; 對齊 Go parser 的 Diagnostic 通道（src/parser/error.go）：本檔只存【結構化】
; 欄位（行/列/正文/碼），位置前綴「line L, column C:」從不進正文——渲染Shape
; 由消費端負責（diag.render 的面向使用者行形、FormatDiagnostics 的中間串形）。
; Authority：p.errorf 以 tok 定位（1-based ln/cl，lx.no §2：NEWLINE 的 col 恆 0）；
; p.saveError 按 (Pos, Message) 去重（parser.go:1685-1693，防 restoreState 重試
; 重複上報）——去鍵不含 Code，此處同形。

; ps-error：在【目前 token】位置記一條錯誤（坐標取自 p.toks[p.pos]，越界視同 EOF
;   的 0/0——Go 端 currentToken 恆有值，EOF token 也帶行列；語料外差異留 M3-c 後續）。
ps-error = (p psst, msg str, code str) {
    ; 坐標先擷取（p.pos 可等於 toks.len()——尾哨兵越界一格的讀一律按 0 處理）
    #{index-out=zero}
    curLn = p.toks[p.pos].ln
    #{index-out=zero}
    curCl = p.toks[p.pos].cl

    ; 去重：同 (ln, cl, msg) 已報過 ⇒ 直接返回（Go saveError 同鍵）
    k = 0
    (k < p.eLn.len()) {
        p.eLn[k] == curLn && p.eCl[k] == curCl && p.eMsg[k] == msg -> return

        k = k + 1
    }
    p.eLn.push(curLn)
    p.eCl.push(curCl)
    p.eMsg.push(msg)
    p.eCode.push(code)
}

; ps-err-count：已收集的錯誤條數（= Go len(p.diags) 的 error 級子集；本階段只收錯誤）。
ps-err-count = (p psst) (n i64) {
    n = p.eLn.len()
}

; ── 進入點 ──
; ps-parse：解析整份原始碼，回傳 Program 節點索引。
;
; ⚠️ 單一回傳值（i64）：arena `t` 與解析器 `p` 由呼叫端建立並作為【輸入參數】
;    傳入。單一回傳值的函式會【借用】結構體輸入參數（不會在函式內釋放），
;    與 ast-test.no 中反覆呼叫 `ast.add(t, …)` 同形——呼叫端在 ps-parse 返回
;    後仍能安全使用 `t`（例如 ast.dump(t, root)）。
;    （多回傳值含結構體 `(r ast, root i64)` 在 oracle 後端會被錯誤 lowering：
;     函式本體不執行、回傳 0，見本次除錯紀錄。）
;
; ⚠️ arena 建構順序（關乎正確性，不只是風格外）：`ast.add` 在呼叫當下把
;    kid0 固定為「當時 kids.len()」，而父節點自己【不】佔 kids 槽位。因此
;    必須【先解析完全部子節點（它們的子樹已依序追加），再 add 父節點，
;    最後依序 kid-add 子節點】——即本函式把 Program 留到最後才 add。
;    （若先 add 父再建子，子的子樹會插在父的 kid 範圍前面，dump 會把孫
;     節點錯置成父的直接子節點——實測 `42` 曾因此少印 ExpressionStatement。）
; ps-semi-eat-count：復刻 Go buffer.go::warnSemiSwallow 的 W_SEMI_EAT 計數（s56）。
;   nolang 中單個 `;` 是行註釋，行尾其後的代碼（含大括號）整體被吞。Go 在
;   advanceCollect 收集每個符合條件的 COMMENT token 時發一條 SeverityWarning，
;   Program.warnings 匯總所有 warning（parser.go::Warnings）。
;   啟發式是純詞法的 ⇒ 對 toks 做一次前向預掃即可得同計數：Go 的
;   warnedSemiEat[idx] 去重是防「回溯後重放同註釋」，預掃天然每 token 一遇。
;   條件（全滿足才計）：
;     1. mk == ';'（單分號行註釋；`;;` / `;;block` 的 Marker 不同、永不警告）
;     2. lit 含 '{'(123) 或 '}'(125)（疑似吞掉語句與右大括號）
;     3. 前一個非 COMMENT token 存在、非 NEWLINE 且與其同線（行尾註釋而非行首）
ps-semi-eat-count = (p psst) (n i64) {
    n = 0
    last = -1
    i = 0
    (i < p.toks.len()) {

        #{index-out=zero}
        typ = p.toks[i].typ
        typ != tok.COMMENT -> last = i
        typ == tok.COMMENT -> {

            #{index-out=zero}
            mk = p.toks[i].mk.copy()
            mk == ';' -> {

                #{index-out=zero}
                lit = p.toks[i].lit.copy()
                has = 0
                j = 0
                jl = lit.len-bytes()
                (j < jl) {
                    b-opt = lit.byte(j)
                    b = b-opt: {
                        ok -> it
                        -> 0
                    }
                    b == 123 || b == 125 -> has = 1

                    #{overflow=wrap}
                    j = j + 1
                }
                has == 1 && last >= 0 -> {

                    #{index-out=zero}
                    pt = p.toks[last].typ

                    #{index-out=zero}
                    lnP = p.toks[last].ln

                    #{index-out=zero}
                    lnC = p.toks[i].ln
                    pt != tok.NEWLINE && lnP == lnC -> n = n + 1
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
    n
}

parse = (t ast, p psst) (root i64) {
    stmts []i64 = with-cap(4)
    trail []i64 = with-cap(4)
    prev = 0
    docId = 0
    ps-trail-region(p) == 1 -> ps-collect-tail(t, p, 0, trail)
    ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, 0)
    (ps-peek(p) != tok.EOF) {
        pos0 = p.pos
        s = ps-parse-stmt(t, p)
        s > 0 -> {
            ; s8a：陳述被安全索引降糖改寫 ⇒ 行前 Doc 丟棄（oracle 的 Doc 隨被取代的
            ;   原 LetStatement 一起消失，見 ps-apply-index-out 的 rwDoc 標記）
            docId != 0 && p.rwDoc == 0 -> ast.set-doc(t, s, docId)
            ; s8d：註解／目標之間的註釋後掛 ⇒ 覆寫外層行前 Doc（Go annotation.go:265）
            p.aoDoc != 0 -> {
                ; ⚠️ 降糖改寫過的陳述一樣不掛（s8a 同口徑，見 ps-apply-index-out）
                p.rwDoc == 0 -> ast.set-doc(t, s, p.aoDoc)
                p.aoDoc = 0
            }
            p.rwDoc = 0; ⚠️ 用後即清：否則巢狀區塊末條陳述的標記會外溢到外層陳述
            stmts.push(s)
            prev = s
        }

        ; ⚠️ 進度守則：未覆蓋的語法會回 idx=0 且不吃 token，無此守則時
        ;    迴圈永轉（實測：`noc ast src/std/char.no` busy-spin）。
        ;    對齊 oracle 的錯誤恢復屬於 M3/L3 的範疇；在此之前以
        ;    「強制前進一律終止」取代當機。
        p.pos == pos0 -> ps-bump(p)
        ps-trail-region(p) == 1 -> {
            ps-collect-tail(t, p, prev, trail)
            ; 尾註解區：其後僅剩 EOF，收集完即讓迴圈自然終止
        }
        ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, prev)
    }
    root = ast.add(t, asp.K_PROGRAM)
    j = 0
    (j < stmts.len()) {
        ast.kid-add(t, root, stmts[j])

        #{overflow=wrap}
        j = j + 1
    }

    ; Program 的 HDR 有 SCALAR warnings（pol=COUNT）→ 設為 '0' 即不印出
    ; ⚠️ warnings 計數：oracle 每 parse 一個 if/elif/else 就 saveWarning 一次
    ;   （src/parser/expr.go::parseIfExpression），Program.warnings 累加。
    ;   s56：疊加 W_SEMI_EAT（行尾 `;` 註釋吞大括號）的純詞法預掃計數。
    ast.set-count(t, root, 0, stmts.len())
    p.warn = p.warn + ps-semi-eat-count(p)
    ast.set-slot(t, root, 0, ast.put-str(t, p.warn.to-str()))
    ps-attach-trailing(t, root, trail)
    root
}

; ps-normalize-overflow：復刻 Go NormalizeOverflowMode（annotation.go）。
;   語料中 overflow 值幾乎恆為 `wrap`；此處認五個正規值，其餘回 ''（丢弃、不寫槽）。
ps-normalize-overflow = (s str) (r str) {
    r = ''
    {
        s == 'wrap' -> r = s

        s == 'clamp0' -> r = s

        s == 'min' -> r = s

        s == 'max' -> r = s

        s == 'saturate' -> r = s
    }
    r
}

; ps-parse-annotation 已【內聯】進 ps-parse-stmt 的前置註解迴圈（增量 V）：
;   原实装只回傳 overflow 並吞掉整段 `#{...}`，但 oracle 對「不可附著」的語句級註解
;   會保留独立 AnnotationStatement{entries: N} 節點，需在同段掃描中累計【去重頂層鍵名】數，
;   故改於 ps-parse-stmt 內聯完成（同時產出 ovf 與 keys）。ps-normalize-overflow 仍復用。

; ps-apply-overflow：把 overflow 模式寫到緊後陳述節點對應的純量槽。
;   只有 dump overflow 的節點型別才渲染（槽序依 spec 非 child-derived 純量順序）：
;     LetStatement=6 / ForStatement=2 / MultiAssignStatement=1 / FunctionDefinition=4。
;   ExpressionStatement/ReturnStatement 雖有 OverflowMode 欄位但 dump 不渲染 ⇒ 略過。
ps-apply-overflow = (t ast, idx i64, mode str) {
    idx > 0 -> {
        k = ast.kind-at(t, idx)
        sid = ast.put-str(t, mode)
        {
            k == asp.K_LET_STATEMENT -> ast.set-slot(t, idx, 6, sid)

            k == asp.K_FOR_STATEMENT -> ast.set-slot(t, idx, 2, sid)

            k == asp.K_MULTI_ASSIGN_STATEMENT -> ast.set-slot(t, idx, 1, sid)

            k == asp.K_FUNCTION_DEFINITION -> ast.set-slot(t, idx, 4, sid)
        }
    }
}

; ps-apply-builtin：s52——把前置 `#{buildin}` 註解標記寫到緊後陳述節點。
;   Go attachAnnotations（annotation.go:349–378）：對 FunctionDefinition——
;     e.Key=='buildin' ⇒ fd.BuiltinStub（slot5 'true'）；`#{buildin=NAME}` 之 Value ⇒ fd.BuiltinName（slot6 字串，語料暫無此形、預留）；
;   對 TaggedEnumDefinition——`#{buildin}` ⇒ n.Builtin（slot1 'true'，name=slot0、variants=c2）。
;   槽序由 dump.go 的渲染欄位序列導出（name0, colonSyntax1, methodDef2, skipNamingCheck3, overflow4, builtinStub5, builtinName6, builtinGroup7）。
;   ⚠️ `#{intrinsic}` 註解已從 Go 側移除（AST 欄位與 dump 欄位一併消失）⇒
;      FunctionDefinition 的純量槽少一個，builtinStub/builtinName 各前移一格。
ps-apply-builtin = (t ast, idx i64, bs i64, bn str) {
    idx > 0 -> {
        k = ast.kind-at(t, idx)
        {
            k == asp.K_FUNCTION_DEFINITION -> {
                bs == 1 -> ast.set-slot(t, idx, 5, ast.put-str(t, 'true'))

                bn != '' -> ast.set-slot(t, idx, 6, ast.put-str(t, bn))
            }

            k == asp.K_TAGGED_ENUM_DEFINITION -> {
                bs == 1 -> ast.set-slot(t, idx, 1, ast.put-str(t, 'true'))
            }
        }
    }
}

; ps-parse-use：`# path` 匯入陳述（對應 Go parseUseStatement、stmt.go:45）。
;   path 由可選前導 `/`（QUO）與以 `/`、`.` 分隔的 IDENT 段串接（joinPathParts）。
;   語料恆為純路徑（無 `.fn` / `as`）⇒ function/alias 恆空、as 恆 false。
;   UseStatement 槽：path=s0、function=s1（kv 恆渲染、置空字串）、alias=s2（同）、
;   as=s3（kvb policy=true、不設即省略）。
ps-parse-use = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 # (USE)
    path = ''
    ps-peek(p) == tok.QUO -> {
        path = path + '/'
        ps-bump(p)
    }
    (ps-peek(p) == tok.IDENT) {
        path = path + ps-cur-lit(p)
        ps-bump(p)

        ; 段間分隔符：`/` 或 `.`（github.com 類）——兩個獨立 standalone-if，至多一個觸發
        ps-peek(p) == tok.QUO -> {
            path = path + '/'
            ps-bump(p)
        }
        ps-peek(p) == tok.DOT -> {
            path = path + '.'
            ps-bump(p)
        }
    }
    idx = ast.add(t, asp.K_USE_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, path))
    ast.set-slot(t, idx, 1, ast.put-str(t, ''))
    ast.set-slot(t, idx, 2, ast.put-str(t, ''))
    idx
}

; ps-parse-stmt：解析一條陳述（頂層或區塊內通用）

; ps-is-multi-assign-start（測試 codegen）：含索引掃描，不含 trivia skip
ps-is-multi-assign-start = (p psst) (r i64) {
    r = 0
    t0 = ps-peek-at(p, 0)
    t0 == tok.IDENT -> {
        t1 = ps-peek-at(p, 1)
        t1 == tok.COMMA -> r = 1
        t1 == tok.LBRACKET -> {
            depth = 1
            i = 2
            (depth > 0) {
                tk = ps-peek-at(p, i)
                tk == tok.EOF -> depth = 0
                tk == tok.LBRACKET -> depth = depth + 1
                tk == tok.RBRACKET -> depth = depth - 1
                i = i + 1
            }
            nt = ps-peek-at(p, i)
            nt == tok.COMMA -> r = 1
        }
    }
}

; ps-parse-assign-target（s8x）：多重指派目標 = IDENT 或 IDENT[expr]（鏡 Go parseAssignTarget stmt.go:834-847）。
;   ⚠️ 不可複用 ps-parse-expr-prec：`=` 非中綴運算子，但 parseExpression 尾對 Dot/Index LHS 會
;   吸收 `= value` 建 AssignExpression（expr.go:598-637）⇒ 末目標為索引形（`bit, probs[m] = call(...)`）
;   時整個 `= call(...)` 被吞進目標 2、語句邊界錯位（tests/2.no 實測）。Go 用专用目標解析器：
;   讀 IDENT、可選一個 `[` expr `]`（索引内為 LOWEST 表達式）、`]` 後即止，不碰 `=`。
ps-parse-assign-target = (t ast, p psst) (r i64) {
    tk = ps-peek-token(p)
    ps-bump(p); 消費 IDENT
    r = ps-mk-ident(t, tk.lit)
    ps-peek(p) == tok.LBRACKET -> {
        ps-bump(p); 消費 [
        index = ps-parse-expr(t, p)
        ; Go：current 非 RBRACKET 時不報錯也不消費（寬容形），對齊之
        ps-peek(p) == tok.RBRACKET -> ps-bump(p)
        ie = ast.add(t, asp.K_INDEX_EXPRESSION)
        ast.kid-add(t, ie, r)
        ast.kid-add(t, ie, index)
        r = ie
    }
    r
}

; ps-is-type-name-literal（s8y）：鏡 Go isTypeName（type.go:404-413，閉集 15 名）。
;   ⚠️ 與 ps-is-builtin-type 不同：後者多含 'any' 且各处用途為型別位辨認；本鏡像須逐字對齊
;   Go 之閉集（不含 txt/char/any/bigint），供【裸型名陳述】(`u64` 独行) 分流守衛使用。
ps-is-type-name-literal = (s str) (r i64) {
    r = 0
    {
        s == 'i8' || s == 'i16' || s == 'i32' || s == 'i64' || s == 'i128' -> r = 1

        s == 'u8' || s == 'u16' || s == 'u32' || s == 'u64' || s == 'u128' -> r = 1

        s == 'f32' || s == 'f64' -> r = 1

        s == 'byte' || s == 'bool' || s == 'str' -> r = 1
    }
}

; ps-is-op-overload-name（s8y）：鏡 Go OperatorOverloadBaseName + IsOperatorOverloadName
;   （operator_overload.go:40-63）：限定名（`bigint._mul`）取最後 '.' 後裸名，閉集
;   {_add,_sub,_mul,_div,_mod} 命中回 1。裸名（呼叫點 dot.Property）無點同路。
ps-is-op-overload-name = (nm str) (r i64) {
    base = nm
    d = -1
    j = nm.len-bytes() - 1
    (j >= 0 && d < 0) {

        #{index-out=zero}
        nb-opt = nm.byte(j)
        nb = nb-opt: {
            ok -> it
            -> 0
        }
        nb == 46 -> d = j

        #{overflow=wrap}
        j = j - 1
    }
    d >= 0 -> base = nm.slice-bytes(d + 1, nm.len-bytes())
    r = 0
    (base == '_add' || base == '_sub' || base == '_mul' || base == '_div' || base == '_mod') -> r = 1
}

; ps-unwrap-op-overload-type（s8y）：節點級鏡 Go stripOperatorOverloadReturn／decl.go 的
;   `strings.TrimPrefix(ts, "?")`——nm 為運算符重載名且 tn 為 NullableType 時，回内層型別節點
;   （?T ⇒ T，剥一次）；否則原樣回 tn。
ps-unwrap-op-overload-type = (t ast, nm str, tn i64) (r i64) {
    r = tn
    ps-is-op-overload-name(nm) == 1 && tn > 0 && ast.kind-at(t, tn) == asp.K_NULLABLE_TYPE -> {
        ndo = ast.nd-at(t, tn)
        r = ast.kid-at(t, ndo.kid0)
    }
    r
}

ps-parse-stmt = (t ast, p psst) (idx i64) {
    idx = 0
    p.rwDoc = 0; s8a：每條陳述起始重置（呼叫端據此決定是否丟棄行前 Doc）
    p.aoDoc = 0; s8d：同上，註解／目標之間的註釋每條陳述重算
    ps-skip-trivia(p)
    ; s67：每條陳述起始重置值語境（僅賦值 RHS 期間為 1）
    ;   ⚠️ 但【match 臂體內不重置】：Go 的 CTX_EXPR 在整個 match 表達式（含巢狀
    ;   match）解析期間恆定，臂體陳述不會把它清掉。若在此重置，巢狀 match 讀到
    ;   `mv = p.valCtx` 會是 0 ⇒ 內層臂漏印 `valueCtx: true`
    ;   （t59：`h = n: { err -> n: { … } }` 實測兩條內層臂各差 1 行）。
    ;   外層仍照常重置（p.inMatch == 0），故 `a = n: {…}` 走 ps-parse-let 設 1 不受影響。
    p.inMatch == 0 -> p.valCtx = 0

    ; 前置語句級 `#{...}` 註解群組：連續消費全部 `#{...}`、去重累計【頂層鍵名】、提取 overflow 模式。
    ;   對應 Go parseAnnotationStatement（annotation.go:188–309）+ attachAnnotations。之後依「緊後陳述首 token」分流：
    ;     · 首 token ∈ {IDENT, IN, RARROW} ⇒【附著】到緊後陳述（Go 247 分支：回傳 parseStatement 結果、不產生独立節點；
    ;       overflow 由 ps-apply-overflow 寫入 Let/For/MultiAssign/Func 的純量欄）——落到下方 dispatch + 尾端 ovf 套用。
    ;     · 否則（DOT `.field=`、LPAREN、LBRACE… 不可附著形）⇒ 產生独立 `AnnotationStatement{entries: N}` 節點（N=去重鍵名數），
    ;       並【就此回傳】，緊後陳述留待下一輪 ps-parse-stmt（兩者在語句集合中為兄弟，對齊 dump.go:306）。
    ;   鍵名判定鏡像 Go parseAnnotationBody（annotation.go:990）：群組為扁平 `key [= value]` 逗號序列——鍵 IDENT 只出現在
    ;   `#{` 後或頂層 `,` 後（expect_key）；值內 ident（如 wrap）/ 括號（[ ] ( )）不計。去重鏡像 dedupeAnnotationEntries（同鍵名計一次）。
    ;   ⚠️ 連群組（空行分隔）合併後一起去重；keys 空（無註解）時整段跳過 ⇒ 對無 `#{...}` 檔案零回歸。
    ovf = ''
    bs = 0; s52：`#{buildin}` 標記（鏡像 Go fd.BuiltinStub）
    bn = ''; s52：`#{buildin=NAME}` 之 NAME（語料暫無、預留）
    idxOut = ''; s7n：`#{index-out=DEF}` 之 DEF 值字串（安全索引讀形降糖用）
    idxOutTy = 0; s7n：DEF 值 token 型別（tok.IDENT/INT/FLOAT/…）
    ffiLang = ''; s8o：FFI 語言鍵（#{c} 等），後續 IDENT = (...) 轉 ExternStatement
    ; s7t2：從 psst 讀取上一陳述 AnnotationStatement 攜帶的 index-out（跨陳述傳遞）
    p.aoVal != '' -> {
        idxOut = p.aoVal
        idxOutTy = p.aoTy
        p.aoVal = ''
        p.aoTy = 0
    }
    ; s7x：同法攜帶 overflow（AnnotationStatement 既獨立成節點、又作用於緊後 ForStatement）
    p.aoOvf != '' -> {
        ovf = p.aoOvf
        p.aoOvf = ''
    }
    stLn = 0; s7n：緊後陳述首 token 行（__idx_out_L_C 命名用，取 LHS 識別元位置）
    stCl = 0; s7n：緊後陳述首 token 列
    keys []str = with-cap(4)
    (ps-peek(p) == tok.HASH_LBRACE) {
        ps-bump(p); 消費 #{（進入群組，depth=1）
        depth = 1
        expect_key = true
        (depth > 0) {
            tk = ps-peek-token(p)
            {
                tk.typ == tok.EOF -> depth = 0

                tk.typ == tok.HASH_LBRACE || tk.typ == tok.LBRACE || tk.typ == tok.LBRACKET || tk.typ == tok.LPAREN -> {

                    #{overflow=wrap}
                    depth = depth + 1
                    expect_key = false
                    ps-bump(p)
                }

                tk.typ == tok.RBRACE || tk.typ == tok.RBRACKET || tk.typ == tok.RPAREN -> {

                    #{overflow=wrap}
                    depth = depth - 1
                    ps-bump(p)
                }

                tk.typ == tok.IDENT && expect_key && depth == 1 -> {
                    kn = tk.lit
                    found = 0
                    z = 0
                    (z < keys.len()) {
                        keys[z] == kn -> found = 1

                        #{overflow=wrap}
                        z = z + 1
                    }
                    found == 0 -> keys.push(kn)

                    ; s52：buildin 為 FunctionDefinition・TaggedEnum 的標記鍵（重複出現無害，Go 去重後仍命中）
                    kn == 'buildin' -> bs = 1
                    ; s8o：FFI 語言鍵裸條目（c/cpp/rust/go/zig/objc/asm）⇒ 記 ffiLang
                    (kn == 'c' || kn == 'cpp' || kn == 'rust' || kn == 'go' || kn == 'zig' || kn == 'objc' || kn == 'asm') && ps-peek(p) != tok.ASSIGN -> ffiLang = kn
                    ps-bump(p); 消費鍵名
                    expect_key = false
                    ps-peek(p) == tok.ASSIGN -> {
                        ps-bump(p); 消費 =
                        vt = ps-peek-token(p)
                        kn == 'overflow' && (vt.typ == tok.IDENT || vt.typ == tok.STRING) -> ovf = ps-normalize-overflow(vt.lit)
                        kn == 'buildin' && (vt.typ == tok.IDENT || vt.typ == tok.STRING) -> bn = vt.lit
                        ; s7n：`#{index-out=DEF}`——捕獲 DEF 值（標量：zero/nil/數字/布林/字串）；
                        ;   複合（`[`/`{` 起）不在此捕獲 ⇒ idxOut 留空、不降糖（留待後續）。
                        kn == 'index-out' && (vt.typ == tok.IDENT || vt.typ == tok.INT || vt.typ == tok.FLOAT || vt.typ == tok.STRING || vt.typ == tok.TRUE || vt.typ == tok.FALSE) -> {
                            idxOut = vt.lit
                            idxOutTy = vt.typ
                        }
                    }
                }

                tk.typ == tok.COMMA && depth == 1 -> {
                    expect_key = true
                    ps-bump(p)
                }

                ; 其他 token（值 ident/string/number、`...`、運算子、非鍵頂層 ident）：跳過
                -> ps-bump(p)
            }
        }
        ps-skip-trivia(p)
    }

    ; 有註解且緊後首 token 不可附著 ⇒ 產生独立 AnnotationStatement 節點、就此回傳（keys 空即跳過＝零回歸）
    ;   s7t2：暫存 idxOut 到 psst（供下一陳述降糖用——AnnotationStatement 攜帶注解）
    keys.len() > 0 && ps-peek(p) != tok.IDENT && ps-peek(p) != tok.IN && ps-peek(p) != tok.RARROW -> {
        idx = ast.add(t, asp.K_ANNOTATION_STATEMENT)
        ast.set-slot(t, idx, 0, ast.put-str(t, keys.len().to-str()))
        p.aoVal = idxOut
        p.aoTy = idxOutTy
        p.aoOvf = ovf
        ; s8b：回傳前把 `#}` 之後的 trivia（註釋／換行）**退回**給外層 Doc 收集器。
        ;   Go 的 parseAnnotationStatement 在「不可附著」時有 restoreBetween 把註解
        ;   還回 p.comments，隨即被下一輪 collectDocComments 取為緊後陳述的 Doc；
        ;   noc 上方 `ps-skip-trivia`（L993）是破壞性的，註釋被吃掉 ⇒ 緊後陳述漏 Doc
        ;   （實測 /tmp/tdoc3.no：`#{overflow=wrap}` ⏎ `; c1` ⏎ `(cond) {}` 的 c1 兩邊差 1 行）。
        (p.pos > 0) {
            pt = p.toks[p.pos - 1].typ
            pt == tok.COMMENT || pt == tok.NEWLINE -> p.pos = p.pos - 1
            -> break
        }
        return
    }
    ; s8d：Go annotation.go:229-267 ——「註解行與目標陳述之間」的註釋屬於同一 node，
    ;   掛成目標陳述的 Doc（並覆寫外層收集到的行前 Doc）。上方註解群末尾的
    ;   ps-skip-trivia（L993）是破壞性的 ⇒ 先退回 trivia 再用 ps-skip-trivia-doc 取回。
    ;   僅在有註解群時做（無註解而退回會把上一條陳述的行尾註釋誤當本條 Doc）。
    ;   實測：`#{overflow=wrap}` ⏎ `; D6：…` ⏎ `end-c char = pattern[ri + 2]`（regexp.no）。
    keys.len() > 0 -> {
        (p.pos > 0) {
            pt = p.toks[p.pos - 1].typ
            pt == tok.COMMENT || pt == tok.NEWLINE -> p.pos = p.pos - 1
            -> break
        }
        p.aoDoc = ps-skip-trivia-doc(t, p, 0)
    }
    tk = ps-peek-token(p)
    stLn = p.toks[p.pos].ln; s7n：捕獲緊後陳述首 token 位置（讀形 `IDENT = arr[i]` 即 LHS 識別元）
    stCl = p.toks[p.pos].cl
    {
        tk.typ == tok.IF -> {
            inner = ps-parse-if(t, p)
            inner > 0 -> {
                idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
                ast.kid-add(t, idx, inner)
            }
        }

        ; 陳述位裸區塊 `{ … }`——鏡像 Go parseStatement 的 LBRACE 臂（stmt.go:402）：
        ;   含深度 0 `->` ⇒ 裸 match desugared 單陳述；否則普通 BlockStatement 陳述。
        ;   此前此位無臂 ⇒ 防呆前进吃掉 `{`，區塊 wrapper 消失（語句外洩一層）。
        tk.typ == tok.LBRACE -> idx = ps-parse-brace-stmt(t, p)

        ; `for`/`while` 关键字迴圈（无限 / 条件 / range），對應 Go parseForStatement 的 FOR 分支
        tk.typ == tok.FOR -> idx = ps-parse-for-kw(t, p)

        ; `break` / `continue`（可带同列标签），對應 Go parseBreak/ContinueStatement
        tk.typ == tok.BREAK -> idx = ps-parse-break-continue(t, p, 1)

        tk.typ == tok.CONTINUE -> idx = ps-parse-break-continue(t, p, 0)

        ; `*` 語句起始 = break 速寫（Go stmt.go:552 parseStarBreakOrExpr）：僅當緊後 token
        ;   ∈ {NEWLINE,EOF,SEMI,RBRACE,LABEL,IDENT} 才成立，否則退回表達式陳述。
        tk.typ == tok.MUL -> idx = ps-parse-star-break(t, p)

        ; `**` 語句起始 = continue 速寫（Go stmt.go:558 parseStarStarContinue，無前探閘門）
        tk.typ == tok.STAR_STAR -> idx = ps-parse-star-star-cont(t, p)

        tk.typ == tok.LABEL -> {
            lval = tk.lit
            ps-bump(p); 消費 #N
            inner = ps-parse-stmt(t, p)
            idx = inner
            inner > 0 && ast.kind-at(t, inner) == asp.K_FOR_STATEMENT -> ast.set-slot(t, inner, 0, ast.put-str(t, lval))
        }

        tk.typ == tok.RETURN -> {
            ps-bump(p); 消費 return
            idx = ast.add(t, asp.K_RETURN_STATEMENT)
            ast.kid-add(t, idx, 0); guarded CHILD=ReturnValue 缺席→以 0 占位（否則 pre-scan 會讀到後續節點的 kid、node_of 標籤錯位）
        }

        ; `# path` 匯入（tok.USE；`#` 非 `#{` 时詞法回 USE）——此前無臂→走 expr-stmt⇒ 把路徑拆成 `/` 除法運算式。
        tk.typ == tok.USE -> idx = ps-parse-use(t, p)

        ; `!! { }` 無限循環 / `! { }` 恆假循環（stmt.go:528-540 → parseBangLoop 2577）：
        ;   僅當 bang【緊接】LBRACE 才成立，否則退回運算式陳述（`!x` 取反）。
        tk.typ == tok.BANG_BANG && ps-peek-at(p, 1) == tok.LBRACE -> idx = ps-parse-bang-loop(t, p, 1)

        tk.typ == tok.NOT && ps-peek-at(p, 1) == tok.LBRACE -> idx = ps-parse-bang-loop(t, p, 0)

        ; `(cond) { }` 前置條件循環（stmt.go:381 isCondLoopPrefix → parseCondLoopPrefix 2686）：
        ;   僅當平衡 `)` 後【立即】是 `{` 且括號內容非參數列才成立，否則退回 `(expr)` 運算式陳述。
        tk.typ == tok.LPAREN && ps-is-cond-loop-prefix(p) == 1 -> idx = ps-parse-cond-loop(t, p)

        tk.typ == tok.UNDERSCORE && ps-peek-at(p, 1) == tok.ASSIGN -> {
            ps-bump(p); 消費 _
            ps-bump(p); 消費 =
            idx = ps-parse-let(t, p, '_')
        }

        ; s64：泛型陣列接收者的方法定義 `[N]T.method = (params) { body }`
        ;   （語料：src/std/arr.no 22 處、collection/arr-stack.no、collection/link.no、
        ;    sort.no…）。對應 Go parseMethodDefinition 的「接收者為 ArrayType」形。
        ;   偏移：+0 LBRACKET / +1 尺寸（IDENT 或 INT）/ +2 RBRACKET / +3 元素型別 IDENT /
        ;   +4 DOT / +5 方法名 IDENT / +6 ASSIGN / +7 LPAREN。
        ; ⚠️ 此前無臂 ⇒ `[n]t` 被當 SliceLiteral 陳述、`t.method = (…)` 另起為普通方法定義
        ;   ⇒ 接收者型別丟失（self 變 NamedType{t}）、`n` 泛型參數缺席、且多一條幽靈
        ;   SliceLiteral 陳述（arr.no 實測 490 行差異的主體）。
        tk.typ == tok.LBRACKET && (ps-peek-at(p, 1) == tok.IDENT || ps-peek-at(p, 1) == tok.INT) && ps-peek-at(p, 2) == tok.RBRACKET && ps-peek-at(p, 3) == tok.IDENT && ps-peek-at(p, 4) == tok.DOT && ps-peek-at(p, 5) == tok.IDENT && ps-peek-at(p, 6) == tok.ASSIGN && ps-peek-at(p, 7) == tok.LPAREN -> {
            ps-bump(p); 消費 [
            sz_lit = ps-lit-at(p, 0); 尺寸 token 文字（供接收者型別字串用）
            sz = ps-parse-expr-prec(t, p, 0); 尺寸運算式（Identifier / IntegerLiteral）
            ps-expect(p, tok.RBRACKET)
            el_lit = ps-lit-at(p, 0); 元素型別名
            ps-bump(p); 消費元素型別名
            ps-bump(p); 消費 DOT
            mname = ps-lit-at(p, 0); 方法名
            ps-bump(p); 消費方法名
            ps-bump(p); 消費 ASSIGN

            ; 子先於父：elem NamedType → ArrayType（含 size、elem 兩 kid）
            ent = ast.add(t, asp.K_NAMED_TYPE)
            ast.set-slot(t, ent, 0, ast.put-str(t, el_lit))
            at = ast.add(t, asp.K_ARRAY_TYPE)
            ast.set-slot(t, at, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, at, sz)
            ast.kid-add(t, at, ent)
            rtyp = '[' + sz_lit + ']' + el_lit
            full = rtyp + '.' + mname
            idx = ps-parse-method-func(t, p, full, rtyp, at, full)
        }

        ; s65b：切片接收者的方法定義 `[]T.method = (params) { body }`——同 Go
        ;   parseArrayTypeMethodDefinition 的「`]` 緊跟 `[`」分支（decl.go:205-211）。
        ;   偏移：+0 LBRACKET / +1 RBRACKET / +2 元素型別 IDENT / +3 DOT / +4 方法名 IDENT /
        ;   +5 ASSIGN / +6 LPAREN。
        ; ⚠️ 此前無臂 ⇒ `[]` 被 primary 建成空 SliceLiteral 幽靈陳述（並把 Doc 註解搶走，
        ;   使後續 `Doc:` 掛到幽靈而非方法定義上），`t.method = (…)` 另起為普通方法定義
        ;   ⇒ 名稱丟失 `[]` 前綴、self 型別降成 NamedType{t}。語料分布：vec.no 22 處、
        ;   byte.no 12、str.no、char.no、sort.no 2…
        ; ⚠️ 不播種隱式泛型（見 ps-parse-method-func 內 gnames 段的說明）。
        tk.typ == tok.LBRACKET && ps-peek-at(p, 1) == tok.RBRACKET && ps-peek-at(p, 2) == tok.IDENT && ps-peek-at(p, 3) == tok.DOT && ps-peek-at(p, 4) == tok.IDENT && ps-peek-at(p, 5) == tok.ASSIGN && ps-peek-at(p, 6) == tok.LPAREN -> {
            ps-bump(p); 消費 [
            ps-bump(p); 消費 ]
            el_lit = ps-lit-at(p, 0); 元素型別名
            ps-bump(p); 消費元素型別名
            ps-bump(p); 消費 DOT
            mname = ps-lit-at(p, 0); 方法名
            ps-bump(p); 消費方法名
            ps-bump(p); 消費 ASSIGN

            ; 子先於父：elem NamedType → SliceType（唯一 kid）
            ent = ast.add(t, asp.K_NAMED_TYPE)
            ast.set-slot(t, ent, 0, ast.put-str(t, el_lit))
            st = ast.add(t, asp.K_SLICE_TYPE)
            ast.set-slot(t, st, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, st, ent)
            rtyp = '[]' + el_lit
            full = rtyp + '.' + mname
            idx = ps-parse-method-func(t, p, full, rtyp, st, full)
        }

        tk.typ == tok.IDENT || tk.typ == tok.MATCH -> {
            name = tk.lit
            nxt_typ = ps-peek-at(p, 1)
            nxt2_typ = ps-peek-at(p, 2)

            ; ⚠️ 用 `handled` 旗標而非裸 `-> ...` 預設臂：實測同块多臂時，尾
            ;   臂 `-> idx = expr` 會被當作**尾隨無條件陳述**執行，覆寫前面
            ;   ASSIGN 臂已經算好的 idx（表現為 `x = 1` dump 出 `Program{}`）。
            ;   原 `-> {}` 不傷是因為它是 no-op。
            handled = 0
            nxt_typ == tok.ASSIGN -> {

                ; s53：頂層型別別名分派（Go stmt.go:151-170：isFnDef → isFnTypeAlias → looksLikeEqAlias → let）。
                ;   FD 判定仍由原 ps-is-func 臂兜后；别名形在 ps-is-func 场景必回 false，故先判别名。
                ;   ⚠️ 全臂带守卫（aliased == 0 &&）——同块尾裸 `->` 臂会被当尾随无条件陈述执行（见 handled 守则），
                ;   若不守卫生成别名后默认臂会重消费 token 并覆写 idx。
                aliased = 0
                ; s8o：FFI 宣告 `#{c} \n name = (params) (results)` ⇒ ExternStatement。
                ;   守衛 ffiLang（注解塊擷取的裸 FFI 語言鍵）非空白 且 形狀為 `name = (...)`。
                ffiLang != '' && ps-peek-at(p, 2) == tok.LPAREN -> {
                    idx = ps-parse-extern-decl(t, p, name, ffiLang)
                    aliased = 1
                }
                ; ⚠️ Step 2（Go type.go:406-421 isFunctionTypeAlias 的內容驗證）：
                ;   形狀檢查（ps-fn-alias-shape）只確認括號結構，**不看成員**，
                ;   會把 `a = (1 + 2)` 這種括號表達式誤判成 `name = (params)` 函式
                ;   型別別名（t7 實測：產出 `TypeAlias{a, fn()}` 而 oracle 是 let）。
                ;   Go 用試解析 parseFunctionType + 錯誤計數判定；本解析器無錯誤
                ;   計數，改用廉價等價判據：參數群首 token 必須是「型別起始」
                ;   （IDENT / `?` / `[` / `)` 空群），字面量（INT…）與運算子即否。
                falias2 = 0
                p.fn == '' && ps-peek-at(p, 2) == tok.LPAREN -> {
                    f3 = ps-peek-at(p, 3)
                    f3 == tok.IDENT -> falias2 = 1
                    f3 == tok.QUESTION -> falias2 = 1
                    f3 == tok.LBRACKET -> falias2 = 1
                    f3 == tok.RPAREN -> falias2 = 1
                }
                p.fn == '' && ps-peek-at(p, 2) == tok.LPAREN && falias2 == 1 && ps-fn-alias-shape(p) == 1 && ps-fn-alias-inner-ok(p) == 1 -> {
                    idx = ps-parse-fn-type-alias(t, p, name)
                    aliased = 1
                }
                aliased == 0 && p.fn == '' && ps-peek-at(p, 2) != tok.LPAREN && ps-looks-eq-alias(p) == 1 -> {
                    idx = ps-parse-type-alias(t, p, name)
                    aliased = 1
                }
                aliased == 0 -> {
                    ps-bump(p); 消費 IDENT
                    ps-bump(p); 消費 ASSIGN
                    a2 = ps-peek-token(p)
                    a2.typ == tok.LPAREN -> {

                        ; `= (...) {` 才是函式定義；`= (expr)` 是括號運算式（見 ps-is-func）
                        ps-is-func(p) == 1 -> idx = ps-parse-func(t, p, name)

                        -> idx = ps-parse-let(t, p, name)
                    }

                    -> idx = ps-parse-let(t, p, name)
                }
                handled = 1
            }

            ; ?= 解箱賦值（UnwrapAssignStatement）：`name ?= expr`（Identifier LHS 形）
            ;   對應 Go parseUnwrapAssignStatement（stmt.go:964）：消費 IDENT + `?=`、
            ;   以 LOWEST 解 RHS 為 Value；建 K_UNWRAP_ASSIGN_STATEMENT，s0=name、kid0=Value。
            ;   Target 形（`a.b ?= v` / `a[i] ?= v`，expr.go:608）本片不處理——語料尚無。
            ;   renderer（asp.no kind 70，num=5）已就緒：HDR+SCALAR(name)+COMMENTS+CHILD(Target)+CHILD(Value)；
            ;   本片只建 Identifier LHS，故 kid0 直接放 Value（Target 為 nil，dump 視覺一致）。
            nxt_typ == tok.QUESTION_ASSIGN -> {
                ps-bump(p); 消費 IDENT（name）
                ps-bump(p); 消費 ?=
                vcSave = p.valCtx; s67：?= RHS ⇒ 值語境（對齊 ps-parse-let，IndexExpression RHS 需要）
                p.valCtx = 1
                val = ps-parse-expr(t, p)
                p.valCtx = vcSave
                idx = ast.add(t, asp.K_UNWRAP_ASSIGN_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ; renderer（asp.no kind 70）預期雙 CHILD [Target, Value]；Identifier LHS 無 Target，
                ; 故先佔位 nil（kid-add(0)）再放 Value，避免第二個 CHILD op 越界讀到髒 node id。
                ast.kid-add(t, idx, 0); Target 佔位（nil）
                ast.kid-add(t, idx, val); Value
                handled = 1
            }

            ; 明示型別標註：`name TYPE = expr`（第一片只認 NamedType 形式的標註）
            nxt_typ == tok.IDENT && nxt2_typ == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT

                ; 先取型別名（仍在 IDENT 之后的位置），然后手动前进到 ASSIGN 之后
                tt = ps-peek-token(p)
                tn = tt.lit
                ps-bump(p); 消費型別名
                ps-bump(p); 消費 ASSIGN
                vcSave = p.valCtx; s67：明示型別標註 `name T = expr` 賦值 RHS ⇒ 值語境
                p.valCtx = 1
                val = ps-parse-expr(t, p)
                p.valCtx = vcSave
                ; s8q：明示型別 let 亦走 Go parseLetStatement（stmt.go:1242）的統一同位規則——
                ;   `x T = A -> B` 整條鏈是 value（包成 IfExpression，型別標註仍保留）。守衛同
                ;   ps-parse-let（活 ps-peek==RARROW、非 match 臂內）。語料無此形，此舉為規則完備。
                val > 0 && p.inMatch == 0 && ps-peek(p) == tok.RARROW -> val = ps-mk-standalone-if(t, p, val)
                typ = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, typ, 0, ast.put-str(t, tn))

                ; 明示標註：不設 inferred（slot1 留 0 → dump 不印 inferred: true）
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, typ)
                ast.kid-add(t, idx, val)
                ps-reg-let(t, p, name, typ); s51：明示宣告也登記 varType+declared（Go parseLet 尾部）
                ps-mark-ifd(p, name); s8f：含值 let ⇒ IsFuncDeclared（Go stmt.go:1599）
                handled = 1
            }

            ; 定長陣列標註：`name [N]T = [e1, …, eN]`（本片只認 `[ INT ] IDENT ASSIGN` 單行形）
            ;   偏移：+0 IDENT name / +1 LBRACKET / +2 INT / +3 RBRACKET / +4 IDENT elem / +5 ASSIGN
            ;   +2 必須是 INT（尺寸字面量）；若是 IDENT ⇒ 是 `[K]V` map 標註（見下臂）
            nxt_typ == tok.LBRACKET && ps-peek-at(p, 2) == tok.INT && ps-peek-at(p, 3) == tok.RBRACKET && ps-peek-at(p, 5) == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                sz = ps-parse-expr(t, p); 尺寸運算式（IntegerLiteral）
                ps-expect(p, tok.RBRACKET)
                et = ps-peek-token(p)
                en = et.lit
                ps-bump(p); 消費 elem 型別名
                ps-expect(p, tok.ASSIGN)

                ; RHS 為 [..] 才走陣列字面量上下文（復刻 Go stmt.go:1333-1356：
                ;   只有 stmt.Value 是 SliceLiteral 時才轉 ArrayLiteral）；其餘 RHS
                ;   （呼叫／識別字／點開頭的方法呼叫…）一律走普通運算式。
                ; ⚠️ 此處曾無條件呼叫 ps-parse-arr-lit ⇒ `iv [12]byte = .gen-iv()`
                ;   的 RHS 被強行當陣列字面量：ps-expect(LBRACKET) 失敗後，元素迴圈
                ;   從當前 token 起把後續全部陳述當「元素」吞掉（直到 EOF），方法定義行
                ;   被卷成 AssignExpression，其 RHS 又在運算式解析器裡纏出超深
                ;   GroupedExpression 鏈 ⇒ dump 二次方縮排 + GB 級輸出 ⇒ 掛起。
                ;   實證：src/std/net/net.no:571（aes-cbc/tls 兩檔同源）；詳見
                ;   docs/design/nolang-selfhost.md §5.3.3。
                ps-skip-trivia(p)
                ps-peek(p) == tok.LBRACKET -> al = ps-parse-arr-lit(t, p, sz)

                -> {
                    vcSave = p.valCtx; s67：定長陣列標註 `name [N]T = expr` 賦值 RHS ⇒ 值語境
                    p.valCtx = 1
                    al = ps-parse-expr(t, p)
                    p.valCtx = vcSave
                }

                ; 子先於父：elem NamedType → ArrayType（含 size、elem 兩 kid）→ LetStatement
                ntyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ntyp, 0, ast.put-str(t, en))
                at = ast.add(t, asp.K_ARRAY_TYPE)
                ast.set-slot(t, at, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
                ast.kid-add(t, at, sz)
                ast.kid-add(t, at, ntyp)
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, at)
                ast.kid-add(t, idx, al)
                ps-reg-let(t, p, name, at); s51 登記
                ps-mark-ifd(p, name); s8f：含值 let ⇒ IsFuncDeclared（Go stmt.go:1599）
                handled = 1
            }

            ; 推論元素型別的定長陣列：`name [N] = [e1, …, eN]`（`]` 後直接 `=`、無元素型別名）
            ;   偏移：+0 IDENT name / +1 LBRACKET / +2 INT / +3 RBRACKET / +4 ASSIGN / +5 LBRACKET
            ;   與明示臂（+4 IDENT elem / +5 ASSIGN）互斥：此臂要求 +4==ASSIGN 且 +5==LBRACKET。
            ;   此前無臂 → `name [N]` 被誤解析為 IndexExpression、`= [..]` 成 AssignExpression。
            ;   元素型別恆為 i64（Go stmt.go:957：省略元素型別時補 NamedType{i64, inferred}，
            ;   【不】依首元素推論）；ArrayType.IsInferred=false（formatter 必須印回 [N]）。
            ;   僅 Size>0 才把 RHS 轉 ArrayLiteral（Go stmt.go:1210）；Size==0 保留 SliceLiteral。
            nxt_typ == tok.LBRACKET && ps-peek-at(p, 2) == tok.INT && ps-peek-at(p, 3) == tok.RBRACKET && ps-peek-at(p, 4) == tok.ASSIGN && ps-peek-at(p, 5) == tok.LBRACKET -> {
                sz_lit = ps-lit-at(p, 2)
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                sz = ps-parse-expr(t, p); 尺寸運算式（IntegerLiteral）
                ps-expect(p, tok.RBRACKET)
                ps-expect(p, tok.ASSIGN)

                ; 子先於父：elem NamedType(i64, inferred) → ArrayType（含 size、elem 兩 kid）
                ntyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ntyp, 0, ast.put-str(t, 'i64'))
                ast.set-slot(t, ntyp, 1, ast.put-str(t, 'true')); i64 元素 → inferred: true
                at = ast.add(t, asp.K_ARRAY_TYPE)
                ast.set-slot(t, at, 0, ast.put-str(t, 'false')); 明示 [N] → 不 inferred
                ast.kid-add(t, at, sz)
                ast.kid-add(t, at, ntyp)

                ; Size>0：RHS [..] 直接建 ArrayLiteral；Size==0：保留 SliceLiteral（走 primary expr）
                val = 0
                sz_lit != '0' -> val = ps-parse-arr-lit(t, p, sz)
                sz_lit == '0' -> {
                    ps-skip-trivia(p)
                    vcSave = p.valCtx; s67：推論元素型別定長陣列 `name [N] = expr` 賦值 RHS ⇒ 值語境
                    p.valCtx = 1
                    val = ps-parse-expr(t, p)
                    p.valCtx = vcSave
                }
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, at)
                ast.kid-add(t, idx, val)
                ps-reg-let(t, p, name, at); s51 登記
                ps-mark-ifd(p, name); s8f：含值 let ⇒ IsFuncDeclared（Go stmt.go:1599）
                handled = 1
            }

            ; Map 標註：`name [K]V = { k1: v1, … }`
            ;   s8u：泛化——V【經 ps-parse-type 遞迴】而非單 IDENT，覆蓋 `[str][]i64`
            ;   （V 為 SliceType）等複合型別（鏡 ps-parse-type 的 [K]V 臂 6407、Go type.go:835-849）。
            ;   鑑別同 ps-parse-type：`[ K ]` 且 K 為內建型別名 ⇒ MapType（非 [N]T 陣列）。
            ;   ⚠️ 須確有 `=`（ps-is-map-assign-let）——裸 map 宣告 `m1 [str]i64`（無 `=`）不得誤入本臂
            ;   （鏡 s8u 前舊守衛 +5==ASSIGN；否則裸宣告被吞、後隨陳述錯位，nested-container-clone.no 實測回歸）。
            ;   型別導向值解析（鏡 Go parseLetStatement stmt.go:1221）：RHS 起於 { ⇒ MapLiteral，
            ;   否則普通運算式（`m [K]V = f()`）。舊缺陷：V 非單 IDENT（如 `[]i64`）⇒ 本臂前綴守衛
            ;   +4==IDENT 失敗 ⇒ 落到通用型別 let，`{ }` 被 ps-is-struct-lit 誤判 StructLiteral。
            nxt_typ == tok.LBRACKET && ps-is-map-assign-let(p) == 1 -> {
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                kt = ps-peek-token(p)
                kn = kt.lit
                ps-bump(p); 消費 key 型別名
                ps-expect(p, tok.RBRACKET)
                vty = ps-parse-type(t, p); value 型別（可複合，遞迴）
                ps-expect(p, tok.ASSIGN)

                ; 子先於父：key NamedType + value 型別 → MapType（共用節點傳给 map 字面量）
                ktyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ktyp, 0, ast.put-str(t, kn))
                mt = ast.add(t, asp.K_MAP_TYPE)
                ast.set-slot(t, mt, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
                ast.kid-add(t, mt, ktyp)
                ast.kid-add(t, mt, vty)

                ; 型別導向：{ ⇒ MapLiteral；否則普通 expr（valCtx=1）
                ml = 0
                ps-skip-trivia(p)
                ps-peek(p) == tok.LBRACE -> ml = ps-parse-map-lit(t, p, mt)
                -> {
                    vcSave = p.valCtx
                    p.valCtx = 1
                    ml = ps-parse-expr(t, p)
                    p.valCtx = vcSave
                }
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, mt)
                ast.kid-add(t, idx, ml)
                ps-reg-let(t, p, name, mt); s51 登記
                ps-mark-ifd(p, name); s8f：含值 let ⇒ IsFuncDeclared（Go stmt.go:1599）
                handled = 1
            }

            ; 切片型別標註：`name []T = [e1, …]`（單行形，T 為單一 IDENT）
            ;   偏移：+0 IDENT name / +1 LBRACKET / +2 RBRACKET（空括）/ +3 IDENT elem / +4 ASSIGN
            ;   舆 `[N]T`（+2 INT）/`[K]V`（+2 IDENT）互斥：此臂要求 +2 為 RBRACKET
            nxt_typ == tok.LBRACKET && ps-peek-at(p, 2) == tok.RBRACKET && ps-peek-at(p, 3) == tok.IDENT && ps-peek-at(p, 4) == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                ps-bump(p); 消費 RBRACKET
                et = ps-peek-token(p)
                en = et.lit
                ps-bump(p); 消費 elem 型別名
                ps-expect(p, tok.ASSIGN)

                ; RHS `[..]` 經 primary 自然建 SliceLiteral（含空 `[]`）
                ps-skip-trivia(p)
                vcSave = p.valCtx; s67：切片型別標註 `name []T = expr` 賦值 RHS ⇒ 值語境
                p.valCtx = 1
                val = ps-parse-expr(t, p)
                p.valCtx = vcSave
                ntyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ntyp, 0, ast.put-str(t, en))
                styp = ast.add(t, asp.K_SLICE_TYPE)
                ast.set-slot(t, styp, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
                ast.kid-add(t, styp, ntyp)
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, styp)
                ast.kid-add(t, idx, val)
                ps-reg-let(t, p, name, styp); s51 登記
                ps-mark-ifd(p, name); s8f：含值 let ⇒ IsFuncDeclared（Go stmt.go:1599）
                handled = 1
            }

            ; Nullable 型別標註：`name ?T = expr`（? 後接命名/切片/巢狀可為空型別）⇒ LetStatement{type: NullableType, value}。
            ;   分派守衛 `nxt_typ == QUESTION`：`IDENT ?` 於陳述層只可能是可為空標註（傳導 `?=` 是 QUESTION_ASSIGN 另一 token）。
            nxt_typ == tok.QUESTION -> {
                ps-bump(p); 消費 IDENT name
                nltyp = ps-parse-type(t, p); 消費 ? 與內層型別

                ; s7 續 G：`name ?T` 裸宣告（無 `=`）⇒ LetStatement{type, value:0 佔位}。
                ;   ⚠️ 舊缺陷：無條件 ps-expect(ASSIGN) 失敗不退 ⇒ 後隨陳述（如
                ;   `x: { … }`）被 ps-parse-expr 吃成 RHS，且 valCtx=1 污染 MatchArm
                ;   valueCtx（實測 match-test.no）。鏡像 ps-parse-typedecl 雙形口徑。
                ; s8t：⚠️【不】在此 ps-skip-trivia——舊行為會 destructive 吞掉型別後
                ;   緊接的換行＋行前註解（如 `x ?i64` 後另起一行的 `; cmt`），令該註解
                ;   無法成為下一陳述的 Doc（實測 match-test.no:11 `; 直接->是else` 丟失）。
                ;   鏡像 ps-parse-typedecl 含值/裸雙形口徑：直接【非破壞性】ps-peek 判 `=`
                ;   （同列 `name ?T = v` 時 `=` 緊接型別，ps-peek 即見 ASSIGN；裸形見 NEWLINE⇒不進此支）。
                nlval = 0
                nlAsg = 0; s8f：是否有 `=`（含值 let 才記 IsFuncDeclared，裸宣告不記）
                ps-peek(p) == tok.ASSIGN -> {
                    ps-bump(p); 消費 =
                    ps-skip-trivia(p)
                    vcSave = p.valCtx; s67：可為空型別標註 `name ?T = expr` 賦值 RHS ⇒ 值語境
                    p.valCtx = 1
                    nlval = ps-parse-expr(t, p)
                    p.valCtx = vcSave
                    nlAsg = 1
                }
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, nltyp)
                ast.kid-add(t, idx, nlval); guarded CHILD=Value 缺席→0 佔位（dump 印 `value: `）
                ps-reg-let(t, p, name, nltyp); s51 登記
                nlAsg == 1 -> ps-mark-ifd(p, name); s8f：含值 let ⇒ IsFuncDeclared（Go stmt.go:1599）
                handled = 1
            }

            ; 多重指派：`a, b, … = expr` / `a[i], b = expr`（RHS 常為多返回值呼叫）⇒ MultiAssignStatement{targets: N}。
            ; kid 序依 dump 源碼序：先 targets（KIDS、count slot0=N）、後 value（guarded CHILD）。
            ; ⚠️ slot0=targets 顯示數（kvc NON-ZERO，未設會印空 `targets: `）；overflow slot1 留''。
            ; ⚠️ 父後建：先解析完所有 target/value 子樹，再 add 父、依序 kid-add（共享 kids 游標）。
            ;   守衛 ps-is-multi-assign-start：首目標為裸 IDENT(`x,`) 或索引(`a[i],`) 後緊接 COMMA。
            ps-is-multi-assign-start(p) == 1 -> {
                maTargets []i64 = with-cap(4)
                maT0 = ps-parse-expr-prec(t, p, 0); 首目標鏡 Go firstExpr（parseExpressionStatement:1919）：完整表達式解析；`=` 吸收在本形不可見（IDENT/索引後必為 COMMA 才進入）
                maT0 > 0 -> maTargets.push(maT0)
                more = 1
                (more == 1) {
                    ps-peek(p) == tok.COMMA -> {
                        ps-bump(p); 消費 COMMA
                        ps-skip-trivia(p)
                        maTn = ps-parse-assign-target(t, p)
                        maTn > 0 -> maTargets.push(maTn)
                    }
                    ps-peek(p) != tok.COMMA -> more = 0
                }
                ps-skip-trivia(p)
                ps-expect(p, tok.ASSIGN)
                vcSave = p.valCtx; s67：多重指派 `a, b = expr` 賦值 RHS ⇒ 值語境
                p.valCtx = 1
                maVal = ps-parse-expr(t, p)
                p.valCtx = vcSave
                idx = ast.add(t, asp.K_MULTI_ASSIGN_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, maTargets.len().to-str()))
                ast.set-count(t, idx, 0, maTargets.len())
                maK = 0
                (maK < maTargets.len()) {
                    ast.kid-add(t, idx, maTargets[maK])

                    #{overflow=wrap}
                    maK = maK + 1
                }
                ast.kid-add(t, idx, maVal); guarded CHILD=Value（缺席以 0 佔位）
                handled = 1
            }

            ; 其他 IDENT 開頭的句法（呼叫語、運算子等）一律走運算式陳述，
            ;   不先消費 IDENT（否则會把 `f(1,2)` 拆成兩個 token）。
            ; 兵列迭代（bare range-for）：`var <- range-or-array [:] { body }`（不使用 `for` 關鍵字）。
            ;   分派守衛 `nxt_typ == ARROW`：`IDENT <-` 於述層即迭代表達式（對應 Go parseForStatement bare 分支）。
            ;   s7t3：將本陳述捕獲的 idxOut 暫存到 p.aoVal（range-loop body 的內層
            ;   ps-parse-stmt 會讀到並降糖——Go 對 range body 內的 safe-index 也降糖）。
            nxt_typ == tok.ARROW -> {
                idxOut != '' -> {
                    p.aoVal = idxOut
                    p.aoTy = idxOutTy
                }
                idx = ps-parse-for(t, p, name)
                handled = 1
            }

            ; 方法定義：`recvType.method = (params) [ (results) ] { body }`（僅函式形）
            ;   對應 Go parseMethodDefinition（stmt.go:292–301）。偏移：+0 recv IDENT / +1 DOT /
            ;   +2 method IDENT / +3 ASSIGN / +4 LPAREN。`obj.field = value` 因 +4 非 LPAREN、
            ;   或 `= (expr)` 非 `(...) {`（ps-is-func==0）而回退（不誤吞，退回運算式陳述）。
            nxt_typ == tok.DOT && nxt2_typ == tok.IDENT && ps-peek-at(p, 3) == tok.ASSIGN && ps-peek-at(p, 4) == tok.LPAREN -> {
                recvType = name
                methodName = ps-lit-at(p, 2)
                fullName = recvType + '.' + methodName
                savePos = p.pos
                ps-bump(p); 消費 recv IDENT
                ps-bump(p); 消費 DOT
                ps-bump(p); 消費 method IDENT
                ps-bump(p); 消費 ASSIGN
                isf = ps-is-func(p)
                isf == 1 -> {
                    idx = ps-parse-method-func(t, p, fullName, recvType, 0, methodName)
                    handled = 1
                }
                isf == 0 -> p.pos = savePos
            }

            ; 介面定義：`name { m(...) }` / `name { t.m(...) (res bool) }`（陳述位置）
            ;   對應 Go stmt.go:288-297 classifyBlock()==blockIface。
            ;   ⚠️ 必須排在【結構體定義】之前：兩者的守衛都要求 peek==LBRACE，
            ;   但區塊首成員形狀互斥（`m(` vs `field TYPE`）⇒ 不會互相誤判。
            ;   ⚠️ 守衛 ps-is-iface-def 已排除標籤列舉形（`ok(v t),` 等）與 implements
            ;   繼承清單（`a, b {`）⇒ 零回退。
            handled == 0 && nxt_typ == tok.LBRACE && ps-is-iface-def(p) == 1 -> {
                idx = ps-parse-iface-def(t, p, name)
                handled = 1
            }

            ; s8y 規則C：介面繼承清單形 `name iface1, iface2 { m(...) }`（鏡 Go stmt.go:65-113）。
            ;   nxt_typ==IDENT ⇒ 必須排在【複合型明示宣告 typedecl】之前（Go 中 implements 掃描
            ;   先於 parseLetStatement；否則 `db enter` 被 typedecl 解成 `name TYPE` 宣告）。
            ;   守衛只放行【介面內容】形（內容首 token IDENT+( /.)；欄位形語料無見⇒不回退 struct 路）。
            ;   ⚠️ 須先於 ps-is-multi-assign-start 之外無衝突：本形 +1==IDENT（非 COMMA/LBRACKET）
            ;   ⇒ 多重指派守衛不觸發；但 `a, b = …` 的 nxt_typ==COMMA 亦不進本臂。
            handled == 0 && nxt_typ == tok.IDENT && ps-is-iface-inherits(p) == 1 -> {
                idx = ps-parse-iface-def(t, p, name)
                handled = 1
            }

            ; 結構體定義：`name { field TYPE ... }`（陳述位置，peek==LBRACE 且分類器認可）
            ;   對應 Go stmt.go:277 classifyBlock()==blockStruct。僅在 ps-is-struct-def 回 1 時走此路；
            ;   枚舉/介面/實作清單/限定型別等一律回退原運算式陳述路徑（零回歸）。
            nxt_typ == tok.LBRACE && ps-is-struct-def(p) == 1 -> {
                idx = ps-parse-struct-def(t, p, name)
                handled = 1
            }

            ; 枚舉定義：裸 `name { red, green, blue }`（回 1）/ 標籤 `name { ok(v t), fail }`（回 2）
            ;   對應 Go stmt.go:279–283 classifyBlock() ∈ {blockEnum, blockTaggedEnum}。
            ;   守衛 ps-is-enum-def 保守識別（欄位形 `n i64`、介面形 `m() (r t)`、括號全無裸變體 ⇒ 回 0 交回原路）。
            handled == 0 && nxt_typ == tok.LBRACE && ps-is-enum-def(p) > 0 -> {
                edk = ps-is-enum-def(p)
                idx = ps-parse-enum-def(t, p, name, edk)
                handled = 1
            }

            ; 複合型明示宣告（限定名/巢狀）：`name TYPE [= value]`，TYPE 為各特化含值臂未覆蓋的
            ;   限定 NamedType（`a.b`）/巢狀 SliceType・ArrayType（`[][]T`、`[N][]T`）。上方各特化臂
            ;   皆要求特定偏移的 `=`，此處 handled==0 表示都未命中⇒可能為複合型宣告或索引運算式；
            ;   ps-parse-typedecl 只在【真宣告】(型別後為 `=` 或陳述邊界)回 >0，其餘還原交由下方 expr-stmt。
            ;   守衛限 nxt_typ∈{IDENT,LBRACKET}（QUESTION 由上方可為空臂；COMMA/ARROW/DOT/LBRACE 非型別）。
            handled == 0 && (nxt_typ == tok.LBRACKET || nxt_typ == tok.IDENT) -> {
                td = ps-parse-typedecl(t, p, name)
                td > 0 -> {
                    idx = td
                    handled = 1
                }
            }

            ; s8y 規則A：裸型名陳述（鏡 Go stmt.go:346-356）：IDENT 且 peek ∈ {NEWLINE, SEMICOLON}
            ;   且 literal ∈ isTypeName 閉集 ⇒ 走 parseLetStatement。Go 內 typeToken 回落至名 token
            ;   本身（stmt.go:1153-1155）⇒ stmt.Type = buildType(name)（NamedType、非 inferred）；
            ;   current 抵達 NEWLINE 落入裸分支（1187-1196）：setVarType 後 early return——
            ;   Value=nil、【不】觸及 SetFuncDeclared。典型觸發：後綴_cast_ `av u64 = (expr) u64`
            ;   尾部的 `u64` 独行成句（bigint.no 實測原被解為 ExpressionStatement）。
            handled == 0 && (nxt_typ == tok.NEWLINE || nxt_typ == tok.SEMICOLON) && ps-is-type-name-literal(name) == 1 -> {
                ps-bump(p); 消費 IDENT（名與型同一 token，鏡 Go typeToken 回落）
                laTy = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, laTy, 0, ast.put-str(t, name))
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, laTy); guarded CHILD=Type
                ast.kid-add(t, idx, 0); guarded CHILD=Value 缺席→0 佔位（dump 印 `value: `）
                ps-reg-let(t, p, name, laTy); 鏡裸分支：setVarType+declaredLocals；early-return 跳過 SetFuncDeclared ⇒ 不 ps-mark-ifd
                handled = 1
            }
            handled == 0 -> idx = ps-parse-expr-stmt(t, p)
        }

        ; s57：`N * { }` / `-N * { }` 前置計數循環（stmt.go:395 INT/SUB 臂：isCountLoopPrefix 過 ⇒
        ;   parseCountLoopPrefix，否則 parseExpressionStatement）。閘門不過⇒原樣落預設 expr-stmt 臂。
        (tk.typ == tok.INT || tk.typ == tok.SUB) && s57-count-prefix-p(p) > 0 -> idx = s57-parse-count-loop-prefix(t, p)

        -> idx = ps-parse-expr-stmt(t, p)
    }

    ; s7t：尾隨注解掃描——`stmt #{key=val}` 同行尾部的 `#{...}`（Go 尾隨註解掛到前一陳述）。
    ;   僅在 idxOut 尚空時掃（前導已有 index-out 則不覆蓋）；只捕獲 index-out/overflow。
    idxOut == '' && ps-peek(p) == tok.HASH_LBRACE -> {
        tEnd = p.toks[p.pos]
        tEnd.ln == stLn -> {
            ps-bump(p); 消費 #{
            depth = 1
            expect_key = true
            (depth > 0 && p.pos < p.toks.len()) {
                tk = ps-peek-token(p)
                {
                    tk.typ == tok.LBRACE -> {
                        depth = depth + 1
                        expect_key = true
                        ps-bump(p)
                    }
                    tk.typ == tok.RBRACE -> {
                        depth = depth - 1
                        ps-bump(p)
                    }
                    expect_key && tk.typ == tok.IDENT -> {
                        kn = tk.lit
                        ps-bump(p); 消費鍵名
                        expect_key = false
                        ps-peek(p) == tok.ASSIGN -> {
                            ps-bump(p); 消費 =
                            vt = ps-peek-token(p)
                            kn == 'overflow' && (vt.typ == tok.IDENT || vt.typ == tok.STRING) -> ovf = ps-normalize-overflow(vt.lit)
                            kn == 'index-out' && (vt.typ == tok.IDENT || vt.typ == tok.INT || vt.typ == tok.FLOAT || vt.typ == tok.STRING || vt.typ == tok.TRUE || vt.typ == tok.FALSE) -> {
                                idxOut = vt.lit
                                idxOutTy = vt.typ
                            }
                        }
                    }
                    tk.typ == tok.COMMA && depth == 1 -> {
                        expect_key = true
                        ps-bump(p)
                    }
                    -> ps-bump(p)
                }
            }
            ps-skip-trivia(p)
        }
    }

    ovf != '' -> ps-apply-overflow(t, idx, ovf)
    idxOut != '' -> idx = ps-apply-index-out(t, p, idx, idxOut, idxOutTy, stLn, stCl, p.aeLn, p.aeCl)

    ; s52：`#{buildin}` 標記僅對 FunctionDefinition/TaggedEnumDefinition 生效（其餘 kind 由 helper 忽略）
    bs == 1 -> ps-apply-builtin(t, idx, bs, bn)
    idx
}

; ps-parse-expr-stmt：運算式陳述 `42`，並復刻 Go parseExpressionStatement 的
;   **獨立 if-then desugar**（`cond -> body` / wildcard `-> body`，無外層 `{ }`）。
;   Go 在陳述層看到 `expr` 後紧跟 `->` 就把整條包成 IfExpression{cond,inline-body,alt}；
;   行首即為 `->` 時 cond 是 wildcard 標記 IntegerLiteral{value:1}（ps-mk-true，無 raw）。
;   ⚠️ 檢查 `->` 用【活】ps-peek（不跳 trivia）——對齊 Go 只看 currentToken==RARROW，
;     `a \n -> b`（arrow 換行）不構成獨立 if，`-> b` 之後另起為 wildcard 陳述。
ps-parse-expr-stmt = (t ast, p psst) (idx i64) {
    idx = 0

    ; 裸 `_` 陳述：對齊 Go 把 `_` 當空運算式（dump 印 `ExpressionStatement{nil}`）。
    ;   消費 `_` 並產生一個無子節點的 ExpressionStatement（kid0=0 占位，避免 dumper 把
    ;   後續節點誤讀成首子節點）。僅在陳述位（非 `_ =` 指派、非型樣位）觸發——
    ;   `_ = x` 由 ps-parse-stmt 提前消費，`_` 型樣由 ps-parse-match 直接消費，皆不會落到此。
    ;   ⚠️ 修復 match 裸 `-> _` 臂：原 ps-parse-expr 回 0 且不消費 `_` ⇒ `_` 殘留被
    ;   下一輪臂迴圈當成幽靈 wildcard 型樣臂（SurfaceMatch 多出一臂）。
    ps-peek(p) == tok.UNDERSCORE -> {
        ps-bump(p); 消費 _
        idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
        ast.kid-add(t, idx, 0); guarded：空運算式（對齊 Go `ExpressionStatement{nil}`）
        return
    }

    ; (A) wildcard 獨立 if：行首 `-> body`
    ps-peek(p) == tok.RARROW -> {
        cond = ps-mk-true(t)
        ie = ps-mk-standalone-if(t, p, cond)
        idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
        ast.kid-add(t, idx, ie)
        return
    }
    e = ps-parse-expr(t, p)
    e > 0 -> {

        ; (B) `cond -> body`：運算式 e 之後同位即 `->` ⇒ 獨立 if-then
        ;   ⚠️ Go parseExpressionStatement 回的是 ExpressionStatement{IfExpression}——
        ;     standalone IfExpression 需包一層 ExpressionStatement 作為陳述。
        ps-peek(p) == tok.RARROW -> {
            ie = ps-mk-standalone-if(t, p, e)
            idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
            ast.kid-add(t, idx, ie)
            return
        }
        idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
        ast.kid-add(t, idx, e)
    }
    idx
}

; ps-parse-expr：解析一個運算式（預設最低優先級）
ps-parse-expr = (t ast, p psst) (idx i64) {
    idx = ps-parse-expr-prec(t, p, 0)
}

; ps-op-prec：中綴 token 型別 → 優先級（照抄 src/parser/expr.go 的 precedences map）。
;   LOWEST=0 / COMMA=1 / CONDITIONAL=2 / LOGICAL_OR=3 / LOGICAL_AND=4 /
;   EQUALS=5 / LESSGREATER=6 / SUM=7 / PRODUCT=8 / PREFIX=9 / CALL=10。
;   回 0 = 不是中綴運算子（含 COMMA/QUESTION/AS/LPAREN──它倆在 Go 裡進這張表
;   但不在 infixOperators 集合，這裡一視同仁不作為二元運算子處理）。
; ⚠️ Go 表的 quirks 必須復刻：SHL/SHR/AND 是 PRODUCT(8)；OR/XOR 是 SUM(7)。
ps-op-prec = (typ i64) (r i64) {
    r = 0
    {
        typ == tok.LOR -> r = 3

        typ == tok.LAND -> r = 4

        typ == tok.EQUALS -> r = 5

        typ == tok.NOT_EQUALS -> r = 5

        typ == tok.LESS -> r = 6

        typ == tok.LESS_EQUALS -> r = 6

        typ == tok.GREATER -> r = 6

        typ == tok.GREATER_EQUALS -> r = 6

        typ == tok.OR -> r = 7

        typ == tok.XOR -> r = 7

        typ == tok.ADD -> r = 7

        typ == tok.SUB -> r = 7

        typ == tok.SHL -> r = 8

        typ == tok.SHR -> r = 8

        typ == tok.AND -> r = 8

        typ == tok.MUL -> r = 8

        typ == tok.QUO -> r = 8

        typ == tok.MOD -> r = 8

        -> {
        }
    }
}

; ps-int-lit-value：復刻 Go parseIntegerLiteral 的 value 計算（expr.go:652-688）。
;   規則：`0x/0X` 前綴⇒ base16，否則 base10（Go 用 base=0 自動偵測僅限 0x 形）。
;   折疊低 64 位並套 overflow=wrap ⇒ 自動得 int64(uval) 的兩倍補數語意（如 2^64-1⇒-1）；
;   若數值超出 u64（i128/u128 範圍）⇒ value=0（Go 走 isBareIntToken 分支保留 Raw 文字）。
;   僅回傳十進位字串（對齊 dumper 的 `%d`）；Raw 仍由呼叫端直接取 token 文字。
ps-int-lit-value = (raw str) (out str) {
    len = raw.len-bytes()
    len == 0 -> {
        out = '0'
        return
    }

    ; 偵測 base 與其實位元起始（跳過 `0x`/`0X` 前綴）
    start = 0
    base = 10
    b0-opt = raw.byte(0)
    b0 = b0-opt: {
        ok -> it
        -> 0
    }
    b1-opt = raw.byte(1)
    b1 = b1-opt: {
        ok -> it
        -> 0
    }
    len > 2 && b0 == 48 && (b1 == 120 || b1 == 88) -> {
        base = 16
        start = 2
    }

    ; 跳過前導 0，定位有效首位（全 0 ⇒ s=len ⇒ sig=0 ⇒ 折疊得 0）
    s = start

    #{overflow=wrap}
    (s < len) {
        lead-opt = raw.byte(s)
        lead = lead-opt: {
            ok -> it
            -> 0
        }
        lead != 48 -> break
        s = s + 1
    }

    #{overflow=wrap}
    sig = len - s

    ; 是否超出 u64：hex 只要有效位 >16 即超（16 個 F 恰為 2^64-1）；
    ;   decimal 有效位 >20 即超，==20 需與 '18446744073709551615' 逐位比較。
    exceeds = 0
    base == 16 -> {
        sig > 16 -> exceeds = 1
    }

    #{overflow=wrap}
    base == 10 -> {
        sig > 20 -> exceeds = 1
        sig == 20 -> {
            maxd = '18446744073709551615'
            i = 0
            cmp = 0
            (i < 20 && cmp == 0) {
                d-opt = raw.byte(s + i)
                d = d-opt: {
                    ok -> it
                    -> 0
                }
                m-opt = maxd.byte(i)
                m = m-opt: {
                    ok -> it
                    -> 0
                }
                d > m -> cmp = 1
                d < m -> cmp = -1
                i = i + 1
            }
            cmp == 1 -> exceeds = 1
        }
    }
    exceeds == 1 -> {
        out = '0'
        return
    }

    ; 折疊低 64 位（wrap ⇒ 自動得 int64(uval) 兩倍補數）
    val = 0
    j = s

    #{overflow=wrap}
    (j < len) {
        c-opt = raw.byte(j)
        c = c-opt: {
            ok -> it
            -> 0
        }
        dv = 0
        c >= 48 && c <= 57 -> dv = c - 48
        base == 16 -> {
            c >= 97 && c <= 102 -> dv = c - 97 + 10
            c >= 65 && c <= 70 -> dv = c - 65 + 10
        }
        val = val * base + dv
        j = j + 1
    }
    out = val.to-str()
}

; ps-parse-expr-prec：優先級爬升解析（對應 Go parseExpression(precedence)。
;   左結合：只吞「優先級**嚴格大於** prec」的運算子（Go 的迴圈條件
;   `currentPrecedence() > precedence`）。遞迴右運算元時傳入**運算子自身**
;   的優先級（Go parseInfixExpression 的 `parseExpression(precedence)`）。
ps-parse-expr-prec = (t ast, p psst, prec i64) (idx i64) {

    ; 運算式開頭跳過 trivia（Go 只跳 NEWLINE；本實作連 COMMENT 一齊跳，
    ; 與 Go 的差異僅在「運算子後紧跟行內註解」的罕見排版，L2 差分可偵測）
    ps-skip-trivia(p)
    idx = 0
    tk = ps-peek-token(p)
    {
        tk.typ == tok.INT -> {

            ; value：解析成 i64 再轉十進位字串（與 Go 的 %v 對齊）
            ; raw：原始碼文字（直接解析的字串字面量不設 Raw，見 §5.3.2）
            v = ps-int-lit-value(tk.lit)
            idx = ast.add(t, asp.K_INTEGER_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, v))
            ast.set-slot(t, idx, 1, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.FLOAT -> {

            ; value = ParseFloat 後的 %v 呈現（'1.0'⇒1、'1.50'⇒1.5）；raw = 原 token 文字
            ;   ⚠️ 已知殘差（s7z）：Go 的 %v 是【最短往返】（strconv.FormatFloat 'g' -1），
            ;   std 的 f64.to-str 是 C %g（固定 6 位）⇒ 3.141592653589793 會印成 3.14159。
            ;   精確對齊需要 Ryu/Grisu 級「精確最短往返」：std 的 log10/exp 只有 ~1e-12
            ;   精度（禁 libm，純 .no 實現），16–17 位時 to-str-sci/-fixed 會產出垃圾數字
            ;   （實測 1e-6 ⇒ 9.9999999999948480e-07、1e17 ⇒ 1.0000000000894680e+17）。
            ;   正解：由 f64 位元拆出 m×2^E，用 bigint 做精確十進位展開再逐位試最短往返。
            v = tk.lit.to-f64().to-str()
            idx = ast.add(t, asp.K_FLOAT_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, v))
            ast.set-slot(t, idx, 1, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.STRING -> {
            idx = ast.add(t, asp.K_STRING_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))

            ; raw 留 0（直接解析 → 不印 raw）
            ps-bump(p)
        }

        tk.typ == tok.CHAR -> {

            ; `"a"` ⇒ CharLiteral{value: a}（Nolang 雙引號=字元）；raw 留 0 → kvs 不印
            idx = ast.add(t, asp.K_CHAR_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.TRUE -> {
            idx = ast.add(t, asp.K_BOOLEAN_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'true'))
            ps-bump(p)
        }

        tk.typ == tok.FALSE -> {
            idx = ast.add(t, asp.K_BOOLEAN_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false'))
            ps-bump(p)
        }

        tk.typ == tok.NIL -> {
            idx = ast.add(t, asp.K_NIL_LITERAL)
            ps-bump(p)
        }

        ; s8p：正則字面量 /pattern/flags（照抄 oracle RegexLiteral）。lexer 已吐 REGEX
        ;   token：pattern 在 tk.lit、flags 在 tk.raw（見 lx.no:1088-1091）。spec 段
        ;   K_REGEX_LITERAL(55)：s0=pattern(P-ALWAYS)、s1=flags(P-NON-EMPTY)；無子節點。
        tk.typ == tok.REGEX -> {
            idx = ast.add(t, asp.K_REGEX_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit)); pattern
            ast.set-slot(t, idx, 1, ast.put-str(t, tk.raw)); flags
            ps-bump(p)
        }

        ; s59：IN 是上下文關鍵字——表達式位可作識別字（Go expr.go:96
        ;   `case lexer.IDENT, lexer.IN, lexer.MATCH: leftExp = p.parseIdentifier()`；
        ;   parseIdentifier 直接用 token literal ⇒ Identifier{name: in}）。
        ; ⚠️ 缺 IN 臂 ⇒ 表達式位的 `in` 無 primary 可取（回 idx=0 且不吃 token）：
        ;   · `it = in[i]`：let RHS 變 IndexExpression{<nil>, i}（左值丟失）
        ;   · `(in[i]) != pad-len -> { … }`（src/std/crypto/aes-cbc.no:222、
        ;     src/std/net/tls.no:695 同源）：LPAREN 臂建出【空殼】GroupedExpression 後
        ;     pos 卡在 IN 不動 ⇒ 陳述級進度守則每輪強制 bump 一 token，把一行拆成
        ;     「41+ 深 GroupedExpression 鏈」+「SliceLiteral{i}」+「左值 nil 的
        ;     InfixExpression」三個陳述；深鏈使 dump 每行縮排 O(depth)、總量 O(N²)
        ;     ⇒ GB 級輸出 ⇒ 表現為掛起（rc=124）。實證：token 流
        ;     `3:1 LPAREN / 3:2 IN in / 3:4 LBRACKET …`；oracle 產
        ;     `GroupedExpression{IndexExpression{Identifier{in}, Identifier{i}}}`。
        ; ⚠️ MATCH 同屬此類（Go expr.go:96 同臂、stmt.go:2122 isStatementBoundary），
        ;   原注释稱「語料無 match 作識別字用法」⇒ 只補 IN；但批次十六後發現 src/std/str.no、
        ;   src/std/txt.no、test/std/base64.no、test/std/pem.no 均有 `match = …` 變數賦值
        ;   （被 SUT 當 match 語句吞掉、殘留 ExpressionStatement{…}）⇒ 現補 MATCH（s8i）。
        ;   語料無裸 `match {` 語句（Go stmt.go 亦不把 MATCH 當語句關鍵字），故安全。
        tk.typ == tok.IDENT || tk.typ == tok.IN || tk.typ == tok.MATCH -> {
            idx = ast.add(t, asp.K_IDENTIFIER)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.LPAREN -> {

            ; (expr) → GroupedExpression{ expr }（dump 無標頭欄位，僅一個子節點）
            ps-bump(p)
            inner = ps-parse-expr-prec(t, p, 0)
            ps-skip-trivia(p)
            ; s10：缺 RPAREN ⇒ 復刻 expr.go:956-960（parseGroupedExpression 的報錯點：
            ;   「expected right parenthesis, got <TYPE> instead」定位在【目前 token】）。
            ;   ⚠️ 僅報錯、不改容錯消費路徑（ps-expect 照舊），觀測面 L2 不受影響。
            ps-peek(p) != tok.RPAREN -> ps-error(p, 'expected right parenthesis, got ' + tok.name(ps-peek(p)) + ' instead', 'E_GENERAL')
            ps-expect(p, tok.RPAREN)
            idx = ast.add(t, asp.K_GROUPED_EXPRESSION)
            inner > 0 -> ast.kid-add(t, idx, inner)
        }

        tk.typ == tok.LBRACE -> {

            ; primary 位 `{`——鏡像 Go expr.go:369-386 LBRACE 臂：blockStruct →
            ;   匿名 struct literal（type 空）／blockMatch → 裸 match 運算式／
            ;   其他 → 吃掉 `{` 回 nil。
            ;   ⚠️ 此前無臂 ⇒ `result = { pat -> … }` 的 RHS 回空（LetStatement.value=∅）
            ;   且裸 match 落回陳述位重解析 ⇒ MatchArm.valueCtx 全丟（build-mo flag_gap
            ;   根因）。⚠️ 兩閘先擷取旗標再分支（同 ps-loop-body 教訓）：解析會改 p.pos，
            ;   續列條件重讀 peek 必錯位。
            stLit = 0
            ps-is-struct-lit(p) == 1 -> stLit = 1
            stLit == 1 -> idx = ps-parse-struct-lit(t, p, '')
            stLit == 0 -> {
                bm = 0
                ps-bm-scan(p) == 1 -> bm = 1
                bm == 1 -> idx = ps-parse-bare-match(t, p)
                bm == 0 -> {
                    ps-bump(p); 消費 {（Go：nextToken(); return nil）
                    idx = 0
                }
            }
        }

        tk.typ == tok.IF -> {
            ; s8h：表達式位 `if` ——對齊 Go expr.go:302 的 IF 臂（parseIfExpression）。
            ;   與 ps-parse-stmt 的語句級 `if` 共用 ps-parse-if（自包含、不依賴語句級狀態）。
            idx = ps-parse-if(t, p)
        }

        tk.typ == tok.SUB -> {

            ; 前綴負號：不折進字面量（Oracle：-3 ⇒ PrefixExpression{-} / IntegerLiteral{3, raw:3}）
            ps-bump(p)
            right = ps-parse-expr-prec(t, p, 9); PREFIX 優先級
            idx = ast.add(t, asp.K_PREFIX_EXPRESSION)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            right > 0 -> ast.kid-add(t, idx, right)
        }

        tk.typ == tok.NOT -> {
            ps-bump(p)
            right = ps-parse-expr-prec(t, p, 9); PREFIX 優先級
            idx = ast.add(t, asp.K_PREFIX_EXPRESSION)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            right > 0 -> ast.kid-add(t, idx, right)
        }

        tk.typ == tok.TILDE -> {
            ; s8h：前綴位元 NOT（bitwise NOT）——對齊 Go expr.go:269 的 TILDE 臂（parsePrefixExpression）。
            ;   Oracle：-3 ⇒ PrefixExpression{-} / IntegerLiteral{3}；~x ⇒ PrefixExpression{~} / Identifier{x}。
            ps-bump(p)
            right = ps-parse-expr-prec(t, p, 9); PREFIX 優先級
            idx = ast.add(t, asp.K_PREFIX_EXPRESSION)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            right > 0 -> ast.kid-add(t, idx, right)
        }

        tk.typ == tok.RUN -> {
            dotAfter = ps-peek-at(p, 1) == tok.DOT
            dotAfter == 1 -> {
                idx = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
                ps-bump(p); 消費 run（停在 DOT）
            }
            dotAfter == 0 -> {
                ps-bump(p); 消費 run
                child = ps-parse-expr-prec(t, p, 0); 內層呼叫運算式（LOWEST）
                idx = ast.add(t, asp.K_RUN_EXPRESSION)
                child > 0 -> ast.kid-add(t, idx, child); guarded CHILD=Call
            }
        }

        tk.typ == tok.CO -> {
            dotAfter = ps-peek-at(p, 1) == tok.DOT
            dotAfter == 1 -> {
                idx = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
                ps-bump(p); 消費 co（停在 DOT）
            }
            dotAfter == 0 -> {
                ps-bump(p); 消費 co
                child = ps-parse-expr-prec(t, p, 0); 內層呼叫運算式（LOWEST）
                idx = ast.add(t, asp.K_CO_EXPRESSION)
                child > 0 -> ast.kid-add(t, idx, child); guarded CHILD=Call
            }
        }

        tk.typ == tok.AWY -> {
            ps-bump(p); 消費 awy
            child = ps-parse-expr-prec(t, p, 0); 內層運算式（LOWEST）
            idx = ast.add(t, asp.K_AWAIT_EXPRESSION)
            child > 0 -> ast.kid-add(t, idx, child); guarded CHILD=Right
        }

        tk.typ == tok.LBRACKET -> {

            ; [e1, e2, …] → SliceLiteral{elements: N}
            ; 規則源於 Go parseSliceLiteral：跳 LBRACKET、跳 NEWLINE、空 [] 直接回；
            ; 否則逗號分隔解析運算式直到 RBRACKET。
            ; s7 續 F：`[` 後見 ELLIPSIS（[..b]）或首元素後見 ELLIPSIS（[a..b] / [a..b)）
            ;   ⇒ RangeExpression{Start, End, leftInc=true, rightInc}（Go parseSliceLiteral
            ;   的 range 分支；`..` 非中綴運算子，首元素解析完 `..` 仍停在
            ;   currentToken）。舊缺陷：一律建 SliceLiteral ⇒ match 臂 range 型樣
            ;   `[0..60) ->` 被吞成 SliceLiteral{4}（實測 match-range-pattern.no）。
            ps-bump(p)
            els []i64 = with-cap(4)
            ps-skip-trivia(p)
            rng = 0
            rst = 0
            ren = 0
            ri = 'false'
            {
                ps-peek(p) == tok.RBRACKET -> {
                    ps-bump(p)
                }

                -> {
                    ps-peek(p) == tok.ELLIPSIS -> {

                        ; 無下限區間 [..b] / [..b) / [..]（Start 缺席 ⇒ kid0 占位 0）
                        rng = 1
                        ps-bump(p); 消費 ..
                        ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.RPAREN -> ren = ps-parse-expr-prec(t, p, 0)
                    }
                    rng == 0 -> {
                        rst = ps-parse-expr-prec(t, p, 0)
                        rst > 0 -> els.push(rst)
                        ps-skip-trivia(p)
                        ps-peek(p) == tok.ELLIPSIS -> {
                            rng = 1
                            ps-bump(p); 消費 ..
                            ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.RPAREN -> ren = ps-parse-expr-prec(t, p, 0)
                        }
                    }
                    rng == 1 -> {
                        cl = ps-peek(p)
                        ri = 'false'
                        cl == tok.RBRACKET -> ri = 'true'
                        ps-bump(p); 消費閉合 `]` 或 `)`
                    }
                    rng == 0 -> {
                        (ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.EOF) {
                            pos0 = p.pos
                            e = ps-parse-expr-prec(t, p, 0)
                            e > 0 -> els.push(e)
                            ps-skip-trivia(p)

                            ; ⚠️ 展開多行：`;` 是行註解，單行寫法會吃掉閉合 `}`
                            ps-peek(p) == tok.COMMA -> {
                                ps-bump(p)
                                ps-skip-trivia(p)
                            }
                            p.pos == pos0 -> ps-bump(p)
                        }
                        ps-expect(p, tok.RBRACKET)
                    }
                }
            }
            rng == 0 -> {
                idx = ast.add(t, asp.K_SLICE_LITERAL)
                ast.set-slot(t, idx, 0, ast.put-str(t, els.len().to-str()))
                ast.set-count(t, idx, 0, els.len())
                m = 0
                (m < els.len()) {
                    ast.kid-add(t, idx, els[m])

                    #{overflow=wrap}
                    m = m + 1
                }
            }
            rng == 1 -> {
                idx = ast.add(t, asp.K_RANGE_EXPRESSION)
                ast.set-slot(t, idx, 0, ast.put-str(t, 'true')); leftInc（開 `[`）
                ast.set-slot(t, idx, 1, ast.put-str(t, ri)); rightInc
                ast.kid-add(t, idx, rst); Start（缺席＝0 占位 ⇒ <nil>）
                ast.kid-add(t, idx, ren); End
            }
        }

        tk.typ == tok.DOT -> {
            ps-bump(p); 消費 DOT
            pn = ps-peek-token(p)
            pn.typ == tok.IDENT -> {

                ; .property → 先建 self Identifier（子）再建 DotExpression（父）：子先於父
                selfid = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, selfid, 0, ast.put-str(t, 'self'))
                dot = ast.add(t, asp.K_DOT_EXPRESSION)
                ast.set-slot(t, dot, 0, ast.put-str(t, pn.lit))
                ast.kid-add(t, dot, selfid)
                idx = dot
                ps-bump(p); 消費 property IDENT
            }

            ; 裸 `.`（無緊接 IDENT）→ self
            pn.typ != tok.IDENT -> {
                idx = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, idx, 0, ast.put-str(t, 'self'))
            }
        }

        -> {
        }
    }

    ; ---------- 後綴迴圈：呼叫 `f(...)` / 成員 `a.b` ----------
    ; Go 在 parseExpression 的主循環中將 LPAREN 歸為 CALL(10)
    ; 優先級最高 ⇒ 只要能看见就必須绑定（outer prec 永远 < 10）。
    ; DOT 不在 precedences 表中，Go 在链式呼叫/成员访问中直接处理
    ; ⇒ 這裡一律绑定，不比較 prec。
    pgo = true
    (pgo) {
        nt = ps-peek(p)

        ; ⚠️ 用 `handled` 旗標而非裸 `-> { pgo = false }` 預設臂：實測在 `(pgo)` 迴圈
        ;   內的多臂 match，尾隨預設臂與其他臂的**跨臂接連迭代**會誤編（新增第三個
        ;   區塊臂後 DOT→LPAREN / LPAREN→LBRACKET / LBRACKET→LBRACKET 各有其一會斷）。
        ;   `handled` 把終止條件變成**顯式陳述**，不依賴 match 落 semantics。
        handled = 0
        nt == tok.LPAREN -> {

            ; Go expr.go LPAREN 臂：先探視 `(` 後是否 range 切片（ELLIPSIS，或 INT/IDENT 緊接 ELLIPSIS），
            ;   是 ⇒ parseSliceExpression（tok=LPAREN ⇒ leftInc=false，右閉 `]`⇒rightInc=true）；否 ⇒ 普通 CALL。
            t1 = ps-peek-at(p, 1)
            t2 = ps-peek-at(p, 2)
            isRng = t1 == tok.ELLIPSIS || (t1 == tok.INT && t2 == tok.ELLIPSIS) || (t1 == tok.IDENT && t2 == tok.ELLIPSIS)
            isRng == 1 -> {
                ps-bump(p); 消費 (
                pst0 = 0
                pen0 = 0
                phas = ps-peek(p) != tok.ELLIPSIS
                phas == 0 -> {
                    ps-bump(p); 消費 ..
                    ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.RPAREN -> pen0 = ps-parse-expr-prec(t, p, 0)
                }
                phas == 1 -> {
                    pst0 = ps-parse-expr-prec(t, p, 0)
                    ps-peek(p) == tok.ELLIPSIS -> {
                        ps-bump(p); 消費 ..
                        ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.RPAREN -> pen0 = ps-parse-expr-prec(t, p, 0)
                    }
                }
                ps-skip-trivia(p)
                pcl = ps-peek(p)
                pri = 'false'
                pcl == tok.RBRACKET -> pri = 'true'
                ps-bump(p); 消費閉合 `]` 或 `)`
                prg = ast.add(t, asp.K_RANGE_EXPRESSION)
                ast.set-slot(t, prg, 0, ast.put-str(t, 'false')); leftInc（開 `(`）
                ast.set-slot(t, prg, 1, ast.put-str(t, pri)); rightInc
                ast.kid-add(t, prg, pst0)
                ast.kid-add(t, prg, pen0)
                pse = ast.add(t, asp.K_SLICE_EXPRESSION)
                ast.kid-add(t, pse, idx)
                ast.kid-add(t, pse, prg)
                idx = pse
                handled = 1
            }
            isRng == 0 -> {

                ; 消耗 LPAREN，實參循環鏡像 Go parseCallExpression（expr.go:2207-2245）：
                ;   空參速出（Go 進循環前 currentToken==RPAREN ⇒ nextToken; return）；
                ;   每輪＝跳前導 trivia → parseArgument → 跳尾 trivia → COMMA/RPAREN/其他
                ;   三分支；其他 ⇒ s10 報錯「expected comma or right parenthesis, got X
                ;   instead」（expr.go:2242 saveError）且【不消耗】該 token 即離開
                ;   （Go return nil；呼叫表達式落空）。
                ; ⚠️ 前導跳語義僅對【首實參前】的 NEWLINE 與 Go 對齊：Go 在「上一實參
                ;   已 Consumed、尚未報錯」的態直接進下一輪 parseArgument，不會先跳行；
                ;   noc 無法從 arg==0 區分「換行開頭的實參」與「缺逗號」，統一跳 trivia
                ;   （語料中 `f(\n  x)` 形 Go 也照收，noc 收同 AST；僅缺逗號報錯的時序略異）。
                ps-bump(p)
                args []i64 = with-cap(4)
                clDone = 0
                (clDone == 0) {
                    ps-skip-trivia(p)
                    {
                        ; 空參數表：`)` 直接開 ⇒ Go 前導速出（消費 RPAREN、不報錯）
                        ps-peek(p) == tok.RPAREN && args.len() == 0 -> {
                            ps-bump(p)
                            clDone = 1
                        }

                        -> {
                            clPos0 = p.pos
                            a = ps-parse-expr-prec(t, p, 0)
                            a > 0 -> args.push(a)
                            ; 防呆：arg 解析一 token 未吃（如非法起始符）⇒ 前進一格
                            p.pos == clPos0 -> ps-bump(p)
                            {
                                ps-peek(p) == tok.COMMA -> ps-bump(p)

                                ; 結尾：消費 RPAREN 並退出（Go nextToken(); break）
                                ps-peek(p) == tok.RPAREN -> {
                                    ps-bump(p)
                                    clDone = 1
                                }

                                ; Go else 臂：實參後既無逗號也無閉括號 ⇒ 報錯、不消耗
                                ps-err-count(p) == 0 -> {
                                    ps-error(p, 'expected comma or right parenthesis, got ' + tok.name(ps-peek(p)) + ' instead', 'E_GENERAL')
                                    clDone = 1
                                }

                                ; 已有其他錯誤在前（Go saveError 去重/非法 token 已報）⇒ 靜默前進
                                -> ps-bump(p)
                            }
                        }
                    }
                }

                ; arena 順序：Function (idx) 与 args 子树已完成 → add 父后依序 kid-add
                call = ast.add(t, asp.K_CALL_EXPRESSION)

                ; slot 0 = "args" 纯量的预渲染（kvc=NON-ZERO 政策：0 不印）
                ast.set-slot(t, call, 0, ast.put-str(t, args.len().to-str()))

                ; count slot 0 = KIDS 迭代次数（Arguments 切片长度）
                ast.set-count(t, call, 0, args.len())
                ast.kid-add(t, call, idx)
                k = 0
                (k < args.len()) {
                    ast.kid-add(t, call, args[k])

                    #{overflow=wrap}
                    k = k + 1
                }
                idx = call
                handled = 1
            }
        }
        nt == tok.DOT -> {
            ps-bump(p)
            ps-skip-trivia(p)
            pn = ps-peek-token(p)
            pname = pn.lit
            ps-expect(p, tok.IDENT)

            ; DotExpression dump 只一个 CHILD(Receiver)；property 是字串槽 0
            dot = ast.add(t, asp.K_DOT_EXPRESSION)
            ast.set-slot(t, dot, 0, ast.put-str(t, pname))
            ast.kid-add(t, dot, idx)
            idx = dot
            handled = 1
        }
        nt == tok.LBRACKET -> {

            ; `left[...]` ⇒ 純索引 `a[i]` 走 IndexExpression；含 `..` 的範圍走 SliceExpression{Range}。
            ; 對應 Go parseSliceExpression：LOWEST 優先級、leftInc=true（開 `[`）、右閉 `]`⇒rightInc=true。
            ; ⚠️ hasStart 先存快照：兩個臂的條件必須互斥且不随位置变化重评，否则 A 臂解析后 B 臂会误跑。
            ps-bump(p)
            st = 0
            en = 0
            isRange = 0
            hasStart = ps-peek(p) != tok.ELLIPSIS
            hasStart == 0 -> {

                ; [..end] / [..]：無 start
                ps-bump(p)
                isRange = 1
                ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.RPAREN -> en = ps-parse-expr-prec(t, p, 0)
            }
            hasStart == 1 -> {

                ; [expr..] / [expr]：先解 start（或索引）
                st = ps-parse-expr-prec(t, p, 0)
                ps-peek(p) == tok.ELLIPSIS -> {
                    ps-bump(p)
                    isRange = 1
                    ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.RPAREN -> en = ps-parse-expr-prec(t, p, 0)
                }
            }
            ps-skip-trivia(p)

            ; 閉合可能是 `]`（rightInc=true）或 `)`（rightInc=false）——Go 兩者皆接受
            cl = ps-peek(p)
            ri = 'false'
            cl == tok.RBRACKET -> ri = 'true'
            ps-bump(p); 消費閉合 `]` 或 `)`

            ; 組節點：Range 兩 kid 固定為 [Start, End]，缺席者以 0 占位（node-string(0)='<nil>'）
            isRange == 1 -> {
                rg = ast.add(t, asp.K_RANGE_EXPRESSION)
                ast.set-slot(t, rg, 0, ast.put-str(t, 'true')); leftInc（開 `[`）
                ast.set-slot(t, rg, 1, ast.put-str(t, ri)); rightInc
                ast.kid-add(t, rg, st)
                ast.kid-add(t, rg, en)
                se = ast.add(t, asp.K_SLICE_EXPRESSION)
                ast.kid-add(t, se, idx)
                ast.kid-add(t, se, rg)
                idx = se
            }
            isRange == 0 -> {
                ie = ast.add(t, asp.K_INDEX_EXPRESSION)
                ast.kid-add(t, ie, idx)
                ast.kid-add(t, ie, st)
                idx = ie
            }
            handled = 1
        }
        nt == tok.LBRACE && ps-is-struct-lit(p) -> {

            ; `Ident{ field: val, … }` ⇒ StructLiteral（對應 Go parseStructLiteral）。
            ; 型别名用 ps-dotted-name：単 IDENT→`Point`、限定名 DotExpression 链→`net.Conn`。
            ty = ps-dotted-name(t, idx)
            sl = ps-parse-struct-lit(t, p, ty)
            idx = sl
            handled = 1
        }
        matchSubj = 0
        ast.kind-at(t, idx) == asp.K_IDENTIFIER -> matchSubj = 1
        ast.kind-at(t, idx) == asp.K_INDEX_EXPRESSION -> matchSubj = 1
        ast.kind-at(t, idx) == asp.K_DOT_EXPRESSION -> matchSubj = 1
        nt == tok.COLON && ps-peek-at(p, 1) == tok.LBRACE && matchSubj == 1 -> {

            ; 明示 match：`subj: { pat -> body … }` ⇒ desugar 成 if/else 鏈（見 ps-parse-match）。
            ; s66c：主體放寬到 IDENT / IndexExpression / DotExpression，並把主體【節點】傳入
            ;   ps-parse-match（subj 字串仍供降糖路用），覆蓋率 17%→68%（見 §5.3.4）。
            subjName = ast.node-string(t, idx)
            ps-bump(p); 消費 COLON
            ps-bump(p); 消費 LBRACE
            mm = ps-parse-match(t, p, subjName, idx)
            ps-expect(p, tok.RBRACE)
            idx = mm
            handled = 1
        }
        handled == 0 -> pgo = false
    }

    ; 中綴迴圈（Go：for currentToken != EOF && currentPrecedence() > precedence）
    ; 注意：**不**在檢查運算子前跳 trivia──句尾 NEWLINE 優先級 0 自然終止迴圈。
    go = true
    (go) {
        optyp = ps-peek(p)
        oprec = ps-op-prec(optyp)
        go = oprec > prec
        go -> {
            otk = ps-peek-token(p)
            ps-bump(p)
            right = ps-parse-expr-prec(t, p, oprec)
            right > 0 -> {

                ; arena 順序：左右子樹均已完成 → 先 add 父，再依序 kid-add
                node = ast.add(t, asp.K_INFIX_EXPRESSION)
                ast.set-slot(t, node, 0, ast.put-str(t, otk.lit))
                ast.kid-add(t, node, idx)
                ast.kid-add(t, node, right)
                idx = node
            }

            ; 右運算元缺失：Go 報錯後回左值；這裡保留左值並終止迴圈
            right <= 0 -> go = false
        }
    }

    ; 三元運算式 `? :`（CONDITIONAL 優先級=2；對應 Go parseExpression 尾的 QUESTION 檢查，expr.go:599）。
    ; 僅當 prec <= 2 才吸收 `?`：否則 `a > 5 ? b : c` 的 `?` 會錯綁到 `5`（應綁到整個 `a > 5`）。
    ; 鏡像 Go parseConditionalExpression（expr.go:848）：skip ? → consequence@CONDITIONAL → expect : → alternative@CONDITIONAL。
    ; 節點 K_CONDITIONAL_EXPRESSION（id 21）三子節點順序：Condition / Consequence / Alternative（asp.no:144-147 / dump.go:534-536）。
    ps-peek(p) == tok.QUESTION && prec <= 2 -> {
        ps-bump(p); 消費 ?
        cons = ps-parse-expr-prec(t, p, 2); consequence（CONDITIONAL=2，允許巢狀三元右結合）
        ps-peek(p) == tok.COLON -> ps-bump(p); 消費 :（缺則靜默終止，對齊 Go saveError 寬容行為）
        alt = ps-parse-expr-prec(t, p, 2); alternative（CONDITIONAL=2）
        ce = ast.add(t, asp.K_CONDITIONAL_EXPRESSION)
        ast.kid-add(t, ce, idx);   Condition
        ast.kid-add(t, ce, cons);  Consequence
        ast.kid-add(t, ce, alt);   Alternative
        idx = ce
    }

    ; 陳述/運算式層級的 lvalue 賦值：`obj.field = expr` / `arr[i] = expr` / `mp[k] = expr`。
    ;   對應 Go parseExpression 尾（expr.go:598–637）：`=` 非中綴運算子（優先級 0），中綴迴圈天然停在 ASSIGN；
    ;   若此時左值是 Dot/Index ⇒ 消費 `=`、以 LOWEST 解右值、建 AssignExpression{Left,Value}（右結合、無純量槽）。
    ;   僅 plain ASSIGN（`?=` → UnwrapAssignStatement 為另一節點，本片延後）。檢查用【活】ps-peek：`=` 前若換行則 currentToken 為 NEWLINE、不觸發（對齊 Go）。
    ps-peek(p) == tok.ASSIGN -> {
        k0 = ast.kind-at(t, idx)
        isLval = 0
        k0 == asp.K_DOT_EXPRESSION -> isLval = 1
        k0 == asp.K_INDEX_EXPRESSION -> isLval = 1
        isLval == 1 -> {
            ; s7w：捕獲 `=` token 位置（寫形 __idx_out_L_C 命名用，Go AssignExpression.Token）
            p.aeLn = p.toks[p.pos].ln
            p.aeCl = p.toks[p.pos].cl
            ps-bump(p); 消費 =
            val = ps-parse-expr(t, p)
            ae = ast.add(t, asp.K_ASSIGN_EXPRESSION)
            ast.kid-add(t, ae, idx)
            ast.kid-add(t, ae, val)
            idx = ae
        }
    }
    idx
}

; ── s51：parse 期型別推斷輔助群（復刻 Go parser 的簽名表/變數型別表/宣告表與 gate）──

; ps-sig-find：反向掃描同檔函式簽名（最後註冊覆蓋先前，對應 Go map 語意）。回傳回傳值型別起始 token 下標；-1=未找到。
; ── s51b：O(1) 字串→i64 雜湊查表（開放定址；模數按需增長 = htK.len()，負載>=0.75 翻倍重哈希）──
ps-hash = (s str) (h i64) {
    h = 5381
    i = 0
    n = s.len-bytes()
    (i < n) {
        c-opt = s.byte(i)
        c = c-opt: {
            ok -> it
            -> 0
        }
        #{overflow=wrap}
        h = h * 31 + c
        i = i + 1
    }
}

ps-ht-put = (p psst, key str, val i64) () {
    cap = p.htK.len()
    (p.htN * 4 >= cap * 3) -> {
        ; 負載因子 >= 0.75：把 htK/htV 翻倍並重哈希（htTy 不動，htV 存的是 htTy 下標）。
        oldK = p.htK
        oldV = p.htV
        oldN = oldK.len()
        newCap = oldN * 2
        (newCap == 0) -> newCap = 256
        p.htK = with-cap(newCap)
        p.htV = with-cap(newCap)
        hi = 0
        (hi < newCap) {
            p.htK.push('')
            p.htV.push(0)
            hi = hi + 1
        }
        p.htN = 0
        hi = 0
        (hi < oldN) {
            k = oldK[hi]
            k != '' -> {
                m = p.htK.len()
                hh = ps-hash(k)
                #{overflow=wrap}
                hh = hh % m
                (hh < 0) -> hh = hh + m
                j = 0
                (j < m) {
                    kk = p.htK[hh]
                    kk == '' -> {
                        p.htK[hh] = k
                        p.htV[hh] = oldV[hi]
                        p.htN = p.htN + 1
                        j = m
                    }
                    kk == k -> {
                        p.htV[hh] = oldV[hi]
                        j = m
                    }
                    #{overflow=wrap}
                    hh = (hh + 1) % m
                    (hh < 0) -> hh = hh + m
                    j = j + 1
                }
            }
            hi = hi + 1
        }
    }
    n = p.htK.len()
    h = ps-hash(key)
    #{overflow=wrap}
    h = h % n
    (h < 0) -> h = h + n
    i = 0
    (i < n) {
        k = p.htK[h]
        k == '' -> {
            p.htK[h] = key
            p.htV[h] = val
            p.htN = p.htN + 1
            return
        }
        k == key -> {
            p.htV[h] = val
            return
        }
        #{overflow=wrap}
        h = (h + 1) % n
        (h < 0) -> h = h + n
        i = i + 1
    }
}

ps-ht-get = (p psst, key str) (r i64) {
    r = -1
    n = p.htK.len()
    h = ps-hash(key)
    #{overflow=wrap}
    h = h % n
    (h < 0) -> h = h + n
    i = 0
    (i < n) {
        k = p.htK[h]
        k == '' -> { return }
        k == key -> {
            r = p.htV[h]
            return
        }
        #{overflow=wrap}
        h = (h + 1) % n
        (h < 0) -> h = h + n
        i = i + 1
    }
}

ps-sig-find = (p psst, fname str) (pos i64) {
    pos = ps-ht-get(p, 'sig:' - fname)
    (pos < 0) -> {
        ; s8j：module-qualified fallback（对齐 Go returnTypeFromCallExpr 的 mod+"."+fnName 回退，
        ;   type.go:148-152）。SUT 单文件解析：方法簽名存於 msN（鍵形如 `mod.fn`，L4311 註），
        ;   裸名函式存於 sigN；二者相斥。裸名呼叫未命中時，扫描 msN（次掃 sigN）找
        ;   「以 "."+fname 結尾」的鍵即本模組同名方法，取其回傳型別起點 token。
        ;   例：str.no 内 `out = with-cap(total)` 呼叫裸名 with-cap，而该函式以方法 `str.with-cap`
        ;   定义于同档（ms:str.with-cap）⇒ 裸名查不到，经此后备命中回传 str。
        suf = '.' - fname
        sl = suf.len-bytes()
        i = 0
        (i < p.msN.len()) {
            nm = p.msN[i]
            nl = nm.len-bytes()
            nl > sl -> {
                pre = nm.slice-bytes(nl - sl, nl)
                pre == suf -> {
                    pos = p.msP[i]
                    i = p.msN.len()
                }
            }
            i = i + 1
        }
        (pos < 0) -> {
            j = 0
            (j < p.sigN.len()) {
                nm = p.sigN[j]
                nl = nm.len-bytes()
                nl > sl -> {
                    pre = nm.slice-bytes(nl - sl, nl)
                    pre == suf -> {
                        pos = p.sigP[j]
                        j = p.sigN.len()
                    }
                }
                j = j + 1
            }
        }
    }
    (pos < 0) -> pos = -1
}

; s58：ps-msig-find：方法簽名表查 'recv.method' 鍵（同 ps-sig-find 反掃覆前口徑）。
ps-msig-find = (p psst, key str) (pos i64) {
    pos = ps-ht-get(p, 'ms:' - key)
    (pos < 0) -> pos = -1
}

; s8v-dom：結構欄位型別登記表（鏡像 Go p.structFields：structName → fieldName → typeString，
;   type.go:30/50/71 讀取）。ps-parse-struct-def 逐欄位登記；僅供 ps-reg-let 鏈式接收者
;   `self.field.method(...)` 的回傳型推斷查表（Go resolveReceiverType 的 DotExpression 臂）。
;   ⚠️ 純增量鍵空間 'sf:'——既有流程不讀 ⇒ 登記本身零回歸；只有新增的推斷臂會消費。
ps-reg-struct-field = (p psst, sname str, fname str, ty str) {
    tidx = p.htTy.len()
    p.htTy.push(ty)
    ps-ht-put(p, 'sf:' - sname - ' ' - fname, tidx)
}

ps-struct-field-type = (p psst, sname str, fname str) (ty str) {
    ty = ''
    tidx = ps-ht-get(p, 'sf:' - sname - ' ' - fname)
    tidx >= 0 -> ty = p.htTy[tidx]
}

; ps-set-var-type：登記變數型別。頂層（fn==''）進全域 VarTypes；函式內僅進 FuncVarTypes
;   （Go parser.go:1050-1066：函式區域變數不污染全域表）。
ps-set-var-type = (p psst, vname str, ty str) {
    key = 'vt:' - p.fn - ' ' - vname
    tidx = p.htTy.len()
    p.htTy.push(ty)
    ps-ht-put(p, key, tidx)
    p.fn == '' -> {
        p.gvN.push(vname)
        p.gvT.push(ty)
    }

    -> {
        p.fvF.push(p.fn)
        p.fvV.push(vname)
        p.fvT.push(ty)
        ps-ht-put(p, 'fv:' - p.fn - ' ' - vname, 1)
    }
}

; ps-set-var-type-s7v：s7v 後備登記（函式內 receiver 的索引元素型別）——寫進**獨立鍵空間**。
;   ⚠️ 為何不混在 'vt:'：Go 的 IndexExpression 臂只從【全域表 p.sem.VarTypes】取 receiver 型別
;   （stmt.go:1483），函式內 receiver 讀不到 ⇒ 該 let **不會**被登記進 FuncVarTypes
;   ⇒ 後續 `x = y` 傳播（stmt.go:1421 只讀 FuncVarTypes）查不到 y ⇒ 不推斷。
;   noc 的 s7v 後備登記是為降糖（ps-apply-index-out）保留的鏈式型別線索，若混進 'vt:'
;   會讓 `x = y` 多推一層 ⇒ 與 oracle 不符（bzip2 `extra = v` / rsa `tmp = top` /
;   gzip `it = prev` 實測）。
;   ⚠️ 'fv:' 仍要標（作用域成員判定 ps-walk-declared 用）。
ps-set-var-type-s7v = (p psst, vname str, ty str) {
    key = 'vt7:' - p.fn - ' ' - vname
    tidx = p.htTy.len()
    p.htTy.push(ty)
    ps-ht-put(p, key, tidx)
    p.fvF.push(p.fn)
    p.fvV.push(vname)
    p.fvT.push(ty)
    ps-ht-put(p, 'fv:' - p.fn - ' ' - vname, 1)
}

; ps-var-type：FuncVarType 語意——先查當前函式，再回退全域表（Go resolver.go:485）；後寫覆蓋先寫。
;   ⚠️ 末段 fallback 到 'vt7:'（s7v 後備登記）——Go 側沒有這筆（stmt.go:1483 的 IndexExpression
;   臂只從【全域表 p.sem.VarTypes】取 receiver 型別，函式內 receiver 讀不到 ⇒ 該 let 不進
;   FuncVarTypes）。noc 保留它只為降糖（ps-apply-index-out）能查到鏈式型別；
;   **推斷閘門一律走 ps-var-type-strict**（不得被 s7v 線索餵到）。
ps-var-type = (p psst, vname str) (ty str) {
    ty = ''
    tidx = ps-ht-get(p, 'vt:' - p.fn - ' ' - vname)
    tidx >= 0 -> {
        ty = p.htTy[tidx]
        ty != '' -> return
    }
    gidx = ps-ht-get(p, 'vt: ' - vname)
    gidx >= 0 -> {
        ty = p.htTy[gidx]
        ty != '' -> return
    }
    tidx7 = ps-ht-get(p, 'vt7:' - p.fn - ' ' - vname)
    tidx7 >= 0 -> ty = p.htTy[tidx7]
}

; ps-var-type-strict：FuncVarType 的**嚴格**語意（鏡像 Go resolver.go:796-807）——
;   只查本函式 'vt:' 與全域 'vt: '，**不含** s7v 後備登記（'vt7:'）。
;   Go 側 s7v 對應路徑根本不存在 ⇒ 該 let 不進 FuncVarTypes ⇒ `x = y` 傳播（stmt.go:1421）
;   查不到 y ⇒ 不推斷。noc 的 s7v 線索只供降糖（走 ps-var-type），不得餵進推斷閘門。
ps-var-type-strict = (p psst, vname str) (ty str) {
    ty = ''
    tidx = ps-ht-get(p, 'vt:' - p.fn - ' ' - vname)
    tidx >= 0 -> {
        ty = p.htTy[tidx]
        ty != '' -> return
    }
    gidx = ps-ht-get(p, 'vt: ' - vname)
    gidx >= 0 -> ty = p.htTy[gidx]
}

; ps-g-var-type：全域表只讀（鏡像 Go p.sem.VarTypes 直接索引——setVarType 在函式內
;   只寫 FuncVarTypes，全域表僅含頂層變數，parser.go:1113-1129）。供 IndexExpression
;   推斷的 receiver 讀取用：receiver 是函式內區域變數時 Go 讀不到 ⇒ 不推斷。
ps-g-var-type = (p psst, vname str) (ty str) {
    ty = ''
    tidx = ps-ht-get(p, 'vt: ' - vname)
    tidx >= 0 -> ty = p.htTy[tidx]
}

; ps-mark-dcl：let 解析尾部登記宣告（Go parseLetStatement 尾：DeclaredVars 恒記 + SetFuncDeclared）。
;   dclT【僅頂層】登記——鏡像 lowerer walk 的 declaredLocals：函式作用域每次進入 FunctionDefinition
;   即重置（lowering.go:249），頂層名單不得被函式内區域 let 污染（s54 回歸教訓：ip/sha256-simplified/
;   number-div-mod-clamp 皆「本作用域已出現、型别表無entry → captureTargetAllowsOption 拒」）。
ps-mark-dcl = (p psst, vname str) {
    p.gclN.push(vname)
    ps-ht-put(p, 'dcg:' - vname, 1)
    p.fn != '' -> {
        p.dclF.push(p.fn)
        p.dclV.push(vname)
        ps-ht-put(p, 'dc:' - p.fn - ' ' - vname, 1)
        ps-ht-put(p, 'dct:' - p.fn, 1)
    }
    p.fn == '' -> {
        p.dclT.push(vname)
        ps-ht-put(p, 'dctop:' - vname, 1)
    }
}

; ps-mark-ifd：IsFuncDeclared 標記（Go SetFuncDeclared，resolver.go:810）——與 ps-mark-dcl
;   （declaredLocals，給 ps-walk-declared 用）分離。Go 的【裸型別宣告】`x []byte`
;   （stmt.go:1187-1196 no-value 分支）走 setVarType 卻 early-return，跳過尾端
;   SetFuncDeclared（stmt.go:1599）⇒ 裸宣告【不】記 IsFuncDeclared；含值 let 才記。
;   分離後 ps-is-declared 讀 'ifd:'/'ifdg:'；舊 'dc:'/'dcg:' 僅留給 declaredLocals。
;   ⚠️ 'ifdg:' 恆記（鏡像舊 'dcg:' 恆記）以保留全域回退行為 ⇒ 非裸 let 的 ps-is-declared 零變化。
;   s8g：追蹤鍵改用 ps-ifd-key(p)（''⇒p.fn；`recv.method = (…)` 形＝裸方法名，見 psst.ifdFn 註）。
ps-mark-ifd = (p psst, vname str) {
    ps-ht-put(p, 'ifdg:' - vname, 1)
    ifk = ps-ifd-key(p)
    ifk != '' -> {
        ps-ht-put(p, 'ifd:' - ifk - ' ' - vname, 1)
        ps-ht-put(p, 'ifdt:' - ifk, 1); 本函式已有含值 let ⇒ IsFuncDeclared 追蹤起始（鏡像 Go FuncDeclaredVars[fn] 建立時機）
    }
}

; ps-ifd-key：IsFuncDeclared 的函式鍵。s8g：`p.ifdFn` 非空即用之（裸方法名），否則 p.fn。
ps-ifd-key = (p psst) (k str) {
    k = p.fn
    p.ifdFn != '' -> k = p.ifdFn
}

; ps-is-declared：IsFuncDeclared 語意（Go resolver.go:519）——函式已被追蹤時【只】查函式對表，
;   否則回退全域宣告表。防止不同函式的同名區域變數互相干擾推斷。
;   ⚠️ 讀 'ifd:'/'ifdg:'（ps-mark-ifd），非 'dc:'/'dcg:'（後者是 declaredLocals/ps-walk-declared）：
;   裸型別宣告只進 declaredLocals、不進 IsFuncDeclared（見 ps-mark-ifd 註）。
ps-is-declared = (p psst, vname str) (r i64) {
    r = 0
    tracked = 0
    ifk = ps-ifd-key(p)
    tf = ps-ht-get(p, 'ifdt:' - ifk)
    tf >= 0 -> tracked = 1
    ifk != '' && tracked == 1 -> {
        d = ps-ht-get(p, 'ifd:' - ifk - ' ' - vname)
        d >= 0 -> r = 1
        return
    }
    g = ps-ht-get(p, 'ifdg:' - vname)
    g >= 0 -> r = 1
}

; ps-filter-ok：filterInferableType 語意（Go type.go:204-226）——option（?T，節點形即 NullableType）恒可推斷；
;   裸名本型別（整數/浮點/bool/byte/char/fd）不可（整数字面量已有専用推断路径）；str/切片/map/結構名可。
;   ⚠️ 未實作 Go 的「含 | 聯合型别排除」：簽名字串来自同一解析通道，目前語料未見 union 回傳；如遇會以 DIFF 暴露。
ps-filter-ok = (t ast, tn i64, ts str) (r i64) {
    r = 1
    ts == '' -> {
        r = 0
        return
    }
    k = ast.kind-at(t, tn)
    k == asp.K_NULLABLE_TYPE -> return
    k == asp.K_NAMED_TYPE -> {
        ts == 'i64' || ts == 'i32' || ts == 'i16' || ts == 'i8' || ts == 'u64' || ts == 'u32' || ts == 'u16' || ts == 'u8' || ts == 'f64' || ts == 'f32' || ts == 'bool' || ts == 'byte' || ts == 'char' || ts == 'fd' -> r = 0
    }
}

; ps-mark-inferred：遞迴標記推斷型別節點（Go markInferred type.go:1163）：
;   NamedType slot1、Slice/Array/Map slot0 = 'true' 並下鑽子節點；NullableType 頭不渲 inferred，僅下鑽。
ps-mark-inferred = (t ast, tn i64) {
    k = ast.kind-at(t, tn)
    {
        k == asp.K_NAMED_TYPE -> {
            ast.set-slot(t, tn, 1, ast.put-str(t, 'true'))
        }

        k == asp.K_SLICE_TYPE -> {
            ast.set-slot(t, tn, 0, ast.put-str(t, 'true'))
            d = ast.nd-at(t, tn)
            c = ast.kid-at(t, d.kid0)
            c > 0 -> ps-mark-inferred(t, c)
        }

        k == asp.K_ARRAY_TYPE -> {
            ast.set-slot(t, tn, 0, ast.put-str(t, 'true'))
            d = ast.nd-at(t, tn)

            #{overflow=wrap}
            e = ast.kid-at(t, d.kid0 + 1)
            e > 0 -> ps-mark-inferred(t, e)
        }

        k == asp.K_MAP_TYPE -> {
            ast.set-slot(t, tn, 0, ast.put-str(t, 'true'))
            d = ast.nd-at(t, tn)
            a = ast.kid-at(t, d.kid0)

            #{overflow=wrap}
            b = ast.kid-at(t, d.kid0 + 1)
            a > 0 -> ps-mark-inferred(t, a)
            b > 0 -> ps-mark-inferred(t, b)
        }

        k == asp.K_NULLABLE_TYPE -> {
            d = ast.nd-at(t, tn)
            c = ast.kid-at(t, d.kid0)
            c > 0 -> ps-mark-inferred(t, c)
        }

        -> {
        }
    }
}

; ps-reg-let：明示型別 let 的登記（Go parseLet：Type!=nil 時 setVarType + 尾部 markDeclared）。
ps-reg-let = (t ast, p psst, name str, tn i64) {
    tn > 0 -> {
        ps-set-var-type(p, name, ast.type-string(t, tn))
    }
    ps-mark-dcl(p, name)
}

; ── s53：頂層型別別名（TypeAlias / UnionType / FunctionType）─────────────────────
;   Go 權威：type.go:554 looksLikeEqualsTypeAlias、type.go:626 scanIsUnionTypeAlias、
;   type.go:688 parseTypeAlias、type.go:433 isFunctionTypeAliasShape、type.go:512 parseFunctionTypeAlias；
;   分派序 stmt.go:151-170（isFnDef → isFnTypeAlias → looksLikeEqAlias → let）。
;   槽位（dump.go:316-324 渲染序）：TypeAlias slot0=name、slot1=type 摘要字串；guarded CHILD Type(kid0)、Union(kid1)。
;   UnionType：單 KIDS 組 set-count slot0=types；FunctionType：KIDS slot0=params、slot1=results。
;   ⚠️ 偏離說明：Go 的 isFunctionTypeAlias 無 CTX 閘、靠第二趟 saveState 試解析驗內容；
;   noc 無法廉价試解析，統一以 p.fn == ''（頂層）閘控替代——語料函式內無 `x = (T)(T)` 別名形。

; ps-is-builtin-type：Go builtInTypeNames（type.go:540）。
ps-is-builtin-type = (s str) (r i64) {
    {
        s == 'i8' || s == 'i16' || s == 'i32' || s == 'i64' || s == 'i128' -> r = 1

        s == 'u8' || s == 'u16' || s == 'u32' || s == 'u64' || s == 'u128' -> r = 1

        s == 'f32' || s == 'f64' -> r = 1

        s == 'byte' || s == 'bool' || s == 'str' || s == 'any' -> r = 1

        -> {
        }
    }
}

; ps-alias-registered：Go p.typeAliasNames 登記表（ps-parse-type-alias/fn 式成功後 push）。
ps-alias-registered = (p psst, s str) (r i64) {
    i = 0
    (i < p.alN.len()) {
        p.alN[i].copy() == s -> r = 1

        #{overflow=wrap}
        i = i + 1
    }
}

; ps-scan-union：Go scanIsUnionTypeAlias（type.go:626）。呼叫點 current=IDENT name。look(j) ≙ ps-peek-at(p, 2 + j)。
;   depth 0 下僅容 `|` 與型別操作元；陳述結束符（NEWLINE/EOF/SEMICOLON/未配对閉括號）⇒ 別名；其他二元運算子 ⇒ 位元或運算式。
ps-scan-union = (p psst) (r i64) {
    depth = 0
    j = 0
    go = true
    (go) {
        {
            j > 1024 -> go = false

            -> {
                t = ps-peek-at(p, 2 + j)
                {
                    t == tok.NEWLINE || t == tok.EOF || t == tok.SEMICOLON -> {
                        depth == 0 -> {
                            r = 1
                            go = false
                        }
                    }

                    t == tok.LPAREN -> {
                        okk = 1
                        depth == 0 -> {
                            inside = ps-peek-at(p, 3 + j)
                            {
                                inside == tok.IDENT || inside == tok.IN || inside == tok.RPAREN -> {
                                }

                                -> okk = 0
                            }
                        }
                        okk == 1 -> depth = depth + 1
                        okk == 0 -> {
                            r = 0
                            go = false
                        }
                    }

                    t == tok.LBRACKET || t == tok.LBRACE -> depth = depth + 1

                    t == tok.RBRACKET || t == tok.RPAREN || t == tok.RBRACE -> {
                        depth == 0 -> {
                            r = 1
                            go = false
                        }

                        depth > 0 -> depth = depth - 1
                    }

                    t == tok.ADD || t == tok.SUB || t == tok.MUL || t == tok.QUO || t == tok.MOD || t == tok.SHL || t == tok.SHR || t == tok.AND || t == tok.XOR || t == tok.EQUALS || t == tok.NOT_EQUALS || t == tok.LESS || t == tok.LESS_EQUALS || t == tok.GREATER || t == tok.GREATER_EQUALS || t == tok.LOR || t == tok.LAND || t == tok.ASSIGN || t == tok.COLON || t == tok.QUESTION || t == tok.ARROW || t == tok.RARROW -> {
                        depth == 0 -> {
                            r = 0
                            go = false
                        }
                    }

                    -> {
                    }
                }
                go == true -> {

                    #{overflow=wrap}
                    j = j + 1
                }
            }
        }
    }
}

; ps-looks-eq-alias：Go looksLikeEqualsTypeAlias（type.go:554）。呼叫點 current=IDENT name、+1=ASSIGN。
ps-looks-eq-alias = (p psst) (r i64) {
    p.fn != '' -> return
    t1 = ps-peek-at(p, 2)
    t2 = ps-peek-at(p, 3)
    {
        t1 == tok.IDENT && t2 == tok.OR -> r = ps-scan-union(p)

        t1 == tok.IDENT && (t2 == tok.NEWLINE || t2 == tok.EOF || t2 == tok.SEMICOLON) -> {
            l1 = ps-lit-at(p, 2)
            ps-is-builtin-type(l1) == 1 -> r = 1
            ps-alias-registered(p, l1) == 1 -> r = 1
        }

        t1 == tok.LBRACKET && t2 == tok.RBRACKET && ps-peek-at(p, 4) == tok.IDENT -> r = 1

        t1 == tok.LBRACKET && t2 == tok.INT && ps-peek-at(p, 4) == tok.RBRACKET && ps-peek-at(p, 5) == tok.IDENT -> r = 1

        t1 == tok.QUESTION && t2 == tok.IDENT -> r = 1

        -> {
        }
    }
}

; ps-fn-alias-shape：Go isFunctionTypeAliasShape（type.go:433）。look(j) ≙ ps-peek-at(p, 2 + j)。
;   第一組 `(...)` 後必須是陳述結束符或第二組 `(...)`+陳述結束符。
ps-fn-alias-shape = (p psst) (r i64) {
    ps-peek-at(p, 2) != tok.LPAREN -> return
    depth = 0
    i = 0
    done = 0
    (done == 0 && i <= 256) {
        t = ps-peek-at(p, 2 + i)
        {
            t == tok.EOF -> done = 1

            t == tok.LPAREN -> depth = depth + 1

            t == tok.RPAREN -> {
                depth = depth - 1
                depth == 0 -> {
                    done = 1
                    nx = ps-peek-at(p, 3 + i)
                    {
                        nx == tok.NEWLINE || nx == tok.EOF || nx == tok.SEMICOLON -> r = 1

                        nx == tok.LPAREN -> {
                            d2 = 0
                            jj = i + 1
                            stop2 = 0
                            (stop2 == 0 && jj <= 256) {
                                t2 = ps-peek-at(p, 2 + jj)
                                {
                                    t2 == tok.EOF -> stop2 = 1

                                    t2 == tok.LPAREN -> d2 = d2 + 1

                                    t2 == tok.RPAREN -> {
                                        d2 = d2 - 1
                                        d2 == 0 -> {
                                            stop2 = 1
                                            n2 = ps-peek-at(p, 3 + jj)
                                            n2 == tok.NEWLINE || n2 == tok.EOF || n2 == tok.SEMICOLON -> r = 1
                                        }
                                    }

                                    -> {
                                    }
                                }

                                #{overflow=wrap}
                                jj = jj + 1
                            }
                        }

                        -> {
                        }
                    }
                }
            }

            -> {
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ps-fn-alias-inner-ok：對齊 Go isFunctionTypeAlias Step 2（type.go:440-455）的內容驗證。
;   ps-fn-alias-shape 只驗括號結構，會把 `a = (it == 90)` 這類「括號表達式」誤判成
;   函式型別別名（t7 / setbyte-fallible 實測：`TypeAlias{a, fn(it)}`）。oracle 用
;   parseFunctionType 試解析 + 錯誤計數判定；本解析器無錯誤計數，改用廉價等價判據：
;   第一組 `(...)` 內部若含【不可能出現在型別語法裡】的二元運算子（== != <= >= && ||），
;   即非合法參數列表，回 0。泛型 `<>` 不在禁止列，以免誤傷 `Vec<i64>` 等。
;   掃描從 peek(2) 的 `(` 起，追蹤深度至首組 `)` 結束（設 i=257 跳出迴圈）。
ps-fn-alias-inner-ok = (p psst) (r i64) {
    r = 1
    depth = 0
    i = 0
    (r == 1 && i <= 256) {
        t = ps-peek-at(p, 2 + i)
        {
            t == tok.EOF -> r = 0
            t == tok.LPAREN -> depth = depth + 1
            t == tok.RPAREN -> {
                depth = depth - 1
                depth == 0 -> i = 257
            }
            t == tok.EQUALS -> r = 0
            t == tok.NOT_EQUALS -> r = 0
            t == tok.LESS_EQUALS -> r = 0
            t == tok.GREATER_EQUALS -> r = 0
            t == tok.LAND -> r = 0
            t == tok.LOR -> r = 0
        }
        #{overflow=wrap}
        i = i + 1
    }
}

; ps-parse-type-alias：Go parseTypeAlias（type.go:688）。呼叫點 current=IDENT name。
;   union 形：平坦收集 `|` 分隔型別 → UnionType；單型形：slot1=typeString + CHILD Type。
ps-parse-type-alias = (t ast, p psst, name str) (idx i64) {
    ps-bump(p); 消費 IDENT
    ps-bump(p); 消費 ASSIGN
    ty = ps-parse-type(t, p)
    ut = 0
    {
        ps-peek(p) == tok.OR -> {
            mem []i64 = with-cap(4)
            ty > 0 -> mem.push(ty)
            (ps-peek(p) == tok.OR) {
                ps-bump(p); 消費 |
                (ps-peek(p) == tok.NEWLINE) {
                    ps-bump(p); union 內允許換行（Go parseTypeAlias 的 NEWLINE skip 迴圈）
                }
                m = ps-parse-type(t, p)
                m > 0 -> mem.push(m)
                m == 0 -> {

                    ; 防呆：解析不出就前進，避免卡死在 `|`
                    (ps-peek(p) != tok.EOF && ps-peek(p) != tok.NEWLINE) {
                        ps-bump(p)
                    }
                }
            }
            ut = ast.add(t, asp.K_UNION_TYPE)
            ast.set-slot(t, ut, 0, ast.put-str(t, mem.len().to-str())); header kvc 预渲染（P-COUNT：'0' 不印）
            ast.set-count(t, ut, 0, mem.len())
            k = 0
            (k < mem.len()) {
                ast.kid-add(t, ut, mem[k])

                #{overflow=wrap}
                k = k + 1
            }
            ty = 0; Go union 形 Type=nil ⇒ CHILD Type 以 0 佔位
        }

        -> {
        }
    }
    idx = ast.add(t, asp.K_TYPE_ALIAS)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    ut == 0 && ty > 0 -> ast.set-slot(t, idx, 1, ast.put-str(t, ast.type-string(t, ty)))
    ast.kid-add(t, idx, ty); guarded CHILD=Type（缺席 0 佔位）
    ast.kid-add(t, idx, ut); guarded CHILD=Union
    p.alN.push(name); Go typeAliasNames[name]=true
}

; ps-parse-ftype-param：fn 型別名的參數/回傳值解析（Go parseFunctionType 參數規則，≠ ps-parse-func 的 FD 參數）：
;   `name TYPE` ⇒ 有名帶型；裸 `IDENT` ⇒ **無名帶型**參數（Parameter{name: '', type: NamedType}，
;   s53 測得 oracle 對 `x = (or-value)` 输出 `Parameter{name: , type: or-value}`）。idx=0 表非參數起點（呼叫端防呆前進）。
ps-parse-ftype-param = (t ast, p psst) (idx i64) {
    tk = ps-peek-token(p)
    tk.typ != tok.IDENT -> return
    ps-bump(p); 消費首段 IDENT
    nxt = ps-peek(p)
    typ = 0
    {
        nxt == tok.IDENT || nxt == tok.QUESTION || nxt == tok.LBRACKET -> {

            ; 有名帶型：首段為參數名，其後為型別
            typ = ps-parse-type(t, p)
            idx = ast.add(t, asp.K_PARAMETER)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
        }

        nxt != tok.IDENT && nxt != tok.QUESTION && nxt != tok.LBRACKET -> {

            ; 裸 IDENT ⇒ 無名帶型：名字空槽 + NamedType
            nt = ast.add(t, asp.K_NAMED_TYPE)
            ast.set-slot(t, nt, 0, ast.put-str(t, tk.lit))
            typ = nt
            idx = ast.add(t, asp.K_PARAMETER)
        }

        -> {
        }
    }
    idx > 0 -> {
        ast.kid-add(t, idx, typ); CHILD=Type
        ast.kid-add(t, idx, 0); CHILD=DefaultExpr 缺席佔位
    }
}

; ps-parse-fn-type-alias：Go parseFunctionTypeAlias（type.go:512）。呼叫點 current=IDENT、+1=ASSIGN、+2=LPAREN。
ps-parse-fn-type-alias = (t ast, p psst, name str) (idx i64) {
    ps-bump(p); 消費 IDENT
    ps-bump(p); 消費 ASSIGN
    ps-bump(p); 消費 LPAREN（參數群）
    params []i64 = with-cap(4)
    (ps-peek(p) != tok.RPAREN && ps-peek(p) != tok.EOF) {
        pn = ps-parse-ftype-param(t, p)
        pn > 0 -> params.push(pn)
        pn == 0 -> ps-bump(p); 防呆
    }
    ps-bump(p); 消費 RPAREN
    outs []i64 = with-cap(4)

    ; 結果群前只跳換行（Go parseFunctionType 跳 NEWLINE 找結果群；COMMENT 屬下一陳述的 doc）；
    ;   ⚠️ 未命中第二群时必须還原 pos——吃掉陳述末換行會令頂層 doc 收集器把下行註解誤判為行尾 Comment（s53 測得）。
    sp = p.pos
    (ps-peek(p) == tok.NEWLINE) {
        ps-bump(p)
    }
    second = 0
    ps-peek(p) == tok.LPAREN -> {
        ps-bump(p)
        (ps-peek(p) != tok.RPAREN && ps-peek(p) != tok.EOF) {
            ro = ps-parse-ftype-param(t, p)
            ro > 0 -> outs.push(ro)
            ro == 0 -> ps-bump(p); 防呆
        }
        ps-bump(p); 消費第二個 RPAREN
        second = 1
    }
    second == 0 -> p.pos = sp; 單群形：退回陳述末換行
    ft = ast.add(t, asp.K_FUNCTION_TYPE)
    ast.set-slot(t, ft, 0, ast.put-str(t, params.len().to-str())); header params 预渲染
    ast.set-slot(t, ft, 1, ast.put-str(t, outs.len().to-str())); header results 预渲染
    ast.set-count(t, ft, 0, params.len())
    ast.set-count(t, ft, 1, outs.len())
    k = 0
    (k < params.len()) {
        ast.kid-add(t, ft, params[k])

        #{overflow=wrap}
        k = k + 1
    }
    m = 0
    (m < outs.len()) {
        ast.kid-add(t, ft, outs[m])

        #{overflow=wrap}
        m = m + 1
    }
    idx = ast.add(t, asp.K_TYPE_ALIAS)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    ast.set-slot(t, idx, 1, ast.put-str(t, ast.type-string(t, ft)))
    ast.kid-add(t, idx, ft); CHILD=Type
    ast.kid-add(t, idx, 0); CHILD=Union 缺席佔位
    p.alN.push(name)
}

; ps-parse-let：解析 `name = expr`（推論型別：字面量→NamedType，SliceLiteral→SliceType(NamedType)）
; ── s54：D6 算術 option 推斷（inferOptionArith）───────────────────────
;   Go 權威：src/parser/lowering.go:493 inferOptionArith（walk 於 parse 後逐 LetStatement 執行）：
;   無明示型別、非合成、值（剝括號後）為 op ∈ {+ - * / %} 的 InfixExpression 且兩側運算元
;   皆「静态可知有號整數」時，就地合成 NullableType{NamedType{base}}（不標 inferred——
;   dumper 對 NullableType 頭不印）並 setVarType(name, "?base")。
;   偏離記錄：Go 在 parse 完成後才 walk，運算元查表能看到「後方才宣告」的變數；
;   noc 單趟解析在 let 處即時查表——僅影響前向引用形（語料未見，探針釘死現狀行為）。

; ps-unwrap-grouped： mirrors Go unwrapLowerExpr（lowering.go:922）——剝尽 GroupedExpression 外殼，回傳內層節點。
ps-unwrap-grouped = (t ast, e i64) (r i64) {
    r = e
    go = true
    (go) {
        d = ast.nd-at(t, r)
        d.kind == asp.K_GROUPED_EXPRESSION -> {
            c = ast.kid-at(t, d.kid0)
            c > 0 -> r = c
            c == 0 -> go = false
        }
        d.kind != asp.K_GROUPED_EXPRESSION -> go = false
    }
}

; ps-is-arith-op： Go isOptionArithOperator（lowering.go:900）——統一 option 規則覆蓋 + - * / %。
ps-is-arith-op = (op str) (r i64) {
    r = 0
    op == '+' || op == '-' || op == '*' || op == '/' || op == '%' -> r = 1
}

; ps-lower-signed-int-name： Go lowerSignedIntName（lowering.go:936）——靜態型別字串是否可產生 option 的
;   有號整數型：拒 ''/?T 前綴；剝前導 *；取最後一個 '.' 後的裸名；僅收 {int,i8,i16,i32,i64}。
;   拒無號/i128/f32/f64/bool/byte/char/str/fd 及一切已宣告複合名（如 union 別名 num2）。
ps-lower-signed-int-name = (typ str) (r str) {
    r = ''
    typ.len-bytes() == 0 -> return
    typ.starts-with('?') -> return
    typ.starts-with('*') -> {
        r = ps-lower-signed-int-name(typ.slice-bytes(1, typ.len-bytes()))
        return
    }
    typ == 'int' || typ.ends-with('.int') -> r = 'int'
    typ == 'i8' || typ.ends-with('.i8') -> r = 'i8'
    typ == 'i16' || typ.ends-with('.i16') -> r = 'i16'
    typ == 'i32' || typ.ends-with('.i32') -> r = 'i32'
    typ == 'i64' || typ.ends-with('.i64') -> r = 'i64'
}

; ps-signed-int-operand： Go signedIntOperandType（lowering.go:860）——回傳運算元的有號整數型別名，
;   推不出回 ''。整數字面量恆 i64；識別符查 ps-var-type（FuncVarType 同款 fn→全域回落；
;   self 靠 ps-parse-method-func 預登記接收者型別，鏡像 Go lowerSelfType 讀 Results[0]）；
;   巢狀算術遞迴取較寬者（len 比較、平手取左，Go 同法）。其餘 kind（呼叫/索引/欄位…）一律拒。
ps-signed-int-operand = (t ast, p psst, e i64) (r str) {
    r = ''
    e <= 0 -> return
    u = ps-unwrap-grouped(t, e)
    d = ast.nd-at(t, u)
    {
        d.kind == asp.K_INTEGER_LITERAL -> r = 'i64'

        d.kind == asp.K_IDENTIFIER -> {
            nm = ast.str-at(t, d.s0)
            r = ps-lower-signed-int-name(ps-var-type(p, nm))
        }

        d.kind == asp.K_INFIX_EXPRESSION -> {
            op = ast.str-at(t, d.s0)
            ps-is-arith-op(op) == 1 -> {
                lt = ps-signed-int-operand(t, p, ast.kid-at(t, d.kid0))
                rt = ps-signed-int-operand(t, p, ast.kid-at(t, d.kid0 + 1))
                lt != '' && rt != '' -> {
                    r = lt
                    rt.len() > lt.len() -> r = rt
                }
            }
        }

        -> {
        }
    }
}

; ps-walk-declared： Go lowerer.declaredLocals 成員判定（lowering.go:226 walk 序登記、:249 函式重置、
;   :252 形參先入帳）——本作用域已出現的 let 目標名（含形參，無論有無型別）。
;   函式内：dcl 對（本函式 let）+ fv 對（參數/已登記區域變數）；頂層：dclT（僅頂層 let）。
ps-walk-declared = (p psst, vname str) (r i64) {
    r = 0
    d = ps-ht-get(p, 'dc:' - p.fn - ' ' - vname)
    d >= 0 -> r = 1
    r == 0 && p.fn == '' -> {
        t = ps-ht-get(p, 'dctop:' - vname)
        t >= 0 -> r = 1
    }
    r == 0 -> {
        f = ps-ht-get(p, 'fv:' - p.fn - ' ' - vname)
        f >= 0 -> r = 1
    }
}

; ps-local-type： Go localDeclaredType（lowering.go:3377）——【僅本作用域】型別查詢，
;   刻意不做 FuncVarType 的全域回退（防其他函式同名參數污染，Go 碼内事故註釋同述）。
;   回 '' = 未找到（ok=false）；正序掃描後寫覆蓋＝Go map 賦值語義。
ps-local-type = (p psst, vname str) (ty str) {
    ty = ''
    tidx = ps-ht-get(p, 'vt:' - p.fn - ' ' - vname)
    tidx >= 0 -> {
        ty = p.htTy[tidx]
        return
    }
    p.fn == '' -> {
        gidx = ps-ht-get(p, 'vt: ' - vname)
        gidx >= 0 -> ty = p.htTy[gidx]
    }
}

; ps-mk-opt-arith-type： inferOptionArith 主體。
;   ⚠️ S3（2026-10-16.4）後**不再回傳合成的 NullableType 節點**：Go 的
;   inferOptionArith 已改成只 `publishInferredType`（src/parser/lowering.go:866-869，
;   註解見 astdiskcache.go:143-148）——把 `?base` 記入語義副表 + VarTypes，
;   **AST 不帶這個語義事實**（`s.Type` 保持 nil）。故這裡恆回 0 且只登記 varType；
;   建節點會讓 dump 多出 `type: ?i64` 兩行，與 oracle 不符（t58 / t62 實測）。
;   閘門順序照 Go：①本 let 無明示/已推斷型（呼叫端 typ==0 保證 s.Type==nil）；
;   ②captureTargetAllowsOption（lowering.go:3424）：已出現（declaredLocals 成員）则必須本就是
;     ?T（型别表查無 entry 也拒——字面量 let 只入名單不入型别表）；首次出現则拒本作用域純量宣告；
;   ③運算子與兩側運算元判定；④base=較寬者。
;   成功同步 ps-set-var-type(name, "?base")（Go setVarType，影響後續推斷/閘門）。
ps-mk-opt-arith-type = (t ast, p psst, name str, val i64) (typ i64) {
    typ = 0
    declared = ps-walk-declared(p, name)
    ty = ps-local-type(p, name)
    opt = 0
    ty.starts-with('?') -> opt = 1
    okk = 0
    declared == 1 && opt == 1 -> okk = 1
    declared == 0 && opt == 1 -> okk = 1
    declared == 0 && ty == '' -> okk = 1
    okk == 1 -> {
        e = ps-unwrap-grouped(t, val)
        d = ast.nd-at(t, e)
        d.kind == asp.K_INFIX_EXPRESSION -> {
            op = ast.str-at(t, d.s0)
            ps-is-arith-op(op) == 1 -> {
                lt = ps-signed-int-operand(t, p, ast.kid-at(t, d.kid0))
                rt = ps-signed-int-operand(t, p, ast.kid-at(t, d.kid0 + 1))
                lt != '' && rt != '' -> {
                    base = lt
                    rt.len() > lt.len() -> base = rt
                    ; 只登記 varType（Go publishInferredType 的 l.p.setVarType）；
                    ; 不建 NullableType 節點——見本函式檔頭的 S3 說明。
                    ps-set-var-type(p, name, '?' - base)
                }
            }
        }
    }
}

ps-parse-let = (t ast, p psst, name str) (idx i64) {
    vcSave = p.valCtx; s67：let/賦值 RHS ⇒ 值語境（對齊 Go CTX_EXPR，驅動 MatchArm.valueCtx）
    p.valCtx = 1
    val = ps-parse-expr(t, p)
    p.valCtx = vcSave

    ; s10：RHS 落空 ⇒ 復刻 stmt.go:1306-1312（parseLetStatement 的 value==nil else 臂）：
    ;   「expected expression, got nil instead」定位在【目前 token】，且僅在【尚無任何
    ;   已報錯誤】時上報（Go 的閘門是 reportedIllegal——ILLEGAL token 已自行報錯就不重複；
    ;   Go 全程只收 ERROR 級 diags，用 eLn 非空近似同形）。
    val == 0 && ps-err-count(p) == 0 -> ps-error(p, 'expected expression, got nil instead', 'E_GENERAL')

    ; s8q：Pipeline 同位——`x = A -> B` 的【整條鏈】是 let 的 value（鏡像 Go stmt.go:1242-1260）。
    ;   值解析完後若【同位】緊接 `->`（用活 ps-peek，對齊 Go 只看 currentToken==RARROW；
    ;   `a \n -> b` 的 arrow 換行不構成 pipeline），把 value 包成獨立 IfExpression：
    ;   `A -> B -> V` 降糖為 `if A { if B { V } }`（ps-mk-standalone-if 已含 wrap-chain 遞迴）。
    ;   守衛 p.inMatch==0 排除 match 臂內（對齊 Go !CTX_MATCH_ARM）；let 恆為陳述位、結構上
    ;   不落 for-cond，故 !CTX_FOR_COND 不另設（與 ps-parse-expr-stmt (B) 同範疇）。
    ;   ⚠️ 包覆後 val 變 IF_EXPRESSION ⇒ 下方型別推斷各臂（Slice/Struct/Index/IDENT/Call）
    ;   皆不命中，不會誤推 `p = a -> 7` 的型別（對齊 oracle：該 let 無 type 欄）。
    val > 0 && p.inMatch == 0 && ps-peek(p) == tok.RARROW -> val = ps-mk-standalone-if(t, p, val)
    typ = 0

    ; SliceLiteral RHS → 建 SliceType(inferred) 包 NamedType(elemType, inferred)
    ; 復刻 Go stmt.go 中 `case *SliceLiteral: stmt.Type = &SliceType{...}` 的路徑
    val > 0 -> {
        d = ast.nd-at(t, val)
        {
            d.kind == asp.K_SLICE_LITERAL -> {
                elem = ps-elem-type-of(t, val)
                inner = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, inner, 0, ast.put-str(t, elem))
                ast.set-slot(t, inner, 1, ast.put-str(t, 'true'))
                typ = ast.add(t, asp.K_SLICE_TYPE)
                ast.set-slot(t, typ, 0, ast.put-str(t, 'true'))
                ast.kid-add(t, typ, inner)
                ps-set-var-type(p, name, '[]' - elem); Go SliceLiteral 臂同步登記「[]elem」
            }

            d.kind == asp.K_STRUCT_LITERAL -> {
                st = ast.str-at(t, d.s0)
                ps-var-type(p, name) == '' -> ps-set-var-type(p, name, st)
            }

            d.kind == asp.K_INDEX_EXPRESSION -> {

                ; Go stmt.go:1462-1494：陣列/切片索引 → 元素型別（`e0 = v[0]`）。
                ;   receiver 型別從【全域表】讀（Go p.sem.VarTypes 只含頂層變數——函式內
                ;   setVarType 只寫 FuncVarTypes，parser.go:1113-1129 ⇒ 區域 receiver
                ;   讀不到就不推斷，與 Go 同口徑）。僅在 LHS 尚無型別時設定（FuncVarType
                ;   語義 = ps-var-type 前置查），並回寫型別表（供後續推斷鏈）。
                ; ⚠️ 本臂局部變數【不得與其他臂同名（尤其不同型別）】：s7l 實測本臂 tn（i64）
                ;   與 catch-all 的 tn（str）同名會讓 codegen 串型別——ps-infer-type 回傳值被
                ;   截成形別名長度（'i64'→"3"、'char'→"4"），所有 let 推論型別全汙染，checker
                ;   卻不報錯。故本臂節點變數加 x 後綴（tnx）。
                left = ast.kid-at(t, d.kid0)
                ast.kind-at(t, left) == asp.K_IDENTIFIER -> {
                    ld = ast.nd-at(t, left)
                    recvTy = ps-g-var-type(p, ast.str-at(t, ld.s0))
                    elem = ps-idx-elem-of(recvTy)
                    ; s7v：函式內 receiver 的後備登記——僅寫型別表（不建型別節點，
                    ;   對齊 Go parse-time 不為函式內 receiver 產型別標註的行為）。
                    ;   讓後續降糖（ps-apply-index-out 的 ps-var-type）能查到鏈式推斷型別。
                    elem == '' -> {
                        recvTy2 = ps-var-type(p, ast.str-at(t, ld.s0))
                        elem2 = ps-idx-elem-of(recvTy2)
                        elem2 != '' && ps-var-type-strict(p, name) == '' -> ps-set-var-type-s7v(p, name, elem2)
                    }
                    elem != '' && ps-var-type-strict(p, name) == '' -> {
                        ; 結構化元素型別節點（對齊 Go buildType + markInferred）：
                        ;   elem 形如 `i64` / `[2]i64` / `[]i64` / `?i64`。將 `[N]X` 建為
                        ;   ArrayType{size:IntegerLiteral(N), elem: X}；`[]X` 建為
                        ;   SliceType{elem: X}；`?X` 建為 NullableType{elem: X}；其餘
                        ;   （扁平名稱）維持 NamedType。內層 X 一律建扁平 NamedType
                        ;   （巢狀結構極少出現在索引元素位；主缺口 [2]i64 已修）。
                        ;   inferred 旗標統一由 ps-mark-inferred 下鑽標記（與他處同形）。
                        ;   ⚠️ 節點變數加 ex 後綴，避免與他臂 tn（str）同名汙染（s7l 教訓）。
                        ; ⚠️ 本臂【嚴禁】直接對 elem 求值 `.byte()`，也禁用 std 的
                        ;   starts-with/index/byte-index：
                        ;     · `elem.byte(0)` 實測拿到垃圾（6102830939 而非 91）——ps.no
                        ;       巨型模組的 str.byte codegen「借用」缺陷（lx.no:114 同類陷阱）；
                        ;     · std 的 starts-with/index 內部也是對【self】取 .byte() ⇒
                        ;       同樣失真，實測 `'[2]i64'.starts-with('?')` 竟回 TRUE。
                        ;   故一律下推到 ps-elem-shape / ps-elem-arr-size / ps-elem-arr-elem
                        ;   （以 str 為參數、對【參數】取 .byte()，實測可靠）。
                        ;   len-bytes / slice-bytes 在本臂實測可靠，可直接使用。
                        ; ⚠️ 尾臂一律以 exhd 旗標守衛：裸 `-> {…}` 尾臂會被當成尾隨無條件
                        ;   陳述執行並覆寫 typ（ps.no:1082 handled 守則）。
                        exsh = ps-elem-shape(elem)
                        exhd = 0
                        exsh == 1 -> {
                            ; `?X` ⇒ NullableType{ elem: X }
                            exn = elem.len-bytes()
                            exInner = ast.add(t, asp.K_NAMED_TYPE)
                            ast.set-slot(t, exInner, 0, ast.put-str(t, elem.slice-bytes(1, exn)))
                            typ = ast.add(t, asp.K_NULLABLE_TYPE)
                            ast.kid-add(t, typ, exInner)
                            exhd = 1
                        }
                        exhd == 0 && exsh == 2 -> {
                            ; `[]X` ⇒ SliceType{ inferred, elem: X }
                            exn = elem.len-bytes()
                            exInner = ast.add(t, asp.K_NAMED_TYPE)
                            ast.set-slot(t, exInner, 0, ast.put-str(t, elem.slice-bytes(2, exn)))
                            typ = ast.add(t, asp.K_SLICE_TYPE)
                            ast.kid-add(t, typ, exInner)
                            exhd = 1
                        }
                        exhd == 0 && exsh == 3 -> {
                            ; `[N]X` ⇒ ArrayType{size:IntegerLiteral(N), inferred, elem: X}
                            exszs = ps-elem-arr-size(elem)
                            exel = ps-elem-arr-elem(elem)
                            exsz = ast.add(t, asp.K_INTEGER_LITERAL)
                            ast.set-slot(t, exsz, 0, ast.put-str(t, exszs))
                            ; raw：Go 側由詞法帶出原文（dump 實測印 `raw: 2`），
                            ;   與 value 同串；留空會讓 dump 少印 `raw:` 段（1 行差）
                            ast.set-slot(t, exsz, 1, ast.put-str(t, exszs))
                            exInner = ast.add(t, asp.K_NAMED_TYPE)
                            ast.set-slot(t, exInner, 0, ast.put-str(t, exel))
                            typ = ast.add(t, asp.K_ARRAY_TYPE)
                            ast.kid-add(t, typ, exsz)
                            ast.kid-add(t, typ, exInner)
                            exhd = 1
                        }
                        exhd == 0 -> {
                            ; 扁平 NamedType{ elem }（預設，維持 test-let-idx-elem-infer 的 i64 行為）
                            typ = ast.add(t, asp.K_NAMED_TYPE)
                            ast.set-slot(t, typ, 0, ast.put-str(t, elem))
                        }
                        ps-mark-inferred(t, typ)
                        ps-set-var-type(p, name, elem)
                    }
                }
            }

            ; s66：`x = y`（RHS 為裸識別符）→ 把 y 的已知型別傳播給 x。
            ;   鏡像 Go stmt.go:1410-1433：這是賦值鏈型別傳遞的一環（dec-valid 的
            ;   `i = 0` → `j = i`）；若 j 不登記型別，後續 `p-opt = j + 1` 的
            ;   signedIntOperandType 查不到 j，inferOptionArith 保守跳過、p-opt 退成
            ;   plain i64，ok 臂永不命中。
            ;   ⚠️ 兩個閘門照 Go：
            ;     ① 只傳播【有號整數】int/i8/i16/i32/i64（含 `?` 前綴的 ?T，
            ;        剝前綴後判定）——刻意不碰 slice/struct/map 等聚合型別（避免
            ;        改變 `x = y` 的拷貝／引用語意），也刻意不碰 u8/bool/f64/str；
            ;     ② 僅在 x 尚無型別時登記（!ok || existing == ""），不覆蓋既有型別。
            ;   ⚠️ 節點變數一律 iv 前綴，避免與他臂同名（s7l 串型別教訓）。
            d.kind == asp.K_IDENTIFIER -> {
                ivs = ast.str-at(t, d.s0)
                ; ⚠️ `it` 例外：本解析器會把 match 臂綁定型別暫寫進 varType 表
                ;   （ps.no:7049，臂末還原），但 Go 的 FuncVarType 看不到臂綁定
                ;   （它是合成暫存，不在語義表）。少了這個例外，`ok -> { a = it }`
                ;   會把臂綁定型別傳播給 a（t63 實測與 oracle 不符）。
                ; ⚠️ s7z3：`self`（`.` 接收者簡寫）同 `it` 例外。Go 的 selfParam 是在
                ;   detectImplicitGeneric／setVarType **之後**才插進 Results（decl.go:2034-2040），
                ;   故 FuncVarType(curFunc,'self') 恆為空 ⇒ `n = .` 不推斷、`tmp = n` 亦不
                ;   傳播（級聯）。noc 為了解析 `.field` 而在 ps-parse-method-func 預登記
                ;   self（ps.no:4195），少了這個例外 `n = .` 會被推成 `int`（int.no 實測）。
                ivt = ''
                ivs != 'it' && ivs != 'self' -> ivt = ps-var-type-strict(p, ivs)
                ; s7w：`_`（blank LHS）不接收識別符型別傳播——對齊 oracle：
                ;   `_ = x` 永不帶 type（無論 x 是定型別 let 還是 `?=` 解箱）。
                ;   僅守衛內層（保留 K_IDENTIFIER 臂匹配）⇒ `_ = x` 不落到 catch-all
                ;   的 ps-infer-type（否則仍會建 NamedType）。
                ivt != '' && name != '_' -> {
                    ivb = ivt
                    ivsh = ps-elem-shape(ivt)
                    ivsh == 1 -> ivb = ivt.slice-bytes(1, ivt.len-bytes())
                    ivsig = 0
                    ivb == 'int' -> ivsig = 1
                    ivb == 'i8' -> ivsig = 1
                    ivb == 'i16' -> ivsig = 1
                    ivb == 'i32' -> ivsig = 1
                    ivb == 'i64' -> ivsig = 1
                    ivsig == 1 -> {
                        ivx = ps-var-type-strict(p, name)
                        ivx == '' -> {
                            ivsh == 1 -> {
                                ; `?T` ⇒ NullableType{ NamedType{T} }
                                ivin = ast.add(t, asp.K_NAMED_TYPE)
                                ast.set-slot(t, ivin, 0, ast.put-str(t, ivb))
                                typ = ast.add(t, asp.K_NULLABLE_TYPE)
                                ast.kid-add(t, typ, ivin)
                            }
                            ivsh == 0 -> {
                                typ = ast.add(t, asp.K_NAMED_TYPE)
                                ast.set-slot(t, typ, 0, ast.put-str(t, ivt))
                            }
                            ps-mark-inferred(t, typ)
                            ps-set-var-type(p, name, ivt)
                        }
                    }
                }
            }

            -> {
                tn = ps-infer-type(t, val)
                tn != '' -> {
                    typ = ast.add(t, asp.K_NAMED_TYPE)
                    ast.set-slot(t, typ, 0, ast.put-str(t, tn))
                    ast.set-slot(t, typ, 1, ast.put-str(t, 'true'))
                }
            }
        }
    }

    ; s51：同檔裸名函式呼叫回傳型別推斷（Go stmt.go:1502-1533 CallExpression 臂）。
    ;   仅当无明示型別且未被字面量/切片臂填上 typ 時触发；顺序依赖：签名字表只含【已解析完】的函数
    ;   （故前向引用/递归调用推不到，与 Go 一致）。克隆 = 把 p.pos 跳到回传值型別起点重跑 ps-parse-type，
    ;   未采用（gate 否决/被过滤）则孤儿节点自然不被渲染（零回归保证同 typedecl 守则）。
    typ == 0 && val > 0 -> {
        vd = ast.nd-at(t, val)
        vd.kind == asp.K_CALL_EXPRESSION -> {
            fc = ast.kid-at(t, vd.kid0)
            ast.kind-at(t, fc) == asp.K_IDENTIFIER -> {
                fnd = ast.nd-at(t, fc)
                fname = ast.str-at(t, fnd.s0)
                tp = ps-sig-find(p, fname)
                tp >= 0 -> {
                    oldpos = p.pos
                    p.pos = tp
                    tn2 = ps-parse-type(t, p)
                    p.pos = oldpos
                    ts2 = ''
                    tn2 > 0 -> ts2 = ast.type-string(t, tn2)
                    tn2 > 0 && ps-filter-ok(t, tn2, ts2) == 1 -> {
                        keep = 0
                        ps-is-declared(p, name) == 0 -> {
                            keep = 1
                            ps-set-var-type(p, name, ts2)
                        }

                        -> {

                            ; 已宣告：option 仅更新 varType 不盖型別注标（Go stmt.go:1518-1521）；
                            ;   非 option 当现有型別为空或 i64 时才补（Go stmt.go:1523-1530）。
                            iso = 0
                            ast.kind-at(t, tn2) == asp.K_NULLABLE_TYPE -> iso = 1
                            iso == 1 -> {
                                ps-set-var-type(p, name, ts2)
                            }
                            iso == 0 -> {
                                ex = ps-var-type-strict(p, name)
                                ex == '' || ex == 'i64' -> {
                                    keep = 1
                                    ps-set-var-type(p, name, ts2)
                                }
                            }
                        }
                        keep == 1 -> {
                            ps-mark-inferred(t, tn2)
                            typ = tn2
                        }
                    }
                }
            }

            ; s58：方法呼叫回傳型別推斷（Go returnTypeFromCallExpr 的 DotExpression 臂）——
            ;   ① rty!=''：recv 是 IDENT 變數且 varType 已知 → methodSignatures['recvTy.method']
            ;      （如 `p = view-point{…}`）；② s8r：rty==''：recv 是 IDENT 但非變數 → 視為
            ;      套件限定名，查 msig['recv.method']（如 `doc = toml.new()`）。
            ;   hashmap 鍵換算、鏈式接收者（self.pool.method）等形另見後續增補。
            ;   克隆舆上方裸名臂同法（跳 token 重跑 ps-parse-type，未采用即孤兒零回歸）。
            ast.kind-at(t, fc) == asp.K_DOT_EXPRESSION -> {
                fd = ast.nd-at(t, fc)
                rc = ast.kid-at(t, fd.kid0)
                ast.kind-at(t, rc) == asp.K_IDENTIFIER -> {
                    rd = ast.nd-at(t, rc)
                    rty = ps-var-type(p, ast.str-at(t, rd.s0))
                    rty != '' -> {
                        mkey = rty + '.' + ast.str-at(t, fd.s0)
                        tp2 = ps-msig-find(p, mkey)
                        tp2 >= 0 -> {
                            oldpos2 = p.pos
                            p.pos = tp2
                            tn3 = ps-parse-type(t, p)
                            p.pos = oldpos2
                            ; s8y 規則B1：Go returnTypeFromCallExpr 的 dot 分支以 dot.Property
                            ;   剝 `?`（type.go:192/199/229 stripOperatorOverloadReturn）⇒
                            ;   重載名（_mul 等）呼叫點推論 bigint 而非 ?bigint。
                            tn3 = ps-unwrap-op-overload-type(t, ast.str-at(t, fd.s0), tn3)
                            ts3 = ''
                            tn3 > 0 -> ts3 = ast.type-string(t, tn3)
                            tn3 > 0 && ps-filter-ok(t, tn3, ts3) == 1 -> {
                                keep2 = 0
                                ps-is-declared(p, name) == 0 -> {
                                    keep2 = 1
                                    ps-set-var-type(p, name, ts3)
                                }

                                -> {
                                    iso2 = 0
                                    ast.kind-at(t, tn3) == asp.K_NULLABLE_TYPE -> iso2 = 1
                                    iso2 == 1 -> {
                                        ps-set-var-type(p, name, ts3)
                                    }
                                    iso2 == 0 -> {
                                        ex2 = ps-var-type-strict(p, name)
                                        ex2 == '' || ex2 == 'i64' -> {
                                            keep2 = 1
                                            ps-set-var-type(p, name, ts3)
                                        }
                                    }
                                }
                                keep2 == 1 -> {
                                    ps-mark-inferred(t, tn3)
                                    typ = tn3
                                }
                            }
                        }
                    }

                    ; s8r：module-path 接收者（Go type.go returnTypeFromCallExpr 的 module-path 臂）——
                    ;   當 recv IDENT【不是】變數（ps-var-type 空）時，把它當【套件限定名】，
                    ;   查全名 `recv.method`（如 toml.new = () (doc toml-doc) registered as ms:toml.new）。
                    ;   克隆舆 rty!='' 臂同法（跳 token 重跑 ps-parse-type，未采用即孤兒零回歸）。
                    ;   ⚠️ 本臂局部變數一律 q 後綴，避免舆 rty!='' 臂同名串型別（s7l 教訓）。
                    rty == '' -> {
                        mq = ast.str-at(t, rd.s0) + '.' + ast.str-at(t, fd.s0)
                        tpq = ps-msig-find(p, mq)
                        tpq >= 0 -> {
                            oldposq = p.pos
                            p.pos = tpq
                            tnq = ps-parse-type(t, p)
                            p.pos = oldposq
                            ; s8y 規則B1：同 rty≠'' 臂——Go dot 分支統一剝 `?`，module-path 鍵
                            ;   （`pkg._mul`）命中時 property 仍為 dot.Property（fd.s0）。
                            tnq = ps-unwrap-op-overload-type(t, ast.str-at(t, fd.s0), tnq)
                            tsq = ''
                            tnq > 0 -> tsq = ast.type-string(t, tnq)
                            tnq > 0 && ps-filter-ok(t, tnq, tsq) == 1 -> {
                                keepq = 0
                                ps-is-declared(p, name) == 0 -> {
                                    keepq = 1
                                    ps-set-var-type(p, name, tsq)
                                }

                                -> {
                                    isoq = 0
                                    ast.kind-at(t, tnq) == asp.K_NULLABLE_TYPE -> isoq = 1
                                    isoq == 1 -> {
                                        ps-set-var-type(p, name, tsq)
                                    }
                                    isoq == 0 -> {
                                        exq = ps-var-type-strict(p, name)
                                        exq == '' || exq == 'i64' -> {
                                            keepq = 1
                                            ps-set-var-type(p, name, tsq)
                                        }
                                    }
                                }
                                keepq == 1 -> {
                                    ps-mark-inferred(t, tnq)
                                    typ = tnq
                                }
                            }
                        }
                    }
                }

                ; s8v-dom：鏈式接收者 `self.field.method(...)`（Go resolveReceiverType 的
                ;   DotExpression 臂，type.go:47-54）——recv 是 DotExpression `self.field` 時，
                ;   先由 structFields 查出欄位型別（self 型別取自 ps-var-type('self')＝方法接收者
                ;   型別，於 ps-parse-method-func 預登），再以 `fieldTy.method` 查 msig 推回傳型別。
                ;   ⚠️ 純增量：僅在 rc 為 DotExpression（既有 IDENT 臂不觸發）時才補；節點變數 c 後綴。
                ast.kind-at(t, rc) == asp.K_DOT_EXPRESSION -> {
                    rd2 = ast.nd-at(t, rc)
                    rc2 = ast.kid-at(t, rd2.kid0)
                    ast.kind-at(t, rc2) == asp.K_IDENTIFIER -> {
                        rc2d = ast.nd-at(t, rc2)
                        ast.str-at(t, rc2d.s0) == 'self' -> {
                            snm = ps-var-type(p, 'self')
                            fnm = ast.str-at(t, rd2.s0)
                            fty = ''
                            snm != '' && fnm != '' -> fty = ps-struct-field-type(p, snm, fnm)
                            fty != '' -> {
                                mkeyc = fty + '.' + ast.str-at(t, fd.s0)
                                tpc = ps-msig-find(p, mkeyc)
                                tpc >= 0 -> {
                                    oldposc = p.pos
                                    p.pos = tpc
                                    tnc = ps-parse-type(t, p)
                                    p.pos = oldposc
                                    ; s8y 規則B1：鏈式接收者臂同受 Go dot 分支剝 `?` 語意管轄
                                    tnc = ps-unwrap-op-overload-type(t, ast.str-at(t, fd.s0), tnc)
                                    tsc = ''
                                    tnc > 0 -> tsc = ast.type-string(t, tnc)
                                    tnc > 0 && ps-filter-ok(t, tnc, tsc) == 1 -> {
                                        keepc = 0
                                        ps-is-declared(p, name) == 0 -> {
                                            keepc = 1
                                            ps-set-var-type(p, name, tsc)
                                        }

                                        -> {
                                            isoc = 0
                                            ast.kind-at(t, tnc) == asp.K_NULLABLE_TYPE -> isoc = 1
                                            isoc == 1 -> {
                                                ps-set-var-type(p, name, tsc)
                                            }
                                            isoc == 0 -> {
                                                exc = ps-var-type-strict(p, name)
                                                exc == '' || exc == 'i64' -> {
                                                    keepc = 1
                                                    ps-set-var-type(p, name, tsc)
                                                }
                                            }
                                        }
                                        keepc == 1 -> {
                                            ps-mark-inferred(t, tnc)
                                            typ = tnc
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    ; to-vec 登記（Go collectLocalTypes ②，lowering.go:671-676）：RHS 為
    ;   `X.to-vec()` / `X.to-vec` 時登記 `[]elem`（to-vec 回傳 slice）。
    ;   ⚠️ 僅函式內（p.fn != ''）登記——鏡像 Go 只掃函式體（gatherLetsInFuncScope），
    ;   頂層 to-vec 不登記 ⇒ 頂層 `res = av[i]` 不降糖（t-tv-glob 實測對齊）。
    ;   ⚠️ 只寫型別表、不建型別節點（CTL dump：to-vec let 的 LetStatement 無 type 欄；
    ;   ps-infer-type 對呼叫形回 ''、s58 對 `[n]t.to-vec` 泛型鍵 miss ⇒ typ 恆 0）。
    ;   鏈式 `bv=b.to-vec(); cv=bv.to-vec()`：ps-to-vec-elem 經 ps-var-type 查到前筆。
    ;   ⚠️ 節點變數 tvE 前綴，避免與他臂同名串型別（s7l 教訓）。
    val > 0 && p.fn != '' -> {
        tvE = ps-to-vec-elem(t, p, val)
        tvE != '' && ps-var-type(p, name) == '' -> ps-set-var-type(p, name, '[]' - tvE)
    }

    ; s54：根為有號整數算術的無型別綁定 → 合成 `?base`（Go inferOptionArith）。
    ;   ⚠️ S3（2026-10-16.4）後**本解析器不合成、也不預先登記 varType**：
    ;     · AST 側：Go 改成只 `publishInferredType`（lowering.go:866-869），
    ;       `s.Type` 保持 nil ⇒ dump 不該出現 `?T`（見 ps-mk-opt-arith-type 檔頭）。
    ;     · varType 側：Go 的 inferOptionArith 是【解析完成後的另一個 pass】，
    ;       所以同一函式裡後面的 let 在解析時**看不到**前面算術綁定的 `?T`
    ;       （t37：`#{overflow=wrap} a = n + 1` 之後的 `b = a` oracle 無型別）。
    ;       本檔是單遍解析器，若在這裡就 setVarType('?i64')，`b = a` 會錯誤地
    ;       傳播出 `?i64`。故這一步整體留空，待二階段 port 時再接。

    ; Go stmt.go:1586-1594：把（可能為推斷的）stmt.Type **補登記**進語義表，
    ;   使 FuncVarType 可見。缺這一步時，裸標量字面量推斷出的型別只寫進
    ;   stmt.Type，`x = y` 的傳播與 signedIntOperandType 都查不到
    ;   （t66 `_ = a`、t33 `x = v` 實測與 oracle 不符）。
    ;   ⚠️ 僅在變數尚無型別時補登記：字面量推斷不是用戶意圖，對已宣告的變數
    ;   （如 `?i64` 參數）寫 `v = 1` 時若覆寫成 i64 會讓 option 窮盡性檢查失效。
    ;   ⚠️ existing 查詢走 ps-var-type-strict（鏡 Go stmt.go:1604 讀 FuncVarType）：
    ;     切片/陣列方法參數經 s8v 只登記在 vt7（非嚴格），若這裡用非嚴格 ps-var-type
    ;     會看到 vt7 的參數型別而誤判「已有型別」⇒ 跳過補登記 ⇒ 參數永不進嚴格表 ⇒
    ;     其後 `x = param` 的識別符傳播查不到 param（byte.no `from = 0` 之後 `i = from`
    ;     漏推 i64）。Go 側 FuncVarType 對切片方法參數恆空（parseArrayTypeMethodDefinition
    ;     不登記）⇒ 一定補登記 ⇒ 傳播成功。
    typ != 0 -> {
        tsx = ast.type-string(t, typ)
        tsx != '' && ps-var-type-strict(p, name) == '' -> ps-set-var-type(p, name, tsx)
    }

    idx = ast.add(t, asp.K_LET_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    ast.kid-add(t, idx, typ)
    ast.kid-add(t, idx, val)
    ps-mark-dcl(p, name); Go parseLet 尾部：恒記 DeclaredVars
    ps-mark-ifd(p, name); IsFuncDeclared（含值 let，Go stmt.go:1599）
    idx
}

; ps-parse-arr-lit：在**陣列型別上下文**下直接把 RHS `[e1, …, eN]` 建為
;   ArrayLiteral{size, elements, wasSliceLiteral: true}（不經 SliceLiteral 中转）。
;   對應 Go stmt.go:1210-1218：ArrayType.Size>0 且 RHS 為 SliceLiteral 時的轉換。
;   kid 序：child0=Size（沿用型別側的 sz 節點），child1..N=Elements（KIDS 迭代）。
ps-parse-arr-lit = (t ast, p psst, sz i64) (idx i64) {
    ps-skip-trivia(p)
    ps-expect(p, tok.LBRACKET)
    els []i64 = with-cap(4)
    ps-skip-trivia(p)
    {
        ps-peek(p) == tok.RBRACKET -> {
            ps-bump(p)
        }

        -> {
            (ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.EOF) {
                pos0 = p.pos
                e = ps-parse-expr-prec(t, p, 0)
                e > 0 -> els.push(e)
                ps-skip-trivia(p)
                ps-peek(p) == tok.COMMA -> {
                    ps-bump(p)
                    ps-skip-trivia(p)
                }
                p.pos == pos0 -> ps-bump(p)
            }
            ps-expect(p, tok.RBRACKET)
        }
    }
    idx = ast.add(t, asp.K_ARRAY_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, els.len().to-str())); elements
    ast.set-slot(t, idx, 1, ast.put-str(t, 'true')); wasSliceLiteral
    ast.set-count(t, idx, 0, els.len())
    ast.kid-add(t, idx, sz); Size（child0）
    m = 0
    (m < els.len()) {
        ast.kid-add(t, idx, els[m])

        #{overflow=wrap}
        m = m + 1
    }
}

; ps-is-map-assign-let：非破壞性前探——判斷 `name [K]V =`（map 標註【含值】）。
;   起點 p 於 name（IDENT）。鑑別 `[ K ]` 且 K 為內建型別名（同 ps-parse-type 的 [K]V 臂）。
;   V 可為複合型別：從 +4 起掃描型別語法（前導 `[]`/`[*T`/`&T`/巢狀 `[K]V` 括號群），
;   停在 base IDENT 之後一個 token；該 token 為 `=` ⇒ 回 1；換行/EOF/其他 ⇒ 裸宣告 `name [K]V` ⇒ 回 0。
;   ⚠️ s8u：舊 map 臂守衛 +5==ASSIGN 只認單 IDENT V；泛化 V 遞迴後須以此前探補回 `=` 判別，
;     否則裸 map 宣告（無 `=`）誤入、吞掉後隨陳述（nested-container-clone.no 實測回歸）。
ps-is-map-assign-let = (p psst) (res i64) {
    res = 0
    ps-peek-at(p, 1) == tok.LBRACKET && ps-peek-at(p, 2) == tok.IDENT && ps-peek-at(p, 3) == tok.RBRACKET && ps-is-builtin-type(ps-lit-at(p, 2)) == 1 -> {
        j = 4
        scan = 1
        (scan == 1) {
            tkj = ps-peek-at(p, j)
            tkj == tok.EOF -> scan = 0
            tkj == tok.MUL || tkj == tok.AND || tkj == tok.STAR_STAR -> j = j + 1
            tkj == tok.LBRACKET -> {
                ; 跳到配對 RBRACKET（樸素取首個 ]：巢狀 map 值型別極少見，失配⇒不回 1⇒退回通用路、無回歸）
                k = j + 1
                (ps-peek-at(p, k) != tok.RBRACKET && ps-peek-at(p, k) != tok.EOF) {
                    k = k + 1
                }
                j = k + 1
            }
            tkj == tok.IDENT -> {
                j = j + 1
                scan = 0
            }
            ; ⚠️ 未知 token（換行/ASSIGN/其他）⇒ 型別掃描中止。此else【不可】寫成裸 `-> scan = 0`——
            ;   ps.no 塊內各 `cond -> stmt` 為互相獨立之 bare-if，裸 `->` 只掛在最末 `tkj==IDENT` 臂
            ;   ⇒ 任何非 IDENT token（含 `[`）都會誤中止掃描。須顯式列出所有已處理 token 之補集。
            tkj != tok.EOF && tkj != tok.MUL && tkj != tok.AND && tkj != tok.STAR_STAR && tkj != tok.LBRACKET && tkj != tok.IDENT -> scan = 0
        }
        ps-peek-at(p, j) == tok.ASSIGN -> res = 1
    }
    res
}

; ps-parse-map-lit：在 **Map 型別上下文**下把 RHS `{ k1: v1, … }` 建為
;   MapLiteral{pairs}，對應 Go parseMapLiteral。
;   kid 序（遵從 dump 源碼序）：child0..N-1 = MapPair（KIDS 迭代），最末 kid = MapType（CHILD）。
;   注意舆 ArrayLiteral 相反：MapLiteral 的 KIDS 在前、CHILD(MapType) 在後。
ps-parse-map-lit = (t ast, p psst, mt i64) (idx i64) {
    ps-skip-trivia(p)
    ps-expect(p, tok.LBRACE)
    pvs []i64 = with-cap(4); 每個 MapPair 節點索引
    {
        ps-peek(p) == tok.RBRACE -> {
            ps-bump(p); 空 map {}
        }

        -> {
            (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
                pos0 = p.pos
                ps-skip-trivia(p)
                k = ps-parse-expr-prec(t, p, 0)
                ps-skip-trivia(p)
                ps-expect(p, tok.COLON)
                ps-skip-trivia(p)
                v = ps-parse-expr-prec(t, p, 0)

                ; MapPair{Key, Value}：裸標頭 + 兩 kid（Key=child0、Value=child1）
                mp = ast.add(t, asp.K_MAP_PAIR)
                ast.kid-add(t, mp, k)
                ast.kid-add(t, mp, v)
                mp > 0 -> pvs.push(mp)
                ps-skip-trivia(p)
                ps-peek(p) == tok.COMMA -> {
                    ps-bump(p)
                    ps-skip-trivia(p)
                }
                p.pos == pos0 -> ps-bump(p)
            }
            ps-expect(p, tok.RBRACE)
        }
    }
    idx = ast.add(t, asp.K_MAP_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, pvs.len().to-str())); pairs（OF-LEN 字串槽）
    ast.set-count(t, idx, 0, pvs.len()); KIDS 迭代數
    m = 0
    (m < pvs.len()) {
        ast.kid-add(t, idx, pvs[m])

        #{overflow=wrap}
        m = m + 1
    }
    ast.kid-add(t, idx, mt); MapType（CHILD，永遠排最後）
}

; ps-is-struct-lit：判斷【目前 pos 為 LBRACE】起是否為結構體字面量形：
;   空 `{}` 或 `{ IDENT : … }`（首個非 trivia token 為 IDENT 且紧跟 COLON）。
;   match 用 `->`、enum 用 `,`/`=`，皆不會误中此形。不消耗 p.pos。
ps-is-struct-lit = (p psst) (r i64) {
    r = 0

    #{index-out=zero}
    p.toks[p.pos].typ == tok.LBRACE -> {

        ; 定位首個非 trivia token
        #{overflow=wrap}
        i = p.pos + 1
        go = true
        (go && i < p.toks.len()) {

            #{index-out=zero}
            tt = p.toks[i].typ
            tt == tok.NEWLINE -> {

                #{overflow=wrap}
                i = i + 1
            }
            tt == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            -> go = false
        }

        #{index-out=zero}
        t1 = p.toks[i].typ
        t1 == tok.RBRACE -> r = 1
        t1 == tok.IDENT -> {

            ; IDENT 後首個非 trivia token 必須是 COLON
            #{overflow=wrap}
            j = i + 1
            go2 = true
            (go2 && j < p.toks.len()) {

                #{index-out=zero}
                tj = p.toks[j].typ
                tj == tok.NEWLINE -> {

                    #{overflow=wrap}
                    j = j + 1
                }
                tj == tok.COMMENT -> {

                    #{overflow=wrap}
                    j = j + 1
                }

                -> go2 = false
            }

            #{index-out=zero}
            t2 = p.toks[j].typ
            t2 == tok.COLON -> r = 1
        }
    }
}

; ps-dotted-name：把 `net.Conn` / `a.b.C` 的 DotExpression 链重組為點分型名字串。
;   DotExpression：slot0=property 名、kid0=Receiver（递归展开）；Identifier：slot0=名。
;   其他節點 → 回退 node-string（不该出现在限定名的位置）。
ps-dotted-name = (t ast, n i64) (r str) {
    r = ''
    n <= 0 -> return
    d = ast.nd-at(t, n)
    {
        d.kind == asp.K_DOT_EXPRESSION -> {
            rc = 0
            d.nkid > 0 -> rc = ast.kid-at(t, d.kid0)
            r = ps-dotted-name(t, rc) + '.' + ast.str-at(t, d.s0)
        }

        d.kind == asp.K_IDENTIFIER -> r = ast.str-at(t, d.s0)

        -> r = ast.node-string(t, n)
    }
}

; ps-parse-struct-lit：把 `{ field: val, … }` 建為 StructLiteral{type, fields}。
;   slot0=型别名(字串)、slot1=fields 數(OF-LEN 字串槽)、count0=KIDS 迭代數；kid 序=各 StructField。
;   每個 StructField：slot0=name、kid0=Type(0 占位)、kid1=Value（對應 dump CHILD 序）。
ps-parse-struct-lit = (t ast, p psst, ty str) (idx i64) {
    ps-expect(p, tok.LBRACE)
    flds []i64 = with-cap(4); 每個 StructField 節點索引
    {
        ps-peek(p) == tok.RBRACE -> {
            ps-bump(p); 空 {}
        }

        -> {
            (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
                pos0 = p.pos
                ps-skip-trivia(p)
                ft = ps-peek-token(p)
                fname = ft.lit
                ps-peek(p) == tok.IDENT -> ps-bump(p); 消費欄位名
                ps-skip-trivia(p)
                val = 0
                ps-peek(p) == tok.COLON -> {
                    ps-bump(p); 消費 :
                    ps-skip-trivia(p)
                    val = ps-parse-expr-prec(t, p, 0)
                }

                ; StructField{name}：裸標頭 + [Type=0 占位, Value]
                sf = ast.add(t, asp.K_STRUCT_FIELD)
                ast.set-slot(t, sf, 0, ast.put-str(t, fname))
                ast.set-slot(t, sf, 1, ast.put-str(t, '0')); arraySize（kvn NON-ZERO：'0' → 略過）
                ast.kid-add(t, sf, 0)
                ast.kid-add(t, sf, val)
                sf > 0 -> flds.push(sf)
                ps-skip-trivia(p)
                ps-peek(p) == tok.COMMA -> {
                    ps-bump(p)
                    ps-skip-trivia(p)
                }
                p.pos == pos0 -> ps-bump(p)
            }
            ps-expect(p, tok.RBRACE)
        }
    }
    idx = ast.add(t, asp.K_STRUCT_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, ty)); type
    ast.set-slot(t, idx, 1, ast.put-str(t, flds.len().to-str())); fields（OF-LEN 字串槽）
    ast.set-count(t, idx, 0, flds.len()); KIDS 迭代數
    m = 0
    (m < flds.len()) {
        ast.kid-add(t, idx, flds[m])

        #{overflow=wrap}
        m = m + 1
    }
}

; ps-intlit-hex：整數字面量原始文字是否為 `0x`/`0X` 十六進位形（Go stmt.go:1233 口徑）。
;   僅按【進位制前綴】判定，不看數值範圍（與 ps-int-lit-value 的 base 偵測同一寫法）。
ps-intlit-hex = (raw str) (r i64) {
    r = 0
    h0-opt = raw.byte(0)
    h0 = h0-opt: {
        ok -> it
        -> 0
    }
    h1-opt = raw.byte(1)
    h1 = h1-opt: {
        ok -> it
        -> 0
    }
    raw.len-bytes() > 2 && h0 == 48 && (h1 == 120 || h1 == 88) -> r = 1
}

; ps-elem-type-of：从 SliceLiteral 的首元素推論元素型别名（空切片默认 i64）
;   規則同 Go stmt.go:1274-1300：IntegerLiteral→i64（十六進位 0x⇒byte）, Float→f64,
;   String→str, Bool→bool, Char→char, default→i64。
ps-elem-type-of = (t ast, sl i64) (r str) {
    r = 'i64'
    d = ast.nd-at(t, sl)
    d.nkid <= 0 -> return
    firstKid = ast.kid-at(t, d.kid0)
    firstKid <= 0 -> return
    e = ast.nd-at(t, firstKid)
    {
        e.kind == asp.K_INTEGER_LITERAL -> {

            ; Go stmt.go:1279-1288：0x/0X 十六進位元素⇒ byte，否則 i64
            raw = ast.str-at(t, ast.nd-s(e, 1))
            r = 'i64'
            ps-intlit-hex(raw) == 1 -> r = 'byte'
        }

        e.kind == asp.K_FLOAT_LITERAL -> r = 'f64'

        e.kind == asp.K_STRING_LITERAL -> r = 'str'

        e.kind == asp.K_BOOLEAN_LITERAL -> r = 'bool'

        e.kind == asp.K_CHAR_LITERAL -> r = 'char'

        -> r = 'i64'
    }
}

; ps-infer-type：依 RHS 字面量種類推論預設型別（§5.3.2 的 desugar 路徑）。
;   回 '' = 不推斷（Oracle 對非标量 RHS 不建 NamedType）。
ps-infer-type = (t ast, val i64) (r str) {
    r = ''
    val <= 0 -> return
    d = ast.nd-at(t, val)
    {
        d.kind == asp.K_INTEGER_LITERAL -> {

            ; Go stmt.go:1229-1240：十六進位字面量（0xNN）推 byte，十進位推 i64
            raw = ast.str-at(t, ast.nd-s(d, 1))
            r = 'i64'
            ps-intlit-hex(raw) == 1 -> r = 'byte'
        }

        d.kind == asp.K_FLOAT_LITERAL -> r = 'f64'

        d.kind == asp.K_BOOLEAN_LITERAL -> r = 'bool'

        d.kind == asp.K_STRING_LITERAL -> r = 'str'

        d.kind == asp.K_CHAR_LITERAL -> r = 'char'

        -> r = ''
    }
}

; ps-idx-elem-of：從已登記型別串取索引元素型別——鏡像 Go stmt.go:1470-1478：
;   `[]X` → X（切片，剝前綴）／`[N]X` → X（定長陣列，取第一個 `]` 之後）。
;   非陣列/切片形（含長度不足）⇒ ''。⚠️ 算術一律預算（內聯算術作實參會污染呼叫 ABI）。
ps-idx-elem-of = (ty str) (r str) {
    r = ''
    n = ty.len-bytes()
    c0-opt = ty.byte(0)
    c0 = c0-opt: {
        ok -> it
        -> 0
    }
    n > 2 -> c0 == 91 -> {
        c1-opt = ty.byte(1)
        c1 = c1-opt: {
            ok -> it
            -> 0
        }
        c1 == 93 -> {
            ; []X：X = ty[2..n]
            r = ty.slice-bytes(2, n)
        }
        c1 != 93 -> {
            ; [N]X：掃到第一個 ]（93）後取尾部
            i = 2
            go = true
            (go && i < n) {
                ci-opt = ty.byte(i)
                ci = ci-opt: {
                    ok -> it
                    -> 0
                }
                ci == 93 -> {
                    from = i
                    #{overflow=wrap}
                    from = from + 1
                    r = ty.slice-bytes(from, n)
                    go = false
                }

                #{overflow=wrap}
                i = i + 1
            }
        }
    }
}

; ═════════════════════════════════════════════════════════════════════
; 元素型別串形狀判定 / 切分
;
; ⚠️ 為什麼這些都要獨立成【以 str 為參數】的函式：
;   ps-parse-let 的 IndexExpression 臂裡，`elem` 是 ps-idx-elem-of() 的回傳值
;   （函式呼叫結果）。實測在該處直接求值 `elem.byte(0)` 會拿到【垃圾】
;   （6102830939，而非 91）——ps.no 巨型模組的 str.byte codegen「借用」缺陷
;   （lx.no:114 已記錄同類陷阱：以 str 字段/暫存為接收者求值 .byte() 屬借用）。
;   連帶兩個後果：
;     · `ex0 == 91` 恆假 ⇒ 結構化分支永不命中（退化成扁平 NamedType）；
;     · std 的 starts-with / index 內部也是對【self】取 .byte() ⇒ 同樣失真，
;       實測 `'[2]i64'.starts-with('?')` 竟回 TRUE，不可用。
;   但【參數】上的 .byte() 實測可靠（ps-idx-elem-of 的 ty.byte(0) 正確），
;   故把形狀判定與切分下推到這些小函式，由它們對參數取 .byte()。
; ═════════════════════════════════════════════════════════════════════

; ps-elem-shape：元素型別串形狀。0=扁平名稱 / 1=`?X` / 2=`[]X` / 3=`[N]X`
ps-elem-shape = (e str) (shape i64) {
    shape = 0
    n = e.len-bytes()
    n > 0 -> {
        c0-opt = e.byte(0)
        c0 = c0-opt: {
            ok -> it
            -> 0
        }
        c0 == 63 -> shape = 1
        c0 == 91 -> {
            c1-opt = e.byte(1)
            c1 = c1-opt: {
                ok -> it
                -> 0
            }
            c1 == 93 -> shape = 2
            -> shape = 3
        }
    }
}

; ps-elem-arr-size：`[N]X` ⇒ N（找不到 `]` ⇒ ''）
ps-elem-arr-size = (e str) (r str) {
    r = ''
    n = e.len-bytes()
    i = 1
    go = true
    (go && i < n) {
        cb-opt = e.byte(i)
        cb = cb-opt: {
            ok -> it
            -> 0
        }
        cb == 93 -> {
            r = e.slice-bytes(1, i)
            go = false
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ps-elem-arr-elem：`[N]X` ⇒ X（找不到 `]` ⇒ ''）
ps-elem-arr-elem = (e str) (r str) {
    r = ''
    n = e.len-bytes()
    i = 1
    go = true
    (go && i < n) {
        cb-opt = e.byte(i)
        cb = cb-opt: {
            ok -> it
            -> 0
        }
        cb == 93 -> {
            rb = i
            #{overflow=wrap}
            rb = rb + 1
            r = e.slice-bytes(rb, n)
            go = false
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ps-build-elem-type：把 ps-idx-elem-of 取出的【衍生型別串】建為【結構化】型別节点
;   （對齊 Go buildType + markInferred）。衍生串如 `?i64` / `[2]i64` / `[]?i64` /
;   `[][2]i64` 若直接塞進 NamedType.name 會與 Go 的 NullableType / ArrayType /
;   SliceType 不符（p-idx-edge2 實測 3 行差）。
;   實作＝重詞法 elem 串、暫存 p.toks/p.pos、跳 p.pos=0 重跑 ps-parse-type（全形
;   解析，與明示型別註標同源），再還原 p.toks/p.pos。複用既有解析保證與 Go 同構；
;   若 elem 含無法解析的片段則回 0（呼叫者退化回扁平 NamedType）。
;   ⚠️ p 為引用型別（parser 全域表靠它跨呼叫持久），故暫存/還原 p.toks 安全；
;      本函式內部絕不讓異常 path 漏改 p.toks（先存 old 末還原）。

; s63：隱式泛型參數偵測——鏡像 Go detectImplicitGeneric（decl.go:2061-2089）。
;   單字母 a-z 的 NamedType 收入泛型名（去重、保序）；Nullable/View/Pointer/Slice 遞迴 kid0；
;   Array 先查 Size 是否單字母 IDENT、再遞迴 Elem(kid0+1)；MapType/FunctionType/其餘 Go switch 無臂 ⇒ 不處理。
;   gnames 以 []str 累加，呼叫端據此建 Identifier 節點 prepend 於 FD kid 區首（signature() 依 c3 切片渲染 GenericParams）。
;   ⚠️ 僅 ps-parse-func / ps-parse-method-func 兩個 FD 定義點呼叫（對應 Go decl.go:518/521、1750/1753），
;     FunctionLiteral/FunctionType 不偵測——多處誤加會給當前 SAME 檔憑空生出 GenericParams 行而回歸。
ps-add-generic = (g []str, nm str) {
    found = 0
    j = 0
    (j < g.len()) {
        g[j] == nm -> found = 1

        #{overflow=wrap}
        j = j + 1
    }
    found == 0 -> g.push(nm)
}

ps-detect-generic = (t ast, i i64, g []str) {
    i <= 0 -> return
    d = ast.nd-at(t, i)
    d.kind <= 0 -> return
    k = d.kind
    {
        k == asp.K_NAMED_TYPE -> {
            nm = ast.str-at(t, d.s0)
            nm0-opt = nm.byte(0)
            nm0 = nm0-opt: {
                ok -> it
                -> 0
            }
            nm.len-bytes() == 1 && nm0 >= 97 && nm0 <= 122 -> ps-add-generic(g, nm)
        }

        ; Nullable/View/Pointer 遞迴 .Type、Slice 遞迴 .Elem——noc 兩者皆 kid0。
        k == asp.K_NULLABLE_TYPE || k == asp.K_VIEW_TYPE || k == asp.K_POINTER_TYPE || k == asp.K_SLICE_TYPE -> ps-detect-generic(t, ast.kid-at(t, d.kid0), g)

        k == asp.K_ARRAY_TYPE -> {

            ; Size 若是單字母 IDENT（如 `[n]byte`）視為泛型大小參數（Go decl.go:2077-2080），先於 Elem 加入。
            sz = ast.kid-at(t, d.kid0)
            sz > 0 -> {
                sd = ast.nd-at(t, sz)
                sd.kind == asp.K_IDENTIFIER -> {
                    nm2 = ast.str-at(t, sd.s0)
                    nm2b-opt = nm2.byte(0)
                    nm2b = nm2b-opt: {
                        ok -> it
                        -> 0
                    }
                    nm2.len-bytes() == 1 && nm2b >= 97 && nm2b <= 122 -> ps-add-generic(g, nm2)
                }
            }
            ps-detect-generic(t, ast.kid-at(t, d.kid0 + 1), g)
        }

        -> {
        }
    }
}

; ps-parse-func：解析 `name = (params) { body }` 或 `name = (params) (results) { body }`

; ps-parse-extern-decl：解析 FFI 宣告 `name = (params) (results)` 為 ExternStatement。
;   對應 Go parseAnnotationFFIDeclaration（annotation.go:945）。params/results 各為一組
;   Parameter（用 ps-parse-param，resParam=1 不解析預設值）；節點 kid 序：先 params
;   （KIDS 段 0）後 results（KIDS 段 1），count 由 ast.set-count 填入（LEN 純量自動派生）。
ps-parse-extern-decl = (t ast, p psst, name str, lang str) (idx i64) {
    idx = 0
    ps-bump(p); 消費 IDENT name
    ps-bump(p); 消費 =
    params []i64 = with-cap(4)
    results []i64 = with-cap(4)
    ; 解析 (params)
    ps-peek(p) == tok.LPAREN -> {
        ps-bump(p); 消費 (
        p.resParam = 1; 參數不解析預設值（對齊 Go decl.go:1693-1698）
        (ps-peek(p) != tok.RPAREN) {
            pm = ps-parse-param(t, p)
            pm > 0 -> params.push(pm)
            pm == 0 -> ps-bump(p); 防呆：沒解析出參數也要前進
        }
        p.resParam = 0
        ps-expect(p, tok.RPAREN)
    }
    ; 跳過 NEWLINE（多行定義）
    ps-skip-trivia(p)
    ; 解析 (results) 選擇性
    ps-peek(p) == tok.LPAREN -> {
        ps-bump(p); 消費 (
        p.resParam = 1
        (ps-peek(p) != tok.RPAREN) {
            rm = ps-parse-param(t, p)
            rm > 0 -> results.push(rm)
            rm == 0 -> ps-bump(p); 防呆
        }
        p.resParam = 0
        ps-expect(p, tok.RPAREN)
    }
    ; 建 ExternStatement（父後建：params/results 已先建於 arena）
    idx = ast.add(t, asp.K_EXTERN_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, lang)); FIELD scalar: lang
    ast.set-slot(t, idx, 1, ast.put-str(t, name)); FIELD scalar: name
    ; LEN 純量（kvc params/results，P-COUNT + OF-LEN）：dump 讀 s2/s3 的預渲染計數字串
    ast.set-slot(t, idx, 2, ast.put-str(t, params.len().to-str())); LEN 純量：params 數
    ast.set-slot(t, idx, 3, ast.put-str(t, results.len().to-str())); LEN 純量：results 數
    ; kid 序：先 params（段 0）後 results（段 1）
    k = 0
    (k < params.len()) {
        ast.kid-add(t, idx, params[k])
        #{overflow=wrap}
        k = k + 1
    }
    k = 0
    (k < results.len()) {
        ast.kid-add(t, idx, results[k])
        #{overflow=wrap}
        k = k + 1
    }
    ast.set-count(t, idx, 0, params.len()); KIDS 段 0 = params 數
    ast.set-count(t, idx, 1, results.len()); KIDS 段 1 = results 數
    idx
}

ps-parse-func = (t ast, p psst, name str) (idx i64) {

    ; s51：body 解析期间设定当前函式名（Go parseFunctionBody 起始 curFuncName=def.Name），
    ;   退出时还原，支持嵌套函式链。
    ofn = p.fn
    p.fn = name
    p.varFlag = 0; 變參標記每函式重置
    ps-bump(p); 消費 LPAREN（輸入參數群）
    params []i64 = with-cap(4)
    (ps-peek(p) != tok.RPAREN) {
        pn = ps-parse-param(t, p)
        pn > 0 -> params.push(pn)
        pn == 0 -> ps-bump(p); 防呆：沒解析出參數也要前進
    }
    ps-bump(p); 消費 RPAREN
    ps-skip-trivia(p)

    ; 回傳值群組（可選）：`(out T, …)`。Nolang 把回傳值建為 FunctionDefinition 上的 Parameter，
    ;   於 signature() 渲染時接在輸入參數之後（[inputs][results] 連續）。
    outs []i64 = with-cap(4)
    opos []i64 = with-cap(4)
    ps-peek(p) == tok.LPAREN -> {
        ps-bump(p); 消費第二個 LPAREN
        p.resParam = 1; 回傳值路徑不解析默認值（Go decl.go:1693-1698）
        (ps-peek(p) != tok.RPAREN) {
            ro = ps-parse-param(t, p)
            ro > 0 -> {
                outs.push(ro)
                opos.push(p.lastTp); s51：同步记下回传值型別起始 token（-1=无型別）
            }
            ro == 0 -> ps-bump(p); 防呆
        }
        p.resParam = 0
        ps-bump(p); 消費第二個 RPAREN
        ps-skip-trivia(p)
    }

    ; s51：body 前把參數/回傳值型別登記進函式作用域 varType 表（Go decl.go:1756-1773：
    ;   先設 curFuncName 再逐參數 setVarType），供后续 let 推斷 gate 的 existing 查询。
    rp = 0
    (rp < params.len()) {
        ; 索引讀提取為獨立陳述並標 #{index-out=zero}：巢置於 call 引數內的索引讀會被
        ; option 捕獲改寫（pd 淪為 ?i64、後續欄位讀在 MIR 產 NoVal，bug #85 類）；
        ; 迴圈守衛 rp < params.len() 已保證不越界，zero 僅為型別層面的逃生艙。
        #{index-out=zero}
        pni = params[rp]
        pd = ast.nd-at(t, pni)
        pt = ast.kid-at(t, pd.kid0)
        pt > 0 -> ps-set-var-type(p, ast.str-at(t, pd.s0), ast.type-string(t, pt))

        #{overflow=wrap}
        rp = rp + 1
    }
    rr = 0
    (rr < outs.len()) {
        ; 索引讀提取為獨立陳述並標 #{index-out=zero}（理由同 params 循環：call 引數內的
        ; 索引讀會被 option 捕獲改寫 ⇒ 後續欄位讀 NoVal）；迴圈守衛保證不越界。
        #{index-out=zero}
        oni = outs[rr]
        od = ast.nd-at(t, oni)
        ot = ast.kid-at(t, od.kid0)
        ; s8y 規則B2：鏡 Go decl.go:1766-1790——輸出參數 setVarType 登記時，若定義名
        ;   （OperatorOverloadBaseName 取末段）為運算符重載 ⇒ TrimPrefix "?"。
        ;   ⚠️ 節點級剥離僅影響登記字串；typ 節點（ifd 推斷路徑）不經此處，零外溢。
        ot > 0 -> ps-set-var-type(p, ast.str-at(t, od.s0), ast.type-string(t, ps-unwrap-op-overload-type(t, name, ot)))

        #{overflow=wrap}
        rr = rr + 1
    }
    ps-expect(p, tok.LBRACE); 進入 body
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE); 結束 body
    p.fn = ofn

    ; s51：body 解析【完成後】才註冊單回傳值簽名（Go decl.go:1836 在 parseFunctionDefinition 尾部）
    ;   ⇒ 顺序依赖：递归/前向引用的呼叫推不到回传型别，与 Go 一致。多回传值也记（查询端自行忽略 len≠1 效果：
    ;   Go 用 len(rets)==1 守卫；此處只在 outs==1 時记，其他情形不记——同名被无签名的重定义覆盖：Go map 覆盖语意，
    ;   故 outs==1 且无型別也要记（sigP=-1 哨兵，ps-sig-find 命中后 tp>=0 守衛自然过滤）。
    outs.len() == 1 -> {
        p.sigN.push(name)
        p.sigP.push(opos[0])
        ps-ht-put(p, 'sig:' - name, opos[0])
    }

    ; s63：偵測隱式泛型參數（Go decl.go:517-522：先 Parameters 後 Results，同序去重）。
    ;   每個參數/回傳值的型別節點（Parameter kid0）遞迴走訪，單字母 a-z 名收入 gnames。
    gnames []str = with-cap(2)
    gp = 0
    (gp < params.len()) {
        ; 索引讀提取獨立成句 + index-out=zero（理由同 params/outs 型別登記循環）
        #{index-out=zero}
        gni = params[gp]
        gpd = ast.nd-at(t, gni)
        ps-detect-generic(t, ast.kid-at(t, gpd.kid0), gnames)

        #{overflow=wrap}
        gp = gp + 1
    }
    gr = 0
    (gr < outs.len()) {
        ; 索引讀提取獨立成句 + index-out=zero（理由同上）
        #{index-out=zero}
        goi = outs[gr]
        grd = ast.nd-at(t, goi)
        ps-detect-generic(t, ast.kid-at(t, grd.kid0), gnames)

        #{overflow=wrap}
        gr = gr + 1
    }
    idx = ast.add(t, asp.K_FUNCTION_DEFINITION)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))

    ; SIG：泛型參數 gnames.len() / 輸入參數 params.len() / 回傳值 outs.len()
    ;   kid 區序：[genparams…][inputs…][results…] 連續（signature() 由 base 依 c3/c4/c5 切片），body 為其後 guarded CHILD
    ast.set-sig(t, idx, gnames.len(), params.len(), outs.len())
    ast.set-sig-extras(t, idx, 0, p.varFlag)
    gg = 0
    (gg < gnames.len()) {
        gi = ast.add(t, asp.K_IDENTIFIER)
        ast.set-slot(t, gi, 0, ast.put-str(t, gnames[gg]))
        ast.kid-add(t, idx, gi)

        #{overflow=wrap}
        gg = gg + 1
    }
    j = 0
    (j < params.len()) {
        ast.kid-add(t, idx, params[j])

        #{overflow=wrap}
        j = j + 1
    }
    m = 0
    (m < outs.len()) {
        ast.kid-add(t, idx, outs[m])

        #{overflow=wrap}
        m = m + 1
    }
    ast.kid-add(t, idx, body)
    idx
}

; ps-parse-method-func：方法定義 `recvType.method = (params) [ (results) ] { body }` 的主體。
;   進入時 p.pos 落在輸入參數群的 LPAREN。對應 Go parseMethodDefinition：
;     · name = 點分全名（'recvType.method'）、methodDef 欄位 = 'true'（FunctionDefinition slot2）。
;     · self 合成為【首個輸出參數】（Results，非 inputs）：Parameter{name:'self', Type:NamedType{recvType}}。
;       ⇒ kid 區序 [inputs…][self][results…][body]，set-sig 的 results 數 = 1 + 宣告的 outs 數。
;   ⚠️ Parameter 有 2 個 guarded CHILD（Type、DefaultExpr）：Type=selfnt、DefaultExpr=0 佔位。
; s64：recvNode —— 接收者型別【節點】（>0 時直接用，如 `[n]t` 的 ArrayType）；
;   <=0 則依 recvType 字串建 NamedType（普通 `Recv.method` 路徑，行為不變）。
; s8g：ifdKey —— IsFuncDeclared 追蹤鍵。`recv.method = (…)` 形傳【裸方法名】
;   （Go decl.go:56-82 只遷 FuncVarTypes，FuncDeclaredVars 留在裸名 ⇒ 同名方法跨接收者
;   共享宣告集，實測 mD 第二個方法 oracle 無型別、mE 異名則有）；`[N]t.method` / `[]t.method`
;   形 Go 以全名為鍵（mG 實測第二個方法有型別）⇒ 傳 full。
ps-parse-method-func = (t ast, p psst, fullName str, recvType str, recvNode i64, ifdKey str) (idx i64) {

    ; s51：方法体内设当前函式名（Go curFuncName=def.Name='recv.method'）；方法签名存 methodSignatures，
    ;   不入裸名 sigN（裸名查找不会命中，与 Go 一致）。
    ofn = p.fn
    p.fn = fullName
    oifd = p.ifdFn; s8g：進 body 前切換追蹤鍵，出 body 後還原（方法不巢狀，還原即清空）
    p.ifdFn = ifdKey
    p.varFlag = 0; 變參標記每方法重置
    ps-bump(p); 消費 LPAREN（輸入參數群）
    params []i64 = with-cap(4)
    (ps-peek(p) != tok.RPAREN) {
        pn = ps-parse-param(t, p)
        pn > 0 -> params.push(pn)
        pn == 0 -> ps-bump(p); 防呆：沒解析出參數也要前進
    }
    ps-bump(p); 消費 RPAREN
    ps-skip-trivia(p)

    ; 回傳值群組（可選）：`(out T, …)`
    outs []i64 = with-cap(4)
    opos []i64 = with-cap(4); s58：同步記回傳值型別起始 token（方法推斷用）
    ps-peek(p) == tok.LPAREN -> {
        ps-bump(p); 消費第二個 LPAREN
        p.resParam = 1; 回傳值路徑不解析默認值（Go decl.go:1693-1698）
        (ps-peek(p) != tok.RPAREN) {
            ro = ps-parse-param(t, p)
            ro > 0 -> {
                outs.push(ro)
                opos.push(p.lastTp)
            }
            ro == 0 -> ps-bump(p); 防呆
        }
        p.resParam = 0
        ps-bump(p); 消費第二個 RPAREN
        ps-skip-trivia(p)
    }

    ; self 合成接收者（先建子樹 NamedType，再建 Parameter 父節點）
    ; s64：recvNode>0（泛型陣列接收者 `[n]t`）時直接用該節點，否則建 NamedType{recvType}。
    selfnt = 0
    recvNode > 0 -> selfnt = recvNode
    recvNode <= 0 -> {
        selfnt = ast.add(t, asp.K_NAMED_TYPE)
        ast.set-slot(t, selfnt, 0, ast.put-str(t, recvType))
    }
    selfp = ast.add(t, asp.K_PARAMETER)
    ast.set-slot(t, selfp, 0, ast.put-str(t, 'self'))
    ast.kid-add(t, selfp, selfnt)
    ast.kid-add(t, selfp, 0)

    ; s51：body 前登記輸入參數型別（Go decl.go 只登 Parameters；self 不隨 params 登）
    ; s8v：Go 對【切片/陣列接收者方法】走 parseArrayTypeMethodDefinition（decl.go:191），
    ;   它【不】setVarType 參數/回傳值型別進 FuncVarTypes（只有 parseMethodDefinition/
    ;   parseFunctionBody 才登）。故 `[]T.m`/`[N]T.m` 體內 `x = <參數>` 的識別符型別傳播
    ;   （stmt.go:1421 讀 FuncVarType）查不到該參數 ⇒ 不推斷（vec.no `[]t.remove` 的
    ;   `j = i`：oracle 不給 j 型別）；而 `[]t.sum` 的 `sum = acc`：結果參數 `sum` 未預登
    ;   ⇒ existing=="" ⇒ 本地 let `acc`（parseLetStatement 自登 i64）照常傳播。
    ;   ⚠️ 但降糖（index-out 安全索引，ps-apply-index-out）需讀參數型別——Go 的 lowering
    ;   直接讀 def.Parameters AST（不经 FuncVarTypes）。noc 用【s7v 命名空間 vt7:】承接：
    ;   ps-var-type（非嚴格，降糖端）讀得到 vt7，ps-var-type-strict（推斷閘門，鏡像 Go
    ;   FuncVarType）讀不到 ⇒ 兩邊語意同時對齊。selfnt 為 SliceType/ArrayType ⇒ 走此路徑。
    ;   ⚠️ 用 regp/skp 前綴變數避免串型別（s7l 教訓）。
    skp = ast.kind-at(t, selfnt)
    regp = 1
    skp == asp.K_SLICE_TYPE || skp == asp.K_ARRAY_TYPE -> regp = 0
    rp = 0
    (rp < params.len()) {
        ; 索引讀提取為獨立陳述並標 #{index-out=zero}：巢置於 call 引數內的索引讀會被
        ; option 捕獲改寫（pd 淪為 ?i64、後續欄位讀在 MIR 產 NoVal，bug #85 類）；
        ; 迴圈守衛 rp < params.len() 已保證不越界，zero 僅為型別層面的逃生艙。
        #{index-out=zero}
        pni = params[rp]
        pd = ast.nd-at(t, pni)
        pt = ast.kid-at(t, pd.kid0)
        pt > 0 -> {
            regp == 1 -> ps-set-var-type(p, ast.str-at(t, pd.s0), ast.type-string(t, pt))
            regp == 0 -> ps-set-var-type-s7v(p, ast.str-at(t, pd.s0), ast.type-string(t, pt))
        }

        #{overflow=wrap}
        rp = rp + 1
    }
    rr = 0
    (rr < outs.len()) {
        ; 索引讀提取為獨立陳述並標 #{index-out=zero}（理由同 params 循環：call 引數內的
        ; 索引讀會被 option 捕獲改寫 ⇒ 後續欄位讀 NoVal）；迴圈守衛保證不越界。
        #{index-out=zero}
        oni = outs[rr]
        od = ast.nd-at(t, oni)
        ot = ast.kid-at(t, od.kid0)
        ; s8y 規則B2：同 ps-parse-func-def 口徑——Go decl.go:1766-1790 對方法定義以
        ;   OperatorOverloadBaseName（`t._mul`→`_mul`）判重載後 TrimPrefix "?"。
        ot > 0 -> {
            regp == 1 -> ps-set-var-type(p, ast.str-at(t, od.s0), ast.type-string(t, ps-unwrap-op-overload-type(t, fullName, ot)))
            regp == 0 -> ps-set-var-type-s7v(p, ast.str-at(t, od.s0), ast.type-string(t, ps-unwrap-op-overload-type(t, fullName, ot)))
        }

        #{overflow=wrap}
        rr = rr + 1
    }

    ; s54：預登記 self=接收者型別，供 ps-signed-int-operand 查表（鏡像 Go lowerSelfType
    ;   於 parse 完成後的 walk 中讀 Results[0]；noc 單趟需在 body 前就可解析 `.`）。
    ps-set-var-type(p, 'self', recvType)
    ps-expect(p, tok.LBRACE); 進入 body
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE); 結束 body
    p.fn = ofn
    p.ifdFn = oifd; s8g：還原追蹤鍵

    ; s58：body 完成後註冊單回傳值方法簽名（Go decl.go methodSignatures 尾注冊語意；
    ;   鍵='recv.method'，舆裸名 sigN 相斥——Go returnTypeFromCallExpr 雨表分查）。
    outs.len() == 1 -> {
        p.msN.push(fullName)
        p.msP.push(opos[0])
        ps-ht-put(p, 'ms:' - fullName, opos[0])
    }

    ; s63：方法定義隐式泛型偵測（Go decl.go:1750/1753：Parameters 後接 Results）。
    ;   ⚠️ s65c：順序是 params → outs，**不含 self**（理由見下方 self 移除處的註解）。
    gnames []str = with-cap(2)

    ; s64：陣列接收者 `[N]T` 的隱式泛型在【接收者解析時】就已加入——Go
    ;   parseArrayMethodDefinition（decl.go:242-243）先 addImplicitGeneric(size)、
    ;   再 addImplicitGeneric(elem)，兩者都【早於】Parameters/Results 的
    ;   detectImplicitGeneric ⇒ 順序必須是 size, elem, 然後才是 params/self/outs。
    ;   實測反例：`[n]t.arr-stack-push = (s arr-stack, val t) (ok bool)`，oracle
    ;   產 `GenericParams: n, t`；若只按 params→self 順序則得 `t, n`（差一處順序）。
    ;   ⚠️ 僅【陣列】接收者才播種：Go 的 addImplicitGeneric(size/elem) 只在 `[n]t` 分支呼叫，
    ;      `[]t` / `[?]t` 分支不呼叫（decl.go:205-242）⇒ 切片接收者的泛型只能來自 params/outs。
    ;      實測反例：`[]t.len = () (out i64)` oracle 無 GenericParams；若對 SliceType 也播種
    ;      則多出 `GenericParams: t`（回歸）。
    recvNode > 0 && ast.kind-at(t, recvNode) == asp.K_ARRAY_TYPE -> ps-detect-generic(t, recvNode, gnames)
    gp = 0
    (gp < params.len()) {
        ; 索引讀提取獨立成句 + index-out=zero（理由同 params/outs 型別登記循環）
        #{index-out=zero}
        gni = params[gp]
        gpd = ast.nd-at(t, gni)
        ps-detect-generic(t, ast.kid-at(t, gpd.kid0), gnames)

        #{overflow=wrap}
        gp = gp + 1
    }
    ; ⚠️ self 【不】參與泛型偵測：Go 三條方法路徑（decl.go:569 / 94 / 2037）都在
    ;   detectImplicitGeneric（516-521 / 1750-1753）【之後】才把 selfParam 插進 Results
    ;   ⇒ self 的型別永遠不被掃描。此前多掃一次 selfnt ⇒ 切片接收者 `[]t.len = () (out i64)`
    ;   憑 self 的 SliceType{t} 多出 `GenericParams: t`（oracle 無）⇒ 回歸。
    gr = 0
    (gr < outs.len()) {
        ; 索引讀提取獨立成句 + index-out=zero（理由同上）
        #{index-out=zero}
        goi = outs[gr]
        grd = ast.nd-at(t, goi)
        ps-detect-generic(t, ast.kid-at(t, grd.kid0), gnames)

        #{overflow=wrap}
        gr = gr + 1
    }
    ; s7z2：泛型結構體模板（接收者名以 '-tmpl' 結尾）的方法，Go 會清空
    ;   detectImplicitGeneric 誤加的函式級 GenericParams（decl.go:42-48）——單字母型別
    ;   （v/k）是【結構體級】泛型參數，由 monomorphizeGenericStructs 處理，不該出現在
    ;   函式簽名。實測 `hashmap-str-tmpl.put = (key str, val v)`：oracle 無 GenericParams，
    ;   SUT 多出 `GenericParams: v`（map.no / static-hashmap.no 各 8–9 行）。
    tl = recvType.len-bytes()
    tl >= 5 && recvType.slice-bytes(tl - 5, tl) == '-tmpl' && gnames.len() > 0 -> {
        gnames = with-cap(0)
    }
    idx = ast.add(t, asp.K_FUNCTION_DEFINITION)
    ast.set-slot(t, idx, 0, ast.put-str(t, fullName))
    ast.set-slot(t, idx, 2, ast.put-str(t, 'true')); methodDef（P-TRUE：僅 'true' 才印）
    rs = outs.len()

    #{overflow=wrap}
    rs = rs + 1; +self
    ast.set-sig(t, idx, gnames.len(), params.len(), rs)
    ast.set-sig-extras(t, idx, 0, p.varFlag)
    gg = 0
    (gg < gnames.len()) {
        gi = ast.add(t, asp.K_IDENTIFIER)
        ast.set-slot(t, gi, 0, ast.put-str(t, gnames[gg]))
        ast.kid-add(t, idx, gi)

        #{overflow=wrap}
        gg = gg + 1
    }
    j = 0
    (j < params.len()) {
        ast.kid-add(t, idx, params[j])

        #{overflow=wrap}
        j = j + 1
    }
    ast.kid-add(t, idx, selfp)
    m = 0
    (m < outs.len()) {
        ast.kid-add(t, idx, outs[m])

        #{overflow=wrap}
        m = m + 1
    }
    ast.kid-add(t, idx, body)
    idx
}

; ps-for-source：解析 range 迭代來源（`<-` 右側），對應 Go parseForRange。
;   `[`/`(` → RangeExpression 填 src(kid0)；其他（陣列 IDENT/呼叫等）→ 運算式填 srcExpr(kid1)。
;   進入時呼叫端已消費 `<-`，本函式先 skip-trivia。回傳 (src, srcExpr)（皆 i64、無結構體⇒安全多回傳）。
;   ⚠️ 守衛用快照 op，避免活 ps-peek 於 ps-bump 後重評誤觸（跨臂坑）。
ps-for-source = (t ast, p psst) (src i64, srcExpr i64) {
    ps-skip-trivia(p)
    src = 0
    srcExpr = 0
    op = ps-peek(p)

    ; s57：`[` 源鏡像 Go parseForRange 的 LBRACKET 分類（stmt.go:2582）——saveState/restoreState
    ;   前掃 distinguishing range（含 `..`）vs 匿名切片字面量（`,`/`]` 收尾）。分類期所建節點
    ;   不被任何 kid 引用即孤兒，dumper 沿 kid 走訪永不觸及（ps-parse-typedecl 同法）⇒ 零回歸。
    ;   kind==1 → 走原 range 路徑；kind==2 → 整段 `[...]` 由 ps-parse-expr 的 LBRACKET 前綴臂
    ;   建 SliceLiteral 填 RangeExpr(kid1)；kind==0（Go saveError 形）無以復現 ⇒ 保持舊無分類行為。
    op == tok.LBRACKET -> {
        save = p.pos
        kind = 0
        ps-bump(p); 消費 `[`（僅分類期）
        ps-peek(p) == tok.ELLIPSIS -> kind = 1
        ps-peek(p) != tok.ELLIPSIS -> {
            u = ps-parse-expr-prec(t, p, 0)
            nc = ps-peek(p)
            nc == tok.ELLIPSIS -> kind = 1
            nc == tok.COMMA || nc == tok.RBRACKET -> kind = 2
        }
        p.pos = save; restoreState
        kind == 1 -> {
            ps-bump(p); 消費 `[`
            leftInc = 'true'
            st = 0
            en = 0
            ps-peek(p) != tok.ELLIPSIS -> st = ps-parse-expr-prec(t, p, 0)
            ps-expect(p, tok.ELLIPSIS); 消費 ..
            nc = ps-peek(p)
            nc != tok.RBRACKET && nc != tok.RPAREN -> en = ps-parse-expr-prec(t, p, 0)
            cl = ps-peek(p)
            ri = 'false'
            cl == tok.RBRACKET -> ri = 'true'
            ps-bump(p); 消費閉合 `]`
            src = ast.add(t, asp.K_RANGE_EXPRESSION)
            ast.set-slot(t, src, 0, ast.put-str(t, leftInc)); leftInc
            ast.set-slot(t, src, 1, ast.put-str(t, ri)); rightInc
            ast.kid-add(t, src, st)
            ast.kid-add(t, src, en)
        }
        kind == 2 -> srcExpr = ps-parse-expr(t, p)
        kind == 0 -> {
            ps-bump(p); 消費 `[`
            leftInc = 'true'
            st = 0
            en = 0
            ps-peek(p) != tok.ELLIPSIS -> st = ps-parse-expr-prec(t, p, 0)
            ps-expect(p, tok.ELLIPSIS); 消費 ..
            nc = ps-peek(p)
            nc != tok.RBRACKET && nc != tok.RPAREN -> en = ps-parse-expr-prec(t, p, 0)
            cl = ps-peek(p)
            ri = 'false'
            cl == tok.RBRACKET -> ri = 'true'
            ps-bump(p); 消費閉合 `]` 或 `)`
            src = ast.add(t, asp.K_RANGE_EXPRESSION)
            ast.set-slot(t, src, 0, ast.put-str(t, leftInc)); leftInc
            ast.set-slot(t, src, 1, ast.put-str(t, ri)); rightInc
            ast.kid-add(t, src, st)
            ast.kid-add(t, src, en)
        }
    }
    op == tok.LPAREN -> {
        ps-bump(p); 消費 `(`
        leftInc = 'false'
        st = 0
        en = 0
        ps-peek(p) != tok.ELLIPSIS -> st = ps-parse-expr-prec(t, p, 0)
        ps-expect(p, tok.ELLIPSIS); 消費 ..
        nc = ps-peek(p)
        nc != tok.RBRACKET && nc != tok.RPAREN -> en = ps-parse-expr-prec(t, p, 0)
        cl = ps-peek(p)
        ri = 'false'
        cl == tok.RBRACKET -> ri = 'true'
        ps-bump(p); 消費閉合 `]` 或 `)`
        src = ast.add(t, asp.K_RANGE_EXPRESSION)
        ast.set-slot(t, src, 0, ast.put-str(t, leftInc)); leftInc
        ast.set-slot(t, src, 1, ast.put-str(t, ri)); rightInc
        ast.kid-add(t, src, st)
        ast.kid-add(t, src, en)
    }
    op != tok.LBRACKET && op != tok.LPAREN -> {

        ; 陣列/切片源：若為 **裸 IDENT 後接 `:`**（`i <- a: { }`），不能走 ps-parse-expr——
        ;   否則 `ident : {` 會誤觸明示-match 後綴分支（ps.no 的 `IDENT COLON LBRACE` 臂）吃掉本體 ⇒ SIGBUS。
        ;   直接建 Identifier 並只消費 ident，把 `:` 留給呼叫端冒號檢查。其他形仍走 ps-parse-expr。
        srcTk = ps-peek-token(p)
        bareIdentColon = srcTk.typ == tok.IDENT && ps-peek-at(p, 1) == tok.COLON
        bareIdentColon -> {
            srcExpr = ast.add(t, asp.K_IDENTIFIER)
            ast.set-slot(t, srcExpr, 0, ast.put-str(t, srcTk.lit))
            ps-bump(p); 消費 ident
        }
        bareIdentColon == 0 -> srcExpr = ps-parse-expr(t, p)
    }
}

; ps-loop-body：解析迴圈本體——鏡像 Go parseLoopBody（stmt.go:2386-2411）。
;   兩形：`{ ... }` 區塊體（inline 欄位留空）／冒號後單陳述行內體（BlockStatement
;   單 kid + slot0='true' ⇒ dump `inline: true`）。⚠️ 行內體【只】綁一條陳述——
;   後續行為外層區塊陳述（Go「Single-statement body」，yaml 級聯 c7 探針實證）。
;   ⚠️ 不可沿用 ps-expect(LBRACE)+ps-parse-block 直取：ps-expect 對不符 token
;   靜默放行、ps-parse-block 又是開區間（吃到 RBRACE/EOF）——`for v <- r: stmt`
;   行內形會吞到下一個 `}`，偷走外層收束括號（yaml.no parse-block-scalar 級聯
;   誤解析根因：後隨陳述被吞進迴圈體、後續函式被吞進前函式、裸 match 被逼回塊形）。
ps-loop-body = (t ast, p psst) (idx i64) {
    ps-skip-trivia(p)
    isBlk = 0
    ps-peek(p) == tok.LBRACE -> isBlk = 1
    isBlk == 1 -> {
        ps-bump(p); 消費 `{`
        idx = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
    }
    isBlk == 0 -> {
        s = ps-parse-stmt(t, p)
        idx = ast.add(t, asp.K_BLOCK_STATEMENT)
        s > 0 -> {
            ast.set-slot(t, idx, 0, ast.put-str(t, 'true')); inline（Go IsInline=true）
            ast.kid-add(t, idx, s)
            ast.set-count(t, idx, 0, 1)
        }
        s == 0 -> ast.set-count(t, idx, 0, 0); 解析失敗：空本體（Go saveError 後同形）
    }
}

; ps-parse-for：解析 bare range-for 迭代 `vname <- range-or-array [:] { body }`（不使用 `for` 關鍵字）。
;   對應 Go parseForStatement 的 bare 分支 + parseForRange。回傳 ForStatement 節點索引。
ps-parse-for = (t ast, p psst, vname str) (idx i64) {
    ps-bump(p); 消費 IDENT（迴圈變數）
    ps-bump(p); 消費 ARROW (<-)
    src, srcExpr = ps-for-source(t, p)

    ; 冒號：有 `:` 消費（無警告）；無 `:` ⇒ deprecated 形，p.warn + 1（對應 Go parseForStatement saveWarning）
    hd = ps-peek(p)
    hd == tok.COLON -> ps-bump(p)

    #{overflow=wrap}
    hd != tok.COLON -> p.warn = p.warn + 1

    ; 迴圈本體（`{ ... }` 塊體或冒號後單陳述行內體）
    body = ps-loop-body(t, p)

    ; IterationExpr（子先於父：src/srcExpr 已建）；2 個 guarded CHILD：Range(kid0)、RangeExpr(kid1)
    ie = ast.add(t, asp.K_ITERATION_EXPR)
    ast.set-slot(t, ie, 0, ast.put-str(t, vname)); var 名（kvs，空則不印）
    ast.kid-add(t, ie, src)
    ast.kid-add(t, ie, srcExpr)

    ; ForStatement：6 個 guarded CHILD（Init,Condition,Update,CountExpr,IterRange,Body），僅後兩者非零
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, ie)
    ast.kid-add(t, idx, body)
    idx
}

; ps-parse-for-kw：解析 `for`/`while` 關鍵字迴圈（對應 Go parseForStatement 的 FOR 分支）。
;   僅支援帶 `{ }` 本體的三種形體（無大括號 inline / C-style `,;` / 比較運算子退路等罕見形暫不覆蓋）：
;     · `for { }`                → Condition=BooleanLiteral{true}，p.warn+1（2297）
;     · `for v <- range [:] { }` → Condition=Identifier{v} + IterRange=IterationExpr，無警告（ARROW 分支）
;     · `for expr { }` / `while` → Condition=expr，p.warn+1（2407 for / 2402 while）
;   ⚠️ `;` 在 Nolang 是行註解 ⇒ C-style `for a; b; c` 天然退化，不實作。
ps-parse-for-kw = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 for/while 關鍵字
    ps-skip-trivia(p)
    warn = 0
    cond = 0
    ie = 0
    body = 0
    hd = ps-peek(p)

    ; 無限迴圈：for { }
    hd == tok.LBRACE -> {
        cond = ast.add(t, asp.K_BOOLEAN_LITERAL)
        ast.set-slot(t, cond, 0, ast.put-str(t, 'true'))
        warn = 1
        ps-expect(p, tok.LBRACE)
        body = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
    }
    hd != tok.LBRACE -> {
        tk1 = ps-peek-token(p)
        tk2 = ps-peek-at(p, 1)
        isRange = tk1.typ == tok.IDENT && tk2 == tok.ARROW

        ; range 形：for v <- src { }（ARROW 分支無警告；IN 形暫不覆蓋）
        isRange -> {
            ps-bump(p); 消費 ident（迴圈變數）
            ps-bump(p); 消費 ARROW (<-)
            src, srcExpr = ps-for-source(t, p)
            hc = ps-peek(p)
            hc == tok.COLON -> ps-bump(p)
            body = ps-loop-body(t, p)
            ie = ast.add(t, asp.K_ITERATION_EXPR)
            ast.set-slot(t, ie, 0, ast.put-str(t, tk1.lit))
            ast.kid-add(t, ie, src)
            ast.kid-add(t, ie, srcExpr)
            cond = ast.add(t, asp.K_IDENTIFIER)
            ast.set-slot(t, cond, 0, ast.put-str(t, tk1.lit))
        }

        ; 條件形：for expr { } / while expr { }
        isRange == 0 -> {
            cond = ps-parse-expr(t, p)
            hc = ps-peek(p)
            hasCol = 0
            hc == tok.COLON -> {
                hasCol = 1
                ps-bump(p)
            }
            body = ps-loop-body(t, p)
            ; Go stmt.go:2586-2612：帶冒號的 `for cond: body` 不發 deprecated 警告
            hasCol == 0 -> warn = 1
        }
    }

    ; ForStatement：6 個 guarded CHILD（Init,Condition,Update,CountExpr,IterRange,Body）
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, cond)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, ie)
    ast.kid-add(t, idx, body)

    #{overflow=wrap}
    p.warn = p.warn + warn
    idx
}

; ps-parse-bang-loop：`!! { }`（恆真、無限循環）與 `! { }`（恆假、不執行）。
;   對應 Go parseBangLoop（stmt.go:2577）：Condition=BooleanLiteral{loop}、Body=BlockStatement。
;   此二形【不】saveWarning（新式語法），故不累加 p.warn。其餘 4 個 guarded CHILD 以 0 佔位。
ps-parse-bang-loop = (t ast, p psst, loop i64) (idx i64) {
    ps-bump(p); 消費 !! / !
    ps-expect(p, tok.LBRACE)
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)
    cond = ast.add(t, asp.K_BOOLEAN_LITERAL)
    lit = 'false'
    loop == 1 -> lit = 'true'
    ast.set-slot(t, cond, 0, ast.put-str(t, lit))
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0); Init
    ast.kid-add(t, idx, cond); Condition
    ast.kid-add(t, idx, 0); Update
    ast.kid-add(t, idx, 0); CountExpr
    ast.kid-add(t, idx, 0); IterRange
    ast.kid-add(t, idx, body); Body
}

; s57-count-prefix-p：判定【目前 pos】是否為前置計數循環 `N * { }` / `-N * { }`—鏡像 Go
;   isCountLoopPrefix（stmt.go:2842）。【直接索引扫描】而非多次 ps-peek-at——實證同一函式體
;   內多點前視（含變量偏位）會讀到陳宅寞存器（MIR 冷路径審查，見 ps-bm-scan 直接索引澉演）。
;   nolang 語法下 COMMENT 恆為行首（`;` 吞至行尾）⇙ Go look() 跳 COMMENT 在本形與原樣索引等價。
;   回 1=`INT MUL LBRACE`、2=`SUB INT MUL LBRACE`、0=非。
s57-count-prefix-p = (p psst) (r i64) {
    r = 0

    #{index-out=zero}
    cur = p.toks[p.pos].typ

    #{index-out=zero}
    t1 = p.toks[p.pos + 1].typ
    cur == tok.INT -> {

        #{index-out=zero}
        t2 = p.toks[p.pos + 2].typ
        t1 == tok.MUL && t2 == tok.LBRACE -> r = 1
    }
    cur == tok.SUB && t1 == tok.INT -> {

        #{index-out=zero}
        t2 = p.toks[p.pos + 2].typ

        #{index-out=zero}
        t3 = p.toks[p.pos + 3].typ
        t2 == tok.MUL && t3 == tok.LBRACE -> r = 2
    }
    r
}

; s57-count-blockfirst-p：判定【目前 pos（LBRACE）】是否為 `{ body } * [(-)?] N` 計數循環——
;   鏡像 Go isCountedLoopBlockFirst（stmt.go:3085）：平衡大括號掃描，`#{` 群組整體跳過
;   （同 isCondLoopBlockFirst 守剉，其 `}` 不得提前收合）；匹配 `}` 後須為 MUL [SUB] INT，
;   且 INT 後須為語句結束（NEWLINE/EOF/SEMICOLON/RBRACE），避免與 `} * n` 乘法混淆。
;   直接索引扫描（同上點審查）；會員取出均帶 index-out=zero。回 1=是、0=否。
s57-count-blockfirst-p = (p psst) (r i64) {
    r = 0
    depth = 1
    i = 1
    go = true
    (go) {

        #{index-out=zero}
        t = p.toks[p.pos + i].typ
        t == tok.EOF -> go = false
        t == tok.HASH_LBRACE -> {

            #{overflow=wrap}
            i = i + 1; 消費 #{
            inner = true
            (inner) {

                #{index-out=zero}
                tt = p.toks[p.pos + i].typ
                tt == tok.EOF -> {
                    inner = false
                    go = false
                }
                inner == true -> {

                    #{overflow=wrap}
                    i = i + 1
                    tt == tok.RBRACE -> inner = false
                }
            }
        }
        go == true && t != tok.HASH_LBRACE -> {
            t == tok.LBRACE -> {

                #{overflow=wrap}
                depth = depth + 1
            }
            t == tok.RBRACE -> {

                #{overflow=wrap}
                depth = depth - 1
                depth == 0 -> {
                    go = false

                    #{index-out=zero}
                    mt = p.toks[p.pos + i + 1].typ
                    mt == tok.MUL -> {

                        #{index-out=zero}
                        st = p.toks[p.pos + i + 2].typ
                        j = i + 2
                        st == tok.SUB -> {

                            #{overflow=wrap}
                            j = i + 3
                        }

                        #{index-out=zero}
                        it = p.toks[p.pos + j].typ
                        it == tok.INT -> {

                            #{index-out=zero}
                            at = p.toks[p.pos + j + 1].typ
                            at == tok.NEWLINE || at == tok.EOF || at == tok.SEMICOLON || at == tok.RBRACE -> r = 1
                        }
                    }
                }
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
    r
}

; s57-parse-count-loop-prefix：`N * { body }` 前置計數循環（鏡像 Go parseCountLoopPrefix
;   stmt.go:2867）。CountExpr=IntegerLiteral{value}（無 raw ⇒ slot1 置空串，dumper 不印）；
;   負號形把字面量取負（Go intToken.Literal = "-"+lit）。數字直接讀 token 字面量，
;   不走 ps-parse-expr（避免冷路徕前視壞）。前提：閘門已過。
s57-parse-count-loop-prefix = (t ast, p psst) (idx i64) {
    neg = 0
    ps-peek(p) == tok.SUB -> {
        neg = 1
        ps-bump(p); 消費 -
    }
    tk = ps-peek-token(p)
    lit = tk.lit
    neg == 1 -> lit = '-' + lit
    ps-bump(p); 消費 INT
    ps-expect(p, tok.MUL); 消費 *
    ps-expect(p, tok.LBRACE); 進入 body
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)
    cnt = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, cnt, 0, ast.put-str(t, lit))
    ast.set-slot(t, cnt, 1, ast.put-str(t, '')); raw 空 ⇒ 不印
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0); Init
    ast.kid-add(t, idx, 0); Condition
    ast.kid-add(t, idx, 0); Update
    ast.kid-add(t, idx, cnt); CountExpr
    ast.kid-add(t, idx, 0); IterRange
    ast.kid-add(t, idx, body); Body
    idx
}

; s57-parse-count-loop-blockfirst：`{ body } * [(-)?] N` 後置計數循環（鏡像 Go
;   parseCountedLoopBlockFirst stmt.go:3134）。前提閘門已過。其餘同 prefix 形。
s57-parse-count-loop-blockfirst = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 {
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE); 結束 body
    ps-expect(p, tok.MUL); 消費 *
    neg = 0
    ps-peek(p) == tok.SUB -> {
        neg = 1
        ps-bump(p); 消費 -
    }
    tk = ps-peek-token(p)
    lit = tk.lit
    neg == 1 -> lit = '-' + lit
    ps-bump(p); 消費 INT
    cnt = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, cnt, 0, ast.put-str(t, lit))
    ast.set-slot(t, cnt, 1, ast.put-str(t, '')); raw 空 ⇒ 不印
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0); Init
    ast.kid-add(t, idx, 0); Condition
    ast.kid-add(t, idx, 0); Update
    ast.kid-add(t, idx, cnt); CountExpr
    ast.kid-add(t, idx, 0); IterRange
    ast.kid-add(t, idx, body); Body
    idx
}

; ps-is-cond-loop-prefix：判定【目前 pos（LPAREN）】是否為 `(cond) {` 前置條件循環。
;   對應 Go isCondLoopPrefix（stmt.go:2615）：(1) 掃至平衡 `)`；(2) 其【立即】下一 token 須為 `{`
;   （不跳 trivia—換行後的 `{` 屬後綴式循環，非本形）；(3) 括號內容含 `,` 或「恰好兩個 IDENT」
;   （參數名+型別）⇒ 是匿名函式參數列，非循環。其餘（含 `()`、單 IDENT `(flag)`）⇒ 循環。
ps-is-cond-loop-prefix = (p psst) (r i64) {
    r = 0
    depth = 0
    i = 0
    closed = -1
    go = true
    (go) {
        t = ps-peek-at(p, i)
        t == tok.EOF -> go = false
        go == true -> {
            t == tok.LPAREN -> {

                #{overflow=wrap}
                depth = depth + 1
            }
            t == tok.RPAREN -> {

                #{overflow=wrap}
                depth = depth - 1
                depth == 0 -> {
                    closed = i
                    go = false
                }
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
    closed < 0 -> return

    #{overflow=wrap}
    after = closed + 1
    ps-peek-at(p, after) != tok.LBRACE -> return
    hasComma = 0
    identCnt = 0
    innerCnt = 0
    z = 1
    (z < closed) {
        it = ps-peek-at(p, z)
        it == tok.COMMA -> hasComma = 1
        it == tok.IDENT -> {

            #{overflow=wrap}
            identCnt = identCnt + 1
        }

        #{overflow=wrap}
        innerCnt = innerCnt + 1

        #{overflow=wrap}
        z = z + 1
    }
    hasComma == 1 -> return
    innerCnt == 2 && identCnt == 2 -> return
    r = 1
}

; ps-parse-cond-loop：`(cond) { body }` 前置條件循環。對應 Go parseCondLoopPrefix（stmt.go:2686）。
;   空括號 `()` ⇒ Condition=BooleanLiteral{false}（不執行）；`(true)`/`(expr)` ⇒ Condition=expr。
;   Body=BlockStatement。不 saveWarning（新式語法）。
ps-parse-cond-loop = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 (
    cond = 0

    ; ⚠️ 預先取 hd（同 ps-parse-for-kw 守則）：若每臂各呼叫 ps-peek(p)，首臂消費 `)` 後
    ;   次臂重取會看到 `{` ⇒ 雙臂皆執行（match 非互斥 switch），cond 被第二臂覆寫成 0。
    hd = ps-peek(p)
    hd == tok.RPAREN -> {
        cond = ast.add(t, asp.K_BOOLEAN_LITERAL)
        ast.set-slot(t, cond, 0, ast.put-str(t, 'false'))
        ps-bump(p); 消費 )
    }
    hd != tok.RPAREN -> {
        cond = ps-parse-expr(t, p)
        ps-expect(p, tok.RPAREN)
    }
    ps-expect(p, tok.LBRACE)
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label
    ast.kid-add(t, idx, 0); Init
    ast.kid-add(t, idx, cond); Condition
    ast.kid-add(t, idx, 0); Update
    ast.kid-add(t, idx, 0); CountExpr
    ast.kid-add(t, idx, 0); IterRange
    ast.kid-add(t, idx, body); Body
}

; ps-parse-break-continue：解析 `break` / `continue`（對應 Go parseBreakStatement / parseContinueStatement）。
;   節點無 CHILD，仅雨個字串 slot：slot0=label（`kv` 恆印，空⇒`label: `）、slot1=kind（`kv` 恆印，'none'/'text'/'numeric'）。
;   brk=1⇒BreakStatement，brk=0⇒ContinueStatement。
;   標籤侦测对齐 Go：消費关键字後直接看**紧邻** token（不跳 trivia）——LABEL(`#N`)⇒numeric、IDENT⇒text（同列才成立）；
;   否则（NEWLINE/RBRACE 等）⇒裸 break（label=''、kind='none'）。⚠️ 不同列的 IDENT 属于下一条陈述，不能当标签。
ps-parse-break-continue = (t ast, p psst, brk i64) (idx i64) {
    ps-bump(p); 消費 break/continue 关键字
    label = ''
    kind = 'none'
    nt = ps-peek(p)
    nt == tok.LABEL -> {
        ltk = ps-peek-token(p)
        label = ltk.lit
        kind = 'numeric'
        ps-bump(p)
    }
    nt == tok.IDENT -> {
        itk = ps-peek-token(p)
        label = itk.lit
        kind = 'text'
        ps-bump(p)
    }
    nodekind = asp.K_BREAK_STATEMENT
    brk == 0 -> nodekind = asp.K_CONTINUE_STATEMENT
    idx = ast.add(t, nodekind)
    ast.set-slot(t, idx, 0, ast.put-str(t, label)); label
    ast.set-slot(t, idx, 1, ast.put-str(t, kind)); kind
    idx
}

; ps-mk-break-cont：建 Break/Continue 節點（label/kind 兩純量槽），供速寫復用。
ps-mk-break-cont = (t ast, brk i64, label str, kind str) (idx i64) {
    nodekind = asp.K_BREAK_STATEMENT
    brk == 0 -> nodekind = asp.K_CONTINUE_STATEMENT
    idx = ast.add(t, nodekind)
    ast.set-slot(t, idx, 0, ast.put-str(t, label)); label
    ast.set-slot(t, idx, 1, ast.put-str(t, kind)); kind
    idx
}

; ps-star-label：消費速寫關鍵字後的【可選】標籤（LABEL `#N`→numeric / IDENT→text），
;   對應 Go parseBreak/parseStar* 的尾部 label 吸收。回傳 kind：0=none / 1=numeric或text（label 写入 out）。
ps-star-label = (p psst, out []str) (k i64) {
    k = 0
    nt = ps-peek(p)
    nt == tok.LABEL -> {
        ltk = ps-peek-token(p)
        out[0] = ltk.lit
        out[1] = 'numeric'
        k = 1
        ps-bump(p)
    }
    nt == tok.IDENT -> {
        itk = ps-peek-token(p)
        out[0] = itk.lit
        out[1] = 'text'
        k = 1
        ps-bump(p)
    }
    k
}

; ps-parse-star-break：語句位 `*` → BreakStatement 速寫（Go parseStarBreakOrExpr stmt.go:2913）。
;   閘門：peek(1) ∈ {NEWLINE,EOF,SEMICOLON,RBRACE,LABEL,IDENT} 才視作 break；否則退回表達式陳述。
;   ⚠️ 閘門含 IDENT——`* x` 在 Go 即 break+label x（怪异但必须逐位元組鏡像）。
ps-parse-star-break = (t ast, p psst) (idx i64) {
    idx = 0
    nt = ps-peek-at(p, 1)
    isBrk = 0
    nt == tok.NEWLINE || nt == tok.EOF || nt == tok.SEMICOLON || nt == tok.RBRACE || nt == tok.LABEL || nt == tok.IDENT -> isBrk = 1
    isBrk == 1 -> {
        ps-bump(p); 消費 *
        lab []str = with-cap(2)
        lab.push('')
        lab.push('none')
        ps-star-label(p, lab)
        idx = ps-mk-break-cont(t, 1, lab[0], lab[1])
    }
    isBrk == 0 -> idx = ps-parse-expr-stmt(t, p)
    idx
}

; ps-parse-star-star-cont：語句位 `**` → ContinueStatement 速寫（Go parseStarStarContinue stmt.go:2937，無閘門）。
ps-parse-star-star-cont = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 **
    lab []str = with-cap(2)
    lab.push('')
    lab.push('none')
    ps-star-label(p, lab)
    idx = ps-mk-break-cont(t, 0, lab[0], lab[1])
    idx
}

; ps-rarrow-same-line：目前是否為【與前一個 token 同列】的 `->`（對應 Go
;   `currentToken==RARROW && prevToken.Type != NEWLINE`）。⚠️ NEWLINE 在 ps.no
;   raw token 流中【保留】，故直接看 p.pos-1 的型別即可判是否換行。
ps-rarrow-same-line = (p psst) (yes i64) {
    yes = 0
    ps-peek(p) == tok.RARROW -> {
        prevTyp = 0
        p.pos >= 1 -> {

            #{index-out=zero, overflow=wrap}
            prevTyp = p.toks[p.pos - 1].typ
        }
        prevTyp != tok.NEWLINE -> yes = 1
    }
}

; ps-standalone-body：解析獨立 if-then 的本體（已消費其前面的 `->`），對應
;   Go parseStandaloneBody。回傳 (blk, tail)：blk=BlockStatement 節點；tail=可再鏈式
;   的單一運算式節點（僅運算式本體非 0；區塊/陳述本體為 0，不可鏈）。
;   ⚠️ 不跳 trivia——對齊 Go 直接看 currentToken：`-> \n` 之類換行→回空非內聯 Block。
ps-standalone-body = (t ast, p psst) (blk i64, tail i64) {
    blk = 0
    tail = 0
    hd = ps-peek(p)

    ; 區塊本體 `{ stmts }` → 非內聯 Block（ps-parse-block 不自動吃大括號）
    hd == tok.LBRACE -> {
        ps-bump(p); 消費 {
        blk = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
        return
    }

    ; 終止符（換行/}/EOF）→ 空非內聯 Block
    hd == tok.NEWLINE || hd == tok.RBRACE || hd == tok.EOF -> {
        blk = ast.add(t, asp.K_BLOCK_STATEMENT)
        ast.set-count(t, blk, 0, 0)
        return
    }

    ; 陳述型本體：關鍵字（return/break/continue）或 `IDENT =/,`（let/multi-assign）
    ;   → 內聯 Block{[stmt]}、tail=0（非 ExprStmt ⇒ 不可鏈）
    isStmt = 0
    hd == tok.RETURN || hd == tok.BREAK || hd == tok.CONTINUE || hd == tok.MUL || hd == tok.STAR_STAR -> isStmt = 1
    hd == tok.IDENT && (ps-peek-at(p, 1) == tok.ASSIGN || ps-peek-at(p, 1) == tok.COMMA) -> isStmt = 1
    isStmt == 1 -> {
        s = ps-parse-stmt(t, p)
        blk = ast.add(t, asp.K_BLOCK_STATEMENT)
        s > 0 -> {
            ast.kid-add(t, blk, s)
            ast.set-count(t, blk, 0, 1)
        }
        ast.set-slot(t, blk, 0, ast.put-str(t, 'true')); inline
        return
    }

    ; 運算式本體 → 內聯 Block{[ExprStmt{e}]}、tail=e（可鏈）
    e = ps-parse-expr(t, p)
    es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
    ast.kid-add(t, es, e)
    blk = ast.add(t, asp.K_BLOCK_STATEMENT)
    ast.kid-add(t, blk, es)
    ast.set-count(t, blk, 0, 1)
    ast.set-slot(t, blk, 0, ast.put-str(t, 'true')); inline
    tail = e
}

; ps-wrap-chain：獨立 if-then 的【鏈式 `->`】處理，對應 Go wrapStandaloneChainDepth。
;   當 blk 是單一內聯 ExprStmt（tail>0）且後面跟【同列】`->` 時，tail 變成巢狀 if 的
;   cond：`a -> b -> c` → if(a){ inline[ExprStmt{ if(b){ inline[ExprStmt{c}] } }] }。
;   ⚠️ 遞迴把後續所有同列 `->` 吃光，故本層只需一次判定（不需 while 迴圈）。
;   ⚠️ lint：进入时 linkIdx==2 代整條鏈已達第 3 個條件 ⇒ saveWarning(WarnChainedIf) 一次（
;     與鏈長無關）；單條 `a -> b`（链只一層， recurse 到 linkIdx==2 時已無同列 ->，不進本支）不告警。
;   ⚠️ arena：tail（cond）與 nextBlk（遞迴产物）均已先建，再【父後建】 chained→es→newblk。
ps-wrap-chain = (t ast, p psst, blk i64, tail i64, linkIdx i64) (blk2 i64) {
    blk2 = blk
    tail > 0 && ps-rarrow-same-line(p) -> {

        #{overflow=wrap}
        linkIdx == 2 -> p.warn = p.warn + 1
        ps-bump(p); 消費 ->
        nextBlk, nextTail = ps-standalone-body(t, p)
        lid = 0
        lid = linkIdx
        #{overflow=wrap}
        lid = lid + 1
        nextBlk = ps-wrap-chain(t, p, nextBlk, nextTail, lid)
        ; s8w：鏈式獨立 if 的尾隨 else【綁到最內層 if】（Go 語意）。
        ;   當本層 body 為區塊（nextTail==0、鏈到此終止）且其後【同列】有 `->` 時，就地
        ;   吃掉該 `-> {E}`。⚠️ Go 不是把它當最內層 if 的 else，而是以整條最內層 if
        ;   作【條件】再包一層 IfExpression{cond=chained, consequence=nil, alternative={E}}
        ;   （dump.go:486-492：恆印 cond、then/else 非 nil 才印 ⇒ 外層只顯示 cond=內層 if
        ;   + 一個 else 區塊）。`a -> b -> {B} -> {E}`：oracle 為
        ;   if(a){ inline: if( if(b){B} ){else E} }，非 if(a){if(b){B}else{E}}。單條 if
        ;   （外層 blk 的 tail 恆 0、不進本支）仍由 mk-standalone-if 的 else 邏輯處理。
        altW = 0
        nextTail == 0 && ps-rarrow-same-line(p) -> {
            ; s8w：尾隨 else 是 Go wrapStandaloneChainDepth【同一 frame 的下一次 for 迭代】
            ;   （stmt.go:1847–1862）——同 linkIdx、再 consume 一個 `->`。故此折疊在
            ;   linkIdx==2 時【也要】告警一次（與上方主鏈迭代同 frame、Go 各迭代各報一次）。
            ;   else-body 的後續鏈（若 body 是運算式鏈）以 linkIdx+1 遞迴，鏡 Go
            ;   `wrapStandaloneChainDepth(nextBody, linkIdx+1)`。
            ;   byte.no UTF-8 分支 `c1->{B}->c2->{B}->c3->{B}->{E}`：c3 子鏈落在 linkIdx==2
            ;   frame，主迭代(->{B})+尾折疊(->{E}) 各報一次 ⇒ oracle Program{warnings: 2}。
            linkIdx == 2 -> p.warn = p.warn + 1
            ps-bump(p); 消費 ->
            ablk, atail = ps-standalone-body(t, p)
            elid = linkIdx
            #{overflow=wrap}
            elid = elid + 1
            altW = ps-wrap-chain(t, p, ablk, atail, elid)
        }
        chained = ast.add(t, asp.K_IF_EXPRESSION)
        ast.kid-add(t, chained, tail)
        ast.kid-add(t, chained, nextBlk)
        ast.kid-add(t, chained, 0)
        esChild = chained
        altW > 0 -> {
            wrapper = ast.add(t, asp.K_IF_EXPRESSION)
            ast.kid-add(t, wrapper, chained)
            ast.kid-add(t, wrapper, 0)
            ast.kid-add(t, wrapper, altW)
            esChild = wrapper
        }
        es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
        ast.kid-add(t, es, esChild)
        newblk = ast.add(t, asp.K_BLOCK_STATEMENT)
        ast.kid-add(t, newblk, es)
        ast.set-count(t, newblk, 0, 1)
        ast.set-slot(t, newblk, 0, ast.put-str(t, 'true')); inline
        blk2 = newblk
    }
}

; ps-mk-standalone-if：由 cond 組裝整個獨立 if-then。前置條件：目前 token 為 cond
;   之後的第一個 `->`（呼叫端已確認 ps-peek==RARROW）。對應 Go parseExpressionStatement
;   的 standalone 分支：吃 `->` → body → wrap-chain →（可能）else 分支 → 組 IfExpression。
;   s50：另復刻 Go parseBlockStatement 迴圈開頭的【換行後 `-> else` 續接】（stmt.go:2168–2186）：
;   同列 else 未命中（alt==0）且尚在區塊層級（inBlk=1、非臂內 inMatch=0）時，前探跳過
;   NEWLINE/SEMICOLON；若碰到的恰是 `->`，就地吃掉它並把 body 寫進 alt 槽——節點尚未組装，
;   無需 kids 原地覆寫（曾試过 ast.no 加 kid-set 原地覆寫方案，因需等到節點建好後再改，
;   参數/生命周期復杂度 higher 而放弃；s50 一度誤判其「汚染代碼生成」，實為誤用主樹
;   bin/no 當工具链的误编译——自 host 構建必須用 /tmp/nolang-v44 钉死的 v44 工具链）。
;   Go 對照：已挂 alt 的 if 不二次續接（ie.Alternative==nil 守衛）——本實现在同一陳述内
;   最多一次前探續接，語義相同。
ps-mk-standalone-if = (t ast, p psst, cond i64) (idx i64) {
    ps-bump(p); 消費 cond 之後的 ->
    blk, tail = ps-standalone-body(t, p)
    blk = ps-wrap-chain(t, p, blk, tail, 1)

    ; else 分支：`cond -> {block} -> elseBody`（罕見；链已吃光同列 -> 後仅剩此情形）
    alt = 0
    ps-rarrow-same-line(p) -> {
        ps-bump(p); 消費 ->
        ablk, altail = ps-standalone-body(t, p)
        alt = ps-wrap-chain(t, p, ablk, altail, 1)
    }

    ; 換行後續接：僅區塊層級、非臂內、同列 else 未命中時前探
    alt == 0 && p.inBlk == 1 && p.inMatch == 0 -> {
        k = 0
        (ps-peek-at(p, k) == tok.NEWLINE || ps-peek-at(p, k) == tok.SEMICOLON) {

            #{overflow=wrap}
            k = k + 1
        }
        ps-peek-at(p, k) == tok.RARROW -> {
            m = 0
            (m < k) {
                ps-bump(p); 跳過 NEWLINE/SEMI trivia

                #{overflow=wrap}
                m = m + 1
            }
            ps-bump(p); 消費 ->
            ablk, altail = ps-standalone-body(t, p)
            alt = ps-wrap-chain(t, p, ablk, altail, 1)
        }
    }
    idx = ast.add(t, asp.K_IF_EXPRESSION)
    ast.kid-add(t, idx, cond)
    ast.kid-add(t, idx, blk)
    ast.kid-add(t, idx, alt)
}

; ================= 陳述位 `{ … }`：裸 match desugar + 普通區塊陳述（s48） =================
; 對應 Go parseStatement LBRACE 臂（stmt.go:402–531）與 buildBareMatchDesugar
; （lowering.go:1727）：所有臂非 wildcard 且 >1 ⇒ 包一層 IfExpression{IntegerLiteral 1,
; Block{各臂 if(無 else) 為兄弟}}；否則由末臂往回組 elif 鏈（尾 wildcard ⇒ If{1,body}，
; 普通臂 else = 非內聯 Block{ExpressionStatement{後續鏈}}）。
; 保守退讓（回 0 交呼叫端還原）：臂首 `#{...}` 前置註解、`ok->` isDotVal 綁定、
; wildcard 出現在鏈中間（Go 要 mutation 已建節點的 else，s48 不支持）。

; ps-scan-nont：從 from 起第一個非 trivia（NEWLINE/COMMENT）的 token 下標；越界回 toks.len()。
ps-scan-nont = (p psst, from i64) (i i64) {
    i = from

    #{index-out=zero}
    (i < p.toks.len() && (p.toks[i].typ == tok.NEWLINE || p.toks[i].typ == tok.COMMENT)) {

        #{overflow=wrap}
        i = i + 1
    }
    i
}

; ps-arrow-scan0：從當前 token 往後、同一 logical 行內（NEWLINE/;/RBRACE/EOF 即停）
;   是否出現深度 0 的 `->`。鏡像 Go scanForArrowAtDepth0（match.go:607：只跟 ( ) [ ]，
;   RBRACE 屬停止集）。
ps-arrow-scan0 = (p psst) (yes i64) {
    yes = 0
    depth = 0
    done = false

    #{overflow=wrap}
    i = p.pos + 1
    (done == false && i < p.toks.len()) {

        #{index-out=zero}
        tt = p.toks[i].typ
        tt == tok.NEWLINE || tt == tok.SEMICOLON || tt == tok.RBRACE || tt == tok.EOF -> done = true
        tt == tok.LPAREN || tt == tok.LBRACKET -> {

            #{overflow=wrap}
            depth = depth + 1
        }
        tt == tok.RPAREN || tt == tok.RBRACKET -> {

            #{overflow=wrap}
            depth = depth - 1
            depth < 0 -> done = true
        }
        tt == tok.RARROW && depth == 0 -> {
            yes = 1
            done = true
        }
        done == false -> {

            #{overflow=wrap}
            i = i + 1
        }
    }
    yes
}

; ps-arrow-scan-line：從 from 起在同一首陳述內前視深度 0 的 `->`（鏡像 Go parser.go:912-942）。
;   NEWLINE/EOF/RPAREN/RBRACKET/RBRACE 於深度 0 → 無臂（回 0）；深度 0 `->` → 臂（回 1）。
;   服務 `IDENT .` 開頭首臂：`it.v = 99`（無 `->`）⇒ 0；`obj.m() -> ...`⇒ 1。上限 40 token。
ps-arrow-scan-line = (p psst, from i64) (yes i64) {
    yes = 0
    depth = 0
    done = false
    i = from
    stop = from + 40
    (done == false && i < p.toks.len() && i < stop) {

        #{index-out=zero}
        tt = p.toks[i].typ
        tt == tok.EOF || tt == tok.NEWLINE -> depth == 0 -> done = true
        tt == tok.LPAREN || tt == tok.LBRACE || tt == tok.LBRACKET -> {

            #{overflow=wrap}
            depth = depth + 1
        }
        tt == tok.RPAREN || tt == tok.RBRACKET || tt == tok.RBRACE -> {
            depth == 0 -> done = true
            depth > 0 -> {

                #{overflow=wrap}
                depth = depth - 1
            }
        }
        tt == tok.RARROW -> depth == 0 -> {
            yes = 1
            done = true
        }
        done == false -> {

            #{overflow=wrap}
            i = i + 1
        }
    }
    yes
}

; ps-is-arm-start：目前 token（呼叫前已跳 trivia）是否新臂開頭。鏡像 Go isArmStart
;   （match.go:563）：INT/_/:/-> 直接；IDENT 後 :/-> 或 LOR+{err,nil,ok} 或比較運算子後
;   同行探 `->`；NIL 後 :/->/LOR；NOT/?/. 後緊接 ->。
ps-is-arm-start = (p psst) (yes i64) {
    yes = 0
    t0 = ps-peek(p)
    t1 = ps-peek-at(p, 1)
    t0 == tok.INT || t0 == tok.UNDERSCORE || t0 == tok.COLON || t0 == tok.RARROW -> yes = 1
    t0 == tok.IDENT && (t1 == tok.COLON || t1 == tok.RARROW) -> yes = 1
    tk0 = ps-peek-token(p)
    t0 == tok.IDENT && t1 == tok.LOR && (tk0.lit == 'err' || tk0.lit == 'nil' || tk0.lit == 'ok') -> yes = 1
    t0 == tok.IDENT && (t1 == tok.EQUALS || t1 == tok.NOT_EQUALS || t1 == tok.LESS || t1 == tok.GREATER || t1 == tok.LESS_EQUALS || t1 == tok.GREATER_EQUALS || t1 == tok.LAND || t1 == tok.LOR) -> yes = ps-arrow-scan0(p)
    t0 == tok.NIL && (t1 == tok.COLON || t1 == tok.RARROW || t1 == tok.LOR) -> yes = 1
    (t0 == tok.NOT || t0 == tok.QUESTION || t0 == tok.DOT) && t1 == tok.RARROW -> yes = 1
    yes
}

; ps-is-opt-pat-start：鏡像 Go isOptionPatternStart（match.go:29543）——option 型樣臂首
;   （`->` / `nil ->` / `ok ->` / `err ->` / `!->` / `?->` / `.->`）。用於 NEWLINE 臂體
;   的收束判據與 inline 形空臂體偵測（expr.go:1251-1376：body 位見 option 型樣 ⇒
;   本臂空體 fallthrough）。⚠️ Go 中此判據【不受】checkArmStart 閘控（wildcard 臂
;   亦須停在 option 型樣前）。
ps-is-opt-pat-start = (p psst) (yes i64) {
    yes = 0
    t0 = ps-peek(p)
    t1 = ps-peek-at(p, 1)
    t0 == tok.RARROW -> yes = 1
    t0 == tok.NIL && t1 == tok.RARROW -> yes = 1
    tk0 = ps-peek-token(p)
    t0 == tok.IDENT && t1 == tok.RARROW && (tk0.lit == 'err' || tk0.lit == 'nil' || tk0.lit == 'ok') -> yes = 1
    t0 == tok.NOT && t1 == tok.RARROW -> yes = 1
    t0 == tok.QUESTION && t1 == tok.RARROW -> yes = 1
    t0 == tok.DOT && t1 == tok.RARROW -> yes = 1
    yes
}

; ps-la-sep：行首 `->`（p.pos 即 RARROW）是否為「臂分隔符」而非 wildcard 本身。
;   鏡像 Go leadingArrowIsSeparator（match.go:530）：往後遇 NEWLINE/;/EOF ⇒ 非分隔符
;   （=wildcard 本體開頭）；深度 0 再見 `->` ⇒ 是分隔符（`-> cond -> body` 形）。
ps-la-sep = (p psst) (yes i64) {
    yes = 0
    depth = 0
    done = false

    #{overflow=wrap}
    i = p.pos + 1
    (done == false && i < p.toks.len()) {

        #{index-out=zero}
        tt = p.toks[i].typ
        tt == tok.NEWLINE || tt == tok.SEMICOLON || tt == tok.EOF -> done = true
        tt == tok.LPAREN || tt == tok.LBRACKET || tt == tok.LBRACE -> {

            #{overflow=wrap}
            depth = depth + 1
        }
        tt == tok.RPAREN || tt == tok.RBRACKET || tt == tok.RBRACE -> {

            #{overflow=wrap}
            depth = depth - 1
            depth < 0 -> done = true
        }
        tt == tok.RARROW && depth == 0 -> {
            yes = 1
            done = true
        }
        done == false -> {

            #{overflow=wrap}
            i = i + 1
        }
    }
    yes
}

; ps-bm-scan：粗探【p.pos 為 LBRACE】的區塊是否裸 match（含深度 0 `->` 才嘗試）。
;   鏡像 Go classifyBlockAtCurrent(blockMatch) + stmt.go:418 例外：`{ name: { … } }`
;   （首非 trivia 為 IDENT 且第二/三非 trivia 依序 COLON、LBRACE）強制走普通區塊。
ps-bm-scan = (p psst) (yes i64) {
    yes = 0

    #{index-out=zero}
    p.toks[p.pos].typ == tok.LBRACE -> {

        #{overflow=wrap}
        i = ps-scan-nont(p, p.pos + 1)

        #{overflow=wrap}
        j = ps-scan-nont(p, i + 1)

        #{overflow=wrap}
        k = ps-scan-nont(p, j + 1)
        excl = false
        lbl = false
        (i < p.toks.len() && j < p.toks.len() && k < p.toks.len()) -> {

            #{index-out=zero}
            iID = p.toks[i].typ == tok.IDENT

            #{index-out=zero}
            jCL = p.toks[j].typ == tok.COLON

            #{index-out=zero}
            kLB = p.toks[k].typ == tok.LBRACE

            #{index-out=zero}
            kID = p.toks[k].typ == tok.IDENT

            #{index-out=zero}
            jAS = p.toks[j].typ == tok.ASSIGN

            #{index-out=zero}
            jCM = p.toks[j].typ == tok.COMMA

            ; s7 續 H2：`IDENT : IDENT {`（巢狀結構值 name: Type{…}）⇒ blockStruct（excl）
            (iID == true && jCL == true && kID == true) -> {
                k4 = ps-scan-nont(p, k + 1)

                #{index-out=zero}
                k4 < p.toks.len() && p.toks[k4].typ == tok.LBRACE -> excl = true
            }

            ; s7 續 H2：`IDENT : {`（labelled block/match）⇒ Go classifyBlockAtCurrent
            ;   「name : { 刻意不覆蓋——該形是 labelled block/match」落到 blockMatch。
            ;   ⚠️ 舊缺陷：此形被 excl 誤擋 ⇒ scan=0 ⇒ 明示臂體誤標 blockBody
            ;   （err-binding.no `err(m) -> { b: { … } … }`）。注意其內層 `->` 全在
            ;   括號 depth>0，箭頭掃描摸不到 ⇒ 必須顯式判定、不可只靠掃描。
            (iID == true && jCL == true && kLB == true) -> lbl = true

            ; s7 續 H3：`IDENT =` 起頭（賦值陳述塊）⇒ Go tok2==ASSIGN 回 blockEnum
            ;   （classifyBlockAtCurrent 呼叫點只比 blockMatch ⇒ 視為非 match、走
            ;   普通塊 IsBlockBody=true）。箭頭掃描會被後續獨立 if 的 `->` 誤觸
            ;   （std-byte-indexing.no / server.no 等 10 檔回歸根因）。
            ;   `IDENT ,`（多重指派 `a, b = …` 起頭）同理——Go tok2==COMMA 回
            ;   blockEnum（json-parse-option.no / std-byte-indexing.no 5d 臂）。
            (iID == true && jAS == true) -> excl = true
            (iID == true && jCM == true) -> excl = true
        }
        lbl == true -> yes = 1

        #{index-out=zero}
        excl == false && lbl == false && i < p.toks.len() -> {
            depth = 0
            done = false
            m = i
            (done == false && m < p.toks.len()) {

                #{index-out=zero}
                tt = p.toks[m].typ

                ; s7 續 H4：箭頭掃描【同行】內止步（NEWLINE/SEMICOLON 即停）——鏡像
                ;   Go scanForArrowAtDepth0（match.go:25486 同停止集）與 isArmStart
                ;   的 arm 型樣同行口徑。舊缺陷：跨行掃描被【後續陳述】的獨立 if `->`
                ;   誤觸 ⇒ `it.set-str(…)` / `a = …` 等語句起頭塊被判 blockMatch
                ;   （json-get-clone.no / std-byte-indexing.no 5d 臂）。
                tt == tok.NEWLINE || tt == tok.SEMICOLON -> done = true
                tt == tok.EOF -> done = true
                tt == tok.RBRACE && depth == 0 -> done = true
                tt == tok.RARROW && depth == 0 -> {
                    yes = 1
                    done = true
                }
                tt == tok.LBRACE || tt == tok.LBRACKET || tt == tok.LPAREN -> {

                    #{overflow=wrap}
                    depth = depth + 1
                }
                tt == tok.RBRACE && depth > 0 -> {

                    #{overflow=wrap}
                    depth = depth - 1
                }
                tt == tok.RBRACKET || tt == tok.RPAREN -> {

                    #{overflow=wrap}
                    depth = depth - 1
                }
                done == false -> {

                    #{overflow=wrap}
                    m = m + 1
                }
            }
        }
    }
    yes
}

; ps-arm-blk-match：【臂體大括號】閘——Go expr.go:1253 `classifyBlockAtCurrent() != blockMatch`
;   的鏡像判定。與 ps-bm-scan（stmt 級啟發式）的差異：Go 臂體級嚴格用【形狀分類】，
;   「有 depth-0 箭頭」≠blockMatch。補三條箭頭掃描會誤觸的非 match 形（皆 blockUnknown/blockIface）：
;     · DOT IDENT LPAREN（`.m(…) ->` 方法呼叫陳述，parser.go:791-793）
;     · DOT IDENT ASSIGN（`.f = v` 欄位賦值陳述，:788-790）
;     · IDENT LPAREN（`f(x) ->` 呼叫陳述，:828-832 blockIface）
;   s7 續 I：str/txt `to-bool` 的 `.byte(0) == … -> {…}` 臂體被誤收單臂 match
;   （SurfaceMatch{arms:1} 反向多臂）即此三形。
ps-arm-blk-match = (p psst) (yes i64) {
    yes = 0
    ps-bm-scan(p) == 1 -> {
        i = ps-scan-nont(p, p.pos + 1)
        excl = 0
        i < p.toks.len() -> {

            #{index-out=zero}
            t0 = p.toks[i].typ
            t1 = tok.EOF
            t2 = tok.EOF
            i + 1 < p.toks.len() -> {

                #{index-out=zero}
                t1 = p.toks[i + 1].typ
            }
            i + 2 < p.toks.len() -> {

                #{index-out=zero}
                t2 = p.toks[i + 2].typ
            }
            t0 == tok.DOT && t1 == tok.IDENT && (t2 == tok.LPAREN || t2 == tok.ASSIGN) -> excl = 1
            t0 == tok.IDENT && t1 == tok.LPAREN -> excl = 1
        }
        excl == 0 -> yes = 1
    }
    yes
}

; s61：ps-bm-block-shape：明示臂 `{ }` 體的分類前視（p.pos 已消費 LBRACE，於首個非 trivia token）。
;   鏡像 Go classifyBlockAtCurrent（parser.go:704-945）：回 1==blockMatch ⇔ Go 走「inline 語句形」
;   （expr.go:1263-1310：stmt 提取進臂體區塊且 IsInline=true）或 NEWLINE 臂體形（同標 inline）
;   ⇒ dump `inline: true`；回 0 ⇒ parseBlockStatement 普通路（inline:false）。
;   精確判据（r11/r12/r13 探针实测钉死）：`IDENT :` 開頭属 tok2==COLON 的**其他**子形（非字面值後
;   NEWLINE/}/, 等）⇒ blockStruct(0)——`b:`+換行、`b: {`、`b: ident(\n` 皆 0；`IDENT NEWLINE` 亦 0（結構欄形）。
;   其余首臂形（`_`/`->`/`:`/字面值/`!`/IDENT 後 `->`/比較運算子+本行深度 0 有 `->`）⇒ 1。
;   ⚠️ 只服務明示臂體；语句级裸 `{` 仍用 ps-bm-scan（s48 保守形，不動）。
ps-bm-block-shape = (p psst) (yes i64) {
    yes = 0
    i = ps-scan-nont(p, p.pos + 1)
    i >= p.toks.len() -> return

    #{index-out=zero}
    t1 = p.toks[i].typ
    t1 == tok.EOF || t1 == tok.RBRACE -> return

    ; 首臂直接形（Go tok1 switch：COLON 屬 blockMatch；RBRACE 於非 CTX_MATCH_COND ⇒ blockStruct）
    {
        t1 == tok.UNDERSCORE || t1 == tok.RARROW || t1 == tok.COLON || t1 == tok.NOT -> yes = 1

        t1 == tok.INT || t1 == tok.FLOAT || t1 == tok.STRING || t1 == tok.CHAR || t1 == tok.REGEX || t1 == tok.TRUE || t1 == tok.FALSE -> yes = 1
    }
    t1 == tok.DOT -> {

        #{index-out=zero}
        t2 = p.toks[i + 1].typ
        t3 = tok.EOF
        i + 2 < p.toks.len() -> {

            #{index-out=zero}
            t3 = p.toks[i + 2].typ
        }

        ; `.field ->` 臂形；`.x = ` 賦值、`.m(` 呼叫 ⇒ 普通區塊（Go parser.go:739-760）
        t2 != tok.IDENT || (t3 != tok.ASSIGN && t3 != tok.LPAREN) -> yes = 1
    }
    t1 == tok.IDENT || t1 == tok.NIL || t1 == tok.IN -> {

        #{index-out=zero}
        t2 = p.toks[i + 1].typ
        t3 = tok.EOF
        t4 = tok.EOF
        t5 = tok.EOF
        t6 = tok.EOF
        i + 2 < p.toks.len() -> {

            #{index-out=zero}
            t3 = p.toks[i + 2].typ
        }
        i + 3 < p.toks.len() -> {

            #{index-out=zero}
            t4 = p.toks[i + 3].typ
        }
        i + 4 < p.toks.len() -> {

            #{index-out=zero}
            t5 = p.toks[i + 4].typ
        }
        i + 5 < p.toks.len() -> {

            #{index-out=zero}
            t6 = p.toks[i + 5].typ
        }

        ; tok2 直接形
        {
            t2 == tok.RARROW -> yes = 1

            t2 == tok.NEWLINE || t2 == tok.RBRACE || t2 == tok.COMMA -> yes = 0; Go 宣告欄位形（r13 實測 0）

            t2 == tok.EQUALS || t2 == tok.NOT_EQUALS || t2 == tok.LESS || t2 == tok.GREATER || t2 == tok.LESS_EQUALS || t2 == tok.GREATER_EQUALS || t2 == tok.LAND || t2 == tok.LOR -> yes = 1; Go :943 直接 blockMatch

            t2 == tok.DOT -> yes = ps-arrow-scan-line(p, i + 2); Go :912-942 前視深度 0 `->`（如 `it.v = 99` 無臂→ blockUnknown 0）

            t2 == tok.COLON -> {

                ; 鏡像 parser.go:800-911：默認 blockMatch(1)，僅結構欄形 → blockStruct(0)
                yes = 1

                ; name : TYPE \n|}|,
                t3 == tok.IDENT || t3 == tok.PTR -> t4 == tok.NEWLINE || t4 == tok.RBRACE || t4 == tok.COMMA -> yes = 0

                ; name : 字面值 \n|}|,
                t3 == tok.STRING || t3 == tok.INT || t3 == tok.TRUE || t3 == tok.FALSE || t3 == tok.NIL -> t4 == tok.NEWLINE || t4 == tok.RBRACE || t4 == tok.COMMA -> yes = 0

                ; name : -INT \n|}|,
                t3 == tok.SUB && t4 == tok.INT && (t5 == tok.NEWLINE || t5 == tok.RBRACE || t5 == tok.COMMA) -> yes = 0

                ; name : .field（臂絕不有此形）
                t3 == tok.DOT -> yes = 0

                ; name : IDENT <op|(|{|[ ⇒ 結構欄；name : IDENT . IDENT <tail> ⇒ 結構欄
                t3 == tok.IDENT -> {
                    t4 == tok.OR || t4 == tok.AND || t4 == tok.XOR || t4 == tok.ADD || t4 == tok.SUB ||
t4 == tok.MUL || t4 == tok.QUO || t4 == tok.MOD || t4 == tok.SHL || t4 == tok.SHR ||
t4 == tok.LPAREN || t4 == tok.LBRACE || t4 == tok.LBRACKET -> yes = 0
                    t4 == tok.DOT && t5 == tok.IDENT && (t6 == tok.LPAREN || t6 == tok.OR || t6 == tok.AND || t6 == tok.XOR || t6 == tok.ADD || t6 == tok.SUB || t6 == tok.MUL || t6 == tok.QUO || t6 == tok.MOD || t6 == tok.SHL || t6 == tok.SHR || t6 == tok.NEWLINE || t6 == tok.RBRACE || t6 == tok.COMMA) -> yes = 0
                }

                ; isStructFieldValueShape：t3 ∈ {LBRACKET,LPAREN,NOT,UNDERSCORE,FLOAT,CHAR,REGEX}
                t3 == tok.LBRACKET || t3 == tok.LPAREN || t3 == tok.NOT || t3 == tok.UNDERSCORE ||
t3 == tok.FLOAT || t3 == tok.CHAR || t3 == tok.REGEX -> yes = 0

                ; isFieldValueStart(t3) && isBinaryOp(t4)：name : <value><binop>
                t3 == tok.INT || t3 == tok.STRING || t3 == tok.TRUE || t3 == tok.FALSE || t3 == tok.NIL ||
t3 == tok.FLOAT || t3 == tok.CHAR || t3 == tok.REGEX || t3 == tok.LBRACKET || t3 == tok.LPAREN || t3 == tok.NOT || t3 == tok.UNDERSCORE -> {
                    t4 == tok.ADD || t4 == tok.SUB || t4 == tok.MUL || t4 == tok.QUO || t4 == tok.MOD || t4 == tok.AND || t4 == tok.OR || t4 == tok.XOR || t4 == tok.SHL || t4 == tok.SHR || t4 == tok.EQUALS || t4 == tok.NOT_EQUALS || t4 == tok.LESS || t4 == tok.LESS_EQUALS || t4 == tok.GREATER || t4 == tok.GREATER_EQUALS || t4 == tok.LAND || t4 == tok.LOR -> yes = 0
                }
            }
        }
    }
    yes
}

; ps-parse-bare-match：解析裸 match 區塊（p.pos 於 LBRACE），回 desugared 外層
;   IfExpression 索引；回 0 ⇒ 失敗（p.pos 不定，呼叫端自行還原重解析）。臂形鏡像
;   Go parseBareMatchExpr：`expr -> body`／`_ -> body`／`-> body`（含 `-> cond -> body`
;   分隔符形）；body 三形：`{ … }` 區塊（可內層再套裸 match）、換行 block 形（語句
;   至臂界）、同行單陳述（後兩者 Block{inline:true}）。
ps-parse-bare-match = (t ast, p psst) (res i64) {
    res = 0
    fail = 0
    ps-bump(p); 消費 {

    ; 臂解析狀態：換行後 `->` 在 Go 由臂迴圈消化（wildcard 臂），不是區塊層級續接
    ;   （stmt.go:2168 只在 parseBlockStatement 迴圈開頭）⇒ 抑制 ps-mk-standalone-if 前探。
    ;   臂 body 若為 { } 區塊，ps-parse-block 會自行清零 inMatch ✔。
    oldMat = p.inMatch
    p.inMatch = 1
    condA []i64 = with-cap(4); wildcard 臂存 0
    bodyA []i64 = with-cap(4)
    wildA []i64 = with-cap(4)
    dotA []i64 = with-cap(4); s7 裁定①：dotVal 標記（ok-> ⇒ 1）
    bbSA []i64 = with-cap(4); s7 裁定①：blockBody 標記（LBRACE/NEWLINE 體 ⇒ 1，oracle IsBlockBody）
    mv = p.valCtx; s7 裁定①：入函值語境快照（ps-parse-stmt 每陳述重置 p.valCtx，尾讀必為 0）
    done = false
    (done == false && fail == 0) {

        ; s59：臂首 armDoc 收集（Go match.go:208）；行尾註解由各體形当场 tail-attach
        armDoc = ps-skip-trivia-doc(t, p, 0)
        hd = ps-peek(p)
        hd == tok.RBRACE || hd == tok.EOF -> done = true
        hd == tok.SEMICOLON -> ps-bump(p); 臂間分號（Go 同跳）
        hd == tok.HASH_LBRACE -> fail = 1; 臂首前置註解不支持 → 退讓
        hd != tok.RBRACE && hd != tok.EOF && hd != tok.SEMICOLON && hd != tok.HASH_LBRACE -> {
            wild = 0
            cond = 0
            dot = 0
            bbArm = 0
            A = ps-peek(p)
            A == tok.UNDERSCORE -> {
                ps-bump(p)
                wild = 1
            }
            A == tok.RARROW && ps-la-sep(p) == 1 -> ps-bump(p); 分隔符 `->`，續解析條件
            A == tok.RARROW && ps-la-sep(p) == 0 -> {
                ps-bump(p)
                wild = 1
            }
            tk0 = ps-peek-token(p)

            ; s7 裁定①：`ok->`（dotVal 臂）——oracle match.go:347-357 產 wildcard+dotVal
            ;   且【保留】Condition=Identifier{ok}（P1 不丟源碼識別字）。desugar 路
            ;   （PS-SURFACE-MATCH=0）維持 s48 保守退讓（fail ⇒ 宿主 fallback）；surface 路收錄。
            tk0.typ == tok.IDENT && tk0.lit == 'ok' && ps-peek-at(p, 1) == tok.RARROW -> {
                PS-SURFACE-MATCH == 0 -> fail = 1
                PS-SURFACE-MATCH == 1 -> {
                    wild = 1
                    dot = 1
                    cond = ps-mk-ident(t, 'ok')
                    ps-bump(p); 消費 ok（`->` 由下方 wild==1 路徑的 RARROW 消費）
                }
            }

            ; wildcard 臂：`_` 後必須緊接 `->`；RARROW 形已在上支消費
            ; ⚠️ ad 快照旗標：arrow 已吃後第二行不得因【重取 ps-peek】誤判 fail（match 塊非互斥）
            fail == 0 && wild == 1 -> {
                ad = 0
                ps-peek(p) == tok.RARROW -> {
                    ps-bump(p)
                    ad = 1
                }
                ad == 0 && A == tok.UNDERSCORE -> fail = 1
            }

            ; 條件臂：完整布爾式後【同行】緊接 `->`（Go：currentToken 非 RARROW 即回 nil）
            fail == 0 && wild == 0 -> {
                cond = ps-parse-expr(t, p)
                (cond == 0 || ps-peek(p) != tok.RARROW) -> fail = 1
                fail == 0 -> ps-bump(p); 消費 ->
            }

            ; ── 臂本體三形 ──
            blk = 0
            fail == 0 -> {
                hd2 = ps-peek(p)
                hd2 == tok.LBRACE -> {
                    bbArm = 1

                    ; 先試內層裸 match（Go：classify==blockMatch 時 parseStatement 優试），
                    ;   成則 body Block 含單 ExpressionStatement；敗則【還原 nsave】吃大括號走普通 block
                    ; ⚠️ ps-parse-bare-match 失敗時 p.pos 已在其自身 `{`/cond 處推進，不還原會雙重消費（http.no 掛死根因）
                    nested = 0
                    nsave = p.pos
                    bm2 = ps-bm-scan(p)
                    PS-SURFACE-MATCH == 1 -> bm2 = ps-arm-blk-match(p)
                    bm2 == 1 -> nested = ps-parse-bare-match(t, p)
                    nested == 0 -> {
                        p.pos = nsave
                        ps-bump(p); 消費 {
                        blk = ps-parse-block(t, p)
                        ps-expect(p, tok.RBRACE)

                        ; s59：大括號臂 armDoc → 區塊尾註群最前（Go match.go:443 merged）
                        armDoc != 0 -> ps-premerge-trailing(t, blk, armDoc)
                    }
                    nested > 0 -> {
                        es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
                        ast.kid-add(t, es, nested)
                        blk = ast.add(t, asp.K_BLOCK_STATEMENT)
                        ast.kid-add(t, blk, es)
                        ast.set-count(t, blk, 0, 1)
                    }
                }
                hd2 == tok.NEWLINE -> {
                    bbArm = 1

                    ; block 形（無大括號）：語句解析至臂界/}`；Go 將 bodyBlock.IsInline=true
                    sl []i64 = with-cap(4)
                    bdone = false
                    (bdone == false && fail == 0) {

                        ; s59：對齊 Go match.go:355-359（collectDoc→parseStatement→setDoc→attachInlineComment）
                        sdoc = ps-skip-trivia-doc(t, p, 0)
                        hd3 = ps-peek(p)
                        hd3 == tok.RBRACE || hd3 == tok.EOF -> bdone = true
                        wild == 0 && bdone == false && ps-is-arm-start(p) == 1 -> bdone = true
                        bdone == false && fail == 0 -> {
                            pos0 = p.pos
                            s = ps-parse-stmt(t, p)
                            s > 0 -> {
                                sdoc != 0 -> ast.set-doc(t, s, sdoc)
                                ps-peek(p) == tok.COMMENT -> {
                                    ast.set-cmt(t, s, ast.put-doc-str(t, ps-cur-lit(p)))
                                    ps-bump(p)
                                }
                                sl.push(s)
                            }
                            p.pos == pos0 -> ps-bump(p)
                        }
                    }

                    ; s59：IsInline 區塊體（Go match.go:441-442）：armDoc 覆寫首陳述 Doc
                    armDoc != 0 && sl.len() > 0 -> ast.set-doc(t, sl[0], armDoc)
                    blk = ast.add(t, asp.K_BLOCK_STATEMENT)
                    j = 0
                    (j < sl.len()) {
                        ast.kid-add(t, blk, sl[j])

                        #{overflow=wrap}
                        j = j + 1
                    }
                    ast.set-count(t, blk, 0, sl.len())
                    ast.set-slot(t, blk, 0, ast.put-str(t, 'true')); inline
                }
                hd2 != tok.LBRACE && hd2 != tok.NEWLINE -> {

                    ; 同行單陳述本體：Block{inline:true, [stmt]}
                    pos0 = p.pos
                    s = ps-parse-stmt(t, p)
                    (s == 0 || p.pos == pos0) -> fail = 1
                    fail == 0 -> {
                        blk = ast.add(t, asp.K_BLOCK_STATEMENT)
                        ast.kid-add(t, blk, s)
                        ast.set-count(t, blk, 0, 1)
                        ast.set-slot(t, blk, 0, ast.put-str(t, 'true')); inline

                        ; s59：armDoc → body 陳述 Doc（Go IsInline⇒setDoc(bodyStmts[0])）；
                        ;   行尾 `; cmt` → 該陳述 Comment（Go attachInlineComment）
                        armDoc != 0 -> ast.set-doc(t, s, armDoc)
                        ps-peek(p) == tok.COMMENT -> {
                            ast.set-cmt(t, s, ast.put-doc-str(t, ps-cur-lit(p)))
                            ps-bump(p)
                        }
                    }
                }
            }
            fail == 0 -> {
                condA.push(cond)
                bodyA.push(blk)
                wildA.push(wild)
                dotA.push(dot)
                bbSA.push(bbArm)
            }
        }
    }

    ; 閉合 `}`（有才吃，鏡像 Go）；空臂區 ⇒ 失敗
    ps-peek(p) == tok.RBRACE -> ps-bump(p)
    fail == 0 && condA.len() == 0 -> fail = 1

    ; ── desugar 組裝（buildBareMatchDesugar）──
    wc = 0
    z = 0
    (z < wildA.len()) {

        #{index-out=zero}
        wildA[z] == 1 -> {

            #{overflow=wrap}
            wc = wc + 1
        }

        #{overflow=wrap}
        z = z + 1
    }
    n = condA.len()
    bail = 0

    ; 全非 wildcard 且多臂 ⇒ 包一層 If{1, Block{各臂 if(無 else)}}（independent-guard fast path）
    fail == 0 && wc == 0 && n > 1 -> {
        kids []i64 = with-cap(4)
        z2 = 0
        (z2 < n) {
            ie = ast.add(t, asp.K_IF_EXPRESSION)
            ast.kid-add(t, ie, condA[z2])
            ast.kid-add(t, ie, bodyA[z2])
            ast.kid-add(t, ie, 0)
            es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
            ast.kid-add(t, es, ie)
            kids.push(es)

            #{overflow=wrap}
            z2 = z2 + 1
        }
        wb = ast.add(t, asp.K_BLOCK_STATEMENT)
        j2 = 0
        (j2 < kids.len()) {
            ast.kid-add(t, wb, kids[j2])

            #{overflow=wrap}
            j2 = j2 + 1
        }
        ast.set-count(t, wb, 0, kids.len())
        ct = ps-mk-true(t)
        res = ast.add(t, asp.K_IF_EXPRESSION)
        ast.kid-add(t, res, ct)
        ast.kid-add(t, res, wb)
        ast.kid-add(t, res, 0)
    }

    ; 否則：由末臂往回組 elif 鏈
    fail == 0 && res == 0 && (wc > 0 || n == 1) -> {

        #{overflow=wrap}
        i = n - 1
        (i >= 0 && bail == 0) {

            #{index-out=zero}
            w = wildA[i]

            #{index-out=zero}
            b = bodyA[i]
            hdw = 0
            w == 1 && res == 0 && bail == 0 -> {

                ; 尾 wildcard ⇒ If{IntegerLiteral 1(synthetic), body}無 else
                ct = ps-mk-true(t)
                ie = ast.add(t, asp.K_IF_EXPRESSION)
                ast.kid-add(t, ie, ct)
                ast.kid-add(t, ie, b)
                ast.kid-add(t, ie, 0)
                res = ie
                hdw = 1
            }

            ; 鏈中間 wildcard：Go 要改寫已建節點的 else，保守退讓
            ; ⚠️ hdw 快照守衛：上支剛建的 res 不得令本臂【誤復發】bail（match 塊非互斥）
            w == 1 && res > 0 && hdw == 0 -> {
                bail = 1
                hdw = 1
            }
            hdw == 0 -> {
                alt = 0
                res > 0 -> {

                    ; else = 非內聯 Block{ExpressionStatement{後續鏈}}
                    es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
                    ast.kid-add(t, es, res)
                    wb = ast.add(t, asp.K_BLOCK_STATEMENT)
                    ast.kid-add(t, wb, es)
                    ast.set-count(t, wb, 0, 1)
                    alt = wb
                }
                ie = ast.add(t, asp.K_IF_EXPRESSION)
                ast.kid-add(t, ie, condA[i])
                ast.kid-add(t, ie, b)
                ast.kid-add(t, ie, alt)
                res = ie
            }

            #{overflow=wrap}
            i = i - 1
        }
    }
    fail == 1 || bail == 1 -> res = 0

    ; s7 裁定①（2026-10-21）：surface 發射——對齊 oracle parseBareMatchExpr 產
    ;   SurfaceMatch{**無 Matched**}（match.go:638 newSurfaceMatch(tok, nil, arms)）。
    ;   與 ps-parse-match 的 surface 塊同構；差異：
    ;     ① 無 Matched 主體子節點（裸 match 無 subject）；
    ;     ② ok->（dotVal）臂【保留】Condition=Identifier{ok}（oracle P1；明示 match 的
    ;        ok-> 則 cond=0——兩路口徑各自對齊各自的 oracle）；
    ;     ③ blockBody = LBRACE【或】NEWLINE 體（oracle IsBlockBody 兩形皆真，match.go:393/454）；
    ;     ④ valueCtx 用入函快照 mv（s67 讀點修正：臂體 ps-parse-stmt 會重置活 p.valCtx）。
    ;   desugar 鏈（上方）仍按 s48 保守口徑組裝；flag=1 時被本塊覆寫、flag=0 時原樣保留。
    PS-SURFACE-MATCH == 1 && fail == 0 -> {
        n = condA.len()
        sm = ast.add(t, asp.K_SURFACE_MATCH)
        ast.set-slot(t, sm, 0, ast.put-str(t, n.to-str())); arms 數
        ; ⚠️ Matched 必須佔一個 0 kid：ast.add 的 kid0 是全域 kids 陣列的當時末位，
        ;   不佔位則 kid0 與【下一個節點】的 kid 槽別名（實測被外層
        ;   ExpressionStatement 的 kid-add 寫入 sm 自身）⇒ guarded Matched CHILD
        ;   讀到自己 → dump 無限遞迴 → SIGSEGV。佔 0 後 guard 讀 0 即跳過（dump 不印）。
        ast.kid-add(t, sm, 0)
        ast.helper-begin(t, sm, n)
        i = 0
        (i < n) {
            ; 12 aux / 臂：binding, bindingVariant, typePattern, typeBinding,
            ;   wildcard, dotVal, rawCond, blockBody, typeArm, valueCtx, Condition, Body
            ast.aux-add(t, 0); binding（裸 match 無析構綁定）
            ast.aux-add(t, 0); bindingVariant
            ast.aux-add(t, 0); typePattern
            ast.aux-add(t, 0); typeBinding

            #{index-out=zero}
            wildA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            wildA[i] == 0 -> ast.aux-add(t, 0); wildcard

            #{index-out=zero}
            dotA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            dotA[i] == 0 -> ast.aux-add(t, 0); dotVal
            ast.aux-add(t, 0); rawCond（ok(<expr>) 形不落裸 match 路）

            #{index-out=zero}
            bbSA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            bbSA[i] == 0 -> ast.aux-add(t, 0); blockBody
            ast.aux-add(t, 0); typeArm
            mv == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            mv == 0 -> ast.aux-add(t, 0); valueCtx（入函快照，見 A1 註解）

            #{index-out=zero}
            ast.aux-add(t, condA[i]); Condition（_/bare-> 臂=0；ok-> 臂=Identifier{ok}）

            #{index-out=zero}
            ast.aux-add(t, bodyA[i]); Body

            #{overflow=wrap}
            i = i + 1
        }
        res = sm
    }
    p.inMatch = oldMat
    res
}

; ps-parse-brace-stmt：陳述位 `{ … }` 統一入口（對齐 Go stmt.go:402 LBRACE 臂）：
;   含深度 0 `->` ⇒ 試裸 match，成則 ExpressionStatement{if鏈}；敗/非 match ⇒
;   還原後走普通 BlockStatement（ps-parse-block + 吃 `}`，語句不外洩）。
ps-parse-brace-stmt = (t ast, p psst) (idx i64) {
    savePos = p.pos
    idx = 0

    ; s57：`{ body } * N` 後置計數循環優先於裸 match/普通區塊（鏡像 Go stmt.go:402-406 LBRACE 臂序：
    ;   isCountedLoopBlockFirst 先測）。閘門為純前視、不消費 token ⇒ 不過則零副作用落原路徑。
    s57-count-blockfirst-p(p) == 1 -> idx = s57-parse-count-loop-blockfirst(t, p)
    idx == 0 -> ps-bm-scan(p) == 1 -> {
        bm = ps-parse-bare-match(t, p)
        bm > 0 -> {
            idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
            ast.kid-add(t, idx, bm)
        }
        bm == 0 -> p.pos = savePos; 還原，區塊内容改由普通 block 重解析
    }
    idx == 0 -> {
        ps-bump(p); 消費 {
        blk = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
        idx = blk
    }
    idx
}

; ps-parse-type：在當前位置解析一個型別並回傳其節點索引（**子先於父**）。
;   支持：NamedType（IDENT，含限定名 `a.b.c`）、NullableType（? T，遞迴）、
;   SliceType（[] T，T 可為巢狀 `[][]T`/限定 `[]a.b`/可為空 `[]?T`）、
;   ArrayType（[ N ] T，T 亦可巢狀）。
;   明示標註一律不設 inferred（dump 不印 `inferred: true`）。回 0 = 当前位置非合法型別起點。
;   ⚠️ 限定名對齊 Go stmt.go:1034 的 `for cur==DOT { name += "." + next IDENT }`：
;      整條 `tls.conn` 存進 NamedType 的 name 槽（type-string 直接讀 s0，不另建節點）。
;   ⚠️ 巢狀元素經【遞迴】ps-parse-type 取得（子先於父），故 `[][]i64` 建為
;      SliceType{ SliceType{ NamedType{i64} } }；type-string(ast.no:610) 遞迴印 `[][]i64`。
;   ⚠️ 用 `handled` 旗標（非互斥條件）防同块多臂重評：某臂已建 idx 後，後續臂不得再跑
;      （match 非排他，實測裸條件會因前一臂已消費 token 使後臂的活 ps-peek-at 誤命中）。
; ps-is-builtin-type：型別名是否為內建（Go type.go:399-408 isBuiltinTypeName）。
;   用於 `[K]V` 的 map／array 判定（見 ps-parse-type 的 s8e 臂）。
ps-is-builtin-type = (nm str) (r i64) {
    r = 0
    nm == 'str' -> r = 1
    nm == 'txt' -> r = 1
    nm == 'i64' -> r = 1
    nm == 'i32' -> r = 1
    nm == 'i16' -> r = 1
    nm == 'i8' -> r = 1
    nm == 'i128' -> r = 1
    nm == 'u64' -> r = 1
    nm == 'u32' -> r = 1
    nm == 'u16' -> r = 1
    nm == 'u8' -> r = 1
    nm == 'u128' -> r = 1
    nm == 'bool' -> r = 1
    nm == 'byte' -> r = 1
    nm == 'char' -> r = 1
    nm == 'f64' -> r = 1
    nm == 'f32' -> r = 1
}

ps-parse-type = (t ast, p psst) (idx i64) {
    ps-skip-trivia(p)
    tk = ps-peek-token(p)
    idx = 0
    handled = 0
    {
        handled == 0 && tk.typ == tok.IDENT -> {
            handled = 1
            ps-bump(p); 消費首段型別名
            nm = tk.lit
            go = true
            (go) {
                ps-peek(p) == tok.DOT && ps-peek-at(p, 1) == tok.IDENT -> {
                    ps-bump(p); 消費 .
                    seg = ps-lit-at(p, 0)
                    ps-bump(p); 消費 段名
                    nm = nm + '.' + seg
                }

                -> go = false
            }
            idx = ast.add(t, asp.K_NAMED_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, nm))

            ; s58：指標後綴 `T*` / `T**` 正規化為前綴形（Go type.go:1064-1070：typeLit = '*' + typeLit，
            ;   `*` 綁在 base 上、先於 ?/& 包裹——遞迴位置天然一致）
            (ps-peek(p) == tok.MUL) {
                ps-bump(p); 消費後綴 *
                pt = ast.add(t, asp.K_POINTER_TYPE)
                ast.kid-add(t, pt, idx)
                idx = pt
            }
            ps-peek(p) == tok.STAR_STAR -> {
                ps-bump(p); 消費後綴 **
                q1 = ast.add(t, asp.K_POINTER_TYPE)
                ast.kid-add(t, q1, idx)
                q2 = ast.add(t, asp.K_POINTER_TYPE)
                ast.kid-add(t, q2, q1)
                idx = q2
            }
        }

        handled == 0 && tk.typ == tok.QUESTION -> {
            handled = 1
            ps-bump(p); 消費 ?
            pti = ps-parse-type(t, p); 內層型別（遞迴）
            idx = ast.add(t, asp.K_NULLABLE_TYPE)
            ast.kid-add(t, idx, pti); 唯一 guarded CHILD=Type
        }

        handled == 0 && tk.typ == tok.MUL -> {
            handled = 1
            ps-bump(p); 消費 *
            inner = ps-parse-type(t, p)
            idx = ast.add(t, asp.K_POINTER_TYPE)
            ast.kid-add(t, idx, inner); guarded CHILD=Type
        }

        handled == 0 && tk.typ == tok.STAR_STAR -> {
            handled = 1
            ps-bump(p); 消費 **（詞法器合併為單 token）
            inner = ps-parse-type(t, p)
            p1 = ast.add(t, asp.K_POINTER_TYPE)
            ast.kid-add(t, p1, inner)
            idx = ast.add(t, asp.K_POINTER_TYPE)
            ast.kid-add(t, idx, p1); **T ⇒ PointerType{PointerType{T}}
        }

        handled == 0 && tk.typ == tok.AND -> {
            handled = 1
            ps-bump(p); 消費 &
            inner = ps-parse-type(t, p)
            idx = ast.add(t, asp.K_VIEW_TYPE)
            ast.kid-add(t, idx, inner); guarded CHILD=Type
        }

        handled == 0 && tk.typ == tok.LBRACKET && ps-peek-at(p, 1) == tok.RBRACKET && (ps-peek-at(p, 2) == tok.IDENT || ps-peek-at(p, 2) == tok.LBRACKET || ps-peek-at(p, 2) == tok.QUESTION) -> {
            handled = 1
            ps-bump(p); 消費 [
            ps-bump(p); 消費 ]
            elem = ps-parse-type(t, p); 元素型別（遞迴，子先於父）
            idx = ast.add(t, asp.K_SLICE_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, idx, elem)
        }

        ; s8e：`[K]V` 且 K 為【內建型別名】⇒ MapType，不是 ArrayType{size: K}。
        ;   Go type.go:835-849 parseTypeExpression：K 為 isBuiltinTypeName 或已註冊
        ;   結構／列舉名時建 MapType{Key:NamedType{K}, Value:V}（Value 可為複合型別，
        ;   如 `[str][]i64`），否則才落到下方 `[N]T` 陣列臂。
        ;   ⚠️ 泛型尺寸 `[n]t` 的 n 不是內建型別名 ⇒ 仍走陣列臂（arr.no 實測）。
        ;   ⚠️ 必須排在陣列臂【之前】：兩臂前綴同為 `[ IDENT ]`。
        handled == 0 && tk.typ == tok.LBRACKET && ps-peek-at(p, 1) == tok.IDENT && ps-peek-at(p, 2) == tok.RBRACKET && ps-is-builtin-type(ps-lit-at(p, 1)) == 1 -> {
            handled = 1
            kn2 = ps-lit-at(p, 1)
            ps-bump(p); 消費 [
            ps-bump(p); 消費 K
            ps-bump(p); 消費 ]
            vty = ps-parse-type(t, p); value 型別（遞迴）
            kt2 = ast.add(t, asp.K_NAMED_TYPE)
            ast.set-slot(t, kt2, 0, ast.put-str(t, kn2))
            idx = ast.add(t, asp.K_MAP_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, idx, kt2)
            ast.kid-add(t, idx, vty)
        }

        ; s8s：`[?]T` ——【尺寸為 unknown 的 ArrayType】（非 SliceType、非 NullableType 包裹）。
        ;   Go parseParamTypeAfterName type.go:1090-1092：`]` 前遇 `?` ⇒ paramType="[?]"，
        ;   再拼元素名 → buildType("[?]T") 產 ArrayType{Size:nil, Elem:NamedType{T}}；
        ;   dump 為 `ArrayType{size: <nil>}` 且【僅一個】可見子節點（Size 為 nil 不印）。
        ;   ⚠️ 必須排在其他 `[` 臂之前/互斥：本臂特徵是 +1==QUESTION（`[]`臂 +1==RBRACKET、
        ;   `[K]V`/`[N]T`臂 +1==INT/IDENT），故彼此不重疊。
        ;   ⚠️ kid0 佔位 push 0（Size=nil），type-string（ast.no:740）讀 kid0==0 ⇒ 印 `?`，
        ;   kid1=elem（ast.no:744 讀 kid0+1）。實測 number.no:1250 `(out [?]byte)`、
        ;   vec.no:182 `(out [?]t)`（修好後 s63 泛型走訪亦能由 NamedType{t} 收得 GenericParams）。
        handled == 0 && tk.typ == tok.LBRACKET && ps-peek-at(p, 1) == tok.QUESTION && ps-peek-at(p, 2) == tok.RBRACKET && (ps-peek-at(p, 3) == tok.IDENT || ps-peek-at(p, 3) == tok.LBRACKET || ps-peek-at(p, 3) == tok.QUESTION) -> {
            handled = 1
            ps-bump(p); 消費 [
            ps-bump(p); 消費 ?
            ps-bump(p); 消費 ]
            elem = ps-parse-type(t, p); 元素型別（遞迴，子先於父）
            idx = ast.add(t, asp.K_ARRAY_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, idx, 0); Size=nil（→ dump `size: <nil>`、type-string 印 `?`）
            ast.kid-add(t, idx, elem)
        }

        ; s65a：尺寸除 INT 外亦接受 IDENT（泛型尺寸 `[n]t`）。Go decl.go:301-303 的參數型別
        ;   解析 `if cur==INT || cur==IDENT { paramType = "[" + lit + "]" }` 同形；此前只收 INT
        ;   ⇒ `(dst [n]t)` 的 `[n]t` 不被當型別，逐 token 退化成 dst/n/t 三個參數（arr.no 實測）。
        handled == 0 && tk.typ == tok.LBRACKET && (ps-peek-at(p, 1) == tok.INT || ps-peek-at(p, 1) == tok.IDENT) && ps-peek-at(p, 2) == tok.RBRACKET && (ps-peek-at(p, 3) == tok.IDENT || ps-peek-at(p, 3) == tok.LBRACKET || ps-peek-at(p, 3) == tok.QUESTION) -> {
            handled = 1
            ps-bump(p); 消費 [
            sz = ps-parse-expr(t, p); 尺寸 IntegerLiteral / Identifier（泛型 n）
            ps-expect(p, tok.RBRACKET); 消費 ]
            elem = ps-parse-type(t, p); 元素型別（遞迴）
            idx = ast.add(t, asp.K_ARRAY_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, idx, sz)
            ast.kid-add(t, idx, elem)
        }

        -> {
        }
    }
    idx
}

; ps-parse-typedecl：解析【通用明示型別宣告】`name TYPE [= value]`——補齊各特化含值臂未覆蓋的
;   複合型形（限定名 `a.b`、巢狀 `[][]T`/`[N][]T`）之裸宣告與含值兩形。裸形對應 Go parseLetStatement
;   的 no-value 分支（stmt.go:1051–1060：型別後遇陳述邊界即 Value=nil，dump 為 `type: X, value: `）；
;   含值形對應 Go 的 `= expr` 分支（dump 為 `type: X, value: <expr>`）。
;   型別經 ps-parse-type（NamedType / SliceType / ArrayType / NullableType 全形，含限定/巢狀）。
;   ⚠️ 只在【上方各特化臂都未命中】（handled==0）時由分派處呼叫：`name IDENT = v`（+2==ASSIGN）
;   由單名含值臂、`[]T=[..]`/`[N]T=[..]`/`[K]V={..}` 由對應陣列/映射特化臂先行處理（它們有 ArrayLiteral
;   /MapLiteral desugar），故本函式只接住那些臂遺漏的複合型形，RHS 一律走 ps-parse-expr。
;   ⚠️ 復用 ps-parse-type 會【先建節點】；若型別後既非 `=` 亦非陳述邊界（如索引 `x[i]`、運算子）
;   則還原 p.pos、回 0，交由運算式陳述重解——所建節點不被任何 kid 引用即為孤兒，dumper 自 root
;   沿 kid 走訪永不觸及（見 ast.dump），故零回歸、僅耗少許 arena。
ps-parse-typedecl = (t ast, p psst, name str) (idx i64) {
    idx = 0
    savePos = p.pos
    ps-bump(p); 消費 name IDENT
    ty = ps-parse-type(t, p); 明示型別（子先於父）
    ty == 0 -> p.pos = savePos
    ty != 0 -> {

        ; 預取型別之後首個 token（同 ps-parse-for-kw 守則：勿在補集雙臂各重取）
        hd = ps-peek(p)

        ; 含值形：型別後接 `=` ⇒ LetStatement{name, type, value}
        hd == tok.ASSIGN -> {
            ps-bump(p); 消費 =
            ps-skip-trivia(p)
            val = ps-parse-expr(t, p)
            idx = ast.add(t, asp.K_LET_STATEMENT)
            ast.set-slot(t, idx, 0, ast.put-str(t, name))
            ast.kid-add(t, idx, ty); guarded CHILD=Type
            ast.kid-add(t, idx, val); guarded CHILD=Value
            ps-reg-let(t, p, name, ty); s51 登記
            ps-mark-ifd(p, name); 含值 let ⇒ IsFuncDeclared（Go stmt.go:1599 SetFuncDeclared）
        }

        ; 裸形：型別後為陳述邊界 ⇒ LetStatement{name, type, value:0 佔位}
        (hd == tok.NEWLINE || hd == tok.RBRACE || hd == tok.EOF || hd == tok.SEMICOLON || hd == tok.COMMENT) -> {
            idx = ast.add(t, asp.K_LET_STATEMENT)
            ast.set-slot(t, idx, 0, ast.put-str(t, name))
            ast.kid-add(t, idx, ty); guarded CHILD=Type
            ast.kid-add(t, idx, 0); guarded CHILD=Value 缺席→0 佔位（dump 印 `value: `）
            ps-reg-let(t, p, name, ty); s51 登記（Go 裸宣告：setVarType + declaredLocals，
            ;   但 early-return 跳過 SetFuncDeclared ⇒ 【不】記 IsFuncDeclared，故不呼叫 ps-mark-ifd）
        }

        ; 既非 `=` 亦非邊界：非宣告（索引/運算式）→ 還原，回 0 交運算式陳述
        (hd != tok.ASSIGN && hd != tok.NEWLINE && hd != tok.RBRACE && hd != tok.EOF && hd != tok.SEMICOLON && hd != tok.COMMENT) -> p.pos = savePos
    }
}

; ps-skip-annot-idx：鏡像 ps-parse-stmt 的 `#{...}` 群組掃描，但以【索引前視】方式（不消費
;   token）回傳跳過自索引 i 起全部相鄰 `#{...}` 群組後的索引；非 `#{` 起 ⇒ 原樣回 i。
;   深度計數：`#{ [ ( {` → +1、`} ) ]` → −1（`#{` 自身計作一個開大括號），與 ps-parse-stmt 同口徑。
ps-skip-annot-idx = (p psst, i i64) (j i64) {
    j = i
    (ps-peek-at(p, j) == tok.HASH_LBRACE) {
        depth = 1

        #{overflow=wrap}
        j = j + 1; 消費 #{
        (depth > 0) {
            t = ps-peek-at(p, j)
            {
                t == tok.EOF -> depth = 0

                t == tok.HASH_LBRACE || t == tok.LBRACE || t == tok.LBRACKET || t == tok.LPAREN -> {

                    #{overflow=wrap}
                    depth = depth + 1

                    #{overflow=wrap}
                    j = j + 1
                }

                t == tok.RBRACE || t == tok.RBRACKET || t == tok.RPAREN -> {

                    #{overflow=wrap}
                    depth = depth - 1

                    #{overflow=wrap}
                    j = j + 1
                }

                -> {

                    #{overflow=wrap}
                    j = j + 1
                }
            }
        }
    }
}

; ps-skip-annot：【消費】自目前 pos 起全部相鄰 `#{...}` 群組。用於結構體欄位尾的
;   `#{inline=…}` 等註解——`no ast`（無 -annotations）根本不渲染欄位註解 ⇒ 跳過即可。
ps-skip-annot = (p psst) {
    (ps-peek(p) == tok.HASH_LBRACE) {
        ps-bump(p); 消費 #{
        depth = 1
        (depth > 0) {
            tk = ps-peek-token(p)
            {
                tk.typ == tok.EOF -> depth = 0

                tk.typ == tok.HASH_LBRACE || tk.typ == tok.LBRACE || tk.typ == tok.LBRACKET || tk.typ == tok.LPAREN -> {

                    #{overflow=wrap}
                    depth = depth + 1
                    ps-bump(p)
                }

                tk.typ == tok.RBRACE || tk.typ == tok.RBRACKET || tk.typ == tok.RPAREN -> {

                    #{overflow=wrap}
                    depth = depth - 1
                    ps-bump(p)
                }

                -> ps-bump(p)
            }
        }
    }
}

; ps-skip-type-idx：以【索引前视】（不消費 token）復刻 ps-parse-type 的型別語法，回傳吃完整
;   條型別後的索引；非法型別起 ⇒ 回 −1（呼叫者據此拒绝）。鏡像 ps-parse-type 四形：
;   `a.b`（IDENT (.IDENT)*）、`?T`、`[]T`、`[N]T`（N=單 INT）；元素皆可遞迴 ∈ {IDENT, [, ?}。
ps-skip-type-idx = (p psst, i i64) (j i64) {
    j = -1
    t0 = ps-peek-at(p, i)

    #{overflow=wrap}
    t1 = ps-peek-at(p, i + 1)

    #{overflow=wrap}
    t2 = ps-peek-at(p, i + 2)
    {
        t0 == tok.IDENT -> {

            #{overflow=wrap}
            j = i + 1; 消費首段型別名
            go = true
            (go) {

                #{overflow=wrap}
                jp = j + 1
                ps-peek-at(p, j) == tok.DOT && ps-peek-at(p, jp) == tok.IDENT -> {

                    #{overflow=wrap}
                    j = j + 2; 消費 .段
                }

                -> go = false
            }
        }

        t0 == tok.QUESTION -> {

            #{overflow=wrap}
            qi = i + 1
            inner = ps-skip-type-idx(p, qi)
            inner >= 0 -> j = inner
        }

        t0 == tok.LBRACKET && t1 == tok.RBRACKET -> {

            #{overflow=wrap}
            ei = i + 2
            inner = ps-skip-type-idx(p, ei); []T
            inner >= 0 -> j = inner
        }

        t0 == tok.LBRACKET && t1 == tok.INT && t2 == tok.RBRACKET -> {

            #{overflow=wrap}
            ei = i + 3
            inner = ps-skip-type-idx(p, ei); [N]T
            inner >= 0 -> j = inner
        }

        -> j = -1
    }
}

; ps-is-struct-def：判斷【目前 pos=IDENT name】起是否為「乾淨」的結構體定義形
;   `name { field TYPE ... }`，TYPE ∈ {IDENT, []IDENT, [INT]IDENT}，欄位以換行或尾隨逗號分隔，
;   區塊以 } 收尾。僅作分派守衛（不消費 token）：枚舉(`a, b`)、介面(`m()`)、實作清單
;   (`name impl {`)、註解、限定型別(`a.b`)、可為空(`?T`)等一律回 0 → 交回原運算式陳述路徑（零回歸）。
ps-is-struct-def = (p psst) (r i64) {
    r = 0
    ps-peek(p) != tok.IDENT -> return
    ps-peek-at(p, 1) != tok.LBRACE -> return
    i = 2
    nfield = 0
    go = true
    (go) {
        t = ps-peek-at(p, i)
        {
            t == tok.RBRACE -> {
                go = false
                nfield > 0 -> r = 1
                nfield == 0 -> r = 0
            }

            t == tok.EOF -> {
                go = false
                r = 0
            }

            t == tok.NEWLINE -> {

                #{overflow=wrap}
                i = i + 1
            }

            t == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            t == tok.IDENT -> {

                #{overflow=wrap}
                i = i + 1; 消費欄位名
                ti = ps-skip-type-idx(p, i); IDENT/[]T/[N]T/?T/限定/嵌套（镜像 ps-parse-type）
                ti < 0 -> {
                    go = false
                    r = 0
                }
                ti >= 0 -> {
                    i = ti
                    i = ps-skip-annot-idx(p, i); 跳过栏位尾 `#{...}` 注解（dump 不渲染）
                    et = ps-peek-at(p, i)
                    {
                        et == tok.NEWLINE -> {

                            #{overflow=wrap}
                            i = i + 1

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        et == tok.COMMA -> {

                            #{overflow=wrap}
                            i = i + 1

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        et == tok.RBRACE -> {

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        et == tok.EOF -> {

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        -> {
                            go = false
                            r = 0
                        }
                    }
                }
            }

            -> {
                go = false
                r = 0
            }
        }
    }
}

; ps-iface-has-bare-variant：掃描介面區塊內容，判斷是否存在「裸變體」
;   （深度 0 的 IDENT/NIL 後**不接** `(`）—— 對應 Go parser.go:583-611
;   blockIsTaggedEnumWithParens。裸變體存在 ⇒ 該區塊是**標籤列舉**而非介面。
ps-iface-has-bare-variant = (p psst, start i64) (r i64) {
    r = 0
    depth = 0
    i = start
    n = 0
    (n < 200) {
        t = ps-peek-at(p, i)
        {
            t == tok.EOF -> return

            t == tok.LPAREN || t == tok.LBRACKET || t == tok.LBRACE -> {

                #{overflow=wrap}
                depth = depth + 1
            }

            t == tok.RPAREN || t == tok.RBRACKET -> {

                #{overflow=wrap}
                depth = depth - 1
                depth < 0 -> return
            }

            t == tok.RBRACE -> {
                depth == 0 -> return

                #{overflow=wrap}
                depth = depth - 1
            }

            t == tok.IDENT || t == tok.NIL -> {
                depth == 0 && ps-peek-at(p, i + 1) != tok.LPAREN -> {
                    r = 1
                    return
                }
            }
        }

        #{overflow=wrap}
        i = i + 1

        #{overflow=wrap}
        n = n + 1
    }
}

; ps-iface-all-parens-tagged：判斷「全部成員皆 name(...) 形」的區塊是**標籤列舉**還是介面
;   —— 對應 Go parser.go:699-742 blockIsTaggedEnumAllParens（回 1 = 標籤列舉）。
;   消歧規則（與 Go 逐項一致）：
;     · 某成員的 `)` 後緊跟 `(`（結果組，如 `t.gt(b t) (res bool)`）⇒ **介面**（回 0）；
;     · 否則若至少一個成員的參數列表非空（如 `circle(r f64)`）⇒ 標籤列舉（回 1）；
;     · 否則（全部空參數 `name()`）⇒ 介面（回 0）。
ps-iface-all-parens-tagged = (p psst, start i64) (r i64) {
    r = 0
    hasBig = 0
    i = start
    n = 0
    (n < 200) {
        t = ps-peek-at(p, i)
        {
            t == tok.EOF -> {
                r = hasBig
                return
            }
            t == tok.RBRACE -> {
                r = hasBig
                return
            }
        }
        t == tok.LPAREN -> {
            prev = 0
            ; ⚠️ 下限是 0（相對目前 token），**不是** start：括號的前一個 token
            ;   可能就是區塊內容首 token（方法名本身），oracle 的 look 索引下限是 -1。
            i - 1 >= 0 -> {
                pt = ps-peek-at(p, i - 1)
                pt == tok.IDENT -> prev = 1
            }
            prev == 1 -> {
                ps-peek-at(p, i + 1) != tok.RPAREN -> hasBig = 1
                ; 找匹配的 `)`；其後若緊跟 `(` ⇒ 介面（結果組）⇒ 回 0。
                d = 0
                k = i
                m = 0
                (m < 200) {
                    lk = ps-peek-at(p, k)
                    {
                        lk == tok.LPAREN -> {

                            #{overflow=wrap}
                            d = d + 1
                        }

                        lk == tok.RPAREN -> {

                            #{overflow=wrap}
                            d = d - 1
                            d == 0 -> {
                                ps-peek-at(p, k + 1) == tok.LPAREN -> return
                                i = k
                                m = 200
                            }
                        }

                        lk == tok.EOF -> {
                            r = hasBig
                            return
                        }
                    }

                    #{overflow=wrap}
                    k = k + 1

                    #{overflow=wrap}
                    m = m + 1
                }
            }
        }

        #{overflow=wrap}
        i = i + 1

        #{overflow=wrap}
        n = n + 1
    }
    r = hasBig
}

; ps-is-iface-def：判斷【目前 pos=IDENT name】起是否為「介面定義」形
;   `name { m(...) }` 或 `name { t.m(...) (res bool) }`。
;   對應 Go stmt.go:288-297 classifyBlock()==blockIface（tok2 ∈ {LPAREN, DOT}）。
;   ⚠️ 與標籤列舉的消歧（Go parser.go:396-401 / :699-742）：
;     · 區塊內有裸變體 ⇒ 標籤列舉，非介面；
;     · 全部成員皆括號形但至少一個參數非空 ⇒ 標籤列舉，非介面；
;     · 某成員帶結果組（`)` 後緊跟 `(`）⇒ 介面；
;     · 全部空參數 ⇒ 介面。
;   ⚠️ 守衛不消費 token；`name {` 之後若還有 IDENT（implements 繼承清單）⇒ 回 0
;   （oracle 對 `a, b {` 走的是另一條路徑並報解析錯誤）。
ps-is-iface-def = (p psst) (r i64) {
    r = 0
    ps-peek(p) != tok.IDENT -> return
    ps-peek-at(p, 1) != tok.LBRACE -> return
    i = 2
    ; 跳過 NEWLINE / COMMENT，取區塊內容首 token（對應 Go classifyBlock 的 skip）
    go = true
    (go) {
        t = ps-peek-at(p, i)
        {
            t == tok.NEWLINE -> {

                #{overflow=wrap}
                i = i + 1
            }

            t == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            -> go = false
        }
    }
    ps-peek-at(p, i) != tok.IDENT -> return
    i = i + 1
    t2 = ps-peek-at(p, i)
    t2 == tok.DOT -> {
        ; generic-receiver 形：t.m(...) ⇒ Go parser.go:404-407 直接判 blockIface
        i = i + 1
        ps-peek-at(p, i) != tok.IDENT -> return
        i = i + 1
        ps-peek-at(p, i) != tok.LPAREN -> return
        r = 1
        return
    }
    t2 != tok.LPAREN -> return
    ; 括號形：先排除標籤列舉（裸變體 / 非空參數）
    ps-iface-has-bare-variant(p, i) == 1 -> return
    ps-iface-all-parens-tagged(p, i) == 1 -> return
    r = 1
}

; ps-is-iface-inherits（s8y 規則C）：介面【繼承清單形】分派守衛（鏡 Go stmt.go:65-113，
;   不消費 token）：pos=IDENT name 且 +1=IDENT（首個繼承介面名）。Go 的 look(k)=current 之後
;   第 k+2 個【非註解】token ⇒ 以索引前視 + COMMENT 跳讀模擬（NEWLINE 【不】跳，鏡 Go 寬容）。
;   掃描 DOT/COMMA 交錯的介面名列表；終點須恰為 LBRACE，再分類區塊內容首 token：
;   IDENT 且其後（跳註解）為 LPAREN 或 DOT ⇒ 介面（Go:107 回 parseInterfaceDefinition）。
;   ⚠️ 內容為欄位形時 Go 回 parseStructDefinition（struct-with-implements），但全語料無此形
;   （s79 掃圖仅 sql.no 為介面形）⇒ 本守衛【不】放行欄位形，維持舊路徑零回歸。
ps-is-iface-inherits = (p psst) (r i64) {
    r = 0
    ps-peek-at(p, 1) != tok.IDENT -> return
    i = 2
    goS = true
    (goS) {
        t = ps-peek-at(p, i)
        {
            t == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            t == tok.DOT -> {

                #{overflow=wrap}
                i = i + 1
                u = ps-peek-at(p, i)
                u == tok.IDENT -> {

                    #{overflow=wrap}
                    i = i + 1
                }
                u != tok.IDENT -> goS = false
            }

            t == tok.COMMA -> {

                #{overflow=wrap}
                i = i + 1
                u = ps-peek-at(p, i)
                u == tok.IDENT -> {

                    #{overflow=wrap}
                    i = i + 1
                }
                u != tok.IDENT -> goS = false
            }

            -> goS = false
        }
    }
    ps-peek-at(p, i) != tok.LBRACE -> return
    ; 區塊內容首 token：跳 NEWLINE／COMMENT（Go:96-102 跳 NEWLINE，look() 天然跳 COMMENT）
    goC = true
    (goC) {
        t = ps-peek-at(p, i + 1)
        {
            t == tok.NEWLINE || t == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            -> goC = false
        }
    }
    t1 = ps-peek-at(p, i + 1)
    t2i = i + 2
    ps-peek-at(p, t2i) == tok.COMMENT -> t2i = t2i + 1
    t2 = ps-peek-at(p, t2i)
    t1 == tok.IDENT && (t2 == tok.LPAREN || t2 == tok.DOT) -> r = 1
}

; ps-parse-iface-def：把陳述位置的 `name { m(...) }` 建為 InterfaceDefinition。
;   InterfaceDefinition：slot0=name、slot1=methods 數（OF-LEN）；無 kids
;     （Go 的 InterfaceDefinition 只有 Name/Methods/Implements 三個欄位）。
;   helper 區（aux，寬度 5 * methods）：name / receiver / variadic / genericReceiver /
;     該方法的節點數；節點索引段緊接其後（起點 = hbase + 5 * methods）。
;   InterfaceMethod 的參數與回傳都是 *parser.Parameter（普通 Node），走 arena。
;   對應 Go decl.go:867-1075 parseInterfaceDefinition。
ps-parse-iface-def = (t ast, p psst, name str) (idx i64) {
    ps-bump(p); 消費 name IDENT
    ; s8y 規則C：繼承清單（鏡 Go decl.go:874-885）：while current 為 IDENT 收集介面名、
    ;   跳逗號；Go 於非 IDENT 止、再【無條件】nextToken 跳 LBRACE。COMMENT 容忍跳讀。
    imps []str = with-cap(4)
    ig = true
    (ig) {
        tt = ps-peek(p)
        {
            tt == tok.COMMENT -> ps-bump(p)

            tt == tok.IDENT -> {
                it = ps-peek-token(p)
                imps.push(it.lit)
                ps-bump(p)
                ps-peek(p) == tok.COMMA -> ps-bump(p)
            }

            -> ig = false
        }
    }
    ps-bump(p); 消費 LBRACE
    mn []str = with-cap(4)
    mr []str = with-cap(4)
    mv []str = with-cap(4)
    mg []str = with-cap(4)
    mc []i64 = with-cap(4)
    mp []i64 = with-cap(8)
    nm = 0
    go = true
    (go) {
        ; 跳過 NEWLINE / COMMA
        sk = true
        (sk) {
            tt = ps-peek(p)
            {
                tt == tok.NEWLINE -> ps-bump(p)
                tt == tok.COMMA -> ps-bump(p)
                -> sk = false
            }
        }
        ps-peek(p) == tok.RBRACE -> go = false
        ps-peek(p) == tok.EOF -> go = false
        go -> {
            mt = ps-peek-token(p)
            mt.typ != tok.IDENT -> go = false
            go -> {
                mname = mt.lit
                ps-bump(p); 消費方法名
                mrecv = ''
                mgen = ''
                mvar = ''
                mcnt = 0
                ps-peek(p) == tok.DOT -> {
                    ; generic receiver：t.m(...) ⇒ Receiver=t、IsGenericReceiver=true
                    mrecv = mname
                    mgen = 'true'
                    ps-bump(p); 消費 DOT
                    mt2 = ps-peek-token(p)
                    mt2.typ != tok.IDENT -> go = false
                    go -> {
                        mname = mt2.lit
                        ps-bump(p); 消費方法名
                    }
                }
                ps-peek(p) != tok.LPAREN -> go = false
                go -> {
                    ps-bump(p); 消費 (
                    ; 參數：interface 的參數**不解析默認值**（Go decl.go:920-1030）⇒ resParam=1
                    p.resParam = 1
                    prm = 1
                    (prm) {
                        ps-peek(p) == tok.RPAREN -> prm = 0
                        ps-peek(p) == tok.EOF -> prm = 0
                        prm -> {
                            tt = ps-peek(p)
                            {
                                tt == tok.NEWLINE -> ps-bump(p)
                                tt == tok.COMMA -> ps-bump(p)
                                -> {
                                    vf0 = p.varFlag
                                    p.varFlag = 0
                                    pj = ps-parse-param(t, p)
                                    mvar = ''
                                    p.varFlag == 1 -> mvar = 'true'
                                    p.varFlag = vf0
                                    pj > 0 -> {
                                        mp.push(pj)

                                        #{overflow=wrap}
                                        mcnt = mcnt + 1
                                    }
                                    ps-peek(p) == tok.RPAREN -> prm = 0
                                }
                            }
                        }
                    }
                    ps-peek(p) == tok.RPAREN -> ps-bump(p); 消費 )
                    ; 結果組 `(res bool)`：Go decl.go:1032-1063
                    ps-peek(p) == tok.LPAREN && ps-peek-at(p, 1) == tok.IDENT -> {
                        ps-bump(p); 消費 (
                        rr = 1
                        (rr) {
                            ps-peek(p) == tok.RPAREN -> rr = 0
                            ps-peek(p) == tok.EOF -> rr = 0
                            rr -> {
                                pj = ps-parse-param(t, p)
                                pj > 0 -> {
                                    mp.push(pj)

                                    #{overflow=wrap}
                                    mcnt = mcnt + 1
                                }
                                ps-peek(p) == tok.COMMA -> ps-bump(p)
                                ps-peek(p) == tok.RPAREN -> rr = 0
                            }
                        }
                        ps-peek(p) == tok.RPAREN -> ps-bump(p); 消費 )
                    }
                    p.resParam = 0
                    mn.push(mname)
                    mr.push(mrecv)
                    mv.push(mvar)
                    mg.push(mgen)
                    mc.push(mcnt)
                    nm = nm + 1
                }
            }
        }
    }
    ps-peek(p) == tok.RBRACE -> ps-bump(p); 消費 }
    ; ★ 節點建立順序（先建子、後建父）：InterfaceDefinition 節點必須在所有
    ;   參數／回傳 Parameter 節點建完之後才 ast.add，否則它的 kid0 會落在
    ;   參數節點之前（見 ast.no 的「節點建立順序」說明）。本節點**不 push kids**
    ;   （Go 的 InterfaceDefinition 無 Parameters/Results 欄位），參數節點由
    ;   helper 以「節點索引」引用 ⇒ 不佔 kid 區。
    idx = ast.add(t, asp.K_INTERFACE_DEFINITION)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    ast.set-slot(t, idx, 1, ast.put-str(t, nm.to-str()))
    ; s8y 規則C：Implements 清單（鏡 Go decl.go:878 id.Implements；dump.go:396-397 於標頭後、
    ;   註解前印 `Implements: [a b]`，tape kind40 已含 OP-IMPLEMENTS）。aux 區段規約
    ;   ［trail→clos→impl］（ast.aux-begin 註解）⇒ 本處無 trail/clos，ct0 起頭即 impl，
    ;   ntrail/nclos 傳 -1（無群組）。⚠️ aux-begin 必須先於 helper-begin（hbase 取當時
    ;   aux 尾，順序顛倒則 impl 段與 helper 段錯位）。nimp 預設 0 ⇒ 無繼承清單時零外溢。
    imps.len() > 0 -> {
        ia = ast.aux-begin(t, idx)
        ia >= 0 -> {
            ii = 0
            (ii < imps.len()) {
                ast.aux-add(t, ast.put-str(t, imps[ii]))

                #{overflow=wrap}
                ii = ii + 1
            }
        }
        ast.set-aux-counts(t, idx, -1, -1, imps.len())
    }
    ast.helper-begin(t, idx, nm)
    j = 0
    (j < nm) {

        #{overflow=wrap}
        ast.aux-add(t, ast.put-str(t, mn[j]))

        #{overflow=wrap}
        ast.aux-add(t, ast.put-str(t, mr[j]))

        #{overflow=wrap}
        ast.aux-add(t, ast.put-str(t, mv[j]))

        #{overflow=wrap}
        ast.aux-add(t, ast.put-str(t, mg[j]))

        #{overflow=wrap}
        ast.aux-add(t, mc[j])

        #{overflow=wrap}
        j = j + 1
    }
    k = 0
    (k < mp.len()) {

        #{overflow=wrap}
        ast.aux-add(t, mp[k])

        #{overflow=wrap}
        k = k + 1
    }
    idx
}

; ps-parse-struct-def：把陳述位置的 `name { field TYPE ... }` 建為 StructDefinition。
;   StructDefinition：slot0=name、slot1=implements 數('0' 省略)、slot2=fields 數(OF-LEN)、
;     count0=KIDS 迭代數、kid 序=各 StructField。
;   StructField：slot0=name、slot1=arraySize(kvn '0'省略)、slot2=slice(kvb 'true')、slot3=readonly、slot4=sealed；
;     kid0=Type(子先於父)、kid1=Value(定義恒 0)。`type:` 文字由 dumper 自 kid0 合成(OF-TYPE)，不佔槽。
ps-parse-struct-def = (t ast, p psst, name str) (idx i64) {
    ps-bump(p); 消費 name IDENT
    ps-bump(p); 消費 LBRACE
    flds []i64 = with-cap(4)
    (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
        pos0 = p.pos
        ps-skip-trivia(p)
        fname = ps-lit-at(p, 0)
        ps-peek(p) == tok.IDENT -> ps-bump(p); 消費欄位名
        ps-skip-trivia(p)
        ty = 0
        arrSize = '0'
        sliceFlag = ''
        tt = ps-peek(p)
        {
            tt == tok.LBRACKET && ps-peek-at(p, 1) == tok.RBRACKET -> {
                ty = ps-parse-type(t, p); []T → SliceType
                sliceFlag = 'true'
            }

            tt == tok.LBRACKET && ps-peek-at(p, 1) == tok.INT -> {
                arrSize = ps-lit-at(p, 1); 尺寸字面量文字
                ty = ps-parse-type(t, p); [N]T → ArrayType
            }

            -> {
                ty = ps-parse-type(t, p); IDENT → NamedType
            }
        }
        ps-skip-annot(p); 欄位尾 `#{inline=…}` 註解（dump 不渲染 ⇒ 跳過）
        sf = ast.add(t, asp.K_STRUCT_FIELD)
        ast.set-slot(t, sf, 0, ast.put-str(t, fname))
        ast.set-slot(t, sf, 1, ast.put-str(t, arrSize))
        ast.set-slot(t, sf, 2, ast.put-str(t, sliceFlag))
        ast.set-slot(t, sf, 3, ast.put-str(t, ''))
        ast.set-slot(t, sf, 4, ast.put-str(t, ''))
        ast.kid-add(t, sf, ty)
        ast.kid-add(t, sf, 0)
        sf > 0 -> flds.push(sf)
        ; s8v-dom：登記欄位型別進 structFields（供 self.field.method 回傳型推斷查表）。
        ;   泛型接收者欄位（如 `[]t`）的 type-string 原樣存（`[]t`），鏈式查表以字面鍵匹配。
        ty > 0 -> ps-reg-struct-field(p, name, fname, ast.type-string(t, ty))
        ps-skip-trivia(p)
        ps-peek(p) == tok.COMMA -> {
            ps-bump(p)
            ps-skip-trivia(p)
        }
        p.pos == pos0 -> ps-bump(p)
    }
    ps-expect(p, tok.RBRACE)
    idx = ast.add(t, asp.K_STRUCT_DEFINITION)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    ast.set-slot(t, idx, 1, ast.put-str(t, '0')); implements 數 → 0（省略）
    ast.set-slot(t, idx, 2, ast.put-str(t, flds.len().to-str())); fields 數（OF-LEN）
    ast.set-count(t, idx, 0, flds.len()); KIDS 迭代數
    m = 0
    (m < flds.len()) {
        ast.kid-add(t, idx, flds[m])

        #{overflow=wrap}
        m = m + 1
    }
    idx
}

; ps-is-enum-def：枚舉定義分派守衛（不消費 token，索引前視）。pos=IDENT name 且 +1=LBRACE 時掃描區塊：
;   成員 ∈ {IDENT/NIL 變體名、`名(欄位…)` 括號載荷、`名 = INT` 顯式值、`#{…}` 註解、NEWLINE/COMMA 分隔符}。
;   回 2（標籤）：同時出現括號變體與裸變體（語料全形：`ok(v str), fail,`；介面形含「`) (`回傳群組」或
;   首成員 `t.` ⇒ 被拒）；回 1（裸）：僅裸變體/顯式賦值、無任何括號成員；其餘回 0（含純括號無裸變體者—
;   —保守排除全括號標籤枚舉與介面，只改善不回歸）。⚠️ 掃描中任何非預期 token ⇒ bad=1 回 0。
ps-is-enum-def = (p psst) (r i64) {
    r = 0
    ps-peek(p) != tok.IDENT -> return
    ps-peek-at(p, 1) != tok.LBRACE -> return
    i = 2
    sawParen = 0
    sawUnit = 0
    nmem = 0
    bad = 0
    go = true
    (go && bad == 0) {
        t = ps-peek-at(p, i)
        {
            t == tok.NEWLINE || t == tok.COMMA || t == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            t == tok.RBRACE -> go = false

            t == tok.EOF -> {
                go = false
                bad = 1
            }

            t == tok.HASH_LBRACE -> i = ps-skip-annot-idx(p, i)

            t == tok.IDENT || t == tok.NIL -> {

                #{overflow=wrap}
                i = i + 1

                #{overflow=wrap}
                nmem = nmem + 1
                et = ps-peek-at(p, i)
                {
                    et == tok.LPAREN -> {

                        ; 括號載荷欄位掃描：( [NEWLINE|COMMA]* ( IDENT [型別] )*[,] )；非預期 token ⇒ okf=0
                        fi = i
                        okf = 1
                        gof = true
                        (gof && okf == 1) {
                            ft = ps-peek-at(p, fi)
                            {
                                ft == tok.LPAREN || ft == tok.NEWLINE || ft == tok.COMMA || ft == tok.COMMENT -> {

                                    #{overflow=wrap}
                                    fi = fi + 1
                                }

                                ft == tok.RPAREN -> {
                                    gof = false

                                    #{overflow=wrap}
                                    fi = fi + 1
                                }

                                ft == tok.IDENT -> {

                                    ; `名 型別`（nt=型別起）或裸 `名`（nt∈{,, ),NEWLINE,COMMENT}）

                                    #{overflow=wrap}
                                    nt = ps-peek-at(p, fi + 1)
                                    nt == tok.COMMA || nt == tok.RPAREN || nt == tok.NEWLINE || nt == tok.COMMENT -> {

                                        #{overflow=wrap}
                                        fi = fi + 1
                                    }

                                    -> {

                                        #{overflow=wrap}
                                        fi = fi + 1
                                        ts = ps-skip-type-idx(p, fi)
                                        ts >= 0 -> fi = ts
                                        ts < 0 -> okf = 0
                                    }
                                }

                                ft == tok.EOF -> {
                                    gof = false
                                    okf = 0
                                }

                                -> okf = 0
                            }
                        }
                        okf == 0 -> bad = 1
                        okf == 1 -> {
                            i = fi
                            sawParen = 1
                            ps-peek-at(p, i) == tok.LPAREN -> bad = 1; `) (` 第二回傳群組 ⇒ 介面方法形，拒
                        }
                    }

                    et == tok.COMMA || et == tok.NEWLINE || et == tok.RBRACE || et == tok.EOF || et == tok.COMMENT -> {
                        sawUnit = 1
                        ; 不前進：分隔符交由迴圈頂Consumption
                    }

                    et == tok.HASH_LBRACE -> {
                        sawUnit = 1
                        i = ps-skip-annot-idx(p, i)
                    }

                    et == tok.ASSIGN -> {

                        #{overflow=wrap}
                        vt = ps-peek-at(p, i + 1)
                        vt == tok.INT -> {
                            sawUnit = 1

                            #{overflow=wrap}
                            i = i + 2
                        }
                        vt != tok.INT -> bad = 1
                    }

                    -> {
                        bad = 1
                    }
                }
            }

            -> {
                bad = 1
            }
        }
    }
    bad == 1 -> return
    nmem == 0 -> return
    sawParen == 1 && sawUnit == 1 -> r = 2
    sawParen == 0 && sawUnit == 1 -> r = 1
}

; ps-parse-enum-def：於陳述位解析守衛已認可的枚舉定義（kind=1 裸 EnumDefinition / kind=2 標籤 TaggedEnumDefinition）。
;   EnumValue：s0=名、s1=value 十進制文字（恒印）、s2=explicit('true'/''，P-TRUE 隱空)；無子節點。
;   TaggedEnumVariant：s0=名、s1=index 文字（P-NON-ZERO：'0' 隱、'1' 印）、s2=fields 數（P-COUNT）；
;     kid0=Type（恒加：單元變體 0 佔位 ⇒ OF-TYPE 讀空 ⇒ 隱）；HELPER taggedEnumField 成對：
;     aux[hbase+2j]=欄位名 id、aux[hbase+2j+1]=欄位型節點（0=無型）。變體 index 恒遞增；
;     EnumValue 的 nextVal 仅在非顯式賦值時遞增（鏡像 Go decl.go:807–821）。
;   父：EnumDefinition{s0=名、s1=values 數}；TaggedEnumDefinition{s0=名、s1=builtin ''（隱）、s2=variants 數}；
;     均 set-count(c0)=成員數並逐一 kid-add（父後建）。
ps-parse-enum-def = (t ast, p psst, name str, kind i64) (idx i64) {
    ps-bump(p); 消費 name IDENT
    ps-bump(p); 消費 LBRACE
    mems []i64 = with-cap(4)
    ctr = 0
    (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
        pos0 = p.pos
        ps-skip-trivia(p)
        ps-peek(p) == tok.HASH_LBRACE -> {
            ps-skip-annot(p); 變體上方獨立成行註解（dump 不渲染 ⇒ 跳過）
            ps-skip-trivia(p)
        }
        mt = ps-peek-token(p)
        mt.typ == tok.IDENT || mt.typ == tok.NIL -> {
            vname = mt.lit
            ps-bump(p); 消費變體名
            fns []str = with-cap(2)
            fty []i64 = with-cap(2)
            valstr = ctr.to-str()
            expstr = ''
            expf = 0
            hd = ps-peek(p)
            hd == tok.LPAREN && kind == 2 -> {
                ps-bump(p); 消費 (
                (ps-peek(p) != tok.RPAREN && ps-peek(p) != tok.EOF) {
                    pf0 = p.pos
                    ps-skip-trivia(p)
                    ps-peek(p) == tok.COMMA -> ps-bump(p); 欄位間逗號
                    ps-skip-trivia(p)
                    ft = ps-peek-token(p)
                    ft.typ == tok.IDENT -> {
                        fname = ft.lit
                        ps-bump(p); 消費欄位名（或裸型別名）
                        tyi = 0
                        nt = ps-peek(p)
                        nt == tok.IDENT || nt == tok.QUESTION || nt == tok.LBRACKET -> tyi = ps-parse-type(t, p)
                        fns.push(fname)
                        fty.push(tyi)
                    }
                    p.pos == pf0 -> ps-bump(p)
                }
                ps-peek(p) == tok.RPAREN -> ps-bump(p); 消費 )
            }
            hd == tok.ASSIGN && kind == 1 -> {
                ps-bump(p); 消費 =
                vt = ps-peek-token(p)
                vt.typ == tok.INT -> {
                    valstr = ps-int-lit-value(vt.lit)
                    expstr = 'true'
                    expf = 1
                    ps-bump(p); 消費 INT
                }
            }
            v = 0
            kind == 1 -> {
                v = ast.add(t, asp.K_ENUM_VALUE)
                ast.set-slot(t, v, 0, ast.put-str(t, vname))
                ast.set-slot(t, v, 1, ast.put-str(t, valstr))
                ast.set-slot(t, v, 2, ast.put-str(t, expstr))
                expf == 0 -> {

                    #{overflow=wrap}
                    ctr = ctr + 1
                }
            }
            kind == 2 -> {
                v = ast.add(t, asp.K_TAGGED_ENUM_VARIANT)
                ast.set-slot(t, v, 0, ast.put-str(t, vname))
                ast.set-slot(t, v, 1, ast.put-str(t, ctr.to-str()))
                ast.set-slot(t, v, 2, ast.put-str(t, fns.len().to-str()))
                ty0 = 0
                fns.len() > 0 -> {

                    #{index-out=zero}
                    ty0 = fty[0]
                }
                ast.kid-add(t, v, ty0)
                ast.helper-begin(t, v, fns.len())
                j = 0
                (j < fns.len()) {

                    #{index-out=zero}
                    ast.aux-add(t, ast.put-str(t, fns[j]))

                    #{index-out=zero}
                    ast.aux-add(t, fty[j])

                    #{overflow=wrap}
                    j = j + 1
                }

                #{overflow=wrap}
                ctr = ctr + 1
            }
            v > 0 -> mems.push(v)

            ; s60：登記枚舉變體（Go decl.go:1196-1224，kind==2）：payload 單欄位=欄型別、
            ;   多欄位='enum.variant' 合成結構名、單元=''；欄位型別逐欄存 ef* 行。
            ;   裸枚舉 kind==1 亦登記（Go decl.go:858：EnumVariants[ed.Name]，payload 恒 ''、ncols 0）——
            ;   供 `p plain = plain.a; p: { a -> }` 的變體臂綁定型別（oracle 实测 it typed 'a'）。
            kind == 1 -> {
                p.enN.push(name)
                p.evN.push(vname)
                p.evP.push('')
                p.evC.push(0)
            }
            kind == 2 -> {
                p.enN.push(name)
                p.evN.push(vname)
                pay = ''
                fns.len() == 1 -> {

                    #{index-out=zero}
                    pay = ast.type-string(t, fty[0])
                }
                fns.len() > 1 -> pay = name + '.' + vname
                p.evP.push(pay)
                p.evC.push(fns.len())
                g = 0
                (g < fty.len()) {
                    fts = ''

                    #{index-out=zero}
                    fty[g] > 0 -> fts = ast.type-string(t, fty[g])
                    p.efE.push(name)
                    p.efV.push(vname)
                    p.efT.push(fts)

                    #{overflow=wrap}
                    g = g + 1
                }
            }
        }
        ps-skip-trivia(p)
        ps-peek(p) == tok.COMMA -> {
            ps-bump(p)
            ps-skip-trivia(p)
        }
        p.pos == pos0 -> ps-bump(p)
    }
    ps-expect(p, tok.RBRACE)
    kind == 1 -> {
        idx = ast.add(t, asp.K_ENUM_DEFINITION)
        ast.set-slot(t, idx, 0, ast.put-str(t, name))
        ast.set-slot(t, idx, 1, ast.put-str(t, mems.len().to-str()))
    }
    kind == 2 -> {
        idx = ast.add(t, asp.K_TAGGED_ENUM_DEFINITION)
        ast.set-slot(t, idx, 0, ast.put-str(t, name))
        ast.set-slot(t, idx, 1, ast.put-str(t, '')); builtin 旗標（非內建 ⇒ 空、隱）
        ast.set-slot(t, idx, 2, ast.put-str(t, mems.len().to-str()))
    }
    ast.set-count(t, idx, 0, mems.len())
    m2 = 0
    (m2 < mems.len()) {

        #{index-out=zero}
        ast.kid-add(t, idx, mems[m2])

        #{overflow=wrap}
        m2 = m2 + 1
    }
    idx
}

; ps-parse-param：解析一個參數 `name [type]`（型別可為 NamedType / NullableType / SliceType）
ps-parse-param = (t ast, p psst) (idx i64) {
    idx = 0
    p.lastTp = -1
    tk = ps-peek-token(p)

    ; s58：參數名位允許 IN token（Go parseFunctionBody：`!= IDENT && != IN`，如 `in []byte` 參數名）
    tk.typ != tok.IDENT && tk.typ != tok.IN -> return
    pname = tk.lit
    ps-bump(p); 消費參數名
    typ = 0
    nxt = ps-peek-token(p)

    ; 變參：`name ..T` ⇒ 型別 []T（Go decl.go:947-965，`n ..t` 後綴 ELLIPSIS + 元素型別）。
    ;   元素型別名直接建 NamedType、外裹 SliceType；並置 p.varFlag=1 供呼叫端寫入
    ;   FunctionDefinition 的 varflag 槽（dump 的 Variadic{}）。最後消費元素型別名 T。
    nxt.typ == tok.ELLIPSIS -> {
        ps-bump(p); 消費 ..
        et = ps-peek-token(p)
        inner = ast.add(t, asp.K_NAMED_TYPE)
        ast.set-slot(t, inner, 0, ast.put-str(t, et.lit))
        typ = ast.add(t, asp.K_SLICE_TYPE)
        ast.kid-add(t, typ, inner)
        p.varFlag = 1
        p.lastTp = -1; 變參非推斷簽名來源
        ps-bump(p); 消費元素型別名 T
    }

    ; s58：型別起點 token 集擴展 MUL(*T)/STAR_STAR(**T)/AND(&T)——鏡像 Go
    ;   parseParamTypeAfterName 的前綴循環（type.go:1023-1040）
    nxt.typ == tok.IDENT || nxt.typ == tok.QUESTION || nxt.typ == tok.LBRACKET || nxt.typ == tok.MUL || nxt.typ == tok.STAR_STAR || nxt.typ == tok.AND -> {
        p.lastTp = p.pos; s51：记下型別起始 token，供回传值签名克隆重解析
        typ = ps-parse-type(t, p)
    }
    ; ⚠️ **節點建立順序**（先建子、後建父）：ast.add 把節點的 kid0 記為「當下的 kids.len()」，
    ;   而 ast.kid-add 是 **append 到 kids 陣列尾部** ⇒ 某節點的子節點必須在
    ;   「該節點 ast.add 之後、中間沒有別的節點 push 子節點」的前提下才落在它自己的槽位。
    ;   ⚠️ 預設值表達式會 **push 自己的子節點**（如 InfixExpression 的兩個 IntegerLiteral）
    ;   ⇒ Parameter 節點必須在**預設值解析完成之後**才 ast.add，否則 Parameter.kid0
    ;   落在預設值子節點之前、它的兩個子節點被擠到後面 ⇒ 位置式 dumper 讀錯槽位
    ;   （實測 `a i64 = 1 + 2`：oracle 印 NamedType + InfixExpression，
    ;     SUT 印兩個 IntegerLiteral、且 type: 變成 *parser.IntegerLiteral）。
    ;   與 ps-parse-type（MapType/SliceType）同一套路：子樹先建、父節點最後 ast.add。
    ; ⚠️ Parameter spec 有兩個 guarded CHILD（Type、DefaultExpr），dumper 是**位置式**讀 kid0/kid0+1；
    ;   少 push 一槽 ⇒ kid0+1 读到下一個全域 kid（如 body 的 Identifier）⇒ 多出一個幽影子節點。
    ;   Type 缺席時也 push 0 佔位。
    ; ── 參數默認值 `name T = expr`（Go decl.go:362-366 / :1631-1635）：
    ;   oracle 在**型別解析之後**檢查 currentToken == ASSIGN，命中則 nextToken()
    ;   並 parseExpression(LOWEST) 存成 param.DefaultExpr；dump.go:634-636 再把它
    ;   印成 Parameter 的第二個子節點（StringLiteral{value: } 等）。
    ;   ⚠️ 檢查位置不可提前：型別本身可含 `=`（如泛型預設？），且 `name T` 與 `name T = v`
    ;   在 token 流上前綴相同 ⇒ 只有在型別吃完後才判斷 `=` 是不是默認值。
    ;   ⚠️ 只有**輸入參數**（Parameters）路徑解析默認值；**回傳值**（Results）路徑
    ;   （Go decl.go:1693-1698）不解析 ⇒ 用 p.resParam 區分，否則 `(out str = '')`
    ;   這種回傳值會被 SUT 誤挂 DefaultExpr（oracle 不挂）⇒ 差一行。
    ;   與 dump 的 guarded CHILD 對齊：無默認值 ⇒ push 0 佔位（缺席）。
    dflt = 0
    p.resParam == 0 -> {
        ps-peek(p) == tok.ASSIGN -> {
            ps-bump(p); 消費 =
            dflt = ps-parse-expr(t, p)
        }
    }

    ; ⚠️ Parameter 節點必須在**預設值解析之後**才 ast.add（見上方「節點建立順序」）。
    idx = ast.add(t, asp.K_PARAMETER)
    ast.set-slot(t, idx, 0, ast.put-str(t, pname))
    ast.kid-add(t, idx, typ)
    ast.kid-add(t, idx, dflt)
    idx
}

; ps-parse-block：解析 `{ stmts }`（同 parse：子節點全建完才 add 父節點）
ps-parse-block = (t ast, p psst) (idx i64) {
    stmts []i64 = with-cap(4)
    trail []i64 = with-cap(4)
    prev = 0
    docId = 0
    ; s8c：開括號行號（進入時 `{` 已被消費，故取前一 token）。Go stmt.go:2187：
    ;   與 `{` 同行的註解收進 fmtTrivia.SetOpeningBraceComment（**只供 formatter**），
    ;   不進 AST ⇒ dump 看不到，也不會成為首條陳述的 Doc
    ;   （實測 `cond -> {; cmt` ⇒ oracle 無 Doc；magic.no / url.no 各差 1 行）。
    braceLn = -1
    p.pos > 0 -> braceLn = p.toks[p.pos - 1].ln

    ; 區塊層級標記：換行後 `-> else` 續接只在區塊迴圈生效（Go parseBlockStatement）；
    ;   臂解析狀態在此【清零】——臂 body 若為 { } 區塊，區塊开头的續接在 Go 同樣生效。
    oldBlk = p.inBlk
    oldMat = p.inMatch
    p.inBlk = 1
    p.inMatch = 0
    ps-trail-region(p) == 1 -> ps-collect-tail(t, p, 0, trail)
    ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, 0)
    ; s8c：與 `{` 同行的註解 ⇒ 丟棄（Go 收進 fmtTrivia，不進 AST）
    docId != 0 && p.docLn == braceLn -> docId = 0
    (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
        pos0 = p.pos
        s = ps-parse-stmt(t, p)
        s > 0 -> {
            ; s8a：同 parse 迴圈——降糖改寫過的陳述不掛行前 Doc（對齊 oracle）
            docId != 0 && p.rwDoc == 0 -> ast.set-doc(t, s, docId)
            ; s8d：同 parse 迴圈（註解／目標之間的註釋後掛、覆寫行前 Doc）
            p.aoDoc != 0 -> {
                ; ⚠️ 降糖改寫過的陳述一樣不掛（s8a 同口徑，見 ps-apply-index-out）
                p.rwDoc == 0 -> ast.set-doc(t, s, p.aoDoc)
                p.aoDoc = 0
            }
            p.rwDoc = 0; ⚠️ 用後即清（同上）
            stmts.push(s)
            prev = s
        }
        p.pos == pos0 -> ps-bump(p)
        ps-trail-region(p) == 1 -> ps-collect-tail(t, p, prev, trail)
        ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, prev)
    }
    p.inBlk = oldBlk
    p.inMatch = oldMat
    idx = ast.add(t, asp.K_BLOCK_STATEMENT)
    j = 0
    (j < stmts.len()) {
        ast.kid-add(t, idx, stmts[j])

        #{overflow=wrap}
        j = j + 1
    }
    ast.set-count(t, idx, 0, stmts.len())
    ps-attach-trailing(t, idx, trail)
    idx
}

; ps-parse-if：解析 `if cond { ... } [else { ... }]`
;   ⚠️ Oracle 在 expr.go::parseIfExpression 每遇到一個 if 關鍵字就 saveWarning 一次；
;     需同步 p.warn 的計數，Program 的 dump 才能出現 `warnings: N`。
;   ⚠️ ELIF 舆 `if/else` 共享同一入口（Go 将 elif desugar 为 else { if ... }），
;     本增量先不支援 ELIF（待下一個 t14）。
;   ⚠️ spec CHILD 數 = 3 (Condition/Consequence/Alternative)——缺 Alternative
;     時也要 push 0 占位（否則 dumper 的 cur 指標會跟 kid 陣列位置錯位）。
ps-parse-if = (t ast, p psst) (idx i64) {

    ; 消費 if 關鍵字 + 记一笔警告
    ps-bump(p)

    #{overflow=wrap}
    p.warn = p.warn + 1

    ; 條件運算式（LOWEST 優先級，與 Go parseExpression(LOWEST) 一致）
    cond = ps-parse-expr(t, p)

    ; 條件到 LBRACE 之間可能有 NEWLINE/COMMENT——一律跳過
    ps-skip-trivia(p)
    ps-expect(p, tok.LBRACE)
    then = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)

    ; 探測 else（允许 `}\nelse {` 或 `} else {`）
    ; s59：預看【不消費】——直接索引掃到首個非 trivia token；是 ELSE 才把 pos 跳到該處。
    ;   找不到 ELSE 時 pos 原封不動：其間註釋留給外層區塊的 doc/TrailingComments 收集器
    ;   （Go 語義：預看期間註釋只進 p.comments 緩衝、不被吃掉——舊 ps-skip-trivia 預看會吞掉
    ;    if 區塊之後的函式尾註釋，move-clone-liveness 即此根因）。
    k = p.pos
    kscan = true
    (kscan) {

        #{index-out=zero}
        kt = p.toks[k].typ
        kt == tok.NEWLINE || kt == tok.COMMENT -> k = k + 1
        kt != tok.NEWLINE && kt != tok.COMMENT -> kscan = false
    }
    alt = 0

    #{index-out=zero}
    kt2 = p.toks[k].typ
    kt2 == tok.ELSE -> {
        p.pos = k
        ps-bump(p)
        ps-skip-trivia(p)
        ps-expect(p, tok.LBRACE)
        alt = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
    }

    ; arena：先建 cond/then/alt 子樹，再建父，依序 kid-add
    idx = ast.add(t, asp.K_IF_EXPRESSION)
    ast.kid-add(t, idx, cond)
    ast.kid-add(t, idx, then)
    ast.kid-add(t, idx, alt)
    idx
}

; ═══ match desugar（明示形 `subj: { pat -> body … }`）═══════════════════
; 見設計文檔 §6.3（t23 片）與 nolang-parser-lowering-invariants.md §22（S1 收官）。
; ⚠️ 2026-10-19 分歧記錄（S7）：bin/no 的 parser 現已【保留 SurfaceMatch】不展開
;   （S1：翻轉 b918dba9、刪除舊降糖路徑 d6965622；降糖改到 H0 lowering pass 執行）。
;   本節的 parse 期 desugar 是【noc 既有實作】，與 bin/no 現態分歧 ⇒ L2 oracle
;   （`no ast` 逐位元組）在含 match 的語料上必然偏離（實測 264/653 檔，2026-10-19）。
;   ✅ S7 裁定①（2026-10-21，使用者拍板）：noc 預設改產 SurfaceMatch（parser
;   忠實，P1），見上方 PS-SURFACE-MATCH 開關。本節 desugar 路徑**保留**為
;   A/B 回歸基線（PS-SURFACE-MATCH=0）與 M4 hir.no 重做降糖時的形狀參考；
;   預設路徑不再走它。
; 範圍（noc 現狀）：識別元主體、字面量/識別元/wildcard 型樣、運算式/區塊臂、if/else 鏈。
; 延後：守衛、option/enum 完整型樣、複雜主體（呼叫/索引）。

; ps-mk-ident：建 Identifier 葉節點（僅 slot0=name）——供 desugar 多处複用運算元
ps-mk-ident = (t ast, name str) (idx i64) {
    idx = ast.add(t, asp.K_IDENTIFIER)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    idx
}

; ps-mk-it-let：建 `it = subj` 合成 LetStatement（synthetic: true、無 Type）
;   dump：LetStatement{name: it, value: subj, synthetic: true} + kid[0=Type(0),1=Ident]
ps-mk-it-let = (t ast, subjNode i64) (idx i64) {
    idx = ast.add(t, asp.K_LET_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, 'it'))
    ast.set-slot(t, idx, 1, ast.put-str(t, 'true')); synthetic
    ast.kid-add(t, idx, 0); Type 缺席→0 佔位（守 guarded-CHILD 位置）
    ast.kid-add(t, idx, subjNode); value = 主體節點（識別元 / 索引 / 點運算皆可直接用）
    idx
}

; ps-mk-it-let-t：变体臂合成绑定（Go lowering.go buildItBindingForArm）——
;   bt 非空時建 `LetStatement{name: bname, type: NamedType{bt}, value: subj, synthetic: true, armBinding: true}`；
;   bt 空且 bname=='it' 形同 ps-mk-it-let（裸 shared 綁定、無 armBinding）；
;   s60：bt 空但具名綁定（未知主體 ok(v)，Go namedItBinding 回退 :2919-2927）仍 armBinding=true。
;   槽位 s1=synthetic、s2=armBinding（asp.no LetStatement 模板 ref 序）；NamedType 無 inferred 標記。
ps-mk-it-let-t = (t ast, subjNode i64, bt str, bname str) (idx i64) {
    tn = 0
    bt != '' -> {
        tn = ast.add(t, asp.K_NAMED_TYPE)
        ast.set-slot(t, tn, 0, ast.put-str(t, bt))
    }
    idx = ast.add(t, asp.K_LET_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, bname))
    ast.set-slot(t, idx, 1, ast.put-str(t, 'true')); synthetic
    bt != '' || bname != 'it' -> ast.set-slot(t, idx, 2, ast.put-str(t, 'true')); armBinding
    ast.kid-add(t, idx, tn)
    ast.kid-add(t, idx, subjNode); value = 主體節點（識別元 / 索引 / 點運算皆可直接用）
    idx
}

; ps-mk-ext-let：s60 多欄位析構提欄（Go lowering.go:2307-2334）——
;   `LetStatement{name: fname, value: DotExpression{receiver: recv, property: f{j}}, synthetic, armBinding}`，
;   無 Type 子節點（0 佔位）
ps-mk-ext-let = (t ast, fname str, recv str, j i64) (idx i64) {
    rid = ps-mk-ident(t, recv)
    dot = ast.add(t, asp.K_DOT_EXPRESSION)
    ast.set-slot(t, dot, 0, ast.put-str(t, 'f' + j.to-str()))
    ast.kid-add(t, dot, rid)
    idx = ast.add(t, asp.K_LET_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, fname))
    ast.set-slot(t, idx, 1, ast.put-str(t, 'true')); synthetic
    ast.set-slot(t, idx, 2, ast.put-str(t, 'true')); armBinding
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, dot)
    idx
}

; ps-match-listed：掃描當前 match 臂區 token（不消費、不建節點），收集「緊接 `->` 的
;   关键字型樣」：fl[0]=ok fl[1]=err fl[2]=nil（Go hasExplicitOk/Err/Nil，lowering.go:2090-2120）。
;   僅深度 0（本區塊自己的臂）計入——嵌套 {…}/(…)/[…] 增深度，防内層 match 的 `nil ->` 污染補集判定。
;   s60：補集掃描改在 desugar 前（Go 是在 call→Identifier 改寫後掃）——故 ok(v)/err(e) 析構形
;   （expr.go:1021-1065 規範化為 dotVal/Identifier{err}）也計入 fl；並收集變體臂候補
;   cN/cA（裸 `X ->` 記 -1、`X(a,b) ->` 記參數數；ok/err/nil 排除——Go 关键字優先 :2107-2116）。
ps-match-listed = (p psst, fl []i64, cN []str, cA []i64) {
    j = 0
    depth = 0
    go = true
    (go) {
        t = ps-peek-at(p, j)
        {
            t == tok.EOF -> go = false

            depth == 0 && t == tok.RBRACE -> go = false

            t == tok.LBRACE || t == tok.LBRACKET || t == tok.LPAREN -> depth = depth + 1

            depth > 0 && (t == tok.RBRACE || t == tok.RBRACKET || t == tok.RPAREN) -> depth = depth - 1

            depth == 0 && t == tok.NIL && ps-peek-at(p, j + 1) == tok.RARROW -> fl[2] = 1

            depth == 0 && t == tok.IDENT && ps-lit-at(p, j) == 'err' && ps-peek-at(p, j + 1) == tok.RARROW -> fl[1] = 1

            depth == 0 && t == tok.IDENT && ps-lit-at(p, j) == 'ok' && ps-peek-at(p, j + 1) == tok.RARROW -> fl[0] = 1

            depth == 0 && t == tok.IDENT && (ps-lit-at(p, j) == 'ok' || ps-lit-at(p, j) == 'err') && ps-peek-at(p, j + 1) == tok.LPAREN && ps-peek-at(p, j + 2) == tok.IDENT && ps-peek-at(p, j + 3) == tok.RPAREN && ps-peek-at(p, j + 4) == tok.RARROW -> {
                ps-lit-at(p, j) == 'ok' -> fl[0] = 1
                ps-lit-at(p, j) == 'err' -> fl[1] = 1
            }

            depth == 0 && t == tok.IDENT && ps-peek-at(p, j + 1) == tok.RARROW && ps-lit-at(p, j) != 'ok' && ps-lit-at(p, j) != 'err' && ps-lit-at(p, j) != 'nil' -> {
                cN.push(ps-lit-at(p, j))
                cA.push(-1)
            }

            depth == 0 && t == tok.IDENT && ps-peek-at(p, j + 1) == tok.LPAREN && ps-peek-at(p, j + 2) == tok.IDENT -> {
                kb = j + 2
                bcnt = 0
                okC = 1
                (okC == 1) {
                    hit = 0
                    ps-peek-at(p, kb) == tok.IDENT -> {
                        hit = 1
                        bcnt = bcnt + 1
                        kb = kb + 1
                        ps-peek-at(p, kb) == tok.COMMA -> kb = kb + 1
                    }
                    hit == 0 && ps-peek-at(p, kb) == tok.RPAREN -> {
                        hit = 1
                        ps-peek-at(p, kb + 1) == tok.RARROW -> {
                            cN.push(ps-lit-at(p, j))
                            cA.push(bcnt)
                        }
                        okC = 0
                    }
                    hit == 0 -> okC = 0
                }
            }
        }

        #{overflow=wrap}
        j = j + 1
    }
}

; ps-mk-true：wildcard 條件 = IntegerLiteral{value: 1}（無 raw，故不印 raw）
ps-mk-true = (t ast) (idx i64) {
    idx = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, '1'))
    ast.set-slot(t, idx, 1, ast.put-str(t, ''))
    idx
}

; ps-mk-eq：InfixExpression{==}[l, r]（l/r 必須已完整建成）
ps-mk-eq = (t ast, l i64, r i64) (idx i64) {
    idx = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, idx, 0, ast.put-str(t, '=='))
    ast.kid-add(t, idx, l)
    ast.kid-add(t, idx, r)
    idx
}

; ═════════════════════════════════════════════════════════════════════
; s7n：`#{index-out=DEF}` 安全索引【讀形】降糖（`l = arr[i]`）。
; 對應 Go maybeIndexOutAssign（lowering.go:1558-1683）+ defaultLiteralFor /
; scalarZeroLiteral + buildItBindingForArm。目標形（bin/no ast /tmp/t-idxout.no）：
;   BlockStatement{}
;     LetStatement{name: l, value: DEF}                          ; 預宣告（全域未宣告時）
;     LetStatement{name: __idx_out_L_C, type: ?elem, value: arr[i], synthetic: true}
;     ExpressionStatement{IfExpression}
;       IfExpression{ __idx_out_L_C == ok }
;         BlockStatement{ it:elem=__idx_out, l=it }
;         BlockStatement{ it:err|nil=__idx_out, l=DEF }
; ⚠️ arena 共享 kids 游標（add 設 kid0=kids.len）→ 父節點務必最後 add、再 kid-add。
; ═════════════════════════════════════════════════════════════════════

; ps-mk-i64：IntegerLiteral{value:s, raw:s}（s 十進位；Go Raw=FormatInt）
ps-mk-i64 = (t ast, s str) (idx i64) {
    idx = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, s))
    ast.set-slot(t, idx, 1, ast.put-str(t, s))
    idx
}

; ps-mk-bool2：BooleanLiteral{value:b}（b='true'/'false'）
ps-mk-bool2 = (t ast, b str) (idx i64) {
    idx = ast.add(t, asp.K_BOOLEAN_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, b))
    idx
}

; ps-mk-str2：StringLiteral{value:v, raw:'v'}（raw=單引號包覆原文；Go defaultLiteralFor str 路徑）
;   sq 為單引號字元（ASCII 39）→字串（lx-ch-str 走 sb，避開 .to-str 借用缺陷）；raw = sq - v - sq。
ps-mk-str2 = (t ast, v str) (idx i64) {
    sq = lx.lx-ch-str(39)
    raw = sq - v - sq
    idx = ast.add(t, asp.K_STRING_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, v))
    ast.set-slot(t, idx, 1, ast.put-str(t, raw))
    idx
}

; ps-mk-f64：FloatLiteral{value:v, raw:raw}
ps-mk-f64 = (t ast, v str, raw str) (idx i64) {
    idx = ast.add(t, asp.K_FLOAT_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, v))
    ast.set-slot(t, idx, 1, ast.put-str(t, raw))
    idx
}

; ps-mk-let-full：LetStatement{name, type, value, synthetic, armBinding}（typ/val 已建成；typ=0 表 Type 缺席）
ps-mk-let-full = (t ast, name str, typ i64, val i64, synth i64, armB i64) (idx i64) {
    idx = ast.add(t, asp.K_LET_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    synth == 1 -> ast.set-slot(t, idx, 1, ast.put-str(t, 'true'))
    armB == 1 -> ast.set-slot(t, idx, 2, ast.put-str(t, 'true'))
    ast.kid-add(t, idx, typ)
    ast.kid-add(t, idx, val)
    idx
}

; ps-int-elem-p：整數族元素型別白名單（i8..i128 / u8..u128 / byte / char）
ps-int-elem-p = (e str) (r i64) {
    r = 0
    e == 'i8' -> r = 1
    e == 'i16' -> r = 1
    e == 'i32' -> r = 1
    e == 'i64' -> r = 1
    e == 'i128' -> r = 1
    e == 'u8' -> r = 1
    e == 'u16' -> r = 1
    e == 'u32' -> r = 1
    e == 'u64' -> r = 1
    e == 'u128' -> r = 1
    e == 'byte' -> r = 1
    e == 'char' -> r = 1
}

; ps-mk-zero-slice：空切片零值 ArrayLiteral{size:nil, elements:0, wasSliceLiteral:true}。
;   Go zeroValueLiteralFor compositeSlice → ArrayLiteral{Elements:[], WasSliceLiteral:true}。
;   dump：`ArrayLiteral{size: <nil>, wasSliceLiteral: true}`。kid0=nil Size 占位。
ps-mk-zero-slice = (t ast) (idx i64) {
    idx = ast.add(t, asp.K_ARRAY_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, '0')); 0 elements
    ast.set-slot(t, idx, 1, ast.put-str(t, 'true')); wasSliceLiteral
    ast.set-count(t, idx, 0, 0); 0 element kids
    ast.kid-add(t, idx, 0); Size = nil 占位（dump 印 <nil>）
}

; ps-mk-zero-struct：零結構體 StructLiteral{type:ty, fields:0}。
;   Go zeroValueLiteralFor default → StructLiteral{Type:elem, Fields:nil}。
ps-mk-zero-struct = (t ast, ty str) (idx i64) {
    idx = ast.add(t, asp.K_STRUCT_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, ty)); type
    ast.set-slot(t, idx, 1, ast.put-str(t, '0')); 0 fields
    ast.set-count(t, idx, 0, 0); 0 field kids
}

; ps-mk-zero-map：空映射 MapLiteral{pairs:0}。
;   Go zeroValueLiteralFor compositeMap → MapLiteral{Pairs:nil}。無 MapType kid。
ps-mk-zero-map = (t ast) (idx i64) {
    idx = ast.add(t, asp.K_MAP_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, '0')); 0 pairs
    ast.set-count(t, idx, 0, 0); 0 pair kids（無 MapType——Go nil MapType 不 dump）
}

; ps-mk-zero-array：定長陣列零值 ArrayLiteral{size:N, elements:N, wasSliceLiteral:false}。
;   Go zeroValueLiteralFor compositeArray → ArrayLiteral{Size:N, Elements:[N×zero]}。
;   元素遞迴取 scalarZeroLiteral；為簡化先只建標量零元素（複合嵌套元素留待需要時擴展）。
ps-mk-zero-array = (t ast, szs str, el str) (idx i64) {
    n = szs.to-i64()
    idx = ast.add(t, asp.K_ARRAY_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, szs)); elements count = N
    ast.set-count(t, idx, 0, n); KIDS iteration count = N（不含 Size CHILD）
    szn = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, szn, 0, ast.put-str(t, szs))
    ast.set-slot(t, szn, 1, ast.put-str(t, szs)); raw = value
    ast.kid-add(t, idx, szn); Size（child0）
    m = 0
    (m < n) {
        z = ps-mk-def-lit(t, el, 'zero', 0)
        z > 0 -> ast.kid-add(t, idx, z)
        z <= 0 -> ast.kid-add(t, idx, 0); 兜底 nil 占位
        #{overflow=wrap}
        m = m + 1
    }
}

; ps-is-comp-elem：isContainerOrStructElem 鏡像——`[` 開頭為容器；非標量扁平名為結構體。
ps-is-comp-elem = (e str) (r i64) {
    r = 0
    n = e.len-bytes()
    n > 0 -> {
        c0-opt = e.byte(0)
        c0 = c0-opt: {
            ok -> it
            -> 0
        }
        c0 == 91 -> r = 1; `[` 開頭 = 容器
        c0 != 91 -> {
            e != 'f64' && e != 'f32' && e != 'bool' && e != 'str' && e != 'txt' && ps-int-elem-p(e) == 0 -> r = 1
        }
    }
}

; ps-is-digits：字串是否全為數字（判 `[N]X` vs `[K]V`）。
ps-is-digits = (s str) (r i64) {
    r = 0
    n = s.len-bytes()
    n > 0 -> {
        r = 1
        i = 0
        (i < n) {
            c-opt = s.byte(i)
            c = c-opt: {
                ok -> it
                -> 0
            }
            (c < 48 || c > 57) -> r = 0
            #{overflow=wrap}
            i = i + 1
        }
    }
}

; ps-mk-zero-comp：複合零值分派（Go zeroValueLiteralFor）。
;   []X→空slice / [N]X→零陣列 / [K]V→空map / 結構體→零struct。
ps-mk-zero-comp = (t ast, elem str) (idx i64) {
    idx = 0
    exsh = ps-elem-shape(elem)
    exsh == 2 -> idx = ps-mk-zero-slice(t); []X
    exsh == 3 -> {
        szs = ps-elem-arr-size(elem)
        ps-is-digits(szs) == 1 -> idx = ps-mk-zero-array(t, szs, ps-elem-arr-elem(elem)); [N]X
        ps-is-digits(szs) == 0 -> idx = ps-mk-zero-map(t); [K]V
    }
    exsh == 0 -> idx = ps-mk-zero-struct(t, elem); 結構體
}

; ps-mk-def-lit：依元素型別 + index-out 值建 DEF 字面量（回 0=不支援⇒跳過降糖）。
;   對齊 Go defaultLiteralFor（標量+複合）+ scalarZeroLiteral。
ps-mk-def-lit = (t ast, elem str, iv str, ivTy i64) (idx i64) {
    idx = 0
    iv == 'zero' -> {
        elem == 'f64' -> idx = ps-mk-f64(t, '0', '0')
        elem == 'f32' -> idx = ps-mk-f64(t, '0', '0')
        elem == 'bool' -> idx = ps-mk-bool2(t, 'false')
        elem == 'str' -> idx = ps-mk-str2(t, '')
        elem == 'txt' -> idx = ps-mk-str2(t, '')
        ps-int-elem-p(elem) == 1 -> idx = ps-mk-i64(t, '0')
        ps-is-comp-elem(elem) == 1 -> idx = ps-mk-zero-comp(t, elem)
    }
    iv != 'zero' && ivTy == tok.INT -> {
        elem == 'f64' -> idx = ps-mk-f64(t, iv, iv)
        elem == 'f32' -> idx = ps-mk-f64(t, iv, iv)
        elem == 'str' -> {
            iv == '0' -> idx = ps-mk-str2(t, '')
        }
        elem == 'txt' -> {
            iv == '0' -> idx = ps-mk-str2(t, '')
        }
        ps-int-elem-p(elem) == 1 -> idx = ps-mk-i64(t, ps-int-lit-value(iv))
        ; Go defaultLiteralFor：複合元素 + IntValue 0 → 零值（nil/0 同義）
        ps-is-comp-elem(elem) == 1 -> {
            iv == '0' -> idx = ps-mk-zero-comp(t, elem)
        }
    }
    iv != 'zero' && ivTy == tok.STRING -> {
        elem == 'str' -> idx = ps-mk-str2(t, iv)
        elem == 'txt' -> idx = ps-mk-str2(t, iv)
        ; Go defaultLiteralFor integer+STRING → 首 rune 碼點 IntegerLiteral{value:cp, raw:iv}
        ps-int-elem-p(elem) == 1 -> {
            b0-opt = iv.byte(0)
            b0 = b0-opt: {
                ok -> it
                -> 0
            }
            ; 用 i64.to-str（原生 @str_from_i64，運行期正確，numeric DEF 已驗證）取代
            ; byte.to-str（→u64.to-str 借用緩衝區，運行期懸垂→垃圾指標）。
            ; 先把 byte 拓寬成 i64（byte+整型字面量→i64），再走 i64.to-str。
            bi = b0 + 0
            b0v = bi.to-str()
            idx = ast.add(t, asp.K_INTEGER_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, b0v))
            ast.set-slot(t, idx, 1, ast.put-str(t, iv))
        }
    }
    iv != 'zero' && ivTy == tok.FLOAT -> {
        elem == 'f64' -> idx = ps-mk-f64(t, iv.to-f64().to-str(), iv)
        elem == 'f32' -> idx = ps-mk-f64(t, iv.to-f64().to-str(), iv)
    }
    iv != 'zero' && (ivTy == tok.TRUE || ivTy == tok.FALSE) -> {
        elem == 'bool' -> {
            ivTy == tok.TRUE -> idx = ps-mk-bool2(t, 'true')
            ivTy == tok.FALSE -> idx = ps-mk-bool2(t, 'false')
        }
    }
}

; ps-build-idxout：建構安全索引讀形的 BlockStatement（形見 ps-apply-index-out 頂註）。
;   defNone= none 臂 DEF、defPre= 預宣告 DEF（兩份獨立節點，避免共享）。
;   needPre= 是否建預宣告（Go lowering.go:1676：VarTypes[name]=='' 才建）。
ps-build-idxout = (t ast, name str, tmpName str, elem str, idxExpr i64, defNone i64, defPre i64, needPre i64) (out i64) {
    ; —— 子先於父：先建全部子節點 ——
    tn = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, tn, 0, ast.put-str(t, elem))
    nul = ast.add(t, asp.K_NULLABLE_TYPE)
    ast.kid-add(t, nul, tn)
    cL = ps-mk-ident(t, tmpName)
    cR = ps-mk-ident(t, 'ok')
    cond = ps-mk-eq(t, cL, cR)
    okSub = ps-mk-ident(t, tmpName)
    okIt = ps-mk-it-let-t(t, okSub, elem, 'it')
    okVal = ps-mk-ident(t, 'it')
    okAs = ps-mk-let-full(t, name, 0, okVal, 0, 0)
    okBlk = ast.add(t, asp.K_BLOCK_STATEMENT)
    ast.kid-add(t, okBlk, okIt)
    ast.kid-add(t, okBlk, okAs)
    ast.set-count(t, okBlk, 0, 2)
    noSub = ps-mk-ident(t, tmpName)
    noIt = ps-mk-it-let-t(t, noSub, 'err | nil', 'it')
    noAs = ps-mk-let-full(t, name, 0, defNone, 0, 0)
    noBlk = ast.add(t, asp.K_BLOCK_STATEMENT)
    ast.kid-add(t, noBlk, noIt)
    ast.kid-add(t, noBlk, noAs)
    ast.set-count(t, noBlk, 0, 2)
    ife = ast.add(t, asp.K_IF_EXPRESSION)
    ast.kid-add(t, ife, cond)
    ast.kid-add(t, ife, okBlk)
    ast.kid-add(t, ife, noBlk)
    es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
    ast.kid-add(t, es, ife)
    tmp = ps-mk-let-full(t, tmpName, nul, idxExpr, 1, 0)
    pre = 0
    needPre == 1 -> pre = ps-mk-let-full(t, name, 0, defPre, 0, 0)
    out = ast.add(t, asp.K_BLOCK_STATEMENT)
    needPre == 1 -> {
        ast.kid-add(t, out, pre)
        ast.kid-add(t, out, tmp)
        ast.kid-add(t, out, es)
        ast.set-count(t, out, 0, 3)
    }
    needPre == 0 -> {
        ast.kid-add(t, out, tmp)
        ast.kid-add(t, out, es)
        ast.set-count(t, out, 0, 2)
    }
    out
}

; ps-build-idxout-w：建構安全索引寫形的 BlockStatement（`LHS = arr[i]` + `#{index-out=DEF}`）。
;   ok 臂：ExpressionStatement{AssignExpression{lval, it}}（解箱元素寫入 LHS）
;   none 臂：ExpressionStatement{AssignExpression{lval, DEF}}
;   無預宣告（LHS 是既有 lvalue），count=2。lval 為 LHS 表達式節點索引（共享）。
ps-build-idxout-w = (t ast, lval i64, tmpName str, elem str, idxExpr i64, defNone i64) (out i64) {
    ; —— 子先於父 ——
    tn = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, tn, 0, ast.put-str(t, elem))
    nul = ast.add(t, asp.K_NULLABLE_TYPE)
    ast.kid-add(t, nul, tn)
    cL = ps-mk-ident(t, tmpName)
    cR = ps-mk-ident(t, 'ok')
    cond = ps-mk-eq(t, cL, cR)
    ; ok 臂
    okSub = ps-mk-ident(t, tmpName)
    okIt = ps-mk-it-let-t(t, okSub, elem, 'it')
    okVal = ps-mk-ident(t, 'it')
    okAe = ast.add(t, asp.K_ASSIGN_EXPRESSION)
    ast.kid-add(t, okAe, lval)
    ast.kid-add(t, okAe, okVal)
    okEs = ast.add(t, asp.K_EXPRESSION_STATEMENT)
    ast.kid-add(t, okEs, okAe)
    okBlk = ast.add(t, asp.K_BLOCK_STATEMENT)
    ast.kid-add(t, okBlk, okIt)
    ast.kid-add(t, okBlk, okEs)
    ast.set-count(t, okBlk, 0, 2)
    ; none 臂
    noSub = ps-mk-ident(t, tmpName)
    noIt = ps-mk-it-let-t(t, noSub, 'err | nil', 'it')
    noAe = ast.add(t, asp.K_ASSIGN_EXPRESSION)
    ast.kid-add(t, noAe, lval)
    ast.kid-add(t, noAe, defNone)
    noEs = ast.add(t, asp.K_EXPRESSION_STATEMENT)
    ast.kid-add(t, noEs, noAe)
    noBlk = ast.add(t, asp.K_BLOCK_STATEMENT)
    ast.kid-add(t, noBlk, noIt)
    ast.kid-add(t, noBlk, noEs)
    ast.set-count(t, noBlk, 0, 2)
    ; IfExpression + ExpressionStatement + outer BlockStatement
    ife = ast.add(t, asp.K_IF_EXPRESSION)
    ast.kid-add(t, ife, cond)
    ast.kid-add(t, ife, okBlk)
    ast.kid-add(t, ife, noBlk)
    es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
    ast.kid-add(t, es, ife)
    tmp = ps-mk-let-full(t, tmpName, nul, idxExpr, 1, 0)
    out = ast.add(t, asp.K_BLOCK_STATEMENT)
    ast.kid-add(t, out, tmp)
    ast.kid-add(t, out, es)
    ast.set-count(t, out, 0, 2)
    out
}

; ps-idx-elem-d：降糖路徑的元素型別推斷（Go inferIndexElemType → containerElemType）。
;   與 ps-idx-elem-of 的差異：额外处理 str/txt → char（D6 2026-10-13）。
;   仅用于 ps-apply-index-out，不用于 ps-parse-let 的型別登记（Go stmt.go 不映射）。
ps-idx-elem-d = (ty str) (r str) {
    r = ''
    ty == 'str' -> {
        r = 'char'
        return
    }
    ty == 'txt' -> {
        r = 'char'
        return
    }
    r = ps-idx-elem-of(ty)
}

; ps-tv-recv-elem：to-vec 接收者型別 → 元素型別（Go toVecElemType 尾步：
;   containerElemType(TrimPrefix(recvType, "?"))）。先剝 `?` 前綴再走
;   ps-idx-elem-d（str/txt→char + []X/[N]X，同 containerElemType 口徑）。
;   ⚠️ 全程以 ty【參數】為 .byte() 接收者（ps.no 巨型模組 str.byte 陷阱）。
ps-tv-recv-elem = (ty str) (r str) {
    r = ''
    n = ty.len-bytes()
    n > 0 -> {
        c0-opt = ty.byte(0)
        c0 = c0-opt: {
            ok -> it
            -> 0
        }
        c0 == 63 -> {

            ; `?X` → 剝前綴後取元素
            r = ps-idx-elem-d(ty.slice-bytes(1, n))
            return
        }
    }
    r = ps-idx-elem-d(ty)
}

; ps-dot-recv-name：`a` / `a.field` 接收者表達式最左識別符名（Go dotReceiverName）。
ps-dot-recv-name = (t ast, node i64) (nm str) {
    nm = ''
    node > 0 -> {
        nk = ast.kind-at(t, node)
        nk == asp.K_IDENTIFIER -> {
            ndi = ast.nd-at(t, node)
            nm = ast.str-at(t, ndi.s0)
        }
        nk == asp.K_DOT_EXPRESSION -> {
            ndd = ast.nd-at(t, node)
            nrc = ast.kid-at(t, ndd.kid0)
            nm = ps-dot-recv-name(t, nrc)
        }
    }
}

; ps-to-vec-elem：`X.to-vec()` / `X.to-vec` RHS → 容器元素型別（Go toVecElemType，
;   lowering.go:811-840）。非 to-vec 形 / 接收者型別未知 ⇒ ''。鏈式
;   （bv=b.to-vec(); cv=bv.to-vec()）靠 ps-var-type 查到先前 to-vec 登記的
;   `[]elem`，再取其元素。
ps-to-vec-elem = (t ast, p psst, val i64) (r str) {
    r = ''
    prop = ''
    recvNode = 0
    val > 0 -> {
        tk = ast.kind-at(t, val)
        tk == asp.K_CALL_EXPRESSION -> {
            tvd = ast.nd-at(t, val)
            tfc = ast.kid-at(t, tvd.kid0)
            tfc > 0 && ast.kind-at(t, tfc) == asp.K_DOT_EXPRESSION -> {
                tfd = ast.nd-at(t, tfc)
                prop = ast.str-at(t, tfd.s0)
                recvNode = ast.kid-at(t, tfd.kid0)
            }
        }
        tk == asp.K_DOT_EXPRESSION -> {
            tvd2 = ast.nd-at(t, val)
            prop = ast.str-at(t, tvd2.s0)
            recvNode = ast.kid-at(t, tvd2.kid0)
        }
    }
    prop == 'to-vec' -> {
        rn = ps-dot-recv-name(t, recvNode)
        rn != '' -> {
            recvTy = ps-var-type(p, rn)
            recvTy != '' -> r = ps-tv-recv-elem(recvTy)
        }
    }
}

; ps-apply-index-out：安全索引降糖主入口（鏡像 Go maybeIndexOutAssign，lowering.go:1558）。
;   讀形（LetStatement 非 synthetic、value=IndexExpression、base=Identifier）+ 寫形
;   （ExpressionStatement{AssignExpression} 非 Identifier LHS、value=IndexExpression）。
;   命中時回傳取代的 BlockStatement，否則原樣回傳。
ps-apply-index-out = (t ast, p psst, stmtIdx i64, iv str, ivTy i64, ln i64, cl i64, aeLn i64, aeCl i64) (out i64) {
    out = stmtIdx
    d = ast.nd-at(t, stmtIdx)

    ; ── 讀形：LetStatement 非 synthetic、value=IndexExpression ──
    d.kind == asp.K_LET_STATEMENT -> {
        syn = ast.str-at(t, d.s1)
        syn != 'true' -> {
            name = ast.str-at(t, d.s0)
            idxExpr = ast.kid-at(t, d.kid0 + 1)
            idxExpr > 0 && ast.kind-at(t, idxExpr) == asp.K_INDEX_EXPRESSION -> {
                idxd = ast.nd-at(t, idxExpr)
                base = ast.kid-at(t, idxd.kid0)
                base > 0 && ast.kind-at(t, base) == asp.K_IDENTIFIER -> {
                    bd = ast.nd-at(t, base)
                    bname = ast.str-at(t, bd.s0)
                    recvTy = ps-var-type(p, bname)
                    elem = ps-idx-elem-d(recvTy)
                    elem != '' -> {
                        defNone = ps-mk-def-lit(t, elem, iv, ivTy)
                        defNone > 0 -> {
                            needPre = 0
                            ps-g-var-type(p, name) == '' -> needPre = 1
                            defPre = 0
                            needPre == 1 -> defPre = ps-mk-def-lit(t, elem, iv, ivTy)
                            tmpName = '__idx_out_' - ln.to-str() - '_' - cl.to-str()
                            p.rwDoc = 1; s8a：降糖改寫 ⇒ 行前 Doc 丟棄（對齊 oracle）
                            out = ps-build-idxout(t, name, tmpName, elem, idxExpr, defNone, defPre, needPre)
                        }
                    }
                }
            }
        }
    }

    ; ── 寫形：ExpressionStatement{AssignExpression} 非 Identifier LHS ──
    ;   Go lowering.go:1582-1586：leftExpr = s.Left（IndexExpression/DotExpression），
    ;   tok = s.Token（= 運算子位置）；arm 賦值目標 = leftExpr（非 name）。
    d.kind == asp.K_EXPRESSION_STATEMENT -> {
        ae = ast.kid-at(t, d.kid0)
        ae > 0 && ast.kind-at(t, ae) == asp.K_ASSIGN_EXPRESSION -> {
            aed = ast.nd-at(t, ae)
            lval = ast.kid-at(t, aed.kid0)
            rval = ast.kid-at(t, aed.kid0 + 1)
            ; LHS 非 Identifier（IndexExpression / DotExpression）才走寫形
            lval > 0 && ast.kind-at(t, lval) != asp.K_IDENTIFIER -> {
                rval > 0 && ast.kind-at(t, rval) == asp.K_INDEX_EXPRESSION -> {
                    idxd = ast.nd-at(t, rval)
                    base = ast.kid-at(t, idxd.kid0)
                    base > 0 && ast.kind-at(t, base) == asp.K_IDENTIFIER -> {
                        bd = ast.nd-at(t, base)
                        bname = ast.str-at(t, bd.s0)
                        recvTy = ps-var-type(p, bname)
                        elem = ps-idx-elem-d(recvTy)
                        elem != '' -> {
                            defNone = ps-mk-def-lit(t, elem, iv, ivTy)
                            defNone > 0 -> {
                                tmpName = '__idx_out_' - aeLn.to-str() - '_' - aeCl.to-str()
                                p.rwDoc = 1; s8a：降糖改寫 ⇒ 行前 Doc 丟棄（對齊 oracle）
                                out = ps-build-idxout-w(t, lval, tmpName, elem, rval, defNone)
                            }
                        }
                    }
                }
            }
        }
    }
}

; ps-parse-match：解析 `subj: { pat -> body … }` 的**臂區**（已消費 `:` 與 `{`），
;   停在閉合 `}` 前（呼叫端 ps-expect(RBRACE)）。desugar 為 if/else 鏈：
;   • 非 wildcard 臂：cond = subj==pat，consequence = 臂區塊（先塞 it 合成綁定）
;   • wildcard `_` 或裸 `->`（尾隨無型樣臂＝else）：其區塊直接作前一 if 的 alternative
;   • 相鄰非 wildcard 臂：後臂包成 else 區塊 BlockStatement{}[ExpressionStatement{if}]
;   • err/nil 关键字臂（型樣為裸关键字且緊接 `->`）：綁定带 type+armBinding（對齊 Go buildItBindingForArm）
;   ⚠️ arena 共享 kids 游標（add 設 kid0=kids.len）→ 父節點務必最後 add、再 kid-add。
ps-parse-match = (t ast, p psst, subj str, subjNode i64) (idx i64) {
    wildA []i64 = with-cap(4)
    patA []i64 = with-cap(4)
    blkA []i64 = with-cap(4)
    ; s66c：surface 形專用收集（與 desugar 的 wildA/patA/blkA 平行）
    swA []i64 = with-cap(4); surface wildcard（含关键字臂 ok/err/nil）
    dotValA []i64 = with-cap(4)
    bindA []str = with-cap(4); MatchArm.binding（析構綁定名，如 ok(v) 的 v）
    bvarA []str = with-cap(4); MatchArm.bindingVariant（ok(v)→ok / err(e)→err，無綁定留空）
    condA []i64 = with-cap(4); MatchArm.Condition（型樣節點；wildcard/关键字臂=0）
    blkSA []i64 = with-cap(4); surface 臂體（不含合成 it）
    bbA []i64 = with-cap(4); s66c：blockBody 標記（hd2==1 區塊臂⇒true，對齊 oracle MatchArm.blockBody）
    tarmA []i64 = with-cap(4); s7 續：typeArm 標記（`v T ->` 帶綁定型別臂）
    tpatA []str = with-cap(4); typePattern（union 成員型別名）
    tbndA []str = with-cap(4); typeBinding（綁定名）
    bshape = 0
    rawA []i64 = with-cap(4); s66d：raw-cond 臂標記（ok(<expr>) 條件值臂⇒rawCond:true）
    matchHasRaw = 0; s66d：match 層 raw-cond 標記（僅供 rawCond 槽使用；valueCtx 改由 psst.valCtx 驅動，見 s67）
    mv = p.valCtx; s67 讀點修正（s7）：入函快照——臂體 ps-parse-stmt 會把活 p.valCtx 重置為 0，
    ;   發射時尾讀必失真（實測 `r = n: { -> 'ok' }` 漏 valueCtx）。Go 端是整個 match 表達式
    ;   解析期間 CTX_EXPR 恆定，故快照於入函、全臂共用。

    ; 同 ps-parse-bare-match：臂迴圈自行消化 `->`，抑制區塊級續接前探
    oldMat = p.inMatch
    p.inMatch = 1

    ; s55：預掃关键字臂名單（Go hasExplicitOk/Err/Nil）——供 wildcard 臂補集判定
    ; s60：另收變體臂候補 cN/cA（補集 = evs − 候補∩變體）
    listed []i64 = with-cap(3)
    listed.push(0)
    listed.push(0)
    listed.push(0)
    cN []str = with-cap(8)
    cA []i64 = with-cap(8)
    ps-match-listed(p, listed, cN, cA)

    ; s60：主題靜態型別與枚舉判定（Go matchedVarType/isEnumType/enumVariants，lowering.go:1927-1941）
    st0 = ps-var-type(p, subj)
    isenum = 0
    ps-enum-has(p, st0) == 1 -> isenum = 1
    evs []str = with-cap(8)
    isenum == 1 -> ps-enum-variants(p, st0, evs)

    ; s8t：移植 Go match_warn.go::warnUnreachableArms 的【不可達 wildcard 臂】計數——
    ;   當 option 主體（型別 `?T`）三變體 ok/err/nil 全列、或 enum 主體全部變體全列時，
    ;   裸 `->` 臂為死碼（同 Go skipItBinding 觸發點，lowering.go:2214）。Go 已把這條
    ;   saveWarning 從降糖搬到 parse 期（降糖路徑那兩處移除），故 noc 須在此累加 p.warn，
    ;   dump 才現 `Program{warnings: N}`。⚠️ 全語料僅 tests/match-test.no 命中 2 臂（19:9/79:9）。
    ;   deadTotal 於下方兩處 dead=1 累加；發射時【raw-cond 抑制】（Go：任一臂 IsRawCond 整段 return）。
    deadTotal = 0

    ; s59：臂首 armDoc 收集（Go match.go:208 collectDocComments）——行尾註解已在上一臂
    ;   body 解析完當場被 tail-attach 取走，迴圈頭所見註解恆為 standalone⇒prev=0 純 doc。
    ;   套用規則（Go match.go:440-452）：inline 體→setDoc(bodyStmts[0])；區塊體→置入尾註群。
    ;   ⚠️ 舊首/尾 ps-skip-trivia  destructive 吞註解是缺 Doc 的根因。
    blkTrail []i64 = with-cap(4)
    hasTrail = 0
    armGo = true
    (armGo) {
        armDoc = ps-skip-trivia-doc(t, p, 0)
        armGo = ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF
        armGo -> {
            pos0 = p.pos

            ; 型樣：`_` 或裸 `->`（無型樣＝else 臂）→ wildcard；否則解析成表達式（int/float/bool/str/char/ident）
            ; ⚠️ 用快照 at 令兩臂互斥（ps-peek 随位置重评会误触发，見 ps.no LBRACKET 臂同构写法）
            ; ⚠️ err/nil 关键字臂（緊接 `->`）記 kvar ⇒ 綁定带 type+armBinding（Go buildItBindingForArm）
            wild = 0
            pat = 0
            kvar = ''
            rawc = 0; s66d：本臂是否 raw-cond 臂（ok(<expr>)）
            typArm = 0; s7 續：`v T ->` 帶綁定型別臂（expr.go:1152-1160）
            tpatS = ''
            tbndS = ''
            bname = ''
            kvarE = ''
            bmulti = 0
            bns2 []str = with-cap(4)
            fxv []str = with-cap(4)
            fxo []str = with-cap(4)
            reg = ''
            at = ps-peek(p)
            tk0 = ps-peek-token(p)
            {
                at == tok.UNDERSCORE -> {
                    ps-bump(p)
                    wild = 1
                }

                at == tok.RARROW -> wild = 1; 裸尾臂＝else（不消費，交由下方 expect(RARROW)）

                at != tok.UNDERSCORE && at != tok.RARROW -> {
                    kwt = 0
                    caseA = 0
                    caseB = 0
                    tk0.typ == tok.NIL && ps-peek-at(p, 1) == tok.RARROW -> {
                        kvar = 'nil'
                        kwt = 1
                    }
                    kwt == 0 && tk0.typ == tok.IDENT && tk0.lit == 'err' && ps-peek-at(p, 1) == tok.RARROW -> kvar = 'err'
                    kwt == 0 && tk0.typ == tok.IDENT && tk0.lit == 'ok' && ps-peek-at(p, 1) == tok.RARROW -> kvar = 'ok'

                    ; s7 續：帶綁定型別臂 `v T ->`（expr.go:1152-1160）——IsTypeArm+TypePattern+
                    ;   TypeBindingName，**無** Condition。純語法識別（成員校驗在 lowering/checker）。
                    ;   ⚠️ 舊缺陷：落通用 expr 解析 ⇒ `v` 成 Condition、`T -> …` 被換行 `->` 續接
                    ;   吸進臂體當 standalone if（實測 match-type-arm.no）。
                    kwt == 0 && typArm == 0 && tk0.typ == tok.IDENT && ps-peek-at(p, 1) == tok.IDENT && ps-peek-at(p, 2) == tok.RARROW -> {
                        typArm = 1
                        tpatS = ps-lit-at(p, 1).copy()
                        tbndS = tk0.lit.copy()
                        ps-bump(p)
                        ps-bump(p)
                    }

                    ; s60 case A：ok(v)/err(e) 析構綁定（expr.go:1021-1065 _parse 期規範化）——
                    ;   括內單裸識別符 ⇒ 型樣 condition 換 Identifier{ok|err}、綁定名 v/e
                    kwt == 0 && tk0.typ == tok.IDENT && (tk0.lit == 'ok' || tk0.lit == 'err') && ps-peek-at(p, 1) == tok.LPAREN &&
ps-peek-at(p, 2) == tok.IDENT && ps-peek-at(p, 3) == tok.RPAREN -> {
                        caseA = 1
                        bname = ps-lit-at(p, 2)
                        kvar = tk0.lit.copy()
                        pat = ps-mk-ident(t, tk0.lit)
                        ps-bump(p)
                        ps-bump(p)
                        ps-bump(p)
                        ps-bump(p)
                    }

                    ; s60 case B：枚舉變體呼叫臂（Go 泛化改寫 lowering.go:2049-2090）——全裸識別符
                    ;   參數且元數==欄位數 ⇒ 型樣換 Identifier{X}、參數名入綁定（>1 ⇒ 提欄）
                    ;   ⚠️ s7 續：該泛化在 Go 是【lowering 期】改寫——parse 期 surface 保留原始
                    ;   CallExpression 型樣、binding 空（實測 oracle：`circle(r) ->` ⇒
                    ;   MatchArm{binding: } + CallExpression{fn: circle, args: 1}）。舊 noc 在
                    ;   parse 期就換 Identifier+綁定 ⇒ 旗標/型樣雙錯。surface 模式（=1）跳過
                    ;   本 case（落通用 expr 解析 ⇒ CallExpression ✓）；=0 維持舊降糖路。
                    caseA == 0 && PS-SURFACE-MATCH == 0 && isenum == 1 && tk0.typ == tok.IDENT && ps-peek-at(p, 1) == tok.LPAREN && ps-peek-at(p, 2) == tok.IDENT -> {
                        kb = 2
                        bcnt = 0
                        okB = 1
                        (okB == 1) {
                            hb = 0
                            ps-peek-at(p, kb) == tok.IDENT -> {
                                hb = 1
                                bns2.push(ps-lit-at(p, kb))
                                bcnt = bcnt + 1
                                kb = kb + 1
                                ps-peek-at(p, kb) == tok.COMMA -> kb = kb + 1
                            }
                            hb == 0 && ps-peek-at(p, kb) == tok.RPAREN -> {
                                hb = 1
                                nc = ps-enum-ncols(p, st0, tk0.lit)
                                nc > 0 && nc == bcnt -> caseB = 1
                                okB = 0
                            }
                            hb == 0 -> okB = 0
                        }
                        caseB == 1 -> {
                            k = 0
                            (k <= kb) {
                                ps-bump(p)

                                #{overflow=wrap}
                                k = k + 1
                            }
                            pat = ps-mk-ident(t, tk0.lit)
                            kvarE = tk0.lit.copy()
                            bcnt == 1 -> {

                                #{index-out=zero}
                                bname = bns2[0]
                            }
                            bcnt > 1 -> bmulti = 1
                        }
                    }

                    ; s60：裸變體臂（非关键字、已登記枚舉之變體）→ kvarE（Go :2243-2250）
                    caseA == 0 && caseB == 0 && kwt == 0 && isenum == 1 && tk0.typ == tok.IDENT && ps-peek-at(p, 1) == tok.RARROW &&
tk0.lit != 'ok' && tk0.lit != 'err' && tk0.lit != 'nil' && ps-enum-row(p, st0, tk0.lit) >= 0 -> kvarE = tk0.lit.copy()
                    ; s66d：raw-cond 臂 ok(<expr>) — <expr> 非單裸識別符（ok(v) 值綁定由 caseA 處理）；
                    ;   內部布林表達式即 Condition；rawCond/valueCtx 標記；不綁定、非 wildcard、非 dotVal。
                    caseA == 0 && caseB == 0 && tk0.typ == tok.IDENT && tk0.lit == 'ok' && ps-peek-at(p, 1) == tok.LPAREN -> {
                        rawc = 1
                        matchHasRaw = 1
                        ps-bump(p)
                        ps-bump(p)
