; ═════════════════════════════════════════════════════════════════
; ps — Nolang 語法分析器（M2 的第一片）
; ═════════════════════════════════════════════════════════════════
;
; 目標（M2，見 docs/design/nolang-selfhost.md §5.3）：把 token 串
; （lx.scan-all 的產物）解析成 ast 的 arena，使 `noc ast <file>` 的 dump
; 與 L2 oracle `no ast <file>` **逐位元組相同**。
;
; ⚠️ 本檔是【第一片】——只涵蓋足以重現下列最小 fixture 的子集合：
;   * `42`                                  ExpressionStatement + IntegerLiteral
;   * `main = () { 42 }`                    FunctionDefinition + BlockStatement
;   * `x = 1` / `b = true` / `s = 'hi'`     LetStatement + 型別推論（i64/bool/str）
;   尚未涵蓋：明示型別標註、infix/前綴運算式、多數陳述與運算式種類、參數
;   型別與預設值、註解、annotations。這些是後續增量擴充的目標。
;
; ── arena 的建構順序（關鍵不變式）──────────────────────────────────
; `ast.add` 在呼叫當下把 `kid0` 固定成「目前 kids 陣列的長度」。因此必須
; **先建子節點（含它們的子樹），再建父節點並 kid-add 子節點**（自底向上），
; 這樣每個節點的 kid0 才會正確指到它在 kids 陣列裡的子樹起點。所有
; ps-parse-* 都遵守這個順序。
;
; ── 必須複製的是「建構路徑」，不只是語義（§5.3.2）──────────────────
;   `x = 1` 的型別不是寫在原始碼裡的，而是 Go 端 lowering 推論出 `i64`、
;   並在 NamedType 上標 `inferred: true`。noc 要綠燈就必須在同一路徑上
;   合成這個 NamedType——本檔的 ps-infer-type 就是做這件事。
;
; ── SHS 合規 ──────────────────────────────────────────────────────
;   無模組級可變狀態、無一等函式值、無指針、無 map 欄位。
; ⚠️ 整數運算預設回 option<int>：每條算術陳述都要 #{overflow=wrap}。
; ⚠️ 讀 `arr[i]`（i 非字面量）要 #{index-out=zero}。
; ⚠️ `;` 是**行註解**，不是陳述分隔符。
; ⚠️ `(cond) { … }` 才是迴圈；`v: { … }` 是 match 臂。
;
; ── 結構體回傳值的釋放陷阱（oracle 後端缺陷，見 docs/design/
;    nolang-selfhost.md §2.2.x / 記憶）─────────────────────────────
;   tk 結構體含 7 個 str 欄位。**實測（noc 編譯产物，M2）**：「把
;   []tk 的元素讀進一個結構體暫存值」是**淺別名**（`t = p.toks[i]` 不
;   深拷貝 str 欄位），於是任何持有這份別名的區域變數在作用域結束時
;   會釋放**仍住在 toks 向量裡**的字串緩衝：第一次釋放僥倖無事，第二
;   次（同一元素的另一份別名、或向量自身解構時）就是 malloc abort
;   （RC=134「pointer being freed was not allocated」）。「先指派給區
;   域變數」並**不能**防住這個坑。
;   ⇒ 本檔守則（已驗證有效）：
;     · 只需型別時用 `ps-peek` / `ps-peek-at`（回傳 i64，用鏈式欄位讀
;       `p.toks[i].typ`，不產生結構體別名）；
;     · 需要完整 token 時 `ps-peek-token` 逐欄位重建，str 欄位一律
;       `.copy()`（強制新分配，切斷與向量元素的共享）；
;     · `ps-bump` 只前進 pos，**不得**用 `_ = ps-peek-token(p)` 來表達
;       「吃 token」的意圖。

# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/lx
# /compiler/src/tok

; ── 解析器狀態 ──
; ⚠️ 結構體名 psst（不是 ps）：模組短名是 ps（來自 `# /compiler/src/ps`），
;    若結構體也叫 ps 會和模組名撞名，導致 EmitLLVM: unknown callee ps.new。
;   跨模組呼叫寫 ps.new / ps.parse —— 必須對應【裸】函式名 `new` / `parse`
;   （lx.no 的 lx.dump → 裸 `dump` 是同樣規則）。
psst {
    toks []tk
    pos i64
    warn i64
}

; new：掃描原始碼，建立解析器（跨模組呼叫寫 ps.new → 必須是裸函式名 `new`）
new = (src str) (r psst) {
    r = psst {
        toks: lx.scan-all(src)
        pos: 0
        warn: 0
    }
}

; ps-peek：目前 token 的型別（越界視為 EOF）。回傳 i64——避免回傳帶字串欄位
;   的 tk 結構體當作暫存值（會觸發釋放崩潰）。
ps-peek = (p psst) (typ i64) {
    i = p.pos
    i >= p.toks.len() -> {
        typ = tok.EOF
        return
    }

    #{index-out=zero}
    typ = p.toks[i].typ
}

; ps-peek-token：目前 token 的完整結構體。逐欄位重建 + str `.copy()`，
;   回傳的 tk 持有全新字串，呼叫端可安全指派/讀欄位（見檔頭守則）。
ps-peek-token = (p psst) (t tk) {
    t = tk {
        ln: 0
        cl: 0
        typ: 0
        lit: ''
        raw: ''
        mk: ''
        emsg: ''
    }
    p.pos >= p.toks.len() -> return

    #{index-out=zero}
    t.ln = p.toks[p.pos].ln
    t.cl = p.toks[p.pos].cl
    t.typ = p.toks[p.pos].typ
    t.lit = p.toks[p.pos].lit.copy()
    t.raw = p.toks[p.pos].raw.copy()
    t.mk = p.toks[p.pos].mk.copy()
    t.emsg = p.toks[p.pos].emsg.copy()
}

; ps-peek-at：向前看 k 個 token（0 = 目前）的型別（越界視為 EOF）。
ps-peek-at = (p psst, k i64) (typ i64) {

    #{overflow=wrap}
    i = p.pos + k
    i >= p.toks.len() -> {
        typ = tok.EOF
        return
    }

    #{index-out=zero}
    typ = p.toks[i].typ
}

; ps-is-func：判斷【目前 pos（LPAREN）】起是否為 `(...) {` 形式（即
;   `name = ` 右側是 FunctionLiteral）。⚠️ 單看首個 LPAREN 不够：實測
;   `a = (x)` 被误判成函式定義 → 進入 ps-parse-block 後找不到 RBRACE 永轉。
;   從 LPAREN 掃到平衡的 RPAREN，再確認下一個非 trivia token 是 LBRACE。
ps-is-func = (p psst) (r i64) {
    r = 0
    depth = 0
    i = 0
    go = true
    (go) {
        t = ps-peek-at(p, i)
        t == tok.EOF -> go = false
        go -> {
            t == tok.LPAREN -> {

                #{overflow=wrap}
                depth = depth + 1
            }
            t == tok.RPAREN -> {

                #{overflow=wrap}
                depth = depth - 1
                depth == 0 -> {

                    ; 閉合瞭：往後找第一個非 trivia token
                    #{overflow=wrap}
                    k = i + 1
                    nt = ps-peek-at(p, k)
                    (nt == tok.NEWLINE) {

                        #{overflow=wrap}
                        k = k + 1
                        nt = ps-peek-at(p, k)
                    }
                    (nt == tok.COMMENT) {

                        #{overflow=wrap}
                        k = k + 1
                        nt = ps-peek-at(p, k)
                    }

                    ; 群組閉合後第一個非 trivia：`{` ⇒ 函式；`(` ⇒ 回傳元組（續掃）；其他 ⇒ 非函式
                    nt == tok.LBRACE -> {
                        r = 1
                        go = false
                    }

                    ; 回傳元組：`(...)` 後接 `(` ⇒ 不中斷（go 保持 true），續掃下一群組
                    nt == tok.LPAREN -> {}

                    ; 既非 `{` 亦非 `(`（含 EOF）⇒ 不是函式定義，停止（r 維持 0）
                    nt != tok.LBRACE && nt != tok.LPAREN -> go = false
                }
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
}

; ps-bump：消費目前 token 並前進（回傳 void）。
; ⚠️ 這裡**不能**寫 `_ = ps-peek-token(p)`「消費暫存值」：捨棄回傳的 tk
;    會觸發「釋放不存在的指標」（見檔頭「結構體回傳值的釋放陷阱」）。
;    bump 只需要前進 pos，不讀 token。
ps-bump = (p psst) {

    #{overflow=wrap}
    p.pos = p.pos + 1
}

; ps-skip-trivia：跳過 NEWLINE / COMMENT（詞法上不影響 AST 結構）
ps-skip-trivia = (p psst) {
    go = true
    (go) {
        t = ps-peek(p)
        {
            t == tok.NEWLINE -> ps-bump(p)

            t == tok.COMMENT -> ps-bump(p)

            -> go = false
        }
    }
}

; ps-cur-lit：複製目前 token 的 lit（字串欄位）回傳，供讀取註解文字。
;   .copy() 切斷與 toks 向量元素的共享（見檔頭釋放守則）。
ps-cur-lit = (p psst) (s str) {
    s = ''
    p.pos < p.toks.len() -> {

        #{index-out=zero}
        s = p.toks[p.pos].lit.copy()
    }
}

; ps-lit-at：向前看 k 個 token（0 = 目前）的 lit（字串）。
;   .copy() 切斷與 toks 向量元素的共享（見檔頭釋放守則）。
ps-lit-at = (p psst, k i64) (s str) {
    s = ''

    #{overflow=wrap}
    i = p.pos + k
    i < p.toks.len() -> {

        #{index-out=zero}
        s = p.toks[i].lit.copy()
    }
}

; ps-skip-trivia-doc：跳過 NEWLINE / COMMENT，同時完成「註解歸位」——
;   · 行前註解（其前已見換行，或無前兄弟 prevIdx==0）⇒ 取【首條】作為回傳 docId
;     （dump.go 只渲染群組第一條，故 docTaken 守衛只留一條）
;   · 行尾註解（緊接前一兄弟陳述的同一行、其前無換行）⇒ 掛到 prevIdx 的 Comment:
; 回傳 0 表示無 doc 群組。對齊 Go collectDocComments + attachInlineComment：
;   Doc 附著於【其後】那條陳述、行尾 Comment 附著於【其前】那條陳述。
; ⚠️ 換行偵測靠【保留在 token 串中的 NEWLINE token】（本解析器不預先丟棄換行）。
ps-skip-trivia-doc = (t ast, p psst, prevIdx i64) (docId i64) {
    docId = 0
    docTaken = 0
    cmtTaken = 0
    sawNL = 0
    go = true
    (go) {
        tt = ps-peek(p)
        {
            tt == tok.NEWLINE -> {
                sawNL = 1
                ps-bump(p)
            }

            tt == tok.COMMENT -> {
                isTrailing = sawNL == 0 && prevIdx > 0
                isTrailing -> {
                    cmtTaken == 0 -> {
                        ast.set-cmt(t, prevIdx, ast.put-str(t, ps-cur-lit(p)))
                        cmtTaken = 1
                    }
                }
                isTrailing == false -> {
                    docTaken == 0 -> {
                        docId = ast.put-str(t, ps-cur-lit(p))
                        docTaken = 1
                    }
                }
                ps-bump(p)
            }

            -> go = false
        }
    }
    docId
}

; ps-trail-region：向前掃描（不消費 token）——若跳過全部 NEWLINE/COMMENT 後首個
;   實 token 是 RBRACE 或 EOF，回 1，代表當前處於「尾註解區」：其後不會再有陳述，
;   因此緊接的 standalone 註解应歸本區塊/程式的 TrailingComments（對齊 Go stmt.go:2141
;   block.TrailingComments = collectDocComments()，其後无语句）。回 0 = 其後仍有陳述
;   （那些 standalone 註解是下一條陳述的 leading Doc，不在此處理）。
ps-trail-region = (p psst) (r i64) {
    r = 0
    k = 0
    go = true
    (go) {
        tt = ps-peek-at(p, k)
        {
            tt == tok.NEWLINE -> {

                #{overflow=wrap}
                k = k + 1
            }

            tt == tok.COMMENT -> {

                #{overflow=wrap}
                k = k + 1
            }

            tt == tok.RBRACE -> {
                r = 1
                go = false
            }

            tt == tok.EOF -> {
                r = 1
                go = false
            }

            -> go = false
        }
    }
}

; ps-collect-tail：消費「尾註解區」的 NEWLINE/COMMENT 直到 RBRACE/EOF。
;   · 緊接 prev 同一行、其前無換行的首條註解 → 掛 prev 的 inline Comment（對齊 Go 行尾註解）；
;   · 其餘 standalone 註解 → 其 str-id 依序收集進 trail（本區塊/程式的 TrailingComments 各條）。
;   ⚠️ 與 ps-skip-trivia-doc 同形（用旗標 sawNL/cmtTaken，非互斥補集重取），只在 ps-trail-region
;   回 1 時由呼叫端使用；對無尾註解的區塊 trail 空 → 後續 ps-attach-trailing 不建節點（零回歸）。
ps-collect-tail = (t ast, p psst, prev i64, trail []i64) {
    sawNL = 0
    cmtTaken = 0
    go = true
    (go) {
        tt = ps-peek(p)
        {
            tt == tok.NEWLINE -> {
                sawNL = 1
                ps-bump(p)
            }

            tt == tok.COMMENT -> {
                inline = sawNL == 0 && prev > 0 && cmtTaken == 0
                inline -> {
                    ast.set-cmt(t, prev, ast.put-str(t, ps-cur-lit(p)))
                    cmtTaken = 1
                }
                inline == false -> {
                    trail.push(ast.put-str(t, ps-cur-lit(p)))
                }
                sawNL = 0
                ps-bump(p)
            }

            -> go = false
        }
    }
}

; ps-attach-trailing：把 trail（註解文字 str-id 向量）落成區塊/程式節點的 TrailingComments。
;   對應 ast.no trailing-comments 渲染（OP-TRAILING）：節點需 ct0（aux 起點）+ ntrail（條數）。
;   子先於父原則下 aux 區段獨立於 kids，故於節點 add 之後再 aux-begin/aux-add/set-aux-counts。
;   trail 空 → 不建任何 aux、不設 ntrail（維持預設 -1 → dumper 跳過印出，零回歸）。
ps-attach-trailing = (t ast, idx i64, trail []i64) {
    trail.len() > 0 -> {
        base = ast.aux-begin(t, idx)
        base >= 0 -> {
            k = 0
            (k < trail.len()) {
                ast.aux-add(t, trail[k])

                #{overflow=wrap}
                k = k + 1
            }
        }
        ast.set-aux-counts(t, idx, trail.len(), -1, 0)
    }
}

; ps-expect：若目前 token 是 want 就消費它（容錯：不符也繼續）
ps-expect = (p psst, want i64) {
    ps-peek(p) == want -> ps-bump(p)

    -> {}
}

; ── 進入點 ──
; ps-parse：解析整份原始碼，回傳 Program 節點索引。
;
; ⚠️ 單一回傳值（i64）：arena `t` 與解析器 `p` 由呼叫端建立並作為【輸入參數】
;    傳入。單一回傳值的函式會【借用】結構體輸入參數（不會在函式內釋放），
;    與 ast_test.no 中反覆呼叫 `ast.add(t, …)` 同形——呼叫端在 ps-parse 返回
;    後仍能安全使用 `t`（例如 ast.dump(t, root)）。
;    （多回傳值含結構體 `(r ast, root i64)` 在 oracle 後端會被錯誤 lowering：
;     函式本體不執行、回傳 0，見本次除錯紀錄。）
;
; ⚠️ arena 建構順序（關乎正確性，不只是風格外）：`ast.add` 在呼叫當下把
;    kid0 固定為「當時 kids.len()」，而父節點自己【不】佔 kids 槽位。因此
;    必須【先解析完全部子節點（它們的子樹已依序追加），再 add 父節點，
;    最後依序 kid-add 子節點】——即本函式把 Program 留到最後才 add。
;    （若先 add 父再建子，子的子樹會插在父的 kid 範圍前面，dump 會把孫
;     節點錯置成父的直接子節點——實測 `42` 曾因此少印 ExpressionStatement。）
parse = (t ast, p psst) (root i64) {
    stmts []i64 = with-cap(4)
    trail []i64 = with-cap(4)
    prev = 0
    docId = 0
    ps-trail-region(p) == 1 -> ps-collect-tail(t, p, 0, trail)
    ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, 0)
    (ps-peek(p) != tok.EOF) {
        pos0 = p.pos
        s = ps-parse-stmt(t, p)
        s > 0 -> {
            docId != 0 -> ast.set-doc(t, s, docId)
            stmts.push(s)
            prev = s
        }

        ; ⚠️ 進度守則：未覆蓋的語法會回 idx=0 且不吃 token，無此守則時
        ;    迴圈永轉（實測：`noc ast src/std/char.no` busy-spin）。
        ;    對齊 oracle 的錯誤恢復屬於 M3/L3 的範疇；在此之前以
        ;    「強制前進一律終止」取代當機。
        p.pos == pos0 -> ps-bump(p)
        ps-trail-region(p) == 1 -> {
            ps-collect-tail(t, p, prev, trail)
            ; 尾註解區：其後僅剩 EOF，收集完即讓迴圈自然終止
        }
        ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, prev)
    }
    root = ast.add(t, asp.K_PROGRAM)
    j = 0
    (j < stmts.len()) {
        ast.kid-add(t, root, stmts[j])

        #{overflow=wrap}
        j = j + 1
    }

    ; Program 的 HDR 有 SCALAR warnings（pol=COUNT）→ 設為 '0' 即不印出
    ; ⚠️ warnings 計數：oracle 每 parse 一個 if/elif/else 就 saveWarning 一次
    ;   （src/parser/expr.go::parseIfExpression），Program.warnings 累加。
    ast.set-count(t, root, 0, stmts.len())
    ast.set-slot(t, root, 0, ast.put-str(t, p.warn.to-str()))
    ps-attach-trailing(t, root, trail)
    root
}

; ps-normalize-overflow：復刻 Go NormalizeOverflowMode（annotation.go）。
;   語料中 overflow 值幾乎恆為 `wrap`；此處認五個正規值，其餘回 ''（丢弃、不寫槽）。
ps-normalize-overflow = (s str) (r str) {
    r = ''
    {
        s == 'wrap' -> r = s

        s == 'clamp0' -> r = s

        s == 'min' -> r = s

        s == 'max' -> r = s

        s == 'saturate' -> r = s
    }
    r
}

; ps-parse-annotation 已【內聯】進 ps-parse-stmt 的前置註解迴圈（增量 V）：
;   原实装只回傳 overflow 並吞掉整段 `#{...}`，但 oracle 對「不可附著」的語句級註解
;   會保留独立 AnnotationStatement{entries: N} 節點，需在同段掃描中累計【去重頂層鍵名】數，
;   故改於 ps-parse-stmt 內聯完成（同時產出 ovf 與 keys）。ps-normalize-overflow 仍復用。

; ps-apply-overflow：把 overflow 模式寫到緊後陳述節點對應的純量槽。
;   只有 dump overflow 的節點型別才渲染（槽序依 spec 非 child-derived 純量順序）：
;     LetStatement=6 / ForStatement=2 / MultiAssignStatement=1 / FunctionDefinition=4。
;   ExpressionStatement/ReturnStatement 雖有 OverflowMode 欄位但 dump 不渲染 ⇒ 略過。
ps-apply-overflow = (t ast, idx i64, mode str) {
    idx > 0 -> {
        k = ast.kind-at(t, idx)
        sid = ast.put-str(t, mode)
        {
            k == asp.K_LET_STATEMENT -> ast.set-slot(t, idx, 6, sid)

            k == asp.K_FOR_STATEMENT -> ast.set-slot(t, idx, 2, sid)

            k == asp.K_MULTI_ASSIGN_STATEMENT -> ast.set-slot(t, idx, 1, sid)

            k == asp.K_FUNCTION_DEFINITION -> ast.set-slot(t, idx, 4, sid)
        }
    }
}

; ps-parse-use：`# path` 匯入陳述（對應 Go parseUseStatement、stmt.go:45）。
;   path 由可選前導 `/`（QUO）與以 `/`、`.` 分隔的 IDENT 段串接（joinPathParts）。
;   語料恆為純路徑（無 `.fn` / `as`）⇒ function/alias 恆空、as 恆 false。
;   UseStatement 槽：path=s0、function=s1（kv 恆渲染、置空字串）、alias=s2（同）、
;   as=s3（kvb policy=true、不設即省略）。
ps-parse-use = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 # (USE)
    path = ''
    ps-peek(p) == tok.QUO -> {
        path = path + '/'
        ps-bump(p)
    }
    (ps-peek(p) == tok.IDENT) {
        path = path + ps-cur-lit(p)
        ps-bump(p)

        ; 段間分隔符：`/` 或 `.`（github.com 類）——兩個獨立 standalone-if，至多一個觸發
        ps-peek(p) == tok.QUO -> {
            path = path + '/'
            ps-bump(p)
        }
        ps-peek(p) == tok.DOT -> {
            path = path + '.'
            ps-bump(p)
        }
    }
    idx = ast.add(t, asp.K_USE_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, path))
    ast.set-slot(t, idx, 1, ast.put-str(t, ''))
    ast.set-slot(t, idx, 2, ast.put-str(t, ''))
    idx
}

; ps-parse-stmt：解析一條陳述（頂層或區塊內通用）
ps-parse-stmt = (t ast, p psst) (idx i64) {
    idx = 0
    ps-skip-trivia(p)

    ; 前置語句級 `#{...}` 註解群組：連續消費全部 `#{...}`、去重累計【頂層鍵名】、提取 overflow 模式。
    ;   對應 Go parseAnnotationStatement（annotation.go:188–309）+ attachAnnotations。之後依「緊後陳述首 token」分流：
    ;     · 首 token ∈ {IDENT, IN, RARROW} ⇒【附著】到緊後陳述（Go 247 分支：回傳 parseStatement 結果、不產生独立節點；
    ;       overflow 由 ps-apply-overflow 寫入 Let/For/MultiAssign/Func 的純量欄）——落到下方 dispatch + 尾端 ovf 套用。
    ;     · 否則（DOT `.field=`、LPAREN、LBRACE… 不可附著形）⇒ 產生独立 `AnnotationStatement{entries: N}` 節點（N=去重鍵名數），
    ;       並【就此回傳】，緊後陳述留待下一輪 ps-parse-stmt（兩者在語句集合中為兄弟，對齊 dump.go:306）。
    ;   鍵名判定鏡像 Go parseAnnotationBody（annotation.go:990）：群組為扁平 `key [= value]` 逗號序列——鍵 IDENT 只出現在
    ;   `#{` 後或頂層 `,` 後（expect_key）；值內 ident（如 wrap）/ 括號（[ ] ( )）不計。去重鏡像 dedupeAnnotationEntries（同鍵名計一次）。
    ;   ⚠️ 連群組（空行分隔）合併後一起去重；keys 空（無註解）時整段跳過 ⇒ 對無 `#{...}` 檔案零回歸。
    ovf = ''
    keys []str = with-cap(4)
    (ps-peek(p) == tok.HASH_LBRACE) {
        ps-bump(p); 消費 #{（進入群組，depth=1）
        depth = 1
        expect_key = true
        (depth > 0) {
            tk = ps-peek-token(p)
            {
                tk.typ == tok.EOF -> depth = 0

                tk.typ == tok.HASH_LBRACE || tk.typ == tok.LBRACE || tk.typ == tok.LBRACKET || tk.typ == tok.LPAREN -> {

                    #{overflow=wrap}
                    depth = depth + 1
                    expect_key = false
                    ps-bump(p)
                }

                tk.typ == tok.RBRACE || tk.typ == tok.RBRACKET || tk.typ == tok.RPAREN -> {

                    #{overflow=wrap}
                    depth = depth - 1
                    ps-bump(p)
                }

                tk.typ == tok.IDENT && expect_key && depth == 1 -> {
                    kn = tk.lit
                    found = 0
                    z = 0
                    (z < keys.len()) {
                        keys[z] == kn -> found = 1

                        #{overflow=wrap}
                        z = z + 1
                    }
                    found == 0 -> keys.push(kn)
                    ps-bump(p); 消費鍵名
                    expect_key = false
                    ps-peek(p) == tok.ASSIGN -> {
                        ps-bump(p); 消費 =
                        vt = ps-peek-token(p)
                        kn == 'overflow' && (vt.typ == tok.IDENT || vt.typ == tok.STRING) -> ovf = ps-normalize-overflow(vt.lit)
                    }
                }

                tk.typ == tok.COMMA && depth == 1 -> {
                    expect_key = true
                    ps-bump(p)
                }

                ; 其他 token（值 ident/string/number、`...`、運算子、非鍵頂層 ident）：跳過
                -> ps-bump(p)
            }
        }
        ps-skip-trivia(p)
    }

    ; 有註解且緊後首 token 不可附著 ⇒ 產生独立 AnnotationStatement 節點、就此回傳（keys 空即跳過＝零回歸）
    keys.len() > 0 && ps-peek(p) != tok.IDENT && ps-peek(p) != tok.IN && ps-peek(p) != tok.RARROW -> {
        idx = ast.add(t, asp.K_ANNOTATION_STATEMENT)
        ast.set-slot(t, idx, 0, ast.put-str(t, keys.len().to-str()))
        return
    }
    tk = ps-peek-token(p)
    {
        tk.typ == tok.IF -> {
            inner = ps-parse-if(t, p)
            inner > 0 -> {
                idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
                ast.kid-add(t, idx, inner)
            }
        }

        ; `for`/`while` 关键字迴圈（无限 / 条件 / range），對應 Go parseForStatement 的 FOR 分支
        tk.typ == tok.FOR -> idx = ps-parse-for-kw(t, p)

        ; `break` / `continue`（可带同列标签），對應 Go parseBreak/ContinueStatement
        tk.typ == tok.BREAK -> idx = ps-parse-break-continue(t, p, 1)

        tk.typ == tok.CONTINUE -> idx = ps-parse-break-continue(t, p, 0)

        tk.typ == tok.RETURN -> {
            ps-bump(p); 消費 return
            idx = ast.add(t, asp.K_RETURN_STATEMENT)
            ast.kid-add(t, idx, 0); guarded CHILD=ReturnValue 缺席→以 0 占位（否則 pre-scan 會讀到後續節點的 kid、node_of 標籤錯位）
        }

        ; `# path` 匯入（tok.USE；`#` 非 `#{` 时詞法回 USE）——此前無臂→走 expr-stmt⇒ 把路徑拆成 `/` 除法運算式。
        tk.typ == tok.USE -> idx = ps-parse-use(t, p)

        ; `!! { }` 無限循環 / `! { }` 恆假循環（stmt.go:528-540 → parseBangLoop 2577）：
        ;   僅當 bang【緊接】LBRACE 才成立，否則退回運算式陳述（`!x` 取反）。
        tk.typ == tok.BANG_BANG && ps-peek-at(p, 1) == tok.LBRACE -> idx = ps-parse-bang-loop(t, p, 1)

        tk.typ == tok.NOT && ps-peek-at(p, 1) == tok.LBRACE -> idx = ps-parse-bang-loop(t, p, 0)

        ; `(cond) { }` 前置條件循環（stmt.go:381 isCondLoopPrefix → parseCondLoopPrefix 2686）：
        ;   僅當平衡 `)` 後【立即】是 `{` 且括號內容非參數列才成立，否則退回 `(expr)` 運算式陳述。
        tk.typ == tok.LPAREN && ps-is-cond-loop-prefix(p) == 1 -> idx = ps-parse-cond-loop(t, p)

        tk.typ == tok.IDENT -> {
            name = tk.lit
            nxt_typ = ps-peek-at(p, 1)
            nxt2_typ = ps-peek-at(p, 2)

            ; ⚠️ 用 `handled` 旗標而非裸 `-> ...` 預設臂：實測同块多臂時，尾
            ;   臂 `-> idx = expr` 會被當作**尾隨無條件陳述**執行，覆寫前面
            ;   ASSIGN 臂已經算好的 idx（表現為 `x = 1` dump 出 `Program{}`）。
            ;   原 `-> {}` 不傷是因為它是 no-op。
            handled = 0
            nxt_typ == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT
                ps-bump(p); 消費 ASSIGN
                a2 = ps-peek-token(p)
                a2.typ == tok.LPAREN -> {

                    ; `= (...) {` 才是函式定義；`= (expr)` 是括號運算式（見 ps-is-func）
                    ps-is-func(p) == 1 -> idx = ps-parse-func(t, p, name)

                    -> idx = ps-parse-let(t, p, name)
                }

                -> idx = ps-parse-let(t, p, name)
                handled = 1
            }

            ; 明示型別標註：`name TYPE = expr`（第一片只認 NamedType 形式的標註）
            nxt_typ == tok.IDENT && nxt2_typ == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT

                ; 先取型別名（仍在 IDENT 之后的位置），然后手动前进到 ASSIGN 之后
                tt = ps-peek-token(p)
                tn = tt.lit
                ps-bump(p); 消費型別名
                ps-bump(p); 消費 ASSIGN
                val = ps-parse-expr(t, p)
                typ = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, typ, 0, ast.put-str(t, tn))

                ; 明示標註：不設 inferred（slot1 留 0 → dump 不印 inferred: true）
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, typ)
                ast.kid-add(t, idx, val)
                handled = 1
            }

            ; 定長陣列標註：`name [N]T = [e1, …, eN]`（本片只認 `[ INT ] IDENT ASSIGN` 單行形）
            ;   偏移：+0 IDENT name / +1 LBRACKET / +2 INT / +3 RBRACKET / +4 IDENT elem / +5 ASSIGN
            ;   +2 必須是 INT（尺寸字面量）；若是 IDENT ⇒ 是 `[K]V` map 標註（見下臂）
            nxt_typ == tok.LBRACKET && ps-peek-at(p, 2) == tok.INT && ps-peek-at(p, 3) == tok.RBRACKET && ps-peek-at(p, 5) == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                sz = ps-parse-expr(t, p); 尺寸運算式（IntegerLiteral）
                ps-expect(p, tok.RBRACKET)
                et = ps-peek-token(p)
                en = et.lit
                ps-bump(p); 消費 elem 型別名
                ps-expect(p, tok.ASSIGN)

                ; RHS 為 [..]：在陣列上下文直接建 ArrayLiteral（復刻 Go stmt.go:1210-1218 的轉換）
                al = ps-parse-arr-lit(t, p, sz)

                ; 子先於父：elem NamedType → ArrayType（含 size、elem 兩 kid）→ LetStatement
                ntyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ntyp, 0, ast.put-str(t, en))
                at = ast.add(t, asp.K_ARRAY_TYPE)
                ast.set-slot(t, at, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
                ast.kid-add(t, at, sz)
                ast.kid-add(t, at, ntyp)
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, at)
                ast.kid-add(t, idx, al)
                handled = 1
            }

            ; 推論元素型別的定長陣列：`name [N] = [e1, …, eN]`（`]` 後直接 `=`、無元素型別名）
            ;   偏移：+0 IDENT name / +1 LBRACKET / +2 INT / +3 RBRACKET / +4 ASSIGN / +5 LBRACKET
            ;   與明示臂（+4 IDENT elem / +5 ASSIGN）互斥：此臂要求 +4==ASSIGN 且 +5==LBRACKET。
            ;   此前無臂 → `name [N]` 被誤解析為 IndexExpression、`= [..]` 成 AssignExpression。
            ;   元素型別恆為 i64（Go stmt.go:957：省略元素型別時補 NamedType{i64, inferred}，
            ;   【不】依首元素推論）；ArrayType.IsInferred=false（formatter 必須印回 [N]）。
            ;   僅 Size>0 才把 RHS 轉 ArrayLiteral（Go stmt.go:1210）；Size==0 保留 SliceLiteral。
            nxt_typ == tok.LBRACKET && ps-peek-at(p, 2) == tok.INT && ps-peek-at(p, 3) == tok.RBRACKET && ps-peek-at(p, 4) == tok.ASSIGN && ps-peek-at(p, 5) == tok.LBRACKET -> {
                sz_lit = ps-lit-at(p, 2)
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                sz = ps-parse-expr(t, p); 尺寸運算式（IntegerLiteral）
                ps-expect(p, tok.RBRACKET)
                ps-expect(p, tok.ASSIGN)

                ; 子先於父：elem NamedType(i64, inferred) → ArrayType（含 size、elem 兩 kid）
                ntyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ntyp, 0, ast.put-str(t, 'i64'))
                ast.set-slot(t, ntyp, 1, ast.put-str(t, 'true')); i64 元素 → inferred: true
                at = ast.add(t, asp.K_ARRAY_TYPE)
                ast.set-slot(t, at, 0, ast.put-str(t, 'false')); 明示 [N] → 不 inferred
                ast.kid-add(t, at, sz)
                ast.kid-add(t, at, ntyp)

                ; Size>0：RHS [..] 直接建 ArrayLiteral；Size==0：保留 SliceLiteral（走 primary expr）
                val = 0
                sz_lit != '0' -> val = ps-parse-arr-lit(t, p, sz)
                sz_lit == '0' -> {
                    ps-skip-trivia(p)
                    val = ps-parse-expr(t, p)
                }
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, at)
                ast.kid-add(t, idx, val)
                handled = 1
            }

            ; Map 標註：`name [K]V = { k1: v1, … }`（單行形）
            ;   偏移：+0 IDENT name / +1 LBRACKET / +2 IDENT keyType / +3 RBRACKET / +4 IDENT valType / +5 ASSIGN / +6 LBRACE
            ;   復刻 Go parseMapLiteral（只在有 MapType 標註時走此路）
            nxt_typ == tok.LBRACKET && ps-peek-at(p, 2) == tok.IDENT && ps-peek-at(p, 3) == tok.RBRACKET && ps-peek-at(p, 4) == tok.IDENT && ps-peek-at(p, 5) == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                kt = ps-peek-token(p)
                kn = kt.lit
                ps-bump(p); 消費 key 型別名
                ps-expect(p, tok.RBRACKET)
                vt = ps-peek-token(p)
                vn = vt.lit
                ps-bump(p); 消費 value 型別名
                ps-expect(p, tok.ASSIGN)

                ; 先建 key/value NamedType → MapType（子先於父），再作為共用節點傳给 map 字面量
                ktyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ktyp, 0, ast.put-str(t, kn))
                vtyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, vtyp, 0, ast.put-str(t, vn))
                mt = ast.add(t, asp.K_MAP_TYPE)
                ast.set-slot(t, mt, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
                ast.kid-add(t, mt, ktyp)
                ast.kid-add(t, mt, vtyp)
                ml = ps-parse-map-lit(t, p, mt)
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, mt)
                ast.kid-add(t, idx, ml)
                handled = 1
            }

            ; 切片型別標註：`name []T = [e1, …]`（單行形，T 為單一 IDENT）
            ;   偏移：+0 IDENT name / +1 LBRACKET / +2 RBRACKET（空括）/ +3 IDENT elem / +4 ASSIGN
            ;   舆 `[N]T`（+2 INT）/`[K]V`（+2 IDENT）互斥：此臂要求 +2 為 RBRACKET
            nxt_typ == tok.LBRACKET && ps-peek-at(p, 2) == tok.RBRACKET && ps-peek-at(p, 3) == tok.IDENT && ps-peek-at(p, 4) == tok.ASSIGN -> {
                ps-bump(p); 消費 IDENT name
                ps-bump(p); 消費 LBRACKET
                ps-bump(p); 消費 RBRACKET
                et = ps-peek-token(p)
                en = et.lit
                ps-bump(p); 消費 elem 型別名
                ps-expect(p, tok.ASSIGN)

                ; RHS `[..]` 經 primary 自然建 SliceLiteral（含空 `[]`）
                ps-skip-trivia(p)
                val = ps-parse-expr(t, p)
                ntyp = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, ntyp, 0, ast.put-str(t, en))
                styp = ast.add(t, asp.K_SLICE_TYPE)
                ast.set-slot(t, styp, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
                ast.kid-add(t, styp, ntyp)
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, styp)
                ast.kid-add(t, idx, val)
                handled = 1
            }

            ; Nullable 型別標註：`name ?T = expr`（? 後接命名/切片/巢狀可為空型別）⇒ LetStatement{type: NullableType, value}。
            ;   分派守衛 `nxt_typ == QUESTION`：`IDENT ?` 於陳述層只可能是可為空標註（傳導 `?=` 是 QUESTION_ASSIGN 另一 token）。
            nxt_typ == tok.QUESTION -> {
                ps-bump(p); 消費 IDENT name
                nltyp = ps-parse-type(t, p); 消費 ? 與內層型別
                ps-expect(p, tok.ASSIGN)
                ps-skip-trivia(p)
                nlval = ps-parse-expr(t, p)
                idx = ast.add(t, asp.K_LET_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, name))
                ast.kid-add(t, idx, nltyp)
                ast.kid-add(t, idx, nlval)
                handled = 1
            }

            ; 多重指派：`a, b, … = expr`（RHS 常為多返回值呼叫）⇒ MultiAssignStatement{targets: N}。
            ; kid 序依 dump 源碼序：先 targets（KIDS、count slot0=N）、後 value（guarded CHILD）。
            ; ⚠️ slot0=targets 顯示數（kvc NON-ZERO，未設會印空 `targets: `）；overflow slot1 留''。
            ; ⚠️ 父後建：先解析完所有 target/value 子樹，再 add 父、依序 kid-add（共享 kids 游標）。
            nxt_typ == tok.COMMA -> {
                maTargets []i64 = with-cap(4)
                maT0 = ps-parse-expr-prec(t, p, 0)
                maT0 > 0 -> maTargets.push(maT0)
                (ps-peek(p) == tok.COMMA) {
                    ps-bump(p); 消費 COMMA
                    ps-skip-trivia(p)
                    maTn = ps-parse-expr-prec(t, p, 0)
                    maTn > 0 -> maTargets.push(maTn)
                }
                ps-skip-trivia(p)
                ps-expect(p, tok.ASSIGN)
                maVal = ps-parse-expr(t, p)
                idx = ast.add(t, asp.K_MULTI_ASSIGN_STATEMENT)
                ast.set-slot(t, idx, 0, ast.put-str(t, maTargets.len().to-str()))
                ast.set-count(t, idx, 0, maTargets.len())
                maK = 0
                (maK < maTargets.len()) {
                    ast.kid-add(t, idx, maTargets[maK])

                    #{overflow=wrap}
                    maK = maK + 1
                }
                ast.kid-add(t, idx, maVal); guarded CHILD=Value（缺席以 0 佔位）
                handled = 1
            }

            ; 其他 IDENT 開頭的句法（呼叫語、運算子等）一律走運算式陳述，
            ;   不先消費 IDENT（否则會把 `f(1,2)` 拆成兩個 token）。
            ; 兵列迭代（bare range-for）：`var <- range-or-array [:] { body }`（不使用 `for` 關鍵字）。
            ;   分派守衛 `nxt_typ == ARROW`：`IDENT <-` 於述層即迭代表達式（對應 Go parseForStatement bare 分支）。
            nxt_typ == tok.ARROW -> {
                idx = ps-parse-for(t, p, name)
                handled = 1
            }

            ; 方法定義：`recvType.method = (params) [ (results) ] { body }`（僅函式形）
            ;   對應 Go parseMethodDefinition（stmt.go:292–301）。偏移：+0 recv IDENT / +1 DOT /
            ;   +2 method IDENT / +3 ASSIGN / +4 LPAREN。`obj.field = value` 因 +4 非 LPAREN、
            ;   或 `= (expr)` 非 `(...) {`（ps-is-func==0）而回退（不誤吞，退回運算式陳述）。
            nxt_typ == tok.DOT && nxt2_typ == tok.IDENT && ps-peek-at(p, 3) == tok.ASSIGN && ps-peek-at(p, 4) == tok.LPAREN -> {
                recvType = name
                methodName = ps-lit-at(p, 2)
                fullName = recvType + '.' + methodName
                savePos = p.pos
                ps-bump(p); 消費 recv IDENT
                ps-bump(p); 消費 DOT
                ps-bump(p); 消費 method IDENT
                ps-bump(p); 消費 ASSIGN
                isf = ps-is-func(p)
                isf == 1 -> {
                    idx = ps-parse-method-func(t, p, fullName, recvType)
                    handled = 1
                }
                isf == 0 -> p.pos = savePos
            }

            ; 結構體定義：`name { field TYPE ... }`（陳述位置，peek==LBRACE 且分類器認可）
            ;   對應 Go stmt.go:277 classifyBlock()==blockStruct。僅在 ps-is-struct-def 回 1 時走此路；
            ;   枚舉/介面/實作清單/限定型別等一律回退原運算式陳述路徑（零回歸）。
            nxt_typ == tok.LBRACE && ps-is-struct-def(p) == 1 -> {
                idx = ps-parse-struct-def(t, p, name)
                handled = 1
            }

            ; 複合型明示宣告（限定名/巢狀）：`name TYPE [= value]`，TYPE 為各特化含值臂未覆蓋的
            ;   限定 NamedType（`a.b`）/巢狀 SliceType・ArrayType（`[][]T`、`[N][]T`）。上方各特化臂
            ;   皆要求特定偏移的 `=`，此處 handled==0 表示都未命中⇒可能為複合型宣告或索引運算式；
            ;   ps-parse-typedecl 只在【真宣告】(型別後為 `=` 或陳述邊界)回 >0，其餘還原交由下方 expr-stmt。
            ;   守衛限 nxt_typ∈{IDENT,LBRACKET}（QUESTION 由上方可為空臂；COMMA/ARROW/DOT/LBRACE 非型別）。
            handled == 0 && (nxt_typ == tok.LBRACKET || nxt_typ == tok.IDENT) -> {
                td = ps-parse-typedecl(t, p, name)
                td > 0 -> {
                    idx = td
                    handled = 1
                }
            }
            handled == 0 -> idx = ps-parse-expr-stmt(t, p)
        }

        -> idx = ps-parse-expr-stmt(t, p)
    }
    ovf != '' -> ps-apply-overflow(t, idx, ovf)
    idx
}

; ps-parse-expr-stmt：運算式陳述 `42`，並復刻 Go parseExpressionStatement 的
;   **獨立 if-then desugar**（`cond -> body` / wildcard `-> body`，無外層 `{ }`）。
;   Go 在陳述層看到 `expr` 後紧跟 `->` 就把整條包成 IfExpression{cond,inline-body,alt}；
;   行首即為 `->` 時 cond 是 wildcard 標記 IntegerLiteral{value:1}（ps-mk-true，無 raw）。
;   ⚠️ 檢查 `->` 用【活】ps-peek（不跳 trivia）——對齊 Go 只看 currentToken==RARROW，
;     `a \n -> b`（arrow 換行）不構成獨立 if，`-> b` 之後另起為 wildcard 陳述。
ps-parse-expr-stmt = (t ast, p psst) (idx i64) {
    idx = 0

    ; (A) wildcard 獨立 if：行首 `-> body`
    ps-peek(p) == tok.RARROW -> {
        cond = ps-mk-true(t)
        ie = ps-mk-standalone-if(t, p, cond)
        idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
        ast.kid-add(t, idx, ie)
        return
    }
    e = ps-parse-expr(t, p)
    e > 0 -> {

        ; (B) `cond -> body`：運算式 e 之後同位即 `->` ⇒ 獨立 if-then
        ;   ⚠️ Go parseExpressionStatement 回的是 ExpressionStatement{IfExpression}——
        ;     standalone IfExpression 需包一層 ExpressionStatement 作為陳述。
        ps-peek(p) == tok.RARROW -> {
            ie = ps-mk-standalone-if(t, p, e)
            idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
            ast.kid-add(t, idx, ie)
            return
        }
        idx = ast.add(t, asp.K_EXPRESSION_STATEMENT)
        ast.kid-add(t, idx, e)
    }
    idx
}

; ps-parse-expr：解析一個運算式（預設最低優先級）
ps-parse-expr = (t ast, p psst) (idx i64) {
    idx = ps-parse-expr-prec(t, p, 0)
}

; ps-op-prec：中綴 token 型別 → 優先級（照抄 src/parser/expr.go 的 precedences map）。
;   LOWEST=0 / COMMA=1 / CONDITIONAL=2 / LOGICAL_OR=3 / LOGICAL_AND=4 /
;   EQUALS=5 / LESSGREATER=6 / SUM=7 / PRODUCT=8 / PREFIX=9 / CALL=10。
;   回 0 = 不是中綴運算子（含 COMMA/QUESTION/AS/LPAREN──它倆在 Go 裡進這張表
;   但不在 infixOperators 集合，這裡一視同仁不作為二元運算子處理）。
; ⚠️ Go 表的 quirks 必須復刻：SHL/SHR/AND 是 PRODUCT(8)；OR/XOR 是 SUM(7)。
ps-op-prec = (typ i64) (r i64) {
    r = 0
    {
        typ == tok.LOR -> r = 3

        typ == tok.LAND -> r = 4

        typ == tok.EQUALS -> r = 5

        typ == tok.NOT_EQUALS -> r = 5

        typ == tok.LESS -> r = 6

        typ == tok.LESS_EQUALS -> r = 6

        typ == tok.GREATER -> r = 6

        typ == tok.GREATER_EQUALS -> r = 6

        typ == tok.OR -> r = 7

        typ == tok.XOR -> r = 7

        typ == tok.ADD -> r = 7

        typ == tok.SUB -> r = 7

        typ == tok.SHL -> r = 8

        typ == tok.SHR -> r = 8

        typ == tok.AND -> r = 8

        typ == tok.MUL -> r = 8

        typ == tok.QUO -> r = 8

        typ == tok.MOD -> r = 8

        -> {
        }
    }
}

; ps-int-lit-value：復刻 Go parseIntegerLiteral 的 value 計算（expr.go:652-688）。
;   規則：`0x/0X` 前綴⇒ base16，否則 base10（Go 用 base=0 自動偵測僅限 0x 形）。
;   折疊低 64 位並套 overflow=wrap ⇒ 自動得 int64(uval) 的兩倍補數語意（如 2^64-1⇒-1）；
;   若數值超出 u64（i128/u128 範圍）⇒ value=0（Go 走 isBareIntToken 分支保留 Raw 文字）。
;   僅回傳十進位字串（對齊 dumper 的 `%d`）；Raw 仍由呼叫端直接取 token 文字。
ps-int-lit-value = (raw str) (out str) {
    len = raw.len-bytes()
    len == 0 -> {
        out = '0'
        return
    }

    ; 偵測 base 與其實位元起始（跳過 `0x`/`0X` 前綴）
    start = 0
    base = 10
    len > 2 && raw.byte(0) == 48 && (raw.byte(1) == 120 || raw.byte(1) == 88) -> {
        base = 16
        start = 2
    }

    ; 跳過前導 0，定位有效首位（全 0 ⇒ s=len ⇒ sig=0 ⇒ 折疊得 0）
    s = start

    #{overflow=wrap}
    (s < len && raw.byte(s) == 48) {
        s = s + 1
    }

    #{overflow=wrap}
    sig = len - s

    ; 是否超出 u64：hex 只要有效位 >16 即超（16 個 F 恰為 2^64-1）；
    ;   decimal 有效位 >20 即超，==20 需與 '18446744073709551615' 逐位比較。
    exceeds = 0
    base == 16 -> {
        sig > 16 -> exceeds = 1
    }

    #{overflow=wrap}
    base == 10 -> {
        sig > 20 -> exceeds = 1
        sig == 20 -> {
            maxd = '18446744073709551615'
            i = 0
            cmp = 0
            (i < 20 && cmp == 0) {
                d = raw.byte(s + i)
                m = maxd.byte(i)
                d > m -> cmp = 1
                d < m -> cmp = -1
                i = i + 1
            }
            cmp == 1 -> exceeds = 1
        }
    }
    exceeds == 1 -> {
        out = '0'
        return
    }

    ; 折疊低 64 位（wrap ⇒ 自動得 int64(uval) 兩倍補數）
    val = 0
    j = s

    #{overflow=wrap}
    (j < len) {
        c = raw.byte(j)
        dv = 0
        c >= 48 && c <= 57 -> dv = c - 48
        base == 16 -> {
            c >= 97 && c <= 102 -> dv = c - 97 + 10
            c >= 65 && c <= 70 -> dv = c - 65 + 10
        }
        val = val * base + dv
        j = j + 1
    }
    out = val.to-str()
}

; ps-parse-expr-prec：優先級爬升解析（對應 Go parseExpression(precedence)。
;   左結合：只吞「優先級**嚴格大於** prec」的運算子（Go 的迴圈條件
;   `currentPrecedence() > precedence`）。遞迴右運算元時傳入**運算子自身**
;   的優先級（Go parseInfixExpression 的 `parseExpression(precedence)`）。
ps-parse-expr-prec = (t ast, p psst, prec i64) (idx i64) {

    ; 運算式開頭跳過 trivia（Go 只跳 NEWLINE；本實作連 COMMENT 一齊跳，
    ; 與 Go 的差異僅在「運算子後紧跟行內註解」的罕見排版，L2 差分可偵測）
    ps-skip-trivia(p)
    idx = 0
    tk = ps-peek-token(p)
    {
        tk.typ == tok.INT -> {

            ; value：解析成 i64 再轉十進位字串（與 Go 的 %v 對齊）
            ; raw：原始碼文字（直接解析的字串字面量不設 Raw，見 §5.3.2）
            v = ps-int-lit-value(tk.lit)
            idx = ast.add(t, asp.K_INTEGER_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, v))
            ast.set-slot(t, idx, 1, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.FLOAT -> {

            ; value = ParseFloat 後的 %v 呈現（'1.0'⇒1、'1.50'⇒1.5）；raw = 原 token 文字
            v = tk.lit.to-f64().to-str()
            idx = ast.add(t, asp.K_FLOAT_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, v))
            ast.set-slot(t, idx, 1, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.STRING -> {
            idx = ast.add(t, asp.K_STRING_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))

            ; raw 留 0（直接解析 → 不印 raw）
            ps-bump(p)
        }

        tk.typ == tok.CHAR -> {

            ; `"a"` ⇒ CharLiteral{value: a}（Nolang 雙引號=字元）；raw 留 0 → kvs 不印
            idx = ast.add(t, asp.K_CHAR_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.TRUE -> {
            idx = ast.add(t, asp.K_BOOLEAN_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'true'))
            ps-bump(p)
        }

        tk.typ == tok.FALSE -> {
            idx = ast.add(t, asp.K_BOOLEAN_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false'))
            ps-bump(p)
        }

        tk.typ == tok.NIL -> {
            idx = ast.add(t, asp.K_NIL_LITERAL)
            ps-bump(p)
        }

        tk.typ == tok.IDENT -> {
            idx = ast.add(t, asp.K_IDENTIFIER)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            ps-bump(p)
        }

        tk.typ == tok.LPAREN -> {

            ; (expr) → GroupedExpression{ expr }（dump 無標頭欄位，僅一個子節點）
            ps-bump(p)
            inner = ps-parse-expr-prec(t, p, 0)
            ps-skip-trivia(p)
            ps-expect(p, tok.RPAREN)
            idx = ast.add(t, asp.K_GROUPED_EXPRESSION)
            inner > 0 -> ast.kid-add(t, idx, inner)
        }

        tk.typ == tok.SUB -> {

            ; 前綴負號：不折進字面量（Oracle：-3 ⇒ PrefixExpression{-} / IntegerLiteral{3, raw:3}）
            ps-bump(p)
            right = ps-parse-expr-prec(t, p, 9); PREFIX 優先級
            idx = ast.add(t, asp.K_PREFIX_EXPRESSION)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            right > 0 -> ast.kid-add(t, idx, right)
        }

        tk.typ == tok.NOT -> {
            ps-bump(p)
            right = ps-parse-expr-prec(t, p, 9); PREFIX 優先級
            idx = ast.add(t, asp.K_PREFIX_EXPRESSION)
            ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
            right > 0 -> ast.kid-add(t, idx, right)
        }

        ; 無色 async 前綴運算子（Go expr.go:305–357）：`run e` → RunExpression{Call:e}、
        ;   `co e` → CoExpression{Call:e}、`awy e` → AwaitExpression{Right:e}（子先於父：先 parse 內層再 add 父）。
        ;   ⚠️ `run`/`co` 若緊接 `.`（peek-at(1)==DOT）【不是】async 關鍵字，而是模組名（`run.list(...)`）
        ;      ⇒ 建普通 Identifier{lit}、停在 DOT 交給後綴 DOT 迴圈（Go 同口徑）；`awy` 無此歧義。
        ;   ⚠️ 用預先算好的 `dotAfter` 旗標（非互斥條件）防 match 非排他：兩臂各重取 ps-peek-at 會因首臂消費 token 而誤觸。
        tk.typ == tok.RUN -> {
            dotAfter = ps-peek-at(p, 1) == tok.DOT
            dotAfter == 1 -> {
                idx = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
                ps-bump(p); 消費 run（停在 DOT）
            }
            dotAfter == 0 -> {
                ps-bump(p); 消費 run
                child = ps-parse-expr-prec(t, p, 0); 內層呼叫運算式（LOWEST）
                idx = ast.add(t, asp.K_RUN_EXPRESSION)
                child > 0 -> ast.kid-add(t, idx, child); guarded CHILD=Call
            }
        }

        tk.typ == tok.CO -> {
            dotAfter = ps-peek-at(p, 1) == tok.DOT
            dotAfter == 1 -> {
                idx = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, idx, 0, ast.put-str(t, tk.lit))
                ps-bump(p); 消費 co（停在 DOT）
            }
            dotAfter == 0 -> {
                ps-bump(p); 消費 co
                child = ps-parse-expr-prec(t, p, 0); 內層呼叫運算式（LOWEST）
                idx = ast.add(t, asp.K_CO_EXPRESSION)
                child > 0 -> ast.kid-add(t, idx, child); guarded CHILD=Call
            }
        }

        tk.typ == tok.AWY -> {
            ps-bump(p); 消費 awy
            child = ps-parse-expr-prec(t, p, 0); 內層運算式（LOWEST）
            idx = ast.add(t, asp.K_AWAIT_EXPRESSION)
            child > 0 -> ast.kid-add(t, idx, child); guarded CHILD=Right
        }

        tk.typ == tok.LBRACKET -> {

            ; [e1, e2, …] → SliceLiteral{elements: N}
            ; 規則源於 Go parseSliceLiteral：跳 LBRACKET、跳 NEWLINE、空 [] 直接回；
            ; 否則逗號分隔解析運算式直到 RBRACKET。
            ps-bump(p)
            els []i64 = with-cap(4)
            ps-skip-trivia(p)
            {
                ps-peek(p) == tok.RBRACKET -> {
                    ps-bump(p)
                }

                -> {
                    (ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.EOF) {
                        pos0 = p.pos
                        e = ps-parse-expr-prec(t, p, 0)
                        e > 0 -> els.push(e)
                        ps-skip-trivia(p)

                        ; ⚠️ 展開多行：`;` 是行註解，單行寫法會吃掉閉合 `}`
                        ps-peek(p) == tok.COMMA -> {
                            ps-bump(p)
                            ps-skip-trivia(p)
                        }
                        p.pos == pos0 -> ps-bump(p)
                    }
                    ps-expect(p, tok.RBRACKET)
                }
            }
            idx = ast.add(t, asp.K_SLICE_LITERAL)
            ast.set-slot(t, idx, 0, ast.put-str(t, els.len().to-str()))
            ast.set-count(t, idx, 0, els.len())
            m = 0
            (m < els.len()) {
                ast.kid-add(t, idx, els[m])

                #{overflow=wrap}
                m = m + 1
            }
        }

        tk.typ == tok.DOT -> {
            ps-bump(p); 消費 DOT
            pn = ps-peek-token(p)
            pn.typ == tok.IDENT -> {

                ; .property → 先建 self Identifier（子）再建 DotExpression（父）：子先於父
                selfid = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, selfid, 0, ast.put-str(t, 'self'))
                dot = ast.add(t, asp.K_DOT_EXPRESSION)
                ast.set-slot(t, dot, 0, ast.put-str(t, pn.lit))
                ast.kid-add(t, dot, selfid)
                idx = dot
                ps-bump(p); 消費 property IDENT
            }

            ; 裸 `.`（無緊接 IDENT）→ self
            pn.typ != tok.IDENT -> {
                idx = ast.add(t, asp.K_IDENTIFIER)
                ast.set-slot(t, idx, 0, ast.put-str(t, 'self'))
            }
        }

        -> {
        }
    }

    ; ---------- 後綴迴圈：呼叫 `f(...)` / 成員 `a.b` ----------
    ; Go 在 parseExpression 的主循環中將 LPAREN 歸為 CALL(10)
    ; 優先級最高 ⇒ 只要能看见就必須绑定（outer prec 永远 < 10）。
    ; DOT 不在 precedences 表中，Go 在链式呼叫/成员访问中直接处理
    ; ⇒ 這裡一律绑定，不比較 prec。
    pgo = true
    (pgo) {
        nt = ps-peek(p)

        ; ⚠️ 用 `handled` 旗標而非裸 `-> { pgo = false }` 預設臂：實測在 `(pgo)` 迴圈
        ;   內的多臂 match，尾隨預設臂與其他臂的**跨臂接連迭代**會誤編（新增第三個
        ;   區塊臂後 DOT→LPAREN / LPAREN→LBRACKET / LBRACKET→LBRACKET 各有其一會斷）。
        ;   `handled` 把終止條件變成**顯式陳述**，不依賴 match 落 semantics。
        handled = 0
        nt == tok.LPAREN -> {

            ; 消耗 LPAREN，依逗號分隔解析实参，直到 RPAREN
            ps-bump(p)
            args []i64 = with-cap(4)
            ps-skip-trivia(p)
            (ps-peek(p) != tok.RPAREN) {
                pos0 = p.pos
                a = ps-parse-expr-prec(t, p, 0)
                a > 0 -> args.push(a)
                ps-skip-trivia(p)
                ps-peek(p) == tok.COMMA -> {
                    ps-bump(p)
                    ps-skip-trivia(p)
                }

                ; 防呆：未消耗任何 token 则前进一步避免永转
                p.pos == pos0 -> ps-bump(p)
            }
            ps-expect(p, tok.RPAREN)

            ; arena 順序：Function (idx) 与 args 子树已完成 → add 父后依序 kid-add
            call = ast.add(t, asp.K_CALL_EXPRESSION)

            ; slot 0 = "args" 纯量的预渲染（kvc=NON-ZERO 政策：0 不印）
            ast.set-slot(t, call, 0, ast.put-str(t, args.len().to-str()))

            ; count slot 0 = KIDS 迭代次数（Arguments 切片长度）
            ast.set-count(t, call, 0, args.len())
            ast.kid-add(t, call, idx)
            k = 0
            (k < args.len()) {
                ast.kid-add(t, call, args[k])

                #{overflow=wrap}
                k = k + 1
            }
            idx = call
            handled = 1
        }
        nt == tok.DOT -> {
            ps-bump(p)
            ps-skip-trivia(p)
            pn = ps-peek-token(p)
            pname = pn.lit
            ps-expect(p, tok.IDENT)

            ; DotExpression dump 只一个 CHILD(Receiver)；property 是字串槽 0
            dot = ast.add(t, asp.K_DOT_EXPRESSION)
            ast.set-slot(t, dot, 0, ast.put-str(t, pname))
            ast.kid-add(t, dot, idx)
            idx = dot
            handled = 1
        }
        nt == tok.LBRACKET -> {

            ; `left[...]` ⇒ 純索引 `a[i]` 走 IndexExpression；含 `..` 的範圍走 SliceExpression{Range}。
            ; 對應 Go parseSliceExpression：LOWEST 優先級、leftInc=true（開 `[`）、右閉 `]`⇒rightInc=true。
            ; ⚠️ hasStart 先存快照：兩個臂的條件必須互斥且不随位置变化重评，否则 A 臂解析后 B 臂会误跑。
            ps-bump(p)
            st = 0
            en = 0
            isRange = 0
            hasStart = ps-peek(p) != tok.ELLIPSIS
            hasStart == 0 -> {

                ; [..end] / [..]：無 start
                ps-bump(p)
                isRange = 1
                ps-peek(p) != tok.RBRACKET -> en = ps-parse-expr-prec(t, p, 0)
            }
            hasStart == 1 -> {

                ; [expr..] / [expr]：先解 start（或索引）
                st = ps-parse-expr-prec(t, p, 0)
                ps-peek(p) == tok.ELLIPSIS -> {
                    ps-bump(p)
                    isRange = 1
                    ps-peek(p) != tok.RBRACKET -> en = ps-parse-expr-prec(t, p, 0)
                }
            }
            ps-skip-trivia(p)

            ; 閉合可能是 `]`（rightInc=true）或 `)`（rightInc=false）——Go 兩者皆接受
            cl = ps-peek(p)
            ri = 'false'
            cl == tok.RBRACKET -> ri = 'true'
            ps-bump(p); 消費閉合 `]` 或 `)`

            ; 組節點：Range 兩 kid 固定為 [Start, End]，缺席者以 0 占位（node-string(0)='<nil>'）
            isRange == 1 -> {
                rg = ast.add(t, asp.K_RANGE_EXPRESSION)
                ast.set-slot(t, rg, 0, ast.put-str(t, 'true')); leftInc（開 `[`）
                ast.set-slot(t, rg, 1, ast.put-str(t, ri)); rightInc
                ast.kid-add(t, rg, st)
                ast.kid-add(t, rg, en)
                se = ast.add(t, asp.K_SLICE_EXPRESSION)
                ast.kid-add(t, se, idx)
                ast.kid-add(t, se, rg)
                idx = se
            }
            isRange == 0 -> {
                ie = ast.add(t, asp.K_INDEX_EXPRESSION)
                ast.kid-add(t, ie, idx)
                ast.kid-add(t, ie, st)
                idx = ie
            }
            handled = 1
        }
        nt == tok.LBRACE && ps-is-struct-lit(p) -> {

            ; `Ident{ field: val, … }` ⇒ StructLiteral（對應 Go parseStructLiteral）。
            ; 型别名用 ps-dotted-name：単 IDENT→`Point`、限定名 DotExpression 链→`net.Conn`。
            ty = ps-dotted-name(t, idx)
            sl = ps-parse-struct-lit(t, p, ty)
            idx = sl
            handled = 1
        }
        nt == tok.COLON && ps-peek-at(p, 1) == tok.LBRACE && ast.kind-at(t, idx) == asp.K_IDENTIFIER -> {

            ; 明示 match：`subj: { pat -> body … }` ⇒ desugar 成 if/else 鏈（見 ps-parse-match）。
            ; ⚠️ 只認「識別元主體」；複雜主體（呼叫/索引）延後。`:` 與 `{` 須同行（空格已被詞法过滤）。
            subjName = ast.node-string(t, idx)
            ps-bump(p); 消費 COLON
            ps-bump(p); 消費 LBRACE
            mm = ps-parse-match(t, p, subjName)
            ps-expect(p, tok.RBRACE)
            idx = mm
            handled = 1
        }
        handled == 0 -> pgo = false
    }

    ; 中綴迴圈（Go：for currentToken != EOF && currentPrecedence() > precedence）
    ; 注意：**不**在檢查運算子前跳 trivia──句尾 NEWLINE 優先級 0 自然終止迴圈。
    go = true
    (go) {
        optyp = ps-peek(p)
        oprec = ps-op-prec(optyp)
        go = oprec > prec
        go -> {
            otk = ps-peek-token(p)
            ps-bump(p)
            right = ps-parse-expr-prec(t, p, oprec)
            right > 0 -> {

                ; arena 順序：左右子樹均已完成 → 先 add 父，再依序 kid-add
                node = ast.add(t, asp.K_INFIX_EXPRESSION)
                ast.set-slot(t, node, 0, ast.put-str(t, otk.lit))
                ast.kid-add(t, node, idx)
                ast.kid-add(t, node, right)
                idx = node
            }

            ; 右運算元缺失：Go 報錯後回左值；這裡保留左值並終止迴圈
            right <= 0 -> go = false
        }
    }

    ; 陳述/運算式層級的 lvalue 賦值：`obj.field = expr` / `arr[i] = expr` / `mp[k] = expr`。
    ;   對應 Go parseExpression 尾（expr.go:598–637）：`=` 非中綴運算子（優先級 0），中綴迴圈天然停在 ASSIGN；
    ;   若此時左值是 Dot/Index ⇒ 消費 `=`、以 LOWEST 解右值、建 AssignExpression{Left,Value}（右結合、無純量槽）。
    ;   僅 plain ASSIGN（`?=` → UnwrapAssignStatement 為另一節點，本片延後）。檢查用【活】ps-peek：`=` 前若換行則 currentToken 為 NEWLINE、不觸發（對齊 Go）。
    ps-peek(p) == tok.ASSIGN -> {
        k0 = ast.kind-at(t, idx)
        isLval = 0
        k0 == asp.K_DOT_EXPRESSION -> isLval = 1
        k0 == asp.K_INDEX_EXPRESSION -> isLval = 1
        isLval == 1 -> {
            ps-bump(p); 消費 =
            val = ps-parse-expr(t, p)
            ae = ast.add(t, asp.K_ASSIGN_EXPRESSION)
            ast.kid-add(t, ae, idx)
            ast.kid-add(t, ae, val)
            idx = ae
        }
    }
    idx
}

; ps-parse-let：解析 `name = expr`（推論型別：字面量→NamedType，SliceLiteral→SliceType(NamedType)）
ps-parse-let = (t ast, p psst, name str) (idx i64) {
    val = ps-parse-expr(t, p)
    typ = 0

    ; SliceLiteral RHS → 建 SliceType(inferred) 包 NamedType(elemType, inferred)
    ; 復刻 Go stmt.go 中 `case *SliceLiteral: stmt.Type = &SliceType{...}` 的路徑
    val > 0 -> {
        d = ast.nd-at(t, val)
        {
            d.kind == asp.K_SLICE_LITERAL -> {
                elem = ps-elem-type-of(t, val)
                inner = ast.add(t, asp.K_NAMED_TYPE)
                ast.set-slot(t, inner, 0, ast.put-str(t, elem))
                ast.set-slot(t, inner, 1, ast.put-str(t, 'true'))
                typ = ast.add(t, asp.K_SLICE_TYPE)
                ast.set-slot(t, typ, 0, ast.put-str(t, 'true'))
                ast.kid-add(t, typ, inner)
            }

            -> {
                tn = ps-infer-type(t, val)
                tn != '' -> {
                    typ = ast.add(t, asp.K_NAMED_TYPE)
                    ast.set-slot(t, typ, 0, ast.put-str(t, tn))
                    ast.set-slot(t, typ, 1, ast.put-str(t, 'true'))
                }
            }
        }
    }
    idx = ast.add(t, asp.K_LET_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    ast.kid-add(t, idx, typ)
    ast.kid-add(t, idx, val)
    idx
}

; ps-parse-arr-lit：在**陣列型別上下文**下直接把 RHS `[e1, …, eN]` 建為
;   ArrayLiteral{size, elements, wasSliceLiteral: true}（不經 SliceLiteral 中转）。
;   對應 Go stmt.go:1210-1218：ArrayType.Size>0 且 RHS 為 SliceLiteral 時的轉換。
;   kid 序：child0=Size（沿用型別側的 sz 節點），child1..N=Elements（KIDS 迭代）。
ps-parse-arr-lit = (t ast, p psst, sz i64) (idx i64) {
    ps-skip-trivia(p)
    ps-expect(p, tok.LBRACKET)
    els []i64 = with-cap(4)
    ps-skip-trivia(p)
    {
        ps-peek(p) == tok.RBRACKET -> {
            ps-bump(p)
        }

        -> {
            (ps-peek(p) != tok.RBRACKET && ps-peek(p) != tok.EOF) {
                pos0 = p.pos
                e = ps-parse-expr-prec(t, p, 0)
                e > 0 -> els.push(e)
                ps-skip-trivia(p)
                ps-peek(p) == tok.COMMA -> {
                    ps-bump(p)
                    ps-skip-trivia(p)
                }
                p.pos == pos0 -> ps-bump(p)
            }
            ps-expect(p, tok.RBRACKET)
        }
    }
    idx = ast.add(t, asp.K_ARRAY_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, els.len().to-str())); elements
    ast.set-slot(t, idx, 1, ast.put-str(t, 'true')); wasSliceLiteral
    ast.set-count(t, idx, 0, els.len())
    ast.kid-add(t, idx, sz); Size（child0）
    m = 0
    (m < els.len()) {
        ast.kid-add(t, idx, els[m])

        #{overflow=wrap}
        m = m + 1
    }
}

; ps-parse-map-lit：在 **Map 型別上下文**下把 RHS `{ k1: v1, … }` 建為
;   MapLiteral{pairs}，對應 Go parseMapLiteral。
;   kid 序（遵從 dump 源碼序）：child0..N-1 = MapPair（KIDS 迭代），最末 kid = MapType（CHILD）。
;   注意舆 ArrayLiteral 相反：MapLiteral 的 KIDS 在前、CHILD(MapType) 在後。
ps-parse-map-lit = (t ast, p psst, mt i64) (idx i64) {
    ps-skip-trivia(p)
    ps-expect(p, tok.LBRACE)
    pvs []i64 = with-cap(4); 每個 MapPair 節點索引
    {
        ps-peek(p) == tok.RBRACE -> {
            ps-bump(p); 空 map {}
        }

        -> {
            (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
                pos0 = p.pos
                ps-skip-trivia(p)
                k = ps-parse-expr-prec(t, p, 0)
                ps-skip-trivia(p)
                ps-expect(p, tok.COLON)
                ps-skip-trivia(p)
                v = ps-parse-expr-prec(t, p, 0)

                ; MapPair{Key, Value}：裸標頭 + 兩 kid（Key=child0、Value=child1）
                mp = ast.add(t, asp.K_MAP_PAIR)
                ast.kid-add(t, mp, k)
                ast.kid-add(t, mp, v)
                mp > 0 -> pvs.push(mp)
                ps-skip-trivia(p)
                ps-peek(p) == tok.COMMA -> {
                    ps-bump(p)
                    ps-skip-trivia(p)
                }
                p.pos == pos0 -> ps-bump(p)
            }
            ps-expect(p, tok.RBRACE)
        }
    }
    idx = ast.add(t, asp.K_MAP_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, pvs.len().to-str())); pairs（OF-LEN 字串槽）
    ast.set-count(t, idx, 0, pvs.len()); KIDS 迭代數
    m = 0
    (m < pvs.len()) {
        ast.kid-add(t, idx, pvs[m])

        #{overflow=wrap}
        m = m + 1
    }
    ast.kid-add(t, idx, mt); MapType（CHILD，永遠排最後）
}

; ps-is-struct-lit：判斷【目前 pos 為 LBRACE】起是否為結構體字面量形：
;   空 `{}` 或 `{ IDENT : … }`（首個非 trivia token 為 IDENT 且紧跟 COLON）。
;   match 用 `->`、enum 用 `,`/`=`，皆不會误中此形。不消耗 p.pos。
ps-is-struct-lit = (p psst) (r i64) {
    r = 0

    #{index-out=zero}
    p.toks[p.pos].typ == tok.LBRACE -> {

        ; 定位首個非 trivia token
        #{overflow=wrap}
        i = p.pos + 1
        go = true
        (go && i < p.toks.len()) {

            #{index-out=zero}
            tt = p.toks[i].typ
            tt == tok.NEWLINE -> {

                #{overflow=wrap}
                i = i + 1
            }
            tt == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            -> go = false
        }

        #{index-out=zero}
        t1 = p.toks[i].typ
        t1 == tok.RBRACE -> r = 1
        t1 == tok.IDENT -> {

            ; IDENT 後首個非 trivia token 必須是 COLON
            #{overflow=wrap}
            j = i + 1
            go2 = true
            (go2 && j < p.toks.len()) {

                #{index-out=zero}
                tj = p.toks[j].typ
                tj == tok.NEWLINE -> {

                    #{overflow=wrap}
                    j = j + 1
                }
                tj == tok.COMMENT -> {

                    #{overflow=wrap}
                    j = j + 1
                }

                -> go2 = false
            }

            #{index-out=zero}
            t2 = p.toks[j].typ
            t2 == tok.COLON -> r = 1
        }
    }
}

; ps-dotted-name：把 `net.Conn` / `a.b.C` 的 DotExpression 链重組為點分型名字串。
;   DotExpression：slot0=property 名、kid0=Receiver（递归展开）；Identifier：slot0=名。
;   其他節點 → 回退 node-string（不该出现在限定名的位置）。
ps-dotted-name = (t ast, n i64) (r str) {
    r = ''
    n <= 0 -> return
    d = ast.nd-at(t, n)
    {
        d.kind == asp.K_DOT_EXPRESSION -> {
            rc = 0
            d.nkid > 0 -> rc = ast.kid-at(t, d.kid0)
            r = ps-dotted-name(t, rc) + '.' + ast.str-at(t, d.s0)
        }

        d.kind == asp.K_IDENTIFIER -> r = ast.str-at(t, d.s0)

        -> r = ast.node-string(t, n)
    }
}

; ps-parse-struct-lit：把 `{ field: val, … }` 建為 StructLiteral{type, fields}。
;   slot0=型别名(字串)、slot1=fields 數(OF-LEN 字串槽)、count0=KIDS 迭代數；kid 序=各 StructField。
;   每個 StructField：slot0=name、kid0=Type(0 占位)、kid1=Value（對應 dump CHILD 序）。
ps-parse-struct-lit = (t ast, p psst, ty str) (idx i64) {
    ps-expect(p, tok.LBRACE)
    flds []i64 = with-cap(4); 每個 StructField 節點索引
    {
        ps-peek(p) == tok.RBRACE -> {
            ps-bump(p); 空 {}
        }

        -> {
            (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
                pos0 = p.pos
                ps-skip-trivia(p)
                ft = ps-peek-token(p)
                fname = ft.lit
                ps-peek(p) == tok.IDENT -> ps-bump(p); 消費欄位名
                ps-skip-trivia(p)
                val = 0
                ps-peek(p) == tok.COLON -> {
                    ps-bump(p); 消費 :
                    ps-skip-trivia(p)
                    val = ps-parse-expr-prec(t, p, 0)
                }

                ; StructField{name}：裸標頭 + [Type=0 占位, Value]
                sf = ast.add(t, asp.K_STRUCT_FIELD)
                ast.set-slot(t, sf, 0, ast.put-str(t, fname))
                ast.set-slot(t, sf, 1, ast.put-str(t, '0')); arraySize（kvn NON-ZERO：'0' → 略過）
                ast.kid-add(t, sf, 0)
                ast.kid-add(t, sf, val)
                sf > 0 -> flds.push(sf)
                ps-skip-trivia(p)
                ps-peek(p) == tok.COMMA -> {
                    ps-bump(p)
                    ps-skip-trivia(p)
                }
                p.pos == pos0 -> ps-bump(p)
            }
            ps-expect(p, tok.RBRACE)
        }
    }
    idx = ast.add(t, asp.K_STRUCT_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, ty)); type
    ast.set-slot(t, idx, 1, ast.put-str(t, flds.len().to-str())); fields（OF-LEN 字串槽）
    ast.set-count(t, idx, 0, flds.len()); KIDS 迭代數
    m = 0
    (m < flds.len()) {
        ast.kid-add(t, idx, flds[m])

        #{overflow=wrap}
        m = m + 1
    }
}

; ps-intlit-hex：整數字面量原始文字是否為 `0x`/`0X` 十六進位形（Go stmt.go:1233 口徑）。
;   僅按【進位制前綴】判定，不看數值範圍（與 ps-int-lit-value 的 base 偵測同一寫法）。
ps-intlit-hex = (raw str) (r i64) {
    r = 0
    raw.len-bytes() > 2 && raw.byte(0) == 48 && (raw.byte(1) == 120 || raw.byte(1) == 88) -> r = 1
}

; ps-elem-type-of：从 SliceLiteral 的首元素推論元素型别名（空切片默认 i64）
;   規則同 Go stmt.go:1274-1300：IntegerLiteral→i64（十六進位 0x⇒byte）, Float→f64,
;   String→str, Bool→bool, Char→char, default→i64。
ps-elem-type-of = (t ast, sl i64) (r str) {
    r = 'i64'
    d = ast.nd-at(t, sl)
    d.nkid <= 0 -> return
    firstKid = ast.kid-at(t, d.kid0)
    firstKid <= 0 -> return
    e = ast.nd-at(t, firstKid)
    {
        e.kind == asp.K_INTEGER_LITERAL -> {

            ; Go stmt.go:1279-1288：0x/0X 十六進位元素⇒ byte，否則 i64
            raw = ast.str-at(t, ast.nd-s(e, 1))
            r = 'i64'
            ps-intlit-hex(raw) == 1 -> r = 'byte'
        }

        e.kind == asp.K_FLOAT_LITERAL -> r = 'f64'

        e.kind == asp.K_STRING_LITERAL -> r = 'str'

        e.kind == asp.K_BOOLEAN_LITERAL -> r = 'bool'

        e.kind == asp.K_CHAR_LITERAL -> r = 'char'

        -> r = 'i64'
    }
}

; ps-infer-type：依 RHS 字面量種類推論預設型別（§5.3.2 的 desugar 路徑）。
;   回 '' = 不推斷（Oracle 對非标量 RHS 不建 NamedType）。
ps-infer-type = (t ast, val i64) (r str) {
    r = ''
    val <= 0 -> return
    d = ast.nd-at(t, val)
    {
        d.kind == asp.K_INTEGER_LITERAL -> {

            ; Go stmt.go:1229-1240：十六進位字面量（0xNN）推 byte，十進位推 i64
            raw = ast.str-at(t, ast.nd-s(d, 1))
            r = 'i64'
            ps-intlit-hex(raw) == 1 -> r = 'byte'
        }

        d.kind == asp.K_FLOAT_LITERAL -> r = 'f64'

        d.kind == asp.K_BOOLEAN_LITERAL -> r = 'bool'

        d.kind == asp.K_STRING_LITERAL -> r = 'str'

        d.kind == asp.K_CHAR_LITERAL -> r = 'char'

        -> r = ''
    }
}

; ps-parse-func：解析 `name = (params) { body }` 或 `name = (params) (results) { body }`
ps-parse-func = (t ast, p psst, name str) (idx i64) {
    ps-bump(p); 消費 LPAREN（輸入參數群）
    params []i64 = with-cap(4)
    (ps-peek(p) != tok.RPAREN) {
        pn = ps-parse-param(t, p)
        pn > 0 -> params.push(pn)
        pn == 0 -> ps-bump(p); 防呆：沒解析出參數也要前進
    }
    ps-bump(p); 消費 RPAREN
    ps-skip-trivia(p)

    ; 回傳值群組（可選）：`(out T, …)`。Nolang 把回傳值建為 FunctionDefinition 上的 Parameter，
    ;   於 signature() 渲染時接在輸入參數之後（[inputs][results] 連續）。
    outs []i64 = with-cap(4)
    ps-peek(p) == tok.LPAREN -> {
        ps-bump(p); 消費第二個 LPAREN
        (ps-peek(p) != tok.RPAREN) {
            ro = ps-parse-param(t, p)
            ro > 0 -> outs.push(ro)
            ro == 0 -> ps-bump(p); 防呆
        }
        ps-bump(p); 消費第二個 RPAREN
        ps-skip-trivia(p)
    }
    ps-expect(p, tok.LBRACE); 進入 body
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE); 結束 body
    idx = ast.add(t, asp.K_FUNCTION_DEFINITION)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))

    ; SIG：泛型參數 0 / 輸入參數 params.len() / 回傳值 outs.len()
    ;   kid 區序：[inputs…][results…] 連續（signature() 由 base 依 c3/c4/c5 切片），body 為其後 guarded CHILD
    ast.set-sig(t, idx, 0, params.len(), outs.len())
    j = 0
    (j < params.len()) {
        ast.kid-add(t, idx, params[j])

        #{overflow=wrap}
        j = j + 1
    }
    m = 0
    (m < outs.len()) {
        ast.kid-add(t, idx, outs[m])

        #{overflow=wrap}
        m = m + 1
    }
    ast.kid-add(t, idx, body)
    idx
}

; ps-parse-method-func：方法定義 `recvType.method = (params) [ (results) ] { body }` 的主體。
;   進入時 p.pos 落在輸入參數群的 LPAREN。對應 Go parseMethodDefinition：
;     · name = 點分全名（'recvType.method'）、methodDef 欄位 = 'true'（FunctionDefinition slot2）。
;     · self 合成為【首個輸出參數】（Results，非 inputs）：Parameter{name:'self', Type:NamedType{recvType}}。
;       ⇒ kid 區序 [inputs…][self][results…][body]，set-sig 的 results 數 = 1 + 宣告的 outs 數。
;   ⚠️ Parameter 有 2 個 guarded CHILD（Type、DefaultExpr）：Type=selfnt、DefaultExpr=0 佔位。
ps-parse-method-func = (t ast, p psst, fullName str, recvType str) (idx i64) {
    ps-bump(p); 消費 LPAREN（輸入參數群）
    params []i64 = with-cap(4)
    (ps-peek(p) != tok.RPAREN) {
        pn = ps-parse-param(t, p)
        pn > 0 -> params.push(pn)
        pn == 0 -> ps-bump(p); 防呆：沒解析出參數也要前進
    }
    ps-bump(p); 消費 RPAREN
    ps-skip-trivia(p)

    ; 回傳值群組（可選）：`(out T, …)`
    outs []i64 = with-cap(4)
    ps-peek(p) == tok.LPAREN -> {
        ps-bump(p); 消費第二個 LPAREN
        (ps-peek(p) != tok.RPAREN) {
            ro = ps-parse-param(t, p)
            ro > 0 -> outs.push(ro)
            ro == 0 -> ps-bump(p); 防呆
        }
        ps-bump(p); 消費第二個 RPAREN
        ps-skip-trivia(p)
    }

    ; self 合成接收者（先建子樹 NamedType，再建 Parameter 父節點）
    selfnt = ast.add(t, asp.K_NAMED_TYPE)
    ast.set-slot(t, selfnt, 0, ast.put-str(t, recvType))
    selfp = ast.add(t, asp.K_PARAMETER)
    ast.set-slot(t, selfp, 0, ast.put-str(t, 'self'))
    ast.kid-add(t, selfp, selfnt)
    ast.kid-add(t, selfp, 0)
    ps-expect(p, tok.LBRACE); 進入 body
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE); 結束 body
    idx = ast.add(t, asp.K_FUNCTION_DEFINITION)
    ast.set-slot(t, idx, 0, ast.put-str(t, fullName))
    ast.set-slot(t, idx, 2, ast.put-str(t, 'true')); methodDef（P-TRUE：僅 'true' 才印）
    rs = outs.len()

    #{overflow=wrap}
    rs = rs + 1; +self
    ast.set-sig(t, idx, 0, params.len(), rs)
    j = 0
    (j < params.len()) {
        ast.kid-add(t, idx, params[j])

        #{overflow=wrap}
        j = j + 1
    }
    ast.kid-add(t, idx, selfp)
    m = 0
    (m < outs.len()) {
        ast.kid-add(t, idx, outs[m])

        #{overflow=wrap}
        m = m + 1
    }
    ast.kid-add(t, idx, body)
    idx
}

; ps-for-source：解析 range 迭代來源（`<-` 右側），對應 Go parseForRange。
;   `[`/`(` → RangeExpression 填 src(kid0)；其他（陣列 IDENT/呼叫等）→ 運算式填 srcExpr(kid1)。
;   進入時呼叫端已消費 `<-`，本函式先 skip-trivia。回傳 (src, srcExpr)（皆 i64、無結構體⇒安全多回傳）。
;   ⚠️ 守衛用快照 op，避免活 ps-peek 於 ps-bump 後重評誤觸（跨臂坑）。
ps-for-source = (t ast, p psst) (src i64, srcExpr i64) {
    ps-skip-trivia(p)
    src = 0
    srcExpr = 0
    op = ps-peek(p)
    op == tok.LBRACKET || op == tok.LPAREN -> {
        ps-bump(p); 消費 `[` 或 `(`
        leftInc = 'true'
        op == tok.LPAREN -> leftInc = 'false'
        st = 0
        en = 0
        ps-peek(p) != tok.ELLIPSIS -> st = ps-parse-expr-prec(t, p, 0)
        ps-expect(p, tok.ELLIPSIS); 消費 ..
        nc = ps-peek(p)
        nc != tok.RBRACKET && nc != tok.RPAREN -> en = ps-parse-expr-prec(t, p, 0)
        cl = ps-peek(p)
        ri = 'false'
        cl == tok.RBRACKET -> ri = 'true'
        ps-bump(p); 消費閉合 `]` 或 `)`
        src = ast.add(t, asp.K_RANGE_EXPRESSION)
        ast.set-slot(t, src, 0, ast.put-str(t, leftInc)); leftInc
        ast.set-slot(t, src, 1, ast.put-str(t, ri)); rightInc
        ast.kid-add(t, src, st)
        ast.kid-add(t, src, en)
    }
    op != tok.LBRACKET && op != tok.LPAREN -> {

        ; 陣列/切片源：若為 **裸 IDENT 後接 `:`**（`i <- a: { }`），不能走 ps-parse-expr——
        ;   否則 `ident : {` 會誤觸明示-match 後綴分支（ps.no 的 `IDENT COLON LBRACE` 臂）吃掉本體 ⇒ SIGBUS。
        ;   直接建 Identifier 並只消費 ident，把 `:` 留給呼叫端冒號檢查。其他形仍走 ps-parse-expr。
        srcTk = ps-peek-token(p)
        bareIdentColon = srcTk.typ == tok.IDENT && ps-peek-at(p, 1) == tok.COLON
        bareIdentColon -> {
            srcExpr = ast.add(t, asp.K_IDENTIFIER)
            ast.set-slot(t, srcExpr, 0, ast.put-str(t, srcTk.lit))
            ps-bump(p); 消費 ident
        }
        bareIdentColon == 0 -> srcExpr = ps-parse-expr(t, p)
    }
}

; ps-parse-for：解析 bare range-for 迭代 `vname <- range-or-array [:] { body }`（不使用 `for` 關鍵字）。
;   對應 Go parseForStatement 的 bare 分支 + parseForRange。回傳 ForStatement 節點索引。
ps-parse-for = (t ast, p psst, vname str) (idx i64) {
    ps-bump(p); 消費 IDENT（迴圈變數）
    ps-bump(p); 消費 ARROW (<-)
    src, srcExpr = ps-for-source(t, p)

    ; 冒號：有 `:` 消費（無警告）；無 `:` ⇒ deprecated 形，p.warn + 1（對應 Go parseForStatement saveWarning）
    hd = ps-peek(p)
    hd == tok.COLON -> ps-bump(p)

    #{overflow=wrap}
    hd != tok.COLON -> p.warn = p.warn + 1

    ; 迴圈本體
    ps-skip-trivia(p)
    ps-expect(p, tok.LBRACE)
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)

    ; IterationExpr（子先於父：src/srcExpr 已建）；2 個 guarded CHILD：Range(kid0)、RangeExpr(kid1)
    ie = ast.add(t, asp.K_ITERATION_EXPR)
    ast.set-slot(t, ie, 0, ast.put-str(t, vname)); var 名（kvs，空則不印）
    ast.kid-add(t, ie, src)
    ast.kid-add(t, ie, srcExpr)

    ; ForStatement：6 個 guarded CHILD（Init,Condition,Update,CountExpr,IterRange,Body），僅後兩者非零
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, ie)
    ast.kid-add(t, idx, body)
    idx
}

; ps-parse-for-kw：解析 `for`/`while` 關鍵字迴圈（對應 Go parseForStatement 的 FOR 分支）。
;   僅支援帶 `{ }` 本體的三種形體（無大括號 inline / C-style `,;` / 比較運算子退路等罕見形暫不覆蓋）：
;     · `for { }`                → Condition=BooleanLiteral{true}，p.warn+1（2297）
;     · `for v <- range [:] { }` → Condition=Identifier{v} + IterRange=IterationExpr，無警告（ARROW 分支）
;     · `for expr { }` / `while` → Condition=expr，p.warn+1（2407 for / 2402 while）
;   ⚠️ `;` 在 Nolang 是行註解 ⇒ C-style `for a; b; c` 天然退化，不實作。
ps-parse-for-kw = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 for/while 關鍵字
    ps-skip-trivia(p)
    warn = 0
    cond = 0
    ie = 0
    body = 0
    hd = ps-peek(p)

    ; 無限迴圈：for { }
    hd == tok.LBRACE -> {
        cond = ast.add(t, asp.K_BOOLEAN_LITERAL)
        ast.set-slot(t, cond, 0, ast.put-str(t, 'true'))
        warn = 1
        ps-expect(p, tok.LBRACE)
        body = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
    }
    hd != tok.LBRACE -> {
        tk1 = ps-peek-token(p)
        tk2 = ps-peek-at(p, 1)
        isRange = tk1.typ == tok.IDENT && tk2 == tok.ARROW

        ; range 形：for v <- src { }（ARROW 分支無警告；IN 形暫不覆蓋）
        isRange -> {
            ps-bump(p); 消費 ident（迴圈變數）
            ps-bump(p); 消費 ARROW (<-)
            src, srcExpr = ps-for-source(t, p)
            hc = ps-peek(p)
            hc == tok.COLON -> ps-bump(p)
            ps-skip-trivia(p)
            ps-expect(p, tok.LBRACE)
            body = ps-parse-block(t, p)
            ps-expect(p, tok.RBRACE)
            ie = ast.add(t, asp.K_ITERATION_EXPR)
            ast.set-slot(t, ie, 0, ast.put-str(t, tk1.lit))
            ast.kid-add(t, ie, src)
            ast.kid-add(t, ie, srcExpr)
            cond = ast.add(t, asp.K_IDENTIFIER)
            ast.set-slot(t, cond, 0, ast.put-str(t, tk1.lit))
        }

        ; 條件形：for expr { } / while expr { }
        isRange == 0 -> {
            cond = ps-parse-expr(t, p)
            hc = ps-peek(p)
            hc == tok.COLON -> ps-bump(p)
            ps-skip-trivia(p)
            ps-expect(p, tok.LBRACE)
            body = ps-parse-block(t, p)
            ps-expect(p, tok.RBRACE)
            warn = 1
        }
    }

    ; ForStatement：6 個 guarded CHILD（Init,Condition,Update,CountExpr,IterRange,Body）
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, cond)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, 0)
    ast.kid-add(t, idx, ie)
    ast.kid-add(t, idx, body)

    #{overflow=wrap}
    p.warn = p.warn + warn
    idx
}

; ps-parse-bang-loop：`!! { }`（恆真、無限循環）與 `! { }`（恆假、不執行）。
;   對應 Go parseBangLoop（stmt.go:2577）：Condition=BooleanLiteral{loop}、Body=BlockStatement。
;   此二形【不】saveWarning（新式語法），故不累加 p.warn。其餘 4 個 guarded CHILD 以 0 佔位。
ps-parse-bang-loop = (t ast, p psst, loop i64) (idx i64) {
    ps-bump(p); 消費 !! / !
    ps-expect(p, tok.LBRACE)
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)
    cond = ast.add(t, asp.K_BOOLEAN_LITERAL)
    lit = 'false'
    loop == 1 -> lit = 'true'
    ast.set-slot(t, cond, 0, ast.put-str(t, lit))
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label（kv 恆印 `label: `）
    ast.kid-add(t, idx, 0); Init
    ast.kid-add(t, idx, cond); Condition
    ast.kid-add(t, idx, 0); Update
    ast.kid-add(t, idx, 0); CountExpr
    ast.kid-add(t, idx, 0); IterRange
    ast.kid-add(t, idx, body); Body
}

; ps-is-cond-loop-prefix：判定【目前 pos（LPAREN）】是否為 `(cond) {` 前置條件循環。
;   對應 Go isCondLoopPrefix（stmt.go:2615）：(1) 掃至平衡 `)`；(2) 其【立即】下一 token 須為 `{`
;   （不跳 trivia—換行後的 `{` 屬後綴式循環，非本形）；(3) 括號內容含 `,` 或「恰好兩個 IDENT」
;   （參數名+型別）⇒ 是匿名函式參數列，非循環。其餘（含 `()`、單 IDENT `(flag)`）⇒ 循環。
ps-is-cond-loop-prefix = (p psst) (r i64) {
    r = 0
    depth = 0
    i = 0
    closed = -1
    go = true
    (go) {
        t = ps-peek-at(p, i)
        t == tok.EOF -> go = false
        go == true -> {
            t == tok.LPAREN -> {

                #{overflow=wrap}
                depth = depth + 1
            }
            t == tok.RPAREN -> {

                #{overflow=wrap}
                depth = depth - 1
                depth == 0 -> {
                    closed = i
                    go = false
                }
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
    closed < 0 -> return

    #{overflow=wrap}
    after = closed + 1
    ps-peek-at(p, after) != tok.LBRACE -> return
    hasComma = 0
    identCnt = 0
    innerCnt = 0
    z = 1
    (z < closed) {
        it = ps-peek-at(p, z)
        it == tok.COMMA -> hasComma = 1
        it == tok.IDENT -> {

            #{overflow=wrap}
            identCnt = identCnt + 1
        }

        #{overflow=wrap}
        innerCnt = innerCnt + 1

        #{overflow=wrap}
        z = z + 1
    }
    hasComma == 1 -> return
    innerCnt == 2 && identCnt == 2 -> return
    r = 1
}

; ps-parse-cond-loop：`(cond) { body }` 前置條件循環。對應 Go parseCondLoopPrefix（stmt.go:2686）。
;   空括號 `()` ⇒ Condition=BooleanLiteral{false}（不執行）；`(true)`/`(expr)` ⇒ Condition=expr。
;   Body=BlockStatement。不 saveWarning（新式語法）。
ps-parse-cond-loop = (t ast, p psst) (idx i64) {
    ps-bump(p); 消費 (
    cond = 0

    ; ⚠️ 預先取 hd（同 ps-parse-for-kw 守則）：若每臂各呼叫 ps-peek(p)，首臂消費 `)` 後
    ;   次臂重取會看到 `{` ⇒ 雙臂皆執行（match 非互斥 switch），cond 被第二臂覆寫成 0。
    hd = ps-peek(p)
    hd == tok.RPAREN -> {
        cond = ast.add(t, asp.K_BOOLEAN_LITERAL)
        ast.set-slot(t, cond, 0, ast.put-str(t, 'false'))
        ps-bump(p); 消費 )
    }
    hd != tok.RPAREN -> {
        cond = ps-parse-expr(t, p)
        ps-expect(p, tok.RPAREN)
    }
    ps-expect(p, tok.LBRACE)
    body = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)
    idx = ast.add(t, asp.K_FOR_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, '')); label
    ast.kid-add(t, idx, 0); Init
    ast.kid-add(t, idx, cond); Condition
    ast.kid-add(t, idx, 0); Update
    ast.kid-add(t, idx, 0); CountExpr
    ast.kid-add(t, idx, 0); IterRange
    ast.kid-add(t, idx, body); Body
}

; ps-parse-break-continue：解析 `break` / `continue`（對應 Go parseBreakStatement / parseContinueStatement）。
;   節點無 CHILD，仅雨個字串 slot：slot0=label（`kv` 恆印，空⇒`label: `）、slot1=kind（`kv` 恆印，'none'/'text'/'numeric'）。
;   brk=1⇒BreakStatement，brk=0⇒ContinueStatement。
;   標籤侦测对齐 Go：消費关键字後直接看**紧邻** token（不跳 trivia）——LABEL(`#N`)⇒numeric、IDENT⇒text（同列才成立）；
;   否则（NEWLINE/RBRACE 等）⇒裸 break（label=''、kind='none'）。⚠️ 不同列的 IDENT 属于下一条陈述，不能当标签。
ps-parse-break-continue = (t ast, p psst, brk i64) (idx i64) {
    ps-bump(p); 消費 break/continue 关键字
    label = ''
    kind = 'none'
    nt = ps-peek(p)
    nt == tok.LABEL -> {
        ltk = ps-peek-token(p)
        label = ltk.lit
        kind = 'numeric'
        ps-bump(p)
    }
    nt == tok.IDENT -> {
        itk = ps-peek-token(p)
        label = itk.lit
        kind = 'text'
        ps-bump(p)
    }
    nodekind = asp.K_BREAK_STATEMENT
    brk == 0 -> nodekind = asp.K_CONTINUE_STATEMENT
    idx = ast.add(t, nodekind)
    ast.set-slot(t, idx, 0, ast.put-str(t, label)); label
    ast.set-slot(t, idx, 1, ast.put-str(t, kind)); kind
    idx
}

; ps-rarrow-same-line：目前是否為【與前一個 token 同列】的 `->`（對應 Go
;   `currentToken==RARROW && prevToken.Type != NEWLINE`）。⚠️ NEWLINE 在 ps.no
;   raw token 流中【保留】，故直接看 p.pos-1 的型別即可判是否換行。
ps-rarrow-same-line = (p psst) (yes i64) {
    yes = 0
    ps-peek(p) == tok.RARROW -> {
        prevTyp = 0
        p.pos >= 1 -> {

            #{index-out=zero, overflow=wrap}
            prevTyp = p.toks[p.pos - 1].typ
        }
        prevTyp != tok.NEWLINE -> yes = 1
    }
}

; ps-standalone-body：解析獨立 if-then 的本體（已消費其前面的 `->`），對應
;   Go parseStandaloneBody。回傳 (blk, tail)：blk=BlockStatement 節點；tail=可再鏈式
;   的單一運算式節點（僅運算式本體非 0；區塊/陳述本體為 0，不可鏈）。
;   ⚠️ 不跳 trivia——對齊 Go 直接看 currentToken：`-> \n` 之類換行→回空非內聯 Block。
ps-standalone-body = (t ast, p psst) (blk i64, tail i64) {
    blk = 0
    tail = 0
    hd = ps-peek(p)

    ; 區塊本體 `{ stmts }` → 非內聯 Block（ps-parse-block 不自動吃大括號）
    hd == tok.LBRACE -> {
        ps-bump(p); 消費 {
        blk = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
        return
    }

    ; 終止符（換行/}/EOF）→ 空非內聯 Block
    hd == tok.NEWLINE || hd == tok.RBRACE || hd == tok.EOF -> {
        blk = ast.add(t, asp.K_BLOCK_STATEMENT)
        ast.set-count(t, blk, 0, 0)
        return
    }

    ; 陳述型本體：關鍵字（return/break/continue）或 `IDENT =/,`（let/multi-assign）
    ;   → 內聯 Block{[stmt]}、tail=0（非 ExprStmt ⇒ 不可鏈）
    isStmt = 0
    hd == tok.RETURN || hd == tok.BREAK || hd == tok.CONTINUE || hd == tok.MUL || hd == tok.STAR_STAR -> isStmt = 1
    hd == tok.IDENT && (ps-peek-at(p, 1) == tok.ASSIGN || ps-peek-at(p, 1) == tok.COMMA) -> isStmt = 1
    isStmt == 1 -> {
        s = ps-parse-stmt(t, p)
        blk = ast.add(t, asp.K_BLOCK_STATEMENT)
        s > 0 -> {
            ast.kid-add(t, blk, s)
            ast.set-count(t, blk, 0, 1)
        }
        ast.set-slot(t, blk, 0, ast.put-str(t, 'true')); inline
        return
    }

    ; 運算式本體 → 內聯 Block{[ExprStmt{e}]}、tail=e（可鏈）
    e = ps-parse-expr(t, p)
    es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
    ast.kid-add(t, es, e)
    blk = ast.add(t, asp.K_BLOCK_STATEMENT)
    ast.kid-add(t, blk, es)
    ast.set-count(t, blk, 0, 1)
    ast.set-slot(t, blk, 0, ast.put-str(t, 'true')); inline
    tail = e
}

; ps-wrap-chain：獨立 if-then 的【鏈式 `->`】處理，對應 Go wrapStandaloneChainDepth。
;   當 blk 是單一內聯 ExprStmt（tail>0）且後面跟【同列】`->` 時，tail 變成巢狀 if 的
;   cond：`a -> b -> c` → if(a){ inline[ExprStmt{ if(b){ inline[ExprStmt{c}] } }] }。
;   ⚠️ 遞迴把後續所有同列 `->` 吃光，故本層只需一次判定（不需 while 迴圈）。
;   ⚠️ lint：进入时 linkIdx==2 代整條鏈已達第 3 個條件 ⇒ saveWarning(WarnChainedIf) 一次（
;     與鏈長無關）；單條 `a -> b`（链只一層， recurse 到 linkIdx==2 時已無同列 ->，不進本支）不告警。
;   ⚠️ arena：tail（cond）與 nextBlk（遞迴产物）均已先建，再【父後建】 chained→es→newblk。
ps-wrap-chain = (t ast, p psst, blk i64, tail i64, linkIdx i64) (blk2 i64) {
    blk2 = blk
    tail > 0 && ps-rarrow-same-line(p) -> {

        #{overflow=wrap}
        linkIdx == 2 -> p.warn = p.warn + 1
        ps-bump(p); 消費 ->
        nextBlk, nextTail = ps-standalone-body(t, p)

        #{overflow=wrap}
        nextBlk = ps-wrap-chain(t, p, nextBlk, nextTail, linkIdx + 1)
        chained = ast.add(t, asp.K_IF_EXPRESSION)
        ast.kid-add(t, chained, tail)
        ast.kid-add(t, chained, nextBlk)
        ast.kid-add(t, chained, 0)
        es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
        ast.kid-add(t, es, chained)
        newblk = ast.add(t, asp.K_BLOCK_STATEMENT)
        ast.kid-add(t, newblk, es)
        ast.set-count(t, newblk, 0, 1)
        ast.set-slot(t, newblk, 0, ast.put-str(t, 'true')); inline
        blk2 = newblk
    }
}

; ps-mk-standalone-if：由 cond 組裝整個獨立 if-then。前置條件：目前 token 為 cond
;   之後的第一個 `->`（呼叫端已確認 ps-peek==RARROW）。對應 Go parseExpressionStatement
;   的 standalone 分支：吃 `->` → body → wrap-chain →（可能）else 分支 → 組 IfExpression。
ps-mk-standalone-if = (t ast, p psst, cond i64) (idx i64) {
    ps-bump(p); 消費 cond 之後的 ->
    blk, tail = ps-standalone-body(t, p)
    blk = ps-wrap-chain(t, p, blk, tail, 1)

    ; else 分支：`cond -> {block} -> elseBody`（罕見；链已吃光同列 -> 後仅剩此情形）
    alt = 0
    ps-rarrow-same-line(p) -> {
        ps-bump(p); 消費 ->
        ablk, altail = ps-standalone-body(t, p)
        alt = ps-wrap-chain(t, p, ablk, altail, 1)
    }
    idx = ast.add(t, asp.K_IF_EXPRESSION)
    ast.kid-add(t, idx, cond)
    ast.kid-add(t, idx, blk)
    ast.kid-add(t, idx, alt)
}

; ps-parse-type：在當前位置解析一個型別並回傳其節點索引（**子先於父**）。
;   支持：NamedType（IDENT，含限定名 `a.b.c`）、NullableType（? T，遞迴）、
;   SliceType（[] T，T 可為巢狀 `[][]T`/限定 `[]a.b`/可為空 `[]?T`）、
;   ArrayType（[ N ] T，T 亦可巢狀）。
;   明示標註一律不設 inferred（dump 不印 `inferred: true`）。回 0 = 当前位置非合法型別起點。
;   ⚠️ 限定名對齊 Go stmt.go:1034 的 `for cur==DOT { name += "." + next IDENT }`：
;      整條 `tls.conn` 存進 NamedType 的 name 槽（type-string 直接讀 s0，不另建節點）。
;   ⚠️ 巢狀元素經【遞迴】ps-parse-type 取得（子先於父），故 `[][]i64` 建為
;      SliceType{ SliceType{ NamedType{i64} } }；type-string(ast.no:610) 遞迴印 `[][]i64`。
;   ⚠️ 用 `handled` 旗標（非互斥條件）防同块多臂重評：某臂已建 idx 後，後續臂不得再跑
;      （match 非排他，實測裸條件會因前一臂已消費 token 使後臂的活 ps-peek-at 誤命中）。
ps-parse-type = (t ast, p psst) (idx i64) {
    ps-skip-trivia(p)
    tk = ps-peek-token(p)
    idx = 0
    handled = 0
    {
        handled == 0 && tk.typ == tok.IDENT -> {
            handled = 1
            ps-bump(p); 消費首段型別名
            nm = tk.lit
            go = true
            (go) {
                ps-peek(p) == tok.DOT && ps-peek-at(p, 1) == tok.IDENT -> {
                    ps-bump(p); 消費 .
                    seg = ps-lit-at(p, 0)
                    ps-bump(p); 消費 段名
                    nm = nm + '.' + seg
                }

                -> go = false
            }
            idx = ast.add(t, asp.K_NAMED_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, nm))
        }

        handled == 0 && tk.typ == tok.QUESTION -> {
            handled = 1
            ps-bump(p); 消費 ?
            pti = ps-parse-type(t, p); 內層型別（遞迴）
            idx = ast.add(t, asp.K_NULLABLE_TYPE)
            ast.kid-add(t, idx, pti); 唯一 guarded CHILD=Type
        }

        handled == 0 && tk.typ == tok.LBRACKET && ps-peek-at(p, 1) == tok.RBRACKET && (ps-peek-at(p, 2) == tok.IDENT || ps-peek-at(p, 2) == tok.LBRACKET || ps-peek-at(p, 2) == tok.QUESTION) -> {
            handled = 1
            ps-bump(p); 消費 [
            ps-bump(p); 消費 ]
            elem = ps-parse-type(t, p); 元素型別（遞迴，子先於父）
            idx = ast.add(t, asp.K_SLICE_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, idx, elem)
        }

        handled == 0 && tk.typ == tok.LBRACKET && ps-peek-at(p, 1) == tok.INT && ps-peek-at(p, 2) == tok.RBRACKET && (ps-peek-at(p, 3) == tok.IDENT || ps-peek-at(p, 3) == tok.LBRACKET || ps-peek-at(p, 3) == tok.QUESTION) -> {
            handled = 1
            ps-bump(p); 消費 [
            sz = ps-parse-expr(t, p); 尺寸 IntegerLiteral
            ps-expect(p, tok.RBRACKET); 消費 ]
            elem = ps-parse-type(t, p); 元素型別（遞迴）
            idx = ast.add(t, asp.K_ARRAY_TYPE)
            ast.set-slot(t, idx, 0, ast.put-str(t, 'false')); 明示 → inferred 不印
            ast.kid-add(t, idx, sz)
            ast.kid-add(t, idx, elem)
        }

        -> {
        }
    }
    idx
}

; ps-parse-typedecl：解析【通用明示型別宣告】`name TYPE [= value]`——補齊各特化含值臂未覆蓋的
;   複合型形（限定名 `a.b`、巢狀 `[][]T`/`[N][]T`）之裸宣告與含值兩形。裸形對應 Go parseLetStatement
;   的 no-value 分支（stmt.go:1051–1060：型別後遇陳述邊界即 Value=nil，dump 為 `type: X, value: `）；
;   含值形對應 Go 的 `= expr` 分支（dump 為 `type: X, value: <expr>`）。
;   型別經 ps-parse-type（NamedType / SliceType / ArrayType / NullableType 全形，含限定/巢狀）。
;   ⚠️ 只在【上方各特化臂都未命中】（handled==0）時由分派處呼叫：`name IDENT = v`（+2==ASSIGN）
;   由單名含值臂、`[]T=[..]`/`[N]T=[..]`/`[K]V={..}` 由對應陣列/映射特化臂先行處理（它們有 ArrayLiteral
;   /MapLiteral desugar），故本函式只接住那些臂遺漏的複合型形，RHS 一律走 ps-parse-expr。
;   ⚠️ 復用 ps-parse-type 會【先建節點】；若型別後既非 `=` 亦非陳述邊界（如索引 `x[i]`、運算子）
;   則還原 p.pos、回 0，交由運算式陳述重解——所建節點不被任何 kid 引用即為孤兒，dumper 自 root
;   沿 kid 走訪永不觸及（見 ast.dump），故零回歸、僅耗少許 arena。
ps-parse-typedecl = (t ast, p psst, name str) (idx i64) {
    idx = 0
    savePos = p.pos
    ps-bump(p); 消費 name IDENT
    ty = ps-parse-type(t, p); 明示型別（子先於父）
    ty == 0 -> p.pos = savePos
    ty != 0 -> {

        ; 預取型別之後首個 token（同 ps-parse-for-kw 守則：勿在補集雙臂各重取）
        hd = ps-peek(p)

        ; 含值形：型別後接 `=` ⇒ LetStatement{name, type, value}
        hd == tok.ASSIGN -> {
            ps-bump(p); 消費 =
            ps-skip-trivia(p)
            val = ps-parse-expr(t, p)
            idx = ast.add(t, asp.K_LET_STATEMENT)
            ast.set-slot(t, idx, 0, ast.put-str(t, name))
            ast.kid-add(t, idx, ty); guarded CHILD=Type
            ast.kid-add(t, idx, val); guarded CHILD=Value
        }

        ; 裸形：型別後為陳述邊界 ⇒ LetStatement{name, type, value:0 佔位}
        (hd == tok.NEWLINE || hd == tok.RBRACE || hd == tok.EOF || hd == tok.SEMICOLON || hd == tok.COMMENT) -> {
            idx = ast.add(t, asp.K_LET_STATEMENT)
            ast.set-slot(t, idx, 0, ast.put-str(t, name))
            ast.kid-add(t, idx, ty); guarded CHILD=Type
            ast.kid-add(t, idx, 0); guarded CHILD=Value 缺席→0 佔位（dump 印 `value: `）
        }

        ; 既非 `=` 亦非邊界：非宣告（索引/運算式）→ 還原，回 0 交運算式陳述
        (hd != tok.ASSIGN && hd != tok.NEWLINE && hd != tok.RBRACE && hd != tok.EOF && hd != tok.SEMICOLON && hd != tok.COMMENT) -> p.pos = savePos
    }
}

; ps-skip-annot-idx：鏡像 ps-parse-stmt 的 `#{...}` 群組掃描，但以【索引前視】方式（不消費
;   token）回傳跳過自索引 i 起全部相鄰 `#{...}` 群組後的索引；非 `#{` 起 ⇒ 原樣回 i。
;   深度計數：`#{ [ ( {` → +1、`} ) ]` → −1（`#{` 自身計作一個開大括號），與 ps-parse-stmt 同口徑。
ps-skip-annot-idx = (p psst, i i64) (j i64) {
    j = i
    (ps-peek-at(p, j) == tok.HASH_LBRACE) {
        depth = 1

        #{overflow=wrap}
        j = j + 1; 消費 #{
        (depth > 0) {
            t = ps-peek-at(p, j)
            {
                t == tok.EOF -> depth = 0

                t == tok.HASH_LBRACE || t == tok.LBRACE || t == tok.LBRACKET || t == tok.LPAREN -> {

                    #{overflow=wrap}
                    depth = depth + 1

                    #{overflow=wrap}
                    j = j + 1
                }

                t == tok.RBRACE || t == tok.RBRACKET || t == tok.RPAREN -> {

                    #{overflow=wrap}
                    depth = depth - 1

                    #{overflow=wrap}
                    j = j + 1
                }

                -> {

                    #{overflow=wrap}
                    j = j + 1
                }
            }
        }
    }
}

; ps-skip-annot：【消費】自目前 pos 起全部相鄰 `#{...}` 群組。用於結構體欄位尾的
;   `#{inline=…}` 等註解——`no ast`（無 -annotations）根本不渲染欄位註解 ⇒ 跳過即可。
ps-skip-annot = (p psst) {
    (ps-peek(p) == tok.HASH_LBRACE) {
        ps-bump(p); 消費 #{
        depth = 1
        (depth > 0) {
            tk = ps-peek-token(p)
            {
                tk.typ == tok.EOF -> depth = 0

                tk.typ == tok.HASH_LBRACE || tk.typ == tok.LBRACE || tk.typ == tok.LBRACKET || tk.typ == tok.LPAREN -> {

                    #{overflow=wrap}
                    depth = depth + 1
                    ps-bump(p)
                }

                tk.typ == tok.RBRACE || tk.typ == tok.RBRACKET || tk.typ == tok.RPAREN -> {

                    #{overflow=wrap}
                    depth = depth - 1
                    ps-bump(p)
                }

                -> ps-bump(p)
            }
        }
    }
}

; ps-skip-type-idx：以【索引前视】（不消費 token）復刻 ps-parse-type 的型別語法，回傳吃完整
;   條型別後的索引；非法型別起 ⇒ 回 −1（呼叫者據此拒绝）。鏡像 ps-parse-type 四形：
;   `a.b`（IDENT (.IDENT)*）、`?T`、`[]T`、`[N]T`（N=單 INT）；元素皆可遞迴 ∈ {IDENT, [, ?}。
ps-skip-type-idx = (p psst, i i64) (j i64) {
    j = -1
    t0 = ps-peek-at(p, i)

    #{overflow=wrap}
    t1 = ps-peek-at(p, i + 1)

    #{overflow=wrap}
    t2 = ps-peek-at(p, i + 2)
    {
        t0 == tok.IDENT -> {

            #{overflow=wrap}
            j = i + 1; 消費首段型別名
            go = true
            (go) {

                #{overflow=wrap}
                jp = j + 1
                ps-peek-at(p, j) == tok.DOT && ps-peek-at(p, jp) == tok.IDENT -> {

                    #{overflow=wrap}
                    j = j + 2; 消費 .段
                }

                -> go = false
            }
        }

        t0 == tok.QUESTION -> {

            #{overflow=wrap}
            qi = i + 1
            inner = ps-skip-type-idx(p, qi)
            inner >= 0 -> j = inner
        }

        t0 == tok.LBRACKET && t1 == tok.RBRACKET -> {

            #{overflow=wrap}
            ei = i + 2
            inner = ps-skip-type-idx(p, ei); []T
            inner >= 0 -> j = inner
        }

        t0 == tok.LBRACKET && t1 == tok.INT && t2 == tok.RBRACKET -> {

            #{overflow=wrap}
            ei = i + 3
            inner = ps-skip-type-idx(p, ei); [N]T
            inner >= 0 -> j = inner
        }

        -> j = -1
    }
}

; ps-is-struct-def：判斷【目前 pos=IDENT name】起是否為「乾淨」的結構體定義形
;   `name { field TYPE ... }`，TYPE ∈ {IDENT, []IDENT, [INT]IDENT}，欄位以換行或尾隨逗號分隔，
;   區塊以 } 收尾。僅作分派守衛（不消費 token）：枚舉(`a, b`)、介面(`m()`)、實作清單
;   (`name impl {`)、註解、限定型別(`a.b`)、可為空(`?T`)等一律回 0 → 交回原運算式陳述路徑（零回歸）。
ps-is-struct-def = (p psst) (r i64) {
    r = 0
    ps-peek(p) != tok.IDENT -> return
    ps-peek-at(p, 1) != tok.LBRACE -> return
    i = 2
    nfield = 0
    go = true
    (go) {
        t = ps-peek-at(p, i)
        {
            t == tok.RBRACE -> {
                go = false
                nfield > 0 -> r = 1
                nfield == 0 -> r = 0
            }

            t == tok.EOF -> {
                go = false
                r = 0
            }

            t == tok.NEWLINE -> {

                #{overflow=wrap}
                i = i + 1
            }

            t == tok.COMMENT -> {

                #{overflow=wrap}
                i = i + 1
            }

            t == tok.IDENT -> {

                #{overflow=wrap}
                i = i + 1; 消費欄位名
                ti = ps-skip-type-idx(p, i); IDENT/[]T/[N]T/?T/限定/嵌套（镜像 ps-parse-type）
                ti < 0 -> {
                    go = false
                    r = 0
                }
                ti >= 0 -> {
                    i = ti
                    i = ps-skip-annot-idx(p, i); 跳过栏位尾 `#{...}` 注解（dump 不渲染）
                    et = ps-peek-at(p, i)
                    {
                        et == tok.NEWLINE -> {

                            #{overflow=wrap}
                            i = i + 1

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        et == tok.COMMA -> {

                            #{overflow=wrap}
                            i = i + 1

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        et == tok.RBRACE -> {

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        et == tok.EOF -> {

                            #{overflow=wrap}
                            nfield = nfield + 1
                        }

                        -> {
                            go = false
                            r = 0
                        }
                    }
                }
            }

            -> {
                go = false
                r = 0
            }
        }
    }
}

; ps-parse-struct-def：把陳述位置的 `name { field TYPE ... }` 建為 StructDefinition。
;   StructDefinition：slot0=name、slot1=implements 數('0' 省略)、slot2=fields 數(OF-LEN)、
;     count0=KIDS 迭代數、kid 序=各 StructField。
;   StructField：slot0=name、slot1=arraySize(kvn '0'省略)、slot2=slice(kvb 'true')、slot3=readonly、slot4=sealed；
;     kid0=Type(子先於父)、kid1=Value(定義恒 0)。`type:` 文字由 dumper 自 kid0 合成(OF-TYPE)，不佔槽。
ps-parse-struct-def = (t ast, p psst, name str) (idx i64) {
    ps-bump(p); 消費 name IDENT
    ps-bump(p); 消費 LBRACE
    flds []i64 = with-cap(4)
    (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
        pos0 = p.pos
        ps-skip-trivia(p)
        fname = ps-lit-at(p, 0)
        ps-peek(p) == tok.IDENT -> ps-bump(p); 消費欄位名
        ps-skip-trivia(p)
        ty = 0
        arrSize = '0'
        sliceFlag = ''
        tt = ps-peek(p)
        {
            tt == tok.LBRACKET && ps-peek-at(p, 1) == tok.RBRACKET -> {
                ty = ps-parse-type(t, p); []T → SliceType
                sliceFlag = 'true'
            }

            tt == tok.LBRACKET && ps-peek-at(p, 1) == tok.INT -> {
                arrSize = ps-lit-at(p, 1); 尺寸字面量文字
                ty = ps-parse-type(t, p); [N]T → ArrayType
            }

            -> {
                ty = ps-parse-type(t, p); IDENT → NamedType
            }
        }
        ps-skip-annot(p); 欄位尾 `#{inline=…}` 註解（dump 不渲染 ⇒ 跳過）
        sf = ast.add(t, asp.K_STRUCT_FIELD)
        ast.set-slot(t, sf, 0, ast.put-str(t, fname))
        ast.set-slot(t, sf, 1, ast.put-str(t, arrSize))
        ast.set-slot(t, sf, 2, ast.put-str(t, sliceFlag))
        ast.set-slot(t, sf, 3, ast.put-str(t, ''))
        ast.set-slot(t, sf, 4, ast.put-str(t, ''))
        ast.kid-add(t, sf, ty)
        ast.kid-add(t, sf, 0)
        sf > 0 -> flds.push(sf)
        ps-skip-trivia(p)
        ps-peek(p) == tok.COMMA -> {
            ps-bump(p)
            ps-skip-trivia(p)
        }
        p.pos == pos0 -> ps-bump(p)
    }
    ps-expect(p, tok.RBRACE)
    idx = ast.add(t, asp.K_STRUCT_DEFINITION)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    ast.set-slot(t, idx, 1, ast.put-str(t, '0')); implements 數 → 0（省略）
    ast.set-slot(t, idx, 2, ast.put-str(t, flds.len().to-str())); fields 數（OF-LEN）
    ast.set-count(t, idx, 0, flds.len()); KIDS 迭代數
    m = 0
    (m < flds.len()) {
        ast.kid-add(t, idx, flds[m])

        #{overflow=wrap}
        m = m + 1
    }
    idx
}

; ps-parse-param：解析一個參數 `name [type]`（型別可為 NamedType / NullableType / SliceType）
ps-parse-param = (t ast, p psst) (idx i64) {
    idx = 0
    tk = ps-peek-token(p)
    tk.typ != tok.IDENT -> return
    pname = tk.lit
    ps-bump(p); 消費參數名
    typ = 0
    nxt = ps-peek-token(p)
    nxt.typ == tok.IDENT || nxt.typ == tok.QUESTION || nxt.typ == tok.LBRACKET -> {
        typ = ps-parse-type(t, p)
    }
    idx = ast.add(t, asp.K_PARAMETER)
    ast.set-slot(t, idx, 0, ast.put-str(t, pname))

    ; ⚠️ Parameter spec 有兩個 guarded CHILD（Type、DefaultExpr），dumper 是**位置式**讀 kid0/kid0+1；
    ;   少 push 一槽 ⇒ kid0+1 读到下一個全域 kid（如 body 的 Identifier）⇒ 多出一個幽靈子節點。
    ;   Nolang 形 `name [type]` 無預設值 ⇒ DefaultExpr 恒 0；Type 缺席時也 push 0 佔位。
    ast.kid-add(t, idx, typ)
    ast.kid-add(t, idx, 0)
    idx
}

; ps-parse-block：解析 `{ stmts }`（同 parse：子節點全建完才 add 父節點）
ps-parse-block = (t ast, p psst) (idx i64) {
    stmts []i64 = with-cap(4)
    trail []i64 = with-cap(4)
    prev = 0
    docId = 0
    ps-trail-region(p) == 1 -> ps-collect-tail(t, p, 0, trail)
    ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, 0)
    (ps-peek(p) != tok.RBRACE && ps-peek(p) != tok.EOF) {
        pos0 = p.pos
        s = ps-parse-stmt(t, p)
        s > 0 -> {
            docId != 0 -> ast.set-doc(t, s, docId)
            stmts.push(s)
            prev = s
        }
        p.pos == pos0 -> ps-bump(p)
        ps-trail-region(p) == 1 -> ps-collect-tail(t, p, prev, trail)
        ps-trail-region(p) == 0 -> docId = ps-skip-trivia-doc(t, p, prev)
    }
    idx = ast.add(t, asp.K_BLOCK_STATEMENT)
    j = 0
    (j < stmts.len()) {
        ast.kid-add(t, idx, stmts[j])

        #{overflow=wrap}
        j = j + 1
    }
    ast.set-count(t, idx, 0, stmts.len())
    ps-attach-trailing(t, idx, trail)
    idx
}

; ps-parse-if：解析 `if cond { ... } [else { ... }]`
;   ⚠️ Oracle 在 expr.go::parseIfExpression 每遇到一個 if 關鍵字就 saveWarning 一次；
;     需同步 p.warn 的計數，Program 的 dump 才能出現 `warnings: N`。
;   ⚠️ ELIF 舆 `if/else` 共享同一入口（Go 将 elif desugar 为 else { if ... }），
;     本增量先不支援 ELIF（待下一個 t14）。
;   ⚠️ spec CHILD 數 = 3 (Condition/Consequence/Alternative)——缺 Alternative
;     時也要 push 0 占位（否則 dumper 的 cur 指標會跟 kid 陣列位置錯位）。
ps-parse-if = (t ast, p psst) (idx i64) {

    ; 消費 if 關鍵字 + 记一笔警告
    ps-bump(p)

    #{overflow=wrap}
    p.warn = p.warn + 1

    ; 條件運算式（LOWEST 優先級，與 Go parseExpression(LOWEST) 一致）
    cond = ps-parse-expr(t, p)

    ; 條件到 LBRACE 之間可能有 NEWLINE/COMMENT——一律跳過
    ps-skip-trivia(p)
    ps-expect(p, tok.LBRACE)
    then = ps-parse-block(t, p)
    ps-expect(p, tok.RBRACE)

    ; 探測 else（允许 `}\nelse {` 或 `} else {`）
    ; Go 端先跳 NEWLINE 再检查 ELSE，此处同构
    ps-skip-trivia(p)
    alt = 0
    ps-peek(p) == tok.ELSE -> {
        ps-bump(p)
        ps-skip-trivia(p)
        ps-expect(p, tok.LBRACE)
        alt = ps-parse-block(t, p)
        ps-expect(p, tok.RBRACE)
    }

    ; arena：先建 cond/then/alt 子樹，再建父，依序 kid-add
    idx = ast.add(t, asp.K_IF_EXPRESSION)
    ast.kid-add(t, idx, cond)
    ast.kid-add(t, idx, then)
    ast.kid-add(t, idx, alt)
    idx
}

; ═══ match desugar（明示形 `subj: { pat -> body … }`）═══════════════════
; 見設計文檔 §6.3。bin/no 於 parse 期就將 match 展開為 if/else 鏈（非 SurfaceMatch）。
; 範圍：識別元主體、字面量/識別元/wildcard 型樣、運算式/區塊臂、if/else 鏈。
; 延後：守衛、option/enum 完整型樣、複雜主體（呼叫/索引）。

; ps-mk-ident：建 Identifier 葉節點（僅 slot0=name）——供 desugar 多处複用運算元
ps-mk-ident = (t ast, name str) (idx i64) {
    idx = ast.add(t, asp.K_IDENTIFIER)
    ast.set-slot(t, idx, 0, ast.put-str(t, name))
    idx
}

; ps-mk-it-let：建 `it = subj` 合成 LetStatement（synthetic: true、無 Type）
;   dump：LetStatement{name: it, value: subj, synthetic: true} + kid[0=Type(0),1=Ident]
ps-mk-it-let = (t ast, subj str) (idx i64) {
    val = ps-mk-ident(t, subj)
    idx = ast.add(t, asp.K_LET_STATEMENT)
    ast.set-slot(t, idx, 0, ast.put-str(t, 'it'))
    ast.set-slot(t, idx, 1, ast.put-str(t, 'true')); synthetic
    ast.kid-add(t, idx, 0); Type 缺席→0 佔位（守 guarded-CHILD 位置）
    ast.kid-add(t, idx, val)
    idx
}

; ps-mk-true：wildcard 條件 = IntegerLiteral{value: 1}（無 raw，故不印 raw）
ps-mk-true = (t ast) (idx i64) {
    idx = ast.add(t, asp.K_INTEGER_LITERAL)
    ast.set-slot(t, idx, 0, ast.put-str(t, '1'))
    ast.set-slot(t, idx, 1, ast.put-str(t, ''))
    idx
}

; ps-mk-eq：InfixExpression{==}[l, r]（l/r 必須已完整建成）
ps-mk-eq = (t ast, l i64, r i64) (idx i64) {
    idx = ast.add(t, asp.K_INFIX_EXPRESSION)
    ast.set-slot(t, idx, 0, ast.put-str(t, '=='))
    ast.kid-add(t, idx, l)
    ast.kid-add(t, idx, r)
    idx
}

; ps-parse-match：解析 `subj: { pat -> body … }` 的**臂區**（已消費 `:` 與 `{`），
;   停在閉合 `}` 前（呼叫端 ps-expect(RBRACE)）。desugar 為 if/else 鏈：
;   • 非 wildcard 臂：cond = subj==pat，consequence = 臂區塊（先塞 it 合成綁定）
;   • wildcard `_`：其區塊直接作前一 if 的 alternative
;   • 相鄰非 wildcard 臂：後臂包成 else 區塊 BlockStatement{}[ExpressionStatement{if}]
;   ⚠️ arena 共享 kids 游標（add 設 kid0=kids.len）→ 父節點務必最後 add、再 kid-add。
ps-parse-match = (t ast, p psst, subj str) (idx i64) {
    wildA []i64 = with-cap(4)
    patA []i64 = with-cap(4)
    blkA []i64 = with-cap(4)
    ps-skip-trivia(p)
    (ps-peek(p) != tok.RBRACE) {
        pos0 = p.pos

        ; 型樣：`_` → wildcard；否則解析成表達式（int/float/bool/str/char/ident）
        ; ⚠️ 用快照 at 令兩臂互斥（ps-peek 随位置重评会误触发，見 ps.no LBRACKET 臂同构写法）
        wild = 0
        pat = 0
        at = ps-peek(p)
        {
            at == tok.UNDERSCORE -> {
                ps-bump(p)
                wild = 1
            }

            at != tok.UNDERSCORE -> {
                pat = ps-parse-expr-prec(t, p, 0)
            }
        }
        ps-skip-trivia(p)
        ps-expect(p, tok.RARROW)
        ps-skip-trivia(p)

        ; 先完整建成 it 合成綁定 + body（父後建、kid 區段才不與子樹重疊）
        itl = ps-mk-it-let(t, subj)
        kids []i64 = with-cap(4)
        kids.push(itl)
        inline = 0
        hd2 = 0
        ps-peek(p) == tok.LBRACE -> {

            ; 區塊臂（非內聯）：展開 `{
            ps-bump(p)
            ps-skip-trivia(p)
            (ps-peek(p) != tok.RBRACE) {
                s0 = p.pos
                s = ps-parse-stmt(t, p)
                s > 0 -> kids.push(s)
                p.pos == s0 -> ps-bump(p)
                ps-skip-trivia(p)
            }
            ps-expect(p, tok.RBRACE)
            hd2 = 1
        }
        hd2 == 0 -> {

            ; 運算式臂（內聯）：BlockStatement{inline: true}[it, ExpressionStatement{e}]
            e = ps-parse-expr-prec(t, p, 0)
            es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
            ast.kid-add(t, es, e)
            kids.push(es)
            inline = 1
        }

        ; 父後建：先 add blk，再依序 kid-add 已建好的子節點
        blk = ast.add(t, asp.K_BLOCK_STATEMENT)
        j = 0
        (j < kids.len()) {
            ast.kid-add(t, blk, kids[j])

            #{overflow=wrap}
            j = j + 1
        }
        ast.set-count(t, blk, 0, kids.len())
        inline == 1 -> ast.set-slot(t, blk, 0, ast.put-str(t, 'true'))
        wildA.push(wild)
        patA.push(pat)
        blkA.push(blk)
        p.pos == pos0 -> ps-bump(p)
        ps-skip-trivia(p)
    }

    ; 由末臂往回組 if/else 鏈
    res = 0

    #{overflow=wrap}
    i = blkA.len() - 1
    (i >= 0) {

        #{index-out=zero}
        w = wildA[i]

        #{index-out=zero}
        b = blkA[i]
        hd3 = 0
        w == 1 -> {

            ; wildcard：其區塊直接作前一 if 的 alternative
            res = b
            hd3 = 1
        }
        hd3 == 0 -> {

            #{index-out=zero}
            cond = ps-mk-eq(t, ps-mk-ident(t, subj), patA[i])

            ; 決定 alternative
            alt = 0
            hd4 = 0
            res > 0 && ast.kind-at(t, res) == asp.K_IF_EXPRESSION -> {

                ; 後臂是 if → 包成非內聯 else 區塊 [ExpressionStatement{if}]
                es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
                ast.kid-add(t, es, res)
                wb = ast.add(t, asp.K_BLOCK_STATEMENT)
                ast.kid-add(t, wb, es)
                ast.set-count(t, wb, 0, 1)
                alt = wb
                hd4 = 1
            }
            res > 0 && hd4 == 0 -> alt = res

            ; 父後建
            ie = ast.add(t, asp.K_IF_EXPRESSION)
            ast.kid-add(t, ie, cond)
            ast.kid-add(t, ie, b)
            ast.kid-add(t, ie, alt)
            res = ie
        }

        #{overflow=wrap}
        i = i - 1
    }

    ; 若最外層只是 wildcard 區塊（無 if 包裹，如 `z: { _ -> 0 }`）→ 包成 if(cond=true){blk}
    res > 0 && ast.kind-at(t, res) == asp.K_BLOCK_STATEMENT -> {
        cond = ps-mk-true(t)
        ie = ast.add(t, asp.K_IF_EXPRESSION)
        ast.kid-add(t, ie, cond)
        ast.kid-add(t, ie, res)
        ast.kid-add(t, ie, 0)
        res = ie
    }
    idx = res
}
