                es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
                ast.kid-add(t, es, res)
                wb = ast.add(t, asp.K_BLOCK_STATEMENT)
                ast.kid-add(t, wb, es)
                ast.set-count(t, wb, 0, 1)
                alt = wb
                hd4 = 1
