            bn = 'it'
            bname != '' -> bn = bname
            bname != '' -> {
                reg = elem
                isenum == 1 -> reg = st0
                kvar == 'err' && isenum == 0 -> reg = 'str'
                bt != '' && bt != 'ok' && bt != 'err' && bt != 'nil' -> reg = bt
            }
            itl = 0
            hd5 = 0
            dead == 0 && (bt != '' || bname != '') -> {
                itl = ps-mk-it-let-t(t, subjNode, bt, bn)
                hd5 = 1
            }
            dead == 0 && hd5 == 0 -> itl = ps-mk-it-let(t, subjNode)

