                bt = 'ok'
                bname != '' -> {
                    pt = ps-enum-payload(p, st0, 'ok')
                    pt != '' -> bt = pt
                }
            }
            isenum == 1 && kvarE != '' -> {
                bt = kvarE
                pt2 = ps-enum-payload(p, st0, kvarE)
                pt2 != '' -> bt = pt2
            }
            isenum == 1 && wild == 1 && kvar == '' && kvarE == '' -> {

                ; 補集 = 登記序變體 − 已列變體臂（Go :2189-2208）；空 ⇒ 死臂 skipItBinding
                bt = ''
                i2 = 0
                (i2 < evs.len()) {
                    hit2 = 0
                    q2 = 0
                    (q2 < cN.len() && hit2 == 0) {

                        #{index-out=zero}
                        cN[q2].copy() == evs[i2] &&
(cA[q2] == -1 ||
cA[q2] == ps-enum-ncols(p, st0, evs[i2])) -> hit2 = 1

                        #{overflow=wrap}
                        q2 = q2 + 1
