            dead = 0
            sopt == 1 && kvar == 'err' -> bt = 'err'
            sopt == 1 && kvar == 'nil' -> bt = 'nil'
            sopt == 1 && kvar == 'ok' -> bt = elem
            sopt == 1 && wild == 1 -> {

                #{index-out=zero}
