    res = 0

    #{overflow=wrap}
    i = blkA.len() - 1
    (i >= 0) {

        #{index-out=zero}
        w = wildA[i]

        #{index-out=zero}
        b = blkA[i]
        hd3 = 0
        w == 1 -> {

            ; wildcard：其區塊直接作前一 if 的 alternative
