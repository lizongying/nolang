        i = i - 1
    }

    ; 若最外層只是 wildcard 區塊（無 if 包裹，如 `z: { _ -> 0 }`）→ 包成 if(cond=true){blk}
    res > 0 && ast.kind-at(t, res) == asp.K_BLOCK_STATEMENT -> {
        cond = ps-mk-true(t)
        ie = ast.add(t, asp.K_IF_EXPRESSION)
        ast.kid-add(t, ie, cond)
        ast.kid-add(t, ie, res)
        ast.kid-add(t, ie, 0)
        res = ie
    }
    ; s66c：開關開 ⇒ 改發 SurfaceMatch（對齊 L2 oracle，收斂 98% match 表示分歧）。
    ;   與 desugar 共用臂資料；surface 形【不】注入合成 it（it 直接寫在臂體，見 step ③）。
    PS-SURFACE-MATCH == 1 -> {
        n = blkA.len()
        sm = ast.add(t, asp.K_SURFACE_MATCH)
        ast.set-slot(t, sm, 0, ast.put-str(t, n.to-str())); arms 數
        ast.kid-add(t, sm, subjNode); Matched（guarded：本函數必有主體節點）
        ast.helper-begin(t, sm, n)
        i = 0
        (i < n) {
            ; 12 aux / 臂：binding, bindingVariant, typePattern, typeBinding,
            ;   wildcard, dotVal, rawCond, blockBody, typeArm, valueCtx, Condition, Body
            ba = bindA[i]
            ba != '' -> ast.aux-add(t, ast.put-str(t, ba))
            ba == '' -> ast.aux-add(t, 0); binding
            bv = bvarA[i]
            bv != '' -> ast.aux-add(t, ast.put-str(t, bv))
            bv == '' -> ast.aux-add(t, 0); bindingVariant（ok(v)⇒ok / err(e)⇒err）
            tp = tpatA[i]
            tp != '' -> ast.aux-add(t, ast.put-str(t, tp))
            tp == '' -> ast.aux-add(t, 0); typePattern（s7 續：`v T ->` 型別臂）
            tn = tbndA[i]
            tn != '' -> ast.aux-add(t, ast.put-str(t, tn))
            tn == '' -> ast.aux-add(t, 0); typeBinding
            swA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            swA[i] == 0 -> ast.aux-add(t, 0); wildcard
            dotValA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            dotValA[i] == 0 -> ast.aux-add(t, 0); dotVal
            rawA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            rawA[i] == 0 -> ast.aux-add(t, 0); rawCond
            bbA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            bbA[i] == 0 -> ast.aux-add(t, 0); blockBody（區塊臂⇒true，對齊 oracle）
            tarmA[i] == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            tarmA[i] == 0 -> ast.aux-add(t, 0); typeArm（s7 續）
            mv == 1 -> ast.aux-add(t, ast.put-str(t, 'true'))
            mv == 0 -> ast.aux-add(t, 0); valueCtx（值語境：入函快照 mv，見函頭 s67 讀點修正）
            ast.aux-add(t, condA[i]); Condition（型樣節點；wildcard/关键字臂=0）
            ast.aux-add(t, blkSA[i]); Body
            #{overflow=wrap}
            i = i + 1
        }
        res = sm
    }
    p.inMatch = oldMat
    idx = res
}
