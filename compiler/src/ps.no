            hd3 = 1
        }
            hd3 == 0 -> {

                #{index-out=zero}
                rawA[i] == 1 -> cond = patA[i]; s66d：raw-cond 臂直接用條件式（不包 subj ==）
                rawA[i] == 0 -> cond = ps-mk-eq(t, subjNode, patA[i])

