                ;   IsBlockBody 保持 false、IsInline=true。舊缺陷：一律 hd2=1 非 inline
                ;   ⇒ err-binding.no / match-arm-binding-scope.no blockBody 過度標記。
                ;   非 blockMatch（scanned==0）普通大括號臂體不變：IsBlockBody=true、非 inline。
                scanned == 1 -> {
                    hd2 = 0
                    inline = 1
                }
                scanned == 0 -> hd2 = 1
