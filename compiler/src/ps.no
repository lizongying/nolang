                ;   續接拆成 if 鏈（ExpressionStatement{IfExpression}）且臂體打了 blockBody。
                ;   僅 PS-SURFACE-MATCH=1 啟用；flag=0 維持舊塊解析（A/B 基線逐位元組不動）。
                nested = 0
                scanned = 0
                nsave = p.pos
                PS-SURFACE-MATCH == 1 && ps-arm-blk-match(p) == 1 -> {
                    scanned = 1; s7 續 H：blockMatch 分類旗標
                    nested = ps-parse-bare-match(t, p)
                }
                nested > 0 -> {
                    es = ast.add(t, asp.K_EXPRESSION_STATEMENT)
                    ast.kid-add(t, es, nested)
                    kids.push(es)
                    inline = 1; oracle IsInline=true（inline 形）
                    hd2 = 0; oracle：blockMatch 體成功 ⇒ **無** blockBody
