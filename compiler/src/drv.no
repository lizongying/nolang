; drv — CLI 分派（noc 的入口邏輯）
;
; M0 範圍：version / help 可用；tokens / ast / build 是明確的「未實作」骨架，
; 以 rc=EXIT-NOTIMPL(3) 退出——讓差分 harness 能把「未實作」與「失敗」分開。
; ⚠️ 上述是 M0 歷史記述：tokens / ast / vet 早已落地；2026-11-12（M4-d，§11 後 ⑧）
;    build / run 亦已接線——自產 `.ll` → link.compile 調 clang（DR-2）。
;    EXIT-NOTIMPL 目前只剩給未列出的子命令骨架用，build 不再走 drv.not-implemented。
;
; 退出碼約定：
;   0  EXIT-OK          成功
;   1  EXIT-FAIL        一般失敗（編譯錯誤等）
;   2  EXIT-USAGE       用法錯誤（未知子命令 / 缺參數）
;   3  EXIT-NOTIMPL     尚未實作的子命令（M0 佔位）
;
; ⚠️ SHS：無模組級可變狀態、無一等函式值、無指針。

; ⚠️ 導入寫 `# /compiler/src/lx`（**模組**形式），呼叫寫 lx.dump(...)。
;    `# /path/mod.Type` 是【型別】導入形式（配 `<Type>.<method>` 呼叫）；
;    lx.no 沒有宣告結構體，用型別形式會得到 `unknown callee lx.dump`。

# /compiler/src/lx
# /compiler/src/ast
# /compiler/src/ps
# /compiler/src/asp
# /compiler/src/diag
# /compiler/src/ck
# /compiler/src/ck-sig
# /compiler/src/mir
# /compiler/src/cg
# /compiler/src/cg-runtime
# /compiler/src/cg-rc
# /compiler/src/h2m
# /compiler/src/link
# /compiler/src/util/sb.sb

; ⚠️ 本檔的 drv.* 是**含點的自由函式**（沒有宣告 struct drv），因此受 SHS S6
;    約束：每個定義的 out-param 至多 1 個，否則執行期 SIGSEGV。見 docs 附錄 A.6。

EXIT-OK = 0
EXIT-FAIL = 1
EXIT-USAGE = 2
EXIT-NOTIMPL = 3

NOC-NAME = 'noc'
NOC-VERSION = 'v0.0.1-m0'

; 功能待補充
; r: 結果字串
drv.name = () (r str) {
    r = NOC-NAME
}

; 功能待補充
; r: 結果字串
drv.version = () (r str) {
    r = NOC-VERSION
}

; 打印用法
drv.usage = () {
    print(NOC-NAME - ' — Nolang compiler (self-hosted, M0 skeleton)')
    print('')
    print('Usage: noc <command> [args]')
    print('')
    print('Commands:')
    print('  version            print version')
    print('  help               print this help')
    print('  tokens <file>      dump token stream (not implemented in M0)')
    print('  ast <file>         dump AST (not implemented in M0)')
    print('  vet <file>         run diagnostics (M3-c skeleton: syntax errors + not-defined family)')
    print('  build [-o OUT] <file>   compile to executable via clang (M4-d: self-produced .ll)')
    print('  run [-o OUT] <file>     build, then execute the produced binary (M4-d)')
}

; 功能待補充
drv.cmd-version = () {
    print(NOC-NAME - ' ' - NOC-VERSION)
}

; 統一的「未實作」出口
; what: 字串
; code: 狀態碼
drv.not-implemented = (what str) (code i64) {
    eprint(NOC-NAME - ': command "' - what - '" is not implemented yet (M0 skeleton)')
    code = EXIT-NOTIMPL
}

; dump 詞法 token 流
; 輸出格式與 L1 oracle 逐位元組相同（見 compiler/src/lx.no 檔頭）。
; ⚠️ 不要用 print 印「已帶尾端 \n 的字串」——print 自己會補一個 \n，
;    那會多出一個空行。lx.dump 回的字串刻意**不帶**尾端 \n。
; code: 狀態碼
drv.cmd-tokens = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': tokens requires a file argument')
        code = EXIT-USAGE
        return
    }
    opt-path = args.get(2)
    path = ''
    opt-path: {
        ok -> path = it

        -> _
    }

    ; ⚠️ 必須用 read-bytes + to-bytes-str，**不能**用 fs.read-str：
    ;    fs.read-str 最終呼叫 []byte.to-str()，而該方法（2026-09-06 起）
    ;    是「byte → 碼點 → UTF-8 重新編碼」，對 >= 0x80 的位元組會二次編碼。
    ;    實測：5 位元組檔 `; \xe7\xbb\xbc\n` 讀進來變成 15 位元組
    ;    （每個高位元組變成 4 位元組）。詞法分析器必須看到**原始位元組**。
    ;    見 docs/design/nolang-selfhost.md §8 P0-⑥。
    ; ⚠️ nil = **檔案存在但長度為 0**（實測：fs.read-bytes 對 0 位元組檔回 nil，
    ;    對不存在的路徑回 err）。空檔案是**合法**原始碼（詞法分析器應吐單一 EOF），
    ;    所以 nil **不是**錯誤。不處理的話 `noc tokens <空檔>` 會 rc=1 而 oracle rc=0
    ;    ⇒ L1 假 DIFF（語料中目前沒有空檔，故此缺陷目前是**潛伏**的）。
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok -> {
            src = it
            got = true
        }

        nil -> {
            got = true
        }

        err -> {
        }
    }
    got == false -> {
        eprint(NOC-NAME - ': cannot read ' - path)
        code = EXIT-FAIL
        return
    }
    print(lx.dump(src))
}

; 解析並 dump AST（M2）
; 輸出與 L2 oracle `no ast <file>` 逐位元組相同（見 compiler/src/ast.no 檔頭）。
; 讀檔走 read-bytes + to-bytes-str（與 cmd-tokens 同理由，§8 P0-⑥）。
; code: 狀態碼
drv.cmd-ast = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': ast requires a file argument')
        code = EXIT-USAGE
        return
    }
    opt-path = args.get(2)
    path = ''
    opt-path: {
        ok -> path = it

        -> _
    }
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok -> {
            src = it
            got = true
        }

        nil -> {
            got = true
        }

        err -> {
        }
    }
    got == false -> {
        eprint(NOC-NAME - ': cannot read ' - path)
        code = EXIT-FAIL
        return
    }
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)
    out = ast.dump(t, root)
    print(out)
}

; 執行診斷檢查（M3-a 骨架＋s10 語法錯誤首族）
; 輸出契約錨定 oracle `no vet <file>`（authority：Go printLintResults，src/cmd/no/main.go）：
;   無診斷        ⇒ stdout 'No issues found.'，rc=0
;   檔案不存在    ⇒ stderr 'Error: stat <path>: no such file or directory'，rc=1
;   有診斷        ⇒ 每條 <file>:<line>:<col>: [LEVEL] <src>: <msg> [<code>] （stdout），
;                  摘要「\nN error(s), W warning(s), H hint(s)」走 stderr；rc=1（鉗制，見下）
;   s10 起的診斷源 = ps.no 的語法錯誤收集器（三站點：分組缺 RPAREN、實參缺逗號、
;   let RHS 落空）；checker 未實作 ⇒ WARNING/HINT 恆 0，LINT 族留 M3-c 後續增量。
; code: 狀態碼
drv.cmd-vet = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': vet requires a file argument')
        code = EXIT-USAGE
        return
    }
    opt-path = args.get(2)
    path = ''
    opt-path: {
        ok -> path = it

        -> _
    }

    ; 讀檔走 read-bytes + ok/nil/err 三臂（與 cmd-tokens 同理由，§8 P0-⑥）：
    ;   nil = 存在但 0 位元組（合法空檔，oracle 回 No issues found.）
    ;   err = 路徑不存在 ⇒ 覆刻 oracle 的 os.Stat ENOENT 文案
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok -> {
            src = it
            got = true
        }

        nil -> {
            got = true
        }

        err -> {
            eprint('Error: stat ' - path - ': no such file or directory')
            code = EXIT-FAIL
        }
    }
    got == false -> {
        return
    }

    ; 跑完整前端，保證 vet 與 ast 共用同一條 parse 路徑；
    ; ps.no 的語法錯誤收集器（s10/M3-c 首族）掛在 parse 期間。
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)

    ; s13：checker 骨架首族 `'X' is not defined`（ck.no，TraceID 4bek3xc6）。
    ;   正主 runParseGate 語義（p90 實證）：有 parse 錯 ⇒ checker 整族跳過。
    ;   診斷順序：ps 錯誤在前、ck 在後（各自內部按構造序），摘要計數合併。
    ;   ck↔drv 介面 = 打包串 vec 'L|C|CODE|MSG'（結構體跨模組按值傳參觸 MIR 坑，s13 實證）。
    ck-out []str = with-cap(4)
    ps-errs = ps.ps-err-count(p)
    ps-errs == 0 -> {
        ck-out = ck.check(t, path)
    }

    ; s10：渲染 ps 收集的語法錯誤。契約（authority Go printLintResults）：
    ;   每條診斷 stdout：render 行形（file=被 vet 的路徑；parser 錯誤無跨檔歸屬）
    ;   有診斷：stderr 摘要「\nN error(s), W warning(s), H hint(s)」
    ;     （Go `return errorCount` 是函式內值；caller vet 端 `if errorCount > 0 { os.Exit(1) }`
    ;      ——實測 3 錯檔 rc=1，行程退出碼恆鉗制為 1；本族只產 ERROR ⇒ W/H 恆 0）
    ;   無診斷：stdout 'No issues found.'，rc=0
    nerr = 0
    i = 0
    (i < ps-errs) {
        d = diag{
            file: path
            line: 0
            col: 0
            level: 2
            src: 'nolang-compile'
            msg: ''
            code: 'E_GENERAL'
        }
        d.line = p.e-ln[i]
        d.col = p.e-cl[i]
        d.msg = p.e-msg[i]
        d.code = p.e-code[i]
        print(d.render())

        #{overflow=wrap}
        nerr = nerr + 1

        #{overflow=wrap}
        i = i + 1
    }

    ; s13：渲染 ck 的 not-defined 診斷。ck↔drv 介面 = 打包串 vec，每條 'L|C|CODE|MSG'
    ;   （前 3 段以 '|' 分隔且無歧義：L/C 為十進制、CODE 為 TraceID；MSG 可含 '|'）。
    i = 0
    (i < ck-out.len()) {
        raw = ck.ck-str-at(ck-out, i)

        ; 逐段切：L | C | CODE | 余下整段作 MSG
        p1 = raw.index('|')
        ln-part = ''
        rest = ''
        p1 > 0 -> {
            ln-part = raw.slice-bytes(0, p1)
            rest = raw.slice-bytes(p1 + 1, raw.len-bytes())
        }
        p2 = rest.index('|')
        cl-part = ''
        rest2 = ''
        p2 > 0 -> {
            cl-part = rest.slice-bytes(0, p2)
            rest2 = rest.slice-bytes(p2 + 1, rest.len-bytes())
        }
        p3 = rest2.index('|')
        code-part = rest2
        msg-part = ''
        p3 > 0 -> {
            code-part = rest2.slice-bytes(0, p3)
            msg-part = rest2.slice-bytes(p3 + 1, rest2.len-bytes())
        }

        d = diag{
            file: path
            line: 0
            col: 0
            level: 2
            src: 'nolang-compile'
            msg: ''
            code: 'E_GENERAL'
        }
        d.line = ln-part.to-i64()
        d.col = cl-part.to-i64()
        d.code = code-part
        d.msg = msg-part
        print(d.render())

        #{overflow=wrap}
        nerr = nerr + 1

        #{overflow=wrap}
        i = i + 1
    }
    nerr > 0 -> {
        eprint('')
        eprint(nerr.to-str() - ' error(s), 0 warning(s), 0 hint(s)')
    }

    nerr == 0 -> {
        print('No issues found.')
    }

    ; rc 鉗制：對齊 Go vet caller `errorCount > 0 ⇒ os.Exit(1)`（main.go:3328-3332）
    nerr > 0 -> {
        code = 1
    }
}

; ═══════════════════════════════════════════════════════════════════
; M4-d（2026-11-12，§11 後 ⑧）：build / run 接線
; ═══════════════════════════════════════════════════════════════════
; 鏈路：read-bytes → ast.make/ps.new/ps.parse → h2m-lower-module（合成 @main）
;       → cg-runtime-prelude-full() + body = 完整 .ll → link.compile（clang -x ir）
; ⚠️ 與 §5.7 M5 的界線：本件**不做** workspace / package / `#` 導入合併／target 解析／快取；
;    只處理「單一 .no 檔、SHS 子集」。頂層內建呼叫（print 等）、模組導入、
;    跨函式讀頂層 let 全局都計 unsup ⇒ 誠實 rc=1，不靜默產出錯碼。
; ⚠️ SHS S6：以下 drv.* 皆含點自由函式 ⇒ 每個 out-param 至多 1 個。

; 純函式：原始位元組 → 完整 LLVM IR 模組文字（L0 可直接斷言，不碰檔案／行程）
; src: 原始碼位元組（**不得**用 fs.read-str，見 §8 P0-⑥ 的二次編碼陷阱）
; r: 完整 .ll；'' = 降級不支援（已 eprint 診斷）
drv.build-ll = (src []byte) (r str) {
    r = ''
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)
    agg = h2m-new()
    body = h2m-lower-module(t, agg, root)
    agg.unsup > 0 -> {
        eprint(NOC-NAME - ': unsupported constructs: ' - agg.unsup.to-str() - ' (M4-d SHS subset)')
        return
    }
    body == '' -> {
        eprint(NOC-NAME - ': no code generated')
        return
    }
    b = sb.init(32768)
    b.push(cg-runtime-prelude-full())
    b.push('\n')
    b.push(body)
    b.push('\n')
    r = b.str()
}

; ═══════════════════════════════════════════════════════════════════
; ⑭ 切片 2（2026-11-13）：`#` 模組導入解析——整包載入器（入口 → 依序模組清單）
;   路徑解析（④）：`# /X` 去前導 `/`；尾 `.sb` ⇒ `.no`；尾 `/` ⇒ `main.no`；否則補 `.no`。
;   ⚠️ 僅處理 compiler 單包；跨包 / workspace 合併留待 M5 後續（⑫）。
;   遞迴 + cycle 檢測：祖先鏈 pathchain（str，`:`-分隔）防真循環；r 清單兼作 diamond 去重；cyc 截斷。
;   本件只回傳「依序模組路徑清單（str，`:`-分隔，前置 cycle 旗標 0:/1:）」，
;   不含 (ast, root)——後者留待切片 2b。
;
;   ⚠️ 本輪實踩的兩個 self-host codegen / API 坑（都修掉了）：
;   ① bug #85 兄弟模組常數陷阱：drv.build-package 內部呼叫 ps.parse，而 ps.parse 依賴的兄弟模組
;      （lx/tok/asp/…）頂層常數，只有在「入口檔直接 import」這些模組時才會生成（drv-build-test.no:11
;      同款註釋）。若入口只 import drv（或只 import ast+ps），codegen 會報
;      `func parse: consumer reads value 0`。⇨ 所有呼叫 build-package 的測試必須直接 import 全套
;      傳遞依賴（與 drv-build-test.no 同款 import 區塊）。
;   ② AST 子節點迭代 API：kid-at 吃「扁平 kids 陣列的位置索引」，不是 (node, k)。必須先 nd-at 取
;      rootnd.kid0（基址）與 rootnd.nkid（子數），再 kid-at(t, base + k)。原 3 參版 kid-at(t, root, k)
;      會把 root 當位置索引、k 被吞，讀到錯節點甚至越界 → SIGTRAP（trace/BPT trap）。
;   ③ cycle 檢測：早期用 seen 集（任何重複都報 cycle）會對 diamond（A→B, A→C→B）誤報 cycle；
;      改為 pathchain（祖先鏈）參數，只在「重訪節點落在祖先鏈上」時才報真循環。
;   設計權衡（仍成立）：全程 str 串接累積（r / pathchain），不對 []str 下標；build-package 回傳單一
;     str，bp-walk 回傳單一 bpctx struct（欄位皆 str / bool）；membership 用 str.contains。
; ═══════════════════════════════════════════════════════════════════

; bp-walk 共享上下文（str 欄位，避免 []str 下標）：
;   r：依序模組路徑清單，`:`-分隔（首項前也有 `:`）；同時兼作「已處理」集合（diamond 去重）
;   cyc：本子樹是否觸發 cycle
;   ⚠️ cycle 檢測改用「祖先鏈 pathchain」參數（見 bp-walk），不靠 seen：
;      重複訪問若落在祖先鏈上＝真循環；若只是已在 r 清單中＝diamond（無環，跳過不報）。
bpctx {
    r str
    cyc bool
}

; 入口 .no 檔路徑 → 依賴順序的模組路徑清單（`:`-分隔，前置 cycle 旗標 0:/1:）。
;   path: 入口檔（相對 cwd = workspace 根）
;   r: `0:`/`1:` + `:`-分隔模組路徑（入口在最前）；'' = 失敗（已 eprint）
drv.build-package = (path str) (r str) {
    c = bpctx{
        r: ''
        cyc: false
    }
    c = drv.bp-walk(path, c, ':')
    flag = '0'
    c.cyc == true -> flag = '1'

    ; 輸出：`0:`/`1:` + `:`-分隔模組路徑（入口在最前）
    result = flag - ':' - c.r
    r = result
}

; 整包結果是否含某模組路徑（str 子串比對，免 []str 下標）
drv.pkg-contains = (mods str, want str) (r bool) {
    wsep = ':' - want - ':'
    r = mods.contains(wsep)
}

; 遞迴走訪：把 path 及其依賴依序塞進 ctx.r；祖先鏈 pathchain 做 cycle 偵測，r 清單兼作 diamond 去重。
;   ⚠️ 所有旗標頂層初始化、條件賦值走直線（self-host codegen 單趟配置器陷阱，見 ⑭ ③ 追記）。
;   ⚠️ bug #85 繞行：每個 concat / call 結果先綁到中間變數再使用（含 base + k 這類直接表達式運算元）。
;   ⚠️ AST 子節點迭代：kid-at 吃「扁平 kids 陣列的位置索引」，不是 (node, k)。必須先 nd-at 取
;      rootnd.kid0（基址）與 rootnd.nkid（子數），再 kid-at(t, base + k)。原 3 參版 kid-at(t, root, k)
;      會把 root 當位置索引、k 被吞，讀到錯節點甚至越界 → SIGTRAP。
drv.bp-walk = (path str, ctx bpctx, pathchain str) (r bpctx) {
    r = ctx
    probe = ':' - path - ':'

    ; cycle：path 已在祖先鏈上 ⇒ 真循環（A→B→A）
    onstack = pathchain.contains(probe)
    onstack == true -> {
        r.cyc = true
        return
    }

    ; diamond：path 已處理過（在 r 清單中）⇒ 跳過重複，不報 cycle（A→B, A→C→B）
    done = r.r.contains(probe)
    done == true -> {
        return
    }

    ; 加入依序清單（DFS 前序，入口最先）
    newr = r.r - path
    r.r = newr - ':'

    ; 讀檔
    c = fs.read-bytes(path)
    ok-read = false
    src []byte = with-cap(0)
    c: {
        ok -> {
            src = it
            ok-read = true
        }

        nil -> {
            ok-read = true
        }

        err -> {
        }
    }
    ok-read == false -> {
        eprint(NOC-NAME - ': cannot read ' - path)
        return
    }

    ; parse
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)

    ; 遍歷根節點的子節點，找 K-USE-STATEMENT
    rootnd = ast.nd-at(t, root)
    nk = rootnd.nkid
    base = rootnd.kid0
    k = 0
    (k < nk) {
        ch = ast.kid-at(t, base + k)
        kind = ast.kind-at(t, ch)
        kind == asp.K-USE-STATEMENT -> {
            sid = ast.slot-at(t, ch, 0)
            imp = ast.str-at(t, sid)
            file = drv.bp-resolve(imp)
            childchain = pathchain - probe
            sub = drv.bp-walk(file, r, childchain)
            subcyc = sub.cyc
            subcyc == true -> r.cyc = true
            r = sub
        }
        k = k + 1
    }
}

; `# <imp>` 的 imp 路徑 → 實體 .no 檔路徑（④）
drv.bp-resolve = (imp str) (file str) {
    file = imp
    imp.starts-with('/') -> file = imp.slice-bytes(1, imp.len-bytes())
    file.ends-with('.no') -> return
    file.ends-with('.sb') -> {
        file = file.slice-bytes(0, file.len-bytes() - 3) + '.no'
        return
    }
    file.ends-with('/') -> {
        file = file + 'main.no'
        return
    }
    file = file - '.no'
}

; ═══════════════════════════════════════════════════════════════════
; ⑭ 切片 3（2026-11-13）：全域簽名表 + 單 `agg` struct 註冊（⑤ B／C）
;   目標：整包所有模組的結構體定義登記進【同一份】agg（共享結構體名→sid 表），
;        每個頂層函式以 `mod.fn` 為 key 登記進【同一份】簽名表 sg；
;        供切片 4（多模組 body 串接＋`@<mod.fn>` 命名）與切片 5（dotted-call 查全域表）使用。
;   設計對照（⑭ ⑪ ③）：本件即「h2m-sig-add 擴充為帶 mod 限定、key = mod.fn」的落地；
;       為不動既有 h2m-lower-program 單模組路徑（保 drv-build-test 63/63 零回歸），
;       mod 限定在呼叫點拼成完整 key 字串傳入 h2m-sig-add（fname 即 `mod.fn`），語意等價。
;
;   ⚠️ 兩遍結構：先【全部】模組 struct-register（跨模組結構體名都就位），再【全部】func-sig
;      抽取——避免「消費者模組先於其依賴模組被處理」時 h2m-func-sig 查不到結構體名（e.g. drv 先於 ast）。
;   ⚠️ 本件【只抽取簽名 + 登記結構體名→sid】，不做欄位型別解析（stft）與 emit；
;      欄位型別解析（h2m-struct-resolve 須按各模組 t 跑）與 emit 留待切片 4/5。
;   ⚠️ bin/no codegen 坑（同切片 2 註 ①）：入口必須直接 import 全套傳遞依賴（drv/ast/ps/asp/lx/tok/
;      mir/cg/cg-runtime/cg-rc/h2m/link/util·sb/diag/ck/ck-sig），否則 h2m.* 頂層常數不生成、
;      pkg-sigs 內部 h2m-* 呼叫 codegen 失敗（consumer reads value 0）。
;   ⚠️ key 構造坑（實踩）：自舉各模組函式名前綴慣例不一致——`drv.build-package`/`ps.parse`/`ast.str-at`
;      用【點號】前綴，`h2m-sig-add`/`ps-parse-use` 用【連字】前綴。故 key 先剝掉 `mod.` 或 `mod-` 模組
;      前綴得 short，再組 `mod.short` 規範 key，與切片 5 點號呼叫 emit `call @<mod.fn>` 查表 key 對齊。
;   ⚠️ `drv.*` 模組函式暫不入表（已知自舉 parser 缺陷）：`drv.no` 用 `drv.x = (...)` 點號名定義，
;      自舉 `ps.parse` 對此類定義的 signature 計數有 bug（c5 多算 1），致 h2m-func-sig 全判 bad=1 略過。
;      裸名模組（ps/ast/h2m/lx/…）不受影響，切片 3 驗收（ps.parse/ast.str-at）達標；要讓
;      `drv.dispatch`→`ps.parse` 這類跨模組點號呼叫通，須先修該 parser 計數 bug（切片 5 前置）。
; ═══════════════════════════════════════════════════════════════════

; 讀模組檔 → 原始位元組（option 錯誤靜默成空，由呼叫方判空）
drv.read-mod = (f str) (src []byte) {
    c = fs.read-bytes(f)
    ok-read = false
    c: {
        ok -> {
            src = it
            ok-read = true
        }

        nil -> {
            ok-read = true
        }

        err -> {
        }
    }
    ok-read == false -> {
        eprint(NOC-NAME - ': cannot read ' - f)
        return
    }
}

; 模組檔路徑 → 模組短名（basename 去 .no/.sb）：compiler/src/ps.no → ps；compiler/src/util/sb.no → sb
drv.mod-name = (f str) (r str) {
    n = f.len-bytes()
    last = -1
    k = 0
    (k < n) {
        c = f.slice-bytes(k, k + 1)
        c == '/' -> last = k

        #{overflow=wrap}
        k = k + 1
    }
    base = f.slice-bytes(last + 1, n)
    bn = base.len-bytes()
    r = base
    bn >= 3 -> {
        suf = base.slice-bytes(bn - 3, bn)
        suf == '.no' -> r = base.slice-bytes(0, bn - 3)
        suf == '.sb' -> r = base.slice-bytes(0, bn - 3)
    }
}

; `:`-分隔（帶前導 `:`）的模組清單 → []str；空段跳過
drv.pkg-split = (s str) (r []str) {
    r = with-cap(32)
    n = s.len-bytes()
    start = 0
    i = 0
    (i < n) {
        c = s.slice-bytes(i, i + 1)
        c == ':' -> {
            seg = s.slice-bytes(start, i)
            seg.len-bytes() > 0 -> r.push(seg)
            start = i + 1
        }

        #{overflow=wrap}
        i = i + 1
    }
    last = s.slice-bytes(start, n)
    last.len-bytes() > 0 -> r.push(last)
}

; 入口 .no 檔 → 整包全域簽名表（key = `mod.fn`，存於 sg.fname）。
;   單一 agg 共享整包結構體名→sid；單一 sg 收整包函式簽名。
;   path: 入口檔（相對 cwd = workspace 根）
;   sg: 全域簽名表；空表（len 0）＝失敗（已 eprint）
drv.pkg-sigs = (path str) (sg h2m-sigs) {
    sg = h2m-sigs-new()
    agg = h2m-new()
    pkg = drv.build-package(path)
    body = pkg.slice-bytes(1, pkg.len-bytes())
    files = drv.pkg-split(body)

    ; pass 1：全部模組 struct 名→sid 登記進共享 agg（跨模組結構體表統一）
    f <- files: {
        src = drv.read-mod(f)
        t = ast.make()
        p = ps.new(src)
        root = ps.parse(t, p)
        rootnd = ast.nd-at(t, root)
        nk = rootnd.nkid
        base = rootnd.kid0
        k = 0
        (k < nk) {
            kid = ast.kid-at(t, base + k)
            kk = ast.nd-at(t, kid)
            kk.kind == asp.K-STRUCT-DEFINITION -> h2m-struct-register(agg, t, kid)

            #{overflow=wrap}
            k = k + 1
        }
    }

    ; pass 2：函式簽名抽取，key = mod.fn
    f <- files: {
        mod = drv.mod-name(f)
        src = drv.read-mod(f)
        t = ast.make()
        p = ps.new(src)
        root = ps.parse(t, p)
        rootnd = ast.nd-at(t, root)
        nk = rootnd.nkid
        base = rootnd.kid0
        k = 0
        (k < nk) {
            kid = ast.kid-at(t, base + k)
            kk = ast.nd-at(t, kid)
            kk.kind == asp.K-FUNCTION-DEFINITION -> {
                nm, rt, ap, dp, bd = h2m-func-sig(t, agg, kid)
                bd == 0 -> {

                    ; 模組源碼函式名慣例不一致：有的帶 `mod.` 點號前綴（drv.build-package / ps.parse /
                    ;   ast.str-at），有的帶 `mod-` 連字前綴（h2m-sig-add / ps-parse-use）。
                    ;   剝掉模組前綴（點或連字）得 short，再組 `mod.short` 規範 key，
                    ;   與切片 5 點號呼叫 emit `call @<mod.fn>` 的查表 key 對齊；無前綴則 short = nm。
                    short = nm
                    pre-dot = mod - '.'
                    pre-hyp = mod - '-'
                    nm.starts-with(pre-dot) == true -> short = nm.slice-bytes(mod.len-bytes() + 1, nm.len-bytes())
                    nm.starts-with(pre-hyp) == true -> short = nm.slice-bytes(mod.len-bytes() + 1, nm.len-bytes())
                    key = mod - '.' - short
                    h2m-sig-find(sg, key) < 0 -> h2m-sig-add(sg, key, rt, ap, dp)
                }
            }

            #{overflow=wrap}
            k = k + 1
        }
    }
}

; ═══════════════════════════════════════════════════════════════════
; ⑭ 切片 4（2026-11-13）：整包降級——多模組 body 串接 + @<mod>.<fn> 命名（⑤ D／⑦）
;   目標：整包所有模組降成【同一份】.ll，函式以 @<mod.fn> 命名（入口 main 仍 @main），
;         body 串接，供 opt -passes=verify 與 clang 連結。
;   設計對照（⑭ ⑪ ④）：本件即「逐模組呼叫 h2m-lower-func、共享 agg、emit @<mod.fn>」的落地；
;        為不動既有 h2m-lower-program 單模組 emit（保 drv-build-test 63/63 零回歸），
;        整包路徑【不】走 h2m-lower-program（它會重複登記 struct、重複 emit 宣告、且每模組一份），
;        改由本函數統一：① 全模組 struct 登記進共享 agg；② 逐模組用自身 t 解欄位型別；
;        ③ 全域 struct 宣告 emit 一次；④ 逐模組建本模組 sg、emit 各函式（入口額外合成 main）。
;
;   ⚠️ 共享 agg × 逐模組解：struct 欄位型別節點在各模組自己的 AST，故解時必須用「該模組的 t」
;      （h2m-struct-resolve-range 按模組區間解，避免跨模組讀錯節點）。
;   ⚠️ 函式名即 h2m-func-sig 回傳名：dot 前綴模組（ps.parse / ast.str-at）天然 emit @ps.parse；
;      連字前綴（h2m-sig-add）emit @h2m-sig-add；drv.* 因 parser 缺陷（切片 3 註）全 bad=1 不產碼。
;   ⚠️ 跨模組呼叫（drv.dispatch → ps.parse）留待切片 5；本件只做 body 串接與命名，
;      故入口 main 若含跨模組呼叫會計 unsup（真 compiler/main.no 即如此）——切片 5 前置修 parser 後才通。
;   ⚠️ bin/no codegen 坑（同切片 2／3）：呼叫 drv.pkg-ll 的測試必須直接 import 全套傳遞依賴，
;      否則 drv.* 內部 h2m-*／ast.*／ps.* 呼叫 codegen 失敗（consumer reads value 0）。
; ═══════════════════════════════════════════════════════════════════

; 入口 .no 檔 → 整包完整 LLVM IR 模組文字（多模組 body 串接、函式 @<mod.fn>、入口 @main）。
;   path: 入口檔（相對 cwd = workspace 根）
;   r: 完整 .ll（prelude + 全域 struct 宣告 + 各模組函式）；'' = 失敗（已 eprint）
drv.pkg-ll = (path str) (r str) {
    r = ''
    pkg = drv.build-package(path)
    body0 = pkg.slice-bytes(1, pkg.len-bytes())
    files = drv.pkg-split(body0)
    nfiles = files.len()
    agg = h2m-new()

    ; pass 1：全模組 struct 登記進共享 agg，逐模組用自身 t 解欄位型別（避免跨 AST 讀錯節點）
    k = 0
    (k < nfiles) {
        f = files[k]
        src = drv.read-mod(f)
        t = ast.make()
        p = ps.new(src)
        root = ps.parse(t, p)
        nd = ast.nd-at(t, root)
        nk = nd.nkid
        base = nd.kid0
        before = agg.stn.len()
        m = 0
        (m < nk) {
            kid = ast.kid-at(t, base + m)
            kd = ast.nd-at(t, kid)
            kd.kind == asp.K-STRUCT-DEFINITION -> h2m-struct-register(agg, t, kid)

            #{overflow=wrap}
            m = m + 1
        }
        after = agg.stn.len()
        after > before -> h2m-struct-resolve-range(agg, t, before, after)

        #{overflow=wrap}
        k = k + 1
    }

    ; 全域結構體宣告一次（§11 B10 唯一裝配點，多模組不可分散 emit 否則 redefinition）
    decls = h2m-struct-decls(agg)

    ; pass 2：逐模組 emit 各函式（入口額外合成 main），body 串接
    body = ''
    body = body - decls

    ; 整包 emit-once：同名函式只產一次（自舉源碼存在重複定義，如 ps.no 的 ps-is-builtin-type
    ;   在 3434 與 7321 各定義一次；整包路徑首次完整降級 ps.no 才暴露。emit-once 兼顧跨模組同名碰撞。
    emitted = ':'
    k2 = 0
    (k2 < nfiles) {
        f = files[k2]
        src = drv.read-mod(f)
        t = ast.make()
        p = ps.new(src)
        root = ps.parse(t, p)

        ; 本模組 sg（簽名表；切片 4 不跨模組呼叫，逐模組即可）
        sg = h2m-sigs-new()
        nd = ast.nd-at(t, root)
        nk = nd.nkid
        base = nd.kid0
        m = 0
        (m < nk) {
            kid = ast.kid-at(t, base + m)
            kd = ast.nd-at(t, kid)
            kd.kind == asp.K-FUNCTION-DEFINITION -> {
                nm, rt, ap, dp, bd = h2m-func-sig(t, agg, kid)
                bd == 0 -> h2m-sig-add(sg, nm, rt, ap, dp)
            }

            #{overflow=wrap}
            m = m + 1
        }

        ; 入口模組：合成 main（其餘模組直接用原 Program root）
        target = root
        k2 == 0 -> target = h2m-synth-main(t, root)
        tnd = ast.nd-at(t, target)
        tnk = tnd.nkid
        tbase = tnd.kid0
        m2 = 0
        (m2 < tnk) {
            kid = ast.kid-at(t, tbase + m2)
            kd = ast.nd-at(t, kid)
            kd.kind == asp.K-FUNCTION-DEFINITION -> {
                nm, _, _, _, _ = h2m-func-sig(t, agg, kid)
                key = ':' - nm - ':'
                emitted.contains(key) == false -> {
                    one = h2m-lower-func(t, agg, sg, kid)
                    one != '' -> {
                        body = body - one - '\n'
                        emitted = emitted - key
                    }
                }
            }

            #{overflow=wrap}
            m2 = m2 + 1
        }

        #{overflow=wrap}
        k2 = k2 + 1
    }
    r = cg-runtime-prelude-full() - '\n' - body - '\n'
    agg.unsup > 0 -> {
        eprint(NOC-NAME - ': unsupported constructs: ' - agg.unsup.to-str() - ' (pkg-ll)')
    }
}

; 取 argv 第 i 項（越界／nil ⇒ ''）
; i: 下標
; r: 引數文字
drv.arg-at = (i i64) (r str) {
    r = ''
    oa = args.get(i)
    oa: {
        ok(v) -> r = v

        -> _
    }
}

; 來源檔路徑：argv[2..] 中**第一個不是** `-o` 也不是 `-o` 值的項。
;   ⚠️ 兩種順序都吃（與 Go oracle 對齊、又容錯）：
;      `noc build -o OUT FILE`（Go `no build` 的硬性順序，見 §11 後 ⑧）
;      `noc build FILE -o OUT`（早期 M4-d 草案寫法）
;   故不能直接取 argv[2]——那會把 `-o` 當檔名（實測 `noc: cannot read -o`）。
; r: 來源路徑；'' = 沒給
drv.src-arg = () (r str) {
    r = ''
    n = args.count()
    i = 2
    (i < n) {
        a = drv.arg-at(i)
        a == '-o' -> {

            #{overflow=wrap}
            i = i + 2
            continue
        }
        r = a
        break
    }
}

; `-o <out>` 的值；未给 ⇒ ''
; r: 目的路径（'' = 没给）
drv.out-arg = () (r str) {
    r = ''
    n = args.count()
    i = 2
    (i < n) {
        a = drv.arg-at(i)
        a == '-o' -> {

            #{overflow=wrap}
            j = i + 1
            j < n -> {
                r = drv.arg-at(j)
            }
            break
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; run 的临时产物路径：`<tmp>/noc-run-<pid>.out`
;   ⚠️ `run` **不**默认写 <src>.out——否则拿它跑 `tests/` 全语料会往语料目录里
;      拉一坨 *.no.out（L4 差分时是污染源）。用 pid 区分并发进程。
; r: 路径
drv.run-temp = () (r str) {
    td = '/tmp'
    e = os.get-env('TMPDIR')
    e: {
        ok(v) -> {
            v != '' -> td = v
        }

        -> _
    }
    r = td - 'noc-run-' - os.get-pid().to-str() - '.out'
}

; 目的檔路徑：`-o <out>` 優先；未給 ⇒ <path>.out（刻意**不**去尾 .no，
;   免得為湊 Go 預設輸出名而做 len-3 算術／後綴切片，見 §11 後 ⑧）
; path: 來源檔路徑
; r: 可執行檔路徑
drv.build-out = (path str) (r str) {
    r = drv.out-arg()
    r == '' -> r = path - '.out'
}

; 建置主体：读档 → 自产 .ll → clang 链出 out
; path: 来源档路径
; out: 目的可执行档路径
; ok: 是否成功（false 时已 eprint 诊断）
drv.build-to = (path str, out str) (ok bool) {
    ok = false
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok(v) -> {
            src = v
            got = true
        }

        nil -> {
            got = true
        }

        err(e) -> {
        }
    }
    got == false -> {
        eprint(NOC-NAME - ': cannot read ' - path)
        return
    }
    ll = drv.build-ll(src)
    ll == '' -> return
    ok = link.compile(ll, out)
}

; build：自產 .ll → clang 組譯＋鏈接
; ⚠️ 檔案不存在與空檔的區分沿用 cmd-tokens 的三臂，但 `fs.read-bytes` 對不存在
;    回 err、對空檔回 nil；本件對 err 直接 eprint + rc=1（見 drv.build-to）
; code: 狀態碼
drv.cmd-build = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': build requires a file argument')
        code = EXIT-USAGE
        return
    }
    path = drv.src-arg()
    path == '' -> {
        eprint(NOC-NAME - ': build requires a file argument')
        code = EXIT-USAGE
        return
    }
    ok = drv.build-to(path, drv.build-out(path))
    ok == false -> code = EXIT-FAIL
}

; run：build 後同步執行產物，把子行程結束碼當 noc 的結束碼（L4 行為差分用）
; ⚠️ 未给 -o ⇒ 产物落 <tmp>/noc-run-<pid>.out（不污染语料目录，见 drv.run-temp）
; ⚠️ process.process-system 回 C system() 的 raw wait status ⇒ 必須 >> 8 才是結束碼；
;    process.shell-quote 會把含空白的路徑包好，避免 shell 拆詞。
; code: 子行程結束碼（build 失敗時為 EXIT-FAIL / EXIT-USAGE）
drv.cmd-run = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': run requires a file argument')
        code = EXIT-USAGE
        return
    }
    path = drv.src-arg()
    path == '' -> {
        eprint(NOC-NAME - ': run requires a file argument')
        code = EXIT-USAGE
        return
    }
    out = drv.out-arg()
    out == '' -> out = drv.run-temp()
    ok = drv.build-to(path, out)
    ok == false -> {
        code = EXIT-FAIL
        return
    }
    st = process.process-system(process.shell-quote(out))
    code = st >> 8
}

; 依 argv[1] 分派；回傳行程退出碼
; code: 狀態碼
drv.dispatch = () (code i64) {
    code = EXIT-OK
    n = args.count()
    {
        n <= 1 -> {
            drv.usage()
            code = EXIT-USAGE
        }

        -> {
            opt-cmd = args.get(1)
            cmd str = ''
            opt-cmd: {
                ok -> cmd = it

                -> _
            }
            cmd: {
                'version' -> drv.cmd-version()

                'help' -> drv.usage()

                '--help' -> drv.usage()

                '-h' -> drv.usage()

                'tokens' -> code = drv.cmd-tokens()

                'ast' -> code = drv.cmd-ast()

                'vet' -> code = drv.cmd-vet()

                'build' -> code = drv.cmd-build()

                'run' -> code = drv.cmd-run()

                -> {
                    eprint(NOC-NAME - ': unknown command "' - cmd - '"')
                    drv.usage()
                    code = EXIT-USAGE
                }
            }
        }
    }
}
