; drv — CLI 分派（noc 的入口邏輯）
;
; M0 範圍：version / help 可用；tokens / ast / build 是明確的「未實作」骨架，
; 以 rc=EXIT-NOTIMPL(3) 退出——讓差分 harness 能把「未實作」與「失敗」分開。
; ⚠️ 上述是 M0 歷史記述：tokens / ast / vet 早已落地；2026-11-12（M4-d，§11 後 ⑧）
;    build / run 亦已接線——自產 `.ll` → link.compile 調 clang（DR-2）。
;    EXIT-NOTIMPL 目前只剩給未列出的子命令骨架用，build 不再走 drv.not-implemented。
;
; 退出碼約定：
;   0  EXIT-OK          成功
;   1  EXIT-FAIL        一般失敗（編譯錯誤等）
;   2  EXIT-USAGE       用法錯誤（未知子命令 / 缺參數）
;   3  EXIT-NOTIMPL     尚未實作的子命令（M0 佔位）
;
; ⚠️ SHS：無模組級可變狀態、無一等函式值、無指針。

; ⚠️ 導入寫 `# /compiler/src/lx`（**模組**形式），呼叫寫 lx.dump(...)。
;    `# /path/mod.Type` 是【型別】導入形式（配 `<Type>.<method>` 呼叫）；
;    lx.no 沒有宣告結構體，用型別形式會得到 `unknown callee lx.dump`。

# /compiler/src/lx
# /compiler/src/ast
# /compiler/src/ps
# /compiler/src/asp
# /compiler/src/diag
# /compiler/src/ck
# /compiler/src/ck-sig
# /compiler/src/mir
# /compiler/src/cg
# /compiler/src/cg-runtime
# /compiler/src/cg-rc
# /compiler/src/h2m
# /compiler/src/link
# /compiler/src/util/sb.sb

; ⚠️ 本檔的 drv.* 是**含點的自由函式**（沒有宣告 struct drv），因此受 SHS S6
;    約束：每個定義的 out-param 至多 1 個，否則執行期 SIGSEGV。見 docs 附錄 A.6。

EXIT-OK = 0
EXIT-FAIL = 1
EXIT-USAGE = 2
EXIT-NOTIMPL = 3

NOC-NAME = 'noc'
NOC-VERSION = 'v0.0.1-m0'

; 功能待補充
; r: 結果字串
drv.name = () (r str) {
    r = NOC-NAME
}

; 功能待補充
; r: 結果字串
drv.version = () (r str) {
    r = NOC-VERSION
}

; 打印用法
drv.usage = () {
    print(NOC-NAME - ' — Nolang compiler (self-hosted, M0 skeleton)')
    print('')
    print('Usage: noc <command> [args]')
    print('')
    print('Commands:')
    print('  version            print version')
    print('  help               print this help')
    print('  tokens <file>      dump token stream (not implemented in M0)')
    print('  ast <file>         dump AST (not implemented in M0)')
    print('  vet <file>         run diagnostics (M3-c skeleton: syntax errors + not-defined family)')
    print('  build [-o OUT] <file>   compile to executable via clang (M4-d: self-produced .ll)')
    print('  run [-o OUT] <file>     build, then execute the produced binary (M4-d)')
}

; 功能待補充
drv.cmd-version = () {
    print(NOC-NAME - ' ' - NOC-VERSION)
}

; 統一的「未實作」出口
; what: 字串
; code: 狀態碼
drv.not-implemented = (what str) (code i64) {
    eprint(NOC-NAME - ': command "' - what - '" is not implemented yet (M0 skeleton)')
    code = EXIT-NOTIMPL
}

; dump 詞法 token 流
; 輸出格式與 L1 oracle 逐位元組相同（見 compiler/src/lx.no 檔頭）。
; ⚠️ 不要用 print 印「已帶尾端 \n 的字串」——print 自己會補一個 \n，
;    那會多出一個空行。lx.dump 回的字串刻意**不帶**尾端 \n。
; code: 狀態碼
drv.cmd-tokens = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': tokens requires a file argument')
        code = EXIT-USAGE
        return
    }
    opt-path = args.get(2)
    path = ''
    opt-path: {
        ok -> path = it

        -> _
    }

    ; ⚠️ 必須用 read-bytes + to-bytes-str，**不能**用 fs.read-str：
    ;    fs.read-str 最終呼叫 []byte.to-str()，而該方法（2026-09-06 起）
    ;    是「byte → 碼點 → UTF-8 重新編碼」，對 >= 0x80 的位元組會二次編碼。
    ;    實測：5 位元組檔 `; \xe7\xbb\xbc\n` 讀進來變成 15 位元組
    ;    （每個高位元組變成 4 位元組）。詞法分析器必須看到**原始位元組**。
    ;    見 docs/design/nolang-selfhost.md §8 P0-⑥。
    ; ⚠️ nil = **檔案存在但長度為 0**（實測：fs.read-bytes 對 0 位元組檔回 nil，
    ;    對不存在的路徑回 err）。空檔案是**合法**原始碼（詞法分析器應吐單一 EOF），
    ;    所以 nil **不是**錯誤。不處理的話 `noc tokens <空檔>` 會 rc=1 而 oracle rc=0
    ;    ⇒ L1 假 DIFF（語料中目前沒有空檔，故此缺陷目前是**潛伏**的）。
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok -> {
            src = it
            got = true
        }

        nil -> {
            got = true
        }

        err -> {
        }
    }
    got == false -> {
        eprint(NOC-NAME - ': cannot read ' - path)
        code = EXIT-FAIL
        return
    }
    print(lx.dump(src))
}

; 解析並 dump AST（M2）
; 輸出與 L2 oracle `no ast <file>` 逐位元組相同（見 compiler/src/ast.no 檔頭）。
; 讀檔走 read-bytes + to-bytes-str（與 cmd-tokens 同理由，§8 P0-⑥）。
; code: 狀態碼
drv.cmd-ast = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': ast requires a file argument')
        code = EXIT-USAGE
        return
    }
    opt-path = args.get(2)
    path = ''
    opt-path: {
        ok -> path = it

        -> _
    }
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok -> {
            src = it
            got = true
        }

        nil -> {
            got = true
        }

        err -> {
        }
    }
    got == false -> {
        eprint(NOC-NAME - ': cannot read ' - path)
        code = EXIT-FAIL
        return
    }
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)
    out = ast.dump(t, root)
    print(out)
}

; 執行診斷檢查（M3-a 骨架＋s10 語法錯誤首族）
; 輸出契約錨定 oracle `no vet <file>`（authority：Go printLintResults，src/cmd/no/main.go）：
;   無診斷        ⇒ stdout 'No issues found.'，rc=0
;   檔案不存在    ⇒ stderr 'Error: stat <path>: no such file or directory'，rc=1
;   有診斷        ⇒ 每條 <file>:<line>:<col>: [LEVEL] <src>: <msg> [<code>] （stdout），
;                  摘要「\nN error(s), W warning(s), H hint(s)」走 stderr；rc=1（鉗制，見下）
;   s10 起的診斷源 = ps.no 的語法錯誤收集器（三站點：分組缺 RPAREN、實參缺逗號、
;   let RHS 落空）；checker 未實作 ⇒ WARNING/HINT 恆 0，LINT 族留 M3-c 後續增量。
; code: 狀態碼
drv.cmd-vet = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': vet requires a file argument')
        code = EXIT-USAGE
        return
    }
    opt-path = args.get(2)
    path = ''
    opt-path: {
        ok -> path = it

        -> _
    }

    ; 讀檔走 read-bytes + ok/nil/err 三臂（與 cmd-tokens 同理由，§8 P0-⑥）：
    ;   nil = 存在但 0 位元組（合法空檔，oracle 回 No issues found.）
    ;   err = 路徑不存在 ⇒ 覆刻 oracle 的 os.Stat ENOENT 文案
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok -> {
            src = it
            got = true
        }

        nil -> {
            got = true
        }

        err -> {
            eprint('Error: stat ' - path - ': no such file or directory')
            code = EXIT-FAIL
        }
    }
    got == false -> {
        return
    }

    ; 跑完整前端，保證 vet 與 ast 共用同一條 parse 路徑；
    ; ps.no 的語法錯誤收集器（s10/M3-c 首族）掛在 parse 期間。
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)

    ; s13：checker 骨架首族 `'X' is not defined`（ck.no，TraceID 4bek3xc6）。
    ;   正主 runParseGate 語義（p90 實證）：有 parse 錯 ⇒ checker 整族跳過。
    ;   診斷順序：ps 錯誤在前、ck 在後（各自內部按構造序），摘要計數合併。
    ;   ck↔drv 介面 = 打包串 vec 'L|C|CODE|MSG'（結構體跨模組按值傳參觸 MIR 坑，s13 實證）。
    ck-out []str = with-cap(4)
    ps-errs = ps.ps-err-count(p)
    ps-errs == 0 -> {
        ck-out = ck.check(t, path)
    }

    ; s10：渲染 ps 收集的語法錯誤。契約（authority Go printLintResults）：
    ;   每條診斷 stdout：render 行形（file=被 vet 的路徑；parser 錯誤無跨檔歸屬）
    ;   有診斷：stderr 摘要「\nN error(s), W warning(s), H hint(s)」
    ;     （Go `return errorCount` 是函式內值；caller vet 端 `if errorCount > 0 { os.Exit(1) }`
    ;      ——實測 3 錯檔 rc=1，行程退出碼恆鉗制為 1；本族只產 ERROR ⇒ W/H 恆 0）
    ;   無診斷：stdout 'No issues found.'，rc=0
    nerr = 0
    i = 0
    (i < ps-errs) {
        d = diag{
            file: path
            line: 0
            col: 0
            level: 2
            src: 'nolang-compile'
            msg: ''
            code: 'E_GENERAL'
        }
        d.line = p.e-ln[i]
        d.col = p.e-cl[i]
        d.msg = p.e-msg[i]
        d.code = p.e-code[i]
        print(d.render())

        #{overflow=wrap}
        nerr = nerr + 1

        #{overflow=wrap}
        i = i + 1
    }

    ; s13：渲染 ck 的 not-defined 診斷。ck↔drv 介面 = 打包串 vec，每條 'L|C|CODE|MSG'
    ;   （前 3 段以 '|' 分隔且無歧義：L/C 為十進制、CODE 為 TraceID；MSG 可含 '|'）。
    i = 0
    (i < ck-out.len()) {
        raw = ck.ck-str-at(ck-out, i)

        ; 逐段切：L | C | CODE | 余下整段作 MSG
        p1 = raw.index('|')
        ln-part = ''
        rest = ''
        p1 > 0 -> {
            ln-part = raw.slice-bytes(0, p1)
            rest = raw.slice-bytes(p1 + 1, raw.len-bytes())
        }
        p2 = rest.index('|')
        cl-part = ''
        rest2 = ''
        p2 > 0 -> {
            cl-part = rest.slice-bytes(0, p2)
            rest2 = rest.slice-bytes(p2 + 1, rest.len-bytes())
        }
        p3 = rest2.index('|')
        code-part = rest2
        msg-part = ''
        p3 > 0 -> {
            code-part = rest2.slice-bytes(0, p3)
            msg-part = rest2.slice-bytes(p3 + 1, rest2.len-bytes())
        }

        d = diag{
            file: path
            line: 0
            col: 0
            level: 2
            src: 'nolang-compile'
            msg: ''
            code: 'E_GENERAL'
        }
        d.line = ln-part.to-i64()
        d.col = cl-part.to-i64()
        d.code = code-part
        d.msg = msg-part
        print(d.render())

        #{overflow=wrap}
        nerr = nerr + 1

        #{overflow=wrap}
        i = i + 1
    }
    nerr > 0 -> {
        eprint('')
        eprint(nerr.to-str() - ' error(s), 0 warning(s), 0 hint(s)')
    }

    nerr == 0 -> {
        print('No issues found.')
    }

    ; rc 鉗制：對齊 Go vet caller `errorCount > 0 ⇒ os.Exit(1)`（main.go:3328-3332）
    nerr > 0 -> {
        code = 1
    }
}

; ═══════════════════════════════════════════════════════════════════
; M4-d（2026-11-12，§11 後 ⑧）：build / run 接線
; ═══════════════════════════════════════════════════════════════════
; 鏈路：read-bytes → ast.make/ps.new/ps.parse → h2m-lower-module（合成 @main）
;       → cg-runtime-prelude-full() + body = 完整 .ll → link.compile（clang -x ir）
; ⚠️ 與 §5.7 M5 的界線：本件**不做** workspace / package / `#` 導入合併／target 解析／快取；
;    只處理「單一 .no 檔、SHS 子集」。頂層內建呼叫（print 等）、模組導入、
;    跨函式讀頂層 let 全局都計 unsup ⇒ 誠實 rc=1，不靜默產出錯碼。
; ⚠️ SHS S6：以下 drv.* 皆含點自由函式 ⇒ 每個 out-param 至多 1 個。

; 純函式：原始位元組 → 完整 LLVM IR 模組文字（L0 可直接斷言，不碰檔案／行程）
; src: 原始碼位元組（**不得**用 fs.read-str，見 §8 P0-⑥ 的二次編碼陷阱）
; r: 完整 .ll；'' = 降級不支援（已 eprint 診斷）
drv.build-ll = (src []byte) (r str) {
    r = ''
    t = ast.make()
    p = ps.new(src)
    root = ps.parse(t, p)
    agg = h2m-new()
    body = h2m-lower-module(t, agg, root)
    agg.unsup > 0 -> {
        eprint(NOC-NAME - ': unsupported constructs: ' - agg.unsup.to-str() - ' (M4-d SHS subset)')
        return
    }
    body == '' -> {
        eprint(NOC-NAME - ': no code generated')
        return
    }
    b = sb.init(32768)
    b.push(cg-runtime-prelude-full())
    b.push('\n')
    b.push(body)
    b.push('\n')
    r = b.str()
}

; 取 argv 第 i 項（越界／nil ⇒ ''）
; i: 下標
; r: 引數文字
drv.arg-at = (i i64) (r str) {
    r = ''
    oa = args.get(i)
    oa: {
        ok(v) -> r = v

        -> _
    }
}

; 來源檔路徑：argv[2..] 中**第一個不是** `-o` 也不是 `-o` 值的項。
;   ⚠️ 兩種順序都吃（與 Go oracle 對齊、又容錯）：
;      `noc build -o OUT FILE`（Go `no build` 的硬性順序，見 §11 後 ⑧）
;      `noc build FILE -o OUT`（早期 M4-d 草案寫法）
;   故不能直接取 argv[2]——那會把 `-o` 當檔名（實測 `noc: cannot read -o`）。
; r: 來源路徑；'' = 沒給
drv.src-arg = () (r str) {
    r = ''
    n = args.count()
    i = 2
    (i < n) {
        a = drv.arg-at(i)
        a == '-o' -> {

            #{overflow=wrap}
            i = i + 2
            continue
        }
        r = a
        break
    }
}

; `-o <out>` 的值；未给 ⇒ ''
; r: 目的路径（'' = 没给）
drv.out-arg = () (r str) {
    r = ''
    n = args.count()
    i = 2
    (i < n) {
        a = drv.arg-at(i)
        a == '-o' -> {

            #{overflow=wrap}
            j = i + 1
            j < n -> {
                r = drv.arg-at(j)
            }
            break
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; run 的临时产物路径：`<tmp>/noc-run-<pid>.out`
;   ⚠️ `run` **不**默认写 <src>.out——否则拿它跑 `tests/` 全语料会往语料目录里
;      拉一坨 *.no.out（L4 差分时是污染源）。用 pid 区分并发进程。
; r: 路径
drv.run-temp = () (r str) {
    td = '/tmp'
    e = os.get-env('TMPDIR')
    e: {
        ok(v) -> {
            v != '' -> td = v
        }

        -> _
    }
    r = td - 'noc-run-' - os.get-pid().to-str() - '.out'
}

; 目的檔路徑：`-o <out>` 優先；未給 ⇒ <path>.out（刻意**不**去尾 .no，
;   免得為湊 Go 預設輸出名而做 len-3 算術／後綴切片，見 §11 後 ⑧）
; path: 來源檔路徑
; r: 可執行檔路徑
drv.build-out = (path str) (r str) {
    r = drv.out-arg()
    r == '' -> r = path - '.out'
}

; 建置主体：读档 → 自产 .ll → clang 链出 out
; path: 来源档路径
; out: 目的可执行档路径
; ok: 是否成功（false 时已 eprint 诊断）
drv.build-to = (path str, out str) (ok bool) {
    ok = false
    c = fs.read-bytes(path)
    src []byte = with-cap(0)
    got = false
    c: {
        ok(v) -> {
            src = v
            got = true
        }

        nil -> {
            got = true
        }

        err(e) -> {
        }
    }
    got == false -> {
        eprint(NOC-NAME - ': cannot read ' - path)
        return
    }
    ll = drv.build-ll(src)
    ll == '' -> return
    ok = link.compile(ll, out)
}

; build：自產 .ll → clang 組譯＋鏈接
; ⚠️ 檔案不存在與空檔的區分沿用 cmd-tokens 的三臂，但 `fs.read-bytes` 對不存在
;    回 err、對空檔回 nil；本件對 err 直接 eprint + rc=1（見 drv.build-to）
; code: 狀態碼
drv.cmd-build = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': build requires a file argument')
        code = EXIT-USAGE
        return
    }
    path = drv.src-arg()
    path == '' -> {
        eprint(NOC-NAME - ': build requires a file argument')
        code = EXIT-USAGE
        return
    }
    ok = drv.build-to(path, drv.build-out(path))
    ok == false -> code = EXIT-FAIL
}

; run：build 後同步執行產物，把子行程結束碼當 noc 的結束碼（L4 行為差分用）
; ⚠️ 未给 -o ⇒ 产物落 <tmp>/noc-run-<pid>.out（不污染语料目录，见 drv.run-temp）
; ⚠️ process.process-system 回 C system() 的 raw wait status ⇒ 必須 >> 8 才是結束碼；
;    process.shell-quote 會把含空白的路徑包好，避免 shell 拆詞。
; code: 子行程結束碼（build 失敗時為 EXIT-FAIL / EXIT-USAGE）
drv.cmd-run = () (code i64) {
    code = EXIT-OK
    n = args.count()
    n < 3 -> {
        eprint(NOC-NAME - ': run requires a file argument')
        code = EXIT-USAGE
        return
    }
    path = drv.src-arg()
    path == '' -> {
        eprint(NOC-NAME - ': run requires a file argument')
        code = EXIT-USAGE
        return
    }
    out = drv.out-arg()
    out == '' -> out = drv.run-temp()
    ok = drv.build-to(path, out)
    ok == false -> {
        code = EXIT-FAIL
        return
    }
    st = process.process-system(process.shell-quote(out))
    code = st >> 8
}

; 依 argv[1] 分派；回傳行程退出碼
; code: 狀態碼
drv.dispatch = () (code i64) {
    code = EXIT-OK
    n = args.count()
    {
        n <= 1 -> {
            drv.usage()
            code = EXIT-USAGE
        }

        -> {
            opt-cmd = args.get(1)
            cmd str = ''
            opt-cmd: {
                ok -> cmd = it

                -> _
            }
            cmd: {
                'version' -> drv.cmd-version()

                'help' -> drv.usage()

                '--help' -> drv.usage()

                '-h' -> drv.usage()

                'tokens' -> code = drv.cmd-tokens()

                'ast' -> code = drv.cmd-ast()

                'vet' -> code = drv.cmd-vet()

                'build' -> code = drv.cmd-build()

                'run' -> code = drv.cmd-run()

                -> {
                    eprint(NOC-NAME - ': unknown command "' - cmd - '"')
                    drv.usage()
                    code = EXIT-USAGE
                }
            }
        }
    }
}
