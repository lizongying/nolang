; ═══════════════════════════════════════════════════════════════════
; h2m — AST → MIR 降级（对齐 src/mir/hir2mir.go）
; ═══════════════════════════════════════════════════════════════════
;
; 目标（M4-e，s55 首件 / s56 第二件 / s57 第三件）：把 ps.no 产出的 AST arena 降级成 cg.no 消费的 MIR 指令流，
; 打通「源码 → IR」的第一条真实路径。此前 compiler/ 里每一段 IR 都来自手写的 op 数组
; （cg-test.no / tmp/probe-sNN.no）——等于「codegen 有测试、前端无出口」。
;
; ── 覆盖面（刻意极小，且小得可测量）─────────────────────────────
;   支持：Program / FunctionDefinition（输入参数按 LLVM 形参序占值 id 1..nargs、
;         至多一个输出参数且其型别决定 retty）/ BlockStatement / LetStatement /
;         Identifier / IntegerLiteral / BooleanLiteral（s90：true/false ⇒ OP-CONST(TY-I64, 0/1)，镜像 Go hir2mir.go KBoolLit；自举 bool 走 i64 宽 0/1，与 s57 比较族「布尔=i64 0/1」同口径）/ CharLiteral（s91：双引号单码点 ⇒ UTF-8 首码点解码 ⇒ OP-CONST(TY-I64, cp)，镜像 Go lowerCharLit；自举 char 走 i64 码点、无 i32 槽，同 bool 宽口径）/ GroupedExpression / InfixExpression（+ - * 与六个比较符，仅 i64；位运算 & | ^ << >> s67，s79 起 u64 亦放行——uty 下 >> 重映射 OP-SHRU 发 lshr、其余发裸 and/or/xor/shl i64；s80：'>>' 无条件重映射 OP-SHRU——i64 侧亦发 lshr，镜像 Go OpShr 恒逻辑移位，s35 的 i64=ashr 设计被推翻，cg 的 ashr 臂转死代码）；逻辑 && || s68，复用 OP-AND/OR（s83 起 u64 亦放行——Go 对 u64 逻辑族即裸位形 and/or 非短路，探针实钉）；s71：二元 + - * / 接受 f64 两侧操作数 ⇒ OP-ADD/SUB/MUL/DIV 发 fadd/fsub/fmul/fdiv double，镜像 Go 按型别分派——操作数必为 f64 形参，无 f64 字面量；s72：六个比较符 < > <= >= == != 接受 f64 两侧操作数 ⇒ OP-CMP* 依操作数 TY-F64 发 fcmp（!= 用 une 保 NaN）后 zext i1→i64，结果 dest 恒 TY-I64（非 f64）；位运算/移位/逻辑于 f64 仍门禁；s75：i64 侧 '/' '%' 放行 ⇒ OP-DIV/OP-MOD（dest TY-I64）由 cg 发带除零護欄的 sdiv/srem，镜像 Go plain 路径——除零结果定义化为 0 + stderr 报告；?i64 的 tag=2 装箱 err option 路未建模；f64 '%' s87 放行 ⇒ OP-MOD 入 is-arith 发 frem double（AArch64 llc 降为 libm fmod：trunc 语义，与 Go 同 IR 形制同 lowering；oracle 实钉 7.0%2.5=2.0），f64 算术 + - * / % 族收齐）/
;         PrefixExpression（s66：-x / !x，仅 i64；s69：~x 位非 ⇒ OP-XOR(x, CONST -1)，镜像 Go ~→XOR-all-ones；s70：f64 -x ⇒ OP-NEG/fneg double，镜像 Go emitNeg float 分支——操作数必为 f64 形参，无 f64 字面量；s81：u64 主体 -x ⇒ OP-NEG(dest TY-U64)、~x ⇒ OP-CONST(-1)+OP-XOR(dest TY-U64)，cg 整数臂发 sub i64 0 / xor i64（二补回绕/bit-not，与 i64 同 IR 形）；s88：'!' 于 i64／u64 一律先 OP-CONST(1)＋OP-AND 归位低 bit 再 OP-NOT（镜像 Go emitNot `xor i1 1, trunc i64→i1` 的 bool 域 (x&1)^1；旧 s66 全宽 xor i64 1 仅操作数∈{0,1} 同值），f64 主体 '!' 仍门禁——Go 侧 double→i1 退化恒 true，无可镜像稳定语义；s89 裁定纪实＋哨兵：非整型主体 '!' 三面（f64 poison／str 运行路 build fail／字面量恒真折叠）均无权威，门禁维持）/
;         CallExpression（零参或多参——实参值 id 走侧池 args（s64），缺省实参按签名 fdef 表在调用点降默认式回填（s92，镜像 Go hir2mir.go:13175 尾部回填），返回型别查模块级签名表）/
;         语句位调用（s93）：K-EXPRESSION-STATEMENT 包 K-CALL-EXPRESSION ⇒ 走 h2m-lower-expr 后【丢弃结果值】，
;         镜像 Go hir2mir.go:3790 KExprStmt 的 else 分支（l.stmtVal = l.lowerExpr(child)，非取值位置不发绑定）；
;         无输出参被调沿用既有「void ⇒ define i64 + 尾部 ret 0」约定 ⇒ 陈述位发 call i64 并把值 id 丢掉（LLVM 容未用值）；
;         同层的裸字面量/裸函数标识符陈述【不放行】——Go 在 checker 层 checkBareExprStatement 专拒
;         （yf6kxdmz / k9179drd），自举无 checker，故仍走 hd=0 诚实门禁（同 s92「被缺且无默认值」兜法）/
;         控制流（s57）：K-IF-EXPRESSION（含可选 else，elif 链按嵌套 if 递归）/
;         K-FOR-STATEMENT 的纯前置条件循环（Init/Update/IterRange 必须全 0）/
;         计数循环（s60m）：K-FOR-STATEMENT 的 CountExpr 形 `N * { }` 与 `{ } * N`（两形在 parser 归一）——
;         计数器落 entry 的 alloca 槽（槽名由 ForStatement 节点 id 合成），header 判 >0、update 块自减
;         区间遍历（s61）：K-FOR-STATEMENT 的 IterRange 形 `i <- [a..b]`（四括号组合＋自动双向）——
;         循环变量落 entry 的 alloca 槽（按源名登记），方向由 lo <= hi 的分支解析（IR 无 select），
;         init/header/update 三处各判一次方向，共 11 块；端点只求值一次，其后各块按 SSA 支配关系复用
;         容器遍历（s62）：K-FOR-STATEMENT 的 IterRange 形 `i <- xs`（源限 TY-VEC 形参）——
;         复用既有 OP-VECLEN/OP-VECGET（零改 cg）：长度在进循环前只求一次，索引落 entry 的合成槽
;         `@idx<node>`，元素 STORE 进循环变量同名 i64 槽；共 5 块（pre/hdr/body/upd/exit），
;         continue 目标 = update（自增后再判，与 s60m 计数循环同口径）
;         控制流（s58）：K-SURFACE-MATCH 的语句位花括号短路链 `{ c1 -> a1  c2 -> a2  -> b }`
;         （臂群在 helper/aux 阵，12 aux/臂，展开成 if/elif/else 的 CONDBR 链——镜像 Go desugarSurfaceMatchToIfExpr）
;         值匹配（s63）：同一节点的显式主体形 `x: { 1 -> a1  2 -> a2  -> b }`——主体限「已在槽表登记且槽型 i64 的
;         裸标识符」、型样限「裸整型字面量」，逐臂在【本臂判定块内】重读主体发 OP-CMPEQ（复用 s35，零改 cg）；
;         臂体里的 `it` 隐式绑定（s65）：逐臂把主体值压进 c.itv 栈，嵌套 match 臂入栈臂退栈恢复外层
;         块终结形（s59）：return / break / continue（含 * / ** 速写经解析归一后的同形节点）——
;         return 走全函数共享的 ret 块（entry 零铺槽已保证未赋值输出参回零值），
;         break/continue 走循环目标栈（(hdr, exit) 对，限最内层循环、无标签形）；
;         三者都要求是本块最后一条陈述（其后陈述不可达 ⇒ 计 unsup，同 s58 兜底不在末位纪律）；
;   型别表：i64 / u64 / f64 / str 四个具名型别（K-NAMED-TYPE 的 s0）——只有签名侧认它们，
;         s94：?u64 option 三件套——签名侧 K-NULLABLE-TYPE(u64) ⇒ TY-OPT；nil 字面量 ⇒ OP-OPTNONE(tag=1)；
;         回值位非 option 右值 ⇒ 隐式 some 包裹（镜像 Go wrapOptionIfNeeded：整型載荷 OP-OPTSOME）；
;         s95：内层整型放宽 ?i64（同 64 位整宽槽、同 OP-OPTSOME）；s96：内层 ?f64（double 等宽、回值位改 OP-OPTMKF64 bitcast）；
;         覆盖面从直线式（mem==0）扩到控制流（mem==1）的 option 铺槽——s97：h2m-slot-decl 认 TY-OPT 发 OP-OPTALLOC + tag=1 nil-init；
;         写点 h2m-var-write 分 option←option 直存 OP-OPTSTORE／option←載荷经 h2m-opt-wrap 写点包裹再存、读点 OP-OPTLOAD；
;         回值位与写点共用 h2m-opt-wrap 单口径；撤除 s94 的 mem==1+option 整函数门禁（str/vec 載荷仍计 unsup）；option 的 match 臂仍走 s63 门禁
;         算术语义：二元 + - * 与六个比较符仅 i64（其余型别的值进运算符即计 unsup，不发错码）；
;         例外：前缀 '-'（s70）与二元 + - * /（s71）接受 f64 操作数（发 fneg/fadd/fsub/fmul/fdiv double）；s72：六个比较符亦接受 f64 操作数（发 fcmp 后 zext i1→i64，结果恒 i64）；位运算/移位/逻辑仍不收 f64；s76：u64 的 '/' '%' 经无符號重映射放行（OP-DIVU/OP-MODU，dest TY-U64）；s77：六个比较符亦接受 u64 操作数（< <= > >= 重映射为 OP-CMP*U 发 icmp u*，== != 與符號无关保持原 op，结果恒 i64）；s78：u64 的 '+ - *' 放行（不重映射，64 位宽下签／无签位元相同，dest TY-U64 发裸 add/sub/mul i64）；s79：u64 位运算/移位放行（'& | ^ <<' 发裸 and/or/xor/shl i64，'>>' 经 OP-SHRU 发 lshr）；s80：'>>' 改无条件重映射 OP-SHRU（i64 侧同发 lshr，与 Go 对齐）；u64 逻辑族仍不收
;   s99l：str 拼接——二元 '+' / '-' 于两侧皆 TY-STR 时降 OP-STRCAT（镜像 Go emitBinary：lt=="%str-long"
;         时非 '*' 一律 @str_concat；'*' 是重复 @_mir_str_repeat，h2m 无对应 op 故不放行）。@str_concat
;         造 rc=1 自拥有（两操作数各 memcpy 一份、不消耗）⇒ 结果登记 scope-exit 释放（与 s99j/s99k 同一
;         释放清单）；操作数按只读不释放（字面量指向静态常量）。混合 str/i64、str/txt（Go 先转标量再拼）未建模 ⇒ 计 unsup
;   s104：str 相等/不等——'==' / '!=' 于两侧皆 TY-STR 时降 OP-STEREQ / OP-STNEQ（镜像 Go 专用 OpStrEq：
;         icmp %str-long 非法，故降运行时 helper @str_eq，两串等 iff 长度相同且 memcmp==0）。结果恒 TY-I64（0/1），
;         与 s72 f64 比较、s77 u64 比较同口径——比较结果不是 str，故落 %v 命名空间而非 %sv。
;         **零改 cg / 零改 mir**：OP-STEREQ=63 / OP-STNEQ=64 早已在 mir.no 定义、cg.no 已实现，
;         @str_eq 由 cg-runtime-prelude-full 每模块发一次；缺的只是本层这条降级臂。
;         混合形（str == i64、str == ?str）与排序（str < str，Go 侧无对应降级）仍计 unsup
;   s99m：scope-exit 释放的放行/跳过（move 分析小型化）——撤除 s99k 的「含 OP-CALL 即整函数不放行」闸门：§5.6.1
;         铁律（传参不 retain／callee 不 release 参数／caller 在最后使用后 release）证明 call 是借用而非 move，含 call
;         亦释放；双释放改由 owner provenance 兜住——按「变量→owner」追踪 + retset（may-return）跳过「间接回传 r = u」
;         与「分支多写输出槽」两种 outsv 单值覆盖不到的情形。残余均为 leak（循环多迭代、may 近似、别名缺 retain），见 §5.3.4.en
;   s99n：vec 的取得所有权站点 + scope-exit 释放——切片字面量（K-SLICE-LITERAL，元素限 i64）降
;         OP-VECNEW + 逐元素 OP-VECPUSH，**最终** %vec 登记释放清单；退出时发 OP-VEC-FREE（cg 发
;         `call void @vec_free(%vec)`，运行时取 f2=dat ⇒ inttoptr ⇒ @free，dat==0 短路）。
;         ⚠️ vec 缓冲无 RC 头（§11 B5）⇒ 无 retain、只有一次性 free ⇒ 所有权必须唯一：中间 push 值
;            不入清单（@vec_push_i64 已自 free 旧缓冲），且所有权外流（结构体字面量字段 / 字段写 /
;            返回值）一律计 unsup——外流后 scope-exit 仍 free 就是 UAF。元素非 i64 的切片仍计 unsup
;   不支持（一律计入 unsup，绝不静默略过）：值位 K-SURFACE-MATCH 的【非 i64 臂值 / 非单表达式臂体】
;         （s103：`r = { c -> 1  -> 0 }` 已放行——逐臂 STORE 进 entry 结果槽、汇聚块 LOAD；str/vec
;         臂值与多陈述臂体仍计 unsup）、i64 除与余（`/` `%`——Go 侧 `?i64` 除零→err，i64 子集未建模 option；f64 `/` 已于 s71 放行），位清除 `&^`（无对应 op）、
;         多输出参数、泛型（c3 > 0）（s92：带默认值的参数已放行——调用点尾部回填，见上 CallExpression；带默认值的输出参与无默认值而被缺的形参仍入门禁）、
;         非具名型别（map / *t / 别名／[]非 i64／s62 起只 []i64 形参入形）、vec 形参作返回值（s62）、
;         复合赋值、非函数定义语句、方法调用（点号）、
;         容器遍历的非 vec 容器源——str（Go 逐码点走 utf8_at，需 OP-UTF8AT）／定长数组 [n]t（无运行期长度）／
;         vec 局部量（cg 只有 alloca i64 与 alloca %str-long 两种槽 op，无 %vec 槽）／元素非 i64 的 vec
;         （@vec_get_i64 是单型 helper）／体内改写循环变量（Go bindElemPlace 把循环变量绑到元素位址、
;         写它会【写回容器】，noc 的 VECGET 交出的是副本 ⇒ 语义分岔，就地不产码），
;         区间的开边界 `i <- [a..]`／`[..b]`／`[..]`（Go 取型别极值补齐，量级不可验证）、
;         嵌套同名区间循环（两层共用一个槽 ⇒ 内层踩掉外层计数），
;         带标签的 break/continue（s1 ≠ 'none'）、
;         带值的 return（nkid>1 且 kid[0] ≠ 0，语料中恒裸）；表达式位的链与臂体非末位终结形不产码
;         值匹配的非收形（s63）：解构绑定 ok(v)/err(e)、'ok' 关键字臂（dot-val）、raw-cond ok(<expr>) 臂、
;         型别臂（typePattern／typeArm）、非 i64 主体（str／vec／option）、非字面量型样（具名／-1 前缀式／布尔／字符串）
;
; ── 实参侧池 args（s64：摘掉旧「连续 id 契约」§11 B16）──────────────
;   cg 的 CALL 臂按 args[xa[k] + j] 读第 j 个实参的值 id ⇒ 实参入池必须是**连续段**，
;   但段内的值 id 可任意散布；生产侧先把一次调用的实参落临时 vec，校验全过后再按
;   调用点顺序整段追加进同一个池（嵌套调用实参降期自己会推池项，边降边推会挤偏基址）。Go 侧 Inst.Args 就是任意
;   ValueID 列表（src/mir/mir.go:1324，emitCall 直接 for i, a := range inst.Args），
;   本件把 noc 侧对齐到该形制：旧口径要求 xa..xa+bs-1 连续，于是「非首位实参需先
;   算一个中间值」的调用（如 f(x, i + 1)）全数撞门禁（实测 tmp/probe-s64-dump.no
;   的 c4/c5/c7/c9，改侧池后形制放行）。
;   ⚠️ 池单调追加、不回收：被拒调用不入池（校验在整段追加之前完成）；每个 CALL 各取自己
;     入池那一刻的 args.len() 作基址；函数一被计 unsup 就整函数不产码。
;
; ── 值 id 模型（与 cg.cg-emit-cfg-t 的约定对齐）───────────────────
;   id 0 = 哑元（vty[0] 先占位，永不引用）；1..nargs = 形参（s56 起按形参序单调分配）；
;   nargs+1 起由降级期单调分配。每个 LetStatement 把右值表达式的结果 id 直接绑到名字，
;   同名重复绑定 = 覆盖（镜像 §3.11「函数作用域内同名重复赋值 = 重赋值」）。
;
; ── 两种存储模式（s57：按体内有无控制流二选一，判据来自 h2m-scan 前扫描）─────
;   mem == 0（直线式，s55/s56 原样）：SSA 名即槽，**不发 alloca/store/load**。
;   mem == 1（体内有分支/循环）：**全部局部量（含形参）落 entry 块 alloca 槽**（-O0 风格），
;     读 = OP-LOAD/OP-SLOAD，写 = OP-STORE/OP-SSTORE。理由是 cg 只用 blks 数组切标签、
;     没有 PHI：跨块引用别的块的 SSA 名会被 opt 的 dominator 检查直接拒（then 块里绑的
;     %v9 在汇聚块不可用），而循环体内重绑同名变量若不落内存就退化成「永远只加第一轮的值」。
;     ⚠️ 槽必须在 entry：cg 要求每块是指令序的**连续段**，一旦离开 entry 就再也回不去，
;       所以槽位表由前扫描（h2m-lst + h2m-ty-of）先把名字与型别定下来，再进 body。
;     ⚠️ 槽型别只认 i64 / str（cg 只有 alloca i64 与 alloca %str-long 两种；f64 无槽 op）；
;       前扫描推不出型别的局部量（如 vec / 结构体）⇒ 计 unsup，整函数不产码。
;
; ── 诚实门禁 ─────────────────────────────────────────────────────
;   不支持的构造让 agg.unsup += 1。呼叫方必须以 unsup == 0 判定本轮产码可信，
;   不得把「产出了 IR」当成「降级正确」。
;
; SHS 合规：无模块级可变状态、无一等函数值、无指针、无 map 字段；
;   一律【普通函数 + 显式结构体参数】，不用方法（带 vec 字段的跨模块方法同 ast.no 风险面）。
; ⚠️ 整数运算默认回 option<int>：每条算术陈述都要 #{overflow=wrap}；
;    索引读取 arr[i] 返回 ?T，需以值 match / ?= / place-match 显式消费。

# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/mir
# /compiler/src/cg
# /compiler/src/util/sb.sb

; ── 降级上下文（指令流 + 值 id arena + 变量绑定表 + 块游标 + 诚实计数器）──
; ⚠️ 块游标纪律（s57）：cg 主循环按 `blks[k] != cur` 发标签 ⇒ **每块必须是指令序中的连续段**。
;   故本文件只单向推进块 id（entry → arms / loop 区域 → 汇聚块），回边只发 OP-BR 不再发指令；
;   一旦离开某块就绝不再写它（写回去会重复发标签，opt 报标签重定义）。
; s59 追加：ret = 共享 return 块的块 id（0 = 尚未开；懒开保证无 return 的函数 IR 逐字节不变）；
;   stk / stk-n = 循环目标栈（h2m-lower-for 进 body 前压 (continue 目标, exit) 对 ⇒ break/continue 查最内层；
;     条件循环的 continue 目标 = hdr，s60m 计数循环 = update 块，与 Go loopCtx{exit, update} 同口径）
; s61 追加：rnms / rnms-n = 活动遍历的循环变量名栈（内层与外层同名 ⇒ 共用一个槽会互相踩计数，
;     就地计 unsup；区间遍历与容器遍历共用本栈；⚠️ s65 修正：出栈时真刪除（pop），只減計数留陳項 ⇒
;     兄弟循环读到已退出层的陈名——误拒（同名合法复用被计 unsup）与漏闸双向错）
; s62 追加：epl / epl-n = 容器遍历体内活动的「元素位绑定名」栈（Go bindElemPlace 语义：写循环变量 = 写回容器元素；
;     noc 走 VECGET 取副本，写回不可得 ⇒ 名字命中即计 unsup；同 rnms，s65 起出栈真刪除）
;     另：TY-VEC 形参在 mem 模式下【不铺槽】——cg 没有 alloca %vec 的 op，而函数形参本身就是 entry 就存在
;     的 SSA 值、支配全函数所有块 ⇒ 绑定保持 incoming 值 id 即跨块可读（h2m-var-read 对此型别直返该 id）
h2m-ctx {
    ops []i64
    dsts []i64
    xa []i64
    bs []i64
    syms []str
    blks []i64
    vty []i64
    cty []i64
    names []str
    vids []i64
    tys []i64
    nid i64
    blk i64
    bnext i64
    mem i64
    unsup i64
    ret i64
    stk []i64
    stk-n i64
    rnms []str
    rnms-n i64
    epl []str
    epl-n i64
    args []i64
    itv []i64
    itv-n i64
    aln []str
    alv []i64
    alidx []i64
    ; s99：模块级结构体表（B10 唯一装配点的前置数据）。并行数组、按定义序稳定 id：
    ;   stn = 结构体名；stid = 结构体 id（= 型别码 - TY-STRUCT-BASE）；stfc = 字段数；
    ;   stft = 字段型别码拼接表（按 id 升序，长度 = Σ stfc）；stfldn = 字段名拼接表（与 stft 同序、同下标）；
    ;   stftn = 字段型别【节点 id】拼接表（与 stft/stfldn 同序、同下标）——两遍注册用：
    ;     第一遍只登记节点 id，第二遍（h2m-struct-resolve）等全部结构体名就位后再解析成型别码，
    ;     以支持「结构体字段引用较后定义的结构体」（单遍无法解析）。
    ; ⚠️ 数组在 h2m-lower-func 里从模块级 agg 浅拷进函数 ctx（只增不写），函数体只读，不另发独立副本
    stn []str
    stid []i64
    stfc []i64
    stft []i64
    stfldn []str
    stftn []i64
    ; s99j：scope-exit 释放清单（见下方 h2m-new 初始化处的说明）
    rls []i64
    rlsm []i64
    rlst []i64
    ; s99k：mem==1 scope-exit 释放扩展（解除 s99j 的 mem==0 限制）
    outn str; 输出（回传）变量名：body 降级时用它识别「写入输出槽」以记录 outsv/retset
    outsv i64; 最后写入输出槽的 owner id（= 该拥有值当前在输出槽、将被回传给呼叫方 ⇒ 释放时跳过防双重释放）
    ; s99m：所有权 provenance（may-move 分析）——mem==1 下 `r = u` 走 STLOAD 交出新 id ≠ owner，skip 失效；
    ;   故按「变量 → owner」追踪：间接回传时把 owner 正确并入 retset 跳过，防双重释放。
    ;   （§5.6.1 铁律：传参不 retain、callee 不 release 参数 ⇒ call 是借用而非 move，故 s99k 的 hc 整函数闸门可撤）
    ownn []str; 变量名（独立维护，避免与 vids 并行数组同步风险；name 键，同 h2m-name-find 口径）
    ownv []i64; 该变量当前持有的 owner 值 id（0 = 不拥有）
    rdval i64; 最近一次 var-read 交出的值 id（供 var-write 判定「右值是否就是某次读」以传 owner）
    rdown i64; 最近一次 var-read 的 owner（该名字当时的 owner）
    retset []i64; 「可能被回传」的 owner 集合（may-return：任一次写输出槽的 owner 并入；释放时跳过）
}

; 新建降级上下文：vty 先占 id 0（哑元），下一个可用 id = 1；块 0 = entry
; c: 上下文
h2m-new = () (c h2m-ctx) {
    c = h2m-ctx{
        ops: []
        dsts: []
        xa: []
        bs: []
        syms: []
        blks: []
        vty: []
        cty: []
        names: []
        vids: []
        tys: []
        nid: 1
        blk: 0
        bnext: 1
        mem: 0
        unsup: 0
        ret: 0
        stk: []
        stk-n: 0
        rnms: []
        rnms-n: 0
        epl: []
        epl-n: 0
        args: []
        itv: []
        itv-n: 0
        aln: []
        alv: []
        alidx: []
        stn: []
        stid: []
        stfc: []
        stft: []
        stfldn: []
        stftn: []
        ; s99j：scope-exit 释放清单——函数退出时为仍持有堆的活变量发 OP-RELEASE / OP-STRUCT-RELEASE。
        ;   与 s99g 的「取得所有权」半边配对（s99g 在 MK 后发 OP-STRUCT-RETAIN，本件在退出时发 RELEASE）。
        ;   rls = 待释放值 id（%st / %sv）；rlsm = 字段掩码（>0 ⇒ OP-STRUCT-RELEASE，bit j 置位 ⇔ 欄位 j 是 str；
        ;     0 ⇒ TY-STR 纯 str ⇒ OP-RELEASE）；rlst = 值型别码（TY-STR 或 TY-STRUCT-BASE+sid），用于选 OP 码。
        ;   按 vid 去重（同一值只释放一次）。⚠️ 仅 mem==0 放行（见 h2m-emit-releases）。
        rls: []
        rlsm: []
        rlst: []
        outn: ''
        outsv: 0
        ownn: []
        ownv: []
        rdval: 0
        rdown: 0
        retset: []
    }
    c.vty.push(TY-I64)
}

; 分配一个新值 id，并把它的型别码登记进 vty（vty 按值 id 索引，必须同步填）
; c: 上下文
; ty: 型别码
; id: 新分配的值 id
h2m-alloc = (c h2m-ctx, ty i64) (id i64) {
    c.vty.push(ty)
    id = c.nid

    #{overflow=wrap}
    c.nid = c.nid + 1
}

; 追加一条指令（落到当前块 c.blk；s57 前恒为 entry = 0）
; c: 上下文
; op: OP-* 码
; d: 结果值 id（无结果指令传 0；⚠️ OP-CONDBR 的 d 被 cg 当【假块 id】用）
; a: 第一实参
; b: 第二实参
; sym: 符号槽（字符串字面量等）
; res: 结果型别码（写入 cty[k]）
h2m-emit = (c h2m-ctx, op i64, d i64, a i64, b i64, sym str, res i64) {
    c.ops.push(op)
    c.dsts.push(d)
    c.xa.push(a)
    c.bs.push(b)
    c.syms.push(sym)
    c.blks.push(c.blk)
    c.cty.push(res)
}

; s99j：登记一个待释放值（scope-exit 时发 OP-RELEASE / OP-STRUCT-RELEASE）。按 vid 去重。
;   vid = 值 id（%st / %sv）；ty = 型别码（TY-STR 或 TY-STRUCT-BASE+sid）；
;   mask = 字段掩码（含 str 欄位 ⇒ >0，走 OP-STRUCT-RELEASE；纯 str ⇒ 0，走 OP-RELEASE）。
h2m-rel-add = (c h2m-ctx, vid i64, ty i64, mask i64) {
    dup = 0
    i = 0
    (i < c.rls.len() && dup == 0) {
        c.rls[i] == vid -> dup = 1

        #{overflow=wrap}
        i = i + 1
    }
    dup == 0 -> {
        c.rls.push(vid)
        c.rlsm.push(mask)
        c.rlst.push(ty)
    }
}

; s99m：变量 → owner 存取（name 键；owner = 0 表示不拥有/清除）。owner 即「该变量当前持有的自拥有值 id」
;   （MK 结构体值 / STRCAT 结果），是个 SSA 值 id；用于间接回传识别与释放时跳过。
; c: 上下文
; name: 变量名
; owner: owner 值 id（0 = 清除）
h2m-own-set = (c h2m-ctx, name str, owner i64) {
    found = 0
    i = 0
    (i < c.ownn.len() && found == 0) {
        c.ownn[i] == name -> {
            c.ownv[i] = owner
            found = 1
        }

        #{overflow=wrap}
        i = i + 1
    }
    found == 0 -> {
        c.ownn.push(name)
        c.ownv.push(owner)
    }
}

; s99m：查变量当前 owner（未登记或已清除 ⇒ 0）
; c: 上下文
; name: 变量名
; owner: owner 值 id（0 = 不拥有）
h2m-own-get = (c h2m-ctx, name str) (owner i64) {
    owner = 0
    i = 0
    (i < c.ownn.len() && owner == 0) {
        c.ownn[i] == name -> owner = c.ownv[i]

        #{overflow=wrap}
        i = i + 1
    }
}

; s99m：值 id 是否在释放清单里（= 是 h2m 自造的自拥有值：MK 结构体 / STRCAT 结果）
; c: 上下文
; vid: 值 id
; yes: 1 = 在清单
h2m-rel-has = (c h2m-ctx, vid i64) (yes i64) {
    yes = 0
    i = 0
    (i < c.rls.len() && yes == 0) {
        c.rls[i] == vid -> yes = 1

        #{overflow=wrap}
        i = i + 1
    }
}

; s99n：值 id 是否「自拥有 vec」（= 切片字面量产出的 %vec，已入释放清单）
;   所有权外流（写进结构体字段 / 作返回值）必须计 unsup——vec 缓冲无 RC 头（§11 B5），
;   没有 retain 可用，一旦外流而 scope-exit 仍 free，就是悬垂指针（UAF）。
; c: 上下文
; vid: 值 id
; yes: 1 = 自拥有 vec
h2m-vec-own = (c h2m-ctx, vid i64) (yes i64) {
    yes = 0
    vid > 0 && h2m-rel-has(c, vid) == 1 && h2m-vty-at(c, vid) == TY-VEC -> yes = 1
}

; s99m：把一个 owner 并入「可能被回传」集合（按 vid 去重；may-return 分析）
; c: 上下文
; vid: owner 值 id
h2m-ret-add = (c h2m-ctx, vid i64) {
    dup = 0
    i = 0
    (i < c.retset.len() && dup == 0) {
        c.retset[i] == vid -> dup = 1

        #{overflow=wrap}
        i = i + 1
    }
    dup == 0 -> c.retset.push(vid)
}

; s99m：值 id 是否「可能被回传」（释放时跳过防双重释放）
; c: 上下文
; vid: 值 id
; yes: 1 = 可能被回传
h2m-ret-has = (c h2m-ctx, vid i64) (yes i64) {
    yes = 0
    i = 0
    (i < c.retset.len() && yes == 0) {
        c.retset[i] == vid -> yes = 1

        #{overflow=wrap}
        i = i + 1
    }
}

; s99j/s99k/s99m：函数 scope-exit 释放——遍历释放清单，对每条未被「回传/占用」的值发释放指令。
;   三路跳过（防双重释放）：
;     · skip = 返回值的值 id（mem==0：输出参直接绑定的 MK 原 id；mem==1：共享 ret 块 STLOAD 出的新 id）；
;     · outsv = 最后写入输出槽的 owner（mem==1 下输出参住槽，退出重读是 STLOAD 新 id，故须用写入槽的 owner）；
;     · retset = 「可能被回传」的 owner 集合（may-return，覆盖「间接回传 r = u」与「分支多写输出槽」——
;       两者 outsv 单值都覆盖不到，用集合兜住）。
;   ⚠️ 放行（s99m 撤除 s99k 的 hc 整函数闸门）：
;     · 恒放行——§5.6.1 铁律证明 call 是借用、非 move（传参不 retain、callee 不 release 参数、caller 在最后
;       使用后 release），故含 OP-CALL 的 mem==1 函数亦可释放局部自拥有值，不产生双释放。
;     · 已知残余（诚实标注，均为 leak 非 double-free）：
;       ①循环体内 MK 出的值按「一个 SSA 值」静态释放一次，多迭代者每次迭代的堆会漏（非本件，s99j/s99k 同）；
;       ②「可能被回传」是 may 近似，分支多写输出槽时非实际回传的那支也跳过 ⇒ leak；
;       ③别名缺 retain（v = u 不复刻 §5.6.1 的「赋第二变量须 retain」）——当前靠「单值单释放 + scope-exit」不显形，属 M7 精确所有权留待。
h2m-emit-releases = (c h2m-ctx, skip i64) {

    ; s99m：撤除 s99k 的 hc 整函数闸门——§5.6.1 铁律（传参不 retain／callee 不 release 参数／caller 在最后
    ;   使用后 release）⇒ call 是借用而非 move，含 call 的 mem==1 函数亦可在 scope-exit 释放局部自拥有值。
    ;   双重释放改由三路跳过兜住：skip（mem==0 直返 id）／outsv（最后写入输出槽的 owner）／retset（may-return，
    ;   覆盖「间接回传 r = u」与「分支多写输出槽」两种 outsv 单值覆盖不到的情形）。
    i = 0
    (i < c.rls.len()) {
        vid = c.rls[i]
        m = c.rlsm[i]
        ty = c.rlst[i]
        (vid != skip && vid != c.outsv && h2m-ret-has(c, vid) == 0) -> {
            ty == TY-STR -> h2m-emit(c, OP-RELEASE, 0, vid, 0, '', TY-STR)

            ; s99n：vec 走破坏性一次性释放（缓冲无 RC 头，§11 B5 —— 无 retain，只有 free）
            ty == TY-VEC -> h2m-emit(c, OP-VEC-FREE, 0, vid, 0, '', 0)
            ty >= TY-STRUCT-BASE && m > 0 -> h2m-emit(c, OP-STRUCT-RELEASE, 0, vid, m, '', 0)
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; 新开一个基本块并回它的 id（只分配 id，不发指令；块内容由后续 h2m-set-block 写入）
; c: 上下文
; id: 新块 id（entry = 0，故首个新块是 1）
h2m-block-new = (c h2m-ctx) (id i64) {
    id = c.bnext

    #{overflow=wrap}
    c.bnext = c.bnext + 1
}

; 切当前块（后续 h2m-emit 落到此块）⚠️ 只可切到尚未写过指令的块（连续段纪律）
; c: 上下文
; id: 目标块 id
h2m-set-block = (c h2m-ctx, id i64) {
    c.blk = id
}

; 记一条「本切片不支持」的构造（诚实门禁，不是静默略过）
; c: 上下文
h2m-mark = (c h2m-ctx) {

    #{overflow=wrap}
    c.unsup = c.unsup + 1
}

; 查变量绑定的值 id
; c: 上下文
; name: 变量名
; id: 值 id（0 = 未绑定）
h2m-var-find = (c h2m-ctx, name str) (id i64) {
    id = 0
    i = 0
    (i < c.names.len() && id == 0) {
        nm = c.names[i]
        nm == name -> {
            vid = c.vids[i]
            id = vid
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; 绑定变量名到值 id：已有同名绑定则覆盖（重赋值语义），否则追加（仅 mem == 0 直线式路径）
; c: 上下文
; name: 变量名
; id: 值 id
h2m-var-bind = (c h2m-ctx, name str, id i64) {
    found = 0
    i = 0
    (i < c.names.len() && found == 0) {
        nm = c.names[i]
        nm == name -> {
            c.vids[i] = id
            found = 1
        }

        #{overflow=wrap}
        i = i + 1
    }
    found == 0 -> {
        c.names.push(name)
        c.vids.push(id)
        c.tys.push(0)
    }
}

; ── mem 模式（s57）：局部量落 alloca 槽的三件套 ────────────────────
; 名字在 c.names 中的下标；-1 = 未登记（与 h2m-var-find 共用线性扫，表长只几个局部量）
; c: 上下文
; name: 变量名
; i: 下标（-1 = 未找到）
h2m-name-find = (c h2m-ctx, name str) (i i64) {
    i = -1
    j = 0
    (j < c.names.len() && i < 0) {
        nm = c.names[j]
        nm == name -> i = j

        #{overflow=wrap}
        j = j + 1
    }
}

; 为名字铺一个槽（s57：必须在 entry 块调用，因 cg 要求块为连续段、离开 entry 就回不去）
; 同名已有条目（形参已经绑过值 id）则把绑定改写为槽；同时零初始化，避免未赋值先读拿到 poison
; ⚠️ TY-U64 在 LLVM 里与 TY-I64 同类型（i64），共用 alloca i64 槽；s74：TY-F64 铺 alloca double 槽（零初始化携 sym='0.0'，供 cg 的 fadd 物化分支）
; ⚠️ s62：TY-VEC 走【不铺槽】分支——cg 没有 alloca %vec 的 op，而函数形参本身就是 entry 就存在的
;   SSA 值（支配全函数所有块）⇒ 只记型别、沿用已绑的 incoming 值 id；名字尚无绑定（vec 局部量）⇒ 计 unsup
; c: 上下文
; name: 变量名
; ty: 槽型别码（认 TY-I64 / TY-U64 / TY-F64 / TY-STR / TY-OPT；TY-VEC 不铺槽）
h2m-slot-decl = (c h2m-ctx, name str, ty i64) {
    ty == TY-VEC -> {
        i0 = h2m-name-find(c, name)
        i0 >= 0 -> c.tys[i0] = ty
        i0 < 0 -> h2m-mark(c)
    }
    ty != TY-VEC -> {
        sid = h2m-alloc(c, ty)
        ok-slot = 1
        ty != TY-I64 && ty != TY-U64 && ty != TY-STR && ty != TY-F64 && ty != TY-OPT && ! (ty >= TY-STRUCT-BASE) -> ok-slot = 0
        ok-slot == 1 && ty != TY-STR && ty != TY-OPT -> {
            h2m-emit(c, OP-ALLOC, sid, 0, 0, '', ty)
            zid = h2m-alloc(c, ty)

            ; s74：f64 零初始化携 sym='0.0'——cg 的 OP-CONST TY-F64 分支读 sym 发 fadd double 0.0, <sym>，空 sym 会产非法 IR
            zs = ''
            ty == TY-F64 -> zs = '0.0'
            h2m-emit(c, OP-CONST, zid, 0, 0, zs, ty)
            h2m-emit(c, OP-STORE, 0, zid, sid, '', 0)
        }
        ok-slot == 1 && ty == TY-STR -> {
            h2m-emit(c, OP-SALLOC, sid, 0, 0, '', TY-STR)
            zid2 = h2m-alloc(c, TY-STR)
            h2m-emit(c, OP-STRCONST, zid2, 0, 0, '', TY-STR)
            h2m-emit(c, OP-SSTORE, 0, zid2, sid, '', 0)
        }

        ; s97：TY-OPT 铺槽——镜像 Go 的 option 局部 alloca %option + tag=1 零初始化（延迟零值=nil）；
        ;   槽发 OP-OPTALLOC（cg s41 既存 %os 命名空间），初值 OP-OPTNONE（tag=1）经 OP-OPTSTORE 落槽，
        ;   使控制流下「未写路径」读出 nil 而非 some(0)（正是 s94 门禁所防的错形）
        ok-slot == 1 && ty == TY-OPT -> {
            h2m-emit(c, OP-OPTALLOC, sid, 0, 0, '', TY-OPT)
            zid3 = h2m-alloc(c, TY-OPT)
            h2m-emit(c, OP-OPTNONE, zid3, 0, 0, '', TY-OPT)
            h2m-emit(c, OP-OPTSTORE, 0, zid3, sid, '', 0)
        }

        ; s99c：结构体局部量落 entry 的 alloca %struct.sN 槽（%sts<sid>，与值 %st<sid> 分开命名空间）；
        ;   无零初始化——写前读会拿 poison，但良构程序每条路径写先于读；cg 的 OP-STALLOC 用 b 槽传结构体 id
        ok-slot == 1 && ty >= TY-STRUCT-BASE -> {
            h2m-emit(c, OP-STALLOC, sid, 0, ty - TY-STRUCT-BASE, '', 0)
        }
        ok-slot == 0 -> h2m-mark(c)
        ok-slot == 1 -> {
            i = h2m-name-find(c, name)
            i >= 0 -> {
                c.vids[i] = sid
                c.tys[i] = ty
            }
            i < 0 -> {
                c.names.push(name)
                c.vids.push(sid)
                c.tys.push(ty)
            }
        }
    }
}

; 把形参 incoming 值存进它的槽（仍需在 entry 块调用；值 id 由 h2m-alloc 单调分配⇒c 已绑同名的槽）
; c: 上下文
; name: 形参名
; vid: 形参的值 id（1..nargs）
; ty: 槽型别码
h2m-slot-init-arg = (c h2m-ctx, name str, vid i64, ty i64) {
    sid = 0
    st = -1
    i = h2m-name-find(c, name)
    i >= 0 -> {
        sid = c.vids[i]
        st = c.tys[i]
    }
    st == ty && ty != TY-VEC && ty != TY-STR && ty < TY-STRUCT-BASE -> h2m-emit(c, OP-STORE, 0, vid, sid, '', 0)
    st == ty && ty == TY-STR -> h2m-emit(c, OP-SSTORE, 0, vid, sid, '', 0)

    ; s99c：结构体形参 incoming 值落 %sts<sid> 槽（cg OP-STSTORE：xa=值、bs=槽）
    st == ty && ty >= TY-STRUCT-BASE -> h2m-emit(c, OP-STSTORE, 0, vid, sid, '', 0)

    ; s62：TY-VEC 形参无槽可存——绑在名字上的值 id 就是该 incoming vid ⇒ 空操作
    st != ty -> h2m-mark(c)
    i < 0 -> h2m-mark(c)
}

; 读一个变量的当前值：mem == 0 直返 SSA 值 id；mem == 1 在当前块发 LOAD/SLOAD
; s65：`it` 隐式绑定——值匹配臂降级时把主体值压进 c.itv 栈（不进 names/槽表），栈顶即当前臂的绑定值；
;   绑定臂内的 `it` 读永在 match 内（栈非空），match 外的 `it` 仍走 names 路（查不到计 unsup）
; c: 上下文
; name: 变量名
; v: 值 id（0 = 未登记或槽型 unsupported，已计入 unsup）
h2m-var-read = (c h2m-ctx, name str) (v i64) {
    v = 0
    name == 'it' && c.itv-n > 0 -> v = c.itv[c.itv-n - 1]
    name != 'it' || c.itv-n <= 0 -> {

        ; s98：臂局部名（ok(v) 等 match 臂绑定）——跨 mem 模式直返 SSA 值，绕过槽 LOAD；
        ;   后入栈者优先（同名取最近一臂），臂退出时由调用方 pop 还原外层绑定
        ai = c.aln.len() - 1
        fal = 0
        (ai >= 0 && fal == 0) {
            c.aln[ai] == name -> {
                v = c.alv[ai]
                fal = 1
            }

            #{overflow=wrap}
            ai = ai - 1
        }
        fal == 0 -> {
            i = h2m-name-find(c, name)
            i < 0 -> h2m-mark(c)
            i >= 0 && c.mem == 0 -> v = c.vids[i]
            i >= 0 && c.mem == 1 -> {
                sid = c.vids[i]
                st = c.tys[i]
                st == TY-I64 || st == TY-U64 || st == TY-F64 -> {
                    v = h2m-alloc(c, st)
                    h2m-emit(c, OP-LOAD, v, sid, 0, '', st)
                }
                st == TY-STR -> {
                    v = h2m-alloc(c, TY-STR)
                    h2m-emit(c, OP-SLOAD, v, sid, 0, '', TY-STR)
                }

                ; s97：TY-OPT 槽读——OP-OPTLOAD 交出 %option 值（cg %op 命名空间，与 SLOAD 同形：槽在 a、结果在 dst）
                st == TY-OPT -> {
                    v = h2m-alloc(c, TY-OPT)
                    h2m-emit(c, OP-OPTLOAD, v, sid, 0, '', TY-OPT)
                }

                ; s62：TY-VEC 不铺槽 ⇒ 绑定的 sid 就是 entry 的 incoming 形参值 id，支配全函数各块，直返即可
                st == TY-VEC -> v = sid
                st >= TY-STRUCT-BASE -> {
                    v = h2m-alloc(c, st)
                    h2m-emit(c, OP-STLOAD, v, sid, 0, '', st)
                }
                st != TY-I64 && st != TY-U64 && st != TY-STR && st != TY-VEC && st != TY-F64 && st != TY-OPT && ! (st >= TY-STRUCT-BASE) -> h2m-mark(c)
            }
        }
    }

    ; s99m：记录本次读的值 id 与其 owner（供 var-write 判定「右值是否就是某次读」并传递 owner）
    v > 0 -> {
        c.rdval = v
        c.rdown = h2m-own-get(c, name)
    }
}

; 把非 option 右值包成 %option（镜像 Go wrapOptionIfNeeded：hir2mir.go:14893）：TY-I64/TY-U64→OP-OPTSOME、
;   TY-F64→OP-OPTMKF64（bitcast double→i64）；已是 option／str／vec（載荷未入形）原样返回
;   ⇒ 呼叫方以 wrapped == rid 判定「不可包」（str/vec）→ 计 unsup，宁缺勿错
; ⚠️ 回值位（h2m-lower-func 尾）与写点（h2m-var-write）共用本子程序，不留两套包裹口径（§11 B7）
; c: 上下文
; rid: 右值 id
; wrapped: 包裹后的 option 值 id（不需/不能包裹时 == rid）
h2m-opt-wrap = (c h2m-ctx, rid i64) (wrapped i64) {
    wrapped = rid
    rid > 0 -> {
        pty = h2m-vty-at(c, rid)
        some-w = 0
        some-wf = 0
        pty == TY-I64 || pty == TY-U64 -> some-w = 1
        pty == TY-F64 -> some-wf = 1
        some-w == 1 -> {
            wid = h2m-alloc(c, TY-OPT)
            h2m-emit(c, OP-OPTSOME, wid, rid, 0, '', TY-OPT)
            wrapped = wid
        }
        some-wf == 1 -> {
            widf = h2m-alloc(c, TY-OPT)
            h2m-emit(c, OP-OPTMKF64, widf, rid, 0, '', TY-OPT)
            wrapped = widf
        }
    }
}

; 写一个变量：mem == 0 绑/覆盖值 id；mem == 1 发 STORE/SSTORE/OPTSTORE 进槽（型别不符 ⇒ unsup）
; ⚠️ s97：mem==1 的 TY-OPT 槽写分两路——option←option 直存 OP-OPTSTORE；option←載荷（i64/u64/f64）
;   先经 h2m-opt-wrap 写点包裹再存（镜像 Go）；str/vec 載荷不可包 → 仍落 ok-w==0 计 unsup
; ⚠️ s62 元素位门禁：名字落在容器遍历的活动名栈 c.epl 里 ⇒ Go 的 bindElemPlace 会把这次赋值
;   【写回容器元素】，而 noc 侧 VECGET 交出的是副本、写它只改副本 ⇒ 语义分岔，计 unsup 整函数不产码
; ⚠️ s65 写 `it` 门禁：绑定臂内对 `it` 赋值不在覆盖面（臂绑定值是只读侧池项，无槽可落）⇒ 计 unsup
; ⚠️ TY-VEC 无槽也不能写（cg 无 %vec 的 store op）⇒ 落入 ok-w == 0 计 unsup
; c: 上下文
; name: 变量名
; val: 右值的值 id
h2m-var-write = (c h2m-ctx, name str, val i64) {
    hit = 0
    it-w = 0
    name == 'it' && c.itv-n > 0 -> it-w = 1
    it-w == 1 -> h2m-mark(c)
    q = 0
    (q < c.epl-n && hit == 0) {
        en = c.epl[q]
        en == name -> hit = 1

        #{overflow=wrap}
        q = q + 1
    }
    hit == 1 -> h2m-mark(c)
    it-w == 0 && hit == 0 && c.mem == 0 -> h2m-var-bind(c, name, val)
    it-w == 0 && hit == 0 && c.mem == 1 -> {
        ok-w = 0
        i = h2m-name-find(c, name)
        i >= 0 -> {
            sid = c.vids[i]
            st = c.tys[i]
            vt = h2m-vty-at(c, val)
            st == vt && st != TY-STR && st != TY-VEC && st != TY-OPT && st < TY-STRUCT-BASE -> {
                h2m-emit(c, OP-STORE, 0, val, sid, '', 0)
                ok-w = 1
            }
            st == vt && st == TY-STR -> {
                h2m-emit(c, OP-SSTORE, 0, val, sid, '', 0)
                ok-w = 1
            }

            ; s97：option 槽 ← option 值（nil 字面量／另一 ?T 右值）——直存 OP-OPTSTORE
            st == TY-OPT && st == vt -> {
                h2m-emit(c, OP-OPTSTORE, 0, val, sid, '', 0)
                ok-w = 1
            }

            ; s97：option 槽 ← 載荷右值（i64/u64/f64）——写点 some-wrap（与回值位共用 h2m-opt-wrap）再存；
            ;   str/vec 載荷不可包（wrapped==val）→ ok-w 仍 0 → 计 unsup
            st == TY-OPT && vt != TY-OPT -> {
                wv = h2m-opt-wrap(c, val)
                wv != val -> {
                    h2m-emit(c, OP-OPTSTORE, 0, wv, sid, '', 0)
                    ok-w = 1
                }
            }

            ; s99c：结构体槽写——整结构体值 %st<val> 落 %sts<sid>（cg OP-STSTORE：xa=值、bs=槽）
            st == vt && st >= TY-STRUCT-BASE -> {
                h2m-emit(c, OP-STSTORE, 0, val, sid, '', 0)
                ok-w = 1
            }

            ; s99m：owner provenance——val 是自拥有值（在 rel-list：MK 结构体 / STRCAT 结果）或直接来自某次读
            ;   （val == rdval，如 `r = u`）⇒ 记该变量的 owner；写输出槽（name == outn）时把 owner 记入
            ;   outsv 与 retset（间接回传的 owner 在此被正确捕获，退出释放时跳过，防双重释放）。
            ownr = 0
            val > 0 && h2m-rel-has(c, val) == 1 -> ownr = val
            ownr == 0 && val > 0 && val == c.rdval -> ownr = c.rdown
            h2m-own-set(c, name, ownr)
            name == c.outn -> {
                c.outsv = ownr
                ownr > 0 -> h2m-ret-add(c, ownr)
            }
        }
        ok-w == 0 -> h2m-mark(c)
    }
}

; 安全读某值 id 的型别码（越界回元素零值 = TY-I64，与 cg.cg-vty-at 同口径）
; c: 上下文
; id: 值 id
; t: 型别码
h2m-vty-at = (c h2m-ctx, id i64) (t i64) {
    t = c.vty[id]
}

; 具名型别 → MIR 型别码；本件只收四个基础型别，认不出回 -1（呼叫方计 unsup）
; s: 型别名文本（K-NAMED-TYPE 的 s0）
; t: 型别码（-1 = 不在覆盖面）
h2m-ty-code = (s str) (t i64) {
    t = -1
    s == 'i64' -> t = TY-I64
    s == 'u64' -> t = TY-U64
    s == 'f64' -> t = TY-F64
    s == 'str' -> t = TY-STR

    ; s90：bool 型别码 ⇒ TY-I64——Go MIR 层 bool 载荷即 int64（codegen 的 i1 形属后端类型环境），
    ;   自举无独立 i1 槽先例，与整族共用 i64 宽（s78/s83/s88）；s88 '!' 臂 TY-I64 主体门天然贯通 bool
    s == 'bool' -> t = TY-I64

    ; s91：char 型别码 ⇒ TY-I64——Go 侧 char=i32（Unicode 标量值），自举无 i32 槽；
    ;   码点 ≤0x10FFFF 落 i64 精确、槽/常量同宽无混用（同 bool 的 i64 宽先例）
    s == 'char' -> t = TY-I64
}

; 型别 AST 节点 → MIR 型别码（s94 共用判据）：K-NAMED-TYPE 走 h2m-ty-code，
;   K-NULLABLE-TYPE(50) nkid=1、kid[0]=内层型别节点（ps.no 实测形制：tok.QUESTION 分支只
;   ast.kid-add 唯一 guarded CHILD=Type，无槽位）——只收 ?u64／?i64／?f64 ⇒ TY-OPT：noc 的 %option 載荷槽是
;   [3 x i64]、TY-OPT 不挾載荷型别；i64／u64 内层同为 64 位整宽槽（回值位 OP-OPTSOME）、f64 内层亦为
;   64 位（double 舆槽元素等宽，回值位 OP-OPTMKF64 以 bitcast double→i64 落 slot[0]）——
;   三内层皆已放行（与 Go 一致：optionPayloadCoerced 仅对 str/txt 内层做位形转换，整型／f64 内层
;   占同一 [3 x i64] 槽无分岔）；内层 str／vec（載荷降级卡 M4-d RC／ptrtoint，未入形）
;   一律不入——宁缺勿错（与 Go 一致：?T 在 MIR 层就是单一 %option）
;   ⚠️ 签名侧（h2m-param-ty）与 let 标注侧（h2m-lower-let）共用本式子——两条型别判定必须同口径（§11 B7）
; t: AST arena
; tn: 型别节点 id（0 = 缺位）
; code: 型别码（-1 = 不在覆盖面）
h2m-tynode-code = (t ast, agg h2m-ctx, tn i64) (code i64) {
    code = -1
    tn > 0 -> {
        d = ast.nd-at(t, tn)
        d.kind == asp.K-NAMED-TYPE -> {
            nm = ast.str-at(t, d.s0)
            code = h2m-ty-code(nm)

            ; s99b：具名型别若不是基本型，回退查模块级结构体表（定义序即 id 序）
            ;   ⇒ 结构体作形参／返回值／let 标注型别时，名字解析成 TY-STRUCT-BASE + sid
            code < 0 -> {
                sid = h2m-struct-find(agg, nm)
                sid >= 0 -> code = TY-STRUCT-BASE + sid
            }
        }
        d.kind == asp.K-NULLABLE-TYPE && d.nkid == 1 -> {
            ik = h2m-kid-i(t, tn, 0)
            ik > 0 -> {
                ind = ast.nd-at(t, ik)
                ind.kind == asp.K-NAMED-TYPE -> {
                    inm = ast.str-at(t, ind.s0)

                    ; s95：内层整型放宽——?i64 与 ?u64 同为 64 位整宽 %option 槽（回值位 some-wrap
                    ;   已放行 TY-I64／TY-U64 載荷），Go 侧整型内层不做位形转换，两口径同形
                    ; s96：内层 f64 放宽——?f64 载荷 double 舆 [3 x i64] 槽元素等宽，回值位 some-wrap
                    ;   走 OP-OPTMKF64（bitcast double→i64，与整型的 OP-OPTSOME 分岔但同为入形）
                    inm == 'u64' || inm == 'i64' || inm == 'f64' -> code = TY-OPT
                }
            }
        }

        ; s99f：结构体栏位型别支援 []i64（K-SLICE-TYPE）→ TY-VEC。
        ;   与 s62 形参口径一致——仅收元素为 i64 的切片（@vec_get_i64 / @vec_push_i64 是单型 helper）；
        ;   元素非 i64 的 vec（[]str 等）不携元素型别且运行期会被 i64 helper 误读 ⇒ 回 -1 计 unsup。
        ;   栏位位存／搬只认 %vec（3 字 i64 值），元素型别在栏位布局层面不敏感，故 []i64 栏位可正确
        ;   MK（insertvalue %vec）/ GET（extractvalue %vec）/ 作实参穿过 call；vec 返回与本地 vec 量仍不入形
        ;   （见 L3164 的 rb==0 && rc==TY-VEC -> bad=1 门禁），须由调用方以 []i64 形参注入 vec 值。
        d.kind == asp.K-SLICE-TYPE && d.nkid == 1 -> {
            ek = ast.kid-at(t, d.kid0)
            ek > 0 -> {
                ed = ast.nd-at(t, ek)
                ed.kind == asp.K-NAMED-TYPE -> {
                    enm = ast.str-at(t, ed.s0)
                    enm == 'i64' -> code = TY-VEC
                }
            }
        }
    }
}

; ── s99：结构体表查询 helper（表存 c.stn/stid/stfc/stft/stfldn，定义序即 id 序）──
; 按名查结构体 id（-1 = 未登记）
h2m-struct-find = (c h2m-ctx, name str) (sid i64) {
    sid = -1
    i = 0
    (i < c.stn.len() && sid < 0) {
        c.stn[i] == name -> sid = i

        #{overflow=wrap}
        i = i + 1
    }
}

; 取结构体 sid 的字段数
h2m-struct-fc = (c h2m-ctx, sid i64) (fc i64) {
    fc = c.stfc[sid]
}

; 取结构体 sid 第 fi 个字段的型别码（stft 为拼接表，需跳过前 sid 个结构体的字段）
h2m-struct-field-ty = (c h2m-ctx, sid i64, fi i64) (ty i64) {
    ty = -1
    off = 0
    i = 0
    (i < sid) {
        off = off + c.stfc[i]

        #{overflow=wrap}
        i = i + 1
    }
    ty = c.stft[off + fi]
}

; s99g：结构体 str 欄位位掩码——bit j 置位 ⇔ 第 j 個欄位型別是 TY-STR。
;   喂 OP-STRUCT-RETAIN/RELEASE 的 bs[k]（欄位掩碼）；無 str 欄位回 0（不發 retain）。
;   與 cg OP-STRUCT-RETAIN/RELEASE 的「bit j 置位 ⇒ 欄位 j 持有堆（且必須是 str）」約定一致。
h2m-struct-str-mask = (c h2m-ctx, sid i64) (mask i64) {
    mask = 0
    fc = h2m-struct-fc(c, sid)
    j = 0
    (j < fc) {
        fty = h2m-struct-field-ty(c, sid, j)
        fty == TY-STR -> mask = mask | (1 << j)

        #{overflow=wrap}
        j = j + 1
    }
}

; 按字段名查字段下标（-1 = 该结构体无此字段）；stfldn 与 stft 同序同下标
h2m-struct-field-idx = (c h2m-ctx, sid i64, fname str) (fi i64) {
    fi = -1
    off = 0
    i = 0
    (i < sid) {
        off = off + c.stfc[i]

        #{overflow=wrap}
        i = i + 1
    }
    j = 0
    (j < c.stfc[sid] && fi < 0) {
        c.stfldn[off + j] == fname -> fi = j

        #{overflow=wrap}
        j = j + 1
    }
}

; s99：在前扫描里登记一个结构体定义（K-STRUCT-DEFINITION 节点 n）。
; 定义序即 id 序：新结构体 id = 当前 stn 长度。字段逐个登记：本遍只把【型别节点 id】压进 stftn，
;   型别码留待 h2m-struct-resolve 在全部结构体名就位后统一解析（支持嵌套结构体字段、定义序无关）。
; 字段名进 stfldn；字段数进 stfc；型别码最终进 stft（与 stftn/stfldn 同序、同下标）。
; 字段型别覆盖面见 h2m-struct-resolve（i64/u64/f64/str/bool/char/嵌套结构体；vec/函數指標等不支援⇒计 unsup）。
h2m-struct-register = (c h2m-ctx, t ast, n i64) {
    d = ast.nd-at(t, n)

    ; ps-parse-struct-def 把名字存进 slot0（s1=implements 数、s2=fields 数），故此处读 s0
    sname = ast.str-at(t, d.s0)
    sid = h2m-struct-find(c, sname)
    sid >= 0 -> {
        ; 重复定义：保留首定义，静默跳过（Go 同名 struct 后定义不覆盖）
    }
    sid < 0 -> {
        nid = c.stn.len()
        c.stn.push(sname)
        c.stid.push(nid)
        fc = 0
        i = 0
        (i < d.nkid) {

            ; 字段跨定义逐个推进：d.kid0 是首 kid 的【位置】基址（非节点 id），
            ;   必须先 ast.kid-at 取该位置的子节点 id，再 ast.nd-at 取结构体（直传 d.kid0+i 给 nd-at 会读错节点）。
            fchild = ast.kid-at(t, d.kid0 + i)
            fnode = ast.nd-at(t, fchild)

            ; 定义内 StructField：s0 = 字段名，kid0 = 型别节点（NamedType / NullableType 等）
            ffname = ast.str-at(t, fnode.s0)
            ntk = ast.kid-at(t, fnode.kid0)

            ; 先登记型别【节点 id】，型别码延后由 h2m-struct-resolve 解析
            fc = fc + 1
            c.stftn.push(ntk)
            c.stfldn.push(ffname)

            #{overflow=wrap}
            i = i + 1
        }
        c.stfc.push(fc)
    }
}

; s99：第二遍——全部结构体名就位后，把 stftn（字段型别节点 id）逐字段解析成型别码压进 stft。
; 覆盖面与 h2m-tynode-code 一致：i64/u64/f64/str/bool/char（basic）+ 嵌套结构体（K-NAMED-TYPE 回退查表）；
; 不支援的栏位型别（vec／函數指標等）解析回 -1 ⇒ 整模块计 unsup，宁缺勿错。
; stft 与 stftn/stfldn 同序同下标、按结构体 id 升序拼接，故偏移算法与 h2m-struct-field-ty/-idx 一致。
h2m-struct-resolve = (c h2m-ctx, t ast) {
    n = c.stn.len()
    off = 0
    i = 0
    (i < n) {
        fc = c.stfc[i]
        j = 0
        (j < fc) {
            ftn = c.stftn[off + j]
            fty = h2m-tynode-code(t, c, ftn)
            fty < 0 -> h2m-mark(c)
            c.stft.push(fty)

            #{overflow=wrap}
            j = j + 1
        }
        off = off + fc

        #{overflow=wrap}
        i = i + 1
    }
}

; ⑭ 切片 4（2026-11-13）：逐模組結構體欄位型別解析（共享 agg 時，每個模組必須用「自己那棵 AST」
;   解析，否則跨模組結構體欄位型別節點讀到錯 AST 會解錯）。只解 [from, to) 區間的結構體並 push 進
;   共享 stft，與 h2m-struct-resolve（解全部）同序同偏移；供 drv.pkg-ll 在「全模組登記完」後，按模組順序
;   逐段解（每段用該模組自己的 t）。
h2m-struct-resolve-range = (c h2m-ctx, t ast, from i64, to i64) {
    n = c.stn.len()
    off = 0
    i0 = 0
    (i0 < from) {
        off = off + c.stfc[i0]

        #{overflow=wrap}
        i0 = i0 + 1
    }
    i = from
    (i < to) {
        fc = c.stfc[i]
        j = 0
        (j < fc) {
            ftn = c.stftn[off + j]
            fty = h2m-tynode-code(t, c, ftn)
            fty < 0 -> h2m-mark(c)
            c.stft.push(fty)

            #{overflow=wrap}
            j = j + 1
        }
        off = off + fc

        #{overflow=wrap}
        i = i + 1
    }
}

; s99：模块级结构体型别声明串（§11 B10 唯一装配点）。id 升序、nf>0 才发；
;   型别名经 cg.cg-ty-name 唯一映射（与 cg 发射端 %struct.s<id> 同源），避免两处各写一份。
;   stft 是按 id 升序拼接的字段型别表，需按 stfc 计数跳过前 sid 个结构体的字段求偏移。
h2m-struct-decls = (c h2m-ctx) (r str) {
    b = sb.init(256)
    n = c.stn.len()
    i = 0
    (i < n) {
        fc = c.stfc[i]
        fc > 0 -> {
            off = 0
            k = 0
            (k < i) {
                off = off + c.stfc[k]

                #{overflow=wrap}
                k = k + 1
            }
            b.push('%struct.s')
            b.push(i.to-str())
            b.push(' = type { ')
            j = 0
            (j < fc) {
                j > 0 -> b.push(', ')
                tn = cg.cg-ty-name(c.stft[off + j])
                b.push(tn)

                #{overflow=wrap}
                j = j + 1
            }
            b.push(' }')
            b.push('\n')
        }

        #{overflow=wrap}
        i = i + 1
    }
    r = b.str()
}

; 计数循环计数器的合成槽名（s60m）：带上 ForStatement 节点 id ⇒ 同函数内多个／嵌套计数循环各占一槽；
;   '@' 不是合法标识符首字符 ⇒ 永不与源码里的变量名相撞，前扫描与降级侧共用本式子
; n: ForStatement 节点 id
; s: 合成名
h2m-cnt-name = (n i64) (s str) {
    s = '@cnt' - n.to-str()
}

; 值位 SurfaceMatch 结果槽的合成名（s103）：带上 LetStatement 节点 id ⇒ 同函数内多个值位 match
;   各占一槽；'@' 不是合法标识符首字符 ⇒ 永不与源码里的变量名相撞，前扫描与降级侧共用本式子。
;   ⚠️ 槽必须在前扫描登记、在 entry 块铺：降级时逐臂 STORE 进槽、汇聚块再 LOAD 交回，
;      而 h2m 离开 entry 就回不去（块为指令序连续段），半路 OP-ALLOC 会让循环体内每次迭代
;      都新摊一份栈（长循环栈溢出）。Go 权威同样把结果槽摊在 entry（实测 build-mo.ll 的 %v11.s）。
; n: LetStatement 节点 id
; s: 合成名
h2m-smv-name = (n i64) (s str) {
    s = '@smv' - n.to-str()
}

; 值位 SurfaceMatch 臂体的值表达式节点 id（s103）
; 实测形制（compiler/tests/probe-smv.no，钉于本轮日志）：
;   臂体 = K-BLOCK-STATEMENT(15, inline, nkid=1) 包 K-EXPRESSION-STATEMENT(29, nkid=1) 包值表达式；
;   每臂 aux[hb+9]（valueCtx）非零——ps.no 在值语境下写 ast.put-str(t,'true')，故只能比非零不能比 1
; 不合格形（多陈述块／裸块／空体／非表达式陈述）⇒ 回 0，调用方计 unsup（宁缺勿错）
; t: AST arena
; bn: 臂体节点 id
; ex: 值表达式节点 id（0 = 不在覆盖面）
h2m-smv-arm-val = (t ast, bn i64) (ex i64) {
    ex = 0
    bn > 0 -> {
        bd = ast.nd-at(t, bn)
        bd.kind == asp.K-BLOCK-STATEMENT && bd.nkid == 1 -> {
            k0 = h2m-kid-i(t, bn, 0)
            k0 > 0 -> {
                ed = ast.nd-at(t, k0)
                ed.kind == asp.K-EXPRESSION-STATEMENT && ed.nkid == 1 -> ex = h2m-kid-i(t, k0, 0)
            }
        }
    }
}

; 臂体降级分派（s103）：陈述位走 h2m-lower-branch（原有路），值位降臂值表达式再 STORE 进结果槽
;   ⚠️ 臂值型别必须是 TY-I64：结果槽按 i64 铺（h2m-slot-decl），str/vec 值无处可落 ⇒ 计 unsup
;   ⚠️ h2m-smv-arm-val 回的是【AST 节点 id】，不是值 id——必须先 h2m-lower-expr 才拿到值 id；
;      直接把节点 id 当值 id 用会发 `store i64 %v7` 这种引用未定义值的 IR（实测 build-mo 首版即此坑）
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; bn: 臂体节点 id
; vctx: 1 = 值位
; sslot: 值位结果槽的槽 id（vctx==0 时不用）
h2m-smv-body = (t ast, c h2m-ctx, sg h2m-sigs, bn i64, vctx i64, sslot i64) {
    vctx == 0 -> h2m-lower-branch(t, c, sg, bn)
    vctx == 1 -> {
        ex = h2m-smv-arm-val(t, bn)
        ex > 0 -> {
            xv = h2m-lower-expr(t, c, sg, ex)
            xv > 0 -> {
                h2m-vty-at(c, xv) == TY-I64 -> h2m-emit(c, OP-STORE, 0, xv, sslot, '', 0)
                h2m-vty-at(c, xv) != TY-I64 -> h2m-mark(c)
            }
            xv <= 0 -> h2m-mark(c)
        }
        ex <= 0 -> h2m-mark(c)
    }
}

; 区间遍历的循环变量名（s61）：非 K-ITERATION-EXPR 或名字缺位 ⇒ 回空串（呼叫方不铺槽／计 unsup）
; 实测形制（tmp/probe-s61-ast.no，钉于 tmp/s61-ast-out.txt）：
;   K-ITERATION-EXPR(41)：nkid=2，s0 = 循环变量名，kid[0] = 区间源（K-RANGE-EXPRESSION），kid[1] = 容器源
; t: AST arena
; ie: IterationExpr 节点 id
; vn: 循环变量名
h2m-rng-var = (t ast, ie i64) (vn str) {
    vn = ''
    ie > 0 -> {
        d = ast.nd-at(t, ie)
        d.kind == asp.K-ITERATION-EXPR && d.nkid == 2 && d.s0 > 0 -> vn = ast.str-at(t, d.s0)
    }
}

; 区间遍历形状校验（s61）：回 RangeExpression 节点 id，0 = 不在覆盖面（呼叫方计 unsup）
;   K-RANGE-EXPRESSION(54)：nkid=2，s0 = leftInc（'true'/'false'）、s1 = rightInc，
;   kid[0] = 下界、kid[1] = 上界（缺位为 0 ⇒ 开边界）
; 不入形的判据：容器遍历（kid[0] 非 RANGE 或 kid[1] 非 0，改由 s62 的 h2m-coll-check 收）／
;   开边界（任一端为 0，Go 取 i64 极值补齐，实测量级不可验证）／
;   `for v <- rng` 关键字形里 cond 不是循环变量自身的 IDENT（Go lowerFor 先取 iter 臂、条件位被忽略，
;   本件只收「条件位就是循环变量」这一形，其余宁缺勿错）
; t: AST arena
; ie: IterationExpr 节点 id
; cond: ForStatement 的 Condition kid（0 或循环变量的 IDENT）
; rg: RangeExpression 节点 id（0 = 不在覆盖面）
h2m-rng-check = (t ast, ie i64, cond i64) (rg i64) {
    rg = 0
    ie > 0 -> {
        d = ast.nd-at(t, ie)
        ok-c = 0
        d.kind == asp.K-ITERATION-EXPR && d.nkid == 2 && d.s0 > 0 -> ok-c = 1
        ok-c == 1 -> {
            k0 = h2m-kid-i(t, ie, 0)
            k1 = h2m-kid-i(t, ie, 1)
            k0 > 0 && k1 == 0 -> {
                kd = ast.nd-at(t, k0)
                kd.kind == asp.K-RANGE-EXPRESSION && kd.nkid == 2 -> {
                    sd = h2m-kid-i(t, k0, 0)
                    ed = h2m-kid-i(t, k0, 1)

                    ; 开边界（任一端缺位）不在本件覆盖面
                    sd > 0 && ed > 0 -> rg = k0
                }
            }
            cond > 0 && rg > 0 -> {
                cvn = ast.str-at(t, d.s0)
                cd = ast.nd-at(t, cond)
                keep = 0
                cd.kind == asp.K-IDENTIFIER -> {
                    cnm = ast.str-at(t, cd.s0)
                    cnm == cvn -> keep = 1
                }
                keep == 0 -> rg = 0
            }
        }
    }
}

; 容器遍历的索引槽名（s62）：带上 ForStatement 节点 id ⇒ 同函数内多个／嵌套容器遍历各占一颗；
;   '@' 不是合法标识符首字符 ⇒ 永不与源码里的变量名相撞（与 h2m-cnt-name 同理）
; n: ForStatement 节点 id
; s: 合成名
h2m-idx-name = (n i64) (s str) {
    s = '@idx' - n.to-str()
}

; 容器遍历形状校验（s62）：命中则回容器源节点 id（K-IDENTIFIER），0 = 不在覆盖面（呼叫方计 unsup）
;   实测形制（tmp/probe-s62-ast.no，钉于 tmp/s62-ast-out.txt）：K-ITERATION-EXPR(41) nkid=2、
;   s0 = 循环变量名、kid[0] = 0（区间位空）、kid[1] = 容器源；区间形则是 kid[0] 非 0 且 kid[1] = 0
;   两形互斥，故本助手只在 h2m-rng-check 回 0 后被呼叫
; 不入形的判据：容器源不是裸 IDENT（数组索引／方法链等需先能降级子表达式）／
;   名字缺位（s0 == 0）／`for v <- xs` 关键字形里 cond 不是循环变量自身的 IDENT（与 s61 同口径）
; t: AST arena
; ie: IterationExpr 节点 id
; cond: ForStatement 的 Condition kid（0 或循环变量的 IDENT）
; src: 容器源节点 id（0 = 不在覆盖面）
h2m-coll-check = (t ast, ie i64, cond i64) (src i64) {
    src = 0
    ie > 0 -> {
        d = ast.nd-at(t, ie)
        ok-c = 0
        d.kind == asp.K-ITERATION-EXPR && d.nkid == 2 && d.s0 > 0 -> ok-c = 1
        ok-c == 1 -> {
            k0 = h2m-kid-i(t, ie, 0)
            k1 = h2m-kid-i(t, ie, 1)
            k0 == 0 && k1 > 0 -> {
                kd = ast.nd-at(t, k1)
                kd.kind == asp.K-IDENTIFIER && kd.nkid == 0 -> src = k1
            }
            src > 0 && cond > 0 -> {
                cvn = ast.str-at(t, d.s0)
                cd = ast.nd-at(t, cond)
                keep = 0
                cd.kind == asp.K-IDENTIFIER -> {
                    cnm = ast.str-at(t, cd.s0)
                    cnm == cvn -> keep = 1
                }
                keep == 0 -> src = 0
            }
        }
    }
}

; ── 模块级函数签名表（调用点据此解析返回型别与实参个数，对齐 Go 的函数表查找）──
h2m-sigs {
    fname []str
    fret []i64
    fnarg []i64
    fbase []i64
    farg []i64
    fdef []i64
    femit []str
}

; 新建签名表
; s: 签名表
h2m-sigs-new = () (s h2m-sigs) {
    s = h2m-sigs{
        fname: []
        fret: []
        fnarg: []
        fbase: []
        farg: []
        fdef: []
        femit: []
    }
}

; 登记一个函数签名；argt 逐项拷进拼接表 farg（值复制，与呼叫方分离）
; s: 签名表
; name: 查表键（切片 5 全域 sg 用 `mod.fn` 点号键；单模組 h2m-lower-program 用裸名）
; emit: 定义 emit 名（LLVM 符号名，即 h2m-func-sig 回传的裸 AST 名 nm）——呼叫点 emit `call @<emit>`
;       与定义 `define @<emit>` 对齐；切片 6 统一 emit 名，根除「定义/呼叫名错位」未定义引用。
; ret: 返回型别码
; argt: 输入型别表（顺序即 LLVM 形参序）
; deft: 默认值表达式节点表（与 argt 平行，0 = 无默认值；s92 调用点回填用）
h2m-sig-add = (s h2m-sigs, name str, emit str, ret i64, argt []i64, deft []i64) {
    b = s.farg.len()
    s.fname.push(name)
    s.femit.push(emit)
    s.fret.push(ret)
    s.fnarg.push(argt.len())
    s.fbase.push(b)
    i = 0
    (i < argt.len()) {
        at = argt[i]: {
            ok -> it

            -> _
        }
        s.farg.push(at)
        dt = deft[i]: {
            ok -> it

            -> _
        }
        s.fdef.push(dt)

        #{overflow=wrap}
        i = i + 1
    }
}

; 按名字查签名下标；-1 = 未登记（含被形状门禁排除的函数）
; s: 签名表
; name: 函数名
; i: 签名下标（-1 = 未找到）
h2m-sig-find = (s h2m-sigs, name str) (i i64) {
    i = -1
    j = 0
    (j < s.fname.len() && i < 0) {
        nm = s.fname[j]
        nm == name -> i = j

        #{overflow=wrap}
        j = j + 1
    }
}

; 读签名 i 的第 j 个输入型别码
; s: 签名表
; i: 签名下标
; j: 形参序
; t: 型别码
h2m-sig-arg = (s h2m-sigs, i i64, j i64) (t i64) {
    fb = s.fbase[i]

    #{overflow=wrap}
    fb = fb + j
    t = s.farg[fb]
}

; 读签名 i 的第 j 个输入的默认值表达式 AST 节点 id（s92：调用点尾部回填）
; s: 签名表
; i: 签名下标
; j: 形参序
; k: 默认值表达式节点 id（0 = 无默认值）
h2m-sig-def = (s h2m-sigs, i i64, j i64) (k i64) {
    fb = s.fbase[i]

    #{overflow=wrap}
    fb = fb + j
    k = s.fdef[fb]
}

; ── 前扫描（s57：mem 模式定槽宽 + 控制流探测）───────────────────
; 槽必须在 entry，而 entry 指令又必须先于 body 发出 ⇒ 进 body 前就得知道「有哪些局部量、各是什么型别」。
; 本段就是一个不指令的小型Syntax walker：只做两件事——登记 let 名取型别、发现控制流节点置 flow。
; ⚠️ 与降级器的型别判定彼此独立⇒可能偏离；偏离不会发错码：写入口 h2m-var-write 会再比一次
;   槽型与右值实型（不符 ⇒ unsup、整函数不产码），宁缺勿错。
h2m-lst {
    lname []str
    lty []i64
}

; 新建局部量表
; l: 局部量表
h2m-lst-new = () (l h2m-lst) {
    l = h2m-lst{
        lname: []
        lty: []
    }
}

; 查局部量名在表中的下标；-1 = 未登记
; l: 局部量表
; name: 变量名
; i: 下标
h2m-lst-find = (l h2m-lst, name str) (i i64) {
    i = -1
    j = 0
    (j < l.lname.len() && i < 0) {
        nm = l.lname[j]
        nm == name -> i = j

        #{overflow=wrap}
        j = j + 1
    }
}

; 登记/覆盖一个局部量及其型别（同一名字多次 let 以最后一次为准，与重赋语义一致）
; l: 局部量表
; name: 变量名
; ty: 型别码（-1 = 推不出，后续 h2m-slot-decl 会计 unsup）
h2m-lst-add = (l h2m-lst, name str, ty i64) {
    i = h2m-lst-find(l, name)
    i >= 0 -> l.lty[i] = ty
    i < 0 -> {
        l.lname.push(name)
        l.lty.push(ty)
    }
}

; 语法型别推断（仅供定槽宽）：认 i64 / u64 / str / f64 四型（s74/s76），其余一律 -1
; t: AST arena
; sg: 模块级签名表（调用回值型别）
; l: 已登记的局部量表（标识符型别查此表）
; n: 表达式节点 id
; code: 型别码（-1 = 推不出）
h2m-ty-of = (t ast, sg h2m-sigs, l h2m-lst, agg h2m-ctx, n i64) (code i64) {
    code = -1
    n > 0 -> {
        d = ast.nd-at(t, n)
        d.kind == asp.K-INTEGER-LITERAL -> code = TY-I64
        d.kind == asp.K-STRING-LITERAL -> code = TY-STR

        ; s90：bool 字面量初值 ⇒ 槽宽 TY-I64（与降级侧 K-BOOLEAN-LITERAL 同口径；bool 0/1 落 i64 宽）
        d.kind == asp.K-BOOLEAN-LITERAL -> code = TY-I64

        ; s91：char 字面量初值 ⇒ 槽宽 TY-I64（与降级侧 K-CHAR-LITERAL 同口径；码点落 i64 宽）
        d.kind == asp.K-CHAR-LITERAL -> code = TY-I64

        ; s94：nil 初值 ⇒ 槽宽 TY-OPT（与降级侧 K-NIL-LITERAL 同口径；TY-OPT 铺槽未入形 ⇒
        ;   含控制流的函数在 h2m-slot-decl 计 unsup，宁缺勿错；直线式不走本路，绑定期 vty 已定）
        d.kind == asp.K-NIL-LITERAL -> code = TY-OPT

        ; s74：f64 字面量初值 ⇒ 槽宽 TY-F64（与降级侧 K-FLOAT-LITERAL 同口径；裸指数形如 1e5 降级侧必 mark，整函数不产码，槽宽推错无害）
        d.kind == asp.K-FLOAT-LITERAL -> code = TY-F64
        d.kind == asp.K-GROUPED-EXPRESSION -> {
            k = ast.kid-at(t, d.kid0)
            code = h2m-ty-of(t, sg, l, agg, k)
        }
        d.kind == asp.K-INFIX-EXPRESSION -> {
            xk = ast.kid-at(t, d.kid0)
            yk = h2m-kid-i(t, n, 1)
            a = h2m-ty-of(t, sg, l, agg, xk)
            b = h2m-ty-of(t, sg, l, agg, yk)
            a == TY-I64 && b == TY-I64 -> code = TY-I64

            ; s76：整族含 u64（任一侧 TY-U64、另一侧整族）⇒ TY-U64，与降级侧 uty 同口径——
            ;   除模（s76）与算术 + - *（s78）两族 dest 皆为 TY-U64，与本推断同口径；
            ;   （s76 当时曾记「其余 op 在此推成 U64 无害：降级侧必 mark ⇒ 整函数不产码」，
            ;   该前提已随 s77（比较）/ s78（算术）解除门禁而失效——现在只有仍门禁的位运算／移位／逻辑成立）
            ; s77 🔴 比较族例外：整族含 u64 但 op 是比较符 ⇒ 推 TY-I64（不是 U64）——
            ;   降级侧比较的 dest 恒 TY-I64（结果 0/1），而 h2m-var-write 只接受 st == vt；
            ;   若这里仍推 U64，`f = x > y`（x,y u64）会把 f 铺成 U64 槽，随后对 f 的 i64 写全部计 unsup
            ;   ——与降级侧 s77 的 OP-CMP*U 臂同口径，两条路必须一起改
            (a == TY-U64 || b == TY-U64) && (a == TY-I64 || a == TY-U64) && (b == TY-I64 || b == TY-U64) -> {
                osu = ast.str-at(t, d.s0)
                osu == '<' || osu == '>' || osu == '<=' || osu == '>=' || osu == '==' || osu == '!=' -> code = TY-I64
                osu != '<' && osu != '>' && osu != '<=' && osu != '>=' && osu != '==' && osu != '!=' -> code = TY-U64
            }

            ; s74：f64 双侧按操作符分族，与降级侧 dest 型别同步——算术族 + - * / ⇒ TY-F64；比较族 ⇒ TY-I64；
            ;   位/移位/逻辑不推（留 -1 ⇒ 铺槽失败整函数 unsup，与降级侧族门禁同口径）
            a == TY-F64 && b == TY-F64 -> {
                os = ast.str-at(t, d.s0)
                os == '+' || os == '-' || os == '*' || os == '/' -> code = TY-F64
                os == '<' || os == '>' || os == '<=' || os == '>=' || os == '==' || os == '!=' -> code = TY-I64
            }

            ; s104：str 双侧——与降级侧 str 两臂同步（同 s74/s77「ty-of 与 dest 型别必须一起改」纪律）：
            ;   比较族 == != ⇒ TY-I64（OP-STEREQ/STNEQ 的 dst 是 zext 后的 i64，不是 str）；
            ;   拼接族 + - ⇒ TY-STR（s99l OP-STRCAT 的 dest）。
            ;   🔴 缺这一支时 str 比较/拼接落在【含控制流（mem==1）】的函数里必挂：槽宽推不出（留 -1）
            ;      ⇒ h2m-slot-decl 计 unsup、整函数不产码。实测 `a='x' b='y' c=a==b  if c==1 { … }`
            ;      记 5 条 unsup，而同一份代码在直线式（mem==0）下不铺槽 ⇒ 正常产码——
            ;      两种 mem 模式行为分岔，只有走控制流的那支才暴露。
            a == TY-STR && b == TY-STR -> {
                os2 = ast.str-at(t, d.s0)
                os2 == '==' || os2 == '!=' -> code = TY-I64
                os2 == '+' || os2 == '-' -> code = TY-STR
            }
        }
        d.kind == asp.K-IDENTIFIER -> {
            nm = ast.str-at(t, d.s0)
            i = h2m-lst-find(l, nm)
            i >= 0 -> code = l.lty[i]

            ; s65：`it` 不进槽表——它的值 = 值匹配臂主体（s63 门禁限 i64 槽），槽宽直推 I64；
            ;   裸链／match 外的 `it` 在这里同样推成 I64，但降级侧 var-read/write 栈空即计 unsup，门禁不放松
            i < 0 && nm == 'it' -> code = TY-I64
        }
        d.kind == asp.K-PREFIX-EXPRESSION -> {
            k = ast.kid-at(t, d.kid0)
            code = h2m-ty-of(t, sg, l, agg, k)
        }
        d.kind == asp.K-CALL-EXPRESSION -> {
            ck = ast.kid-at(t, d.kid0)
            ck > 0 -> {
                cd = ast.nd-at(t, ck)
                cd.kind == asp.K-IDENTIFIER -> {
                    cn = ast.str-at(t, cd.s0)
                    si = h2m-sig-find(sg, cn)
                    si >= 0 -> code = sg.fret[si]
                }
            }
        }

        ; s99c：点号字段读 ⇒ 解析接收者型别，按字段名查结构体字段型别；
        ;   接收者若直接是标识符 ⇒ 查 loc 表拿其型别码（struct 局部量／形参已登记 TY-STRUCT-BASE+sid）；
        ;   否则递归 h2m-ty-of 推接收者型别。字段型别码经 h2m-struct-field-ty 查模块结构体表。
        d.kind == asp.K-DOT-EXPRESSION -> {
            rk = ast.kid-at(t, d.kid0)
            rkd = ast.nd-at(t, rk)
            rt = -1
            rkd.kind == asp.K-IDENTIFIER -> {
                rnm = ast.str-at(t, rkd.s0)
                ri = h2m-lst-find(l, rnm)
                ri >= 0 -> rt = l.lty[ri]
                ri < 0 -> rt = h2m-ty-of(t, sg, l, agg, rk)
            }
            rkd.kind != asp.K-IDENTIFIER -> rt = h2m-ty-of(t, sg, l, agg, rk)
            rt >= TY-STRUCT-BASE -> {
                rsid = rt - TY-STRUCT-BASE
                rfn = ast.str-at(t, d.s0)
                rfi = h2m-struct-field-idx(agg, rsid, rfn)
                rfi >= 0 -> code = h2m-struct-field-ty(agg, rsid, rfi)
                rfi < 0 -> code = -1
            }
        }
    }
}

; 读节点第 i 个 kid（越界回 0，不拿后面节点的 kid 槽）
; t: AST arena
; n: 节点 id
; i: kid 序号
; k: 子节点 id（0 = 越界或该槽本来就空）
h2m-kid-i = (t ast, n i64, i i64) (k i64) {
    k = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        i < d.nkid -> {
            p = d.kid0

            #{overflow=wrap}
            p = p + i
            k = ast.kid-at(t, p)
        }
    }
}

; 逐个 kid 前扫（不进嵌套函数定义：其局部量属另一个函数，否则会被误铺槽）
; t: AST arena
; sg: 模块级签名表
; l: 局部量表
; n: 父节点 id
; flow: 其子树是否含控制流
h2m-scan-kids = (t ast, sg h2m-sigs, l h2m-lst, agg h2m-ctx, n i64) (flow i64) {
    flow = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        i = 0
        (i < d.nkid) {
            kid = h2m-kid-i(t, n, i)
            kf = 0
            kid > 0 -> {
                kd = ast.nd-at(t, kid)
                kd.kind != asp.K-FUNCTION-DEFINITION -> kf = h2m-scan(t, sg, l, agg, kid)
            }
            kf > flow -> flow = kf

            #{overflow=wrap}
            i = i + 1
        }
    }
}

; SurfaceMatch 臂群前扫（s58）：臂不占 kid 阵，只能按 12 aux/臂的布局逐个取 COND/BODY 再递进
; t: AST arena
; sg: 模块级签名表
; l: 局部量表
; n: SurfaceMatch 节点 id
; flow: 1 = 臂体内含控制流
h2m-scan-arms = (t ast, sg h2m-sigs, l h2m-lst, agg h2m-ctx, n i64) (flow i64) {
    flow = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        j = 0
        (j < d.hcount) {

            #{overflow=wrap}
            hb = d.hbase + 12 * j
            cn = ast.aux-at(t, hb + 10)
            bn = ast.aux-at(t, hb + 11)
            cf = 0
            cn > 0 -> cf = h2m-scan(t, sg, l, agg, cn)
            cf > flow -> flow = cf
            bf = 0
            bn > 0 -> bf = h2m-scan(t, sg, l, agg, bn)
            bf > flow -> flow = bf

            #{overflow=wrap}
            j = j + 1
        }
    }
}

; 前扫入口：登记 let 绑定名与型别，并回「子树内是否有分支/循环」
; ⚠️ K-SURFACE-MATCH 的臂群不占 kid 阵（在 helper/aux 区），故必须走 h2m-scan-arms 才能扫到臂体；
;   漏扫会少铺局部量槽，降级器在写入口比对不上 ⇒ 计 unsup 整函数不产码
; t: AST arena
; sg: 模块级签名表
; l: 局部量表（呼叫方预先播种形参）
; n: 节点 id
; flow: 1 = 含控制流（需 mem 模式）
h2m-scan = (t ast, sg h2m-sigs, l h2m-lst, agg h2m-ctx, n i64) (flow i64) {
    flow = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        {
            d.kind == asp.K-LET-STATEMENT -> {
                nm = ast.str-at(t, d.s0)
                vc = d.nkid

                #{overflow=wrap}
                vc = vc - 1
                vk = h2m-kid-i(t, n, vc)

                ; s99c：结构体字面量 RHS ⇒ 直接查模块结构体表解析型别码（h2m-ty-of 不认 K-STRUCT-LITERAL）；
                ;   表在 pre-pass 先登记，此处必已就绪；查不到留 -1 ⇒ slot-decl 计 unsup
                ty = -1
                vkd = ast.nd-at(t, vk)
                vkd.kind == asp.K-STRUCT-LITERAL -> {
                    vsn = ast.str-at(t, vkd.s0)
                    vsid = h2m-struct-find(agg, vsn)
                    vsid >= 0 -> ty = TY-STRUCT-BASE + vsid
                    vsid < 0 -> ty = -1
                }
                vkd.kind != asp.K-STRUCT-LITERAL -> ty = h2m-ty-of(t, sg, l, agg, vk)

                ; s103：值位 SurfaceMatch 右值（`r = { c -> v  -> d }`）——h2m-ty-of 不认 K-SURFACE-MATCH，
                ;   故就地定型 TY-I64（本件只收 i64 臂值，str/vec 值仍由降级侧门禁计 unsup）；
                ;   同时登记结果槽合成名，让 entry 把 alloca 铺出来（降级侧逐臂 STORE、汇聚块 LOAD）
                vkd.kind == asp.K-SURFACE-MATCH -> {
                    ty = TY-I64
                    h2m-lst-add(l, h2m-smv-name(n), TY-I64)
                }
                h2m-lst-add(l, nm, ty)
                f0 = h2m-scan-kids(t, sg, l, agg, vk)
                f0 > flow -> flow = f0

                ; s103：臂群不在 kid 阵（在 helper/aux 区）⇒ 必须走 h2m-scan-arms 才扫得到臂体局部量；
                ;   值位 match 本身也是控制流（逐臂切块），故直接置 flow
                vkd.kind == asp.K-SURFACE-MATCH -> {
                    fa0 = h2m-scan-arms(t, sg, l, agg, vk)
                    fa0 > flow -> flow = fa0
                    flow = 1
                }
            }

            d.kind == asp.K-IF-EXPRESSION || d.kind == asp.K-FOR-STATEMENT || d.kind == asp.K-SURFACE-MATCH -> {
                flow = 1

                ; s60m：计数循环的计数器要跨迭代存活 ⇒ 必须落 entry 的 alloca 槽，而槽只能在进 body 前铺完
                ;   ⇒ 前扫描在这里按节点 id 合成名登记；形状不合格（如同时带条件）会在降级侧计 unsup
                ;   ⇒ 整函数不产码，多铺一个无人读的槽无害
                d.kind == asp.K-FOR-STATEMENT -> {
                    cnode = h2m-kid-i(t, n, 3)
                    cnode > 0 -> h2m-lst-add(l, h2m-cnt-name(n), TY-I64)

                    ; s61：区间遍历的循环变量同理（体内要读、又必须跨迭代），但它用**源名**登记，
                    ;   体内的 K-IDENTIFIER 才能直接查到这颗槽；形状不合时不铺槽（降级侧计 unsup）
                    rnode = h2m-kid-i(t, n, 4)
                    rnode > 0 -> {
                        cnd = h2m-kid-i(t, n, 1)
                        rgi = h2m-rng-check(t, rnode, cnd)
                        rgi > 0 -> h2m-lst-add(l, h2m-rng-var(t, rnode), TY-I64)

                        ; s62：容器遍历铺【两颗】i64 槽——循环变量同名槽（体内读当前元素）与合成索引槽
                        ;   （跨迭代自增）；容器本身不铺槽（无 %vec 槽 op），靠形参的 incoming SSA 值
                        rgi == 0 && h2m-coll-check(t, rnode, cnd) > 0 -> {
                            h2m-lst-add(l, h2m-rng-var(t, rnode), TY-I64)
                            h2m-lst-add(l, h2m-idx-name(n), TY-I64)
                        }
                    }
                }

                f1 = h2m-scan-kids(t, sg, l, agg, n)
                f1 > flow -> flow = f1
                fa = 0
                d.kind == asp.K-SURFACE-MATCH -> fa = h2m-scan-arms(t, sg, l, agg, n)
                fa > flow -> flow = fa
            }

            ; s59：return/break/continue 也逼出 mem 模式（return 写输出参槽、之后还有块要读它）
            d.kind == asp.K-RETURN-STATEMENT || d.kind == asp.K-BREAK-STATEMENT || d.kind == asp.K-CONTINUE-STATEMENT -> flow = 1

            d.kind == asp.K-BLOCK-STATEMENT || d.kind == asp.K-EXPRESSION-STATEMENT -> {
                f2 = h2m-scan-kids(t, sg, l, agg, n)
                f2 > flow -> flow = f2
            }

            -> {
                f3 = h2m-scan-kids(t, sg, l, agg, n)
                f3 > flow -> flow = f3
            }
        }
    }
}

; 表达式降级：回传该表达式的值 id；0 = 不支持（已计入 unsup）
; t: AST arena
; c: 上下文
; sg: 模块级签名表（调用点解析用）
; n: 表达式节点 id
; v: 值 id
h2m-lower-expr = (t ast, c h2m-ctx, sg h2m-sigs, n i64) (v i64) {
    v = 0
    d = ast.nd-at(t, n)
    {
        d.kind == asp.K-INTEGER-LITERAL -> {
            lit = ast.str-at(t, d.s0)
            ov = lit.to-i64()
            ok-lit = 0
            num = 0
            ov: {
                ok -> {
                    num = it
                    ok-lit = 1
                }

                -> {
                }
            }
            ok-lit == 1 -> {
                cid = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CONST, cid, num, 0, '', TY-I64)
                v = cid
            }
            ok-lit == 0 -> h2m-mark(c)
        }

        ; s73：f64 字面量降级——取 raw（slot1 = 源 token 原文，非 %v 值），物化为 OP-CONST(TY-F64) 携 raw 于 sym 槽
        ;   ⚠ 与整型字面量分岔：整型把数值放 a(xa)、sym 留空；f64 把 raw 放 sym、a 留 0（cg 按 dest TY-F64 走 fadd 分支读 sym）
        ;   ⚠ 诚实门控：LLVM double 字面量文法要求尾数含小数点（'1.0'/'1.5e-7' 可、裸 '1e5' 不可）⇒ raw 不含 '.' 即 mark
        d.kind == asp.K-FLOAT-LITERAL -> {
            raw = ast.str-at(t, d.s1)
            ok-f64 = 0
            raw.contains('.') -> ok-f64 = 1
            ok-f64 == 1 -> {
                cid = h2m-alloc(c, TY-F64)
                h2m-emit(c, OP-CONST, cid, 0, 0, raw, TY-F64)
                v = cid
            }
            ok-f64 == 0 -> h2m-mark(c)
        }

        ; s90：bool 字面量降级——镜像 Go hir2mir.go KBoolLit ⇒ EmitInt(OpConst, typeOfNode, 0/1)。
        ;   ps.no 把 'true'/'false' 存进 slot0（对齐整型字面量 s0 存文本口径），此处读文本选 0/1；
        ;   自举表示 TY-I64 0/1（与 s57 比较族布尔同口径，零改 cg：OP-CONST(TY-I64,v) ⇒ `%v = add i64 0, v`）
        d.kind == asp.K-BOOLEAN-LITERAL -> {
            lit = ast.str-at(t, d.s0)
            bval = 0
            lit == 'true' -> bval = 1
            cid = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, cid, bval, 0, '', TY-I64)
            v = cid
        }

        ; s91：char 字面量降级——镜像 Go lowerCharLit（KCharLit ⇒ EmitInt(OpConst, 首码点)）。
        ;   ps.no L2330 把去引号的字符内文存进 slot0（UTF-8 str，lexer 已处理转义且限单码点）；
        ;   按 UTF-8 首码点解码：lead 字节定长族（1/2/3/4 字节），continuation 取低 6 位（- 128），累加还原码点；
        ;   自举 char⇒TY-I64 码点（Go i32、自举无 i32 槽，码点 ≤0x10FFFF 落 i64 精确，同 bool 宽口径零改 cg）
        d.kind == asp.K-CHAR-LITERAL -> {
            lit = ast.str-at(t, d.s0)
            bs = lit.to-bytes()
            n = bs.len()
            cp = 0
            n > 0 -> {
                b0 i64 = bs[0]
                b0 < 128 -> cp = b0
                b0 >= 192 && b0 < 224 && n >= 2 -> {
                    b1x i64 = bs[1]
                    cp = (b0 - 192) * 64 + (b1x - 128)
                }
                b0 >= 224 && b0 < 240 && n >= 3 -> {
                    b1y i64 = bs[1]
                    b2y i64 = bs[2]
                    cp = (b0 - 224) * 4096 + (b1y - 128) * 64 + (b2y - 128)
                }
                b0 >= 240 && n >= 4 -> {
                    b1z i64 = bs[1]
                    b2z i64 = bs[2]
                    b3z i64 = bs[3]
                    cp = (b0 - 240) * 262144 + (b1z - 128) * 4096 + (b2z - 128) * 64 + (b3z - 128)
                }
            }
            cid = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, cid, cp, 0, '', TY-I64)
            v = cid
        }

        ; s94：nil 字面量降级——镜像 Go lowerNilLit（hir2mir.go:9632）：option 语境的 nil = 「none」判别式。
        ;   自举无 Go 的 typeHint 语境传递机制，直接发 %option 常量 tag=1（OP-OPTNONE，cg 发
        ;   insertvalue %option { i64 1, [3 x i64] zeroinitializer }）；非 option 语境的 nil（如对照 str）
        ;   由消费端型别比对兜住（var-write st!=vt / 回值 ty-match）⇒ 计 unsup 不发错码
        d.kind == asp.K-NIL-LITERAL -> {
            oid = h2m-alloc(c, TY-OPT)
            h2m-emit(c, OP-OPTNONE, oid, 0, 0, '', TY-OPT)
            v = oid
        }

        ; s99e：str 字面量降级——镜像其他字面量，发 OP-STRCONST（cg 发全局常量 + %str-long 值，落 %sv 命名空间）。
        ;   ps.no 把去引号内文存进 s0，直接作全局初始化串文（cg 包成 c"..."\00）。
        ;   本件让「结构体 str 字段 = '字面量'」与「调用方传 str 字面量进 str 字段」成立；
        ;   此前 K-STRING-LITERAL 不在本 switch ⇒ 直落默认 mark（UNSUP 暴涨）。
        d.kind == asp.K-STRING-LITERAL -> {
            lit = ast.str-at(t, d.s0)
            cid = h2m-alloc(c, TY-STR)
            h2m-emit(c, OP-STRCONST, cid, 0, 0, lit, TY-STR)
            v = cid
        }

        d.kind == asp.K-IDENTIFIER -> {
            nm = ast.str-at(t, d.s0)

            ; s65：`it` 不在 names/槽表——值匹配臂降级时住在 c.itv 栈上，栈非空即读栈顶
            ; s98：臂局部名（ok(v) 等）住在 c.alidx/c.alv 栈，不在 names——
            ;   预检必须一并纳入，否则 vi<0 会直接 h2m-mark 跳过错过的降级臂。
            ;   ⚠️ 用「名字在 str 表的下标」(i64) 作键，而非名字串本身：本构建里
            ;   []str.push 对非字面串（ast.str-at 的回传）会存成空串，故串比对不可靠；
            ;   下标是 i64，push/cmp 都稳。d.s0 即本标识符名字的下标，臂绑定名下标
            ;   由 emit 侧 ast.aux-at(hb+0) 推入 c.alidx，同一 t.strs 表 ⇒ 可直接比下标。
            aln-hit = 0
            found-ai = -1
            ai = c.alidx.len() - 1
            (ai >= 0 && aln-hit == 0) {

                ; 按内容比对：把臂绑定名的 str 表下标现取现比（ast.str-at 此时已可靠），
                ;   不与 d.s0 比下标——同一 'v' 在 t.strs 里可能有多份，下标不等但内容相等。
                inm = ast.str-at(t, c.alidx[ai])
                inm == nm -> {
                    aln-hit = 1
                    found-ai = ai
                }

                #{overflow=wrap}
                ai = ai - 1
            }
            it-on = 0
            nm == 'it' && c.itv-n > 0 -> it-on = 1
            vi = h2m-name-find(c, nm)

            ; 优先级：臂局部 (alidx) > it 栈 > names 表；命中即取对应 SSA 值
            aln-hit == 1 -> v = c.alv[found-ai]
            aln-hit == 0 && (it-on == 1 || vi >= 0) -> v = h2m-var-read(c, nm)
            aln-hit == 0 && it-on == 0 && vi < 0 -> h2m-mark(c)
        }

        d.kind == asp.K-GROUPED-EXPRESSION -> {
            gk = ast.kid-at(t, d.kid0)
            v = h2m-lower-expr(t, c, sg, gk)
        }

        d.kind == asp.K-INFIX-EXPRESSION -> {
            osym = ast.str-at(t, d.s0)
            xk = ast.kid-at(t, d.kid0)
            yp = d.kid0

            #{overflow=wrap}
            yp = yp + 1
            yk = ast.kid-at(t, yp)
            lv = h2m-lower-expr(t, c, sg, xk)
            rv = h2m-lower-expr(t, c, sg, yk)
            bop = 0
            {
                osym == '+' -> bop = OP-ADD

                osym == '-' -> bop = OP-SUB

                osym == '*' -> bop = OP-MUL

                ; 除法符号映射（s71  '/' ⇒ OP-DIV；s75  '%' ⇒ OP-MOD；s76 整族另按操作数型别重映射为无符號族）：
                ;   f64 侧 '/' 发 fdiv double；s87 '%' 放行入 is-arith ⇒ frem double（镜像 Go codegen.go:6083 OpMod isFloat⇒frem）；
                ;   i64 侧 s75 起两符皆放行 ⇒ cg 发除零 select 護欄（镜像 Go plain 路径：除零→0 + stderr 报告）；
                ;   u64 侧 s76 起两符放行 ⇒ 下方 uty 重映射为 OP-DIVU/OP-MODU（同護欄、无 (MIN,-1)）
                osym == '/' -> bop = OP-DIV

                osym == '%' -> bop = OP-MOD

                ; 位运算家族（s67：& | ^ << >> 双侧 i64；s79 起 u64 亦放行——见下方 uty 位运算臂；
                ;   s80 起 '>>' 无条件重映射 OP-SHRU——i64 侧亦发 lshr，镜像 Go OpShr 恒逻辑移位；&^ 位清除无对应 op 仍计 unsup）
                osym == '&' -> bop = OP-AND

                osym == '|' -> bop = OP-OR

                osym == '^' -> bop = OP-XOR

                osym == '<<' -> bop = OP-SHL

                osym == '>>' -> bop = OP-SHR

                ; 逻辑家族（s67 位运算之后）：&& || 复用 OP-AND/OR（非短路，与 Go emitLogic 同形）；
                ;   i64 子集里布尔恒为 0/1（比较结果 zext），and/or i64 于 0/1 == 逻辑与/或
                osym == '&&' -> bop = OP-AND

                osym == '||' -> bop = OP-OR

                ; 比较家族（s57：控制流的条件侧需要 0/1 值；cg 发 icmp + zext i1→i64）
                osym == '<' -> bop = OP-CMPLT

                osym == '>' -> bop = OP-CMPGT

                osym == '<=' -> bop = OP-CMPLE

                osym == '>=' -> bop = OP-CMPGE

                osym == '==' -> bop = OP-CMPEQ

                osym == '!=' -> bop = OP-CMPNE

                -> {
                }
            }

            ; s83：is-logic 旗标退场——&& || 与位运算同码（OP-AND/OR，s68 复用）⇒ 直接走下方 u64 位运算臂，无需分旗标
            ;   （s79 曾以「u64 操作数非 0/1、裸 and/or 不等价逻辑语义」为由门禁，该前提被 v413 探针推翻：
            ;   Go emitLogic 对 OpAnd/OpOr 发裸 and/or 非短路，12&&10⇒8、0||5⇒5）

            ; 运算元型别分派（s71 二元算术 + s72 二元比较 + s76 无符號除模 + s78 无符號算术 + s79 无符號位运算/移位）：
            ;   i64 侧：全部 bop 放行（s75 含 '/' '%'）⇒ 结果 TY-I64（算术/比较/位/移位/逻辑结果恒 i64）
            ;   f64 侧：仅「算术族」与「比较族」放行——
            ;     - 算术 + - * / ⇒ 发 fadd/fsub/fmul/fdiv double，dest 记 TY-F64（s71）
            ;     - 比较 < > <= >= == != ⇒ 发 fcmp 后 zext i1→i64，dest 记 TY-I64（s72，比较结果恒 i64 非 f64）
            ;   u64 侧（s76 除模 / s77 比較 / s78 算術）：'/' '%' 经 uty 重映射为 OP-DIVU/OP-MODU，dest 记 TY-U64；
            ;     六個比較符经 uty 重映射为 OP-CMP*U（eq/ne 除外），dest 记 TY-I64；
            ;     '+ - *' 不重映射（Go 算子表无 OpAddU/OpSubU/OpMulU，64 位宽下签／无签位元相同），直接以 OP-ADD/SUB/MUL 发裸 add/sub/mul i64，dest 记 TY-U64；
            ;     '& | ^ <<' 同理不重映射发裸 and/or/xor/shl i64；'>>' 经 uty 重映射为 OP-SHRU 发 lshr i64
            ;     （Go 侧 OpShr 对所有整型恒发 lshr——「nolang >> 是逻辑移位」，见 codegen.go emitBitwise），dest 记 TY-U64；
            ;     逻辑族（&& ||）s83 同码走位运算臂放行（Go 权威非短路，裸位 and/or 即其唯一语义）；&^ 无 cg op 仍门禁
            ;   位运算/移位/逻辑（& | ^ << >> && ||）于 f64 不落任一路 ⇒ 计 unsup（收紧 s71 曾过宽的 f64 臂）
            ;   混合（一 i64 一 f64）或任一 str ⇒ ity、fty、uty 皆 0 ⇒ 计 unsup
            ity = 1
            fty = 1
            lv > 0 && rv > 0 -> {
                h2m-vty-at(c, lv) != TY-I64 -> ity = 0
                h2m-vty-at(c, rv) != TY-I64 -> ity = 0
                h2m-vty-at(c, lv) != TY-F64 -> fty = 0
                h2m-vty-at(c, rv) != TY-F64 -> fty = 0
            }

            ; s76：无符號判据（镜像 Go hir2mir sourceUnsigned(lv) || sourceUnsigned(rv)：任一侧声明为 u64 即走无符號）——
            ;   两侧皆整族（i64/u64）且至少一侧 TY-U64 ⇒ uty；纯 i64 两侧不落此路（ty-of 推不出裸整字面量为 u64，
            ;   与 Go 字面量 sourceUnsigned=false 同口径）；含 f64/str 的混合 ⇒ uty=0 维持门禁
            uty = 0
            lv > 0 && rv > 0 -> {
                lu = h2m-vty-at(c, lv)
                ru = h2m-vty-at(c, rv)
                lu == TY-U64 || ru == TY-U64 -> {
                    uty = 1
                    lu != TY-I64 && lu != TY-U64 -> uty = 0
                    ru != TY-I64 && ru != TY-U64 -> uty = 0
                }
            }

            ; s76：无符號除模分派——uty 下 '/' '%' 重映射（镜像 Go OpDiv⇒OpUDiv、OpMod⇒OpUMod）；
            ;   重映射先于 bop 归类，故 OP-DIVU/OP-MODU 不入 is-arith，f64 臂不受影响（且含 u64 时 fty 必 0）
            bop == OP-DIV && uty == 1 -> bop = OP-DIVU
            bop == OP-MOD && uty == 1 -> bop = OP-MODU

            ; s77：无符號比較分派——uty 下 < <= > >= 重映射（镜像 Go 同段的 OpLt⇒OpULt、OpLe⇒OpULe、
            ;   OpGt⇒OpUGt、OpGe⇒OpUGe：有符號謂詞会把最高位为 1 的 u64 当负数而误序）；
            ;   '==' '!=' 不参与重映射——Go 口径「eq/ne 與符號无关（同位比較）」，保持 OP-CMPEQ/CMPNE
            bop == OP-CMPLT && uty == 1 -> bop = OP-CMPLTU
            bop == OP-CMPLE && uty == 1 -> bop = OP-CMPLEU
            bop == OP-CMPGT && uty == 1 -> bop = OP-CMPGTU
            bop == OP-CMPGE && uty == 1 -> bop = OP-CMPGEU

            ; s79/s80：右移重映射——'>>' ⇒ OP-SHRU 无条件（非镜像路由表而是镜像 Go 发射：
            ;   codegen.go:7257 OpShr 恒发 lshr，注释 7212「nolang >> is a logical shift」——
            ;   s79 先解 uty==1（u64 侧）；s80 裁定 i64 侧同改：自举 s35 的「i64=ashr」与 Go 失真
            ;   （负数右移为分岔靶，s79 關鍵點 2），全族对齐 lshr；重映射先于归类，
            ;   OP-SHR 归類后不再产生⇒ cg 的 ashr 臂转死代码（本件不动 cg，保留待后续清理）
            bop == OP-SHR -> bop = OP-SHRU

            ; bop 归类（s72）：算术族 vs 比较族（决定 f64 侧 dest 型别 TY-F64 vs TY-I64）
            ;   s87：OP-MOD 入算术族——f64 侧 '%' 放行发 frem double（镜像 Go codegen.go:6083）；
            ;   i64 路无条件全放不受影响；uty 下 OP-MOD 已先行重映射为 OP-MODU（s76），本行不可达
            is-arith = 0
            is-cmp = 0
            bop == OP-ADD -> is-arith = 1
            bop == OP-SUB -> is-arith = 1
            bop == OP-MUL -> is-arith = 1
            bop == OP-DIV -> is-arith = 1
            bop == OP-MOD -> is-arith = 1
            bop == OP-CMPLT -> is-cmp = 1
            bop == OP-CMPEQ -> is-cmp = 1
            bop == OP-CMPNE -> is-cmp = 1
            bop == OP-CMPLE -> is-cmp = 1
            bop == OP-CMPGT -> is-cmp = 1
            bop == OP-CMPGE -> is-cmp = 1

            ; s77：重映射後的无符號比較同属比較族（dest 恒 TY-I64）——歸類在重映射之後，
            ;   故这四行只可能在 uty==1 時命中；fty==1（两侧 f64）与 uty==1（含 u64）互斥，不会误开 f64 臂
            bop == OP-CMPLTU -> is-cmp = 1
            bop == OP-CMPLEU -> is-cmp = 1
            bop == OP-CMPGTU -> is-cmp = 1
            bop == OP-CMPGEU -> is-cmp = 1

            ; s79：位运算／移位族归类（归類在重映射之后：s80 起 OP-SHR 已全量重映射为
            ;   OP-SHRU，此行不再命中——保留仅作防御；and/or/xor/shl 签／无签位元相同故两路共用同码）
            is-bit = 0
            bop == OP-AND -> is-bit = 1
            bop == OP-OR -> is-bit = 1
            bop == OP-XOR -> is-bit = 1
            bop == OP-SHL -> is-bit = 1
            bop == OP-SHR -> is-bit = 1
            bop == OP-SHRU -> is-bit = 1

            ; i64：全部二元 op 放行（s75 起含 OP-DIV/OP-MOD ⇒ dest TY-I64，cg 发带除零護欄的 sdiv/srem）
            ;   ⚠️ 口径：護欄对应 Go 非 option（plain）路径——除零结果定义化为 0 并 stderr 报告；
            ;     ?i64 的 tag=2 装箱 err option 路未建模（h2m 型别表无 option dest），对账 oracle 须用明示 i64 目标
            ok-i = 0
            bop > 0 && lv > 0 && rv > 0 && ity == 1 -> {
                mid = h2m-alloc(c, TY-I64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-I64)
                v = mid
                ok-i = 1
            }

            ; f64 算术：+ - * / 放行 ⇒ dest TY-F64（cg 发 fadd/fsub/fmul/fdiv double）
            ok-f = 0
            bop > 0 && lv > 0 && rv > 0 && fty == 1 && is-arith == 1 -> {
                mid = h2m-alloc(c, TY-F64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-F64)
                v = mid
                ok-f = 1
            }

            ; f64 比较：< > <= >= == != 放行 ⇒ dest TY-I64（cg 依操作数 TY-F64 发 fcmp 后 zext i1→i64）
            bop > 0 && lv > 0 && rv > 0 && fty == 1 && is-cmp == 1 -> {
                mid = h2m-alloc(c, TY-I64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-I64)
                v = mid
                ok-f = 1
            }

            ; u64 除模（s76）：仅 OP-DIVU/OP-MODU 放行 ⇒ dest TY-U64（cg 发 udiv/urem 除零 select 護欄，sgn=0 无 (MIN,-1)）；
            ;   其余 u64 二元 op 不落此臂 ⇒ 计入下方 mark（仍门禁，与 s75 i64 全族放行区分：本件仅解除法族）
            ;   ⚠️ 口径同 s75：護欄对应 Go 非 option（plain）路——除零结果定义化为 0 并 stderr 报告；?u64 未建模
            ok-u = 0
            bop > 0 && lv > 0 && rv > 0 && uty == 1 && (bop == OP-DIVU || bop == OP-MODU) -> {
                mid = h2m-alloc(c, TY-U64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-U64)
                v = mid
                ok-u = 1
            }

            ; u64 算術族（s78）：+ - * 放行 ⇒ dest TY-U64（cg 发裸 add/sub/mul i64，TY-U64 走 cg 默认 i64 臂）。
            ;   ⚠️ 本件不需重映射：Go 侧 MIR 算子表只有除模（OpUDiv/OpUMod）与序比较（OpULt..OpUGe）有無符號衍生，
            ;     add/sub/mul 在 64 位宽下签／无签位元相同（2's 补数）；Go 的溢出内在函数（s*add vs u*add.with.overflow）
            ;     只在 option 路（codegen.go:6183 「Plain arithmetic keeps emitting a bare add/sub/mul」），?u64 未建模⇒不表达
            ;   uty==1 时 is-arith==1 只可能是 ADD/SUB/MUL（OP-DIV/OP-MOD 已在上式重映射为 OP-DIVU/OP-MODU，不入 is-arith）
            bop > 0 && lv > 0 && rv > 0 && uty == 1 && is-arith == 1 -> {
                mid = h2m-alloc(c, TY-U64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-U64)
                v = mid
                ok-u = 1
            }

            ; u64 比較族（s77）：< <= > >= 已经 uty 重映射为 OP-CMP*U（cg 发 icmp ult/ule/ugt/uge + zext i1→i64）；
            ;   == != 與符號无关，保持 OP-CMPEQ/CMPNE（cg 发 icmp eq/ne i64，槽宽同为 i64）；
            ;   dest 恒 TY-I64——比較结果是 0/1 而非 u64，镜像 Go 的 resTyp（compare 结果固定整型）
            ;   u64 的位運算/移位/逻辑不落此臂 ⇒ 仍计入下方 mark（本件仅解除比較族）
            bop > 0 && lv > 0 && rv > 0 && uty == 1 && is-cmp == 1 -> {
                mid = h2m-alloc(c, TY-I64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-I64)
                v = mid
                ok-u = 1
            }

            ; u64 位运算／移位族（s79）：& | ^ << 放行⇒裸 and/or/xor/shl i64（逐位运算与符號性无关，
            ;   Go 无符號路由表无 OpBitAndU/OpShlU 等衍生可镜像）；>> 已经 uty 重映射为 OP-SHRU⇒lshr i64
            ;   （唯一衍生：Go OpShr 恒逻辑移位，cg s36 已备 lshr 臂）；dest 记 TY-U64（移位／逐位结果仍 u64 宽度）
            ;   s83：&& || 同码（OP-AND/OR）入本臂——Go 对 u64 逻辑族即裸位形 and/or 非短路（探针实钉 12&&10⇒8、0||5⇒5）
            bop > 0 && lv > 0 && rv > 0 && uty == 1 && is-bit == 1 -> {
                mid = h2m-alloc(c, TY-U64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-U64)
                v = mid
                ok-u = 1
            }

            ; s99l：str 拼接——两侧皆 TY-STR 时 '+' / '-' 皆走 OP-STRCAT（镜像 Go emitBinary：
            ;   lt=="%str-long" 时非 '*' 的二元 op 一律 @str_concat；'*' 是重复 @_mir_str_repeat，
            ;   h2m 无对应 op ⇒ 不在此臂，落默认 mark）。
            ;   @str_concat 造 rc=1 自拥有（两操作数各 memcpy 一份、不消耗）⇒ 结果登记 scope-exit 释放；
            ;   操作数按只读不释放（字面量指向静态常量、另一 STRCAT 结果各自已在清单中）。
            ;   混合 str/i64、str/txt（Go 会先转标量再拼）h2m 未建模 ⇒ 落默认 mark（宁缺勿错）。
            ok-s = 0
            bop > 0 && lv > 0 && rv > 0 && (bop == OP-ADD || bop == OP-SUB) && h2m-vty-at(c, lv) == TY-STR && h2m-vty-at(c, rv) == TY-STR -> {
                scid = h2m-alloc(c, TY-STR)
                h2m-emit(c, OP-STRCAT, scid, lv, rv, '', TY-STR)
                h2m-rel-add(c, scid, TY-STR, 0)
                v = scid
                ok-s = 1
            }

            ; s104：str 相等/不等——两侧皆 TY-STR 时 '==' ⇒ OP-STEREQ、'!=' ⇒ OP-STNEQ。
            ;   镜像 Go 专用 OpStrEq：icmp %str-long 非法（LLVM 不许对聚合型发 icmp），故降运行时
            ;   helper @str_eq（两串等 iff 长度相同且 memcmp==0）。**零改 cg / 零改 mir**：
            ;   OP-STEREQ=63 / OP-STNEQ=64 早已在 mir.no 定义、cg.no:695/710 已实现，
            ;   @str_eq 定义由 cg-runtime-prelude-full 每模块发一次（cg-runtime-str-eq）——
            ;   缺的只是 h2m 这条降级臂（此前落默认 mark ⇒ 整函数不产码）。
            ;   结果恒 TY-I64（0/1）：与 s72 f64 比较、s77 u64 比较同口径——比较结果不是 str，
            ;   故 dest 记 TY-I64（cg 侧发 `zext i1 → i64` 落 %v 命名空间，非 %sv）。
            ;   ⚠️ 只收「两侧同型 TY-STR」：str == ?str、str == i64 等混合形仍落 mark（宁缺勿错，
            ;      权威侧由 checker 先转标量再比，自举无 checker 不臆造该转换）。
            ;   ⚠️ 不放行 str 的 < > <= >=：Go 侧无对应降级（@str_eq 只判等），无权威可镜像。
            ok-e = 0
            bop > 0 && lv > 0 && rv > 0 && (bop == OP-CMPEQ || bop == OP-CMPNE) && h2m-vty-at(c, lv) == TY-STR && h2m-vty-at(c, rv) == TY-STR -> {
                seid = h2m-alloc(c, TY-I64)
                bop == OP-CMPEQ -> h2m-emit(c, OP-STEREQ, seid, lv, rv, '', TY-I64)
                bop == OP-CMPNE -> h2m-emit(c, OP-STNEQ, seid, lv, rv, '', TY-I64)
                v = seid
                ok-e = 1
            }
            bop == 0 || lv == 0 || rv == 0 || (ok-i == 0 && ok-f == 0 && ok-u == 0 && ok-s == 0 && ok-e == 0) -> h2m-mark(c)
        }

            ; 调用降级：c0 = 实参个数；实参个数与型别查签名表；
            ;   s64：实参值 id 逐个追加进侧池 c.args，CALL 只带「池基址 + 个数」，不再校验 id 连续性。
            ;   自举 parser 对两种呼叫形态的解析不同（⑥ 跨模組點號呼叫關鍵）：
            ;   ─ 純量呼叫 `f(x)`：call.child[0]=callee(IDENTIFIER f)、child[1..]=實參
            ;     ⇒ name=f、實參基址=call.kid0+1。
            ;   ─ 點號呼叫 `mod.fn(x)`：call.child[0]=K-DOT-EXPRESSION(fn)（整個 `mod.fn` 作為 callee，
            ;     fn=dot.s0、模組名 mod 在 dot 子節點[0]）、child[1..]=實參（與純量同構，仍是 CALL 直接子節點）
            ;     ⇒ name=dot.base.s0 . '.' . dot.s0=mod.fn、實參基址=call.kid0+1（同純量）。
            d.kind == asp.K-CALL-EXPRESSION -> {
                na = d.c0
                ck = ast.kid-at(t, d.kid0)
                cd = ast.nd-at(t, ck)
                ok-call = 1
                ok-print = 0
                cn = ''
                si = -1
                argbase = d.kid0 + 1
                ; ⑥ 點號呼叫（跨模組）：callee 是單個 K-DOT-EXPRESSION（`mod.fn`），
                ;   name = base.fn，其中 base 是 dot 的子節點[0]（K-IDENTIFIER mod）、fn = dot.s0。
                ;   實參仍是 CALL 的直接子節點（child[1..]），與純量呼叫 f(x) 完全同構
                ;   ⇒ argbase 保持 d.kid0+1，na 仍取 d.c0。
                ;   （差異只在 cn 的拼法：純量取 child[0] 的 s0；點號取 dot.base.s0 . '.' . dot.s0。）
                has-dot = 0
                cd.kind == asp.K-DOT-EXPRESSION -> {
                    has-dot = 1
                    base-nd = ast.nd-at(t, ast.kid-at(t, cd.kid0))
                    cn = ast.str-at(t, base-nd.s0) - '.' - ast.str-at(t, cd.s0)
                }
                cd.kind != asp.K-DOT-EXPRESSION -> {
                    cd.kind == asp.K-IDENTIFIER -> cn = ast.str-at(t, cd.s0)
                    cd.kind != asp.K-IDENTIFIER -> ok-call = 0
                }
            ; s100：print / eprint 是内建（自举无 builtin 签名表）⇒ 在签名查找前单点认领。
            ;   语句位由 s93 路径丢弃结果值（hd=1，不查 v）；表达式位若被当值用，
            ;   v 留 0 会让外层调用 / 赋值入门禁，退化成 unsup（诚实门禁不绕）。
            ok-call == 1 && (cn == 'print' || cn == 'eprint') -> {
                h2m-lower-print(t, c, sg, n, cn)
                ok-print = 1

                ; ⚠️ 必须同时清 ok-call：否则下面「ok-call == 1 ⇒ want-n = sg.fnarg[si]」
                ;   会用 si = -1 索引签名表 ⇒ 越界（实测 SIGBUS 138）。
                ;   清掉后靠 ok-print 抑制末尾的 h2m-mark。
                ok-call = 0
            }
            ok-call == 1 && cn != 'print' && cn != 'eprint' -> {
                si = h2m-sig-find(sg, cn)
                si < 0 -> ok-call = 0
                ; 切片 6：命中後把 cn 覆寫為【定義 emit 名】（femit），使 call 符號與
                ;   define 符號一致（根除「定義 @testmod-bar / 呼叫 @testmod.bar」錯位）。
                ;   單模組路徑 femit==fname==nm，故與舊行為等價、零回歸。
                si >= 0 -> cn = sg.femit[si]
            }
            ok-call == 1 -> {
                want-n = sg.fnarg[si]

                ; s92：实参少于形参不再 arity 拒——尾部缺口走默认值回填（Go hir2mir.go:13175）；
                ;   超供仍入门禁（输出绑定／方法 receiver 改写不在本路覆盖面）
                na > want-n -> ok-call = 0
            }
            base = 0
            ok-call == 1 -> {

                ; ⚠️ 实参先落临时 al，全部通过后才整段入池：嵌套调用实参（如 f(h(3), 1)）
                ;   降期自己会往 c.args 推池项，若边降边推，base..base+na-1 会被内层插入的
                ;   孤儿项挤偏（s64 初版实测 c6 发成 @f(%v1,%v2)，应为 @f(%v2,%v3)）。
                al []i64 = []
                j = 0
                (j < want-n && ok-call == 1) {
                    ak = 0
                    j < na -> {
                        ; 實參基址：純量呼叫 = call.kid0+1；⑥ 方法呼叫 = method.kid0（實參嵌在 method 子節點）
                        ap = argbase

                        #{overflow=wrap}
                        ap = ap + j
                        ak = ast.kid-at(t, ap)
                    }

                    ; s92 尾部缺省：拿签名登记的默认值表达式节点降级进呼叫者块
                    ;   （镜像 Go lowerExpr(deID)，每个调用点拷开一份）；
                    ;   「被缺且无默认值」ak=0 → 入门禁计 unsup（Go 靠 checker 前置拒，自举无 checker，在此兜住）
                    j >= na -> {
                        ak = h2m-sig-def(sg, si, j)
                        ak == 0 -> ok-call = 0
                    }
                    ok-call == 1 -> {
                        av = h2m-lower-expr(t, c, sg, ak)
                        av == 0 -> ok-call = 0
                        ok-call == 1 -> {
                            at = h2m-vty-at(c, av)
                            want = h2m-sig-arg(sg, si, j)
                            want != at -> ok-call = 0
                            ok-call == 1 -> al.push(av)
                        }
                    }

                    #{overflow=wrap}
                    j = j + 1
                }
                ok-call == 1 -> {
                    base = c.args.len()
                    m = 0
                    (m < al.len()) {
                        c.args.push(al[m])

                        #{overflow=wrap}
                        m = m + 1
                    }
                }
            }
            ok-call == 1 -> {
                rt = sg.fret[si]
                cid = h2m-alloc(c, rt)

                ; s92：入池实参个数是回填后的 want-n（非 AST 原实基数 na），OP-CALL 计数与 args 段长对齐
                h2m-emit(c, OP-CALL, cid, base, want-n, cn, rt)
                v = cid
            }
            ok-call == 0 && ok-print == 0 -> h2m-mark(c)
        }

        ; s66：前缀表达式 -x / !x（镜像 Go emitNeg/emitNot hir2mir.go:5503/5505）
        ;   '-' ⇒ OP-NEG（i64⇒sub 0,x；f64⇒fneg double，s70）；'!' ⇒ OP-CONST(1)＋OP-AND＋OP-NOT（s88 先归位低 bit）、'~' ⇒ OP-XOR（s69）；其余非 i64/f64 主体仍计 unsup
        ;   s86 纪实：f64 主体 '~' 维持门禁是正确形态——Go 侧同形非权威而是崩溃：
        ;   hir2mir.go:8878 对 rt=f64 无守卫发 OpXor ⇒ emitBitwise 出 `xor double`（LLVM 非法，
        ;   clang build fail，tmp/probe-s86-b.no 实测）；常量路又被 cvInt 域 comptime 摺死
        ;   （tmp/probe-s86-a.no）。本臂 ok-p==0 是 cg「OP-XOR 恒发 xor i64」的唯一上游防线，
        ;   放行前须先给 cg 补 double 合法形（无权威可对拍，不放行）。哨兵：h2m-test test-prefix-not-f64-gate
        d.kind == asp.K-PREFIX-EXPRESSION -> {
            osym = ast.str-at(t, d.s0)
            ok = ast.kid-at(t, d.kid0)
            ov = h2m-lower-expr(t, c, sg, ok)
            ok-p = 0
            ov > 0 && osym == '-' && h2m-vty-at(c, ov) == TY-I64 -> {
                mid = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-NEG, mid, ov, 0, '', TY-I64)
                v = mid
                ok-p = 1
            }

            ; s70：f64 前缀负号 -x ⇒ OP-NEG（镜像 Go emitNeg 的 float 分支，cg 发 fneg double %fd…）
            ;   操作数型别作 mid/emit 型别（寄存器模式下 f64 以 %fd SSA 流动，不落槽）
            ov > 0 && osym == '-' && h2m-vty-at(c, ov) == TY-F64 -> {
                mid = h2m-alloc(c, TY-F64)
                h2m-emit(c, OP-NEG, mid, ov, 0, '', TY-F64)
                v = mid
                ok-p = 1
            }

            ; s88：'!' 值语义对齐 Go emitNot——hir2mir prefixOp '!' ⇒ OpNot、dest 型别 bool
            ;   （MIR 把 bool 映射为 i1）；codegen.go:6408 先 coerceInt(i64→i1) 发 `trunc i64 … to i1`
            ;   （取最低位）再 `xor i1 1` ⇒ 值恒 (x&1)^1 ∈ {0,1}。自举无 i1 槽（整族共用 i64 宽，
            ;   口径同 s78/s83）⇒ 以 OP-CONST(1)＋OP-AND 表达 trunc 归位、OP-NOT 表达 xor 1。
            ;   旧 s66 直发 `xor i64 1, %v`（全宽）仅在操作数 ∈ {0,1} 同值——非 0/1 分岔：
            ;   oracle tmp/s88-oracle-i64.no 实钉 117（态 T）vs 探针旧形 362（态 W）。
            ;   u64 主体同臂放行（s81 登记的门禁尾款）；结果恒 bool ⇒ dest 一律 TY-I64
            ;   f64 主体 '!' 不落此臂⇒仍计 unsup（Go 侧 double→i1 恒得 true，poison 退化无稳定语义）
            ; s89 纪实：非整型主体 '!' 维持门禁是正确形态——三面均无权威可镜像（实作零改）：
            ;   f64 运行路 coerceInt(i64→i1) 对 double 截出 poison 再 xor i1 1 ⇒ 恒 true；
            ;   str/vec 运行路 intWidth 查不到 ⇒ coerceInt 原样返回，emitNot 发 `xor i1 1, %str-long`
            ;   类型错 build fail（trace d8en6a9j）；字面量路 hir inline comptime 折叠恒 true
            ;   （空串也 true，证伪空检语义）。本臂 I64||U64 门是 cg OP-NOT 恒发 i64 域的上游防线。
            ;   哨兵：h2m-test test-prefix-lnot-f64-gate / test-prefix-lnot-str-gate
            ov > 0 && osym == '!' && (h2m-vty-at(c, ov) == TY-I64 || h2m-vty-at(c, ov) == TY-U64) -> {
                one = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CONST, one, 1, 0, '', TY-I64)
                low = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-AND, low, ov, one, '', TY-I64)
                mid = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-NOT, mid, low, 0, '', TY-I64)
                v = mid
                ok-p = 1
            }

            ; s69：位非 ~x（镜像 Go hir2mir.go:8861 ~⇒OpXor 全 1 常量，非 OpNot）
            ;   ~x = x XOR -1（-1 = i64 全 1）；先落 OP-CONST -1，再 OP-XOR 双 SSA 操作数
            ov > 0 && osym == '~' && h2m-vty-at(c, ov) == TY-I64 -> {
                cm1 = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CONST, cm1, -1, 0, '', TY-I64)
                mid = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-XOR, mid, ov, cm1, '', TY-I64)
                v = mid
                ok-p = 1
            }

            ; s81：u64 主体前缀负号 -x ⇒ OP-NEG（dest TY-U64），镜像 Go emitNeg 非 option 非 float 路径；
            ;   cg 整数臂（vty != TY-F64）发 sub i64 0, %v——TY-U64 与 TY-I64 共用 %v 命名空间与 i64 型别，
            ;   二补回绕同形（-(1 u64)=M-1），零改 cg；s76–s80 u64 族收尾的前缀 NEG 一环
            ov > 0 && osym == '-' && h2m-vty-at(c, ov) == TY-U64 -> {
                mid = h2m-alloc(c, TY-U64)
                h2m-emit(c, OP-NEG, mid, ov, 0, '', TY-U64)
                v = mid
                ok-p = 1
            }

            ; s81：u64 主体位非 ~x ⇒ OP-CONST(-1)+OP-XOR（dest TY-U64），镜像 Go ~⇒XOR-all-ones；
            ;   与 i64 ~x 同发 add i64 0, -1 与 xor i64，仅 dest 型别码为 TY-U64；'!' 于 u64 已随 s88 放行（见上 '!' 臂）
            ov > 0 && osym == '~' && h2m-vty-at(c, ov) == TY-U64 -> {
                cm1 = h2m-alloc(c, TY-U64)
                h2m-emit(c, OP-CONST, cm1, -1, 0, '', TY-U64)
                mid = h2m-alloc(c, TY-U64)
                h2m-emit(c, OP-XOR, mid, ov, cm1, '', TY-U64)
                v = mid
                ok-p = 1
            }
            ok-p == 0 -> h2m-mark(c)
        }

        ; s99：结构体字面量降级——K-STRUCT-LITERAL：s0 = 结构体名，kids = StructField（s0 = 字段名、kid0 = 值 expr）。
        ;   逐字段降级，字段值 id 经 args 侧池传给 cg 的 OP-STRUCT-MK（xa[k]=基址、bs[k]=字段数，
        ;   第 j 个字段值 id = args[xa[k]+j]）——解除「字段值 id 连续」假设（嵌套结构体字面量作非首位
        ;   字段值时值 id 不连续，cg 侧池索引取真實 id，与 OP-CALL 同形）；
        ;   每个字段值的型别由 h2m-lower-expr 自己登记进 vty（字段序即 ast 字段序，与定义序一致）。
        ;   ⚠️ 字段数必须与定义一致（nf != stfc ⇒ 诚实门禁，避免 cg 按 nf 步数 insertvalue 与型别声明错位）。
        d.kind == asp.K-STRUCT-LITERAL -> {
            sname = ast.str-at(t, d.s0)
            sid = h2m-struct-find(c, sname)
            sid < 0 -> h2m-mark(c)
            sid >= 0 -> {
                nf = d.nkid
                want = h2m-struct-fc(c, sid)
                nf != want -> h2m-mark(c)
                nf == want -> {
                    fvs []i64 = []
                    i = 0
                    (i < nf) {

                        ; d.kid0 是首 kid 位置基址（非节点 id）：先 ast.kid-at 取子节点 id 再 ast.nd-at（同 h2m-struct-register）
                        fchild = ast.kid-at(t, d.kid0 + i)
                        fnode = ast.nd-at(t, fchild)

                        ; 字面量 StructField：kid0 = Type 占位(0)，Value 是【第二个 kid】⇒ 走 fnode.kid0 + 1 位置取（nd 结构体无 kid1 字段，多 kid 连续存于 kid0 起）
                        vexpr = ast.kid-at(t, fnode.kid0 + 1)
                        fv = h2m-lower-expr(t, c, sg, vexpr)
                        fv == 0 -> h2m-mark(c)
                        fvs.push(fv)

                        #{overflow=wrap}
                        i = i + 1
                    }

                    ; s99n：逃逸门禁——切片字面量的自拥有 %vec 被放进结构体字段 ⇒ 所有权外流。
                    ;   vec 缓冲无 RC 头（§11 B5）、没有 retain 可用 ⇒ scope-exit 仍 free 就是悬垂指针，
                    ;   故整函数计 unsup（宁缺勿错，与 s62「vec 作返回值」同一处置）。
                    vi = 0
                    (vi < fvs.len()) {
                        h2m-vec-own(c, fvs[vi]) == 1 -> h2m-mark(c)

                        #{overflow=wrap}
                        vi = vi + 1
                    }

                    #{overflow=wrap}
                    stcode = TY-STRUCT-BASE + sid
                    sv = h2m-alloc(c, stcode)

                    ; ②MK 連續 id 修復（args 側池）：先收齊全部欄位值再整段入池（同 OP-CALL 的 al 暫存再 push，
                    ;   避免嵌套降級往池中間插入孤兒項擠偏 base）；cg 依 base+j 取，不再假設 xa[k]+j。
                    base = c.args.len()
                    m = 0
                    (m < nf) {
                        c.args.push(fvs[m])

                        #{overflow=wrap}
                        m = m + 1
                    }
                    h2m-emit(c, OP-STRUCT-MK, sv, base, nf, '', stcode)

                    ; s99g：含 str 欄位 ⇒ 構造後即取得所有權，緊接 OP-STRUCT-RETAIN
                    ;   （mir.no L194：MK 只存不 retain；cg L2315 依 bs[k] 掩碼對每個 str 欄位 call @nolang_rc_retain）。
                    ;   掩碼 bit j 置位 ⇔ 欄位 j 是 str；無 str 欄位（mask==0）不發。
                    ; s99j：取得所有權後緊接登記 scope-exit 釋放（與本行 RETAIN 配對）——函數退出時由
                    ;   h2m-emit-releases 對該 %st 值發 OP-STRUCT-RELEASE（跳過「已被回傳佔用」的值，防雙重釋放）。
                    ;   放行條件見 h2m-emit-releases：mem==0 直接放行；mem==1 僅當函數不含 OP-CALL 才放行
                    ;   （含 call 時保守保持 leak，需 move 分析方能正確釋放，見 §5.3.4.el 後續）。
                    mk-mask = h2m-struct-str-mask(c, sid)
                    mk-mask != 0 -> h2m-emit(c, OP-STRUCT-RETAIN, 0, sv, mk-mask, '', 0)
                    mk-mask != 0 -> h2m-rel-add(c, sv, stcode, mk-mask)
                    v = sv
                }
            }
        }

        ; s99：点号字段读——K-DOT-EXPRESSION：s0 = 字段名，kid0 = 接收者（变量或字面量）。
        ;   降级接收者得结构体值 id（vty 含 TY-STRUCT-BASE 偏移），按名查字段下标，发 OP-STRUCT-GET；
        ;   cg 取 vty[xa[k]] 推结构体 id、cty[k] 推字段型别前缀。
        d.kind == asp.K-DOT-EXPRESSION -> {
            fname = ast.str-at(t, d.s0)
            recv = ast.kid-at(t, d.kid0)
            sv = h2m-lower-expr(t, c, sg, recv)
            sv > 0 -> {
                stcode = h2m-vty-at(c, sv)

                #{overflow=wrap}
                sid = stcode - TY-STRUCT-BASE
                (sid < 0 || sid >= c.stn.len()) -> h2m-mark(c)
                sid >= 0 && sid < c.stn.len() -> {
                    fi = h2m-struct-field-idx(c, sid, fname)
                    fi < 0 -> h2m-mark(c)
                    fi >= 0 -> {
                        fty = h2m-struct-field-ty(c, sid, fi)
                        fv = h2m-alloc(c, fty)
                        h2m-emit(c, OP-STRUCT-GET, fv, sv, fi, '', fty)
                        v = fv
                    }
                }
            }
        }

        ; s99i：索引读取 expr[i]（就地索引 vec 欄位 / 本地 vec 變量）——base 降級出 %vec 值 id 後發 OP-VECGET 取第 i 個 i64 元素
        ;   base 須是 TY-VEC（[]i64 欄位 / vec 形參 / mem==0 下綁定的 vec 局部）；其餘型別（str/struct/arr）不在本臂，計 unsup
        ;   kid[0] = base、kid[1] = 下標（i64）；元素型別恒 i64（自舉 vec 元素僅收 i64，與 @vec_get_i64 單型 helper 一致）
        d.kind == asp.K-INDEX-EXPRESSION -> {
            bk = ast.kid-at(t, d.kid0)
            ik = ast.kid-at(t, d.kid0 + 1)
            bv = h2m-lower-expr(t, c, sg, bk)
            bv > 0 -> {
                bt = h2m-vty-at(c, bv)
                bt == TY-VEC -> {
                    iv = h2m-lower-expr(t, c, sg, ik)
                    iv > 0 -> {
                        ev = h2m-alloc(c, TY-I64)
                        h2m-emit(c, OP-VECGET, ev, bv, iv, '', TY-I64)
                        v = ev
                    }
                }
                bt != TY-VEC -> h2m-mark(c)
            }
        }

        ; s99n：切片字面量 [e0, e1, …] → OP-VECNEW + 逐元素 OP-VECPUSH（镜像 Go lowerSliceLiteral 的整数元素形）
        ;   ⚠️ @vec_push_i64 是单型 helper（§11 B5：vec 元素目前只有 i64）⇒ 任一个元素非 i64 即计 unsup，
        ;      []str 等元素型别支路整条不入形（与 s62 形参、s99f 欄位同一口径）。
        ;   ⚠️ 只登记【最终】%vec 入释放清单：@vec_push_i64 返回新 %vec 且已自行 free 旧缓冲，
        ;      中间值无主（登记中间值 = free 一个已释放的指针）。空字面量 `[]` 无 push，登记 @vec_new
        ;      的裸值（dat=0，@vec_free 内短路，见 cg-runtime.no）。
        ;   ⚠️ 所有权唯一的另一半是「不许外流」：结构体字段写 / 返回值两处由调用点门禁拦（无 vec retain）。
        d.kind == asp.K-SLICE-LITERAL -> {
            vcnew = h2m-alloc(c, TY-VEC)
            h2m-emit(c, OP-VECNEW, vcnew, 0, 0, '', TY-VEC)
            vc-cur = vcnew
            ok-sl = 1
            ei = 0
            (ei < d.nkid && ok-sl == 1) {
                ep = d.kid0

                #{overflow=wrap}
                ep = ep + ei
                ek = ast.kid-at(t, ep)
                evo = h2m-lower-expr(t, c, sg, ek)
                evo == 0 -> {
                    h2m-mark(c)
                    ok-sl = 0
                }
                evo > 0 -> {
                    eto = h2m-vty-at(c, evo)
                    eto == TY-I64 -> {
                        vcn = h2m-alloc(c, TY-VEC)
                        h2m-emit(c, OP-VECPUSH, vcn, vc-cur, evo, '', TY-VEC)
                        vc-cur = vcn
                    }
                    eto != TY-I64 -> {
                        h2m-mark(c)
                        ok-sl = 0
                    }
                }

                #{overflow=wrap}
                ei = ei + 1
            }
            ok-sl == 1 -> {
                v = vc-cur
                h2m-rel-add(c, vc-cur, TY-VEC, 0)
            }
        }

        -> h2m-mark(c)
    }
}

; LetStatement 降级：右值降级出的 id 直接绑到名字（不发 alloca/store/load）
; kid 区序 = [型别节点, 值表达式]，取最后一个 kid 作值（对 nkid=1 的合成人同样成立）
; 显式型别标注（kids[0] 非 0）必须与右值型别码一致，否则计 unsup
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: 语句节点 id
h2m-lower-let = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    d = ast.nd-at(t, n)
    d.nkid == 0 -> h2m-mark(c)
    d.nkid > 0 -> {
        nm = ast.str-at(t, d.s0)
        vp = d.kid0
        vc = d.nkid

        #{overflow=wrap}
        vc = vc - 1

        #{overflow=wrap}
        vp = vp + vc
        vk = ast.kid-at(t, vp)
        vv = 0

        ; s103：值位 SurfaceMatch 右值（`r = { c -> v  -> d }`）——不走 h2m-lower-expr（其 switch 不认
        ;   K-SURFACE-MATCH，会直接计 unsup），改走 h2m-lower-surface 的值位分支：逐臂把臂值 STORE 进
        ;   前扫描铺好的结果槽，汇聚块 LOAD 交回。结果槽名按本 LetStatement 节点 id 合成。
        vkd = ast.nd-at(t, vk)
        vkd.kind == asp.K-SURFACE-MATCH -> vv = h2m-lower-surface(t, c, sg, vk, h2m-smv-name(n))
        vkd.kind != asp.K-SURFACE-MATCH -> vv = h2m-lower-expr(t, c, sg, vk)
        vv > 0 -> h2m-var-write(c, nm, vv)

        ; 型别标注侧：走 h2m-tynode-code 共用判据且码与右值相符（不符 ⇒ 计 unsup，整函数不产码）
        ;   s94：?u64 标注入形——Go 解析期的 capture 机制（synthesizeNullableType）会把
        ;   `z = f()`（f 回 ?u64）的 let 标注合成成 NullableType{NamedType{u64}}，旧单臂「非 NAMED 即拒」
        ;   会误杀捕获形；签名侧与标注侧同改一 helper，不留两套口径（§11 B7）
        tc = 0
        vv > 0 && d.nkid > 1 -> {
            tkp = d.kid0
            tk = ast.kid-at(t, tkp)
            tk > 0 -> {
                code = h2m-tynode-code(t, c, tk)
                code != h2m-vty-at(c, vv) -> tc = -1
                code >= 0 && code == h2m-vty-at(c, vv) -> tc = 1
            }
        }
        tc < 0 -> h2m-mark(c)
    }
}

; BlockStatement 降级：逐个 kid 降级；认得 LetStatement / IfExpression / ForStatement /
; ExpressionStatement（内含 IfExpression，即述层的 `cond -> stmt` 单行 guard；s93 起亦含裸调用），其余计 unsup
; s59：陈述位终结形（return/break/continue）经 h2m-lower-term-stmt 分派，非本块末条计 unsup
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: 块节点 id
h2m-lower-block = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    d = ast.nd-at(t, n)
    i = 0
    (i < d.nkid) {
        p = d.kid0

        #{overflow=wrap}
        p = p + i
        kid = ast.kid-at(t, p)
        kk = ast.nd-at(t, kid)
        hd = 0

        ; s59：本块末条判定（终结形只能站在陈述列末尾）
        last = 0
        li = d.nkid

        #{overflow=wrap}
        li = li - 1
        i == li -> last = 1
        th = kk.kind
        th == asp.K-RETURN-STATEMENT || th == asp.K-BREAK-STATEMENT || th == asp.K-CONTINUE-STATEMENT -> {
            hd = h2m-lower-term-stmt(t, c, sg, kid, last)
        }
        kk.kind == asp.K-LET-STATEMENT -> {
            h2m-lower-let(t, c, sg, kid)
            hd = 1
        }
        kk.kind == asp.K-IF-EXPRESSION -> {
            h2m-lower-if(t, c, sg, kid)
            hd = 1
        }
        kk.kind == asp.K-FOR-STATEMENT -> {
            h2m-lower-for(t, c, sg, kid)
            hd = 1
        }
        kk.kind == asp.K-SURFACE-MATCH -> {
            h2m-lower-surface(t, c, sg, kid, '')
            hd = 1
        }

        ; s101：`...` 占位陈述——什么都不做（镜像 Go ASTToHIR 对 EmptyStatement 的整条丢弃）。
        ;   hd = 1 表示「本陈述已被消费」，避免落进下方 hd == 0 的诚实门禁。
        kk.kind == asp.K-EMPTY-STATEMENT -> hd = 1

        ; 述层的单行 `cond -> stmt`：ExpressionStatement 包一个 IfExpression（实测 kid 序 [expr]）
        kk.kind == asp.K-EXPRESSION-STATEMENT -> {
            sub = h2m-kid-i(t, kid, 0)
            sub > 0 -> {
                sd = ast.nd-at(t, sub)
                sd.kind == asp.K-IF-EXPRESSION -> {
                    h2m-lower-if(t, c, sg, sub)
                    hd = 1
                }
                sd.kind == asp.K-SURFACE-MATCH -> {
                    h2m-lower-surface(t, c, sg, sub, '')
                    hd = 1
                }

                ; s59：`cond -> return` 的 guard 块里是裸 BLOCK(inline) 包陈述；但若子节点
                ;   直接就是终结形（合成 AST 或未来解析改造），同样走末位分派
                st = sd.kind
                st == asp.K-RETURN-STATEMENT || st == asp.K-BREAK-STATEMENT || st == asp.K-CONTINUE-STATEMENT -> {
                    hd = h2m-lower-term-stmt(t, c, sg, sub, last)
                }

                ; s93：语句位调用——镜像 Go hir2mir.go:3790 KExprStmt 的 else 分支 `l.stmtVal = l.lowerExpr(child)`：
                ;   表达式照降（副作用在序），交出的值 id 直接丢弃，不绑变量也不落槽。
                ;   ⚠ 只收 K-CALL-EXPRESSION：Go 的 checker 层 checkBareExprStatement 专拒裸字面量（yf6kxdmz）
                ;     与裸函数标识符（k9179drd），自举无 checker ⇒ 其余表达式仍走下面 hd=0 的诚实门禁，
                ;     免得自举产物比权威更宽松（同 s92「被缺且无默认值」在此兜住的口径）。
                ;   ⚠ lower-expr 失败时自己已经 mark 过（其每条不支持路皆 h2m-mark），故 hd 置 1 不再补计，避免双账
                hd == 0 && sd.kind == asp.K-CALL-EXPRESSION -> {
                    h2m-lower-expr(t, c, sg, sub)
                    hd = 1
                }

                ; s99：字段写——K-ASSIGN-EXPRESSION 且 LHS 是 K-DOT-EXPRESSION（var.field = rhs）：
                ;   降 RHS 得值 id；读旧结构体值（h2m-var-read）、按名查字段下标与型别；
                ;   OP-STRUCT-SET 产「读旧 + insertvalue 出新值」（LLVM 结构不可变），再 h2m-var-write 把变量重绑到新值。
                ;   ⚠️ ast.kid-at 回 i64 节点 id（非结构体），取 kind 走 ast.kind-at、取名走 ast.nd-at 落地局部再 .s0，
                ;     不得对 kid-at 结果直接 .kind（bin/no 旧后端报 NoVal）；nd-at 结构体拷贝字段亦不得裸进区块臂条件。
                hd == 0 && sd.kind == asp.K-ASSIGN-EXPRESSION -> {
                    lk = h2m-kid-i(t, sub, 0)
                    lk > 0 -> {
                        lkd = ast.nd-at(t, lk)
                        lkd.kind == asp.K-DOT-EXPRESSION -> {
                            recv = ast.kid-at(t, lkd.kid0)
                            rk = ast.kind-at(t, recv)
                            rk == asp.K-IDENTIFIER -> {
                                rd = ast.nd-at(t, recv)
                                varnm = ast.str-at(t, rd.s0)
                                sv = h2m-var-read(c, varnm)
                                sv > 0 -> {
                                    stcode = h2m-vty-at(c, sv)

                                    ; #{overflow=wrap}
                                    sid = stcode - TY-STRUCT-BASE
                                    (sid < 0 || sid >= c.stn.len()) -> h2m-mark(c)
                                    sid >= 0 && sid < c.stn.len() -> {
                                        fname = ast.str-at(t, lkd.s0)
                                        fi = h2m-struct-field-idx(c, sid, fname)
                                        fi < 0 -> h2m-mark(c)
                                        fi >= 0 -> {
                                            fty = h2m-struct-field-ty(c, sid, fi)
                                            rhsn = h2m-kid-i(t, sub, 1)
                                            rv = h2m-lower-expr(t, c, sg, rhsn)

                                            ; s99n：逃逸门禁——自拥有 %vec 写进结构体字段 ⇒ 所有权外流
                                            ;   （无 vec retain，§11 B5）⇒ 计 unsup，整函数不产码
                                            h2m-vec-own(c, rv) == 1 -> h2m-mark(c)
                                            rv > 0 -> {
                                                dsv = h2m-alloc(c, stcode)
                                                h2m-emit(c, OP-STRUCT-SET, dsv, sv, rv, '', fi)
                                                h2m-var-write(c, varnm, dsv)
                                            }
                                            rv == 0 -> h2m-mark(c)
                                        }
                                    }
                                }
                                sv == 0 -> h2m-mark(c)
                            }
                            rk != asp.K-IDENTIFIER -> h2m-mark(c)
                        }
                    }
                    hd = 1
                }
            }
        }
        hd == 0 -> h2m-mark(c)

        #{overflow=wrap}
        i = i + 1
    }
}

; 分支体降级：Block 走 h2m-lower-block；嵌套 IfExpression 走 h2m-lower-if（elif 链就靠这一路）；
; 花括号短路链走 h2m-lower-surface；臂体内再开循环走 h2m-lower-for（s58）；
; s58 补：链臂体的单陈述形（非块）走 h2m-lower-block；s59 补：臂体直接是终结形（单陈述 inline 臂）走 h2m-lower-term
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: 体节点 id
h2m-lower-branch = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    n <= 0 -> h2m-mark(c)
    n > 0 -> {
        d = ast.nd-at(t, n)
        {
            d.kind == asp.K-BLOCK-STATEMENT -> h2m-lower-block(t, c, sg, n)

            d.kind == asp.K-IF-EXPRESSION -> h2m-lower-if(t, c, sg, n)

            d.kind == asp.K-SURFACE-MATCH -> h2m-lower-surface(t, c, sg, n, '')

            d.kind == asp.K-FOR-STATEMENT -> h2m-lower-for(t, c, sg, n)

            ; s59：单陈述臂体直接是终结形（`n > 0 -> return` 的 inline 形若未包块即走此路）
            d.kind == asp.K-RETURN-STATEMENT || d.kind == asp.K-BREAK-STATEMENT || d.kind == asp.K-CONTINUE-STATEMENT -> h2m-lower-term(t, c, n, d.kind)

            -> h2m-mark(c)
        }
    }
}

; IfExpression 降级：kid 序 = [Condition][Consequence][Alternative]（实测 3 kid，单行 guard 的 Alternative = 0）
; 块形制：当前块求值条件后发 CONDBR，then / else 各成一块并无条件的 BR 回汇聚块。
; ⚠️ CONDBR 的三个槽按 cg 口径填：xa = 条件值 id、bs = 真块 id、**dsts = 假块 id**（此处 dsts 不是结果值）
; ⚠️ 无 else 臂时把假路直接接到汇聚块，不留空块；每个开出来的块至少拿到一条终结指令（连续段纪律）
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: IfExpression 节点 id
h2m-lower-if = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    ck = h2m-kid-i(t, n, 0)
    tk = h2m-kid-i(t, n, 1)
    ek = h2m-kid-i(t, n, 2)
    cv = h2m-lower-expr(t, c, sg, ck)
    cv == 0 -> h2m-mark(c)
    cv > 0 -> {
        then-id = h2m-block-new(c)
        else-id = h2m-block-new(c)
        merge-id = h2m-block-new(c)
        ftgt = else-id
        ek == 0 -> ftgt = merge-id
        h2m-emit(c, OP-CONDBR, ftgt, cv, then-id, '', 0)

        h2m-set-block(c, then-id)
        h2m-lower-branch(t, c, sg, tk)
        h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)

        ek > 0 -> {
            h2m-set-block(c, else-id)
            h2m-lower-branch(t, c, sg, ek)
            h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)
        }

        h2m-set-block(c, merge-id)
    }
}

; ForStatement 降级（s57：纯前置条件循环 `(cond) { }`；s60m：计数循环 `N * { }` 与 `{ } * N`；s61：区间遍历 `i <- [a..b]`；s62：容器遍历 `i <- xs`）
; kid 序 = [Init][Condition][Update][CountExpr][IterRange][Body]（ps.no:5706 注释 + 实测 kid[1]/kid[5]）
; 条件循环块形制：当前块 BR → hdr；hdr 求值条件后 CONDBR(body, exit)；body 结尾 BR 回 hdr；后继语句落在 exit
; s59：进 body 前压 (continue 目标, exit) 到循环栈（c.stk/c.stk-n）⇒ 体内 break/continue 查栈顶；出口弹回
; ⚠️ Init/Update 任一非 0 ⇒ 不在覆盖面（C 形三段式本件不收）
; ⚠️ Condition／CountExpr／IterRange 三者只认其一：Go lowerFor 按 iter → count → 三段式的序命中即走，
;   多余位被静默丢弃（计数的条件位、区间的条件位都会沉掉）；本件宁缺勿错：并存 ⇒ 计 unsup，
;   仅放宽 `for v <- rng` 关键字形（ps.no:5762 把 cond 写成循环变量自身的 IDENT，与 IterRange 同义不矛盾，
;   h2m-lower-for 对此形不另计形位）
; s60m 计数循环形制（镜像 Go lowerCountFor hir2mir.go:5408）：计数值 STORE 进合成计数器槽→
;   hdr LOAD 后 CMPGT 0→ CONDBR(body, exit)→ body 结尾 BR 到 update（不是 hdr）→
;   update 块 LOAD/SUB 1/STORE 后 BR hdr；continue 目标因此是 update（自减后再判，不会活锁）
; s61 区间遍历形制（镜像 Go lowerRangeFor hir2mir.go:5017-5176）→ 转 h2m-lower-range
; s62 容器遍历形制（镜像 Go lowerRangeFor 的容器分支 hir2mir.go:5179-5301）→ 转 h2m-lower-coll
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: ForStatement 节点 id
h2m-lower-for = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    d = ast.nd-at(t, n)
    init = h2m-kid-i(t, n, 0)
    cond = h2m-kid-i(t, n, 1)
    upd = h2m-kid-i(t, n, 2)
    cnt = h2m-kid-i(t, n, 3)
    rng = h2m-kid-i(t, n, 4)
    body = h2m-kid-i(t, n, 5)
    bad = 0
    d.nkid != 6 -> bad = 1
    init != 0 || upd != 0 -> bad = 1
    body == 0 -> bad = 1

    ; 区间／容器两形共用同一个 IterRange 位（kid[4]）：先试区间形，不中就试容器形
    ; rg 非 0 且 cond 非 0 时，cond 必是「循环变量自身的 IDENT」（`for v <- rng` 关键字形，
    ;   h2m-rng-check 只认这一形），与 IterRange 同义 ⇒ 不另计一个形位（h2m-coll-check 同口径）
    rg = 0
    ce = 0
    vn = ''
    bad == 0 && rng != 0 -> rg = h2m-rng-check(t, rng, cond)
    bad == 0 && rng != 0 && rg == 0 -> ce = h2m-coll-check(t, rng, cond)
    bad == 0 && rng != 0 && rg == 0 && ce == 0 -> bad = 1
    rg > 0 || ce > 0 -> vn = h2m-rng-var(t, rng)
    bad == 0 && rng != 0 && vn == '' -> bad = 1

    ; 条件／计数／区间三位只允许一个真正生效的形（并存时 Go 会静默吃掉其一 ⇒ 就地不产码）
    ;   ⚠️ 关键字形（rg 或 ce 命中）的 cond 位就是循环变量自身的 IDENT，与 IterRange 同义 ⇒ 不计形位
    form = 0
    rg == 0 && ce == 0 && cond != 0 -> form = 1
    cnt != 0 -> {

        #{overflow=wrap}
        form = form + 1
    }
    rng != 0 -> {

        #{overflow=wrap}
        form = form + 1
    }
    form != 1 -> bad = 1

    bad != 0 -> h2m-mark(c)
    bad == 0 && cond != 0 && rng == 0 -> {
        hdr-id = h2m-block-new(c)
        body-id = h2m-block-new(c)
        exit-id = h2m-block-new(c)
        h2m-emit(c, OP-BR, 0, hdr-id, 0, '', 0)

        h2m-set-block(c, hdr-id)
        cv = h2m-lower-expr(t, c, sg, cond)
        cv == 0 -> h2m-mark(c)
        cv > 0 -> h2m-emit(c, OP-CONDBR, exit-id, cv, body-id, '', 0)

        h2m-set-block(c, body-id)

        ; s59：压循环目标对 (hdr, exit)——continue 查 hdr（重判条件）、break 查 exit（跑完后继语句）
        c.stk.push(hdr-id)
        c.stk.push(exit-id)

        #{overflow=wrap}
        c.stk-n = c.stk-n + 1
        h2m-lower-block(t, c, sg, body)

        ; s65：出栈真刪除——只減計数留陳項 ⇒ 下一个兄弟循环查到本层的 hdr/exit（break 回跳成死循環）
        c.stk.pop()
        c.stk.pop()
        c.stk-n = c.stk-n - 1
        h2m-emit(c, OP-BR, 0, hdr-id, 0, '', 0)

        h2m-set-block(c, exit-id)
    }

    ; s60m：计数循环——计数值只算一次（落在进循环前的当前块），此后全靠槽里的自减驱动
    bad == 0 && cnt != 0 -> {
        nv0 = h2m-lower-expr(t, c, sg, cnt)
        nv0 == 0 -> h2m-mark(c)

        ; 计数器槽只认 i64（cg 只有 alloca i64 与 alloca %str-long 两种），其余型别进不了计数器
        nv0 > 0 && h2m-vty-at(c, nv0) != TY-I64 -> h2m-mark(c)
        nv0 > 0 && h2m-vty-at(c, nv0) == TY-I64 -> {
            slot = h2m-var-find(c, h2m-cnt-name(n))

            ; 前扫描未登记该槽 ⇒ 降级侧与前扫侧形制不一致（绝不允许默默发错码）
            slot == 0 -> h2m-mark(c)
            slot > 0 -> {
                h2m-emit(c, OP-STORE, 0, nv0, slot, '', 0)
                ch-id = h2m-block-new(c)
                cb-id = h2m-block-new(c)
                cu-id = h2m-block-new(c)
                ce-id = h2m-block-new(c)
                h2m-emit(c, OP-BR, 0, ch-id, 0, '', 0)

                ; header：每次判定都重新 LOAD 计数器（槽跨迭代，SSA 值不可复用）
                h2m-set-block(c, ch-id)
                cl1 = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-LOAD, cl1, slot, 0, '', TY-I64)
                cz0 = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CONST, cz0, 0, 0, '', TY-I64)
                cg0 = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CMPGT, cg0, cl1, cz0, '', TY-I64)
                h2m-emit(c, OP-CONDBR, ce-id, cg0, cb-id, '', 0)

                h2m-set-block(c, cb-id)

                ; 循环目标对压 (update, exit)：continue 先自减再重判（对齐 Go loopCtx.update）
                c.stk.push(cu-id)
                c.stk.push(ce-id)

                #{overflow=wrap}
                c.stk-n = c.stk-n + 1
                h2m-lower-block(t, c, sg, body)

                ; s65：出栈真刪除（同前置循環）
                c.stk.pop()
                c.stk.pop()
                c.stk-n = c.stk-n - 1
                h2m-emit(c, OP-BR, 0, cu-id, 0, '', 0)

                ; update 块：cnt = cnt - 1 后跳回 header（N ≤ 0 的初始形在 header 首次判定即退出）
                h2m-set-block(c, cu-id)
                cl2 = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-LOAD, cl2, slot, 0, '', TY-I64)
                co1 = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CONST, co1, 1, 0, '', TY-I64)
                cnx = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-SUB, cnx, cl2, co1, '', TY-I64)
                h2m-emit(c, OP-STORE, 0, cnx, slot, '', 0)
                h2m-emit(c, OP-BR, 0, ch-id, 0, '', 0)

                h2m-set-block(c, ce-id)
            }
        }
    }

    ; s61：区间遍历——形状已过校验，块形制交给 h2m-lower-range
    bad == 0 && rg > 0 -> h2m-lower-range(t, c, sg, rg, body, vn)

    ; s62：容器遍历——形状已过校验，块形制交给 h2m-lower-coll（n 用于回推合成索引槽名）
    bad == 0 && ce > 0 -> h2m-lower-coll(t, c, sg, n, ce, body, vn)
}

; 区间遍历降级（s61）：`i <- [a..b]`／`(a..b]`／`[a..b]`／`(a..b)` 四括号组合 + 自动双向
; 镜像 Go lowerRangeFor（src/mir/hir2mir.go:5017-5176）——IR 无 select ⇒ 方向由 lo <= hi 的分支解析，
;   init / header / update 三处各判一次方向，共 11 块（块 id 递增序即写入序，满足 cg 连续段纪律）：
;   pre    ：两端点只求值一次，发 CMPLE(lo, hi) + CONDBR(initDesc | initAsc)
;   initAsc：i = lo + off（'(' ⇒ off=1，'[' ⇒ 0）后 BR join    initDesc：i = lo - off 后 BR join
;   join   ：BR hdr
;   hdr    ：再判方向 ⇒ CONDBR(hdDesc | hdAsc)
;   hdAsc  ：LOAD i 后 i < hi（']' ⇒ <=），CONDBR(exit | body)   hdDesc：i > hi（']' ⇒ >=）
;   body   ：陈述列，结尾 BR upd（continue 目标 = upd，同 s60m 口径）
;   upd    ：再判方向 ⇒ CONDBR(updDesc | updAsc)
;   updAsc ：i = i + 1 后 BR hdr                              updDesc：i = i - 1 后 BR hdr
;   exit   ：循环后继语句落此块
; ⚠️ 与 Go 的偏差（就地不产码）：容器遍历／开边界／嵌套同名区间循环（末者两层共用一个槽 ⇒
;   内层踩掉外层计数，Go 给内层另开一颗并把绑定也换掉，两边语义都不干净，宁缺勿错）
; ⚠️ 端点值 sv/ev 在 pre 块定义、被其后各块引用：pre 支配一切循环块 ⇒ SSA 合法；
;   且端点不写回（只有循环变量落槽），故可像 Go 一样直接复用同一对值 id 而非每次重新 LOAD
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; rg: RangeExpression 节点 id（h2m-rng-check 已验形状）
; body: 循环体 BlockStatement 节点 id
; vn: 循环变量名
h2m-lower-range = (t ast, c h2m-ctx, sg h2m-sigs, rg i64, body i64, vn str) {
    rd = ast.nd-at(t, rg)
    sk = h2m-kid-i(t, rg, 0)
    ek = h2m-kid-i(t, rg, 1)

    ; 左开 '(' ⇒ 起始值要偏一格；右闭 ']' ⇒ 终止比较取 <=／>=，右开 ')' ⇒ 取 <／>
    li = ast.str-at(t, rd.s0)
    ri = ast.str-at(t, rd.s1)
    lo-off = 0
    li != 'true' -> lo-off = 1
    asc-op = OP-CMPLT
    desc-op = OP-CMPGT
    ri == 'true' -> asc-op = OP-CMPLE
    ri == 'true' -> desc-op = OP-CMPGE

    islot = h2m-var-find(c, vn)
    bad = 0
    islot == 0 -> bad = 1

    ; 嵌套同名区间循环判据：活动名栈里已有同名 ⇒ 共用一颗槽会互相踩计数，整函数不产码
    q = 0
    (q < c.rnms-n && bad == 0) {
        qn = c.rnms[q]
        qn == vn -> bad = 1

        #{overflow=wrap}
        q = q + 1
    }
    bad == 1 -> h2m-mark(c)

    bad == 0 -> {
        sv = h2m-lower-expr(t, c, sg, sk)
        ev = h2m-lower-expr(t, c, sg, ek)
        ty-ok = 1
        sv > 0 && h2m-vty-at(c, sv) != TY-I64 -> ty-ok = 0
        ev > 0 && h2m-vty-at(c, ev) != TY-I64 -> ty-ok = 0
        sv == 0 || ev == 0 || ty-ok == 0 -> h2m-mark(c)

        sv > 0 && ev > 0 && ty-ok == 1 -> {
            ias-id = h2m-block-new(c)
            ide-id = h2m-block-new(c)
            ijo-id = h2m-block-new(c)
            chr-id = h2m-block-new(c)
            cha-id = h2m-block-new(c)
            che-id = h2m-block-new(c)
            cbd-id = h2m-block-new(c)
            cup-id = h2m-block-new(c)
            cua-id = h2m-block-new(c)
            cud-id = h2m-block-new(c)
            cex-id = h2m-block-new(c)

            ; pre：方向定一次（升序条什 lo <= hi），两路各算起始值
            d1 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CMPLE, d1, sv, ev, '', TY-I64)
            h2m-emit(c, OP-CONDBR, ide-id, d1, ias-id, '', 0)

            h2m-set-block(c, ias-id)
            o1 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, o1, lo-off, 0, '', TY-I64)
            a1 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-ADD, a1, sv, o1, '', TY-I64)
            h2m-emit(c, OP-STORE, 0, a1, islot, '', 0)
            h2m-emit(c, OP-BR, 0, ijo-id, 0, '', 0)

            h2m-set-block(c, ide-id)
            o2 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, o2, lo-off, 0, '', TY-I64)
            s2 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-SUB, s2, sv, o2, '', TY-I64)
            h2m-emit(c, OP-STORE, 0, s2, islot, '', 0)
            h2m-emit(c, OP-BR, 0, ijo-id, 0, '', 0)

            h2m-set-block(c, ijo-id)
            h2m-emit(c, OP-BR, 0, chr-id, 0, '', 0)

            ; header：重判方向（端点不变 ⇒ 同一对值 id），两路各比 i 与 hi
            h2m-set-block(c, chr-id)
            d2 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CMPLE, d2, sv, ev, '', TY-I64)
            h2m-emit(c, OP-CONDBR, che-id, d2, cha-id, '', 0)

            h2m-set-block(c, cha-id)
            l3 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-LOAD, l3, islot, 0, '', TY-I64)
            c3 = h2m-alloc(c, TY-I64)
            h2m-emit(c, asc-op, c3, l3, ev, '', TY-I64)
            h2m-emit(c, OP-CONDBR, cex-id, c3, cbd-id, '', 0)

            h2m-set-block(c, che-id)
            l4 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-LOAD, l4, islot, 0, '', TY-I64)
            c4 = h2m-alloc(c, TY-I64)
            h2m-emit(c, desc-op, c4, l4, ev, '', TY-I64)
            h2m-emit(c, OP-CONDBR, cex-id, c4, cbd-id, '', 0)

            ; body：进体前压 (upd, exit) 与活动名 ⇒ 体内 break/continue 查栈顶，同名的嵌套层被门禁
            h2m-set-block(c, cbd-id)
            c.stk.push(cup-id)
            c.stk.push(cex-id)

            #{overflow=wrap}
            c.stk-n = c.stk-n + 1
            c.rnms.push(vn)

            #{overflow=wrap}
            c.rnms-n = c.rnms-n + 1
            h2m-lower-block(t, c, sg, body)

            ; s65：出栈真刪除——rnms 留陳項 ⇒ 后续兄弟层的同名检查拿已退出层的名字误拒／漏闸
            c.rnms.pop()
            c.rnms-n = c.rnms-n - 1
            c.stk.pop()
            c.stk.pop()
            c.stk-n = c.stk-n - 1
            h2m-emit(c, OP-BR, 0, cup-id, 0, '', 0)

            h2m-set-block(c, cup-id)
            d3 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CMPLE, d3, sv, ev, '', TY-I64)
            h2m-emit(c, OP-CONDBR, cud-id, d3, cua-id, '', 0)

            h2m-set-block(c, cua-id)
            l5 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-LOAD, l5, islot, 0, '', TY-I64)
            one1 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, one1, 1, 0, '', TY-I64)
            x5 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-ADD, x5, l5, one1, '', TY-I64)
            h2m-emit(c, OP-STORE, 0, x5, islot, '', 0)
            h2m-emit(c, OP-BR, 0, chr-id, 0, '', 0)

            h2m-set-block(c, cud-id)
            l6 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-LOAD, l6, islot, 0, '', TY-I64)
            one2 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, one2, 1, 0, '', TY-I64)
            x6 = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-SUB, x6, l6, one2, '', TY-I64)
            h2m-emit(c, OP-STORE, 0, x6, islot, '', 0)
            h2m-emit(c, OP-BR, 0, chr-id, 0, '', 0)

            h2m-set-block(c, cex-id)
        }
    }
}

; 容器遍历降级（s62）：`i <- xs`（xs 限 TY-VEC 形参）
; 镜像 Go lowerRangeFor 的容器分支（src/mir/hir2mir.go:5179-5301），但长度与取下标复用 noc 既有
;   helper（OP-VECLEN / OP-VECGET ⇒ 零改 cg）；五块形制（块 id 递增序即写入序，满足 cg 连续段纪律）：
;   pre  ：当前块——VECLEN 只求一次（镜像 Go 在循环外 Emit(OpLen)）+ 索引 STORE 0 + BR hdr
;   hdr  ：LOAD 索引 → CMPLT(idx, len) → CONDBR(body, exit)
;   body ：VECGET(elem, vec, idx) → STORE 进循环变量同名槽 → 陈述列 → BR upd
;   upd  ：LOAD + ADD 1 + STORE → BR hdr（continue 目标 = upd，与 s60m/s61 同口径）
;   exit ：循环后继语句落此块
; ⚠️ 与 Go 的两处偏差（均就地不产码）：
;   ① Go 对非 map 元素会 bindElemPlace 把循环变量绑到【元素位址】，体内 `v = 9` 写回容器；
;      noc 的 VECGET 交出的是副本 ⇒ 靠 c.epl 在 h2m-var-write 入口计 unsup
;   ② Go 的 KindArray 源用编译期 Sizes[0] 常量做长度；noc 无数组型别登记 ⇒ 只收 vec
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: ForStatement 节点 id（合成索引槽名用它，与前扫描 h2m-scan 共用同一式子）
; src: 容器源节点 id（h2m-coll-check 已验为裸 K-IDENTIFIER）
; body: 循环体 BlockStatement 节点 id
; vn: 循环变量名
h2m-lower-coll = (t ast, c h2m-ctx, sg h2m-sigs, n i64, src i64, body i64, vn str) {
    bad = 0
    sd = ast.nd-at(t, src)
    cnm = ast.str-at(t, sd.s0)
    sv = 0

    ; 容器名必须已有绑定（只有形参会绑上）：查不到 ⇒ vec 局部量／外部名字 ⇒ 不产码
    ;   不直接走 h2m-lower-expr：它在未绑定时已自行计 unsup，会与下面的门禁重计
    ci = h2m-name-find(c, cnm)
    ci < 0 -> bad = 1
    ci >= 0 -> {
        sv = h2m-var-read(c, cnm)
        sv == 0 -> bad = 1

        ; 容器必须是 TY-VEC：str 源要逐码点遍历（Go lowerStrRangeFor，需 utf8_at）、
        ;   定长数组源无运行期长度 op ⇒ 两者一律不产码
        sv > 0 && h2m-vty-at(c, sv) != TY-VEC -> bad = 1
    }

    ; 两颗槽必须由前扫描铺好（循环变量体内要读、索引要跨迭代存活）
    islot = 0
    xslot = 0
    bad == 0 -> {
        islot = h2m-var-find(c, vn)
        xslot = h2m-var-find(c, h2m-idx-name(n))
        islot == 0 || xslot == 0 -> bad = 1
    }

    ; 嵌套同名判据（与 s61 同口径）：活动遍历名栈里已有同名 ⇒ 共用一颗循环变量槽会互相踩，整函数不产码
    q = 0
    (q < c.rnms-n && bad == 0) {
        qn = c.rnms[q]
        qn == vn -> bad = 1

        #{overflow=wrap}
        q = q + 1
    }

    bad != 0 -> h2m-mark(c)
    bad == 0 -> {

        ; pre：长度只求一次（lv 定在当前块，它支配 hdr/body/upd ⇒ SSA 合法）；索引归 0
        lv = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-VECLEN, lv, sv, 0, '', TY-I64)
        z0 = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-CONST, z0, 0, 0, '', TY-I64)
        h2m-emit(c, OP-STORE, 0, z0, xslot, '', 0)
        hdr-id = h2m-block-new(c)
        bdy-id = h2m-block-new(c)
        upd-id = h2m-block-new(c)
        ext-id = h2m-block-new(c)
        h2m-emit(c, OP-BR, 0, hdr-id, 0, '', 0)

        h2m-set-block(c, hdr-id)
        l1 = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-LOAD, l1, xslot, 0, '', TY-I64)
        c1 = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-CMPLT, c1, l1, lv, '', TY-I64)
        h2m-emit(c, OP-CONDBR, ext-id, c1, bdy-id, '', 0)

        h2m-set-block(c, bdy-id)
        e1 = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-VECGET, e1, sv, l1, '', TY-I64)
        h2m-emit(c, OP-STORE, 0, e1, islot, '', 0)

        ; 进体前压三样：循环目标对 (upd, exit)、活动遍历名（嵌套同名门禁）、元素位名（写回门禁）
        c.stk.push(upd-id)
        c.stk.push(ext-id)

        #{overflow=wrap}
        c.stk-n = c.stk-n + 1
        c.rnms.push(vn)

        #{overflow=wrap}
        c.rnms-n = c.rnms-n + 1
        c.epl.push(vn)

        #{overflow=wrap}
        c.epl-n = c.epl-n + 1
        h2m-lower-block(t, c, sg, body)

        ; s65：出栈真刪除——epl 留陳項 ⇒ 下一个兄弟容器遍历里写循环变量的门禁漏闸（静默错码）
        c.epl.pop()
        c.epl-n = c.epl-n - 1
        c.rnms.pop()
        c.rnms-n = c.rnms-n - 1
        c.stk.pop()
        c.stk.pop()
        c.stk-n = c.stk-n - 1
        h2m-emit(c, OP-BR, 0, upd-id, 0, '', 0)

        ; update：索引自增后跳回 header（len == 0 时在 header 首次判定即退出，与 Go 同形）
        h2m-set-block(c, upd-id)
        l2 = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-LOAD, l2, xslot, 0, '', TY-I64)
        one = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-CONST, one, 1, 0, '', TY-I64)
        nx = h2m-alloc(c, TY-I64)
        h2m-emit(c, OP-ADD, nx, l2, one, '', TY-I64)
        h2m-emit(c, OP-STORE, 0, nx, xslot, '', 0)
        h2m-emit(c, OP-BR, 0, hdr-id, 0, '', 0)

        h2m-set-block(c, ext-id)
    }
}

; s65：子树里是否引用了 `it`——兜底臂只在命中时才补主体 LOAD（不命中则 IR 与 s63 同形，零回归）
; 递归走 kid 阵，另下钻 K-SURFACE-MATCH 的 aux 臂区（槽 10/11）；ForStatement 体已是 kid 无需特处理；
; 看不到即不推 ⇒ 臂里真用 `it` 时 var-read 就地计 unsup，方向安全
; t: AST arena
; n: 子树根节点 id
; u: 1 = 子树里引用了 `it`
h2m-subtree-uses-it = (t ast, n i64) (u i64) {
    u = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        d.kind == asp.K-IDENTIFIER -> {
            ast.str-at(t, d.s0) == 'it' -> u = 1
        }
        u == 0 -> {
            i = 0
            (i < d.nkid && u == 0) {
                k = ast.kid-at(t, d.kid0 + i)
                k > 0 -> u = h2m-subtree-uses-it(t, k)

                #{overflow=wrap}
                i = i + 1
            }
            u == 0 && d.kind == asp.K-SURFACE-MATCH -> {
                arms = d.hcount
                j = 0
                (j < arms && u == 0) {
                    hb = d.hbase + 12 * j
                    cn = ast.aux-at(t, hb + 10)
                    bn = ast.aux-at(t, hb + 11)
                    u = h2m-subtree-uses-it(t, cn)
                    u == 0 -> u = h2m-subtree-uses-it(t, bn)

                    #{overflow=wrap}
                    j = j + 1
                }
            }
        }
    }
}

; SurfaceMatch 降级（s58 裸链 + s63 值匹配）：语句位花括号短路链 `{ c1 -> a1  c2 -> a2  -> b }`
;   与带主体的显式链 `x: { 1 -> a1  2 -> a2  -> b }`
; 实测形制（tmp/probe-s58-ast.no、tmp/probe-s63-ast.no，后者钉于 tmp/s63-ast-out.txt）：节点 nkid=1——
;   kid[0] 就是 Matched 主体：裸链为 0（ps.no 占住 Matched 位防 kid 槽别名）、显式 match 为主体节点；
;   s0 = 臂数的字符串、臂群在 helper/aux 区——d.hcount 臂 × 12 aux/臂，
;   槽 0/1/2/3 = binding／bindingVariant／typePattern／typeBinding（解构与型别臂，都是 str 槽）、
;   槽 4 = wildcard（'true' / 0）、槽 5 = dot-val（'ok' 关键字臂）、槽 6 = rawCond（'ok(<expr>)' 臂）、
;   槽 7 = blockBody（'true' / 0）、槽 8 = typeArm、槽 9 = valueCtx、
;   槽 10 = Condition 节点索引（wildcard 臂 = 0）、槽 11 = Body 节点索引
; 块形制（镜像 Go desugarSurfaceMatchToIfExpr 的 if/elif/else 链）：逐臂「当前块求值条件 → CONDBR(臂体块, 下一臂判定块)」，
;   臂体结束一律 BR 回汇聚块；wildcard 臂不发 CONDBR，其体直接落当前块，其后的臂不可达（语言语义即短路）故不再降
; s63 值匹配（主体存在）：Go 权威 desugar 是 `raw-a[i] == 0 -> cond = ps-mk-eq(t, subj-node, pat-a[i])`
;   （ps.no:10372），即每臂比「主体 == 型样」，且主体节点被每臂重复引用 ⇒ noc 侧同样在【本臂判定块内】
;   各读一次主体（块必须是指令序连续段，把某块发的 LOAD 结果拿到别的块用会破支配关系）
; ⚠️ 本件收两形主体：① i64 变量名 + 型样 = 裸整型字面量（s63 值匹配，臂体里 `it` 可读自 s65）；
;   ② option 变量名 + 三态臂 ok(v)/nil/err(e)（s98，tag 比较）。两者外：解构绑定、'ok' 关键字臂（dot-val）、
;   raw-cond `ok(<expr>)`、typePattern／typeArm、非 i64/option 主体（str／vec）、非字面量型样
;   （具名型样、负数前缀式、布尔／字符串字面量）一律走形状门禁 ⇒ 整函数不产码；
;   s98 缺口：err(e) 的 e 暂不可绑（无 TY-ERR 代表型别），体引用 e ⇒ h2m-var-read 查不到 ⇒ unsup（安全）；
;   其余臂体 `it` 读仍走 h2m-var-read（option 主体下 `it` = 整个 %option 值）；写 `it`（`it = ...`）计 unsup。
; ⚠️ 收闸前的行为是【静默错码】不是 unsup：主体被丢、型样字面量当布尔条件 ⇒ `1 -> …` 恒真
;   （实测 tmp/probe-s63-now.no：unsup=0、%c10 = icmp ne i64 1, 0、主体 %v1 从未 load）
; ⚠️ 先跑整链形状前置校验再发指令：cg 要求每块都是指令序的**连续段**且每个被引用的块至少拿到一条终结指令，
;   半路放弃会在 IR 里留下「有跳转无指令」的块 ⇒ opt 报标签未定义，所以不合格就地整函数不产码
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: SurfaceMatch 节点 id
; ⚠️ 兜底臂只认末位：兜底臂吃掉全部余下路径，其后的臂恒不可达；若照发则臂体里的不支持构造
;   会被 stop 静默吞掉（产码 ≠ 产对码），故形状校验直接把 兜底臂不在末位 判成不覆盖面
; s103 值位：`snm` 非空 ⇒ 本链在【表达式位】（`r = { c -> v  -> d }`），臂体交出值而不是陈述：
;   前扫描已按 snm 在 entry 铺好 i64 结果槽，本函数逐臂「降臂值表达式 → STORE 进槽」，
;   汇聚块末再 LOAD 交回 r。门禁比陈述位多两条：① 每臂 aux[hb+9]（valueCtx）必须非零
;   （ps.no 在值语境写 ast.put-str(t,'true')，是非零下标不是 1，故只比非零）；
;   ② 臂体必须是「inline 块包单表达式陈述」（h2m-smv-arm-val），且臂值型别必须是 TY-I64。
;   ⚠️ 无兜底臂且全部不命中时，结果槽读出前扫描铺槽时的零初始化 0——与 Go 权威同口径
;      （Go 同样把结果槽摊在 entry 并零初始化）。
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: SurfaceMatch 节点 id
; snm: 值位结果槽的合成名（'' = 陈述位，不发值）
; r: 交出的值 id（0 = 陈述位或降级失败）
h2m-lower-surface = (t ast, c h2m-ctx, sg h2m-sigs, n i64, snm str) (r i64) {
    d = ast.nd-at(t, n)
    arms = d.hcount
    sname = ''
    vmode = 0
    omode = 0
    vctx = 0
    r = 0
    snm != '' -> vctx = 1
    arms <= 0 -> h2m-mark(c)
    arms > 0 -> {
        bad = 0
        sslot = 0

        ; 主体判定——裸链 kid[0] = 0（占位），显式 match kid[0] = 主体节点
        ;   主体只认【已在槽表登记且槽型 i64 或 option 的裸标识符】：查表在发指令之前完成，校验期不发 LOAD
        ;   i64 主体走 s63 值匹配（vmode）；option 主体走 s98 三态臂匹配（omode）
        subj = h2m-kid-i(t, n, 0)
        subj > 0 -> {
            sd = ast.nd-at(t, subj)
            sd.kind != asp.K-IDENTIFIER || sd.nkid != 0 -> bad = 1
            bad == 0 -> {
                sname = ast.str-at(t, sd.s0)
                si = h2m-name-find(c, sname)
                si < 0 -> bad = 1
                si >= 0 -> {
                    sty = c.tys[si]
                    sty == TY-I64 -> vmode = 1
                    sty == TY-OPT -> omode = 1
                    sty != TY-I64 && sty != TY-OPT -> bad = 1
                }
            }
        }

        ; s103：值位结果槽的槽 id（查表在发指令之前完成，校验期不发指令）
        ;   ⚠️ c.vids[si] 在 mem 模式下就是 entry 那颗 alloca 的 dest id（h2m-slot-decl 绑的），
        ;      不能改用 h2m-var-read——那会在当前块多插一条 LOAD，我们要的是槽本身
        vctx == 1 -> {
            si = h2m-name-find(c, snm)
            si < 0 -> bad = 1
            si >= 0 -> sslot = c.vids[si]
        }

        j = 0
        (j < arms && bad == 0) {

            #{overflow=wrap}
            hb = d.hbase + 12 * j
            cn = ast.aux-at(t, hb + 10)
            bn = ast.aux-at(t, hb + 11)
            wi = ast.aux-at(t, hb + 4)

            ; bvx = 臂 variant 字段的 strs 下标（ok/err/nil 之一，或 0 表示无 variant / 真·兜底）
            ;   ⚠️ 不能用 ast.str-at 读 variant 内容：strs 切片长度在降级早期滞后，
            ;      早读会越界回 ''，晚读才正确；故一律比「原始下标」而非字串內容。
            bvx = ast.aux-at(t, hb + 1)
            bn <= 0 -> bad = 1

            ; 真·兜底臂（catch-all `_`）：无 variant（bvx==0）、无 Condition、wildcard 标记置位。
            ;   仅此一种需「末位」约束；option 三态臂 ok/nil/err 各吃掉一个变体，不是 catch-all。
            ;   ⚠️ hb+4 是 wildcard 字符串字段（'true'/''），parser 对 nil 臂也填非空，
            ;      故不能单凭 wi>0 判 catch-all——必须叠加 bvx==0 才是真兜底。
            is-wild = 0
            wi > 0 && cn <= 0 && bvx == 0 -> is-wild = 1
            is-wild == 1 -> {
                last-j = j + 1
                last-j < arms -> bad = 1
            }

            ; s63 值匹配臂群门禁：除 wildcard 外只认裸整型字面量型样，带任何解构／型别／raw-cond 标记即出局
            vmode == 1 -> {
                ast.aux-at(t, hb + 0) != 0 -> bad = 1
                ast.aux-at(t, hb + 1) != 0 -> bad = 1
                ast.aux-at(t, hb + 2) != 0 -> bad = 1
                ast.aux-at(t, hb + 3) != 0 -> bad = 1
                ast.aux-at(t, hb + 5) != 0 -> bad = 1
                ast.aux-at(t, hb + 6) != 0 -> bad = 1
                ast.aux-at(t, hb + 8) != 0 -> bad = 1
                wi <= 0 -> {
                    pd = ast.nd-at(t, cn)
                    pd.kind != asp.K-INTEGER-LITERAL || pd.nkid != 0 -> bad = 1
                }
            }

            ; s98 option 三态臂门禁：只认 ok(v) / nil / err(e) 三类 variant 标记（bvx 非零），
            ;   型别臂（typePattern/typeBinding/typeArm）与 raw-cond 一律出局（自举未支持）。
            ;   variant 具体是哪一态不在此区分（str-at 早期越界不可靠），由 emit 侧按 tag 降。
            omode == 1 -> {
                ast.aux-at(t, hb + 2) != 0 -> bad = 1
                ast.aux-at(t, hb + 3) != 0 -> bad = 1
                ast.aux-at(t, hb + 6) != 0 -> bad = 1
                ast.aux-at(t, hb + 8) != 0 -> bad = 1

                ; 无 variant（bvx==0）：只能是真·兜底臂（is-wild），否则不合法
                bvx == 0 -> {
                    is-wild == 0 -> bad = 1
                }
            }

            ; s103 值位门禁：valueCtx 必须置位（否则本链其实在陈述位，按值降会读错语境），
            ;   且臂体必须恰好是「inline 块包单表达式陈述」——解不出值表达式即出局
            vctx == 1 -> {
                ast.aux-at(t, hb + 9) == 0 -> bad = 1
                ast.aux-at(t, hb + 9) != 0 -> {
                    ex0 = h2m-smv-arm-val(t, bn)
                    ex0 <= 0 -> bad = 1
                }
            }

            #{overflow=wrap}
            j = j + 1
        }
        bad != 0 -> h2m-mark(c)
        bad == 0 -> {
            merge-id = h2m-block-new(c)
            next-id = c.blk
            j = 0
            stop = 0
            (j < arms && stop == 0) {

                #{overflow=wrap}
                hb = d.hbase + 12 * j
                cn = ast.aux-at(t, hb + 10)
                bn = ast.aux-at(t, hb + 11)
                wi = ast.aux-at(t, hb + 4)
                bvar = ast.str-at(t, ast.aux-at(t, hb + 1))
                wild = 0

                ; 真·兜底臂才走 s65 无判定块路；option 三态臂（ok/nil/err，bvar 非空）必须走 tag 比较
                wi > 0 && cn <= 0 && bvar == '' -> wild = 1
                h2m-set-block(c, next-id)

                #{overflow=wrap}
                last = j + 1
                wild == 1 -> {

                    ; s65：兜底臂无判定块——仅当体子树引用 `it` 时在体首块补一次主体 LOAD 并压栈
                    ;   （判定臂的栈压入复用判定块已有 load，不新增指令）
                    bound = 0
                    (vmode == 1 || omode == 1) && h2m-subtree-uses-it(t, bn) == 1 -> {
                        iv1 = h2m-var-read(c, sname)
                        iv1 <= 0 -> h2m-mark(c)
                        iv1 > 0 -> {
                            bound = 1
                            c.itv.push(iv1)

                            #{overflow=wrap}
                            c.itv-n = c.itv-n + 1
                        }
                    }
                    h2m-smv-body(t, c, sg, bn, vctx, sslot)
                    h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)
                    bound == 1 -> {
                        c.itv.pop()

                        #{overflow=wrap}
                        c.itv-n = c.itv-n - 1
                    }
                    stop = 1
                }
                wild == 0 -> {

                    ; s98：option 主体三态臂降级（ok/nil/err），tag 比较而非整值比较
                    omode == 1 -> {
                        sv = h2m-var-read(c, sname)
                        sv <= 0 -> {
                            stop = 1
                        }
                        sv > 0 -> {

                            ; tag = extractvalue %option, 0
                            tg = h2m-alloc(c, TY-I64)
                            h2m-emit(c, OP-OPTTAG, tg, sv, 0, '', TY-I64)

                            ; 期望 tag：ok=0 / nil=1 / err=2
                            bvar = ast.str-at(t, ast.aux-at(t, hb + 1))
                            et = 1
                            bvar == 'ok' -> et = 0
                            bvar == 'err' -> et = 2
                            ect = h2m-alloc(c, TY-I64)
                            h2m-emit(c, OP-CONST, ect, et, 0, '', TY-I64)
                            eqv = h2m-alloc(c, TY-I64)
                            h2m-emit(c, OP-CMPEQ, eqv, tg, ect, '', TY-I64)
                            cv = eqv
                            cv == 0 -> {
                                stop = 1
                            }
                            cv > 0 -> {
                                arm-id = h2m-block-new(c)
                                ftgt = merge-id
                                last < arms -> ftgt = h2m-block-new(c)
                                h2m-emit(c, OP-CONDBR, ftgt, cv, arm-id, '', 0)
                                h2m-set-block(c, arm-id)

                                ; it = subject option 值（同 i64 路）
                                c.itv.push(sv)

                                #{overflow=wrap}
                                c.itv-n = c.itv-n + 1

                                ; ok(v)：payload 绑定到臂局部名（跨 mem 直返 SSA，出臂 pop 还原）
                                bvar == 'ok' -> {
                                    bidx = ast.aux-at(t, hb + 0)
                                    pv = h2m-alloc(c, TY-I64)
                                    h2m-emit(c, OP-OPTGET, pv, sv, 0, '', TY-I64)
                                    c.alidx.push(bidx)
                                    c.alv.push(pv)
                                }

                                ; err(e)：err 结构暂不可绑（无 TY-ERR），体引用 e → h2m-var-read 查不到 → unsup（安全）
                                h2m-smv-body(t, c, sg, bn, vctx, sslot)
                                h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)
                                bvar == 'ok' -> {
                                    c.alidx.pop()
                                    c.alv.pop()
                                }
                                c.itv.pop()

                                #{overflow=wrap}
                                c.itv-n = c.itv-n - 1
                                next-id = ftgt
                            }
                        }
                    }

                    ; 原有 i64 值匹配（s63）+ 裸链（s58）路
                    omode == 0 -> {
                        pv = h2m-lower-expr(t, c, sg, cn)
                        cv = pv
                        sv = 0
                        vmode == 1 && pv > 0 -> {
                            sv = h2m-var-read(c, sname)
                            sv > 0 -> {
                                eqv = h2m-alloc(c, TY-I64)
                                h2m-emit(c, OP-CMPEQ, eqv, sv, pv, '', TY-I64)
                                cv = eqv
                            }
                            sv <= 0 -> cv = 0
                        }
                        cv == 0 -> {
                            stop = 1
                        }
                        cv > 0 -> {
                            arm-id = h2m-block-new(c)
                            ftgt = merge-id
                            last < arms -> ftgt = h2m-block-new(c)
                            h2m-emit(c, OP-CONDBR, ftgt, cv, arm-id, '', 0)
                            h2m-set-block(c, arm-id)

                            ; s65：本臂绑定值 = 判定块刚 LOAD 的主体值（判定块支配臂块）⇒ 压入后臂体里的 `it` 可读
                            ab = 0
                            sv > 0 -> {
                                ab = 1
                                c.itv.push(sv)

                                #{overflow=wrap}
                                c.itv-n = c.itv-n + 1
                            }
                            h2m-smv-body(t, c, sg, bn, vctx, sslot)
                            h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)
                            ab == 1 -> {
                                c.itv.pop()

                                #{overflow=wrap}
                                c.itv-n = c.itv-n - 1
                            }
                            next-id = ftgt
                        }
                    }
                }

                #{overflow=wrap}
                j = j + 1
            }
            h2m-set-block(c, merge-id)

            ; s103：值位——汇聚块从结果槽 LOAD 出整链的值交回呼叫方（h2m-lower-let 再写进目标变量）
            vctx == 1 -> {
                lv = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-LOAD, lv, sslot, 0, '', TY-I64)
                r = lv
            }
        }
    }
}

; ── 块终结形（s59）：return / break / continue ───────────────────
; 三种节点均要**作为本块最后一条陈述**才可降级（呼叫方把关 last）：其后陈述不可达，
;   若照降则臂体里的不支持构造会被静默吞掉（产码 ≠ 产对码），同 s58「兜底不在末位」纪律。
; 形制（实测 tmp/probe-s59-ast.no，钉于 tmp/s59-ast-out.txt）：
;   K-RETURN-STATEMENT(56)：nkid=1 且 kid[0]=0（guarded ReturnValue 缺席占位），无标量槽
;   K-BREAK-STATEMENT(16) / K-CONTINUE-STATEMENT(22)：nkid=0，s0=label（空串）、s1=kind 名（'none'）
;   ⚠️ s1 是【字串槽】不是整数槽：kv P-ALWAYS 政策下未显式设值会渲染成 kind 名默认——
;     ps.no 存 'none' 表示无标签；非 'none'（text/numeric）是带标签跳出形，不在覆盖面
; return 块形制：懒开一个全函数共享的 ret 块，终结处只发 BR；真正的 LOAD+RET
;   由 h2m-lower-func 收尾时在该块发出——输出参的 entry 零初始化已替我们落地
;   Go 侧「延迟零值」语义（return 前未赋值 ⇒ 读槽得 0），无需逐 return 点插 CONST。
; break/continue 目标：查循环栈栈顶的 (hdr, exit) 对；栈空 ⇒ 循环外跳出，计 unsup。
;   本件限最内层循环、无标签形；Go 侧 label 解析（break # N）不在覆盖面。
; 终结后的 BR 落入「有跳转无后续」的死区段：同块内不再发指令（last 门禁保证），
;   若呼叫方（if/链）随后在同一区域补发汇聚 BR，多出的不可达终结指令由 LLVM 接受（单测钉 IR 形）
; t: AST arena
; c: 上下文
; n: 终结形节点 id
; k: 节点 kind（RETURN/BREAK/CONTINUE）
h2m-lower-term = (t ast, c h2m-ctx, n i64, k i64) {
    d = ast.nd-at(t, n)
    ok-t = 1

    ; 带值 return（kid[0] 非 0）不在覆盖面：语料中恒裸（Go 对 `return <val>` 直接报错）
    k == asp.K-RETURN-STATEMENT && d.nkid > 0 -> {
        vk = h2m-kid-i(t, n, 0)
        vk != 0 -> ok-t = 0
    }

    ; 带标签的 break/continue：kind 名非 'none' 即不在覆盖面
    k == asp.K-BREAK-STATEMENT || k == asp.K-CONTINUE-STATEMENT -> {
        kl = ast.str-at(t, d.s1)
        kl != 'none' -> ok-t = 0
    }
    ok-t == 0 -> h2m-mark(c)
    ok-t == 1 -> {
        tgt = 0
        k == asp.K-RETURN-STATEMENT -> {
            c.ret <= 0 -> {
                rid-blk = h2m-block-new(c)
                c.ret = rid-blk
            }
            tgt = c.ret
        }
        k == asp.K-BREAK-STATEMENT -> {
            p = c.stk-n

            #{overflow=wrap}
            p = p - 1
            p < 0 -> h2m-mark(c)
            p >= 0 -> {
                pk = 2 * p + 1
                tgt = c.stk[pk]
                h2m-emit(c, OP-BR, 0, tgt, 0, '', 0)
            }
        }
        k == asp.K-CONTINUE-STATEMENT -> {
            p = c.stk-n

            #{overflow=wrap}
            p = p - 1
            p < 0 -> h2m-mark(c)
            p >= 0 -> {
                pk = 2 * p
                tgt = c.stk[pk]
                h2m-emit(c, OP-BR, 0, tgt, 0, '', 0)
            }
        }
        k == asp.K-RETURN-STATEMENT && tgt > 0 -> h2m-emit(c, OP-BR, 0, tgt, 0, '', 0)
    }
}

; 块陈述列里的终结形分派（s59）：kind 命中则按「是否本块末条」把关后降级
; t: AST arena
; c: 上下文
; sg: 模块级签名表（仅为呼叫形参统一，终结形自身无表达式子树）
; kid: 陈述节点 id
; last: 1 = 本块最后一条陈述
; hd: 1 = 已分派（呼叫方据此不再计 unsup）
h2m-lower-term-stmt = (t ast, c h2m-ctx, sg h2m-sigs, kid i64, last i64) (hd i64) {
    hd = 0
    kk = ast.nd-at(t, kid)
    k = kk.kind
    k == asp.K-RETURN-STATEMENT || k == asp.K-BREAK-STATEMENT || k == asp.K-CONTINUE-STATEMENT -> {
        hd = 1
        last == 0 -> h2m-mark(c)
        last == 1 -> h2m-lower-term(t, c, kid, k)
    }
}

; 单个 K-PARAMETER 节点 → 型别码（实测 kid 序 = [Type, DefaultExpr]）
; 非具名型别（除 []i64）/ 未知型别名 ⇒ bad = 1
; s92：带默认值不再不入形——de 交默认值表达式节点 id，由调用点降级后回填 argv
;   （镜像 Go hir2mir.go:13175-13207 尾部回填；旧门禁「默认值会让 arity 判定失效」是无回填通路时的保守判断）
; s62：[]i64（K-SLICE-TYPE）入形→ TY-VEC；【非】具名型别的其它形（map / *t / 别名／元素非 i64 的 vec）仍不入
; t: AST arena
; p: 参数节点 id
; code: 型别码（-1 = 不在覆盖面）
; bad: 形状不合格标记
; de: 默认值表达式 AST 节点 id（0 = 无默认值）
h2m-param-ty = (t ast, agg h2m-ctx, p i64) (code i64, bad i64, de i64) {
    bad = 1
    code = -1
    de = 0
    pd = ast.nd-at(t, p)
    tk = ast.kid-at(t, pd.kid0)
    tk > 0 -> {
        td = ast.nd-at(t, tk)

        ; s94：具名型别与 ?u64 同走 h2m-tynode-code 共用判据（旧 K-NAMED-TYPE 单臂上提进 helper）
        td.kind == asp.K-NAMED-TYPE || td.kind == asp.K-NULLABLE-TYPE -> {
            code = h2m-tynode-code(t, agg, tk)
            code >= 0 -> bad = 0
        }

        ; 实测形制（tmp/s62-ast-out.txt）：K-SLICE-TYPE(60) nkid=1、s0='false'（是否多字节元），
        ;   其 kid[0] = 元素型别节点——只收 i64 元（@vec_get_i64 是单型 helper）
        td.kind == asp.K-SLICE-TYPE && td.nkid == 1 -> {
            ek = h2m-kid-i(t, tk, 0)
            ek > 0 -> {
                ed = ast.nd-at(t, ek)
                ed.kind == asp.K-NAMED-TYPE -> {
                    enm = ast.str-at(t, ed.s0)
                    enm == 'i64' -> {
                        code = TY-VEC
                        bad = 0
                    }
                }
            }
        }
    }
    dp = pd.kid0

    #{overflow=wrap}
    dp = dp + 1
    dv = ast.kid-at(t, dp)
    dv != 0 -> de = dv
}

; 读取函数定义节点的签名：名字 / 返回型别码 / 输入型别表 / 默认值表 / 形状门禁
; kid 区序 = [泛型…][输入…][输出…][body]（实测：nkid == c3 + c4 + c5 + 1）
; bad = 1 表示不在本件覆盖面（泛型、多输出、非具名型别、带默认值的输出参、未知型别名）；
;   这里不计 unsup，由呼叫方计——前置 pass 与产码 pass 共用一份判据
; s92：带默认值的【输入】参入形，deft 与 argt 平行交默认值表达式节点 id，调用点回填
; t: AST arena
; n: 函数定义节点 id
; name: 函数名
; ret: 返回型别码（无输出参数时按 TY-I64）
; argt: 输入型别表（顺序即 LLVM 形参序）
; deft: 默认值表达式节点表（与 argt 平行，0 = 无默认值；s92）
; bad: 形状不合格标记
h2m-func-sig = (t ast, agg h2m-ctx, n i64) (name str, ret i64, argt []i64, deft []i64, bad i64) {
    bad = 0
    ret = TY-I64
    d = ast.nd-at(t, n)
    name = ast.str-at(t, d.s0)
    d.c3 > 0 -> bad = 1
    d.c5 > 1 -> bad = 1
    i = 0
    (i < d.c4 && bad == 0) {
        p = d.kid0

        #{overflow=wrap}
        p = p + d.c3

        #{overflow=wrap}
        p = p + i
        pk = ast.kid-at(t, p)
        pc, pb, pde = h2m-param-ty(t, agg, pk)
        pb != 0 -> bad = 1
        pb == 0 -> argt.push(pc)
        pb == 0 -> deft.push(pde)

        #{overflow=wrap}
        i = i + 1
    }
    bad == 0 && d.c5 == 1 -> {
        rp = d.kid0

        #{overflow=wrap}
        rp = rp + d.c3

        #{overflow=wrap}
        rp = rp + d.c4
        rk = ast.kid-at(t, rp)
        rc, rb, rde = h2m-param-ty(t, agg, rk)
        rb != 0 -> bad = 1

        ; s92：输出参带默认值不入形——Go 回填循环只遍输入参（hir2mir.go:13176 paramNodes），
        ;   且自举未建模输出绑定的调用形制，宁缺勿错
        rb == 0 && rde != 0 -> bad = 1

        ; s62：[]i64 作为【输入】形参已入形，但 vec 返回不入形——noc 侧无产出 vec 值的途径
        ;   （无 %vec 槽、无 vec 字面量降级），且 OP-RET/CALL 的 %vec 返回从未经端到端验证，宁缺勿错
        rb == 0 && rc == TY-VEC -> bad = 1
        rb == 0 && rc != TY-VEC -> ret = rc
    }
}

; FunctionDefinition 降级为一段函数 IR 文本
; agg: 模块级计数器上下文（本件内部的指令 arena 是私有的，只把 unsup 增量并入 agg）
; t: AST arena
; sg: 模块级签名表（体内调用点查表用）
; n: 函数定义节点 id
; r: 函数 IR 文本（'' = 形状不支持，未产码）
;
; s59 收尾契约：若体内出现过 return（c.ret > 0），尾部先 BR 到共享 ret 块，
;   再切过去发 LOAD+RET（读输出参槽——entry 零铺槽即「延迟零值」）；
;   无 return 的函数走原路（终结指令落当前块），IR 逐字节不变
h2m-lower-func = (t ast, agg h2m-ctx, sg h2m-sigs, n i64) (r str) {
    r = ''
    c = h2m-new()

    ; s99：模块级结构体表从 agg 浅拷进函数 ctx（只增不写，函数体只读）。MK/GET/SET 降级时按名字查 id 与字段
    c.stn = agg.stn
    c.stid = agg.stid
    c.stfc = agg.stfc
    c.stft = agg.stft
    c.stfldn = agg.stfldn
    c.stftn = agg.stftn
    d = ast.nd-at(t, n)
    fnm, frt, fap, fdp, fb = h2m-func-sig(t, agg, n)
    fb != 0 -> {
        h2m-mark(c)
    }
    fb == 0 -> {

        ; 形参：值 id 按 LLVM 形参序单调分配（h2m-new 起 nid = 1 ⇒ 恰为 1..nargs），
        ;   并把名字绑上；型别同时进 vty（发射侧按它选 %v / %sv 命名空间）
        ;   loc 同步播种形参（前扫描要拿它推标识符型别，也要拿它当「哪些名字是 incoming」）
        loc = h2m-lst-new()
        q = 0
        (q < fap.len()) {
            p = d.kid0

            #{overflow=wrap}
            p = p + d.c3

            #{overflow=wrap}
            p = p + q
            pk = ast.kid-at(t, p)
            pd = ast.nd-at(t, pk)
            pnm = ast.str-at(t, pd.s0)
            pt = fap[q]: {
                ok -> it

                -> _
            }
            vid = h2m-alloc(c, pt)
            h2m-var-bind(c, pnm, vid)
            h2m-lst-add(loc, pnm, pt)

            #{overflow=wrap}
            q = q + 1
        }

        ; body 是最后一个 kid
        bp = d.kid0
        bc = d.nkid

        #{overflow=wrap}
        bc = bc - 1

        #{overflow=wrap}
        bp = bp + bc
        body = ast.kid-at(t, bp)

        ; ⚠️ 槽必须在 body 之前铺完（entry 块的连续段纪律）⇒ 先前扫描定「有无控制流 + 局部量表」
        flow = 0
        bc >= 0 -> flow = h2m-scan(t, sg, loc, agg, body)
        flow > 0 -> c.mem = 1

        ; s97：option 输出参的槽必须按【声明型 TY-OPT】铺（nil-init），但 h2m-scan 把体内 `r = <payload>`
        ;   当 LetStatement 登记 ⇒ 槽型被按 RHS 推成整/f64（正是 some(0) 错形之源）。故 mem==1 且回值型为
        ;   option 时，铺槽前按声明覆写该名为 TY-OPT（h2m-lst-add 的 i>=0 分支就地改型、位次不变，仍排在形参后）
        c.mem == 1 && frt == TY-OPT && d.c5 == 1 -> {
            oop = d.kid0

            #{overflow=wrap}
            oop = oop + d.c3

            #{overflow=wrap}
            oop = oop + d.c4
            ook = ast.kid-at(t, oop)
            ood = ast.nd-at(t, ook)
            oonm = ast.str-at(t, ood.s0)
            h2m-lst-add(loc, oonm, TY-OPT)
        }

        c.mem == 1 -> {
            m = 0
            (m < loc.lname.len()) {
                lnm = loc.lname[m]
                lty = loc.lty[m]
                h2m-slot-decl(c, lnm, lty)

                ; 前 m 项是形参（loc 先被形参播种）⇒ 另需把 incoming 值存进槽，不然 callee 读不到实参
                m < fap.len() -> {
                    avid = 0

                    #{overflow=wrap}
                    avid = m + 1
                    h2m-slot-init-arg(c, lnm, avid, lty)
                }

                #{overflow=wrap}
                m = m + 1
            }
        }
        bc < 0 -> {
            h2m-mark(c)
        }

        ; s99k：提前算出输出变量名，供 body 降级时 h2m-var-write 识别「写入输出槽」并记录 outsv
        ;   （out-name 原在 body 之后才求，但 h2m-var-write 在 body 降级期就会用到，故此处先定）
        d.c5 == 1 -> {
            op2 = d.kid0

            #{overflow=wrap}
            op2 = op2 + d.c3

            #{overflow=wrap}
            op2 = op2 + d.c4
            ok2 = ast.kid-at(t, op2)
            od2 = ast.nd-at(t, ok2)
            c.outn = ast.str-at(t, od2.s0)
        }
        bc >= 0 -> h2m-lower-block(t, c, sg, body)

        ; 恰一个输出参数时：它绑定的值 id 即返回值
        rid = 0
        d.c5 == 1 -> {
            rp = d.kid0

            #{overflow=wrap}
            rp = rp + d.c3

            #{overflow=wrap}
            rp = rp + d.c4
            pk = ast.kid-at(t, rp)
            pd = ast.nd-at(t, pk)
            out-name = ast.str-at(t, pd.s0)

            ; mem 模式要在这里发 LOAD（槽在 entry、本块可达）；直线式仍直接拿绑定的值 id
            oi = h2m-name-find(c, out-name)
            oi >= 0 -> rid = h2m-var-read(c, out-name)
        }

        ; 输出参数未被赋值：Go 侧靠「延迟零值」补零；本件对 i64 发 CONST 0、对 option 发 OPTNONE（s94，
        ;   §3.11 延迟零值 option→nil = tag=1，非 zeroinitializer 的 tag=0），其余计 unsup
        ; s97：mem==1 + option 输出参已入形（TY-OPT 槽 nil-init + 写点 some-wrap），撤除 s94 整函数门禁；
        ;   未写路径经 OPTALLOC 的 tag=1 初始化读出 nil（合 Go 延迟零值），条件写经 h2m-var-write 写点包裹
        rid == 0 && frt == TY-I64 -> {
            zid = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, zid, 0, 0, '', TY-I64)
            rid = zid
        }
        rid == 0 && frt == TY-OPT -> {
            zoid = h2m-alloc(c, TY-OPT)
            h2m-emit(c, OP-OPTNONE, zoid, 0, 0, '', TY-OPT)
            rid = zoid
        }
        rid == 0 && frt != TY-I64 && frt != TY-OPT -> h2m-mark(c)

        ; s94：隐式 ok(v) 包裹——镜像 Go wrapOptionIfNeeded（hir2mir.go:14893）：非 option 右值赋给
        ;   ?T 输出参 ⇒ 建成 {tag=0, payload=v}（OP-OPTSOME 发 insertvalue slot[0]），绝不把裸标量
        ;   直当 %option 返回（会把 tag 读成载荷位，some 退化成 nil/err，同 Go 注释里的事故形）。
        ;   載荷只收 64 位宽（TY-I64/TY-U64 共用 %v 命名空间→OP-OPTSOME；TY-F64 住 %fd→OP-OPTMKF64
        ;   bitcast double→i64，s96）；str/vec 載荷不包（卡 M4-d RC/ptrtoint）——落到下面 ty-match
        ;   门禁 ⇒ 计 unsup，宁缺勿错
        ; s94/s96/s97：回值位隐式 some 包裹改由 h2m-opt-wrap 单点承载（与写点共用同一判据，§11 B7 同口径）；
        ;   mem==0 时 rid 为裸載荷⇒包裹；mem==1 时 rid 已是 OPTLOAD 交出的 %option⇒原样返回（不误再包）
        frt == TY-OPT && rid > 0 -> rid = h2m-opt-wrap(c, rid)

        ; 返回值型别必须与输出参数的声明相符：`s = a`（a 为 i64、s 声明为 str）会
        ;   让 cg 发 `ret %str-long %v…`——LLVM 验不过但降级不报错，故在此拦截
        ty-match = 1
        rid > 0 -> {
            h2m-vty-at(c, rid) != frt -> ty-match = 0
        }
        ty-match == 0 -> h2m-mark(c)

        ; s59：共享 ret 块的收尾——末尾块（可能是 exit/merge）BR 过去，再在 ret 块读槽并 RET；
        ;   无 ret 块时原路不动（ty-match 已过 ⇒ rid 必 > 0，发终结 RET）
        ret-ok = rid > 0 && ty-match == 1
        ret-ok && c.ret > 0 -> {
            h2m-emit(c, OP-BR, 0, c.ret, 0, '', 0)
            h2m-set-block(c, c.ret)
            zc2 = 0
            d.c5 == 1 -> {
                oi2 = h2m-name-find(c, out-name)
                oi2 >= 0 -> zc2 = h2m-var-read(c, out-name)
            }
            d.c5 == 0 -> {
                zc2 = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CONST, zc2, 0, 0, '', TY-I64)
            }
            ret-ok = zc2 > 0
            ret-ok -> {

                ; s99j：scope-exit 释放（跳過回傳值 id 防雙重釋放；僅 mem==0 放行，見 h2m-emit-releases）
                h2m-emit-releases(c, zc2)
                h2m-emit(c, OP-RET, 0, zc2, 0, '', frt)
                r = cg.cg-emit-cfg-t(fnm, frt, fap.len(), fap, c.vty, c.cty, c.blks, c.ops, c.dsts, c.xa, c.bs, c.syms, c.args)
            }
            zc2 == 0 -> h2m-mark(c)
        }
        ret-ok && c.ret <= 0 -> {

            ; s99j：scope-exit 释放（直落路徑同款；跳過回傳值 id）
            h2m-emit-releases(c, rid)
            h2m-emit(c, OP-RET, 0, rid, 0, '', frt)
            r = cg.cg-emit-cfg-t(fnm, frt, fap.len(), fap, c.vty, c.cty, c.blks, c.ops, c.dsts, c.xa, c.bs, c.syms, c.args)
        }
    }

    ; 本函数体内有任何不支持构造 ⇒ 整函数不产码（宁缺勿错），并把计数并入模块级
    inc = c.unsup

    #{overflow=wrap}
    agg.unsup = agg.unsup + inc
    inc > 0 -> r = ''
}

; 整个 Program 降级：先扫一遍签名表（调用可前向引用），再逐函数产码并拼接
; 非函数定义、以及签名不合格的函数均计入 unsup（只在产码 pass 计，避免双计）
; t: AST arena
; agg: 模块级计数器上下文（呼叫方以 agg.unsup == 0 判定产码可信）
; root: Program 节点 id
; r: 模块函数文本（不含 prelude / main）
h2m-lower-program = (t ast, agg h2m-ctx, root i64) (r str) {
    r = ''
    sg = h2m-sigs-new()
    d = ast.nd-at(t, root)

    ; s99b：前置 pass 拆两段——①先登记全部结构体定义（定义序即 id 序、字段表拼接），
    ;   ②再登记合格函数签名。这样函数签名里的 Point 等结构体型别名，无论「函数先于结构体定义」
    ;   与否，解析时结构体表都已就绪（struct 名 → TY-STRUCT-BASE + sid 由 h2m-tynode-code 回退查表）
    i = 0
    (i < d.nkid) {
        p = d.kid0

        #{overflow=wrap}
        p = p + i
        kid = ast.kid-at(t, p)
        kk = ast.nd-at(t, kid)
        kk.kind == asp.K-STRUCT-DEFINITION -> h2m-struct-register(agg, t, kid)

        #{overflow=wrap}
        i = i + 1
    }

    ; 前置 pass ①b：全部结构体名就位后，解析字段型别码（支持嵌套结构体字段、定义序无关）
    h2m-struct-resolve(agg, t)

    ; 前置 pass ②：登记合格函数签名（调用可前向引用；此时结构体表已全就绪）
    i = 0
    (i < d.nkid) {
        p = d.kid0

        #{overflow=wrap}
        p = p + i
        kid = ast.kid-at(t, p)
        kk = ast.nd-at(t, kid)
        kk.kind == asp.K-FUNCTION-DEFINITION -> {
            nm, rt, ap, dp, bd = h2m-func-sig(t, agg, kid)
            bd == 0 -> h2m-sig-add(sg, nm, nm, rt, ap, dp)
        }

        #{overflow=wrap}
        i = i + 1
    }

    ; 产码 pass：逐个函数降级
    j = 0
    (j < d.nkid) {
        p = d.kid0

        #{overflow=wrap}
        p = p + j
        kid = ast.kid-at(t, p)
        kk = ast.nd-at(t, kid)
        kk.kind == asp.K-FUNCTION-DEFINITION -> {
            nm2, rt2, ap2, dp2, bd2 = h2m-func-sig(t, agg, kid)
            bd2 != 0 -> {
                h2m-mark(agg)
            }
            bd2 == 0 -> {
                one = h2m-lower-func(t, agg, sg, kid)
                one != '' -> {
                    r = r - one - '\n'
                }
            }
        }

        ; s99：结构体定义不是函数、也不是不支持构造——前扫描已登记，此处跳过（不计入 unsup）
        kk.kind != asp.K-FUNCTION-DEFINITION && kk.kind != asp.K-STRUCT-DEFINITION -> {
            h2m-mark(agg)
        }

        #{overflow=wrap}
        j = j + 1
    }

    ; s99：模块级结构体型别声明（§11 B10 唯一装配点）——按 id 升序一次性发全部，前置于函数文本；
    ;   多结构体模块若分散各函数发会报 "redefinition of type named"，故必须于此集中、且只此一处。
    decls = h2m-struct-decls(agg)
    decls.len() > 0 -> {
        r = decls - '\n' - r
    }
}

; ═══════════════════════════════════════════════════════════════════
; M4-d（2026-11-12，§11 後 ⑧）：模块级降级入口——合成 @main
; ═══════════════════════════════════════════════════════════════════
; Go 後端把 `main` 保留為關鍵字（實測 `'main' is a reserved name ... [xgs17cqx]`），
;   entry 由**頂層陳述**自動合成。既有 h2m-lower-program 只認 FunctionDefinition /
;   StructDefinition，任何頂層陳述一律計 unsup ⇒ 無法直接給 drv.cmd-build 用。
; 本件做一次「AST 手術」，把原 Program 改寫成一棵**只含定義**的合成 Program：
;   ① 頂層 FunctionDefinition / StructDefinition 原樣搬過去（簽名表／結構體表照舊）；
;   ② 其餘頂層陳述收進一個合成 `K-BLOCK-STATEMENT`；
;   ③ 末位 `exit(E)`（述層 ExpressionStatement → CallExpression{fn:exit, args:1}）
;      改寫成合成函式的輸出參綁定：`__noc_r = E`。無 exit ⇒ 合成整數字面量 0，
;      對齊 Go 合成 main 的「自然終了回 0」；
;   ④ 合成 `main = () (__noc_r i64) { <頂層陳述…>; __noc_r = E }`，
;      h2m-lower-func 會發出 `define i64 @main()`；LLVM 允許 i64 @main，
;      C runtime 取低 32 位元當行程結束碼（實測 clang + 執行 exit=42）。
; ⚠️ 與 h2m-lower-program 的界線：本件**不改**既有函式，舊呼叫點（s62 探針、
;    h2m-test 等）逐字節不變；新入口只由 drv.build-ll 消費。
; ⚠️ ast.add 會把 kid0 凍結在「當下的 kids.len()」⇒ 每個合成節點建立後必須
;    **立刻**加完 kids 才建立下一個節點，否則 kid 段會互相覆蓋（探針實釘）。
; ⚠️ 誠實門禁：頂層內建模組導入／`print` 等非簽名表呼叫、跨函式讀頂層 let
;    全局，仍由既有 h2m 路徑計 unsup，呼叫方以 agg.unsup > 0 直接失敗，不靜默產碼。
; ═══ s102：字面量插值（`print('a={x}')`）═══════════════════════════════════
; 权威侧的判定在 Go hir2mir.go formatSegmentsOf：字面量必须
;   ① parser.ParseFormatString 解析成功，**且** ② 至少有一个 Field，
; 才走「命名格式」降级；否则整串**原样输出**（连 {{ / }} 都不反转义——
; 实测 `print('a{{b')` 印 `a{{b`，`print('a{b')` 印 `a{b`）。
; 字段渲染在 std/fmt.no 的 fmt-int / fmt-str 族（spec 解析 + 宽度/对齐/千分位）。
;
; 自举没有 fmt 线，故按「能否逐字节复现」分三档：
;   · 无 spec 的 `{ident}` ⇒ 直接按型别发 OP-PRINT（i64/u64 → print_i64、
;     str → print_str）。**这与权威逐字节同结果**：fmt-int(n, '') 的正文就是
;     n.to-str()（fmt.no 的 `full = n.to-str()`，width=0/grouping=0 时不改写），
;     而 print_i64 印的也是同一串十进制。
;   · `{ident:spec}` ⇒ 计 unsup（宽度/对齐/进制/千分位无法用 print_i64 复现）。
;   · 表达式字段 `{a[i] & 255}` ⇒ 计 unsup（权威侧要求值，本件只认裸标识符）。
;   · 含 `{{` / `}}` 转义 ⇒ 计 unsup（本件不反转义，原样印会错码）。

; s102：i + 1（索引运算的溢出在本文件不可能发生，回绕即可）
; i: 下标
; r: i + 1
h2m-inc = (i i64) (r i64) {

    #{overflow=wrap}
    r = i + 1
}

; s102：取 s[i] 的字节值；越界回 -1（哨兵；合法字节值域是 0..255）
; s: 来源字串
; i: 下标（字节）
; b: 字节值；-1 = 越界
h2m-byte-at = (s str, i i64) (b i64) {
    b = -1
    i >= 0 && i < s.len-bytes() -> {
        bo = s.byte(i)
        bo: {
            ok(bv) -> b = bv

            -> _
        }
    }
}

; s102：找 s 中 from 起第一个 '}' 的下标；无则 -1
; s: 来源字串
; from: 起始下标
; e: '}' 下标；-1 = 没有
h2m-fmt-find-close = (s str, from i64) (e i64) {
    e = -1
    n = s.len-bytes()
    i = from
    (i < n && e < 0) {
        b = h2m-byte-at(s, i)
        b == 125 -> e = i
        b != 125 -> i = h2m-inc(i)
    }
}

; s102：在花括号内文 [a, e) 里找规格分隔符 ':' 的下标；无则 -1
; s: 来源字串
; a: '{' 之后的下标
; e: 配对 '}' 的下标
; col: ':' 下标；-1 = 无规格
h2m-fmt-colon = (s str, a i64, e i64) (col i64) {
    col = -1
    i = a
    (i < e && col < 0) {
        b = h2m-byte-at(s, i)
        b == 58 -> col = i
        b != 58 -> i = h2m-inc(i)
    }
}

; s102：判定 `{...}` 内部属于哪一类
; s: 来源字串
; a: '{' 之后的下标
; e: 配对 '}' 的下标
; r: 0 = 空字段（权威侧不产生 Field ⇒ 整串原样）；1 = 裸标识符（可带 spec，由调用方另判）；
;    2 = 其它（表达式字段等，必须计 unsup）
h2m-fmt-field-class = (s str, a i64, e i64) (r i64) {
    r = 2
    e <= a -> r = 0
    e > a -> {
        col = h2m-fmt-colon(s, a, e)
        ne = e
        col >= 0 -> ne = col

        ; 名字必须是裸标识符：首字符 ∈ {_ A-Z a-z -}，其余再加 0-9
        ok-id = 1
        ne <= a -> ok-id = 0
        i = a
        (i < ne && ok-id == 1) {
            b = h2m-byte-at(s, i)
            ok-c = 0
            b == 95 -> ok-c = 1
            b == 45 -> ok-c = 1
            b >= 65 && b <= 90 -> ok-c = 1
            b >= 97 && b <= 122 -> ok-c = 1
            i > a && b >= 48 && b <= 57 -> ok-c = 1
            ok-c == 0 -> ok-id = 0
            i = h2m-inc(i)
        }
        ok-id == 1 -> r = 1
    }
}

; s102：判定一个字面量是否是「可降级的命名格式串」
; s: 字面量内文
; r: 0 = 没有任何替换字段 ⇒ 原样印出；1 = 有字段且全为裸标识符形 ⇒ 可降级；
;    2 = 有字段但形制超出本件能力 ⇒ 必须计 unsup
h2m-fmt-class = (s str) (r i64) {
    r = 0
    n = s.len-bytes()
    i = 0
    (i < n) {
        b = h2m-byte-at(s, i)
        b == 123 -> {
            nx = h2m-byte-at(s, h2m-inc(i))
            nx == 123 -> {
                r = 2
                i = h2m-inc(h2m-inc(i))
            }
            nx != 123 -> {
                e = h2m-fmt-find-close(s, h2m-inc(i))
                e < 0 -> i = h2m-inc(i)
                e >= 0 -> {
                    fc = h2m-fmt-field-class(s, h2m-inc(i), e)
                    fc == 1 -> {
                        r == 0 -> r = 1
                    }
                    fc == 2 -> r = 2
                    i = h2m-inc(e)
                }
            }
        }
        b == 125 -> {
            nx = h2m-byte-at(s, h2m-inc(i))
            nx == 125 -> {
                r = 2
                i = h2m-inc(h2m-inc(i))
            }
            nx != 125 -> i = h2m-inc(i)
        }
        b != 123 && b != 125 -> i = h2m-inc(i)
    }
}

; s102：把一段字面文字原样写到 print/eprint 流（OP-PRINT kind base+1）
; c: 上下文
; lit: 要写的文字（空段不发，省一条 @print_str）
; base: 0 = stdout，4 = stderr
h2m-print-lit = (c h2m-ctx, lit str, base i64) {
    lit.len-bytes() > 0 -> {
        cid = h2m-alloc(c, TY-STR)
        h2m-emit(c, OP-STRCONST, cid, 0, 0, lit, TY-STR)
        h2m-emit(c, OP-PRINT, 0, cid, base + 1, '', 0)
    }
}

; s102：把一个 `{name}` 字段发成对应型别的 print
; c: 上下文
; name: 字段名（裸标识符）
; base: 0 = stdout，4 = stderr
; r: 1 = 已发；0 = 不支持（已 mark，或 h2m-var-read 已 mark）
h2m-print-field = (c h2m-ctx, name str, base i64) (r i64) {
    r = 0
    v = h2m-var-read(c, name)
    v > 0 -> {
        ty = h2m-vty-at(c, v)
        ty == TY-I64 || ty == TY-U64 -> {
            h2m-emit(c, OP-PRINT, 0, v, base, '', 0)
            r = 1
        }
        ty == TY-STR -> {
            h2m-emit(c, OP-PRINT, 0, v, base + 1, '', 0)
            r = 1
        }
        ty != TY-I64 && ty != TY-U64 && ty != TY-STR -> h2m-mark(c)
    }
}

; s102：按 class == 1 的字面量逐段发出 print
; t: AST arena
; c: 上下文
; s: 字面量内文
; base: 0 = stdout，4 = stderr
; r: 1 = 全部发出；0 = 有不支持段（已 mark）
h2m-fmt-emit = (t ast, c h2m-ctx, s str, base i64) (r i64) {
    r = 1
    n = s.len-bytes()
    i = 0
    seg = 0
    (i < n && r == 1) {
        b = h2m-byte-at(s, i)
        b == 123 -> {
            e = h2m-fmt-find-close(s, h2m-inc(i))
            e < 0 -> {

                ; class == 1 保证每个 '{' 都有配对 '}'，此臂不可达；保守计错
                r = 0
                i = n
            }
            e >= 0 -> {

                ; 先把 '{' 之前的字面段写出
                i > seg -> h2m-print-lit(c, s.slice-bytes(seg, i), base)
                col = h2m-fmt-colon(s, h2m-inc(i), e)
                ne = e
                col >= 0 -> ne = col

                ; spec 存在 ⇒ 宽度/对齐/进制/千分位无法复现 ⇒ 计 unsup（先判再发）
                col >= 0 -> r = 0
                r == 1 -> {
                    nm = s.slice-bytes(h2m-inc(i), ne)
                    r = h2m-print-field(c, nm, base)
                }
                i = h2m-inc(e)
                seg = i
            }
        }
        b != 123 -> i = h2m-inc(i)
    }
    r == 1 && seg < n -> h2m-print-lit(c, s.slice-bytes(seg, n), base)
}

; s100：print / eprint 内建降级（自举无 builtin 签名表 ⇒ 在 h2m 单点认领）。
;   语义对齐 Go emitPrint：实参逐个输出、**相邻之间**一个空格、末尾一个换行
;   （print(a, b) ⇒ "a b\n"；print() ⇒ "\n"）。eprint 同形但走 fd 2。
;   ⚠️ 只收 i64 / u64（共用 i64 宽）与 str 两种值型别；f64 / char / vec / option /
;      结构体一律计 unsup —— 宁可诚实门禁，也不发半对的码。
;   ⚠️ **已知分歧**：自举无 bool 型别码（bool 与 i64 共用 TY-I64），故 print(b) 会印
;      "1"/"0" 而权威印 "true"/"false"。这条留给 L4 差分显性暴露（DIFF 而非静默），
;      待自举补 TY-BOOL 或字面量侧识别后再收（§11 後 ⑨）。
;   ⚠️ 插值形 print('{x}') 见 s102（h2m-fmt-class / h2m-fmt-emit）：无 spec 的
;      裸标识符字段按型别直发 OP-PRINT，与权威逐字节同结果；带 spec 或表达式字段计 unsup。
; t: AST arena
; c: 上下文（发码目标）
; sg: 模块级签名表（实参里的嵌套调用要用）
; n: K-CALL-EXPRESSION 节点 id
; name: 'print' 或 'eprint'
; r: 1 = 已降级；0 = 计了 unsup（已 mark）
h2m-lower-print = (t ast, c h2m-ctx, sg h2m-sigs, n i64, name str) (r i64) {
    r = 1
    d = ast.nd-at(t, n)
    na = d.c0

    ; kind 基址：stdout = 0，stderr = 4（见 mir.no 的 OP-PRINT kind 表）
    base = 0
    name == 'eprint' -> base = 4

    j = 0
    (j < na && r == 1) {
        ap = d.kid0

        #{overflow=wrap}
        ap = ap + 1

        #{overflow=wrap}
        ap = ap + j
        ak = ast.kid-at(t, ap)
        ad = ast.nd-at(t, ak)

        ; s102：插值形判定。class 0 = 没有替换字段（原样印，含 {{ }} 不反转义）；
        ;   1 = 全为裸标识符字段（可降级，见 h2m-fmt-emit）；2 = 形制超出本件 ⇒ unsup。
        fcl = 0
        ad.kind == asp.K-STRING-LITERAL -> fcl = h2m-fmt-class(ast.str-at(t, ad.s0))
        fcl == 2 -> r = 0
        fcl == 1 -> {

            ; 权威侧的多实参形（模板 + 其它实参）走 lowerNamedFormatMulti：模板字段
            ;   就地替换、非模板实参照普通 variadic 打印。自举只收「整条 print 只有
            ;   这一个模板实参」的形；多实参计 unsup（宁可诚实门禁）。
            na == 1 -> r = h2m-fmt-emit(t, c, ast.str-at(t, ad.s0), base)
            na != 1 -> r = 0
        }
        r == 1 && fcl == 0 -> {
            av = h2m-lower-expr(t, c, sg, ak)
            av == 0 -> r = 0
            r == 1 -> {

                ; 实参之间的分隔空格：只在第 2 个及以后发（第一个之前不发）
                j > 0 -> h2m-emit(c, OP-PRINT, 0, 0, base + 3, '', 0)
                aty = h2m-vty-at(c, av)
                aty == TY-STR -> h2m-emit(c, OP-PRINT, 0, av, base + 1, '', 0)
                aty == TY-I64 || aty == TY-U64 -> h2m-emit(c, OP-PRINT, 0, av, base, '', 0)
                aty != TY-STR && aty != TY-I64 && aty != TY-U64 -> r = 0
            }
        }

        #{overflow=wrap}
        j = j + 1
    }

    ; 末尾换行（print() 空实参也走这条 ⇒ 只印一个 "\n"，与 Go 同形）
    r == 1 -> h2m-emit(c, OP-PRINT, 0, 0, base + 2, '', 0)
    r == 0 -> h2m-mark(c)
}

; t: AST arena（會被**就地追加**合成節點，不毀損原有節點／kid 段）
; agg: 模块级计数器（呼叫方以 agg.unsup == 0 判定產碼可信）
; root: 原始 Program 節點 id
; r: 模組函式文本（含 define i64 @main()，**不含** prelude；unsup>0 ⇒ ''）
; ⑭ 切片 4（2026-11-13）：M4-d 模块级降级入口——合成 @main。本件拆成「合成 Program」與「整包」兩段：
;   ① 合成邏輯抽到 h2m-synth-main（供 drv.pkg-ll 整包路徑複用，整包時不重複做 struct 登記／解／emit）；
;   ② 本函數只對「單一模組」負責：h2m-synth-main 合成 prog 後，交 h2m-lower-program（內含 struct 登記／解／emit）。
; 與既有單模組呼叫點（s62 探針、h2m-test、drv-build-test）逐字節不變：仍是 h2m-lower-program 產碼。
h2m-lower-module = (t ast, agg h2m-ctx, root i64) (r str) {
    r = ''
    prog = h2m-synth-main(t, root)
    r = h2m-lower-program(t, agg, prog)
    agg.unsup > 0 -> r = ''
}

; ⑭ 切片 4（2026-11-13）：從頂層陳述合成 `main` 的 Program 節點（只做 AST 手術，不含 struct 登記／解／emit，
;   那些由呼叫方統一處理）。邏輯等同舊 h2m-lower-module 的合成段，抽出供整包路徑複用。
;   ① 找末位 exit(E)；② 合成 __noc_r 輸出參；③ 末位 let 把 E 綁到 __noc_r；
;   ④ 合成 main body（非定義、非 exit 頂層陳述 + 末位 let）；⑤ 合成 main 定義；⑥ 合成 Program（定義 + main）。
h2m-synth-main = (t ast, root i64) (prog i64) {
    d = ast.nd-at(t, root)
    n = d.nkid

    ; ① 找末位 exit(E)：記下引數表達式節點 id 與該陳述在 Program 的位次
    ex = 0
    nex = -1
    q <- [0..n): {
        kp = d.kid0

        #{overflow=wrap}
        kp = kp + q
        kid = ast.kid-at(t, kp)
        kd = ast.nd-at(t, kid)
        kd.kind == asp.K-EXPRESSION-STATEMENT -> {
            sub = ast.kid-at(t, kd.kid0)
            sd = ast.nd-at(t, sub)
            sd.kind == asp.K-CALL-EXPRESSION && sd.c0 == 1 -> {
                ck = ast.kid-at(t, sd.kid0)
                cd = ast.nd-at(t, ck)
                cd.kind == asp.K-IDENTIFIER && ast.str-at(t, cd.s0) == 'exit' -> {
                    ap = sd.kid0

                    #{overflow=wrap}
                    ap = ap + 1
                    ex = ast.kid-at(t, ap)
                    nex = q
                }
            }
        }
    }

    ; 無 exit ⇒ 合成 `0` 字面量，讓 main 恆有明確回值（同 Go 合成 main 的 ret 0）
    ex == 0 -> {
        zl = ast.add(t, asp.K-INTEGER-LITERAL)
        ast.set-slot(t, zl, 0, ast.put-str(t, '0'))
        ex = zl
    }

    ; ② 合成輸出參 `__noc_r i64`
    tn = ast.add(t, asp.K-NAMED-TYPE)
    ast.set-slot(t, tn, 0, ast.put-str(t, 'i64'))
    pn = ast.add(t, asp.K-PARAMETER)
    ast.set-slot(t, pn, 0, ast.put-str(t, '__noc_r'))
    ast.kid-add(t, pn, tn)
    ast.kid-add(t, pn, 0)

    ; ③ 末位 let：把 exit(E) 的 E 綁到輸出參名（h2m-lower-func 尾部據此取回值 id）
    ln = ast.add(t, asp.K-LET-STATEMENT)
    ast.set-slot(t, ln, 0, ast.put-str(t, '__noc_r'))
    ast.kid-add(t, ln, ex)

    ; ④ 合成 main body：所有非定義、非 exit 的頂層陳述 + 末位 let
    blk = ast.add(t, asp.K-BLOCK-STATEMENT)
    q <- [0..n): {
        kp = d.kid0

        #{overflow=wrap}
        kp = kp + q
        kid = ast.kid-at(t, kp)
        kd = ast.nd-at(t, kid)
        q != nex && kd.kind != asp.K-FUNCTION-DEFINITION && kd.kind != asp.K-STRUCT-DEFINITION && kd.kind != asp.K-USE-STATEMENT -> {
            ast.kid-add(t, blk, kid)
        }
    }
    ast.kid-add(t, blk, ln)

    ; ⑤ 合成 `main = () (__noc_r i64) { ... }`
    fn = ast.add(t, asp.K-FUNCTION-DEFINITION)
    ast.set-slot(t, fn, 0, ast.put-str(t, 'main'))
    ast.set-sig(t, fn, 0, 0, 1)
    ast.kid-add(t, fn, pn)
    ast.kid-add(t, fn, blk)

    ; ⑥ 合成 Program：只放定義 + main ⇒ h2m-lower-program 的「非定義計 unsup」不再觸發
    prog = ast.add(t, asp.K-PROGRAM)
    q <- [0..n): {
        kp = d.kid0

        #{overflow=wrap}
        kp = kp + q
        kid = ast.kid-at(t, kp)
        kd = ast.nd-at(t, kid)
        kd.kind == asp.K-FUNCTION-DEFINITION || kd.kind == asp.K-STRUCT-DEFINITION -> {
            ast.kid-add(t, prog, kid)
        }
    }
    ast.kid-add(t, prog, fn)
}
