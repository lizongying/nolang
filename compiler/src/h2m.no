; ═══════════════════════════════════════════════════════════════════
; h2m — AST → MIR 降级（对齐 src/mir/hir2mir.go）
; ═══════════════════════════════════════════════════════════════════
;
; 目标（M4-e，s55 首件 / s56 第二件 / s57 第三件）：把 ps.no 产出的 AST arena 降级成 cg.no 消费的 MIR 指令流，
; 打通「源码 → IR」的第一条真实路径。此前 compiler/ 里每一段 IR 都来自手写的 op 数组
; （cg-test.no / tmp/probe-sNN.no）——等于「codegen 有测试、前端无出口」。
;
; ── 覆盖面（刻意极小，且小得可测量）─────────────────────────────
;   支持：Program / FunctionDefinition（输入参数按 LLVM 形参序占值 id 1..nargs、
;         至多一个输出参数且其型别决定 retty）/ BlockStatement / LetStatement /
;         Identifier / IntegerLiteral / GroupedExpression / InfixExpression（+ - * 与六个比较符，仅 i64）/
;         CallExpression（零参或实参值 id 连续的多参，返回型别查模块级签名表）/
;         控制流（s57）：K-IF-EXPRESSION（含可选 else，elif 链按嵌套 if 递归）/
;         K-FOR-STATEMENT 的纯前置条件循环（Init/Update/CountExpr/IterRange 必须全 0）/
;         控制流（s58）：K-SURFACE-MATCH 的语句位花括号短路链 `{ c1 -> a1  c2 -> a2  -> b }`
;         （臂群在 helper/aux 阵，12 aux/臂，展开成 if/elif/else 的 CONDBR 链——镜像 Go desugarSurfaceMatchToIfExpr）
;   型别表：i64 / u64 / f64 / str 四个具名型别（K-NAMED-TYPE 的 s0）——只有签名侧认它们，
;         算术语义仍限 i64（其余型别的值进运算符即计 unsup，不发错码）
;   不支持（一律计入 unsup，绝不静默略过）：表达式位的 K-SURFACE-MATCH（`r = { c -> a -> b }`——须要
;         各臂汇成同一个结果值，本件只收语句位）、除与余、位运算、
;         前缀负号、逻辑 `&& ||`、多输出参数、泛型（c3 > 0）、带默认值的参数、非具名型别（[]t / map / *t / 别名）、
;         复合赋值、非函数定义语句、实参 id 不连续的调用、方法调用（点号）、
;         break / continue / return 语句、计数循环 `n * { }`、区间与容器遍历 `i <- xs:`
;
; ── 实参连续契约（cg 的 OP-CALL 约定，非 Go 约定）─────────────────
;   cg-emit-cfg-t 的 CALL 臂按 `xa[k] .. xa[k]+bs[k]-1` 读实参值 id，要求它们**连续**；
;   Go 侧 Instruction.Args 是任意 ValueID 列表，无此约束。本件用「逐个降级 + 校验
;   av == first + j」显式守门：不连续就计 unsup 不产该调用（而非静默发错 %v 名）。
;   ⚠ 真实修法是把 args 改成独立 arena（对齐 Go），届时删掉这条门禁——已记入未覆盖。
;
; ── 值 id 模型（与 cg.cg-emit-cfg-t 的约定对齐）───────────────────
;   id 0 = 哑元（vty[0] 先占位，永不引用）；1..nargs = 形参（s56 起按形参序单调分配）；
;   nargs+1 起由降级期单调分配。每个 LetStatement 把右值表达式的结果 id 直接绑到名字，
;   同名重复绑定 = 覆盖（镜像 §3.11「函数作用域内同名重复赋值 = 重赋值」）。
;
; ── 两种存储模式（s57：按体内有无控制流二选一，判据来自 h2m-scan 前扫描）─────
;   mem == 0（直线式，s55/s56 原样）：SSA 名即槽，**不发 alloca/store/load**。
;   mem == 1（体内有分支/循环）：**全部局部量（含形参）落 entry 块 alloca 槽**（-O0 风格），
;     读 = OP-LOAD/OP-SLOAD，写 = OP-STORE/OP-SSTORE。理由是 cg 只用 blks 数组切标签、
;     没有 PHI：跨块引用别的块的 SSA 名会被 opt 的 dominator 检查直接拒（then 块里绑的
;     %v9 在汇聚块不可用），而循环体内重绑同名变量若不落内存就退化成「永远只加第一轮的值」。
;     ⚠️ 槽必须在 entry：cg 要求每块是指令序的**连续段**，一旦离开 entry 就再也回不去，
;       所以槽位表由前扫描（h2m-lst + h2m-ty-of）先把名字与型别定下来，再进 body。
;     ⚠️ 槽型别只认 i64 / str（cg 只有 alloca i64 与 alloca %str-long 两种；f64 无槽 op）；
;       前扫描推不出型别的局部量（如 vec / 结构体）⇒ 计 unsup，整函数不产码。
;
; ── 诚实门禁 ─────────────────────────────────────────────────────
;   不支持的构造让 agg.unsup += 1。呼叫方必须以 unsup == 0 判定本轮产码可信，
;   不得把「产出了 IR」当成「降级正确」。
;
; SHS 合规：无模块级可变状态、无一等函数值、无指针、无 map 字段；
;   一律【普通函数 + 显式结构体参数】，不用方法（带 vec 字段的跨模块方法同 ast.no 风险面）。
; ⚠️ 整数运算默认回 option<int>：每条算术陈述都要 #{overflow=wrap}；
;    读 arr[i]（i 非字面量）要 #{index-out=zero}。

# /compiler/src/asp
# /compiler/src/ast
# /compiler/src/mir
# /compiler/src/cg

; ── 降级上下文（指令流 + 值 id arena + 变量绑定表 + 块游标 + 诚实计数器）──
; ⚠️ 块游标纪律（s57）：cg 主循环按 `blks[k] != cur` 发标签 ⇒ **每块必须是指令序中的连续段**。
;   故本文件只单向推进块 id（entry → arms / loop 区域 → 汇聚块），回边只发 OP-BR 不再发指令；
;   一旦离开某块就绝不再写它（写回去会重复发标签，opt 报标签重定义）。
h2m-ctx {
    ops []i64
    dsts []i64
    xa []i64
    bs []i64
    syms []str
    blks []i64
    vty []i64
    cty []i64
    names []str
    vids []i64
    tys []i64
    nid i64
    blk i64
    bnext i64
    mem i64
    unsup i64
}

; 新建降级上下文：vty 先占 id 0（哑元），下一个可用 id = 1；块 0 = entry
; c: 上下文
h2m-new = () (c h2m-ctx) {
    c = h2m-ctx {
        ops: []
        i64
        dsts: []
        i64
        xa: []
        i64
        bs: []
        i64
        syms: []
        str
        blks: []
        i64
        vty: []
        i64
        cty: []
        i64
        names: []
        str
        vids: []
        i64
        tys: []
        i64
        nid: 1
        blk: 0
        bnext: 1
        mem: 0
        unsup: 0
    }
    c.vty.push(TY-I64)
}

; 分配一个新值 id，并把它的型别码登记进 vty（vty 按值 id 索引，必须同步填）
; c: 上下文
; ty: 型别码
; id: 新分配的值 id
h2m-alloc = (c h2m-ctx, ty i64) (id i64) {
    c.vty.push(ty)
    id = c.nid

    #{overflow=wrap}
    c.nid = c.nid + 1
}

; 追加一条指令（落到当前块 c.blk；s57 前恒为 entry = 0）
; c: 上下文
; op: OP-* 码
; d: 结果值 id（无结果指令传 0；⚠️ OP-CONDBR 的 d 被 cg 当【假块 id】用）
; a: 第一实参
; b: 第二实参
; sym: 符号槽（字符串字面量等）
; res: 结果型别码（写入 cty[k]）
h2m-emit = (c h2m-ctx, op i64, d i64, a i64, b i64, sym str, res i64) {
    c.ops.push(op)
    c.dsts.push(d)
    c.xa.push(a)
    c.bs.push(b)
    c.syms.push(sym)
    c.blks.push(c.blk)
    c.cty.push(res)
}

; 新开一个基本块并回它的 id（只分配 id，不发指令；块内容由后续 h2m-set-block 写入）
; c: 上下文
; id: 新块 id（entry = 0，故首个新块是 1）
h2m-block-new = (c h2m-ctx) (id i64) {
    id = c.bnext

    #{overflow=wrap}
    c.bnext = c.bnext + 1
}

; 切当前块（后续 h2m-emit 落到此块）⚠️ 只可切到尚未写过指令的块（连续段纪律）
; c: 上下文
; id: 目标块 id
h2m-set-block = (c h2m-ctx, id i64) {
    c.blk = id
}

; 记一条「本切片不支持」的构造（诚实门禁，不是静默略过）
; c: 上下文
h2m-mark = (c h2m-ctx) {

    #{overflow=wrap}
    c.unsup = c.unsup + 1
}

; 查变量绑定的值 id
; c: 上下文
; name: 变量名
; id: 值 id（0 = 未绑定）
h2m-var-find = (c h2m-ctx, name str) (id i64) {
    id = 0
    i = 0
    (i < c.names.len() && id == 0) {
        nm = c.names[i] #{index-out=zero}
        nm == name -> {
            vid = c.vids[i] #{index-out=zero}
            id = vid
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; 绑定变量名到值 id：已有同名绑定则覆盖（重赋值语义），否则追加（仅 mem == 0 直线式路径）
; c: 上下文
; name: 变量名
; id: 值 id
h2m-var-bind = (c h2m-ctx, name str, id i64) {
    found = 0
    i = 0
    (i < c.names.len() && found == 0) {
        nm = c.names[i] #{index-out=zero}
        nm == name -> {
            c.vids[i] = id
            found = 1
        }

        #{overflow=wrap}
        i = i + 1
    }
    found == 0 -> {
        c.names.push(name)
        c.vids.push(id)
        c.tys.push(0)
    }
}

; ── mem 模式（s57）：局部量落 alloca 槽的三件套 ────────────────────
; 名字在 c.names 中的下标；-1 = 未登记（与 h2m-var-find 共用线性扫，表长只几个局部量）
; c: 上下文
; name: 变量名
; i: 下标（-1 = 未找到）
h2m-name-find = (c h2m-ctx, name str) (i i64) {
    i = -1
    j = 0
    (j < c.names.len() && i < 0) {
        nm = c.names[j] #{index-out=zero}
        nm == name -> i = j

        #{overflow=wrap}
        j = j + 1
    }
}

; 为名字铺一个槽（s57：必须在 entry 块调用，因 cg 要求块为连续段、离开 entry 就回不去）
; 同名已有条目（形参已经绑过值 id）则把绑定改写为槽；同时零初始化，避免未赋值先读拿到 poison
; ⚠️ TY-U64 在 LLVM 里与 TY-I64 同类型（i64），共用 alloca i64 槽；TY-F64 无槽 op ⇒ 计 unsup
; c: 上下文
; name: 变量名
; ty: 槽型别码（认 TY-I64 / TY-U64 / TY-STR）
h2m-slot-decl = (c h2m-ctx, name str, ty i64) {
    sid = h2m-alloc(c, ty)
    ok-slot = 1
    ty != TY-I64 && ty != TY-U64 && ty != TY-STR -> ok-slot = 0
    ok-slot == 1 && ty != TY-STR -> {
        h2m-emit(c, OP-ALLOC, sid, 0, 0, '', ty)
        zid = h2m-alloc(c, ty)
        h2m-emit(c, OP-CONST, zid, 0, 0, '', ty)
        h2m-emit(c, OP-STORE, 0, zid, sid, '', 0)
    }
    ok-slot == 1 && ty == TY-STR -> {
        h2m-emit(c, OP-SALLOC, sid, 0, 0, '', TY-STR)
        zid2 = h2m-alloc(c, TY-STR)
        h2m-emit(c, OP-STRCONST, zid2, 0, 0, '', TY-STR)
        h2m-emit(c, OP-SSTORE, 0, zid2, sid, '', 0)
    }
    ok-slot == 0 -> h2m-mark(c)
    ok-slot == 1 -> {
        i = h2m-name-find(c, name)
        i >= 0 -> {
            c.vids[i] = sid
            c.tys[i] = ty
        }
        i < 0 -> {
            c.names.push(name)
            c.vids.push(sid)
            c.tys.push(ty)
        }
    }
}

; 把形参 incoming 值存进它的槽（仍需在 entry 块调用；值 id 由 h2m-alloc 单调分配⇒c 已绑同名的槽）
; c: 上下文
; name: 形参名
; vid: 形参的值 id（1..nargs）
; ty: 槽型别码
h2m-slot-init-arg = (c h2m-ctx, name str, vid i64, ty i64) {
    sid = 0
    st = -1
    i = h2m-name-find(c, name)
    i >= 0 -> {
        sid = c.vids[i] #{index-out=zero}
        st = c.tys[i] #{index-out=zero}
    }
    st == ty && ty != TY-STR -> h2m-emit(c, OP-STORE, 0, vid, sid, '', 0)
    st == ty && ty == TY-STR -> h2m-emit(c, OP-SSTORE, 0, vid, sid, '', 0)
    st != ty -> h2m-mark(c)
    i < 0 -> h2m-mark(c)
}

; 读一个变量的当前值：mem == 0 直返 SSA 值 id；mem == 1 在当前块发 LOAD/SLOAD
; c: 上下文
; name: 变量名
; v: 值 id（0 = 未登记或槽型 unsupported，已计入 unsup）
h2m-var-read = (c h2m-ctx, name str) (v i64) {
    v = 0
    i = h2m-name-find(c, name)
    i < 0 -> h2m-mark(c)
    i >= 0 && c.mem == 0 -> v = c.vids[i] #{index-out=zero}
    i >= 0 && c.mem == 1 -> {
        sid = c.vids[i] #{index-out=zero}
        st = c.tys[i] #{index-out=zero}
        st == TY-I64 || st == TY-U64 -> {
            v = h2m-alloc(c, st)
            h2m-emit(c, OP-LOAD, v, sid, 0, '', st)
        }
        st == TY-STR -> {
            v = h2m-alloc(c, TY-STR)
            h2m-emit(c, OP-SLOAD, v, sid, 0, '', TY-STR)
        }
        st != TY-I64 && st != TY-U64 && st != TY-STR -> h2m-mark(c)
    }
}

; 写一个变量：mem == 0 绑/覆盖值 id；mem == 1 发 STORE/SSTORE进槽（型别不符 ⇒ unsup）
; c: 上下文
; name: 变量名
; val: 右值的值 id
h2m-var-write = (c h2m-ctx, name str, val i64) {
    c.mem == 0 -> h2m-var-bind(c, name, val)
    c.mem == 1 -> {
        ok-w = 0
        i = h2m-name-find(c, name)
        i >= 0 -> {
            sid = c.vids[i] #{index-out=zero}
            st = c.tys[i] #{index-out=zero}
            vt = h2m-vty-at(c, val)
            st == vt && st != TY-STR -> {
                h2m-emit(c, OP-STORE, 0, val, sid, '', 0)
                ok-w = 1
            }
            st == vt && st == TY-STR -> {
                h2m-emit(c, OP-SSTORE, 0, val, sid, '', 0)
                ok-w = 1
            }
        }
        ok-w == 0 -> h2m-mark(c)
    }
}

; 安全读某值 id 的型别码（越界回元素零值 = TY-I64，与 cg.cg-vty-at 同口径）
; c: 上下文
; id: 值 id
; t: 型别码
h2m-vty-at = (c h2m-ctx, id i64) (t i64) {
    t = c.vty[id] #{index-out=zero}
}

; 具名型别 → MIR 型别码；本件只收四个基础型别，认不出回 -1（呼叫方计 unsup）
; s: 型别名文本（K-NAMED-TYPE 的 s0）
; t: 型别码（-1 = 不在覆盖面）
h2m-ty-code = (s str) (t i64) {
    t = -1
    s == 'i64' -> t = TY-I64
    s == 'u64' -> t = TY-U64
    s == 'f64' -> t = TY-F64
    s == 'str' -> t = TY-STR
}

; ── 模块级函数签名表（调用点据此解析返回型别与实参个数，对齐 Go 的函数表查找）──
h2m-sigs {
    fname []str
    fret []i64
    fnarg []i64
    fbase []i64
    farg []i64
}

; 新建签名表
; s: 签名表
h2m-sigs-new = () (s h2m-sigs) {
    s = h2m-sigs {
        fname: []
        str
        fret: []
        i64
        fnarg: []
        i64
        fbase: []
        i64
        farg: []
        i64
    }
}

; 登记一个函数签名；argt 逐项拷进拼接表 farg（值复制，与呼叫方分离）
; s: 签名表
; name: 函数名
; ret: 返回型别码
; argt: 输入型别表（顺序即 LLVM 形参序）
h2m-sig-add = (s h2m-sigs, name str, ret i64, argt []i64) {
    b = s.farg.len()
    s.fname.push(name)
    s.fret.push(ret)
    s.fnarg.push(argt.len())
    s.fbase.push(b)
    i = 0
    (i < argt.len()) {
        at = argt[i] #{index-out=zero}
        s.farg.push(at)

        #{overflow=wrap}
        i = i + 1
    }
}

; 按名字查签名下标；-1 = 未登记（含被形状门禁排除的函数）
; s: 签名表
; name: 函数名
; i: 签名下标（-1 = 未找到）
h2m-sig-find = (s h2m-sigs, name str) (i i64) {
    i = -1
    j = 0
    (j < s.fname.len() && i < 0) {
        nm = s.fname[j] #{index-out=zero}
        nm == name -> i = j

        #{overflow=wrap}
        j = j + 1
    }
}

; 读签名 i 的第 j 个输入型别码
; s: 签名表
; i: 签名下标
; j: 形参序
; t: 型别码
h2m-sig-arg = (s h2m-sigs, i i64, j i64) (t i64) {
    fb = s.fbase[i] #{index-out=zero}

    #{overflow=wrap}
    fb = fb + j
    t = s.farg[fb] #{index-out=zero}
}

; ── 前扫描（s57：mem 模式定槽宽 + 控制流探测）───────────────────
; 槽必须在 entry，而 entry 指令又必须先于 body 发出 ⇒ 进 body 前就得知道「有哪些局部量、各是什么型别」。
; 本段就是一个不指令的小型Syntax walker：只做两件事——登记 let 名取型别、发现控制流节点置 flow。
; ⚠️ 与降级器的型别判定彼此独立⇒可能偏离；偏离不会发错码：写入口 h2m-var-write 会再比一次
;   槽型与右值实型（不符 ⇒ unsup、整函数不产码），宁缺勿错。
h2m-lst {
    lname []str
    lty []i64
}

; 新建局部量表
; l: 局部量表
h2m-lst-new = () (l h2m-lst) {
    l = h2m-lst {
        lname: []
        str
        lty: []
        i64
    }
}

; 查局部量名在表中的下标；-1 = 未登记
; l: 局部量表
; name: 变量名
; i: 下标
h2m-lst-find = (l h2m-lst, name str) (i i64) {
    i = -1
    j = 0
    (j < l.lname.len() && i < 0) {
        nm = l.lname[j] #{index-out=zero}
        nm == name -> i = j

        #{overflow=wrap}
        j = j + 1
    }
}

; 登记/覆盖一个局部量及其型别（同一名字多次 let 以最后一次为准，与重赋语义一致）
; l: 局部量表
; name: 变量名
; ty: 型别码（-1 = 推不出，后续 h2m-slot-decl 会计 unsup）
h2m-lst-add = (l h2m-lst, name str, ty i64) {
    i = h2m-lst-find(l, name)
    i >= 0 -> l.lty[i] = ty
    i < 0 -> {
        l.lname.push(name)
        l.lty.push(ty)
    }
}

; 语法型别推断（仅供定槽宽）：只认 i64 / str 两型，其余一律 -1
; t: AST arena
; sg: 模块级签名表（调用回值型别）
; l: 已登记的局部量表（标识符型别查此表）
; n: 表达式节点 id
; code: 型别码（-1 = 推不出）
h2m-ty-of = (t ast, sg h2m-sigs, l h2m-lst, n i64) (code i64) {
    code = -1
    n > 0 -> {
        d = ast.nd-at(t, n)
        d.kind == asp.K-INTEGER-LITERAL -> code = TY-I64
        d.kind == asp.K-STRING-LITERAL -> code = TY-STR
        d.kind == asp.K-GROUPED-EXPRESSION -> {
            k = ast.kid-at(t, d.kid0)
            code = h2m-ty-of(t, sg, l, k)
        }
        d.kind == asp.K-INFIX-EXPRESSION -> {
            xk = ast.kid-at(t, d.kid0)
            yk = h2m-kid-i(t, n, 1)
            a = h2m-ty-of(t, sg, l, xk)
            b = h2m-ty-of(t, sg, l, yk)
            a == TY-I64 && b == TY-I64 -> code = TY-I64
        }
        d.kind == asp.K-IDENTIFIER -> {
            nm = ast.str-at(t, d.s0)
            i = h2m-lst-find(l, nm)
            i >= 0 -> code = l.lty[i] #{index-out=zero}
        }
        d.kind == asp.K-CALL-EXPRESSION -> {
            ck = ast.kid-at(t, d.kid0)
            ck > 0 -> {
                cd = ast.nd-at(t, ck)
                cd.kind == asp.K-IDENTIFIER -> {
                    cn = ast.str-at(t, cd.s0)
                    si = h2m-sig-find(sg, cn)
                    si >= 0 -> code = sg.fret[si] #{index-out=zero}
                }
            }
        }
    }
}

; 读节点第 i 个 kid（越界回 0，不拿后面节点的 kid 槽）
; t: AST arena
; n: 节点 id
; i: kid 序号
; k: 子节点 id（0 = 越界或该槽本来就空）
h2m-kid-i = (t ast, n i64, i i64) (k i64) {
    k = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        i < d.nkid -> {
            p = d.kid0

            #{overflow=wrap}
            p = p + i
            k = ast.kid-at(t, p)
        }
    }
}

; 逐个 kid 前扫（不进嵌套函数定义：其局部量属另一个函数，否则会被误铺槽）
; t: AST arena
; sg: 模块级签名表
; l: 局部量表
; n: 父节点 id
; flow: 其子树是否含控制流
h2m-scan-kids = (t ast, sg h2m-sigs, l h2m-lst, n i64) (flow i64) {
    flow = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        i = 0
        (i < d.nkid) {
            kid = h2m-kid-i(t, n, i)
            kf = 0
            kid > 0 -> {
                kd = ast.nd-at(t, kid)
                kd.kind != asp.K-FUNCTION-DEFINITION -> kf = h2m-scan(t, sg, l, kid)
            }
            kf > flow -> flow = kf

            #{overflow=wrap}
            i = i + 1
        }
    }
}

; SurfaceMatch 臂群前扫（s58）：臂不占 kid 阵，只能按 12 aux/臂的布局逐个取 COND/BODY 再递进
; t: AST arena
; sg: 模块级签名表
; l: 局部量表
; n: SurfaceMatch 节点 id
; flow: 1 = 臂体内含控制流
h2m-scan-arms = (t ast, sg h2m-sigs, l h2m-lst, n i64) (flow i64) {
    flow = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        j = 0
        (j < d.hcount) {

            #{overflow=wrap}
            hb = d.hbase + 12 * j
            cn = ast.aux-at(t, hb + 10)
            bn = ast.aux-at(t, hb + 11)
            cf = 0
            cn > 0 -> cf = h2m-scan(t, sg, l, cn)
            cf > flow -> flow = cf
            bf = 0
            bn > 0 -> bf = h2m-scan(t, sg, l, bn)
            bf > flow -> flow = bf

            #{overflow=wrap}
            j = j + 1
        }
    }
}

; 前扫入口：登记 let 绑定名与型别，并回「子树内是否有分支/循环」
; ⚠️ K-SURFACE-MATCH 的臂群不占 kid 阵（在 helper/aux 区），故必须走 h2m-scan-arms 才能扫到臂体；
;   漏扫会少铺局部量槽，降级器在写入口比对不上 ⇒ 计 unsup 整函数不产码
; t: AST arena
; sg: 模块级签名表
; l: 局部量表（呼叫方预先播种形参）
; n: 节点 id
; flow: 1 = 含控制流（需 mem 模式）
h2m-scan = (t ast, sg h2m-sigs, l h2m-lst, n i64) (flow i64) {
    flow = 0
    n > 0 -> {
        d = ast.nd-at(t, n)
        {
            d.kind == asp.K-LET-STATEMENT -> {
                nm = ast.str-at(t, d.s0)
                vc = d.nkid

                #{overflow=wrap}
                vc = vc - 1
                vk = h2m-kid-i(t, n, vc)
                ty = h2m-ty-of(t, sg, l, vk)
                h2m-lst-add(l, nm, ty)
                f0 = h2m-scan-kids(t, sg, l, vk)
                f0 > flow -> flow = f0
            }

            d.kind == asp.K-IF-EXPRESSION || d.kind == asp.K-FOR-STATEMENT || d.kind == asp.K-SURFACE-MATCH -> {
                flow = 1
                f1 = h2m-scan-kids(t, sg, l, n)
                f1 > flow -> flow = f1
                fa = 0
                d.kind == asp.K-SURFACE-MATCH -> fa = h2m-scan-arms(t, sg, l, n)
                fa > flow -> flow = fa
            }

            d.kind == asp.K-BLOCK-STATEMENT || d.kind == asp.K-EXPRESSION-STATEMENT -> {
                f2 = h2m-scan-kids(t, sg, l, n)
                f2 > flow -> flow = f2
            }

            -> {
                f3 = h2m-scan-kids(t, sg, l, n)
                f3 > flow -> flow = f3
            }
        }
    }
}

; 表达式降级：回传该表达式的值 id；0 = 不支持（已计入 unsup）
; t: AST arena
; c: 上下文
; sg: 模块级签名表（调用点解析用）
; n: 表达式节点 id
; v: 值 id
h2m-lower-expr = (t ast, c h2m-ctx, sg h2m-sigs, n i64) (v i64) {
    v = 0
    d = ast.nd-at(t, n)
    {
        d.kind == asp.K-INTEGER-LITERAL -> {
            lit = ast.str-at(t, d.s0)
            ov = lit.to-i64()
            ok-lit = 0
            num = 0
            ov: {
                ok -> {
                    num = it
                    ok-lit = 1
                }

                -> {
                }
            }
            ok-lit == 1 -> {
                cid = h2m-alloc(c, TY-I64)
                h2m-emit(c, OP-CONST, cid, num, 0, '', TY-I64)
                v = cid
            }
            ok-lit == 0 -> h2m-mark(c)
        }

        d.kind == asp.K-IDENTIFIER -> {
            nm = ast.str-at(t, d.s0)
            vi = h2m-name-find(c, nm)
            vi >= 0 -> v = h2m-var-read(c, nm)
            vi < 0 -> h2m-mark(c)
        }

        d.kind == asp.K-GROUPED-EXPRESSION -> {
            gk = ast.kid-at(t, d.kid0)
            v = h2m-lower-expr(t, c, sg, gk)
        }

        d.kind == asp.K-INFIX-EXPRESSION -> {
            osym = ast.str-at(t, d.s0)
            xk = ast.kid-at(t, d.kid0)
            yp = d.kid0

            #{overflow=wrap}
            yp = yp + 1
            yk = ast.kid-at(t, yp)
            lv = h2m-lower-expr(t, c, sg, xk)
            rv = h2m-lower-expr(t, c, sg, yk)
            bop = 0
            {
                osym == '+' -> bop = OP-ADD

                osym == '-' -> bop = OP-SUB

                osym == '*' -> bop = OP-MUL

                ; 比较家族（s57：控制流的条件侧需要 0/1 值；cg 发 icmp + zext i1→i64）
                osym == '<' -> bop = OP-CMPLT

                osym == '>' -> bop = OP-CMPGT

                osym == '<=' -> bop = OP-CMPLE

                osym == '>=' -> bop = OP-CMPGE

                osym == '==' -> bop = OP-CMPEQ

                osym == '!=' -> bop = OP-CMPNE

                -> {
                }
            }

            ; 算术语义仍限 i64：任一操作数是 str/u64/f64 值 ⇒ 计 unsup，不发 add i64 %sv…
            ity = 1
            lv > 0 && rv > 0 -> {
                h2m-vty-at(c, lv) != TY-I64 -> ity = 0
                h2m-vty-at(c, rv) != TY-I64 -> ity = 0
            }
            bop > 0 && lv > 0 && rv > 0 && ity == 1 -> {
                mid = h2m-alloc(c, TY-I64)
                h2m-emit(c, bop, mid, lv, rv, '', TY-I64)
                v = mid
            }
            bop == 0 || lv == 0 || rv == 0 || ity == 0 -> h2m-mark(c)
        }

        ; 调用降级：kid 序 = [被调用者][实参…]，c0 = 实参个数；
        ;   被调用者限 K-IDENTIFIER（方点/方法调用不在本件），实参个数与型别查签名表，
        ;   并校验 cg 的连续 id 契约（不连续 ⇒ 计 unsup 不产该调用）
        d.kind == asp.K-CALL-EXPRESSION -> {
            na = d.c0
            ck = ast.kid-at(t, d.kid0)
            cd = ast.nd-at(t, ck)
            ok-call = 1
            cd.kind != asp.K-IDENTIFIER -> ok-call = 0
            cn = ''
            si = -1
            ok-call == 1 -> {
                cn = ast.str-at(t, cd.s0)
                si = h2m-sig-find(sg, cn)
                si < 0 -> ok-call = 0
            }
            ok-call == 1 -> {
                want-n = sg.fnarg[si] #{index-out=zero}
                want-n != na -> ok-call = 0
            }
            first = 0
            ok-call == 1 -> {
                j = 0
                (j < na && ok-call == 1) {
                    ap = d.kid0

                    #{overflow=wrap}
                    ap = ap + 1

                    #{overflow=wrap}
                    ap = ap + j
                    ak = ast.kid-at(t, ap)
                    av = h2m-lower-expr(t, c, sg, ak)
                    av == 0 -> ok-call = 0
                    ok-call == 1 -> {
                        at = h2m-vty-at(c, av)
                        want = h2m-sig-arg(sg, si, j)
                        want != at -> ok-call = 0
                        first == 0 -> first = av

                        #{overflow=wrap}
                        want = first + j
                        want != av -> ok-call = 0
                    }

                    #{overflow=wrap}
                    j = j + 1
                }
            }
            ok-call == 1 -> {
                rt = sg.fret[si] #{index-out=zero}
                cid = h2m-alloc(c, rt)
                h2m-emit(c, OP-CALL, cid, first, na, cn, rt)
                v = cid
            }
            ok-call == 0 -> h2m-mark(c)
        }

        -> h2m-mark(c)
    }
}

; LetStatement 降级：右值降级出的 id 直接绑到名字（不发 alloca/store/load）
; kid 区序 = [型别节点, 值表达式]，取最后一个 kid 作值（对 nkid=1 的合成人同样成立）
; 显式型别标注（kids[0] 非 0）必须与右值型别码一致，否则计 unsup
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: 语句节点 id
h2m-lower-let = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    d = ast.nd-at(t, n)
    d.nkid == 0 -> h2m-mark(c)
    d.nkid > 0 -> {
        nm = ast.str-at(t, d.s0)
        vp = d.kid0
        vc = d.nkid

        #{overflow=wrap}
        vc = vc - 1

        #{overflow=wrap}
        vp = vp + vc
        vk = ast.kid-at(t, vp)
        vv = h2m-lower-expr(t, c, sg, vk)
        vv > 0 -> h2m-var-write(c, nm, vv)

        ; 型别标注侧：只认 K-NAMED-TYPE 且码与右值相符（不符 ⇒ 计 unsup，整函数不产码）
        tc = 0
        vv > 0 && d.nkid > 1 -> {
            tkp = d.kid0
            tk = ast.kid-at(t, tkp)
            tk > 0 -> {
                td = ast.nd-at(t, tk)
                td.kind != asp.K-NAMED-TYPE -> tc = -1
                td.kind == asp.K-NAMED-TYPE -> {
                    code = h2m-ty-code(ast.str-at(t, td.s0))
                    code != h2m-vty-at(c, vv) -> tc = -1
                    code >= 0 && code == h2m-vty-at(c, vv) -> tc = 1
                }
            }
        }
        tc < 0 -> h2m-mark(c)
    }
}

; BlockStatement 降级：逐个 kid 降级；认得 LetStatement / IfExpression / ForStatement /
; ExpressionStatement（内含 IfExpression，即述层的 `cond -> stmt` 单行 guard），其余计 unsup
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: 块节点 id
h2m-lower-block = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    d = ast.nd-at(t, n)
    i = 0
    (i < d.nkid) {
        p = d.kid0

        #{overflow=wrap}
        p = p + i
        kid = ast.kid-at(t, p)
        kk = ast.nd-at(t, kid)
        hd = 0
        kk.kind == asp.K-LET-STATEMENT -> {
            h2m-lower-let(t, c, sg, kid)
            hd = 1
        }
        kk.kind == asp.K-IF-EXPRESSION -> {
            h2m-lower-if(t, c, sg, kid)
            hd = 1
        }
        kk.kind == asp.K-FOR-STATEMENT -> {
            h2m-lower-for(t, c, sg, kid)
            hd = 1
        }
        kk.kind == asp.K-SURFACE-MATCH -> {
            h2m-lower-surface(t, c, sg, kid)
            hd = 1
        }

        ; 述层的单行 `cond -> stmt`：ExpressionStatement 包一个 IfExpression（实测 kid 序 [expr]）
        kk.kind == asp.K-EXPRESSION-STATEMENT -> {
            sub = h2m-kid-i(t, kid, 0)
            sub > 0 -> {
                sd = ast.nd-at(t, sub)
                sd.kind == asp.K-IF-EXPRESSION -> {
                    h2m-lower-if(t, c, sg, sub)
                    hd = 1
                }
                sd.kind == asp.K-SURFACE-MATCH -> {
                    h2m-lower-surface(t, c, sg, sub)
                    hd = 1
                }
            }
        }
        hd == 0 -> h2m-mark(c)

        #{overflow=wrap}
        i = i + 1
    }
}

; 分支体降级：Block 走 h2m-lower-block；嵌套 IfExpression 走 h2m-lower-if（elif 链就靠这一路）；
; 花括号短路链走 h2m-lower-surface；臂体内再开循环走 h2m-lower-for（s58）
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: 体节点 id
h2m-lower-branch = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    n <= 0 -> h2m-mark(c)
    n > 0 -> {
        d = ast.nd-at(t, n)
        {
            d.kind == asp.K-BLOCK-STATEMENT -> h2m-lower-block(t, c, sg, n)

            d.kind == asp.K-IF-EXPRESSION -> h2m-lower-if(t, c, sg, n)

            d.kind == asp.K-SURFACE-MATCH -> h2m-lower-surface(t, c, sg, n)

            d.kind == asp.K-FOR-STATEMENT -> h2m-lower-for(t, c, sg, n)

            -> h2m-mark(c)
        }
    }
}

; IfExpression 降级：kid 序 = [Condition][Consequence][Alternative]（实测 3 kid，单行 guard 的 Alternative = 0）
; 块形制：当前块求值条件后发 CONDBR，then / else 各成一块并无条件的 BR 回汇聚块。
; ⚠️ CONDBR 的三个槽按 cg 口径填：xa = 条件值 id、bs = 真块 id、**dsts = 假块 id**（此处 dsts 不是结果值）
; ⚠️ 无 else 臂时把假路直接接到汇聚块，不留空块；每个开出来的块至少拿到一条终结指令（连续段纪律）
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: IfExpression 节点 id
h2m-lower-if = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    ck = h2m-kid-i(t, n, 0)
    tk = h2m-kid-i(t, n, 1)
    ek = h2m-kid-i(t, n, 2)
    cv = h2m-lower-expr(t, c, sg, ck)
    cv == 0 -> h2m-mark(c)
    cv > 0 -> {
        then-id = h2m-block-new(c)
        else-id = h2m-block-new(c)
        merge-id = h2m-block-new(c)
        ftgt = else-id
        ek == 0 -> ftgt = merge-id
        h2m-emit(c, OP-CONDBR, ftgt, cv, then-id, '', 0)

        h2m-set-block(c, then-id)
        h2m-lower-branch(t, c, sg, tk)
        h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)

        ek > 0 -> {
            h2m-set-block(c, else-id)
            h2m-lower-branch(t, c, sg, ek)
            h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)
        }

        h2m-set-block(c, merge-id)
    }
}

; ForStatement 降级（本件只收纯前置条件循环 `(cond) { }`）
; kid 序 = [Init][Condition][Update][CountExpr][IterRange][Body]（ps.no:5706 注释 + 实测 kid[1]/kid[5]）
; 块形制：当前块 BR → hdr；hdr 求值条件后 CONDBR(body, exit)；body 结尾 BR 回 hdr；后继语句落在 exit
; ⚠️ Init/Update/CountExpr/IterRange 任一非 0 ⇒ 不在覆盖面（计数循环与区间遍历属后续）
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: ForStatement 节点 id
h2m-lower-for = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    d = ast.nd-at(t, n)
    init = h2m-kid-i(t, n, 0)
    cond = h2m-kid-i(t, n, 1)
    upd = h2m-kid-i(t, n, 2)
    cnt = h2m-kid-i(t, n, 3)
    rng = h2m-kid-i(t, n, 4)
    body = h2m-kid-i(t, n, 5)
    bad = 0
    d.nkid != 6 -> bad = 1
    init != 0 || upd != 0 || cnt != 0 || rng != 0 -> bad = 1
    cond == 0 || body == 0 -> bad = 1
    bad != 0 -> h2m-mark(c)
    bad == 0 -> {
        hdr-id = h2m-block-new(c)
        body-id = h2m-block-new(c)
        exit-id = h2m-block-new(c)
        h2m-emit(c, OP-BR, 0, hdr-id, 0, '', 0)

        h2m-set-block(c, hdr-id)
        cv = h2m-lower-expr(t, c, sg, cond)
        cv == 0 -> h2m-mark(c)
        cv > 0 -> h2m-emit(c, OP-CONDBR, exit-id, cv, body-id, '', 0)

        h2m-set-block(c, body-id)
        h2m-lower-block(t, c, sg, body)
        h2m-emit(c, OP-BR, 0, hdr-id, 0, '', 0)

        h2m-set-block(c, exit-id)
    }
}

; SurfaceMatch 降级（s58）：语句位花括号短路链 `{ c1 -> a1  c2 -> a2  -> b }`
; 实测形制（tmp/probe-s58-ast.no）：节点 nkid=1 且 kid[0] 恒为 0（ps.no 占住 Matched 位防 kid 槽别名）、
;   s0 = 臂数的字符串、臂群在 helper/aux 区——d.hcount 臂 × 12 aux/臂，
;   槽 4 = wildcard（'true' / 0）、槽 7 = blockBody（'true' / 0）、槽 10 = Condition 节点索引（wildcard 臂 = 0）、槽 11 = Body 节点索引
; 块形制（镜像 Go desugarSurfaceMatchToIfExpr 的 if/elif/else 链）：逐臂「当前块求值条件 → CONDBR(臂体块, 下一臂判定块)」，
;   臂体结束一律 BR 回汇聚块；wildcard 臂不发 CONDBR，其体直接落当前块，其后的臂不可达（语言语义即短路）故不再降
; ⚠️ 先跑整链形状前置校验再发指令：cg 要求每块都是指令序的**连续段**且每个被引用的块至少拿到一条终结指令，
;   半路放弃会在 IR 里留下「有跳转无指令」的块 ⇒ opt 报标签未定义，所以不合格就地整函数不产码
; t: AST arena
; c: 上下文
; sg: 模块级签名表
; n: SurfaceMatch 节点 id
h2m-lower-surface = (t ast, c h2m-ctx, sg h2m-sigs, n i64) {
    d = ast.nd-at(t, n)
    arms = d.hcount
    arms <= 0 -> h2m-mark(c)
    arms > 0 -> {
        bad = 0
        j = 0
        (j < arms && bad == 0) {

            #{overflow=wrap}
            hb = d.hbase + 12 * j
            cn = ast.aux-at(t, hb + 10)
            bn = ast.aux-at(t, hb + 11)
            wi = ast.aux-at(t, hb + 4)
            bn <= 0 -> bad = 1
            wi <= 0 && cn <= 0 -> bad = 1

            #{overflow=wrap}
            j = j + 1
        }
        bad != 0 -> h2m-mark(c)
        bad == 0 -> {
            merge-id = h2m-block-new(c)
            next-id = c.blk
            j = 0
            stop = 0
            (j < arms && stop == 0) {

                #{overflow=wrap}
                hb = d.hbase + 12 * j
                cn = ast.aux-at(t, hb + 10)
                bn = ast.aux-at(t, hb + 11)
                wi = ast.aux-at(t, hb + 4)
                wild = 0
                wi > 0 -> wild = 1
                h2m-set-block(c, next-id)

                #{overflow=wrap}
                last = j + 1
                wild == 1 -> {
                    h2m-lower-branch(t, c, sg, bn)
                    h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)
                    stop = 1
                }
                wild == 0 -> {
                    cv = h2m-lower-expr(t, c, sg, cn)
                    cv == 0 -> {
                        h2m-mark(c)
                        stop = 1
                    }
                    cv > 0 -> {
                        arm-id = h2m-block-new(c)
                        ftgt = merge-id
                        last < arms -> ftgt = h2m-block-new(c)
                        h2m-emit(c, OP-CONDBR, ftgt, cv, arm-id, '', 0)
                        h2m-set-block(c, arm-id)
                        h2m-lower-branch(t, c, sg, bn)
                        h2m-emit(c, OP-BR, 0, merge-id, 0, '', 0)
                        next-id = ftgt
                    }
                }

                #{overflow=wrap}
                j = j + 1
            }
            h2m-set-block(c, merge-id)
        }
    }
}

; 单个 K-PARAMETER 节点 → 型别码（实测 kid 序 = [Type, DefaultExpr]）
; 非具名型别 / 未知型别名 / 带默认值 ⇒ bad = 1（默认值会让调用点 arity 判定失效）
; t: AST arena
; p: 参数节点 id
; code: 型别码（-1 = 不在覆盖面）
; bad: 形状不合格标记
h2m-param-ty = (t ast, p i64) (code i64, bad i64) {
    bad = 1
    code = -1
    pd = ast.nd-at(t, p)
    tk = ast.kid-at(t, pd.kid0)
    tk > 0 -> {
        td = ast.nd-at(t, tk)
        td.kind == asp.K-NAMED-TYPE -> {
            code = h2m-ty-code(ast.str-at(t, td.s0))
            code >= 0 -> bad = 0
        }
    }
    dp = pd.kid0

    #{overflow=wrap}
    dp = dp + 1
    dv = ast.kid-at(t, dp)
    dv != 0 -> {
        bad = 1
        code = -1
    }
}

; 读取函数定义节点的签名：名字 / 返回型别码 / 输入型别表 / 形状门禁
; kid 区序 = [泛型…][输入…][输出…][body]（实测：nkid == c3 + c4 + c5 + 1）
; bad = 1 表示不在本件覆盖面（泛型、多输出、非具名型别、带默认值参数、未知型别名）；
;   这里不计 unsup，由呼叫方计——前置 pass 与产码 pass 共用一份判据
; t: AST arena
; n: 函数定义节点 id
; name: 函数名
; ret: 返回型别码（无输出参数时按 TY-I64）
; argt: 输入型别表（顺序即 LLVM 形参序）
; bad: 形状不合格标记
h2m-func-sig = (t ast, n i64) (name str, ret i64, argt []i64, bad i64) {
    bad = 0
    ret = TY-I64
    d = ast.nd-at(t, n)
    name = ast.str-at(t, d.s0)
    d.c3 > 0 -> bad = 1
    d.c5 > 1 -> bad = 1
    i = 0
    (i < d.c4 && bad == 0) {
        p = d.kid0

        #{overflow=wrap}
        p = p + d.c3

        #{overflow=wrap}
        p = p + i
        pk = ast.kid-at(t, p)
        pc, pb = h2m-param-ty(t, pk)
        pb != 0 -> bad = 1
        pb == 0 -> argt.push(pc)

        #{overflow=wrap}
        i = i + 1
    }
    bad == 0 && d.c5 == 1 -> {
        rp = d.kid0

        #{overflow=wrap}
        rp = rp + d.c3

        #{overflow=wrap}
        rp = rp + d.c4
        rk = ast.kid-at(t, rp)
        rc, rb = h2m-param-ty(t, rk)
        rb != 0 -> bad = 1
        rb == 0 -> ret = rc
    }
}

; FunctionDefinition 降级为一段函数 IR 文本
; agg: 模块级计数器上下文（本件内部的指令 arena 是私有的，只把 unsup 增量并入 agg）
; t: AST arena
; sg: 模块级签名表（体内调用点查表用）
; n: 函数定义节点 id
; r: 函数 IR 文本（'' = 形状不支持，未产码）
h2m-lower-func = (t ast, agg h2m-ctx, sg h2m-sigs, n i64) (r str) {
    r = ''
    c = h2m-new()
    d = ast.nd-at(t, n)
    fnm, frt, fap, fb = h2m-func-sig(t, n)
    fb != 0 -> h2m-mark(c)
    fb == 0 -> {

        ; 形参：值 id 按 LLVM 形参序单调分配（h2m-new 起 nid = 1 ⇒ 恰为 1..nargs），
        ;   并把名字绑上；型别同时进 vty（发射侧按它选 %v / %sv 命名空间）
        ;   loc 同步播种形参（前扫描要拿它推标识符型别，也要拿它当「哪些名字是 incoming」）
        loc = h2m-lst-new()
        q = 0
        (q < fap.len()) {
            p = d.kid0

            #{overflow=wrap}
            p = p + d.c3

            #{overflow=wrap}
            p = p + q
            pk = ast.kid-at(t, p)
            pd = ast.nd-at(t, pk)
            pnm = ast.str-at(t, pd.s0)
            pt = fap[q] #{index-out=zero}
            vid = h2m-alloc(c, pt)
            h2m-var-bind(c, pnm, vid)
            h2m-lst-add(loc, pnm, pt)

            #{overflow=wrap}
            q = q + 1
        }

        ; body 是最后一个 kid
        bp = d.kid0
        bc = d.nkid

        #{overflow=wrap}
        bc = bc - 1

        #{overflow=wrap}
        bp = bp + bc
        body = ast.kid-at(t, bp)

        ; ⚠️ 槽必须在 body 之前铺完（entry 块的连续段纪律）⇒ 先前扫描定「有无控制流 + 局部量表」
        flow = 0
        bc >= 0 -> flow = h2m-scan(t, sg, loc, body)
        flow > 0 -> c.mem = 1
        c.mem == 1 -> {
            m = 0
            (m < loc.lname.len()) {
                lnm = loc.lname[m] #{index-out=zero}
                lty = loc.lty[m] #{index-out=zero}
                h2m-slot-decl(c, lnm, lty)

                ; 前 m 项是形参（loc 先被形参播种）⇒ 另需把 incoming 值存进槽，不然 callee 读不到实参
                m < fap.len() -> {
                    avid = 0

                    #{overflow=wrap}
                    avid = m + 1
                    h2m-slot-init-arg(c, lnm, avid, lty)
                }

                #{overflow=wrap}
                m = m + 1
            }
        }
        bc < 0 -> h2m-mark(c)
        bc >= 0 -> h2m-lower-block(t, c, sg, body)

        ; 恰一个输出参数时：它绑定的值 id 即返回值
        rid = 0
        d.c5 == 1 -> {
            rp = d.kid0

            #{overflow=wrap}
            rp = rp + d.c3

            #{overflow=wrap}
            rp = rp + d.c4
            pk = ast.kid-at(t, rp)
            pd = ast.nd-at(t, pk)
            out-name = ast.str-at(t, pd.s0)

            ; mem 模式要在这里发 LOAD（槽在 entry、本块可达）；直线式仍直接拿绑定的值 id
            oi = h2m-name-find(c, out-name)
            oi >= 0 -> rid = h2m-var-read(c, out-name)
        }

        ; 输出参数未被赋值：Go 侧靠「延迟零值」补零；本件只对 i64 发 CONST 0，其余计 unsup
        rid == 0 && frt == TY-I64 -> {
            zid = h2m-alloc(c, TY-I64)
            h2m-emit(c, OP-CONST, zid, 0, 0, '', TY-I64)
            rid = zid
        }
        rid == 0 && frt != TY-I64 -> h2m-mark(c)

        ; 返回值型别必须与输出参数的声明相符：`s = a`（a 为 i64、s 声明为 str）会
        ;   让 cg 发 `ret %str-long %v…`——LLVM 验不过但降级不报错，故在此拦截
        ty-match = 1
        rid > 0 -> {
            h2m-vty-at(c, rid) != frt -> ty-match = 0
        }
        ty-match == 0 -> h2m-mark(c)
        rid > 0 && ty-match == 1 -> {
            h2m-emit(c, OP-RET, 0, rid, 0, '', frt)
            r = cg.cg-emit-cfg-t(fnm, frt, fap.len(), fap, c.vty, c.cty, c.blks, c.ops, c.dsts, c.xa, c.bs, c.syms)
        }
    }

    ; 本函数体内有任何不支持构造 ⇒ 整函数不产码（宁缺勿错），并把计数并入模块级
    inc = c.unsup

    #{overflow=wrap}
    agg.unsup = agg.unsup + inc
    inc > 0 -> r = ''
}

; 整个 Program 降级：先扫一遍签名表（调用可前向引用），再逐函数产码并拼接
; 非函数定义、以及签名不合格的函数均计入 unsup（只在产码 pass 计，避免双计）
; t: AST arena
; agg: 模块级计数器上下文（呼叫方以 agg.unsup == 0 判定产码可信）
; root: Program 节点 id
; r: 模块函数文本（不含 prelude / main）
h2m-lower-program = (t ast, agg h2m-ctx, root i64) (r str) {
    r = ''
    sg = h2m-sigs-new()
    d = ast.nd-at(t, root)

    ; 前置 pass：只登记合格签名（不合格的此处跳登、不计数）
    i = 0
    (i < d.nkid) {
        p = d.kid0

        #{overflow=wrap}
        p = p + i
        kid = ast.kid-at(t, p)
        kk = ast.nd-at(t, kid)
        kk.kind == asp.K-FUNCTION-DEFINITION -> {
            nm, rt, ap, bd = h2m-func-sig(t, kid)
            bd == 0 -> h2m-sig-add(sg, nm, rt, ap)
        }

        #{overflow=wrap}
        i = i + 1
    }

    ; 产码 pass：逐个函数降级
    j = 0
    (j < d.nkid) {
        p = d.kid0

        #{overflow=wrap}
        p = p + j
        kid = ast.kid-at(t, p)
        kk = ast.nd-at(t, kid)
        kk.kind == asp.K-FUNCTION-DEFINITION -> {
            nm2, rt2, ap2, bd2 = h2m-func-sig(t, kid)
            bd2 != 0 -> h2m-mark(agg)
            bd2 == 0 -> {
                one = h2m-lower-func(t, agg, sg, kid)
                one != '' -> {
                    r = r - one - '\n'
                }
            }
        }
        kk.kind != asp.K-FUNCTION-DEFINITION -> h2m-mark(agg)

        #{overflow=wrap}
        j = j + 1
    }
}
