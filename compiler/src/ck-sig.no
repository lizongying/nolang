        mok: []
        moo: []
        bk: []
        bv: []
        bo: []
    }
    ck-sig-fill-fk(t)
    ck-sig-fill-fp(t)
    ck-sig-fill-fr(t)
    ck-sig-fill-mk(t)
    ck-sig-fill-mp(t)
