    fr []str
    mk []str
    mp []str
    mr []str
    sfk []str
    sft []str
    alk []str
    alt []str
    smk []str
    smt []str
    evk []str
    evt []str
    mok []str
    moo []str
    bk []str
    bv []str
    bo []str
}

; ── 表构造（首块字面量整賦＋余块 push 链，仿 asp.no strs/tape 形制）──

ck-sig.new = () (t ck-sig) {
    t = ck-sig {
        fk: []
        fp: []
        fr: []
        mk: []
        mp: []
        mr: []
        sfk: []
        sft: []
        alk: []
