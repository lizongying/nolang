; ck-sig — std 签名/结构/别名/枚举/模块表（M3-b，生成物）
;
; ⚠️【生成檔，勿手改】再生成：python3 compiler/tools/gen_ck_sig.py
; Authority：src/checker/stdsig_gen.go（genstdsig/'make gen' 产物）；源 sha256 见 CK-SIG-DIGEST。
; bk/bv/bo 裸名门表 Authority = oracle 行为探测（./bin/no vet 批量），非 Go 源文件；
;   bv='-' 沉默放行 / bv=owner 模块名 ⇒ 带 call-it-as 提示 / bv='' 或不在表 ⇒ 裸 not defined。
;   bo = fk unique owner（可空）——正主 stdFuncModule 同值，供 curModule 自模块裸调放行臂。
;
; 编码约定：
;   * 各表按 key ASCII 升序 ⇒ ck-sig-bsearch 二分查找
;   * Params/Results/变体清单以 ',' 连接（型串字符集实测不含 ','）
;   * structFields 拍平为 'Struct.field' -> type（标识符不含 '.'，无歧义）
;   * 全部键/值为纯 ASCII（ck-sig-lt 以 byte(i)/len-bytes() 逐字节比较）
;
; 表规模（生成时实测）：
;   funcs 862 / methods 2387 / struct-fields 720
;   aliases 1 / struct-mod 105 / enums 3 / modules 118
;   bare-gate 1726 (silent 779 / gated 947)

CK-SIG-VERSION = 3
CK-SIG-DIGEST = '0329cf82be1b3d12c2c40ba8ebec2226b23662ac6542cc5c1f7ab07a9ac12b49'

ck-sig {
    fk []str
    fp []str
    fr []str
    mk []str
    mp []str
    mr []str
    sfk []str
    sft []str
    alk []str
    alt []str
    smk []str
    smt []str
    evk []str
    evt []str
    mok []str
    moo []str
    bk []str
    bv []str
    bo []str
}

; ── 表构造（一次性 push 链，仿 asp.no strs/tape 形制）──

ck-sig.new = () (t ck-sig) {
    t = ck-sig {
        fk: with-cap(862)
        fp: with-cap(862)
        fr: with-cap(862)
        mk: with-cap(2387)
        mp: with-cap(2387)
        mr: with-cap(2387)
        sfk: with-cap(720)
        sft: with-cap(720)
        alk: with-cap(1)
        alt: with-cap(1)
        smk: with-cap(105)
        smt: with-cap(105)
        evk: with-cap(3)
        evt: with-cap(3)
        mok: with-cap(118)
        moo: with-cap(118)
        bk: with-cap(1726)
        bv: with-cap(1726)
        bo: with-cap(1726)
    }
    ck-sig-fill-fk(t)
    ck-sig-fill-fp(t)
    ck-sig-fill-fr(t)
    ck-sig-fill-mk(t)
    ck-sig-fill-mp(t)
    ck-sig-fill-mr(t)
    ck-sig-fill-sfk(t)
    ck-sig-fill-sft(t)
    ck-sig-fill-alk(t)
    ck-sig-fill-alt(t)
    ck-sig-fill-smk(t)
    ck-sig-fill-smt(t)
    ck-sig-fill-evk(t)
    ck-sig-fill-evt(t)
    ck-sig-fill-mok(t)
    ck-sig-fill-moo(t)
    ck-sig-fill-bk(t)
    ck-sig-fill-bv(t)
    ck-sig-fill-bo(t)
}

; ── 各列数据（生成区）──
ck-sig-fill-fk = (t ck-sig) {
    ck-sig-fill-fk-g0(t)
    ck-sig-fill-fk-g1(t)
    ck-sig-fill-fk-g2(t)
}

