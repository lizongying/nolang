; ═══════════════════════════════════════════════════════════════════
; ast — AST arena（POD）+ `no ast` dump 解譯器
; ═══════════════════════════════════════════════════════════════════
;
; 目標（M2，見 docs/design/nolang-selfhost.md §5.3）：讓 `noc ast <file>` 的輸出
; 與 L2 oracle `no ast <file>` **逐位元組相同**。
;
; ── 為什麼是 arena + i64 索引（§5.1.1）─────────────────────────────
; AST 是有向圖（型別互相引用、符號互相引用，可能成環）。Nolang 的所有權模型
; 無法表達環。而且 `[]T` 擴容會重新分配，任何指向舊緩衝的位址立即失效。
; 索引永遠有效，且環可以自由表達。
;
; ⚠️ `nd` 必須是 **POD**：全部欄位都是 i64，字串以 id 指向 strs / aux 池。
;    這一條是硬約定（§5.1.1）：含擁有堆的欄位會在 push 時被深拷貝，
;    而 POD 的拷貝成本是固定的。
;
; ── 為什麼是「規格表 + 解譯器」而不是 71 個手寫函式 ────────────────
; 規格表在 compiler/src/asp.no（**自動生成**，來源是 dump.go 的型別 switch）。
; 同一份表已經在 Go 上重放並與 dump.go 對拍：src/parser/dump/spec_gen_test.go
; 走全語料 528 檔、逐位元組一致 ⇒ **表本身已被證明忠實**。
; 本檔只需要忠實「解譯」那張表，不必再承擔 71 段輸出序列的轉錄風險。
;
; ── 表的槽位模型（與 asp.no 檔頭同步）────────────────────────────
; HDR     = (op, name-id, braces, child-ordinal(node_of)+1 或 0, absent-id)
; SCALAR  = (op, policy, render, of, label-id | ref<<24)
;   ref：OF-TYPE / OF-NODE-STRING / OF-LOCAL(render=nodeString)
;        → **CHILD 序號**（值來自子節點，不佔槽位）
;        其餘 → 節點的字串槽序號 s0..s8（parser 已預先渲染好）
; CHILD   = (op, field-id, guard, 0, 0)
; KIDS    = (op, field-id, skip_nil, ptr, 0)
; HELPER  = (op, field-id, skip_nil, helper-id, 0)
; SELFHELPER = (op, helper-id, 0, 0, 0)
; 其餘    = (op, 0, 0, 0, 0)
;
; ⚠️ **為什麼純量槽一律是「字串槽」而不是「字串槽 + 整數槽」**：
;    render 包含 float，而 Go 的 `%v` 對 float64 的輸出無法從 i64 還原。
;    改由 parser 預先渲染成字串後，解譯器只需 `wanted(policy, val)` 一個決策點。
;
; ── 本檔目前的覆蓋範圍（M2 進行中，**刻意可量測**）────────────────
;   已接線：OP-HDR / OP-SCALAR / OP-COMMENTS / OP-CHILD / OP-KIDS /
;           OP-FREE / OP-BETWEEN / OP-TRAILING / OP-CLOSING /
;           OP-IMPLEMENTS / OP-SIG / OP-HELPER（taggedEnumField / matchArm /
;           interfaceMethod）
;   未接線：OP-SELF-HELPER（AnnotationEntry）、OP-HELPER 的
;           annotationStructField 一支
; ⚠️ 未接線的指令會讓 `.unsup` 計數 +1（**不是**靜默略過），
;    所以「這個 fixture 的 dump 可不可信」是可判定的：ast.unsupported(t) == 0。
;
; ⚠️ **OP-ANNOTS 是 no-op，且這不是遺漏**：Go 端的規格表本身也不模擬
;    `Options.Annotations`（見 spec_gen_test.go 的 opAnnots 註解）。
;    因此本檔的 dump 對應的是 **`-annotations` 關閉** 的情形。
;    語料的 L2 對拍（528 檔）也全是在 annotations 關閉下做的。
;
; ── `.gaps`：不影響輸出、但「不可重現」的診斷計數 ─────────────────
;   * `exprToString` 的 `default: fmt.Sprintf("%v", e)` 印的是 Go 結構體
;     傾印（含 lexer.Token），**無法**在 Nolang 重現。
;   * 已實測：全語料 262 個 ArrayType.Size 全部是 *IntegerLiteral
;     （見 §5.3.1 的探針），故此分支目前不可達。
;   命中時輸出 `<expr?(` + 型別名 + `)>`（刻意醜，避免被當成正確輸出），
;   並讓 ast.gaps(t) > 0。
;
; ── SHS 合規 ──────────────────────────────────────────────────────
;   無模組級可變狀態、無一等函式值、無指針、無 map 欄位。
; ⚠️ 一律用【普通函式 + 顯式結構體參數】，不用方法：
;    帶 map 欄位的結構體 + 方法 + 跨模組會炸（見 compiler/src/util/intern.no 檔頭）。
; ⚠️ 整數運算預設回 option<int>：每條算術陳述都要 #{overflow=wrap}。
; ⚠️ 讀 `x = arr[i]`（i 非字面量）要 #{index-out=zero}；寫入位置不需要。
;
; ⚠️ 為什麼 type-string / expr-string 在本檔而不是 ty.no：
;    §4.3 的依賴圖是 `ast ──► ty`（ast 在上游）。dump 需要 `Type.String()`，
;    若把它放進 ty.no 就會形成 ast ⇄ ty 循環。故**dump 專用的兩個摘要印表機**
;    留在 ast.no；ty.no 負責型別的**文法解析**與語意查詢。

# /compiler/src/asp
# /compiler/src/util/sb.sb

; ── 節點資料（POD；字串一律以 id 指向 ast.strs / ast.aux）──────────
;
; 槽位分區（每一區都從 0 起算，互不重疊）：
;   c0..c2   KIDS 各組的元素數（由 ast.set-count 填入）
;   c3..c5   SIG 的三組節點數：泛型參數 / 參數 / 回傳值
;   s0..s7   純量字串槽（MAX-STR-SLOTS = 8，由生成器實測）
;   varunion / varflag   SIG 的 VariadicUnion 字串 id / IsVariadic
;   doc / cmt            Doc / Comment 的**首條**註解文字 id（0 = 無群組，-1 = 空群組）
;   free / btw           FreeComments / BetweenComments 的註解條數（-1 = 無群組）
;   ct0                  ast.aux 的起點：本節點的 [trailing][closing][implements] 區段
;   ntrail / nclos / nimp  三段各自的條數（-1 = 無群組 / 0 = 無）
;   hcount / hbase       HELPER 的元素數 / aux 中 (name-id, tnode) 成對區段的起點
nd {
    kind i64
    kid0 i64
    nkid i64
    c0 i64
    c1 i64
    c2 i64
    c3 i64
    c4 i64
    c5 i64
    s0 i64
    s1 i64
    s2 i64
    s3 i64
    s4 i64
    s5 i64
    s6 i64
    s7 i64
    s8 i64
    varunion i64
    varflag i64
    doc i64
    cmt i64
    free i64
    btw i64
    ct0 i64
    ntrail i64
    nclos i64
    nimp i64
    hcount i64
    hbase i64
}

ast {
    nodes []nd
    kids []i64
    strs []str
    str-k []str; string-interning hash table (open addressing; grows on demand)
    str-v []i64; maps interned string -> index in strs
    str-n i64; live entry count in str-k/str-v (drives load-factor growth)
    aux []i64
    tape []i64
    kinds []i64
    n i64
    unsup i64
    gaps i64
}

; ═══════════════════════════════════════════════════════════════════
; 建構
; ═══════════════════════════════════════════════════════════════════

; 功能待補充
; d: 返回結果
zero-nd = () (d nd) {
    d = nd {
        kind: 0
        kid0: 0
        nkid: 0
        c0: 0
        c1: 0
        c2: 0
        c3: 0
        c4: 0
        c5: 0
        s0: 0
        s1: 0
        s2: 0
        s3: 0
        s4: 0
        s5: 0
        s6: 0
        s7: 0
        s8: 0
        varunion: 0
        varflag: 0
        doc: 0
        cmt: 0
        free: -1
        btw: -1
        ct0: 0
        ntrail: -1
        nclos: -1
        nimp: 0
        hcount: 0
        hbase: 0
    }
}

; 建立空 arena（索引 0 保留為「無節點」；strs/aux 的索引 0 亦保留）
; r: 返回結果
make = () (r ast) {
    r = ast {
        nodes: []
        nd
        kids: []
        i64
        strs: asp.strs()
        str-k: with-cap(256)
        str-v: with-cap(256)
        str-n: 0
        aux: []
        i64
        tape: asp.tape()
        kinds: asp.kinds()
        n: 0
        unsup: 0
        gaps: 0
    }
    z = ast.zero-nd()
    r.nodes.push(z)
    r.aux.push(0)
    r.n = 1

    ; pre-fill string-interner sentinel slots (open addressing; '' = empty)
    hi = 0
    (hi < 256) {
        r.str-k.push('')
        r.str-v.push(0)
        hi = hi + 1
    }
}

; 新增節點，回傳其索引（>= 1）
; t: 輸入
; kind: 種類
; idx: 索引
add = (t ast, kind i64) (idx i64) {
    d = ast.zero-nd()
    d.kind = kind
    d.kid0 = t.kids.len()
    t.nodes.push(d)

    #{overflow=wrap}
    t.n = t.n + 1

    #{overflow=wrap}
    idx = t.n - 1
}

; 把子節點索引附加到節點 i 的 kids 區段
; t: 輸入
; i: 索引
; c: 運算元
kid-add = (t ast, i i64, c i64) {
    t.kids.push(c)
    d = ast.nd-at(t, i)

    #{overflow=wrap}
    d.nkid = d.nkid + 1
    ast.nd-put(t, i, d)
}

; 第 slot 個 KIDS 指令的元素數（slot 從 0 起）
; t: 輸入
; i: 索引
; slot: 數值
; v: 值
set-count = (t ast, i i64, slot i64, v i64) {
    d = ast.nd-at(t, i)
    {
        slot == 0 -> d.c0 = v

        slot == 1 -> d.c1 = v

        slot == 2 -> d.c2 = v

        -> {
        }
    }
    ast.nd-put(t, i, d)
}

; SIG 的三組節點數（泛型參數 / 參數 / 回傳值）
; t: 輸入
; i: 索引
; ng: 數值
; np: 數值
; nr: 數值
set-sig = (t ast, i i64, ng i64, np i64, nr i64) {
    d = ast.nd-at(t, i)
    d.c3 = ng
    d.c4 = np
    d.c5 = nr
    ast.nd-put(t, i, d)
}

; 第 slot 個純量字串槽（slot 從 0 起；**不含** doc/cmt）
; t: 輸入
; i: 索引
; slot: 數值
; v: 值
set-slot = (t ast, i i64, slot i64, v i64) {
    d = ast.nd-at(t, i)
    {
        slot == 0 -> d.s0 = v

        slot == 1 -> d.s1 = v

        slot == 2 -> d.s2 = v

        slot == 3 -> d.s3 = v

        slot == 4 -> d.s4 = v

        slot == 5 -> d.s5 = v

        slot == 6 -> d.s6 = v

        slot == 7 -> d.s7 = v

        slot == 8 -> d.s8 = v

        -> {
        }
    }
    ast.nd-put(t, i, d)
}

; SIG 的 VariadicUnion 與 IsVariadic
; t: 輸入
; i: 索引
; union: 數值
; variadic: 數值
set-sig-extras = (t ast, i i64, union i64, variadic i64) {
    d = ast.nd-at(t, i)
    d.varunion = union
    d.varflag = variadic
    ast.nd-put(t, i, d)
}

; set-doc / set-cmt: 節點自己的 Doc / Comment（存**首條**註解文字的 str id；
; 0 = 無群組，-1 = 有群組但首條文字空 —— 見 put-doc-str）
; ⚠️ 渲染端（comments）對 -1 仍要印出 "Doc: //" + 換行（oracle commentGroupInline
;    無條件印 "//" + 首條文字 + 換行；首條文字為空 ⇒ 印 "//" 換行）
; t: 輸入
; i: 索引
; v: 值
set-doc = (t ast, i i64, v i64) {
    d = ast.nd-at(t, i)
    d.doc = v
    ast.nd-put(t, i, d)
}

; 設置 cmt
; t: 輸入
; i: 索引
; v: 值
set-cmt = (t ast, i i64, v i64) {
    d = ast.nd-at(t, i)
    d.cmt = v
    ast.nd-put(t, i, d)
}

; free / btw 的註解條數（-1 = 無群組）
; t: 輸入
; i: 索引
; free: 數值
; btw: 數值
set-comments = (t ast, i i64, free i64, btw i64) {
    d = ast.nd-at(t, i)
    d.free = free
    d.btw = btw
    ast.nd-put(t, i, d)
}

; 開始本節點的 aux 區段（trailing → closing → implements 依序 append）
; t: 輸入
; i: 索引
; base: 結果數值
aux-begin = (t ast, i i64) (base i64) {
    base = t.aux.len()
    d = ast.nd-at(t, i)
    d.ct0 = base
    ast.nd-put(t, i, d)
}

; 追加一個 aux 值（註解文字 id / implements 字串 id）
; t: 輸入
; v: 值
aux-add = (t ast, v i64) {
    t.aux.push(v)
}

; 三段 aux 區段的條數
; t: 輸入
; i: 索引
; ntrail: 數值
; nclos: 數值
; nimp: 數值
set-aux-counts = (t ast, i i64, ntrail i64, nclos i64, nimp i64) {
    d = ast.nd-at(t, i)
    d.ntrail = ntrail
    d.nclos = nclos
    d.nimp = nimp
    ast.nd-put(t, i, d)
}

; 開始本節點的 HELPER 區段（每個元素 2 個 aux 值：name-id, tnode）
; t: 輸入
; i: 索引
; count: 計數
; base: 結果數值
helper-begin = (t ast, i i64, count i64) (base i64) {
    base = t.aux.len()
    d = ast.nd-at(t, i)
    d.hcount = count
    d.hbase = base
    ast.nd-put(t, i, d)
}

; put-str: 把字串駐留進池，回傳其**索引**（空字串回 0）
;
; ⚠️ 回傳值是**索引**不是「1 起算的 id」：asp.strs() 已經在索引 0 放了一個
;    空字串，所以表的 id（1..N）與池的索引**恰好重合**（strs[sid] 就是那個
;    字串）。新增的字串接在後面，索引就是 len-1。
;    早期版本回傳 len（1 起算），會讓 str-at 讀到隔壁一格 —— 症狀是
;    `warnings: ` 少印、而 `value` 印成下一個字串的內容。
; ── 字串駐留：O(1) 開放定址雜湊（替代原 O(n) 線性掃描，修 parser O(n²)）──
; sx: 字串
; h: 結果數值
ast-str-hash = (sx str) (h i64) {
    h = 5381
    i = 0
    n = sx.len-bytes()
    (i < n) {
        c-opt = sx.byte(i)
        c = c-opt: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        h = h * 31 + c
        i = i + 1
    }
}

; 不查重、直接插入 mapping s -> target（grow 重哈希時用，避免遞歸增長）
; t: 輸入
; s: 字串
; target: 數值
ast-str-intern-raw = (t ast, s str, target i64) {
    n = t.str-k.len()
    h = ast-str-hash(s)

    #{overflow=wrap}
    h = h % n
    (h < 0) -> h = h + n
    i = 0
    (i < n) {
        k = t.str-k[h]
        k == '' -> {
            t.str-k[h] = s
            t.str-v[h] = target
            t.str-n = t.str-n + 1
            return
        }
        k == s -> {
            return
        }

        #{overflow=wrap}
        h = (h + 1) % n
        (h < 0) -> h = h + n
        i = i + 1
    }
}

; 翻倍重哈希（str-v 存的是 strs 下標，strs 本身不動）
; t: 輸入
ast-str-grow = (t ast) {
    old-k = t.str-k
    old-v = t.str-v
    old-n = old-k.len()
    new-cap = old-n * 2
    (new-cap == 0) -> new-cap = 256
    t.str-k = with-cap(new-cap)
    t.str-v = with-cap(new-cap)
    hi = 0
    (hi < new-cap) {
        t.str-k.push('')
        t.str-v.push(0)
        hi = hi + 1
    }
    t.str-n = 0
    hi = 0
    (hi < old-n) {
        kk = old-k[hi]
        kk != '' -> ast-str-intern-raw(t, kk, old-v[hi])
        hi = hi + 1
    }
}

; 回傳 s 在 strs 中的駐留下標（首次出現則 append 後駐留；與原線性掃描下標完全一致）
; t: 輸入
; s: 字串
; idx: 索引
ast-str-intern = (t ast, s str) (idx i64) {
    cap = t.str-k.len()
    (t.str-n * 4 >= cap * 3) -> ast-str-grow(t)
    n = t.str-k.len()
    h = ast-str-hash(s)

    #{overflow=wrap}
    h = h % n
    (h < 0) -> h = h + n
    i = 0
    (i < n) {
        k = t.str-k[h]
        k == s -> {
            idx = t.str-v[h]
            return
        }
        k == '' -> {
            t.str-k[h] = s
            t.strs.push(s)
            idx = t.strs.len() - 1
            t.str-v[h] = idx
            t.str-n = t.str-n + 1
            return
        }

        #{overflow=wrap}
        h = (h + 1) % n
        (h < 0) -> h = h + n
        i = i + 1
    }
    t.strs.push(s)
    idx = t.strs.len() - 1
}

; 放入 str
; t: 輸入
; s: 字串
; id: 結果數值
put-str = (t ast, s str) (id i64) {
    id = 0
    s.len-bytes() == 0 -> return
    id = ast-str-intern(t, s)
}

; Doc / Comment 欄位用的**首條註解文字** id。
;
;   空字串 ⇒ -1（群組存在但首條文字為空）；非空 ⇒ put-str 的 id（≥1）。
;   ⚠️ 不能直接用 put-str：它對空字串回 0，而 0 在 doc/cmt 欄位是
;      「**無群組**」的哨兵 ⇒ 空文字的首條註解會讓整組憑空消失。
;      oracle 側的 CommentGroup 恆非空（commentGroupFromTokens 對空切片回 nil），
;      dump.go 的 commentGroupInline 只印首條文字 ⇒ 空文字仍印 "Doc: //"。
;      故以 -1 標示「群組在、首條文字空」，-1/0 兩個哨兵語意互斥。
; t: 輸入
; s: 字串
; id: 結果數值
put-doc-str = (t ast, s str) (id i64) {
    id = -1
    s.len-bytes() == 0 -> return
    id = ast.put-str(t, s)
}

; ═══════════════════════════════════════════════════════════════════
; 存取
; ═══════════════════════════════════════════════════════════════════
; t: 輸入
; i: 索引
; d: 返回結果
nd-at = (t ast, i i64) (d nd) {
    d = ast.zero-nd()
    i <= 0 -> return
    i >= t.n -> return

    #{index-out=zero}
    d = t.nodes[i]
}

; 功能待補充
; t: 輸入
; i: 索引
; d: 輸入
nd-put = (t ast, i i64, d nd) {
    i <= 0 -> return
    i >= t.n -> return
    t.nodes[i] = d
}

; 功能待補充
; t: 輸入
; i: 索引
; v: 結果數值
kid-at = (t ast, i i64) (v i64) {
    v = 0
    i < 0 -> return
    i >= t.kids.len() -> return

    #{index-out=zero}
    v = t.kids[i]
}

; 第 i 條指令的第 j 欄（每條 5 個 i64）
; t: 輸入
; i: 索引
; j: 索引
; v: 結果數值
ins = (t ast, i i64, j i64) (v i64) {
    v = 0

    #{overflow=wrap}
    p = i * 5

    #{overflow=wrap}
    p = p + j
    p < 0 -> return
    p >= t.tape.len() -> return

    #{index-out=zero}
    v = t.tape[p]
}

; 節點種類 k 的第 j 欄（每種 4 個 i64）
; t: 輸入
; k: 索引
; j: 索引
; v: 結果數值
kind-f = (t ast, k i64, j i64) (v i64) {
    v = 0

    #{overflow=wrap}
    p = k * 4

    #{overflow=wrap}
    p = p + j
    p < 0 -> return
    p >= t.kinds.len() -> return

    #{index-out=zero}
    v = t.kinds[p]
}

; 功能待補充
; t: 輸入
; id: 數值
; r: 結果字串
str-at = (t ast, id i64) (r str) {
    r = ''
    id <= 0 -> return
    id >= t.strs.len() -> return

    #{index-out=zero}
    r = t.strs[id]
}

; 功能待補充
; t: 輸入
; idx: 索引
; v: 結果數值
aux-at = (t ast, idx i64) (v i64) {
    v = 0
    idx <= 0 -> return
    idx >= t.aux.len() -> return

    #{index-out=zero}
    v = t.aux[idx]
}

; 功能待補充
; d: 輸入
; j: 索引
; v: 結果數值
nd-c = (d nd, j i64) (v i64) {
    v = 0
    {
        j == 0 -> v = d.c0

        j == 1 -> v = d.c1

        j == 2 -> v = d.c2

        -> {
        }
    }
}

; 功能待補充
; d: 輸入
; j: 索引
; v: 結果數值
nd-s = (d nd, j i64) (v i64) {
    v = 0
    {
        j == 0 -> v = d.s0

        j == 1 -> v = d.s1

        j == 2 -> v = d.s2

        j == 3 -> v = d.s3

        j == 4 -> v = d.s4

        j == 5 -> v = d.s5

        j == 6 -> v = d.s6

        j == 7 -> v = d.s7

        j == 8 -> v = d.s8

        -> {
        }
    }
}

; 預掃出來的 CHILD 節點索引陣列的第 ref 項（越界回 0）
; t: 輸入
; childs: 容器
; ref: 數值
; v: 結果數值
child-at = (t ast, childs []i64, ref i64) (v i64) {
    v = 0
    ref < 0 -> return
    ref >= childs.len() -> return

    #{index-out=zero}
    v = childs[ref]
}

; ── 讀回存取器（給測試與除錯用；ps.no 不需要）────────────────────
; t: 輸入
; i: 索引
; v: 結果數值
kind-at = (t ast, i i64) (v i64) {
    d = ast.nd-at(t, i)
    v = d.kind
}

; 功能待補充
; t: 輸入
; i: 索引
; j: 索引
; v: 結果數值
slot-at = (t ast, i i64, j i64) (v i64) {
    d = ast.nd-at(t, i)
    v = ast.nd-s(d, j)
}

; 取得數量 at
; t: 輸入
; i: 索引
; j: 索引
; v: 結果數值
count-at = (t ast, i i64, j i64) (v i64) {
    d = ast.nd-at(t, i)
    v = ast.nd-c(d, j)
}

; 功能待補充
; t: 輸入
; i: 索引
; v: 結果數值
nkid-at = (t ast, i i64) (v i64) {
    d = ast.nd-at(t, i)
    v = d.nkid
}

; ═══════════════════════════════════════════════════════════════════
; 輸出輔助
; ═══════════════════════════════════════════════════════════════════
; o: 輸入
; depth: 深度
indent = (o sb, depth i64) {
    j = 0
    (j < depth) {
        o.push('    ')

        #{overflow=wrap}
        j = j + 1
    }
}

; 「縮排 + s + 換行」
; o: 輸入
; depth: 深度
; s: 字串
line = (o sb, depth i64, s str) {
    ast.indent(o, depth)
    o.push(s)
    o.push-byte(10)
}

; 位元組切片（等價於 Go 的 s[a:b]，a/b 都是位元組索引）
; s: 字串
; a: 運算元
; b: 運算元
; r: 結果字串
sub = (s str, a i64, b i64) (r str) {
    t = sb.init(16)
    i = a
    (i < b) {
        sb-opt = s.byte(i)
        sbv = sb-opt: {
            ok -> it

            -> 0
        }
        t.push-byte(sbv)

        #{overflow=wrap}
        i = i + 1
    }
    r = t.str()
}

; 去掉尾端的換行（等價於 Go 的 strings.TrimRight(s, "\n")）
; s: 字串
; r: 結果字串
trim-nl = (s str) (r str) {
    n = s.len-bytes()
    (n > 0) {

        #{overflow=wrap}
        b-opt = s.byte(n - 1)
        b = b-opt: {
            ok -> it

            -> 0
        }
        b != 10 -> break

        #{overflow=wrap}
        n = n - 1
    }
    r = ast.sub(s, 0, n)
}

; ═══════════════════════════════════════════════════════════════════
; nodeString：標頭行裡的行內摘要（dump.go 的 (*dumper).nodeString）
; ═══════════════════════════════════════════════════════════════════
;
; ⚠️ 與 typeString 的差別：nodeString **不**特判 nil，`%T` of nil 是 "<nil>"，
;    所以 nil 節點要印成 "<nil>"；typeString 對 nil 回空字串。
;
; ⚠️ 7 個具名分支一律讀 **s0**：這是各節點自己的表中該欄位所在的槽位
;    （Identifier.name / IntegerLiteral.value / FloatLiteral.value /
;     StringLiteral.value / CharLiteral.value / BooleanLiteral.value 皆為 slot 0，
;     已由生成器逐一驗證）。BooleanLiteral 的 bool 由 parser 預先渲染成
;     'true'/'false'。
; t: 輸入
; i: 索引
; r: 結果字串
node-string = (t ast, i i64) (r str) {
    r = '<nil>'
    i <= 0 -> return
    d = ast.nd-at(t, i)
    d.kind <= 0 -> return
    k = d.kind
    {
        k == asp.K-IDENTIFIER -> r = ast.str-at(t, d.s0)

        k == asp.K-INTEGER-LITERAL -> r = ast.str-at(t, d.s0)

        k == asp.K-FLOAT-LITERAL -> r = ast.str-at(t, d.s0)

        k == asp.K-STRING-LITERAL -> r = ast.str-at(t, d.s0)

        k == asp.K-CHAR-LITERAL -> r = ast.str-at(t, d.s0)

        k == asp.K-BOOLEAN-LITERAL -> r = ast.str-at(t, d.s0)

        k == asp.K-NIL-LITERAL -> r = 'nil'

        -> r = asp.kind-name(k)
    }
}

; ═══════════════════════════════════════════════════════════════════
; typeString：型別摘要（等價於 dump.go 的 typeString → Type.String()）
; ═══════════════════════════════════════════════════════════════════
;
; ⚠️ 這與「型別子節點也要遞迴印出」是兩件事：標頭行需要摘要，
;    子節點行才是權威內容（§5.3.1 契約第 4 條）。
;
; ⚠️ 未列出的節點種類走 `default: fmt.Sprintf("%T", n)` ⇒ 印成
;    `*parser.<型別名>`。這對 UnionType 是**精確**的（typeString 的
;    switch 裡沒有 UnionType），且因為 kinds 表的名字就是 Go 的結構體名，
;    對任何未列出的種類都精確。
; t: 輸入
; i: 索引
; r: 結果字串
type-string = (t ast, i i64) (r str) {
    r = ''
    i <= 0 -> return
    d = ast.nd-at(t, i)
    d.kind <= 0 -> return
    k = d.kind
    {
        k == asp.K-NAMED-TYPE -> r = ast.str-at(t, d.s0)

        k == asp.K-SLICE-TYPE -> r = '[]' - ast.type-string(t, ast.kid-at(t, d.kid0))

        k == asp.K-ARRAY-TYPE -> {

            ; ArrayType.String()：Size == nil ⇒ "[?]"；否則 "[" + exprToString(Size) + "]"
            inner = '?'
            sz = ast.kid-at(t, d.kid0)
            sz > 0 -> inner = ast.expr-string(t, sz)

            #{overflow=wrap}
            r = '[' - inner - ']' - ast.type-string(t, ast.kid-at(t, d.kid0 + 1))
        }

        k == asp.K-MAP-TYPE -> {
            r = '[' - ast.type-string(t, ast.kid-at(t, d.kid0))

            #{overflow=wrap}
            r = r - ']' - ast.type-string(t, ast.kid-at(t, d.kid0 + 1))
        }

        k == asp.K-NULLABLE-TYPE -> r = '?' - ast.type-string(t, ast.kid-at(t, d.kid0))

        k == asp.K-POINTER-TYPE -> r = '*' - ast.type-string(t, ast.kid-at(t, d.kid0))

        k == asp.K-VIEW-TYPE -> r = '&' - ast.type-string(t, ast.kid-at(t, d.kid0))

        k == asp.K-FUNCTION-TYPE -> r = ast.fn-str(t, d)

        -> r = '*parser.' - asp.kind-name(k)
    }
}

; 等價於 parser.exprToString（ArrayType 的大小運算式）
; t: 輸入
; i: 索引
; r: 結果字串
expr-string = (t ast, i i64) (r str) {
    r = ''
    i <= 0 -> return
    d = ast.nd-at(t, i)
    k = d.kind
    {
        k == asp.K-INTEGER-LITERAL -> r = ast.str-at(t, d.s0)

        k == asp.K-IDENTIFIER -> r = ast.str-at(t, d.s0)

        k == asp.K-STRING-LITERAL -> {
            raw = ast.str-at(t, d.s1)
            raw.len-bytes() > 0 -> r = raw

            -> r = "'" - ast.str-at(t, d.s0) - "'"
        }

        k == asp.K-INFIX-EXPRESSION -> {
            folded = ast.fold-int(t, d)
            folded.len-bytes() > 0 -> r = folded

            -> {
                r = ast.expr-string(t, ast.kid-at(t, d.kid0))
                r = r - ' ' - ast.str-at(t, d.s0) - ' '

                #{overflow=wrap}
                r = r - ast.expr-string(t, ast.kid-at(t, d.kid0 + 1))
            }
        }

        -> {

            ; ⚠️ Go 的 default 是 fmt.Sprintf("%v", e)：結構體傾印，無法重現。
            #{overflow=wrap}
            t.gaps = t.gaps + 1
            r = '<expr?(' - asp.kind-name(k) - ')>'
        }
    }
}

; 等價於 parser.evalConstIntExpr。可折疊時回十進位字串，否則回 ''
;
; ⚠️ 用 '' 當「不可折疊」的哨兵是安全的：成功折疊的結果一律非空（連 "0" 也非空）。
; t: 輸入
; d: 輸入
; r: 結果字串
fold-int = (t ast, d nd) (r str) {
    r = ''
    l = ast.kid-at(t, d.kid0)

    #{overflow=wrap}
    rr = ast.kid-at(t, d.kid0 + 1)
    l <= 0 -> return
    rr <= 0 -> return
    ld = ast.nd-at(t, l)
    rd = ast.nd-at(t, rr)
    ld.kind != asp.K-INTEGER-LITERAL -> return
    rd.kind != asp.K-INTEGER-LITERAL -> return
    a = ast.str-at(t, ld.s0).to-i64()
    b = ast.str-at(t, rd.s0).to-i64()
    op = ast.str-at(t, d.s0)
    {
        op.eq-full('+') -> {

            #{overflow=wrap}
            r = ast.int-str(a + b)
        }

        op.eq-full('-') -> {

            #{overflow=wrap}
            r = ast.int-str(a - b)
        }

        op.eq-full('*') -> {

            #{overflow=wrap}
            r = ast.int-str(a * b)
        }

        op.eq-full('/') -> {
            b != 0 -> {

                #{overflow=wrap}
                r = ast.int-str(a / b)
            }
        }

        -> {
        }
    }
}

; i64 → 十進位字串（避免各處重複寫 `-` 的型別推斷問題）
; v: 值
; r: 結果字串
int-str = (v i64) (r str) {
    r = v.to-str()
}

; 等價於 FunctionType.String()
; t: 輸入
; d: 輸入
; r: 結果字串
fn-str = (t ast, d nd) (r str) {
    r = 'fn('
    np = d.c0
    base = d.kid0
    j = 0
    (j < np) {
        j > 0 -> r = r - ','

        #{overflow=wrap}
        r = r - ast.param-type(t, ast.kid-at(t, base + j))

        #{overflow=wrap}
        j = j + 1
    }
    r = r - ')'
    nr = d.c1
    nr > 0 -> {
        r = r - '('

        #{overflow=wrap}
        rb = base + np
        m = 0
        (m < nr) {
            m > 0 -> r = r - ','

            #{overflow=wrap}
            r = r - ast.param-type(t, ast.kid-at(t, rb + m))

            #{overflow=wrap}
            m = m + 1
        }
        r = r - ')'
    }
}

; Parameter.Type 的 typeString（Parameter 的第一個 CHILD 就是 Type）
; t: 輸入
; pi: 數值
; r: 結果字串
param-type = (t ast, pi i64) (r str) {
    r = ''
    pi <= 0 -> return
    p = ast.nd-at(t, pi)
    r = ast.type-string(t, ast.kid-at(t, p.kid0))
}

; ═══════════════════════════════════════════════════════════════════
; dump：解譯 asp.no 的指令帶
; ═══════════════════════════════════════════════════════════════════

; 走訪 root 子樹，回傳完整文字（**不帶**尾端換行，與 dump.go 相同）
; t: 輸入
; root: 數值
; r: 結果字串
dump = (t ast, root i64) (r str) {
    o = sb.init(4096)
    ast.node(t, o, root, 0)
    r = ast.trim-nl(o.str())
}

; 這次 dump 遇到幾個「尚未接線」的指令（0 ⇒ dump 可信）
; t: 輸入
; n: 數量
unsupported = (t ast) (n i64) {
    n = t.unsup
}

; 幾個「不可重現」的摘要分支被命中（不影響 unsup，但值得追）
; t: 輸入
; n: 數量
gaps = (t ast) (n i64) {
    n = t.gaps
}

; 印出節點 i 及其子樹
; t: 輸入
; o: 輸入
; i: 索引
; depth: 深度
node = (t ast, o sb, i i64, depth i64) {
    i <= 0 -> {
        ast.line(o, depth, '<nil>')
        return
    }
    d = ast.nd-at(t, i)
    d.kind <= 0 -> {
        ast.line(o, depth, '<nil>')
        return
    }
    first = ast.kind-f(t, d.kind, 1)
    num = ast.kind-f(t, d.kind, 2)

    #{overflow=wrap}
    last = first + num

    ; 預掃：把 CHILD / KIDS / SIG / HELPER 指到的節點索引依序收進 childs[]。
    ; OF-TYPE / OF-NODE-STRING 的純量在**標頭行**就要用到它們，
    ; 而 CHILD 指令排在標頭行之後 ⇒ 必須先掃一遍。
    childs []i64 = with-cap(8)
    cur = d.kid0
    cslot = 0
    j = 0
    (j < num) {

        #{overflow=wrap}
        op = ast.ins(t, first + j, 0)
        op == asp.OP-CHILD -> {
            childs.push(ast.kid-at(t, cur))

            #{overflow=wrap}
            cur = cur + 1
        }
        op == asp.OP-KIDS -> {

            #{overflow=wrap}
            cur = cur + ast.nd-c(d, cslot)

            #{overflow=wrap}
            cslot = cslot + 1
        }
        op == asp.OP-SIG -> {

            ; SIG 的三組節點（泛型參數 / 參數 / 回傳值）連續排在 kid 區
            #{overflow=wrap}
            cur = cur + d.c3

            #{overflow=wrap}
            cur = cur + d.c4

            #{overflow=wrap}
            cur = cur + d.c5
        }
        op == asp.OP-HELPER -> {

            #{overflow=wrap}
            cur = cur + d.hcount
        }

        -> {}

        #{overflow=wrap}
        j = j + 1
    }

    ; 主掃：逐指令輸出
    cur = d.kid0
    kslot = 0
    j = 0
    (j < num) {

        #{overflow=wrap}
        ins = first + j
        op = ast.ins(t, ins, 0)
        {
            op == asp.OP-HDR -> ast.header(t, o, d, ins, last, childs, depth)

            op == asp.OP-SCALAR -> {
            }

            op == asp.OP-COMMENTS -> ast.comments(t, o, d, depth)

            op == asp.OP-CHILD -> {
                v = ast.kid-at(t, cur)

                #{overflow=wrap}
                cur = cur + 1
                guard = ast.ins(t, ins, 2)
                {
                    v <= 0 -> {
                        guard == 0 -> {

                            #{overflow=wrap}
                            ast.line(o, depth + 1, '<nil>')
                        }

                        -> {
                        }
                    }

                    -> {

                        #{overflow=wrap}
                        ast.node(t, o, v, depth + 1)
                    }
                }
            }

            op == asp.OP-KIDS -> {
                n = ast.nd-c(d, kslot)
                skip = ast.ins(t, ins, 2)

                #{overflow=wrap}
                kslot = kslot + 1
                m = 0
                (m < n) {
                    v = ast.kid-at(t, cur)

                    #{overflow=wrap}
                    cur = cur + 1
                    {
                        v <= 0 -> {
                            skip == 0 -> {

                                #{overflow=wrap}
                                ast.line(o, depth + 1, '<nil>')
                            }

                            -> {
                            }
                        }

                        -> {

                            #{overflow=wrap}
                            ast.node(t, o, v, depth + 1)
                        }
                    }

                    #{overflow=wrap}
                    m = m + 1
                }
            }

            op == asp.OP-SIG -> {

                ; ⚠️ 子節點（泛型/參數/回傳）必須印在 depth+1：
                ;   dump.go FunctionDefinition(:281)/FunctionLiteral(:409) 皆 `d.signature(sig, depth+1)`，
                ;   signature() 內部再以它收到的 depth 渲染 `d.node(p, depth)` ⇒ 實際是 FD 本層的 depth+1。
                ;   先前誤傳 `depth` ⇒ 0 參數時不可見、≥1 參數時 Parameter 塌成 Program 同層兄弟。
                #{overflow=wrap}
                ast.signature(t, o, d, depth + 1)

                #{overflow=wrap}
                cur = cur + d.c3

                #{overflow=wrap}
                cur = cur + d.c4

                #{overflow=wrap}
                cur = cur + d.c5
            }

            op == asp.OP-HELPER -> {
                hname = ast.str-at(t, ast.ins(t, ins, 3))
                ast.helper(t, o, d, hname, cur, depth)

                #{overflow=wrap}
                cur = cur + d.hcount
            }

            op == asp.OP-FREE -> ast.free-comments(t, o, d, depth)

            op == asp.OP-BETWEEN -> ast.between-comments(t, o, d, depth)

            op == asp.OP-TRAILING -> ast.trailing-comments(t, o, d, depth)

            op == asp.OP-CLOSING -> ast.closing-comments(t, o, d, depth)

            op == asp.OP-IMPLEMENTS -> ast.implements(t, o, d, depth)

            op == asp.OP-ANNOTS -> {
            }

            -> {

                ; 尚未接線：計數，**不靜默略過**

                #{overflow=wrap}
                t.unsup = t.unsup + 1
            }
        }

        #{overflow=wrap}
        j = j + 1
    }
}

; ═══════════════════════════════════════════════════════════════════
; 註解
; ═══════════════════════════════════════════════════════════════════

; Doc: //… 與 Comment: //…
; ⚠️ commentGroupInline 只印群組的**第一條**註解（dump.go 的既有行為），
;    且**無條件**印 "//" + 首條文字 + 換行（dump.go:954-958）：
;    首條文字為空（裸 `;`）⇒ 輸出 "Doc: //" + 換行。
;    故 d.doc == -1（群組在、首條文字空）與 d.doc > 0 的差別只在「有沒有文字」，
;    "//" 與換行兩者都要印。
; t: 輸入
; o: 輸入
; d: 輸入
; depth: 深度
comments = (t ast, o sb, d nd, depth i64) {
    d.doc != 0 -> {

        #{overflow=wrap}
        ast.indent(o, depth + 1)
        o.push('Doc: ')
        o.push('//')
        o.push(ast.str-at(t, d.doc))
        o.push-byte(10)
    }
    d.cmt != 0 -> {

        #{overflow=wrap}
        ast.indent(o, depth + 1)
        o.push('Comment: ')
        o.push('//')
        o.push(ast.str-at(t, d.cmt))
        o.push-byte(10)
    }
}

; 功能待補充
; t: 輸入
; o: 輸入
; d: 輸入
; depth: 深度
free-comments = (t ast, o sb, d nd, depth i64) {
    d.free >= 0 -> {

        #{overflow=wrap}
        ast.indent(o, depth + 1)
        o.push('FreeComments: ')
        o.push(d.free.to-str())
        o.push(' group(s)')
        o.push-byte(10)
    }
}

; 判斷區間 comments
; t: 輸入
; o: 輸入
; d: 輸入
; depth: 深度
between-comments = (t ast, o sb, d nd, depth i64) {
    d.btw >= 0 -> {

        #{overflow=wrap}
        ast.indent(o, depth + 1)
        o.push('BetweenComments: ')
        o.push(d.btw.to-str())
        o.push(' group(s)')
        o.push-byte(10)
    }
}

; trailing / closing：aux[ct0 .. ct0+ntrail) 與 aux[ct0+ntrail .. +nclos)
; t: 輸入
; o: 輸入
; d: 輸入
; depth: 深度
trailing-comments = (t ast, o sb, d nd, depth i64) {
    d.ntrail >= 0 -> {

        #{overflow=wrap}
        ast.indent(o, depth + 1)
        o.push('TrailingComments')
        o.push-byte(10)
        j = 0
        (j < d.ntrail) {

            #{overflow=wrap}
            ast.indent(o, depth + 2)
            o.push('//')

            #{overflow=wrap}
            o.push(ast.str-at(t, ast.aux-at(t, d.ct0 + j)))
            o.push-byte(10)

            #{overflow=wrap}
            j = j + 1
        }
    }
}

; 功能待補充
; t: 輸入
; o: 輸入
; d: 輸入
; depth: 深度
closing-comments = (t ast, o sb, d nd, depth i64) {
    d.nclos >= 0 -> {

        #{overflow=wrap}
        ast.indent(o, depth + 1)
        o.push('ClosingBraceComment')
        o.push-byte(10)
        base = d.ct0
        d.ntrail > 0 -> {

            #{overflow=wrap}
            base = d.ct0 + d.ntrail
        }
        j = 0
        (j < d.nclos) {

            #{overflow=wrap}
            ast.indent(o, depth + 2)
            o.push('//')

            #{overflow=wrap}
            o.push(ast.str-at(t, ast.aux-at(t, base + j)))
            o.push-byte(10)

            #{overflow=wrap}
            j = j + 1
        }
    }
}

; InterfaceDefinition.Implements []string，Go 端用 %v ⇒ "[a b c]"
; t: 輸入
; o: 輸入
; d: 輸入
; depth: 深度
implements = (t ast, o sb, d nd, depth i64) {
    d.nimp > 0 -> {

        #{overflow=wrap}
        ast.indent(o, depth + 1)
        o.push('Implements: [')
        base = d.ct0
        d.ntrail > 0 -> {

            #{overflow=wrap}
            base = base + d.ntrail
        }
        d.nclos > 0 -> {

            #{overflow=wrap}
            base = base + d.nclos
        }
        j = 0
        (j < d.nimp) {
            j > 0 -> o.push(' ')

            #{overflow=wrap}
            o.push(ast.str-at(t, ast.aux-at(t, base + j)))

            #{overflow=wrap}
            j = j + 1
        }
        o.push(']')
        o.push-byte(10)
    }
}

; ═══════════════════════════════════════════════════════════════════
; 共用子結構
; ═══════════════════════════════════════════════════════════════════

; FunctionDefinition / FunctionLiteral 的參數與回傳值區塊。
;
; ⚠️ 注意這裡的子節點印在 **depth**（不是 depth+1），與 dump.go 一致。
; ⚠️ 泛型參數是 `[]*Identifier`，只印**名字**（不當節點遞迴）；
;    nil 元素被跳過，且分隔符以「已附加的個數」為準（= strings.Join 語意）。
; t: 輸入
; o: 輸入
; d: 輸入
; depth: 深度
signature = (t ast, o sb, d nd, depth i64) {
    base = d.kid0
    d.c3 > 0 -> {
        ast.indent(o, depth)
        o.push('GenericParams: ')
        j = 0
        k = 0
        (j < d.c3) {

            #{overflow=wrap}
            v = ast.kid-at(t, base + j)
            v > 0 -> {
                k > 0 -> o.push(', ')
                o.push(ast.node-string(t, v))

                #{overflow=wrap}
                k = k + 1
            }

            #{overflow=wrap}
            j = j + 1
        }
        o.push-byte(10)
    }
    d.varflag != 0 -> {
        ast.indent(o, depth)
        o.push('Variadic{')
        u = ast.str-at(t, d.varunion)
        u.len-bytes() > 0 -> {
            o.push('union: ')
            o.push(u)
        }
        o.push('}')
        o.push-byte(10)
    }

    #{overflow=wrap}
    p0 = base + d.c3
    j = 0
    (j < d.c4) {

        #{overflow=wrap}
        v = ast.kid-at(t, p0 + j)
        v > 0 -> ast.node(t, o, v, depth)

        #{overflow=wrap}
        j = j + 1
    }

    #{overflow=wrap}
    r0 = p0 + d.c4
    j = 0
    (j < d.c5) {

        #{overflow=wrap}
        v = ast.kid-at(t, r0 + j)
        v > 0 -> ast.node(t, o, v, depth)

        #{overflow=wrap}
        j = j + 1
    }
}

; 分派非 Node 的子結構（dump.go 的 (*dumper).helper）
;
; ⚠️ 已接線 taggedEnumField（TaggedEnumVariant.Fields）、matchArm（SurfaceMatch.Arms）
;    與 interfaceMethod（InterfaceDefinition）。annotationStructField
;    （AnnotationStructValue）尚未接線，會計入 .unsup。
;
; 元素編碼（**依 hname 而異**，兩支互不衝突）：
;   taggedEnumField: 2 個 aux 值 / 元素
;       aux[hbase + 2j]     = name 的 str id
;       aux[hbase + 2j + 1] = Type 節點索引（0 = 無 Type，-1 = 元素本身為 nil）
;   matchArm:        12 個 aux 值 / 臂（見下方 s66 註解）
; t: 輸入
; o: 輸入
; d: 輸入
; hname: 字串
; base: 基準值
; depth: 深度
helper = (t ast, o sb, d nd, hname str, base i64, depth i64) {

    ; s66：matchArm —— SurfaceMatch 的臂。MatchArm **不是 Node**
    ;   （dump.go:876-877 明言：非 Node、無 dumpNode case、只經 SurfaceMatch 的
    ;   HELPER 到達）⇒ 資料全部走 aux，不佔 kid 區。
    ;   ⚠️ 元素寬度 12（taggedEnumField 是 2）：4 個字串 + 6 個 bool + 2 個節點索引。
    ;      因只有 SurfaceMatch 用 matchArm，按 hname 分派不會與 2-值編碼衝突；
    ;      HELPER 是 SurfaceMatch 的最後一條指令，故「cur += hcount」的過度前進
    ;      不影響任何後續輸出（無需改動 hcount/hbase 預掃）。
    ;   欄位順序與 Go dump.go:888-895 的 fields(...) **逐項一致**：
    ;      wildcard, dotVal, rawCond, blockBody, typeArm, typePattern, typeBinding,
    ;      skipIt, valueCtx 為可選（kvb/kvs，非預設值才印）；
    ;      binding, bindingVariant 為恆印（kv，空值也印成 `binding: `）。
    ;   ⚠️ multiOption / multiValue / bindingNames / bindingFields 在 653 檔語料
    ;      中**零命中**（見 nolang-selfhost.md §5.3.4 的欄位普查），本支未接線。
    ;   ⚠️ bool 以字串 'true' / ''（str id 0）表示——nolang 無位元運算，走字串最簡。
    hname.eq-full('matchArm') -> {
        j = 0
        (j < d.hcount) {

            #{overflow=wrap}
            hb = d.hbase + 12 * j

            mbind = ast.str-at(t, ast.aux-at(t, hb))

            #{overflow=wrap}
            mbvar = ast.str-at(t, ast.aux-at(t, hb + 1))

            #{overflow=wrap}
            mtpat = ast.str-at(t, ast.aux-at(t, hb + 2))

            #{overflow=wrap}
            mtbnd = ast.str-at(t, ast.aux-at(t, hb + 3))

            #{overflow=wrap}
            mwild = ast.str-at(t, ast.aux-at(t, hb + 4))

            #{overflow=wrap}
            mdot = ast.str-at(t, ast.aux-at(t, hb + 5))

            #{overflow=wrap}
            mraw = ast.str-at(t, ast.aux-at(t, hb + 6))

            #{overflow=wrap}
            mblk = ast.str-at(t, ast.aux-at(t, hb + 7))

            #{overflow=wrap}
            mtarm = ast.str-at(t, ast.aux-at(t, hb + 8))

            #{overflow=wrap}
            mvctx = ast.str-at(t, ast.aux-at(t, hb + 9))

            #{overflow=wrap}
            mcond = ast.aux-at(t, hb + 10)

            #{overflow=wrap}
            mbody = ast.aux-at(t, hb + 11)

            ast.indent(o, depth + 1)
            o.push('MatchArm{')
            mfirst = 1
            mwild.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('wildcard: ')
                o.push(mwild)
                mfirst = 0
            }
            mdot.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('dotVal: ')
                o.push(mdot)
                mfirst = 0
            }
            mraw.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('rawCond: ')
                o.push(mraw)
                mfirst = 0
            }
            mblk.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('blockBody: ')
                o.push(mblk)
                mfirst = 0
            }
            mtarm.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('typeArm: ')
                o.push(mtarm)
                mfirst = 0
            }
            mtpat.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('typePattern: ')
                o.push(mtpat)
                mfirst = 0
            }
            mtbnd.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('typeBinding: ')
                o.push(mtbnd)
                mfirst = 0
            }
            mvctx.len-bytes() > 0 -> {
                mfirst == 0 -> o.push(', ')
                o.push('valueCtx: ')
                o.push(mvctx)
                mfirst = 0
            }

            ; binding / bindingVariant 恆印（kv），空值也印成 `binding: `
            mfirst == 0 -> o.push(', ')
            o.push('binding: ')
            o.push(mbind)
            o.push(', ')
            o.push('bindingVariant: ')
            o.push(mbvar)
            o.push('}')
            o.push-byte(10)

            ; 子節點：Go 是 Condition 先、Body 後，皆 depth+1（相對臂 = depth+2）
            mcond > 0 -> ast.node(t, o, mcond, depth + 2)
            mbody > 0 -> ast.node(t, o, mbody, depth + 2)

            #{overflow=wrap}
            j = j + 1
        }
    }

    hname.eq-full('taggedEnumField') -> {
        j = 0
        (j < d.hcount) {

            #{overflow=wrap}
            nm = ast.str-at(t, ast.aux-at(t, d.hbase + 2 * j))

            #{overflow=wrap}
            ty = ast.aux-at(t, d.hbase + 2 * j + 1)
            ty < 0 -> {

                #{overflow=wrap}
                ast.line(o, depth + 1, '<nil>')
            }

            -> {

                #{overflow=wrap}
                ast.indent(o, depth + 1)
                o.push('TaggedEnumField{name: ')
                o.push(nm)
                ts = ast.type-string(t, ty)
                ts.len-bytes() > 0 -> {
                    o.push(', type: ')
                    o.push(ts)
                }
                o.push('}')
                o.push-byte(10)
                ty > 0 -> {

                    #{overflow=wrap}
                    ast.node(t, o, ty, depth + 2)
                }
            }

            #{overflow=wrap}
            j = j + 1
        }
    }

    hname.eq-full('interfaceMethod') -> {

        ; interfaceMethod（InterfaceDefinition 的方法）—— **不是 Node**
        ;   （Go dump.go:837-849：d.interfaceMethod 單獨印，不經 node switch）
        ;   ⇒ 資料全部走 aux；參數／回傳的**節點索引**也走 aux（節點本身在 arena）。
        ;   aux 編碼（寬度 5，見 ps-parse-iface-def）：
        ;     [0] name / [1] receiver / [2] variadic('true'/'') / [3] genericReceiver
        ;     [4] 該方法的節點數（參數 + 回傳）
        ;   節點索引段緊接在 helper 區之後：起點 = hbase + 5 * hcount。
        ;   ⚠️ 欄位順序與 Go dump.go:842-843 的 fields(...) 逐項一致：
        ;     name 恆印；receiver 非空才印；variadic / genericReceiver 為 true 才印。
        ;   ⚠️ 參數與回傳**不分組**，都印在 depth+2（InterfaceMethod 印在 depth+1，
        ;     見 dump.go:845-850 的 d.node(p, depth+1) —— 該處的 depth 已是
        ;     InterfaceDefinition.depth+1）。
        j = 0
        off = 0
        seg-b = d.hbase + 5 * d.hcount
        (j < d.hcount) {

            #{overflow=wrap}
            hb = d.hbase + 5 * j

            imnm = ast.str-at(t, ast.aux-at(t, hb))

            #{overflow=wrap}
            imrc = ast.str-at(t, ast.aux-at(t, hb + 1))

            #{overflow=wrap}
            imva = ast.str-at(t, ast.aux-at(t, hb + 2))

            #{overflow=wrap}
            imgr = ast.str-at(t, ast.aux-at(t, hb + 3))

            #{overflow=wrap}
            impc = ast.aux-at(t, hb + 4)

            ast.indent(o, depth + 1)
            o.push('InterfaceMethod{name: ')
            o.push(imnm)
            imrc.len-bytes() > 0 -> {
                o.push(', receiver: ')
                o.push(imrc)
            }
            imva.eq-full('true') -> o.push(', variadic: true')
            imgr.eq-full('true') -> o.push(', genericReceiver: true')
            o.push('}')
            o.push-byte(10)

            k = 0
            (k < impc) {

                #{overflow=wrap}
                v = ast.aux-at(t, seg-b + off + k)
                v > 0 -> ast.node(t, o, v, depth + 2)

                #{overflow=wrap}
                k = k + 1
            }

            #{overflow=wrap}
            off = off + impc

            #{overflow=wrap}
            j = j + 1
        }
    }

    -> {

        #{overflow=wrap}
        t.unsup = t.unsup + 1
    }
}

; ═══════════════════════════════════════════════════════════════════
; 標頭行與純量
; ═══════════════════════════════════════════════════════════════════

; 印一條 OP-HDR 指令（含其後緊跟的 OP-SCALAR 指令）
;
; ⚠️ SCALAR 的掃描必須**以本種類的指令範圍 last 為界**，不能只靠
;    「下一條是不是 OP-SCALAR」——那會在跨越種類邊界時誤吞下一種的指令。
; t: 輸入
; o: 輸入
; d: 輸入
; ins: 數值
; last: 數值
; childs: 容器
; depth: 深度
header = (t ast, o sb, d nd, ins i64, last i64, childs []i64, depth i64) {
    name = ast.str-at(t, ast.ins(t, ins, 1))
    braces = ast.ins(t, ins, 2)
    nof = ast.ins(t, ins, 3)
    absent = ast.str-at(t, ast.ins(t, ins, 4))

    ast.indent(o, depth)
    o.push(name)
    braces == 0 -> {
        o.push-byte(10)
        return
    }
    o.push('{')
    nof > 0 -> {

        ; 標頭內容是「某個子節點的行內摘要」；nil 時改用 absent

        #{overflow=wrap}
        v = ast.child-at(t, childs, nof - 1)
        v <= 0 -> o.push(absent)

        -> o.push(ast.node-string(t, v))
    }

    -> {

        ; ⚠️ 分隔符必須寫在**值之前**，所以 scalar 回傳文字而不是直接寫進 o。
        ;    早期版本先寫值、再推 ", "，結果每個節點都變成
        ;    `IntegerLiteral{value: 42raw: 42, }`（逗號全部右移一格）。
        sep = ''
        k = ins

        #{overflow=wrap}
        k = k + 1
        (k < last) {
            ast.ins(t, k, 0) == asp.OP-SCALAR -> {
                shown, txt = ast.scalar(t, d, k, childs)
                shown == 1 -> {
                    o.push(sep)
                    o.push(txt)
                    sep = ', '
                }

                #{overflow=wrap}
                k = k + 1
            }

            -> break
        }
    }
    o.push('}')
    o.push-byte(10)
}

; 渲染第 k 條 OP-SCALAR 指令，回傳 (是否印出, 文字)
;
; 指令欄位：(op, policy, render, of, label-id | ref<<24)
; t: 輸入
; d: 輸入
; k: 索引
; childs: 容器
; shown: 結果數值
; text: 結果字串
scalar = (t ast, d nd, k i64, childs []i64) (shown i64, text str) {
    shown = 0
    text = ''
    pol = ast.ins(t, k, 1)
    ren = ast.ins(t, k, 2)
    of = ast.ins(t, k, 3)
    ddd = ast.ins(t, k, 4)

    #{overflow=wrap}
    ref = ddd / 16777216

    #{overflow=wrap}
    label = ast.str-at(t, ddd - ref * 16777216)
    val = ''
    {
        of == asp.OF-TYPE -> val = ast.type-string(t, ast.child-at(t, childs, ref))

        of == asp.OF-NODE-STRING -> val = ast.node-string(t, ast.child-at(t, childs, ref))

        of == asp.OF-LOCAL -> {
            ren == asp.R-NODE-STRING -> {
                v = ast.child-at(t, childs, ref)
                v <= 0 -> val = ''

                -> val = ast.node-string(t, v)
            }

            -> val = ast.str-at(t, ast.nd-s(d, ref))
        }

        -> val = ast.str-at(t, ast.nd-s(d, ref))
    }
    shown = ast.wanted(pol, val)
    shown == 1 -> {
        b = sb.init(32)
        label.len-bytes() > 0 -> {
            b.push(label)
            b.push(': ')
        }
        b.push(val)
        text = b.str()
    }
}

; 純量印出政策（dump.go 的 kv / kvs / kvb / kvn / kvc）
; pol: 數值
; val: 值
; yes: 是否成立
wanted = (pol i64, val str) (yes i64) {
    yes = 1
    {
        pol == asp.P-NON-EMPTY -> {
            yes = 0
            val.len-bytes() > 0 -> yes = 1
        }

        pol == asp.P-TRUE -> {
            yes = 0
            val.eq-full('true') -> yes = 1
        }

        pol == asp.P-NON-ZERO -> {
            yes = 0
            val.eq-full('0') -> {}

            -> yes = 1
        }

        pol == asp.P-COUNT -> {
            yes = 0
            val.eq-full('0') -> {}

            -> yes = 1
        }

        -> {
        }
    }
}

; [TEST] 結構體參數數量實驗
; a: 運算元
; r: 結果數值
one-ast = (a ast) (r i64) {
    r = 0
}

; 功能待補充
; a: 運算元
; b: 運算元
; r: 結果數值
two-ast = (a ast, b ast) (r i64) {
    r = 0
}
