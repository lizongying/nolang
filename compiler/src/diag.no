; diag — 診斷模型
;
; 對齊 no 的兩種輸出形狀（見 docs/design/nolang-selfhost.md §5.4）：
;   面向使用者：<file>:<line>:<col>: [LEVEL] <source>: <message> [<code>]
;   中間串    ：<channel>: [<file>: ]line L, column C: <message> [<code>]
;
; ⚠️ line / col 從 1 開始（1-based）。
; ⚠️ code 是 8 字元 base36 TraceID；M0 尚未接上生成器，先用固定佔位。

LEVEL-HINT = 0
LEVEL-WARNING = 1
LEVEL-ERROR = 2

diag {
    file str
    line i64
    col i64
    level i64
    src str
    msg str
    code str
}

; 診斷級別的名稱
diag.level-name = () (r str) {
    {
        .level == LEVEL-ERROR -> r = 'ERROR'
        .level == LEVEL-WARNING -> r = 'WARNING'
        -> r = 'HINT'
    }
}

; 面向使用者的單行輸出
; Authority：Go printLintResults（src/cmd/no/main.go）只有兩種行形：
;   line > 0  ⇒ <file>:<line>:<col>: [LEVEL] <src>: <msg> [<code>]
;   line == 0 ⇒ <file>: [LEVEL] <src>: <msg> [<code>]   （檔案級診斷，無位置）
diag.render = () (r str) {
    head str = ''
    {
        .line > 0 -> {
            head = .file + ':' + .line.to-str() + ':' + .col.to-str() + ': '
        }

        -> {
            head = .file + ': '
        }
    }
    r = head + '[' + .level-name() + '] ' + .src + ': ' + .msg + ' [' + .code + ']'
}

; 中間編譯錯誤串的一條（無檔名前綴）
diag.render-mid = () (r str) {
    r = 'line ' + .line.to-str() + ', column ' + .col.to-str() + ': ' + .msg + ' [' + .code + ']'
}
