; cg-runtime — LLVM IR 运行期 prelude（M4-a 骨架）
;
; Authority：src/mir/codegen.go emitPrelude（%nolang_hdr / %task 类型块 +
;   @malloc/@free 声明）。照抄策略见 docs/design/nolang-selfhost.md §5.6.2：
;   IR 文本可逐字节照抄，不重新设计 ABI。
;
; ⚠️ IR 注释内引用标识符一律用双引号，不用反引号（nolang 的 ``` 会终止字面量）。
; ⚠️ 本模块刻意【惰性】：目前只被 compiler/tests/cg-runtime-test.no 引用，
;    尚未接入任何真实发射路径（M4-b 起由 cg.no 消费）。

# /compiler/src/util/sb.sb
# /compiler/src/cg-rc
# /compiler/src/mir
# /compiler/src/ix

; ty-name：型别码 → LLVM 型名。**全库唯一**的一份映射（s32 从 cg.no 迁到这里：
;   struct 型别声明也要用它，而声明属于模块级装配点，不能反向依赖发射器）。
;   i64 / %str-long / %vec / %option / %struct.s<结构体 id>。
; t: 數值
; s: 結果字串
cg-runtime-ty-name = (t i64) (s str) {
    s = 'i64'
    t == TY-STR -> s = '%str-long'
    t == TY-VEC -> s = '%vec'

    ; 切片 B：[]str 与 []i64 在 LLVM 层同为 %vec（元素 stride 由助手决定）
    t == TY-VECSTR -> s = '%vec'

    ; s162：[]结构体 与 []i64／[]str 在 LLVM 层同为 %vec（描述符与元素型别无关）
    ; s175：TY-SVEC-BASE + sid —— 同樣是 %vec 描述符（元素型別編在型別碼裡）
    t == TY-VECSTRUCT -> s = '%vec'
    t >= TY-SVEC-BASE && t < TY-STRUCT-BASE -> s = '%vec'
    t == TY-OPT -> s = '%option'
    t == TY-F64 -> s = 'double'
    t >= TY-STRUCT-BASE -> s = '%struct.s' - (t - TY-STRUCT-BASE).to-str()
}

; hdr-type：16 字节头类型。rc@base+0，magic@base+8，data=base+16。
; r: 結果字串
cg-runtime-hdr-type = () (r str) {
    r = '%nolang_hdr = type { i64, i64 }'
}

; task-type：协程任务（32 字节）。
; r: 結果字串
cg-runtime-task-type = () (r str) {
    r = '%task = type { void (i8*)*, i64, i1, i1, i8* }'
}

; str-type：字符串（u32 len, u32 cap, data）。与 Go emitPrelude 的 %str-long 逐字相同。
; ⚠️ B28（2026-11-11 後端變更）：len/cap 由 i64 縮成 u32 ⇒ 描述子從 24B 變 16B，
;   但**外部 API 仍是 i64**：所有讀寫邊界都要 zext i32→i64 / trunc i64→i32（見 cg.no）。
; r: 結果字串
cg-runtime-str-type = () (r str) {
    r = '%str-long = type { i32, i32, i8* }   ; u32 len, u32 cap, data (16B); external API stays i64'
}

; decls：libc 外部声明。
; r: 結果字串
cg-runtime-decls = () (r str) {
    r = 'declare i8* @malloc(i64)\ndeclare void @free(i8*)\ndeclare i64 @write(i32, i8*, i64)\ndeclare i64 @strlen(i8*)\ndeclare i32 @stat(i8*, i8*)\ndeclare i32 @getpid()\n'
}

; memcpy-decl：llvm.memcpy 声明（Go codegen.go:2987 同形）。
; r: 結果字串
cg-runtime-memcpy-decl = () (r str) {
    r = 'declare void @llvm.memcpy.p0i8.p0i8.i64(i8*, i8*, i64, i1)'
}

; memcmp-decl：libc memcmp 声明（Go @str_eq 字节比较所用，codegen.go:3129 同形）。
; r: 結果字串
cg-runtime-memcmp-decl = () (r str) {
    r = 'declare i32 @memcmp(i8*, i8*, i64)'
}

; str-eq：@str_eq —— %str-long 结构相等（Go emitPrelude 的 @str_eq 逐字）。
;   两串相等 iff 长度相同且字节相同（memcmp==0）；绝不对 struct 本体发 icmp（非法）。
;   MIR OP-STEREQ 降级到此调用。2 空格缩进（与 Go 该处一致，非 tab）。
;   依赖 @memcmp（cg-runtime-memcmp-decl）；不依赖 RC。
; ⚠️ B28：len 欄是 u32 ⇒ 先 extractvalue 到 i32 暫存（%la.i32/%lb.i32），再 zext 回 i64
;   才能發 icmp eq i64 與 memcmp(i64 len)。不可直接拿 i32 當 i64 用。
; r: 結果字串
cg-runtime-str-eq = () (r str) {
    b = sb.init(768)
    b.push('define i1 @str_eq(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %lb.i32 = extractvalue %str-long %b, 0\n')
    b.push('  %lb = zext i32 %lb.i32 to i64\n')
    b.push('  %lenEq = icmp eq i64 %la, %lb\n')
    b.push('  br i1 %lenEq, label %cmpto, label %noteq\n')
    b.push('cmpto:\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  %db = extractvalue %str-long %b, 2\n')
    b.push('  %cmp = call i32 @memcmp(i8* %da, i8* %db, i64 %la)\n')
    b.push('  %same = icmp eq i32 %cmp, 0\n')
    b.push('  br label %done\n')
    b.push('noteq:\n')
    b.push('  br label %done\n')
    b.push('done:\n')
    b.push('  %res = phi i1 [ 0, %noteq ], [ %same, %cmpto ]\n')
    b.push('  ret i1 %res\n')
    b.push('}\n')
    r = b.str()
}

; vec-eq：@__nolang_vec_eq_i64 —— 两个 %vec（元素 i64）按内容深度相等（Go vecDeepEq 的 i64 分支逐字）。
; %vec = { u32 len, u32 cap, i64 data }（16B）；data 存为整数地址，故先 inttoptr 还原为 i8*。
; 先比 len，len 相等才 memcmp(data,data,len*8)（空向量 bytes=0，memcmp 不解引用，null 也安全）。
; len 是 u32 ⇒ 取用前 zext 到 i64（比较与字节数都以 i64 为准）。
; 依赖 @memcmp（cg-runtime-memcmp-decl，s42 已声明）。
; r: 結果字串
cg-runtime-vec-eq = () (r str) {
    b = sb.init(768)
    b.push('define i1 @__nolang_vec_eq_i64(%vec %a, %vec %b) {\n')
    b.push('entry:\n')
    b.push('  %la32 = extractvalue %vec %a, 0\n')
    b.push('  %lb32 = extractvalue %vec %b, 0\n')
    b.push('  %la = zext i32 %la32 to i64\n')
    b.push('  %lb = zext i32 %lb32 to i64\n')
    b.push('  %leneq = icmp eq i64 %la, %lb\n')
    b.push('  br i1 %leneq, label %cmp, label %no\n')
    b.push('cmp:\n')
    b.push('  %da = extractvalue %vec %a, 2\n')
    b.push('  %db = extractvalue %vec %b, 2\n')
    b.push('  %pa = inttoptr i64 %da to i8*\n')
    b.push('  %pb = inttoptr i64 %db to i8*\n')
    b.push('  %bytes = mul i64 %la, 8\n')
    b.push('  %mr = call i32 @memcmp(i8* %pa, i8* %pb, i64 %bytes)\n')
    b.push('  %same = icmp eq i32 %mr, 0\n')
    b.push('  ret i1 %same\n')
    b.push('no:\n')
    b.push('  ret i1 false\n')
    b.push('}\n')
    r = b.str()
}

; div-zero-msg：@nolang_msg_div_zero —— 整數除零診斷串（Go divZeroMsgText 逐字，85 位元組，
;   含結尾 \n）：private unnamed_addr constant，供 div-zero-report helper 取址寫 stderr。
;   ⚠️ 用單引號串 + 雙反斜杠（\6E 寫成 \\6E）——fmt 會清空含反斜杠的反引號原始串；\ 在單引號串內轉義成字面反斜杠。
; r: 結果字串（不含結尾換行，由 prelude-full 補 \n）
cg-runtime-div-zero-msg = () (r str) {
    r = '@nolang_msg_div_zero = private unnamed_addr constant [85 x i8] c"\\6E\\6F\\6C\\61\\6E\\67\\3A\\20\\69\\6E\\74\\65\\67\\65\\72\\20\\64\\69\\76\\69\\73\\69\\6F\\6E\\20\\6F\\72\\20\\72\\65\\6D\\61\\69\\6E\\64\\65\\72\\20\\62\\79\\20\\7A\\65\\72\\6F\\20\\28\\74\\68\\65\\20\\64\\69\\76\\69\\73\\6F\\72\\20\\69\\73\\20\\30\\3B\\20\\72\\65\\73\\75\\6C\\74\\20\\66\\6F\\72\\63\\65\\64\\20\\74\\6F\\20\\30\\29\\0A"'
}

; div-zero-report：@__nolang_div_zero_report(i1 %bad) —— %bad 為真時把除零診斷寫到 stderr（fd 2）。
;   與 Go divZeroReport 同形：呼叫方只需發單條 call，不切斷其所在基本塊（故做 helper 而非 inline 分支）。
;   依賴 @write（cg-runtime-decls）與 @nolang_msg_div_zero（cg-runtime-div-zero-msg）。
; r: 結果字串
cg-runtime-div-zero-report = () (r str) {
    b = sb.init(512)
    b.push('define void @__nolang_div_zero_report(i1 %bad) {\n')
    b.push('entry:\n')
    b.push('  br i1 %bad, label %report, label %done\n')
    b.push('report:\n')
    b.push('  call i64 @write(i32 2, i8* getelementptr inbounds ([85 x i8], [85 x i8]* @nolang_msg_div_zero, i64 0, i64 0), i64 85)\n')
    b.push('  br label %done\n')
    b.push('done:\n')
    b.push('  ret void\n')
    b.push('}\n')
    r = b.str()
}

; str-concat：@str_concat —— 堆上拼接两个 %str-long（Go emitPrelude 的 @str_concat 逐字）。
; 2 空格缩进（与 Go 该处一致，不是 tab）；依赖 @nolang_rc_alloc（见 cg-rc.no）。
; ⚠️ B28：len 欄 u32 ⇒ 讀出後 zext i32→i64 才做 add/memcpy；寫回描述子前
;   trunc i64 %total→i32，且聚合常數改 { i32 0, i32 0, i8* null }。
; r: 結果字串
cg-runtime-str-concat = () (r str) {
    b = sb.init(1024)
    b.push('define %str-long @str_concat(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %lb.i32 = extractvalue %str-long %b, 0\n')
    b.push('  %lb = zext i32 %lb.i32 to i64\n')
    b.push('  %total = add i64 %la, %lb\n')
    b.push('  %buf = call i8* @nolang_rc_alloc(i64 %total)\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %buf, i8* %da, i64 %la, i1 0)\n')
    b.push('  %db = extractvalue %str-long %b, 2\n')
    b.push('  %dst2 = getelementptr i8, i8* %buf, i64 %la\n')
    b.push('  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %dst2, i8* %db, i64 %lb, i1 0)\n')
    b.push('  %r0.i32 = trunc i64 %total to i32\n')
    b.push('  %r0 = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %r0.i32, 0\n')
    b.push('  %r1.i32 = trunc i64 %total to i32\n')
    b.push('  %r1 = insertvalue %str-long %r0, i32 %r1.i32, 1\n')
    b.push('  %r2 = insertvalue %str-long %r1, i8* %buf, 2\n')
    b.push('  ret %str-long %r2\n}\n')
    r = b.str()
}

; str-cp-len：@str_cp_len —— UTF-8 码点数（s135）。
;   语义 = std str.len（src/std/str.no:47）= .cp-index(.len-bytes())：数「b < 0x80 或
;   (b & 0xc0) == 0xc0」的字节（即首字节个数 = 码点数），与 s[i] 的码点索引语义一致。
;   Go 后端把 str.len 编成 .cp-index 循环（emitStrCpIndex 是 s[i] 的【读】，非计数）
;   ⇒ 无原语可组，故走 helper。纯计算、不分配、无 libc 依赖。
;   ⚠️ phi 的 incoming 块必须真实是前驱：loop 的前驱是 entry 与 body（body 末尾 br loop）。
; r: 结果字串
cg-runtime-str-cp-len = () (r str) {
    b = sb.init(1024)
    b.push('define i64 @str_cp_len(%str-long %s) {\n')
    b.push('entry:\n')
    b.push('  %len.i32 = extractvalue %str-long %s, 0\n')
    b.push('  %len = zext i32 %len.i32 to i64\n')
    b.push('  %data = extractvalue %str-long %s, 2\n')
    b.push('  br label %loop\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %entry ], [ %inext, %body ]\n')
    b.push('  %n = phi i64 [ 0, %entry ], [ %nnext, %body ]\n')
    b.push('  %go = icmp slt i64 %i, %len\n')
    b.push('  br i1 %go, label %body, label %done\n')
    b.push('body:\n')
    b.push('  %p = getelementptr i8, i8* %data, i64 %i\n')
    b.push('  %b = load i8, i8* %p\n')
    b.push('  %bw = zext i8 %b to i64\n')
    b.push('  %lo = icmp slt i64 %bw, 128\n')
    b.push('  %and = and i64 %bw, 192\n')
    b.push('  %hi = icmp eq i64 %and, 192\n')
    b.push('  %inc = or i1 %lo, %hi\n')
    b.push('  %nadd = add i64 %n, 1\n')
    b.push('  %nnext = select i1 %inc, i64 %nadd, i64 %n\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('done:\n')
    b.push('  ret i64 %n\n')
    b.push('}\n')
    r = b.str()
}

; s158：str 子串四件套的執行期助手（OP-STRPREF / OP-STRSUFF / OP-STRCTNS / OP-STRIDX）。
;   语义逐字鏡像 src/std/str.no 的 str.starts-with(:460) / str.ends-with(:481) /
;   str.contains(:450) / str.index(:420)——全部【純計算、不分配、無 RC】。
;   ⚠️ 共用內核 @str_find_byte：scan i ∈ [0, n-m]，逐元比對 target；空 target 回 0
;      （鏡像 find-byte-from 的 `target.len-bytes() == 0 → r-from <= n → pos = r-from`，
;       r-from 恒 0 ⇒ 回 0；非空則等價首次命中，與 Sunday 算法結果相同）。
;   ⚠️ B28：len 欄 u32 ⇒ 讀出後 zext i32→i64 才做 icmp / gep 偏移。
; r: 結果字串
cg-runtime-str-find-byte = () (r str) {
    b = sb.init(1536)
    b.push('define i64 @str_find_byte(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %lb.i32 = extractvalue %str-long %b, 0\n')
    b.push('  %lb = zext i32 %lb.i32 to i64\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  %db = extractvalue %str-long %b, 2\n')
    b.push('  %m0 = icmp eq i64 %lb, 0\n')
    b.push('  br i1 %m0, label %empty, label %chk\n')
    b.push('empty:\n')
    b.push('  ret i64 0\n')
    b.push('chk:\n')
    b.push('  %nge = icmp sge i64 %la, %lb\n')
    b.push('  br i1 %nge, label %loop, label %nofind\n')
    b.push('nofind:\n')
    b.push('  ret i64 -1\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %chk ], [ %inext, %next ]\n')
    b.push('  %limit = sub i64 %la, %lb\n')
    b.push('  %go = icmp sle i64 %i, %limit\n')
    b.push('  br i1 %go, label %body, label %nofind\n')
    b.push('body:\n')
    b.push('  %j = phi i64 [ 0, %loop ], [ %jnext, %bmatch ]\n')
    b.push('  %mgo = icmp slt i64 %j, %lb\n')
    b.push('  br i1 %mgo, label %cmp, label %found\n')
    b.push('cmp:\n')
    b.push('  %idx = add i64 %i, %j\n')
    b.push('  %pa = getelementptr i8, i8* %da, i64 %idx\n')
    b.push('  %ba = load i8, i8* %pa\n')
    b.push('  %pb = getelementptr i8, i8* %db, i64 %j\n')
    b.push('  %bb = load i8, i8* %pb\n')
    b.push('  %eq = icmp eq i8 %ba, %bb\n')
    b.push('  br i1 %eq, label %bmatch, label %next\n')
    b.push('bmatch:\n')
    b.push('  %jnext = add i64 %j, 1\n')
    b.push('  br label %body\n')
    b.push('found:\n')
    b.push('  ret i64 %i\n')
    b.push('next:\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('}\n')
    r = b.str()
}

; str-startswith：@str_starts_with —— 逐元前綴比對（std str.starts-with:460 逐字）。
;   target 較長 ⇒ false；否則比對前 lb 個位元。r: 結果字串
cg-runtime-str-startswith = () (r str) {
    b = sb.init(1024)
    b.push('define i1 @str_starts_with(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %lb.i32 = extractvalue %str-long %b, 0\n')
    b.push('  %lb = zext i32 %lb.i32 to i64\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  %db = extractvalue %str-long %b, 2\n')
    b.push('  %le = icmp sle i64 %lb, %la\n')
    b.push('  br i1 %le, label %loop, label %no\n')
    b.push('no:\n')
    b.push('  ret i1 false\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %entry ], [ %inext, %same ]\n')
    b.push('  %go = icmp slt i64 %i, %lb\n')
    b.push('  br i1 %go, label %body, label %yes\n')
    b.push('body:\n')
    b.push('  %pa = getelementptr i8, i8* %da, i64 %i\n')
    b.push('  %ba = load i8, i8* %pa\n')
    b.push('  %pb = getelementptr i8, i8* %db, i64 %i\n')
    b.push('  %bb = load i8, i8* %pb\n')
    b.push('  %eq = icmp eq i8 %ba, %bb\n')
    b.push('  br i1 %eq, label %same, label %no\n')
    b.push('same:\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('yes:\n')
    b.push('  ret i1 true\n')
    b.push('}\n')
    r = b.str()
}

; str-endswith：@str_ends_with —— 逐元後綴比對（std str.ends-with:481 逐字）。
;   target 較長 ⇒ false；off = la - lb（#{overflow=wrap} 在源側，此處 la >= lb 已保證）。
; r: 結果字串
cg-runtime-str-endswith = () (r str) {
    b = sb.init(1024)
    b.push('define i1 @str_ends_with(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %lb.i32 = extractvalue %str-long %b, 0\n')
    b.push('  %lb = zext i32 %lb.i32 to i64\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  %db = extractvalue %str-long %b, 2\n')
    b.push('  %le = icmp sle i64 %lb, %la\n')
    b.push('  br i1 %le, label %entry2, label %no\n')
    b.push('no:\n')
    b.push('  ret i1 false\n')
    b.push('entry2:\n')
    b.push('  %off = sub i64 %la, %lb\n')
    b.push('  br label %loop\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %entry2 ], [ %inext, %same ]\n')
    b.push('  %go = icmp slt i64 %i, %lb\n')
    b.push('  br i1 %go, label %body, label %yes\n')
    b.push('body:\n')
    b.push('  %idx = add i64 %off, %i\n')
    b.push('  %pa = getelementptr i8, i8* %da, i64 %idx\n')
    b.push('  %ba = load i8, i8* %pa\n')
    b.push('  %pb = getelementptr i8, i8* %db, i64 %i\n')
    b.push('  %bb = load i8, i8* %pb\n')
    b.push('  %eq = icmp eq i8 %ba, %bb\n')
    b.push('  br i1 %eq, label %same, label %no\n')
    b.push('same:\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('yes:\n')
    b.push('  ret i1 true\n')
    b.push('}\n')
    r = b.str()
}

; str-contains：@str_contains —— 等價 index(target) >= 0（std str.contains:450 逐字）。
; r: 結果字串
cg-runtime-str-contains = () (r str) {
    b = sb.init(256)
    b.push('define i1 @str_contains(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %p = call i64 @str_find_byte(%str-long %a, %str-long %b)\n')
    b.push('  %r = icmp sge i64 %p, 0\n')
    b.push('  ret i1 %r\n')
    b.push('}\n')
    r = b.str()
}

; str-index：@str_index —— 回「首次出現的【碼點】位置」，未找到 -1（std str.index:420 逐字）。
;   = find-byte-from(target, 0) 命中後 .cp-index(b)：數 a[0..b) 裡的首字節（b<0x80 或 (b&0xc0)==0xc0）個數。
;   ⚠️ 與 @str_cp_len 同口徑（見 cg-runtime-str-cp-len），只在 [0, p) 區間數。
; r: 結果字串
cg-runtime-str-index = () (r str) {
    b = sb.init(1536)
    b.push('define i64 @str_index(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %p = call i64 @str_find_byte(%str-long %a, %str-long %b)\n')
    b.push('  %ok = icmp sge i64 %p, 0\n')
    b.push('  br i1 %ok, label %count, label %neg\n')
    b.push('neg:\n')
    b.push('  ret i64 -1\n')
    b.push('count:\n')
    b.push('  %data = extractvalue %str-long %a, 2\n')
    b.push('  br label %loop\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %count ], [ %inext, %body ]\n')
    b.push('  %n = phi i64 [ 0, %count ], [ %nnext, %body ]\n')
    b.push('  %go = icmp slt i64 %i, %p\n')
    b.push('  br i1 %go, label %body, label %done\n')
    b.push('body:\n')
    b.push('  %ptr = getelementptr i8, i8* %data, i64 %i\n')
    b.push('  %byt = load i8, i8* %ptr\n')
    b.push('  %bw = zext i8 %byt to i64\n')
    b.push('  %lo = icmp slt i64 %bw, 128\n')
    b.push('  %and = and i64 %bw, 192\n')
    b.push('  %hi = icmp eq i64 %and, 192\n')
    b.push('  %inc = or i1 %lo, %hi\n')
    b.push('  %nadd = add i64 %n, 1\n')
    b.push('  %nnext = select i1 %inc, i64 %nadd, i64 %n\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('done:\n')
    b.push('  ret i64 %n\n')
    b.push('}\n')
    r = b.str()
}

; str-to-bytes：@str_to_bytes —— s159。語義逐字鏡像 src/std/str.no:694 的 str.to-bytes()：
;   n = .len-bytes()；with-cap-len(n, n) 後逐元 val[i] = .byte(i)。
;   ⚠️ 結果**擁有**新緩衝（rc=1、cap=n>0）⇒ 呼叫端必須 rel-add，離開作用域發 OP-VEC-FREE；
;      這與 s121 bytes() 的 cap==0【借用視圖】相反，勿混。
;   ⚠️ []byte 元素在 noc 運行期是 i64 寬槽（stride 8，s136 口徑合併）⇒ 每元寫一個 8 位元組槽，
;      把該元 u8 值 zext 成 i64 存進去，@vec_get_i64（stride 8）才能讀回 0..255。
;   ⚠️ B28：%str-long 的 len 欄是 u32 ⇒ 讀出即 zext i32→i64。
;   ⚠️ 空串走 empty 短路：回 {0,0,0}，@vec_free 對 dat==0 短路（同 vec_new_cap_i64）。
; r: 結果字串
cg-runtime-str-to-bytes = () (r str) {
    b = sb.init(1792)
    b.push('define %vec @str_to_bytes(%str-long %a) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  %z = icmp eq i64 %la, 0\n')
    b.push('  br i1 %z, label %empty, label %alloc\n')
    b.push('empty:\n')
    b.push('  ret %vec { i32 0, i32 0, i64 0 }\n')
    b.push('alloc:\n')
    b.push('  %nb = mul i64 %la, 8\n')
    b.push('  %p = call i8* @malloc(i64 %nb)\n')
    b.push('  br label %loop\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %alloc ], [ %inext, %body ]\n')
    b.push('  %go = icmp slt i64 %i, %la\n')
    b.push('  br i1 %go, label %body, label %done\n')
    b.push('body:\n')
    b.push('  %sp = getelementptr i8, i8* %da, i64 %i\n')
    b.push('  %bi = load i8, i8* %sp\n')
    b.push('  %bw = zext i8 %bi to i64\n')
    b.push('  %off = mul i64 %i, 8\n')
    b.push('  %dp = getelementptr i8, i8* %p, i64 %off\n')
    b.push('  %dpp = bitcast i8* %dp to i64*\n')
    b.push('  store i64 %bw, i64* %dpp\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('done:\n')
    b.push('  %c32 = trunc i64 %la to i32\n')
    b.push('  %pd = ptrtoint i8* %p to i64\n')
    b.push('  %v0 = insertvalue %vec zeroinitializer, i32 %c32, 0\n')
    b.push('  %v1 = insertvalue %vec %v0, i32 %c32, 1\n')
    b.push('  %v2 = insertvalue %vec %v1, i64 %pd, 2\n')
    b.push('  ret %vec %v2\n')
    b.push('}\n')
    r = b.str()
}

; s160：@str_slice_bytes —— str.slice-bytes(start,end) 的【新配置】子串副本助手。
;   語義逐字鏡像 src/std/str.no:642：start<0 ⇒ 0；end>len-bytes() ⇒ len-bytes()；
;   start>=end ⇒ 空；否則把 [start,end) 逐元（1:1 位元組，不做 UTF-8 重編碼）複製進新緩衝。
;   ⚠️ 緩衝走 @nolang_rc_alloc（非裸 @malloc）⇒ rc=1，由 h2m-rel-add(TY-STR) 登記、
;      作用域結束發 OP-RELEASE ⇒ @nolang_rc_release 歸還（同 OP-STRCAT／OP-ITOSTR）。
;      s159 的 @str_to_bytes 用裸 @malloc + OP-VEC-FREE，兩者【所有權路徑不同】，勿混。
;   ⚠️ B28：%str-long 的 len 欄是 u32 ⇒ 讀出即 zext i32→i64 才做 icmp / gep 偏移。
;   ⚠️ 以「n<0 ⇒ 0」的 select 收斂 start>=end，不另開 empty 分支：
;      rc_alloc(0) 仍回非空指標（alloc n+16），故空結果的 data 永不為 null。
;   ⚠️ 同一函式內區域值名不得與形參同名（§78 ⑥ 教訓）：杜絕 %a = ／ %b = ／ %s = ／ %e =。
; r: 結果字串
cg-runtime-str-slice-bytes = () (r str) {
    b = sb.init(1792)
    b.push('define %str-long @str_slice_bytes(%str-long %a, i64 %s, i64 %e) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  %sneg = icmp slt i64 %s, 0\n')
    b.push('  %s0 = select i1 %sneg, i64 0, i64 %s\n')
    b.push('  %egt = icmp sgt i64 %e, %la\n')
    b.push('  %e0 = select i1 %egt, i64 %la, i64 %e\n')
    b.push('  %nraw = sub i64 %e0, %s0\n')
    b.push('  %nneg = icmp slt i64 %nraw, 0\n')
    b.push('  %n = select i1 %nneg, i64 0, i64 %nraw\n')
    b.push('  %buf = call i8* @nolang_rc_alloc(i64 %n)\n')
    b.push('  br label %loop\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %entry ], [ %inext, %body ]\n')
    b.push('  %go = icmp slt i64 %i, %n\n')
    b.push('  br i1 %go, label %body, label %done\n')
    b.push('body:\n')
    b.push('  %src = add i64 %s0, %i\n')
    b.push('  %sp = getelementptr i8, i8* %da, i64 %src\n')
    b.push('  %by = load i8, i8* %sp\n')
    b.push('  %dp = getelementptr i8, i8* %buf, i64 %i\n')
    b.push('  store i8 %by, i8* %dp\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('done:\n')
    b.push('  %l0.i32 = trunc i64 %n to i32\n')
    b.push('  %r0 = insertvalue %str-long zeroinitializer, i32 %l0.i32, 0\n')
    b.push('  %r1 = insertvalue %str-long %r0, i32 %l0.i32, 1\n')
    b.push('  %r2 = insertvalue %str-long %r1, i8* %buf, 2\n')
    b.push('  ret %str-long %r2\n')
    b.push('}\n')
    r = b.str()
}

; vec-type：向量（Go codegen.go 逐字）。16B = u32 len + u32 cap + i64 data（data 存成 i64 裸指针）。
; 對外 API（.len()）仍是 i64 ⇒ 讀寫該兩欄一律 zext/trunc 在邊界做，
; 不可用 i64 直接 load/store（opaque pointer 下 LLVM 不會攔，會靜默讀到 len+cap 打包值）。
; r: 結果字串
cg-runtime-vec-type = () (r str) {
    r = '%vec = type { i32, i32, i64 }   ; u32 len, u32 cap, data (ptrtoint, 16B); external API stays i64'
}

; option-type：`?T` 的唯一表示（Go emitPrelude 的 %option 逐字）。
; 32 字节 = 8 字节 tag + 24 字节 payload slot；slot 是 `[3 x i64]`，
; 所以能内联 <=24 字节的载荷（i64 / %vec / 16B 的 %str-long 都装得下），更大的走堆上装箱。
; ⚠️ B28：**slot 本身仍是 24B**（Go optSlotDefaultBytes = 24 未變），故 ?str 仍是 inline；
;    但 %str-long 改成 16B 後只佔 slot 前 16 字節，**不再是 `[3 x i64]` 三欄 1:1 對應**：
;    len/cap 以 zext i32→i64 存進 slot[0..1]、讀回時 trunc i64→i32；data 仍 ptrtoint/inttoptr。
; tag：0 = ok、1 = nil、2 = err。
; r: 結果字串
cg-runtime-option-type = () (r str) {
    r = '%option = type { i64, [3 x i64] }    ; tag, 24-byte payload slot (32 bytes total)'
}

; struct-decl：单个结构体的型别声明（M4-c 续件 s31/s32）。
; id: 结构体 id（对应型别码 TY-STRUCT-BASE + id）
; nf: 字段数（0 ⇒ 该结构体未被使用，由 struct-decls 跳过）
; ft: 容器 —— 该结构体的字段型别码（长度 == nf）
; r: 結果字串
; s175：[]結構體索引讀的【借用指標】助手（逐結構體一條，名 @vec_get_st_ptr_<sid>）。
;   stride 不手算：讓 LLVM 自己算——getelementptr %struct.s<sid>, %struct.s<sid>* null, i64 1
;   的位址即 sizeof（含對齊填充），ptrtoint 得位元數。這正是 clang 求 sizeof 的辦法，
;   避免了用 nolang 重算 LLVM 版面（混合寬度字段會有 padding，手算必錯）。
; sid: 結構體 id
; r: 結果字串
cg-runtime-vec-get-st-ptr = (sid i64) (r str) {
    b = sb.init(512)
    b.push('define i8* @vec_get_st_ptr_')
    b.push(sid.to-str())
    b.push('(%vec %v, i64 %i) {\nentry:\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%p1 = getelementptr %struct.s')
    b.push(sid.to-str())
    b.push(', %struct.s')
    b.push(sid.to-str())
    b.push('* null, i64 1\n')
    b.push('\t%sz = ptrtoint %struct.s')
    b.push(sid.to-str())
    b.push('* %p1 to i64\n')
    b.push('\t%off = mul i64 %i, %sz\n')
    b.push('\t%base = inttoptr i64 %dat to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\tret i8* %slot\n}\n')
    r = b.str()
}

; s175：逐結構體發一條 @vec_get_st_ptr_<sid>（sfc[id] > 0 才發）。
; sfc: 各結構體的欄位數（0 = 未使用）
; r: 結果字串
cg-runtime-vec-get-st-ptrs = (sfc []i64) (r str) {
    b = sb.init(1024)
    n = sfc.len()
    i = 0
    (i < n) {
        fc = sfc[i]
        fc > 0 -> {
            b.push(cg-runtime-vec-get-st-ptr(i))
            b.push('\n')
        }

        i = ix.inc(i)
    }
    r = b.str()
}

cg-runtime-struct-decl = (id i64, nf i64, ft []i64) (r str) {
    b = sb.init(256)
    b.push('%struct.s')
    b.push(id.to-str())
    b.push(' = type { ')
    j = 0
    (j < nf) {
        j > 0 -> b.push(', ')
        b.push(cg-runtime-ty-name(ix.at-i(ft, j)))

        j = ix.inc(j)
    }
    b.push(' }')
    r = b.str()
}

; struct-decls：模块内**全部**结构体型别声明（唯一装配点）。
; sfc: 容器 —— sfc[id] = 该结构体的字段数（0 = 未使用 ⇒ 跳过）
; sft: 容器 —— 各结构体字段型别码的**拼接**（按 id 升序，长度 == Σ sfc）
; r: 結果字串
; ⚠️ 具名型别在 LLVM 模块内唯一（§11 B10）：这里一次性发全部，各函式**不得**再发。
; ⚠️ sft 是「拼接表」而不是二维表：nolang 的容器没有二维形态，用「计数 + 游标」展开
;    比「id*stride + j」少一个隐式上限（stride 一写死，struct 就不能超那个字段数）。
cg-runtime-struct-decls = (sfc []i64, sft []i64) (r str) {
    b = sb.init(1024)
    n = sfc.len()
    off = 0
    i <- [0..n): {
        nf = sfc[i]
        nf > 0 -> {
            ft []i64 = []
            j = 0
            (j < nf) {
                ft.push(ix.at-i(sft, off))

                j = ix.inc(j)

                off = ix.inc(off)
            }
            b.push(cg-runtime-struct-decl(i, nf, ft))
            b.push('\n')
        }
    }
    r = b.str()
}

; 向量 helper（M4-c 第六件；**刻意不照抄 Go 的 inline 展开**）
...

; Go 的 `vec.push` 在每个调用点 inline 展开（load %vec / 扩容 / store），
; 好处是零调用开销，代价是每个 push 站点几百行 IR。M4 阶段以**行为等价**
; 为验收（§5.6.3 第①层），故改为 4 个小 helper：IR 量级差一个数量级，
; 且 helper 本身可以被单元测试直接钉住。**这是刻意偏离**，记在 §11。
;
; ⚠️ 数据缓冲用**裸 @malloc**（不带 RC 头）——元素目前只有 i64，无 RC 需求；
;    扩容后 @free 旧缓冲，故不会无界泄漏。等元素变成 str/vec 时要换成
;    @nolang_rc_alloc + 逐元素 retain/release（记入 §11）。
; r: 結果字串
cg-runtime-vec-new = () (r str) {
    b = sb.init(256)
    b.push('define %vec @vec_new() {\n')
    b.push('entry:\n')
    b.push('\tret %vec { i32 0, i32 0, i64 0 }\n}\n')
    r = b.str()
}

; vec_len：对外仍是 i64（Nolang API），描述符里的 len 是 u32 ⇒ 边界处 zext。
; r: 結果字串
cg-runtime-vec-len = () (r str) {
    b = sb.init(256)
    b.push('define i64 @vec_len(%vec %v) {\n')
    b.push('entry:\n')
    b.push('\t%l32 = extractvalue %vec %v, 0\n')
    b.push('\t%l = zext i32 %l32 to i64\n')
    b.push('\tret i64 %l\n}\n')
    r = b.str()
}

; 功能待補充
; r: 結果字串
cg-runtime-vec-get = () (r str) {
    b = sb.init(512)
    b.push('define i64 @vec_get_i64(%vec %v, i64 %i) {\n')
    b.push('entry:\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%off = mul i64 %i, 8\n')
    b.push('\t%base = inttoptr i64 %dat to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\t%sp = bitcast i8* %slot to i64*\n')
    b.push('\t%x = load i64, i64* %sp\n')
    b.push('\tret i64 %x\n}\n')
    r = b.str()
}

; push：满则翻倍（下限 4）→ 新 malloc + memcpy + free 旧 → 写尾部 → len+1。
; r: 結果字串
cg-runtime-vec-push = () (r str) {
    b = sb.init(1024)
    b.push('define %vec @vec_push_i64(%vec %v, i64 %x) {\n')
    b.push('entry:\n')
    b.push('\t%len32 = extractvalue %vec %v, 0\n')
    b.push('\t%cap32 = extractvalue %vec %v, 1\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%len = zext i32 %len32 to i64\n')
    b.push('\t%cap = zext i32 %cap32 to i64\n')
    b.push('\t%full = icmp eq i64 %len, %cap\n')
    b.push('\tbr i1 %full, label %grow, label %store\n')
    b.push('grow:\n')
    b.push('\t%ncap0 = mul i64 %cap, 2\n')
    b.push('\t%small = icmp slt i64 %ncap0, 4\n')
    b.push('\t%ncap = select i1 %small, i64 4, i64 %ncap0\n')
    b.push('\t%nb = mul i64 %ncap, 8\n')
    b.push('\t%nbp = call i8* @malloc(i64 %nb)\n')
    b.push('\t%nbi = ptrtoint i8* %nbp to i64\n')
    b.push('\t%ob = mul i64 %len, 8\n')
    b.push('\t%empty = icmp eq i64 %ob, 0\n')
    b.push('\tbr i1 %empty, label %store, label %copy\n')
    b.push('copy:\n')
    b.push('\t%old = inttoptr i64 %dat to i8*\n')
    b.push('\tcall void @llvm.memcpy.p0i8.p0i8.i64(i8* %nbp, i8* %old, i64 %ob, i1 0)\n')
    b.push('\tcall void @free(i8* %old)\n')
    b.push('\tbr label %store\n')
    b.push('store:\n')
    b.push('\t%cap2 = phi i64 [ %cap, %entry ], [ %ncap, %grow ], [ %ncap, %copy ]\n')
    b.push('\t%dat2 = phi i64 [ %dat, %entry ], [ %nbi, %grow ], [ %nbi, %copy ]\n')
    b.push('\t%off = mul i64 %len, 8\n')
    b.push('\t%base = inttoptr i64 %dat2 to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\t%sp = bitcast i8* %slot to i64*\n')
    b.push('\tstore i64 %x, i64* %sp\n')
    b.push('\t%len1 = add i64 %len, 1\n')
    b.push('\t%len1t = trunc i64 %len1 to i32\n')
    b.push('\t%cap2t = trunc i64 %cap2 to i32\n')
    b.push('\t%r0 = insertvalue %vec { i32 0, i32 0, i64 0 }, i32 %len1t, 0\n')
    b.push('\t%r1 = insertvalue %vec %r0, i32 %cap2t, 1\n')
    b.push('\t%r2 = insertvalue %vec %r1, i64 %dat2, 2\n')
    b.push('\tret %vec %r2\n}\n')
    r = b.str()
}

; vec 释放（M4-e s99n）：与切片字面量的取得所有权配对，scope-exit 调一次。
;   ⚠️ 数据缓冲**无 RC 头**（§11 B5）⇒ 这不是「减引用计数」，是**一次性 free**：
;      调用后该 %vec 全部字段作废（所有权唯一，见 mir.no OP-VEC-FREE）。
;   ⚠️ dat == 0 短路：@vec_new 的初值 / 空字面量 `[]` 都是 {0,0,0}，free(0) 虽合法但
;      多一次越界分支没有意义，且显式短路让 IR 文本断言能钉住「空字面量不调 free」。
; r: 結果字串
cg-runtime-vec-free = () (r str) {
    b = sb.init(512)
    b.push('define void @vec_free(%vec %v) {\n')
    b.push('entry:\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%nul = icmp eq i64 %dat, 0\n')
    b.push('\tbr i1 %nul, label %done, label %freeme\n')
    b.push('freeme:\n')
    b.push('\t%p = inttoptr i64 %dat to i8*\n')
    b.push('\tcall void @free(i8* %p)\n')
    b.push('\tbr label %done\n')
    b.push('done:\n')
    b.push('\tret void\n}\n')
    r = b.str()
}

; 切片 B 底座：str 元素向量助手（%vec = {i32 len, i32 cap, i64 data}，元素 %str-long 16B）
...

; ⚠️ 所有權（鏡像 Go vecDeepClone/vecDeepFree，適配 self-host 無 magic 頭的 rc_release）：
;   - 陣列緩衝用裸 @malloc/@free（與 i64 vec 一致，無 RC 頭）；
;   - 元素 str 用 @nolang_rc_alloc/@nolang_rc_release，push 時【clone】元素到新 rc 塊
;     （字面量 @.str 無 rc 頭，直接 release 會讀越界頭 ⇒ 一律 clone 成獨立 rc 塊）；
;   - 擴容 memcpy 元素（淺拷貝 rc 塊指針）後 free【舊陣列緩衝】（裸 free，非元素 buf）；
;   - free-str 逐元素 release data（field 2）後 free 陣列緩衝。
; ⚠️ get-str 回【借用視圖】（與原 vec 共享元素 buf）⇒ 呼叫方不得 drop 結果，否則 double-free。

; vec_push_str：push 一個 str 元素，回新 %vec（stride 16）。元素先 clone 成獨立 rc 塊。
; r: 結果字串
cg-runtime-vec-push-str = () (r str) {
    b = sb.init(2048)
    b.push('define %vec @vec_push_str(%vec %v, %str-long %x) {\n')
    b.push('entry:\n')
    b.push('\t%len32 = extractvalue %vec %v, 0\n')
    b.push('\t%cap32 = extractvalue %vec %v, 1\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%len = zext i32 %len32 to i64\n')
    b.push('\t%cap = zext i32 %cap32 to i64\n')
    b.push('\t%full = icmp eq i64 %len, %cap\n')
    b.push('\tbr i1 %full, label %grow, label %clone\n')
    b.push('grow:\n')
    b.push('\t%ncap0 = mul i64 %cap, 2\n')
    b.push('\t%small = icmp slt i64 %ncap0, 4\n')
    b.push('\t%ncap = select i1 %small, i64 4, i64 %ncap0\n')
    b.push('\t%nb = mul i64 %ncap, 16\n')
    b.push('\t%nbp = call i8* @malloc(i64 %nb)\n')
    b.push('\t%nbi = ptrtoint i8* %nbp to i64\n')
    b.push('\t%ob = mul i64 %len, 16\n')
    b.push('\t%empty = icmp eq i64 %ob, 0\n')
    b.push('\tbr i1 %empty, label %clone, label %copy\n')
    b.push('copy:\n')
    b.push('\t%old = inttoptr i64 %dat to i8*\n')
    b.push('\tcall void @llvm.memcpy.p0i8.p0i8.i64(i8* %nbp, i8* %old, i64 %ob, i1 0)\n')
    b.push('\tcall void @free(i8* %old)\n')
    b.push('\tbr label %clone\n')
    b.push('clone:\n')
    b.push('\t%cap2 = phi i64 [ %cap, %entry ], [ %ncap, %grow ], [ %ncap, %copy ]\n')
    b.push('\t%dat2 = phi i64 [ %dat, %entry ], [ %nbi, %grow ], [ %nbi, %copy ]\n')
    b.push('\t%xl = extractvalue %str-long %x, 0\n')
    b.push('\t%xl64 = zext i32 %xl to i64\n')
    b.push('\t%xd = extractvalue %str-long %x, 2\n')
    b.push('\t%nbuf = call i8* @nolang_rc_alloc(i64 %xl64)\n')
    b.push('\tcall void @llvm.memcpy.p0i8.p0i8.i64(i8* %nbuf, i8* %xd, i64 %xl64, i1 0)\n')
    b.push('\t%off = mul i64 %len, 16\n')
    b.push('\t%base = inttoptr i64 %dat2 to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\t%sp = bitcast i8* %slot to %str-long*\n')
    b.push('\t%e0 = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %xl, 0\n')
    b.push('\t%e1 = insertvalue %str-long %e0, i32 %xl, 1\n')
    b.push('\t%e2 = insertvalue %str-long %e1, i8* %nbuf, 2\n')
    b.push('\tstore %str-long %e2, %str-long* %sp\n')
    b.push('\t%len1 = add i64 %len, 1\n')
    b.push('\t%len1t = trunc i64 %len1 to i32\n')
    b.push('\t%cap2t = trunc i64 %cap2 to i32\n')
    b.push('\t%r0 = insertvalue %vec { i32 0, i32 0, i64 0 }, i32 %len1t, 0\n')
    b.push('\t%r1 = insertvalue %vec %r0, i32 %cap2t, 1\n')
    b.push('\t%r2 = insertvalue %vec %r1, i64 %dat2, 2\n')
    b.push('\tret %vec %r2\n}\n')
    r = b.str()
}

; vec_get_str：取第 i 個 str 元素（借用視圖，stride 16）。
; r: 結果字串
cg-runtime-vec-get-str = () (r str) {
    b = sb.init(512)
    b.push('define %str-long @vec_get_str(%vec %v, i64 %i) {\n')
    b.push('entry:\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%off = mul i64 %i, 16\n')
    b.push('\t%base = inttoptr i64 %dat to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\t%sp = bitcast i8* %slot to %str-long*\n')
    b.push('\t%x = load %str-long, %str-long* %sp\n')
    b.push('\tret %str-long %x\n}\n')
    r = b.str()
}

; vec_free_str：逐元素 release data（field 2）+ free 陣列緩衝（dat==0 短路）。
; r: 結果字串
cg-runtime-vec-free-str = () (r str) {
    b = sb.init(1024)
    b.push('define void @vec_free_str(%vec %v) {\n')
    b.push('entry:\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%nul = icmp eq i64 %dat, 0\n')
    b.push('\tbr i1 %nul, label %done, label %init\n')
    b.push('init:\n')
    b.push('\t%len32 = extractvalue %vec %v, 0\n')
    b.push('\t%len = zext i32 %len32 to i64\n')
    b.push('\tbr label %loop\n')
    b.push('loop:\n')
    b.push('\t%i = phi i64 [ 0, %init ], [ %inext, %body ]\n')
    b.push('\t%more = icmp ult i64 %i, %len\n')
    b.push('\tbr i1 %more, label %body, label %fin\n')
    b.push('body:\n')
    b.push('\t%off = mul i64 %i, 16\n')
    b.push('\t%base = inttoptr i64 %dat to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\t%sp = bitcast i8* %slot to %str-long*\n')
    b.push('\t%ev = load %str-long, %str-long* %sp\n')
    b.push('\t%ed = extractvalue %str-long %ev, 2\n')
    b.push('\tcall void @nolang_rc_release(i8* %ed)\n')
    b.push('\t%inext = add i64 %i, 1\n')
    b.push('\tbr label %loop\n')
    b.push('fin:\n')
    b.push('\t%p = inttoptr i64 %dat to i8*\n')
    b.push('\tcall void @free(i8* %p)\n')
    b.push('\tbr label %done\n')
    b.push('done:\n')
    b.push('\tret void\n}\n')
    r = b.str()
}

; 切片 B 第三层：with-cap 的容量预留助手。
;   与 @vec_new（恒 {0,0,0}）不同，with-cap(n) 的 cap 有真实语义——跨帧传递的
;   bufio.reader 缓冲区要求 cap 原样保留（Go codegen.go:2414 vecBufClone 的來歷），
;   否则 `buf.cap` 读回 0 ⇒ fs.read 读 0 字节。故必须 malloc cap*stride 并写入 cap 字段。
;   cap==0 ⇒ 回 {0,0,0}（与空 vec 一致，@vec_free 对 dat==0 短路）。
; r: 結果字串
cg-runtime-vec-new-cap-i64 = () (r str) {
    b = sb.init(768)
    b.push('define %vec @vec_new_cap_i64(i64 %cap) {\n')
    b.push('entry:\n')
    b.push('\t%nz = icmp eq i64 %cap, 0\n')
    b.push('\tbr i1 %nz, label %empty, label %alloc\n')
    b.push('empty:\n')
    b.push('\tret %vec { i32 0, i32 0, i64 0 }\n')
    b.push('alloc:\n')
    b.push('\t%nb = mul i64 %cap, 8\n')
    b.push('\t%p = call i8* @malloc(i64 %nb)\n')
    b.push('\t%dp = ptrtoint i8* %p to i64\n')
    b.push('\t%c32 = trunc i64 %cap to i32\n')
    b.push('\t%v0 = insertvalue %vec undef, i32 0, 0\n')
    b.push('\t%v1 = insertvalue %vec %v0, i32 %c32, 1\n')
    b.push('\t%v2 = insertvalue %vec %v1, i64 %dp, 2\n')
    b.push('\tret %vec %v2\n}\n')
    r = b.str()
}

; str 版：元素 stride 16（%str-long）；malloc 后 memset 0，
;   使尚未写入的元素槽读回定义良好的空 str（避免垃圾指针被 release）。
; r: 結果字串
cg-runtime-vec-new-cap-str = () (r str) {
    b = sb.init(1024)
    b.push('define %vec @vec_new_cap_str(i64 %cap) {\n')
    b.push('entry:\n')
    b.push('\t%nz = icmp eq i64 %cap, 0\n')
    b.push('\tbr i1 %nz, label %empty, label %alloc\n')
    b.push('empty:\n')
    b.push('\tret %vec { i32 0, i32 0, i64 0 }\n')
    b.push('alloc:\n')
    b.push('\t%nb = mul i64 %cap, 16\n')
    b.push('\t%p = call i8* @malloc(i64 %nb)\n')
    b.push('\tcall void @llvm.memset.p0i8.i64(i8* %p, i8 0, i64 %nb, i1 false)\n')
    b.push('\t%dp = ptrtoint i8* %p to i64\n')
    b.push('\t%c32 = trunc i64 %cap to i32\n')
    b.push('\t%v0 = insertvalue %vec undef, i32 0, 0\n')
    b.push('\t%v1 = insertvalue %vec %v0, i32 %c32, 1\n')
    b.push('\t%v2 = insertvalue %vec %v1, i64 %dp, 2\n')
    b.push('\tret %vec %v2\n}\n')
    r = b.str()
}

; vec_clear（s165）：就地清除——只把 len 欄歸零，cap/data 原封保留（緩衝可重用、不釋放）。
;   逐字鏡像 Go src/mir/builtin_call.go:2481 emitBuiltinVecClear 的 insertvalue %vec %v, i32 0, 0。
;   ⚠️ dat==0（空 vec）時也安全：insertvalue 只是拷字段，不碰緩衝。
; r: 結果字串
cg-runtime-vec-clear = () (r str) {
    b = sb.init(512)
    b.push('define %vec @vec_clear(%vec %v) {\n')
    b.push('entry:\n')
    b.push('\t%cp = extractvalue %vec %v, 1\n')
    b.push('\t%dt = extractvalue %vec %v, 2\n')
    b.push('\t%r0 = insertvalue %vec undef, i32 0, 0\n')
    b.push('\t%r1 = insertvalue %vec %r0, i32 %cp, 1\n')
    b.push('\t%r2 = insertvalue %vec %r1, i64 %dt, 2\n')
    b.push('\tret %vec %r2\n}\n')
    r = b.str()
}

; vec_pop（s166）：移除最後一期——len = max(len-1, 0)，cap/data 原封不動。
;   逐字鏡像 Go src/mir/builtin_call.go:2610 emitBuiltinVecPop 的 newLen 口徑
;   （z = len==0；newLen = select z ? 0 : len-1），但【不】回傳被彈出元素：
;   自舉呼叫點（h2m-bk-pop／h2m-lower-for／h2m-lower-coll 等）全為陳述位 .pop()。
;   ⚠️ 與 vec_clear 一樣只改描述符、不碰緩衝 ⇒ dat==0（空 vec）安全。
; r: 結果字串
cg-runtime-vec-pop = () (r str) {
    b = sb.init(512)
    b.push('define %vec @vec_pop(%vec %v) {\n')
    b.push('entry:\n')
    b.push('\t%l32 = extractvalue %vec %v, 0\n')
    b.push('\t%l = zext i32 %l32 to i64\n')
    b.push('\t%z = icmp eq i64 %l, 0\n')
    b.push('\t%lm1 = sub i64 %l, 1\n')
    b.push('\t%nl = select i1 %z, i64 0, i64 %lm1\n')
    b.push('\t%nl32 = trunc i64 %nl to i32\n')
    b.push('\t%cp = extractvalue %vec %v, 1\n')
    b.push('\t%dt = extractvalue %vec %v, 2\n')
    b.push('\t%r0 = insertvalue %vec undef, i32 %nl32, 0\n')
    b.push('\t%r1 = insertvalue %vec %r0, i32 %cp, 1\n')
    b.push('\t%r2 = insertvalue %vec %r1, i64 %dt, 2\n')
    b.push('\tret %vec %r2\n}\n')
    r = b.str()
}

; chk_add（s167）：帶溢出檢測的有符號 i64 加法——語義鏡像 Go inferOptionArith。
;   正常 ⇒ tag=0 + 載荷=和；溢出 ⇒ tag=2（err；S0 實測 o1/t2 走 err 臂，非 nil）+ 載荷 0 語義位。
;   檢測用經典符號位公式：(a^r) & (b^r) 的符號位即溢出（無 intrinsic、無分支）。
; r: 結果字串
cg-runtime-chk-add = () (r str) {
    b = sb.init(512)
    b.push('define %option @chk_add(i64 %a, i64 %b) {\n')
    b.push('entry:\n')
    b.push('\t%r = add i64 %a, %b\n')
    b.push('\t%x = xor i64 %a, %r\n')
    b.push('\t%y = xor i64 %b, %r\n')
    b.push('\t%s = and i64 %x, %y\n')
    b.push('\t%ovf = icmp slt i64 %s, 0\n')
    b.push('\t%bad = zext i1 %ovf to i64\n')
    b.push('\t%tg = mul i64 %bad, 2\n')
    b.push('\t%o0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 %tg, 0\n')
    b.push('\t%o1 = insertvalue %option %o0, i64 %r, 1, 0\n')
    b.push('\tret %option %o1\n}\n')
    r = b.str()
}

; chk_sub（s167）：帶溢出檢測的有符號 i64 減法。溢出公式 (a^b) & (a^r) 的符號位。
; r: 結果字串
cg-runtime-chk-sub = () (r str) {
    b = sb.init(512)
    b.push('define %option @chk_sub(i64 %a, i64 %b) {\n')
    b.push('entry:\n')
    b.push('\t%r = sub i64 %a, %b\n')
    b.push('\t%x = xor i64 %a, %b\n')
    b.push('\t%y = xor i64 %a, %r\n')
    b.push('\t%s = and i64 %x, %y\n')
    b.push('\t%ovf = icmp slt i64 %s, 0\n')
    b.push('\t%bad = zext i1 %ovf to i64\n')
    b.push('\t%tg = mul i64 %bad, 2\n')
    b.push('\t%o0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 %tg, 0\n')
    b.push('\t%o1 = insertvalue %option %o0, i64 %r, 1, 0\n')
    b.push('\tret %option %o1\n}\n')
    r = b.str()
}

; chk_mul（s167）：帶溢出檢測的有符號 i64 乘法。i64×i64 溢出的完備判據是
;   「i128 乘積轉回 i64 再符號擴展不回原值」（截斷判據，非启发式）⇒ sext 到 i128 相乘。
; r: 結果字串
cg-runtime-chk-mul = () (r str) {
    b = sb.init(512)
    b.push('define %option @chk_mul(i64 %a, i64 %b) {\n')
    b.push('entry:\n')
    b.push('\t%pa = sext i64 %a to i128\n')
    b.push('\t%pb = sext i64 %b to i128\n')
    b.push('\t%p = mul i128 %pa, %pb\n')
    b.push('\t%lo = trunc i128 %p to i64\n')
    b.push('\t%ext = sext i64 %lo to i128\n')
    b.push('\t%ovf = icmp ne i128 %p, %ext\n')
    b.push('\t%bad = zext i1 %ovf to i64\n')
    b.push('\t%tg = mul i64 %bad, 2\n')
    b.push('\t%o0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 %tg, 0\n')
    b.push('\t%o1 = insertvalue %option %o0, i64 %lo, 1, 0\n')
    b.push('\tret %option %o1\n}\n')
    r = b.str()
}

; chk_div（s167）：帶溢出／除零檢測的有符號 i64 除法（向零截斷 sdiv，同 S0 o6 的 -7/2=-3）。
;   失敗態：b==0 或 (a==MIN && b==-1)（S0 實測 o3/o4 皆走 err 臂）⇒ tag=2 + 載荷 0。
;   ⚠️ 必須顯式分支護航：裸 sdiv 在這兩種情形是 poison/陷阱，不可直接發。
; r: 結果字串
cg-runtime-chk-div = () (r str) {
    b = sb.init(640)
    b.push('define %option @chk_div(i64 %a, i64 %b) {\n')
    b.push('entry:\n')
    b.push('\t%z = icmp eq i64 %b, 0\n')
    b.push('\t%mna = icmp eq i64 %a, -9223372036854775808\n')
    b.push('\t%mnb = icmp eq i64 %b, -1\n')
    b.push('\t%mn = and i1 %mna, %mnb\n')
    b.push('\t%bad0 = or i1 %z, %mn\n')
    b.push('\tbr i1 %bad0, label %bad, label %good\n')
    b.push('good:\n')
    b.push('\t%q = sdiv i64 %a, %b\n')
    b.push('\t%o0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 0, 0\n')
    b.push('\t%o1 = insertvalue %option %o0, i64 %q, 1, 0\n')
    b.push('\tret %option %o1\n')
    b.push('bad:\n')
    b.push('\t%e0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 2, 0\n')
    b.push('\t%e1 = insertvalue %option %e0, i64 0, 1, 0\n')
    b.push('\tret %option %e1\n}\n')
    r = b.str()
}

; chk_mod（s167）：帶溢出／除零檢測的有符號 i64 取餘（srem）。
;   失敗態同除法（b==0 或 MIN%-1；S0 實測 o5 走 err 臂）⇒ tag=2 + 載荷 0。
; r: 結果字串
cg-runtime-chk-mod = () (r str) {
    b = sb.init(640)
    b.push('define %option @chk_mod(i64 %a, i64 %b) {\n')
    b.push('entry:\n')
    b.push('\t%z = icmp eq i64 %b, 0\n')
    b.push('\t%mna = icmp eq i64 %a, -9223372036854775808\n')
    b.push('\t%mnb = icmp eq i64 %b, -1\n')
    b.push('\t%mn = and i1 %mna, %mnb\n')
    b.push('\t%bad0 = or i1 %z, %mn\n')
    b.push('\tbr i1 %bad0, label %bad, label %good\n')
    b.push('good:\n')
    b.push('\t%q = srem i64 %a, %b\n')
    b.push('\t%o0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 0, 0\n')
    b.push('\t%o1 = insertvalue %option %o0, i64 %q, 1, 0\n')
    b.push('\tret %option %o1\n')
    b.push('bad:\n')
    b.push('\t%e0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 2, 0\n')
    b.push('\t%e1 = insertvalue %option %e0, i64 0, 1, 0\n')
    b.push('\tret %option %e1\n}\n')
    r = b.str()
}

; args-list（s168）：@args_list —— os.args() 的【自有】[]str 拷貝。
;   語意逐字鏡像 Go src/mir/builtin_call.go:4379 emitBuiltinArgsList：讀
;   @__nolang_argc（i64）與 @__nolang_argv（i8**），逐元把 argv[i] 的字串內容
;   1:1 複製成新 %str-long（元素 stride 16）。
;   ⚠️ 元素緩衝走 @nolang_rc_alloc（rc=1）⇒ 與 @vec_free_str 的逐元素
;      @nolang_rc_release 口令一致；data 緩衝走裸 @malloc（同 @vec_new_cap_str，
;      @vec_free_str 收尾 @free）。argv[i]==null（不該發生）映射到空字串全局。
;   ⚠️ argc 由入口包裝以 i32 捕獲（見 cg-runtime-entry-main）。
; r: 結果字串
cg-runtime-args-list = () (r str) {
    b = sb.init(1792)
    b.push('define %vec @args_list() {\n')
    b.push('entry:\n')
    b.push('\t%ac = load i64, i64* @__nolang_argc\n')
    b.push('\t%av = load i8**, i8*** @__nolang_argv\n')
    b.push('\t%nis = icmp eq i8** %av, null\n')
    b.push('\t%n0 = select i1 %nis, i64 0, i64 %ac\n')
    b.push('\t%nb = mul i64 %n0, 16\n')
    b.push('\t%heap = call i8* @malloc(i64 %nb)\n')
    b.push('\tbr label %loop\n')
    b.push('loop:\n')
    b.push('\t%i = phi i64 [ 0, %entry ], [ %inext, %body ]\n')
    b.push('\t%more = icmp ult i64 %i, %n0\n')
    b.push('\tbr i1 %more, label %body, label %done\n')
    b.push('body:\n')
    b.push('\t%sp = getelementptr i8*, i8** %av, i64 %i\n')
    b.push('\t%p = load i8*, i8** %sp\n')
    b.push('\t%nz = icmp ne i8* %p, null\n')
    b.push('\t%emp = getelementptr [1 x i8], [1 x i8]* @__nolang_empty_cstr, i64 0, i64 0\n')
    b.push('\t%safe = select i1 %nz, i8* %p, i8* %emp\n')
    b.push('\t%len = call i64 @strlen(i8* %safe)\n')
    b.push('\t%buf = call i8* @nolang_rc_alloc(i64 %len)\n')
    b.push('\tcall void @llvm.memcpy.p0i8.p0i8.i64(i8* %buf, i8* %safe, i64 %len, i1 false)\n')
    b.push('\t%l32a = trunc i64 %len to i32\n')
    b.push('\t%s0 = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %l32a, 0\n')
    b.push('\t%s1 = insertvalue %str-long %s0, i32 %l32a, 1\n')
    b.push('\t%s2 = insertvalue %str-long %s1, i8* %buf, 2\n')
    b.push('\t%off = mul i64 %i, 16\n')
    b.push('\t%ep = getelementptr i8, i8* %heap, i64 %off\n')
    b.push('\t%esp = bitcast i8* %ep to %str-long*\n')
    b.push('\tstore %str-long %s2, %str-long* %esp\n')
    b.push('\t%inext = add i64 %i, 1\n')
    b.push('\tbr label %loop\n')
    b.push('done:\n')
    b.push('\t%dp = ptrtoint i8* %heap to i64\n')
    b.push('\t%nl32 = trunc i64 %n0 to i32\n')
    b.push('\t%nc32 = trunc i64 %n0 to i32\n')
    b.push('\t%v0 = insertvalue %vec undef, i32 %nl32, 0\n')
    b.push('\t%v1 = insertvalue %vec %v0, i32 %nc32, 1\n')
    b.push('\t%v2 = insertvalue %vec %v1, i64 %dp, 2\n')
    b.push('\tret %vec %v2\n}\n')
    r = b.str()
}

; vec-get-str-opt（s168）：@vec_get_str_opt —— []str.get(i) 的 option 化讀取。
;   語意逐字鏡像 Go emitBuiltinArgsGet：0 <= i < len ⇒ tag=0 + 載荷為元素的
;   【自有】拷貝（rc=1）；越界（含負數）⇒ tag=1（nil）、載荷零值。
;   ⚠️ 越界時讀取下標鉗到 0（恆在緩衝內），但載荷仍拷一份合法空/首元——
;      與 Go 相同（Go 亦 unsafe 讀 clamp 後的指標，只是 tag 標 nil）；
;      本實作鉗到 0 後照常複製元素 0，語意上只影響不帶出的載荷值，無副作用。
;   ⚠️ 失敗態是 nil（tag=1）【不是】err（tag=2）——與 s167 chk_* 族區别。
; r: 結果字串
cg-runtime-vec-get-str-opt = () (r str) {
    b = sb.init(1536)
    b.push('define %option @vec_get_str_opt(%vec %v, i64 %ix) {\n')
    b.push('entry:\n')
    b.push('\t%l32 = extractvalue %vec %v, 0\n')
    b.push('\t%ln = zext i32 %l32 to i64\n')
    b.push('\t%ge = icmp sge i64 %ix, 0\n')
    b.push('\t%lt = icmp slt i64 %ix, %ln\n')
    b.push('\t%inr = and i1 %ge, %lt\n')
    b.push('\t%ci = select i1 %inr, i64 %ix, i64 0\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%dp = inttoptr i64 %dat to i8*\n')
    b.push('\t%off = mul i64 %ci, 16\n')
    b.push('\t%ep = getelementptr i8, i8* %dp, i64 %off\n')
    b.push('\t%esp = bitcast i8* %ep to %str-long*\n')
    b.push('\t%ev = load %str-long, %str-long* %esp\n')
    b.push('\t%en = extractvalue %str-long %ev, 0\n')
    b.push('\t%el = zext i32 %en to i64\n')
    b.push('\t%ed = extractvalue %str-long %ev, 2\n')
    b.push('\t%buf = call i8* @nolang_rc_alloc(i64 %el)\n')
    b.push('\tcall void @llvm.memcpy.p0i8.p0i8.i64(i8* %buf, i8* %ed, i64 %el, i1 false)\n')
    b.push('\t%nl32 = trunc i64 %el to i32\n')
    b.push('\t%s0 = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %nl32, 0\n')
    b.push('\t%s1 = insertvalue %str-long %s0, i32 %nl32, 1\n')
    b.push('\t%s2 = insertvalue %str-long %s1, i8* %buf, 2\n')
    b.push('\t%o0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 0, 0\n')
    b.push('\t%o1 = insertvalue %option %o0, i64 %el, 1, 0\n')
    b.push('\t%o2 = insertvalue %option %o1, i64 %el, 1, 1\n')
    b.push('\t%dpb = ptrtoint i8* %buf to i64\n')
    b.push('\t%o3 = insertvalue %option %o2, i64 %dpb, 1, 2\n')
    b.push('\t%tg = select i1 %inr, i64 0, i64 1\n')
    b.push('\t%r0 = insertvalue %option %o3, i64 %tg, 0\n')
    b.push('\tret %option %r0\n}\n')
    r = b.str()
}

; str-to-i64（s169）：@str_to_i64 —— str.to-i64() 的解析助手。
;   語意逐字鏡像 src/std/str.no:715：空字串 ⇒ nil（tag=1）；非數字字元／孤立 +/- ⇒ err（tag=2）；
;   溢出 ⇒ err；成功 ⇒ ok（tag=0，載荷 i64）。⚠️ i64.MIN（-9223372036854775808）特例：
;   n == 922337203685477580 且 neg 且末位 d == 8 ⇒ 經由【環繞】算術得出正確量值。
;   ⚠️ 與 Go 的差異：err 載荷在語言側是 str（錯誤訊息），本助手只帶 tag、載荷零值——
;      自舉語料（h2m/ps/asp/drv 的 to-i64 呼叫點）皆只取 ok 臂或 nil 臂，不讀 err 載荷。
; r: 結果字串
cg-runtime-str-to-i64 = () (r str) {
    b = sb.init(4096)
    b.push('define %option @str_to_i64(%str-long %s) {\n')
    b.push('entry:\n')
    b.push('\t%l32 = extractvalue %str-long %s, 0\n')
    b.push('\t%ln = zext i32 %l32 to i64\n')
    b.push('\t%empty = icmp eq i64 %ln, 0\n')
    b.push('\tbr i1 %empty, label %nil, label %sign\n')
    b.push('sign:\n')
    b.push('\t%dp0 = extractvalue %str-long %s, 2\n')
    b.push('\t%b0v = load i8, i8* %dp0\n')
    b.push('\t%b0 = zext i8 %b0v to i64\n')
    b.push('\t%minus = icmp eq i64 %b0, 45\n')
    b.push('\t%plus = icmp eq i64 %b0, 43\n')
    b.push('\t%has = or i1 %minus, %plus\n')
    b.push('\t%one = icmp eq i64 %ln, 1\n')
    b.push('\t%lone = and i1 %has, %one\n')
    b.push('\tbr i1 %lone, label %err, label %start\n')
    b.push('start:\n')
    b.push('\t%st = select i1 %has, i64 1, i64 0\n')
    b.push('\t%neg0 = select i1 %minus, i64 1, i64 0\n')
    b.push('\tbr label %loop\n')
    b.push('loop:\n')
    b.push('\t%i = phi i64 [ %st, %start ], [ %inext, %inc ]\n')
    b.push('\t%n = phi i64 [ 0, %start ], [ %nnext, %inc ]\n')
    b.push('\t%neg = phi i64 [ %neg0, %start ], [ %neg, %inc ]\n')
    b.push('\t%ge = icmp sge i64 %i, 0\n')
    b.push('\t%lt = icmp slt i64 %i, %ln\n')
    b.push('\t%inr = and i1 %ge, %lt\n')
    b.push('\tbr i1 %inr, label %body, label %done\n')
    b.push('body:\n')
    b.push('\t%dp = extractvalue %str-long %s, 2\n')
    b.push('\t%ep = getelementptr i8, i8* %dp, i64 %i\n')
    b.push('\t%cv8 = load i8, i8* %ep\n')
    b.push('\t%c = zext i8 %cv8 to i64\n')
    b.push('\t%clt = icmp slt i64 %c, 48\n')
    b.push('\t%cgt = icmp sgt i64 %c, 57\n')
    b.push('\t%badc = or i1 %clt, %cgt\n')
    b.push('\tbr i1 %badc, label %err, label %range\n')
    b.push('range:\n')
    b.push('\t%d = sub i64 %c, 48\n')
    b.push('\t%lim = icmp sgt i64 %n, 922337203685477580\n')
    b.push('\tbr i1 %lim, label %err, label %atlim\n')
    b.push('atlim:\n')
    b.push('\t%iseq = icmp eq i64 %n, 922337203685477580\n')
    b.push('\tbr i1 %iseq, label %edge, label %acc\n')
    b.push('edge:\n')
    b.push('\t%negb = icmp ne i64 %neg, 0\n')
    b.push('\tbr i1 %negb, label %edge-neg, label %edge-pos\n')
    b.push('edge-neg:\n')
    b.push('\t%dgt8 = icmp sgt i64 %d, 8\n')
    b.push('\tbr i1 %dgt8, label %err, label %edge-neg-8\n')
    b.push('edge-neg-8:\n')
    b.push('\t%deq8 = icmp eq i64 %d, 8\n')
    b.push('\tbr i1 %deq8, label %edge-min, label %acc\n')
    b.push('edge-min:\n')
    b.push('\t%lm1 = sub i64 %ln, 1\n')
    b.push('\t%last = icmp eq i64 %i, %lm1\n')
    b.push('\tbr i1 %last, label %minval, label %err\n')
    b.push('minval:\n')
    b.push('\t%mt = mul i64 %n, 10\n')
    b.push('\t%nmin = add i64 %mt, 8\n')
    b.push('\tbr label %inc\n')
    b.push('edge-pos:\n')
    b.push('\t%dgt7 = icmp sgt i64 %d, 7\n')
    b.push('\tbr i1 %dgt7, label %err, label %acc\n')
    b.push('acc:\n')
    b.push('\t%mt2 = mul i64 %n, 10\n')
    b.push('\t%nacc = add i64 %mt2, %d\n')
    b.push('\tbr label %inc\n')
    b.push('inc:\n')
    b.push('\t%nnext = phi i64 [ %nacc, %acc ], [ %nmin, %minval ]\n')
    b.push('\t%inext = add i64 %i, 1\n')
    b.push('\tbr label %loop\n')
    b.push('done:\n')
    b.push('\t%nd = phi i64 [ %n, %loop ]\n')
    b.push('\t%negd = phi i64 [ %neg, %loop ]\n')
    b.push('\t%isneg = icmp ne i64 %negd, 0\n')
    b.push('\t%val0 = sub i64 0, %nd\n')
    b.push('\t%val = select i1 %isneg, i64 %val0, i64 %nd\n')
    b.push('\t%o0 = insertvalue %option { i64 0, [3 x i64] zeroinitializer }, i64 0, 0\n')
    b.push('\t%o1 = insertvalue %option %o0, i64 %val, 1, 0\n')
    b.push('\tret %option %o1\n')
    b.push('nil:\n')
    b.push('\t%p0 = insertvalue %option { i64 1, [3 x i64] zeroinitializer }, i64 0, 0\n')
    b.push('\t%p1 = insertvalue %option %p0, i64 0, 1, 0\n')
    b.push('\tret %option %p1\n')
    b.push('err:\n')
    b.push('\t%e0 = insertvalue %option { i64 2, [3 x i64] zeroinitializer }, i64 2, 0\n')
    b.push('\t%e1 = insertvalue %option %e0, i64 0, 1, 0\n')
    b.push('\tret %option %e1\n')
    b.push('}\n')
    r = b.str()
}

; stat-kind（s170）：@nolang_stat_isfile / @nolang_stat_isdir —— fs.is-file(p) / fs.is-dir(p)
;   的 C interop 助手。語意逐字鏡像 Go emitBuiltinStatFile（src/mir/forward_call.go:511-512）：
;   rc = stat(nul 終止路徑, buf)；rc == 0 且 (st_mode & mask) != 0 ⇒ 1，否則 0。
;   ⚠️ st_mode 讀取按 Go 口徑用【i32 載荷】（forward_call.go:787 起：i16 讀在此後端會
;      誤編成 0），偏移 4、緩衝 144B = 本機 darwin/arm64 的 struct stat 佈局
;      （實測 sizeof=144、offsetof(st_mode)=4；跨平台_layout 差異為已知粗略邊，如阻力再參數化）。
;   ⚠️ 路徑複製：%str-long 資料未必 NUL 終止 ⇒ 動态 alloca(len+1) + memcpy + 補 0。
; mk: 0 → is-file（mask 32768=S_IFREG）；1 → is-dir（mask 16384=S_IFDIR）
; r: 結果字串
cg-runtime-stat-kind = (mk i64) (r str) {
    fn = 'nolang_stat_isfile'
    msk = '32768'
    mk == 1 -> {
        fn = 'nolang_stat_isdir'
        msk = '16384'
    }
    b = sb.init(2048)
    b.push('define i64 @')
    b.push(fn)
    b.push('(%str-long %sp) {\n')
    b.push('entry:\n')
    b.push('\t%l32 = extractvalue %str-long %sp, 0\n')
    b.push('\t%ln = zext i32 %l32 to i64\n')
    b.push('\t%dp = extractvalue %str-long %sp, 2\n')
    b.push('\t%l1 = add i64 %ln, 1\n')
    b.push('\t%buf = alloca i8, i64 %l1\n')
    b.push('\tcall void @llvm.memcpy.p0i8.p0i8.i64(i8* %buf, i8* %dp, i64 %ln, i1 false)\n')
    b.push('\t%zp = getelementptr i8, i8* %buf, i64 %ln\n')
    b.push('\tstore i8 0, i8* %zp\n')
    b.push('\t%sb = alloca [144 x i8]\n')
    b.push('\t%sbb = bitcast [144 x i8]* %sb to i8*\n')
    b.push('\t%rc = call i32 @stat(i8* %buf, i8* %sbb)\n')
    b.push('\t%okc = icmp eq i32 %rc, 0\n')
    b.push('\t%mp = getelementptr i8, i8* %sbb, i64 4\n')
    b.push('\t%m32p = bitcast i8* %mp to i32*\n')
    b.push('\t%mode = load i32, i32* %m32p\n')
    b.push('\t%mand = and i32 %mode, ')
    b.push(msk)
    b.push('\n')
    b.push('\t%mne = icmp ne i32 %mand, 0\n')
    b.push('\t%both = and i1 %okc, %mne\n')
    b.push('\t%res = zext i1 %both to i64\n')
    b.push('\tret i64 %res\n')
    b.push('}\n')
    r = b.str()
}

; getpid（s170）：@nolang_getpid —— os.get-pid() 的 C interop 助手
;   （Go CLibCall getpid，RetExt i64Type ⇒ sext）。無參數、無 RC。
; r: 結果字串
cg-runtime-getpid = () (r str) {
    r = 'define i64 @nolang_getpid() {\nentry:\n\t%r = call i32 @getpid()\n\t%e = sext i32 %r to i64\n\tret i64 %e\n}\n'
}

; entry-main（s168）：C 入口包装 —— 捕獲 argc/argv 到 @__nolang_argc/@__nolang_argv，
;   再轉調降級側合成入口 @__nolang_main（原 `@main` 更名，見 h2m-synth-main）。
;   ⚠️ 每模組僅一次（drv.pkg-ll／link.compile 皆只前插一份 prelude）。
;   ⚠️ @__nolang_empty_cstr 供 @args_list／@vec_get_str_opt 的 null 護航取用。
; r: 結果字串
cg-runtime-entry-main = () (r str) {
    b = sb.init(512)
    b.push('@__nolang_argc = global i64 0\n')
    b.push('@__nolang_argv = global i8** null\n')
    b.push('@__nolang_empty_cstr = private constant [1 x i8] zeroinitializer\n')
    b.push('define i32 @main(i32 %argc, i8** %argv) {\n')
    b.push('entry:\n')
    b.push('\t%ac = sext i32 %argc to i64\n')
    b.push('\tstore i64 %ac, i64* @__nolang_argc\n')
    b.push('\tstore i8** %argv, i8*** @__nolang_argv\n')
    b.push('\t%rv = call i64 @__nolang_main()\n')
    b.push('\t%ri = trunc i64 %rv to i32\n')
    b.push('\tret i32 %ri\n}\n')
    r = b.str()
}

; vec_bytes_to_str（s165）：[]byte.to-str() 的【自有】1:1 逐字節複製助手。
;   語意逐字鏡像 src/std/byte.no:141（原始位元保留、不做 UTF-8 重編碼）與 Go builtin
;   src/dist/txtmin.ll 的 _LB__RB_byte.to-bytes-str（配置 n 位元組後逐元複製）。
;   ⚠️ 與 OP-STRFROMVEC（s49）的零拷貝重interpret【相反】：那里與原 vec 共享緩衝，
;      接收者離開作用域即懸垂；此處必須複製，故走 @nolang_rc_alloc（rc=1），由 h2m-rel-add
;      登記、作用域結束發 OP-RELEASE ⇒ @nolang_rc_release（同 OP-STRCAT／OP-STRSLICEB）。
;   ⚠️ 元素槽是 i64 寬（s136 口徑）⇒ 逐元 load i64、trunc i8 寫進 i8 緩衝（低 8 位即元首元）。
;   ⚠️ 空 vec ⇒ 直接回 {0,0,null}（無 rc 頭可釋放，避免 release 讀越界頭）；這與
;      s160 @str_slice_bytes 的「rc_alloc(0) 恆非空」不同分支，前者是 vec 緩衝無 RC 的既有口徑。
; r: 結果字串
cg-runtime-vec-bytes-to-str = () (r str) {
    b = sb.init(1792)
    b.push('define %str-long @vec_bytes_to_str(%vec %a) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %vec %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %da = extractvalue %vec %a, 2\n')
    ; s165 語義煙測（tmp/s165/sem）抓到的真錯：%vec 的 f2 是【整數】指針（i64），
    ;   LLVM 不能把 i64 直接當 i8* 用 ⇒ 必須 inttoptr（同 cg.no OP-STRFROMVEC 的
    ;   「bitcast 不能指針⇄整數」口徑）。缺這步 clang 報
    ;   `'%da' defined with type 'i64' but expected 'ptr'`。
    b.push('  %dap = inttoptr i64 %da to i8*\n')
    b.push('  %z = icmp eq i64 %la, 0\n')
    b.push('  br i1 %z, label %empty, label %alloc\n')
    b.push('empty:\n')
    b.push('  ret %str-long { i32 0, i32 0, i8* null }\n')
    b.push('alloc:\n')
    b.push('  %buf = call i8* @nolang_rc_alloc(i64 %la)\n')
    b.push('  br label %loop\n')
    b.push('loop:\n')
    b.push('  %i = phi i64 [ 0, %alloc ], [ %inext, %body ]\n')
    b.push('  %go = icmp slt i64 %i, %la\n')
    b.push('  br i1 %go, label %body, label %done\n')
    b.push('body:\n')
    b.push('  %off = mul i64 %i, 8\n')
    b.push('  %sp = getelementptr i8, i8* %dap, i64 %off\n')
    b.push('  %spp = bitcast i8* %sp to i64*\n')
    b.push('  %xw = load i64, i64* %spp\n')
    b.push('  %xb = trunc i64 %xw to i8\n')
    b.push('  %dp = getelementptr i8, i8* %buf, i64 %i\n')
    b.push('  store i8 %xb, i8* %dp\n')
    b.push('  %inext = add i64 %i, 1\n')
    b.push('  br label %loop\n')
    b.push('done:\n')
    b.push('  %c32 = trunc i64 %la to i32\n')
    b.push('  %r0 = insertvalue %str-long zeroinitializer, i32 %c32, 0\n')
    b.push('  %r1 = insertvalue %str-long %r0, i32 %c32, 1\n')
    b.push('  %r2 = insertvalue %str-long %r1, i8* %buf, 2\n')
    b.push('  ret %str-long %r2\n')
    b.push('}\n')
    r = b.str()
}

; str_from_i64：把 i64 渲染成【新分配】的 %str-long（十進制、帶符號）。
;   s143：OP-ITOSTR 的執行期助手。逐字鏡像 Go src/mir/codegen.go:4643 的 @str_from_i64
;   （相同於 @print_i64 的數字發射，但產物是 rc=1 堆緩衝而非直接 write）。
;   ⚠️ 與 Go 的差異：Go 原版【沒有】i64.MIN 的 isMin select 護欄（`sub i64 0, %v` 對 MIN
;      是 poison，靠執行期回繞成 2^63 才得到正確量值）。自舉側按本檔案 @print_i64 的既有
;      口徑補上護欄，避免 opt 把 poison 折成垃圾（見 cg-runtime-print-helpers 註釋）。
;   ⚠️ 依賴 @digits（本檔 cg-runtime-print-helpers）與 @nolang_rc_alloc（cg-rc.no）
;      ⇒ 必須排在兩者之後。
; r: 結果字串
cg-runtime-str-from-i64 = () (r str) {
    b = sb.init(1024)
    b.push('define %str-long @str_from_i64(i64 %v) {\n')
    b.push('entry:\n')
    b.push('  %buf = alloca [24 x i8]\n')
    b.push('  %neg = icmp slt i64 %v, 0\n')
    b.push('  %isMin = icmp eq i64 %v, -9223372036854775808\n')
    b.push('  %negv = sub i64 0, %v\n')
    b.push('  %absNeg = select i1 %isMin, i64 9223372036854775808, i64 %negv\n')
    b.push('  %abs = select i1 %neg, i64 %absNeg, i64 %v\n')
    b.push('  %end = getelementptr [24 x i8], [24 x i8]* %buf, i64 0, i64 23\n')
    b.push('  store i8 0, i8* %end\n')
    b.push('  %sp = call i8* @digits(i64 %abs, i8* %end)\n')
    b.push('  br i1 %neg, label %negw, label %emit\n')
    b.push('negw:\n')
    b.push('  %sn = getelementptr i8, i8* %sp, i64 -1\n')
    b.push('  store i8 45, i8* %sn\n')
    b.push('  br label %emit\n')
    b.push('emit:\n')
    b.push('  %start = phi i8* [ %sn, %negw ], [ %sp, %entry ]\n')
    b.push('  %ep = getelementptr [24 x i8], [24 x i8]* %buf, i64 0, i64 23\n')
    b.push('  %epp = ptrtoint i8* %ep to i64\n')
    b.push('  %startp = ptrtoint i8* %start to i64\n')
    b.push('  %len = sub i64 %epp, %startp\n')
    b.push('  %nbuf = call i8* @nolang_rc_alloc(i64 %len)\n')
    b.push('  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %nbuf, i8* %start, i64 %len, i1 0)\n')
    b.push('  %s0.i32 = trunc i64 %len to i32\n')
    b.push('  %s0 = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %s0.i32, 0\n')
    b.push('  %s1.i32 = trunc i64 %len to i32\n')
    b.push('  %s1 = insertvalue %str-long %s0, i32 %s1.i32, 1\n')
    b.push('  %s2 = insertvalue %str-long %s1, i8* %nbuf, 2\n')
    b.push('  ret %str-long %s2\n')
    b.push('}\n')
    r = b.str()
}

; prelude：类型 + 声明（RC helper 见 cg-rc.no）。M4-a 的「最小 prelude」。
; r: 結果字串
cg-runtime-prelude = () (r str) {
    b = sb.init(256)
    b.push(cg-runtime-hdr-type())
    b.push('\n')
    b.push(cg-runtime-task-type())
    b.push('\n')
    b.push(cg-runtime-str-type())
    b.push('\n')
    b.push(cg-runtime-vec-type())
    b.push('\n')
    b.push(cg-runtime-option-type())
    b.push('\n\n')
    b.push(cg-runtime-decls())
    r = b.str()
}

; prelude-full：完整 prelude，**顺序有语义**——
;   类型 → libc 声明 → memcpy 声明 → RC helper → 字符串 helper → 向量 helper。
; @str_concat 调 @nolang_rc_alloc，故必须排在 RC 之后（LLVM 允许前向引用，
; 但保持与 Go 发射顺序一致便于逐字节对照）。
; r: 結果字串
; print-helpers：print / eprint 的執行期助手（s100）。
;   逐字鏡像 Go `emitPrelude`（src/mir/codegen.go:3818 `@digits`、3839 `@print_str`、
;   3848 `@print_i64`、4205 `@.nl`／4206 `@.sp`、4209 `@print_nl`、4216 `@print_space`、
;   4302 `@eprint_i64`、4351 `@eprint_nl`、4359 `@eprint_space`、4366 `@eprint_str`）。
;   ⚠️ 助手只寫「值本身」，**不**補換行／空格——那由 h2m 顯式發 OP-PRINT kind 2/3/6/7，
;      與 Go emitPrint 的拼法一致（print(a, b) ⇒ "a b\n"）。
;   ⚠️ `@digits` 是 itoa 核心（urem/udiv 迴圈，指標從尾端往前寫）；
;      `@print_i64` 的 i64.MIN 用 isMin select 護欄——`sub i64 0, %v` 對 MIN 是 poison，
;      InstCombine 會折成垃圾（Go 檔內註釋有完整來歷）。
;   ⚠️ IR 的 `\0A`／`\00` 在 Nolang 字面量裡必須寫成 `\\0A`／`\\00`：
;      單反斜線會被 Nolang 當跳脫解成 NUL 位元組（實測 len 少 2）。
; r: 結果字串
cg-runtime-print-helpers = () (r str) {
    b = sb.init(4096)
    b.push('@.nl = private constant [2 x i8] c"\\0A\\00"\n')
    b.push('@.sp = private constant [2 x i8] c" \\00"\n')
    b.push('\n')
    b.push('define i8* @digits(i64 %abs, i8* %end) {\n')
    b.push('entry:\n  br label %loop\n')
    b.push('loop:\n')
    b.push('  %p = phi i8* [ %end, %entry ], [ %pleft, %loop ]\n')
    b.push('  %n = phi i64 [ %abs, %entry ], [ %n2, %loop ]\n')
    b.push('  %digit = urem i64 %n, 10\n')
    b.push('  %ch = add i64 %digit, 48\n')
    b.push('  %ch8 = trunc i64 %ch to i8\n')
    b.push('  %pleft = getelementptr i8, i8* %p, i64 -1\n')
    b.push('  store i8 %ch8, i8* %pleft\n')
    b.push('  %n2 = udiv i64 %n, 10\n')
    b.push('  %last = icmp eq i64 %n2, 0\n')
    b.push('  br i1 %last, label %done, label %loop\n')
    b.push('done:\n  ret i8* %pleft\n')
    b.push('}\n\n')
    b.push('define void @print_str(%str-long %s) {\n')
    b.push('entry:\n')
    b.push('  %len.i32 = extractvalue %str-long %s, 0\n')
    b.push('  %len = zext i32 %len.i32 to i64\n')
    b.push('  %data = extractvalue %str-long %s, 2\n')
    b.push('  call i64 @write(i32 1, i8* %data, i64 %len)\n')
    b.push('  ret void\n}\n\n')
    b.push('define void @print_i64(i64 %v) {\n')
    b.push('entry:\n')
    b.push('  %buf = alloca [24 x i8]\n')
    b.push('  %neg = icmp slt i64 %v, 0\n')
    b.push('  %isMin = icmp eq i64 %v, -9223372036854775808\n')
    b.push('  %negv = sub i64 0, %v\n')
    b.push('  %absNeg = select i1 %isMin, i64 9223372036854775808, i64 %negv\n')
    b.push('  %abs = select i1 %neg, i64 %absNeg, i64 %v\n')
    b.push('  %end = getelementptr [24 x i8], [24 x i8]* %buf, i64 0, i64 23\n')
    b.push('  store i8 0, i8* %end\n')
    b.push('  %sp = call i8* @digits(i64 %abs, i8* %end)\n')
    b.push('  br i1 %neg, label %negw, label %emit\n')
    b.push('negw:\n')
    b.push('  %sn = getelementptr i8, i8* %sp, i64 -1\n')
    b.push('  store i8 45, i8* %sn\n')
    b.push('  br label %emit\n')
    b.push('emit:\n')
    b.push('  %start = phi i8* [ %sn, %negw ], [ %sp, %entry ]\n')
    b.push('  %ep = getelementptr [24 x i8], [24 x i8]* %buf, i64 0, i64 23\n')
    b.push('  %epp = ptrtoint i8* %ep to i64\n')
    b.push('  %startp = ptrtoint i8* %start to i64\n')
    b.push('  %len = sub i64 %epp, %startp\n')
    b.push('  call i64 @write(i32 1, i8* %start, i64 %len)\n')
    b.push('  ret void\n}\n\n')
    b.push('define void @eprint_str(%str-long %s) {\n')
    b.push('entry:\n')
    b.push('  %len.i32 = extractvalue %str-long %s, 0\n')
    b.push('  %len = zext i32 %len.i32 to i64\n')
    b.push('  %data = extractvalue %str-long %s, 2\n')
    b.push('  call i64 @write(i32 2, i8* %data, i64 %len)\n')
    b.push('  ret void\n}\n\n')
    b.push('define void @eprint_i64(i64 %v) {\n')
    b.push('entry:\n')
    b.push('  %buf = alloca [24 x i8]\n')
    b.push('  %neg = icmp slt i64 %v, 0\n')
    b.push('  %isMin = icmp eq i64 %v, -9223372036854775808\n')
    b.push('  %negv = sub i64 0, %v\n')
    b.push('  %absNeg = select i1 %isMin, i64 9223372036854775808, i64 %negv\n')
    b.push('  %abs = select i1 %neg, i64 %absNeg, i64 %v\n')
    b.push('  %end = getelementptr [24 x i8], [24 x i8]* %buf, i64 0, i64 23\n')
    b.push('  store i8 0, i8* %end\n')
    b.push('  %sp = call i8* @digits(i64 %abs, i8* %end)\n')
    b.push('  br i1 %neg, label %negw, label %emit\n')
    b.push('negw:\n')
    b.push('  %sn = getelementptr i8, i8* %sp, i64 -1\n')
    b.push('  store i8 45, i8* %sn\n')
    b.push('  br label %emit\n')
    b.push('emit:\n')
    b.push('  %start = phi i8* [ %sn, %negw ], [ %sp, %entry ]\n')
    b.push('  %ep = getelementptr [24 x i8], [24 x i8]* %buf, i64 0, i64 23\n')
    b.push('  %epp = ptrtoint i8* %ep to i64\n')
    b.push('  %startp = ptrtoint i8* %start to i64\n')
    b.push('  %len = sub i64 %epp, %startp\n')
    b.push('  call i64 @write(i32 2, i8* %start, i64 %len)\n')
    b.push('  ret void\n}\n\n')
    b.push('define void @print_nl() {\nentry:\n')
    b.push('  call i64 @write(i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @.nl, i64 0, i64 0), i64 1)\n')
    b.push('  ret void\n}\n\n')
    b.push('define void @print_space() {\nentry:\n')
    b.push('  call i64 @write(i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @.sp, i64 0, i64 0), i64 1)\n')
    b.push('  ret void\n}\n\n')
    b.push('define void @eprint_nl() {\nentry:\n')
    b.push('  call i64 @write(i32 2, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @.nl, i64 0, i64 0), i64 1)\n')
    b.push('  ret void\n}\n\n')
    b.push('define void @eprint_space() {\nentry:\n')
    b.push('  call i64 @write(i32 2, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @.sp, i64 0, i64 0), i64 1)\n')
    b.push('  ret void\n}\n')
    r = b.str()
}

cg-runtime-prelude-full = () (r str) {
    b = sb.init(16384)
    b.push(cg-runtime-prelude())
    b.push(cg-runtime-memcpy-decl())
    b.push('\n')
    b.push(cg-runtime-memcmp-decl())
    b.push('\n')
    b.push(cg-runtime-div-zero-msg())
    b.push('\n')
    b.push(cg-runtime-div-zero-report())
    b.push('\n')
    b.push(cg-rc-alloc())
    b.push(cg-rc-retain())
    b.push(cg-rc-release())
    b.push(cg-rc-nolang-free())
    b.push(cg-runtime-str-eq())
    b.push('\n')
    b.push(cg-runtime-str-concat())
    b.push(cg-runtime-str-cp-len())
    b.push(cg-runtime-str-find-byte())
    b.push(cg-runtime-str-startswith())
    b.push(cg-runtime-str-endswith())
    b.push(cg-runtime-str-contains())
    b.push(cg-runtime-str-index())
    ; s159：@str_to_bytes —— str.to-bytes() 的 O(N) 複製助手（i64 寬槽，自有緩衝）。
    b.push(cg-runtime-str-to-bytes())
    ; s160：@str_slice_bytes —— str.slice-bytes(start,end) 的新配置子串副本（走 rc_alloc/OP-RELEASE）。
    b.push(cg-runtime-str-slice-bytes())
    b.push(cg-runtime-vec-new())
    b.push(cg-runtime-vec-len())
    b.push(cg-runtime-vec-get())
    b.push(cg-runtime-vec-push())
    b.push(cg-runtime-vec-free())
    b.push(cg-runtime-vec-push-str())
    b.push(cg-runtime-vec-get-str())
    b.push(cg-runtime-vec-free-str())
    b.push(cg-runtime-vec-new-cap-i64())
    b.push(cg-runtime-vec-new-cap-str())
    ; s165：@vec_clear（就地清 len，保留 cap/data）與 @vec_bytes_to_str（1:1 自有拷貝成 str）。
    b.push(cg-runtime-vec-clear())
    b.push(cg-runtime-vec-pop())
    ; s167：帶溢出檢測算術族 @chk_add/sub/mul/div/mod（表面匹配 i64 算術主體的 err 態語意）。
    b.push(cg-runtime-chk-add())
    b.push(cg-runtime-chk-sub())
    b.push(cg-runtime-chk-mul())
    b.push(cg-runtime-chk-div())
    b.push(cg-runtime-chk-mod())
    ; s168：args 全域——C 入口包裝（捕獲 argc/argv，轉調 @__nolang_main）、
    ;   @args_list（os.args() 自有拷貝）與 @vec_get_str_opt（args.get 的 option 化讀取）。
    b.push(cg-runtime-entry-main())
    b.push(cg-runtime-args-list())
    b.push(cg-runtime-vec-get-str-opt())
    ; s169：@str_to_i64 —— str.to-i64() 的解析助手（空⇒nil、非數字／孤立符號／溢出⇒err）。
    b.push(cg-runtime-str-to-i64())
    ; s170：宿主全域 builtin —— @nolang_stat_isfile/@nolang_stat_isdir（fs.is-file/is-dir，
    ;   stat + S_IFREG/S_IFDIR 遮罩）與 @nolang_getpid（os.get-pid，getpid + sext）。
    b.push(cg-runtime-stat-kind(0))
    b.push(cg-runtime-stat-kind(1))
    b.push(cg-runtime-getpid())
    b.push(cg-runtime-vec-bytes-to-str())
    b.push(cg-runtime-vec-eq())
    b.push(cg-runtime-print-helpers())
    b.push(cg-runtime-str-from-i64())
    r = b.str()
}
