; cg-runtime — LLVM IR 运行期 prelude（M4-a 骨架）
;
; Authority：src/mir/codegen.go emitPrelude（%nolang_hdr / %task 类型块 +
;   @malloc/@free 声明）。照抄策略见 docs/design/nolang-selfhost.md §5.6.2：
;   IR 文本可逐字节照抄，不重新设计 ABI。
;
; ⚠️ IR 注释内引用标识符一律用双引号，不用反引号（nolang 的 ``` 会终止字面量）。
; ⚠️ 本模块刻意【惰性】：目前只被 compiler/tests/cg-runtime-test.no 引用，
;    尚未接入任何真实发射路径（M4-b 起由 cg.no 消费）。

# /compiler/src/util/sb.sb
# /compiler/src/cg-rc
# /compiler/src/mir

; ty-name：型别码 → LLVM 型名。**全库唯一**的一份映射（s32 从 cg.no 迁到这里：
;   struct 型别声明也要用它，而声明属于模块级装配点，不能反向依赖发射器）。
;   i64 / %str-long / %vec / %option / %struct.s<结构体 id>。
; t: 數值
; s: 結果字串
cg-runtime-ty-name = (t i64) (s str) {
    s = 'i64'
    t == TY-STR -> s = '%str-long'
    t == TY-VEC -> s = '%vec'
    t == TY-OPT -> s = '%option'
    t == TY-F64 -> s = 'double'
    t >= TY-STRUCT-BASE -> s = '%struct.s' - (t - TY-STRUCT-BASE).to-str()
}

; hdr-type：16 字节头类型。rc@base+0，magic@base+8，data=base+16。
; r: 結果字串
cg-runtime-hdr-type = () (r str) {
    r = '%nolang_hdr = type { i64, i64 }'
}

; task-type：协程任务（32 字节）。
; r: 結果字串
cg-runtime-task-type = () (r str) {
    r = '%task = type { void (i8*)*, i64, i1, i1, i8* }'
}

; str-type：字符串（u32 len, u32 cap, data）。与 Go emitPrelude 的 %str-long 逐字相同。
; ⚠️ B28（2026-11-11 後端變更）：len/cap 由 i64 縮成 u32 ⇒ 描述子從 24B 變 16B，
;   但**外部 API 仍是 i64**：所有讀寫邊界都要 zext i32→i64 / trunc i64→i32（見 cg.no）。
; r: 結果字串
cg-runtime-str-type = () (r str) {
    r = '%str-long = type { i32, i32, i8* }   ; u32 len, u32 cap, data (16B); external API stays i64'
}

; decls：libc 外部声明。
; r: 結果字串
cg-runtime-decls = () (r str) {
    r = 'declare i8* @malloc(i64)\ndeclare void @free(i8*)\ndeclare i64 @write(i32, i8*, i64)\n'
}

; memcpy-decl：llvm.memcpy 声明（Go codegen.go:2987 同形）。
; r: 結果字串
cg-runtime-memcpy-decl = () (r str) {
    r = 'declare void @llvm.memcpy.p0i8.p0i8.i64(i8*, i8*, i64, i1)'
}

; memcmp-decl：libc memcmp 声明（Go @str_eq 字节比较所用，codegen.go:3129 同形）。
; r: 結果字串
cg-runtime-memcmp-decl = () (r str) {
    r = 'declare i32 @memcmp(i8*, i8*, i64)'
}

; str-eq：@str_eq —— %str-long 结构相等（Go emitPrelude 的 @str_eq 逐字）。
;   两串相等 iff 长度相同且字节相同（memcmp==0）；绝不对 struct 本体发 icmp（非法）。
;   MIR OP-STEREQ 降级到此调用。2 空格缩进（与 Go 该处一致，非 tab）。
;   依赖 @memcmp（cg-runtime-memcmp-decl）；不依赖 RC。
; ⚠️ B28：len 欄是 u32 ⇒ 先 extractvalue 到 i32 暫存（%la.i32/%lb.i32），再 zext 回 i64
;   才能發 icmp eq i64 與 memcmp(i64 len)。不可直接拿 i32 當 i64 用。
; r: 結果字串
cg-runtime-str-eq = () (r str) {
    b = sb.init(768)
    b.push('define i1 @str_eq(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %lb.i32 = extractvalue %str-long %b, 0\n')
    b.push('  %lb = zext i32 %lb.i32 to i64\n')
    b.push('  %lenEq = icmp eq i64 %la, %lb\n')
    b.push('  br i1 %lenEq, label %cmpto, label %noteq\n')
    b.push('cmpto:\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  %db = extractvalue %str-long %b, 2\n')
    b.push('  %cmp = call i32 @memcmp(i8* %da, i8* %db, i64 %la)\n')
    b.push('  %same = icmp eq i32 %cmp, 0\n')
    b.push('  br label %done\n')
    b.push('noteq:\n')
    b.push('  br label %done\n')
    b.push('done:\n')
    b.push('  %res = phi i1 [ 0, %noteq ], [ %same, %cmpto ]\n')
    b.push('  ret i1 %res\n')
    b.push('}\n')
    r = b.str()
}

; vec-eq：@__nolang_vec_eq_i64 —— 两个 %vec（元素 i64）按内容深度相等（Go vecDeepEq 的 i64 分支逐字）。
; %vec = { u32 len, u32 cap, i64 data }（16B）；data 存为整数地址，故先 inttoptr 还原为 i8*。
; 先比 len，len 相等才 memcmp(data,data,len*8)（空向量 bytes=0，memcmp 不解引用，null 也安全）。
; len 是 u32 ⇒ 取用前 zext 到 i64（比较与字节数都以 i64 为准）。
; 依赖 @memcmp（cg-runtime-memcmp-decl，s42 已声明）。
; r: 結果字串
cg-runtime-vec-eq = () (r str) {
    b = sb.init(768)
    b.push('define i1 @__nolang_vec_eq_i64(%vec %a, %vec %b) {\n')
    b.push('entry:\n')
    b.push('  %la32 = extractvalue %vec %a, 0\n')
    b.push('  %lb32 = extractvalue %vec %b, 0\n')
    b.push('  %la = zext i32 %la32 to i64\n')
    b.push('  %lb = zext i32 %lb32 to i64\n')
    b.push('  %leneq = icmp eq i64 %la, %lb\n')
    b.push('  br i1 %leneq, label %cmp, label %no\n')
    b.push('cmp:\n')
    b.push('  %da = extractvalue %vec %a, 2\n')
    b.push('  %db = extractvalue %vec %b, 2\n')
    b.push('  %pa = inttoptr i64 %da to i8*\n')
    b.push('  %pb = inttoptr i64 %db to i8*\n')
    b.push('  %bytes = mul i64 %la, 8\n')
    b.push('  %mr = call i32 @memcmp(i8* %pa, i8* %pb, i64 %bytes)\n')
    b.push('  %same = icmp eq i32 %mr, 0\n')
    b.push('  ret i1 %same\n')
    b.push('no:\n')
    b.push('  ret i1 false\n')
    b.push('}\n')
    r = b.str()
}

; div-zero-msg：@nolang_msg_div_zero —— 整數除零診斷串（Go divZeroMsgText 逐字，85 位元組，
;   含結尾 \n）：private unnamed_addr constant，供 div-zero-report helper 取址寫 stderr。
;   ⚠️ 用單引號串 + 雙反斜杠（\6E 寫成 \\6E）——fmt 會清空含反斜杠的反引號原始串；\ 在單引號串內轉義成字面反斜杠。
; r: 結果字串（不含結尾換行，由 prelude-full 補 \n）
cg-runtime-div-zero-msg = () (r str) {
    r = '@nolang_msg_div_zero = private unnamed_addr constant [85 x i8] c"\\6E\\6F\\6C\\61\\6E\\67\\3A\\20\\69\\6E\\74\\65\\67\\65\\72\\20\\64\\69\\76\\69\\73\\69\\6F\\6E\\20\\6F\\72\\20\\72\\65\\6D\\61\\69\\6E\\64\\65\\72\\20\\62\\79\\20\\7A\\65\\72\\6F\\20\\28\\74\\68\\65\\20\\64\\69\\76\\69\\73\\6F\\72\\20\\69\\73\\20\\30\\3B\\20\\72\\65\\73\\75\\6C\\74\\20\\66\\6F\\72\\63\\65\\64\\20\\74\\6F\\20\\30\\29\\0A"'
}

; div-zero-report：@__nolang_div_zero_report(i1 %bad) —— %bad 為真時把除零診斷寫到 stderr（fd 2）。
;   與 Go divZeroReport 同形：呼叫方只需發單條 call，不切斷其所在基本塊（故做 helper 而非 inline 分支）。
;   依賴 @write（cg-runtime-decls）與 @nolang_msg_div_zero（cg-runtime-div-zero-msg）。
; r: 結果字串
cg-runtime-div-zero-report = () (r str) {
    b = sb.init(512)
    b.push('define void @__nolang_div_zero_report(i1 %bad) {\n')
    b.push('entry:\n')
    b.push('  br i1 %bad, label %report, label %done\n')
    b.push('report:\n')
    b.push('  call i64 @write(i32 2, i8* getelementptr inbounds ([85 x i8], [85 x i8]* @nolang_msg_div_zero, i64 0, i64 0), i64 85)\n')
    b.push('  br label %done\n')
    b.push('done:\n')
    b.push('  ret void\n')
    b.push('}\n')
    r = b.str()
}

; str-concat：@str_concat —— 堆上拼接两个 %str-long（Go emitPrelude 的 @str_concat 逐字）。
; 2 空格缩进（与 Go 该处一致，不是 tab）；依赖 @nolang_rc_alloc（见 cg-rc.no）。
; ⚠️ B28：len 欄 u32 ⇒ 讀出後 zext i32→i64 才做 add/memcpy；寫回描述子前
;   trunc i64 %total→i32，且聚合常數改 { i32 0, i32 0, i8* null }。
; r: 結果字串
cg-runtime-str-concat = () (r str) {
    b = sb.init(1024)
    b.push('define %str-long @str_concat(%str-long %a, %str-long %b) {\n')
    b.push('entry:\n')
    b.push('  %la.i32 = extractvalue %str-long %a, 0\n')
    b.push('  %la = zext i32 %la.i32 to i64\n')
    b.push('  %lb.i32 = extractvalue %str-long %b, 0\n')
    b.push('  %lb = zext i32 %lb.i32 to i64\n')
    b.push('  %total = add i64 %la, %lb\n')
    b.push('  %buf = call i8* @nolang_rc_alloc(i64 %total)\n')
    b.push('  %da = extractvalue %str-long %a, 2\n')
    b.push('  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %buf, i8* %da, i64 %la, i1 0)\n')
    b.push('  %db = extractvalue %str-long %b, 2\n')
    b.push('  %dst2 = getelementptr i8, i8* %buf, i64 %la\n')
    b.push('  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %dst2, i8* %db, i64 %lb, i1 0)\n')
    b.push('  %r0.i32 = trunc i64 %total to i32\n')
    b.push('  %r0 = insertvalue %str-long { i32 0, i32 0, i8* null }, i32 %r0.i32, 0\n')
    b.push('  %r1.i32 = trunc i64 %total to i32\n')
    b.push('  %r1 = insertvalue %str-long %r0, i32 %r1.i32, 1\n')
    b.push('  %r2 = insertvalue %str-long %r1, i8* %buf, 2\n')
    b.push('  ret %str-long %r2\n}\n')
    r = b.str()
}

; vec-type：向量（Go codegen.go 逐字）。16B = u32 len + u32 cap + i64 data（data 存成 i64 裸指针）。
; 對外 API（.len()）仍是 i64 ⇒ 讀寫該兩欄一律 zext/trunc 在邊界做，
; 不可用 i64 直接 load/store（opaque pointer 下 LLVM 不會攔，會靜默讀到 len+cap 打包值）。
; r: 結果字串
cg-runtime-vec-type = () (r str) {
    r = '%vec = type { i32, i32, i64 }   ; u32 len, u32 cap, data (ptrtoint, 16B); external API stays i64'
}

; option-type：`?T` 的唯一表示（Go emitPrelude 的 %option 逐字）。
; 32 字节 = 8 字节 tag + 24 字节 payload slot；slot 是 `[3 x i64]`，
; 所以能内联 <=24 字节的载荷（i64 / %vec / 16B 的 %str-long 都装得下），更大的走堆上装箱。
; ⚠️ B28：**slot 本身仍是 24B**（Go optSlotDefaultBytes = 24 未變），故 ?str 仍是 inline；
;    但 %str-long 改成 16B 後只佔 slot 前 16 字節，**不再是 `[3 x i64]` 三欄 1:1 對應**：
;    len/cap 以 zext i32→i64 存進 slot[0..1]、讀回時 trunc i64→i32；data 仍 ptrtoint/inttoptr。
; tag：0 = ok、1 = nil、2 = err。
; r: 結果字串
cg-runtime-option-type = () (r str) {
    r = '%option = type { i64, [3 x i64] }    ; tag, 24-byte payload slot (32 bytes total)'
}

; struct-decl：单个结构体的型别声明（M4-c 续件 s31/s32）。
; id: 结构体 id（对应型别码 TY-STRUCT-BASE + id）
; nf: 字段数（0 ⇒ 该结构体未被使用，由 struct-decls 跳过）
; ft: 容器 —— 该结构体的字段型别码（长度 == nf）
; r: 結果字串
cg-runtime-struct-decl = (id i64, nf i64, ft []i64) (r str) {
    b = sb.init(256)
    b.push('%struct.s')
    b.push(id.to-str())
    b.push(' = type { ')
    j = 0
    (j < nf) {
        j > 0 -> b.push(', ')
        b.push(cg-runtime-ty-name(ft[j]))

        #{overflow=wrap}
        j = j + 1
    }
    b.push(' }')
    r = b.str()
}

; struct-decls：模块内**全部**结构体型别声明（唯一装配点）。
; sfc: 容器 —— sfc[id] = 该结构体的字段数（0 = 未使用 ⇒ 跳过）
; sft: 容器 —— 各结构体字段型别码的**拼接**（按 id 升序，长度 == Σ sfc）
; r: 結果字串
; ⚠️ 具名型别在 LLVM 模块内唯一（§11 B10）：这里一次性发全部，各函式**不得**再发。
; ⚠️ sft 是「拼接表」而不是二维表：nolang 的容器没有二维形态，用「计数 + 游标」展开
;    比「id*stride + j」少一个隐式上限（stride 一写死，struct 就不能超那个字段数）。
cg-runtime-struct-decls = (sfc []i64, sft []i64) (r str) {
    b = sb.init(1024)
    n = sfc.len()
    off = 0
    i <- [0..n): {
        nf = sfc[i]
        nf > 0 -> {
            ft []i64 = []
            j = 0
            (j < nf) {
                ft.push(sft[off])

                #{overflow=wrap}
                j = j + 1

                #{overflow=wrap}
                off = off + 1
            }
            b.push(cg-runtime-struct-decl(i, nf, ft))
            b.push('\n')
        }
    }
    r = b.str()
}

; ── 向量 helper（M4-c 第六件；**刻意不照抄 Go 的 inline 展开**）──────────
; Go 的 `vec.push` 在每个调用点 inline 展开（load %vec / 扩容 / store），
; 好处是零调用开销，代价是每个 push 站点几百行 IR。M4 阶段以**行为等价**
; 为验收（§5.6.3 第①层），故改为 4 个小 helper：IR 量级差一个数量级，
; 且 helper 本身可以被单元测试直接钉住。**这是刻意偏离**，记在 §11。
;
; ⚠️ 数据缓冲用**裸 @malloc**（不带 RC 头）——元素目前只有 i64，无 RC 需求；
;    扩容后 @free 旧缓冲，故不会无界泄漏。等元素变成 str/vec 时要换成
;    @nolang_rc_alloc + 逐元素 retain/release（记入 §11）。
; r: 結果字串
cg-runtime-vec-new = () (r str) {
    b = sb.init(256)
    b.push('define %vec @vec_new() {\n')
    b.push('entry:\n')
    b.push('\tret %vec { i32 0, i32 0, i64 0 }\n}\n')
    r = b.str()
}

; vec_len：对外仍是 i64（Nolang API），描述符里的 len 是 u32 ⇒ 边界处 zext。
; r: 結果字串
cg-runtime-vec-len = () (r str) {
    b = sb.init(256)
    b.push('define i64 @vec_len(%vec %v) {\n')
    b.push('entry:\n')
    b.push('\t%l32 = extractvalue %vec %v, 0\n')
    b.push('\t%l = zext i32 %l32 to i64\n')
    b.push('\tret i64 %l\n}\n')
    r = b.str()
}

; 功能待補充
; r: 結果字串
cg-runtime-vec-get = () (r str) {
    b = sb.init(512)
    b.push('define i64 @vec_get_i64(%vec %v, i64 %i) {\n')
    b.push('entry:\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%off = mul i64 %i, 8\n')
    b.push('\t%base = inttoptr i64 %dat to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\t%sp = bitcast i8* %slot to i64*\n')
    b.push('\t%x = load i64, i64* %sp\n')
    b.push('\tret i64 %x\n}\n')
    r = b.str()
}

; push：满则翻倍（下限 4）→ 新 malloc + memcpy + free 旧 → 写尾部 → len+1。
; r: 結果字串
cg-runtime-vec-push = () (r str) {
    b = sb.init(1024)
    b.push('define %vec @vec_push_i64(%vec %v, i64 %x) {\n')
    b.push('entry:\n')
    b.push('\t%len32 = extractvalue %vec %v, 0\n')
    b.push('\t%cap32 = extractvalue %vec %v, 1\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%len = zext i32 %len32 to i64\n')
    b.push('\t%cap = zext i32 %cap32 to i64\n')
    b.push('\t%full = icmp eq i64 %len, %cap\n')
    b.push('\tbr i1 %full, label %grow, label %store\n')
    b.push('grow:\n')
    b.push('\t%ncap0 = mul i64 %cap, 2\n')
    b.push('\t%small = icmp slt i64 %ncap0, 4\n')
    b.push('\t%ncap = select i1 %small, i64 4, i64 %ncap0\n')
    b.push('\t%nb = mul i64 %ncap, 8\n')
    b.push('\t%nbp = call i8* @malloc(i64 %nb)\n')
    b.push('\t%nbi = ptrtoint i8* %nbp to i64\n')
    b.push('\t%ob = mul i64 %len, 8\n')
    b.push('\t%empty = icmp eq i64 %ob, 0\n')
    b.push('\tbr i1 %empty, label %store, label %copy\n')
    b.push('copy:\n')
    b.push('\t%old = inttoptr i64 %dat to i8*\n')
    b.push('\tcall void @llvm.memcpy.p0i8.p0i8.i64(i8* %nbp, i8* %old, i64 %ob, i1 0)\n')
    b.push('\tcall void @free(i8* %old)\n')
    b.push('\tbr label %store\n')
    b.push('store:\n')
    b.push('\t%cap2 = phi i64 [ %cap, %entry ], [ %ncap, %grow ], [ %ncap, %copy ]\n')
    b.push('\t%dat2 = phi i64 [ %dat, %entry ], [ %nbi, %grow ], [ %nbi, %copy ]\n')
    b.push('\t%off = mul i64 %len, 8\n')
    b.push('\t%base = inttoptr i64 %dat2 to i8*\n')
    b.push('\t%slot = getelementptr i8, i8* %base, i64 %off\n')
    b.push('\t%sp = bitcast i8* %slot to i64*\n')
    b.push('\tstore i64 %x, i64* %sp\n')
    b.push('\t%len1 = add i64 %len, 1\n')
    b.push('\t%len1t = trunc i64 %len1 to i32\n')
    b.push('\t%cap2t = trunc i64 %cap2 to i32\n')
    b.push('\t%r0 = insertvalue %vec { i32 0, i32 0, i64 0 }, i32 %len1t, 0\n')
    b.push('\t%r1 = insertvalue %vec %r0, i32 %cap2t, 1\n')
    b.push('\t%r2 = insertvalue %vec %r1, i64 %dat2, 2\n')
    b.push('\tret %vec %r2\n}\n')
    r = b.str()
}

; vec 释放（M4-e s99n）：与切片字面量的取得所有权配对，scope-exit 调一次。
;   ⚠️ 数据缓冲**无 RC 头**（§11 B5）⇒ 这不是「减引用计数」，是**一次性 free**：
;      调用后该 %vec 全部字段作废（所有权唯一，见 mir.no OP-VEC-FREE）。
;   ⚠️ dat == 0 短路：@vec_new 的初值 / 空字面量 `[]` 都是 {0,0,0}，free(0) 虽合法但
;      多一次越界分支没有意义，且显式短路让 IR 文本断言能钉住「空字面量不调 free」。
; r: 結果字串
cg-runtime-vec-free = () (r str) {
    b = sb.init(512)
    b.push('define void @vec_free(%vec %v) {\n')
    b.push('entry:\n')
    b.push('\t%dat = extractvalue %vec %v, 2\n')
    b.push('\t%nul = icmp eq i64 %dat, 0\n')
    b.push('\tbr i1 %nul, label %done, label %freeme\n')
    b.push('freeme:\n')
    b.push('\t%p = inttoptr i64 %dat to i8*\n')
    b.push('\tcall void @free(i8* %p)\n')
    b.push('\tbr label %done\n')
    b.push('done:\n')
    b.push('\tret void\n}\n')
    r = b.str()
}

; prelude：类型 + 声明（RC helper 见 cg-rc.no）。M4-a 的「最小 prelude」。
; r: 結果字串
cg-runtime-prelude = () (r str) {
    b = sb.init(256)
    b.push(cg-runtime-hdr-type())
    b.push('\n')
    b.push(cg-runtime-task-type())
    b.push('\n')
    b.push(cg-runtime-str-type())
    b.push('\n')
    b.push(cg-runtime-vec-type())
    b.push('\n')
    b.push(cg-runtime-option-type())
    b.push('\n\n')
    b.push(cg-runtime-decls())
    r = b.str()
}

; prelude-full：完整 prelude，**顺序有语义**——
;   类型 → libc 声明 → memcpy 声明 → RC helper → 字符串 helper → 向量 helper。
; @str_concat 调 @nolang_rc_alloc，故必须排在 RC 之后（LLVM 允许前向引用，
; 但保持与 Go 发射顺序一致便于逐字节对照）。
; r: 結果字串
cg-runtime-prelude-full = () (r str) {
    b = sb.init(8192)
    b.push(cg-runtime-prelude())
    b.push(cg-runtime-memcpy-decl())
    b.push('\n')
    b.push(cg-runtime-memcmp-decl())
    b.push('\n')
    b.push(cg-runtime-div-zero-msg())
    b.push('\n')
    b.push(cg-runtime-div-zero-report())
    b.push('\n')
    b.push(cg-rc-alloc())
    b.push(cg-rc-retain())
    b.push(cg-rc-release())
    b.push(cg-rc-nolang-free())
    b.push(cg-runtime-str-eq())
    b.push('\n')
    b.push(cg-runtime-str-concat())
    b.push(cg-runtime-vec-new())
    b.push(cg-runtime-vec-len())
    b.push(cg-runtime-vec-get())
    b.push(cg-runtime-vec-push())
    b.push(cg-runtime-vec-free())
    b.push(cg-runtime-vec-eq())
    r = b.str()
}
