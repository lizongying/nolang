; Test individual steps of fe-invert
main = () {
    ; a = 9
    base [32]byte
    i <- [0..32): {
        base[i] = 0
    }
    base[0] = 9

    a []i64 = with-len(10)
    x25519.fe-frombytes(a, base)

    print('=== a = 9 ===')
    i <- [0..3): {
        print(a[i])
    }

    ; Step 1: t0 = a^2 = 81
    t0 []i64 = with-len(10)
    x25519.fe-sq(t0, a)
    print('=== t0 = a^2 (expect 81) ===')
    i <- [0..3): {
        print(t0[i])
    }

    ; Step 2: t1 = t0^2 = a^4 = 6561
    t1 []i64 = with-len(10)
    x25519.fe-sq(t1, t0)
    print('=== t1 = a^4 (expect 6561) ===')
    i <- [0..3): {
        print(t1[i])
    }

    ; Step 3: t1 = t1^2 = a^8 = 43046721
    x25519.fe-sq(t1, t1)
    print('=== t1 = a^8 (expect 43046721) ===')
    i <- [0..3): {
        print(t1[i])
    }

    ; Step 4: t1 = a * t1 = a^9 = 387420489
    x25519.fe-mul(t1, a, t1)
    print('=== t1 = a^9 (expect 387420489) ===')
    i <- [0..3): {
        print(t1[i])
    }

    ; Convert a^9 to bytes to verify
    t1-bytes [32]byte
    i <- [0..32): {
        t1-bytes[i] = 0
    }
    x25519.fe-tobytes(t1-bytes, t1)
    print('=== a^9 bytes (expect 129, 42, 28, ...) ===')
    ; 387420489 = 0x17179149
    ; little-endian: 0x49, 0x91, 0x17, 0x17 -> 73, 145, 23, 23
    i <- [0..8): {
        print(t1-bytes[i] & 255)
    }

    ; Step 5: t0 = t0 * t1 = a^2 * a^9 = a^11
    x25519.fe-mul(t0, t0, t1)
    t0-bytes [32]byte
    i <- [0..32): {
        t0-bytes[i] = 0
    }
    x25519.fe-tobytes(t0-bytes, t0)
    print('=== a^11 bytes (expect 31381059609 mod p) ===')
    ; 9^11 = 31381059609 = 0x74F0C279
    ; little-endian: 0x79, 0xC2, 0xF0, 0x74 -> 121, 194, 240, 116
    i <- [0..8): {
        print(t0-bytes[i] & 255)
    }

    ; Now test fe-invert directly
    print('=== fe-invert(9) ===')
    inv []i64 = with-len(10)
    x25519.fe-invert(inv, a)
    inv-bytes [32]byte
    i <- [0..32): {
        inv-bytes[i] = 0
    }
    x25519.fe-tobytes(inv-bytes, inv)
    print('=== inv(9) bytes (expect 18, 199, 113, 28, 199, ...) ===')
    i <- [0..8): {
        print(inv-bytes[i] & 255)
    }

    ; Check: 9 * inv(9) should = 1
    check []i64 = with-len(10)
    x25519.fe-mul(check, a, inv)
    check-bytes [32]byte
    i <- [0..32): {
        check-bytes[i] = 0
    }
    x25519.fe-tobytes(check-bytes, check)
    print('=== 9 * inv(9) bytes (expect 1, 0, 0, ...) ===')
    i <- [0..8): {
        print(check-bytes[i] & 255)
    }
}
