define void @sincos(double %x, double* %sin_out, double* %cos_out) #0 {
entry:
	%s = call double @llvm.sin.f64(double %x)
	%c = call double @llvm.cos.f64(double %x)
	store double %s, double* %sin_out
	store double %c, double* %cos_out
	ret void
}
