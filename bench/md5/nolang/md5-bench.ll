define internal void @nolang.bounds_check(i64 %idx, i64 %len) {
entry:
	%lo = icmp slt i64 %idx, 0
	%hi = icmp sge i64 %idx, %len
	%oob = or i1 %lo, %hi
	br i1 %oob, label %err, label %ok
err:
	call i64 @write(i32 2, i8* getelementptr inbounds ([36 x i8], [36 x i8]* @.str.oob, i64 0, i64 0), i64 36)
	call void @exit(i32 1)
	unreachable
ok:
	ret void
}

define internal i32 @nolang.memcmp(i8* %a, i8* %b, i64 %n) {
entry:
	br label %loop
loop:
	%i = phi i64 [0, %entry], [%i.next, %loop.cont]
	%done = icmp eq i64 %i, %n
	br i1 %done, label %equal, label %body
body:
	%a.ptr = getelementptr i8, i8* %a, i64 %i
	%b.ptr = getelementptr i8, i8* %b, i64 %i
	%a.byte = load i8, i8* %a.ptr
	%b.byte = load i8, i8* %b.ptr
	%cmp.eq = icmp eq i8 %a.byte, %b.byte
	br i1 %cmp.eq, label %loop.cont, label %diff
diff:
	%lt = icmp ult i8 %a.byte, %b.byte
	%result = select i1 %lt, i32 -1, i32 1
	ret i32 %result
loop.cont:
	%i.next = add i64 %i, 1
	br label %loop
equal:
	ret i32 0
}

