define internal i64 @nolang.strlen(i8* %s) {
entry:
	%null.cond = icmp eq i8* %s, null
	br i1 %null.cond, label %done, label %loop
loop:
	%i = phi i64 [0, %entry], [%i.next, %loop]
	%ptr = getelementptr i8, i8* %s, i64 %i
	%c = load i8, i8* %ptr
	%cond = icmp eq i8 %c, 0
	%i.next = add i64 %i, 1
	br i1 %cond, label %done, label %loop
done:
	%len = phi i64 [0, %entry], [%i, %loop]
	ret i64 %len
}

define internal i64 @nolang.strtoll(i8* %s) {
entry:
	%ptr.addr = alloca i8*
	store i8* %s, i8** %ptr.addr
	%neg.flag = alloca i1
	store i1 false, i1* %neg.flag
	%acc = alloca i64
	store i64 0, i64* %acc
	br label %skip.ws
skip.ws:
	%p = load i8*, i8** %ptr.addr
	%c = load i8, i8* %p
	%is.sp = icmp eq i8 %c, 32
	%is.ht = icmp eq i8 %c, 9
	%is.lf = icmp eq i8 %c, 10
	%is.cr = icmp eq i8 %c, 13
	%a1 = or i1 %is.sp, %is.ht
	%a2 = or i1 %a1, %is.lf
	%a3 = or i1 %a2, %is.cr
	br i1 %a3, label %ws.next, label %check.sign
ws.next:
	%p.next = getelementptr i8, i8* %p, i64 1
	store i8* %p.next, i8** %ptr.addr
	br label %skip.ws
check.sign:
	%is.minus = icmp eq i8 %c, 45
	br i1 %is.minus, label %set.neg, label %check.plus
set.neg:
	store i1 true, i1* %neg.flag
	%p.am = getelementptr i8, i8* %p, i64 1
	store i8* %p.am, i8** %ptr.addr
	br label %digit.loop
check.plus:
	%is.plus = icmp eq i8 %c, 43
	br i1 %is.plus, label %skip.plus, label %digit.loop
skip.plus:
	%p.ap = getelementptr i8, i8* %p, i64 1
	store i8* %p.ap, i8** %ptr.addr
	br label %digit.loop
digit.loop:
	%p2 = load i8*, i8** %ptr.addr
	%c2 = load i8, i8* %p2
	%ge.0 = icmp sge i8 %c2, 48
	%le.9 = icmp sle i8 %c2, 57
	%is.dig = and i1 %ge.0, %le.9
	br i1 %is.dig, label %dig.proc, label %done
dig.proc:
	%cur = load i64, i64* %acc
	%mul10 = mul i64 %cur, 10
	%dv = sext i8 %c2 to i64
	%dv.sub = sub i64 %dv, 48
	%new.acc = add i64 %mul10, %dv.sub
	store i64 %new.acc, i64* %acc
	%p3 = getelementptr i8, i8* %p2, i64 1
	store i8* %p3, i8** %ptr.addr
	br label %digit.loop
done:
	%final = load i64, i64* %acc
	%is.neg = load i1, i1* %neg.flag
	br i1 %is.neg, label %negate, label %ret.pos
negate:
	%negated = sub i64 0, %final
	ret i64 %negated
ret.pos:
	ret i64 %final
}

define internal double @nolang.strtod(i8* %s) {
entry:
	%ptr.addr = alloca i8*
	store i8* %s, i8** %ptr.addr
	%neg.flag = alloca i1
	store i1 false, i1* %neg.flag
	%acc = alloca double
	store double 0.0, double* %acc
	%frac.div = alloca double
	store double 1.0, double* %frac.div
	%has.dot = alloca i1
	store i1 false, i1* %has.dot
	br label %skip.ws
skip.ws:
	%p = load i8*, i8** %ptr.addr
	%c = load i8, i8* %p
	%is.sp = icmp eq i8 %c, 32
	%is.ht = icmp eq i8 %c, 9
	%is.lf = icmp eq i8 %c, 10
	%is.cr = icmp eq i8 %c, 13
	%a1 = or i1 %is.sp, %is.ht
	%a2 = or i1 %a1, %is.lf
	%a3 = or i1 %a2, %is.cr
	br i1 %a3, label %ws.next, label %check.sign
ws.next:
	%p.next = getelementptr i8, i8* %p, i64 1
	store i8* %p.next, i8** %ptr.addr
	br label %skip.ws
check.sign:
	%is.minus = icmp eq i8 %c, 45
	br i1 %is.minus, label %set.neg, label %check.plus
set.neg:
	store i1 true, i1* %neg.flag
	%p.am = getelementptr i8, i8* %p, i64 1
	store i8* %p.am, i8** %ptr.addr
	br label %main.loop
check.plus:
	%is.plus = icmp eq i8 %c, 43
	br i1 %is.plus, label %skip.plus, label %main.loop
skip.plus:
	%p.ap = getelementptr i8, i8* %p, i64 1
	store i8* %p.ap, i8** %ptr.addr
	br label %main.loop
main.loop:
	%p2 = load i8*, i8** %ptr.addr
	%c2 = load i8, i8* %p2
	%ge.0 = icmp sge i8 %c2, 48
	%le.9 = icmp sle i8 %c2, 57
	%is.dig = and i1 %ge.0, %le.9
	br i1 %is.dig, label %dig.proc, label %check.dot
dig.proc:
	%dv = sext i8 %c2 to i64
	%dv.sub = sub i64 %dv, 48
	%dv.f = sitofp i64 %dv.sub to double
	%in.frac = load i1, i1* %has.dot
	br i1 %in.frac, label %frac.dig, label %int.dig
int.dig:
	%cur.i = load double, double* %acc
	%mul10 = fmul double %cur.i, 10.0
	%add.i = fadd double %mul10, %dv.f
	store double %add.i, double* %acc
	br label %next.char
frac.dig:
	%cur.f = load double, double* %acc
	%cur.div = load double, double* %frac.div
	%new.div = fmul double %cur.div, 10.0
	store double %new.div, double* %frac.div
	%divided = fdiv double %dv.f, %new.div
	%add.f = fadd double %cur.f, %divided
	store double %add.f, double* %acc
	br label %next.char
next.char:
	%p3 = getelementptr i8, i8* %p2, i64 1
	store i8* %p3, i8** %ptr.addr
	br label %main.loop
check.dot:
	%is.dot = icmp eq i8 %c2, 46
	br i1 %is.dot, label %set.dot, label %check.exp
set.dot:
	store i1 true, i1* %has.dot
	%p.ad = getelementptr i8, i8* %p2, i64 1
	store i8* %p.ad, i8** %ptr.addr
	br label %main.loop
check.exp:
	%is.e = icmp eq i8 %c2, 101
	%is.E = icmp eq i8 %c2, 69
	%is.exp = or i1 %is.e, %is.E
	br i1 %is.exp, label %exp.setup, label %done
exp.setup:
	%p.ae = getelementptr i8, i8* %p2, i64 1
	store i8* %p.ae, i8** %ptr.addr
	%exp.neg = alloca i1
	store i1 false, i1* %exp.neg
	%exp.acc = alloca i64
	store i64 0, i64* %exp.acc
	%pe0 = load i8*, i8** %ptr.addr
	%ce0 = load i8, i8* %pe0
	%exp.is.minus = icmp eq i8 %ce0, 45
	br i1 %exp.is.minus, label %exp.set.neg, label %exp.check.plus
exp.set.neg:
	store i1 true, i1* %exp.neg
	%p.aem = getelementptr i8, i8* %pe0, i64 1
	store i8* %p.aem, i8** %ptr.addr
	br label %exp.dig.loop
exp.check.plus:
	%exp.is.plus = icmp eq i8 %ce0, 43
	br i1 %exp.is.plus, label %exp.skip.plus, label %exp.dig.loop
exp.skip.plus:
	%p.aep = getelementptr i8, i8* %pe0, i64 1
	store i8* %p.aep, i8** %ptr.addr
	br label %exp.dig.loop
exp.dig.loop:
	%pe2 = load i8*, i8** %ptr.addr
	%ce2 = load i8, i8* %pe2
	%ege.0 = icmp sge i8 %ce2, 48
	%ele.9 = icmp sle i8 %ce2, 57
	%eis.dig = and i1 %ege.0, %ele.9
	br i1 %eis.dig, label %exp.dig.proc, label %exp.apply
exp.dig.proc:
	%ec = load i64, i64* %exp.acc
	%emul = mul i64 %ec, 10
	%edv = sext i8 %ce2 to i64
	%edv.sub = sub i64 %edv, 48
	%enew = add i64 %emul, %edv.sub
	store i64 %enew, i64* %exp.acc
	%pe3 = getelementptr i8, i8* %pe2, i64 1
	store i8* %pe3, i8** %ptr.addr
	br label %exp.dig.loop
exp.apply:
	%exp.val = load i64, i64* %exp.acc
	%exp.f = sitofp i64 %exp.val to double
	%pow10 = call double @llvm.pow.f64(double 10.0, double %exp.f)
	%exp.is.neg = load i1, i1* %exp.neg
	br i1 %exp.is.neg, label %exp.div, label %exp.mul
exp.div:
	%before.div = load double, double* %acc
	%after.div = fdiv double %before.div, %pow10
	store double %after.div, double* %acc
	br label %done
exp.mul:
	%before.mul = load double, double* %acc
	%after.mul = fmul double %before.mul, %pow10
	store double %after.mul, double* %acc
	br label %done
done:
	%final = load double, double* %acc
	%is.neg = load i1, i1* %neg.flag
	br i1 %is.neg, label %negate, label %ret.pos
negate:
	%negated = fneg double %final
	ret double %negated
ret.pos:
	ret double %final
}

define internal i64 @nolang.now_ms() {
entry:
	%tv = alloca [16 x i8]
	%tv.ptr = bitcast [16 x i8]* %tv to i8*
	call i32 @gettimeofday(i8* %tv.ptr, i8* null)
	%sec.ptr = bitcast [16 x i8]* %tv to i64*
	%sec = load i64, i64* %sec.ptr
	%usec.ptr = getelementptr i64, i64* %sec.ptr, i64 1
	%usec = load i64, i64* %usec.ptr
	%sec.ms = mul i64 %sec, 1000
	%usec.ms = sdiv i64 %usec, 1000
	%result = add i64 %sec.ms, %usec.ms
	ret i64 %result
}

define internal i64 @nolang.now_s() {
entry:
	%tv = alloca [16 x i8]
	%tv.ptr = bitcast [16 x i8]* %tv to i8*
	call i32 @gettimeofday(i8* %tv.ptr, i8* null)
	%sec.ptr = bitcast [16 x i8]* %tv to i64*
	%sec = load i64, i64* %sec.ptr
	ret i64 %sec
}

define internal i64 @nolang.now_us() {
entry:
	%tv = alloca [16 x i8]
	%tv.ptr = bitcast [16 x i8]* %tv to i8*
	call i32 @gettimeofday(i8* %tv.ptr, i8* null)
	%sec.ptr = bitcast [16 x i8]* %tv to i64*
	%sec = load i64, i64* %sec.ptr
	%usec.ptr = getelementptr i64, i64* %sec.ptr, i64 1
	%usec = load i64, i64* %usec.ptr
	%sec.us = mul i64 %sec, 1000000
	%result = add i64 %sec.us, %usec
	ret i64 %result
}

define internal i64 @nolang.now_ns() {
entry:
	%ts = alloca [16 x i8]
	%ts.ptr = bitcast [16 x i8]* %ts to i8*
	call i32 @clock_gettime(i32 0, i8* %ts.ptr)
	%sec.ptr = bitcast [16 x i8]* %ts to i64*
	%sec = load i64, i64* %sec.ptr
	%nsec.ptr = getelementptr i64, i64* %sec.ptr, i64 1
	%nsec = load i64, i64* %nsec.ptr
	%sec.ns = mul i64 %sec, 1000000000
	%result = add i64 %sec.ns, %nsec
	ret i64 %result
}

define internal void @nolang.sleep_us(i64 %us) {
entry:
	%us.trunc = trunc i64 %us to i32
	call i32 @usleep(i32 %us.trunc)
	ret void
}

define internal i64 @nolang.sleep_s(i64 %sec) {
entry:
	%req = alloca [16 x i8]
	%sec.ptr = bitcast [16 x i8]* %req to i64*
	store i64 %sec, i64* %sec.ptr
	%nsec.ptr = getelementptr i64, i64* %sec.ptr, i64 1
	store i64 0, i64* %nsec.ptr
	%req.ptr = bitcast [16 x i8]* %req to i8*
	call i32 @nanosleep(i8* %req.ptr, i8* null)
	ret i64 0
}

define internal void @nolang.sleep_ns(i64 %ns) {
entry:
	%req = alloca [16 x i8]
	%sec = sdiv i64 %ns, 1000000000
	%nsec = srem i64 %ns, 1000000000
	%sec.ptr = bitcast [16 x i8]* %req to i64*
	store i64 %sec, i64* %sec.ptr
	%nsec.ptr = getelementptr i64, i64* %sec.ptr, i64 1
	store i64 %nsec, i64* %nsec.ptr
	%req.ptr = bitcast [16 x i8]* %req to i8*
	call i32 @nanosleep(i8* %req.ptr, i8* null)
	ret void
}

