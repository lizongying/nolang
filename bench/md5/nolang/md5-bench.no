; md5-bench — Nolang MD5 基準測試
;
; 測量 100,000 次 MD5（"abc"，每次修改 input[2] 防止死代碼消除）
;
; 編譯：
;   no build test/bench/md5/nolang/md5-bench.no
;   ./dist/md5-bench

input []byte = ["a", "b", "c"]
result [16]byte

i <- [0..100000): {
    input[2] = i & 255
    result = md5.md5(input)
}
b = result[0]
print('{b}')
