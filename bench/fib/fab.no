; fib 模組 — 提供 fib 函數

; 功能待補充
fib = () {
    n = 10
    a = 0
    b = 1
    i = 2
    (i <= n) {

        #{overflow=wrap}
        c = a + b
        a = b
        b-opt = c
        b-opt: {
            ok -> b = it

            ->
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt = i + 1
            i-opt: {
                ok -> i = it

                ->
            }
        }
    }
    print(b)
}
