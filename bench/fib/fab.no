fib = () {
    n = 10
    a = 0
    b = 1
    i = 2
    (i <= n) {

        #{overflow=wrap}
        c = a + b
        a = b
        b-opt = c
        b-opt: {
            ok -> b = it
            ->
        }

        #{overflow=wrap}
        i = i + 1
    }
    print(b)
}
