; Fibonacci — Nolang 版本，純計算無 I/O（附編譯屏障）

fib = (n i64) (o i64) {
    a = 0
    b = 1
    i = 2
    (i <= n) {

        #{overflow=wrap}
        c = a + b
        a = b
        b = c

        #{overflow=wrap}
        i = i + 1
    }
    o = b
}
sink = 0
iter <- [0..10000000): {
    result = 0
    n = iter
    {
        iter < 5000000 -> n = 40

        iter >= 5000000 -> n = 41
    }
    result = fib(n)
    sink = result
}
