; Minimal test for fe_tobytes byte packing bug
main = () {
    ; Simulate t[4] value from fe_frombytes for test 2 input
    t4 = 4474956

    ; Expected: s[13] = 19, s[14] = 18, s[15] = 17
    s13 = (t4 >> 2) & 255
    s14 = (t4 >> 10) & 255
    s15 = (t4 >> 18) & 255

    print('t4 =')
    print(t4)
    print('s13 (expect 19) =')
    print(s13)
    print('s14 (expect 18) =')
    print(s14)
    print('s15 (expect 17) =')
    print(s15)

    ; Now test with array
    t []i64 = with-len(10)
    t[0] = 18751264
    t[1] = 8832775
    t[2] = 48431907
    t[3] = 10528944
    t[4] = 4474956
    t[5] = 17698576
    t[6] = 17139206
    t[7] = 14745889
    t[8] = 4214880
    t[9] = 4227264

    ; Direct array access
    print('array t[4] =')
    print(t[4])
    print('array s13 (expect 19) =')
    print((t[4] >> 2) & 255)
    print('array s14 (expect 18) =')
    print((t[4] >> 10) & 255)
    print('array s15 (expect 17) =')
    print((t[4] >> 18) & 255)

    ; Test carry propagation step by step
    ; Step 3: carry from t[2] to t[3]
    c = (t[2] + 33554432) >> 26
    t[2] = t[2] - (c << 26)
    t[3] = t[3] + c

    print('After step 3:')
    print('c =')
    print(c)
    print('t[2] =')
    print(t[2])
    print('t[3] =')
    print(t[3])

    ; Step 4: carry from t[3] to t[4]
    c = (t[3] + 16777216) >> 25
    t[3] = t[3] - (c << 25)
    t[4] = t[4] + c

    print('After step 4:')
    print('c =')
    print(c)
    print('t[3] =')
    print(t[3])
    print('t[4] =')
    print(t[4])

    ; Now check s[14] again
    print('After carry, array s14 =')
    print((t[4] >> 10) & 255)
    print('After carry, array s13 =')
    print((t[4] >> 2) & 255)
    print('After carry, array s15 =')
    print((t[4] >> 18) & 255)
}
