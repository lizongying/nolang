; Minimal X25519 debug test
main = () {
    ; Alice's private key
    alice-priv [32]byte
    alice-priv-hex = [
        119, 7, 109, 10, 115, 24, 165, 125,
        60, 22, 193, 114, 81, 178, 102, 69,
        223, 76, 47, 135, 235, 192, 153, 42,
        177, 119, 251, 165, 29, 185, 44, 42,
    ]
    i <- [0..32): {
        alice-priv[i] = alice-priv-hex[i]
    }

    ; Alice's public key
    alice-pub [32]byte
    alice-pub = x25519.x25519-scalarmult-base(alice-priv)

    ; Expected: 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
    expected-alice-pub = [
        133, 32, 240, 9, 137, 48, 167, 84,
        116, 139, 125, 220, 180, 62, 247, 90,
        13, 191, 58, 13, 38, 56, 26, 244,
        235, 164, 169, 142, 170, 155, 78, 106,
    ]

    print('=== got ===')
    i <- [0..32): {
        print(alice-pub[i] & 255)
    }

    print('=== expected ===')
    i <- [0..32): {
        print(expected-alice-pub[i])
    }

    ; Check match
    alice-ok = true
    i <- [0..32): {
        (alice-pub[i] & 255) != expected-alice-pub[i] -> alice-ok = false
    }
    alice-ok -> print('PASS: Alice pub matches')
    alice-ok == false -> print('FAIL: Alice pub mismatch')
}
