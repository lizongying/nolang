p9, f9 = runner.test('pretty option', t-option)
#{overflow=wrap}
passed = passed + p9
#{overflow=wrap}
failed = failed + f9

p10, f10 = runner.test('pretty implicit float', t-implicit-float)
#{overflow=wrap}
passed = passed + p10
#{overflow=wrap}
failed = failed + f10

p11, f11 = runner.test('pretty element', t-element-pretty)
#{overflow=wrap}
passed = passed + p11
#{overflow=wrap}
failed = failed + f11

p12, f12 = runner.test('pretty json', t-json-pretty)
#{overflow=wrap}
passed = passed + p12
#{overflow=wrap}
failed = failed + f12

p13, f13 = runner.test('pretty yaml', t-yaml-pretty)
#{overflow=wrap}
passed = passed + p13
#{overflow=wrap}
failed = failed + f13

p14, f14 = runner.test('pretty toml', t-toml-pretty)
#{overflow=wrap}
passed = passed + p14
#{overflow=wrap}
failed = failed + f14

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
