#{overflow=wrap}
passed = passed + p8

#{overflow=wrap}
failed = failed + f8
p9, f9 = runner.test('byte.to-str ascii', t-to-str-ascii)

#{overflow=wrap}
passed = passed + p9

#{overflow=wrap}
failed = failed + f9
p10, f10 = runner.test('byte.to-str 2-byte', t-to-str-2byte)

#{overflow=wrap}
passed = passed + p10

#{overflow=wrap}
failed = failed + f10
p11, f11 = runner.test('byte.to-str 1:1 copy', t-to-str-one-to-one)

#{overflow=wrap}
passed = passed + p11

#{overflow=wrap}
failed = failed + f11
p12, f12 = runner.test('byte.to-str empty', t-to-str-empty)

#{overflow=wrap}
passed = passed + p12

#{overflow=wrap}
