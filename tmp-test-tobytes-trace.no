; Trace fe_tobytes with test 2 input
main = () {
    ; Input limbs from fe_frombytes for test 2
    t []i64 = with-len(10)
    t[0] = 18751264
    t[1] = 8832775
    t[2] = 48431907
    t[3] = 10528944
    t[4] = 4474956
    t[5] = 17698576
    t[6] = 17139206
    t[7] = 14745889
    t[8] = 4214880
    t[9] = 4227264

    print('Initial t[4] =')
    print(t[4])

    ; First carry pass (full)
    c = (t[0] + 33554432) >> 26
    t[0] = t[0] - (c << 26)
    t[1] = t[1] + c
    c = (t[1] + 16777216) >> 25
    t[1] = t[1] - (c << 25)
    t[2] = t[2] + c
    c = (t[2] + 33554432) >> 26
    t[2] = t[2] - (c << 26)
    t[3] = t[3] + c
    c = (t[3] + 16777216) >> 25
    t[3] = t[3] - (c << 25)
    t[4] = t[4] + c
    c = (t[4] + 33554432) >> 26
    t[4] = t[4] - (c << 26)
    t[5] = t[5] + c
    c = (t[5] + 16777216) >> 25
    t[5] = t[5] - (c << 25)
    t[6] = t[6] + c
    c = (t[6] + 33554432) >> 26
    t[6] = t[6] - (c << 26)
    t[7] = t[7] + c
    c = (t[7] + 16777216) >> 25
    t[7] = t[7] - (c << 25)
    t[8] = t[8] + c
    c = (t[8] + 33554432) >> 26
    t[8] = t[8] - (c << 26)
    t[9] = t[9] + c
    c = (t[9] + 16777216) >> 25
    t[9] = t[9] - (c << 25)
    t[0] = t[0] + c * 19

    print('After first carry, t[4] =')
    print(t[4])
    print('s14 after first carry =')
    print((t[4] >> 10) & 255)

    ; Second carry (wrap-around)
    c = (t[0] + 33554432) >> 26
    t[0] = t[0] - (c << 26)
    t[1] = t[1] + c
    c = (t[1] + 16777216) >> 25
    t[1] = t[1] - (c << 25)
    t[2] = t[2] + c

    print('After second carry, t[4] =')
    print(t[4])

    ; +19 and simple carry
    t[0] = t[0] + 19

    c = t[0] >> 26
    t[0] = t[0] - (c << 26)
    t[1] = t[1] + c
    c = t[1] >> 25
    t[1] = t[1] - (c << 25)
    t[2] = t[2] + c
    c = t[2] >> 26
    t[2] = t[2] - (c << 26)
    t[3] = t[3] + c
    c = t[3] >> 25
    t[3] = t[3] - (c << 25)
    t[4] = t[4] + c
    c = t[4] >> 26
    t[4] = t[4] - (c << 26)
    t[5] = t[5] + c
    c = t[5] >> 25
    t[5] = t[5] - (c << 25)
    t[6] = t[6] + c
    c = t[6] >> 26
    t[6] = t[6] - (c << 26)
    t[7] = t[7] + c
    c = t[7] >> 25
    t[7] = t[7] - (c << 25)
    t[8] = t[8] + c
    c = t[8] >> 26
    t[8] = t[8] - (c << 26)
    t[9] = t[9] + c
    c = t[9] >> 25
    t[9] = t[9] - (c << 25)

    print('After simple carry, t[4] =')
    print(t[4])
    print('c (from t[9]) =')
    print(c)

    mask = 0 - (1 - c)
    t[0] = t[0] - (19 & mask)

    print('Final t[4] =')
    print(t[4])
    print('Final s14 =')
    print((t[4] >> 10) & 255)
    print('Final s13 =')
    print((t[4] >> 2) & 255)
    print('Final s15 =')
    print((t[4] >> 18) & 255)
}
