; Test fe operations with p-1
main = () {
    ; p-1 = 2^255 - 20
    ; In little-endian: byte 0 = 236 (0xEC), bytes 1-30 = 255, byte 31 = 127 (0x7F)
    vp [32]byte
    i <- [0..32): {
        vp[i] = 255
    }
    vp[0] = 236
    vp[31] = 127

    ; Round-trip test
    c []i64 = with-len(10)
    x25519.fe-frombytes(c, vp)
    print('p-1 limbs:')
    i <- [0..10): {
        print(c[i])
    }

    out [32]byte
    x25519.fe-tobytes(out, c)
    print('p-1 round-trip bytes:')
    i <- [0..32): {
        print(out[i] & 255)
    }

    ; Check round-trip
    rt-ok = true
    i <- [0..32): {
        (out[i] & 255) != (vp[i] & 255) -> rt-ok = false
    }
    rt-ok -> print('PASS: p-1 round-trip')
    rt-ok == false -> print('FAIL: p-1 round-trip')

    ; (p-1)^2 = 1 mod p (since p-1 = -1)
    r []i64 = with-len(10)
    x25519.fe-mul(r, c, c)
    print('(p-1)^2 limbs:')
    i <- [0..10): {
        print(r[i])
    }

    x25519.fe-tobytes(out, r)
    print('(p-1)^2 bytes (expect all 0 except byte 0 = 1):')
    i <- [0..32): {
        print(out[i] & 255)
    }

    ; Full check
    sq-ok = true
    i <- [1..32): {
        (out[i] & 255) != 0 -> sq-ok = false
    }
    (out[0] & 255) == 1 -> print('byte 0 ok')
    (out[0] & 255) != 1 -> print('byte 0 FAIL')
    sq-ok -> print('PASS: (p-1)^2 = 1 (all high bytes 0)')
    sq-ok == false -> print('FAIL: (p-1)^2 has non-zero high bytes')

    ; Also test: p-1 + p-1 = p-2 = -2 mod p = p - 2
    ; p-2 = 2^255 - 21
    ; byte 0 = 256 - 21 = 235, bytes 1-30 = 255, byte 31 = 127
    s []i64 = with-len(10)
    x25519.fe-add(s, c, c)
    x25519.fe-tobytes(out, s)
    print('(p-1)+(p-1) bytes (expect: 235, 255, ..., 255, 127):')
    i <- [0..32): {
        print(out[i] & 255)
    }
}
