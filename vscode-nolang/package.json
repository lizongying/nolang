{
  "name": "vscode-nolang",
  "displayName": "Nolang Support",
  "description": "Nolang support for Visual Studio Code",
  "version": "0.3.4",
  "icon": "icon.png",
  "publisher": "lizongying",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lizongying/nolang"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./client/out/extension",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "nolang",
        "aliases": [
          "Nolang",
          "nolang"
        ],
        "extensions": [
          ".no"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icon16x16.png",
          "light": "./icon16x16.png"
        },
        "mimetypes": [
          "text/x-nolang"
        ]
      },
      {
        "id": "noml",
        "aliases": [
          "NOML",
          "noml"
        ],
        "extensions": [
          ".noml"
        ],
        "filenames": [
          "workspace.noml",
          "package.noml",
          ".workspace.noml",
          "nolang.lock.noml",
          "sum.noml"
        ],
        "configuration": "./language-configuration-noml.json"
      }
    ],
    "grammars": [
      {
        "language": "nolang",
        "scopeName": "source.nolang",
        "path": "./syntaxes/nolang.tmLanguage.json"
      },
      {
        "language": "noml",
        "scopeName": "source.noml",
        "path": "./syntaxes/noml.tmLanguage.json"
      },
      {
        "scopeName": "inject.nolang.md",
        "path": "./syntaxes/md-nolang-inject.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nolang": "nolang"
        }
      }
    ],
    "configurationDefaults": {
      "[nolang]": {
        "editor.defaultFormatter": "lizongying.vscode-nolang",
        "editor.formatOnSave": true
      }
    },
    "configuration": {
      "type": "object",
      "title": "Nolang",
      "properties": {
        "nolang.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Nolang language server executable"
        },
        "nolang.languageServer.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for the language server"
        },
        "nolang.fmt.rewrite": {
          "type": "boolean",
          "default": true,
          "description": "Format-on-save applies the same active rewrites as `no fmt` (remove redundant type annotations, ineffective overflow annotations, flip string concatenation). Turn off for layout-only formatting."
        },
        "nolang.fmt.redundantTypes": {
          "type": "boolean",
          "default": true,
          "description": "Remove explicit type annotations whose type equals the inferred type (e.g. `x str = ''` -> `x = ''`). Requires nolang.fmt.rewrite."
        },
        "nolang.fmt.ineffectiveOverflow": {
          "type": "boolean",
          "default": true,
          "description": "Remove #{overflow=...} annotations whose governed statement contains no integer arithmetic. Requires nolang.fmt.rewrite."
        },
        "nolang.fmt.stringConcat": {
          "type": "boolean",
          "default": true,
          "description": "Rewrite string concatenation `+` to Nolang's `-` operator during formatting. Requires nolang.fmt.rewrite."
        },
        "nolang.fmt.crossModuleSignatures": {
          "type": "boolean",
          "default": true,
          "description": "Load std/local module signatures while formatting. Disable to fall back to a single-file view (type-driven rewrites and bool-comparison simplification become conservative)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p client/tsconfig.json",
    "watch": "tsc -watch -p client/tsconfig.json",
    "package": "vsce package --out ../bin/",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.80.0",
    "ts-loader": "^9.6.0",
    "typescript": "^5.0.0",
    "vsce": "^2.0.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}