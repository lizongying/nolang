// Test: compare with varying k
words []str = with-cap(256)
counts []i64 = with-cap(256)
word [64]byte
wlen i64 = 0
n i64 = 0
c i64 = 0
found i64 = 0
k = 0
tmp-word str = ''
lower i64 = 0
total-words i64 = 0
r i64 = 0

; Pre-push 3 words
word[0] = 104
word[1] = 101
word[2] = 108
word[3] = 108
word[4] = 111
wlen = 5
tmp-word = with-cap(64)
k <- [0..wlen): {
    tmp-word[k] = word[k]
}
words.push(tmp-word)
counts.push(1)
word[0] = 119
word[1] = 111
word[2] = 114
word[3] = 108
word[4] = 100
wlen = 5
tmp-word = with-cap(64)
k <- [0..wlen): {
    tmp-word[k] = word[k]
}
words.push(tmp-word)
counts.push(1)
word[0] = 102
word[1] = 111
word[2] = 111
wlen = 3
tmp-word = with-cap(64)
k <- [0..wlen): {
    tmp-word[k] = word[k]
}
words.push(tmp-word)
counts.push(1)
n = 3
wlen = 0

{
    line str = ''
    ok = false
    line, ok = get-line()
    ok == false -> break
    bs []byte = line.to-bytes()
    j <- [0..bs.len): {
        c = bs[j]
        (c >= 65 && c <= 90) || (c >= 97 && c <= 122) -> {
            lower = c
            c >= 65 && c <= 90 -> lower = c + 32
            wlen < 64 -> {
                word[wlen] = lower
                wlen = wlen + 1
            }
        }
        !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) -> {
            wlen >= 3 -> {
                total-words = total-words + 1
                tmp-word = with-cap(64)
                k <- [0..wlen): {
                    tmp-word[k] = word[k]
                }
                ; Compare tmp-word with all words
                k <- [0..n): {
                    r = tmp-word.compare(words[k])
                }
            }
            wlen = 0
        }
    }
} ()

print('total words: ' + total-words.to-str())
print('unique: ' + n.to-str())
