; Test fe-invert addition chain step by step
; For a=2, verify each intermediate exponent
main = () {
    ; a = 2
    a []i64 = with-len(10)
    a[0] = 2

    t0 []i64 = with-len(10)
    t1 []i64 = with-len(10)
    t2 []i64 = with-len(10)
    t3 []i64 = with-len(10)

    out [32]byte

    ; Step 1: t0 = a^2 = 4
    x25519.fe-sq(t0, a)
    x25519.fe-tobytes(out, t0)
    print('a^2 = ? (expect 4)')
    print(out[0] & 255)
    print(out[1] & 255)

    ; Step 2: t1 = t0^2 = a^4 = 16
    x25519.fe-sq(t1, t0)
    x25519.fe-tobytes(out, t1)
    print('a^4 = ? (expect 16)')
    print(out[0] & 255)
    print(out[1] & 255)

    ; Step 3: t1 = t1^2 = a^8 = 256
    x25519.fe-sq(t1, t1)
    x25519.fe-tobytes(out, t1)
    print('a^8 = ? (expect 256)')
    print(out[0] & 255)
    print(out[1] & 255)

    ; Step 4: t1 = a * t1 = a^9 = 512
    x25519.fe-mul(t1, a, t1)
    x25519.fe-tobytes(out, t1)
    print('a^9 = ? (expect 512)')
    print(out[0] & 255)
    print(out[1] & 255)

    ; Step 5: t0 = t0 * t1 = a^11 = 2048
    x25519.fe-mul(t0, t0, t1)
    x25519.fe-tobytes(out, t0)
    print('a^11 = ? (expect 2048)')
    print(out[0] & 255)
    print(out[1] & 255)

    ; Step 6: t2 = t0^2 = a^22 = 4194304
    x25519.fe-sq(t2, t0)
    x25519.fe-tobytes(out, t2)
    print('a^22 = ? (expect 4194304)')
    print(out[0] & 255)
    print(out[1] & 255)
    print(out[2] & 255)
    print(out[3] & 255)

    ; Step 7: t1 = t1 * t2 = a^31 = 2147483648 = 2^31
    x25519.fe-mul(t1, t1, t2)
    x25519.fe-tobytes(out, t1)
    print('a^31 = ? (expect 2^31 = 2147483648)')
    print(out[0] & 255)
    print(out[1] & 255)
    print(out[2] & 255)
    print(out[3] & 255)
    print(out[4] & 255)

    ; 2^31 in little-endian: 0x00, 0x00, 0x00, 0x80, 0x00
    (out[0] & 255) == 0 -> print('byte 0 ok')
    (out[1] & 255) == 0 -> print('byte 1 ok')
    (out[2] & 255) == 0 -> print('byte 2 ok')
    (out[3] & 255) == 128 -> print('byte 3 ok')
    (out[4] & 255) == 0 -> print('byte 4 ok')

    ; Now test a^1023 = a^(2^10-1) = 2^1023
    ; This is a huge number, can't easily verify bytes
    ; Instead test: a^1023 * a = a^1024 = 2^1024
    ; And 2^1024 mod p = 2^1024 mod (2^255-19)
    ; 2^255 = 19 mod p, so 2^1024 = 2^(4*255 + 4) = 19^4 * 2^4 = 130321 * 16 = 2085136
    x25519.fe-sq(t2, t1); t2 = a^62
    i <- [0..4): {
        x25519.fe-sq(t2, t2)
    }

    ; t2 = a^(31*32) = a^992
    x25519.fe-mul(t1, t2, t1)

    ; t1 = a^1023

    ; t1 * a = a^1024 = 2^1024 mod p
    x25519.fe-mul(t2, t1, a)
    x25519.fe-tobytes(out, t2)
    print('2^1024 mod p = ? (expect 2085136)')
    i <- [0..8): {
        print(out[i] & 255)
    }

    ; 2085136 = 0x1FCD90
    ; little-endian: 0x90, 0xCD, 0x1F, 0x00, ...
    (out[0] & 255) == 144 -> print('byte 0 ok (144)')
    (out[1] & 255) == 205 -> print('byte 1 ok (205)')
    (out[2] & 255) == 31 -> print('byte 2 ok (31)')
}
