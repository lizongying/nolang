; os — 作業系統介面標準庫
;
; 提供環境變數、目錄操作、行程管理、系統資訊、時間等 OS 層級功能。
; 檔案讀寫相關功能請見 fs 模組。

; ═══════════════════════════════════════════════
; 環境變數
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: getenv)
; get-env: 取得環境變數
; get-env = (key str) (val str) {  // LLVM: call i8* @getenv
; }

; build-in (ForwardFunc: setenv)
; set-env: 設定環境變數
; set-env = (k str, v str) (ok bool) {  // LLVM: call i32 @setenv
; }

; ═══════════════════════════════════════════════
; 目錄與路徑
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: getcwd)
; get-wd: 取得當前工作目錄
; get-wd = () (dir str) {  // LLVM: call i8* @getcwd → @.os-buf
; }

; build-in (ForwardFunc: chdir)
; ch-dir: 切換工作目錄
; ch-dir = (d str) (ok bool) {  // LLVM: call i32 @chdir
; }

; build-in (ForwardFunc: mkdir)
; mkdir: 建立目錄
; mkdir = (p str, mode i64) (ok bool) {  // LLVM: call i32 @mkdir → zext
; }

; ═══════════════════════════════════════════════
; 行程
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: exit)
; exit: 結束行程
; exit = (c i64) {  // LLVM: call void @exit(i32)
; }

; build-in (ForwardFunc: getpid)
; get-pid: 取得行程 ID
; get-pid = () (pid i64) {  // LLVM: call i32 @getpid → zext
; }

; ═══════════════════════════════════════════════
; 系統資訊
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: gethostname)
; host-name: 取得主機名稱
; host-name = () (name str) {  // LLVM: call i32 @gethostname → @.os-buf
; }

; build-in (ForwardFunc: get-arch)
; get-arch: 取得當前 CPU 架構（編譯期常數，如 arm64、amd64）
; get-arch = () (arch str) {  // LLVM: compile-time constant string from runtime.GOARCH
; }

; strerror: 將 POSIX errno 轉為人類可讀的錯誤訊息
; 以 Nolang 查表實現，取代 libc @strerror CLibCall
; 涵蓋 POSIX 標準 errno (1-40)，未知值返回 "Unknown error: N"
strerror = (errnum i64) (msg str) {
    {
        errnum == 1 -> msg = 'Operation not permitted'
        errnum == 2 -> msg = 'No such file or directory'
        errnum == 3 -> msg = 'No such process'
        errnum == 4 -> msg = 'Interrupted system call'
        errnum == 5 -> msg = 'Input/output error'
        errnum == 6 -> msg = 'No such device or address'
        errnum == 7 -> msg = 'Argument list too long'
        errnum == 8 -> msg = 'Exec format error'
        errnum == 9 -> msg = 'Bad file descriptor'
        errnum == 10 -> msg = 'No child processes'
        errnum == 11 -> msg = 'Resource temporarily unavailable'
        errnum == 12 -> msg = 'Cannot allocate memory'
        errnum == 13 -> msg = 'Permission denied'
        errnum == 14 -> msg = 'Bad address'
        errnum == 15 -> msg = 'Block device required'
        errnum == 16 -> msg = 'Device or resource busy'
        errnum == 17 -> msg = 'File exists'
        errnum == 18 -> msg = 'Invalid cross-device link'
        errnum == 19 -> msg = 'No such device'
        errnum == 20 -> msg = 'Not a directory'
        errnum == 21 -> msg = 'Is a directory'
        errnum == 22 -> msg = 'Invalid argument'
        errnum == 23 -> msg = 'Too many open files in system'
        errnum == 24 -> msg = 'Too many open files'
        errnum == 25 -> msg = 'Inappropriate ioctl for device'
        errnum == 26 -> msg = 'Text file busy'
        errnum == 27 -> msg = 'File too large'
        errnum == 28 -> msg = 'No space left on device'
        errnum == 29 -> msg = 'Illegal seek'
        errnum == 30 -> msg = 'Read-only file system'
        errnum == 31 -> msg = 'Too many links'
        errnum == 32 -> msg = 'Broken pipe'
        errnum == 33 -> msg = 'Numerical argument out of domain'
        errnum == 34 -> msg = 'Numerical result out of range'
        errnum == 35 -> msg = 'Resource deadlock avoided'
        errnum == 36 -> msg = 'Operation now in progress'
        errnum == 37 -> msg = 'Operation already in progress'
        errnum == 38 -> msg = 'Socket operation on non-socket'
        errnum == 39 -> msg = 'Destination address required'
        errnum == 40 -> msg = 'Message too long'
        errnum == 98 -> msg = 'Address already in use'
        errnum == 99 -> msg = 'Cannot assign requested address'
        errnum == 100 -> msg = 'Network is down'
        errnum == 101 -> msg = 'Network is unreachable'
        errnum == 104 -> msg = 'Connection reset by peer'
        errnum == 110 -> msg = 'Connection timed out'
        errnum == 111 -> msg = 'Connection refused'
        errnum == 113 -> msg = 'No route to host'
        -> msg = 'Unknown error: ' + errnum.to-str()
    }
}
; build-in (ForwardFunc: get-errno)
; get-errno: 取得最後的 errno 值
; get-errno = () (errno i64) {  // LLVM: call i32* @__errno_location() → load → sext
; }

; ═══════════════════════════════════════════════
; 權限與檔案資訊
; ═══════════════════════════════════════════════

; build-in (CLibCall: chmod)
; ch-mod: 變更檔案權限
; ch-mod = (path str, mode i64) (ok bool) { }

; build-in (CLibCall: chown)
; chown: 變更檔案擁有者與群組（uid, gid）
; chown = (path str, uid i64, gid i64) (ok bool) { }

; build-in (ForwardFunc: getuid)
; getuid: 取得當前使用者 ID
; getuid = () (uid i64) { }

; build-in (ForwardFunc: getgid)
; getgid: 取得當前群組 ID
; getgid = () (gid i64) { }

; build-in (ForwardFunc: stat-mode)
; stat-mode: 取得檔案模式（包含權限與類型位元）
; stat-mode = (path str) (mode i64, ok bool) { }

; build-in (ForwardFunc: stat-uid)
; stat-uid: 取得檔案擁有者 uid
; stat-uid = (path str) (uid i64, ok bool) { }

; build-in (ForwardFunc: stat-gid)
; stat-gid: 取得檔案群組 gid
; stat-gid = (path str) (gid i64, ok bool) { }

; build-in (ForwardFunc: stat-mtime)
; stat-mtime: 取得檔案修改時間（Unix 秒）
; stat-mtime = (path str) (mtime i64, ok bool) { }
; ═══════════════════════════════════════════════
; 時間
; ═══════════════════════════════════════════════
; build-in (CLibCall: nolang.now_s)
; now: 取得當前 Unix 時間戳（秒）
; now = () (ts i64) {  // LLVM: call i64 @nolang.now_s（gettimeofday → tv_sec）
; }
; build-in (CLibCall: nolang.now_ms)
; now-ms: 取得當前 Unix 時間戳（毫秒）
; now-ms = () (ts i64) {  // LLVM: call i64 @nolang.now_ms
; }
; build-in (CLibCall: nolang.now_us)
; now-us: 取得當前 Unix 時間戳（微秒）
; now-us = () (ts i64) {  // LLVM: call i64 @nolang.now_us
; }
; build-in (CLibCall: nolang.now_ns)
; now-ns: 取得當前時間戳（奈秒）
; now-ns = () (ts i64) {  // LLVM: call i64 @nolang.now_ns
; }
; build-in (CLibCall: nolang.sleep_s)
; sleep: 睡眠 n 秒
; sleep = (s i64) (ok i64) {  // LLVM: call i64 @nolang.sleep_s（nanosleep）→ 0
; }
; build-in (CLibCall: nolang.sleep_us)
; sleep-us: 睡眠 n 微秒
; sleep-us = (us i64) {  // LLVM: call i32 @nolang.sleep_us
; }
; build-in (CLibCall: nolang.sleep_ns)
; sleep-ns: 睡眠 n 奈秒
; sleep-ns = (ns i64) {  // LLVM: call i32 @nolang.sleep_ns
; }
; ═══════════════════════════════════════════════
; 命令列參數
; ═══════════════════════════════════════════════
; build-in (ForwardFunc: args-count)
; args: 命令列參數數量（含程式名）
; args = () (count i64) {
;     // LLVM: access argc from main
; }
; build-in (ForwardFunc: args-get)
; arg: 取得第 i 個命令列參數
; arg = (idx i64) (val str) {
;     // LLVM: access argv[idx]
; }

; ═══════════════════════════════════════════════
; Windows 平台專用（內建）
; ═══════════════════════════════════════════════

; build-in (CLibCall: FindFirstFileA)
; win-find-first-file: Windows 目錄搜尋（FindFirstFileA），返回 bufPtr（0=失敗）
; win-find-first-file = (path str) (bufptr i64) { }

; build-in (CLibCall: FindNextFileA)
; win-find-next-file: 讀取下一個 Windows 目錄條目名稱，返回 (name, ok)
; win-find-next-file = (bufptr i64) (name str, ok bool) { }

; build-in (CLibCall: FindClose)
; win-find-close: 關閉 Windows 目錄搜尋 handle
; win-find-close = (bufptr i64) (ok bool) { }

; build-in (CLibCall: WSAStartup)
; win-wsa-startup: 初始化 Winsock 2.2（僅 Windows），返回 true=成功
; win-wsa-startup = () (ok bool) { }
