; heap — 二元堆積 / 優先權佇列
;
; 實作最小堆積（Min-Heap），以小根堆方式儲存 i64 整數。
;
; 用法：
;   use std/heap
;   data [128]i64 = [0:128]
;   h = heap-init(data)
;   h.push(42)
;   h.push(7)
;   val = h.pop()

; heap: 二元堆積
heap {
    data []i64
    n i64
}

; init: 建立堆積
heap.init = (data []i64) (h heap) {
    h.data = data
    h.n = 0
}

; push: 向堆積推入一個元素
heap.push = (val i64) {

    #{index-out=0, overflow=wrap}
    .data[.n] = val

    #{overflow=wrap}
    .n = .n + 1

    #{overflow=wrap}
    i = .n - 1
    (i > 0) {

        #{overflow=wrap}
        parent = (i - 1) / 2
        .data[i] >= .data[parent] -> {

            #{index-out=0}
            break
        }

        #{index-out=0}
        tmp = .data[i]

        #{index-out=0}
        .data[i] = .data[parent]

        #{index-out=0}
        .data[parent] = tmp
        i = parent
    }
}

; pop: 從堆積彈出最小元素
; 返回 val ?i64: ok=最小值, nil=堆積為空
heap.pop = () (val ?i64) {

    #{overflow=wrap}
    .n == 0 -> {
        val = nil
        return
    }

    #{index-out=0}
    val = .data[0]

    #{overflow=wrap}
    .n = .n - 1

    #{index-out=0}
    .data[0] = .data[.n]
    i = 0
    !! {

        #{overflow=wrap}
        smallest = i

        #{overflow=wrap}
        left = 2 * i + 1

        #{overflow=wrap}
        right = 2 * i + 2
        left < .n && .data[left] < .data[smallest] -> {

            #{index-out=0}
            smallest = left
        }
        right < .n && .data[right] < .data[smallest] -> {

            #{index-out=0}
            smallest = right
        }
        smallest == i -> break

        #{index-out=0}
        tmp = .data[i]

        #{index-out=0}
        .data[i] = .data[smallest]

        #{index-out=0}
        .data[smallest] = tmp
        i = smallest
    }
}

; peek: 查看最小元素（不移除）
; 返回 val ?i64: ok=最小值, nil=堆積為空
heap.peek = () (val ?i64) {
    .n == 0 -> {
        val = nil
        return
    }

    #{index-out=0}
    val = .data[0]
}

; size: 返回堆積大小
heap.size = () (sz i64) {
    sz = .n
}

; empty: 判斷堆積是否為空
heap.empty = () (yes bool) {
    yes = .n == 0
}
