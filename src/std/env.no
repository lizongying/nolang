; env — 環境變數工具
;
; 提供環境變數的讀取、設定、查找等高層操作。
; 底層依賴 os 模組的 get-env、set-env 調用。
;
; 用法：
;   use std/env
;   val = env.get('HOME')
;   ok = env.set('MY_VAR', 'value')
;   val = env.lookup('PATH')
;   val: {
;       nil -> print('not found')
;       -> print(it)
;   }

; get: 獲取環境變數值，不存在時返回空字串
get = (key str) (val str) {
    val = os.get-env(key)
}

; lookup: 獲取環境變數值
; 返回 val ?str: ok=變數值, nil=不存在
lookup = (key str) (val ?str) {
    s = os.get-env(key)

    s.len == 0 -> {
        val = nil
        return
    }
    val = s
}

; set: 設定環境變數
; 返回 true=成功, false=失敗
set = (key str, val str) (ok bool) {
    ok = os.set-env(key, val)
}

; unset: 刪除環境變數（設為空字串）
; 返回 true=成功, false=失敗
unset = (key str) (ok bool) {
    ok = os.set-env(key, '')
}

; get-with-default: 獲取環境變數，不存在時返回預設值
get-with-default = (key str, default-str str) (val str) {
    val = os.get-env(key)
    val.len == 0 -> {

        ; 複製預設值到 val
        i = 0
        {
            c = default-str[i]
            c == 0 -> break
            val[i] = c
            i = i + 1
        } (true)
    }
}

; is-set: 判斷環境變數是否已設定
; 返回 true=已設定, false=未設定
is-set = (key str) (yes bool) {
    val = os.get-env(key)
    yes = val.len != 0
}
