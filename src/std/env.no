; env — 環境變數工具
;
; 提供環境變數的讀取、設定、查找等高層操作。
; 底層依賴 os 模組的 get-env、set-env 調用。
;
; 用法：
;   use std/env
;   val = env.get('HOME')
;   val: {
;       nil -> print('HOME not set')
;       -> print(it)
;   }
;   ok = env.set('MY_VAR', 'value')
;   val = env.lookup('PATH')
;   val: {
;       nil -> print('not found')
;       -> print(it)
;   }

; 獲取環境變數值
; key str: 環境變數名（大小寫敏感，如 'HOME' / 'PATH'）
; val ?str: ok=變數值（可能是空字串）, nil=該變數未設定, err=讀取失敗
; [get](#env.get)
get = (key str) (val ?str) {
    val = os.get-env(key)
}

; 獲取環境變數值（get 的同義別名，行為完全一致）
; key str: 環境變數名
; val ?str: ok=變數值, nil=該變數未設定, err=讀取失敗
; [lookup](#env.lookup)
lookup = (key str) (val ?str) {
    val = os.get-env(key)
}

; 設定環境變數
; 覆寫同名的既有變數；只影響目前進程及其後續子進程。
; key str: 環境變數名，不可為空
; val str: 要寫入的值（空字串等同設定為空）
; ok bool: true=寫入成功, false=底層 set-env 失敗（如 key 為空或長度超限）
; [set](#env.set)
set = (key str, val str) (ok bool) {
    ok = os.set-env(key, val)
}

; 刪除環境變數（設為空字串）
; 注意：實現是寫入空字串而非真正 unset，變數仍存在但值為空。
; key str: 環境變數名
; ok bool: true=寫入空值成功, false=底層 set-env 失敗
; [unset](#env.unset)
unset = (key str) (ok bool) {
    ok = os.set-env(key, '')
}

; 獲取環境變數，未設定時返回預設值
; key str: 環境變數名
; default-str str: 變數未設定或讀取失敗時使用的回退值
; val str: 變數值；未設定（nil/err）時等於 default-str
; [get-with-default](#env.get-with-default)
get-with-default = (key str, default-str str) (val str) {
    opt = os.get-env(key)
    val = default-str
    opt: {
        ok -> val = it
        nil -> val = default-str
        err -> val = default-str
    }
}

; 判斷環境變數是否已設定
; key str: 環境變數名
; yes bool: true=讀取到 ok（含空字串值）, false=未設定或讀取失敗
; [is-set](#env.is-set)
is-set = (key str) (yes bool) {
    opt = os.get-env(key)
    yes = false
    opt: {
        ok -> yes = true
        nil -> yes = false
        err -> yes = false
    }
}
