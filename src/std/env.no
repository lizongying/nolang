; env — 環境變數工具
;
; 提供環境變數的讀取、設定、查找等高層操作。
; 底層依賴 os 模組的 get-env、set-env 調用。
;
; 用法：
;   use std/env
;   val = env.get('HOME')
;   val: {
;       nil -> print('HOME not set')
;       -> print(it)
;   }
;   ok = env.set('MY_VAR', 'value')
;   val = env.lookup('PATH')
;   val: {
;       nil -> print('not found')
;       -> print(it)
;   }

; 獲取環境變數值
; 返回 val ?str: ok=變數值, nil=未設定（os.get-env 直接以 option 呈現）
; [get](#env.get)
get = (key str) (val ?str) {
    val = os.get-env(key)
}

; 獲取環境變數值
; 返回 val ?str: ok=變數值, nil=不存在
; [lookup](#env.lookup)
lookup = (key str) (val ?str) {
    val = os.get-env(key)
}

; 設定環境變數
; 返回 true=成功, false=失敗
; [set](#env.set)
set = (key str, val str) (ok bool) {
    ok = os.set-env(key, val)
}

; 刪除環境變數（設為空字串）
; 返回 true=成功, false=失敗
; [unset](#env.unset)
unset = (key str) (ok bool) {
    ok = os.set-env(key, '')
}

; 獲取環境變數，未設定時返回預設值
; [get-with-default](#env.get-with-default)
get-with-default = (key str, default-str str) (val str) {
    opt = os.get-env(key)
    val = default-str
    opt: {
        ok -> val = it
        nil -> val = default-str
        err -> val = default-str
    }
}

; 判斷環境變數是否已設定
; 返回 true=已設定, false=未設定
; [is-set](#env.is-set)
is-set = (key str) (yes bool) {
    opt = os.get-env(key)
    yes = false
    opt: {
        ok -> yes = true
        nil -> yes = false
        err -> yes = false
    }
}
