; vec — 切片操作
;
; 動態切片的創建、克隆、比較。
;
; 切片是視圖，非獨立類型：vec 的方法同時適用於以下切片視圖：
; - arr 切片（a[1..3] → []t 視圖，共享 arr 底層記憶體）
; - vec 切片（v[1..3] → []t 視圖，共享 vec 底層記憶體）
; 切片不複製資料，只記錄指標+長度+容量，指向原始緩衝區。
; 通過切片修改元素會影響原始資料，反之亦然。
;
; 用法：
;   use std/vec.vec-create
;   data [16]i64 = [0:16]
;   data = vec-create(10, 42)
;
; vec-slice
;
; []t[..]
; []t[..)
; []t(..]
; []t(..)
;
; []t[n0..]
; []t[n0..)
; []t(n0..]
; []t(n0..)
;
; []t[..n1]
; []t[..n1)
; []t(..n1]
; []t(..n1)
;
; []t[n0..n1]
; []t[n0..n1)
; []t(n0..n1]
; []t(n0..n1)

; []t.eq: 比較兩個切片是否相等
; 返回 true=相等, false=不相等
[]t.eq = (b []t) (eq bool) {
    eq = true
    i <- [0...len): {
        .[i] != b[i] -> {
            eq = false
            return
        }
    }
}

; vec/sort — 切片排序
;
; 對 i64 切片進行原地排序。
; 使用插入排序（穩定、無堆分配、適合小數據量）。
; 實現在 LLVM/Go generator 中（Nolang 尚無陣列索引語法）。
;
; 用法：
;   data = [3, 1, 4, 1, 5]
;   sort-asc(data, 5)
;   // data == [1, 1, 3, 4, 5]

; sort-asc: 升序排序 data[0..n)
; build-in (ForwardFunc: vec-sort-asc)
; sort-asc = (data []i64, n i64) { }
; []t.sort-asc = () {
; }

; sort-desc: 降序排序 data[0..n)
; build-in (ForwardFunc: vec-sort-desc)
; sort-desc = (data []i64, n i64) { }
; []t.sort-desc = () {
; }

; vec — 切片操作
;
; 泛型參數 n(大小) t(型別) 自動推斷。

; new-cap = old-cap

; if old-cap == 0:
;     new-cap = 4   # 初始
; elif old-cap < 1024:
;     new-cap = old-cap * 2   # 小容量：翻倍
; else:
;     new-cap = old-cap * 5 / 4  # 大容量：1.25 倍

; vec {
;     len i64 read-only
;     cap i64 read-only

;     // 只存固定大小
;     // <=8 字节存值指針（i8..i64/u8..u64/f32/f64/bool），
;     // >8 字节存指针指針
;     data *any sealed
; }

; []t.len: 回傳切片長度
[]t.len = () (out i64) {
    out = .len
}

; []t.push: 在末尾追加元素（自動擴容）
; 擴容策略：
;   cap == 0 → new-cap = 4
;   cap < 1024 → new-cap = cap * 2
;   cap >= 1024 → new-cap = cap * 5 / 4
; build-in (ForwardFunc: vec-push)
; []t.push = (val t) {
;     n = .len
;     .len = n + 1
;     .[n] = val
; }

; []t.clear: 清空切片（原地修改長度為 0）
; 不 free 堆、不縮 cap，data 指標完全不變
; 只有寫入帶長度新內容時才走擴容邏輯
; build-in (ForwardFunc: vec-clear)
; []t.clear = () {
; }

; 全局函数 with-cap / with-len / with-cap-len 的声明已移至 global.no



; []t.pop: 從末尾彈出元素
; 空切片返回 nil
[]t.pop = () (val ?t) {
    {
        .len > 0 -> {
            idx = .len
            idx = idx - 1
            val = .[idx]
            .len = idx
        }
        -> val = nil
    }
}

; []t.contains: 是否包含值 val
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
; 注意：range-for 上界必須用 len（.len 字段），不能用局部變量 sz，
; 否則編譯器生成錯誤循環條件 i < 0 導致循環不執行
[]t.contains = (val t) (found bool) {
    sz = .len
    i <- [0...len): {
        v = .[i]
        v == val -> {
            found = true
            return
        }
    }
}

; []t.reverse: 反轉
[]t.reverse = () {
    i = 0
    j = .len
    j = j - 1
    {
        tmp = .[i]
        .[i] = .[j]
        .[j] = tmp
        i = i + 1
        j = j - 1
    } (i < j)
}

; []t.clone: 複製切片
[]t.clone = () (dst []t) {
    dst = with-len(.len)
    i <- [0...len): {
        dst[i] = .[i]
    }
}

; []t.fill: 填充為 val
[]t.fill = (val t) {
    i <- [0...len): {
        .[i] = val
    }
}

; []t.to-arr: 切片方法，轉為 [n]t 陣列
[]t.to-arr = () (out [?]t) {
    i <- [0...len): {
        out[i] = .[i]
    }
}

; []t.insert: 在 i 位置插入元素 val
; i >= .len 時等同 push
; 注意：內聯 push 邏輯（.len = cur + 1; .[cur] = val）以規避方法內呼叫 .push()
; 觸發的預存在 LLVM bug（_LB__RB_t.push 未定義）。調用方需確保容量足夠。
[]t.insert = (i i64, val t) {
    {
        i >= .len -> {
            cur = .len
            .len = cur + 1
            .[cur] = val
        }
        -> {
            ; 先在末尾增長一格作為佔位（內聯 push）
            last = .len
            last = last - 1
            cur = .len
            .len = cur + 1
            .[cur] = .[last]
            ; 從末尾向前平移元素到 i+1
            k = .len
            k = k - 2
            {
                .[k + 1] = .[k]
                k = k - 1
            } (k >= i)
            .[i] = val
        }
    }
}

; []t.remove: 刪除 i 位置元素並返回
; 越界返回 nil
[]t.remove = (i i64) (val ?t) {
    {
        i < 0 -> val = nil
        i >= .len -> val = nil
        -> {
            val = .[i]
            bound = .len
            bound = bound - 1
            j = i
            {
                j = j + 1
                .[j - 1] = .[j]
            } (j < bound)
            newlen = .len
            newlen = newlen - 1
            .len = newlen
        }
    }
}

; []t.index-of: 找到值返回索引，否則 -1
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
; 注意：range-for 上界必須用 len（.len 字段），不能用局部變量 sz
[]t.index-of = (val t) (idx i64) {
    sz = .len
    idx = -1
    i <- [0...len): {
        v = .[i]
        v == val -> {
            idx = i
            return
        }
    }
}

; []t.first: 第一個元素，空切片返回 nil
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
[]t.first = () (val ?t) {
    sz = .len
    {
        sz == 0 -> val = nil
        -> val = .[0]
    }
}

; []t.last: 最後一個元素，空切片返回 nil
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
[]t.last = () (val ?t) {
    sz = .len
    {
        sz == 0 -> val = nil
        -> {
            v = .[sz - 1]
            val = v
        }
    }
}

; []t.at: 安全索引訪問，越界返回 nil
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
[]t.at = (i i64) (val ?t) {
    sz = .len
    {
        i < 0 -> val = nil
        i >= sz -> val = nil
        -> val = .[i]
    }
}

; []t.swap: 交換兩位置元素
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
[]t.swap = (i i64, j i64) {
    sz = .len
    tmp = .[i]
    .[i] = .[j]
    .[j] = tmp
}

; []t.max: 最大值，空切片返回 nil
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
; 注意：range-for 上界必須用 len（.len 字段），不能用局部變量 sz
[]t.max = () (max ?t) {
    sz = .len
    {
        sz == 0 -> max = nil
        -> {
            cur = .[0]
            i <- [1...len): {
                v = .[i]
                v > cur -> cur = v
            }
            max = cur
        }
    }
}

; []t.min: 最小值，空切片返回 nil
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
; 注意：range-for 上界必須用 len（.len 字段），不能用局部變量 sz
[]t.min = () (min ?t) {
    sz = .len
    {
        sz == 0 -> min = nil
        -> {
            cur = .[0]
            i <- [1...len): {
                v = .[i]
                v < cur -> cur = v
            }
            min = cur
        }
    }
}

; []t.sum: 求和
; 注意：sz = .len 強制 vec self 類型，避免錯誤特化為 arr 方法
; 注意：range-for 上界必須用 len（.len 字段），不能用局部變量 sz
[]t.sum = () (sum t) {
    sz = .len
    acc = 0
    i <- [0...len): {
        acc = acc + .[i]
    }
    sum = acc
}

; []t.truncate: 截斷到 cnt 個元素，cnt >= .len 時無操作
[]t.truncate = (cnt i64) {
    {
        cnt < .len -> .len = cnt
        ->
    }
}

; []t.extend: 追加另一切片所有元素
; 注意：內聯 push 邏輯以規避方法內呼叫 .push() 的預存在 LLVM bug。
; 調用方需確保容量足夠。
[]t.extend = (b []t) {
    blen = b.len
    i = 0
    {
        i >= blen -> break
        cur = .len
        .len = cur + 1
        .[cur] = b[i]
        i = i + 1
    } (i < blen)
}

; ═══════════════════════════════════════════════
; 內建比較/排序函數
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: vec-eq)
; vec-eq: 比較兩個切片是否相等
; vec-eq = (a []t, b []t, elem-size i64) (eq i64) { }

; build-in (ForwardFunc: arr-eq)
; arr-eq: 比較兩個固定大小陣列是否相等
; arr-eq = (a i64, b i64, n i64) (eq i64) { }

; build-in (ForwardFunc: vec-sort)
; vec-sort: 升序排序切片（原地）
; vec-sort = (a i64) { }

; build-in (ForwardFunc: vec-reverse)
; vec-reverse: 反轉切片（原地）
; vec-reverse = (a i64) { }

; []t.to-str: 字串表示
; 格式如 '[1, 2, 3]'
; 元素轉字串：i64 用 i64-to-str（在 number.no 中定義，自動加載）
[]t.to-str = () (out str) {
    {
        .len == 0 -> out = '[]'
        -> {
            out = '['
            last = .len
            last = last - 1
            i <- [0...len): {
                out = out - number.i64-to-str(.[i])
                i < last -> out = out - ', '
            }
            out = out - ']'
        }
    }
}
