; embed: 跨譯期嵌入的文件系統
;
; 由 #{embed='dir/path'} 在編譯期初始化。
; 將目錄中所有文件嵌入到可執行檔中，實現單二進制分發。
;
; 用法：
;   #{embed='../frontend/dist'}
;   DIST fs.embed
;
;   data = DIST.read('index.html')
;   ok = DIST.exists('css/style.css')
; [embed](#embed)

; embed: 嵌入的文件系統
; count: 文件數量
; paths: 所有路徑拼接（用 \0 分隔）
; pathStarts: 每個路徑在 paths 中的起始偏移
; pathLens: 每個路徑的長度
; blob: 所有文件內容拼接
; dataStarts: 每個文件在 blob 中的起始偏移
; dataLens: 每個文件的長度
; [embed](#embed.embed)
embed {
    count i64
    paths str
    pathStarts []i64
    pathLens []i64
    blob []byte
    dataStarts []i64
    dataLens []i64
}

; embed.read: 讀取嵌入的文件（線性比對路徑後從 blob 切片返回）
; path str: 文件路徑（相對於嵌入目錄，如 'index.html'；含路徑分隔符）
; data ?[]byte: ok=文件內容（blob 上的切片，不複製）, nil=路徑不存在
; 注意：返回值指向嵌入區，請勿修改其內容。
; [read](#embed.read)
embed.read = (path str) (data ?[]byte) {
    data = nil
    path-len = path.len()
    i <- [0..self.count): {
        ixout42c1e = .pathStarts[i]: {
            ok -> it

            -> _
        }

        p-start = ixout42c1e

        ixout44c1a = .pathLens[i]: {
            ok -> it

            -> _
        }

        p-len = ixout44c1a

        ; 快速長度檢查
        p-len != path-len -> break

        ; 逐字節比較
        match = true
        j <- [0..p-len): {

            #{overflow=wrap}
            .paths[p-start + j] != path[j] -> {
                match = false
                break
            }
        }

        match -> {
            ixout61c22 = .dataStarts[i]: {
                ok -> it

                -> _
            }

            d-start = ixout61c22

            ixout63c1e = .dataLens[i]: {
                ok -> it

                -> _
            }

            d-len = ixout63c1e

            ; 從 blob 中切片返回
            data = .blob[d-start..d-start + d-len)
            return
        }
    }
}

; embed.exists: 檢查嵌入的文件是否存在
; 與 read 相同的線性比對邏輯，但不取內容。
; path str: 文件路徑（相對於嵌入目錄）
; yes bool: true=嵌入清單中存在完全相同的路徑
; [exists](#embed.exists)
embed.exists = (path str) (yes bool) {
    path-len = path.len()
    i <- [0..self.count): {
        ixout80c1e = .pathStarts[i]: {
            ok -> it

            -> _
        }

        p-start = ixout80c1e

        ixout82c1a = .pathLens[i]: {
            ok -> it

            -> _
        }

        p-len = ixout82c1a
        p-len != path-len -> break
        match = true
        j <- [0..p-len): {

            #{overflow=wrap}
            .paths[p-start + j] != path[j] -> {
                match = false
                break
            }
        }
        match -> {
            yes = true
            return
        }
    }
}
