; embed: 跨譯期嵌入的文件系統
;
; 由 #{embed='dir/path'} 在編譯期初始化。
; 將目錄中所有文件嵌入到可執行檔中，實現單二進制分發。
;
; 用法：
;   #{embed='../frontend/dist'}
;   DIST fs.embed
;
;   data = DIST.read('index.html')
;   ok = DIST.exists('css/style.css')
; [embed](#embed)

; embed: 嵌入的文件系統
; count: 文件數量
; paths: 所有路徑拼接（用 \0 分隔）
; pathStarts: 每個路徑在 paths 中的起始偏移
; pathLens: 每個路徑的長度
; blob: 所有文件內容拼接
; dataStarts: 每個文件在 blob 中的起始偏移
; dataLens: 每個文件的長度
; [embed](#embed.embed)
embed {
    count i64
    paths str
    pathStarts []i64
    pathLens []i64
    blob []byte
    dataStarts []i64
    dataLens []i64
}

; embed.read: 讀取嵌入的文件（線性比對路徑後從 blob 切片返回）
; path: 文件路徑（相對於嵌入目錄，如 'index.html'；含路徑分隔符）
; data: ok=文件內容（blob 上的切片，不複製）, nil=路徑不存在
; 注意：返回值指向嵌入區，請勿修改其內容。
; [read](#embed.read)
embed.read = (path str) (data ?[]byte) {
    data = nil
    path-len = path.len()
    i <- [0..self.count): {
        p-start = .pathStarts[i]: {
            ok -> it

            -> _
        }

        p-len = .pathLens[i]: {
            ok -> it

            -> _
        }

        ; 快速長度檢查
        ;
        ; ⚠️ 必須 continue，不能 break：線性搜尋是逐筆比對，長度不同只代表「這一筆
        ; 不匹配」，後面還有別的檔案。原本寫 break（跳出整個迴圈），導致只要清單裡
        ; 前面存在一筆長度不同的檔案，後面的檔案就永遠查不到 —— 而 embed 清單按
        ; 目錄走訪順序排列，長度幾乎不會相同，實務上等於只有第 0 筆可讀。
        ; 測試見 test/std/embed.no 的 'later entries'。
        p-len != path-len -> continue

        ; 逐字節比較
        match = true
        j <- [0..p-len): {

            #{overflow=wrap}
            .paths[p-start + j] != path[j] -> {
                match = false
                break
            }
        }

        match -> {
            d-start = .dataStarts[i]: {
                ok -> it

                -> _
            }

            d-len = .dataLens[i]: {
                ok -> it

                -> _
            }

            ; 從 blob 中切片返回
            ;
            ; ⚠️ 2026-11-12：這裡**不能**寫成 `data = .blob[d-start..d-start + d-len)`。
            ; 結果參數是 `?[]byte` 而切片終點含算術式時，codegen 會把加法的一個運算元
            ; 當成切片頭，生成非法 IR：
            ;   %c363 = add %vec %lv.973, %lv.974
            ;   error: '%lv.973' defined with type 'i64' but expected '%vec'
            ; 由於本函式在此前從未被任何程式碼呼叫，這個問題一直沒暴露（整個 embed
            ; 模組等於不可用）。最小復現 tmp/sh/h58p.no。改用 `.slice(a, b)` 方法形態
            ; 可繞過（同一運算式放在方法參數裡不會被誤降級）。
            data = .blob.slice(d-start, d-start + d-len)
            return
        }
    }
}

; embed.exists: 檢查嵌入的文件是否存在
; 與 read 相同的線性比對邏輯，但不取內容。
; path: 文件路徑（相對於嵌入目錄）
; yes: true=嵌入清單中存在完全相同的路徑
; [exists](#embed.exists)
embed.exists = (path str) (yes bool) {
    path-len = path.len()
    i <- [0..self.count): {
        p-start = .pathStarts[i]: {
            ok -> it

            -> _
        }

        p-len = .pathLens[i]: {
            ok -> it

            -> _
        }
        p-len != path-len -> continue
        match = true
        j <- [0..p-len): {

            #{overflow=wrap}
            .paths[p-start + j] != path[j] -> {
                match = false
                break
            }
        }
        match -> {
            yes = true
            return
        }
    }
}
