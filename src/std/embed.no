; ═══════════════════════════════════════════════
; embed: 跨譯期嵌入的文件系統
; ═══════════════════════════════════════════════
;
; 由 #{embed='dir/path'} 在編譯期初始化。
; 將目錄中所有文件嵌入到可執行檔中，實現單二進制分發。
;
; 用法：
;   #{embed='../frontend/dist'}
;   DIST fs.embed
;
;   data = DIST.read('index.html')
;   ok = DIST.exists('css/style.css')

; embed: 嵌入的文件系統
; count: 文件數量
; paths: 所有路徑拼接（用 \0 分隔）
; pathStarts: 每個路徑在 paths 中的起始偏移
; pathLens: 每個路徑的長度
; blob: 所有文件內容拼接
; dataStarts: 每個文件在 blob 中的起始偏移
; dataLens: 每個文件的長度
embed {
    count i64
    paths str
    pathStarts []i64
    pathLens []i64
    blob []byte
    dataStarts []i64
    dataLens []i64
}

; embed.read: 讀取嵌入的文件
; path str: 文件路徑（相對於嵌入目錄，如 'index.html'）
; 返回 data []byte, ok bool: 文件內容和是否找到

#{overflow=wrap}
embed.read = (path str) (data []byte, ok bool) {
    pathLen = path.len()
    i <- [0...count): {
        pStart = .pathStarts[i]
        pLen = .pathLens[i]

        ; 快速長度檢查
        pLen != pathLen -> *

        ; 逐字節比較
        match = true
        j <- [0..pLen): {
            .paths[pStart + j] != path[j] -> {
                match = false
                *
            }
        }
        match -> {
            dStart = .dataStarts[i]
            dLen = .dataLens[i]

            ; 從 blob 中切片返回
            data = .blob[dStart..dStart + dLen)
            ok = true
            return
        }
    }
}

; embed.exists: 檢查嵌入的文件是否存在
; path str: 文件路徑
; 返回 yes bool: 是否存在

#{overflow=wrap}
embed.exists = (path str) (yes bool) {
    pathLen = path.len()
    i <- [0...count): {
        pStart = .pathStarts[i]
        pLen = .pathLens[i]
        pLen != pathLen -> *
        match = true
        j <- [0..pLen): {
            .paths[pStart + j] != path[j] -> {
                match = false
                *
            }
        }
        match -> {
            yes = true
            return
        }
    }
}
