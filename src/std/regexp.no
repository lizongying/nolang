// regexp — 正規表示式標準庫
//
// 以 regexp 結構體封裝正規表示式 pattern，
// 提供 match、find 等方法。
// 底層使用 C 標準庫 regex.h 實作。
//
// 用法示例：
//   re = regexp{
//       pattern: '^hello'
//   }
//   matched = re.matches('hello world')
//   // matched = true
//
//   re = regexp{
//       pattern: '\\d+'
//   }
//   match = re.find('price: 123')
//   // match = '123'

// ═══════════════════════════════════════════════
// regexp 結構體：封裝正規表示式
// ═══════════════════════════════════════════════

// regexp: 正規表示式
// pattern 為正規表示式字串
regexp {
    pattern str
}

// ═══════════════════════════════════════════════
// 內建函數（底層實作）
// ═══════════════════════════════════════════════

// build-in (ForwardFunc: regexp-match)
// regexp-match: 判斷 text 是否匹配 pattern
// regexp-match = (pattern str, text str) (matched bool) {
// }

// build-in (ForwardFunc: regexp-find)
// regexp-find: 在 text 中查找第一個匹配 pattern 的子串
// regexp-find = (pattern str, text str) (result str) {
// }

// ═══════════════════════════════════════════════
// 方法
// ═══════════════════════════════════════════════

// matches: 判斷 text 是否匹配 .pattern
// 返回 true=匹配, false=不匹配
regexp.matches = (text str) (matched bool) {
    matched = regexp-match(.pattern, text)
}

// find: 在 text 中查找第一個匹配 .pattern 的子串
// 返回匹配的子串，未找到返回空字串
regexp.find = (text str) (result str) {
    result = regexp-find(.pattern, text)
}
