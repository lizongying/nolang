; static-hashmap — 固定容量泛型雜湊映射表
;
; 本檔案提供三個泛型 hashmap 模板，由編譯器針對任意 k/v 組合特化：
;   - static-hashmap-str-tmpl: str 鍵（#{generic=[v]}）
;   - static-hashmap-int-tmpl: int 鍵（#{generic=[k,v]}）
;   - static-hashmap-bool-tmpl: bool 鍵（#{generic=[v]}）
;
; 所有實作均為固定容量、線性探測。
; str/int 模板為 256 槽（建議 ≤ 192 條，裝載因子 ≤ 0.75）。
; bool 模板為 2 槽（true/false 直接索引，無需探測）。
;
; 用法（特化後，例如 v=i64）：
;   m = static-hashmap-str-tmpl{}
;   m.init()
;   m.put('name', 42)
;   val = m.get('name')   // val = ok(42) 或 nil

; FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME = 1099511628211

HASHMAP-STR-I64-CAP = 256
HASHMAP-I64-I64-CAP = 256
HASHMAP-STR-STR-CAP = 256

; ============================================================
; 1. static-hashmap-str-tmpl — str 鍵泛型雜湊映射表
; ============================================================

; static-hashmap-str-tmpl — str 鍵泛型雜湊映射表
;
; 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
; 值型別為泛型 v，由編譯器特化。
;
; 用法（特化後，例如 v=i64）：
;   m = static-hashmap-str-tmpl{}
;   m.init()
;   m.put('name', 42)
;   val = m.get('name')   // val = ok(42) 或 nil

static-hashmap-str-tmpl {
    cap i64
    keys [256]str
    vals [256]v
    occ [256]i64
    size i64
}

; init: 初始化
static-hashmap-str-tmpl.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {
        .occ[i] = 0
        .keys[i].len = 0
    }
}

; hash: FNV-1a 字串雜湊
static-hashmap-str-tmpl.hash = (key str) (idx i64) {
    h = FNV-OFFSET
    i <- [0..key.len): {
        h = h ^ (key[i] & 255)
        h = h * FNV-PRIME
    }
    idx = h & (.cap - 1)
}

; str-eq: 比較兩個 str 是否相等
static-hashmap-str-tmpl.str-eq = (a str, b str) (eq bool) {
    a.len != b.len -> return
    i <- [0..a.len): {
        a[i] != b[i] -> return
    }
    eq = true
}

; put: 插入或更新 key→value，回傳是否新增
static-hashmap-str-tmpl.put = (key str, val v) (is-new bool) {
    idx = .hash(key)
    first-tomb = -1

    {
        .occ[idx] == 1 -> {
            eq = .str-eq(.keys[idx], key)
            eq -> {
                .vals[idx] = val
                is-new = false
                return
            }
        }
        .occ[idx] == 2 -> {
            first-tomb < 0 -> first-tomb = idx
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)

    ; 未找到相同 key，插入
    insert-idx = idx
    first-tomb >= 0 -> insert-idx = first-tomb

    .keys[insert-idx] = key
    .vals[insert-idx] = val
    .occ[insert-idx] = 1
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?v（nil=未找到）
static-hashmap-str-tmpl.get = (key str) (result ?v) {
    .size == 0 -> return

    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            eq = .str-eq(.keys[idx], key)
            eq -> {
                result = .vals[idx]
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; contains: 檢查 key 是否存在
static-hashmap-str-tmpl.contains = (key str) (found bool) {
    val ?v = .get(key)
    val: {
        ok -> found = true
        err -> {}
        nil -> {}
    }
}

; remove: 刪除 key（標記墓碑）
static-hashmap-str-tmpl.remove = (key str) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            eq = .str-eq(.keys[idx], key)
            eq -> {
                .occ[idx] = 2
                .size = .size - 1
                removed = true
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; clear: 清空
static-hashmap-str-tmpl.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i].len = 0
    }
    .size = 0
}

; len: 返回元素數量
static-hashmap-str-tmpl.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
static-hashmap-str-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
static-hashmap-str-tmpl.for-each = (k str, v v) {
    i <- [0...cap): {
        .occ[i] == 1 -> {
            j <- [0...keys[i].len): {
                k[j] = .keys[i][j]
            }
            v = .vals[i]
        }
    }
}

; ============================================================
; 2. static-hashmap-int-tmpl — int 鍵泛型雜湊映射表
; ============================================================

; static-hashmap-int-tmpl — int 鍵泛型雜湊映射表
;
; 固定容量（256 槽），線性探測，模數雜湊（位元遮罩）。
; 鍵型別為泛型 k（int），值型別為泛型 v，由編譯器特化。
;
; 用法（特化後，例如 k=i64 且 v=i64）：
;   m = static-hashmap-int-tmpl{}
;   m.init()
;   m.put(42, 100)
;   val = m.get(42)   // val = ok(100) 或 nil

static-hashmap-int-tmpl {
    cap i64
    keys [256]k
    vals [256]v
    occ [256]i64
    size i64
}

; init: 初始化
static-hashmap-int-tmpl.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {
        .occ[i] = 0
        .keys[i] = 0
    }
}

; hash: 計算索引（位元遮罩）
static-hashmap-int-tmpl.hash = (key k) (idx i64) {
    idx = key & (.cap - 1)
}

; put: 插入或更新 key→value，回傳是否新增
static-hashmap-int-tmpl.put = (key k, val v) (is-new bool) {
    idx = .hash(key)
    first-tomb = -1

    {
        .occ[idx] == 1 -> {
            .keys[idx] == key -> {
                .vals[idx] = val
                is-new = false
                return
            }
        }
        .occ[idx] == 2 -> {
            first-tomb < 0 -> first-tomb = idx
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)

    insert-idx = idx
    first-tomb >= 0 -> insert-idx = first-tomb

    .keys[insert-idx] = key
    .vals[insert-idx] = val
    .occ[insert-idx] = 1
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?v（nil=未找到）
static-hashmap-int-tmpl.get = (key k) (result ?v) {
    .size == 0 -> return

    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            .keys[idx] == key -> {
                result = .vals[idx]
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; contains: 檢查 key 是否存在
static-hashmap-int-tmpl.contains = (key k) (found bool) {
    val ?v = .get(key)
    val: {
        ok -> found = true
        err -> {}
        nil -> {}
    }
}

; remove: 刪除 key（標記墓碑）
static-hashmap-int-tmpl.remove = (key k) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            .keys[idx] == key -> {
                .occ[idx] = 2
                .size = .size - 1
                removed = true
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; clear: 清空
static-hashmap-int-tmpl.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i] = 0
    }
    .size = 0
}

; len: 返回元素數量
static-hashmap-int-tmpl.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
static-hashmap-int-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
static-hashmap-int-tmpl.for-each = (k k, v v) {
    i <- [0...cap): {
        .occ[i] == 1 -> {
            k = .keys[i]
            v = .vals[i]
        }
    }
}

; ============================================================
; 3. static-hashmap-bool-tmpl — bool 鍵泛型雜湊映射表
; ============================================================

; static-hashmap-bool-tmpl — bool 鍵泛型雜湊映射表
;
; 固定容量（2 槽），true/false 直接索引，無需線性探測。
; 值型別為泛型 v，由編譯器特化。
;
; 用法（特化後，例如 v=i64）：
;   m = static-hashmap-bool-tmpl{}
;   m.init()
;   m.put(true, 1)
;   val = m.get(true)   // val = ok(1) 或 nil

static-hashmap-bool-tmpl {
    cap i64
    keys [2]bool
    vals [2]v
    occ [2]i64
    size i64
}

; init: 初始化
static-hashmap-bool-tmpl.init = () {
    .cap = 2
    .size = 0
    i <- [0..2): {
        .occ[i] = 0
        .keys[i] = false
    }
}

; hash: 直接索引（true→1，false→0）
static-hashmap-bool-tmpl.hash = (key bool) (idx i64) {
    {
        key == true -> idx = 1
        -> idx = 0
    }
}

; put: 插入或更新 key→value，回傳是否新增
static-hashmap-bool-tmpl.put = (key bool, val v) (is-new bool) {
    idx = .hash(key)

    .occ[idx] == 1 -> {
        .vals[idx] = val
        is-new = false
        return
    }

    .keys[idx] = key
    .vals[idx] = val
    .occ[idx] = 1
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?v（nil=未找到）
static-hashmap-bool-tmpl.get = (key bool) (result ?v) {
    .size == 0 -> return

    idx = .hash(key)

    .occ[idx] == 1 -> {
        result = .vals[idx]
        return
    }
}

; contains: 檢查 key 是否存在
static-hashmap-bool-tmpl.contains = (key bool) (found bool) {
    val ?v = .get(key)
    val: {
        ok -> found = true
        err -> {}
        nil -> {}
    }
}

; remove: 刪除 key（標記墓碑）
static-hashmap-bool-tmpl.remove = (key bool) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    .occ[idx] == 1 -> {
        .occ[idx] = 2
        .size = .size - 1
        removed = true
    }
}

; clear: 清空
static-hashmap-bool-tmpl.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i] = false
    }
    .size = 0
}

; len: 返回元素數量
static-hashmap-bool-tmpl.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
static-hashmap-bool-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
static-hashmap-bool-tmpl.for-each = (k bool, v v) {
    i <- [0...cap): {
        .occ[i] == 1 -> {
            k = .keys[i]
            v = .vals[i]
        }
    }
}
