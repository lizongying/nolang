; map — 泛型動態雜湊映射表
;
; 本檔案提供三個泛型 hashmap 模板，由編譯器針對任意 k/v 組合特化：
;   - hashmap-str-tmpl: str 鍵（V 泛型）
;   - hashmap-int-tmpl: int 鍵（K,V 泛型）
;   - hashmap-bool-tmpl: bool 鍵（V 泛型）
;
; 所有實作均為動態容量，使用 vec 欄位儲存 keys/vals/occ。
; str/int 模板初始容量 16，裝載因子 > 0.75 時自動 rehash 擴容（容量加倍）。
; bool 模板固定 2 槽（true/false 直接索引，無需探測與擴容）。
;
; 用法（特化後，例如 v=i64）：
;   m = hashmap-str-tmpl{}
;   m.init()
;   m.put('name', 42)
;   val = m.get('name')   ; val = ok(42) 或 nil

; FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME = 1099511628211

; ============================================================
; 1. hashmap-str-tmpl — str 鍵泛型動態雜湊映射表
; ============================================================

; hashmap-str-tmpl — str 鍵泛型動態雜湊映射表
;
; 動態容量（初始 16 槽），線性探測，用 FNV-1a 雜湊字串。
; 裝載因子 > 0.75 時自動 rehash 擴容（容量加倍）。
; 值型別為泛型 v，由編譯器特化。

hashmap-str-tmpl {
    cap i64
    size i64
    keys []str
    vals []v
    occ []i64
}

; init: 初始化
hashmap-str-tmpl.init = () {
    .cap = 16
    .size = 0
    .keys = with-len(16)
    .vals = with-len(16)
    .occ = with-len(16)
}

; hash: FNV-1a 字串雜湊
hashmap-str-tmpl.hash = (key str) (idx i64) {
    h = FNV-OFFSET
    i <- [0..key.len): {
        h = h ^ (key[i])
        h = h * FNV-PRIME
    }
    idx = h & (.cap - 1)
}

; str-eq: 比較兩個 str 是否相等
hashmap-str-tmpl.str-eq = (a str, b str) (eq bool) {
    a.len != b.len -> return
    i <- [0..a.len): {
        a[i] != b[i] -> return
    }
    eq = true
}

; put: 插入或更新 key→value，回傳是否新增
hashmap-str-tmpl.put = (key str, val v) (is-new bool) {
    ; 檢查裝載因子，觸發擴容
    { .size + 1 > .cap * 3 / 4 -> .rehash(.cap * 2) }

    idx = .hash(key)
    first-tomb = -1

    {
        .occ[idx] == 1 -> {
            k str = .keys[idx]
            eq = .str-eq(k, key)
            eq -> {
                .vals[idx] = val
                is-new = false
                return
            }
        }
        .occ[idx] == 2 -> {
            first-tomb < 0 -> first-tomb = idx
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)

    ; 未找到相同 key，插入
    insert-idx = idx
    first-tomb >= 0 -> insert-idx = first-tomb

    .keys[insert-idx] = key
    .vals[insert-idx] = val
    .occ[insert-idx] = 1
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?v（nil=未找到）
hashmap-str-tmpl.get = (key str) (result ?v) {
    .size == 0 -> return

    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            k str = .keys[idx]
            eq = .str-eq(k, key)
            eq -> {
                result = .vals[idx]
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; contains: 檢查 key 是否存在
hashmap-str-tmpl.contains = (key str) (found bool) {
    val ?v = .get(key)
    val: {
        ok -> found = true
        err -> {}
        nil -> {}
    }
}

; remove: 刪除 key（標記墓碑，不清 keys/vals）
hashmap-str-tmpl.remove = (key str) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            k str = .keys[idx]
            eq = .str-eq(k, key)
            eq -> {
                .occ[idx] = 2
                .size = .size - 1
                removed = true
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; clear: 清空（重新配置 occ vec，舊 vec 由編譯器 move 語義釋放）
hashmap-str-tmpl.clear = () {
    .occ = with-len(.cap)
    .size = 0
}

; len: 返回元素數量
hashmap-str-tmpl.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
hashmap-str-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
hashmap-str-tmpl.for-each = (k str, v v) {
    n = .cap
    i <- [0..n): {
        .occ[i] == 1 -> {
            src str = .keys[i]
            j <- [0..src.len): {
                k[j] = src[j]
            }
            v = .vals[i]
        }
    }
}

; rehash: 擴容並重新雜湊所有 occ==1 條目
hashmap-str-tmpl.rehash = (new-cap i64) {
    ; 保存舊資料
    old-keys = .keys
    old-vals = .vals
    old-occ = .occ
    old-cap = .cap

    ; 配置新 vec
    .keys = with-len(new-cap)
    .vals = with-len(new-cap)
    .occ = with-len(new-cap)
    .cap = new-cap

    ; 遷移 occ==1 條目
    i <- [0..old-cap): {
        old-occ[i] == 1 -> {
            k str = old-keys[i]
            v = old-vals[i]
            idx = .hash(k)

            ; 找到第一個空槽插入
            {
                .occ[idx] != 0 -> {
                    idx = idx + 1
                    idx >= .cap -> idx = 0
                }
            } (.occ[idx] != 0)

            .keys[idx] = k
            .vals[idx] = v
            .occ[idx] = 1
        }
    }
}

; ============================================================
; 2. hashmap-int-tmpl — int 鍵泛型動態雜湊映射表
; ============================================================

; hashmap-int-tmpl — int 鍵泛型動態雜湊映射表
;
; 動態容量（初始 16 槽），線性探測，模數雜湊（位元遮罩）。
; 裝載因子 > 0.75 時自動 rehash 擴容（容量加倍）。
; 鍵型別為泛型 k（int），值型別為泛型 v，由編譯器特化。

hashmap-int-tmpl {
    cap i64
    size i64
    keys []k
    vals []v
    occ []i64
}

; init: 初始化
hashmap-int-tmpl.init = () {
    .cap = 16
    .size = 0
    .keys = with-len(16)
    .vals = with-len(16)
    .occ = with-len(16)
}

; hash: 計算索引（位元遮罩）
hashmap-int-tmpl.hash = (key k) (idx i64) {
    idx = key & (.cap - 1)
}

; put: 插入或更新 key→value，回傳是否新增
hashmap-int-tmpl.put = (key k, val v) (is-new bool) {
    ; 檢查裝載因子，觸發擴容
    { .size + 1 > .cap * 3 / 4 -> .rehash(.cap * 2) }

    idx = .hash(key)
    first-tomb = -1

    {
        .occ[idx] == 1 -> {
            .keys[idx] == key -> {
                .vals[idx] = val
                is-new = false
                return
            }
        }
        .occ[idx] == 2 -> {
            first-tomb < 0 -> first-tomb = idx
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)

    insert-idx = idx
    first-tomb >= 0 -> insert-idx = first-tomb

    .keys[insert-idx] = key
    .vals[insert-idx] = val
    .occ[insert-idx] = 1
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?v（nil=未找到）
hashmap-int-tmpl.get = (key k) (result ?v) {
    .size == 0 -> return

    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            .keys[idx] == key -> {
                result = .vals[idx]
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; contains: 檢查 key 是否存在
hashmap-int-tmpl.contains = (key k) (found bool) {
    val ?v = .get(key)
    val: {
        ok -> found = true
        err -> {}
        nil -> {}
    }
}

; remove: 刪除 key（標記墓碑，不清 keys/vals）
hashmap-int-tmpl.remove = (key k) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    {
        .occ[idx] == 1 -> {
            .keys[idx] == key -> {
                .occ[idx] = 2
                .size = .size - 1
                removed = true
                return
            }
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] != 0)
}

; clear: 清空（重新配置 occ vec）
hashmap-int-tmpl.clear = () {
    .occ = with-len(.cap)
    .size = 0
}

; len: 返回元素數量
hashmap-int-tmpl.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
hashmap-int-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
hashmap-int-tmpl.for-each = (k k, v v) {
    n = .cap
    i <- [0..n): {
        .occ[i] == 1 -> {
            k = .keys[i]
            v = .vals[i]
        }
    }
}

; rehash: 擴容並重新雜湊所有 occ==1 條目
hashmap-int-tmpl.rehash = (new-cap i64) {
    ; 保存舊資料
    old-keys = .keys
    old-vals = .vals
    old-occ = .occ
    old-cap = .cap

    ; 配置新 vec
    .keys = with-len(new-cap)
    .vals = with-len(new-cap)
    .occ = with-len(new-cap)
    .cap = new-cap

    ; 遷移 occ==1 條目
    i <- [0..old-cap): {
        old-occ[i] == 1 -> {
            k = old-keys[i]
            v = old-vals[i]
            idx = .hash(k)

            ; 找到第一個空槽插入
            {
                .occ[idx] != 0 -> {
                    idx = idx + 1
                    idx >= .cap -> idx = 0
                }
            } (.occ[idx] != 0)

            .keys[idx] = k
            .vals[idx] = v
            .occ[idx] = 1
        }
    }
}

; ============================================================
; 3. hashmap-bool-tmpl — bool 鍵泛型動態雜湊映射表
; ============================================================

; hashmap-bool-tmpl — bool 鍵泛型動態雜湊映射表
;
; 固定容量（2 槽），true/false 直接索引，無需線性探測與擴容。
; 值型別為泛型 v，由編譯器特化。

hashmap-bool-tmpl {
    cap i64
    size i64
    keys []bool
    vals []v
    occ []i64
}

; init: 初始化
hashmap-bool-tmpl.init = () {
    .cap = 2
    .size = 0
    .keys = with-len(2)
    .vals = with-len(2)
    .occ = with-len(2)
}

; hash: 直接索引（true→1，false→0）
hashmap-bool-tmpl.hash = (key bool) (idx i64) {
    {
        key == true -> idx = 1
        -> idx = 0
    }
}

; put: 插入或更新 key→value，回傳是否新增（直接索引，無 rehash）
hashmap-bool-tmpl.put = (key bool, val v) (is-new bool) {
    idx = .hash(key)

    .occ[idx] == 1 -> {
        .vals[idx] = val
        is-new = false
        return
    }

    .keys[idx] = key
    .vals[idx] = val
    .occ[idx] = 1
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?v（nil=未找到）
hashmap-bool-tmpl.get = (key bool) (result ?v) {
    .size == 0 -> return

    idx = .hash(key)

    .occ[idx] == 1 -> {
        result = .vals[idx]
        return
    }
}

; contains: 檢查 key 是否存在
hashmap-bool-tmpl.contains = (key bool) (found bool) {
    val ?v = .get(key)
    val: {
        ok -> found = true
        err -> {}
        nil -> {}
    }
}

; remove: 刪除 key（標記墓碑，不清 keys/vals）
hashmap-bool-tmpl.remove = (key bool) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    .occ[idx] == 1 -> {
        .occ[idx] = 2
        .size = .size - 1
        removed = true
    }
}

; clear: 清空（重新配置 occ vec）
hashmap-bool-tmpl.clear = () {
    .occ = with-len(.cap)
    .size = 0
}

; len: 返回元素數量
hashmap-bool-tmpl.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
hashmap-bool-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
hashmap-bool-tmpl.for-each = (k bool, v v) {
    n = .cap
    i <- [0..n): {
        .occ[i] == 1 -> {
            k = .keys[i]
            v = .vals[i]
        }
    }
}
