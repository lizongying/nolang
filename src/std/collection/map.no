; map — 泛型動態雜湊映射表
;
; 本檔案提供三個泛型 hashmap 模板，由編譯器針對任意 k/v 組合特化：
;   - hashmap-str-tmpl: str 鍵（V 泛型）
;   - hashmap-int-tmpl: int 鍵（K,V 泛型）
;   - hashmap-bool-tmpl: bool 鍵（V 泛型）
;
; 所有實作均為動態容量，使用 vec 欄位儲存 keys/vals/occ。
; str/int 模板初始容量 16，裝載因子 > 0.75 時自動 rehash 擴容（容量加倍）。
; bool 模板固定 2 槽（true/false 直接索引，無需探測與擴容）。
;
; 用法（特化後，例如 v=i64）：
;   m = hashmap-str-tmpl{}
;   m.init()
;   m.put('name', 42)
;   val = m.get('name')   ; val = ok(42) 或 nil

; FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME = 1099511628211

; ============================================================
; 1. hashmap-str-tmpl — str 鍵泛型動態雜湊映射表
; ============================================================

; hashmap-str-tmpl — str 鍵泛型動態雜湊映射表
;
; 動態容量（初始 16 槽），線性探測，用 FNV-1a 雜湊字串。
; 裝載因子 > 0.75 時自動 rehash 擴容（容量加倍）。
; 值型別為泛型 v，由編譯器特化。

hashmap-str-tmpl {
    cap i64
    size i64
    keys []str
    vals []v
    occ []i64
}

; 初始化
; [init](#collection.map.hashmap-str-tmpl.init)
hashmap-str-tmpl.init = () {
    .cap = 16
    .size = 0
    .keys = with-len(16)
    .vals = with-len(16)
    .occ = with-len(16)
}

; FNV-1a 字串雜湊
; [hash](#collection.map.hashmap-str-tmpl.hash)
hashmap-str-tmpl.hash = (key str) (idx i64) {

    h = FNV-OFFSET
    i <- [0..key.len-bytes()): {

        h = h ^ (key.byte(i))

        #{overflow=wrap}
        h = h * FNV-PRIME
    }

    idx = h & (.cap - 1)
}

; 比較兩個 str 是否相等
; [str-eq](#collection.map.hashmap-str-tmpl.str-eq)
hashmap-str-tmpl.str-eq = (a str, b str) (eq bool) {
    a.len-bytes() != b.len-bytes() -> return
    i <- [0..a.len-bytes()): {
        a.byte(i) != b.byte(i) -> {

            return
        }
    }
    eq = true
}

; 插入或更新 key→value，回傳是否新增
; [put](#collection.map.hashmap-str-tmpl.put)
hashmap-str-tmpl.put = (key str, val v) (is-new bool) {

    ; 若未初始化，自動初始化
    .cap == 0 -> .init()

    ; 檢查裝載因子，觸發擴容
    #{overflow=wrap}
    {
        .size + 1 > .cap * 3 / 4 -> .rehash(.cap * 2)
    }
    idx = .hash(key)
    first-tomb = -1

    (.occ[idx] != 0) {

        .occ[idx] == 1 -> {

            k str = .keys[idx]
            eq = .str-eq(k, key)
            eq -> {

                .vals[idx] = val
                is-new = false
                return
            }
        }
        .occ[idx] == 2 -> {

            first-tomb < 0 -> first-tomb = idx
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }

    ; 未找到相同 key，插入
    insert-idx = idx
    first-tomb >= 0 -> insert-idx = first-tomb

    .keys[insert-idx] = key

    .vals[insert-idx] = val

    .occ[insert-idx] = 1

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; 查找 key，返回 ?v（nil=未找到）
; [get](#collection.map.hashmap-str-tmpl.get)
hashmap-str-tmpl.get = (key str) (result ?v) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] != 0) {

        .occ[idx] == 1 -> {

            k str = .keys[idx]
            eq = .str-eq(k, key)
            eq -> {

                result = .vals[idx]
                return
            }
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 檢查 key 是否存在
; [contains](#collection.map.hashmap-str-tmpl.contains)
hashmap-str-tmpl.contains = (key str) (found bool) {
    val = .get(key)
    val: {
        ok -> found = true

        err ->

        nil ->
    }
}

; 刪除 key（標記墓碑，不清 keys/vals）
; [remove](#collection.map.hashmap-str-tmpl.remove)
hashmap-str-tmpl.remove = (key str) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] != 0) {

        #{overflow=wrap}
        .occ[idx] == 1 -> {

            k str = .keys[idx]
            eq = .str-eq(k, key)
            eq -> {

                .occ[idx] = 2
                .size = .size - 1
                removed = true
                return
            }
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 清空（重新配置 occ vec，舊 vec 由編譯器 move 語義釋放）
; [clear](#collection.map.hashmap-str-tmpl.clear)
hashmap-str-tmpl.clear = () {
    .occ = with-len(.cap)
    .size = 0
}

; 返回元素數量
; [len](#collection.map.hashmap-str-tmpl.len)
hashmap-str-tmpl.len = () (n i64) {
    n = .size
}

; 是否為空
; [is-empty](#collection.map.hashmap-str-tmpl.is-empty)
hashmap-str-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; 遍歷所有 (key, value)
; [for-each](#collection.map.hashmap-str-tmpl.for-each)
hashmap-str-tmpl.for-each = () (k str, v v) {
    n = .cap
    i <- [0..n): {
        .occ[i] == 1 -> {

            src str = .keys[i]
            j <- [0..src.len-bytes()): {

                k[j] = src.byte(j)
            }

            v = .vals[i]
        }
    }
}

; 擴容並重新雜湊所有 occ==1 條目
; [rehash](#collection.map.hashmap-str-tmpl.rehash)
hashmap-str-tmpl.rehash = (new-cap i64) {

    ; 保存舊資料
    old-keys = .keys
    old-vals = .vals
    old-occ = .occ
    old-cap = .cap

    ; 配置新 vec
    .keys = with-len(new-cap)
    .vals = with-len(new-cap)
    .occ = with-len(new-cap)
    .cap = new-cap

    ; 遷移 occ==1 條目
    i <- [0..old-cap): {
        old-occ[i] == 1 -> {

            k str = old-keys[i]

            v = old-vals[i]
            idx = .hash(k)

            ; 找到第一個空槽插入
            (.occ[idx] != 0) {
                .occ[idx] != 0 -> {

                    #{overflow=wrap}
                    idx = idx + 1
                    idx >= .cap -> idx = 0
                }
            }

            .keys[idx] = k

            .vals[idx] = v

            .occ[idx] = 1
        }
    }
}

; ============================================================
; 2. hashmap-int-tmpl — int 鍵泛型動態雜湊映射表
; ============================================================

; hashmap-int-tmpl — int 鍵泛型動態雜湊映射表
;
; 動態容量（初始 16 槽），線性探測，模數雜湊（位元遮罩）。
; 裝載因子 > 0.75 時自動 rehash 擴容（容量加倍）。
; 鍵型別為泛型 k（int），值型別為泛型 v，由編譯器特化。

hashmap-int-tmpl {
    cap i64
    size i64
    keys []k
    vals []v
    occ []i64
}

; 初始化
; [init](#collection.map.hashmap-int-tmpl.init)
hashmap-int-tmpl.init = () {
    .cap = 16
    .size = 0
    .keys = with-len(16)
    .vals = with-len(16)
    .occ = with-len(16)
}

; 計算索引（位元遮罩）
; [hash](#collection.map.hashmap-int-tmpl.hash)
hashmap-int-tmpl.hash = (key k) (idx i64) {

    idx = key & (.cap - 1)
}

; 插入或更新 key→value，回傳是否新增
; [put](#collection.map.hashmap-int-tmpl.put)
hashmap-int-tmpl.put = (key k, val v) (is-new bool) {

    ; 若未初始化，自動初始化
    .cap == 0 -> .init()

    ; 檢查裝載因子，觸發擴容
    #{overflow=wrap}
    {
        .size + 1 > .cap * 3 / 4 -> .rehash(.cap * 2)
    }
    idx = .hash(key)
    first-tomb = -1

    (.occ[idx] != 0) {

        .occ[idx] == 1 -> {

            .keys[idx] == key -> {

                .vals[idx] = val
                is-new = false
                return
            }
        }
        .occ[idx] == 2 -> {

            first-tomb < 0 -> first-tomb = idx
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
    insert-idx = idx
    first-tomb >= 0 -> insert-idx = first-tomb

    .keys[insert-idx] = key

    .vals[insert-idx] = val

    .occ[insert-idx] = 1

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; 查找 key，返回 ?v（nil=未找到）
; [get](#collection.map.hashmap-int-tmpl.get)
hashmap-int-tmpl.get = (key k) (result ?v) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] != 0) {

        .occ[idx] == 1 -> {

            .keys[idx] == key -> {

                result = .vals[idx]
                return
            }
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 檢查 key 是否存在
; [contains](#collection.map.hashmap-int-tmpl.contains)
hashmap-int-tmpl.contains = (key k) (found bool) {
    val = .get(key)
    val: {
        ok -> found = true

        err ->

        nil ->
    }
}

; 刪除 key（標記墓碑，不清 keys/vals）
; [remove](#collection.map.hashmap-int-tmpl.remove)
hashmap-int-tmpl.remove = (key k) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] != 0) {

        #{overflow=wrap}
        .occ[idx] == 1 -> {

            .keys[idx] == key -> {

                .occ[idx] = 2
                .size = .size - 1
                removed = true
                return
            }
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 清空（重新配置 occ vec）
; [clear](#collection.map.hashmap-int-tmpl.clear)
hashmap-int-tmpl.clear = () {
    .occ = with-len(.cap)
    .size = 0
}

; 返回元素數量
; [len](#collection.map.hashmap-int-tmpl.len)
hashmap-int-tmpl.len = () (n i64) {
    n = .size
}

; 是否為空
; [is-empty](#collection.map.hashmap-int-tmpl.is-empty)
hashmap-int-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; 遍歷所有 (key, value)
; [for-each](#collection.map.hashmap-int-tmpl.for-each)
hashmap-int-tmpl.for-each = () (k k, v v) {
    n = .cap
    i <- [0..n): {
        .occ[i] == 1 -> {

            k = .keys[i]

            v = .vals[i]
        }
    }
}

; 擴容並重新雜湊所有 occ==1 條目
; [rehash](#collection.map.hashmap-int-tmpl.rehash)
hashmap-int-tmpl.rehash = (new-cap i64) {

    ; 保存舊資料
    old-keys = .keys
    old-vals = .vals
    old-occ = .occ
    old-cap = .cap

    ; 配置新 vec
    .keys = with-len(new-cap)
    .vals = with-len(new-cap)
    .occ = with-len(new-cap)
    .cap = new-cap

    ; 遷移 occ==1 條目
    i <- [0..old-cap): {
        old-occ[i] == 1 -> {

            k = old-keys[i]

            v = old-vals[i]
            idx = .hash(k)

            ; 找到第一個空槽插入
            (.occ[idx] != 0) {
                .occ[idx] != 0 -> {

                    #{overflow=wrap}
                    idx = idx + 1
                    idx >= .cap -> idx = 0
                }
            }

            .keys[idx] = k

            .vals[idx] = v

            .occ[idx] = 1
        }
    }
}

; ============================================================
; 3. hashmap-bool-tmpl — bool 鍵泛型動態雜湊映射表
; ============================================================

; hashmap-bool-tmpl — bool 鍵泛型動態雜湊映射表
;
; 固定容量（2 槽），true/false 直接索引，無需線性探測與擴容。
; 值型別為泛型 v，由編譯器特化。

hashmap-bool-tmpl {
    cap i64
    size i64
    keys []bool
    vals []v
    occ []i64
}

; 初始化
; [init](#collection.map.hashmap-bool-tmpl.init)
hashmap-bool-tmpl.init = () {
    .cap = 2
    .size = 0
    .keys = with-len(2)
    .vals = with-len(2)
    .occ = with-len(2)
}

; 直接索引（true→1，false→0）
; [hash](#collection.map.hashmap-bool-tmpl.hash)
hashmap-bool-tmpl.hash = (key bool) (idx i64) {
    {
        key == true -> idx = 1

        -> idx = 0
    }
}

; 插入或更新 key→value，回傳是否新增（直接索引，無 rehash）
; [put](#collection.map.hashmap-bool-tmpl.put)
hashmap-bool-tmpl.put = (key bool, val v) (is-new bool) {
    .cap == 0 -> .init()

    idx = .hash(key)

    .occ[idx] == 1 -> {

        .vals[idx] = val
        is-new = false
        return
    }

    .keys[idx] = key

    .vals[idx] = val

    .occ[idx] = 1

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; 查找 key，返回 ?v（nil=未找到）
; [get](#collection.map.hashmap-bool-tmpl.get)
hashmap-bool-tmpl.get = (key bool) (result ?v) {
    .size == 0 -> return
    idx = .hash(key)

    .occ[idx] == 1 -> {

        result = .vals[idx]
        return
    }
}

; 檢查 key 是否存在
; [contains](#collection.map.hashmap-bool-tmpl.contains)
hashmap-bool-tmpl.contains = (key bool) (found bool) {
    val = .get(key)
    val: {
        ok -> found = true

        err ->

        nil ->
    }
}

; 刪除 key（標記墓碑，不清 keys/vals）
; [remove](#collection.map.hashmap-bool-tmpl.remove)
hashmap-bool-tmpl.remove = (key bool) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    .occ[idx] == 1 -> {

        .occ[idx] = 2

        #{overflow=wrap}
        .size = .size - 1
        removed = true
    }
}

; 清空（重新配置 occ vec）
; [clear](#collection.map.hashmap-bool-tmpl.clear)
hashmap-bool-tmpl.clear = () {
    .occ = with-len(.cap)
    .size = 0
}

; 返回元素數量
; [len](#collection.map.hashmap-bool-tmpl.len)
hashmap-bool-tmpl.len = () (n i64) {
    n = .size
}

; 是否為空
; [is-empty](#collection.map.hashmap-bool-tmpl.is-empty)
hashmap-bool-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

; 遍歷所有 (key, value)
; [for-each](#collection.map.hashmap-bool-tmpl.for-each)
hashmap-bool-tmpl.for-each = () (k bool, v v) {
    n = .cap
    i <- [0..n): {
        .occ[i] == 1 -> {

            k = .keys[i]

            v = .vals[i]
        }
    }
}
