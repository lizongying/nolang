; str-set — str 哈希集合
;
; 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
; 適合字串去重、成員檢測（建議 ≤ 192 條）。
;
; 用法：
;   s = str-set{}
;   s.init()
;   s.add('hello')
;   yes = s.contains('hello')   // yes = true
;   s.for-each(val)

; FNV-1a 常量
SS-FNV-OFFSET = -3750763034362895579
SS-FNV-PRIME = 1099511628211

str-set {
    cap i64
    keys [256]str
    occ [256]i64
    size i64
}

; init: 初始化
str-set.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {
        .occ[i] = 0
        .keys[i].len = 0
    }
}

; hash: FNV-1a 字串雜湊
str-set.hash = (key str) (idx i64) {
    h = SS-FNV-OFFSET
    i <- [0..key.len): {
        h = h ^ (key[i] & 255)
        h = h * SS-FNV-PRIME
    }
    idx = h & (.cap - 1)
}

; str-eq: 比較兩個 str 是否相等
str-set.str-eq = (a str, b str) (eq bool) {
    eq = false
    a.len != b.len -> return
    i <- [0..a.len): {
        a[i] != b[i] -> return
    }
    eq = true
}

; add: 加入元素，回傳是否新增
str-set.add = (key str) (is-new bool) {
    idx = .hash(key)

    {
        eq = .str-eq(.keys[idx], key)
        eq -> {
            is-new = false
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] == 1)

    ; 複製 key
    .keys[idx].len = key.len
    i <- [0..key.len): {
        .keys[idx][i] = key[i]
    }
    .occ[idx] = 1
    .size = .size + 1
    is-new = true
}

; contains: 檢查元素是否存在
str-set.contains = (key str) (found bool) {
    found = false
    .size == 0 -> return
    idx = .hash(key)

    {
        eq = .str-eq(.keys[idx], key)
        eq -> {
            found = true
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] == 1)
}

; remove: 刪除元素
str-set.remove = (key str) (removed bool) {
    removed = false
    .size == 0 -> return
    idx = .hash(key)

    {
        eq = .str-eq(.keys[idx], key)
        eq -> {
            .occ[idx] = 0
            .keys[idx].len = 0
            .size = .size - 1
            removed = true
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] == 1)
}

; clear: 清空
str-set.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i].len = 0
    }
    .size = 0
}

; len: 返回元素數量
str-set.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
str-set.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有元素
str-set.for-each = (val str) {
    i <- [0...cap): {
        .occ[i] == 1 -> val = .keys[i]
    }
}
