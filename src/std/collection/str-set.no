; str-set — str 哈希集合
;
; 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
; 適合字串去重、成員檢測（建議 ≤ 192 條）。
;
; 用法：
;   s = str-set{}
;   s.init()
;   s.add('hello')
;   yes = s.contains('hello')   // yes = true
;   s.for-each(val)

; FNV-1a 常量
SS-FNV-OFFSET = -3750763034362895579
SS-FNV-PRIME = 1099511628211

; str-set: 以 FNV-1a 雜湊的 str 集合實例
; cap i64: 槽位總數（固定 256，須為 2 的冪）
; keys [256]str: 各槽位存放的字串（共 256 個槽），有效與否由 occ 決定
; occ [256]i64: 佔用標記，1=該槽有位, 0=空槽
; size i64: 目前元素個數
str-set {
    cap i64
    keys [256]str
    occ [256]i64
    size i64
}

; 初始化
; [init](#str-set.str-set.init)
str-set.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {

        .occ[i] = 0

        .keys[i].len = 0
    }
}

; FNV-1a 字串雜湊
; key str: 要散列的字串（按位元組走訪）
; idx i64: 在 [0, cap) 內的槽位下標（雜湊值 & (cap-1)，不看大小寫）
; [hash](#str-set.str-set.hash)
str-set.hash = (key str) (idx i64) {

    h = SS-FNV-OFFSET
    i <- [0..key.len-bytes()): {

        h = h ^ (key.byte(i))

        #{overflow=wrap}
        h = h * SS-FNV-PRIME
    }

    idx = h & (.cap - 1)
}

; 比較兩個 str 是否相等
; 先比長度快速否定，再逐位元組比對（不做大小寫不敏感處理）。
; a str: 左運算元
; b str: 右運算元
; eq bool: true=長度與每個位元組都相同, false=不相等
; [str-eq](#str-set.str-set.str-eq)
str-set.str-eq = (a str, b str) (eq bool) {
    a.len-bytes() != b.len-bytes() -> return
    i <- [0..a.len-bytes()): {
        a.byte(i) != b.byte(i) -> {

            return
        }
    }
    eq = true
}

; 加入元素，回傳是否新增
; 線性探測找槽位，命中相同字串則不重複插入。
; 表已滿且字串不存在時探測會無限循環，呼叫方需自行控制元素個數。
; key str: 要加入的字串（會被複製到槽位中）
; is-new bool: true=原先不存在、已插入, false=已存在，未改動
; [add](#str-set.str-set.add)
str-set.add = (key str) (is-new bool) {

    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)
        eq -> {
            is-new = false
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }

    ; 複製 key
    .keys[idx].len = key.len-bytes()
    i <- [0..key.len-bytes()): {

        .keys[idx][i] = key.byte(i)
    }

    .occ[idx] = 1

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; 檢查元素是否存在
; key str: 要查詢的字串
; found bool: true=集合中存在該字串, false=不存在（集合為空時直接返回）
; [contains](#str-set.str-set.contains)
str-set.contains = (key str) (found bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)
        eq -> {
            found = true
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 刪除元素
; 清空槽位的 occ 與 keys[i].len，不做探測鏈後續重排；同 key 再次 add 即可重用該槽。
; key str: 要刪除的字串
; removed bool: true=找到並刪除, false=不存在
; [remove](#str-set.str-set.remove)
str-set.remove = (key str) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)

        #{overflow=wrap}
        eq -> {

            .occ[idx] = 0

            .keys[idx].len = 0
            .size = .size - 1
            removed = true
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 清空
; [clear](#str-set.str-set.clear)
str-set.clear = () {
    i <- [0...cap): {

        .occ[i] = 0

        .keys[i].len = 0
    }
    .size = 0
}

; 返回元素數量
; n i64: 集合中目前存在的字串個數
; [len](#str-set.str-set.len)
str-set.len = () (n i64) {
    n = .size
}

; 是否為空
; empty bool: true=size == 0, false=還有元素
; [is-empty](#str-set.str-set.is-empty)
str-set.is-empty = () (empty bool) {
    empty = .size == 0
}

; 遍歷所有元素
; 依槽位下標順序（非插入順序）走完 [0, cap)，把每個已佔用槽的字串依次賦給 val。
; 本語言無回呼，函式返回時 val 停在最後一個非空槽位的元素上。
; val str: 當前槽位的字串（最後一次賦值）
; [for-each](#str-set.str-set.for-each)
str-set.for-each = () (val str) {
    i <- [0...cap): {
        .occ[i] == 1 -> {

            val = .keys[i]
        }
    }
}
