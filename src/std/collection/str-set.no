; str-set — str 哈希集合
;
; 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
; 適合字串去重、成員檢測（建議 ≤ 192 條）。
;
; 用法：
;   s = str-set{}
;   s.init()
;   s.add('hello')
;   yes = s.contains('hello')   // yes = true
;   s.for-each(val)

; FNV-1a 常量
SS-FNV-OFFSET = -3750763034362895579
SS-FNV-PRIME = 1099511628211

str-set {
    cap i64
    keys [256]str
    occ [256]i64
    size i64
}

; 初始化
; [init](#collection.str-set.str-set.init)
str-set.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {

        .occ[i] = 0

        .keys[i].len = 0
    }
}

; FNV-1a 字串雜湊
; [hash](#collection.str-set.str-set.hash)
str-set.hash = (key str) (idx i64) {

    h = SS-FNV-OFFSET
    i <- [0..key.len-bytes()): {

        h = h ^ (key.byte(i))

        #{overflow=wrap}
        h = h * SS-FNV-PRIME
    }

    idx = h & (.cap - 1)
}

; 比較兩個 str 是否相等
; [str-eq](#collection.str-set.str-set.str-eq)
str-set.str-eq = (a str, b str) (eq bool) {
    a.len-bytes() != b.len-bytes() -> return
    i <- [0..a.len-bytes()): {
        a.byte(i) != b.byte(i) -> {

            return
        }
    }
    eq = true
}

; 加入元素，回傳是否新增
; [add](#collection.str-set.str-set.add)
str-set.add = (key str) (is-new bool) {

    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)
        eq -> {
            is-new = false
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }

    ; 複製 key
    .keys[idx].len = key.len-bytes()
    i <- [0..key.len-bytes()): {

        .keys[idx][i] = key.byte(i)
    }

    .occ[idx] = 1

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; 檢查元素是否存在
; [contains](#collection.str-set.str-set.contains)
str-set.contains = (key str) (found bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)
        eq -> {
            found = true
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 刪除元素
; [remove](#collection.str-set.str-set.remove)
str-set.remove = (key str) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)

        #{overflow=wrap}
        eq -> {

            .occ[idx] = 0

            .keys[idx].len = 0
            .size = .size - 1
            removed = true
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 清空
; [clear](#collection.str-set.str-set.clear)
str-set.clear = () {
    i <- [0...cap): {

        .occ[i] = 0

        .keys[i].len = 0
    }
    .size = 0
}

; 返回元素數量
; [len](#collection.str-set.str-set.len)
str-set.len = () (n i64) {
    n = .size
}

; 是否為空
; [is-empty](#collection.str-set.str-set.is-empty)
str-set.is-empty = () (empty bool) {
    empty = .size == 0
}

; 遍歷所有元素
; [for-each](#collection.str-set.str-set.for-each)
str-set.for-each = () (val str) {
    i <- [0...cap): {
        .occ[i] == 1 -> {

            val = .keys[i]
        }
    }
}
