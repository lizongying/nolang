; stack — 堆疊
;
; 後進先出（LIFO）資料結構，以 []i64 實作。
;
; 用法：
;   use std/stack
;   buf [128]i64 = [0:128]
;   s = stack { data: buf, n: 0 }
;   s.push(42)
;   s.push(7)
;   val = s.pop()    // val=ok（後入先出）
;   val: {
;       nil -> print('empty')
;       -> print(it)
;   }

; stack: 堆疊狀態
; data []i64: 底層儲存切片，容量上限 = len(data)
; n i64: 目前元素數量；有效元素位於 data[0..n)
stack {
    data []i64
    n i64
}

; 推入元素到堆疊頂端
; 注意：本方法不檢查容量，呼叫方需保證 n < len(data)。
; val i64: 要壓入的值；寫入 data[n] 後 n 加 1
; [push](#stack.stack.push)
stack.push = (val i64) {

    .data[.n] = val

    #{overflow=wrap}
    .n = .n + 1
}

; 從堆疊頂端彈出元素
; val ?i64: ok=原頂端元素（已移除）, nil=堆疊為空
; [pop](#stack.stack.pop)
stack.pop = () (val ?i64) {

    .n == 0 -> {
        val = nil
        return
    }

    #{overflow=wrap}
    .n = .n - 1

    val = .data[.n]
}

; 查看堆疊頂端元素（不移除）
; val ?i64: ok=data[n-1], nil=堆疊為空
; [peek](#stack.stack.peek)
stack.peek = () (val ?i64) {

    .n == 0 -> {
        val = nil
        return
    }

    #{overflow=wrap}
    val = .data[.n - 1]
}

; 返回堆疊目前元素數量
; sz i64: 等於 n（0 表示空，最大不超過 len(data)）
; [size](#stack.stack.size)
stack.size = () (sz i64) {
    sz = .n
}

; 判斷堆疊是否為空
; yes bool: true 表示 n == 0
; [empty](#stack.stack.empty)
stack.empty = () (yes bool) {
    yes = .n == 0
}

; 清空堆疊（n 置 0，不釋放 data、不抹除舊內容）
; 無參數與返回值；清空後 size() 為 0
; [clear](#stack.stack.clear)
stack.clear = () {
    .n = 0
}
