; str-map — str→str 哈希映射表
;
; 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
; 適合小型鍵值對場景（建議 ≤ 192 條）。
;
; 用法：
;   m = str-map{}
;   m.init()
;   m.put('name', 'Alice')
;   val = m.get('name')   // val = ok('Alice') 或 nil
;   m.for-each(k, v)

; FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME = 1099511628211

str-map {
    cap i64
    keys [256]str
    vals [256]str
    occ [256]i64
    size i64
}

; init: 初始化
str-map.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {

        #{index-out=0}
        .occ[i] = 0

        #{index-out=0}
        .keys[i].len = 0

        #{index-out=0}
        .vals[i].len = 0
    }
}

; hash: FNV-1a 字串雜湊
str-map.hash = (key str) (idx i64) {

    #{overflow=wrap}
    h = FNV-OFFSET
    i <- [0..key.len-bytes()): {

        #{index-out=0, overflow=wrap}
        h = h ^ (key.byte(i))

        #{overflow=wrap}
        h = h * FNV-PRIME
    }

    #{overflow=wrap}
    idx = h & (.cap - 1)
}

; str-eq: 比較兩個 str 是否相等
str-map.str-eq = (a str, b str) (eq bool) {
    a.len-bytes() != b.len-bytes() -> return
    i <- [0..a.len-bytes()): {
        a.byte(i) != b.byte(i) -> {

            #{index-out=0}
            return
        }
    }
    eq = true
}

; put: 插入或更新 key→value，回傳是否新增
str-map.put = (key str, val str) (is-new bool) {

    #{overflow=wrap}
    idx = .hash(key)

    (.occ[idx] == 1) {

        #{index-out=0, overflow=wrap}
        eq = .str-eq(.keys[idx], key)
        eq -> {

            ; 直接指派；結構欄位寫入會深拷貝 inline str，不需要手動 .len + 逐字節拷貝
            #{index-out=0}
            .vals[idx] = val
            is-new = false
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0

        #{index-out=0}
    }

    ; 複製 key / val。
    ; 不能用 `.keys[idx].len = key.len-bytes()` 再逐字節寫：`.len = n` 是裸欄位寫入，
    ; 不會分配緩衝區，而新槽位的 keys[idx] 緩衝區還是 null，下一個 [i] = 會對 null
    ; 做 GEP+store（SIGSEGV）。直接指派會深拷貝，才是正確寫法。
    #{index-out=0}
    .keys[idx] = key

    #{index-out=0}
    .vals[idx] = val

    #{index-out=0}
    .occ[idx] = 1

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?str（nil=未找到）
str-map.get = (key str) (result ?str) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        #{index-out=0, overflow=wrap}
        eq = .str-eq(.keys[idx], key)
        eq -> {

            #{index-out=0}
            result = .vals[idx]
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0

        #{index-out=0}
    }
}

; contains: 檢查 key 是否存在
str-map.contains = (key str) (found bool) {
    val = .get(key)
    val: {
        ok -> found = true

        err ->

        nil ->
    }
}

; remove: 刪除 key
str-map.remove = (key str) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        #{index-out=0, overflow=wrap}
        eq = .str-eq(.keys[idx], key)

        #{overflow=wrap}
        eq -> {

            #{index-out=0, overflow=wrap}
            .occ[idx] = 0

            #{index-out=0}
            .keys[idx].len = 0

            #{index-out=0}
            .vals[idx].len = 0
            .size = .size - 1
            removed = true
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0

        #{index-out=0}
    }
}

; clear: 清空
str-map.clear = () {
    i <- [0...cap): {

        #{index-out=0}
        .occ[i] = 0

        #{index-out=0}
        .keys[i].len = 0

        #{index-out=0}
        .vals[i].len = 0
    }
    .size = 0
}

; len: 返回元素數量
str-map.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
str-map.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
str-map.for-each = () (k str, v str) {
    i <- [0...cap): {
        .occ[i] == 1 -> {

            #{index-out=0}
            k = .keys[i]

            #{index-out=0}
            v = .vals[i]
        }
    }
}

; to-str: 字串表示
; 格式如 `{name: Alice, age: 18}`
str-map.to-str = () (out str) {
    out = '{'
    first = true
    i <- [0...cap): {
        .occ[i] == 1 -> {
            first -> {
                out = out - .keys[i] - ': ' - .vals[i]
                first = false
            }
            -> {
                out = out - ', ' - .keys[i] - ': ' - .vals[i]
            }
        }
    }
    out = out - '}'
}
