; str-map — str→str 哈希映射表
;
; 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
; 適合小型鍵值對場景（建議 ≤ 192 條）。
;
; 用法：
;   m = str-map{}
;   m.init()
;   m.put('name', 'Alice')
;   val = m.get('name')   // val = ok('Alice') 或 nil
;   m.for-each(k, v)

; FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME = 1099511628211

str-map {
    cap i64
    keys [256]str
    vals [256]str
    occ [256]i64
    size i64
}

; 初始化
; [init](#collection.str-map.str-map.init)
str-map.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {

        .occ[i] = 0

        .keys[i].len = 0

        .vals[i].len = 0
    }
}

; FNV-1a 字串雜湊
; [hash](#collection.str-map.str-map.hash)
str-map.hash = (key str) (idx i64) {

    h = FNV-OFFSET
    i <- [0..key.len-bytes()): {

        h = h ^ (key.byte(i))

        #{overflow=wrap}
        h = h * FNV-PRIME
    }

    idx = h & (.cap - 1)
}

; 比較兩個 str 是否相等
; [str-eq](#collection.str-map.str-map.str-eq)
str-map.str-eq = (a str, b str) (eq bool) {
    a.len-bytes() != b.len-bytes() -> return
    i <- [0..a.len-bytes()): {
        a.byte(i) != b.byte(i) -> {

            return
        }
    }
    eq = true
}

; 插入或更新 key→value，回傳是否新增
; [put](#collection.str-map.str-map.put)
str-map.put = (key str, val str) (is-new bool) {

    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)
        eq -> {

            ; 直接指派；結構欄位寫入會深拷貝 inline str，不需要手動 .len + 逐字節拷貝
            .vals[idx] = val
            is-new = false
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }

    ; 複製 key / val。
    ; 不能用 `.keys[idx].len = key.len-bytes()` 再逐字節寫：`.len = n` 是裸欄位寫入，
    ; 不會分配緩衝區，而新槽位的 keys[idx] 緩衝區還是 null，下一個 [i] = 會對 null
    ; 做 GEP+store（SIGSEGV）。直接指派會深拷貝，才是正確寫法。
    .keys[idx] = key

    .vals[idx] = val

    .occ[idx] = 1

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; 查找 key，返回 ?str（nil=未找到）
; [get](#collection.str-map.str-map.get)
str-map.get = (key str) (result ?str) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)
        eq -> {

            result = .vals[idx]
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 檢查 key 是否存在
; [contains](#collection.str-map.str-map.contains)
str-map.contains = (key str) (found bool) {
    val = .get(key)
    val: {
        ok -> found = true

        err ->

        nil ->
    }
}

; 刪除 key
; [remove](#collection.str-map.str-map.remove)
str-map.remove = (key str) (removed bool) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        eq = .str-eq(.keys[idx], key)

        #{overflow=wrap}
        eq -> {

            .occ[idx] = 0

            .keys[idx].len = 0

            .vals[idx].len = 0
            .size = .size - 1
            removed = true
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; 清空
; [clear](#collection.str-map.str-map.clear)
str-map.clear = () {
    i <- [0...cap): {

        .occ[i] = 0

        .keys[i].len = 0

        .vals[i].len = 0
    }
    .size = 0
}

; 返回元素數量
; [len](#collection.str-map.str-map.len)
str-map.len = () (n i64) {
    n = .size
}

; 是否為空
; [is-empty](#collection.str-map.str-map.is-empty)
str-map.is-empty = () (empty bool) {
    empty = .size == 0
}

; 遍歷所有 (key, value)
; [for-each](#collection.str-map.str-map.for-each)
str-map.for-each = () (k str, v str) {
    i <- [0...cap): {
        .occ[i] == 1 -> {

            k = .keys[i]

            v = .vals[i]
        }
    }
}

; 字串表示
; 格式如 `{name: Alice, age: 18}`
; [to-str](#collection.str-map.str-map.to-str)
str-map.to-str = () (out str) {
    out = '{'
    first = true
    i <- [0...cap): {
        .occ[i] == 1 -> {
            first -> {
                out = out - .keys[i] - ': ' - .vals[i]
                first = false
            }

            -> {
                out = out - ', ' - .keys[i] - ': ' - .vals[i]
            }
        }
    }
    out = out - '}'
}
