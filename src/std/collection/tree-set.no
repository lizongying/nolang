; tree-set — 有序集合（基於 AVL 自平衡二元搜尋樹）
;
; i64 的有序集合，使用 AVL 樹實作。
; 所有操作為 O(log n)，元素按升序遍歷。
;
; 與 hash-set 的差異：
; - tree-set 按值排序（升序），hash-set 無序
; - tree-set 支援 lower-bound/upper-bound 有序查詢
; - tree-set 使用 AVL 樹，hash-set 使用哈希表
; - tree-set 的 contains/add/remove 返回 bool option
;
; 用法：
;   s = tree-set{}
;   s.init()
;   ok = s.add(3)             // ok=true（新增）
;   ok = s.add(1)             // ok=true
;   ok = s.add(2)             // ok=true
;   ok = s.add(1)             // ok=false（已存在）
;   yes = s.contains(2)       // yes=true
;   val = s.first()           // val = ok（最小值）
;   val = s.last()            // val = ok（最大值）
;   val = s.lower-bound(2)    // val = ok（第一個 ≥ 2）
;   val = s.upper-bound(2)    // val = ok（第一個 > 2）
;   ok = s.remove(2)          // ok=true
;   s.for-each(v)             // 按升序遍歷所有元素
;
;   // option 解包
;   val = s.lower-bound(42)
;   val: {
;       nil -> print('not found')
;       -> print(it)
;   }
; [tree-set](#tree-set)

TS-CAP = 64

; tree-set: AVL 有序集合
; root: 樹根節點索引，-1=空樹
; free-head: 空閒節點池頭索引，-1=池已滿
; size: 當前元素數量
; keys: 鍵儲存
; left/right/parent: 樹結構索引，-1=NIL
; height: 節點高度（葉=1，NIL=0）
; [tree-set](#tree-set.tree-set)
tree-set {
    root i64
    free-head i64
    size i64
    keys [64]i64
    left [64]i64
    right [64]i64
    parent [64]i64
    height [64]i64
}

; 初始化
...

; 初始化空樹與空閒節點池
; [init](#tree-set.tree-set.init)
tree-set.init = () {
    .root = -1
    .free-head = 0
    .size = 0

    {

        #{overflow=wrap}
        i <- [0..TS-CAP - 1): {

            #{overflow=wrap}
            .left[i] ?= i + 1
        }

        #{overflow=wrap}
        .left[TS-CAP - 1] ?= -1
    }: {
        err -> _

        -> _
    }
}

; 內部方法：節點池管理
...

; 從空閒池分配節點
; 返回 idx i64: 節點索引，-1=池已滿
; [alloc-node](#tree-set.tree-set.alloc-node)
tree-set.alloc-node = () (idx i64) {
    idx = .free-head
    idx < 0 -> return

    .free-head = .left[idx]: {
        ok -> it

        -> _
    }

    {
        .left[idx] ?= -1

        .right[idx] ?= -1

        .parent[idx] ?= -1

        .height[idx] ?= 1
    }: {
        err -> _

        -> _
    }
}

; 將節點歸還空閒池
; idx i64: 要釋放的節點索引
; [free-node](#tree-set.tree-set.free-node)
tree-set.free-node = (idx i64) {
    {
        .left[idx] ?= .free-head
        .free-head = idx
    }: {
        err -> _

        -> _
    }
}

; 內部方法：AVL 高度與平衡
...

; 取得節點高度（NIL=0）
; idx i64: 節點索引
; 返回 h i64: 高度
; [ht](#tree-set.tree-set.ht)
tree-set.ht = (idx i64) (h i64) {
    h = 0
    idx < 0 -> return

    h = .height[idx]: {
        ok -> it

        -> _
    }
}

; 重新計算節點高度
; idx i64: 節點索引
; [update-ht](#tree-set.tree-set.update-ht)
tree-set.update-ht = (idx i64) {
    {
        l ?= .left[idx]
        lh = .ht(l)

        r ?= .right[idx]
        rh = .ht(r)

        #{overflow=wrap}
        .height[idx] ?= (lh > rh ? lh : rh) + 1
    }: {
        err -> _

        -> _
    }
}

; 取得平衡因子（左高 - 右高）
; idx i64: 節點索引
; 返回 b i64: 平衡因子
;
; ⚠️ 原實作把 `b = it` 寫在「裸塊 + 值位 match」裡（`b-opt: { ok -> b = it  ->  }`），
; 這個形態對外層變數的寫入會被**靜默丟棄**（test/README.md §5.2 #15 / §5.1a）——
; 於是 bf 恒回 0 ⇒ rebalance 永遠判定「已平衡」⇒ 整棵樹從不自平衡。
; 實測（修前）：升序插入 1..10 得到**高度 10 的右鏈**，複雜度退化成 O(n)。
; 修法：先接值位 match 的結果到局部，再直接賦值給結果參數。
; [bf](#tree-set.tree-set.bf)
tree-set.bf = (idx i64) (b i64) {
    b = 0
    idx < 0 -> return
    l = .left[idx]: {
        ok -> it

        -> -1
    }
    r = .right[idx]: {
        ok -> it

        -> -1
    }
    lh = .ht(l)
    rh = .ht(r)

    ; 正解：match 直接掛在表達式上（見 tree-map.bf 的註解與 test/README.md §5.1q）
    #{overflow=wrap}
    b = lh - rh: {
        ok -> it

        -> 0
    }
}

; 內部方法：AVL 旋轉
...

; 左旋
;     x                y
;    / \              / \
;   a   y     =>     x   c
;      / \          / \
;     b   c        a   b
; x i64: 旋轉軸節點
; [rot-left](#tree-set.tree-set.rot-left)
tree-set.rot-left = (x i64) {
    y = .right[x]: {
        ok -> it

        -> _
    }

    b = .left[y]: {
        ok -> it

        -> _
    }

    {
        .right[x] ?= b
        b >= 0 -> {
            .parent[b] ?= x
        }

        .left[y] ?= x

        .parent[y] ?= .parent[x]

        p = .parent[x]: {
            ok -> it

            -> _
        }
        {
            p < 0 -> .root = y

            -> {
                lp ?= .left[p]
                lp == x -> {
                    .left[p] ?= y
                }
                lp != x -> {
                    .right[p] ?= y
                }
            }
        }

        .parent[x] ?= y
        .update-ht(x)
        .update-ht(y)
    }: {
        err -> _

        -> _
    }
}

; 右旋
;       x              y
;      / \            / \
;     y   c   =>     a   x
;    / \                / \
;   a   b              b   c
; x i64: 旋轉軸節點
; [rot-right](#tree-set.tree-set.rot-right)
tree-set.rot-right = (x i64) {
    y = .left[x]: {
        ok -> it

        -> _
    }

    b = .right[y]: {
        ok -> it

        -> _
    }

    {
        .left[x] ?= b
        b >= 0 -> {
            .parent[b] ?= x
        }

        .right[y] ?= x

        .parent[y] ?= .parent[x]

        p = .parent[x]: {
            ok -> it

            -> _
        }
        {
            p < 0 -> .root = y

            -> {
                lp ?= .left[p]
                lp == x -> {
                    .left[p] ?= y
                }
                lp != x -> {
                    .right[p] ?= y
                }
            }
        }

        .parent[x] ?= y
        .update-ht(x)
        .update-ht(y)
    }: {
        err -> _

        -> _
    }
}

; 內部方法：AVL 再平衡
...

; 在節點 idx 檢查並修復平衡
; idx i64: 節點索引
; 返回 nr i64: 再平衡後的子樹根索引
; [rebalance](#tree-set.tree-set.rebalance)
tree-set.rebalance = (idx i64) (nr i64) {
    nr = idx
    b = .bf(idx)

    {
        li ?= .left[idx]
        ri ?= .right[idx]

        ; 左重（b > 1）
        {
            b > 1 -> {
                lb = .bf(li)
                lb < 0 -> {
                    .rot-left(li)
                }
                .rot-right(idx)

                nr = .parent[idx]: {
                    ok -> it

                    -> _
                }
                return
            }

            b < -1 -> {

                ; 右重（b < -1）

                rb = .bf(ri)
                rb > 0 -> {
                    .rot-right(ri)
                }
                .rot-left(idx)

                nr = .parent[idx]: {
                    ok -> it

                    -> _
                }
                return
            }
        }
        .update-ht(idx)
    }: {
        err -> _

        -> _
    }
}

; 從 idx 向上逐層再平衡
; idx i64: 起始節點索引
; [rebalance-up](#tree-set.tree-set.rebalance-up)
tree-set.rebalance-up = (idx i64) {
    r-idx = idx
    (r-idx >= 0) {
        nr = .rebalance(r-idx)

        r-idx = .parent[nr]: {
            ok -> it

            -> _
        }
    }
}

; 求節點的中序後繼
; idx i64: 節點索引
; 返回 succ i64: 後繼索引，-1=無後繼
; [successor](#tree-set.tree-set.successor)
tree-set.successor = (idx i64) (succ i64) {
    r-idx = idx
    succ = -1
    {
        r ?= .right[r-idx]
        r >= 0 -> {
            succ = r
            l ?= .left[succ]
            (l >= 0) {
                succ = l
                l ?= .left[succ]
            }
            return
        }

        p = .parent[r-idx]: {
            ok -> it

            -> _
        }
        (p >= 0) {
            rp ?= .right[p]
            r-idx != rp -> {
                break
            }
            r-idx = p

            p = .parent[p]: {
                ok -> it

                -> _
            }
        }
        succ = p
    }: {
        err -> _

        -> _
    }
}

; 公開 API：增刪查
...

; 加入元素
; key i64: 要加入的值
; 返回 ok bool: true=新增, false=已存在或池已滿
; [add](#tree-set.tree-set.add)
tree-set.add = (key i64) (ok bool) {
    {

        ; 空樹
        .root < 0 -> {
            idx = .alloc-node()
            idx < 0 -> return

            .keys[idx] ?= key
            .root = idx
            .size = 1
            ok = true
            return
        }

        ; BST 搜尋插入點
        cur = .root
        !! {
            k ?= .keys[cur]
            key == k -> {
                return
            }
            {
                key < k -> {
                    l ?= .left[cur]
                    l < 0 -> {
                        idx = .alloc-node()
                        idx < 0 -> return

                        .keys[idx] ?= key

                        .left[cur] ?= idx

                        .parent[idx] ?= cur

                        #{overflow=wrap}
                        .size = .size + 1: {
                            ok -> it

                            ->
                        }
                        ok = true
                        .rebalance-up(cur)
                        return
                    }

                    cur = l
                }

                -> {
                    r ?= .right[cur]
                    r < 0 -> {
                        idx = .alloc-node()
                        idx < 0 -> return

                        .keys[idx] ?= key

                        .right[cur] ?= idx

                        .parent[idx] ?= cur

                        #{overflow=wrap}
                        .size = .size + 1: {
                            ok -> it

                            ->
                        }
                        ok = true
                        .rebalance-up(cur)
                        return
                    }

                    cur = r
                }
            }
        }
    }: {
        err -> _

        -> _
    }
}

; 檢查元素是否存在
; key i64: 要檢查的值
; 返回 yes bool: true=存在, false=不存在
; [contains](#tree-set.tree-set.contains)
tree-set.contains = (key i64) (yes bool) {
    idx = .root
    {
        (idx >= 0) {
            k ?= .keys[idx]
            key == k -> {
                yes = true
                return
            }
            {
                key < k -> {
                    idx = .left[idx]: {
                        ok -> it

                        -> _
                    }
                }

                -> {
                    idx = .right[idx]: {
                        ok -> it

                        -> _
                    }
                }
            }
        }
    }: {
        err -> _

        -> _
    }
}

; 刪除元素
; key i64: 要刪除的值
; 返回 ok bool: true=已刪除, false=未找到
; [remove](#tree-set.tree-set.remove)
tree-set.remove = (key i64) (ok bool) {
    {

        ; BST 搜尋
        idx = .root
        (idx >= 0) {
            k ?= .keys[idx]
            key == k -> {
                break
            }
            {
                key < k -> {
                    idx = .left[idx]: {
                        ok -> it

                        -> _
                    }
                }

                -> {
                    idx = .right[idx]: {
                        ok -> it

                        -> _
                    }
                }
            }
        }
        idx < 0 -> return
        ok = true

        #{overflow=wrap}
        .size = .size - 1: {
            ok -> it

            ->
        }

        ; 雙子節點：用後繼替換後刪除後繼
        l ?= .left[idx]
        r ?= .right[idx]
        l >= 0 && r >= 0 -> {
            succ = r
            sl ?= .left[succ]
            (sl >= 0) {
                succ = sl
                sl ?= .left[succ]
            }

            .keys[idx] ?= .keys[succ]
            idx = succ
        }

        ; 此時 idx 最多一個子節點
        child = .left[idx]: {
            ok -> it

            -> _
        }
        child < 0 -> {
            child = .right[idx]: {
                ok -> it

                -> _
            }
        }

        p = .parent[idx]: {
            ok -> it

            -> _
        }
        child >= 0 -> {
            .parent[child] ?= p
        }
        {
            p < 0 -> .root = child

            -> {
                lp ?= .left[p]
                lp == idx -> {
                    .left[p] ?= child
                }
                lp != idx -> {
                    .right[p] ?= child
                }
            }
        }
        .free-node(idx)

        ; 從父節點向上再平衡
        p >= 0 -> .rebalance-up(p)
    }: {
        err -> _

        -> _
    }
}

; 公開 API：有序操作
...

; 取得最小值
; 返回 val ?i64: ok=最小值, nil=空集合
; [first](#tree-set.tree-set.first)
tree-set.first = () (val ?i64) {
    idx = .root
    idx < 0 -> {
        val = nil
        return
    }
    l ?= .left[idx]
    (l >= 0) {
        idx = l
        l ?= .left[idx]
    }

    val = .keys[idx]: {
        ok -> it

        -> _
    }
}

; 取得最大值
; 返回 val ?i64: ok=最大值, nil=空集合
; [last](#tree-set.tree-set.last)
tree-set.last = () (val ?i64) {
    idx = .root
    idx < 0 -> {
        val = nil
        return
    }
    r ?= .right[idx]
    (r >= 0) {
        idx = r
        r ?= .right[idx]
    }

    val = .keys[idx]: {
        ok -> it

        -> _
    }
}

; 找第一個 ≥ target 的元素
; target i64: 目標值
; 返回 val ?i64: ok=找到, nil=無此元素
; [lower-bound](#tree-set.tree-set.lower-bound)
tree-set.lower-bound = (target i64) (val ?i64) {
    result = -1
    idx = .root
    (idx >= 0) {
        kv ?= .keys[idx]
        {
            kv >= target -> {
                result = idx

                idx = .left[idx]: {
                    ok -> it

                    -> _
                }
            }

            -> {
                idx = .right[idx]: {
                    ok -> it

                    -> _
                }
            }
        }
    }
    result < 0 -> {
        val = nil
        return
    }

    val = .keys[result]: {
        ok -> it

        -> _
    }
}

; 找第一個 > target 的元素
; target i64: 目標值
; 返回 val ?i64: ok=找到, nil=無此元素
; [upper-bound](#tree-set.tree-set.upper-bound)
tree-set.upper-bound = (target i64) (val ?i64) {
    result = -1
    idx = .root
    (idx >= 0) {
        kv ?= .keys[idx]
        {
            kv > target -> {
                result = idx

                idx = .left[idx]: {
                    ok -> it

                    -> _
                }
            }

            -> {
                idx = .right[idx]: {
                    ok -> it

                    -> _
                }
            }
        }
    }
    result < 0 -> {
        val = nil
        return
    }

    val = .keys[result]: {
        ok -> it

        -> _
    }
}

; 按升序遍歷所有元素
; val i64: 輸出值（每個元素更新）
; [for-each](#tree-set.tree-set.for-each)
tree-set.for-each = () (val i64) {
    idx = .root
    idx < 0 -> return

    ; 定位到最小值
    {
        l ?= .left[idx]
        (l >= 0) {
            idx = l
            l ?= .left[idx]
        }
    }: {
        err -> _

        -> _
    }

    ; 逐個後繼遍歷
    (idx >= 0) {
        val = .keys[idx]: {
            ok -> it

            -> _
        }
        idx = .successor(idx)
    }
}

; 公開 API：狀態查詢
...

; 清空所有元素，重建空閒池
; [clear](#tree-set.tree-set.clear)
tree-set.clear = () {
    .root = -1
    .free-head = 0
    .size = 0

    {

        #{overflow=wrap}
        i <- [0..TS-CAP - 1): {

            #{overflow=wrap}
            .left[i] ?= i + 1
        }

        #{overflow=wrap}
        .left[TS-CAP - 1] ?= -1
    }: {
        err -> _

        -> _
    }
}

; 返回元素數量
; 返回 sz i64: 元素數量
; [size](#tree-set.tree-set.size)
tree-set.size = () (sz i64) {
    sz = .size
}

; 判斷是否為空
; 返回 yes bool: true=空, false=非空
; [empty](#tree-set.tree-set.empty)
tree-set.empty = () (yes bool) {
    yes = .size <= 0
}

; 判斷節點池是否已滿
; 返回 yes bool: true=已滿, false=未滿
; [full](#tree-set.tree-set.full)
tree-set.full = () (yes bool) {
    yes = .free-head < 0
}
