; deque — 雙端佇列
;
; 使用 []i64 實作雙端佇列（Double-Ended Queue）。
; 支援從前後兩端推入和彈出元素。
; 內部使用循環緩衝區實作。
;
; 用法：
;   use std/deque
;   buf [128]i64 = [0:128]
;   d = deque { buf: buf, cap: 128, head: 0, tail: 0 }
;   d.push-back(42)
;   d.push-back(7)
;   val = d.pop-front()
;   val: {
;       nil -> print('empty')
;       -> print(it)
;   }

; deque: 雙端佇列狀態
; buf []i64: 環形緩衝區，容量 = cap（由呼叫方提供並保活）
; cap i64: 佇列容量上限（等於 buf 長度）
; head i64: 前端虛擬下標；實際儲存下標為 head mod cap
; tail i64: 後端虛擬下標；tail - head = 元素數量
deque {
    buf []i64
    cap i64
    head i64
    tail i64
}

; 從前端推入元素
; 佇列已滿（元素數 >= cap）時直接忽略本次推入，不報錯。
; val i64: 要放在前端的值
; [push-front](#deque.deque.push-front)
deque.push-front = (val i64) {

    #{overflow=wrap}
    n = .tail - .head
    n >= .cap -> return

    #{overflow=wrap}
    new-head = .head - 1
    idx = new-head

    #{overflow=wrap}
    idx < 0 -> idx = idx + .cap

    .buf[idx] = val
    .head = new-head
}

; 從後端推入元素
; 佇列已滿（元素數 >= cap）時直接忽略本次推入，不報錯。
; val i64: 要放在後端的值
; [push-back](#deque.deque.push-back)
deque.push-back = (val i64) {

    #{overflow=wrap}
    n = .tail - .head
    n >= .cap -> return
    idx = .tail

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    .buf[idx] = val

    #{overflow=wrap}
    .tail = .tail + 1
}

; 從前端彈出元素
; val ?i64: ok=原前端元素（已移除）, nil=佇列為空
; [pop-front](#deque.deque.pop-front)
deque.pop-front = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }
    idx = .head

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]

    #{overflow=wrap}
    .head = .head + 1
}

; 從後端彈出元素
; val ?i64: ok=原後端元素（已移除）, nil=佇列為空
; [pop-back](#deque.deque.pop-back)
deque.pop-back = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }

    #{overflow=wrap}
    new-tail = .tail - 1
    idx = new-tail

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]
    .tail = new-tail
}

; 查看前端元素（不移除）
; val ?i64: ok=目前前端元素, nil=佇列為空
; [peek-front](#deque.deque.peek-front)
deque.peek-front = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }
    idx = .head

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]
}

; 查看後端元素（不移除）
; val ?i64: ok=目前後端元素, nil=佇列為空
; [peek-back](#deque.deque.peek-back)
deque.peek-back = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }

    #{overflow=wrap}
    idx = .tail - 1

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]
}

; 返回雙端佇列目前元素數量
; sz i64: tail - head（元素存續期間不會回到負值）
; [size](#deque.deque.size)
deque.size = () (sz i64) {

    #{overflow=wrap}
    sz = .tail - .head
}

; 判斷雙端佇列是否為空
; yes bool: true 表示 tail <= head（沒有可取的元素）
; [empty](#deque.deque.empty)
deque.empty = () (yes bool) {
    yes = .tail <= .head
}

; 清空雙端佇列（tail 回到 head，不釋放 buf、不重置 head）
; 無參數與返回值；清空後 size() 為 0
; [clear](#deque.deque.clear)
deque.clear = () {
    .tail = .head
}
