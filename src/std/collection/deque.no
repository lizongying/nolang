; deque — 雙端佇列
;
; 使用 []i64 實作雙端佇列（Double-Ended Queue）。
; 支援從前後兩端推入和彈出元素。
; 內部使用循環緩衝區實作。
;
; 用法：
;   use std/deque
;   buf [128]i64 = [0:128]
;   d = deque { buf: buf, cap: 128, head: 0, tail: 0 }
;   d.push-back(42)
;   d.push-back(7)
;   val = d.pop-front()
;   val: {
;       nil -> print('empty')
;       -> print(it)
;   }

; deque: 雙端佇列
deque {
    buf []i64
    cap i64
    head i64
    tail i64
}

; 從前端推入元素
; [push-front](#collection.deque.deque.push-front)
deque.push-front = (val i64) {

    #{overflow=wrap}
    n = .tail - .head
    n >= .cap -> return

    #{overflow=wrap}
    new-head = .head - 1
    idx = new-head

    #{overflow=wrap}
    idx < 0 -> idx = idx + .cap

    .buf[idx] = val
    .head = new-head
}

; 從後端推入元素
; [push-back](#collection.deque.deque.push-back)
deque.push-back = (val i64) {

    #{overflow=wrap}
    n = .tail - .head
    n >= .cap -> return
    idx = .tail

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    .buf[idx] = val

    #{overflow=wrap}
    .tail = .tail + 1
}

; 從前端彈出元素
; 返回 val ?i64: ok=彈出值, nil=佇列為空
; [pop-front](#collection.deque.deque.pop-front)
deque.pop-front = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }
    idx = .head

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]

    #{overflow=wrap}
    .head = .head + 1
}

; 從後端彈出元素
; 返回 val ?i64: ok=彈出值, nil=佇列為空
; [pop-back](#collection.deque.deque.pop-back)
deque.pop-back = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }

    #{overflow=wrap}
    new-tail = .tail - 1
    idx = new-tail

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]
    .tail = new-tail
}

; 查看前端元素（不移除）
; 返回 val ?i64: ok=前端值, nil=佇列為空
; [peek-front](#collection.deque.deque.peek-front)
deque.peek-front = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }
    idx = .head

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]
}

; 查看後端元素（不移除）
; 返回 val ?i64: ok=後端值, nil=佇列為空
; [peek-back](#collection.deque.deque.peek-back)
deque.peek-back = () (val ?i64) {

    #{overflow=wrap}
    n = .tail - .head
    n <= 0 -> {
        val = nil
        return
    }

    #{overflow=wrap}
    idx = .tail - 1

    #{overflow=wrap}
    {
        idx >= 0 -> idx = idx % .cap

        -> idx = .cap - ((-idx) % .cap)
    }

    val = .buf[idx]
}

; 返回雙端佇列大小
; [size](#collection.deque.deque.size)
deque.size = () (sz i64) {

    #{overflow=wrap}
    sz = .tail - .head
}

; 判斷雙端佇列是否為空
; 返回 true=空, false=非空
; [empty](#collection.deque.deque.empty)
deque.empty = () (yes bool) {
    yes = .tail <= .head
}

; 清空雙端佇列
; [clear](#collection.deque.deque.clear)
deque.clear = () {
    .tail = .head
}
