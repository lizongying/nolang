; linked-hash-map — i64→i64 有序哈希表
;
; 固定容量（64 條），線性探測，雙向鏈表保持插入順序。
; 容量為 2 的冪，建議裝載因子 ≤ 0.75（即最多 ~48 條）。
;
; 用法：
;   m = linked-hash-map{}
;   m.put(42, 100)
;   val = m.get(42)   // val = ok(100) 或 nil
;   m.for-each(key, val)

linked-hash-map {
    cap i64
    keys [64]i64
    vals [64]i64
    occ [64]i64
    nxt [64]i64
    prv [64]i64
    head i64
    tail i64
    size i64
}

; init: 初始化哈希表
linked-hash-map.init = () {
    .cap = 64
    .head = -1
    .tail = -1
    .size = 0
    i <- [0..64): {

        #{index-out=0}
        .occ[i] = 0

        #{index-out=0}
        .nxt[i] = -1

        #{index-out=0}
        .prv[i] = -1
    }
}

; hash: 計算索引
linked-hash-map.hash = (key i64) (idx i64) {

    #{overflow=wrap}
    idx = key & (.cap - 1)
}

; put: 插入或更新 key→value
linked-hash-map.put = (key i64, val i64) (is-new bool) {

    #{overflow=wrap}
    idx = .hash(key)

    (.occ[idx] == 1) {

        #{overflow=wrap}
        .keys[idx] == key -> {

            #{index-out=0}
            .vals[idx] = val
            is-new = false
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }

    #{index-out=0}
    .keys[idx] = key

    #{index-out=0}
    .vals[idx] = val

    #{index-out=0}
    .occ[idx] = 1

    #{index-out=0}
    .nxt[idx] = -1

    #{index-out=0}
    .prv[idx] = .tail

    {
        .head == -1 -> {
            .head = idx
            .tail = idx
        }

        -> {

            #{index-out=0}
            .nxt[.tail] = idx
            .tail = idx
        }
    }

    #{overflow=wrap}
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?i64（nil=未找到）
linked-hash-map.get = (key i64) (result ?i64) {
    .size == 0 -> return
    idx = .hash(key)

    (.occ[idx] == 1) {

        #{overflow=wrap}
        .keys[idx] == key -> {

            #{index-out=0}
            result = .vals[idx]
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

; contains: 檢查 key 是否存在
linked-hash-map.contains = (key i64) (found bool) {
    val = .get(key)
    val: {
        ok -> found = true

        err ->

        nil ->
    }
}

; remove: 刪除 key
linked-hash-map.remove = (key i64) (removed bool) {
    idx = .hash(key)

    (.occ[idx] == 1) {

        #{overflow=wrap}
        .keys[idx] == key -> {

            #{index-out=0, overflow=wrap}
            .occ[idx] = 0
            .size = .size - 1

            #{index-out=0}
            prev = .prv[idx]

            #{index-out=0}
            next = .nxt[idx]
            {
                prev == -1 -> .head = next

                -> {

                    #{index-out=0}
                    .nxt[prev] = next
                }
            }
            {
                next == -1 -> .tail = prev

                -> {

                    #{index-out=0}
                    .prv[next] = prev
                }
            }
            removed = true
            return
        }

        #{overflow=wrap}
        idx = idx + 1
        idx >= .cap -> idx = 0

        #{index-out=0}
    }
}

; clear: 清空
linked-hash-map.clear = () {
    i <- [0...cap): {

        #{index-out=0}
        .occ[i] = 0
    }
    .head = -1
    .tail = -1
    .size = 0
}

; len: 返回元素數量
linked-hash-map.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
linked-hash-map.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 按插入順序遍歷所有 (key, value)
linked-hash-map.for-each = () (k i64, v i64) {
    idx = .head
    (idx != -1) {
        .occ[idx] == 1 -> {

            #{index-out=0}
            k = .keys[idx]

            #{index-out=0}
            v = .vals[idx]
        }

        #{index-out=0}
        idx = .nxt[idx]
    }
}
