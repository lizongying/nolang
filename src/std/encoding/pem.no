; encoding/pem — PEM 格式編解碼（RFC 7468）
;
; PEM（Privacy-Enhanced Mail）格式廣泛用於 X.509 憑證、RSA/ECDSA 金鑰等。
; 格式：
;   -----BEGIN LABEL-----
;   <Base64 編碼的資料，每行 64 字元>
;   -----END LABEL-----
;
; 用法：
;   ; 編碼
;   pem-str = pem-encode('CERTIFICATE', raw-bytes)
;
;   ; 解碼
;   result = pem-decode(pem-str)
;   result: {
;       ok -> {
;           label = result.label
;           data = result.data
;       }
;   }

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 每行最大 Base64 字元數
PEM-LINE-LEN = 64

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; pem-block: PEM 解碼結果
; label str: BEGIN/END 之間的標籤（如 'CERTIFICATE'）
; data []byte: Base64 解碼後的二進位載荷
pem-block {
    label str
    data []byte
}

; ═══════════════════════════════════════════════
; 編碼
; ═══════════════════════════════════════════════

; 將原始位元組編碼為 PEM 格式字串
; label str: PEM 標籤（如 'CERTIFICATE', 'RSA PRIVATE KEY'），必須與 BEGIN/END 一致
; data []byte: 原始二進制資料，由 base64.encode-std 編碼後按 64 字元折行
; out str: 完整的 PEM 文字，包含 BEGIN/END 行與每行行尾換行
; [pem-encode](#pem.pem-encode)
pem-encode = (label str, data []byte) (out str) {

    ; Base64 編碼
    b64 str
    b64 = base64.encode-std(data)

    ; 構建頭尾
    header = '-----BEGIN ' - label - '-----'

    footer = '-----END ' - label - '-----'

    ; 計算輸出長度
    b64-len = b64.len-bytes()

    #{overflow=wrap}
    num-lines = b64-len / PEM-LINE-LEN

    #{overflow=wrap}
    b64-len % PEM-LINE-LEN != 0 -> num-lines = num-lines + 1

    #{overflow=wrap}
    total = header.len-bytes() + 1

    #{overflow=wrap}
    total = total + b64-len

    #{overflow=wrap}
    total = total + num-lines

    #{overflow=wrap}
    total = total + footer.len-bytes() + 1

    out = with-cap(total)
    pos = 0

    ; 寫入 header
    i <- [0..header.len-bytes()): {

        out[pos] = header.byte(i)

        #{overflow=wrap}
        pos = pos + 1
    }

    out[pos] = 10

    #{overflow=wrap}
    pos = pos + 1

    ; 寫入 Base64（每行 64 字元）
    src = 0
    !! {

        src >= b64-len -> break

        #{overflow=wrap}
        remaining = b64-len - src
        line-len = PEM-LINE-LEN
        remaining < PEM-LINE-LEN -> line-len = remaining
        j <- [0..line-len): {

            #{overflow=wrap}
            out[pos] = b64[src + j]

            #{overflow=wrap}
            pos = pos + 1
        }

        out[pos] = 10

        #{overflow=wrap}
        pos = pos + 1

        #{overflow=wrap}
        src = src + PEM-LINE-LEN
    }

    ; 寫入 footer
    i <- [0..footer.len-bytes()): {

        out[pos] = footer.byte(i)

        #{overflow=wrap}
        pos = pos + 1
    }

    out[pos] = 10

    #{overflow=wrap}
    pos = pos + 1
}

; ═══════════════════════════════════════════════
; 解碼
; ═══════════════════════════════════════════════

; 解析 PEM 格式字串（只取輸入中第一個 BEGIN…END 區塊）
; pem-str str: 至少包含一段 '-----BEGIN <label>-----' … '-----END <label>-----' 的文字
; result ?pem-block: ok=標籤與解碼後的載荷, nil=缺少標記、Base64 解碼失敗或內容過短
; [pem-decode](#pem.pem-decode)
pem-decode = (pem-str str) (result ?pem-block) {

    n = pem-str.len-bytes()
    n < 10 -> return

    ; 查找 '-----BEGIN '
    begin-marker = '-----BEGIN '
    pos = pem-str.index-from(begin-marker, 0)
    pos < 0 -> return

    ; 跳過 marker
    #{overflow=wrap}
    label-start = pos + begin-marker.len-bytes()

    ; 查找行尾的 '-----'
    label-end = pem-str.index-from('-----', label-start)
    label-end < 0 -> return

    ; 提取標籤
    label = pem-str.slice(label-start, label-end)

    ; 跳過 '-----\n'
    #{overflow=wrap}
    b64-start = label-end + 5

    ; 跳過換行符
    #{overflow=wrap}
    b64-start < n -> {
        pem-str[b64-start] == 10 -> {

            b64-start = b64-start + 1
        }
    }

    ; 查找 '-----END '
    end-marker = '-----END '
    end-pos = pem-str.index-from(end-marker, b64-start)
    end-pos < 0 -> return

    ; 提取 Base64 資料（去除換行符）
    b64-data str

    #{overflow=wrap}
    b64-data = with-cap(end-pos - b64-start)
    dst = 0
    i <- [b64-start..end-pos): {

        c = pem-str[i]

        ; 跳過換行符和空白
        skip = false
        {
            c == 10 -> skip = true

            c == 13 -> skip = true

            c == 32 -> skip = true
        }

        #{overflow=wrap}
        skip == false -> {

            ; b64-data 是 with-cap 出來的 len=0 緩衝，不能用 `b64-data[dst]: { ok -> it = c }`
            ; （place-match 以讀作閘門，len=0 時讀越界回 nil，ok 臂永不執行），
            ; 必須直接下標寫入才能增長長度。
            b64-data[dst] = c
            dst = dst + 1
        }
    }

    ; Base64 解碼
    decoded = base64.decode(b64-data, base64.BASE64-STD)
    decoded: {
        ok -> {
            blk pem-block
            blk.label = label
            blk.data = it
            result = blk
        }

        nil -> return

        err -> return
    }
}
