; csv — CSV 檔案解析
;
; 提供 CSV 格式的讀取與產生功能。
; 支援標準 CSV 格式（RFC 4180）：逗號分隔、雙引號跳脫。
;
; 用法：
;   use std/encoding/csv
;   line = 'a,b,c'
;   fields = csv.parse-line(line)           // max-fields 默認 1024
;   fields = csv.parse-line(line, 3)        // 限制最多 3 個欄位

; parse-field: 解析 CSV 中的一個欄位
; 從 s[pos] 開始解析，處理雙引號和逗號
; s str: CSV 文字
; pos i64: 開始位置
; 返回 field str: 解析出的欄位內容
; 返回 new-pos i64: 解析後的新位置
parse-field = (s str, pos i64) (field str, new-pos i64) {
    r-pos = pos
    fn = 0
    field = with-cap(s.len-bytes())
    r-pos >= s.len-bytes() -> {
        new-pos = r-pos
        return
    }

    #{index-out=0}
    c = s[r-pos]
    {
        c == 44 -> {

            ; 空欄位（逗號開頭）
            #{overflow=wrap}
            new-pos = r-pos + 1
            return
        }

        c == 34 -> {

            ; 雙引號包圍的欄位
            #{overflow=wrap}
            r-pos = r-pos + 1
            (r-pos < s.len-bytes()) {

                #{index-out=0, overflow=wrap}
                c = s[r-pos]
                c == 34 -> {

                    ; 檢查是否為跳脫的雙引號
                    #{overflow=wrap}
                    r-pos + 1 < s.len-bytes() -> {

                        #{index-out=0, overflow=wrap}
                        nc = s[r-pos + 1]
                        nc == 34 -> {

                            #{index-out=0, overflow=wrap}
                            field[fn] = 34
                            fn = fn + 1
                            r-pos = r-pos + 2
                            continue
                        }
                    }

                    ; 結束雙引號
                    #{overflow=wrap}
                    r-pos = r-pos + 1

                    ; 跳過後續逗號
                    r-pos < s.len-bytes() -> {

                        #{index-out=0, overflow=wrap}
                        nc = s[r-pos]

                        #{overflow=wrap}
                        nc == 44 -> r-pos = r-pos + 1
                    }
                    new-pos = r-pos
                    return
                }
                c == 10 || c == 13 -> {

                    ; 換行在引號內視為換行字元
                    #{index-out=0, overflow=wrap}
                    field[fn] = c

                    #{overflow=wrap}
                    fn = fn + 1

                    #{overflow=wrap}
                    r-pos = r-pos + 1
                    continue
                }

                #{index-out=0}
                field[fn] = c

                #{overflow=wrap}
                fn = fn + 1

                #{overflow=wrap}
                r-pos = r-pos + 1
            }
            new-pos = r-pos
            return
        }
    }

    ; 普通欄位（無引號）
    (r-pos < s.len-bytes()) {

        #{index-out=0, overflow=wrap}
        c = s[r-pos]

        #{overflow=wrap}
        {
            c == 44 -> {

                #{overflow=wrap}
                r-pos = r-pos + 1
                new-pos = r-pos
                return
            }

            c == 10 || c == 13 -> {

                ; 換行結束欄位（不消耗換行）
                new-pos = r-pos
                return
            }
        }

        #{index-out=0}
        field[fn] = c

        #{overflow=wrap}
        fn = fn + 1

        #{overflow=wrap}
        r-pos = r-pos + 1
    }
    new-pos = r-pos
}

; parse-line: 解析一行 CSV 文字
; s str: CSV 文字
; max-fields i64: 最大欄位數
; 返回 fields []str: 解析出的欄位陣列
parse-line = (s str, max-fields i64 = 1024) (fields []str) {
    n = 0
    pos = 0
    fields = with-cap(max-fields)
    (pos < s.len-bytes() && n < max-fields) {

        #{index-out=0}
        fields[n], pos = parse-field(s, pos)

        #{overflow=wrap}
        n = n + 1
    }
    fields.truncate(n)
}

; encode-field: 將一個欄位編碼為 CSV 格式
; 若包含逗號、雙引號或換行，則用雙引號包圍並跳脫
; field str: 要編碼的欄位
; 返回 out str: CSV 編碼後的字串
encode-field = (field str) (out str) {

    #{overflow=wrap}
    need-quote = false
    i <- [0..field.len-bytes()): {

        #{index-out=0, overflow=wrap}
        c = field[i]
        c == 44 || c == 34 || c == 10 || c == 13 -> {
            need-quote = true
            break
        }
    }
    need-quote == false -> {
        out = field
        return
    }
    j = 0

    #{overflow=wrap}
    out = with-cap(field.len-bytes() * 2 + 2)

    #{index-out=0}
    out[j] = 34

    #{overflow=wrap}
    j = j + 1
    i <- [0..field.len-bytes()): {

        #{index-out=0, overflow=wrap}
        c = field[i]

        #{overflow=wrap}
        {
            c == 34 -> {

                #{index-out=0, overflow=wrap}
                out[j] = 34
                j = j + 1

                #{index-out=0}
                out[j] = 34
            }

            -> {

                #{index-out=0}
                out[j] = c
            }
        }

        #{overflow=wrap}
        j = j + 1
    }

    #{index-out=0}
    out[j] = 34
}
