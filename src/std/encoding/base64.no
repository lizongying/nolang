; encoding/base64 — Base64 編解碼（RFC 4648）
;
; 提供標準與 URL 安全兩種字母表的編解碼。

; ═══════════════════════════════════════════════
; 字母表
; ═══════════════════════════════════════════════

; BASE64-STD: 標準 Base64 字母表
BASE64-STD = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

; BASE64-URL: URL 安全 Base64 字母表
BASE64-URL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_'

; PAD: 填充字元 '='
PAD = 61

; ═══════════════════════════════════════════════
; 編碼
; ═══════════════════════════════════════════════

; encode: 使用指定字母表進行 Base64 編碼
; data []byte: 輸入資料
; table str: Base64 字母表
; 返回 out str: Base64 編碼字串
encode = (data []byte, table str) (out str) {
    n = data.len
    out-cap = (n + 2) / 3 * 4
    out = with-cap(out-cap)
    i = 0
    j = 0
    {
        b0 = data[i] & 255
        b1 = data[i + 1] & 255
        b2 = data[i + 2] & 255
        out[j] = table[b0 >> 2]
        out[j + 1] = table[((b0 & 3) << 4) | (b1 >> 4)]
        out[j + 2] = table[((b1 & 15) << 2) | (b2 >> 6)]
        out[j + 3] = table[b2 & 63]
        i = i + 3
        j = j + 4
    } (i + 3 <= n)

    ; 處理剩餘 1 或 2 位元組
    rem = n - i
    rem == 1 -> {
        b0 = data[i] & 255
        out[j] = table[b0 >> 2]
        out[j + 1] = table[(b0 & 3) << 4]
        out[j + 2] = PAD
        out[j + 3] = PAD
    }
    rem == 2 -> {
        b0 = data[i] & 255
        b1 = data[i + 1] & 255
        out[j] = table[b0 >> 2]
        out[j + 1] = table[((b0 & 3) << 4) | (b1 >> 4)]
        out[j + 2] = table[(b1 & 15) << 2]
        out[j + 3] = PAD
    }
}

; encode-std: 使用標準字母表編碼
; data []byte: 輸入資料
; 返回 out str: Base64 編碼字串
encode-std = (data []byte) (out str) {
    out = encode(data, BASE64-STD, out)
}

; encode-url: 使用 URL 安全字母表編碼
; data []byte: 輸入資料
; 返回 out str: Base64 編碼字串
encode-url = (data []byte) (out str) {
    out = encode(data, BASE64-URL, out)
}

; ═══════════════════════════════════════════════
; 解碼
; ═══════════════════════════════════════════════

; decode: 使用指定字母表進行 Base64 解碼
; s str: Base64 字串
; table str: Base64 字母表
; 返回 out ?[]byte: ok=解碼後資料, err=無效字元
decode = (s str, table str) (out ?[]byte) {
    out = nil
    n = s.len

    ; 計算填充數
    pad-count = 0
    n > 0 -> {
        last = s[n - 1] & 255
        last == 61 -> pad-count = 1
    }
    n > 1 -> {
        last2 = s[n - 2] & 255
        last2 == 61 -> pad-count = 2
    }
    i = 0
    j = 0
    out = with-cap(n * 3 / 4)
    {
        v0 = b64-val(s[i], table)
        v1 = b64-val(s[i + 1], table)
        v2 = b64-val(s[i + 2], table)
        v3 = b64-val(s[i + 3], table)
        v0 < 0 || v1 < 0 -> {
            out = err('invalid base64 character')
            return
        }
        out[j] = (v0 << 2) | (v1 >> 4)
        s[i + 2] & 255 != 61 -> {
            v2 < 0 -> {
                out = err('invalid base64 character')
                return
            }
            out[j + 1] = ((v1 & 15) << 4) | (v2 >> 2)
        }
        s[i + 3] & 255 != 61 -> {
            v3 < 0 -> {
                out = err('invalid base64 character')
                return
            }
            out[j + 2] = ((v2 & 3) << 6) | v3
        }
        j = j + 3
        i = i + 4
    } (i + 4 <= n)
    out.len = j - pad-count
    out.len < 0 -> out.len = 0
}

; ═══════════════════════════════════════════════
; 輔助
; ═══════════════════════════════════════════════

; b64-val: 單個 Base64 字元轉數值
; 填充字元回傳 0，無效字元回傳 -1
b64-val = (c i64, table str) (v i64) {
    v = -1
    c == 61 -> {
        v = 0
        return
    }
    i <- [0..64): {
        tc = table[i] & 255
        tc == c -> {
            v = i
            return
        }
    }
}
