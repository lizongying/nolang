// str-map — str→str 哈希映射表
//
// 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
// 適合小型鍵值對場景（建議 ≤ 192 條）。
//
// 用法：
//   m = str-map{}
//   m.init()
//   m.put('name', 'Alice', _)
//   m.get('name', found, val)   // found=1, val='Alice'
//   m.for-each(k, v)

// FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME  = 1099511628211

str-map {
    cap   i64
    keys  [256]str
    vals  [256]str
    occ   [256]i64
    size  i64
}

// init: 初始化
str-map.init = () {
    .cap = 256
    .size = 0
    i = 0
    i < 256: {
        .occ[i] = 0
        .keys[i].len = 0
        .vals[i].len = 0
        i = i + 1
    }
}

// hash: FNV-1a 字串雜湊
str-map.hash = (key str, idx i64) {
    h = FNV-OFFSET
    i = 0
    i < key.len: {
        h = h ^ (key[i] & 255)
        h = h * FNV-PRIME
        i = i + 1
    }
    idx = h & (.cap - 1)
}

// str-eq: 比較兩個 str 是否相等
str-map.str-eq = (a str, b str, eq i64) {
    eq = 0
    a.len != b.len -> return
    i = 0
    i < a.len: {
        a[i] != b[i] -> return
        i = i + 1
    }
    eq = 1
}

// put: 插入或更新 key→value，回傳是否新增
str-map.put = (key str, val str, is-new i64) {
    idx = 0
    .hash(key, idx)

    .occ[idx] == 1: {
        eq = 0
        .str-eq(.keys[idx], key, eq)
        eq == 1 -> {
            .vals[idx] = val
            .vals[idx].len = val.len
            i = 0
            i < val.len: {
                .vals[idx][i] = val[i]
                i = i + 1
            }
            is-new = 0
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    }

    // 複製 key
    .keys[idx].len = key.len
    i = 0
    i < key.len: {
        .keys[idx][i] = key[i]
        i = i + 1
    }
    // 複製 val
    .vals[idx].len = val.len
    i = 0
    i < val.len: {
        .vals[idx][i] = val[i]
        i = i + 1
    }
    .occ[idx] = 1
    .size = .size + 1
    is-new = 1
}

// get: 查找 key
str-map.get = (key str, found i64, result str) {
    found = 0
    .size == 0 -> return

    idx = 0
    .hash(key, idx)

    .occ[idx] == 1: {
        eq = 0
        .str-eq(.keys[idx], key, eq)
        eq == 1 -> {
            result.len = .vals[idx].len
            i = 0
            i < result.len: {
                result[i] = .vals[idx][i]
                i = i + 1
            }
            found = 1
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

// contains: 檢查 key 是否存在
str-map.contains = (key str, found i64) {
    dummy str
    .get(key, found, dummy)
}

// remove: 刪除 key
str-map.remove = (key str, removed i64) {
    removed = 0
    .size == 0 -> return

    idx = 0
    .hash(key, idx)

    .occ[idx] == 1: {
        eq = 0
        .str-eq(.keys[idx], key, eq)
        eq == 1 -> {
            .occ[idx] = 0
            .keys[idx].len = 0
            .vals[idx].len = 0
            .size = .size - 1
            removed = 1
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    }
}

// clear: 清空
str-map.clear = () {
    i = 0
    i < .cap: {
        .occ[i] = 0
        .keys[i].len = 0
        .vals[i].len = 0
        i = i + 1
    }
    .size = 0
}

// len: 返回元素數量
str-map.len = (n i64) {
    n = .size
}

// is-empty: 是否為空
str-map.is-empty = (empty i64) {
    empty = .size == 0 ? 1 : 0
}

// for-each: 遍歷所有 (key, value)
str-map.for-each = (k str, v str) {
    i = 0
    i < .cap: {
        .occ[i] == 1 -> {
            k.len = .keys[i].len
            j = 0
            j < k.len: {
                k[j] = .keys[i][j]
                j = j + 1
            }
            v.len = .vals[i].len
            j = 0
            j < v.len: {
                v[j] = .vals[i][j]
                j = j + 1
            }
        }
        i = i + 1
    }
}
