; str-map — str→str 哈希映射表
;
; 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
; 適合小型鍵值對場景（建議 ≤ 192 條）。
;
; 用法：
;   m = str-map{}
;   m.init()
;   m.put('name', 'Alice')
;   val = m.get('name')   // val = ok('Alice') 或 nil
;   m.for-each(k, v)

; FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME = 1099511628211

str-map {
    cap i64
    keys [256]str
    vals [256]str
    occ [256]i64
    size i64
}

; init: 初始化
str-map.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {
        .occ[i] = 0
        .keys[i].len = 0
        .vals[i].len = 0
    }
}

; hash: FNV-1a 字串雜湊
str-map.hash = (key str) (idx i64) {
    h = FNV-OFFSET
    i <- [0..key.len): {
        h = h ^ (key[i] & 255)
        h = h * FNV-PRIME
    }
    idx = h & (.cap - 1)
}

; str-eq: 比較兩個 str 是否相等
str-map.str-eq = (a str, b str) (eq bool) {
    eq = false
    a.len != b.len -> return
    i <- [0..a.len): {
        a[i] != b[i] -> return
    }
    eq = true
}

; put: 插入或更新 key→value，回傳是否新增
str-map.put = (key str, val str) (is-new bool) {
    idx = .hash(key)

    {
        eq = .str-eq(.keys[idx], key)
        eq -> {
            .vals[idx] = val
            .vals[idx].len = val.len
            i <- [0..val.len): {
                .vals[idx][i] = val[i]
            }
            is-new = false
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] == 1)

    ; 複製 key
    .keys[idx].len = key.len
    i <- [0..key.len): {
        .keys[idx][i] = key[i]
    }

    ; 複製 val
    .vals[idx].len = val.len
    i <- [0..val.len): {
        .vals[idx][i] = val[i]
    }
    .occ[idx] = 1
    .size = .size + 1
    is-new = true
}

; get: 查找 key，返回 ?str（nil=未找到）
str-map.get = (key str) (result ?str) {
    .size == 0 -> {
        result = nil
        return
    }

    idx = .hash(key)

    {
        eq = .str-eq(.keys[idx], key)
        eq -> {
            result = .vals[idx]
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] == 1)
    result = nil
}

; contains: 檢查 key 是否存在
str-map.contains = (key str) (found bool) {
    found = false
    val = .get(key)
    val: {
        ok -> found = true
        err -> {}
        nil -> {}
    }
}

; remove: 刪除 key
str-map.remove = (key str) (removed bool) {
    removed = false
    .size == 0 -> return
    idx = .hash(key)

    {
        eq = .str-eq(.keys[idx], key)
        eq -> {
            .occ[idx] = 0
            .keys[idx].len = 0
            .vals[idx].len = 0
            .size = .size - 1
            removed = true
            return
        }
        idx = idx + 1
        idx >= .cap -> idx = 0
    } (.occ[idx] == 1)
}

; clear: 清空
str-map.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i].len = 0
        .vals[i].len = 0
    }
    .size = 0
}

; len: 返回元素數量
str-map.len = () (n i64) {
    n = .size
}

; is-empty: 是否為空
str-map.is-empty = () (empty bool) {
    empty = .size == 0
}

; for-each: 遍歷所有 (key, value)
str-map.for-each = (k str, v str) {
    i <- [0...cap): {
        .occ[i] == 1 -> {
            k = .keys[i]
            v = .vals[i]
        }
    }
}
