// linked-hash-map — i64→i64 有序哈希表
//
// 固定容量（64 條），線性探測，雙向鏈表保持插入順序。
// 容量為 2 的冪，建議裝載因子 ≤ 0.75（即最多 ~48 條）。
//
// 用法：
//   m = linked-hash-map{}
//   m.put(42, 100)
//   val = m.get(42)   // val = ok(100) 或 nil
//   m.for-each(key, val)

linked-hash-map {
    cap i64
    keys [64]i64
    vals [64]i64
    occ [64]i64
    nxt [64]i64
    prv [64]i64
    head i64
    tail i64
    size i64
}

// init: 初始化哈希表
linked-hash-map.init = () {
    .cap = 64
    .head = -1
    .tail = -1
    .size = 0
    i <- [0..64): {
        .occ[i] = 0
        .nxt[i] = -1
        .prv[i] = -1
    }
}

// hash: 計算索引
linked-hash-map.hash = (key i64)(idx i64) {
    idx = key & (.cap - 1)
}

// put: 插入或更新 key→value
linked-hash-map.put = (key i64, val i64)(is-new bool) {
    idx = .hash(key)

    for .occ[idx] == 1 {
        if .keys[idx] == key {
            .vals[idx] = val
            is-new = false
            return
        }
        idx = idx + 1
        if idx >= .cap {
            idx = 0
        }
    }

    .keys[idx] = key
    .vals[idx] = val
    .occ[idx] = 1
    .nxt[idx] = -1
    .prv[idx] = .tail

    if .head == -1 {
        .head = idx
        .tail = idx
    } else {
        .nxt[.tail] = idx
        .tail = idx
    }

    .size = .size + 1
    is-new = true
}

// get: 查找 key，返回 ?i64（nil=未找到）
linked-hash-map.get = (key i64)(result ?i64) {
    if .size == 0 {
        result = nil
        return
    }

    idx = .hash(key)

    for .occ[idx] == 1 {
        if .keys[idx] == key {
            result = .vals[idx]
            return
        }
        idx = idx + 1
        if idx >= .cap {
            idx = 0
        }
    }
    result = nil
}

// contains: 檢查 key 是否存在
linked-hash-map.contains = (key i64)(found bool) {
    found = false
    val = .get(key)
    val: {
        ok -> found = true
    }
}

// remove: 刪除 key
linked-hash-map.remove = (key i64)(removed bool) {
    removed = false
    idx = .hash(key)

    for .occ[idx] == 1 {
        if .keys[idx] == key {
            .occ[idx] = 0
            .size = .size - 1
            prev = .prv[idx]
            next = .nxt[idx]
            if prev == -1 {
                .head = next
            } else {
                .nxt[prev] = next
            }
            if next == -1 {
                .tail = prev
            } else {
                .prv[next] = prev
            }
            removed = true
            return
        }

        idx = idx + 1
        if idx >= .cap {
            idx = 0
        }
    }
}

// clear: 清空
linked-hash-map.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
    }
    .head = -1
    .tail = -1
    .size = 0
}

// len: 返回元素數量
linked-hash-map.len = () (n i64) {
    n = .size
}

// is-empty: 是否為空
linked-hash-map.is-empty = () (empty bool) {
    empty = .size == 0
}

// for-each: 按插入順序遍歷所有 (key, value)
linked-hash-map.for-each = (k i64, v i64) {
    idx = .head
    for idx != -1 {
        if .occ[idx] == 1 {
            k = .keys[idx]
            v = .vals[idx]
        }
        idx = .nxt[idx]
    }
}
