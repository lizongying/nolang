// map — 泛型雜湊映射表
//
// 本檔案提供三個泛型 hashmap 模板，由編譯器針對任意 K/V 組合特化：
//   - hashmap-str-tmpl: str 鍵（#{generic=[V]}）
//   - hashmap-int-tmpl: int 鍵（#{generic=[K,V]}）
//   - hashmap-bool-tmpl: bool 鍵（#{generic=[V]}）
//
// 所有實作均為固定容量、線性探測。
// str/int 模板為 256 槽（建議 ≤ 192 條，裝載因子 ≤ 0.75）。
// bool 模板為 2 槽（true/false 直接索引，無需探測）。
//
// 用法（特化後，例如 V=i64）：
//   m = hashmap-str-tmpl{}
//   m.init()
//   m.put('name', 42, _)
//   m.get('name', found, val)

// FNV-1a 常量
FNV-OFFSET = -3750763034362895579
FNV-PRIME = 1099511628211

HASHMAP-STR-I64-CAP = 256
HASHMAP-I64-I64-CAP = 256
HASHMAP-STR-STR-CAP = 256

// ============================================================
// 1. hashmap-str-tmpl — str 鍵泛型雜湊映射表
// ============================================================

// hashmap-str-tmpl — str 鍵泛型雜湊映射表
//
// 固定容量（256 槽），線性探測，用 FNV-1a 雜湊字串。
// 值型別為泛型 V，由編譯器特化。
//
// 用法（特化後，例如 V=i64）：
//   m = hashmap-str-tmpl{}
//   m.init()
//   m.put('name', 42, _)
//   m.get('name', found, val)

hashmap-str-tmpl {
    cap i64
    keys [256]str
    vals [256]V
    occ [256]i64
    size i64
}

// init: 初始化
hashmap-str-tmpl.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {
        .occ[i] = 0
        .keys[i].len = 0
        .vals[i] = 0
    }
}

// hash: FNV-1a 字串雜湊
hashmap-str-tmpl.hash = (key str, idx i64) {
    h = FNV-OFFSET
    i <- [0..key.len): {
        h = h ^ (key[i] & 255)
        h = h * FNV-PRIME
    }
    idx = h & (.cap - 1)
}

// str-eq: 比較兩個 str 是否相等
hashmap-str-tmpl.str-eq = (a str, b str, eq i64) {
    eq = 0
    a.len != b.len -> {
        return
    }
    i <- [0..a.len): {
        a[i] != b[i] -> {
            return
        }
    }
    eq = 1
}

// put: 插入或更新 key→value，回傳是否新增
hashmap-str-tmpl.put = (key str, val V, is-new i64) {
    idx = 0
    .hash(key, idx)

    for .occ[idx] == 1 {
        eq = 0
        .str-eq(.keys[idx], key, eq)
        eq == 1 -> {
            .vals[idx] = val
            is-new = 0
            return
        }
        idx = idx + 1
        idx >= .cap -> {
            idx = 0
        }
    }

    // 複製 key
    .keys[idx].len = key.len
    i <- [0..key.len): {
        .keys[idx][i] = key[i]
    }
    .vals[idx] = val
    .occ[idx] = 1
    .size = .size + 1
    is-new = 1
}

// get: 查找 key
hashmap-str-tmpl.get = (key str, found i64, result V) {
    found = 0
    .size == 0 -> {
        return
    }

    idx = 0
    .hash(key, idx)

    for .occ[idx] == 1 {
        eq = 0
        .str-eq(.keys[idx], key, eq)
        eq == 1 -> {
            result = .vals[idx]
            found = 1
            return
        }
        idx = idx + 1
        idx >= .cap -> {
            idx = 0
        }
    }
}

// contains: 檢查 key 是否存在
hashmap-str-tmpl.contains = (key str, found i64) {
    dummy V
    .get(key, found, dummy)
}

// remove: 刪除 key
hashmap-str-tmpl.remove = (key str, removed i64) {
    removed = 0
    .size == 0 -> {
        return
    }

    idx = 0
    .hash(key, idx)

    for .occ[idx] == 1 {
        eq = 0
        .str-eq(.keys[idx], key, eq)
        eq == 1 -> {
            .occ[idx] = 0
            .keys[idx].len = 0
            .vals[idx] = 0
            .size = .size - 1
            removed = 1
            return
        }
        idx = idx + 1
        idx >= .cap -> {
            idx = 0
        }
    }
}

// clear: 清空
hashmap-str-tmpl.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i].len = 0
        .vals[i] = 0
    }
    .size = 0
}

// len: 返回元素數量
hashmap-str-tmpl.len = (n i64) {
    n = .size
}

// is-empty: 是否為空
hashmap-str-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

// for-each: 遍歷所有 (key, value)
hashmap-str-tmpl.for-each = (k str, v V) {
    i <- [0...cap): {
        .occ[i] == 1 -> {
            j <- [0...keys[i].len): {
                k[j] = .keys[i][j]
            }
            v = .vals[i]
        }
    }
}

// ============================================================
// 2. hashmap-int-tmpl — int 鍵泛型雜湊映射表
// ============================================================

// hashmap-int-tmpl — int 鍵泛型雜湊映射表
//
// 固定容量（256 槽），線性探測，模數雜湊（位元遮罩）。
// 鍵型別為泛型 K（int），值型別為泛型 V，由編譯器特化。
//
// 用法（特化後，例如 K=i64 且 V=i64）：
//   m = hashmap-int-tmpl{}
//   m.init()
//   m.put(42, 100, _)
//   m.get(42, found, val)

hashmap-int-tmpl {
    cap i64
    keys [256]K
    vals [256]V
    occ [256]i64
    size i64
}

// init: 初始化
hashmap-int-tmpl.init = () {
    .cap = 256
    .size = 0
    i <- [0..256): {
        .occ[i] = 0
        .keys[i] = 0
        .vals[i] = 0
    }
}

// hash: 計算索引（位元遮罩）
hashmap-int-tmpl.hash = (key K, idx i64) {
    idx = key & (.cap - 1)
}

// put: 插入或更新 key→value，回傳是否新增
hashmap-int-tmpl.put = (key K, val V, is-new i64) {
    idx = 0
    .hash(key, idx)

    for .occ[idx] == 1 {
        .keys[idx] == key -> {
            .vals[idx] = val
            is-new = 0
            return
        }
        idx = idx + 1
        idx >= .cap -> {
            idx = 0
        }
    }

    .keys[idx] = key
    .vals[idx] = val
    .occ[idx] = 1
    .size = .size + 1
    is-new = 1
}

// get: 查找 key
hashmap-int-tmpl.get = (key K, found i64, result V) {
    found = 0
    .size == 0 -> {
        return
    }

    idx = 0
    .hash(key, idx)

    for .occ[idx] == 1 {
        .keys[idx] == key -> {
            result = .vals[idx]
            found = 1
            return
        }
        idx = idx + 1
        idx >= .cap -> {
            idx = 0
        }
    }
}

// contains: 檢查 key 是否存在
hashmap-int-tmpl.contains = (key K, found i64) {
    dummy V
    .get(key, found, dummy)
}

// remove: 刪除 key
hashmap-int-tmpl.remove = (key K, removed i64) {
    removed = 0
    .size == 0 -> {
        return
    }

    idx = 0
    .hash(key, idx)

    for .occ[idx] == 1 {
        .keys[idx] == key -> {
            .occ[idx] = 0
            .keys[idx] = 0
            .vals[idx] = 0
            .size = .size - 1
            removed = 1
            return
        }
        idx = idx + 1
        idx >= .cap -> {
            idx = 0
        }
    }
}

// clear: 清空
hashmap-int-tmpl.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i] = 0
        .vals[i] = 0
    }
    .size = 0
}

// len: 返回元素數量
hashmap-int-tmpl.len = (n i64) {
    n = .size
}

// is-empty: 是否為空
hashmap-int-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

// for-each: 遍歷所有 (key, value)
hashmap-int-tmpl.for-each = (k K, v V) {
    i <- [0...cap): {
        .occ[i] == 1 -> {
            k = .keys[i]
            v = .vals[i]
        }
    }
}

// ============================================================
// 3. hashmap-bool-tmpl — bool 鍵泛型雜湊映射表
// ============================================================

// hashmap-bool-tmpl — bool 鍵泛型雜湊映射表
//
// 固定容量（2 槽），true/false 直接索引，無需線性探測。
// 值型別為泛型 V，由編譯器特化。
//
// 用法（特化後，例如 V=i64）：
//   m = hashmap-bool-tmpl{}
//   m.init()
//   m.put(true, 1, _)
//   m.get(true, found, val)

hashmap-bool-tmpl {
    cap i64
    keys [2]bool
    vals [2]V
    occ [2]i64
    size i64
}

// init: 初始化
hashmap-bool-tmpl.init = () {
    .cap = 2
    .size = 0
    i <- [0..2): {
        .occ[i] = 0
        .keys[i] = false
        .vals[i] = 0
    }
}

// hash: 直接索引（true→1，false→0）
hashmap-bool-tmpl.hash = (key bool, idx i64) {
    {
        key == true -> idx = 1
        -> idx = 0
    }
}

// put: 插入或更新 key→value，回傳是否新增
hashmap-bool-tmpl.put = (key bool, val V, is-new i64) {
    idx = 0
    .hash(key, idx)

    .occ[idx] == 1 -> {
        .vals[idx] = val
        is-new = 0
        return
    }

    .keys[idx] = key
    .vals[idx] = val
    .occ[idx] = 1
    .size = .size + 1
    is-new = 1
}

// get: 查找 key
hashmap-bool-tmpl.get = (key bool, found i64, result V) {
    found = 0
    .size == 0 -> {
        return
    }

    idx = 0
    .hash(key, idx)

    .occ[idx] == 1 -> {
        result = .vals[idx]
        found = 1
    }
}

// contains: 檢查 key 是否存在
hashmap-bool-tmpl.contains = (key bool, found i64) {
    dummy V
    .get(key, found, dummy)
}

// remove: 刪除 key
hashmap-bool-tmpl.remove = (key bool, removed i64) {
    removed = 0
    .size == 0 -> {
        return
    }

    idx = 0
    .hash(key, idx)

    .occ[idx] == 1 -> {
        .occ[idx] = 0
        .keys[idx] = false
        .vals[idx] = 0
        .size = .size - 1
        removed = 1
    }
}

// clear: 清空
hashmap-bool-tmpl.clear = () {
    i <- [0...cap): {
        .occ[i] = 0
        .keys[i] = false
        .vals[i] = 0
    }
    .size = 0
}

// len: 返回元素數量
hashmap-bool-tmpl.len = (n i64) {
    n = .size
}

// is-empty: 是否為空
hashmap-bool-tmpl.is-empty = () (empty bool) {
    empty = .size == 0
}

// for-each: 遍歷所有 (key, value)
hashmap-bool-tmpl.for-each = (k bool, v V) {
    i <- [0...cap): {
        .occ[i] == 1 -> {
            k = .keys[i]
            v = .vals[i]
        }
    }
}