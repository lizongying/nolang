// tree-set — 有序集合（基於 AVL 自平衡二元搜尋樹）
//
// i64 的有序集合，使用 AVL 樹實作。
// 所有操作為 O(log n)，元素按升序遍歷。
//
// 與 hash-set 的差異：
// - tree-set 按值排序（升序），hash-set 無序
// - tree-set 支援 lower-bound/upper-bound 有序查詢
// - tree-set 使用 AVL 樹，hash-set 使用哈希表
// - tree-set 的 contains/add/remove 返回 bool option
//
// 用法：
//   s = tree-set{}
//   s.init()
//   ok = s.add(3)             // ok=true（新增）
//   ok = s.add(1)             // ok=true
//   ok = s.add(2)             // ok=true
//   ok = s.add(1)             // ok=false（已存在）
//   yes = s.contains(2)       // yes=true
//   val = s.first()           // val = ok（最小值）
//   val = s.last()            // val = ok（最大值）
//   val = s.lower-bound(2)    // val = ok（第一個 ≥ 2）
//   val = s.upper-bound(2)    // val = ok（第一個 > 2）
//   ok = s.remove(2)          // ok=true
//   s.for-each(v)             // 按升序遍歷所有元素
//
//   // option 解包
//   val = s.lower-bound(42)
//   val: {
//       nil -> print('not found')
//       -> print(it)
//   }

TS-CAP = 64

// tree-set: AVL 有序集合
// root: 樹根節點索引，-1=空樹
// free-head: 空閒節點池頭索引，-1=池已滿
// size: 當前元素數量
// keys: 鍵儲存
// left/right/parent: 樹結構索引，-1=NIL
// height: 節點高度（葉=1，NIL=0）
tree-set {
    root i64
    free-head i64
    size i64
    keys [64]i64
    left [64]i64
    right [64]i64
    parent [64]i64
    height [64]i64
}

// ═══════════════════════════════════════════════
// 初始化
// ═══════════════════════════════════════════════

// init: 初始化空樹與空閒節點池
tree-set.init = () {
    .root = -1
    .free-head = 0
    .size = 0
    i <- [0..TS-CAP - 1): {
        .left[i] = i + 1
    }
    .left[TS-CAP - 1] = -1
}

// ═══════════════════════════════════════════════
// 內部方法：節點池管理
// ═══════════════════════════════════════════════

// alloc-node: 從空閒池分配節點
// 返回 idx i64: 節點索引，-1=池已滿
tree-set.alloc-node = () (idx i64) {
    idx = .free-head
    idx < 0 -> return
    .free-head = .left[idx]
    .left[idx] = -1
    .right[idx] = -1
    .parent[idx] = -1
    .height[idx] = 1
}

// free-node: 將節點歸還空閒池
// idx i64: 要釋放的節點索引
tree-set.free-node = (idx i64) {
    .left[idx] = .free-head
    .free-head = idx
}

// ═══════════════════════════════════════════════
// 內部方法：AVL 高度與平衡
// ═══════════════════════════════════════════════

// ht: 取得節點高度（NIL=0）
// idx i64: 節點索引
// 返回 h i64: 高度
tree-set.ht = (idx i64) (h i64) {
    h = 0
    idx < 0 -> return
    h = .height[idx]
}

// update-ht: 重新計算節點高度
// idx i64: 節點索引
tree-set.update-ht = (idx i64) {
    lh = .ht(.left[idx])
    rh = .ht(.right[idx])
    .height[idx] = (lh > rh ? lh : rh) + 1
}

// bf: 取得平衡因子（左高 - 右高）
// idx i64: 節點索引
// 返回 b i64: 平衡因子
tree-set.bf = (idx i64) (b i64) {
    lh = .ht(.left[idx])
    rh = .ht(.right[idx])
    b = lh - rh
}

// ═══════════════════════════════════════════════
// 內部方法：AVL 旋轉
// ═══════════════════════════════════════════════

// rot-left: 左旋
//     x                y
//    / \              / \
//   a   y     =>     x   c
//      / \          / \
//     b   c        a   b
// x i64: 旋轉軸節點
tree-set.rot-left = (x i64) {
    y = .right[x]
    b = .left[y]
    .right[x] = b
    b >= 0 -> .parent[b] = x
    .left[y] = x
    .parent[y] = .parent[x]
    p = .parent[x]
    {
        p < 0 -> .root = y
        -> {
            .left[p] == x -> .left[p] = y
            -> .right[p] = y
        }
    }
    .parent[x] = y
    .update-ht(x)
    .update-ht(y)
}

// rot-right: 右旋
//       x              y
//      / \            / \
//     y   c   =>     a   x
//    / \                / \
//   a   b              b   c
// x i64: 旋轉軸節點
tree-set.rot-right = (x i64) {
    y = .left[x]
    b = .right[y]
    .left[x] = b
    b >= 0 -> .parent[b] = x
    .right[y] = x
    .parent[y] = .parent[x]
    p = .parent[x]
    {
        p < 0 -> .root = y
        -> {
            .left[p] == x -> .left[p] = y
            -> .right[p] = y
        }
    }
    .parent[x] = y
    .update-ht(x)
    .update-ht(y)
}

// ═══════════════════════════════════════════════
// 內部方法：AVL 再平衡
// ═══════════════════════════════════════════════

// rebalance: 在節點 idx 檢查並修復平衡
// idx i64: 節點索引
// 返回 nr i64: 再平衡後的子樹根索引
tree-set.rebalance = (idx i64) (nr i64) {
    nr = idx
    b = .bf(idx)

    // 左重（b > 1）
    b > 1 -> {
        lb = .bf(.left[idx])
        lb < 0 -> .rot-left(.left[idx])
        .rot-right(idx)
        nr = .parent[idx]
        return
    }

    // 右重（b < -1）
    b < -1 -> {
        rb = .bf(.right[idx])
        rb > 0 -> .rot-right(.right[idx])
        .rot-left(idx)
        nr = .parent[idx]
        return
    }
    .update-ht(idx)
}

// rebalance-up: 從 idx 向上逐層再平衡
// idx i64: 起始節點索引
tree-set.rebalance-up = (idx i64) {
    for idx >= 0 {
        nr = .rebalance(idx)
        idx = .parent[nr]
    }
}

// successor: 求節點的中序後繼
// idx i64: 節點索引
// 返回 succ i64: 後繼索引，-1=無後繼
tree-set.successor = (idx i64) (succ i64) {
    succ = -1
    .right[idx] >= 0 -> {
        succ = .right[idx]
        for .left[succ] >= 0 {
            succ = .left[succ]
        }
        return
    }
    p = .parent[idx]
    for p >= 0 {
        idx != .right[p] -> break
        idx = p
        p = .parent[p]
    }
    succ = p
}

// ═══════════════════════════════════════════════
// 公開 API：增刪查
// ═══════════════════════════════════════════════

// add: 加入元素
// key i64: 要加入的值
// 返回 ok bool: true=新增, false=已存在或池已滿
tree-set.add = (key i64) (ok bool) {
    ok = false

    // 空樹
    .root < 0 -> {
        idx = .alloc-node()
        idx < 0 -> return
        .keys[idx] = key
        .root = idx
        .size = 1
        ok = true
        return
    }

    // BST 搜尋插入點
    cur = .root
    !! {
        key == .keys[cur] -> return
        {
            key < .keys[cur] -> {
                .left[cur] < 0 -> {
                    idx = .alloc-node()
                    idx < 0 -> return
                    .keys[idx] = key
                    .left[cur] = idx
                    .parent[idx] = cur
                    .size = .size + 1
                    ok = true
                    .rebalance-up(cur)
                    return
                }
                cur = .left[cur]
            }
            -> {
                .right[cur] < 0 -> {
                    idx = .alloc-node()
                    idx < 0 -> return
                    .keys[idx] = key
                    .right[cur] = idx
                    .parent[idx] = cur
                    .size = .size + 1
                    ok = true
                    .rebalance-up(cur)
                    return
                }
                cur = .right[cur]
            }
        }
    }
}

// contains: 檢查元素是否存在
// key i64: 要檢查的值
// 返回 yes bool: true=存在, false=不存在
tree-set.contains = (key i64) (yes bool) {
    yes = false
    idx = .root
    for idx >= 0 {
        key == .keys[idx] -> {
            yes = true
            return
        }
        {
            key < .keys[idx] -> idx = .left[idx]
            -> idx = .right[idx]
        }
    }
}

// remove: 刪除元素
// key i64: 要刪除的值
// 返回 ok bool: true=已刪除, false=未找到
tree-set.remove = (key i64) (ok bool) {
    ok = false

    // BST 搜尋
    idx = .root
    for idx >= 0 {
        key == .keys[idx] -> break
        {
            key < .keys[idx] -> idx = .left[idx]
            -> idx = .right[idx]
        }
    }
    idx < 0 -> return
    ok = true
    .size = .size - 1

    // 雙子節點：用後繼替換後刪除後繼
    .left[idx] >= 0 && .right[idx] >= 0 -> {
        succ = .right[idx]
        for .left[succ] >= 0 {
            succ = .left[succ]
        }
        .keys[idx] = .keys[succ]
        idx = succ
    }

    // 此時 idx 最多一個子節點
    child = .left[idx]
    child < 0 -> child = .right[idx]
    p = .parent[idx]
    child >= 0 -> .parent[child] = p
    {
        p < 0 -> .root = child
        -> {
            .left[p] == idx -> .left[p] = child
            -> .right[p] = child
        }
    }
    .free-node(idx)

    // 從父節點向上再平衡
    p >= 0 -> .rebalance-up(p)
}

// ═══════════════════════════════════════════════
// 公開 API：有序操作
// ═══════════════════════════════════════════════

// first: 取得最小值
// 返回 val ?i64: ok=最小值, nil=空集合
tree-set.first = () (val ?i64) {
    idx = .root
    idx < 0 -> {
        val = nil
        return
    }
    for .left[idx] >= 0 {
        idx = .left[idx]
    }
    val = .keys[idx]
}

// last: 取得最大值
// 返回 val ?i64: ok=最大值, nil=空集合
tree-set.last = () (val ?i64) {
    idx = .root
    idx < 0 -> {
        val = nil
        return
    }
    for .right[idx] >= 0 {
        idx = .right[idx]
    }
    val = .keys[idx]
}

// lower-bound: 找第一個 ≥ target 的元素
// target i64: 目標值
// 返回 val ?i64: ok=找到, nil=無此元素
tree-set.lower-bound = (target i64) (val ?i64) {
    result = -1
    idx = .root
    for idx >= 0 {
        {
            .keys[idx] >= target -> {
                result = idx
                idx = .left[idx]
            }
            -> idx = .right[idx]
        }
    }
    result < 0 -> {
        val = nil
        return
    }
    val = .keys[result]
}

// upper-bound: 找第一個 > target 的元素
// target i64: 目標值
// 返回 val ?i64: ok=找到, nil=無此元素
tree-set.upper-bound = (target i64) (val ?i64) {
    result = -1
    idx = .root
    for idx >= 0 {
        {
            .keys[idx] > target -> {
                result = idx
                idx = .left[idx]
            }
            -> idx = .right[idx]
        }
    }
    result < 0 -> {
        val = nil
        return
    }
    val = .keys[result]
}

// for-each: 按升序遍歷所有元素
// val i64: 輸出值（每個元素更新）
tree-set.for-each = (val i64) {
    idx = .root
    idx < 0 -> return

    // 定位到最小值
    for .left[idx] >= 0 {
        idx = .left[idx]
    }

    // 逐個後繼遍歷
    for idx >= 0 {
        val = .keys[idx]
        idx = .successor(idx)
    }
}

// ═══════════════════════════════════════════════
// 公開 API：狀態查詢
// ═══════════════════════════════════════════════

// clear: 清空所有元素，重建空閒池
tree-set.clear = () {
    .root = -1
    .free-head = 0
    .size = 0
    i <- [0..TS-CAP - 1): {
        .left[i] = i + 1
    }
    .left[TS-CAP - 1] = -1
}

// size: 返回元素數量
// 返回 sz i64: 元素數量
tree-set.size = () (sz i64) {
    sz = .size
}

// empty: 判斷是否為空
// 返回 yes bool: true=空, false=非空
tree-set.empty = () (yes bool) {
    yes = .size <= 0
}

// full: 判斷節點池是否已滿
// 返回 yes bool: true=已滿, false=未滿
tree-set.full = () (yes bool) {
    yes = .free-head < 0
}
