; json — JSON 序列化/反序列化
;
; 高級 API：json 結構體封裝節點池，提供直觀的 parse/stringify 介面。
; 底層基於節點池（json-pool）的 JSON 樹狀結構，支援巢狀陣列與物件。
;
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;           found -> print(name)
;       }
;   }
;
;   j2 = new()
;   j2.set('key', 'value')
;   s = j2.stringify()
;

;

;

; ═══════════════════════════════════════════════
; JSON 值類型枚舉
; ═══════════════════════════════════════════════

; json-kind: JSON 值的類型
json-kind {
    null,
    bool,
    num,
    str,
    arr,
    obj,
}

; 池最大節點數
JSON-MAX-NODES = 64

; 每節點最大子元素數
JSON-MAX-CHILDREN = 16

; ═══════════════════════════════════════════════
; 結構
; ═══════════════════════════════════════════════

; json-value: JSON 節點
json-value {
    kind json-kind
    str-val str
    num-val f64
    bool-val bool
    children [16]i64
    keys [16]str
    count i64
}

; json-pool: JSON 節點池
json-pool {
    nodes [64]json-value
    count i64
}

; json: 高級 JSON 值，封裝節點池與根節點索引
; 用法：
;   j = new()                      // 建立 null json
;   j = json.parse('{"a":1}')      // 從字串解析
;   s = j.stringify()              // 序列化為字串
json {
    pool json-pool
    root i64
}

; ═══════════════════════════════════════════════
; 初始化
; ═══════════════════════════════════════════════

; new: 建立一個空的 json 值（null）
; 用法：
;   j = new()
;   j.set('key', 'value')
;   s = j.stringify()
new = () (j json) {
    j = json {
        pool: json-pool {}
        root: -1
    }
    j.pool.init()
}

; new-pool: 建立並初始化一個 json-pool（低級 API）
; 用法：
;   p = new-pool()
;   root, next, ok = p.parse('{"key":"value"}', 0)
new-pool = () (p json-pool) {
    p = json-pool {}
    p.init()
}

; init: 初始化節點池（延遲初始化，不預先清零所有節點）
json-pool.init = () {
    .count = 0
}

; alloc: 分配新節點，返回索引（-1=池滿）
json-pool.alloc = () (idx i64) {
    idx = -1
    .count >= JSON-MAX-NODES -> return
    idx = .count
    .count = .count + 1
    .nodes[idx].count = 0
    .nodes[idx].kind = json-kind.null
    .nodes[idx].str-val.len = 0
    .nodes[idx].num-val = 0.0
    .nodes[idx].bool-val = false
    j <- [0..JSON-MAX-CHILDREN): {
        .nodes[idx].children[j] = -1
        .nodes[idx].keys[j].len = 0
    }
}

; ═══════════════════════════════════════════════
; 剖析
; ═══════════════════════════════════════════════

; parse: 從字串位置 pos 剖析 JSON 值
; 返回 node-idx=根節點索引, next-pos=下一位置, ok=成功
json-pool.parse = (s str, pos i64) (node-idx i64, next-pos i64, ok bool) {
    ok = false
    node-idx = -1
    sn = s.len
    p = pos
    c = 0
    c2 = 0
    cnt = 0
    child-idx = 0
    child-next = 0
    child-ok = false
    key-idx = 0
    key-next = 0
    key-ok = false
    val-idx = 0
    val-next = 0
    val-ok = false

    ; 跳過空白
    {
        c = s[p]
        c != 32 && c != 9 && c != 10 && c != 13 -> break
        p = p + 1
    } (p < sn)
    p >= sn -> return
    c = s[p]

    ; 分配節點
    node-idx = .alloc()
    node-idx < 0 -> return

    ; null
    {
        c == 110 -> {
            .nodes[node-idx].kind = json-kind.null
            next-pos = p + 4
            ok = true
            return
        }
        c == 116 -> {

            ; true

            .nodes[node-idx].kind = json-kind.bool
            .nodes[node-idx].bool-val = true
            next-pos = p + 4
            ok = true
            return
        }
        c == 102 -> {

            ; false

            .nodes[node-idx].kind = json-kind.bool
            .nodes[node-idx].bool-val = false
            next-pos = p + 5
            ok = true
            return
        }
        c == 34 -> {

            ; string

            .nodes[node-idx].kind = json-kind.str
            next-pos, ok = .parse-str(node-idx, s, p)
            return
        }
        c == 45 -> {

            ; number

            .nodes[node-idx].kind = json-kind.num
            next-pos, ok = .parse-num(node-idx, s, p)
            return
        }
        c >= 48 && c <= 57 -> {
            .nodes[node-idx].kind = json-kind.num
            next-pos, ok = .parse-num(node-idx, s, p)
            return
        }
        c == 91 -> {

            ; array

            .nodes[node-idx].kind = json-kind.arr
            .nodes[node-idx].count = 0
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty array
            s[p] == 93 -> {
                next-pos = p + 1
                ok = true
                return
            }

            ; parse elements
            {
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return
                child-idx, child-next, child-ok = .parse(s, p)
                child-ok == false -> return
                cnt = .nodes[node-idx].count
                cnt >= JSON-MAX-CHILDREN -> return
                .nodes[node-idx].children[cnt] = child-idx
                .nodes[node-idx].count = cnt + 1
                p = child-next
                p = .skip-ws(s, p)
                p >= sn -> return
                c2 = s[p]
                c2 == 93 -> {
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> p = p + 1
                    -> return
                }
            } (p < sn)
        }
        c == 123 -> {

            ; object

            .nodes[node-idx].kind = json-kind.obj
            .nodes[node-idx].count = 0
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty object
            s[p] == 125 -> {
                next-pos = p + 1
                ok = true
                return
            }

            ; parse key-value pairs
            {
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return

                ; key must be string
                s[p] != 34 -> return
                key-idx, key-next, key-ok = .parse(s, p)
                key-ok == false -> return
                p = key-next
                p = .skip-ws(s, p)
                p >= sn -> return

                ; expect ':'
                s[p] != 58 -> return
                p = p + 1
                val-idx, val-next, val-ok = .parse(s, p)
                val-ok == false -> return

                ; add to object
                cnt = .nodes[node-idx].count
                cnt >= JSON-MAX-CHILDREN -> return

                ; copy key string to keys[cnt]
                key-len = .nodes[key-idx].str-val.len
                .nodes[node-idx].keys[cnt] = with-cap(key-len)
                j <- [0..key-len): {
                    .nodes[node-idx].keys[cnt][j] = .nodes[key-idx].str-val[j]
                }
                .nodes[node-idx].keys[cnt].len = key-len
                .nodes[node-idx].children[cnt] = val-idx
                .nodes[node-idx].count = cnt + 1
                p = val-next
                p = .skip-ws(s, p)
                p >= sn -> return
                c2 = s[p]
                c2 == 125 -> {
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> p = p + 1
                    -> return
                }
            } (p < sn)
        }
    }
}

; skip-ws: 跳過空白字元
json-pool.skip-ws = (s str, pos i64) (p i64) {
    p <- [pos..s.len): {
        c = s[p]
        c != 32 && c != 9 && c != 10 && c != 13 -> return
    }
}

; parse-str: 解析 JSON 字串（從開引號開始）
json-pool.parse-str = (node-idx i64, s str, pos i64) (next-pos i64, ok bool) {
    ok = false
    i = pos + 1
    j = 0
    c = 0

    ; 預估容量：掃描到閉引號的距離（不超過 s.len - pos）
    est-cap = s.len - pos
    est-cap < 1 -> est-cap = 1
    .nodes[node-idx].str-val = with-cap(est-cap)
    {
        i >= s.len -> return
        c = s[i]
        {
            c == 34 -> {
                .nodes[node-idx].str-val.len = j
                next-pos = i + 1
                ok = true
                return
            }
            c == 92 -> {

                ; 跳過轉義字元

                i = i + 1
                i >= s.len -> return
                c = s[i]

                ; 處理常見轉義
                c == 110 -> c = 10
                c == 116 -> c = 9
                c == 114 -> c = 13
                ; c == 34, 92, 47 保留原樣
            }
        }
        .nodes[node-idx].str-val[j] = c
        j = j + 1
        i = i + 1
    } (i < s.len)
}

; parse-num: 解析 JSON 數字
json-pool.parse-num = (node-idx i64, s str, pos i64) (next-pos i64, ok bool) {
    ok = true
    i = pos
    c = 0
    negative = 0
    .nodes[node-idx].num-val = 0.0

    ; 負號
    s[i] == 45 -> {
        negative = 1
        i = i + 1
    }

    ; 整數部分
    {
        i >= s.len -> break
        c = s[i]
        c < 48 || c > 57 -> break
        .nodes[node-idx].num-val = .nodes[node-idx].num-val * 10.0 + (c - 48)
        i = i + 1
    } (i < s.len)

    ; 小數部分
    i < s.len -> {
        c = s[i]
        c == 46 -> {
            i = i + 1
            frac = 0.1
            {
                i >= s.len -> break
                c = s[i]
                c < 48 || c > 57 -> break
                .nodes[node-idx].num-val = .nodes[node-idx].num-val + frac * (c - 48)
                frac = frac * 0.1
                i = i + 1
            } (i < s.len)
        }
    }

    ; 處理負數
    negative == 1 -> .nodes[node-idx].num-val = 0.0 - .nodes[node-idx].num-val
    next-pos = i
}

; ═══════════════════════════════════════════════
; 物件存取
; ═══════════════════════════════════════════════

; str-eq: 比較兩個 str 是否相等
; 使用 str.eq-full 統一實作
json-pool.str-eq = (a str, b str) (eq i64) {
    a.eq-full(b) -> eq = 1
}

; get-key: 從物件節點取得鍵對應的子節點索引
; 返回 val-idx=子節點索引, ok=找到
json-pool.get-key = (obj-idx i64, key str) (val-idx i64, ok bool) {
    ok = false
    val-idx = -1
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != json-kind.obj -> return
    cnt = .nodes[obj-idx].count
    i <- [0..cnt): {
        found-eq = 0
        found-eq = .str-eq(.nodes[obj-idx].keys[i], key)
        found-eq == 1 -> {
            val-idx = .nodes[obj-idx].children[i]
            ok = true
            return
        }
    }
}

; set-key: 在物件節點設定鍵值
; 返回 ok=成功
json-pool.set-key = (obj-idx i64, key str, val-idx i64) (ok bool) {
    ok = false
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != json-kind.obj -> return

    ; 檢查鍵是否存在（更新）
    cnt = .nodes[obj-idx].count
    i <- [0..cnt): {
        found-eq = 0
        found-eq = .str-eq(.nodes[obj-idx].keys[i], key)
        found-eq == 1 -> {
            .nodes[obj-idx].children[i] = val-idx
            ok = true
            return
        }
    }

    ; 新增鍵
    cnt >= JSON-MAX-CHILDREN -> return

    ; 复制键字符串到 keys[cnt]
    .nodes[obj-idx].keys[cnt] = with-cap(key.len)
    j <- [0..key.len): {
        .nodes[obj-idx].keys[cnt][j] = key[j]
    }
    .nodes[obj-idx].keys[cnt].len = key.len
    .nodes[obj-idx].children[cnt] = val-idx
    .nodes[obj-idx].count = cnt + 1
    ok = true
}

; ═══════════════════════════════════════════════
; 陣列存取
; ═══════════════════════════════════════════════

; arr-get: 從陣列節點取得指定索引的子節點
; 返回 val-idx=子節點索引, ok=成功
json-pool.arr-get = (arr-idx i64, elem i64) (val-idx i64, ok bool) {
    ok = false
    val-idx = -1
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != json-kind.arr -> return
    elem < 0 || elem >= .nodes[arr-idx].count -> return
    val-idx = .nodes[arr-idx].children[elem]
    ok = true
}

; arr-len: 取得陣列長度
json-pool.arr-len = (arr-idx i64) (n i64) {
    n = 0
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != json-kind.arr -> return
    n = .nodes[arr-idx].count
}

; ═══════════════════════════════════════════════
; 標量存取
; ═══════════════════════════════════════════════

; get-kind: 取得節點類型
json-pool.get-kind = (node-idx i64) (kind json-kind) {
    kind = json-kind.null
    node-idx < 0 || node-idx >= .count -> return
    kind = .nodes[node-idx].kind
}

; get-str: 取得字串值
; 返回 out=字串副本, ok=成功
json-pool.get-str = (node-idx i64) (out str, ok bool) {
    ok = false
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != json-kind.str -> return
    out = .nodes[node-idx].str-val.copy()
    ok = true
}

; get-num: 取得數值
json-pool.get-num = (node-idx i64) (val f64, ok bool) {
    ok = false
    val = 0.0
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != json-kind.num -> return
    val = .nodes[node-idx].num-val
    ok = true
}

; get-bool: 取得布林值
; 返回 val=布林值, ok=成功
json-pool.get-bool = (node-idx i64) (val bool, ok bool) {
    ok = false
    val = false
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != json-kind.bool -> return
    val = .nodes[node-idx].bool-val
    ok = true
}

; ═══════════════════════════════════════════════
; 序列化
; ═══════════════════════════════════════════════

; stringify: 將節點序列化為字串
; start=開始寫入位置, 返回 out-n=寫入後位置
json-pool.stringify = (node-idx i64, out str, start i64) (out-n i64) {
    out-n = start
    node-idx < 0 || node-idx >= .count -> return
    kind = .nodes[node-idx].kind
    c = 0
    cnt = 0
    i = 0
    j = 0
    child-n = 0
    num-val f64 = 0.0
    num-str = ''

    {
        kind == json-kind.null -> {
            out[out-n] = 110
            out[out-n + 1] = 117
            out[out-n + 2] = 108
            out[out-n + 3] = 108
            out-n = out-n + 4
            return
        }
        kind == json-kind.bool -> {
            {
                .nodes[node-idx].bool-val -> {
                    out[out-n] = 116
                    out[out-n + 1] = 114
                    out[out-n + 2] = 117
                    out[out-n + 3] = 101
                    out-n = out-n + 4
                }
                -> {
                    out[out-n] = 102
                    out[out-n + 1] = 97
                    out[out-n + 2] = 108
                    out[out-n + 3] = 115
                    out[out-n + 4] = 101
                    out-n = out-n + 5
                }
            }
            return
        }
        kind == json-kind.num -> {
            num-val = .nodes[node-idx].num-val
            num-str = num-val.to-str()
            j <- [0..num-str.len): {
                out[out-n] = num-str[j]
                out-n = out-n + 1
            }
            return
        }
        kind == json-kind.str -> {
            out[out-n] = 34
            out-n = out-n + 1
            j <- [0...nodes[node-idx].str-val.len): {
                c = .nodes[node-idx].str-val[j]

                ; 跳脫特殊字元
                {
                    c == 34 -> {
                        out[out-n] = 92
                        out[out-n + 1] = 34
                        out-n = out-n + 2
                    }
                    -> {
                        c == 92 -> {
                            out[out-n] = 92
                            out[out-n + 1] = 92
                            out-n = out-n + 2
                        }
                        -> {
                            c == 10 -> {
                                out[out-n] = 92
                                out[out-n + 1] = 110
                                out-n = out-n + 2
                            }
                            -> {
                                c == 9 -> {
                                    out[out-n] = 92
                                    out[out-n + 1] = 116
                                    out-n = out-n + 2
                                }
                                -> {
                                    c == 13 -> {
                                        out[out-n] = 92
                                        out[out-n + 1] = 114
                                        out-n = out-n + 2
                                    }
                                    -> {
                                        out[out-n] = c
                                        out-n = out-n + 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
            out[out-n] = 34
            out-n = out-n + 1
            return
        }
        kind == json-kind.arr -> {
            out[out-n] = 91
            out-n = out-n + 1
            cnt = .nodes[node-idx].count
            i <- [0..cnt): {
                i > 0 -> {
                    out[out-n] = 44
                    out-n = out-n + 1
                }
                child-n = 0
                child-n = .stringify(.nodes[node-idx].children[i], out, out-n)
                out-n = child-n
            }
            out[out-n] = 93
            out-n = out-n + 1
            return
        }
        kind == json-kind.obj -> {
            out[out-n] = 123
            out-n = out-n + 1
            cnt = .nodes[node-idx].count
            i <- [0..cnt): {
                i > 0 -> {
                    out[out-n] = 44
                    out-n = out-n + 1
                }

                ; key
                out[out-n] = 34
                out-n = out-n + 1
                j <- [0...nodes[node-idx].keys[i].len): {
                    out[out-n] = .nodes[node-idx].keys[i][j]
                    out-n = out-n + 1
                }
                out[out-n] = 34
                out-n = out-n + 1

                ; ':'
                out[out-n] = 58
                out-n = out-n + 1

                ; value
                child-n = 0
                child-n = .stringify(.nodes[node-idx].children[i], out, out-n)
                out-n = child-n
            }
            out[out-n] = 125
            out-n = out-n + 1
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 高級 API：json 結構體方法
; ═══════════════════════════════════════════════

; json.parse: 從字串解析 JSON，返回 ?json
; 成功返回 ok(json)，失敗返回 err('parse error')
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;       }
;   }
json.parse = (s str) (result ?json) {
    result = nil
    s.len == 0 -> {
        result = err('empty input')
        return
    }

    ; 建立json 並解析
    j json
    j = new()
    root, next, ok = j.pool.parse(s, 0)

    ok == false -> {
        result = err('parse error')
        return
    }

    ; 檢查是否還有未消費的字元（跳過尾部空白）
    p = j.pool.skip-ws(s, next)
    p != s.len -> {
        result = err('trailing characters')
        return
    }
    j.root = root
    result = j
}

; json.stringify: 將 JSON 值序列化為字串
; 返回 out: JSON 字串
; 用法：
;   j = new()
;   s = j.stringify()
json.stringify = () (out str) {
    out = ''
    .root < 0 -> return

    ; 預估容量：每個節點平均 64 位元組（含 key/value/結構開銷）
    cap = .pool.count * 64
    cap < 32 -> cap = 32
    out = with-cap(cap)
    n = .pool.stringify(.root, out, 0)
    out.truncate(n)
}

; json.is-null: 判斷是否為 null
; 返回 yes: 是否為 null
json.is-null = () (yes bool) {
    yes = false
    .root < 0 -> {
        yes = true
        return
    }
    k json-kind = .pool.get-kind(.root)
    yes = k == json-kind.null
}

; json.is-obj: 判斷是否為物件
json.is-obj = () (yes bool) {
    yes = false
    .root < 0 -> return
    k json-kind = .pool.get-kind(.root)
    yes = k == json-kind.obj
}

; json.is-arr: 判斷是否為陣列
json.is-arr = () (yes bool) {
    yes = false
    .root < 0 -> return
    k json-kind = .pool.get-kind(.root)
    yes = k == json-kind.arr
}

; json.is-str: 判斷是否為字串
json.is-str = () (yes bool) {
    yes = false
    .root < 0 -> return
    k json-kind = .pool.get-kind(.root)
    yes = k == json-kind.str
}

; json.is-num: 判斷是否為數字
json.is-num = () (yes bool) {
    yes = false
    .root < 0 -> return
    k json-kind = .pool.get-kind(.root)
    yes = k == json-kind.num
}

; json.is-bool: 判斷是否為布林值
json.is-bool = () (yes bool) {
    yes = false
    .root < 0 -> return
    k json-kind = .pool.get-kind(.root)
    yes = k == json-kind.bool
}

; json.kind: 取得節點類型
; 返回 json-kind 枚舉值
json.kind = () (k json-kind) {
    k = json-kind.null
    .root < 0 -> return
    k = .pool.get-kind(.root)
}

; ═══════════════════════════════════════════════
; 物件操作
; ═══════════════════════════════════════════════

; json.get: 從物件取得子節點作為 json
; 返回 child ?json: ok=找到, nil=未找到或非物件
; 用法：
;   child = j.get('key')
;   child: {
;       ok -> {
;           s, found = it.get-str('sub-key')
;       }
;   }
json.get = (key str) (child ?json) {
    child = nil
    .root < 0 -> return

    ; 確保為物件，若非物件則自動建立
    k json-kind = .pool.get-kind(.root)
    {
        k == json-kind.null -> {

            ; 將 root 轉為空物件
            .pool.nodes[.root].kind = json-kind.obj
            .pool.nodes[.root].count = 0
        }
        k != json-kind.obj -> return
    }
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return

    ; 包裝為 json
    c json
    c = json {
        pool: .pool
        root: val-idx
    }
    child = c
}

; json.get-str: 從物件取得字串值
; 返回 val str, ok bool: ok=找到且為字串
; 用法：
;   s, found = j.get-str('name')
;   found -> print(s)
json.get-str = (key str) (val str, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != json-kind.obj -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-str(val-idx)
}

; json.get-num: 從物件取得數值
; 返回 val f64, ok bool: ok=找到且為數字
json.get-num = (key str) (val f64, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != json-kind.obj -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-num(val-idx)
}

; json.get-bool: 從物件取得布林值
; 返回 val bool, ok bool: ok=找到且為布林值
json.get-bool = (key str) (val bool, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != json-kind.obj -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-bool(val-idx)
}

; json.get-i64: 從物件取得整數值
; 返回 val i64, ok bool: ok=找到且為數字
json.get-i64 = (key str) (val i64, ok bool) {
    ok = false
    f, found = .get-num(key)
    found == false -> return
    val = f
    ok = true
}

; json.set: 在物件中設定鍵值（值為另一個 json 節點）
; 返回 ok bool: 是否成功
json.set = (key str, val json) (ok bool) {
    ok = false
    .root < 0 -> {

        ; 建立 root 為物件
        .root = .pool.alloc()
        .root < 0 -> return
        .pool.nodes[.root].kind = json-kind.obj
        .pool.nodes[.root].count = 0
    }
    k json-kind = .pool.get-kind(.root)
    {
        k == json-kind.null -> {
            .pool.nodes[.root].kind = json-kind.obj
            .pool.nodes[.root].count = 0
        }
        k != json-kind.obj -> return
    }
    ok = .pool.set-key(.root, key, val.root)
}

; json.set-str: 在物件中設定字串值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-str('name', 'Alice')
json.set-str = (key str, val str) (ok bool) {
    ok = false
    idx = .pool.alloc()
    idx < 0 -> return
    .pool.nodes[idx].kind = json-kind.str
    .pool.nodes[idx].str-val = with-cap(val.len)
    i <- [0..val.len): {
        .pool.nodes[idx].str-val[i] = val[i]
    }
    .pool.nodes[idx].str-val.len = val.len

    ok = .set(key, json {
        pool: .pool
        root: idx
    })
}

; json.set-num: 在物件中設定數值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-num('age', 30.0)
json.set-num = (key str, val f64) (ok bool) {
    ok = false
    idx = .pool.alloc()
    idx < 0 -> return
    .pool.nodes[idx].kind = json-kind.num
    .pool.nodes[idx].num-val = val

    ok = .set(key, json {
        pool: .pool
        root: idx
    })
}

; json.set-i64: 在物件中設定整數值
; 返回 ok bool: 是否成功
json.set-i64 = (key str, val i64) (ok bool) {
    f f64 = val
    ok = .set-num(key, f)
}

; json.set-bool: 在物件中設定布林值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-bool('active', true)
json.set-bool = (key str, val bool) (ok bool) {
    ok = false
    idx = .pool.alloc()
    idx < 0 -> return
    .pool.nodes[idx].kind = json-kind.bool
    .pool.nodes[idx].bool-val = val

    ok = .set(key, json {
        pool: .pool
        root: idx
    })
}

; json.set-null: 在物件中設定 null 值
; 返回 ok bool: 是否成功
json.set-null = (key str) (ok bool) {
    ok = false
    idx = .pool.alloc()
    idx < 0 -> return
    .pool.nodes[idx].kind = json-kind.null

    ok = .set(key, json {
        pool: .pool
        root: idx
    })
}

; ═══════════════════════════════════════════════
; 陣列操作
; ═══════════════════════════════════════════════

; json.arr-get: 從陣列取得指定索引的元素作為 json
; 返回 child ?json: ok=找到, nil=未找到或非陣列
; 用法：
;   elem = j.arr-get(0)
;   elem: {
;       ok -> {
;           s, found = it.get-str('name')
;       }
;   }
json.arr-get = (elem i64) (child ?json) {
    child = nil
    .root < 0 -> return
    .pool.get-kind(.root) != json-kind.arr -> return
    val-idx, found = .pool.arr-get(.root, elem)
    found == false -> return
    c json
    c = json {
        pool: .pool
        root: val-idx
    }
    child = c
}

; json.arr-len: 取得陣列長度
; 返回 n: 陣列元素數量（非陣列返回 0）
; 用法：
;   n = j.arr-len()
json.arr-len = () (n i64) {
    n = 0
    .root < 0 -> return
    .pool.get-kind(.root) != json-kind.arr -> return
    n = .pool.arr-len(.root)
}

; json.arr-push: 向陣列末尾添加元素
; 返回 ok bool: 是否成功
; 用法：
;   j.arr-push(item)
json.arr-push = (val json) (ok bool) {
    ok = false
    .root < 0 -> {

        ; 建立 root 為陣列
        .root = .pool.alloc()
        .root < 0 -> return
        .pool.nodes[.root].kind = json-kind.arr
        .pool.nodes[.root].count = 0
    }
    k json-kind = .pool.get-kind(.root)
    {
        k == json-kind.null -> {
            .pool.nodes[.root].kind = json-kind.arr
            .pool.nodes[.root].count = 0
        }
        k != json-kind.arr -> return
    }
    cnt = .pool.nodes[.root].count
    cnt >= JSON-MAX-CHILDREN -> return
    .pool.nodes[.root].children[cnt] = val.root
    .pool.nodes[.root].count = cnt + 1
    ok = true
}

; json.arr-push-str: 向陣列末尾添加字串元素
; 返回 ok bool: 是否成功
json.arr-push-str = (val str) (ok bool) {
    ok = false
    idx = .pool.alloc()
    idx < 0 -> return
    .pool.nodes[idx].kind = json-kind.str
    .pool.nodes[idx].str-val = with-cap(val.len)
    i <- [0..val.len): {
        .pool.nodes[idx].str-val[i] = val[i]
    }
    .pool.nodes[idx].str-val.len = val.len

    ok = .arr-push(json {
        pool: .pool
        root: idx
    })
}

; json.arr-push-num: 向陣列末尾添加數值元素
; 返回 ok bool: 是否成功
json.arr-push-num = (val f64) (ok bool) {
    ok = false
    idx = .pool.alloc()
    idx < 0 -> return
    .pool.nodes[idx].kind = json-kind.num
    .pool.nodes[idx].num-val = val

    ok = .arr-push(json {
        pool: .pool
        root: idx
    })
}

; json.arr-push-bool: 向陣列末尾添加布林元素
; 返回 ok bool: 是否成功
json.arr-push-bool = (val bool) (ok bool) {
    ok = false
    idx = .pool.alloc()
    idx < 0 -> return
    .pool.nodes[idx].kind = json-kind.bool
    .pool.nodes[idx].bool-val = val

    ok = .arr-push(json {
        pool: .pool
        root: idx
    })
}

; ═══════════════════════════════════════════════
; 標量值取得（root 為標量時直接取值）
; ═══════════════════════════════════════════════

; json.str: 取得字串值（當 root 為字串時）
; 返回 val str, ok bool: ok=成功
; 用法：
;   s, found = j.str()
json.str = () (val str, ok bool) {
    val, ok = .pool.get-str(.root)
}

; json.num: 取得數值（當 root 為數字時）
; 返回 val f64, ok bool: ok=成功
json.num = () (val f64, ok bool) {
    val, ok = .pool.get-num(.root)
}

; json.bool: 取得布林值（當 root 為布林值時）
; 返回 val bool, ok bool: ok=成功
json.bool = () (val bool, ok bool) {
    val, ok = .pool.get-bool(.root)
}

; json.i64: 取得整數值（當 root 為數字時）
; 返回 val i64, ok bool: ok=成功
json.i64 = () (val i64, ok bool) {
    ok = false
    f, found = .num()
    found == false -> return
    val = f
    ok = true
}
