; json — JSON 序列化/反序列化
;
; 高級 API：json 結構體封裝節點池，提供直觀的 parse/stringify 介面。
; 底層基於節點池（json-pool）的 JSON 樹狀結構，支援巢狀陣列與物件。
;
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;           found -> print(name)
;       }
;   }
;
;   j2 = new()
;   j2.set('key', 'value')
;   s = j2.stringify()
;

;

;

; ═══════════════════════════════════════════════
; JSON 值類型枚舉
; ═══════════════════════════════════════════════

; json-kind: JSON 值的類型（使用常量替代枚舉，避免編譯器枚舉值不遞增的 bug）
JSON-KIND-NULL = 0
JSON-KIND-BOOL = 1
JSON-KIND-NUM = 2
JSON-KIND-STR = 3
JSON-KIND-ARR = 4
JSON-KIND-OBJ = 5

; json-pool 的調試標記初值。
;
; ⚠️ 這**不是**實例唯一標識，也不能靠它判斷「源池 == 接收者池」：nolang 的
; 模組級綁定不可重綁，函式內寫 `JSON-POOL-NEXT-ID = …` 只會宣告一個同名區域
; 變數並遮蔽全域，全域永遠停在 0。實測多次 init 後每個池的 id 都是 1，而
; copy-tree 曾據此判定「同池」、改走 copy-self，在空的新池上直接返回 -1，
; 使 json.arr-get / json.get 取到的子樹 root 恆為 -1（.str() 恆 nil、
; stringify 崩潰）。跨池複製的池身份問題改由呼叫端保證（見 copy-tree 註釋），
; 自引用場景走 json.set-key 的兩段中轉。
JSON-POOL-NEXT-ID = 0

; ═══════════════════════════════════════════════
; 結構
; ═══════════════════════════════════════════════

; json-value: JSON 節點（純標量欄位，可安全存放於堆 vec）
; kind/num-val/bool-val: 標量值
; count: 陣列/物件的子元素數量
; first/last: 子元素在邊表的單向鏈表首/尾邊索引（-1=無子元素）
json-value {
    kind i64
    num-val f64
    bool-val bool
    count i64
    first i64
    last i64
}

; json-pool: JSON 節點池（堆 vec 配置，無容量上限）
; nodes: 節點平行陣列（以節點 idx 索引，元素為純標量結構）
; strs: 每個節點的字串值（以節點 idx 索引；自舊 str-val 欄位移出，避免 str  residing 於 vec 元素內）
; ec/ek/en: 邊表——子節點 idx、鍵名、下一同級邊 idx（父節點以 first/last 串起鏈表）
json-pool {
    nodes []json-value
    strs []str
    ec []i64
    ek []str
    en []i64
    count i64
    overflowed bool
    id i64
}

; json: 高級 JSON 值，封裝節點池與根節點索引
; 用法：
;   j = new()                      // 建立 null json
;   j = json.parse('{"a":1}')      // 從字串解析
;   s = j.stringify()              // 序列化為字串
; pool 以 #{inline=false} 存放為指標：使 json 可按值回傳/複製，
; 同時讓節點池改用堆 vec（複製時深拷貝池，避免別名與 double-free）。
json {
    pool json-pool #{inline=false}
    root i64
}

; ═══════════════════════════════════════════════
; 初始化
; ═══════════════════════════════════════════════

; 建立一個空的 json 值（null）
; 用法：
;   j = new()
;   j.set('key', 'value')
;   s = j.stringify()
; j: 根節點為 null 的新 json（池已 init，可直接 set/arr-push 建樹）
; [new](#json.new)
new = () (j json) {
    j.root = -1
    j.pool.init()
}

; 建立並初始化一個 json-pool（低級 API）
; 用法：
;   p = new-pool()
;   root, next, ok = p.parse('{"key":"value"}', 0)
; p: 已 init 的空節點池（各堆 vec 長度 0、overflowed=false）
; [new-pool](#json.new-pool)
new-pool = () (p json-pool) {
    p = json-pool {}
    p.init()
}

; 初始化節點池（堆 vec 需在使用前先初始化為非 nil，方能安全 push）
; [init](#json.json-pool.init)
json-pool.init = () {
    .nodes = with-len(0)
    .strs = with-len(0)
    .ec = with-len(0)
    .ek = with-len(0)
    .en = with-len(0)
    .count = 0
    .overflowed = false

    .id = JSON-POOL-NEXT-ID + 1
}

; 分配新節點，返回索引（堆 vec 自動擴容，不再有池滿上限）
; idx: 新節點索引（kind=null、無子節點；堆 vec 自動擴容，不會失敗）
; [alloc](#json.json-pool.alloc)
json-pool.alloc = () (idx i64) {
    idx = .nodes.len()
    v json-value
    v.kind = JSON-KIND-NULL
    v.num-val = 0.0
    v.bool-val = false
    v.count = 0
    v.first = -1
    v.last = -1
    .nodes.push(v)
    .strs.push('')

    #{overflow=wrap}
    .count = .count + 1
}

; 將子節點 child-idx（鍵名 key，陣列傳空字串）附加到節點 node-idx
; 以邊表單向鏈表實作可變長子元素，無每節點上限
; node-idx: 父節點索引（其 first/last 鏈表尾將接上新邊）
; child-idx: 子節點索引
; key: 邊上的鍵名（物件子節點用；陣列傳空字串）
; [add-child](#json.json-pool.add-child)
json-pool.add-child = (node-idx i64, child-idx i64, key str) {
    e = .ec.len()
    .ec.push(child-idx)
    .ek.push(key)
    .en.push(-1)

    ; 串接到父節點鏈表尾端
    last = .nodes[node-idx].last
    last >= 0 -> {
        .en[last] = e
    }
    last < 0 -> {

        .nodes[node-idx].first = e
    }

    .nodes[node-idx].last = e

    cd = .nodes[node-idx].count

    #{overflow=wrap}
    .nodes[node-idx].count = cd + 1
}

; ═══════════════════════════════════════════════
; 剖析
; ═══════════════════════════════════════════════

; 從字串位置 pos 剖析 JSON 值
; 返回 node-idx=根節點索引, next-pos=下一位置, ok=成功
; s: JSON 字串
; pos: 本值起始的位元組位置
; node-idx: 根節點索引（失敗時為 -1）
; next-pos: 值之後下一個位元組位置
; ok: true=解析成功
; [parse](#json.json-pool.parse)
json-pool.parse = (s str, pos i64) (node-idx i64, next-pos i64, ok bool) {
    ok = false
    node-idx = -1
    sn = s.len-bytes()
    p = pos
    c = 0
    c2 = 0
    cnt = 0
    child-idx = 0
    child-next = 0
    child-ok = false
    key-idx = 0
    key-next = 0
    key-ok = false
    val-idx = 0
    val-next = 0
    val-ok = false

    ; 跳過空白
    (p < sn) {

        c = s.byte(p)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        p = p + 1
    }
    p >= sn -> return

    c = s.byte(p)

    ; 分配節點
    node-idx = .alloc()
    node-idx < 0 -> return

    ; null
    {
        c == 110 -> {
            .nodes[node-idx].kind = JSON-KIND-NULL

            #{overflow=wrap}
            next-pos = p + 4
            ok = true
            return
        }

        c == 116 -> {

            ; true
            .nodes[node-idx].kind = JSON-KIND-BOOL

            .nodes[node-idx].bool-val = true

            #{overflow=wrap}
            next-pos = p + 4
            ok = true
            return
        }

        c == 102 -> {

            ; false
            .nodes[node-idx].kind = JSON-KIND-BOOL

            .nodes[node-idx].bool-val = false

            #{overflow=wrap}
            next-pos = p + 5
            ok = true
            return
        }

        c == 34 -> {

            ; string
            .nodes[node-idx].kind = JSON-KIND-STR
            spo = .parse-str(node-idx, s, p)
            spo: {
                ok -> {
                    next-pos = it
                    ok = true
                }

                -> ok = false
            }
            return
        }

        c == 45 -> {

            ; number
            .nodes[node-idx].kind = JSON-KIND-NUM
            npo = .parse-num(node-idx, s, p)
            npo: {
                ok -> {
                    next-pos = it
                    ok = true
                }

                -> ok = false
            }
            return
        }

        c >= 48 && c <= 57 -> {
            .nodes[node-idx].kind = JSON-KIND-NUM
            npo = .parse-num(node-idx, s, p)
            npo: {
                ok -> {
                    next-pos = it
                    ok = true
                }

                -> ok = false
            }
            return
        }

        c == 91 -> {

            ; array
            .nodes[node-idx].kind = JSON-KIND-ARR

            .nodes[node-idx].count = 0

            #{overflow=wrap}
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty array
            s.byte(p) == 93 -> {

                #{overflow=wrap}
                next-pos = p + 1
                ok = true
                return
            }

            ; parse elements
            (p < sn) {
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return
                child-idx, child-next, child-ok = .parse(s, p)
                child-ok == false -> return

                ; 陣列：以邊表附加子元素（鍵名空字串）
                .add-child(node-idx, child-idx, '')
                p = child-next
                p = .skip-ws(s, p)
                p >= sn -> return

                c2 = s.byte(p)
                c2 == 93 -> {

                    #{overflow=wrap}
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> {

                        #{overflow=wrap}
                        p = p + 1
                    }

                    -> return
                }
            }
        }

        c == 123 -> {

            ; object
            .nodes[node-idx].kind = JSON-KIND-OBJ

            .nodes[node-idx].count = 0

            #{overflow=wrap}
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty object
            s.byte(p) == 125 -> {

                #{overflow=wrap}
                next-pos = p + 1
                ok = true
                return
            }

            ; parse key-value pairs
            (p < sn) {
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return

                ; key must be string
                s.byte(p) != 34 -> {

                    return
                }
                key-idx, key-next, key-ok = .parse(s, p)
                key-ok == false -> return
                p = key-next
                p = .skip-ws(s, p)
                p >= sn -> return

                ; expect ':'
                s.byte(p) != 58 -> {

                    return
                }

                #{overflow=wrap}
                p = p + 1
                val-idx, val-next, val-ok = .parse(s, p)
                val-ok == false -> return

                ; 物件：以邊表附加子元素；鍵名取自解析出的 key 節點字串值
                key-str = .strs[key-idx]
                .add-child(node-idx, val-idx, key-str)
                p = val-next
                p = .skip-ws(s, p)
                p >= sn -> return

                c2 = s.byte(p)
                c2 == 125 -> {

                    #{overflow=wrap}
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> {

                        #{overflow=wrap}
                        p = p + 1
                    }

                    -> return
                }
            }
        }
    }
}

; 跳過空白字元
; s: JSON 字串
; pos: 起始位元組位置
; p: 第一個非空白（空格/Tab/LF/CR）字元的位置；全為空白時為字串尾
; [skip-ws](#json.json-pool.skip-ws)
json-pool.skip-ws = (s str, pos i64) (p i64) {
    p <- [pos..s.len-bytes()): {

        c = s.byte(p)
        c != 32 && c != 9 && c != 10 && c != 13 -> return
    }
}

; 解析 JSON 字串（從開引號開始）
; node-idx: 承接字串值的節點索引
; s: JSON 字串
; pos: 起始開引號所在位置
; next-pos: ok=閉合引號之後的位置, nil=引號未閉合或轉義非法
; [parse-str](#json.json-pool.parse-str)
json-pool.parse-str = (node-idx i64, s str, pos i64) (next-pos ?i64) {

    ; D1：`+` 的結果恆為 `?i64`。`i` 在本函式全程是普通游標（`i = i + 1` 多處），
    ; 兩段式 match 解包讓整條鏈回到 plain 算術，也讓 `next-pos = i + 1` 不再被傳染。
    #{overflow=wrap}
    i-opt = pos + 1
    i = 0
    i-opt: {
        ok -> i = it

        -> i = 0
    }
    j = 0
    c = 0

    ; 預估容量：掃描到閉引號的距離（不超過 s.len-bytes() - pos）
    #{overflow=wrap}
    est-cap = s.len-bytes() - pos
    est-cap < 1 -> est-cap = 1

    ; 在本地 str 緩衝逐位元組建構，最後存入 strs[node-idx]
    ; （避免對 vec 元素 str 做鏈式位元組寫入）
    buf str = with-len(est-cap)
    (i < s.len-bytes()) {
        i >= s.len-bytes() -> return

        c = s.byte(i)

        #{overflow=wrap}
        {
            c == 34 -> {

                ; str.truncate 尚未實作，改用 slice-bytes 截斷（est-cap 為預估容量）
                sv = buf.slice-bytes(0, j)

                .strs[node-idx] = sv

                ; D1：`+` 的結果恆為 `?i64`，此處要的是回繞的普通整數 → 兩段式 match 解包。
                #{overflow=wrap}
                next-pos-opt = i + 1
                next-pos = 0
                next-pos-opt: {
                    ok -> next-pos = it

                    -> next-pos = 0
                }
                return
            }

            c == 92 -> {

                ; 跳過轉義字元

                #{overflow=wrap}
                i = i + 1
                i >= s.len-bytes() -> return

                c = s.byte(i)

                ; 處理常見轉義
                c == 110 -> c = 10
                c == 116 -> c = 9
                c == 114 -> c = 13
                ; c == 34, 92, 47 保留原樣
            }
        }
        buf[j]: {
            ok -> it = c

            -> _
        }

        #{overflow=wrap}
        j = j + 1

        #{overflow=wrap}
        i = i + 1
    }
}

; 解析 JSON 數字
; node-idx: 承接數值的節點索引
; s: JSON 字串
; pos: 數字起始位置
; next-pos: ok=數字結束位置（值已寫入節點 num-val）, nil=格式非法
; [parse-num](#json.json-pool.parse-num)
json-pool.parse-num = (node-idx i64, s str, pos i64) (next-pos ?i64) {
    i = pos
    c = 0
    negative = 0

    .nodes[node-idx].num-val = 0.0

    ; 負號
    #{overflow=wrap}
    s.byte(i) == 45 -> {
        negative = 1
        i = i + 1
    }

    ; 整數部分
    (i < s.len-bytes()) {
        i >= s.len-bytes() -> break

        c = s.byte(i)
        c < 48 || c > 57 -> break

        .nodes[node-idx].num-val = .nodes[node-idx].num-val * 10.0 + (c - 48)

        #{overflow=wrap}
        i = i + 1
    }

    ; 小數部分
    #{overflow=wrap}
    i < s.len-bytes() -> {

        c = s.byte(i)
        c == 46 -> {

            #{overflow=wrap}
            i = i + 1
            frac = 0.1
            (i < s.len-bytes()) {
                i >= s.len-bytes() -> break

                c = s.byte(i)
                c < 48 || c > 57 -> break

                .nodes[node-idx].num-val = .nodes[node-idx].num-val + frac * (c - 48)
                frac = frac * 0.1
                i = i + 1
            }
        }
    }

    ; 指數部分（e/E [+/-] digits）
    #{overflow=wrap}
    i < s.len-bytes() -> {

        c = s.byte(i)
        c == 101 || c == 69 -> {

            #{overflow=wrap}
            i = i + 1
            exp-sign = 1
            i < s.len-bytes() -> {

                c = s.byte(i)
                c == 45 -> {

                    #{overflow=wrap}
                    exp-sign = 0 - 1
                    i = i + 1
                }
                c == 43 -> i = i + 1
            }
            exp-val = 0
            (i < s.len-bytes()) {
                i >= s.len-bytes() -> break

                c = s.byte(i)
                c < 48 || c > 57 -> break
                exp-val = exp-val * 10 + (c - 48)
                i = i + 1
            }

            ; 計算 10^exp-val（exp-val 始終為非負值）
            exp-base = 10.0
            exp-r = 1.0
            ev = exp-val
            (ev > 0) {

                #{overflow=wrap}
                ev & 1 == 1 -> exp-r = exp-r * exp-base
                exp-base = exp-base * exp-base
                ev = ev >> 1
            }
            exp-sign < 0 -> {

                .nodes[node-idx].num-val = .nodes[node-idx].num-val / exp-r
            }
            exp-sign >= 0 -> {

                .nodes[node-idx].num-val = .nodes[node-idx].num-val * exp-r
            }
        }
    }

    ; 處理負數
    negative == 1 -> {

        .nodes[node-idx].num-val = 0.0 - .nodes[node-idx].num-val
    }
    next-pos = i
}

; ═══════════════════════════════════════════════
; 物件存取
; ═══════════════════════════════════════════════

; 比較兩個 str 是否相等
; 使用 str.eq-full 統一實作
; a: 待比較字串
; b: 待比較字串
; eq: 1=相等, 0=不相等
; [str-eq](#json.json-pool.str-eq)
json-pool.str-eq = (a str, b str) (eq i64) {
    a.eq-full(b) -> eq = 1
}

; 從物件節點取得鍵對應的子節點索引
; 返回 val-idx=子節點索引, ok=找到
; obj-idx: 物件節點索引
; key: 鍵名
; val-idx: ok=子節點索引, nil=非物件/索引無效/鍵未命中
; [get-key](#json.json-pool.get-key)
json-pool.get-key = (obj-idx i64, key str) (val-idx ?i64) {
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != JSON-KIND-OBJ -> {

        return
    }

    ; 沿邊表單向鏈表走訪子元素，比對鍵名 .ek[e]，命中回傳子節點 .ec[e]
    e = .nodes[obj-idx].first
    (e >= 0) {

        .str-eq(.ek[e], key) == 1 -> {

            val-idx = .ec[e]
            return
        }

        e = .en[e]
    }
}

; 在物件節點設定鍵值
; 返回 ok=成功
; obj-idx: 物件節點索引
; key: 鍵名
; val-idx: 新值節點索引
; ok: true=已更新既有鍵或追加新鍵；false=索引無效或非物件
; [set-key](#json.json-pool.set-key)
json-pool.set-key = (obj-idx i64, key str, val-idx i64) (ok bool) {
    ok = false
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != JSON-KIND-OBJ -> {

        return
    }

    ; 沿邊表走訪，命中既有鍵則更新其子節點索引
    e = .nodes[obj-idx].first
    (e >= 0) {

        .str-eq(.ek[e], key) == 1 -> {

            .ec[e] = val-idx
            ok = true
            return
        }

        e = .en[e]
    }

    ; 未命中：以邊表附加新鍵值（堆 vec 自動擴容，無每節點上限）
    .add-child(obj-idx, val-idx, key)
    ok = true
}

; 將 src 池中 node-idx 為根的整棵子樹深拷貝進接收者池。
; 返回 dst-idx: 新節點索引（-1=失敗）
;
; 前提：接收者池必須與 src **不是同一個池**。src 以 json-pool 值快照傳入，其
; vec 頭與源池共享底層緩衝區；若同一池，遞迴寫入會在 .alloc()/add-child 處擴容
; 共享 vec，使快照 src 的 vec 頭失效（UAF）。
;
; 池身份不能靠 `src.id == .id`：模組級綁定不可重綁（見 JSON-POOL-NEXT-ID 註釋），
; 所有池的 id 恆為 1，這個判定曾把每一次跨池拷貝都誤當成同池，使
; json.arr-get / json.get 返回的子樹 root 恆為 -1。現在改由呼叫端保證：
;   - json-clone-tree：接收者是剛 init 的全新池；
;   - json.set-key：先把 val 拷進臨時新池（json-clone-tree），再從中轉池直拷
;     進接收者，兩次拷貝的兩端都必不同池，自引用也安全。
; src: 來源池（必須與接收者不是同一池，否則共享 vec 緩衝會失效）
; node-idx: 來源池中的子樹根索引
; dst-idx: 接收者池中的新根索引（-1=來源索引無效）
; [copy-tree](#json.json-pool.copy-tree)
json-pool.copy-tree = (src json-pool, node-idx i64) (dst-idx i64) {
    dst-idx = -1
    node-idx < 0 || node-idx >= src.count -> return

    ; 遞迴深拷貝：分配目標節點，複製標量欄位與字串值
    d = .alloc()
    d < 0 -> return
    dst-idx = d

    .nodes[d].kind = src.nodes[node-idx].kind

    .nodes[d].num-val = src.nodes[node-idx].num-val

    .nodes[d].bool-val = src.nodes[node-idx].bool-val

    .strs[d] = src.strs[node-idx].copy()

    ; 遍歷子節點的邊，逐一遞迴拷貝並以同鍵名附加
    e = src.nodes[node-idx].first
    (e >= 0) {

        cs = src.ec[e]

        ck = src.ek[e]
        cd = .copy-tree(src, cs)
        .add-child(d, cd, ck)

        e = src.en[e]
    }
}

; ═══════════════════════════════════════════════
; 陣列存取
; ═══════════════════════════════════════════════

; 從陣列節點取得指定索引的子節點
; 返回 val-idx=子節點索引, ok=成功
; arr-idx: 陣列節點索引
; elem: 元素序號（沿邊鏈走訪第 elem 條邊）
; val-idx: ok=子節點索引, nil=非陣列/索引無效/越界
; [arr-get](#json.json-pool.arr-get)
json-pool.arr-get = (arr-idx i64, elem i64) (val-idx ?i64) {
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != JSON-KIND-ARR -> {

        return
    }
    elem < 0 || elem >= .nodes[arr-idx].count -> {

        return
    }

    ; 沿邊表走訪到第 elem 條邊
    e = .nodes[arr-idx].first
    k <- [0..elem): {

        e = .en[e]
    }

    val-idx = .ec[e]
}

; 取得陣列長度
; arr-idx: 節點索引
; n: 子元素數量（非陣列亦返回其 count；索引無效時為 0）
; [arr-len](#json.json-pool.arr-len)
json-pool.arr-len = (arr-idx i64) (n i64) {
    n = 0
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != JSON-KIND-ARR -> {

        return
    }

    n = .nodes[arr-idx].count
}

; ═══════════════════════════════════════════════
; 標量存取
; ═══════════════════════════════════════════════

; 取得節點類型
; node-idx: 節點索引
; kind: JSON-KIND-* 常量（索引無效時為 NULL）
; [get-kind](#json.json-pool.get-kind)
json-pool.get-kind = (node-idx i64) (kind i64) {
    kind = JSON-KIND-NULL
    node-idx < 0 || node-idx >= .count -> return

    kind = .nodes[node-idx].kind
}

; 取得字串值
; 返回 out=字串副本, ok=成功
; node-idx: 節點索引
; out: ok=字串值的副本, nil=非字串節點或索引無效
; [get-str](#json.json-pool.get-str)
json-pool.get-str = (node-idx i64) (out ?str) {
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-STR -> {

        return
    }

    out = .strs[node-idx].copy()
}

; 取得數值
; node-idx: 節點索引
; val: ok=num-val（整數與小數皆以 f64 存放）, nil=非數字節點
; [get-num](#json.json-pool.get-num)
json-pool.get-num = (node-idx i64) (val ?f64) {
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-NUM -> {

        return
    }

    val = .nodes[node-idx].num-val
}

; 取得布林值
; 返回 val=布林值, ok=成功
; node-idx: 節點索引
; val: ok=bool-val, nil=非布林節點
; [get-bool](#json.json-pool.get-bool)
json-pool.get-bool = (node-idx i64) (val ?bool) {
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-BOOL -> {

        return
    }

    val = .nodes[node-idx].bool-val
}

; ═══════════════════════════════════════════════
; 序列化
; ═══════════════════════════════════════════════

; 將節點序列化為字串
; 返回 out str: 序列化後的字串
; node-idx: 子樹根索引
; out: 序列化後的 JSON 文本（索引無效時為空字串）
; [stringify](#json.json-pool.stringify)
json-pool.stringify = (node-idx i64) (out str) {
    out = ''
    node-idx < 0 || node-idx >= .count -> return

    kind = .nodes[node-idx].kind
    c = 0
    cnt = 0
    i = 0
    j = 0
    e = 0
    is-first = true
    child-str = ''
    num-val = 0.0
    num-str = ''
    key-str = ''
    {
        kind == JSON-KIND-NULL -> {
            out = 'null'
            return
        }

        kind == JSON-KIND-BOOL -> {
            .nodes[node-idx].bool-val -> {

                out = 'true'
            }

            -> out = 'false'
            return
        }

        kind == JSON-KIND-NUM -> {
            num-val = .nodes[node-idx].num-val
            num-str = num-val.to-str()
            out = num-str
            return
        }

        kind == JSON-KIND-STR -> {
            out = '"'

            sv str = .strs[node-idx]
            j = 0
            (j < sv.len-bytes()) {
                j >= sv.len-bytes() -> break

                c = sv[j]
                {
                    c == 34 -> out = out - '\\"'

                    c == 92 -> out = out - '\\\\'

                    c == 10 -> out = out - '\\n'

                    c == 9 -> out = out - '\\t'

                    c == 13 -> out = out - '\\r'

                    -> {
                        jscc char = c
                        out = out - jscc.to-str()
                    }
                }

                #{overflow=wrap}
                j = j + 1
            }
            out = out - '"'
            return
        }

        kind == JSON-KIND-ARR -> {
            out = '['

            e = .nodes[node-idx].first
            is-first = true
            (e >= 0) {
                is-first == false -> out = out - ','
                is-first = false

                child-str = .stringify(.ec[e])
                out = out - child-str

                e = .en[e]
            }
            out = out - ']'
            return
        }

        kind == JSON-KIND-OBJ -> {
            out = '{'

            e = .nodes[node-idx].first
            is-first = true
            (e >= 0) {
                is-first == false -> out = out - ','
                is-first = false

                key-str = .ek[e]
                out = out - '"' - key-str - '":'

                child-str = .stringify(.ec[e])
                out = out - child-str

                e = .en[e]
            }
            out = out - '}'
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 高級 API：json 結構體方法
; ═══════════════════════════════════════════════

; json.parse: 從字串解析 JSON，返回 ?json
; 成功返回 ok(json)，失敗返回 err('parse error')
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;       }
;   }
; 把 src 池中以 idx 為根的子樹深拷貝到一個全新的獨立池，
; 返回持有該子樹根的新 json。供 json.get / json.arr-get / json.get-key 等
; 「取子句柄」介面使用：返回體與源 json 不共享底層 vec 緩衝區。
;
; 為何必需深拷貝：json.pool 是 #{inline=false} 指標欄位，而編譯器的指標欄位
; 拷貝目前尚缺借用語義（見 copy-tree 註釋與 src/mir 的 hybrid-ownership 說明），
; 直接 `child = json { pool: .pool, ... }` 會讓父子各持一份 vec 頭但共享同一
; data 緩衝；一旦任一 handle 觸發 vec realloc，另一 handle 的 vec 頭即指向已
; 釋放的舊緩衝 → 懸垂讀（stringify 返回 null / 資料錯亂）。改為獨立深拷貝後，
; 雙方的 alloc/擴容各寫自有緩衝，互不影響。
; src: 來源池
; idx: 子樹根在 src 中的索引
; out: 持拷貝子樹的新 json（out.root=新根索引；idx 無效時 root=-1）
; [json-clone-tree](#json.json-clone-tree)
json-clone-tree = (src json-pool, idx i64) (out json) {
    out.pool.init()
    out.root = out.pool.copy-tree(src, idx)
}

; 全域函式 — 從 json 物件中按鍵取得子節點
; 返回 child ?json: 子節點（nil 表示不存在）
; obj: 來源 json（僅讀取，不被改動）
; key: 鍵名
; child: ok=獨立深拷貝的子樹句柄（改動它不會影響 obj）, nil=根非物件或鍵未命中
; [get-key](#json.get-key)
json.get-key = (obj json, key str) (child ?json) {
    child = nil
    obj.root < 0 -> return
    k i64 = obj.pool.get-kind(obj.root)
    k != JSON-KIND-OBJ -> return
    gi = obj.pool.get-key(obj.root, key)
    gi: {
        ok -> {

            ; 返回獨立深拷貝子樹（不與 obj 共享 vec 緩衝）
            child = json-clone-tree(obj.pool, it)
        }

        -> child = nil
    }
}

; 解析
; s: 完整 JSON 文本（首尾空白會被跳過）
; result: ok=解析出的 json, err('empty input'/'parse error'/'trailing characters')=各階段失敗
json.parse = (s str) (result ?json) {
    result = nil
    s.len-bytes() == 0 -> {
        result = err('empty input')
        return
    }

    ; 建立json 並解析
    j json
    j = new()
    root, next, ok = j.pool.parse(s, 0)
    ok == false -> {

        ; 池改用堆 vec 自動擴容，不再有容量上限；解析失敗即語法錯誤
        result = err('parse error')
        return
    }

    ; 檢查是否還有未消費的字元（跳過尾部空白）
    p = j.pool.skip-ws(s, next)
    p != s.len-bytes() -> {
        result = err('trailing characters')
        return
    }
    j.root = root
    result = j
}

; 將 JSON 值序列化為字串
; 返回 out: JSON 字串
; 用法：
;   j = new()
;   s = j.stringify()
; out: JSON 文本（root 無效時為空字串）
; [stringify](#json.stringify)
json.stringify = () (out str) {
    out = ''
    .root < 0 -> return
    out = .pool.stringify(.root)
}

; 最近一次操作是否因池容量耗盡而失敗
; 供 set / arr-push 等回傳 bool 的方法在返回 false 後區分「溢出」與「其他失敗」
; 用法：
;   ok = j.set('k', v)
;   ok == false && j.overflowed() -> print('pool full')
; yes: 池溢出標記（堆 vec 版 alloc 不再觸發，幾乎恆為 false）
; [overflowed](#json.overflowed)
json.overflowed = () (yes bool) {
    yes = .pool.overflowed
}

; 判斷是否為 null
; 返回 yes: 是否為 null
; yes: 根節點類型為 JSON-KIND-NULL
; [is-null](#json.is-null)
json.is-null = () (yes bool) {
    yes = false
    .root < 0 -> {
        yes = true
        return
    }
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-NULL
}

; 判斷是否為物件
; yes: 根節點類型為 JSON-KIND-OBJ
; [is-obj](#json.is-obj)
json.is-obj = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-OBJ
}

; 判斷是否為陣列
; yes: 根節點類型為 JSON-KIND-ARR
; [is-arr](#json.is-arr)
json.is-arr = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-ARR
}

; 判斷是否為字串
; yes: 根節點類型為 JSON-KIND-STR
; [is-str](#json.is-str)
json.is-str = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-STR
}

; 判斷是否為數字
; yes: 根節點類型為 JSON-KIND-NUM
; [is-num](#json.is-num)
json.is-num = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-NUM
}

; 判斷是否為布林值
; yes: 根節點類型為 JSON-KIND-BOOL
; [is-bool](#json.is-bool)
json.is-bool = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-BOOL
}

; 取得節點類型
; 返回 JSON kind 常量值
; k: 根節點的 JSON-KIND-* 常量
; [kind](#json.kind)
json.kind = () (k i64) {
    k = JSON-KIND-NULL
    .root < 0 -> return
    k = .pool.get-kind(.root)
}

; ═══════════════════════════════════════════════
; 物件操作
; ═══════════════════════════════════════════════

; 從物件取得子節點作為 json
; child 是 json 自身的子節點（沿用同一節點池，僅 root 指向子節點），
; 不會新建物件；找不到或非物件時回傳 nil。
; 返回 child ?json: ok=找到, nil=未找到或非物件
; 用法：
;   child = j.get('key')
;   child: {
;       ok -> {
;           s, found = it.get-str('sub-key')
;       }
;   }
; key: 鍵名
; [get](#json.get)
json.get = (key str) (child ?json) {
    child = nil
    .root < 0 -> return

    ; 非物件直接回傳 nil（不在這裡把 root 變成新物件）
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    gi = .pool.get-key(.root, key)
    val-idx = -1
    gi: {
        ok -> val-idx = it

        -> val-idx = -1
    }
    val-idx < 0 -> return

    ; 返回獨立深拷貝子樹（不與父共享 vec 緩衝），避免任一 handle 扩容使另一失效
    child = json-clone-tree(.pool, val-idx)
}

; 從物件取得字串值
; 返回 val str, ok bool: ok=找到且為字串
; 用法：
;   s, found = j.get-str('name')
;   found -> print(s)
; key: 鍵名
; val: ok=子節點的字串值, nil=鍵不存在或值非字串
; [get-str](#json.get-str)
json.get-str = (key str) (val ?str) {
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    gi = .pool.get-key(.root, key)
    gi: {
        ok -> val = .pool.get-str(it)

        -> _
    }
}

; 從物件取得數值
; 返回 val f64, ok bool: ok=找到且為數字
; key: 鍵名
; val: ok=子節點數值, nil=鍵不存在或值非數字
; [get-num](#json.get-num)
json.get-num = (key str) (val ?f64) {
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    gi = .pool.get-key(.root, key)
    gi: {
        ok -> val = .pool.get-num(it)

        -> _
    }
}

; 從物件取得布林值
; 返回 val bool, ok bool: ok=找到且為布林值
; key: 鍵名
; val: ok=子節點布林值, nil=鍵不存在或值非布林
; [get-bool](#json.get-bool)
json.get-bool = (key str) (val ?bool) {
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    gi = .pool.get-key(.root, key)
    gi: {
        ok -> val = .pool.get-bool(it)

        -> _
    }
}

; 從物件取得整數值
; 返回 val i64, ok bool: ok=找到且為數字
; key: 鍵名
; val: ok=數值截斷取整（先 .get-num 再 to-i64，不做位元重解）, nil=鍵不存在或值非數字
; [get-i64](#json.get-i64)
json.get-i64 = (key str) (val ?i64) {
    f-opt = .get-num(key)
    f = 0.0
    found = false
    f-opt: {
        ok -> {
            found = true
            f = it
        }

        -> found = false
    }
    found == false -> return

    ; get-num 回傳 f64，直接 `val = f` 會被當成 f64→i64 的裸指派，
    ; codegen 只做位元重解（42.0 -> 4631107791820423168），必須顯式截斷。
    val = f.to-i64()
}

; 分配新節點（pool 為 #{inline=false} 指標欄位，直接委派 .pool.alloc）
; 返回 idx: 新節點索引
; idx: 本池新分配的節點索引
; [alloc-node](#json.alloc-node)
json.alloc-node = () (idx i64) {
    idx = .pool.alloc()
}

; 在物件中設定鍵值（值為另一個 json 節點）
; 返回 ok bool: 是否成功
; key: 鍵名
; val-idx: 值節點索引（須屬本池）
; ok: true=已寫入；false=root 非物件（root 為 null 時原地提升為物件）
; [set](#json.set)
json.set = (key str, val-idx i64) (ok bool) {
    ok = false
    .root < 0 -> {

        ; 建立 root 為物件
        .root = .alloc-node()

        .pool.nodes[.root].kind = JSON-KIND-OBJ
    }

    ; null 節點可原地提升為物件；其他非物件類型拒絕寫入
    k = .pool.get-kind(.root)
    k == JSON-KIND-NULL -> {

        .pool.nodes[.root].kind = JSON-KIND-OBJ
    }
    k != JSON-KIND-NULL && k != JSON-KIND-OBJ -> return

    ; 委派池方法（pool 為指標欄位，嵌套調用安全）
    ok = .pool.set-key(.root, key, val-idx)
}

; 在物件中設定字串值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-str('name', 'Alice')
; key: 鍵名
; val: 字串值
; ok: true=已寫入（同 json.set 的 root 判定）
; [set-str](#json.set-str)
json.set-str = (key str, val str) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-STR

    ; 字串值存於平行 strs vec（以節點 idx 索引），直接指派副本
    .pool.strs[idx] = val.copy()
    ok = .set(key, idx)
}

; 在物件中設定數值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-num('age', 30.0)
; key: 鍵名
; val: 數值（寫入節點 num-val，整數小數皆以 f64 存放）
; ok: true=已寫入
; [set-num](#json.set-num)
json.set-num = (key str, val f64) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    .pool.nodes[idx].kind = JSON-KIND-NUM

    .pool.nodes[idx].num-val = val
    ok = .set(key, idx)
}

; 在物件中設定整數值
; 返回 ok bool: 是否成功
; key: 鍵名
; val: 整數值
; ok: true=已寫入
; [set-i64](#json.set-i64)
json.set-i64 = (key str, val i64) (ok bool) {
    f = val.to-f64()
    ok = .set-num(key, f)
}

; 在物件中設定布林值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-bool('active', true)
; key str: 屬性名，重複時覆寫已有的同名成員
; val bool: 要寫入的布林值（true / false）
; ok bool: true=已掛到物件節點；false=分配節點失敗或掛接失敗
; [set-bool](#json.set-bool)
json.set-bool = (key str, val bool) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    .pool.nodes[idx].kind = JSON-KIND-BOOL

    .pool.nodes[idx].bool-val = val
    ok = .set(key, idx)
}

; 在物件中設定 null 值
; 返回 ok bool: 是否成功
; key: 鍵名
; ok: true=已寫入 null 子節點
; [set-null](#json.set-null)
json.set-null = (key str) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    .pool.nodes[idx].kind = JSON-KIND-NULL
    ok = .set(key, idx)
}

; ═══════════════════════════════════════════════
; 陣列操作
; ═══════════════════════════════════════════════

; 從陣列取得指定索引的元素作為 json
; 返回 child ?json: ok=找到, nil=未找到或非陣列
; 用法：
;   elem = j.arr-get(0)
;   elem: {
;       ok -> {
;           s, found = it.get-str('name')
;       }
;   }
; child: ok=獨立深拷貝的元素子樹句柄, nil=根非陣列或索引越界
; [arr-get](#json.arr-get)
json.arr-get = (elem i64) (child ?json) {
    child = nil
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-ARR -> return
    ai = .pool.arr-get(.root, elem)
    ai: {
        ok -> child = json-clone-tree(.pool, it)

        -> child = nil
    }
}

; 取得陣列長度
; 返回 n: 陣列元素數量（非陣列返回 0）
; 用法：
;   n = j.arr-len()
; n: 根陣列的子元素數量（非陣列為 0）
; [arr-len](#json.arr-len)
json.arr-len = () (n i64) {
    n = 0
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-ARR -> return
    n = .pool.arr-len(.root)
}

; 以節點索引向陣列末尾附加元素（內部輔助，避免構造 json 時深拷貝整個池）
; 返回 ok bool: 是否成功
; child-idx: 值節點索引（須屬本池）
; ok: true=已附加；false=根非陣列或索引無效（不改變 child-idx 指向的節點）
; [arr-push-idx](#json.arr-push-idx)
json.arr-push-idx = (child-idx i64) (ok bool) {
    ok = false
    .root < 0 -> {

        ; 建立 root 為陣列
        .root = .alloc-node()

        .pool.nodes[.root].kind = JSON-KIND-ARR
    }

    ; null 節點可原地提升為陣列；其他非陣列類型拒絕寫入
    k = .pool.get-kind(.root)
    k == JSON-KIND-NULL -> {

        .pool.nodes[.root].kind = JSON-KIND-ARR
    }
    k != JSON-KIND-NULL && k != JSON-KIND-ARR -> return

    ; 以邊表附加子元素（鍵名空字串）
    .pool.add-child(.root, child-idx, '')
    ok = true
}

; 向陣列末尾添加元素
; 返回 ok bool: 是否成功
; 用法：
;   j.arr-push(item)
; val: 元素 json（其根子樹先深拷貝進本池，再以空鍵附加）
; ok: true=已附加
; [arr-push](#json.arr-push)
json.arr-push = (val json) (ok bool) {
    ok = .arr-push-idx(val.root)
}

; 向陣列末尾添加字串元素
; 返回 ok bool: 是否成功
; val: 字串值
; ok: true=已附加為字串元素
; [arr-push-str](#json.arr-push-str)
json.arr-push-str = (val str) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-STR

    ; 字串值存於平行 strs vec
    .pool.strs[idx] = val.copy()
    ok = .arr-push-idx(idx)
}

; 向陣列末尾添加數值元素
; 返回 ok bool: 是否成功
; val: 數值（寫入節點 num-val，整數小數皆以 f64 存放）
; ok: true=已附加為數字元素
; [arr-push-num](#json.arr-push-num)
json.arr-push-num = (val f64) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-NUM

    .pool.nodes[idx].num-val = val
    ok = .arr-push-idx(idx)
}

; 向陣列末尾添加布林元素
; 返回 ok bool: 是否附加成功
; val bool: 要附加的布林值（true / false）
; ok bool: true=已作為布林元素附加到陣列末尾；false=分配節點或 push 失敗
; [arr-push-bool](#json.arr-push-bool)
json.arr-push-bool = (val bool) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-BOOL

    .pool.nodes[idx].bool-val = val
    ok = .arr-push-idx(idx)
}

; ═══════════════════════════════════════════════
; 標量值取得（root 為標量時直接取值）
; ═══════════════════════════════════════════════

; 取得字串值（當 root 為字串時）
; 返回 val str, ok bool: ok=成功
; 用法：
;   s, found = j.str()
; val: ok=根節點字串值（副本）, nil=根非字串
; [str](#json.str)
json.str = () (val ?str) {
    val = .pool.get-str(.root)
}

; 取得數值（當 root 為數字時）
; 返回 val f64, ok bool: ok=成功
; val: ok=根節點數值, nil=根非數字
; [num](#json.num)
json.num = () (val ?f64) {
    val = .pool.get-num(.root)
}

; 取得布林值（當 root 為布林值時）
; 返回 val bool, ok bool: ok=成功
; val: ok=根節點布林值, nil=根非布林
; [bool](#json.bool)
json.bool = () (val ?bool) {
    val = .pool.get-bool(.root)
}

; 取得整數值（當 root 為數字時）
; 返回 val i64, ok bool: ok=成功
; val: ok=根數值截斷取整, nil=根非數字
; [i64](#json.i64)
json.i64 = () (val ?i64) {
    f-opt = .num()
    f = 0.0
    found = false
    f-opt: {
        ok -> {
            found = true
            f = it
        }

        -> found = false
    }
    found == false -> return
    val = f.to-i64()
}

; 取得物件 key 數量
; 返回 n i64: key 數量（非物件返回 0）
; n: 根物件的鍵數量（非物件為 0）
; [obj-len](#json.obj-len)
json.obj-len = () (n i64) {
    n = 0
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    n = .pool.nodes[.root].count
}

; 取得物件指定索引的 key
; 返回 key str: key 字串
; idx: 鍵序號（依插入順序沿邊鏈走訪）
; key: ok=鍵名, nil=越界或根非物件
; [obj-key](#json.obj-key)
json.obj-key = (idx i64) (key ?str) {
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    cnt = .pool.nodes[.root].count
    idx < 0 || idx >= cnt -> return

    ; 沿邊表走訪到第 idx 條邊，取鍵名 .ek[e]
    e = .pool.nodes[.root].first
    t <- [0..idx): {

        e = .pool.en[e]
    }

    key = .pool.ek[e]
}

; 從物件中刪除指定鍵
; 返回 ok bool: ok=成功（鍵存在且已刪除）
; key: 鍵名
; ok: true=命中並已把該邊從鏈表摘除（邊與子節點的佔用空間不回收）；false=根非物件或鍵未命中
; [delete-key](#json.delete-key)
json.delete-key = (key str) (ok bool) {
    ok = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    ; 遍歷邊鏈並記錄前驅；命中則將該邊從單向鏈表摘除
    e = .pool.nodes[.root].first
    prev = -1
    (e >= 0) {

        next i64 = .pool.en[e]

        ek = .pool.ek[e]
        .pool.str-eq(ek, key) == 1 -> {

            ; 前驅改指向 next；若命中邊為首則更新 first
            prev >= 0 -> {

                .pool.en[prev] = next
            }
            prev < 0 -> {

                .pool.nodes[.root].first = next
            }

            ; 若命中邊為尾則更新 last
            last i64 = .pool.nodes[.root].last
            last == e -> {

                .pool.nodes[.root].last = prev
            }

            cnt i64 = .pool.nodes[.root].count

            #{overflow=wrap}
            .pool.nodes[.root].count = cnt - 1
            ok = true
            return
        }
        prev = e
        e = next
    }
}

; 設定物件鍵值（語意糖，接受 json 值作為 val）
; 返回 ok bool: ok=成功
; key: 鍵名
; val: 值 json（先深拷貝進臨時新池再轉拷進本池，故自引用 j.set(k, j) 亦安全）
; ok: true=已寫入；false=val 根索引無效
; [set-key](#json.set-key)
json.set-key = (key str, val json) (ok bool) {
    ok = false
    val.root < 0 || val.root >= val.pool.count -> return
    .root < 0 -> {
        .root = .alloc-node()
        .root < 0 -> return

        .pool.nodes[.root].kind = JSON-KIND-OBJ

        .pool.nodes[.root].count = 0
    }

    ; 深拷貝 val 池中的子樹到接收者池，再掛键（避免跨池悬空索引）。
    ; val 可能就是 . 自己（j.set(k, j) 自引用），所以先經一個全新池中轉：
    ; 兩次 copy-tree 的兩端都必不同池，不依赖池身份判定。
    tmp = json-clone-tree(val.pool, val.root)
    v-idx = .pool.copy-tree(tmp.pool, tmp.root)
    v-idx < 0 -> return
    ok = .pool.set-key(.root, key, v-idx)
}

; 取得物件所有鍵，以換行分隔的字串返回
; 返回 keys str: 所有鍵拼接成的字串
; keys: 各鍵名依序以 \n 結尾拼接的字串（非物件為空字串）
; [obj-keys-str](#json.obj-keys-str)
json.obj-keys-str = () (keys str) {
    keys = ''
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    ; 沿邊表走訪，依序拼接每個鍵名
    e = .pool.nodes[.root].first
    (e >= 0) {

        key = .pool.ek[e]
        keys = keys - key - '\n'

        e = .pool.en[e]
    }
}

; 取得字串節點的值
; 返回 val str: 字串值
; val: 根節點字串值（非字串節點返回空字串）
; [str-val](#json.str-val)
json.str-val = () (val str) {
    v-opt = .pool.get-str(.root)
    v-opt: {
        ok -> val = it

        -> val = ''
    }
}
