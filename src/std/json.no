// json — JSON 序列化/反序列化
//
// 基於節點池（pool）的 JSON 樹狀結構，支援巢狀陣列與物件。
//
// 用法：
//   p = json-pool{}
//   p.init()
//   root, next = p.parse('{"name":"Alice","age":30}', 0)  // next=-1 表示失敗
//   if ok == 1 {
//       val-idx, found = p.get-key(root, 'name')
//       if found == 1 {
//           buf, ok2 = p.get-str(val-idx)
//           if ok2 == 1 {
//               print(buf)
//           }
//       }
//   }

// ═══════════════════════════════════════════════
// JSON 值類型常量
// ═══════════════════════════════════════════════

KIND-NULL = 0
KIND-BOOL = 1
KIND-NUM = 2
KIND-STR = 3
KIND-ARR = 4
KIND-OBJ = 5

// 池最大節點數
JSON-MAX-NODES = 64
// 每節點最大子元素數
JSON-MAX-CHILDREN = 16

// ═══════════════════════════════════════════════
// 結構
// ═══════════════════════════════════════════════

// json-value: JSON 節點
json-value {
    kind i64
    str-val str
    num-val f64
    bool-val i64
    children [16]i64
    keys [16]str
    count i64
}

// json-pool: JSON 節點池
json-pool {
    nodes [64]json-value
    count i64
}

// ═══════════════════════════════════════════════
// 初始化
// ═══════════════════════════════════════════════

// init: 初始化節點池
json-pool.init = () {
    .count = 0
    i = 0
    for i < JSON-MAX-NODES {
        .nodes[i].count = 0
        .nodes[i].kind = KIND-NULL
        // 用空格字串初始化 str-val，使 data buffer 非 null
        .nodes[i].str-val = ' '
        .nodes[i].str-val.len = 0
        .nodes[i].num-val = 0.0
        .nodes[i].bool-val = 0
        j = 0
        for j < JSON-MAX-CHILDREN {
            .nodes[i].children[j] = -1
            // 用空格字串初始化 keys[j]，使 data buffer 非 null
            .nodes[i].keys[j] = ' '
            .nodes[i].keys[j].len = 0
            j = j + 1
        }
        i = i + 1
    }
}

// alloc: 分配新節點，返回索引（-1=池滿）
json-pool.alloc = () (idx i64) {
    idx = -1
    if .count >= JSON-MAX-NODES {
        return
    }
    idx = .count
    .count = .count + 1
    .nodes[idx].count = 0
    .nodes[idx].kind = KIND-NULL
    // 用空格字串初始化 str-val，使 data buffer 非 null
    .nodes[idx].str-val = ' '
    .nodes[idx].str-val.len = 0
    .nodes[idx].num-val = 0.0
    .nodes[idx].bool-val = 0
    j = 0
    for j < JSON-MAX-CHILDREN {
        .nodes[idx].children[j] = -1
        .nodes[idx].keys[j] = ' '
        .nodes[idx].keys[j].len = 0
        j = j + 1
    }
}

// ═══════════════════════════════════════════════
// 剖析
// ═══════════════════════════════════════════════

// parse: 從字串位置 pos 剖析 JSON 值
// 返回 node-idx=根節點索引, next-pos=下一位置, ok=1=成功
json-pool.parse = (s str, pos i64) (node-idx i64, next-pos i64, ok i64) {
    ok = 0
    node-idx = -1
    sn = s.len
    p = pos
    c = 0
    c2 = 0
    cnt = 0
    child-idx = 0
    child-next = 0
    child-ok = 0
    key-idx = 0
    key-next = 0
    key-ok = 0
    val-idx = 0
    val-next = 0
    val-ok = 0

    // 跳過空白
    for p < sn {
        c = s[p] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        p = p + 1
    }
    if p >= sn {
        return
    }
    c = s[p] & 255

    // 分配節點
    node-idx = .alloc()
    if node-idx < 0 {
        return
    }

    // null
    if c == 110 {
        .nodes[node-idx].kind = KIND-NULL
        next-pos = p + 4
        ok = 1
        return
    }

    // true
    if c == 116 {
        .nodes[node-idx].kind = KIND-BOOL
        .nodes[node-idx].bool-val = 1
        next-pos = p + 4
        ok = 1
        return
    }

    // false
    if c == 102 {
        .nodes[node-idx].kind = KIND-BOOL
        .nodes[node-idx].bool-val = 0
        next-pos = p + 5
        ok = 1
        return
    }

    // string
    if c == 34 {
        .nodes[node-idx].kind = KIND-STR
        next-pos, ok = .parse-str(node-idx, s, sn, p)
        return
    }

    // number
    if c == 45 {
        .nodes[node-idx].kind = KIND-NUM
        next-pos, ok = .parse-num(node-idx, s, sn, p)
        return
    }
    if c >= 48 && c <= 57 {
        .nodes[node-idx].kind = KIND-NUM
        next-pos, ok = .parse-num(node-idx, s, sn, p)
        return
    }

    // array
    if c == 91 {
        .nodes[node-idx].kind = KIND-ARR
        .nodes[node-idx].count = 0
        p = p + 1
        p = .skip-ws(s, sn, p)
        if p >= sn {
            return
        }
        // empty array
        if s[p] & 255 == 93 {
            next-pos = p + 1
            ok = 1
            return
        }
        // parse elements
        ! {
            p = .skip-ws(s, sn, p)
            if p >= sn {
                return
            }
            child-idx, child-next, child-ok = .parse(s, p)
            if child-ok == 0 {
                return
            }
            cnt = .nodes[node-idx].count
            if cnt >= JSON-MAX-CHILDREN {
                return
            }
            .nodes[node-idx].children[cnt] = child-idx
            .nodes[node-idx].count = cnt + 1
            p = child-next
            p = .skip-ws(s, sn, p)
            if p >= sn {
                return
            }
            c2 = s[p] & 255
            if c2 == 93 {
                next-pos = p + 1
                ok = 1
                return
            }
            if c2 == 44 {
                p = p + 1
            } else {
                return
            }
        }
    }

    // object
    if c == 123 {
        .nodes[node-idx].kind = KIND-OBJ
        .nodes[node-idx].count = 0
        p = p + 1
        p = .skip-ws(s, sn, p)
        if p >= sn {
            return
        }
        // empty object
        if s[p] & 255 == 125 {
            next-pos = p + 1
            ok = 1
            return
        }
        // parse key-value pairs
        ! {
            p = .skip-ws(s, sn, p)
            if p >= sn {
                return
            }
            // key must be string
            if s[p] & 255 != 34 {
                return
            }
            key-idx, key-next, key-ok = .parse(s, p)
            if key-ok == 0 {
                return
            }
            p = key-next
            p = .skip-ws(s, sn, p)
            if p >= sn {
                return
            }
            // expect ':'
            if s[p] & 255 != 58 {
                return
            }
            p = p + 1
            // parse value
            val-idx, val-next, val-ok = .parse(s, p)
            if val-ok == 0 {
                return
            }
            // add to object
            cnt = .nodes[node-idx].count
            if cnt >= JSON-MAX-CHILDREN {
                return
            }
            // copy key string to keys[cnt]
            key-len = .nodes[key-idx].str-val.len
            .nodes[node-idx].keys[cnt].len = key-len
            j = 0
            for j < key-len {
                .nodes[node-idx].keys[cnt][j] = .nodes[key-idx].str-val[j]
                j = j + 1
            }
            .nodes[node-idx].children[cnt] = val-idx
            .nodes[node-idx].count = cnt + 1
            p = val-next
            p = .skip-ws(s, sn, p)
            if p >= sn {
                return
            }
            c2 = s[p] & 255
            if c2 == 125 {
                next-pos = p + 1
                ok = 1
                return
            }
            if c2 == 44 {
                p = p + 1
            } else {
                return
            }
        }
    }
}

// skip-ws: 跳過空白字元
json-pool.skip-ws = (s str, sn i64, pos i64) (p i64) {
    p = pos
    for p < sn {
        c = s[p] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 {
            return
        }
        p = p + 1
    }
}

// parse-str: 解析 JSON 字串（從開引號開始）
json-pool.parse-str = (node-idx i64, s str, sn i64, pos i64) (next-pos i64, ok i64) {
    ok = 0
    i = pos + 1
    j = 0
    c = 0
    for i < sn {
        c = s[i] & 255
        if c == 34 {
            .nodes[node-idx].str-val.len = j
            next-pos = i + 1
            ok = 1
            return
        }
        // 跳過轉義字元
        if c == 92 {
            i = i + 1
            if i >= sn {
                return
            }
            c = s[i] & 255
            // 處理常見轉義
            if c == 110 {
                c = 10
            }
            if c == 116 {
                c = 9
            }
            if c == 114 {
                c = 13
            }
            // c == 34, 92, 47 保留原樣
        }
        .nodes[node-idx].str-val[j] = c
        j = j + 1
        i = i + 1
    }
}

// parse-num: 解析 JSON 數字
json-pool.parse-num = (node-idx i64, s str, sn i64, pos i64) (next-pos i64, ok i64) {
    ok = 1
    i = pos
    c = 0
    negative = 0
    .nodes[node-idx].num-val = 0.0

    // 負號
    if s[i] & 255 == 45 {
        negative = 1
        i = i + 1
    }

    // 整數部分
    for i < sn {
        c = s[i] & 255
        if c < 48 || c > 57 {
            break
        }
        .nodes[node-idx].num-val = .nodes[node-idx].num-val * 10.0 + (c - 48)
        i = i + 1
    }

    // 小數部分
    if i < sn {
        c = s[i] & 255
        if c == 46 {
            i = i + 1
            frac = 0.1
            for i < sn {
                c = s[i] & 255
                if c < 48 || c > 57 {
                    break
                }
                .nodes[node-idx].num-val = .nodes[node-idx].num-val + frac * (c - 48)
                frac = frac * 0.1
                i = i + 1
            }
        }
    }

    // 處理負數
    if negative == 1 {
        .nodes[node-idx].num-val = 0.0 - .nodes[node-idx].num-val
    }
    next-pos = i
}

// ═══════════════════════════════════════════════
// 物件存取
// ═══════════════════════════════════════════════

// str-eq: 比較兩個 str 是否相等
json-pool.str-eq = (a str, b str) (eq i64) {
    eq = 0
    if a.len != b.len {
        return
    }
    i = 0
    for i < a.len {
        if a[i] != b[i] {
            return
        }
        i = i + 1
    }
    eq = 1
}

// get-key: 從物件節點取得鍵對應的子節點索引
// 返回 val-idx=子節點索引, ok=1=找到
json-pool.get-key = (obj-idx i64, key str) (val-idx i64, ok i64) {
    ok = 0
    val-idx = -1
    if obj-idx < 0 || obj-idx >= .count {
        return
    }
    if .nodes[obj-idx].kind != KIND-OBJ {
        return
    }
    cnt = .nodes[obj-idx].count
    i = 0
    for i < cnt {
        found-eq = 0
        found-eq = .str-eq(.nodes[obj-idx].keys[i], key)
        if found-eq == 1 {
            val-idx = .nodes[obj-idx].children[i]
            ok = 1
            return
        }
        i = i + 1
    }
}

// set-key: 在物件節點設定鍵值
// 返回 ok=1=成功
json-pool.set-key = (obj-idx i64, key str, val-idx i64) (ok i64) {
    ok = 0
    if obj-idx < 0 || obj-idx >= .count {
        return
    }
    if .nodes[obj-idx].kind != KIND-OBJ {
        return
    }
    // 檢查鍵是否存在（更新）
    cnt = .nodes[obj-idx].count
    i = 0
    for i < cnt {
        found-eq = 0
        found-eq = .str-eq(.nodes[obj-idx].keys[i], key)
        if found-eq == 1 {
            .nodes[obj-idx].children[i] = val-idx
            ok = 1
            return
        }
        i = i + 1
    }
    // 新增鍵
    if cnt >= JSON-MAX-CHILDREN {
        return
    }
    // 复制键字符串到 keys[cnt]
    .nodes[obj-idx].keys[cnt].len = key.len
    j = 0
    for j < key.len {
        .nodes[obj-idx].keys[cnt][j] = key[j]
        j = j + 1
    }
    .nodes[obj-idx].children[cnt] = val-idx
    .nodes[obj-idx].count = cnt + 1
    ok = 1
}

// ═══════════════════════════════════════════════
// 陣列存取
// ═══════════════════════════════════════════════

// arr-get: 從陣列節點取得指定索引的子節點
// 返回 val-idx=子節點索引, ok=1=成功
json-pool.arr-get = (arr-idx i64, elem i64) (val-idx i64, ok i64) {
    ok = 0
    val-idx = -1
    if arr-idx < 0 || arr-idx >= .count {
        return
    }
    if .nodes[arr-idx].kind != KIND-ARR {
        return
    }
    if elem < 0 || elem >= .nodes[arr-idx].count {
        return
    }
    val-idx = .nodes[arr-idx].children[elem]
    ok = 1
}

// arr-len: 取得陣列長度
json-pool.arr-len = (arr-idx i64) (n i64) {
    n = 0
    if arr-idx < 0 || arr-idx >= .count {
        return
    }
    if .nodes[arr-idx].kind != KIND-ARR {
        return
    }
    n = .nodes[arr-idx].count
}

// ═══════════════════════════════════════════════
// 標量存取
// ═══════════════════════════════════════════════

// get-kind: 取得節點類型
json-pool.get-kind = (node-idx i64) (kind i64) {
    kind = KIND-NULL
    if node-idx < 0 || node-idx >= .count {
        return
    }
    kind = .nodes[node-idx].kind
}

// get-str: 取得字串值
// 返回 out=字串副本, ok=1=成功
json-pool.get-str = (node-idx i64) (out str, ok i64) {
    ok = 0
    if node-idx < 0 || node-idx >= .count {
        return
    }
    if .nodes[node-idx].kind != KIND-STR {
        return
    }
    out = .nodes[node-idx].str-val
    ok = 1
}

// get-num: 取得數值
json-pool.get-num = (node-idx i64) (val f64, ok i64) {
    ok = 0
    val = 0.0
    if node-idx < 0 || node-idx >= .count {
        return
    }
    if .nodes[node-idx].kind != KIND-NUM {
        return
    }
    val = .nodes[node-idx].num-val
    ok = 1
}

// get-bool: 取得布林值
// 返回 val=1=true/0=false, ok=1=成功
json-pool.get-bool = (node-idx i64) (val i64, ok i64) {
    ok = 0
    val = 0
    if node-idx < 0 || node-idx >= .count {
        return
    }
    if .nodes[node-idx].kind != KIND-BOOL {
        return
    }
    val = .nodes[node-idx].bool-val
    ok = 1
}

// ═══════════════════════════════════════════════
// 序列化
// ═══════════════════════════════════════════════

// stringify: 將節點序列化為字串
// start=開始寫入位置, 返回 out-n=寫入後位置
json-pool.stringify = (node-idx i64, out str, start i64) (out-n i64) {
    out-n = start
    if node-idx < 0 || node-idx >= .count {
        return
    }
    kind = .nodes[node-idx].kind
    c = 0
    cnt = 0
    i = 0
    j = 0
    child-n = 0
    num-val f64 = 0.0
    num-str = ''

    if kind == KIND-NULL {
        out[out-n] = 110
        out[out-n + 1] = 117
        out[out-n + 2] = 108
        out[out-n + 3] = 108
        out-n = out-n + 4
        return
    }
    if kind == KIND-BOOL {
        if .nodes[node-idx].bool-val == 1 {
            out[out-n] = 116
            out[out-n + 1] = 114
            out[out-n + 2] = 117
            out[out-n + 3] = 101
            out-n = out-n + 4
        } else {
            out[out-n] = 102
            out[out-n + 1] = 97
            out[out-n + 2] = 108
            out[out-n + 3] = 115
            out[out-n + 4] = 101
            out-n = out-n + 5
        }
        return
    }
    if kind == KIND-NUM {
        num-val = .nodes[node-idx].num-val
        num-str = num-val.to-str()
        j = 0
        for j < num-str.len {
            out[out-n] = num-str[j]
            out-n = out-n + 1
            j = j + 1
        }
        return
    }
    if kind == KIND-STR {
        out[out-n] = 34
        out-n = out-n + 1
        j = 0
        for j < .nodes[node-idx].str-val.len {
            c = .nodes[node-idx].str-val[j] & 255
            // 跳脫特殊字元
            if c == 34 {
                out[out-n] = 92
                out[out-n + 1] = 34
                out-n = out-n + 2
            } else {
                if c == 92 {
                    out[out-n] = 92
                    out[out-n + 1] = 92
                    out-n = out-n + 2
                } else {
                    if c == 10 {
                        out[out-n] = 92
                        out[out-n + 1] = 110
                        out-n = out-n + 2
                    } else {
                        if c == 9 {
                            out[out-n] = 92
                            out[out-n + 1] = 116
                            out-n = out-n + 2
                        } else {
                            if c == 13 {
                                out[out-n] = 92
                                out[out-n + 1] = 114
                                out-n = out-n + 2
                            } else {
                                out[out-n] = c
                                out-n = out-n + 1
                            }
                        }
                    }
                }
            }
            j = j + 1
        }
        out[out-n] = 34
        out-n = out-n + 1
        return
    }
    if kind == KIND-ARR {
        out[out-n] = 91
        out-n = out-n + 1
        cnt = .nodes[node-idx].count
        i = 0
        for i < cnt {
            if i > 0 {
                out[out-n] = 44
                out-n = out-n + 1
            }
            child-n = 0
            child-n = .stringify(.nodes[node-idx].children[i], out, out-n)
            out-n = child-n
            i = i + 1
        }
        out[out-n] = 93
        out-n = out-n + 1
        return
    }
    if kind == KIND-OBJ {
        out[out-n] = 123
        out-n = out-n + 1
        cnt = .nodes[node-idx].count
        i = 0
        for i < cnt {
            if i > 0 {
                out[out-n] = 44
                out-n = out-n + 1
            }
            // key
            out[out-n] = 34
            out-n = out-n + 1
            j = 0
            for j < .nodes[node-idx].keys[i].len {
                out[out-n] = .nodes[node-idx].keys[i][j]
                out-n = out-n + 1
                j = j + 1
            }
            out[out-n] = 34
            out-n = out-n + 1
            // ':'
            out[out-n] = 58
            out-n = out-n + 1
            // value
            child-n = 0
            child-n = .stringify(.nodes[node-idx].children[i], out, out-n)
            out-n = child-n
            i = i + 1
        }
        out[out-n] = 125
        out-n = out-n + 1
        return
    }
}
