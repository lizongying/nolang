; json — JSON 序列化/反序列化
;
; 高級 API：json 結構體封裝節點池，提供直觀的 parse/stringify 介面。
; 底層基於節點池（json-pool）的 JSON 樹狀結構，支援巢狀陣列與物件。
;
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;           found -> print(name)
;       }
;   }
;
;   j2 = new()
;   j2.set('key', 'value')
;   s = j2.stringify()
;

;

;

; ═══════════════════════════════════════════════
; JSON 值類型枚舉
; ═══════════════════════════════════════════════

; json-kind: JSON 值的類型（使用常量替代枚舉，避免編譯器枚舉值不遞增的 bug）
JSON-KIND-NULL i64 = 0
JSON-KIND-BOOL i64 = 1
JSON-KIND-NUM i64 = 2
JSON-KIND-STR i64 = 3
JSON-KIND-ARR i64 = 4
JSON-KIND-OBJ i64 = 5

; 池最大節點數
JSON-MAX-NODES = 64

; 每節點最大子元素數
JSON-MAX-CHILDREN = 16

; ═══════════════════════════════════════════════
; 結構
; ═══════════════════════════════════════════════

; json-value: JSON 節點
json-value {
    kind i64
    str-val str
    num-val f64
    bool-val bool
    children [16]i64
    keys [16]str
    count i64
}

; json-pool: JSON 節點池
json-pool {
    nodes [64]json-value
    count i64
}

; json: 高級 JSON 值，封裝節點池與根節點索引
; 用法：
;   j = new()                      // 建立 null json
;   j = json.parse('{"a":1}')      // 從字串解析
;   s = j.stringify()              // 序列化為字串
json {
    pool json-pool
    root i64
}

; ═══════════════════════════════════════════════
; 初始化
; ═══════════════════════════════════════════════

; new: 建立一個空的 json 值（null）
; 用法：
;   j = new()
;   j.set('key', 'value')
;   s = j.stringify()
new = () (j json) {
    j = json {
        pool: json-pool {}
        root: -1
    }
    j.pool.init()
}

; new-pool: 建立並初始化一個 json-pool（低級 API）
; 用法：
;   p = new-pool()
;   root, next, ok = p.parse('{"key":"value"}', 0)
new-pool = () (p json-pool) {
    p = json-pool {}
    p.init()
}

; init: 初始化節點池（延遲初始化，不預先清零所有節點）
json-pool.init = () {
    .count = 0
}

; alloc: 分配新節點，返回索引（-1=池滿）
json-pool.alloc = () (idx i64) {

    #{overflow=wrap}
    idx = -1
    .count >= JSON-MAX-NODES -> return
    idx = .count

    #{overflow=wrap}
    .count = .count + 1

    #{index-out=0}
    .nodes[idx].count = 0

    #{index-out=0}
    .nodes[idx].kind = JSON-KIND-NULL

    #{index-out=0}
    .nodes[idx].str-val = ''

    #{index-out=0}
    .nodes[idx].num-val = 0.0

    #{index-out=0}
    .nodes[idx].bool-val = false
    j <- [0..JSON-MAX-CHILDREN): {

        #{index-out=0, overflow=wrap}
        .nodes[idx].children[j] = -1

        #{index-out=0}
        .nodes[idx].keys[j] = ''
    }
}

; ═══════════════════════════════════════════════
; 剖析
; ═══════════════════════════════════════════════

; parse: 從字串位置 pos 剖析 JSON 值
; 返回 node-idx=根節點索引, next-pos=下一位置, ok=成功
json-pool.parse = (s str, pos i64) (node-idx i64, next-pos i64, ok bool) {
    ok = false
    node-idx = -1
    sn = s.len-bytes()
    p = pos
    c = 0
    c2 = 0
    cnt = 0
    child-idx = 0
    child-next = 0
    child-ok = false
    key-idx = 0
    key-next = 0
    key-ok = false
    val-idx = 0
    val-next = 0
    val-ok = false

    ; 跳過空白
    (p < sn) {

        #{index-out=0, overflow=wrap}
        c = s[p]
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        p = p + 1
    }
    p >= sn -> return

    #{index-out=0}
    c = s[p]

    ; 分配節點
    node-idx = .alloc()
    node-idx < 0 -> return

    ; null
    {
        c == 110 -> {

            #{index-out=0, overflow=wrap}
            .nodes[node-idx].kind = JSON-KIND-NULL

            #{overflow=wrap}
            next-pos = p + 4
            ok = true
            return
        }

        c == 116 -> {

            ; true

            #{index-out=0, overflow=wrap}
            .nodes[node-idx].kind = JSON-KIND-BOOL

            #{index-out=0}
            .nodes[node-idx].bool-val = true

            #{overflow=wrap}
            next-pos = p + 4
            ok = true
            return
        }

        c == 102 -> {

            ; false

            #{index-out=0, overflow=wrap}
            .nodes[node-idx].kind = JSON-KIND-BOOL

            #{index-out=0}
            .nodes[node-idx].bool-val = false

            #{overflow=wrap}
            next-pos = p + 5
            ok = true
            return
        }

        c == 34 -> {

            ; string

            #{index-out=0}
            .nodes[node-idx].kind = JSON-KIND-STR
            next-pos, ok = .parse-str(node-idx, s, p)
            return
        }

        c == 45 -> {

            ; number

            #{index-out=0}
            .nodes[node-idx].kind = JSON-KIND-NUM
            next-pos, ok = .parse-num(node-idx, s, p)
            return
        }

        c >= 48 && c <= 57 -> {

            #{index-out=0}
            .nodes[node-idx].kind = JSON-KIND-NUM
            next-pos, ok = .parse-num(node-idx, s, p)
            return
        }

        c == 91 -> {

            ; array

            #{index-out=0, overflow=wrap}
            .nodes[node-idx].kind = JSON-KIND-ARR

            #{index-out=0}
            .nodes[node-idx].count = 0

            #{overflow=wrap}
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty array
            s[p] == 93 -> {

                #{overflow=wrap}
                next-pos = p + 1
                ok = true
                return
            }

            ; parse elements
            (p < sn) {

                #{overflow=wrap}
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return
                child-idx, child-next, child-ok = .parse(s, p)
                child-ok == false -> return

                #{index-out=0}
                cnt = .nodes[node-idx].count
                cnt >= JSON-MAX-CHILDREN -> return

                #{index-out=0}
                .nodes[node-idx].children[cnt] = child-idx

                #{index-out=0, overflow=wrap}
                .nodes[node-idx].count = cnt + 1
                p = child-next
                p = .skip-ws(s, p)
                p >= sn -> return

                #{index-out=0}
                c2 = s[p]
                c2 == 93 -> {

                    #{overflow=wrap}
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> {

                        #{overflow=wrap}
                        p = p + 1
                    }

                    -> return
                }
            }
        }

        c == 123 -> {

            ; object

            #{index-out=0, overflow=wrap}
            .nodes[node-idx].kind = JSON-KIND-OBJ

            #{index-out=0}
            .nodes[node-idx].count = 0

            #{overflow=wrap}
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty object
            s[p] == 125 -> {

                #{overflow=wrap}
                next-pos = p + 1
                ok = true
                return
            }

            ; parse key-value pairs
            (p < sn) {

                #{overflow=wrap}
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return

                ; key must be string
                s[p] != 34 -> {

                    #{index-out=0}
                    return
                }
                key-idx, key-next, key-ok = .parse(s, p)
                key-ok == false -> return
                p = key-next
                p = .skip-ws(s, p)
                p >= sn -> return

                ; expect ':'
                s[p] != 58 -> {

                    #{index-out=0}
                    return
                }

                #{overflow=wrap}
                p = p + 1
                val-idx, val-next, val-ok = .parse(s, p)
                val-ok == false -> return

                ; add to object
                #{index-out=0}
                cnt = .nodes[node-idx].count
                cnt >= JSON-MAX-CHILDREN -> return

                ; copy key string to keys[cnt]
                #{index-out=0, index-out=0}
                key-len = .nodes[key-idx].str-val.len-bytes()

                #{index-out=0}
                .nodes[node-idx].keys[cnt] = with-len(key-len)
                j <- [0..key-len): {

                    #{index-out=0, overflow=wrap}
                    .nodes[node-idx].keys[cnt][j] = .nodes[key-idx].str-val[j]
                }

                ; (length preset by with-len(key-len) above)
                #{index-out=0}
                .nodes[node-idx].children[cnt] = val-idx

                #{index-out=0, overflow=wrap}
                .nodes[node-idx].count = cnt + 1
                p = val-next
                p = .skip-ws(s, p)
                p >= sn -> return

                #{index-out=0}
                c2 = s[p]
                c2 == 125 -> {

                    #{overflow=wrap}
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> {

                        #{overflow=wrap}
                        p = p + 1
                    }

                    -> return
                }
            }
        }
    }
}

; skip-ws: 跳過空白字元
json-pool.skip-ws = (s str, pos i64) (p i64) {
    p <- [pos..s.len-bytes()): {

        #{index-out=0}
        c = s[p]
        c != 32 && c != 9 && c != 10 && c != 13 -> return
    }
}

; parse-str: 解析 JSON 字串（從開引號開始）
json-pool.parse-str = (node-idx i64, s str, pos i64) (next-pos i64, ok bool) {

    #{overflow=wrap}
    ok = false

    #{overflow=wrap}
    i = pos + 1
    j = 0
    c = 0

    ; 預估容量：掃描到閉引號的距離（不超過 s.len-bytes() - pos）
    #{overflow=wrap}
    est-cap = s.len-bytes() - pos
    est-cap < 1 -> est-cap = 1

    #{index-out=0}
    .nodes[node-idx].str-val = with-len(est-cap)
    (i < s.len-bytes()) {

        #{overflow=wrap}
        i >= s.len-bytes() -> return

        #{index-out=0}
        c = s[i]

        #{overflow=wrap}
        {
            c == 34 -> {

                ; str.truncate 尚未實作，改用 slice-bytes 截斷（est-cap 為預估容量）
                #{index-out=0, overflow=wrap}
                sv str = .nodes[node-idx].str-val.slice-bytes(0, j)

                #{index-out=0}
                .nodes[node-idx].str-val = sv

                #{overflow=wrap}
                next-pos = i + 1
                ok = true
                return
            }

            c == 92 -> {

                ; 跳過轉義字元

                #{overflow=wrap}
                i = i + 1
                i >= s.len-bytes() -> return

                #{index-out=0}
                c = s[i]

                ; 處理常見轉義
                c == 110 -> c = 10
                c == 116 -> c = 9
                c == 114 -> c = 13
                ; c == 34, 92, 47 保留原樣
            }
        }

        #{index-out=0}
        .nodes[node-idx].str-val[j] = c

        #{overflow=wrap}
        j = j + 1

        #{overflow=wrap}
        i = i + 1
    }
}

; parse-num: 解析 JSON 數字
json-pool.parse-num = (node-idx i64, s str, pos i64) (next-pos i64, ok bool) {

    #{overflow=wrap}
    ok = true
    i = pos
    c = 0
    negative = 0

    #{index-out=0}
    .nodes[node-idx].num-val = 0.0

    ; 負號
    #{overflow=wrap}
    s[i] == 45 -> {

        #{overflow=wrap}
        negative = 1
        i = i + 1
    }

    ; 整數部分
    (i < s.len-bytes()) {

        #{overflow=wrap}
        i >= s.len-bytes() -> break

        #{index-out=0}
        c = s[i]
        c < 48 || c > 57 -> break

        #{index-out=0, overflow=wrap}
        .nodes[node-idx].num-val = .nodes[node-idx].num-val * 10.0 + (c - 48)

        #{overflow=wrap}
        i = i + 1
    }

    ; 小數部分
    #{overflow=wrap}
    i < s.len-bytes() -> {

        #{index-out=0}
        c = s[i]
        c == 46 -> {

            #{overflow=wrap}
            i = i + 1
            frac = 0.1
            (i < s.len-bytes()) {

                #{overflow=wrap}
                i >= s.len-bytes() -> break

                #{index-out=0}
                c = s[i]
                c < 48 || c > 57 -> break

                #{index-out=0}
                .nodes[node-idx].num-val = .nodes[node-idx].num-val + frac * (c - 48)
                frac = frac * 0.1
                i = i + 1
            }
        }
    }

    ; 指數部分（e/E [+/-] digits）
    #{overflow=wrap}
    i < s.len-bytes() -> {

        #{index-out=0}
        c = s[i]
        c == 101 || c == 69 -> {

            #{overflow=wrap}
            i = i + 1
            exp-sign = 1
            i < s.len-bytes() -> {

                #{index-out=0, overflow=wrap}
                c = s[i]
                c == 45 -> {

                    #{overflow=wrap}
                    exp-sign = 0 - 1
                    i = i + 1
                }
                c == 43 -> i = i + 1
            }
            exp-val = 0
            (i < s.len-bytes()) {

                #{overflow=wrap}
                i >= s.len-bytes() -> break

                #{index-out=0}
                c = s[i]
                c < 48 || c > 57 -> break
                exp-val = exp-val * 10 + (c - 48)
                i = i + 1
            }

            ; 計算 10^exp-val（exp-val 始終為非負值）
            exp-base = 10.0
            exp-r = 1.0
            ev = exp-val
            (ev > 0) {

                #{overflow=wrap}
                ev & 1 == 1 -> exp-r = exp-r * exp-base
                exp-base = exp-base * exp-base
                ev = ev >> 1
            }
            exp-sign < 0 -> {

                #{index-out=0}
                .nodes[node-idx].num-val = .nodes[node-idx].num-val / exp-r
            }
            exp-sign >= 0 -> {

                #{index-out=0}
                .nodes[node-idx].num-val = .nodes[node-idx].num-val * exp-r
            }
        }
    }

    ; 處理負數
    #{overflow=wrap}
    negative == 1 -> {

        #{index-out=0}
        .nodes[node-idx].num-val = 0.0 - .nodes[node-idx].num-val
    }
    next-pos = i
}

; ═══════════════════════════════════════════════
; 物件存取
; ═══════════════════════════════════════════════

; str-eq: 比較兩個 str 是否相等
; 使用 str.eq-full 統一實作
json-pool.str-eq = (a str, b str) (eq i64) {
    a.eq-full(b) -> eq = 1
}

; get-key: 從物件節點取得鍵對應的子節點索引
; 返回 val-idx=子節點索引, ok=找到
json-pool.get-key = (obj-idx i64, key str) (val-idx i64, ok bool) {
    ok = false
    val-idx = -1
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != JSON-KIND-OBJ -> {

        #{index-out=0}
        return
    }

    #{index-out=0}
    cnt = .nodes[obj-idx].count
    i <- [0..cnt): {
        found-eq = 0

        #{index-out=0}
        found-eq = .str-eq(.nodes[obj-idx].keys[i], key)
        found-eq == 1 -> {

            #{index-out=0}
            val-idx = .nodes[obj-idx].children[i]
            ok = true
            return
        }
    }
}

; set-key: 在物件節點設定鍵值
; 返回 ok=成功
json-pool.set-key = (obj-idx i64, key str, val-idx i64) (ok bool) {

    #{overflow=wrap}
    ok = false
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != JSON-KIND-OBJ -> {

        #{index-out=0}
        return
    }

    ; 檢查鍵是否存在（更新）
    #{index-out=0}
    cnt = .nodes[obj-idx].count
    i <- [0..cnt): {

        #{overflow=wrap}
        found-eq = 0

        #{index-out=0}
        found-eq = .str-eq(.nodes[obj-idx].keys[i], key)
        found-eq == 1 -> {

            #{index-out=0}
            .nodes[obj-idx].children[i] = val-idx
            ok = true
            return
        }
    }

    ; 新增鍵
    cnt >= JSON-MAX-CHILDREN -> return

    #{index-out=0, index-out=0}

    ; 复制键字符串到 keys[cnt]
    .nodes[obj-idx].keys[cnt] = with-len(key.len-bytes())
    j <- [0..key.len-bytes()): {

        #{index-out=0, overflow=wrap}
        .nodes[obj-idx].keys[cnt][j] = key[j]
    }

    ; (length preset by with-len(key.len-bytes()) above)
    #{index-out=0}
    .nodes[obj-idx].children[cnt] = val-idx

    #{index-out=0, overflow=wrap}
    .nodes[obj-idx].count = cnt + 1
    ok = true
}

; ═══════════════════════════════════════════════
; 陣列存取
; ═══════════════════════════════════════════════

; arr-get: 從陣列節點取得指定索引的子節點
; 返回 val-idx=子節點索引, ok=成功
json-pool.arr-get = (arr-idx i64, elem i64) (val-idx i64, ok bool) {
    ok = false
    val-idx = -1
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != JSON-KIND-ARR -> {

        #{index-out=0}
        return
    }
    elem < 0 || elem >= .nodes[arr-idx].count -> {

        #{index-out=0}
        return
    }

    #{index-out=0}
    val-idx = .nodes[arr-idx].children[elem]
    ok = true
}

; arr-len: 取得陣列長度
json-pool.arr-len = (arr-idx i64) (n i64) {
    n = 0
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != JSON-KIND-ARR -> {

        #{index-out=0}
        return
    }

    #{index-out=0}
    n = .nodes[arr-idx].count
}

; ═══════════════════════════════════════════════
; 標量存取
; ═══════════════════════════════════════════════

; get-kind: 取得節點類型
json-pool.get-kind = (node-idx i64) (kind i64) {
    kind = JSON-KIND-NULL
    node-idx < 0 || node-idx >= .count -> return

    #{index-out=0}
    kind = .nodes[node-idx].kind
}

; get-str: 取得字串值
; 返回 out=字串副本, ok=成功
json-pool.get-str = (node-idx i64) (out str, ok bool) {
    ok = false
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-STR -> {

        #{index-out=0}
        return
    }

    #{index-out=0}
    out = .nodes[node-idx].str-val.copy()
    ok = true
}

; get-num: 取得數值
json-pool.get-num = (node-idx i64) (val f64, ok bool) {
    ok = false
    val = 0.0
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-NUM -> {

        #{index-out=0}
        return
    }

    #{index-out=0}
    val = .nodes[node-idx].num-val
    ok = true
}

; get-bool: 取得布林值
; 返回 val=布林值, ok=成功
json-pool.get-bool = (node-idx i64) (val bool, ok bool) {
    ok = false
    val = false
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-BOOL -> {

        #{index-out=0}
        return
    }

    #{index-out=0}
    val = .nodes[node-idx].bool-val
    ok = true
}

; ═══════════════════════════════════════════════
; 序列化
; ═══════════════════════════════════════════════

; stringify: 將節點序列化為字串
; 返回 out str: 序列化後的字串
json-pool.stringify = (node-idx i64) (out str) {
    out = ''
    node-idx < 0 || node-idx >= .count -> return

    #{index-out=0}
    kind = .nodes[node-idx].kind
    c = 0
    cnt = 0
    i = 0
    j = 0
    child-str = ''
    num-val f64 = 0.0
    num-str = ''
    key-str = ''

    {
        kind == JSON-KIND-NULL -> {
            out = 'null'
            return
        }

        kind == JSON-KIND-BOOL -> {
            .nodes[node-idx].bool-val -> {

                #{index-out=0}
                out = 'true'
            }

            -> out = 'false'
            return
        }

        kind == JSON-KIND-NUM -> {

            #{index-out=0}
            num-val = .nodes[node-idx].num-val
            num-str = num-val.to-str()
            out = num-str
            return
        }

        kind == JSON-KIND-STR -> {

            #{overflow=wrap}
            out = '"'

            #{index-out=0}
            sv str = .nodes[node-idx].str-val
            j = 0
            (j < sv.len-bytes()) {

                #{overflow=wrap}
                j >= sv.len-bytes() -> break

                #{index-out=0}
                c = sv[j]
                {
                    c == 34 -> out = out - '\\"'

                    c == 92 -> out = out - '\\\\'

                    c == 10 -> out = out - '\\n'

                    c == 9 -> out = out - '\\t'

                    c == 13 -> out = out - '\\r'

                    -> out = out - char-to-str(c)
                }

                #{overflow=wrap}
                j = j + 1
            }
            out = out - '"'
            return
        }

        kind == JSON-KIND-ARR -> {

            #{overflow=wrap}
            out = '['

            #{index-out=0}
            cnt = .nodes[node-idx].count
            i <- [0..cnt): {

                #{overflow=wrap}
                i > 0 -> out = out - ','

                #{index-out=0}
                child-str = .stringify(.nodes[node-idx].children[i])
                out = out - child-str
            }
            out = out - ']'
            return
        }

        kind == JSON-KIND-OBJ -> {

            #{overflow=wrap}
            out = '{'

            #{index-out=0}
            cnt = .nodes[node-idx].count
            i <- [0..cnt): {

                #{overflow=wrap}
                i > 0 -> out = out - ','

                #{index-out=0}
                key-str = .nodes[node-idx].keys[i]

                #{overflow=wrap}
                out = out - '"' - key-str - '":'

                #{index-out=0}
                child-str = .stringify(.nodes[node-idx].children[i])
                out = out - child-str
            }
            out = out - '}'
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 高級 API：json 結構體方法
; ═══════════════════════════════════════════════

; json.parse: 從字串解析 JSON，返回 ?json
; 成功返回 ok(json)，失敗返回 err('parse error')
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;       }
;   }
; json.get-key: 全局函数 — 从 json 对象中按键获取子节点
; 返回 child ?json: 子节点（nil 表示不存在）
json.get-key = (obj json, key str) (child ?json) {
    child = nil
    obj.root < 0 -> return
    k i64 = obj.pool.get-kind(obj.root)
    k != JSON-KIND-OBJ -> return
    val-idx, found = obj.pool.get-key(obj.root, key)
    found == true -> {
        child = json {
            pool: obj.pool
            root: val-idx
        }
    }
}

json.parse = (s str) (result ?json) {
    result = nil
    s.len-bytes() == 0 -> {
        result = err('empty input')
        return
    }

    ; 建立json 並解析
    j json
    j = new()
    root, next, ok = j.pool.parse(s, 0)

    ok == false -> {
        result = err('parse error')
        return
    }

    ; 檢查是否還有未消費的字元（跳過尾部空白）
    p = j.pool.skip-ws(s, next)
    p != s.len-bytes() -> {
        result = err('trailing characters')
        return
    }
    j.root = root
    result = j
}

; json.stringify: 將 JSON 值序列化為字串
; 返回 out: JSON 字串
; 用法：
;   j = new()
;   s = j.stringify()
json.stringify = () (out str) {
    out = ''
    .root < 0 -> return
    out = .pool.stringify(.root)
}

; json.is-null: 判斷是否為 null
; 返回 yes: 是否為 null
json.is-null = () (yes bool) {
    yes = false
    .root < 0 -> {
        yes = true
        return
    }
    k i64 = .pool.get-kind(.root)
    yes = k == JSON-KIND-NULL
}

; json.is-obj: 判斷是否為物件
json.is-obj = () (yes bool) {
    yes = false
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    yes = k == JSON-KIND-OBJ
}

; json.is-arr: 判斷是否為陣列
json.is-arr = () (yes bool) {
    yes = false
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    yes = k == JSON-KIND-ARR
}

; json.is-str: 判斷是否為字串
json.is-str = () (yes bool) {
    yes = false
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    yes = k == JSON-KIND-STR
}

; json.is-num: 判斷是否為數字
json.is-num = () (yes bool) {
    yes = false
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    yes = k == JSON-KIND-NUM
}

; json.is-bool: 判斷是否為布林值
json.is-bool = () (yes bool) {
    yes = false
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    yes = k == JSON-KIND-BOOL
}

; json.kind: 取得節點類型
; 返回 JSON kind 常量值
json.kind = () (k i64) {
    k = JSON-KIND-NULL
    .root < 0 -> return
    k = .pool.get-kind(.root)
}

; ═══════════════════════════════════════════════
; 物件操作
; ═══════════════════════════════════════════════

; json.get: 從物件取得子節點作為 json
; child 是 json 自身的子節點（沿用同一節點池，僅 root 指向子節點），
; 不會新建物件；找不到或非物件時回傳 nil。
; 返回 child ?json: ok=找到, nil=未找到或非物件
; 用法：
;   child = j.get('key')
;   child: {
;       ok -> {
;           s, found = it.get-str('sub-key')
;       }
;   }
json.get = (key str) (child ?json) {
    child = nil
    .root < 0 -> return

    ; 非物件直接回傳 nil（不在這裡把 root 變成新物件）
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return

    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val-idx < 0 -> return

    ; 子節點仍屬於 json 自己的節點池，只換 root 指向它
    child = json {
        pool: .pool
        root: val-idx
    }
}

; json.get-str: 從物件取得字串值
; 返回 val str, ok bool: ok=找到且為字串
; 用法：
;   s, found = j.get-str('name')
;   found -> print(s)
json.get-str = (key str) (val str, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-str(val-idx)
}

; json.get-num: 從物件取得數值
; 返回 val f64, ok bool: ok=找到且為數字
json.get-num = (key str) (val f64, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-num(val-idx)
}

; json.get-bool: 從物件取得布林值
; 返回 val bool, ok bool: ok=找到且為布林值
json.get-bool = (key str) (val bool, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-bool(val-idx)
}

; json.get-i64: 從物件取得整數值
; 返回 val i64, ok bool: ok=找到且為數字
json.get-i64 = (key str) (val i64, ok bool) {
    ok = false
    f, found = .get-num(key)
    found == false -> return
    val = f
    ok = true
}

; json.alloc-node: 內聯分配節點，避免嵌套方法調用的接收者複製問題
; 返回 idx: 新節點索引（-1=池滿）
json.alloc-node = () (idx i64) {

    #{overflow=wrap}
    idx = -1
    .pool.count >= JSON-MAX-NODES -> return
    idx = .pool.count

    #{overflow=wrap}
    .pool.count = .pool.count + 1

    #{index-out=0}
    .pool.nodes[idx].count = 0

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-NULL

    #{index-out=0}
    .pool.nodes[idx].str-val = ''

    #{index-out=0}
    .pool.nodes[idx].num-val = 0.0

    #{index-out=0}
    .pool.nodes[idx].bool-val = false
    j <- [0..JSON-MAX-CHILDREN): {

        #{index-out=0, overflow=wrap}
        .pool.nodes[idx].children[j] = -1

        #{index-out=0}
        .pool.nodes[idx].keys[j] = ''
    }
}

; json.set: 在物件中設定鍵值（值為另一個 json 節點）
; 返回 ok bool: 是否成功
json.set = (key str, val-idx i64) (ok bool) {

    #{overflow=wrap}
    ok = false
    .root < 0 -> {

        ; 建立 root 為物件
        .root = .alloc-node()
        .root < 0 -> return

        #{index-out=0}
        .pool.nodes[.root].kind = JSON-KIND-OBJ

        #{index-out=0}
        .pool.nodes[.root].count = 0
    }
    k i64 = JSON-KIND-NULL
    .root >= 0 && .root < .pool.count -> {

        #{index-out=0}
        k = .pool.nodes[.root].kind
    }
    {
        k == JSON-KIND-NULL -> {

            #{index-out=0}
            .pool.nodes[.root].kind = JSON-KIND-OBJ

            #{index-out=0}
            .pool.nodes[.root].count = 0
        }

        k != JSON-KIND-OBJ -> return
    }

    ; 內聯 set-key 邏輯（避免嵌套方法調用）
    #{index-out=0}
    cnt = .pool.nodes[.root].count

    ; 檢查鍵是否存在（更新）
    i <- [0..cnt): {

        #{overflow=wrap}
        found-eq = 0
        .pool.nodes[.root].keys[i].eq-full(key) -> {

            #{index-out=0}
            found-eq = 1
        }
        found-eq == 1 -> {

            #{index-out=0}
            .pool.nodes[.root].children[i] = val-idx
            ok = true
            return
        }
    }

    ; 新增鍵
    cnt >= JSON-MAX-CHILDREN -> return

    #{index-out=0, index-out=0}

    ; 複製鍵字串到 keys[cnt]
    .pool.nodes[.root].keys[cnt] = with-len(key.len-bytes())
    j <- [0..key.len-bytes()): {

        #{index-out=0, overflow=wrap}
        .pool.nodes[.root].keys[cnt][j] = key[j]
    }

    #{index-out=0}
    ktmp str = .pool.nodes[.root].keys[cnt].slice-bytes(0, key.len-bytes())

    #{index-out=0}
    .pool.nodes[.root].keys[cnt] = ktmp

    #{index-out=0}
    .pool.nodes[.root].children[cnt] = val-idx

    #{index-out=0, overflow=wrap}
    .pool.nodes[.root].count = cnt + 1
    ok = true
}

; json.set-str: 在物件中設定字串值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-str('name', 'Alice')
json.set-str = (key str, val str) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-STR

    #{index-out=0}
    .pool.nodes[idx].str-val = with-len(val.len-bytes())
    i <- [0..val.len-bytes()): {

        #{index-out=0}
        .pool.nodes[idx].str-val[i] = val[i]
    }

    #{index-out=0}
    svt str = .pool.nodes[idx].str-val.slice-bytes(0, val.len-bytes())

    #{index-out=0}
    .pool.nodes[idx].str-val = svt

    ok = .set(key, idx)
}

; json.set-num: 在物件中設定數值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-num('age', 30.0)
json.set-num = (key str, val f64) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-NUM

    #{index-out=0}
    .pool.nodes[idx].num-val = val

    ok = .set(key, idx)
}

; json.set-i64: 在物件中設定整數值
; 返回 ok bool: 是否成功
json.set-i64 = (key str, val i64) (ok bool) {
    f = number.i64-to-f64(val)
    ok = .set-num(key, f)
}

; json.set-bool: 在物件中設定布林值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-bool('active', true)
json.set-bool = (key str, val bool) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-BOOL

    #{index-out=0}
    .pool.nodes[idx].bool-val = val

    ok = .set(key, idx)
}

; json.set-null: 在物件中設定 null 值
; 返回 ok bool: 是否成功
json.set-null = (key str) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-NULL

    ok = .set(key, idx)
}

; ═══════════════════════════════════════════════
; 陣列操作
; ═══════════════════════════════════════════════

; json.arr-get: 從陣列取得指定索引的元素作為 json
; 返回 child ?json: ok=找到, nil=未找到或非陣列
; 用法：
;   elem = j.arr-get(0)
;   elem: {
;       ok -> {
;           s, found = it.get-str('name')
;       }
;   }
json.arr-get = (elem i64) (child ?json) {
    child = nil
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-ARR -> return
    val-idx, found = .pool.arr-get(.root, elem)
    found == false -> return
    c json
    c = json {
        pool: .pool
        root: val-idx
    }
    child = c
}

; json.arr-len: 取得陣列長度
; 返回 n: 陣列元素數量（非陣列返回 0）
; 用法：
;   n = j.arr-len()
json.arr-len = () (n i64) {
    n = 0
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-ARR -> return
    n = .pool.arr-len(.root)
}

; json.arr-push: 向陣列末尾添加元素
; 返回 ok bool: 是否成功
; 用法：
;   j.arr-push(item)
json.arr-push = (val json) (ok bool) {

    #{overflow=wrap}
    ok = false
    .root < 0 -> {

        ; 建立 root 為陣列
        .root = .alloc-node()
        .root < 0 -> return

        #{index-out=0}
        .pool.nodes[.root].kind = JSON-KIND-ARR

        #{index-out=0}
        .pool.nodes[.root].count = 0
    }
    k i64 = JSON-KIND-NULL
    .root >= 0 && .root < .pool.count -> {

        #{index-out=0}
        k = .pool.nodes[.root].kind
    }
    {
        k == JSON-KIND-NULL -> {

            #{index-out=0}
            .pool.nodes[.root].kind = JSON-KIND-ARR

            #{index-out=0}
            .pool.nodes[.root].count = 0
        }

        k != JSON-KIND-ARR -> return
    }

    #{index-out=0}
    cnt = .pool.nodes[.root].count
    cnt >= JSON-MAX-CHILDREN -> return

    #{index-out=0}
    .pool.nodes[.root].children[cnt] = val.root

    #{index-out=0, overflow=wrap}
    .pool.nodes[.root].count = cnt + 1
    ok = true
}

; json.arr-push-str: 向陣列末尾添加字串元素
; 返回 ok bool: 是否成功
json.arr-push-str = (val str) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-STR

    #{index-out=0}
    .pool.nodes[idx].str-val = with-len(val.len-bytes())
    i <- [0..val.len-bytes()): {

        #{index-out=0}
        .pool.nodes[idx].str-val[i] = val[i]
    }

    #{index-out=0}
    svt str = .pool.nodes[idx].str-val.slice-bytes(0, val.len-bytes())

    #{index-out=0}
    .pool.nodes[idx].str-val = svt

    ok = .arr-push(json {
        pool: .pool
        root: idx
    })
}

; json.arr-push-num: 向陣列末尾添加數值元素
; 返回 ok bool: 是否成功
json.arr-push-num = (val f64) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-NUM

    #{index-out=0}
    .pool.nodes[idx].num-val = val

    ok = .arr-push(json {
        pool: .pool
        root: idx
    })
}

; json.arr-push-bool: 向陣列末尾添加布林元素
; 返回 ok bool: 是否成功
json.arr-push-bool = (val bool) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    #{index-out=0}
    .pool.nodes[idx].kind = JSON-KIND-BOOL

    #{index-out=0}
    .pool.nodes[idx].bool-val = val

    ok = .arr-push(json {
        pool: .pool
        root: idx
    })
}

; ═══════════════════════════════════════════════
; 標量值取得（root 為標量時直接取值）
; ═══════════════════════════════════════════════

; json.str: 取得字串值（當 root 為字串時）
; 返回 val str, ok bool: ok=成功
; 用法：
;   s, found = j.str()
json.str = () (val str, ok bool) {
    val, ok = .pool.get-str(.root)
}

; json.num: 取得數值（當 root 為數字時）
; 返回 val f64, ok bool: ok=成功
json.num = () (val f64, ok bool) {
    val, ok = .pool.get-num(.root)
}

; json.bool: 取得布林值（當 root 為布林值時）
; 返回 val bool, ok bool: ok=成功
json.bool = () (val bool, ok bool) {
    val, ok = .pool.get-bool(.root)
}

; json.i64: 取得整數值（當 root 為數字時）
; 返回 val i64, ok bool: ok=成功
json.i64 = () (val i64, ok bool) {
    ok = false
    f, found = .num()
    found == false -> return
    val = f
    ok = true
}

; json.obj-len: 取得物件 key 數量
; 返回 n i64: key 數量（非物件返回 0）
json.obj-len = () (n i64) {
    n = 0
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    #{index-out=0}
    n = .pool.nodes[.root].count
}

; json.obj-key: 取得物件指定索引的 key
; 返回 key str: key 字串
; 返回 ok bool: 是否成功
json.obj-key = (idx i64) (key str, ok bool) {
    ok = false
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    #{index-out=0}
    cnt i64 = .pool.nodes[.root].count
    idx < 0 || idx >= cnt -> return

    #{index-out=0}
    key = .pool.nodes[.root].keys[idx]
    ok = true
}

; json.delete-key: 從物件中刪除指定鍵
; 返回 ok bool: ok=成功（鍵存在且已刪除）
json.delete-key = (key str) (ok bool) {
    ok = false
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    #{index-out=0}
    cnt i64 = .pool.nodes[.root].count
    i <- [0..cnt): {
        found-eq = 0

        #{index-out=0}
        found-eq = .pool.str-eq(.pool.nodes[.root].keys[i], key)
        found-eq == 1 -> {

            ; 向前移動後續鍵值
            jj <- [i + 1..cnt): {

                #{index-out=0, overflow=wrap}
                .pool.nodes[.root].keys[jj - 1] = .pool.nodes[.root].keys[jj]

                #{index-out=0, overflow=wrap}
                .pool.nodes[.root].children[jj - 1] = .pool.nodes[.root].children[jj]
            }

            #{index-out=0, overflow=wrap}
            .pool.nodes[.root].count = cnt - 1

            ; 清空最後一個槽位
            #{overflow=wrap}
            last i64 = cnt - 1

            #{index-out=0}
            .pool.nodes[.root].keys[last] = ''

            #{index-out=0}
            .pool.nodes[.root].children[last] = -1
            ok = true
            return
        }
    }
}

; json.set-key: 設定物件鍵值（語意糖，接受 json 值作為 val）
; 返回 ok bool: ok=成功
json.set-key = (key str, val json) (ok bool) {
    ok = .pool.set-key(.root, key, val.root)
}

; json.obj-keys-str: 取得物件所有鍵，以換行分隔的字串返回
; 返回 keys str: 所有鍵拼接成的字串
json.obj-keys-str = () (keys str) {
    keys = ''
    .root < 0 -> return
    k i64 = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    #{index-out=0}
    cnt i64 = .pool.nodes[.root].count
    i <- [0..cnt): {

        #{index-out=0, overflow=wrap}
        key = .pool.nodes[.root].keys[i]

        #{overflow=wrap}
        keys = keys - key - '\n'
    }
}

; json.str-val: 取得字串節點的值
; 返回 val str: 字串值
json.str-val = () (val str) {
    val, ok = .pool.get-str(.root)
    ok == false -> val = ''
}
