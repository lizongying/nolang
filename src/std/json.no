; json — JSON 序列化/反序列化
;
; 高級 API：json 結構體封裝節點池，提供直觀的 parse/stringify 介面。
; 底層基於節點池（json-pool）的 JSON 樹狀結構，支援巢狀陣列與物件。
;
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;           found -> print(name)
;       }
;   }
;
;   j2 = new()
;   j2.set('key', 'value')
;   s = j2.stringify()
;

;

;

; ═══════════════════════════════════════════════
; JSON 值類型枚舉
; ═══════════════════════════════════════════════

; json-kind: JSON 值的類型（使用常量替代枚舉，避免編譯器枚舉值不遞增的 bug）
JSON-KIND-NULL = 0
JSON-KIND-BOOL = 1
JSON-KIND-NUM = 2
JSON-KIND-STR = 3
JSON-KIND-ARR = 4
JSON-KIND-OBJ = 5

; json-pool 实例唯一标识计数器：copy-tree 据此检测“源池 == 接收者池”的自引用。
; 每次 init 递增取一个 id。即便被常量折叠使所有 id 相同，copy-tree 仍走经
; copy-tree-into（不查 id）的两段中转，递归在结构上必然收敛，只失去快路径优化。
JSON-POOL-NEXT-ID = 0

; ═══════════════════════════════════════════════
; 結構
; ═══════════════════════════════════════════════

; json-value: JSON 節點（純標量欄位，可安全存放於堆 vec）
; kind/num-val/bool-val: 標量值
; count: 陣列/物件的子元素數量
; first/last: 子元素在邊表的單向鏈表首/尾邊索引（-1=無子元素）
json-value {
    kind i64
    num-val f64
    bool-val bool
    count i64
    first i64
    last i64
}

; json-pool: JSON 節點池（堆 vec 配置，無容量上限）
; nodes: 節點平行陣列（以節點 idx 索引，元素為純標量結構）
; strs: 每個節點的字串值（以節點 idx 索引；自舊 str-val 欄位移出，避免 str  residing 於 vec 元素內）
; ec/ek/en: 邊表——子節點 idx、鍵名、下一同級邊 idx（父節點以 first/last 串起鏈表）
json-pool {
    nodes []json-value
    strs []str
    ec []i64
    ek []str
    en []i64
    count i64
    overflowed bool
    id i64
}

; json: 高級 JSON 值，封裝節點池與根節點索引
; 用法：
;   j = new()                      // 建立 null json
;   j = json.parse('{"a":1}')      // 從字串解析
;   s = j.stringify()              // 序列化為字串
; pool 以 #{inline=false} 存放為指標：使 json 可按值回傳/複製，
; 同時讓節點池改用堆 vec（複製時深拷貝池，避免別名與 double-free）。
json {
    pool json-pool #{inline=false}
    root i64
}

; ═══════════════════════════════════════════════
; 初始化
; ═══════════════════════════════════════════════

; new: 建立一個空的 json 值（null）
; 用法：
;   j = new()
;   j.set('key', 'value')
;   s = j.stringify()
new = () (j json) {
    j.root = -1
    j.pool.init()
}

; new-pool: 建立並初始化一個 json-pool（低級 API）
; 用法：
;   p = new-pool()
;   root, next, ok = p.parse('{"key":"value"}', 0)
new-pool = () (p json-pool) {
    p = json-pool {}
    p.init()
}

; init: 初始化節點池（堆 vec 需在使用前先初始化為非 nil，方能安全 push）
json-pool.init = () {
    .nodes = with-len(0)
    .strs = with-len(0)
    .ec = with-len(0)
    .ek = with-len(0)
    .en = with-len(0)
    .count = 0
    .overflowed = false

    #{overflow=wrap}
    JSON-POOL-NEXT-ID = JSON-POOL-NEXT-ID + 1
    .id = JSON-POOL-NEXT-ID
}

; alloc: 分配新節點，返回索引（堆 vec 自動擴容，不再有池滿上限）
json-pool.alloc = () (idx i64) {
    idx = .nodes.len()
    v json-value
    v.kind = JSON-KIND-NULL
    v.num-val = 0.0
    v.bool-val = false
    v.count = 0
    v.first = -1
    v.last = -1
    .nodes.push(v)
    .strs.push('')

    #{overflow=wrap}
    .count = .count + 1
}

; add-child: 將子節點 child-idx（鍵名 key，陣列傳空字串）附加到節點 node-idx
; 以邊表單向鏈表實作可變長子元素，無每節點上限
json-pool.add-child = (node-idx i64, child-idx i64, key str) {
    e = .ec.len()
    .ec.push(child-idx)
    .ek.push(key)
    .en.push(-1)

    ; 串接到父節點鏈表尾端
    last = .nodes[node-idx].last
    last >= 0 -> {
        .en[last] = e
    }
    last < 0 -> {

        .nodes[node-idx].first = e
    }

    .nodes[node-idx].last = e

    cd = .nodes[node-idx].count

    #{overflow=wrap}
    .nodes[node-idx].count = cd + 1
}

; ═══════════════════════════════════════════════
; 剖析
; ═══════════════════════════════════════════════

; parse: 從字串位置 pos 剖析 JSON 值
; 返回 node-idx=根節點索引, next-pos=下一位置, ok=成功
json-pool.parse = (s str, pos i64) (node-idx i64, next-pos i64, ok bool) {
    ok = false
    node-idx = -1
    sn = s.len-bytes()
    p = pos
    c = 0
    c2 = 0
    cnt = 0
    child-idx = 0
    child-next = 0
    child-ok = false
    key-idx = 0
    key-next = 0
    key-ok = false
    val-idx = 0
    val-next = 0
    val-ok = false

    ; 跳過空白
    (p < sn) {

        c = s.byte(p)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        p = p + 1
    }
    p >= sn -> return

    c = s.byte(p)

    ; 分配節點
    node-idx = .alloc()
    node-idx < 0 -> return

    ; null
    {
        c == 110 -> {
            .nodes[node-idx].kind = JSON-KIND-NULL

            #{overflow=wrap}
            next-pos = p + 4
            ok = true
            return
        }

        c == 116 -> {

            ; true
            .nodes[node-idx].kind = JSON-KIND-BOOL

            .nodes[node-idx].bool-val = true

            #{overflow=wrap}
            next-pos = p + 4
            ok = true
            return
        }

        c == 102 -> {

            ; false
            .nodes[node-idx].kind = JSON-KIND-BOOL

            .nodes[node-idx].bool-val = false

            #{overflow=wrap}
            next-pos = p + 5
            ok = true
            return
        }

        c == 34 -> {

            ; string
            .nodes[node-idx].kind = JSON-KIND-STR
            next-pos, ok = .parse-str(node-idx, s, p)
            return
        }

        c == 45 -> {

            ; number
            .nodes[node-idx].kind = JSON-KIND-NUM
            next-pos, ok = .parse-num(node-idx, s, p)
            return
        }

        c >= 48 && c <= 57 -> {
            .nodes[node-idx].kind = JSON-KIND-NUM
            next-pos, ok = .parse-num(node-idx, s, p)
            return
        }

        c == 91 -> {

            ; array
            .nodes[node-idx].kind = JSON-KIND-ARR

            .nodes[node-idx].count = 0

            #{overflow=wrap}
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty array
            s.byte(p) == 93 -> {

                #{overflow=wrap}
                next-pos = p + 1
                ok = true
                return
            }

            ; parse elements
            (p < sn) {
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return
                child-idx, child-next, child-ok = .parse(s, p)
                child-ok == false -> return

                ; 陣列：以邊表附加子元素（鍵名空字串）
                .add-child(node-idx, child-idx, '')
                p = child-next
                p = .skip-ws(s, p)
                p >= sn -> return

                c2 = s.byte(p)
                c2 == 93 -> {

                    #{overflow=wrap}
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> {

                        #{overflow=wrap}
                        p = p + 1
                    }

                    -> return
                }
            }
        }

        c == 123 -> {

            ; object
            .nodes[node-idx].kind = JSON-KIND-OBJ

            .nodes[node-idx].count = 0

            #{overflow=wrap}
            p = p + 1
            p = .skip-ws(s, p)
            p >= sn -> return

            ; empty object
            s.byte(p) == 125 -> {

                #{overflow=wrap}
                next-pos = p + 1
                ok = true
                return
            }

            ; parse key-value pairs
            (p < sn) {
                p >= sn -> return
                p = .skip-ws(s, p)
                p >= sn -> return

                ; key must be string
                s.byte(p) != 34 -> {

                    return
                }
                key-idx, key-next, key-ok = .parse(s, p)
                key-ok == false -> return
                p = key-next
                p = .skip-ws(s, p)
                p >= sn -> return

                ; expect ':'
                s.byte(p) != 58 -> {

                    return
                }

                #{overflow=wrap}
                p = p + 1
                val-idx, val-next, val-ok = .parse(s, p)
                val-ok == false -> return

                ; 物件：以邊表附加子元素；鍵名取自解析出的 key 節點字串值
                key-str = .strs[key-idx]
                .add-child(node-idx, val-idx, key-str)
                p = val-next
                p = .skip-ws(s, p)
                p >= sn -> return

                c2 = s.byte(p)
                c2 == 125 -> {

                    #{overflow=wrap}
                    next-pos = p + 1
                    ok = true
                    return
                }
                {
                    c2 == 44 -> {

                        #{overflow=wrap}
                        p = p + 1
                    }

                    -> return
                }
            }
        }
    }
}

; skip-ws: 跳過空白字元
json-pool.skip-ws = (s str, pos i64) (p i64) {
    p <- [pos..s.len-bytes()): {

        c = s.byte(p)
        c != 32 && c != 9 && c != 10 && c != 13 -> return
    }
}

; parse-str: 解析 JSON 字串（從開引號開始）
json-pool.parse-str = (node-idx i64, s str, pos i64) (next-pos i64, ok bool) {
    ok = false

    #{overflow=wrap}
    i = pos + 1
    j = 0
    c = 0

    ; 預估容量：掃描到閉引號的距離（不超過 s.len-bytes() - pos）
    #{overflow=wrap}
    est-cap = s.len-bytes() - pos
    est-cap < 1 -> est-cap = 1

    ; 在本地 str 緩衝逐位元組建構，最後存入 strs[node-idx]
    ; （避免對 vec 元素 str 做鏈式位元組寫入）
    buf str = with-len(est-cap)
    (i < s.len-bytes()) {
        i >= s.len-bytes() -> return

        c = s.byte(i)

        #{overflow=wrap}
        {
            c == 34 -> {

                ; str.truncate 尚未實作，改用 slice-bytes 截斷（est-cap 為預估容量）
                sv = buf.slice-bytes(0, j)

                .strs[node-idx] = sv

                #{overflow=wrap}
                next-pos = i + 1
                ok = true
                return
            }

            c == 92 -> {

                ; 跳過轉義字元

                #{overflow=wrap}
                i = i + 1
                i >= s.len-bytes() -> return

                c = s.byte(i)

                ; 處理常見轉義
                c == 110 -> c = 10
                c == 116 -> c = 9
                c == 114 -> c = 13
                ; c == 34, 92, 47 保留原樣
            }
        }
        buf[j] = c

        #{overflow=wrap}
        j = j + 1

        #{overflow=wrap}
        i = i + 1
    }
}

; parse-num: 解析 JSON 數字
json-pool.parse-num = (node-idx i64, s str, pos i64) (next-pos i64, ok bool) {
    ok = true
    i = pos
    c = 0
    negative = 0

    .nodes[node-idx].num-val = 0.0

    ; 負號
    #{overflow=wrap}
    s.byte(i) == 45 -> {
        negative = 1
        i = i + 1
    }

    ; 整數部分
    (i < s.len-bytes()) {
        i >= s.len-bytes() -> break

        c = s.byte(i)
        c < 48 || c > 57 -> break

        .nodes[node-idx].num-val = .nodes[node-idx].num-val * 10.0 + (c - 48)

        #{overflow=wrap}
        i = i + 1
    }

    ; 小數部分
    #{overflow=wrap}
    i < s.len-bytes() -> {

        c = s.byte(i)
        c == 46 -> {

            #{overflow=wrap}
            i = i + 1
            frac = 0.1
            (i < s.len-bytes()) {
                i >= s.len-bytes() -> break

                c = s.byte(i)
                c < 48 || c > 57 -> break

                .nodes[node-idx].num-val = .nodes[node-idx].num-val + frac * (c - 48)
                frac = frac * 0.1
                i = i + 1
            }
        }
    }

    ; 指數部分（e/E [+/-] digits）
    #{overflow=wrap}
    i < s.len-bytes() -> {

        c = s.byte(i)
        c == 101 || c == 69 -> {

            #{overflow=wrap}
            i = i + 1
            exp-sign = 1
            i < s.len-bytes() -> {

                c = s.byte(i)
                c == 45 -> {

                    #{overflow=wrap}
                    exp-sign = 0 - 1
                    i = i + 1
                }
                c == 43 -> i = i + 1
            }
            exp-val = 0
            (i < s.len-bytes()) {
                i >= s.len-bytes() -> break

                c = s.byte(i)
                c < 48 || c > 57 -> break
                exp-val = exp-val * 10 + (c - 48)
                i = i + 1
            }

            ; 計算 10^exp-val（exp-val 始終為非負值）
            exp-base = 10.0
            exp-r = 1.0
            ev = exp-val
            (ev > 0) {

                #{overflow=wrap}
                ev & 1 == 1 -> exp-r = exp-r * exp-base
                exp-base = exp-base * exp-base
                ev = ev >> 1
            }
            exp-sign < 0 -> {

                .nodes[node-idx].num-val = .nodes[node-idx].num-val / exp-r
            }
            exp-sign >= 0 -> {

                .nodes[node-idx].num-val = .nodes[node-idx].num-val * exp-r
            }
        }
    }

    ; 處理負數
    negative == 1 -> {

        .nodes[node-idx].num-val = 0.0 - .nodes[node-idx].num-val
    }
    next-pos = i
}

; ═══════════════════════════════════════════════
; 物件存取
; ═══════════════════════════════════════════════

; str-eq: 比較兩個 str 是否相等
; 使用 str.eq-full 統一實作
json-pool.str-eq = (a str, b str) (eq i64) {
    a.eq-full(b) -> eq = 1
}

; get-key: 從物件節點取得鍵對應的子節點索引
; 返回 val-idx=子節點索引, ok=找到
json-pool.get-key = (obj-idx i64, key str) (val-idx i64, ok bool) {
    ok = false
    val-idx = -1
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != JSON-KIND-OBJ -> {

        return
    }

    ; 沿邊表單向鏈表走訪子元素，比對鍵名 .ek[e]，命中回傳子節點 .ec[e]
    e = .nodes[obj-idx].first
    (e >= 0) {

        .str-eq(.ek[e], key) == 1 -> {

            val-idx = .ec[e]
            ok = true
            return
        }

        e = .en[e]
    }
}

; set-key: 在物件節點設定鍵值
; 返回 ok=成功
json-pool.set-key = (obj-idx i64, key str, val-idx i64) (ok bool) {
    ok = false
    obj-idx < 0 || obj-idx >= .count -> return
    .nodes[obj-idx].kind != JSON-KIND-OBJ -> {

        return
    }

    ; 沿邊表走訪，命中既有鍵則更新其子節點索引
    e = .nodes[obj-idx].first
    (e >= 0) {

        .str-eq(.ek[e], key) == 1 -> {

            .ec[e] = val-idx
            ok = true
            return
        }

        e = .en[e]
    }

    ; 未命中：以邊表附加新鍵值（堆 vec 自動擴容，無每節點上限）
    .add-child(obj-idx, val-idx, key)
    ok = true
}

; copy-tree: 将 src 池中 node-idx 为根的整棵子树深拷贝进接收者池。
; 返回 dst-idx: 新节点索引（-1=失败）
;
; 内存安全（根治自引用崩溃）：src 以 json-pool 值快照传入，其 vec 头与源池共享
; 底层缓冲区。当源与接收者为同一池（自引用，例如 root.get(k) 取到子树后又
; root.set-key(k, child)，且 pool 经 #{inline=false} 指针共享缓冲区）时，递归写入
; 接收者会在 .alloc()/add-child 处扩容共享 vec，使快照 src 的 vec 头失效（UAF）。
; 检测到同池（src.id == .id）即改走 copy-self：直接在实时接收者 `.` 上沿原始
; 子边链递归拷贝，读写均用实时 `.`，无快照失效；副本节点不再被遍历，递归
; 在结构上收敛。跨池（src.id != .id）时保持下方直拷分支，读写分处不同缓冲区。
json-pool.copy-tree = (src json-pool, node-idx i64) (dst-idx i64) {
    dst-idx = -1
    node-idx < 0 || node-idx >= src.count -> return

    ; 同池自引用：改用 copy-self 在实时接收者上拷贝，避免快照 vec 头失效
    src.id == .id -> {
        dst-idx = .copy-self(node-idx)
        return
    }

    ; 遞迴深拷貝：分配目標節點，複製標量欄位與字串值
    d = .alloc()
    d < 0 -> return
    dst-idx = d

    .nodes[d].kind = src.nodes[node-idx].kind

    .nodes[d].num-val = src.nodes[node-idx].num-val

    .nodes[d].bool-val = src.nodes[node-idx].bool-val

    .strs[d] = src.strs[node-idx].copy()

    ; 遍歷子節點的邊，逐一遞迴拷貝並以同鍵名附加
    e = src.nodes[node-idx].first
    (e >= 0) {

        cs = src.ec[e]

        ck = src.ek[e]
        cd = .copy-tree(src, cs)
        .add-child(d, cd, ck)

        e = src.en[e]
    }
}

; copy-self: 在同一池内把 node-idx 为根的子树深拷贝到新分配的節點，返回新根索引。
; 专用于自引用（源与目标同池）场景：读写均用实时接收者 `.`，无值快照，
; 因而不存在共享 vec 被扩容作废的 UAF；递归沿原始子边链走，新副本节点不会
; 被再次遍历，结构上必然收敛。读取子边先于递归写入完成（先存 enext）。
json-pool.copy-self = (node-idx i64) (dst-idx i64) {
    dst-idx = -1
    node-idx < 0 || node-idx >= .count -> return
    d = .alloc()
    d < 0 -> return
    dst-idx = d

    kind = .nodes[node-idx].kind

    numv = .nodes[node-idx].num-val

    boolv = .nodes[node-idx].bool-val

    first = .nodes[node-idx].first
    sval = .strs[node-idx].copy()

    .nodes[d].kind = kind

    .nodes[d].num-val = numv

    .nodes[d].bool-val = boolv

    .strs[d] = sval
    e = first
    (e >= 0) {

        cs = .ec[e]

        ck = .ek[e]

        enext = .en[e]
        cd = .copy-self(cs)
        .add-child(d, cd, ck)
        e = enext
    }
}

; ═══════════════════════════════════════════════
; 陣列存取
; ═══════════════════════════════════════════════

; arr-get: 從陣列節點取得指定索引的子節點
; 返回 val-idx=子節點索引, ok=成功
json-pool.arr-get = (arr-idx i64, elem i64) (val-idx i64, ok bool) {
    ok = false
    val-idx = -1
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != JSON-KIND-ARR -> {

        return
    }
    elem < 0 || elem >= .nodes[arr-idx].count -> {

        return
    }

    ; 沿邊表走訪到第 elem 條邊
    e = .nodes[arr-idx].first
    k <- [0..elem): {

        e = .en[e]
    }

    val-idx = .ec[e]
    ok = true
}

; arr-len: 取得陣列長度
json-pool.arr-len = (arr-idx i64) (n i64) {
    n = 0
    arr-idx < 0 || arr-idx >= .count -> return
    .nodes[arr-idx].kind != JSON-KIND-ARR -> {

        return
    }

    n = .nodes[arr-idx].count
}

; ═══════════════════════════════════════════════
; 標量存取
; ═══════════════════════════════════════════════

; get-kind: 取得節點類型
json-pool.get-kind = (node-idx i64) (kind i64) {
    kind = JSON-KIND-NULL
    node-idx < 0 || node-idx >= .count -> return

    kind = .nodes[node-idx].kind
}

; get-str: 取得字串值
; 返回 out=字串副本, ok=成功
json-pool.get-str = (node-idx i64) (out str, ok bool) {
    ok = false
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-STR -> {

        return
    }

    out = .strs[node-idx].copy()
    ok = true
}

; get-num: 取得數值
json-pool.get-num = (node-idx i64) (val f64, ok bool) {
    ok = false
    val = 0.0
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-NUM -> {

        return
    }

    val = .nodes[node-idx].num-val
    ok = true
}

; get-bool: 取得布林值
; 返回 val=布林值, ok=成功
json-pool.get-bool = (node-idx i64) (val bool, ok bool) {
    ok = false
    val = false
    node-idx < 0 || node-idx >= .count -> return
    .nodes[node-idx].kind != JSON-KIND-BOOL -> {

        return
    }

    val = .nodes[node-idx].bool-val
    ok = true
}

; ═══════════════════════════════════════════════
; 序列化
; ═══════════════════════════════════════════════

; stringify: 將節點序列化為字串
; 返回 out str: 序列化後的字串
json-pool.stringify = (node-idx i64) (out str) {
    out = ''
    node-idx < 0 || node-idx >= .count -> return

    kind = .nodes[node-idx].kind
    c = 0
    cnt = 0
    i = 0
    j = 0
    e = 0
    is-first = true
    child-str = ''
    num-val = 0.0
    num-str = ''
    key-str = ''
    {
        kind == JSON-KIND-NULL -> {
            out = 'null'
            return
        }

        kind == JSON-KIND-BOOL -> {
            .nodes[node-idx].bool-val -> {

                out = 'true'
            }

            -> out = 'false'
            return
        }

        kind == JSON-KIND-NUM -> {
            num-val = .nodes[node-idx].num-val
            num-str = num-val.to-str()
            out = num-str
            return
        }

        kind == JSON-KIND-STR -> {
            out = '"'

            sv str = .strs[node-idx]
            j = 0
            (j < sv.len-bytes()) {
                j >= sv.len-bytes() -> break

                c = sv[j]
                {
                    c == 34 -> out = out - '\\"'

                    c == 92 -> out = out - '\\\\'

                    c == 10 -> out = out - '\\n'

                    c == 9 -> out = out - '\\t'

                    c == 13 -> out = out - '\\r'

                    -> out = out - char-to-str(c)
                }

                #{overflow=wrap}
                j = j + 1
            }
            out = out - '"'
            return
        }

        kind == JSON-KIND-ARR -> {
            out = '['

            e = .nodes[node-idx].first
            is-first = true
            (e >= 0) {
                is-first == false -> out = out - ','
                is-first = false

                child-str = .stringify(.ec[e])
                out = out - child-str

                e = .en[e]
            }
            out = out - ']'
            return
        }

        kind == JSON-KIND-OBJ -> {
            out = '{'

            e = .nodes[node-idx].first
            is-first = true
            (e >= 0) {
                is-first == false -> out = out - ','
                is-first = false

                key-str = .ek[e]
                out = out - '"' - key-str - '":'

                child-str = .stringify(.ec[e])
                out = out - child-str

                e = .en[e]
            }
            out = out - '}'
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 高級 API：json 結構體方法
; ═══════════════════════════════════════════════

; json.parse: 從字串解析 JSON，返回 ?json
; 成功返回 ok(json)，失敗返回 err('parse error')
; 用法：
;   j = json.parse('{"name":"Alice","age":30}')
;   j: {
;       ok -> {
;           name, found = it.get-str('name')
;       }
;   }
; json-clone-tree: 把 src 池中以 idx 为根的子树深拷贝到一个全新的独立池，
; 返回持有该子树根的新 json。供 json.get / json.arr-get / json.get-key 等
; 「取子句柄」接口使用：返回体与源 json 不共享底层 vec 缓冲区。
;
; 为何必需深拷贝：json.pool 是 #{inline=false} 指针字段，而编译器的指针字段
; 拷贝目前尚缺借用语义（见 copy-tree 注释与 src/mir 的 hybrid-ownership 说明），
; 直接 `child = json { pool: .pool, ... }` 会让父子各持一份 vec 头但共享同一
; data 缓冲；一旦任一 handle 触发 vec realloc，另一 handle 的 vec 头即指向已
; 释放的旧缓冲 → 悬垂读（stringify 返回 null / 数据错乱）。改为独立深拷贝后，
; 双方的 alloc/扩容各写自有缓冲，互不影响。
json-clone-tree = (src json-pool, idx i64) (out json) {
    out.pool.init()
    out.root = out.pool.copy-tree(src, idx)
}

; json.get-key: 全局函数 — 从 json 对象中按键获取子节点
; 返回 child ?json: 子节点（nil 表示不存在）
json.get-key = (obj json, key str) (child ?json) {
    child = nil
    obj.root < 0 -> return
    k i64 = obj.pool.get-kind(obj.root)
    k != JSON-KIND-OBJ -> return
    val-idx, found = obj.pool.get-key(obj.root, key)
    found == true -> {

        ; 返回独立深拷贝子树（不与 obj 共享 vec 缓冲）
        child = json-clone-tree(obj.pool, val-idx)
    }
}

json.parse = (s str) (result ?json) {
    result = nil
    s.len-bytes() == 0 -> {
        result = err('empty input')
        return
    }

    ; 建立json 並解析
    j json
    j = new()
    root, next, ok = j.pool.parse(s, 0)
    ok == false -> {

        ; 池改用堆 vec 自動擴容，不再有容量上限；解析失敗即語法錯誤
        result = err('parse error')
        return
    }

    ; 檢查是否還有未消費的字元（跳過尾部空白）
    p = j.pool.skip-ws(s, next)
    p != s.len-bytes() -> {
        result = err('trailing characters')
        return
    }
    j.root = root
    result = j
}

; json.stringify: 將 JSON 值序列化為字串
; 返回 out: JSON 字串
; 用法：
;   j = new()
;   s = j.stringify()
json.stringify = () (out str) {
    out = ''
    .root < 0 -> return
    out = .pool.stringify(.root)
}

; json.overflowed: 最近一次操作是否因池容量耗盡而失敗
; 供 set / arr-push 等回傳 bool 的方法在返回 false 後區分「溢出」與「其他失敗」
; 用法：
;   ok = j.set('k', v)
;   ok == false && j.overflowed() -> print('pool full')
json.overflowed = () (yes bool) {
    yes = .pool.overflowed
}

; json.is-null: 判斷是否為 null
; 返回 yes: 是否為 null
json.is-null = () (yes bool) {
    yes = false
    .root < 0 -> {
        yes = true
        return
    }
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-NULL
}

; json.is-obj: 判斷是否為物件
json.is-obj = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-OBJ
}

; json.is-arr: 判斷是否為陣列
json.is-arr = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-ARR
}

; json.is-str: 判斷是否為字串
json.is-str = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-STR
}

; json.is-num: 判斷是否為數字
json.is-num = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-NUM
}

; json.is-bool: 判斷是否為布林值
json.is-bool = () (yes bool) {
    yes = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    yes = k == JSON-KIND-BOOL
}

; json.kind: 取得節點類型
; 返回 JSON kind 常量值
json.kind = () (k i64) {
    k = JSON-KIND-NULL
    .root < 0 -> return
    k = .pool.get-kind(.root)
}

; ═══════════════════════════════════════════════
; 物件操作
; ═══════════════════════════════════════════════

; json.get: 從物件取得子節點作為 json
; child 是 json 自身的子節點（沿用同一節點池，僅 root 指向子節點），
; 不會新建物件；找不到或非物件時回傳 nil。
; 返回 child ?json: ok=找到, nil=未找到或非物件
; 用法：
;   child = j.get('key')
;   child: {
;       ok -> {
;           s, found = it.get-str('sub-key')
;       }
;   }
json.get = (key str) (child ?json) {
    child = nil
    .root < 0 -> return

    ; 非物件直接回傳 nil（不在這裡把 root 變成新物件）
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val-idx < 0 -> return

    ; 返回独立深拷贝子树（不与父共享 vec 缓冲），避免任一 handle 扩容使另一失效
    child = json-clone-tree(.pool, val-idx)
}

; json.get-str: 從物件取得字串值
; 返回 val str, ok bool: ok=找到且為字串
; 用法：
;   s, found = j.get-str('name')
;   found -> print(s)
json.get-str = (key str) (val str, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-str(val-idx)
}

; json.get-num: 從物件取得數值
; 返回 val f64, ok bool: ok=找到且為數字
json.get-num = (key str) (val f64, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-num(val-idx)
}

; json.get-bool: 從物件取得布林值
; 返回 val bool, ok bool: ok=找到且為布林值
json.get-bool = (key str) (val bool, ok bool) {
    ok = false
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-OBJ -> return
    val-idx, found = .pool.get-key(.root, key)
    found == false -> return
    val, ok = .pool.get-bool(val-idx)
}

; json.get-i64: 從物件取得整數值
; 返回 val i64, ok bool: ok=找到且為數字
json.get-i64 = (key str) (val i64, ok bool) {
    ok = false
    f, found = .get-num(key)
    found == false -> return

    ; get-num 回傳 f64，直接 `val = f` 會被當成 f64→i64 的裸指派，
    ; codegen 只做位元重解（42.0 -> 4631107791820423168），必須顯式截斷。
    val = math.f64-to-i64(f)
    ok = true
}

; json.alloc-node: 分配新節點（pool 為 #{inline=false} 指標欄位，直接委派 .pool.alloc）
; 返回 idx: 新節點索引
json.alloc-node = () (idx i64) {
    idx = .pool.alloc()
}

; json.set: 在物件中設定鍵值（值為另一個 json 節點）
; 返回 ok bool: 是否成功
json.set = (key str, val-idx i64) (ok bool) {
    ok = false
    .root < 0 -> {

        ; 建立 root 為物件
        .root = .alloc-node()

        .pool.nodes[.root].kind = JSON-KIND-OBJ
    }

    ; null 節點可原地提升為物件；其他非物件類型拒絕寫入
    k = .pool.get-kind(.root)
    k == JSON-KIND-NULL -> {

        .pool.nodes[.root].kind = JSON-KIND-OBJ
    }
    k != JSON-KIND-NULL && k != JSON-KIND-OBJ -> return

    ; 委派池方法（pool 為指標欄位，嵌套調用安全）
    ok = .pool.set-key(.root, key, val-idx)
}

; json.set-str: 在物件中設定字串值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-str('name', 'Alice')
json.set-str = (key str, val str) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-STR

    ; 字串值存於平行 strs vec（以節點 idx 索引），直接指派副本
    .pool.strs[idx] = val.copy()
    ok = .set(key, idx)
}

; json.set-num: 在物件中設定數值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-num('age', 30.0)
json.set-num = (key str, val f64) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    .pool.nodes[idx].kind = JSON-KIND-NUM

    .pool.nodes[idx].num-val = val
    ok = .set(key, idx)
}

; json.set-i64: 在物件中設定整數值
; 返回 ok bool: 是否成功
json.set-i64 = (key str, val i64) (ok bool) {
    f = math.i64-to-f64(val)
    ok = .set-num(key, f)
}

; json.set-bool: 在物件中設定布林值
; 返回 ok bool: 是否成功
; 用法：
;   j.set-bool('active', true)
json.set-bool = (key str, val bool) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    .pool.nodes[idx].kind = JSON-KIND-BOOL

    .pool.nodes[idx].bool-val = val
    ok = .set(key, idx)
}

; json.set-null: 在物件中設定 null 值
; 返回 ok bool: 是否成功
json.set-null = (key str) (ok bool) {
    ok = false
    idx = .alloc-node()
    idx < 0 -> return

    .pool.nodes[idx].kind = JSON-KIND-NULL
    ok = .set(key, idx)
}

; ═══════════════════════════════════════════════
; 陣列操作
; ═══════════════════════════════════════════════

; json.arr-get: 從陣列取得指定索引的元素作為 json
; 返回 child ?json: ok=找到, nil=未找到或非陣列
; 用法：
;   elem = j.arr-get(0)
;   elem: {
;       ok -> {
;           s, found = it.get-str('name')
;       }
;   }
json.arr-get = (elem i64) (child ?json) {
    child = nil
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-ARR -> return
    val-idx, found = .pool.arr-get(.root, elem)
    found == false -> return

    ; 返回独立深拷贝子树（不与父共享 vec 缓冲）
    child = json-clone-tree(.pool, val-idx)
}

; json.arr-len: 取得陣列長度
; 返回 n: 陣列元素數量（非陣列返回 0）
; 用法：
;   n = j.arr-len()
json.arr-len = () (n i64) {
    n = 0
    .root < 0 -> return
    .pool.get-kind(.root) != JSON-KIND-ARR -> return
    n = .pool.arr-len(.root)
}

; json.arr-push-idx: 以節點索引向陣列末尾附加元素（內部輔助，避免構造 json 時深拷貝整個池）
; 返回 ok bool: 是否成功
json.arr-push-idx = (child-idx i64) (ok bool) {
    ok = false
    .root < 0 -> {

        ; 建立 root 為陣列
        .root = .alloc-node()

        .pool.nodes[.root].kind = JSON-KIND-ARR
    }

    ; null 節點可原地提升為陣列；其他非陣列類型拒絕寫入
    k = .pool.get-kind(.root)
    k == JSON-KIND-NULL -> {

        .pool.nodes[.root].kind = JSON-KIND-ARR
    }
    k != JSON-KIND-NULL && k != JSON-KIND-ARR -> return

    ; 以邊表附加子元素（鍵名空字串）
    .pool.add-child(.root, child-idx, '')
    ok = true
}

; json.arr-push: 向陣列末尾添加元素
; 返回 ok bool: 是否成功
; 用法：
;   j.arr-push(item)
json.arr-push = (val json) (ok bool) {
    ok = .arr-push-idx(val.root)
}

; json.arr-push-str: 向陣列末尾添加字串元素
; 返回 ok bool: 是否成功
json.arr-push-str = (val str) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-STR

    ; 字串值存於平行 strs vec
    .pool.strs[idx] = val.copy()
    ok = .arr-push-idx(idx)
}

; json.arr-push-num: 向陣列末尾添加數值元素
; 返回 ok bool: 是否成功
json.arr-push-num = (val f64) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-NUM

    .pool.nodes[idx].num-val = val
    ok = .arr-push-idx(idx)
}

; json.arr-push-bool: 向陣列末尾添加布林元素
; 返回 ok bool: 是否成功
json.arr-push-bool = (val bool) (ok bool) {
    ok = false
    idx = .alloc-node()

    .pool.nodes[idx].kind = JSON-KIND-BOOL

    .pool.nodes[idx].bool-val = val
    ok = .arr-push-idx(idx)
}

; ═══════════════════════════════════════════════
; 標量值取得（root 為標量時直接取值）
; ═══════════════════════════════════════════════

; json.str: 取得字串值（當 root 為字串時）
; 返回 val str, ok bool: ok=成功
; 用法：
;   s, found = j.str()
json.str = () (val str, ok bool) {
    val, ok = .pool.get-str(.root)
}

; json.num: 取得數值（當 root 為數字時）
; 返回 val f64, ok bool: ok=成功
json.num = () (val f64, ok bool) {
    val, ok = .pool.get-num(.root)
}

; json.bool: 取得布林值（當 root 為布林值時）
; 返回 val bool, ok bool: ok=成功
json.bool = () (val bool, ok bool) {
    val, ok = .pool.get-bool(.root)
}

; json.i64: 取得整數值（當 root 為數字時）
; 返回 val i64, ok bool: ok=成功
json.i64 = () (val i64, ok bool) {
    ok = false
    f, found = .num()
    found == false -> return
    val = f
    ok = true
}

; json.obj-len: 取得物件 key 數量
; 返回 n i64: key 數量（非物件返回 0）
json.obj-len = () (n i64) {
    n = 0
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    n = .pool.nodes[.root].count
}

; json.obj-key: 取得物件指定索引的 key
; 返回 key str: key 字串
; 返回 ok bool: 是否成功
json.obj-key = (idx i64) (key str, ok bool) {
    ok = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    cnt i64 = .pool.nodes[.root].count
    idx < 0 || idx >= cnt -> return

    ; 沿邊表走訪到第 idx 條邊，取鍵名 .ek[e]
    e i64 = .pool.nodes[.root].first
    t <- [0..idx): {

        e = .pool.en[e]
    }

    key = .pool.ek[e]
    ok = true
}

; json.delete-key: 從物件中刪除指定鍵
; 返回 ok bool: ok=成功（鍵存在且已刪除）
json.delete-key = (key str) (ok bool) {
    ok = false
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    ; 遍歷邊鏈並記錄前驅；命中則將該邊從單向鏈表摘除
    e i64 = .pool.nodes[.root].first
    prev = -1
    (e >= 0) {

        next i64 = .pool.en[e]

        ek = .pool.ek[e]
        .pool.str-eq(ek, key) == 1 -> {

            ; 前驅改指向 next；若命中邊為首則更新 first
            prev >= 0 -> {

                .pool.en[prev] = next
            }
            prev < 0 -> {

                .pool.nodes[.root].first = next
            }

            ; 若命中邊為尾則更新 last
            last i64 = .pool.nodes[.root].last
            last == e -> {

                .pool.nodes[.root].last = prev
            }

            cnt i64 = .pool.nodes[.root].count

            #{overflow=wrap}
            .pool.nodes[.root].count = cnt - 1
            ok = true
            return
        }
        prev = e
        e = next
    }
}

; json.set-key: 設定物件鍵值（語意糖，接受 json 值作為 val）
; 返回 ok bool: ok=成功
json.set-key = (key str, val json) (ok bool) {
    ok = false
    val.root < 0 || val.root >= val.pool.count -> return
    .root < 0 -> {
        .root = .alloc-node()
        .root < 0 -> return

        .pool.nodes[.root].kind = JSON-KIND-OBJ

        .pool.nodes[.root].count = 0
    }

    ; 深拷贝 val 池中的子树到接收者池，再挂键（避免跨池悬空索引）
    v-idx = .pool.copy-tree(val.pool, val.root)
    v-idx < 0 -> return
    ok = .pool.set-key(.root, key, v-idx)
}

; json.obj-keys-str: 取得物件所有鍵，以換行分隔的字串返回
; 返回 keys str: 所有鍵拼接成的字串
json.obj-keys-str = () (keys str) {
    keys = ''
    .root < 0 -> return
    k = .pool.get-kind(.root)
    k != JSON-KIND-OBJ -> return

    ; 沿邊表走訪，依序拼接每個鍵名
    e i64 = .pool.nodes[.root].first
    (e >= 0) {

        key = .pool.ek[e]
        keys = keys - key - '\n'

        e = .pool.en[e]
    }
}

; json.str-val: 取得字串節點的值
; 返回 val str: 字串值
json.str-val = () (val str) {
    val, ok = .pool.get-str(.root)
    ok == false -> val = ''
}
