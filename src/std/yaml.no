; yaml — YAML 1.2 解析與生成
;
; 支持 YAML 1.2 core schema 的完整節點模型：
;   - 塊映射 / 塊序列（縮進嵌套、序列內映射、映射內序列）
;   - 流式集合 [a, b] / {k: v}（可跨行）
;   - 標量：plain、單引號、雙引號（含轉義）、塊標量 | 與 >（含 chomping / 縮進指示符）
;   - 注释、空行、文檔標記 --- / ... 、多文檔、%YAML / %TAG 指令
;   - 锚點 &a / 别名 *a、顯式標簽 !!str / !<...>、合並键 <<
;   - 顯式键 ? key / : value
;   - core schema 類型推斷：null / bool / int（十進制、0x、0o、_ 分隔）/ float（.inf/.nan/指數）
;
; 用法：
;   doc ?yaml = yaml.parse(source)
;   doc: {
;       ok -> {
;           host, found = it.find-str('server.host')
;           port, found = it.find-i64('server.port')
;       }
;   }
;
; 说明：
;   - 别名在解析期解析為共享同一子樹的新節點（只讀），可安全重複讀取；
;     自引用锚點不會被無限展開，序列化時按深度上限截斷。
;   - 键為標量時可直接用點號路径訪問；非標量键請用 key(i) / value(i) 遍歷。
; [yaml](#yaml)

; 常量
...

; 節點類型
; [YAML-KIND-NULL](#yaml.yaml-kind-null)
YAML-KIND-NULL = 0
YAML-KIND-BOOL = 1
YAML-KIND-INT = 2
YAML-KIND-FLOAT = 3
YAML-KIND-STR = 4
YAML-KIND-SEQ = 5
YAML-KIND-MAP = 6

; 標量風格
; [YAML-STYLE-PLAIN](#yaml.yaml-style-plain)
YAML-STYLE-PLAIN = 0
YAML-STYLE-SINGLE = 1
YAML-STYLE-DOUBLE = 2
YAML-STYLE-LITERAL = 3
YAML-STYLE-FOLDED = 4
YAML-STYLE-ALIAS = 5

; 集合風格
; [YAML-STYLE-BLOCK](#yaml.yaml-style-block)
YAML-STYLE-BLOCK = 6
YAML-STYLE-FLOW = 7

; 序列化遞歸深度上限（防御自引用锚點）
; [YAML-MAX-DEPTH](#yaml.yaml-max-depth)
YAML-MAX-DEPTH = 32

; chomping 模式
; [YAML-CHOMP-CLIP](#yaml.yaml-chomp-clip)
YAML-CHOMP-CLIP = 0
YAML-CHOMP-STRIP = 1
YAML-CHOMP-KEEP = 2

; 數據結構
...

; node: 樹節點
;   kind   節點類型（YAML-KIND-*）
;   style  標量/集合風格（YAML-STYLE-*）
;   tag    顯式標簽原文（無標簽為 ''）
;   anchor 锚點名（無锚點為 ''）
;   text   標量原文（引號已解轉義）；集合為空
;   ival/fval/bval 解析後的標量值
;   keys   映射键節點索引；kids 序列元素 / 映射值節點索引
; [node](#yaml.node)
node {
    kind i64
    style i64
    tag str
    anchor str
    text str
    ival i64
    fval f64
    bval bool
    keys []i64
    kids []i64
    line i64
    col i64
}

; node-pool: 節點池
; [pool](#yaml.node-pool)
pool {
    nodes []node
}

; yaml: 已解析文檔（可含多份文檔）
; [yaml](#yaml.yaml)
yaml {
    node-pool pool
    root i64
    roots []i64
    source str
}

; parser: 解析器状態（方法接收者為引用，可原地推進）
; [parser](#yaml.parser)
parser {
    src str
    n i64
    pos i64
    line i64
    nodes []node
    anchor-names []str
    anchor-ids []i64
    err str
    failed bool
}

; 解析器：字符級基础操作
...

; 取 src[i]，越界返回 0
; i: 目標索引
; c: 該位置的位元組值（越界時為 0）
; [byte-at](#yaml.parser.byte-at)
parser.byte-at = (i i64) (c i64) {
    c = 0
    i < 0 -> return
    i >= .n -> return
    c = .src.byte(i): {
        ok -> it

        -> 0
    }
}

; 當前字節
; c: 當前 pos 指向的位元組（EOF 時為 0）
; [cur](#yaml.parser.cur)
parser.cur = () (c i64) {
    c = .byte-at(.pos)
}

; 相對當前位置偏移 k 的字節
; k: 相對當前位置的偏移量（越界按 0 處理）
; c: pos+k 處的位元組值
; [at](#yaml.parser.at)
parser.at = (k i64) (c i64) {

    #{overflow=wrap}
    i = .pos + k
    c = .byte-at(i)
}

; 是否到達输入末尾
; yes: pos 已到達输入末尾
; [eof](#yaml.parser.eof)
parser.eof = () (yes bool) {
    yes = .pos >= .n
}

; 前進一個字節
; [advance](#yaml.parser.advance)
parser.advance = () {

    #{overflow=wrap}
    .pos = .pos + 1: {
        ok -> it

        ->
    }
}

; 消費一個換行（\n 或 \r\n）
; yes: 消費了一個換行；false=不在換行處，位置不變
; [newline](#yaml.parser.newline)
parser.newline = () (yes bool) {
    yes = false
    c = .cur()
    c == 13 -> {
        .advance()
        .cur() == 10 -> .advance()
        yes = true

        #{overflow=wrap}
        .line = .line + 1: {
            ok -> it

            ->
        }
        return
    }
    c == 10 -> {
        .advance()
        yes = true

        #{overflow=wrap}
        .line = .line + 1: {
            ok -> it

            ->
        }
    }
}

; 是否位於行尾（含 EOF）
; yes: 當前位元組是 \n 或已到输入末尾
; [at-eol](#yaml.parser.at-eol)
parser.at-eol = () (yes bool) {
    c = .cur()
    yes = c == 0 || c == 10 || c == 13
}

; 跳過行內空格與制表符
; [skip-spaces](#yaml.parser.skip-spaces)
parser.skip-spaces = () {
    !! {
        c = .cur()
        c == 32 -> {
            .advance()
            continue
        }
        c == 9 -> {
            .advance()
            continue
        }
        break
    }
}

; 跳過行尾空白與行注释（不消費換行）
; [skip-to-eol](#yaml.parser.skip-to-eol)
parser.skip-to-eol = () {
    .skip-spaces()
    c = .cur()
    c == 35 -> {
        !! {
            .at-eol() -> break
            .advance()
        }
    }
}

; 返回 i 所在行的行尾偏移（指向換行或 n）
; i: 目標行內任意位元組偏移
; le: 行尾偏移（指向換行符；無換行時等於输入長度）
; [line-end-of](#yaml.parser.line-end-of)
parser.line-end-of = (i i64) (le i64) {
    le = i
    (le < .n) {
        le >= .n -> return
        c = .byte-at(le)
        c == 10 || c == 13 -> return

        {

            #{overflow=wrap}
            le-opt = le + 1
            le-opt: {
                ok -> le = it

                ->
            }
        }
    }
}

; 返回 i 所在行的起始偏移
; i: 目標行內任意位元組偏移
; ls: i 所在行的行首位元組偏移
; [line-start-of](#yaml.parser.line-start-of)
parser.line-start-of = (i i64) (ls i64) {
    ls = i
    (ls > 0) {
        ls <= 0 -> return

        ; D1：`-` 的結果恆為 `?i64`，p 只作游標用 → 兩段式 match 解包。
        #{overflow=wrap}
        p = ls - 1: {
            ok -> it

            -> 0
        }
        c = .byte-at(p)
        c == 10 || c == 13 -> return
        ls = p
    }
}

; 當前位置距行首的空格數
;
; 先跳過行首空格再計數：調用點幾乎都緊跟在 skip-blank-lines() 之後，
; 此時 pos 停在行首（列 0），直接相減會恆得 0，導致嵌套塊被判成「不縮進」。
; 跳過後 pos 停在首個非空格字符，後續的 is-seq-dash / looks-like-map-entry /
; at-doc-marker 也都需要這個位置。
; ind: 當前行首個非空字符前的空格列數
; [indent-at](#yaml.parser.indent-at)
parser.indent-at = () (ind i64) {
    .skip-spaces()
    ls = .line-start-of(.pos)

    #{overflow=wrap}
    ind = .pos - ls: {
        ok -> it

        ->
    }
}

; 記錄解析錯誤
; msg: 錯誤描述（存入解析器錯誤信息）
; [fail](#yaml.parser.fail)
parser.fail = (msg str) {
    .failed -> return
    .failed = true
    .err = msg
}

; 記錄帶位置的解析錯誤
; msg: 錯誤描述（自動附加當前位置信息）
; [fail-at](#yaml.parser.fail-at)
parser.fail-at = (msg str) {
    .failed -> return
    .failed = true

    #{overflow=wrap}
    col = .pos - .line-start-of(.pos) + 1

    .err = 'line ' - .line.to-str() - ', column ' - col.to-str() - ': ' - msg
}

; 追加節點並返回索引
; nd: 待追加的節點
; idx: 該節點在節點池中的索引
; [push-node](#yaml.parser.push-node)
parser.push-node = (nd node) (idx i64) {
    .nodes.push(nd)

    #{overflow=wrap}
    idx = .nodes.len() - 1
}

; 追加空節點（null）
; idx: 新建 null 節點的池索引
; [push-null](#yaml.parser.push-null)
parser.push-null = () (idx i64) {
    nd = node{
        kind: YAML-KIND-NULL
        style: YAML-STYLE-PLAIN
        tag: ''
        anchor: ''
        text: ''
        ival: 0
        fval: 0.0
        bval: false
        line: .line
        col: 0
    }
    idx = .push-node(nd)
}

; 為節點附加標簽與锚點（並登記锚點）
; idx: 目標節點池索引
; tag: 顯式標簽（空串=無）
; anchor: 锚點名（空串=無；非空時同時登記）
; [set-props](#yaml.parser.set-props)
parser.set-props = (idx i64, tag str, anchor str) {
    .nodes[idx].tag = tag

    .nodes[idx].anchor = anchor
    anchor.len-bytes() > 0 -> .register-anchor(anchor, idx)

    ; 標簽必須在這裡就作用到節點上：節點是先按 core schema 推斷出來的，
    ; 顯式標簽（!!str / !!int …）讀到的時間比節點建立晚，若只存字串就會出現
    ; `!!str 123` 仍被當成 int、`!!int "42"` 仍被當成 str（兩者都是 YAML 1.2
    ; 明確要求標簽優先的情況）。
    .apply-tag-at(idx)
}

; 把節點已有的顯式標簽作用到 kind 與解析後的標量值上
;
; 節點先由 core schema 推斷建立，標簽是後補的，所以需要一步「重算」：
; 標簽改寫 kind 之後，ival/fval/bval 必須按標簽要求重新解析，否則
; `!!int "42"` 會留下 kind=INT 而 ival=0（`yaml.i64` 取到 0 而非 42）。
; 集合節點（seq/map）只保留標簽原文，不改 kind —— `!!seq` / `!!map` 不改變
; 解析結構，而 `!!str` 套在集合上在 YAML 裡本就是非良構寫法。
; idx: 節點池索引
; [apply-tag-at](#yaml.parser.apply-tag-at)
parser.apply-tag-at = (idx i64) {

    ; 讀取走 `?=` 綁定：裸下標 `arr[i]` 回的是 `?T`，不能在這裡當普通值用
    ; （idxbruse）。失敗（索引越界）就直接放棄，什麼也不改。
    {
        nd ?= .nodes[idx]
        tag = nd.tag
        tag.len-bytes() > 0 -> {
            kind = nd.kind
            is-coll = kind == YAML-KIND-SEQ || kind == YAML-KIND-MAP
            is-coll == false -> {
                k = apply-tag(tag, kind)
                k != kind -> {
                    text = nd.text
                    .nodes[idx].kind = k
                    k == YAML-KIND-STR || k == YAML-KIND-NULL -> {
                        .nodes[idx].ival = 0
                        .nodes[idx].fval = 0.0
                        .nodes[idx].bval = false
                    }
                    k == YAML-KIND-INT -> {
                        iv = 0
                        iv2 = 0
                        fv2 = 0.0
                        iv2, iv, fv2 = scan-number(text)
                        .nodes[idx].ival = iv
                    }
                    k == YAML-KIND-FLOAT -> {
                        fv ?f64 = to-f64(text)
                        {
                            .nodes[idx].fval = 0.0
                            fv: {
                                nil -> _

                                err -> _

                                ok -> .nodes[idx].fval = it
                            }
                        }
                    }
                    k == YAML-KIND-BOOL -> {
                        lower = text.to-lower()
                        lower == 'true' -> .nodes[idx].bval = true
                        lower == 'false' -> .nodes[idx].bval = false
                        lower == 'yes' -> .nodes[idx].bval = true
                        lower == 'no' -> .nodes[idx].bval = false
                        lower == 'on' -> .nodes[idx].bval = true
                        lower == 'off' -> .nodes[idx].bval = false
                    }
                }
            }
        }
    }: {
        err -> _

        -> _
    }
}

; 登記锚點
; name: 锚點名
; idx: 锚點指向的節點索引
; [register-anchor](#yaml.parser.register-anchor)
parser.register-anchor = (name str, idx i64) {
    .anchor-names.push(name)
    .anchor-ids.push(idx)
}

; 查找锚點，未找到返回 -1
; name: 锚點名
; idx: 對應的節點索引（-1=未登記）
; [anchor-id](#yaml.parser.anchor-id)
parser.anchor-id = (name str) (idx i64) {
    idx = -1
    total = .anchor-names.len()
    i <- [0..total): {
        nm = str-at(.anchor-names, i)
        nm.eq-full(name) -> {
            idx = .anchor-ids[i]: {
                ok -> it

                -> _
            }
            return
        }
    }
}

; 索引辅助
...

; 取 []str 的第 i 個元素（越界返回空串）
;
; 為什麼需要這個 helper：`arr[i]`（arr 為 []str）默認返回 option<str>，
; 而 MIR 後端在把 option<str> 當作調用實參/方法接收者時會產生非法 IR
; （%option_str 與 %str-long 不匹配）。字符串拼接會自動解包 option，
; 因此這里用 `out = out - a[i]` 取元素，既解包又滿足 `no vet` 的越界檢查。
; a: 目標字符串數組
; i: 元素下標
; out: 第 i 個元素的值（越界返回空串）
; [str-at](#yaml.str-at)
str-at = (a []str, i i64) (out str) {
    out = ''
    i < 0 -> return
    i >= a.len() -> return
    ixout390c17 = a[i]: {
        ok -> it

        -> ''
    }

    out = out - ixout390c17
}

; 浮點是否為 NaN（NaN != NaN）
; 不用 `float.is-nan`：模塊內的接收者式調用在 MIR 後端解析不到該方法。
; x: 待檢測的 f64 值
; yes: x 為 NaN（NaN != NaN 判據）
; [f-is-nan](#yaml.f-is-nan)
f-is-nan = (x f64) (yes bool) {
    yes = x != x
}

; 浮點是否為正/負無窮
;
; 不用字面量比較：Nolang 的數值字面量不支持指數（`1e308` 會被切成 `1` + `e308`）。
; 無窮的判據是「非零且減半後不變」；先用 `x != x` 排除 NaN。
; x: 待檢測的 f64 值
; yes: x 為正/負無窮（非零且減半後不變）
; [f-is-inf](#yaml.f-is-inf)
f-is-inf = (x f64) (yes bool) {
    yes = false
    x != x -> return
    x == 0.0 -> return
    half = x * 0.5
    yes = half == x
}

; 標量類型推斷（YAML 1.2 core schema）
...

; 正無窮
; v: 正無窮大值
; [inf](#yaml.inf)
inf = () (v f64) {
    v = 1.0 / 0.0
}

; 非數
;
; 必須走運行期除法：編譯期常量摺疊會把 `0.0 / 0.0` 直接算成 0。
; 借道局部變量可避免摺疊，得到真正的 NaN（`x != x` 為真）。
; v: NaN 值（運行期 0.0/0.0 產生，未被常量摺疊）
; [nan](#yaml.nan)
nan = () (v f64) {
    zero = 0.0
    v = zero / zero
}

; 十六進制字符轉數值，非十六進制返回 -1
; c: 字符的 ASCII 碼
; d: 該十六進制位代表的數值 0-15（-1=非法十六進制字符）
; [hex-digit](#yaml.hex-digit)
hex-digit = (c i64) (d i64) {
    d = -1
    c >= 48 && c <= 57 -> {
        {

            #{overflow=wrap}
            d-opt2 = c - 48
            d-opt2: {
                ok -> d = it

                ->
            }
        }
        return
    }
    c >= 97 && c <= 102 -> {
        {

            #{overflow=wrap}
            d-opt3 = c - 97 + 10
            d-opt3: {
                ok -> d = it

                ->
            }
        }
        return
    }
    c >= 65 && c <= 70 -> {
        {

            #{overflow=wrap}
            d-opt4 = c - 65 + 10
            d-opt4: {
                ok -> d = it

                ->
            }
        }
    }
}

; 解析 radix 進制整數（忽略 _）
; t: 含數字的文本
; start: 數字起始偏移
; radix: 進制基數（2/8/16）
; kind: 成功=YAML-KIND-INT，失败=YAML-KIND-STR
; v: 轉換出的整數值
; [parse-radix](#yaml.parse-radix)
parse-radix = (t str, start i64, radix i64) (kind i64, v i64) {
    kind = YAML-KIND-STR
    v = 0
    i = start
    n = t.len-bytes()
    digits = 0
    (i < n) {
        i >= n -> break
        c = t.byte(i): {
            ok -> it

            -> _
        }
        c == 95 -> {
            {

                #{overflow=wrap}
                i-opt2 = i + 1
                i-opt2: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        d = hex-digit(c)
        d < 0 -> return
        d >= radix -> return

        {

            #{overflow=wrap}
            v-opt = v * radix + d
            v-opt: {
                ok -> v = it

                ->
            }
        }

        {

            #{overflow=wrap}
            digits-opt = digits + 1
            digits-opt: {
                ok -> digits = it

                ->
            }
        }

        {

            #{overflow=wrap}
            i-opt3 = i + 1
            i-opt3: {
                ok -> i = it

                ->
            }
        }
    }
    digits == 0 -> return
    kind = YAML-KIND-INT
}

; 文本轉 f64（返回 nil 表示失败）
; t: 數字文本
; v: 轉換結果（nil=無法解析為 f64）
; [to-f64](#yaml.to-f64)
to-f64 = (t str) (v ?f64) {
    v = nil
    r = t.to-f64()
    r: {
        nil -> return

        err -> return

        -> v = it
    }
}

; 尝試把文本解析為整數或浮點數
; 返回 kind = YAML-KIND-INT / YAML-KIND-FLOAT / YAML-KIND-STR（不是數字）
; t: 標量文本
; kind: 識别出的數字種類（INT/FLOAT/STR）
; ival: kind=INT 時的整數值
; fval: kind=FLOAT 時的浮點值
; [scan-number](#yaml.scan-number)
scan-number = (t str) (kind i64, ival i64, fval f64) {
    kind = YAML-KIND-STR
    ival = 0
    fval = 0.0
    n = t.len-bytes()
    n == 0 -> return
    i = 0
    neg = false
    c = t.byte(0)
    c == 45 -> {
        neg = true
        i = 1
    }
    c == 43 -> i = 1
    i >= n -> return

    ; start: 數字正文起點（跳過符號），供十進制解析使用
    start = i

    ; 進制前綴 0x / 0o
    c = t.byte(i)
    c == 48 -> {

        #{overflow=wrap}
        j = i + 1
        j < n -> {
            x = t.byte(j)
            x == 120 || x == 88 -> {

                #{overflow=wrap}
                s = j + 1
                k = YAML-KIND-STR
                v = 0
                k, v = parse-radix(t, s, 16)
                k == YAML-KIND-INT -> {
                    neg -> {
                        {

                            #{overflow=wrap}
                            v-opt2 = 0 - v
                            v-opt2: {
                                ok -> v = it

                                ->
                            }
                        }
                    }
                    kind = YAML-KIND-INT
                    ival = v
                }
                return
            }
            x == 111 || x == 79 -> {
                {

                    #{overflow=wrap}
                    s-opt = j + 1
                    s-opt: {
                        ok -> s = it

                        ->
                    }
                }
                k = YAML-KIND-STR
                v = 0
                k, v = parse-radix(t, s, 8)
                k == YAML-KIND-INT -> {
                    neg -> {
                        {

                            #{overflow=wrap}
                            v-opt3 = 0 - v
                            v-opt3: {
                                ok -> v = it

                                ->
                            }
                        }
                    }
                    kind = YAML-KIND-INT
                    ival = v
                }
                return
            }
        }
    }

    ; 十進制
    digits = 0
    has-dot = false
    has-exp = false
    (i < n) {
        i >= n -> break
        c = t.byte(i)
        c == 95 -> {
            {

                #{overflow=wrap}
                i-opt4 = i + 1
                i-opt4: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        c >= 48 && c <= 57 -> {
            {

                #{overflow=wrap}
                digits-opt2 = digits + 1
                digits-opt2: {
                    ok -> digits = it

                    ->
                }
            }

            {

                #{overflow=wrap}
                i-opt5 = i + 1
                i-opt5: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        c == 46 -> {
            has-dot -> break
            has-dot = true

            {

                #{overflow=wrap}
                i-opt6 = i + 1
                i-opt6: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        c == 101 || c == 69 -> {
            has-exp -> break
            digits == 0 -> break
            has-exp = true

            {

                #{overflow=wrap}
                i-opt7 = i + 1
                i-opt7: {
                    ok -> i = it

                    ->
                }
            }
            i < n -> {
                s = t.byte(i): {
                    ok -> it

                    -> 0
                }

                s == 45 || s == 43 -> {
                    {

                        #{overflow=wrap}
                        i-opt8 = i + 1
                        i-opt8: {
                            ok -> i = it

                            ->
                        }
                    }
                }
            }
            continue
        }
        break
    }

    i != n -> return
    digits == 0 -> return

    has-dot || has-exp -> {
        fv ?f64 = to-f64(t)
        fv: {
            nil -> return

            err -> return

            ok -> {
                kind = YAML-KIND-FLOAT
                fval = it
            }
        }
        return
    }

    k = YAML-KIND-STR
    v = 0
    k, v = parse-radix(t, start, 10)
    k == YAML-KIND-INT -> {
        neg -> {
            {

                #{overflow=wrap}
                v-opt4 = 0 - v
                v-opt4: {
                    ok -> v = it

                    ->
                }
            }
        }
        kind = YAML-KIND-INT
        ival = v
    }
}

; 按 core schema 推斷 plain 標量類型
; text: plain 標量原文
; kind: 推斷出的節點種類（null/bool/int/float/str 等）
; ival: kind=INT 時的整數值
; fval: kind=FLOAT 時的浮點值
; bval: kind=BOOL 時的布爾值
; [resolve-plain](#yaml.resolve-plain)
resolve-plain = (text str) (kind i64, ival i64, fval f64, bval bool) {
    kind = YAML-KIND-STR
    ival = 0
    fval = 0.0
    bval = false
    text.len-bytes() == 0 -> {
        kind = YAML-KIND-NULL
        return
    }
    {
        text == '~' || text == 'null' || text == 'Null' || text == 'NULL' -> {
            kind = YAML-KIND-NULL
            return
        }

        text == 'true' || text == 'True' || text == 'TRUE' -> {
            kind = YAML-KIND-BOOL
            bval = true
            return
        }

        text == 'false' || text == 'False' || text == 'FALSE' -> {
            kind = YAML-KIND-BOOL
            bval = false
            return
        }

        text == '.inf' || text == '.Inf' || text == '.INF' -> {
            kind = YAML-KIND-FLOAT
            fval = inf()
            return
        }

        text == '+.inf' || text == '+.Inf' || text == '+.INF' -> {
            kind = YAML-KIND-FLOAT
            fval = inf()
            return
        }

        text == '-.inf' || text == '-.Inf' || text == '-.INF' -> {
            kind = YAML-KIND-FLOAT
            fval = 0.0 - inf()
            return
        }

        text == '.nan' || text == '.NaN' || text == '.NAN' -> {
            kind = YAML-KIND-FLOAT
            fval = nan()
            return
        }
    }
    k = YAML-KIND-STR
    iv = 0
    fv = 0.0
    k, iv, fv = scan-number(text)
    {
        k == YAML-KIND-INT -> {
            kind = k
            ival = iv
            return
        }

        k == YAML-KIND-FLOAT -> {
            kind = k
            fval = fv
        }
    }
}

; 歸一化標簽名（!!str / tag:yaml.org,2002:str → str）
; tag: 原始標簽（!!str / tag:yaml.org,2002:str 等寫法）
; name: 歸一化後的短標簽名（str/int/seq...）
; [tag-name](#yaml.tag-name)
tag-name = (tag str) (name str) {
    name = tag
    name.starts-with('!<') -> {
        n = name.len-bytes()

        #{overflow=wrap}
        n >= 3 -> name = name.slice-bytes(2, n - 1)
    }
    name.starts-with('!!') -> name = name.slice-bytes(2, name.len-bytes())
    name.starts-with('tag:yaml.org,2002:') -> name = name.slice-bytes(18, name.len-bytes())
}

; 按顯式標簽决定節點類型
; tag: 歸一化標簽名
; kind: 按內容推斷的節點種類
; k: 標簽覆蓋後的最終種類（標簽未識别時返回原 kind）
; [apply-tag](#yaml.apply-tag)
apply-tag = (tag str, kind i64) (k i64) {
    k = kind
    name = tag-name(tag)
    {
        name == 'str' -> {
            k = YAML-KIND-STR
            return
        }

        name == 'null' -> {
            k = YAML-KIND-NULL
            return
        }

        name == 'bool' -> {
            k = YAML-KIND-BOOL
            return
        }

        name == 'int' -> {
            k = YAML-KIND-INT
            return
        }

        name == 'float' -> {
            k = YAML-KIND-FLOAT
            return
        }

        -> k = kind
    }
}

; 處理雙引號轉義序列
; body: 雙引號內的字符串內容（含轉義序列）
; out: 反轉義後的文本（nil=含非法轉義）
; [unescape-double](#yaml.unescape-double)
unescape-double = (body str) (out ?str) {
    acc = ''
    i = 0
    n = body.len-bytes()
    (i < n) {
        i >= n -> break
        c = body.byte(i): {
            ok -> it

            -> _
        }
        c != 92 -> {
            u1 char = c
            acc = acc - u1.to-str()

            #{overflow=wrap}
            i ?= i + 1
            continue
        }

        #{overflow=wrap}
        i ?= i + 1
        i >= n -> return
        e = body.byte(i)

        #{overflow=wrap}
        i ?= i + 1
        {
            e == 110 -> acc = acc - '\n'

            e == 116 -> acc = acc - '\t'

            e == 114 -> acc = acc - '\r'

            e == 48 -> acc = acc - '\0'

            e == 97 -> acc = acc - '\x07'

            e == 98 -> acc = acc - '\x08'

            e == 118 -> acc = acc - '\x0b'

            e == 102 -> acc = acc - '\x0c'

            e == 101 -> acc = acc - '\x1b'

            e == 34 -> acc = acc - '"'

            e == 47 -> acc = acc - '/'

            e == 92 -> acc = acc - '\\'

            e == 32 -> acc = acc - ' '

            e == 120 -> {

                #{overflow=wrap}
                j = i + 2
                j <= n -> {
                    cp = 0
                    k <- [0..2): {

                        #{overflow=wrap}
                        d = hex-digit(body.byte(i + k))
                        d < 0 -> return

                        #{overflow=wrap}
                        cp ?= cp * 16 + d
                    }
                    i = j: {
                        ok -> it

                        -> 0
                    }
                    ucp1 char = cp
                    acc = acc - ucp1.to-str()
                    continue
                }
                return
            }

            e == 117 -> {

                #{overflow=wrap}
                j ?= i + 4
                j <= n -> {
                    cp = 0
                    k <- [0..4): {

                        #{overflow=wrap}
                        d = hex-digit(body.byte(i + k))
                        d < 0 -> return

                        #{overflow=wrap}
                        cp ?= cp * 16 + d
                    }
                    i = j: {
                        ok -> it

                        -> 0
                    }
                    ucp2 char = cp
                    acc = acc - ucp2.to-str()
                    continue
                }
                return
            }

            e == 85 -> {

                #{overflow=wrap}
                j ?= i + 8
                j <= n -> {
                    cp = 0
                    k <- [0..8): {

                        #{overflow=wrap}
                        d = hex-digit(body.byte(i + k))
                        d < 0 -> return

                        #{overflow=wrap}
                        cp ?= cp * 16 + d
                    }
                    i = j: {
                        ok -> it

                        -> 0
                    }
                    ucp3 char = cp
                    acc = acc - ucp3.to-str()
                    continue
                }
                return
            }

            -> {
                return
            }
        }
    }
    out = acc
}

; 標量節點構造
...

; 依據風格與標簽構造標量節點
; text: 標量文本
; style: 標量風格（YAML-STYLE-* 常量）
; tag: 顯式標簽（空=按 core schema 推斷類型）
; anchor: 锚點名（空=無）
; idx: 新建節點的池索引
; [push-scalar](#yaml.parser.push-scalar)
parser.push-scalar = (text str, style i64, tag str, anchor str) (idx i64) {
    kind = YAML-KIND-STR
    ival = 0
    fval = 0.0
    bval = false
    style == YAML-STYLE-PLAIN -> {
        kind, ival, fval, bval = resolve-plain(text)
    }
    nd = node{
        kind: kind
        style: style
        tag: tag
        anchor: anchor
        text: text
        ival: ival
        fval: fval
        bval: bval
        line: .line
        col: 0
    }
    idx = .push-node(nd)

    ; 顯式標簽可能來自本次呼叫，也可能稍後由 set-props 補上；兩條路徑共用
    ; apply-tag-at，避免「推斷完就定案」的兩份實作漂移。
    .apply-tag-at(idx)
}

; 屬性（锚點 / 標簽）
...

; 讀取一個不含分隔符的裸 token
; out: 讀到的裸 token（遇空白/指示符即終止）
; [read-token](#yaml.parser.read-token)
parser.read-token = () (out str) {
    start = .pos
    !! {
        c = .cur()
        c == 0 || c == 32 || c == 9 || c == 10 || c == 13 -> break
        c == 44 || c == 91 || c == 93 || c == 123 || c == 125 -> break
        .advance()
    }
    out = .src.slice-bytes(start, .pos)
}

; 讀取一個標簽（!!name / !name / !<verbatim> / !）
; out: 標簽全文（含 ! 前綴；裸 ! 返回 ';!'）
; [read-tag](#yaml.parser.read-tag)
parser.read-tag = () (out str) {
    start = .pos
    .at(1) == 60 -> {
        .advance()
        .advance()
        !! {
            c = .cur()
            c == 0 || c == 10 || c == 13 -> break
            c == 62 -> {
                .advance()
                break
            }
            .advance()
        }
        out = .src.slice-bytes(start, .pos)
        return
    }
    .advance()
    !! {
        c = .cur()
        c == 0 || c == 32 || c == 9 || c == 10 || c == 13 -> break
        c == 44 || c == 91 || c == 93 || c == 123 || c == 125 -> break
        .advance()
    }
    out = .src.slice-bytes(start, .pos)
}

; 解析節點前綴的锚點與標簽（順序任意）
; tag: 讀到的標簽（空串=無）
; anchor: 讀到的锚點名（空串=無；非空時已登記入锚點表）
; [parse-props](#yaml.parser.parse-props)
parser.parse-props = () (tag str, anchor str) {
    tag = ''
    anchor = ''
    !! {
        c = .cur()
        c == 38 -> {
            .advance()
            anchor = .read-token()
            .skip-spaces()
            continue
        }
        c == 33 -> {
            tag = .read-tag()
            .skip-spaces()
            continue
        }
        break
    }
}

; 結構探測
...

; 當前位置是否為序列项指示符 '- '
; yes: 當前位置是序列项指示符（'- ' 或行尾的 '-'）
; [is-seq-dash](#yaml.parser.is-seq-dash)
parser.is-seq-dash = () (yes bool) {
    yes = false
    .cur() != 45 -> return
    c = .at(1)
    yes = c == 0 || c == 32 || c == 9 || c == 10 || c == 13
}

; 本行是否存在頂層 ': ' 或行尾 ':' 或顯式键 '? '
; yes: 本行存在映射键指示符，可作映射條目處理
; [looks-like-map-entry](#yaml.parser.looks-like-map-entry)
parser.looks-like-map-entry = () (yes bool) {
    yes = false

    ; 計數器必須顯式標註 i64。寫成 `i = .pos` 由欄位推斷型別時，本函式下方
    ; 那批 `i-optN = i + N` ＋ `i-optN: { ok -> i = it ... }` 的兩步解包會
    ; 整批退化成普通 i64：`i + N` 不再是有號運算、不產生 `?i64`，`ok` 臂於是
    ; 變成「值與 ok 標籤常數比較」而永不命中，`i` 原地不動 → 死循環，整個
    ; yaml 解析卡死（`yaml.parse('abc')` 即可復現）。顯式標註後 `i + N` 才是
    ; `?i64`，`ok` 臂恢復為 option 對 option 的比較。
    i i64 = .pos
    depth = 0
    in-s = false
    in-d = false
    !! {
        i >= .n -> return
        c = .src.byte(i)
        c == 10 || c == 13 -> return
        in-s -> {
            c == 39 -> {

                #{overflow=wrap}
                j = i + 1
                j < .n -> {
                    .src.byte(j) == 39 -> {
                        {

                            #{overflow=wrap}
                            i-opt9 = i + 2
                            i-opt9: {
                                ok -> i = it

                                ->
                            }
                        }
                        continue
                    }
                }
                in-s = false
            }

            {

                #{overflow=wrap}
                i-opt10 = i + 1
                i-opt10: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        in-d -> {
            c == 92 -> {
                {

                    #{overflow=wrap}
                    i-opt11 = i + 2
                    i-opt11: {
                        ok -> i = it

                        ->
                    }
                }
                continue
            }
            c == 34 -> in-d = false

            {

                #{overflow=wrap}
                i-opt12 = i + 1
                i-opt12: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        c == 39 -> {
            in-s = true

            {

                #{overflow=wrap}
                i-opt13 = i + 1
                i-opt13: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        c == 34 -> {
            in-d = true

            {

                #{overflow=wrap}
                i-opt14 = i + 1
                i-opt14: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        c == 91 || c == 123 -> {
            {

                #{overflow=wrap}
                depth-opt = depth + 1
                depth-opt: {
                    ok -> depth = it

                    ->
                }
            }

            {

                #{overflow=wrap}
                i-opt15 = i + 1
                i-opt15: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        c == 93 || c == 125 -> {
            {

                #{overflow=wrap}
                depth-opt2 = depth - 1
                depth-opt2: {
                    ok -> depth = it

                    ->
                }
            }

            {

                #{overflow=wrap}
                i-opt16 = i + 1
                i-opt16: {
                    ok -> i = it

                    ->
                }
            }
            continue
        }
        depth == 0 && c == 35 -> {
            i == .pos -> return

            #{overflow=wrap}
            prev = .src.byte(i - 1)
            prev == 32 || prev == 9 -> return
        }
        depth == 0 && c == 58 -> {
            {

                #{overflow=wrap}
                j-opt = i + 1
                j-opt: {
                    ok -> j = it

                    ->
                }
            }
            j >= .n -> {
                yes = true
                return
            }
            nc = .src.byte(j)
            nc == 32 || nc == 9 || nc == 10 || nc == 13 -> {
                yes = true
                return
            }
        }
        depth == 0 && c == 63 -> {
            {

                #{overflow=wrap}
                j-opt2 = i + 1
                j-opt2: {
                    ok -> j = it

                    ->
                }
            }
            j >= .n -> {
                yes = true
                return
            }
            nc = .src.byte(j)
            nc == 32 || nc == 9 || nc == 10 || nc == 13 -> {
                yes = true
                return
            }
        }

        {

            #{overflow=wrap}
            i-opt17 = i + 1
            i-opt17: {
                ok -> i = it

                ->
            }
        }
    }
}

; 空行 / 注释跳過
...

; 跳過空行與整行注释，停在下一行內容起始處
; [skip-blank-lines](#yaml.parser.skip-blank-lines)
parser.skip-blank-lines = () {
    !! {
        .eof() -> break
        save = .pos
        .skip-spaces()
        .at-eol() -> {
            .newline()
            continue
        }
        .cur() == 35 -> {
            .skip-to-eol()
            .newline()
            continue
        }
        .pos = save
        break
    }
}

; 讀取當前位置到行尾的內容（去掉行尾空白與注释）
; out: 到行尾的文本（已去行尾空白與 # 注释）
; [read-line-content](#yaml.parser.read-line-content)
parser.read-line-content = () (out str) {
    start = .pos
    !! {
        .at-eol() -> break
        c = .cur()
        c == 35 -> {
            .pos > start -> {
                prev = .at(-1)
                prev == 32 || prev == 9 -> break
            }
        }
        .advance()
    }
    out = .src.slice-bytes(start, .pos).trim()
    .skip-to-eol()
}

; 標量解析
...

; 解析 plain 標量（含跨行摺疊）
; cont-min: 跨行摺疊續行所需的最小縮進列（0=不跨行續接）
; key-mode: true=作映射键解析，遇 ': ' 等指示符即終止
; flow: true=流上下文（',' '}' ']' 亦終止）
; idx: 新建標量節點的池索引
; [parse-plain](#yaml.parser.parse-plain)
parser.parse-plain = (cont-min i64, key-mode bool, flow bool) (idx i64) {
    start = .pos
    !! {
        .at-eol() -> break
        c = .cur()
        flow -> {
            c == 44 || c == 93 || c == 125 -> break
            c == 58 -> {

                #{overflow=wrap}
                j = .pos + 1
                j >= .n -> break
                nc = .src.byte(j)
                nc == 32 || nc == 9 || nc == 10 || nc == 13 || nc == 44 || nc == 93 || nc == 125 -> break
            }
        }
        key-mode -> {
            c == 58 -> {

                #{overflow=wrap}
                j = .pos + 1
                j >= .n -> break
                nc = .src.byte(j)
                nc == 32 || nc == 9 || nc == 10 || nc == 13 -> break
            }
        }
        c == 35 -> {
            .pos > start -> {
                prev = .at(-1)
                prev == 32 || prev == 9 -> break
            }
        }
        .advance()
    }
    text = .src.slice-bytes(start, .pos).trim()

    key-mode || flow -> {
        idx = .push-scalar(text, YAML-STYLE-PLAIN, '', '')
        return
    }

    ; 跨行摺疊：僅塊上下文
    breaks = 0
    stop = false
    !! {
        stop -> break
        .skip-to-eol()
        .eof() -> break
        .newline()
        .eof() -> break
        !! {
            ls = .pos
            .skip-spaces()
            .at-eol() -> {
                .newline()

                {

                    #{overflow=wrap}
                    breaks-opt = breaks + 1
                    breaks-opt: {
                        ok -> breaks = it

                        ->
                    }
                }
                continue
            }

            #{overflow=wrap}
            ind = .pos - ls
            ind < cont-min -> {
                .pos = ls
                stop = true
                break
            }

            ; 續行若看起來像映射條目或序列项，就不是標量的延續（塊上下文禁止）
            .is-seq-dash() -> {
                .pos = ls
                stop = true
                break
            }
            .looks-like-map-entry() -> {
                .pos = ls
                stop = true
                break
            }

            breaks == 0 -> text = text - ' '
            breaks > 0 -> {
                k <- [0..breaks): text = text - '\n'
            }
            more = .read-line-content()
            text = text - more
            breaks = 0
            break
        }
    }

    idx = .push-scalar(text, YAML-STYLE-PLAIN, '', '')
}

; 解析單引號標量
; idx: 新建標量節點的池索引
; [parse-single](#yaml.parser.parse-single)
parser.parse-single = () (idx i64) {
    .advance()
    out = ''
    closed = false
    !! {
        .eof() -> break
        c = .cur()
        c == 39 -> {
            .at(1) == 39 -> {
                out = out - '\''
                .advance()
                .advance()
                continue
            }
            .advance()
            closed = true
            break
        }
        c == 10 || c == 13 -> {
            .newline()
            .skip-spaces()
            out = out - ' '
            continue
        }
        sc char = c
        out = out - sc.to-str()
        .advance()
    }
    closed == false -> .fail-at('unterminated single-quoted scalar')
    idx = .push-scalar(out, YAML-STYLE-SINGLE, '', '')
}

; 解析雙引號標量
; idx: 新建標量節點的池索引（轉義已處理）
; [parse-double](#yaml.parser.parse-double)
parser.parse-double = () (idx i64) {
    .advance()
    raw = ''
    closed = false
    !! {
        .eof() -> break
        c = .cur()
        c == 34 -> {
            .advance()
            closed = true
            break
        }
        c == 10 || c == 13 -> {
            .newline()
            .skip-spaces()
            raw = raw - ' '
            continue
        }
        c == 92 -> {
            raw = raw - '\\'

            #{overflow=wrap}
            i = .pos + 1
            i < .n -> {
                e-b = .src.byte(i): {
                    ok -> it

                    -> _
                }
                e char = e-b
                raw = raw - e.to-str()
                .advance()
            }
            .advance()
            continue
        }
        dc char = c
        raw = raw - dc.to-str()
        .advance()
    }
    closed == false -> {
        .fail-at('unterminated double-quoted scalar')
        idx = .push-null()
        return
    }
    text = ''
    uopt = unescape-double(raw)
    uopt: {
        ok -> text = it

        -> .fail-at('invalid escape sequence in double-quoted scalar')
    }
    idx = .push-scalar(text, YAML-STYLE-DOUBLE, '', '')
}

; 解析别名 *name
; idx: 别名指向的節點索引（-1=锚點不存在，已記錄錯誤）
; [parse-alias](#yaml.parser.parse-alias)
parser.parse-alias = () (idx i64) {
    .advance()
    name = .read-token()
    target = .anchor-id(name)
    target < 0 -> {
        .fail-at('unknown anchor *' - name)
        idx = .push-null()
        return
    }
    src = .nodes[target]: {
        ok -> it

        -> _
    }
    nd = node{
        kind: src.kind
        style: YAML-STYLE-ALIAS
        tag: src.tag
        anchor: ''
        text: src.text
        ival: src.ival
        fval: src.fval
        bval: src.bval
        keys: src.keys
        kids: src.kids
        line: .line
        col: 0
    }
    idx = .push-node(nd)
}

; 解析塊標量 | 與 >
; cont-min: 塊內容必須達到的縮進列（由調用上下文傳入）
; idx: 新建塊標量節點的池索引
; [parse-block-scalar](#yaml.parser.parse-block-scalar)
parser.parse-block-scalar = (cont-min i64) (idx i64) {
    style = YAML-STYLE-LITERAL
    .cur() == 62 -> style = YAML-STYLE-FOLDED
    .advance()
    chomp = YAML-CHOMP-CLIP
    ind-ind = 0
    !! {
        c = .cur()
        c == 45 -> {
            chomp = YAML-CHOMP-STRIP
            .advance()
            continue
        }
        c == 43 -> {
            chomp = YAML-CHOMP-KEEP
            .advance()
            continue
        }
        c >= 49 && c <= 57 -> {
            {

                #{overflow=wrap}
                ind-ind-opt = c - 48
                ind-ind-opt: {
                    ok -> ind-ind = it

                    ->
                }
            }
            .advance()
            continue
        }
        c == 35 -> .skip-to-eol()
        break
    }
    .newline()
    .eof() -> {
        idx = .push-scalar('', style, '', '')
        return
    }

    ; D1：`-` 的結果恆為 `?i64`，parent-indent 只作縮排整數用 → 兩段式 match 解包。
    #{overflow=wrap}
    parent-indent = cont-min - 1: {
        ok -> it

        -> 0
    }

    content-ind = 0
    ind-ind > 0 -> {
        {

            #{overflow=wrap}
            content-ind-opt = parent-indent + ind-ind
            content-ind-opt: {
                ok -> content-ind = it

                ->
            }
        }
    }
    ind-ind == 0 -> {
        save = .pos
        !! {
            .eof() -> break
            ls = .pos
            .skip-spaces()
            .at-eol() -> {
                .newline()
                continue
            }

            #{overflow=wrap}
            content-ind = .pos - ls: {
                ok -> it

                ->
            }
            .pos = save
            break
        }
    }

    lines []str = with-len(0)
    !! {
        .eof() -> break
        ls = .pos
        .skip-spaces()

        #{overflow=wrap}
        ind = .pos - ls
        .at-eol() -> {
            lines.push('')
            .newline()
            continue
        }
        ind < content-ind -> {
            .pos = ls
            break
        }
        le = .line-end-of(.pos)

        #{overflow=wrap}
        from = ls + content-ind
        lines.push(.src.slice-bytes(from, le))
        .pos = le
        .newline()
    }

    ; 尾部空行數
    trail = 0
    !! {

        #{overflow=wrap}
        last = lines.len() - 1 - trail
        last < 0 -> break
        tail = str-at(lines, last)
        tail.len-bytes() == 0 -> {
            {

                #{overflow=wrap}
                trail-opt = trail + 1
                trail-opt: {
                    ok -> trail = it

                    ->
                }
            }
            continue
        }
        break
    }

    content = ''
    style == YAML-STYLE-LITERAL -> {
        i <- [0..lines.len()): {
            content = content - str-at(lines, i) - '\n'
        }
        content.len-bytes() > 0 -> {

            #{overflow=wrap}
            content = content.slice-bytes(0, content.len-bytes() - 1)
        }
    }
    style == YAML-STYLE-FOLDED -> {
        pending = 0
        first = true
        i <- [0..lines.len()): {
            ln = str-at(lines, i)
            ln.len-bytes() == 0 -> {
                {

                    #{overflow=wrap}
                    pending-opt = pending + 1
                    pending-opt: {
                        ok -> pending = it

                        ->
                    }
                }
                continue
            }
            more = ln.byte(0) == 32 || ln.byte(0) == 9
            first -> {
                content = ln
                first = false
                pending = 0
                continue
            }
            more -> {
                k <- [0..pending + 1): content = content - '\n'
            }
            more == false -> {
                pending == 0 -> content = content - ' '
                pending > 0 -> {
                    k <- [0..pending): content = content - '\n'
                }
            }
            content = content - ln
            pending = 0
        }
    }

    {
        chomp == YAML-CHOMP-STRIP -> {
            ; 無尾随換行
        }

        chomp == YAML-CHOMP-KEEP -> {
            content.len-bytes() > 0 || trail > 0 -> {
                content = content - '\n'
                k <- [0..trail): content = content - '\n'
            }
        }

        -> {
            content.len-bytes() > 0 -> content = content - '\n'
        }
    }

    idx = .push-scalar(content, style, '', '')
}

; 流式集合
...

; 解析一個流上下文節點
; cont-min: 傳遞給嵌套標量解析的最小續行縮進
; key-mode: true=按键位置解析
; flow: true=流上下文
; idx: 解析出的節點池索引
; [parse-flow-node](#yaml.parser.parse-flow-node)
parser.parse-flow-node = (cont-min i64, key-mode bool, flow bool) (idx i64) {
    tag = ''
    anchor = ''
    tag, anchor = .parse-props()
    .skip-spaces()
    c = .cur()
    {
        c == 91 -> {
            idx = .parse-flow-seq()
            .set-props(idx, tag, anchor)
            return
        }

        c == 123 -> {
            idx = .parse-flow-map()
            .set-props(idx, tag, anchor)
            return
        }

        c == 34 -> {
            idx = .parse-double()
            .set-props(idx, tag, anchor)
            return
        }

        c == 39 -> {
            idx = .parse-single()
            .set-props(idx, tag, anchor)
            return
        }

        c == 42 -> {
            idx = .parse-alias()
            .set-props(idx, tag, anchor)
            return
        }

        -> {
            idx = .parse-plain(cont-min, key-mode, flow)
            .set-props(idx, tag, anchor)
        }
    }
}

; 流式上下文的空白——行內空格、換行與注释
; [skip-flow-ws](#yaml.parser.skip-flow-ws)
parser.skip-flow-ws = () {
    !! {
        .skip-spaces()

        ; EOF guard: at-eol() is true at EOF (c==0) but newline() does not advance,
        ; so an unterminated flow (e.g. [1 without ]) would spin forever here.
        .eof() -> break
        .at-eol() -> {
            .newline()
            continue
        }
        .cur() == 35 -> {
            .skip-to-eol()
            .newline()
            continue
        }
        break
    }
}

; 解析 [a, b, ...]
; idx: 新建序列節點的池索引
; [parse-flow-seq](#yaml.parser.parse-flow-seq)
parser.parse-flow-seq = () (idx i64) {
    .advance()
    kids []i64 = with-len(0)
    !! {
        .skip-spaces()
        .eof() -> break
        .cur() == 93 -> {
            .advance()
            break
        }
        .cur() == 44 -> {
            .advance()
            continue
        }
        .cur() == 35 -> {
            .skip-to-eol()
            .newline()
            continue
        }
        .at-eol() -> {
            .newline()
            continue
        }
        child = .parse-flow-node(0, false, true)
        kids.push(child)
        .failed -> break
        .skip-flow-ws()
        .eof() -> break
        c = .cur()
        c == 93 -> {
            .advance()
            break
        }
        c == 44 -> {
            .advance()
            continue
        }
        .fail-at('expected , or ] in flow sequence')
        break
    }
    nd = node{
        kind: YAML-KIND-SEQ
        style: YAML-STYLE-FLOW
        tag: ''
        anchor: ''
        text: ''
        ival: 0
        fval: 0.0
        bval: false
        kids: kids
        line: .line
        col: 0
    }
    idx = .push-node(nd)
}

; 解析 {k: v, ...}
; idx: 新建映射節點的池索引
; [parse-flow-map](#yaml.parser.parse-flow-map)
parser.parse-flow-map = () (idx i64) {
    .advance()
    keys []i64 = with-len(0)
    vals []i64 = with-len(0)
    !! {
        .skip-spaces()
        .eof() -> break
        .cur() == 125 -> {
            .advance()
            break
        }
        .cur() == 44 -> {
            .advance()
            continue
        }
        .cur() == 35 -> {
            .skip-to-eol()
            .newline()
            continue
        }
        .at-eol() -> {
            .newline()
            continue
        }
        .cur() == 63 -> {
            c2 = .at(1)
            c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 -> .advance()
        }
        key = .parse-flow-node(0, true, true)
        .failed -> break
        .skip-flow-ws()
        .eof() -> break
        .cur() != 58 -> {
            .fail-at('expected : in flow mapping')
            break
        }
        .advance()
        .skip-flow-ws()
        val = .parse-flow-node(0, false, true)
        .failed -> break
        keys.push(key)
        vals.push(val)
        .skip-flow-ws()
        .eof() -> break
        c = .cur()
        c == 125 -> {
            .advance()
            break
        }
        c == 44 -> {
            .advance()
            continue
        }
        .fail-at('expected , or } in flow mapping')
        break
    }
    nd = node{
        kind: YAML-KIND-MAP
        style: YAML-STYLE-FLOW
        tag: ''
        anchor: ''
        text: ''
        ival: 0
        fval: 0.0
        bval: false
        keys: keys
        kids: vals
        line: .line
        col: 0
    }
    idx = .push-node(nd)
}

; 塊結構
...

; 解析縮進更深的後續行作為值
; parent-indent: 父键行縮進列（後續行須比它更深才視為值）
; idx: 解析出的值節點池索引
; [parse-block-indented](#yaml.parser.parse-block-indented)
parser.parse-block-indented = (parent-indent i64) (idx i64) {
    .skip-blank-lines()
    .eof() -> {
        idx = .push-null()
        return
    }
    ind = .indent-at()
    ind <= parent-indent -> {
        idx = .push-null()
        return
    }
    ind == 0 -> {
        .at(0) == 45 && .at(1) == 45 && .at(2) == 45 -> {
            idx = .push-null()
            return
        }
        .at(0) == 46 && .at(1) == 46 && .at(2) == 46 -> {
            idx = .push-null()
            return
        }
    }
    idx = .parse-block(ind, ind)
}

; 解析塊序列
; indent: 序列项 '-' 的縮進列（同級项與回退判定基準）
; idx: 新建序列節點的池索引
; [parse-block-seq](#yaml.parser.parse-block-seq)
parser.parse-block-seq = (indent i64) (idx i64) {
    kids []i64 = with-len(0)
    !! {

        ; 消費 '-'
        .advance()
        .skip-spaces()
        {
            .at-eol() -> {
                .skip-to-eol()
                .newline()
                child = .parse-block-indented(indent)
            }

            .cur() == 35 -> {
                .skip-to-eol()
                .newline()
                child = .parse-block-indented(indent)
            }

            -> {
                col = .indent-at()

                #{overflow=wrap}
                child = .parse-block(col, indent + 1)
            }
        }
        .failed -> break
        kids.push(child)
        .skip-to-eol()
        .skip-blank-lines()
        .eof() -> break
        ia = .indent-at()
        ia != indent -> break
        .is-seq-dash() -> continue
        break
    }
    nd = node{
        kind: YAML-KIND-SEQ
        style: YAML-STYLE-BLOCK
        tag: ''
        anchor: ''
        text: ''
        ival: 0
        fval: 0.0
        bval: false
        kids: kids
        line: .line
        col: 0
    }
    idx = .push-node(nd)
}

; 把一個映射的條目合並進 keys/vals（不覆蓋已有键）
; 说明：MIR 後端不允許把入參 vec 直接 move 進另一個 vec（借用/所有權保護），
;       因此這里逐元素複製，而不是 ok-keys = keys。
; keys: 目標映射的键節點索引列表
; vals: 目標映射的值節點索引列表
; src: 待合並映射節點的索引（須為 MAP 種類）
; ok-keys: 合並後的键列表（已有键優先保留）
; ok-vals: 合並後的值列表
; [merge-one](#yaml.parser.merge-one)
parser.merge-one = (keys []i64, vals []i64, src i64) (ok-keys []i64, ok-vals []i64) {
    ok-keys = with-len(0)
    ok-vals = with-len(0)
    base = keys.len()
    b <- [0..base): {
        ixout2013c26 = keys[b]: {
            ok -> it

            -> _
        }

        ok-keys.push(ixout2013c26)
        ixout2014c26 = vals[b]: {
            ok -> it

            -> _
        }

        ok-vals.push(ixout2014c26)
    }
    src < 0 -> return
    {
        sn ?= .nodes[src]
        sn.kind != YAML-KIND-MAP -> return
        cnt = sn.keys.len()
        i <- [0..cnt): {
            k ?= sn.keys[i]
            dup = false
            total = ok-keys.len()
            j <- [0..total): {
                k2 = ok-keys[j]
                nk ?= .nodes[k]
                nk2 ?= .nodes[k2]
                key-eq(nk, nk2) -> dup = true
            }
            dup == false -> {
                ok-keys.push(k)
                kk ?= sn.kids[i]
                ok-vals.push(kk)
            }
        }
    }: {
        err -> return

        -> return
    }
}

; 合並键 << 的處理（支持映射或映射序列）
; keys: 目標映射的键節點索引列表
; vals: 目標映射的值節點索引列表
; src: 合並键(<<)的值節點索引（MAP 或 MAP 序列）
; ok-keys: 合並後的键列表
; ok-vals: 合並後的值列表
; [merge-into](#yaml.parser.merge-into)
parser.merge-into = (keys []i64, vals []i64, src i64) (ok-keys []i64, ok-vals []i64) {
    ok-keys = with-len(0)
    ok-vals = with-len(0)
    base = keys.len()
    b <- [0..base): {
        ixout2046c26 = keys[b]: {
            ok -> it

            -> _
        }

        ok-keys.push(ixout2046c26)
        ixout2047c26 = vals[b]: {
            ok -> it

            -> _
        }

        ok-vals.push(ixout2047c26)
    }
    src < 0 -> return
    {
        sn ?= .nodes[src]
        k = sn.kind
        k == YAML-KIND-MAP -> {
            ok-keys, ok-vals = .merge-one(ok-keys, ok-vals, src)
            return
        }
        k == YAML-KIND-SEQ -> {
            cnt = sn.kids.len()
            i <- [0..cnt): {
                ki ?= sn.kids[i]
                ok-keys, ok-vals = .merge-one(ok-keys, ok-vals, ki)
            }
        }
    }: {
        err -> return

        -> return
    }
}

; 解析塊映射
; indent: 映射键的縮進列（同層键與回退判定基準）
; idx: 新建映射節點的池索引
; [parse-block-map](#yaml.parser.parse-block-map)
parser.parse-block-map = (indent i64) (idx i64) {
    keys []i64 = with-len(0)
    vals []i64 = with-len(0)
    !! {
        key = -1
        .cur() == 63 && (.at(1) == 32 || .at(1) == 9) -> {
            .advance()
            .skip-spaces()
            {
                .at-eol() -> {
                    .skip-to-eol()
                    .newline()
                    key = .parse-block-indented(indent)
                }

                -> {
                    kc = .indent-at()

                    #{overflow=wrap}
                    key = .parse-block(kc, indent + 1)
                }
            }
            .failed -> break
            .skip-to-eol()
            .skip-blank-lines()
            .eof() -> break
            .indent-at() != indent -> {
                .fail-at('expected : for explicit key')
                break
            }
            .cur() != 58 -> {
                .fail-at('expected : for explicit key')
                break
            }
            .advance()
            .skip-spaces()
        }
        key < 0 -> {

            #{overflow=wrap}
            key = .parse-flow-node(indent + 1, true, false)
            .failed -> break
            .skip-spaces()
            .cur() != 58 -> {
                .fail-at('expected : after mapping key')
                break
            }
            .advance()
            .skip-spaces()
        }
        val = -1
        .at-eol() -> {
            .skip-to-eol()
            .newline()
            val = .parse-block-indented(indent)
        }
        .cur() == 35 -> {
            .skip-to-eol()
            .newline()
            val = .parse-block-indented(indent)
        }
        val < 0 -> {
            vc = .indent-at()

            #{overflow=wrap}
            val = .parse-block(vc, indent + 1)
        }
        .failed -> break
        is-merge = false
        {
            nk ?= .nodes[key]
        }: {
            err -> _

            -> _
        }
        nk.kind == YAML-KIND-STR -> {
            nk.text.eq-full('<<') -> is-merge = true
        }
        is-merge -> {
            keys, vals = .merge-into(keys, vals, val)
        }
        is-merge == false -> {

            ; 同名键：本地值覆蓋已有條目（YAML 合並键語義）
            dup = -1
            total = keys.len()
            j <- [0..total): {
                kj = keys[j]: {
                    ok -> it

                    -> _
                }
                {
                    nkj ?= .nodes[kj]
                    key-eq(nk, nkj) -> {
                        dup = j
                        break
                    }
                }: {
                    err -> _

                    -> _
                }
            }
            dup >= 0 -> {
                vals[dup]: {
                    ok -> it = val

                    -> _
                }
            }
            dup < 0 -> {
                keys.push(key)
                vals.push(val)
            }
        }
        .skip-to-eol()
        .skip-blank-lines()
        .eof() -> break
        .indent-at() != indent -> break
        .looks-like-map-entry() -> continue
        break
    }
    nd = node{
        kind: YAML-KIND-MAP
        style: YAML-STYLE-BLOCK
        tag: ''
        anchor: ''
        text: ''
        ival: 0
        fval: 0.0
        bval: false
        keys: keys
        kids: vals
        line: .line
        col: 0
    }
    idx = .push-node(nd)
}

; 解析一個塊上下文節點（當前位置即節點起始列）
; indent: 節點起始列
; cont-min: 傳遞給子節點的最小續行縮進
; idx: 解析出的節點池索引
; [parse-block](#yaml.parser.parse-block)
parser.parse-block = (indent i64, cont-min i64) (idx i64) {
    tag = ''
    anchor = ''
    tag, anchor = .parse-props()
    .skip-spaces()
    c = .cur()
    c == 124 || c == 62 -> {
        idx = .parse-block-scalar(cont-min)
        .set-props(idx, tag, anchor)
        return
    }
    .at-eol() || c == 35 -> {
        .skip-to-eol()
        .newline()

        #{overflow=wrap}
        idx = .parse-block-indented(cont-min - 1)
        .set-props(idx, tag, anchor)
        return
    }
    c == 45 && .is-seq-dash() -> {
        idx = .parse-block-seq(indent)
        .set-props(idx, tag, anchor)
        return
    }
    .looks-like-map-entry() -> {
        idx = .parse-block-map(indent)
        .set-props(idx, tag, anchor)
        return
    }
    idx = .parse-flow-node(cont-min, false, false)
    .set-props(idx, tag, anchor)
}

; 文檔
...

; 跳過空行、注释與指令行
; [skip-doc-preamble](#yaml.parser.skip-doc-preamble)
parser.skip-doc-preamble = () {
    !! {
        .eof() -> break
        save = .pos
        .skip-spaces()
        .at-eol() -> {
            .newline()
            continue
        }
        c = .cur()
        c == 35 || c == 37 -> {
            .skip-to-eol()

            ; `%` 指令行必須自己推到行尾：`skip-to-eol` 只認 `#` 註釋，
            ; 對 `%YAML` / `%TAG` 一個字節都不前進，cur 仍停在 `%` 上，
            ; 下面的 newline() 於是回 false，`continue` 就成死循環
            ; （2026-11-11 修：`yaml.parse('%YAML 1.2\n---\na: 1')` 曾永久卡死）。
            !! {
                .at-eol() -> break
                .advance()
            }
            .newline()
            continue
        }
        .pos = save
        break
    }
}

; 當前位置是否為 --- (1) 或 ... (2)
; which: 1='---'、2='...'、0=非文檔標記
; [at-doc-marker](#yaml.parser.at-doc-marker)
parser.at-doc-marker = () (which i64) {
    which = 0
    .at(0) == 45 && .at(1) == 45 && .at(2) == 45 -> {
        which = 1
        return
    }
    .at(0) == 46 && .at(1) == 46 && .at(2) == 46 -> which = 2
}

; 跳過當前文檔剩餘內容，停在下一個 --- 或输入末尾
; [skip-to-doc-boundary](#yaml.parser.skip-to-doc-boundary)
parser.skip-to-doc-boundary = () {
    !! {
        .eof() -> break
        .skip-to-eol()
        .skip-blank-lines()
        .eof() -> break
        .indent-at() != 0 -> {
            .fail-at('unexpected indented content after document')
            break
        }
        w = .at-doc-marker()
        w == 0 -> {
            .fail-at('unexpected content after document')
            break
        }
        w == 2 -> {
            .advance()
            .advance()
            .advance()
            continue
        }
        break
    }
}

; 解析一份文檔，返回根節點索引
; idx: 本文檔根節點的池索引（-1=解析失败）
; [parse-document](#yaml.parser.parse-document)
parser.parse-document = () (idx i64) {
    w = .at-doc-marker()
    w == 1 -> {
        .advance()
        .advance()
        .advance()
        .skip-spaces()
        .at-eol() -> {
            .skip-to-eol()
            .newline()
            .skip-blank-lines()
            .eof() -> {
                idx = .push-null()
                return
            }
            .at-doc-marker() != 0 -> {
                idx = .push-null()
                return
            }
            ind = .indent-at()
            idx = .parse-block(ind, ind)
            return
        }
        .cur() == 35 -> {
            .skip-to-eol()
            .newline()
            .skip-blank-lines()
            .eof() -> {
                idx = .push-null()
                return
            }
            .at-doc-marker() != 0 -> {
                idx = .push-null()
                return
            }
            ind = .indent-at()
            idx = .parse-block(ind, ind)
            return
        }
        dc = .indent-at()
        idx = .parse-block(dc, dc)
        return
    }
    ind = .indent-at()
    idx = .parse-block(ind, ind)
}

; 解析全部文檔
; roots: 各文檔根節點的池索引列表
; [parse-docs](#yaml.parser.parse-docs)
parser.parse-docs = () (roots []i64) {
    roots = with-len(0)
    prev = -1
    !! {
        .failed -> break
        .pos == prev -> break
        prev = .pos
        .skip-doc-preamble()
        .eof() -> break
        idx = .parse-document()
        .failed -> break
        roots.push(idx)
        .skip-to-doc-boundary()
    }
}

; 入口
...

; 解析 YAML 文本，返回第一份文檔
; 返回 ok(yaml) / err(消息)
; source: YAML 源文本
; out: 第一份文檔的句柄（err=解析失败消息）
; [parse](#yaml.parse)
yaml.parse = (source str) (out ?yaml) {
    out = yaml.parse-all(source)
}

; 解析全部文檔
; source: 含多份文檔的 YAML 源文本
; out: 文檔集句柄（以 .doc(i) 逐份訪問）
; [parse-all](#yaml.parse-all)
yaml.parse-all = (source str) (out ?yaml) {
    out = nil
    src = yaml.strip-bom(source)
    p = parser{
        src: src
        n: src.len-bytes()
        pos: 0
        line: 1
        err: ''
        failed: false
    }
    roots []i64 = with-len(0)
    roots = p.parse-docs()
    p.failed -> {
        out = err(p.err)
        return
    }
    roots.len() == 0 -> {
        idx = p.push-null()
        roots.push(idx)
    }
    root = -1
    roots.len() > 0 -> {

        ; root 已在上方宣告為純量（`root = -1`），無法就地捕獲越界 option
        ; （`x = v[i]` 只在首次宣告時推斷為 `?elem`），故顯式標註越界語義。
        ; `roots.len() > 0` 已保證索引 0 合法，此預設值不可達。
        root = roots[0]: {
            ok -> it

            -> 0
        }
    }
    doc = yaml{
        node-pool: pool{
            nodes: p.nodes
        }
        root: root
        roots: roots
        source: src
    }
    out = doc
}

; 去掉開頭的 UTF-8 BOM
; s: 可能帶 BOM 的文本
; out: 去掉開頭 EF BB BF 後的文本
; [strip-bom](#yaml.strip-bom)
yaml.strip-bom = (s str) (out str) {
    out = s
    s.len-bytes() >= 3 -> {
        b0 = s.byte(0)
        b1 = s.byte(1)
        b2 = s.byte(2)
        b0 == 239 && b1 == 187 && b2 == 191 -> out = s.slice-bytes(3, s.len-bytes())
    }
}

; 查詢 API
...

; 本文檔是否解析成功（能拿到 yaml 值即成功）
; yes: 該句柄携帶成功解析的文檔
; [valid](#yaml.valid)
yaml.valid = () (yes bool) {
    yes = .roots.len() > 0 || .root >= 0
}

; 本文檔的解析錯誤（解析成功時恆為空串）
; 说明：解析失败時 yaml.parse 返回 err，拿不到 yaml 值；
;       失败原因請用 yaml.error-of(source) 获取。
; msg: 錯誤信息（解析成功時恆為空串）
; [error](#yaml.error)
yaml.error = () (msg str) {
    msg = ''
}

; 源文本是否可解析（不構造文檔）
; source: 待檢測的 YAML 源文本
; yes: 源文本可被解析
; [valid-of](#yaml.valid-of)
yaml.valid-of = (source str) (yes bool) {
    yes = false
    s = yaml.strip-bom(source)
    p = parser{
        src: s
        n: s.len-bytes()
        pos: 0
        line: 1
        err: ''
        failed: false
    }
    roots []i64 = with-len(0)
    roots = p.parse-docs()
    yes = ! p.failed
}

; 解析源文本並返回錯誤消息（成功時為空串）
; source: YAML 源文本
; msg: 解析錯誤消息（空串=成功）
; [error-of](#yaml.error-of)
yaml.error-of = (source str) (msg str) {
    msg = ''
    s = yaml.strip-bom(source)
    p = parser{
        src: s
        n: s.len-bytes()
        pos: 0
        line: 1
        err: ''
        failed: false
    }
    roots []i64 = with-len(0)
    roots = p.parse-docs()
    p.failed -> msg = p.err
}

; 文檔數量
; n: 本文檔集包含的文檔份數
; [doc-count](#yaml.doc-count)
yaml.doc-count = () (n i64) {
    n = .roots.len()
}

; 取第 i 份文檔
; 说明：子節點視圖以 ?yaml 返回，供調用方 match 解包。
; i: 文檔序號（0 起）
; out: 第 i 份文檔句柄（nil=越界）
; [doc](#yaml.doc)
yaml.doc = (i i64) (out ?yaml) {
    i < 0 -> return
    i >= .roots.len() -> return
    r = .roots[i]: {
        ok -> it

        -> _
    }
    out = yaml{
        node-pool: .node-pool
        root: r
        roots: .roots
        source: .source
    }
}

; 節點總數
; n: 節點池中的節點總數
; [node-count](#yaml.node-count)
yaml.node-count = () (n i64) {
    n = .node-pool.nodes.len()
}

; 當前節點類型
; k: 該節點的 YAML-KIND-* 種類常量
; [kind](#yaml.kind)
yaml.kind = () (k i64) {
    k = YAML-KIND-NULL
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        k = nd.kind
    }: {
        err -> return

        -> return
    }
}

; 當前節點風格
; s: 該節點的 YAML-STYLE-* 風格常量
; [style](#yaml.style)
yaml.style = () (s i64) {
    s = YAML-STYLE-PLAIN
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        s = nd.style
    }: {
        err -> return

        -> return
    }
}

; 當前節點顯式標簽
; t: 該節點的顯式標簽（空串=無）
; [tag](#yaml.tag)
yaml.tag = () (t str) {
    t = ''
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        t = nd.tag
    }: {
        err -> return

        -> return
    }
}

; 當前節點锚點名
; a: 該節點的锚點名（空串=無）
; [anchor](#yaml.anchor)
yaml.anchor = () (a str) {
    a = ''
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        a = nd.anchor
    }: {
        err -> return

        -> return
    }
}

; 當前節點起始行
; n: 節點起始所在行號
; [line-of](#yaml.line-of)
yaml.line-of = () (n i64) {
    n = 0
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        n = nd.line
    }: {
        err -> return

        -> return
    }
}

; 是否為 null
; yes: 節點為 null
; [is-null](#yaml.is-null)
yaml.is-null = () (yes bool) {
    yes = .kind() == YAML-KIND-NULL
}

; 是否為布爾
; yes: 節點為布爾值（true/false 及 YAML 别名寫法）
; [is-bool](#yaml.is-bool)
yaml.is-bool = () (yes bool) {
    yes = .kind() == YAML-KIND-BOOL
}

; 是否為整數
; yes: 節點為整數
; [is-int](#yaml.is-int)
yaml.is-int = () (yes bool) {
    yes = .kind() == YAML-KIND-INT
}

; yaml.is-float: 是否為浮點
; 當前節點是否為 .nan
; yes: 節點為 .nan
; [is-nan](#yaml.is-nan)
yaml.is-nan = () (yes bool) {
    yes = false
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        yes = node-is-nan(nd)
    }: {
        err -> return

        -> return
    }
}

; 判斷是否 float
; yes: 節點為浮點數
; [is-float](#yaml.yaml.is-float)
yaml.is-float = () (yes bool) {
    yes = .kind() == YAML-KIND-FLOAT
}

; 是否為數值
; yes: 節點為整數或浮點數
; [is-num](#yaml.is-num)
yaml.is-num = () (yes bool) {
    k = .kind()
    yes = k == YAML-KIND-INT || k == YAML-KIND-FLOAT
}

; 是否為字符串
; yes: 節點為字符串
; [is-str](#yaml.is-str)
yaml.is-str = () (yes bool) {
    yes = .kind() == YAML-KIND-STR
}

; 是否為序列
; yes: 節點為序列
; [is-seq](#yaml.is-seq)
yaml.is-seq = () (yes bool) {
    yes = .kind() == YAML-KIND-SEQ
}

; 是否為映射
; yes: 節點為映射
; [is-map](#yaml.is-map)
yaml.is-map = () (yes bool) {
    yes = .kind() == YAML-KIND-MAP
}

; 序列元素數 / 映射條目數
; n: 序列元素數或映射键值對數（其他類型為 0）
; [len](#yaml.len)
yaml.len = () (n i64) {
    n = 0
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        n = nd.kids.len()
    }: {
        err -> return

        -> return
    }
}

; 當前節點的標量原文
; t: 標量原文（容器節點為空串）
; [text](#yaml.text)
yaml.text = () (t str) {
    t = ''
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    {
        nd ?= .node-pool.nodes[.root]
        t = nd.text
    }: {
        err -> return

        -> return
    }
}

; 取字符串值（數值/布爾返回其原文）
; val: 標量原文（nil=容器節點）
; [str](#yaml.str)
yaml.str = () (val ?str) {
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    k ?= .node-pool.nodes[.root].kind
    k == YAML-KIND-SEQ || k == YAML-KIND-MAP || k == YAML-KIND-NULL -> return
    val ?= .node-pool.nodes[.root].text
}

; 取整數值
; val: 整數值（nil=非整數節點）
; [i64](#yaml.i64)
yaml.i64 = () (val ?i64) {
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    k ?= .node-pool.nodes[.root].kind
    k == YAML-KIND-INT -> {
        val ?= .node-pool.nodes[.root].ival
        return
    }
    k == YAML-KIND-FLOAT -> {

        ; val 是 i64 出參，fval 是 f64：必須顯式轉換，不能靠隱式截斷
        val ?= .node-pool.nodes[.root].fval.to-i64()
    }
}

; 取浮點值
; val: 浮點值（nil=非浮點節點）
; [f64](#yaml.f64)
yaml.f64 = () (val ?f64) {
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    k ?= .node-pool.nodes[.root].kind
    k == YAML-KIND-FLOAT -> {
        val ?= .node-pool.nodes[.root].fval
        return
    }
    k == YAML-KIND-INT -> {
        val ?= .node-pool.nodes[.root].ival.to-f64()
    }
}

; 取布爾值
; val: 布爾值（nil=非布爾節點）
; [bool](#yaml.bool)
yaml.bool = () (val ?bool) {
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    k ?= .node-pool.nodes[.root].kind
    k == YAML-KIND-BOOL -> {
        val ?= .node-pool.nodes[.root].bval
    }
}

; 取序列元素 / 映射第 i 個值
; i: 序列下標 / 映射的第 i 對键值（0 起）
; out: 對應值節點（nil=越界或類型不符）
; [at](#yaml.at)
yaml.at = (i i64) (out ?yaml) {
    i < 0 -> return
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    nd ?= .node-pool.nodes[.root]
    cnt = nd.kids.len()
    i >= cnt -> return
    k ?= nd.kids[i]
    out = yaml{
        node-pool: .node-pool
        root: k
        roots: .roots
        source: .source
    }
}

; 取映射第 i 個键節點
; i: 键值對序號（0 起）
; out: 第 i 個键節點（nil=越界或非映射）
; [key-node](#yaml.key-node)
yaml.key-node = (i i64) (out ?yaml) {
    i < 0 -> return
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    nd ?= .node-pool.nodes[.root]
    cnt = nd.keys.len()
    i >= cnt -> return
    k ?= nd.keys[i]
    out = yaml{
        node-pool: .node-pool
        root: k
        roots: .roots
        source: .source
    }
}

; 取映射第 i 個键的文本
; i: 键值對序號（0 起）
; out: 第 i 個键的標量文本（nil=越界或非映射）
; [key](#yaml.key)
yaml.key = (i i64) (out ?str) {
    knopt = .key-node(i)
    knopt: {
        ok -> out = it.scalar-text()

        -> _
    }
}

; 取映射第 i 個键對應的值節點
; i: 键值對序號（0 起）
; out: 第 i 對键的值節點（nil=越界或非映射）
; [value](#yaml.value)
yaml.value = (i i64) (out ?yaml) {
    out = .at(i)
}

; 按標量键取映射值
; key: 要查找的標量键文本
; out: 對應的值節點（nil=键不存在或非映射）
; [get](#yaml.get)
yaml.get = (key str) (out ?yaml) {
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    nd ?= .node-pool.nodes[.root]
    nd.kind != YAML-KIND-MAP -> return
    cnt = nd.keys.len()
    i <- [0..cnt): {
        k ?= nd.keys[i]
        nk ?= .node-pool.nodes[k]
        key-text-eq(nk, key) -> {
            v ?= nd.kids[i]
            out = yaml{
                node-pool: .node-pool
                root: v
                roots: .roots
                source: .source
            }
            return
        }
    }
}

; 按標量键取字符串
; key: 要查找的標量键文本
; out: 對應值的字符串形式（nil=键不存在或非字符串值）
; [get-str](#yaml.get-str)
yaml.get-str = (key str) (out ?str) {
    gopt = .get(key)
    gopt: {
        ok -> out = it.str()

        -> _
    }
}

; 按標量键取整數
; key: 要查找的標量键文本
; out: 對應值的整數（nil=键不存在或非整數值）
; [get-i64](#yaml.get-i64)
yaml.get-i64 = (key str) (out ?i64) {
    gopt = .get(key)
    gopt: {
        ok -> out = it.i64()

        -> _
    }
}

; 按標量键取浮點
; key: 要查找的標量键文本
; out: 對應值的浮點數（nil=键不存在或非浮點值）
; [get-f64](#yaml.get-f64)
yaml.get-f64 = (key str) (out ?f64) {
    gopt = .get(key)
    gopt: {
        ok -> out = it.f64()

        -> _
    }
}

; 按標量键取布爾
; key: 要查找的標量键文本
; out: 對應值的布爾值（nil=键不存在或非布爾值）
; [get-bool](#yaml.get-bool)
yaml.get-bool = (key str) (out ?bool) {
    gopt = .get(key)
    gopt: {
        ok -> out = it.bool()

        -> _
    }
}

; 當前節點的標量文本（容器返回 ok=false）
; out: 標量文本（nil=容器節點）
; [scalar-text](#yaml.scalar-text)
yaml.scalar-text = () (out ?str) {
    .root < 0 -> return
    .root >= .node-pool.nodes.len() -> return
    k ?= .node-pool.nodes[.root].kind
    k == YAML-KIND-SEQ || k == YAML-KIND-MAP -> return
    out ?= .node-pool.nodes[.root].text
}

; 按點號路径查找（序列可用數字下標）
; path: 點號分隔路径，如 'a.b.0'（數字段索引序列）
; out: 路径命中的節點（nil=路径不存在）
; [find](#yaml.find)
yaml.find = (path str) (out ?yaml) {
    cur = .root
    cur < 0 -> return
    parts = path.split('.')
    i <- [0..parts.len()): {
        cur < 0 -> return
        seg = str-at(parts, i)
        nd ?= .node-pool.nodes[cur]
        k = nd.kind
        k == YAML-KIND-MAP -> {
            found = -1
            cnt = nd.keys.len()
            j <- [0..cnt): {
                (found < 0) -> {
                    kn ?= nd.keys[j]
                    nkn ?= .node-pool.nodes[kn]
                    kk = nkn.kind
                    is-scalar = kk != YAML-KIND-SEQ && kk != YAML-KIND-MAP
                    hit = 0
                    is-scalar -> {
                        nkn.text.eq-full(seg) -> hit = 1
                    }
                    hit == 1 -> {
                        found ?= nd.kids[j]
                    }
                }
            }
            cur = found
            continue
        }
        k == YAML-KIND-SEQ -> {
            idx = to-i64(seg)
            idx < 0 -> {
                cur = -1
                break
            }
            cnt = nd.kids.len()
            idx >= cnt -> {
                cur = -1
                break
            }
            cur ?= nd.kids[idx]
            continue
        }
        cur = -1
        break
    }

    (true)
    cur < 0 -> return
    out = yaml{
        node-pool: .node-pool
        root: cur
        roots: .roots
        source: .source
    }
}

; 路径取字符串
; path: 點號分隔路径
; out: 路径末端節點的字符串值（nil=不存在或非字符串）
; [find-str](#yaml.find-str)
yaml.find-str = (path str) (out ?str) {
    fopt = .find(path)
    fopt: {
        ok -> out = it.str()

        -> _
    }
}

; 路径取整數
; path: 點號分隔路径
; out: 路径末端節點的整數值（nil=不存在或非整數）
; [find-i64](#yaml.find-i64)
yaml.find-i64 = (path str) (out ?i64) {
    fopt = .find(path)
    fopt: {
        ok -> out = it.i64()

        -> _
    }
}

; 路径取浮點
; path: 點號分隔路径
; out: 路径末端節點的浮點值（nil=不存在或非浮點）
; [find-f64](#yaml.find-f64)
yaml.find-f64 = (path str) (out ?f64) {
    fopt = .find(path)
    fopt: {
        ok -> out = it.f64()

        -> _
    }
}

; 路径取布爾
; path: 點號分隔路径
; out: 路径末端節點的布爾值（nil=不存在或非布爾）
; [find-bool](#yaml.find-bool)
yaml.find-bool = (path str) (out ?bool) {
    fopt = .find(path)
    fopt: {
        ok -> out = it.bool()

        -> _
    }
}

; 键比較辅助
...

; 標量键文本是否等於給定字符串
; nd: 待比較的節點（取其標量文本）
; key: 目標文本
; yes: nd 的標量文本與 key 相等
; [key-text-eq](#yaml.key-text-eq)
key-text-eq = (nd node, key str) (yes bool) {
    yes = false
    nd.kind == YAML-KIND-SEQ || nd.kind == YAML-KIND-MAP -> return
    yes = nd.text.eq-full(key)
}

; 兩個键節點是否等價（比較標量文本）
; a: 键節點 a
; b: 键節點 b
; yes: 兩節點的標量文本相等
; [key-eq](#yaml.key-eq)
key-eq = (a node, b node) (yes bool) {
    yes = false
    a.kind == YAML-KIND-SEQ || a.kind == YAML-KIND-MAP -> return
    b.kind == YAML-KIND-SEQ || b.kind == YAML-KIND-MAP -> return
    yes = a.text.eq-full(b.text)
}

; 文本轉 i64，失败返回 -1
; s: 整數文本
; v: 轉換值（-1=轉換失败）
; [to-i64](#yaml.to-i64)
to-i64 = (s str) (v i64) {
    v = -1
    n = s.len-bytes()
    n == 0 -> return
    i = 0
    acc = 0
    (i < n) {
        i >= n -> break
        c = s.byte(i)
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        acc = acc * 10 + c - 48

        {

            #{overflow=wrap}
            i-opt18 = i + 1
            i-opt18: {
                ok -> i = it

                ->
            }
        }
    }
    v = acc
}

; 序列化：JSON
...

; 節點是否為 .nan
;
; `.nan` 的 fval 由 nan() 填入真正的 NaN，所以按值判定（NaN != NaN）。
; 節點原文判定作為兜底：標簽改寫等路径可能只改 text 而不重算 fval。
; nd: 待檢測節點
; yes: 該節點為 .nan
; [node-is-nan](#yaml.node-is-nan)
node-is-nan = (nd node) (yes bool) {
    yes = false
    nd.kind != YAML-KIND-FLOAT -> return
    nd.fval != nd.fval -> {
        yes = true
        return
    }
    yes = nd.text == '.nan' || nd.text == '.NaN' || nd.text == '.NAN'
}

; 單個十六進制數字（0-15）轉字符
; v: 十六進制位的數值 0-15
; ch: 對應的十六進制字符（'0'-'f'）
; [hex-char](#yaml.hex-char)
hex-char = (v i64) (ch str) {
    ch = '0'

    v < 10 -> {
        h1 char = 0
        {

            #{overflow=wrap}
            h1-opt = 48 + v
            h1-opt: {
                ok -> h1 = it

                ->
            }
        }
        ch = h1.to-str()
        return
    }

    h2 char = 0
    {

        #{overflow=wrap}
        h2-opt = 87 + v
        h2-opt: {
            ok -> h2 = it

            ->
        }
    }
    ch = h2.to-str()
}

; JSON 字符串轉義
; s: 原始字符串
; out: 轉義後的 JSON 字符串（含首尾雙引號）
; [json-escape](#yaml.json-escape)
json-escape = (s str) (out str) {
    out = '"'
    i <- [0..s.len-bytes()): {
        c = s.byte(i): {
            ok -> it

            -> _
        }
        {
            c == 34 -> {
                out = out - '\\' - '"'
            }

            c == 92 -> {
                out = out - '\\' - '\\'
            }

            c == 10 -> {
                out = out - '\\' - 'n'
            }

            c == 13 -> {
                out = out - '\\' - 'r'
            }

            c == 9 -> {
                out = out - '\\' - 't'
            }

            c < 32 -> {

                #{overflow=wrap}
                hi = c / 16

                #{overflow=wrap}
                lo = c - hi * 16
                out = out - '\\' - 'u' - '0' - '0' - hex-char(hi) - hex-char(lo)
            }

            -> {
                jecc char = c
                out = out - jecc.to-str()
            }
        }
    }
    out = out - '"'
}

; 節點轉 JSON
; node-pool: 節點池
; idx: 待轉換節點的索引
; depth: 剩餘遞歸深度（防别名循环）
; out: 該節點對應的 JSON 文本
; [json-of](#yaml.json-of)
json-of = (npool pool, idx i64, depth i64) (out str) {
    out = 'null'
    idx < 0 -> return
    idx >= npool.nodes.len() -> return
    depth > YAML-MAX-DEPTH -> return
    nd = npool.nodes[idx]
    {
        nd.kind == YAML-KIND-NULL -> {
            out = 'null'
            return
        }

        nd.kind == YAML-KIND-BOOL -> {
            out = 'false'
            nd.bval -> out = 'true'
            return
        }

        nd.kind == YAML-KIND-INT -> {
            out = nd.ival.to-str()
            return
        }

        nd.kind == YAML-KIND-FLOAT -> {
            node-is-nan(nd) -> {
                out = 'null'
                return
            }
            f-is-inf(nd.fval) -> {
                out = 'null'
                return
            }
            out = nd.fval.to-str()
            return
        }

        nd.kind == YAML-KIND-STR -> {
            out = json-escape(nd.text)
            return
        }

        nd.kind == YAML-KIND-SEQ -> {

            ; D1：`+` 的結果恆為 `?i64`；depth 是普通整數，以兩段式 match 解包
            ; （否則它會被當成 option 傳給 json-of / emit 的 i64 參數）。
            #{overflow=wrap}
            d = depth + 1: {
                ok -> it

                -> 0
            }
            out = '['
            i <- [0..nd.kids.len()): {
                i > 0 -> out = out - ','
                k = nd.kids[i]
                out = out - json-of(npool, k, d)
            }
            out = out - ']'
            return
        }

        nd.kind == YAML-KIND-MAP -> {

            ; D1：`+` 的結果恆為 `?i64`；depth 是普通整數，以兩段式 match 解包
            ; （否則它會被當成 option 傳給 json-of / emit 的 i64 參數）。
            {

                #{overflow=wrap}
                d-opt-opt = depth + 1
                d-opt-opt: {
                    ok -> d-opt = it

                    ->
                }
            }
            d = 0
            d = d-opt: {
                ok -> it

                -> 0
            }
            out = '{'
            i <- [0..nd.kids.len()): {
                i > 0 -> out = out - ','
                {
                    kn ?= nd.keys[i]
                    knn ?= npool.nodes[kn]
                    out = out - json-escape(knn.text) - ':'
                    ki ?= nd.kids[i]
                    out = out - json-of(npool, ki, d)
                }: {
                    err -> _

                    -> _
                }
            }
            out = out - '}'
        }
    }
}

; 當前文檔轉 JSON
; out: 當前文檔根節點的 JSON 文本
; [to-json](#yaml.to-json)
yaml.to-json = () (out str) {
    out = 'null'
    .root < 0 -> return
    out = json-of(.node-pool, .root, 0)
}

; 全部文檔轉 JSON 數組
; out: 全部文檔組成的 JSON 數組文本
; [to-json-all](#yaml.to-json-all)
yaml.to-json-all = () (out str) {
    out = '['
    total = .roots.len()
    i <- [0..total): {
        i > 0 -> out = out - ','
        {
            ri ?= .roots[i]
            out = out - json-of(.node-pool, ri, 1)
        }: {
            err -> _

            -> _
        }
    }
    out = out - ']'
}

; 序列化：YAML
...

; 生成 n 個空格
; n: 空格個數
; out: n 個空格組成的字符串
; [spaces](#yaml.spaces)
spaces = (n i64) (out str) {
    out = ''
    i <- [0..n): out = out - ' '
}

; 文本可否作為 plain 標量原樣输出
; s: 待输出的文本
; yes: 可作 plain 標量原樣输出（無需加引號）
; [plain-safe](#yaml.plain-safe)
plain-safe = (s str) (yes bool) {
    yes = false
    n = s.len-bytes()
    n == 0 -> return
    c = s.byte(0)
    c == 32 || c == 9 -> return
    c == 45 || c == 63 || c == 58 || c == 44 || c == 91 || c == 93 || c == 123 || c == 125 || c == 35 || c == 38 || c == 42 || c == 33 || c == 124 || c == 62 || c == 39 || c == 34 || c == 37 || c == 64 -> return

    #{overflow=wrap}
    last = s.byte(n - 1)
    last == 32 || last == 9 -> return
    i <- [0..n): {
        ch = s.byte(i)
        ch < 32 -> return
        ch == 10 || ch == 13 -> return
        ch == 58 -> {

            #{overflow=wrap}
            j = i + 1
            j < n -> {
                nx = s.byte(j)
                nx == 32 || nx == 9 -> return
            }
        }
        ch == 35 -> {
            i > 0 -> {

                #{overflow=wrap}
                pv = s.byte(i - 1)
                pv == 32 || pv == 9 -> return
            }
        }
    }

    ; 若會被 core schema 解释為非字符串，则必須加引號
    kind = YAML-KIND-STR
    iv = 0
    fv = 0.0
    bv = false
    kind, iv, fv, bv = resolve-plain(s)
    yes = kind == YAML-KIND-STR
}

; 输出雙引號 YAML 標量
; s: 原始文本
; out: 加雙引號並轉義後的 YAML 標量文本
; [quote](#yaml.quote)
quote = (s str) (out str) {
    out = '"'
    i <- [0..s.len-bytes()): {
        c = s.byte(i): {
            ok -> it

            -> _
        }
        {
            c == 34 -> {
                out = out - '\\' - '"'
            }

            c == 92 -> {
                out = out - '\\' - '\\'
            }

            c == 10 -> {
                out = out - '\\' - 'n'
            }

            c == 13 -> {
                out = out - '\\' - 'r'
            }

            c == 9 -> {
                out = out - '\\' - 't'
            }

            c < 32 -> {

                #{overflow=wrap}
                hi = c / 16

                #{overflow=wrap}
                lo = c - hi * 16
                out = out - '\\' - 'u' - '0' - '0' - hex-char(hi) - hex-char(lo)
            }

            -> {
                jecc char = c
                out = out - jecc.to-str()
            }
        }
    }
    out = out - '"'
}

; 標量的 YAML 表示
; nd: 標量節點
; out: 按種類與風格選定的 YAML 表示文本
; [scalar-repr](#yaml.scalar-repr)
scalar-repr = (nd node) (out str) {
    out = ''
    {
        nd.kind == YAML-KIND-NULL -> {
            out = 'null'
            return
        }

        nd.kind == YAML-KIND-BOOL -> {
            out = 'false'
            nd.bval -> out = 'true'
            return
        }

        nd.kind == YAML-KIND-INT -> {
            out = nd.ival.to-str()
            return
        }

        nd.kind == YAML-KIND-FLOAT -> {
            node-is-nan(nd) -> {
                out = '.nan'
                return
            }
            f-is-inf(nd.fval) -> {
                out = '.inf'
                nd.fval < 0.0 -> out = '-.inf'
                return
            }
            out = nd.fval.to-str()
            return
        }

        -> {
            plain-safe(nd.text) -> {
                out = nd.text
                return
            }
            out = quote(nd.text)
        }
    }
}

; 節點轉塊風格 YAML（不含尾随換行）
; node-pool: 節點池
; idx: 待输出節點的索引
; indent: 每級縮進的空格數
; depth: 當前嵌套深度
; out: 塊風格 YAML 文本（無尾随換行）
; [emit](#yaml.emit)
emit = (npool pool, idx i64, indent i64, depth i64) (out str) {
    out = ''
    idx < 0 -> return
    idx >= npool.nodes.len() -> return
    depth > YAML-MAX-DEPTH -> return
    nd = npool.nodes[idx]
    {
        nd.kind == YAML-KIND-SEQ -> {

            ; D1：`+` 的結果恆為 `?i64`；depth 是普通整數，以兩段式 match 解包
            ; （否則它會被當成 option 傳給 json-of / emit 的 i64 參數）。
            #{overflow=wrap}
            d = depth + 1: {
                ok -> it

                -> 0
            }
            nd.kids.len() == 0 -> {
                out = '[]'
                return
            }
            total = nd.kids.len()
            i <- [0..total): {
                i > 0 -> out = out - '\n'
                out = out - spaces(indent) - '-'
                {
                    k ?= nd.kids[i]
                    nk ?= npool.nodes[k]
                    ck = nk.kind
                    container = ck == YAML-KIND-SEQ || ck == YAML-KIND-MAP
                    container -> {
                        nk.kids.len() == 0 -> {
                            {
                                ck == YAML-KIND-SEQ -> out = out - ' []'

                                -> out = out - ' {}'
                            }
                        }
                        nk.kids.len() > 0 -> {

                            ; D1：`+` 的結果恆為 `?i64`；cut 是普通縮排整數 → 兩段式 match 解包。
                            #{overflow=wrap}
                            cut = indent + 2: {
                                ok -> it

                                -> 0
                            }
                            inner = emit(npool, k, cut, d)
                            inner.len-bytes() > 0 -> {
                                rest = inner.slice-bytes(cut, inner.len-bytes())
                                out = out - ' ' - rest
                            }
                            inner.len-bytes() == 0 -> {
                                out = out - ' ' - scalar-repr(nk)
                            }
                        }
                    }
                    container == false -> {
                        out = out - ' ' - scalar-repr(nk)
                    }
                }: {
                    err -> _

                    -> _
                }
            }
            return
        }

        nd.kind == YAML-KIND-MAP -> {

            ; D1：`+` 的結果恆為 `?i64`；depth 是普通整數，以兩段式 match 解包
            ; （否則它會被當成 option 傳給 json-of / emit 的 i64 參數）。
            {

                #{overflow=wrap}
                d-opt-opt2 = depth + 1
                d-opt-opt2: {
                    ok -> d-opt = it

                    ->
                }
            }
            d = 0
            d = d-opt: {
                ok -> it

                -> 0
            }
            nd.kids.len() == 0 -> {
                out = '{}'
                return
            }
            total = nd.kids.len()
            i <- [0..total): {
                i > 0 -> out = out - '\n'
                {
                    kn ?= nd.keys[i]
                    knn ?= npool.nodes[kn]
                    ktext = scalar-repr(knn)
                    out = out - spaces(indent) - ktext - ':'
                    k ?= nd.kids[i]
                    nk ?= npool.nodes[k]
                    ck = nk.kind
                    container = ck == YAML-KIND-SEQ || ck == YAML-KIND-MAP
                    container -> {
                        nk.kids.len() == 0 -> {
                            {
                                ck == YAML-KIND-SEQ -> out = out - ' []'

                                -> out = out - ' {}'
                            }
                        }
                        nk.kids.len() > 0 -> {

                            #{overflow=wrap}
                            inner = emit(npool, k, indent + 2, d)
                            inner.len-bytes() > 0 -> out = out - '\n' - inner
                            inner.len-bytes() == 0 -> {
                                out = out - ' ' - scalar-repr(nk)
                            }
                        }
                    }
                    container == false -> {
                        out = out - ' ' - scalar-repr(nk)
                    }
                }: {
                    err -> _

                    -> _
                }
            }
            return
        }

        -> out = scalar-repr(nd)
    }
}

; 當前文檔重新输出為 YAML
; out: 當前文檔重新输出的 YAML 文本
; [to-yaml](#yaml.to-yaml)
yaml.to-yaml = () (out str) {
    out = ''
    .root < 0 -> return
    out = emit(.node-pool, .root, 0, 0)
}

; 别名，等同 to-yaml
; out: 同 to-yaml 的输出
; [stringify](#yaml.stringify)
yaml.stringify = () (out str) {
    out = .to-yaml()
}

; 原始输入文本
; out: 解析時的原始输入文本
; [source-of](#yaml.source-of)
yaml.source-of = () (out str) {
    out = .source
}
