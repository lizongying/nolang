; log — 分級日誌
;
; 前綴式分級日誌。預設寫入標準錯誤（以 io.writer 抽象承載），可用
; open-file / set-writer / set-output-fd 切換輸出目標；輸出格式由 set-format 選擇，可含時間戳、級別標籤，
; 以及由編譯器自動注入的呼叫點 檔案:行:列（見 #{track-caller}）。
;
; 用法：
;   log.set-format(log.F-TIME | log.F-LEVEL | log.F-LOC)
;   log.open-file('app.log')            ; 追加寫入檔案
;   log.info('server started')          ; 2026-.. ..:.. [INFO] app.no:7:5 server started
;
;   ; 輸出目標（預設 stderr）：寫到 stdout / stderr 用大寫 fd 常量
;   ;（用標量 STDOUT-FD/STDERR-FD，別用 fs.STDOUT/stdout 那類 struct 全域——
;   ;  std 合併模組中 struct 全域的初始化不可靠）
;   log.set-output-fd(fs.STDOUT-FD)             ; 日誌改寫到標準輸出
;   log.set-output-fd(fs.STDERR-FD)             ; 改回標準錯誤（即預設）

; ═══════════════════════════════════════════════
; 日誌級別常量
; ═══════════════════════════════════════════════

LEVEL-DEBUG = 0
LEVEL-INFO = 1
LEVEL-WARN = 2
LEVEL-ERROR = 3
LEVEL-FATAL = 4

; ═══════════════════════════════════════════════
; 日誌格式位（供 set-format 組合）
; ═══════════════════════════════════════════════

; 前置時間戳 YYYY-MM-DD HH:MM:SS（UTC）
F-TIME = 1

; 前置 [INFO] / [ERROR] 等級標籤
F-LEVEL = 2

; 前置呼叫點 [檔案:行:列]（由 #{track-caller} 自動注入）
F-LOC = 4

; ═══════════════════════════════════════════════
; 全域設定
; ═══════════════════════════════════════════════

; 當前日誌級別（預設 INFO）
LEVEL = 1

; 輸出格式位（預設僅 [INFO] 級別標籤，貼近舊輸出以保持相容；
; 需要的話用 set-format 疊加 F-TIME / F-LOC）
FMT-FLAGS = 2

; OUT-FD: 日誌輸出目標 fd（預設標準錯誤 stderr=2）。
; 說明：對外的輸出介面以 io.writer 抽象承載（見 set-writer / get-writer），但真正
; 持久化的狀態只能是這個標量 fd —— Nolang 的 std 合併模組中，struct global 的寫入
; 不會持久（只有標量 global 可變），故以 fd 作為唯一可信的儲存，寫入時再組裝 writer。
OUT-FD fd = fs.STDERR-FD

; ═══════════════════════════════════════════════
; 設定介面
; ═══════════════════════════════════════════════

; 設定日誌級別
; l: 目標級別（LEVEL-DEBUG..FATAL，0–4；僅輸出小於等於此級別的日誌）
; [set-level](#log.set-level)
set-level = (l i64) {
    LEVEL = l
}

; 設定輸出格式位（F-TIME / F-LEVEL / F-LOC 的或運算）
; flags: F-TIME / F-LEVEL / F-LOC 以 | 組合的格式位元遮罩
; [set-format](#log.set-format)
set-format = (flags i64) {
    FMT-FLAGS = flags
}

; 切換輸出目標到指定 fd（呼叫端負責開啟/關閉）
; new-fd: 新的輸出目標檔案描述符（其開啟與關閉由呼叫端負責）
; [set-output-fd](#log.set-output-fd)
set-output-fd = (new-fd fd) {
    OUT-FD = new-fd
}

; 回傳目前輸出目標的 fd（除錯用）
; cur: 目前輸出目標的 fd（預設為標準錯誤）
; [get-output-fd](#log.get-output-fd)
get-output-fd = () (cur fd) {
    cur = OUT-FD
}

; 切換輸出目標到指定 io.writer（io 介面的抽象寫入器）。
; writer 本質只包一個 fd，std 中唯一可持久化的是標量，故儲存其 fd。
; w: 目標 io.writer（內部僅取其 fd 欄位作持久儲存）
; [set-writer](#log.set-writer)
set-writer = (w io.writer) {
    OUT-FD = w.fd
}

; 回傳目前輸出目標對應的 io.writer
; w: 由目前 OUT-FD 組裝而來的 io.writer 抽象
; [get-writer](#log.get-writer)
get-writer = () (w io.writer) {
    w = writer.from-fd(OUT-FD)
}

; 以追加模式開啟日誌檔案並設為輸出目標
; 回傳 ?bool：ok=true 成功、err 開啟失敗
; path: 要以追加模式開啟並設為輸出目標的日誌檔案路徑
; res: ok=true 開啟成功, err=開啟失敗
; [open-file](#log.open-file)
open-file = (path str) (res ?bool) {
    res = nil
    f = fs.open-file(path, fs.O-WRONLY | fs.O-CREAT | fs.O-APPEND, 420)
    f < 0 -> {
        res = err('log: open failed')
        return
    }
    set-output-fd(f)
    res = true
}

; ═══════════════════════════════════════════════
; 內部輸出
; ═══════════════════════════════════════════════

; 目前時間戳字串（UTC，YYYY-MM-DD HH:MM:SS）
; s: UTC 時間戳字串（格式 YYYY-MM-DD HH:MM:SS）
; [log-stamp](#log.log-stamp)
log-stamp = () (s str) {
    s = time.format-time-str(time.now-s())
}

; 依 FMT-FLAGS 組裝單行日誌，經 io.writer 抽象寫入 OUT-FD
; tag: 級別標籤（如 DEBUG/INFO，僅 F-LEVEL 置位時以 [tag] 前置）
; msg: 日誌正文
; loc: 呼叫點字串（F-LOC 置位且非空時以 [loc] 前置，由上層注入）
; [log-emit](#log.log-emit)
log-emit = (tag str, msg str, loc str) {
    buf = ''
    FMT-FLAGS & F-TIME != 0 -> buf = buf - log-stamp() - ' '
    FMT-FLAGS & F-LEVEL != 0 -> buf = buf - '[' - tag - '] '
    FMT-FLAGS & F-LOC != 0 -> {
        ! loc.empty() -> buf = buf - '[' - loc - '] '
    }
    buf = buf - msg
    w = writer.from-fd(OUT-FD)
    n = w.write-line(buf)
}

; ═══════════════════════════════════════════════
; 日誌輸出（末位 loc 由 #{track-caller} 自動注入呼叫點）
; ═══════════════════════════════════════════════

; debug: 輸出 DEBUG 級別日誌
; [debug](#log.debug)
; msg: 日誌正文
; loc: 呼叫點 檔案:行:列（由 #{track-caller} 自動注入，可留空）

#{track-caller}
debug = (msg str, loc str = '') {
    LEVEL <= 0 -> log-emit('DEBUG', msg, loc)
}

; info: 輸出 INFO 級別日誌
; [info](#log.info)
; msg: 日誌正文
; loc: 呼叫點 檔案:行:列（由 #{track-caller} 自動注入，可留空）

#{track-caller}
info = (msg str, loc str = '') {
    LEVEL <= 1 -> log-emit('INFO', msg, loc)
}

; warn: 輸出 WARN 級別日誌
; [warn](#log.warn)
; msg: 日誌正文
; loc: 呼叫點 檔案:行:列（由 #{track-caller} 自動注入，可留空）

#{track-caller}
warn = (msg str, loc str = '') {
    LEVEL <= 2 -> log-emit('WARN', msg, loc)
}

; error: 輸出 ERROR 級別日誌
; [error](#log.error)
; msg: 日誌正文
; loc: 呼叫點 檔案:行:列（由 #{track-caller} 自動注入，可留空）

#{track-caller}
error = (msg str, loc str = '') {
    LEVEL <= 3 -> log-emit('ERROR', msg, loc)
}

; fatal: 輸出 FATAL 級別日誌並退出
; [fatal](#log.fatal)
; msg: 日誌正文
; code: 輸出後傳給 exit 的進程結束狀態碼
; loc: 呼叫點 檔案:行:列（由 #{track-caller} 自動注入，可留空）

#{track-caller}
fatal = (msg str, code i64, loc str = '') {
    log-emit('FATAL', msg, loc)
    exit(code)
}
