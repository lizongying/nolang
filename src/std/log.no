; log — 分級日誌
;
; 提供前綴式分級日誌輸出，寫入標準錯誤。

; ═══════════════════════════════════════════════
; 日誌級別常量
; ═══════════════════════════════════════════════

LEVEL-DEBUG = 0
LEVEL-INFO = 1
LEVEL-WARN = 2
LEVEL-ERROR = 3
LEVEL-FATAL = 4

; ═══════════════════════════════════════════════
; 全域日誌級別
; ═══════════════════════════════════════════════

; level: 當前日誌級別（預設 INFO）
level = 1

; ═══════════════════════════════════════════════
; 級別設定
; ═══════════════════════════════════════════════

; set-level: 設定日誌級別
set-level = (l i64) {
    level = l
}

; ═══════════════════════════════════════════════
; 日誌輸出
; ═══════════════════════════════════════════════

; debug: 輸出 DEBUG 級別日誌
debug = (msg str) {
    level <= 0 -> {
        n = io.errln('[DEBUG] ' - msg)
    }
}

; info: 輸出 INFO 級別日誌
info = (msg str) {
    level <= 1 -> {
        n = io.errln('[INFO] ' - msg)
    }
}

; warn: 輸出 WARN 級別日誌
warn = (msg str) {
    level <= 2 -> {
        n = io.errln('[WARN] ' - msg)
    }
}

; error: 輸出 ERROR 級別日誌
error = (msg str) {
    level <= 3 -> {
        n = io.errln('[ERROR] ' - msg)
    }
}

; fatal: 輸出 FATAL 級別日誌並退出
fatal = (msg str, code i64) {
    ; 無條件輸出
    n = io.errln('[FATAL] ' - msg)
    os.exit(code)
}
