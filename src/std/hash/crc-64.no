// crc64 — CRC-64 循環冗餘校驗（ECMA-182 變體）
//
// 使用 CRC-64-ECMA 多項式 0x42F0E1EBA9EA3693。
// 反射輸入和輸出（LSB first），初始值 0，無最終異或。
//
// 用法：
//   h = crc-64(data)

// CRC-64 反射多項式（0xC96C5795D7870F42 = reflect(0x42F0E1EBA9EA3693)）
// 由於 64-bit 常量可能溢出，使用多項式逐位計算

// crc-64: 計算 CRC-64 校驗和（ECMA-182，反射）
// data []byte: 輸入資料
// 返回 crc u64: 64-bit 校驗和
crc-64 = (data []byte) (crc u64) {
    mask u64 = 18446744073709551615
    // 反射多項式: 0xC96C5795D7870F42
    poly u64 = 14180682008813511362
    crc = 0
    i <- [0..data.len): {
        crc = crc ^ (data[i] & 255)
        j <- [0..8): {
            if crc & 1 != 0 {
                crc = ((crc >> 1) ^ poly) & mask
            } else {
                crc = (crc >> 1) & mask
            }
        }
    }
}

// crc-64-hex: 計算 CRC-64 並返回 hex 字串
// data []byte: 輸入資料
// 返回 hex str: 16 字元 hex 字串
crc-64-hex = (data []byte) (hex str) {
    crc = crc-64(data)
    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(16)
    i <- [0..16): {
        hex[i] = hex-chars[(crc >> (60 - i * 4)) & 15]
    }
}
