; md5 — MD5 訊息摘要算法（128-bit）
;
; 計算位元組陣列的 MD5 哈希值。
;
; 用法：
;   data = [0x61, 0x62, 0x63]  // "abc"
;   hash = md5(data)
;   // hash == [0x90, 0x01, 0x50, 0x98, ...]

; md5: 計算 MD5 哈希
; in: 輸入位元組陣列
; out: 輸出 16 位元組哈希值
md5 = (data []byte) (out [16]byte) {
    ; MD5 初始值（u32 自然 32-bit 溢出，無需 & mask）
    mask u32 = 4294967295
    h0 u32 = 1732584193
    h1 u32 = 4023233417
    h2 u32 = 2562383102
    h3 u32 = 271733878

    ; 計算填充後的總長度
    dlen = data.len
    blen = dlen * 8
    plen = dlen + 1 + 8
    rem = plen % 64
    rem != 0 -> plen = plen + 64 - rem
    num-blocks = plen / 64

    ; 預建填充緩衝區（一次分配，循環重用）
    buf [64]byte
    plen8 = plen - 8

    ; 對每個 64 位元組區塊進行壓縮
    bidx <- [0..num-blocks): {
        off = bidx * 64
        ; 填充 64 位元組緩衝區：data + 0x80 + zeros + length
        j <- [0..64): {
            pos = off + j
            {
                pos < dlen -> buf[j] = data[pos]
                pos == dlen -> buf[j] = 128
                pos >= plen8 -> buf[j] = (blen >> ((pos - plen8) * 8)) & 255
                -> buf[j] = 0
            }
        }
        ; 從緩衝區直接載入 16 個 32-bit 字（無分支！）
        w0 u32 = buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24)
        w1 u32 = buf[4] | (buf[5] << 8) | (buf[6] << 16) | (buf[7] << 24)
        w2 u32 = buf[8] | (buf[9] << 8) | (buf[10] << 16) | (buf[11] << 24)
        w3 u32 = buf[12] | (buf[13] << 8) | (buf[14] << 16) | (buf[15] << 24)
        w4 u32 = buf[16] | (buf[17] << 8) | (buf[18] << 16) | (buf[19] << 24)
        w5 u32 = buf[20] | (buf[21] << 8) | (buf[22] << 16) | (buf[23] << 24)
        w6 u32 = buf[24] | (buf[25] << 8) | (buf[26] << 16) | (buf[27] << 24)
        w7 u32 = buf[28] | (buf[29] << 8) | (buf[30] << 16) | (buf[31] << 24)
        w8 u32 = buf[32] | (buf[33] << 8) | (buf[34] << 16) | (buf[35] << 24)
        w9 u32 = buf[36] | (buf[37] << 8) | (buf[38] << 16) | (buf[39] << 24)
        w10 u32 = buf[40] | (buf[41] << 8) | (buf[42] << 16) | (buf[43] << 24)
        w11 u32 = buf[44] | (buf[45] << 8) | (buf[46] << 16) | (buf[47] << 24)
        w12 u32 = buf[48] | (buf[49] << 8) | (buf[50] << 16) | (buf[51] << 24)
        w13 u32 = buf[52] | (buf[53] << 8) | (buf[54] << 16) | (buf[55] << 24)
        w14 u32 = buf[56] | (buf[57] << 8) | (buf[58] << 16) | (buf[59] << 24)
        w15 u32 = buf[60] | (buf[61] << 8) | (buf[62] << 16) | (buf[63] << 24)

        ; MD5 壓縮函數（64 輪）— u32 算術自然 32-bit 溢出
        a u32 = h0
        b u32 = h1
        c u32 = h2
        d u32 = h3
        ; 第 1 輪 (F): f = d ^ (b & (c ^ d))
        f u32 = d ^ (b & (c ^ d))
        t u32 = a + f + w0 + 3614090360
        a = b + ((t << 7) | (t >> 25))
        f = c ^ (a & (b ^ c))
        t = d + f + w1 + 3905402710
        d = a + ((t << 12) | (t >> 20))
        f = b ^ (d & (a ^ b))
        t = c + f + w2 + 606105819
        c = d + ((t << 17) | (t >> 15))
        f = a ^ (c & (d ^ a))
        t = b + f + w3 + 3250441966
        b = c + ((t << 22) | (t >> 10))
        f = d ^ (b & (c ^ d))
        t = a + f + w4 + 4118548399
        a = b + ((t << 7) | (t >> 25))
        f = c ^ (a & (b ^ c))
        t = d + f + w5 + 1200080426
        d = a + ((t << 12) | (t >> 20))
        f = b ^ (d & (a ^ b))
        t = c + f + w6 + 2821735955
        c = d + ((t << 17) | (t >> 15))
        f = a ^ (c & (d ^ a))
        t = b + f + w7 + 4249261313
        b = c + ((t << 22) | (t >> 10))
        f = d ^ (b & (c ^ d))
        t = a + f + w8 + 1770035416
        a = b + ((t << 7) | (t >> 25))
        f = c ^ (a & (b ^ c))
        t = d + f + w9 + 2336552879
        d = a + ((t << 12) | (t >> 20))
        f = b ^ (d & (a ^ b))
        t = c + f + w10 + 4294925233
        c = d + ((t << 17) | (t >> 15))
        f = a ^ (c & (d ^ a))
        t = b + f + w11 + 2304563134
        b = c + ((t << 22) | (t >> 10))
        f = d ^ (b & (c ^ d))
        t = a + f + w12 + 1804603682
        a = b + ((t << 7) | (t >> 25))
        f = c ^ (a & (b ^ c))
        t = d + f + w13 + 4254626195
        d = a + ((t << 12) | (t >> 20))
        f = b ^ (d & (a ^ b))
        t = c + f + w14 + 2792965006
        c = d + ((t << 17) | (t >> 15))
        f = a ^ (c & (d ^ a))
        t = b + f + w15 + 1236535329
        b = c + ((t << 22) | (t >> 10))
        ; 第 2 輪 (G): f = c ^ (d & (b ^ c))
        f = c ^ (d & (b ^ c))
        t = a + f + w1 + 4129170786
        a = b + ((t << 5) | (t >> 27))
        f = b ^ (c & (a ^ b))
        t = d + f + w6 + 3225465664
        d = a + ((t << 9) | (t >> 23))
        f = a ^ (b & (d ^ a))
        t = c + f + w11 + 643717713
        c = d + ((t << 14) | (t >> 18))
        f = d ^ (a & (c ^ d))
        t = b + f + w0 + 3921069994
        b = c + ((t << 20) | (t >> 12))
        f = c ^ (d & (b ^ c))
        t = a + f + w5 + 3593408605
        a = b + ((t << 5) | (t >> 27))
        f = b ^ (c & (a ^ b))
        t = d + f + w10 + 38016083
        d = a + ((t << 9) | (t >> 23))
        f = a ^ (b & (d ^ a))
        t = c + f + w15 + 3634488961
        c = d + ((t << 14) | (t >> 18))
        f = d ^ (a & (c ^ d))
        t = b + f + w4 + 3889429448
        b = c + ((t << 20) | (t >> 12))
        f = c ^ (d & (b ^ c))
        t = a + f + w9 + 568446438
        a = b + ((t << 5) | (t >> 27))
        f = b ^ (c & (a ^ b))
        t = d + f + w14 + 3275163606
        d = a + ((t << 9) | (t >> 23))
        f = a ^ (b & (d ^ a))
        t = c + f + w3 + 4107603335
        c = d + ((t << 14) | (t >> 18))
        f = d ^ (a & (c ^ d))
        t = b + f + w8 + 1163531501
        b = c + ((t << 20) | (t >> 12))
        f = c ^ (d & (b ^ c))
        t = a + f + w13 + 2850285829
        a = b + ((t << 5) | (t >> 27))
        f = b ^ (c & (a ^ b))
        t = d + f + w2 + 4243563512
        d = a + ((t << 9) | (t >> 23))
        f = a ^ (b & (d ^ a))
        t = c + f + w7 + 1735328473
        c = d + ((t << 14) | (t >> 18))
        f = d ^ (a & (c ^ d))
        t = b + f + w12 + 2368359562
        b = c + ((t << 20) | (t >> 12))
        ; 第 3 輪 (H): f = x ^ y ^ z
        f = b ^ c ^ d
        t = a + f + w5 + 4294588738
        a = b + ((t << 4) | (t >> 28))
        f = a ^ b ^ c
        t = d + f + w8 + 2272392833
        d = a + ((t << 11) | (t >> 21))
        f = d ^ a ^ b
        t = c + f + w11 + 1839030562
        c = d + ((t << 16) | (t >> 16))
        f = c ^ d ^ a
        t = b + f + w14 + 4259657740
        b = c + ((t << 23) | (t >> 9))
        f = b ^ c ^ d
        t = a + f + w1 + 2763975236
        a = b + ((t << 4) | (t >> 28))
        f = a ^ b ^ c
        t = d + f + w4 + 1272893353
        d = a + ((t << 11) | (t >> 21))
        f = d ^ a ^ b
        t = c + f + w7 + 4139469664
        c = d + ((t << 16) | (t >> 16))
        f = c ^ d ^ a
        t = b + f + w10 + 3200236656
        b = c + ((t << 23) | (t >> 9))
        f = b ^ c ^ d
        t = a + f + w13 + 681279174
        a = b + ((t << 4) | (t >> 28))
        f = a ^ b ^ c
        t = d + f + w0 + 3936430074
        d = a + ((t << 11) | (t >> 21))
        f = d ^ a ^ b
        t = c + f + w3 + 3572445317
        c = d + ((t << 16) | (t >> 16))
        f = c ^ d ^ a
        t = b + f + w6 + 76029189
        b = c + ((t << 23) | (t >> 9))
        f = b ^ c ^ d
        t = a + f + w9 + 3654602809
        a = b + ((t << 4) | (t >> 28))
        f = a ^ b ^ c
        t = d + f + w12 + 3873151461
        d = a + ((t << 11) | (t >> 21))
        f = d ^ a ^ b
        t = c + f + w15 + 530742520
        c = d + ((t << 16) | (t >> 16))
        f = c ^ d ^ a
        t = b + f + w2 + 3299628645
        b = c + ((t << 23) | (t >> 9))
        ; 第 4 輪 (I): f = y ^ (x | ~z)  — mask ^ d 即 ~d
        f = c ^ (b | (mask ^ d))
        t = a + f + w0 + 4096336452
        a = b + ((t << 6) | (t >> 26))
        f = b ^ (a | (mask ^ c))
        t = d + f + w7 + 1126891415
        d = a + ((t << 10) | (t >> 22))
        f = a ^ (d | (mask ^ b))
        t = c + f + w14 + 2878612391
        c = d + ((t << 15) | (t >> 17))
        f = d ^ (c | (mask ^ a))
        t = b + f + w5 + 4237533241
        b = c + ((t << 21) | (t >> 11))
        f = c ^ (b | (mask ^ d))
        t = a + f + w12 + 1700485571
        a = b + ((t << 6) | (t >> 26))
        f = b ^ (a | (mask ^ c))
        t = d + f + w3 + 2399980690
        d = a + ((t << 10) | (t >> 22))
        f = a ^ (d | (mask ^ b))
        t = c + f + w10 + 4293915773
        c = d + ((t << 15) | (t >> 17))
        f = d ^ (c | (mask ^ a))
        t = b + f + w1 + 2240044497
        b = c + ((t << 21) | (t >> 11))
        f = c ^ (b | (mask ^ d))
        t = a + f + w8 + 1873313359
        a = b + ((t << 6) | (t >> 26))
        f = b ^ (a | (mask ^ c))
        t = d + f + w15 + 4264355552
        d = a + ((t << 10) | (t >> 22))
        f = a ^ (d | (mask ^ b))
        t = c + f + w6 + 2734768916
        c = d + ((t << 15) | (t >> 17))
        f = d ^ (c | (mask ^ a))
        t = b + f + w13 + 1309151649
        b = c + ((t << 21) | (t >> 11))
        f = c ^ (b | (mask ^ d))
        t = a + f + w4 + 4149444226
        a = b + ((t << 6) | (t >> 26))
        f = b ^ (a | (mask ^ c))
        t = d + f + w11 + 3174756917
        d = a + ((t << 10) | (t >> 22))
        f = a ^ (d | (mask ^ b))
        t = c + f + w2 + 718787259
        c = d + ((t << 15) | (t >> 17))
        f = d ^ (c | (mask ^ a))
        t = b + f + w9 + 3951481745
        b = c + ((t << 21) | (t >> 11))
        ; 累加回初始值（u32 自然溢出）
        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
    }

    ; 輸出 16 位元組（小端序 32-bit 字）
    out[0] = h0 & 255
    out[1] = (h0 >> 8) & 255
    out[2] = (h0 >> 16) & 255
    out[3] = (h0 >> 24) & 255
    out[4] = h1 & 255
    out[5] = (h1 >> 8) & 255
    out[6] = (h1 >> 16) & 255
    out[7] = (h1 >> 24) & 255
    out[8] = h2 & 255
    out[9] = (h2 >> 8) & 255
    out[10] = (h2 >> 16) & 255
    out[11] = (h2 >> 24) & 255
    out[12] = h3 & 255
    out[13] = (h3 >> 8) & 255
    out[14] = (h3 >> 16) & 255
    out[15] = (h3 >> 24) & 255
}
