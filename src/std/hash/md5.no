// md5 — MD5 訊息摘要算法（128-bit）
//
// 計算位元組陣列的 MD5 哈希值。
//
// 用法：
//   data = [0x61, 0x62, 0x63]  // "abc"
//   hash = md5(data)
//   // hash == [0x90, 0x01, 0x50, 0x98, ...]

// rot-left: 32-bit 循環左移
rot-left = (x i64, n i64) (r i64) {
    s = 32 - n
    l = x << n
    r = x >> s
    r = l | r
    r = r & 4294967295
}

// md5: 計算 MD5 哈希
// in: 輸入位元組陣列
// out: 輸出 16 位元組哈希值
md5 = (data []byte) (out [16]byte) {
    // MD5 初始值
    mask = 4294967295
    h0 = 1732584193  // 0x67452301
    h1 = 4023233417  // 0xEFCDAB89
    h2 = 2562383102  // 0x98BADCFE
    h3 = 271733878  // 0x10325476

    // 計算填充後的總長度
    dlen = len(data)
    blen = dlen * 8
    plen = dlen + 1 + 8
    rem = plen % 64
    rem != 0 -> plen = plen + 64 - rem
    num-blocks = plen / 64

    // 對每個 64 位元組區塊進行壓縮
    bidx <- [0..num-blocks): {
        // 將 64 位元組組裝為 16 個 32-bit 小端字
        off = bidx * 64
        w0 = 0
        w1 = 0
        w2 = 0
        w3 = 0
        w4 = 0
        w5 = 0
        w6 = 0
        w7 = 0
        w8 = 0
        w9 = 0
        w10 = 0
        w11 = 0
        w12 = 0
        w13 = 0
        w14 = 0
        w15 = 0
        wi <- [0..16): {
            boff = off + wi * 4
            b0 = 0
            b1 = 0
            b2 = 0
            b3 = 0
            // b0: byte at position boff
            {
                boff < dlen -> b0 = data[boff]
                boff == dlen -> b0 = 128
                boff >= plen - 8 -> {
                    len-byte-idx = boff - (plen - 8)
                    {
                        len-byte-idx == 0 -> b0 = blen & 255
                        len-byte-idx == 1 -> b0 = (blen >> 8) & 255
                        len-byte-idx == 2 -> b0 = (blen >> 16) & 255
                        len-byte-idx == 3 -> b0 = (blen >> 24) & 255
                        len-byte-idx == 4 -> b0 = (blen >> 32) & 255
                        len-byte-idx == 5 -> b0 = (blen >> 40) & 255
                        len-byte-idx == 6 -> b0 = (blen >> 48) & 255
                        -> b0 = (blen >> 56) & 255
                    }
                }
            }
            // b1: byte at position boff+1
            pos1 = boff + 1
            {
                pos1 < dlen -> b1 = data[pos1]
                pos1 == dlen -> b1 = 128
                pos1 >= plen - 8 -> {
                    len-byte-idx = pos1 - (plen - 8)
                    {
                        len-byte-idx == 0 -> b1 = blen & 255
                        len-byte-idx == 1 -> b1 = (blen >> 8) & 255
                        len-byte-idx == 2 -> b1 = (blen >> 16) & 255
                        len-byte-idx == 3 -> b1 = (blen >> 24) & 255
                        len-byte-idx == 4 -> b1 = (blen >> 32) & 255
                        len-byte-idx == 5 -> b1 = (blen >> 40) & 255
                        len-byte-idx == 6 -> b1 = (blen >> 48) & 255
                        -> b1 = (blen >> 56) & 255
                    }
                }
            }
            // b2: byte at position boff+2
            pos2 = boff + 2
            {
                pos2 < dlen -> b2 = data[pos2]
                pos2 == dlen -> b2 = 128
                pos2 >= plen - 8 -> {
                    len-byte-idx = pos2 - (plen - 8)
                    {
                        len-byte-idx == 0 -> b2 = blen & 255
                        len-byte-idx == 1 -> b2 = (blen >> 8) & 255
                        len-byte-idx == 2 -> b2 = (blen >> 16) & 255
                        len-byte-idx == 3 -> b2 = (blen >> 24) & 255
                        len-byte-idx == 4 -> b2 = (blen >> 32) & 255
                        len-byte-idx == 5 -> b2 = (blen >> 40) & 255
                        len-byte-idx == 6 -> b2 = (blen >> 48) & 255
                        -> b2 = (blen >> 56) & 255
                    }
                }
            }
            // b3: byte at position boff+3
            pos3 = boff + 3
            {
                pos3 < dlen -> b3 = data[pos3]
                pos3 == dlen -> b3 = 128
                pos3 >= plen - 8 -> {
                    len-byte-idx = pos3 - (plen - 8)
                    {
                        len-byte-idx == 0 -> b3 = blen & 255
                        len-byte-idx == 1 -> b3 = (blen >> 8) & 255
                        len-byte-idx == 2 -> b3 = (blen >> 16) & 255
                        len-byte-idx == 3 -> b3 = (blen >> 24) & 255
                        len-byte-idx == 4 -> b3 = (blen >> 32) & 255
                        len-byte-idx == 5 -> b3 = (blen >> 40) & 255
                        len-byte-idx == 6 -> b3 = (blen >> 48) & 255
                        -> b3 = (blen >> 56) & 255
                    }
                }
            }
            word = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
            // 暫存到 wi 變數
            {
                wi == 0 -> w0 = word
                wi == 1 -> w1 = word
                wi == 2 -> w2 = word
                wi == 3 -> w3 = word
                wi == 4 -> w4 = word
                wi == 5 -> w5 = word
                wi == 6 -> w6 = word
                wi == 7 -> w7 = word
                wi == 8 -> w8 = word
                wi == 9 -> w9 = word
                wi == 10 -> w10 = word
                wi == 11 -> w11 = word
                wi == 12 -> w12 = word
                wi == 13 -> w13 = word
                wi == 14 -> w14 = word
                -> w15 = word
            }
        }
        // MD5 壓縮函數（64 輪）
        a = h0
        b = h1
        c = h2
        d = h3
        r = 0
        t = 0
        // 第 1 輪 (F)
        f = (b & c) | ((mask ^ b) & d)
        t = (a + f + w0 + 3614090360) & mask
        r = rot-left(t, 7)
        a = (b + r) & mask
        f = (a & b) | ((mask ^ a) & c)
        t = (d + f + w1 + 3905402710) & mask
        r = rot-left(t, 12)
        d = (a + r) & mask
        f = (d & a) | ((mask ^ d) & b)
        t = (c + f + w2 + 606105819) & mask
        r = rot-left(t, 17)
        c = (d + r) & mask
        f = (c & d) | ((mask ^ c) & a)
        t = (b + f + w3 + 3250441966) & mask
        r = rot-left(t, 22)
        b = (c + r) & mask
        f = (b & c) | ((mask ^ b) & d)
        t = (a + f + w4 + 4118548399) & mask
        r = rot-left(t, 7)
        a = (b + r) & mask
        f = (a & b) | ((mask ^ a) & c)
        t = (d + f + w5 + 1200080426) & mask
        r = rot-left(t, 12)
        d = (a + r) & mask
        f = (d & a) | ((mask ^ d) & b)
        t = (c + f + w6 + 2821735955) & mask
        r = rot-left(t, 17)
        c = (d + r) & mask
        f = (c & d) | ((mask ^ c) & a)
        t = (b + f + w7 + 4249261313) & mask
        r = rot-left(t, 22)
        b = (c + r) & mask
        f = (b & c) | ((mask ^ b) & d)
        t = (a + f + w8 + 1770035416) & mask
        r = rot-left(t, 7)
        a = (b + r) & mask
        f = (a & b) | ((mask ^ a) & c)
        t = (d + f + w9 + 2336552879) & mask
        r = rot-left(t, 12)
        d = (a + r) & mask
        f = (d & a) | ((mask ^ d) & b)
        t = (c + f + w10 + 4294925233) & mask
        r = rot-left(t, 17)
        c = (d + r) & mask
        f = (c & d) | ((mask ^ c) & a)
        t = (b + f + w11 + 2304563134) & mask
        r = rot-left(t, 22)
        b = (c + r) & mask
        f = (b & c) | ((mask ^ b) & d)
        t = (a + f + w12 + 1804603682) & mask
        r = rot-left(t, 7)
        a = (b + r) & mask
        f = (a & b) | ((mask ^ a) & c)
        t = (d + f + w13 + 4254626195) & mask
        r = rot-left(t, 12)
        d = (a + r) & mask
        f = (d & a) | ((mask ^ d) & b)
        t = (c + f + w14 + 2792965006) & mask
        r = rot-left(t, 17)
        c = (d + r) & mask
        f = (c & d) | ((mask ^ c) & a)
        t = (b + f + w15 + 1236535329) & mask
        r = rot-left(t, 22)
        b = (c + r) & mask
        // 第 2 輪 (G) — T[17..32]
        f = (b & d) | (c & (mask ^ d))
        t = (a + f + w1 + 4129170786) & mask
        r = rot-left(t, 5)
        a = (b + r) & mask
        f = (a & c) | (b & (mask ^ c))
        t = (d + f + w6 + 3225465664) & mask
        r = rot-left(t, 9)
        d = (a + r) & mask
        f = (d & b) | (a & (mask ^ b))
        t = (c + f + w11 + 643717713) & mask
        r = rot-left(t, 14)
        c = (d + r) & mask
        f = (c & a) | (d & (mask ^ a))
        t = (b + f + w0 + 3921069994) & mask
        r = rot-left(t, 20)
        b = (c + r) & mask
        f = (b & d) | (c & (mask ^ d))
        t = (a + f + w5 + 3593408605) & mask
        r = rot-left(t, 5)
        a = (b + r) & mask
        f = (a & c) | (b & (mask ^ c))
        t = (d + f + w10 + 38016083) & mask
        r = rot-left(t, 9)
        d = (a + r) & mask
        f = (d & b) | (a & (mask ^ b))
        t = (c + f + w15 + 3634488961) & mask
        r = rot-left(t, 14)
        c = (d + r) & mask
        f = (c & a) | (d & (mask ^ a))
        t = (b + f + w4 + 3889429448) & mask
        r = rot-left(t, 20)
        b = (c + r) & mask
        f = (b & d) | (c & (mask ^ d))
        t = (a + f + w9 + 568446438) & mask
        r = rot-left(t, 5)
        a = (b + r) & mask
        f = (a & c) | (b & (mask ^ c))
        t = (d + f + w14 + 3275163606) & mask
        r = rot-left(t, 9)
        d = (a + r) & mask
        f = (d & b) | (a & (mask ^ b))
        t = (c + f + w3 + 4107603335) & mask
        r = rot-left(t, 14)
        c = (d + r) & mask
        f = (c & a) | (d & (mask ^ a))
        t = (b + f + w8 + 1163531501) & mask
        r = rot-left(t, 20)
        b = (c + r) & mask
        f = (b & d) | (c & (mask ^ d))
        t = (a + f + w13 + 2850285829) & mask
        r = rot-left(t, 5)
        a = (b + r) & mask
        f = (a & c) | (b & (mask ^ c))
        t = (d + f + w2 + 4243563512) & mask
        r = rot-left(t, 9)
        d = (a + r) & mask
        f = (d & b) | (a & (mask ^ b))
        t = (c + f + w7 + 1735328473) & mask
        r = rot-left(t, 14)
        c = (d + r) & mask
        f = (c & a) | (d & (mask ^ a))
        t = (b + f + w12 + 2368359562) & mask
        r = rot-left(t, 20)
        b = (c + r) & mask
        // 第 3 輪 (H) — T[33..48]
        f = b ^ c ^ d
        t = (a + f + w5 + 4294588738) & mask
        r = rot-left(t, 4)
        a = (b + r) & mask
        f = a ^ b ^ c
        t = (d + f + w8 + 2272392833) & mask
        r = rot-left(t, 11)
        d = (a + r) & mask
        f = d ^ a ^ b
        t = (c + f + w11 + 1839030562) & mask
        r = rot-left(t, 16)
        c = (d + r) & mask
        f = c ^ d ^ a
        t = (b + f + w14 + 4259657740) & mask
        r = rot-left(t, 23)
        b = (c + r) & mask
        f = b ^ c ^ d
        t = (a + f + w1 + 2763975236) & mask
        r = rot-left(t, 4)
        a = (b + r) & mask
        f = a ^ b ^ c
        t = (d + f + w4 + 1272893353) & mask
        r = rot-left(t, 11)
        d = (a + r) & mask
        f = d ^ a ^ b
        t = (c + f + w7 + 4139469664) & mask
        r = rot-left(t, 16)
        c = (d + r) & mask
        f = c ^ d ^ a
        t = (b + f + w10 + 3200236656) & mask
        r = rot-left(t, 23)
        b = (c + r) & mask
        f = b ^ c ^ d
        t = (a + f + w13 + 681279174) & mask
        r = rot-left(t, 4)
        a = (b + r) & mask
        f = a ^ b ^ c
        t = (d + f + w0 + 3936430074) & mask
        r = rot-left(t, 11)
        d = (a + r) & mask
        f = d ^ a ^ b
        t = (c + f + w3 + 3572445317) & mask
        r = rot-left(t, 16)
        c = (d + r) & mask
        f = c ^ d ^ a
        t = (b + f + w6 + 76029189) & mask
        r = rot-left(t, 23)
        b = (c + r) & mask
        f = b ^ c ^ d
        t = (a + f + w9 + 3654602809) & mask
        r = rot-left(t, 4)
        a = (b + r) & mask
        f = a ^ b ^ c
        t = (d + f + w12 + 3873151461) & mask
        r = rot-left(t, 11)
        d = (a + r) & mask
        f = d ^ a ^ b
        t = (c + f + w15 + 530742520) & mask
        r = rot-left(t, 16)
        c = (d + r) & mask
        f = c ^ d ^ a
        t = (b + f + w2 + 3299628645) & mask
        r = rot-left(t, 23)
        b = (c + r) & mask
        // 第 4 輪 (I) — T[49..64]
        f = c ^ (b | (mask ^ d))
        t = (a + f + w0 + 4096336452) & mask
        r = rot-left(t, 6)
        a = (b + r) & mask
        f = b ^ (a | (mask ^ c))
        t = (d + f + w7 + 1126891415) & mask
        r = rot-left(t, 10)
        d = (a + r) & mask
        f = a ^ (d | (mask ^ b))
        t = (c + f + w14 + 2878612391) & mask
        r = rot-left(t, 15)
        c = (d + r) & mask
        f = d ^ (c | (mask ^ a))
        t = (b + f + w5 + 4237533241) & mask
        r = rot-left(t, 21)
        b = (c + r) & mask
        f = c ^ (b | (mask ^ d))
        t = (a + f + w12 + 1700485571) & mask
        r = rot-left(t, 6)
        a = (b + r) & mask
        f = b ^ (a | (mask ^ c))
        t = (d + f + w3 + 2399980690) & mask
        r = rot-left(t, 10)
        d = (a + r) & mask
        f = a ^ (d | (mask ^ b))
        t = (c + f + w10 + 4293915773) & mask
        r = rot-left(t, 15)
        c = (d + r) & mask
        f = d ^ (c | (mask ^ a))
        t = (b + f + w1 + 2240044497) & mask
        r = rot-left(t, 21)
        b = (c + r) & mask
        f = c ^ (b | (mask ^ d))
        t = (a + f + w8 + 1873313359) & mask
        r = rot-left(t, 6)
        a = (b + r) & mask
        f = b ^ (a | (mask ^ c))
        t = (d + f + w15 + 4264355552) & mask
        r = rot-left(t, 10)
        d = (a + r) & mask
        f = a ^ (d | (mask ^ b))
        t = (c + f + w6 + 2734768916) & mask
        r = rot-left(t, 15)
        c = (d + r) & mask
        f = d ^ (c | (mask ^ a))
        t = (b + f + w13 + 1309151649) & mask
        r = rot-left(t, 21)
        b = (c + r) & mask
        f = c ^ (b | (mask ^ d))
        t = (a + f + w4 + 4149444226) & mask
        r = rot-left(t, 6)
        a = (b + r) & mask
        f = b ^ (a | (mask ^ c))
        t = (d + f + w11 + 3174756917) & mask
        r = rot-left(t, 10)
        d = (a + r) & mask
        f = a ^ (d | (mask ^ b))
        t = (c + f + w2 + 718787259) & mask
        r = rot-left(t, 15)
        c = (d + r) & mask
        f = d ^ (c | (mask ^ a))
        t = (b + f + w9 + 3951481745) & mask
        r = rot-left(t, 21)
        b = (c + r) & mask
        // 累加回初始值
        h0 = (h0 + a) & mask
        h1 = (h1 + b) & mask
        h2 = (h2 + c) & mask
        h3 = (h3 + d) & mask
    }

    // 輸出 16 位元組（小端序 32-bit 字）
    out[0] = h0 & 255
    out[1] = (h0 >> 8) & 255
    out[2] = (h0 >> 16) & 255
    out[3] = (h0 >> 24) & 255
    out[4] = h1 & 255
    out[5] = (h1 >> 8) & 255
    out[6] = (h1 >> 16) & 255
    out[7] = (h1 >> 24) & 255
    out[8] = h2 & 255
    out[9] = (h2 >> 8) & 255
    out[10] = (h2 >> 16) & 255
    out[11] = (h2 >> 24) & 255
    out[12] = h3 & 255
    out[13] = (h3 >> 8) & 255
    out[14] = (h3 >> 16) & 255
    out[15] = (h3 >> 24) & 255
}