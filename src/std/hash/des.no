    0x16, 0x17, 0x18, 0x19, 0x18, 0x19, 0x1a, 0x1b,
    0x1c, 0x1d, 0x1c, 0x1d, 0x1e, 0x1f, 0x20, 0x01,
]

; P: 排列（32 位元）
P-TBL [32]byte = [
    0x10, 0x07, 0x14, 0x15, 0x1d, 0x0c, 0x1c, 0x11,
    0x01, 0x0f, 0x17, 0x1a, 0x05, 0x12, 0x1f, 0x0a,
