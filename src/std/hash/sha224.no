// sha224 — SHA-224 安全哈希算法（224-bit）
//
// SHA-224 使用與 SHA-256 相同的壓縮函數，但使用不同的初始值並截斷輸出為 28 位元組。
// 底層呼叫 sha256-block 處理 512-bit 區塊。
//
// 用法：
//   # std/hash/sha224
//   hash = sha224(data)       // hash = 28 位元組 [28]byte
//   hex = sha224-hex(data)    // hex = 56 字元 hex 字串

# std/hash/sha256

// sha224: 計算 SHA-224 雜湊（含填充與多區塊處理）
// data []byte: 輸入位元組陣列
// 返回 hash [28]byte: 28 位元組雜湊值
sha224 = (data []byte) (hash [28]byte) {
    // SHA-224 初始狀態（不同於 SHA-256）
    h0 u32 = 3238371032
    h1 u32 = 914150663
    h2 u32 = 812702999
    h3 u32 = 4144912697
    h4 u32 = 4290775857
    h5 u32 = 1750603025
    h6 u32 = 1694076839
    h7 u32 = 3204075428

    dlen = data.len

    // 填充：0x80 + 0x00*pad + 8-byte big-endian bit length
    // 總長度需為 64 的倍數
    bit-len = dlen * 8
    mod-val = (dlen + 9) % 64
    pad-len = 0
    if mod-val != 0 {
        pad-len = 64 - mod-val
    }
    total-len = dlen + 1 + pad-len + 8

    // 建立填充緩衝區
    padded []byte
    i = 0
    for i < total-len {
        padded[i] = 0
        i = i + 1
    }

    // 複製原始資料
    i = 0
    for i < dlen {
        padded[i] = data[i]
        i = i + 1
    }

    // 填充 0x80
    padded[dlen] = 128

    // 填充 0x00
    i = dlen + 1
    for i < total-len - 8 {
        padded[i] = 0
        i = i + 1
    }

    // 填充 bit-len（big-endian 64-bit）
    i = 0
    for i < 8 {
        padded[total-len - 8 + i] = (bit-len >> (56 - i * 8)) & 255
        i = i + 1
    }

    // 處理每個 64 位元組區塊
    block []u32
    i = 0
    for i < 16 {
        block[i] = 0
        i = i + 1
    }
    offset = 0
    for offset < total-len {
        i = 0
        for i < 16 {
            block[i] = (padded[offset + i * 4] << 24) | (padded[offset + i * 4 + 1] << 16) | (padded[offset + i * 4 + 2] << 8) | padded[offset + i * 4 + 3]
            i = i + 1
        }
        hash.sha256.sha256-block(block, h0, h1, h2, h3, h4, h5, h6, h7)
        offset = offset + 64
    }

    // 輸出 28 位元組雜湊值（big-endian，截斷 h0..h6 的前 28 位元組）
    hash[0] = (h0 >> 24) & 255
    hash[1] = (h0 >> 16) & 255
    hash[2] = (h0 >> 8) & 255
    hash[3] = h0 & 255
    hash[4] = (h1 >> 24) & 255
    hash[5] = (h1 >> 16) & 255
    hash[6] = (h1 >> 8) & 255
    hash[7] = h1 & 255
    hash[8] = (h2 >> 24) & 255
    hash[9] = (h2 >> 16) & 255
    hash[10] = (h2 >> 8) & 255
    hash[11] = h2 & 255
    hash[12] = (h3 >> 24) & 255
    hash[13] = (h3 >> 16) & 255
    hash[14] = (h3 >> 8) & 255
    hash[15] = h3 & 255
    hash[16] = (h4 >> 24) & 255
    hash[17] = (h4 >> 16) & 255
    hash[18] = (h4 >> 8) & 255
    hash[19] = h4 & 255
    hash[20] = (h5 >> 24) & 255
    hash[21] = (h5 >> 16) & 255
    hash[22] = (h5 >> 8) & 255
    hash[23] = h5 & 255
    hash[24] = (h6 >> 24) & 255
    hash[25] = (h6 >> 16) & 255
    hash[26] = (h6 >> 8) & 255
    hash[27] = h6 & 255
}

// sha224-hex: 計算 SHA-224 雜湊並返回 hex 字串
// data []byte: 輸入位元組陣列
// 返回 hex str: 56 字元小寫 hex 字串
sha224-hex = (data []byte) (hex str) {
    hash = sha224(data)

    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(56)

    i = 0
    for i < 28 {
        hex[i * 2] = hex-chars[(hash[i] >> 4) & 15]
        hex[i * 2 + 1] = hex-chars[hash[i] & 15]
        i = i + 1
    }
}
