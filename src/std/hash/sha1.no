    // f = (b & c) | (~b & d)

    f = (b & c) | ((mask ^ b) & d)
    temp = ((a << 5) | (a >> 27)) & mask
    temp = (temp + f + e + 1518500249 + s[0]) & mask
    e = d
    d = c
    c = ((b << 30) | (b >> 2)) & mask
    b = a
    a = temp
