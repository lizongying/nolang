; process — 進程操作
;
; 提供進程創建、標準流獲取、進程等待、進程信息查詢等功能。
; 底層使用 POSIX fork/exec/pipe/waitpid 實作。
;
; 用法：
;   p = process.new()
;   p.start('ls', '-la')
;   code = p.wait()
;   print('exit code: ' - code.to-str())
;
;   // 底層啟動方法（支援 args, dir, input, merge-err）
;   p.start-with-opts('ls', ['-la'], '', '', false)
;   code = p.wait()
;
;   // 便捷方法：捕獲 stdout 輸出
;   content, code = process.new().output('ls', '-la')
;
;   // 非阻塞 spawn + wait
;   pid = process.spawn('echo hello')
;   code = process.wait(pid)
;
;   // 便捷：同步執行 shell 命令（spawn + wait 組合）
;   code = process.shell('echo hello')
;
;   // 完整功能的子進程執行器（扁平參數：program, args, dir, stdin, env, timeout, merge-err）
;   out, stderr, code, err = process.cmd('ls', args, '', '', env, 5000, false)
;   print('out=' - out - ' code=' - code.to-str())
;
;   // 結構體結果（返回 exec-result，可鏈式存取 stdout/stderr/code）
;   o = process.cmdopts{timeout: 5000}
;   res = process.exec('ls', ['-la'], o)
;   res.code == 0 -> print(res.stdout)
;   res.code != 0 -> print('error: ' - res.code.to-str())

; ═══════════════════════════════════════════════
; 內建函數（底層實作）
; ═══════════════════════════════════════════════

; process-fork: fork 當前進程
; 返回 0=子進程, >0=父進程(子PID), -1=錯誤
#{buildin}
process-fork = () (pid i64) {
}

; process-pipe: 建立管道
; 返回打包值 (read_fd << 32) | write_fd
#{buildin}
process-pipe = () (fds i64) {
}

; process-waitpid: 等待子進程
; 返回退出碼 (WEXITSTATUS)
#{buildin}
process-waitpid = (pid i64, options i64) (code i64) {
}

; process-waitpid-nohang: 非阻塞等待子進程 (WNOHANG)
; 子進程仍在執行時返回 -1；已退出時返回其退出碼；錯誤時返回 -1。
; 用於 timeout 看門狗輪詢。
#{buildin}
process-waitpid-nohang = (pid i64) (code i64) {
}

; process-exec: 替換當前進程
; 呼叫 execlp(program, program, arg, NULL)
; 僅在失敗時返回
#{buildin}
process-exec = (program str, arg str) (err i64) {
}

; process-kill: 發送信號給進程
#{buildin}
process-kill = (pid i64, sig i64) (ok bool) {
}

; process-dup2: 複製檔案描述符
#{buildin}
process-dup2 = (oldfd i64, newfd i64) (newfd i64) {
}

; process-getppid: 取得父進程 ID
#{buildin}
process-getppid = () (pid i64) {
}

; process-system: 執行 shell 命令
#{buildin}
process-system = (cmd str) (status i64) {
}

; process-exec-shell: 用 sh -c 執行命令字串（替換當前進程）
; cmd: 完整命令字串
; 僅在失敗時返回 errno
#{buildin}
process-exec-shell = (cmd str) (err i64) {
}

; ═══════════════════════════════════════════════
; Windows 平台專用 Win32 API 內建函數
; 這些取代 process.c 的 C runtime，以純 Nolang 實現 cmd
; ═══════════════════════════════════════════════

; win-create-pipe: 建立匿名管道（CreatePipe）
; 返回打包值 (read_handle << 32) | write_handle，0=失敗
#{buildin}
win-create-pipe = () (handles i64) {
}

; win-close-handle: 關閉 Windows handle（CloseHandle）
#{buildin}
win-close-handle = (handle i64) (ok bool) {
}

; win-write-pipe: 寫入資料到管道/handle（WriteFile）
; 返回寫入位元組數，-1=錯誤
#{buildin}
win-write-pipe = (handle i64, data str) (written i64) {
}

; win-read-pipe: 從管道/handle 讀取資料（ReadFile）
; 返回 (data, n)：n=讀取位元組數，-1=錯誤
#{buildin}
win-read-pipe = (handle i64, max-bytes i64) (data str, n i64) {
}

; win-create-process: 創建子進程（CreateProcessA）
; cmdline: 完整命令列字串
; dir: 工作目錄（空=繼承）
; stdin-handle, stdout-handle, stderr-handle: 標準流 handle（0=繼承父進程）
; 返回 (proc-handle, status)：proc-handle>0=成功, 0=失敗
#{buildin}
win-create-process = (cmdline str, dir str, stdin-handle i64, stdout-handle i64, stderr-handle i64) (proc-handle i64, status i64) {
}

; win-wait-process: 等待進程結束（WaitForSingleObject）
; timeout-ms: 超時毫秒（0=無限等待）
; 返回 0=超時, 1=已退出, -1=錯誤
#{buildin}
win-wait-process = (proc-handle i64, timeout-ms i64) (status i64) {
}

; win-get-exit-code: 取得進程退出碼（GetExitCodeProcess）
; 返回 (exit-code, ok)：ok=false 表示仍在執行
#{buildin}
win-get-exit-code = (proc-handle i64) (exit-code i64, ok bool) {
}

; win-terminate-process: 終止進程（TerminateProcess）
#{buildin}
win-terminate-process = (proc-handle i64, exit-code i64) (ok bool) {
}

; win-get-std-handle: 取得標準 handle（GetStdHandle）
; which: 0=stdin, 1=stdout, 2=stderr
#{buildin}
win-get-std-handle = (which i64) (handle i64) {
}

; ═══════════════════════════════════════════════
; 信號常量
; ═══════════════════════════════════════════════

SIG-TERM = 15
SIG-KILL = 9
SIG-INT = 2
SIG-STOP = 19
SIG-CONT = 18
SIG-CHLD = 17

; waitpid options
WNOHANG = 1

; ═══════════════════════════════════════════════
; 執行選項（概念說明）
; ═══════════════════════════════════════════════
;
; process.start-with-opts 的公開介面以「扁平參數」暴露執行選項（對應下列欄位）。
; 之所以不用 Run-Opts 結構體：nolang 目前跨模組傳遞結構體時
; 不會轉發其型別定義，會導致呼叫端 alloca %Run-Opts 失敗
; （"Cannot allocate unsized type"）。欄位順序即 process.start-with-opts 的參數順序：
;   dir       : 工作目錄；空字串 = 繼承父進程工作目錄
;   stdin     : 寫入子進程 stdin 的內容；空字串 = 不提供 stdin
;   env       : 環境變數（["K=V", ...]）；空陣列 = 繼承父進程環境
;   timeout   : 超時時間（毫秒），<=0 = 無限等待
;   merge-err : true = 將 stderr 合併到捕獲的 out 中

; ═══════════════════════════════════════════════
; process 結構體
; ═══════════════════════════════════════════════

; process: 子進程
; pid: 子進程 ID
; stdin-fd: 寫入子進程標準輸入的 fd（-1=未連接）
; stdout-fd: 讀取子進程標準輸出的 fd（-1=未連接）
; stderr-fd: 讀取子進程標準錯誤的 fd（-1=未連接）
; exit-code: 子進程退出碼
; running: 是否仍在執行（0=否, 1=是）
process {
    pid i64
    stdin-fd fd
    stdout-fd fd
    stderr-fd fd
    exit-code i64
    running i64
}

; ═══════════════════════════════════════════════
; 進程創建
; ═══════════════════════════════════════════════

; run: 啟動子進程（底層實例方法，不等待、不讀取輸出）
; program   : 要執行的程式名（PATH 搜尋）
; args      : 傳給程式的參數列表
; dir       : 工作目錄；空字串 = 繼承父進程
; input     : 寫入子進程 stdin 的內容；空字串 = 不提供 stdin
; merge-err : true = 將 stderr 合併到 stdout
; 返回 ok=true=成功；成功時設定 .pid/.stdout-fd/.stdin-fd/.running
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
process.start-with-opts = (program str, args []str, dir str, input str, merge-err bool) (ok bool) {
    ok = false
    .pid = 0
    .stdin-fd = -1
    .stdout-fd = -1
    .stderr-fd = -1
    .exit-code = 0
    .running = 0

    ; 構建命令字串
    cmdline = program
    is-sh-c = false
    {
        ; 直接執行 `sh -c <script>` 時避免雙重嵌套 sh -c（詳見 cmd）
        program == 'sh' -> {
            args.len() >= 2 -> {

                #{index-out=0}
                is-sh-c = args[0] == '-c'
            }
        }
    }
    {
        is-sh-c -> {

            #{index-out=0}
            cmdline = args[1]
        }

        -> {
            i <- [0..args.len()): {

                #{index-out=0, overflow=wrap}
                cmdline = cmdline - ' ' - args[i]
            }
        }
    }

    ; 建立 stdout 管道
    out-fds = process-pipe()
    {
        out-fds < 0 -> return
    }
    out-read = out-fds >> 32
    out-write = out-fds & 0xffffffff

    ; 建立 stderr 管道（除非 merge-err）
    err-read = -1
    err-write = -1
    {
        ! merge-err -> {
            err-fds = process-pipe()
            {
                err-fds < 0 -> {
                    fs.close(out-read)
                    fs.close(out-write)
                    return
                }
            }
            err-read = err-fds >> 32
            err-write = err-fds & 0xffffffff
        }
    }

    ; 建立 stdin 管道（如有 input）
    in-read = -1
    in-write = -1
    {
        input.len-bytes() > 0 -> {
            in-fds = process-pipe()
            {
                in-fds < 0 -> {
                    fs.close(out-read)
                    fs.close(out-write)
                    {
                        ! merge-err -> {
                            fs.close(err-read)
                            fs.close(err-write)
                        }
                    }
                    return
                }
            }
            in-read = in-fds >> 32
            in-write = in-fds & 0xffffffff
        }
    }

    ; fork
    pid = process-fork()

    {
        pid == 0 -> {

            ; 子進程：重定向標準流
            process-dup2(out-write, 1)
            {
                merge-err -> {
                    process-dup2(out-write, 2)
                }

                ! merge-err -> {
                    process-dup2(err-write, 2)
                }
            }
            {
                in-read >= 0 -> process-dup2(in-read, 0)
            }
            fs.close(out-read)
            fs.close(out-write)
            {
                ! merge-err -> {
                    fs.close(err-read)
                    fs.close(err-write)
                }
            }
            {
                in-read >= 0 -> {
                    fs.close(in-read)
                    fs.close(in-write)
                }
            }

            ; 工作目錄
            {
                dir.len-bytes() > 0 -> ch-dir(dir)
            }

            ; 執行命令
            exec-rc i64 = process-exec-shell(cmdline)

            ; exec 失敗：寫錯誤訊息到 stderr（fd 2），供父進程歸一化為 code=-1
            exec-rc != 0 -> {

                #{overflow=wrap}
                exec-err str = 'exec: ' - cmdline - ': command not found\n'
                exec-err-bytes = exec-err.to-bytes()
                fs.write(2, exec-err-bytes, exec-err-bytes.len())
            }

            ; exec 失敗
            exit(127)
        }

        pid < 0 -> {

            ; fork 失敗
            fs.close(out-read)
            fs.close(out-write)
            {
                ! merge-err -> {
                    fs.close(err-read)
                    fs.close(err-write)
                }
            }
            {
                in-read >= 0 -> {
                    fs.close(in-read)
                    fs.close(in-write)
                }
            }
            return
        }
    }

    ; 父進程：關閉子進程端的 fd
    fs.close(out-write)
    {
        ! merge-err -> {
            err-write >= 0 -> fs.close(err-write)
        }
    }
    {
        in-read >= 0 -> fs.close(in-read)
    }

    ; 寫入 stdin
    {
        in-write >= 0 -> {
            b = input.to-bytes()
            fs.write(in-write, b, b.len())
            fs.close(in-write)
        }
    }

    ; 設定實例欄位
    .pid = pid
    .stdout-fd = out-read
    .stdin-fd = -1
    .stderr-fd = ! merge-err ? err-read : -1
    .exit-code = 0
    .running = 1
    ok = true
}

#{win-amd64, win-arm64}
process.start-with-opts = (program str, args []str, dir str, input str, merge-err bool) (ok bool) {
    ok = false
}

; start: 創建子進程並執行命令（便捷方法，單參數）
; program: 要執行的程式名
; arg: 傳給程式的參數
; 返回 ok=true=成功
process.start = (program str, arg str) (ok bool) {
    ok = .start-with-opts(program, [arg], '', '', false)
}

; ═══════════════════════════════════════════════
; 進程等待
; ═══════════════════════════════════════════════

; wait: 等待子進程結束
; 返回 status=退出狀態碼（WEXITSTATUS）
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
process.wait = () (status i64) {
    status = 0
    .running == 0 -> {
        status = .exit-code
        return
    }
    status = process-waitpid(.pid, 0)
    .exit-code = status
    .running = 0
}

#{win-amd64, win-arm64}
process.wait = () (status i64) {
    status = .exit-code
}

; wait-nohang: 非阻塞等待（輪詢）
; 返回 status ?i64: ok=子進程已結束(退出狀態碼), nil=仍在執行
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
process.wait-nohang = () (status ?i64) {
    status = nil
    .running == 0 -> {
        status = .exit-code
        return
    }
    code = process-waitpid(.pid, WNOHANG)

    ; WNOHANG returns 0 if child still running
    code == 0 -> return
    .exit-code = code
    .running = 0
    status = code
}

#{win-amd64, win-arm64}
process.wait-nohang = () (status ?i64) {
    status = nil
}

; ═══════════════════════════════════════════════
; 進程控制
; ═══════════════════════════════════════════════

; kill: 發送信號給子進程
; sig: 信號編號（如 SIG-TERM=15, SIG-KILL=9）
; 返回 ok=true=成功
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
process.kill = (sig i64) (ok bool) {
    ok = process-kill(.pid, sig)
}

#{win-amd64, win-arm64}
process.kill = (sig i64) (ok bool) {
    ok = false
}

; terminate: 發送 SIG-TERM 信號
; 返回 ok=true=成功
process.terminate = () (ok bool) {
    ok = .kill(SIG-TERM)
}

; force-kill: 發送 SIG-KILL 信號
; 返回 ok=true=成功
process.force-kill = () (ok bool) {
    ok = .kill(SIG-KILL)
}

; ═══════════════════════════════════════════════
; 標準流操作
; ═══════════════════════════════════════════════

; read: 從子進程的 stdout 讀取資料
; 返回 read-n=實際讀取位元組數
process.read = (buf []byte, n i64) (read-n i64) {
    read-n = 0
    .stdout-fd < 0 -> return
    read-n = fs.read(.stdout-fd, buf, n)
}

; read-line: 從子進程的 stdout 讀取一行
; 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
process.read-line = () (line ?str) {
    line = nil
    .stdout-fd < 0 -> return
    buf []byte = with-cap(4096)
    n = fs.read(.stdout-fd, buf, 4096)
    n > 0 -> line = buf.to-str()
}

; read-all: 讀取子進程的所有 stdout 輸出
; 返回 content=讀取內容, n=讀取位元組數
process.read-all = () (content str, n i64) {
    n = 0
    .stdout-fd < 0 -> return
    buf []byte = with-len(4096)
    !! {

        #{overflow=wrap}
        chunk-n = fs.read(.stdout-fd, buf, 4096)
        chunk-n <= 0 -> *

        #{overflow=wrap}
        content = content - buf.slice(0, chunk-n).to-str()

        #{overflow=wrap}
        n = n + chunk-n
    }
}

; write: 寫入資料到子進程的 stdin
; 返回 written=實際寫入位元組數
process.write = (data str, n i64) (written i64) {
    written = 0
    .stdin-fd < 0 -> return
    b = data.to-bytes()
    written = fs.write(.stdin-fd, b, n)
}

; close-stdin: 關閉子進程的 stdin 管道
process.close-stdin = () {
    .stdin-fd >= 0 -> {
        fs.close(.stdin-fd)
        .stdin-fd = -1
    }
}

; close-stdout: 關閉子進程的 stdout 管道
process.close-stdout = () {
    .stdout-fd >= 0 -> {
        fs.close(.stdout-fd)
        .stdout-fd = -1
    }
}

; close-stderr: 關閉子進程的 stderr 管道
process.close-stderr = () {
    .stderr-fd >= 0 -> {
        fs.close(.stderr-fd)
        .stderr-fd = -1
    }
}

; ═══════════════════════════════════════════════
; 進程信息
; ═══════════════════════════════════════════════

; pid: 取得子進程 ID
process.pid-of = () (pid i64) {
    pid = .pid
}

; exit-code: 取得退出碼
process.exit-code-of = () (code i64) {
    code = .exit-code
}

; is-running: 判斷子進程是否仍在執行
process.is-running = () (yes bool) {
    yes = .running == 1
}

; parent-pid: 取得父進程 ID（靜態方法）
process.parent-pid = () (pid i64) {
    pid = process-getppid()
}

; ═══════════════════════════════════════════════
; 生命週期管理
; ═══════════════════════════════════════════════

; close: 關閉所有管道並等待子進程
process.close = () {
    .close-stdin()
    .close-stdout()
    .close-stderr()
    .running == 1 -> .wait()
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; process-shell: 執行 shell 命令字串並等待完成（透過 sh -c）
; ⚠ 已棄用（DEPRECATED），建議改用 process.cmd() 或 spawn() + wait()
;
; 已知問題：
;   1. 返回值是 C system() 的原始 wait status，而非退出碼。
;      真正的退出碼需 (status >> 8) & 0xFF，例如退出碼 1 會返回 256。
;   2. 無法捕獲 stdout/stderr 輸出。
;   3. 命令注入風險：cmd 字串直接傳給 sh -c，不可信輸入危險。
;   4. 無超時控制。
;
; 替代方案：
;   out, stderr, code, err = process.cmd('ls', args, '', '', env, 5000, false)  ; 完整功能
;   pid = process.spawn(cmd)                                        ; 非阻塞
;   status = process.wait(pid)                                      ; 返回正確退出碼
process-shell = (cmd str) (status i64) {
    status = process-system(cmd)
}

; cmd: 完整功能的子進程執行器（跨平台生產級實作）
; program   : 要執行的程式名（PATH 搜尋）
; args      : 傳給程式的參數列表
; dir       : 工作目錄；空字串 = 繼承父進程工作目錄
; input     : 寫入子進程 stdin 的內容；空字串 = 不提供 stdin
;             （參數名用 input 而非 stdin，因 std/fs.no 已預定義全域 stdin/file 句柄，
;               同名校驗名會與該全域變數的 SSA 名 %stdin 衝突，導致呼叫端誤用全域。）
; env       : 環境變數（["K=V", ...]）；空陣列 = 繼承父進程環境
; timeout   : 超時時間（毫秒），<=0 = 無限等待
; merge-err : true = 將 stderr 合併到捕獲的 out 中
; 返回 out=捕獲的 stdout（merge-err 時含 stderr），stderr=捕獲的 stderr 輸出，code=退出碼，err=錯誤訊息
;   code >= 0 : 正常退出碼
;   code == -1 : 啟動 / exec 失敗
;   code == -2 : 超時（子進程已被殺死）

; POSIX 版本：使用純 Nolang 實現（process-fork/pipe/dup2/exec-shell/waitpid）。
; 不依賴 process.c C runtime，與 Windows 版本對稱。

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
cmd = (program str, args []str, dir str, input str, env []str, timeout i64, merge-err bool) (out str, stderr str, code i64, err str) {
    out = ''
    stderr = ''
    code = -1
    err = ''

    ; 構建命令字串
    cmdline = program
    is-sh-c = false
    {
        ; 直接執行 `sh -c <script>` 時避免雙重嵌套 sh -c：
        ; 否則 cmdline 會變成 "sh -c <script>"，再被 process-exec-shell 包成
        ; `sh -c "sh -c <script>"`，script 永遠不會按預期執行。
        ; 注意：nolang 的 && 不短路，故 args[0] 索引必須放在
        ; `#{index-out = 0}` 守衛區塊內。
        program == 'sh' -> {
            args.len() >= 2 -> {

                #{index-out=0}
                is-sh-c = args[0] == '-c'
            }
        }
    }
    {
        is-sh-c -> {

            #{index-out=0}
            cmdline = args[1]
        }

        -> {
            i <- [0..args.len()): {

                #{index-out=0, overflow=wrap}
                cmdline = cmdline - ' ' - args[i]
            }
        }
    }

    ; 環境變數轉發：process-exec-shell 本身不接收 env，故以 `env VAR=val ...` 前綴注入。
    ; 說明：env 值含空白/特殊字元時可能需額外引用；此處處理常見情形。
    {
        env.len() > 0 -> {
            envline str = 'env'
            ei <- [0..env.len()): {

                #{index-out=0, overflow=wrap}
                envline = envline - ' ' - env[ei]
            }

            #{overflow=wrap}
            cmdline = envline - ' ' - cmdline
        }
    }

    ; 建立 stdout 管道
    out-fds = process-pipe()
    {
        out-fds < 0 -> {
            err = 'failed to create stdout pipe'
            return
        }
    }
    out-read = out-fds >> 32
    out-write = out-fds & 0xffffffff

    ; 建立 stderr 管道（除非 merge-err）
    err-read = -1
    err-write = -1
    {
        ! merge-err -> {
            err-fds = process-pipe()
            {
                err-fds < 0 -> {
                    fs.close(out-read)
                    fs.close(out-write)
                    err = 'failed to create stderr pipe'
                    return
                }
            }
            err-read = err-fds >> 32
            err-write = err-fds & 0xffffffff
        }
    }

    ; 建立 stdin 管道（如有 input）
    in-read = -1
    in-write = -1
    {
        input.len-bytes() > 0 -> {
            in-fds = process-pipe()
            {
                in-fds < 0 -> {
                    fs.close(out-read)
                    fs.close(out-write)
                    {
                        ! merge-err -> {
                            fs.close(err-read)
                            fs.close(err-write)
                        }
                    }
                    err = 'failed to create stdin pipe'
                    return
                }
            }
            in-read = in-fds >> 32
            in-write = in-fds & 0xffffffff
        }
    }

    ; fork
    pid = process-fork()

    {
        pid == 0 -> {

            ; 子進程：重定向標準流
            process-dup2(out-write, 1)
            {
                merge-err -> {
                    process-dup2(out-write, 2)
                }

                ! merge-err -> {
                    process-dup2(err-write, 2)
                }
            }
            {
                in-read >= 0 -> process-dup2(in-read, 0)
            }
            fs.close(out-read)
            fs.close(out-write)
            {
                ! merge-err -> {
                    fs.close(err-read)
                    fs.close(err-write)
                }
            }
            {
                in-read >= 0 -> {
                    fs.close(in-read)
                    fs.close(in-write)
                }
            }

            ; 工作目錄
            {
                dir.len-bytes() > 0 -> ch-dir(dir)
            }

            ; 執行命令
            exec-rc i64 = process-exec-shell(cmdline)

            ; exec 失敗：寫錯誤訊息到 stderr（fd 2），供父進程歸一化為 code=-1
            exec-rc != 0 -> {

                #{overflow=wrap}
                exec-err str = 'exec: ' - cmdline - ': command not found\n'
                exec-err-bytes = exec-err.to-bytes()
                fs.write(2, exec-err-bytes, exec-err-bytes.len())
            }

            ; exec 失敗
            exit(127)
        }

        pid < 0 -> {

            ; fork 失敗
            fs.close(out-read)
            fs.close(out-write)
            {
                ! merge-err -> {
                    fs.close(err-read)
                    fs.close(err-write)
                }
            }
            {
                in-read >= 0 -> {
                    fs.close(in-read)
                    fs.close(in-write)
                }
            }
            err = 'failed to fork'
            return
        }
    }

    ; 父進程：關閉子進程端的 fd
    fs.close(out-write)
    {
        ! merge-err -> {
            err-write >= 0 -> fs.close(err-write)
        }
    }
    {
        in-read >= 0 -> fs.close(in-read)
    }

    ; 寫入 stdin
    {
        in-write >= 0 -> {
            b = input.to-bytes()
            fs.write(in-write, b, b.len())
            fs.close(in-write)
        }
    }

    ; 讀取 stdout 輸出（在 waitpid 之前讀取以避免管道死鎖）
    buf []byte = with-len(4096)
    !! {

        #{overflow=wrap}
        n = fs.read(out-read, buf, 4096)
        n <= 0 -> break

        #{overflow=wrap}
        out = out - buf.slice(0, n).to-str()
    }

    fs.close(out-read)

    ; 等待進程結束（含超時看門狗）。
    ; 注意：nolang 在函數中段的「裸區塊 + -> 鏈」後會提前返回，故本區塊須為函數最後語句；
    ; stderr 捕獲與啟動/exec 失敗歸一化均置於此區塊內（waitpid 之後子進程已退出，
    ; 讀取可取得完整輸出，EOF 後 read 回傳 0 自然結束迴圈）。
    ; timeout>0 看門狗輪詢非阻塞 waitpid，超時則殺死子進程並回報 -2。
    {
        timeout > 0 -> {
            elapsed i64 = 0
            !! {

                ; 子進程已結束則跳出
                process-waitpid-nohang(pid) != -1 -> break

                ; 已超時則跳出
                elapsed >= timeout -> break
                sleep-us(10000)

                #{overflow=wrap}
                elapsed = elapsed + 10
            }

            ; 超時：仍在執行 → 強制殺死並回報 -2
            process-waitpid-nohang(pid) == -1 -> {
                process-kill(pid, 9)
                code = -2

                ; 收割被殺死的子進程
                process-waitpid(pid, 0)
            }

            -> {

                ; 自然結束：收割並取得退出碼
                code = process-waitpid(pid, 0)
            }
        }
    }
    timeout <= 0 -> {

        ; 無限等待
        code = process-waitpid(pid, 0)
    }

    ; 捕獲 stderr（僅非 merge-err 時 stderr 獨立管道）
    {
        ! merge-err -> {
            err-read >= 0 -> {
                !! {

                    #{overflow=wrap}
                    n = fs.read(err-read, buf, 4096)
                    n <= 0 -> break
                    stderr = stderr - buf.slice(0, n).to-str()
                }
                fs.close(err-read)
            }
        }
    }

    ; 啟動/exec 失敗歸一化：sh -c 包裝下指令不存在會令 sh 以 127 退出，
    ; 將其視為 exec 失敗（code=-1, err=錯誤訊息），符合 API 契約。
    code == 127 -> {
        ! merge-err -> {
            stderr.len-bytes() > 0 -> {
                code = -1
                err = stderr
            }
        }
        merge-err -> {
            out.len-bytes() > 0 -> {
                code = -1
                err = out
            }
        }
    }
}

; cmd: 完整功能的子進程執行器（跨平台生產級實作）
; Windows 版本：使用 Win32 API（CreateProcessA、CreatePipe 等）以純 Nolang 實現。
; 不依賴 process.c C runtime，所有進程創建、管道管理、輸出捕獲均透過
; win-create-process、win-create-pipe、win-read-pipe 等 ForwardFunc 內建完成。

#{win-amd64, win-arm64}
cmd = (program str, args []str, dir str, input str, env []str, timeout i64, merge-err bool) (out str, stderr str, code i64, err str) {
    out = ''
    stderr = ''
    code = -1
    err = ''

    ; 構建命令列字串：program + " " + arg1 + " " + arg2 + ...
    cmdline = program
    i <- [0..args.len()): {

        #{index-out=0}
        arg str = args[i]

        ; 含空格的參數需要加引號
        has-space = arg.contains(' ')
        has-space != 0 -> {

            #{overflow=wrap}
            cmdline = cmdline - ' "' - arg - '"'
        }
        has-space == 0 -> {

            #{overflow=wrap}
            cmdline = cmdline - ' ' - arg
        }
    }

    ; 建立 stdout 管道
    out-fds = win-create-pipe()
    {
        out-fds == 0 -> {
            err = 'failed to create stdout pipe'
            return
        }
    }
    out-read = out-fds >> 32
    out-write = out-fds & 0xffffffff

    ; 建立 stderr 管道（除非 merge-err）
    err-read = 0
    err-write = 0
    {
        ! merge-err -> {
            err-fds = win-create-pipe()
            {
                err-fds == 0 -> {
                    win-close-handle(out-read)
                    win-close-handle(out-write)
                    err = 'failed to create stderr pipe'
                    return
                }
            }
            err-read = err-fds >> 32
            err-write = err-fds & 0xffffffff
        }
    }

    ; 建立 stdin 管道（如有 input）
    in-read = 0
    in-write = 0
    {
        input.len-bytes() > 0 -> {
            in-fds = win-create-pipe()
            {
                in-fds == 0 -> {
                    win-close-handle(out-read)
                    win-close-handle(out-write)
                    {
                        ! merge-err -> {
                            win-close-handle(err-read)
                            win-close-handle(err-write)
                        }
                    }
                    err = 'failed to create stdin pipe'
                    return
                }
            }
            in-read = in-fds >> 32
            in-write = in-fds & 0xffffffff
        }
    }

    ; 取得父進程標準 handle（當對應 handle 為 0 時使用）
    parent-stdin = win-get-std-handle(0)
    parent-stdout = win-get-std-handle(1)
    parent-stderr = win-get-std-handle(2)

    ; 決定傳給子進程的標準 handle
    child-stdin = 0
    child-stdout = 0
    child-stderr = 0
    child-stdin = in-read != 0 ? in-read : parent-stdin
    child-stdout = out-write
    child-stderr = merge-err ? out-write : err-write

    ; 創建子進程
    proc-handle, status = win-create-process(cmdline, dir, child-stdin, child-stdout, child-stderr)

    ; 父進程關閉子進程端的 handle
    win-close-handle(out-write)
    {
        ! merge-err -> {
            err-write != 0 -> win-close-handle(err-write)
        }
    }
    {
        in-read != 0 -> win-close-handle(in-read)
    }

    {
        proc-handle == 0 -> {
            win-close-handle(out-read)
            {
                ! merge-err -> {
                    err-read != 0 -> win-close-handle(err-read)
                }
            }
            {
                in-write != 0 -> win-close-handle(in-write)
            }
            err = 'failed to create process'
            return
        }
    }

    ; 寫入 stdin
    {
        in-write != 0 -> {
            win-write-pipe(in-write, input)
            win-close-handle(in-write)
        }
    }

    ; 等待進程結束（含超時）
    {
        timeout > 0 -> {
            wait-status = win-wait-process(proc-handle, timeout)
            {
                wait-status == 0 -> {

                    ; 超時，終止進程
                    win-terminate-process(proc-handle, 1)
                    win-wait-process(proc-handle, 0)
                    code = -2
                    err = 'process timed out'
                }

                ! wait-status == 0 -> {

                    ; 已退出
                    exit-code, ok = win-get-exit-code(proc-handle)
                    code = exit-code
                }
            }
        }

        timeout <= 0 -> {

            ; 無限等待
            win-wait-process(proc-handle, 0)
            exit-code, ok = win-get-exit-code(proc-handle)
            code = exit-code
        }
    }

    ; 讀取 stdout 輸出
    {
        true -> {
            chunk str = ''
            chunk-n i64 = 0
            !! {
                chunk, chunk-n = win-read-pipe(out-read, 4096)

                #{overflow=wrap}
                chunk-n <= 0 -> break
                out = out - chunk
            }
        }
    }
    win-close-handle(out-read)

    ; 讀取 stderr 輸出（如果不 merge-err，捕獲）
    {
        ! merge-err -> {
            err-read != 0 -> {
                chunk str = ''
                chunk-n i64 = 0
                !! {
                    chunk, chunk-n = win-read-pipe(err-read, 4096)

                    #{overflow=wrap}
                    chunk-n <= 0 -> break
                    stderr = stderr - chunk
                }
                win-close-handle(err-read)
            }
        }
    }

    win-close-handle(proc-handle)
}

; cmdopts: process.start-with-opts 的執行選項（跨模組結構體示例）。
; 欄位對應 process.cmd 的扁平參數：
;   dir       : 工作目錄；空字串 = 繼承父進程工作目錄
;   stdin     : 寫入子進程 stdin 的內容；空字串 = 不提供 stdin
;   env       : 環境變數（["K=V", ...]）；空陣列 = 繼承父進程環境
;   timeout   : 超時時間（毫秒），<=0 = 無限等待
;   merge-err : true = 將 stderr 合併到捕獲的 out 中
cmdopts {
    dir str
    stdin str
    env []str
    timeout i64
    merge-err bool
}

; exec-result: exec 的返回結果結構體
; stdout : 捕獲的 stdout 輸出（merge-err 時含 stderr）
; stderr : 捕獲的 stderr 輸出（merge-err 時為空）
; code   : 退出碼（>=0=正常, 127=命令不存在, -1=啟動失敗, -2=超時）
exec-result {
    stdout str
    stderr str
    code i64
}

; exec: 以結構體選項執行子進程，返回 exec-result 結構體
; 註：函數名為 exec 而非 run，因 run 是語言保留字（關鍵字）。
;
; 用法：
;   o = process.cmdopts{timeout: 5000}
;   res = process.exec('ls', ['-la'], o)
;   res.code == 0 -> print(res.stdout)
;   res.code != 0 -> print('error code: ' + res.code.to-str())
exec = (program str, args []str, o cmdopts) (res exec-result) {
    out, stderr, code, err = cmd(program, args, o.dir, o.stdin, o.env, o.timeout, o.merge-err)
    res = exec-result {
        stdout: out
        stderr: stderr
        code: code
    }
}

; new: 建立並返回一個 process 實例
; 用法：p = process.new()
new = () (p process) {
    p = process {}
}

; output: 執行命令並捕獲 stdout 輸出（實例方法）
; 用法：content, code = process.new().output('ls', '-la')
; 返回 content=輸出內容, code=退出碼
process.output = (program str, arg str) (content str, code i64) {
    .start-with-opts(program, [arg], '', '', false)
    content, n = .read-all()
    code = .wait()
    .close()
}

; ═══════════════════════════════════════════════
; 進程列表與查找（notools 擴展）
; ═══════════════════════════════════════════════

; proc-info: 進程資訊
; pid: 進程 ID
; name: 進程名稱（Linux 取自 /proc/<pid>/comm，最長 15 字元）
proc-info {
    pid i64
    name str
}

; list-all: 列出系統中所有進程
; Linux: 遍歷 /proc，讀取每個 PID 目錄下的 /proc/<pid>/comm 取得進程名
; macOS/Windows: 暫時返回空列表（需 libproc/sysctl 或 CreateToolhelp32Snapshot 支持）
; 返回 proc-info 列表

#{linux-amd64, linux-arm64}
list-all = () (procs []proc-info) {
    names = fs.list-dir('/proc')
    i <- [0..names.len()): {

        #{index-out=0}
        name = names[i]

        ; 只處理全數字條目（PID 目錄）
        pid-val ?i64 = name.to-i64()
        pid-val: {
            ok -> {

                #{overflow=wrap}
                p = proc-info {}
                p.pid = it

                ; 讀取 /proc/<pid>/comm 取得進程名
                #{overflow=wrap}
                comm-path = '/proc/' - name - '/comm'
                comm = fs.read-file(comm-path).to-str()
                comm.len() > 0 -> p.name = comm.trim()
                procs.push(p)
            }

            nil ->

            err ->
        }
    }
}

#{mac-amd64, mac-arm64, intrinsic}
list-all = () (procs []proc-info) {
    ; macOS 暫時返回空列表（需 libproc proc_listallpids 或 sysctl KERN_PROC）
}

#{win-amd64, win-arm64, intrinsic}
list-all = () (procs []proc-info) {
    ; Windows 暫時返回空列表（需 CreateToolhelp32Snapshot）
}

; find-match: 進程名稱部分匹配（大小寫不敏感）
; pname: 進程名稱, target: 查找關鍵字
; 返回 yes=true=匹配成功
find-match = (pname str, target str) (yes bool) {

    ; 大小寫不敏感的部分匹配；用獨立函式確保 pname/target 型別為 str
    lower-pname = pname.to-lower()
    lower-target = target.to-lower()
    yes = lower-pname.contains(lower-target)
}

; find-by-name: 按名稱查找進程 PID
; name: 進程名稱（部分匹配，大小寫不敏感）
; 返回匹配的 PID 列表
find-by-name = (name str) (pids []i64) {
    all = list-all()
    i <- [0..all.len()): {

        #{index-out=0}
        p proc-info = all[i]
        yes = find-match(p.name, name)
        yes -> pids.push(p.pid)
    }
}

; ═══════════════════════════════════════════════
; spawn / wait（notools 擴展：watch/time/xargs/nohup/timeout 使用）
; ═══════════════════════════════════════════════

; spawn: 創建子進程執行命令字串
; cmd: 完整命令字串（將透過 sh -c 執行）
; 返回 pid > 0=父進程(子PID), -1=錯誤
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
spawn = (cmd str) (pid i64) {

    ; fork
    pid = process-fork()
    {
        pid == 0 -> {

            ; 子進程：用 sh -c 執行
            process-exec-shell(cmd)

            ; exec 失敗，退出
            os.exit(127)
        }

        pid < 0 -> {

            ; fork 失敗
            pid = -1
        }
    }
}

#{win-amd64, win-arm64}
spawn = (cmd str) (pid i64) {
    pid = -1
}

; wait: 等待指定子進程結束
; pid: 子進程 ID
; 返回 status=退出狀態碼（WEXITSTATUS）
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
wait = (pid i64) (status i64) {
    status = process-waitpid(pid, 0)
}

#{win-amd64, win-arm64}
wait = (pid i64) (status i64) {
    status = -1
}

; shell: 執行 shell 命令字串並等待完成（spawn + wait 組合）
; cmd: 完整命令字串（將透過 sh -c 執行）
; 返回 code=退出碼（0=成功, >0=命令錯誤, 127=exec 失敗, -1=fork 失敗）
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
shell = (cmd str) (code i64) {
    pid = spawn(cmd)
    {
        pid > 0 -> code = process-waitpid(pid, 0)

        pid < 0 -> code = -1
    }
}

#{win-amd64, win-arm64}
shell = (cmd str) (code i64) {
    code = -1
}
