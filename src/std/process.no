; process — 進程操作
;
; 提供進程創建、標準流獲取、進程等待、進程信息查詢等功能。
; 底層使用 POSIX fork/exec/pipe/waitpid 實作。
;
; 用法：
;   p = process{}
;   p.start('ls', '-la')
;   code = p.wait()
;   print('exit code: ' - code.to-str())
;
;   // 簡易 shell 命令執行
;   code = process-shell('echo hello')
;
;   // 完整功能的子進程執行器（扁平參數：program, args, dir, stdin, env, timeout, merge-err）
;   out, code, err = process.cmd('ls', args, '', '', env, 5000, 0)
;   print('out=' - out - ' code=' - code.to-str())

; ═══════════════════════════════════════════════
; 內建函數（底層實作）
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: process-fork)
; process-fork: fork 當前進程
; 返回 0=子進程, >0=父進程(子PID), -1=錯誤
; process-fork = () (pid i64) { }

; build-in (ForwardFunc: process-pipe)
; process-pipe: 建立管道
; 返回打包值 (read_fd << 32) | write_fd
; process-pipe = () (fds i64) { }

; build-in (ForwardFunc: process-waitpid)
; process-waitpid: 等待子進程
; 返回退出碼 (WEXITSTATUS)
; process-waitpid = (pid i64, options i64) (code i64) { }

; build-in (ForwardFunc: process-exec)
; process-exec: 替換當前進程
; 呼叫 execlp(program, program, arg, NULL)
; 僅在失敗時返回
; process-exec = (program str, arg str) (err i64) { }

; build-in (CLibCall: kill)
; process-kill: 發送信號給進程
; process-kill = (pid i64, sig i64) (ok bool) { }

; build-in (CLibCall: dup2)
; process-dup2: 複製檔案描述符
; process-dup2 = (oldfd i64, newfd i64) (newfd i64) { }

; build-in (CLibCall: getppid)
; process-getppid: 取得父進程 ID
; process-getppid = () (pid i64) { }

; build-in (CLibCall: system)
; process-system: 執行 shell 命令
; process-system = (cmd str) (status i64) { }

; build-in (ForwardFunc: process-exec-shell)
; process-exec-shell: 用 sh -c 執行命令字串（替換當前進程）
; cmd: 完整命令字串
; 僅在失敗時返回 errno
; process-exec-shell = (cmd str) (err i64) { }

; ═══════════════════════════════════════════════
; Windows 平台專用 Win32 API 內建函數
; 這些取代 process.c 的 C runtime，以純 Nolang 實現 process.cmd
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: win-create-pipe)
; win-create-pipe: 建立匿名管道（CreatePipe）
; 返回打包值 (read_handle << 32) | write_handle，0=失敗
; win-create-pipe = () (handles i64) { }

; build-in (ForwardFunc: win-close-handle)
; win-close-handle: 關閉 Windows handle（CloseHandle）
; win-close-handle = (handle i64) (ok bool) { }

; build-in (ForwardFunc: win-write-pipe)
; win-write-pipe: 寫入資料到管道/handle（WriteFile）
; 返回寫入位元組數，-1=錯誤
; win-write-pipe = (handle i64, data str) (written i64) { }

; build-in (ForwardFunc: win-read-pipe)
; win-read-pipe: 從管道/handle 讀取資料（ReadFile）
; 返回 (data, n)：n=讀取位元組數，-1=錯誤
; win-read-pipe = (handle i64, max-bytes i64) (data str, n i64) { }

; build-in (ForwardFunc: win-create-process)
; win-create-process: 創建子進程（CreateProcessA）
; cmdline: 完整命令列字串
; dir: 工作目錄（空=繼承）
; stdin-handle, stdout-handle, stderr-handle: 標準流 handle（0=繼承父進程）
; 返回 (proc-handle, status)：proc-handle>0=成功, 0=失敗
; win-create-process = (cmdline str, dir str, stdin-handle i64, stdout-handle i64, stderr-handle i64) (proc-handle i64, status i64) { }

; build-in (ForwardFunc: win-wait-process)
; win-wait-process: 等待進程結束（WaitForSingleObject）
; timeout-ms: 超時毫秒（0=無限等待）
; 返回 0=超時, 1=已退出, -1=錯誤
; win-wait-process = (proc-handle i64, timeout-ms i64) (status i64) { }

; build-in (ForwardFunc: win-get-exit-code)
; win-get-exit-code: 取得進程退出碼（GetExitCodeProcess）
; 返回 (exit-code, ok)：ok=false 表示仍在執行
; win-get-exit-code = (proc-handle i64) (exit-code i64, ok bool) { }

; build-in (ForwardFunc: win-terminate-process)
; win-terminate-process: 終止進程（TerminateProcess）
; win-terminate-process = (proc-handle i64, exit-code i64) (ok bool) { }

; build-in (ForwardFunc: win-get-std-handle)
; win-get-std-handle: 取得標準 handle（GetStdHandle）
; which: 0=stdin, 1=stdout, 2=stderr
; win-get-std-handle = (which i64) (handle i64) { }

; ═══════════════════════════════════════════════
; 信號常量
; ═══════════════════════════════════════════════

SIG-TERM = 15
SIG-KILL = 9
SIG-INT = 2
SIG-STOP = 19
SIG-CONT = 18
SIG-CHLD = 17

; waitpid options
WNOHANG = 1

; ═══════════════════════════════════════════════
; 執行選項（概念說明）
; ═══════════════════════════════════════════════
;
; process-run 的公開介面以「扁平參數」暴露執行選項（對應下列欄位）。
; 之所以不用 Run-Opts 結構體：nolang 目前跨模組傳遞結構體時
; 不會轉發其型別定義，會導致呼叫端 alloca %Run-Opts 失敗
; （"Cannot allocate unsized type"）。欄位順序即 process-run 的參數順序：
;   dir       : 工作目錄；空字串 = 繼承父進程工作目錄
;   stdin     : 寫入子進程 stdin 的內容；空字串 = 不提供 stdin
;   env       : 環境變數（["K=V", ...]）；空陣列 = 繼承父進程環境
;   timeout   : 超時時間（毫秒），<=0 = 無限等待
;   merge-err : 非 0 = 將 stderr 合併到捕獲的 out 中

; ═══════════════════════════════════════════════
; process 結構體
; ═══════════════════════════════════════════════

; process: 子進程
; pid: 子進程 ID
; stdin-fd: 寫入子進程標準輸入的 fd（-1=未連接）
; stdout-fd: 讀取子進程標準輸出的 fd（-1=未連接）
; stderr-fd: 讀取子進程標準錯誤的 fd（-1=未連接）
; exit-code: 子進程退出碼
; running: 是否仍在執行（0=否, 1=是）
process {
    pid i64
    stdin-fd fd
    stdout-fd fd
    stderr-fd fd
    exit-code i64
    running i64
}

; ═══════════════════════════════════════════════
; 進程創建
; ═══════════════════════════════════════════════

; start: 創建子進程並執行命令
; program: 要執行的程式名（PATH 搜尋）
; arg: 傳給程式的參數
; 返回 ok=true=成功
process.start = (program str, arg str) (ok bool) {
    ok = false
    .pid = 0
    .stdin-fd = -1
    .stdout-fd = -1
    .stderr-fd = -1
    .exit-code = 0
    .running = 0

    ; 建立 stdout 管道
    fds = process-pipe()
    stdout-read = fds >> 32
    stdout-write = fds & 0xffffffff

    ; fork
    pid = process-fork()
    {
        pid == 0 -> {

            ; 子進程：重定向 stdout 到管道寫端
            process-dup2(stdout-write, 1)
            fs.close(stdout-read)
            fs.close(stdout-write)

            ; exec
            process-exec(program, arg)

            ; exec 失敗，退出
            os.exit(1)
        }
        pid < 0 -> {

            ; fork 失敗
            fs.close(stdout-read)
            fs.close(stdout-write)
            return
        }
    }

    ; 父進程
    .pid = pid
    .stdout-fd = stdout-read
    .stdin-fd = -1
    .stderr-fd = -1
    .exit-code = 0
    .running = 1
    ok = true

    ; 關閉不需要的寫端
    fs.close(stdout-write)
}

; start-with-stdin: 創建子進程，同時建立 stdin 管道
; 返回 ok=true=成功
process.start-with-stdin = (program str, arg str) (ok bool) {
    ok = false
    .pid = 0
    .stdin-fd = -1
    .stdout-fd = -1
    .stderr-fd = -1
    .exit-code = 0
    .running = 0

    ; 建立 stdin 管道
    in-fds = process-pipe()
    in-read = in-fds >> 32
    in-write = in-fds & 0xffffffff

    ; 建立 stdout 管道
    out-fds = process-pipe()
    out-read = out-fds >> 32
    out-write = out-fds & 0xffffffff

    pid = process-fork()
    {
        pid == 0 -> {

            ; 子進程
            process-dup2(in-read, 0)
            process-dup2(out-write, 1)
            fs.close(in-read)
            fs.close(in-write)
            fs.close(out-read)
            fs.close(out-write)
            process-exec(program, arg)
            os.exit(1)
        }
        pid < 0 -> {
            fs.close(in-read)
            fs.close(in-write)
            fs.close(out-read)
            fs.close(out-write)
            return
        }
    }

    ; 父進程
    .pid = pid
    .stdin-fd = in-write
    .stdout-fd = out-read
    .stderr-fd = -1
    .exit-code = 0
    .running = 1
    ok = true
    fs.close(in-read)
    fs.close(out-write)
}

; ═══════════════════════════════════════════════
; 進程等待
; ═══════════════════════════════════════════════

; wait: 等待子進程結束
; 返回 exit-code=退出碼, ok=true=成功
process.wait = () (ok bool) {
    ok = false
    .running == 0 -> {
        ok = true
        return
    }
    code = process-waitpid(.pid, 0)
    .exit-code = code
    .running = 0
    ok = true
}

; wait-nohang: 非阻塞等待（輪詢）
; 返回 ok=true=子進程已結束, false=仍在執行
process.wait-nohang = () (ok bool) {
    ok = false
    .running == 0 -> {
        ok = true
        return
    }
    code = process-waitpid(.pid, WNOHANG)

    ; waitpid with WNOHANG returns 0 if child still running
    ; but our builtin returns exit code, so we check if code changed
    ; Actually WNOHANG returns 0 if no child exited, non-zero exit code if exited
    ; This is a limitation - we can't distinguish "still running" from "exit code 0"
    ; For now, assume WNOHANG returns 0 means still running
    code == 0 -> return
    .exit-code = code
    .running = 0
    ok = true
}

; ═══════════════════════════════════════════════
; 進程控制
; ═══════════════════════════════════════════════

; kill: 發送信號給子進程
; sig: 信號編號（如 SIG-TERM=15, SIG-KILL=9）
; 返回 ok=true=成功
process.kill = (sig i64) (ok bool) {
    ok = process-kill(.pid, sig)
}

; terminate: 發送 SIG-TERM 信號
; 返回 ok=true=成功
process.terminate = () (ok bool) {
    ok = .kill(SIG-TERM)
}

; force-kill: 發送 SIG-KILL 信號
; 返回 ok=true=成功
process.force-kill = () (ok bool) {
    ok = .kill(SIG-KILL)
}

; ═══════════════════════════════════════════════
; 標準流操作
; ═══════════════════════════════════════════════

; read: 從子進程的 stdout 讀取資料
; 返回 read-n=實際讀取位元組數
process.read = (buf str, n i64) (read-n i64) {
    read-n = 0
    .stdout-fd < 0 -> return
    read-n = fs.read(.stdout-fd, buf, n)
}

; read-line: 從子進程的 stdout 讀取一行
; 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
process.read-line = () (line ?str) {
    line = nil
    .stdout-fd < 0 -> return
    buf str = with-cap(4096)
    n = fs.read(.stdout-fd, buf, 4096)
    n > 0 -> line = buf
}

; read-all: 讀取子進程的所有 stdout 輸出
; 返回 content=讀取內容, n=讀取位元組數
process.read-all = () (content str, n i64) {
    n = 0
    .stdout-fd < 0 -> return
    buf str = with-len(4096)
    {
        chunk-n = fs.read(.stdout-fd, buf, 4096)
        chunk-n <= 0 -> *
        i <- [0..chunk-n): {
            content[n + i] = buf[i]
        }
        n = n + chunk-n
    } (true)
}

; write: 寫入資料到子進程的 stdin
; 返回 written=實際寫入位元組數
process.write = (data str, n i64) (written i64) {
    written = 0
    .stdin-fd < 0 -> return
    written = fs.write(.stdin-fd, data, n)
}

; close-stdin: 關閉子進程的 stdin 管道
process.close-stdin = () {
    .stdin-fd >= 0 -> {
        fs.close(.stdin-fd)
        .stdin-fd = -1
    }
}

; close-stdout: 關閉子進程的 stdout 管道
process.close-stdout = () {
    .stdout-fd >= 0 -> {
        fs.close(.stdout-fd)
        .stdout-fd = -1
    }
}

; close-stderr: 關閉子進程的 stderr 管道
process.close-stderr = () {
    .stderr-fd >= 0 -> {
        fs.close(.stderr-fd)
        .stderr-fd = -1
    }
}

; ═══════════════════════════════════════════════
; 進程信息
; ═══════════════════════════════════════════════

; pid: 取得子進程 ID
process.pid-of = () (pid i64) {
    pid = .pid
}

; exit-code: 取得退出碼
process.exit-code-of = () (code i64) {
    code = .exit-code
}

; is-running: 判斷子進程是否仍在執行
process.is-running = () (yes bool) {
    yes = .running == 1
}

; parent-pid: 取得父進程 ID（靜態方法）
process.parent-pid = () (pid i64) {
    pid = process-getppid()
}

; ═══════════════════════════════════════════════
; 生命週期管理
; ═══════════════════════════════════════════════

; close: 關閉所有管道並等待子進程
process.close = () {
    .close-stdin()
    .close-stdout()
    .close-stderr()
    .running == 1 -> .wait()
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; process-shell: 執行 shell 命令字串並等待完成（透過 sh -c）
; 返回 status=退出狀態
process-shell = (cmd str) (status i64) {
    status = process-system(cmd)
}

; process.cmd: 完整功能的子進程執行器（跨平台生產級實作）
; program   : 要執行的程式名（PATH 搜尋）
; args      : 傳給程式的參數列表
; dir       : 工作目錄；空字串 = 繼承父進程工作目錄
; input     : 寫入子進程 stdin 的內容；空字串 = 不提供 stdin
;             （參數名用 input 而非 stdin，因 std/fs.no 已預定義全域 stdin/file 句柄，
;               同名校驗名會與該全域變數的 SSA 名 %stdin 衝突，導致呼叫端誤用全域。）
; env       : 環境變數（["K=V", ...]）；空陣列 = 繼承父進程環境
; timeout   : 超時時間（毫秒），<=0 = 無限等待
; merge-err : 非 0 = 將 stderr 合併到捕獲的 out 中
; 返回 out=捕獲的 stdout（merge-err 時含 stderr），code=退出碼，err=錯誤訊息
;   code >= 0 : 正常退出碼
;   code == -1 : 啟動 / exec 失敗
;   code == -2 : 超時（子進程已被殺死）

; POSIX 版本：底層呼叫 process-run-capture 內建函數（C runtime: src/build/runtime/process.c），
; 支援 argv 陣列、環境變數、工作目錄、stdin、超時與 stderr 合併。
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64, wasi-wasm32}
process.cmd = (program str, args []str, dir str, input str, env []str, timeout i64, merge-err i64) (out str, code i64, err str) {

    ; 構建 argv = [program] + args
    argv []str = with-len(args.len + 1)
    argv[0] = program
    i <- [0..args.len): {
        argv[i + 1] = args[i]
    }
    out, status = process-run-capture(argv, env, dir, input, timeout, merge-err)
    code = status
    err = ''
    {
        code == -1 -> err = 'failed to start or exec process'
        code == -2 -> err = 'process timed out'
    }
}

; Windows 版本：使用 Win32 API（CreateProcessA、CreatePipe 等）以純 Nolang 實現。
; 不依賴 process.c C runtime，所有進程創建、管道管理、輸出捕獲均透過
; win-create-process、win-create-pipe、win-read-pipe 等 ForwardFunc 內建完成。
#{win-amd64, win-arm64}
process.cmd = (program str, args []str, dir str, input str, env []str, timeout i64, merge-err i64) (out str, code i64, err str) {
    out = ''
    code = -1
    err = ''

    ; 構建命令列字串：program + " " + arg1 + " " + arg2 + ...
    cmdline str = program
    i <- [0..args.len): {
        arg str = args[i]
        ; 含空格的參數需要加引號
        has-space = arg.contains(' ')
        has-space != 0 -> {
            cmdline = cmdline - ' "' - arg - '"'
        } has-space == 0 -> {
            cmdline = cmdline - ' ' - arg
        }
    }

    ; 建立 stdout 管道
    out-fds = win-create-pipe()
    {
        out-fds == 0 -> {
            err = 'failed to create stdout pipe'
            return
        }
    }
    out-read = out-fds >> 32
    out-write = out-fds & 0xffffffff

    ; 建立 stderr 管道（除非 merge-err）
    err-read i64 = 0
    err-write i64 = 0
    {
        merge-err == 0 -> {
            err-fds = win-create-pipe()
            {
                err-fds == 0 -> {
                    win-close-handle(out-read)
                    win-close-handle(out-write)
                    err = 'failed to create stderr pipe'
                    return
                }
            }
            err-read = err-fds >> 32
            err-write = err-fds & 0xffffffff
        }
    }

    ; 建立 stdin 管道（如有 input）
    in-read i64 = 0
    in-write i64 = 0
    {
        input.len > 0 -> {
            in-fds = win-create-pipe()
            {
                in-fds == 0 -> {
                    win-close-handle(out-read)
                    win-close-handle(out-write)
                    {
                        merge-err == 0 -> {
                            win-close-handle(err-read)
                            win-close-handle(err-write)
                        }
                    }
                    err = 'failed to create stdin pipe'
                    return
                }
            }
            in-read = in-fds >> 32
            in-write = in-fds & 0xffffffff
        }
    }

    ; 取得父進程標準 handle（當對應 handle 為 0 時使用）
    parent-stdin = win-get-std-handle(0)
    parent-stdout = win-get-std-handle(1)
    parent-stderr = win-get-std-handle(2)

    ; 決定傳給子進程的標準 handle
    child-stdin i64 = 0
    child-stdout i64 = 0
    child-stderr i64 = 0
    child-stdin = in-read != 0 ? in-read : parent-stdin
    child-stdout = out-write
    child-stderr = merge-err != 0 ? out-write : err-write

    ; 創建子進程
    proc-handle, status = win-create-process(cmdline, dir, child-stdin, child-stdout, child-stderr)

    ; 父進程關閉子進程端的 handle
    win-close-handle(out-write)
    {
        merge-err == 0 -> {
            err-write != 0 -> win-close-handle(err-write)
        }
    }
    {
        in-read != 0 -> win-close-handle(in-read)
    }

    {
        proc-handle == 0 -> {
            win-close-handle(out-read)
            {
                merge-err == 0 -> {
                    err-read != 0 -> win-close-handle(err-read)
                }
            }
            {
                in-write != 0 -> win-close-handle(in-write)
            }
            err = 'failed to create process'
            return
        }
    }

    ; 寫入 stdin
    {
        in-write != 0 -> {
            win-write-pipe(in-write, input)
            win-close-handle(in-write)
        }
    }

    ; 等待進程結束（含超時）
    {
        timeout > 0 -> {
            wait-status = win-wait-process(proc-handle, timeout)
            {
                wait-status == 0 -> {
                    ; 超時，終止進程
                    win-terminate-process(proc-handle, 1)
                    win-wait-process(proc-handle, 0)
                    code = -2
                    err = 'process timed out'
                } !wait-status == 0 -> {
                    ; 已退出
                    exit-code, ok = win-get-exit-code(proc-handle)
                    code = exit-code
                }
            }
        } timeout <= 0 -> {
            ; 無限等待
            win-wait-process(proc-handle, 0)
            exit-code, ok = win-get-exit-code(proc-handle)
            code = exit-code
        }
    }

    ; 讀取 stdout 輸出
    {
        true -> {
            chunk str = ''
            chunk-n i64 = 0
            {
                chunk, chunk-n = win-read-pipe(out-read, 4096)
                chunk-n > 0 -> {
                    out = out - chunk
                }
            } (chunk-n > 0)
        }
    }
    win-close-handle(out-read)

    ; 讀取 stderr 輸出（如果不 merge-err，丟棄）
    {
        merge-err == 0 -> {
            {
                err-read != 0 -> {
                    chunk str = ''
                    chunk-n i64 = 0
                    {
                        chunk, chunk-n = win-read-pipe(err-read, 4096)
                        chunk-n > 0 -> *
                    } (chunk-n > 0)
                    win-close-handle(err-read)
                }
            }
        }
    }

    win-close-handle(proc-handle)
}

; cmdopts: process.run 的執行選項（跨模組結構體示例）。
; 欄位對應 process.cmd 的扁平參數：
;   dir       : 工作目錄；空字串 = 繼承父進程工作目錄
;   stdin     : 寫入子進程 stdin 的內容；空字串 = 不提供 stdin
;   env       : 環境變數（["K=V", ...]）；空陣列 = 繼承父進程環境
;   timeout   : 超時時間（毫秒），<=0 = 無限等待
;   merge-err : 非 0 = 將 stderr 合併到捕獲的 out 中
cmdopts {
    dir str
    stdin str
    env []str
    timeout i64
    merge-err i64
}

; exec: 以結構體選項執行子進程（跨模組結構體參數示例）。
; 演示 nolang 的跨模組結構體轉發：cmdopts 定義於本模組，
; 呼叫端在另一模組構造 process.cmdopts{...} 並傳入。
; 註：函數名為 exec 而非 run，因 run 是語言保留字（關鍵字）。
process.exec = (program str, args []str, o cmdopts) (out str, code i64, err str) {
    out, code, err = process.cmd(program, args, o.dir, o.stdin, o.env, o.timeout, o.merge-err)
}

; process-output: 執行命令並捕獲 stdout 輸出
; 返回 content=輸出內容, code=退出碼
process-output = (program str, arg str) (content str, code i64) {
    p = process {}
    p.start(program, arg)
    content, n = p.read-all()
    p.wait()
    code = p.exit-code
    p.close()
}

; ═══════════════════════════════════════════════
; 進程列表與查找（notools 擴展）
; ═══════════════════════════════════════════════

; proc-info: 進程資訊
; pid: 進程 ID
; name: 進程名稱（Linux 取自 /proc/<pid>/comm，最長 15 字元）
proc-info {
    pid i64
    name str
}

; list-all: 列出系統中所有進程
; Linux: 遍歷 /proc，讀取每個 PID 目錄下的 /proc/<pid>/comm 取得進程名
; macOS/Windows: 暫時返回空列表（需 libproc/sysctl 或 CreateToolhelp32Snapshot 支持）
; 返回 proc-info 列表

#{linux-amd64, linux-arm64}
process.list-all = () (procs []proc-info) {
    names = fs.list-dir('/proc')
    i <- [0..names.len): {
        name = names[i]

        ; 只處理全數字條目（PID 目錄）
        pid-val ?i64 = name.to-i64()
        pid-val: {
            ok -> {
                p = proc-info {}
                p.pid = it

                ; 讀取 /proc/<pid>/comm 取得進程名
                comm-path = '/proc/' - name - '/comm'
                comm = fs.read-file(comm-path)
                comm.len > 0 -> p.name = comm.trim()
                procs.push(p)
            }
            nil ->
            err ->
        }
    }
}

#{mac-amd64, mac-arm64}
process.list-all = () (procs []proc-info) {
    ; macOS 暫時返回空列表（需 libproc proc_listallpids 或 sysctl KERN_PROC）
}

#{win-amd64, win-arm64}
process.list-all = () (procs []proc-info) {
    ; Windows 暫時返回空列表（需 CreateToolhelp32Snapshot）
}

; find-by-name: 按名稱查找進程 PID
; name: 進程名稱（部分匹配，大小寫不敏感）
; 返回匹配的 PID 列表
process-find-match = (pname str, target str) (yes bool) {

    ; 大小寫不敏感的部分匹配；用獨立函式確保 pname/target 型別為 str
    lower-pname = pname.to-lower()
    lower-target = target.to-lower()
    yes = lower-pname.contains(lower-target)
}

process.find-by-name = (name str) (pids []i64) {
    all []proc-info = process.list-all()
    i <- [0..all.len): {
        p proc-info = all[i]
        yes = process-find-match(p.name, name)
        yes -> pids.push(p.pid)
    }
}

; ═══════════════════════════════════════════════
; spawn / wait（notools 擴展：watch/time/xargs/nohup/timeout 使用）
; ═══════════════════════════════════════════════

; spawn: 創建子進程執行命令字串
; cmd: 完整命令字串（將透過 sh -c 執行）
; 返回 pid > 0=父進程(子PID), -1=錯誤
process-spawn = (cmd str) (pid i64) {

    ; fork
    pid = process-fork()
    {
        pid == 0 -> {

            ; 子進程：用 sh -c 執行
            process-exec-shell(cmd)

            ; exec 失敗，退出
            os.exit(127)
        }
        pid < 0 -> {

            ; fork 失敗
            pid = -1
        }
    }
}

; wait: 等待指定子進程結束
; pid: 子進程 ID
; 返回 status=退出狀態碼（WEXITSTATUS）
process-wait = (pid i64) (status i64) {
    status = process-waitpid(pid, 0)
}
