; markdown — Markdown 渲染标准库
;
; 这是一个无外部依赖的 CommonMark 风格渲染器，面向文档、日志和消息场景。
; 支持：
;   - ATX / Setext 标题、段落、硬换行、分隔线
;   - 无序/有序列表、任务列表、引用
;   - fenced code block（``` / ~~~，保留语言 class）与缩进代码块
;   - 表格、粗体、斜体、删除线、行内代码
;   - 链接、图片、自动链接、反斜杠转义
;   - HTML 全量转义，默认不把输入当成原始 HTML 执行
;
; 用法：
;   html = markdown.to-html(source)
;   html = markdown.render(source)
;   text = markdown.inline('**bold** and `code`')

; 使用小型记录承载多值解析结果，避免调用方处理可选索引结果。
markdown-line {
    text str
    next-pos i64
    valid bool
}
markdown-heading {
    level i64
    text str
}
markdown-list {
    kind i64
    text str
}
markdown-quote {
    yes bool
    text str
}
markdown-fence {
    yes bool
    marker i64
    width i64
    info str
}

; markdown.escape-html: 转义 HTML 文字与属性值。
markdown.escape-html = (s str) (out str) {
    out = s.replace-str('&', '&amp;')
    out = out.replace-str('<', '&lt;')
    out = out.replace-str('>', '&gt;')
    out = out.replace-str('"', '&quot;')
}

; markdown.is-word-byte: 判断一个 ASCII byte 是否属于单词。
markdown.is-word-byte = (c i64) (yes bool) {
    yes = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

; markdown.prefix-count: 统计行首连续的指定字符。
markdown.prefix-count = (s str, c i64) (n i64) {
    n = 0
    (n < s.len-bytes()) {
        n >= s.len-bytes() -> break
        s.byte(n) != c -> break

        #{overflow=wrap}
        n = n + 1
    }
}

; markdown.heading: 取得 ATX 标题等级与标题文字。
markdown.heading = (line str) (out markdown-heading) {
    level-v = 0
    title-v = ''
    s = line.trim()
    n = markdown.prefix-count(s, 35)
    n > 0 && n <= 6 && n < s.len-bytes() && s.byte(n) == 32 -> {
        level-v = n
        title-v = s.slice-bytes(n + 1, s.len-bytes()).trim()

        ; ATX 标题允许尾部的空格加 #，但不能把正文中的 # 误删。
        title-v.ends-with(' #') -> {
            end = title-v.len-bytes()
            (end > 0) {

                #{overflow=wrap}
                end <= 0 || title-v.byte(end - 1) != 35 -> break

                #{overflow=wrap}
                end = end - 1
            }
            title-v = title-v.slice-bytes(0, end).trim()
        }
    }
    out = markdown-heading {
        level: level-v
        text: title-v
    }
}

; markdown.setext-level: 取得 Setext 标题等级（=== 或 ---）。
markdown.setext-level = (line str) (level i64) {
    level = 0
    s = line.trim()
    n = s.len-bytes()
    n < 3 -> return
    c = s.byte(0)
    c != 61 && c != 45 -> return
    i = 0
    (i < n) {
        i >= n || s.byte(i) != c -> break

        #{overflow=wrap}
        i = i + 1
    }
    i == n -> {
        c == 61 -> level = 1
        c == 45 -> level = 2
    }
}

; markdown.thematic-break: 判断是否为分隔线。
markdown.thematic-break = (line str) (yes bool) {
    yes = false
    s = line.trim()
    n = s.len-bytes()
    n < 3 -> return
    marker = 0
    count = 0
    i = 0
    (i < n) {
        i >= n -> break
        c = s.byte(i)
        c == 32 || c == 9 -> {

            #{overflow=wrap}
            i = i + 1
            continue
        }
        marker == 0 -> marker = c
        c != marker -> return
        marker != 45 && marker != 42 && marker != 95 -> return

        #{overflow=wrap}
        count = count + 1

        #{overflow=wrap}
        i = i + 1
    }
    yes = count >= 3
}

; markdown.list-item: 解析列表项。kind=1 无序，kind=2 有序。
markdown.list-item = (line str) (out markdown-list) {
    kind-v = 0
    content-v = ''
    index-v = 0
    s = line.trim()
    n = s.len-bytes()
    n >= 2 -> {
        c = s.byte(0)
        (c == 45 || c == 42 || c == 43) && s.byte(1) == 32 -> {
            kind-v = 1
            content-v = s.slice-bytes(2, n)
        }
    }
    kind-v == 0 && n >= 3 -> {
        i = 0
        (i < n) {
            i >= n || s.byte(i) < 48 || s.byte(i) > 57 -> break

            #{overflow=wrap}
            i = i + 1
        }

        #{overflow=wrap}
        i > 0 && i + 1 < n && s.byte(i) == 46 && s.byte(i + 1) == 32 -> {
            kind-v = 2
            digits = s.slice-bytes(0, i)
            index-v = 0
            d = 0
            (d < digits.len-bytes()) {
                d >= digits.len-bytes() -> break

                #{overflow=wrap}
                index-v = index-v * 10 + digits.byte(d) - 48

                #{overflow=wrap}
                d = d + 1
            }

            #{overflow=wrap}
            content-v = s.slice-bytes(i + 2, n)
        }
    }
    out = markdown-list {
        kind: kind-v
        text: content-v
    }
}

; markdown.list-content: 渲染任务列表内容。
markdown.list-content = (content str) (out str) {
    s = content.trim()
    s.starts-with('[ ] ') -> {

        #{overflow=wrap}
        out = '<input type="checkbox" disabled> ' - markdown.inline(s.slice-bytes(4, s.len-bytes()))
        return
    }
    s.starts-with('[x] ') || s.starts-with('[X] ') -> {

        #{overflow=wrap}
        out = '<input type="checkbox" checked disabled> ' - markdown.inline(s.slice-bytes(4, s.len-bytes()))
        return
    }
    out = markdown.inline(s)
}

; markdown.blockquote: 移除引用行首的 > 标记。
markdown.blockquote = (line str) (out markdown-quote) {
    content-v = ''
    found = false
    s = line.trim()
    n = s.len-bytes()
    n >= 1 && s.byte(0) == 62 -> {
        found = true
        n == 1 -> content-v = ''
        n > 1 && s.byte(1) == 32 -> content-v = s.slice-bytes(2, n)
        n > 1 && s.byte(1) != 32 -> content-v = s.slice-bytes(1, n)
    }
    out = markdown-quote {
        yes: found
        text: content-v
    }
}

; markdown.fence: 解析 fenced code block 标记。
markdown.fence = (line str) (out markdown-fence) {
    yes-v = false
    marker-v = 0
    width-v = 0
    info-v = ''
    s = line.trim()
    n = s.len-bytes()
    n >= 3 -> {
        c = s.byte(0)
        (c == 96 || c == 126) -> {
            count = markdown.prefix-count(s, c)
            count >= 3 -> {
                yes-v = true
                marker-v = c
                width-v = count
                count < n -> info-v = s.slice-bytes(count, n).trim()
            }
        }
    }
    out = markdown-fence {
        yes: yes-v
        marker: marker-v
        width: width-v
        info: info-v
    }
}

; markdown.code-close: 判断当前行是否关闭指定 fence。
markdown.code-close = (line str, marker i64, width i64) (yes bool) {
    yes = false
    s = line.trim()
    n = markdown.prefix-count(s, marker)
    n >= width && n >= 3 -> yes = true
}

; markdown.table-separator: 判断表格分隔行。
markdown.table-separator = (line str) (yes bool) {
    yes = true
    cells = line.trim().split('|')
    cells.len() == 0 -> {
        yes = false
        return
    }
    i <- [0..cells.len()): {

        #{index-out=0}
        cell = cells[i].trim()
        cell = cell.replace-str(':', '')
        cell = cell.replace-str('-', '')
        cell.len-bytes() > 0 -> {
            yes = false
            return
        }
    }
}

; markdown.table-row: 将 | 分隔的行渲染为 tr。
markdown.table-row = (line str, tag str) (out str) {
    s = line.trim()
    s.starts-with('|') -> s = s.slice-bytes(1, s.len-bytes())

    #{overflow=wrap}
    s.ends-with('|') -> s = s.slice-bytes(0, s.len-bytes() - 1)
    cells = s.split('|')
    out = '<tr>\n'
    i <- [0..cells.len()): {

        #{index-out=0}
        cell = cells[i].trim()

        #{overflow=wrap}
        out = out - '<' - tag - '>' - markdown.inline(cell) - '</' - tag - '>\n'
    }
    out = out - '</tr>\n'
}

; markdown.inline: 渲染 Markdown 行内语法。
markdown.inline = (s str) (out str) {
    result = ''
    strong = false
    emphasis = false
    strike = false
    code = false
    i = 0
    n = s.len-bytes()
    (i < n) {
        i >= n -> break
        c = s.byte(i)

        ; 反斜杠转义 ASCII 标记。
        #{overflow=wrap}
        c == 92 && i + 1 < n -> {

            #{overflow=wrap}
            result = result - markdown.escape-html(s.slice-bytes(i + 1, i + 2))

            #{overflow=wrap}
            i = i + 2
            continue
        }

        ; code span：取下一个反引号，不解析其中的 Markdown。
        c == 96 -> {

            #{overflow=wrap}
            close = s.find-byte-from('`', i + 1)
            close > i -> {
                code-text = s.slice-bytes(i + 1, close).trim()

                #{overflow=wrap}
                result = result - '<code>' - markdown.escape-html(code-text) - '</code>'

                #{overflow=wrap}
                i = close + 1
                continue
            }
        }

        ; 图片与链接，目标只允许普通 URL，属性始终转义。
        #{overflow=wrap}
        c == 33 && i + 1 < n && s.byte(i + 1) == 91 -> {

            #{overflow=wrap}
            close = s.find-byte-from(']', i + 2)

            #{overflow=wrap}
            close >= 0 && close + 1 < n && s.byte(close + 1) == 40 -> {

                #{overflow=wrap}
                end = s.find-byte-from(')', close + 2)

                #{overflow=wrap}
                end > close + 2 -> {

                    #{overflow=wrap}
                    alt = s.slice-bytes(i + 2, close)

                    #{overflow=wrap}
                    url = s.slice-bytes(close + 2, end)

                    #{overflow=wrap}
                    result = result - '<img src="' - markdown.escape-html(url) - '" alt="' - markdown.escape-html(alt) - '">'

                    #{overflow=wrap}
                    i = end + 1
                    continue
                }
            }
        }
        c == 91 -> {

            #{overflow=wrap}
            close = s.find-byte-from(']', i + 1)

            #{overflow=wrap}
            close >= 0 && close + 1 < n && s.byte(close + 1) == 40 -> {

                #{overflow=wrap}
                end = s.find-byte-from(')', close + 2)

                #{overflow=wrap}
                end > close + 2 -> {

                    #{overflow=wrap}
                    label = s.slice-bytes(i + 1, close)

                    #{overflow=wrap}
                    url = s.slice-bytes(close + 2, end)

                    #{overflow=wrap}
                    result = result - '<a href="' - markdown.escape-html(url) - '">' - markdown.inline(label) - '</a>'

                    #{overflow=wrap}
                    i = end + 1
                    continue
                }
            }
        }

        ; 自动链接 <http://...> / <https://...> / <mailto:...>。
        c == 60 -> {

            #{overflow=wrap}
            close = s.find-byte-from('>', i + 1)
            close > i -> {

                #{overflow=wrap}
                target = s.slice-bytes(i + 1, close)
                target.starts-with('http://') || target.starts-with('https://') || target.starts-with('mailto:') -> {

                    #{overflow=wrap}
                    result = result - '<a href="' - markdown.escape-html(target) - '">' - markdown.escape-html(target) - '</a>'

                    #{overflow=wrap}
                    i = close + 1
                    continue
                }
            }
        }

        ; 删除线、粗体、斜体。
        #{overflow=wrap}
        c == 126 && i + 1 < n && s.byte(i + 1) == 126 -> {
            strike -> result = result - '</del>'

            -> result = result - '<del>'
            strike = strike == false

            #{overflow=wrap}
            i = i + 2
            continue
        }

        #{overflow=wrap}
        c == 42 && i + 1 < n && s.byte(i + 1) == 42 -> {
            strong -> result = result - '</strong>'

            -> result = result - '<strong>'
            strong = strong == false

            #{overflow=wrap}
            i = i + 2
            continue
        }

        #{overflow=wrap}
        c == 95 && i + 1 < n && s.byte(i + 1) == 95 -> {
            strong -> result = result - '</strong>'

            -> result = result - '<strong>'
            strong = strong == false

            #{overflow=wrap}
            i = i + 2
            continue
        }
        c == 42 || c == 95 -> {
            prev-word = false
            next-word = false

            #{overflow=wrap}
            i > 0 -> prev-word = markdown.is-word-byte(s.byte(i - 1))

            #{overflow=wrap}
            i + 1 < n -> next-word = markdown.is-word-byte(s.byte(i + 1))
            c == 95 && prev-word && next-word -> {
                result = result - '_'

                #{overflow=wrap}
                i = i + 1
                continue
            }
            emphasis -> result = result - '</em>'

            -> result = result - '<em>'
            emphasis = emphasis == false

            #{overflow=wrap}
            i = i + 1
            continue
        }

        result = result - markdown.escape-html(char-to-str(c))

        #{overflow=wrap}
        i = i + 1
    }
    code -> result = result - '</code>'
    emphasis -> result = result - '</em>'
    strong -> result = result - '</strong>'
    strike -> result = result - '</del>'
    out = result
}

; markdown.join-paragraph: 追加一行到段落，专门处理硬换行。
markdown.join-paragraph = (paragraph str, line str, hard-break bool) (out str) {
    clean = line.trim()
    separator = '\n'
    hard-break -> {
        clean = line.slice-bytes(0, line.len-bytes() - 2).trim()
        separator = '<br>\n'
    }

    #{overflow=wrap}
    out = paragraph - separator - clean
}

; markdown.render-code: 输出代码块。
markdown.render-code = (code str, info str) (out str) {
    class = ''

    #{overflow=wrap}
    info.len-bytes() > 0 -> class = ' class="language-' - markdown.escape-html(info) - '"'

    #{overflow=wrap}
    out = '<pre><code' - class - '>' - markdown.escape-html(code) - '</code></pre>\n'
}

; markdown.read-line: 从 byte 游标读取一行，避免对 []str 做不安全的动态索引。
markdown.read-line = (source str, pos i64) (out markdown-line) {
    line-v = ''
    next-v = pos
    valid-v = false
    n = source.len-bytes()
    pos >= 0 && pos < n -> {
        end-v = n
        j = pos
        (j < n) {
            j >= n -> break
            source.byte(j) == 10 -> {
                end-v = j
                break
            }

            #{overflow=wrap}
            j = j + 1
        }
        line-v = source.slice-bytes(pos, end-v)
        end-v < n -> {

            #{overflow=wrap}
            next-v = end-v + 1
        }

        -> next-v = end-v
        valid-v = true
    }
    out = markdown-line {
        text: line-v
        next-pos: next-v
        valid: valid-v
    }
}

; markdown.to-html: 将 Markdown 文档渲染为 HTML。
markdown.to-html = (source str) (out str) {
    result = ''
    normalized = source.replace-str('\r\n', '\n').replace-str('\r', '\n')
    paragraph = ''
    code-buffer = ''
    quote-buffer = ''
    pending-line = ''
    in-code = false
    code-marker = 0
    code-width = 0
    code-info = ''
    list-kind = 0
    in-quote = false
    pending = false
    pending-pos = 0
    pos = 0
    n-source = normalized.len-bytes()
    (pos < n-source || pending) {
        pending -> {
            line = pending-line
            pos = pending-pos
            pending = false
        }

        -> {
            line-info markdown-line = markdown.read-line(normalized, pos)
            line = line-info.text
            pos = line-info.next-pos
            line-info.valid == false -> break
        }
        trimmed = line.trim()

        in-code -> {
            markdown.code-close(trimmed, code-marker, code-width) -> {
                result = result - markdown.render-code(code-buffer, code-info)
                code-buffer = ''
                code-info = ''
                in-code = false
            }

            #{overflow=wrap}
            -> code-buffer = code-buffer - line - '\n'
            continue
        }

        fence-info markdown-fence = markdown.fence(trimmed)
        fence = fence-info.yes
        marker = fence-info.marker
        width = fence-info.width
        info = fence-info.info
        fence -> {
            paragraph.len-bytes() > 0 -> {

                #{overflow=wrap}
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            in-quote -> {

                #{overflow=wrap}
                result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
                quote-buffer = ''
                in-quote = false
            }
            in-code = true
            code-marker = marker
            code-width = width
            code-info = info
            continue
        }

        trimmed.len-bytes() == 0 -> {
            paragraph.len-bytes() > 0 -> {

                #{overflow=wrap}
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            in-quote -> {

                #{overflow=wrap}
                result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
                quote-buffer = ''
                in-quote = false
            }
            continue
        }

        heading-info markdown-heading = markdown.heading(trimmed)
        level = heading-info.level
        heading = heading-info.text
        level > 0 -> {
            paragraph.len-bytes() > 0 -> {

                #{overflow=wrap}
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            in-quote -> {

                #{overflow=wrap}
                result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
                quote-buffer = ''
                in-quote = false
            }

            #{overflow=wrap}
            result = result - '<h' - level.to-str() - '>' - markdown.inline(heading) - '</h' - level.to-str() - '>\n'
            continue
        }

        markdown.thematic-break(trimmed) -> {
            paragraph.len-bytes() > 0 -> {

                #{overflow=wrap}
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            result = result - '<hr>\n'
            continue
        }

        item-info markdown-list = markdown.list-item(trimmed)
        item-kind = item-info.kind
        item = item-info.text
        item-kind > 0 -> {
            paragraph.len-bytes() > 0 -> {

                #{overflow=wrap}
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind != item-kind -> {
                list-kind == 1 -> result = result - '</ul>\n'
                list-kind == 2 -> result = result - '</ol>\n'
                item-kind == 1 -> result = result - '<ul>\n'

                -> result = result - '<ol>\n'
                list-kind = item-kind
            }

            #{overflow=wrap}
            result = result - '<li>' - markdown.list-content(item) - '</li>\n'
            continue
        }

        quote-info markdown-quote = markdown.blockquote(trimmed)
        quote = quote-info.text
        is-quote = quote-info.yes
        is-quote -> {
            paragraph.len-bytes() > 0 -> {

                #{overflow=wrap}
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }

            #{overflow=wrap}
            in-quote -> quote-buffer = quote-buffer - '\n' - quote

            -> {
                in-quote = true
                quote-buffer = quote
            }
            continue
        }

        in-quote -> {

            #{overflow=wrap}
            result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
            quote-buffer = ''
            in-quote = false
        }
        list-kind > 0 -> {
            list-kind == 1 -> result = result - '</ul>\n'

            -> result = result - '</ol>\n'
            list-kind = 0
        }

        ; 对下一行做一次无副作用的 look-ahead，识别 Setext 标题和表格。
        hard-break-v = line.ends-with('  ')
        look-info markdown-line = markdown.read-line(normalized, pos)
        look-line = look-info.text
        look-pos = look-info.next-pos
        look-valid = look-info.valid
        look-valid -> {
            setext = markdown.setext-level(look-line)
            setext > 0 && paragraph.len-bytes() == 0 -> {

                #{overflow=wrap}
                result = result - '<h' - setext.to-str() - '>' - markdown.inline(trimmed) - '</h' - setext.to-str() - '>\n'
                pos = look-pos
                continue
            }

            trimmed.contains('|') && markdown.table-separator(look-line) -> {
                paragraph.len-bytes() > 0 -> {

                    #{overflow=wrap}
                    result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                    paragraph = ''
                }

                #{overflow=wrap}
                result = result - '<table>\n<thead>\n' - markdown.table-row(trimmed, 'th') - '</thead>\n<tbody>\n'
                pos = look-pos
                (pos < n-source && pending == false) {
                    pos >= n-source -> break
                    body-info markdown-line = markdown.read-line(normalized, pos)
                    body-line = body-info.text
                    body-pos = body-info.next-pos
                    body-valid = body-info.valid
                    body-valid == false -> break
                    has-pipe = body-line.contains('|')
                    body-line.trim().len-bytes() == 0 || has-pipe == false -> {
                        pending-line = body-line
                        pending-pos = body-pos
                        pending = true
                        break
                    }
                    result = result - markdown.table-row(body-line, 'td')
                    pos = body-pos
                }
                result = result - '</tbody>\n</table>\n'
                continue
            }

            pending-line = look-line
            pending-pos = look-pos
            pending = true
        }

        ; 缩进四格代码块。
        line.starts-with('    ') -> {
            paragraph.len-bytes() > 0 -> {

                #{overflow=wrap}
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            code-line = line.slice-bytes(4, line.len-bytes())

            #{overflow=wrap}
            result = result - '<pre><code>' - markdown.escape-html(code-line) - '\n</code></pre>\n'
            continue
        }

        hard-break = hard-break-v
        clean-line = trimmed
        hard-break -> clean-line = line.slice-bytes(0, line.len-bytes() - 2).trim()
        paragraph.len-bytes() > 0 -> paragraph = markdown.join-paragraph(paragraph, line, hard-break)

        -> paragraph = clean-line
    }

    in-code -> result = result - markdown.render-code(code-buffer, code-info)

    #{overflow=wrap}
    in-quote -> result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'

    #{overflow=wrap}
    paragraph.len-bytes() > 0 -> result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
    list-kind == 1 -> result = result - '</ul>\n'
    list-kind == 2 -> result = result - '</ol>\n'
    out = result
}

; markdown.render: to-html 的语义别名。
markdown.render = (source str) (out str) {
    out = markdown.to-html(source)
}
