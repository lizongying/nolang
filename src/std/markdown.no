; markdown — Markdown 渲染標準庫
;
; 這是一個無外部依赖的 CommonMark 風格渲染器，面向文檔、日志和消息場景。
; 支持：
;   - ATX / Setext 標题、段落、硬換行、分隔線
;   - 無序/有序列表、任务列表、引用
;   - fenced code block（``` / ~~~，保留語言 class）與縮進代碼塊
;   - 表格、粗體、斜體、刪除線、行內代碼
;   - 鏈接、圖片、自動鏈接、反斜杠轉義
;   - HTML 全量轉義，默認不把输入當成原始 HTML 執行
;
; 用法：
;   html = markdown.to-html(source)
;   html = markdown.render(source)
;   text = markdown.inline('**bold** and `code`')

; 使用小型記錄承載多值解析結果，避免調用方處理可選索引結果。
markdown-line {
    text str
    next-pos i64
    valid bool
}
markdown-heading {
    level i64
    text str
}
markdown-list {
    kind i64
    text str
}
markdown-quote {
    yes bool
    text str
}
markdown-fence {
    yes bool
    marker i64
    width i64
    info str
}

; 轉義 HTML 文字與屬性值（& < > " 四個字元；& 必須先換，否則後續替換會被二次轉義）。
; s str: 原始文字（正文或屬性值）
; out str: 可直接插入 HTML 的轉義結果
; [escape-html](#markdown.escape-html)
markdown.escape-html = (s str) (out str) {
    out = s.replace-str('&', '&amp;')
    out = out.replace-str('<', '&lt;')
    out = out.replace-str('>', '&gt;')
    out = out.replace-str('"', '&quot;')
}

; 判斷一個 ASCII byte 是否屬於單詞。
; c i64: 待判斷的 byte 值（0–255，直接以整數傳入，不是 char）
; yes bool: true 表示 c 是 0-9 / A-Z / a-z；非 ASCII 與標點皆為 false
; [is-word-byte](#markdown.is-word-byte)
markdown.is-word-byte = (c i64) (yes bool) {
    yes = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

; 統計行首連續的指定字符。
; 逐 byte 從 0 開始比較，遇到不同字符、或到達字串結尾即停止。
; s str: 待掃描的行（通常已 trim）
; c i64: 要比對的 byte 值（例如 35 表示 '#'，96 表示 '`'）
; n i64: 前綴長度；沒有任何匹配時為 0
; [prefix-count](#markdown.prefix-count)
markdown.prefix-count = (s str, c i64) (n i64) {
    n = 0
    (n < s.len-bytes()) {
        n >= s.len-bytes() -> break
        s.byte(n) != c -> break

        #{overflow=wrap}
        n = n + 1
    }
}

; 取得 ATX 標題等級與標題文字。
; 只接受「1–6 個 # 加一個空格」的形式，並去掉結尾可選的「空格 + 連續 #」。
; line str: 原始單行文字
; out markdown-heading: level 為 1–6（不是標題時為 0），text 為去除前綴與尾部 # 的標題內容
; [heading](#markdown.heading)
markdown.heading = (line str) (out markdown-heading) {
    level-v = 0
    title-v = ''
    s = line.trim()
    n = markdown.prefix-count(s, 35)
    n > 0 && n <= 6 && n < s.len-bytes() && s.byte(n) == 32 -> {
        level-v = n
        title-v = s.slice-bytes(n + 1, s.len-bytes()).trim()

        ; ATX 標题允許尾部的空格加 #，但不能把正文中的 # 誤刪。
        title-v.ends-with(' #') -> {
            end = title-v.len-bytes()
            (end > 0) {

                #{overflow=wrap}
                end <= 0 || title-v.byte(end - 1) != 35 -> break

                #{overflow=wrap}
                end = end - 1
            }
            title-v = title-v.slice-bytes(0, end).trim()
        }
    }
    out = markdown-heading {
        level: level-v
        text: title-v
    }
}

; 取得 Setext 標題等級（=== 或 ---）。
; 該行 trim 後須長度 ≥ 3，且從頭到尾都是同一個 '=' 或 '-'。
; line str: 原始單行文字
; level i64: 1 = '=' 底線（一級標題），2 = '-' 底線（二級標題），0 = 不是 Setext 標題
; [setext-level](#markdown.setext-level)
markdown.setext-level = (line str) (level i64) {
    level = 0
    s = line.trim()
    n = s.len-bytes()
    n < 3 -> return
    c = s.byte(0)
    c != 61 && c != 45 -> return
    i = 0
    (i < n) {
        i >= n || s.byte(i) != c -> break

        #{overflow=wrap}
        i = i + 1
    }
    i == n -> {
        c == 61 -> level = 1
        c == 45 -> level = 2
    }
}

; 判斷是否為分隔線。
; trim 後由 3 個以上的同一個 - / * / _ 構成，中間允許空格與 tab。
; line str: 原始單行文字
; yes bool: true 表示該行是主題分隔線（<hr>）
; [thematic-break](#markdown.thematic-break)
markdown.thematic-break = (line str) (yes bool) {
    yes = false
    s = line.trim()
    n = s.len-bytes()
    n < 3 -> return
    marker = 0
    count = 0
    i = 0
    (i < n) {
        i >= n -> break
        c-opt = s.byte(i)
        c = c-opt: {
            ok -> it

            -> _
        }
        c == 32 || c == 9 -> {

            #{overflow=wrap}
            i = i + 1
            continue
        }
        marker == 0 -> marker = c
        c != marker -> return
        marker != 45 && marker != 42 && marker != 95 -> return

        #{overflow=wrap}
        count = count + 1

        #{overflow=wrap}
        i = i + 1
    }
    yes = count >= 3
}

; 解析列表項。kind=1 無序，kind=2 有序。
; 無序項需「- / * / + 加一個空格」；有序項需「至少一位數字 + . 加一個空格」。
; line str: 原始單行文字
; out markdown-list: kind 為 0（不是列表項）/ 1（無序）/ 2（有序），text 為標記之後的條目內容
; [list-item](#markdown.list-item)
markdown.list-item = (line str) (out markdown-list) {
    kind-v = 0
    content-v = ''
    index-v = 0
    s = line.trim()
    n = s.len-bytes()
    n >= 2 -> {
        c = s.byte(0)
        (c == 45 || c == 42 || c == 43) && s.byte(1) == 32 -> {
            kind-v = 1
            content-v = s.slice-bytes(2, n)
        }
    }
    kind-v == 0 && n >= 3 -> {
        i = 0
        (i < n) {
            i >= n || s.byte(i) < 48 || s.byte(i) > 57 -> break

            #{overflow=wrap}
            i = i + 1
        }

        #{overflow=wrap}
        i > 0 && i + 1 < n && s.byte(i) == 46 && s.byte(i + 1) == 32 -> {
            kind-v = 2
            digits = s.slice-bytes(0, i)
            index-v = 0
            d = 0
            (d < digits.len-bytes()) {
                d >= digits.len-bytes() -> break

                #{overflow=wrap}
                index-v = index-v * 10 + digits.byte(d) - 48

                #{overflow=wrap}
                d = d + 1
            }

            #{overflow=wrap}
            content-v = s.slice-bytes(i + 2, n)
        }
    }
    out = markdown-list {
        kind: kind-v
        text: content-v
    }
}

; 渲染任務列表內容。
; 識別 GFM 任務標記 '[ ] ' 與 '[x] ' / '[X] '，其餘內容按行內語法渲染。
; content str: 列表項的正文（來自 markdown-list 的 text）
; out str: 帶上 disabled checkbox 的 HTML 片段，或普通行內 HTML
; [list-content](#markdown.list-content)
markdown.list-content = (content str) (out str) {
    s = content.trim()
    s.starts-with('[ ] ') -> {

        out = '<input type="checkbox" disabled> ' - markdown.inline(s.slice-bytes(4, s.len-bytes()))
        return
    }
    s.starts-with('[x] ') || s.starts-with('[X] ') -> {

        out = '<input type="checkbox" checked disabled> ' - markdown.inline(s.slice-bytes(4, s.len-bytes()))
        return
    }
    out = markdown.inline(s)
}

; 移除引用行首的 > 標記。
; '>' 後若只有一個空格則一併去掉；'>>' 之類的嵌套寫法保留剩餘的 '>'。
; line str: 原始單行文字
; out markdown-quote: yes 表示該行是引用行，text 為去掉行首標記後的內容（非引用行時為空串）
; [blockquote](#markdown.blockquote)
markdown.blockquote = (line str) (out markdown-quote) {
    content-v = ''
    found = false
    s = line.trim()
    n = s.len-bytes()
    n >= 1 && s.byte(0) == 62 -> {
        found = true
        n == 1 -> content-v = ''
        n > 1 && s.byte(1) == 32 -> content-v = s.slice-bytes(2, n)
        n > 1 && s.byte(1) != 32 -> content-v = s.slice-bytes(1, n)
    }
    out = markdown-quote {
        yes: found
        text: content-v
    }
}

; 解析 fenced code block 標記。
; 開栅行 trim 後須以 3 個以上的反引號或波浪號開頭，後續文字作為語言標籤。
; line str: 原始單行文字
; out markdown-fence: yes 表示是栅欄行；marker 為 96（`）或 126（~）；width 為栅欄長度；info 為語言標籤，沒有時為空串
; [fence](#markdown.fence)
markdown.fence = (line str) (out markdown-fence) {
    yes-v = false
    marker-v = 0
    width-v = 0
    info-v = ''
    s = line.trim()
    n = s.len-bytes()
    n >= 3 -> {
        c-opt = s.byte(0)
        c = c-opt: {
            ok -> it

            -> _
        }
        (c == 96 || c == 126) -> {
            count = markdown.prefix-count(s, c)
            count >= 3 -> {
                yes-v = true
                marker-v = c
                width-v = count
                count < n -> info-v = s.slice-bytes(count, n).trim()
            }
        }
    }
    out = markdown-fence {
        yes: yes-v
        marker: marker-v
        width: width-v
        info: info-v
    }
}

; 判斷當前行是否關閉指定 fence。
; 與 CommonMark 一致：用同種 marker 且長度不小於開栅寬度（至少 3）才能關閉。
; line str: 待判斷的單行文字
; marker i64: 開栅的 marker byte（96 或 126）
; width i64: 開栅的長度
; yes bool: true 表示該行關閉目前的代碼塊
; [code-close](#markdown.code-close)
markdown.code-close = (line str, marker i64, width i64) (yes bool) {
    yes = false
    s = line.trim()
    n = markdown.prefix-count(s, marker)
    n >= width && n >= 3 -> yes = true
}

; 判斷表格分隔行。
; 以 '|' 切分後，每個單元格去掉 ':' 與 '-' 後必須為空，且至少要有一個單元格。
; line str: 待判斷的單行文字（通常是表頭下一行）
; yes bool: true 表示是 |---|:--:| 這類表格分隔行
; [table-separator](#markdown.table-separator)
markdown.table-separator = (line str) (yes bool) {
    yes = true
    cells = line.trim().split('|')
    cells.len() == 0 -> {
        yes = false
        return
    }
    i <- [0..cells.len()): {

        cell = cells[i].trim()
        cell = cell.replace-str(':', '')
        cell = cell.replace-str('-', '')
        cell.len-bytes() > 0 -> {
            yes = false
            return
        }
    }
}

; 將 | 分隔的行渲染為 tr。
; 自動去掉首尾的 '|'，每個單元格按行內語法渲染後包成 <tag>。
; line str: 表格的單行文字
; tag str: 單元格標籤名，表頭為 'th'、資料行為 'td'
; out str: 完整的 <tr>…</tr>\n 片段
; [table-row](#markdown.table-row)
markdown.table-row = (line str, tag str) (out str) {
    s = line.trim()
    s.starts-with('|') -> s = s.slice-bytes(1, s.len-bytes())

    #{overflow=wrap}
    s.ends-with('|') -> s = s.slice-bytes(0, s.len-bytes() - 1)
    cells = s.split('|')
    out = '<tr>\n'
    i <- [0..cells.len()): {

        cell = cells[i].trim()

        out = out - '<' - tag - '>' - markdown.inline(cell) - '</' - tag - '>\n'
    }
    out = out - '</tr>\n'
}

; 渲染 Markdown 行內語法。
; 支援粗體、斜體、刪除線、行內代碼、鏈接、圖片、自動鏈接與反斜杠轉義；所有文字都經 HTML 轉義，未閉合的標記在結尾自動補齊關閉標籤。
; s str: 單行內的 Markdown 文字（不要傳入塊級語法）
; out str: 行內 HTML 片段（不含外層 <p>）
; [inline](#markdown.inline)
markdown.inline = (s str) (out str) {
    result = ''
    strong = false
    emphasis = false
    strike = false
    code = false
    i = 0
    n = s.len-bytes()
    (i < n) {
        i >= n -> break
        c-opt = s.byte(i)
        c char = c-opt: {
            ok -> it

            -> _
        }

        ; 反斜杠轉義 ASCII 標記。
        #{overflow=wrap}
        c == 92 && i + 1 < n -> {

            #{overflow=wrap}
            result = result - markdown.escape-html(s.slice-bytes(i + 1, i + 2))

            #{overflow=wrap}
            i = i + 2
            continue
        }

        ; code span：取下一個反引號，不解析其中的 Markdown。
        c == 96 -> {

            #{overflow=wrap}
            close = s.find-byte-from('`', i + 1)
            close > i -> {
                code-text = s.slice-bytes(i + 1, close).trim()

                result = result - '<code>' - markdown.escape-html(code-text) - '</code>'

                #{overflow=wrap}
                i-opt = close + 1
                i = 0
                i-opt: {
                    ok -> i = it

                    -> i = 0
                }
                continue
            }
        }

        ; 圖片與鏈接，目標只允許普通 URL，屬性始終轉義。
        #{overflow=wrap}
        c == 33 && i + 1 < n && s.byte(i + 1) == 91 -> {

            #{overflow=wrap}
            close = s.find-byte-from(']', i + 2)

            #{overflow=wrap}
            close >= 0 && close + 1 < n && s.byte(close + 1) == 40 -> {

                #{overflow=wrap}
                end = s.find-byte-from(')', close + 2)

                #{overflow=wrap}
                end > close + 2 -> {

                    #{overflow=wrap}
                    alt-start-opt = i + 2
                    alt-start = 0
                    alt-start-opt: {
                        ok -> alt-start = it

                        -> alt-start = 0
                    }
                    alt = s.slice-bytes(alt-start, close)

                    #{overflow=wrap}
                    img-url-start-opt = close + 2
                    img-url-start = 0
                    img-url-start-opt: {
                        ok -> img-url-start = it

                        -> img-url-start = 0
                    }
                    url = s.slice-bytes(img-url-start, end)
                    result = result - '<img src="' - markdown.escape-html(url) - '" alt="' - markdown.escape-html(alt) - '">'

                    #{overflow=wrap}
                    i-opt = end + 1
                    i = 0
                    i-opt: {
                        ok -> i = it

                        -> i = 0
                    }
                    continue
                }
            }
        }
        c == 91 -> {

            #{overflow=wrap}
            close = s.find-byte-from(']', i + 1)

            #{overflow=wrap}
            close >= 0 && close + 1 < n && s.byte(close + 1) == 40 -> {

                #{overflow=wrap}
                end = s.find-byte-from(')', close + 2)

                #{overflow=wrap}
                end > close + 2 -> {

                    #{overflow=wrap}
                    label-start-opt = i + 1
                    label-start = 0
                    label-start-opt: {
                        ok -> label-start = it

                        -> label-start = 0
                    }
                    label = s.slice-bytes(label-start, close)

                    #{overflow=wrap}
                    url-start-opt = close + 2
                    url-start = 0
                    url-start-opt: {
                        ok -> url-start = it

                        -> url-start = 0
                    }
                    url = s.slice-bytes(url-start, end)
                    result = result - '<a href="' - markdown.escape-html(url) - '">' - markdown.inline(label) - '</a>'

                    #{overflow=wrap}
                    i-opt = end + 1
                    i = 0
                    i-opt: {
                        ok -> i = it

                        -> i = 0
                    }
                    continue
                }
            }
        }

        ; 自動鏈接 <http://...> / <https://...> / <mailto:...>。
        c == 60 -> {

            #{overflow=wrap}
            close = s.find-byte-from('>', i + 1)
            close > i -> {

                #{overflow=wrap}
                target-start-opt = i + 1
                target-start = 0
                target-start-opt: {
                    ok -> target-start = it

                    -> target-start = 0
                }
                target = s.slice-bytes(target-start, close)
                target.starts-with('http://') || target.starts-with('https://') || target.starts-with('mailto:') -> {
                    result = result - '<a href="' - markdown.escape-html(target) - '">' - markdown.escape-html(target) - '</a>'

                    #{overflow=wrap}
                    i-opt = close + 1
                    i = 0
                    i-opt: {
                        ok -> i = it

                        -> i = 0
                    }
                    continue
                }
            }
        }

        ; 刪除線、粗體、斜體。

        #{overflow=wrap}
        c == 126 && i + 1 < n && s.byte(i + 1) == 126 -> {
            strike -> result = result - '</del>'

            -> result = result - '<del>'
            strike = strike == false

            #{overflow=wrap}
            i = i + 2
            continue
        }

        #{overflow=wrap}
        c == 42 && i + 1 < n && s.byte(i + 1) == 42 -> {
            strong -> result = result - '</strong>'

            -> result = result - '<strong>'
            strong = strong == false

            #{overflow=wrap}
            i = i + 2
            continue
        }

        #{overflow=wrap}
        c == 95 && i + 1 < n && s.byte(i + 1) == 95 -> {
            strong -> result = result - '</strong>'

            -> result = result - '<strong>'
            strong = strong == false

            #{overflow=wrap}
            i = i + 2
            continue
        }
        c == 42 || c == 95 -> {
            prev-word = false
            next-word = false

            #{overflow=wrap}
            i > 0 -> prev-word = markdown.is-word-byte(s.byte(i - 1))

            #{overflow=wrap}
            i + 1 < n -> next-word = markdown.is-word-byte(s.byte(i + 1))
            c == 95 && prev-word && next-word -> {
                result = result - '_'

                #{overflow=wrap}
                i = i + 1
                continue
            }
            emphasis -> result = result - '</em>'

            -> result = result - '<em>'
            emphasis = emphasis == false

            #{overflow=wrap}
            i = i + 1
            continue
        }
        result = result - markdown.escape-html(c.to-str())

        #{overflow=wrap}
        i = i + 1
    }
    code -> result = result - '</code>'
    emphasis -> result = result - '</em>'
    strong -> result = result - '</strong>'
    strike -> result = result - '</del>'
    out = result
}

; 追加一行到段落，專門處理硬換行。
; hard-break 為 true 時，行尾兩個空格視為 <br>，從內容中去除後以 '<br>\n' 連接。
; paragraph str: 目前累積的段落文字（空串表示新段落）
; line str: 追加的原始行；hard-break 時結尾必須有兩個空格
; hard-break bool: true 表示該行末有兩個空格，需要插入硬換行
; out str: 追加後的段落文字
; [join-paragraph](#markdown.join-paragraph)
markdown.join-paragraph = (paragraph str, line str, hard-break bool) (out str) {
    clean = line.trim()
    separator = '\n'
    hard-break -> {
        clean = line.slice-bytes(0, line.len-bytes() - 2).trim()
        separator = '<br>\n'
    }

    out = paragraph - separator - clean
}

; 輸出代碼塊。
; info 非空時作為 class="language-<info>" 掛在 <code> 上，代碼內容全量 HTML 轉義。
; code str: 栅欄內纍積的代碼正文（不含栅欄行）
; info str: 栅欄行尾的語言標籤，空串表示無語言
; out str: <pre><code…></code></pre>\n 片段
; [render-code](#markdown.render-code)
markdown.render-code = (code str, info str) (out str) {
    class = ''
    info.len-bytes() > 0 -> class = ' class="language-' - markdown.escape-html(info) - '"'

    out = '<pre><code' - class - '>' - markdown.escape-html(code) - '</code></pre>\n'
}

; 從 byte 游標讀取一行，避免對 []str 做不安全的動態索引。
; 讀到 '\n' 或字串結尾為止，不包含換行符。
; source str: 整份 Markdown 源文字
; pos i64: 目前讀取位置（位元組偏移，從 0 開始）
; out markdown-line: text=該行內容；next-pos=下一行起始偏移；valid=pos 是否落在 [0, len) 內
; [read-line](#markdown.read-line)
markdown.read-line = (source str, pos i64) (out markdown-line) {
    line-v = ''
    next-v = pos
    valid-v = false
    n = source.len-bytes()
    pos >= 0 && pos < n -> {
        end-v = n
        j = pos
        (j < n) {
            j >= n -> break
            source.byte(j) == 10 -> {
                end-v = j
                break
            }

            #{overflow=wrap}
            j = j + 1
        }
        line-v = source.slice-bytes(pos, end-v)
        end-v < n -> {

            #{overflow=wrap}
            next-v = end-v + 1
        }

        -> next-v = end-v
        valid-v = true
    }
    out = markdown-line {
        text: line-v
        next-pos: next-v
        valid: valid-v
    }
}

; 將 Markdown 文檔渲染為 HTML。
; 先將 CRLF / CR 規範化為 LF，再逐行解析塊級語法（標題、列表、引用、代碼塊、表格、分隔線、段落）。
; source str: 完整的 Markdown 源文字
; out str: 完整的 HTML 文檔片段
; [to-html](#markdown.to-html)
markdown.to-html = (source str) (out str) {
    result = ''
    normalized = source.replace-str('\r\n', '\n').replace-str('\r', '\n')
    paragraph = ''
    code-buffer = ''
    quote-buffer = ''
    pending-line = ''
    in-code = false
    code-marker = 0
    code-width = 0
    code-info = ''
    list-kind = 0
    in-quote = false
    pending = false
    pending-pos = 0
    pos = 0
    n-source = normalized.len-bytes()
    (pos < n-source || pending) {
        pending -> {
            line = pending-line
            pos = pending-pos
            pending = false
        }

        -> {
            line-info markdown-line = markdown.read-line(normalized, pos)
            line = line-info.text
            pos = line-info.next-pos
            line-info.valid == false -> break
        }
        trimmed = line.trim()
        in-code -> {
            markdown.code-close(trimmed, code-marker, code-width) -> {
                result = result - markdown.render-code(code-buffer, code-info)
                code-buffer = ''
                code-info = ''
                in-code = false
            }

            -> code-buffer = code-buffer - line - '\n'
            continue
        }
        fence-info markdown-fence = markdown.fence(trimmed)
        fence = fence-info.yes
        marker = fence-info.marker
        width = fence-info.width
        info = fence-info.info
        fence -> {
            paragraph.len-bytes() > 0 -> {
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            in-quote -> {
                result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
                quote-buffer = ''
                in-quote = false
            }
            in-code = true
            code-marker = marker
            code-width = width
            code-info = info
            continue
        }
        trimmed.len-bytes() == 0 -> {
            paragraph.len-bytes() > 0 -> {
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            in-quote -> {
                result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
                quote-buffer = ''
                in-quote = false
            }
            continue
        }
        heading-info markdown-heading = markdown.heading(trimmed)
        level = heading-info.level
        heading = heading-info.text
        level > 0 -> {
            paragraph.len-bytes() > 0 -> {
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            in-quote -> {
                result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
                quote-buffer = ''
                in-quote = false
            }
            result = result - '<h' - level.to-str() - '>' - markdown.inline(heading) - '</h' - level.to-str() - '>\n'
            continue
        }

        markdown.thematic-break(trimmed) -> {
            paragraph.len-bytes() > 0 -> {
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            result = result - '<hr>\n'
            continue
        }
        item-info markdown-list = markdown.list-item(trimmed)
        item-kind = item-info.kind
        item = item-info.text
        item-kind > 0 -> {
            paragraph.len-bytes() > 0 -> {
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind != item-kind -> {
                list-kind == 1 -> result = result - '</ul>\n'
                list-kind == 2 -> result = result - '</ol>\n'
                item-kind == 1 -> result = result - '<ul>\n'

                -> result = result - '<ol>\n'
                list-kind = item-kind
            }
            result = result - '<li>' - markdown.list-content(item) - '</li>\n'
            continue
        }
        quote-info markdown-quote = markdown.blockquote(trimmed)
        quote = quote-info.text
        is-quote = quote-info.yes
        is-quote -> {
            paragraph.len-bytes() > 0 -> {
                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            list-kind > 0 -> {
                list-kind == 1 -> result = result - '</ul>\n'

                -> result = result - '</ol>\n'
                list-kind = 0
            }
            in-quote -> quote-buffer = quote-buffer - '\n' - quote

            -> {
                in-quote = true
                quote-buffer = quote
            }
            continue
        }

        in-quote -> {

            result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
            quote-buffer = ''
            in-quote = false
        }
        list-kind > 0 -> {
            list-kind == 1 -> result = result - '</ul>\n'

            -> result = result - '</ol>\n'
            list-kind = 0
        }

        ; 對下一行做一次無副作用的 look-ahead，識别 Setext 標题和表格。
        hard-break-v = line.ends-with('  ')
        look-info markdown-line = markdown.read-line(normalized, pos)
        look-line = look-info.text
        look-pos = look-info.next-pos
        look-valid = look-info.valid
        look-valid -> {
            setext = markdown.setext-level(look-line)
            setext > 0 && paragraph.len-bytes() == 0 -> {
                result = result - '<h' - setext.to-str() - '>' - markdown.inline(trimmed) - '</h' - setext.to-str() - '>\n'
                pos = look-pos
                continue
            }
            trimmed.contains('|') && markdown.table-separator(look-line) -> {
                paragraph.len-bytes() > 0 -> {
                    result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                    paragraph = ''
                }
                result = result - '<table>\n<thead>\n' - markdown.table-row(trimmed, 'th') - '</thead>\n<tbody>\n'
                pos = look-pos
                (pos < n-source && pending == false) {
                    pos >= n-source -> break
                    body-info markdown-line = markdown.read-line(normalized, pos)
                    body-line = body-info.text
                    body-pos = body-info.next-pos
                    body-valid = body-info.valid
                    body-valid == false -> break
                    has-pipe = body-line.contains('|')
                    body-line.trim().len-bytes() == 0 || has-pipe == false -> {
                        pending-line = body-line
                        pending-pos = body-pos
                        pending = true
                        break
                    }
                    result = result - markdown.table-row(body-line, 'td')
                    pos = body-pos
                }
                result = result - '</tbody>\n</table>\n'
                continue
            }
            pending-line = look-line
            pending-pos = look-pos
            pending = true
        }

        ; 縮進四格代碼塊。
        line.starts-with('    ') -> {
            paragraph.len-bytes() > 0 -> {

                result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
                paragraph = ''
            }
            code-line = line.slice-bytes(4, line.len-bytes())

            result = result - '<pre><code>' - markdown.escape-html(code-line) - '\n</code></pre>\n'
            continue
        }

        hard-break = hard-break-v
        clean-line = trimmed
        hard-break -> clean-line = line.slice-bytes(0, line.len-bytes() - 2).trim()
        paragraph.len-bytes() > 0 -> paragraph = markdown.join-paragraph(paragraph, line, hard-break)

        -> paragraph = clean-line
    }
    in-code -> result = result - markdown.render-code(code-buffer, code-info)
    in-quote -> result = result - '<blockquote>\n' - markdown.inline(quote-buffer) - '\n</blockquote>\n'
    paragraph.len-bytes() > 0 -> result = result - '<p>' - markdown.inline(paragraph) - '</p>\n'
    list-kind == 1 -> result = result - '</ul>\n'
    list-kind == 2 -> result = result - '</ol>\n'
    out = result
}

; to-html 的語義別名，輸出完全一致。
; source str: 完整的 Markdown 源文字
; out str: 完整的 HTML 文檔片段
; [render](#markdown.render)
markdown.render = (source str) (out str) {
    out = markdown.to-html(source)
}
