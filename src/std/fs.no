; fs — 檔案系統工具
;
; 以 file 結構體封裝開啟中的檔案，以 path 結構體封裝路徑。
; 包含檔案操作、讀寫、資訊查詢等底層系統調用。
;
; 用法：
;   f = open(FILE-PATH, {
;       mode: write
;       perm: perm-644
;       excl: false
;       truncate: false
;       append: false
;   })
;   f.write('hello'.to-bytes(), 5)         // 方法呼叫
;   f.close()
;
;   line = STDIN.read-line()              // 從標準輸入讀取一行，返回 ?str
;   n = STDOUT.write('hello'.to-bytes(), 5)  // 寫入標準輸出
;   n = STDERR.write('error'.to-bytes(), 5)  // 寫入標準錯誤
;
;   p = path{
;       p: '/tmp'
;   }
;   yes = p.exists()

; ═══════════════════════════════════════════════
; 檔案操作（內建函數）
; ═══════════════════════════════════════════════

; 刪除檔案
; p: 要刪除的路徑（符號連結只刪連結本身，不動其目標）
; ok: true=刪除成功（路徑不存在或權限不足為 false）
; [remove](#fs.remove)
#{buildin}
remove = (p str) (ok bool) {
}

; 重新命名檔案
; o: 原路徑
; n: 新路徑（同目錄改名或跨目錄搬移）
; ok: true=更名成功
; [rename](#fs.rename)
#{buildin}
rename = (o str, n str) (ok bool) {
}

; 建立符號連結
; target: 連結指向的目標路徑
; linkpath: 符號連結本身的路徑
; 成功返回 true，失敗返回 false
; ok: true=連結已建立（同名路徑已存在時為 false）
; [symlink](#fs.symlink)
#{buildin}
symlink = (target str, linkpath str) (ok bool) {
}

; 建立硬連結
; oldpath: 既有檔案路徑
; newpath: 新硬連結路徑
; 成功返回 true，失敗返回 false
; ok: true=連結已建立（跨檔案系統等情況會失敗）
; [link](#fs.link)
#{buildin}
link = (oldpath str, newpath str) (ok bool) {
}

; 解析絕對路徑
; p: 輸入路徑（可能是相對路徑或含 . / .. 的路徑）
; 成功返回規範化的絕對路徑字串，失敗返回空串
; abs: 規範化後的絕對路徑（路徑無法解析時為空串）
; [realpath](#fs.realpath)
#{buildin}
realpath = (p str) (abs str) {
}

; 讀取符號連結的目標路徑
; p: 符號連結路徑
; 成功返回目標路徑（some），失敗返回 nil
; target: ok=連結指向的路徑原文, nil=該路徑不是符號連結或讀取失敗
; [readlink](#fs.readlink)
#{buildin}
readlink = (p str) (target ?str) {
}

; 建立並開啟唯一臨時檔案
; tmpl: 模板字串，末尾必須為 'XXXXXX'（六個 X）
; 成功返回實際檔名與檔案描述符，失敗返回空串與 fd=-1
; 注意：返回順序為 (name, fd) 而非 (fd, name)，因為 lastBuiltinExtra 機制要求
;       第二返回值必須是 i64/bool 型別，str 必須為主返回值
; name: 實際建立的檔名（模板末六位 X 被隨機字元替換；失敗為空串）
; fd: 已以寫入模式開啟的檔案描述符（失敗為 -1）
; [mkstemp](#fs.mkstemp)
#{buildin}
mkstemp = (tmpl str) (name str, fd fd) {
}

; 建立唯一臨時目錄
; tmpl: 模板字串，末尾必須為 'XXXXXX'
; 成功返回實際目錄名（some），失敗返回 nil
; name: ok=實際建立的目錄名, nil=建立失敗
; [mkdtemp](#fs.mkdtemp)
#{buildin}
mkdtemp = (tmpl str) (name ?str) {
}

; 建立命名管道（FIFO）
; p: 管道路徑
; mode: 權限模式（如 0o644 = 420）
; 成功返回 true，失敗返回 false
; ok: true=FIFO 已建立
; [mkfifo](#fs.mkfifo)
#{buildin}
mkfifo = (p str, mode i64) (ok bool) {
}

; 設定檔案的存取與修改時間
; p: 檔案路徑
; atime: 存取時間（Unix 秒）
; mtime: 修改時間（Unix 秒）
; 成功返回 true，失敗返回 false
; ok: true=時間已設定
; [utime](#fs.utime)
#{buildin}
utime = (p str, atime i64, mtime i64) (ok bool) {
}

; 刪除空目錄
; p: 目錄路徑（必須為空目錄）
; 成功返回 true，失敗返回 false
; ok: true=目錄已刪除（目錄非空或不存在為 false）
; [rmdir](#fs.rmdir)
#{buildin}
rmdir = (p str) (ok bool) {
}

; 建立特殊檔案（管道、裝置節點等）
; p: 檔案路徑
; mode: 檔案類型與權限（如 0o644=420 普通檔案，0o666=438 FIFO）
; dev: 裝置號（對普通檔案/FIFO 傳 0）
; 成功返回 true，失敗返回 false（macOS/Windows 上可能不支援）
; ok: true=已建立（部分平台無權限或不支援時為 false）
; [mknod](#fs.mknod)
#{buildin}
mknod = (p str, mode i64, dev i64) (ok bool) {
}

; 截斷或擴展檔案到指定大小
; p: 檔案路徑
; length: 目標長度（位元組）
; 成功返回 true，失敗返回 false
; ok: true=長度已調整（縮短會丟棄尾端資料，擴展部分補零）
; [truncate](#fs.truncate)
#{buildin}
truncate = (p str, length i64) (ok bool) {
}

; 將檔案系統緩衝區排清到磁碟（無返回值）
; [sync](#fs.sync)
#{buildin}
sync = () {
}

; 取得符號連結本身的資訊（不跟隨連結）
; 與 stat 不同：對符號連結呼叫時返回連結本身的資訊，而非目標
; p: 檔案路徑
; 成功返回 true，失敗返回 false
; ok: true=取得到連結本身的資訊（符號連結存在即為 true，不論其目標是否有效）
; [lstat](#fs.lstat)
#{buildin}
lstat = (p str) (ok bool) {
}

; 判斷路徑是否存在（跟隨符號連結）
; 成功返回 true，失敗返回 false
; p: 待檢查的路徑
; yes: true=路徑存在（符號連結會追隨其目標）
; [exists](#fs.exists)
#{buildin}
exists = (p str) (yes bool) {
}

; 判斷路徑是否為普通檔案
; p: 待檢查的路徑
; exists: true=是普通檔案（目錄、符號連結、裝置節點均為 false）
; [is-file](#fs.is-file)
#{buildin}
is-file = (p str) (exists bool) {
}

; 判斷路徑是否為目錄
; p: 待檢查的路徑
; yes: true=是目錄
; [is-dir](#fs.is-dir)
#{buildin}
is-dir = (p str) (yes bool) {
}

; 取得檔案大小
; p: 檔案路徑
; size: ok=位元組大小, nil=檔案不存在或無權限
; [stat-size](#fs.stat-size)
#{buildin}
stat-size = (p str) (size ?i64) {
}

; 取得已開啟檔案的大小（用 fstat(fd)，消除 TOCTOU）
; fd: 已開啟的檔案描述符
; size: ok=檔案當下大小, nil=fd 無效或 fstat 失敗
; [fstat-size](#fs.fstat-size)
#{buildin}
fstat-size = (fd fd) (size ?i64) {
}

; [deprecated] read-file: 改用 read-bytes（支援錯誤處理、TOCTOU 安全、循環 read）
; 讀取整個檔案內容為 []byte（空 slice 表示失敗，無法區分空檔案與錯誤）
; p: 檔案路徑
; content: 檔案內容（空 slice 無法區分「空檔案」與「讀取失敗」，故標記為已棄用）
; [read-file](#fs.read-file)
#{buildin}
read-file = (p str) (content []byte) {
}

; [deprecated] write-file: 改用 write-bytes（支援錯誤處理、循環 write）
; 將 []byte 寫入檔案（覆寫，無法區分部分寫入與完全失敗）
; p: 目標路徑（不存在則建立，存在則覆寫）
; data: 要寫入的位元組
; ok: 是否寫入成功（不回報部分寫入，故標記為已棄用）
; [write-file](#fs.write-file)
#{buildin}
write-file = (p str, data []byte) (ok bool) {
}

; 取得檔案大小（同 stat-size）
; p: 檔案路徑
; size: ok=位元組大小, nil=取得失敗
; [file-size](#fs.file-size)
#{buildin}
file-size = (p str) (size ?i64) {
}

; ═══════════════════════════════════════════════
; 檔案讀寫（內建函數）
; ═══════════════════════════════════════════════

; 以唯讀模式開啟檔案
; path: 檔案路徑（不存在時不會建立）
; fd: 唯讀檔案描述符（-1=開啟失敗）
; [open-read](#fs.open-read)
#{buildin}
open-read = (path str) (fd fd) {
}

; 以寫入模式開啟檔案（O-WRONLY|O-CREAT|O-TRUNC, 0644）
; path: 檔案路徑（不存在則以 0644 建立）
; fd: 寫入用檔案描述符（-1=失敗；已存在的內容會被截斷為空）
; [open-write](#fs.open-write)
#{buildin}
open-write = (path str) (fd fd) {
}

; 以自訂旗標和權限開啟檔案
; path: 檔案路徑
; flags: open 旗標數值（如 0=O_RDONLY、1537=O_WRONLY|O_CREAT|O_TRUNC）
; mode: 新建檔案時的權限位（如 420=0o644；檔案已存在時忽略）
; fd: 檔案描述符（-1=失敗）
; [open-file](#fs.open-file)
#{buildin}
open-file = (path str, flags i64, mode i64) (fd fd) {
}

; 從檔案描述符讀取最多 n 位元組到 buf
; fd: 已開啟的檔案描述符
; buf: 讀入緩衝區（須預留至少 n 位元組）
; n: 本輪最多讀取的位元組數
; got: 實際讀取位元組數（0=已達 EOF, -1=錯誤）
; [read](#fs.read)
#{buildin}
read = (fd fd, buf []byte, n i64) (got i64) {
}

; 將 data 的前 n 位元組寫入檔案描述符
; fd: 已開啟的檔案描述符
; data: 待寫入資料（僅取其前 n 個位元組）
; n: 要寫入的位元組數
; written: 實際寫入位元組數（-1=錯誤；小於 n 表示部分寫入）
; [write](#fs.write)
#{buildin}
write = (fd fd, data []byte, n i64) (written i64) {
}

; 關閉檔案描述符
; fd: 要關閉的檔案描述符
; ok: 0=成功, -1=失敗（重複關閉同樣失敗）
; [close](#fs.close)
#{buildin}
close = (fd fd) (ok i64) {
}

; ═══════════════════════════════════════════════
; 標準輸入（內建函數）
; ═══════════════════════════════════════════════

; 從標準輸入讀取一行
; line: ok=讀到的一行（不含換行符）, nil=EOF 或讀取失敗
; [get-line](#fs.get-line)
#{buildin}
get-line = () (line ?str) {
}

; 循環讀取 stdin 全部內容為 []byte（不依賴 stat/fstat，對管道安全）
; 返回 content ?[]byte:
;   ok([]byte) — 成功，含 stdin 內容
;   nil        — stdin 為空
;   err        — 讀取失敗
; content: ok=stdin 的全部內容, nil=輸入為空, err=讀取失敗
; [read-stdin](#fs.read-stdin)
read-stdin = () (content ?[]byte) {
    buf []byte
    tmp []byte = with-len(4096)
    !! {
        n = read(STDIN-FD, tmp, 4096)
        n <= 0 -> break
        i <- [0..n): {

            #{index-out=zero}
            buf.push(tmp[i])
        }
    }
    buf.len() == 0 -> {
        content = nil
        return
    }
    content = buf
}

; 循環讀取 stdin 全部內容為 str（不依賴 stat/fstat，對管道安全）
; 返回 content ?str:
;   ok(str) — 成功，含 stdin 內容
;   nil     — stdin 為空
;   err     — 讀取失敗
; content: ok=stdin 全部內容轉成的字串, nil=輸入為空, err=讀取失敗
; [read-stdin-str](#fs.read-stdin-str)
read-stdin-str = () (content ?str) {
    b = read-stdin()
    b: {
        err -> content = err(it)

        nil -> return

        -> {
            s = it.to-bytes-str()
            content = s
        }
    }
}

; ═══════════════════════════════════════════════
; 目錄操作（內建函數）
; ═══════════════════════════════════════════════

; open-dir: 開啟目錄以讀取條目
; 配對 read-dir 逐條讀取；結束須 close-dir。
; ⚠ read-dir 逐條返回的 POSIX 目錄條目【包含】 '.' 和 '..'：
;   遞迴遍歷/刪除若不慎進入 '..' 會向上逃逸、誤刪父樹。
;   需安全地取「子項列表」請改用 fs.dir-entries（已自動過濾 '.'/'..'）。
; p: 目錄路徑（不存在或無讀取權限時開不了）
; dirp: 目錄控制代碼，供 read-dir/close-dir 使用（0=開啟失敗）
; [open-dir](#fs.open-dir)

#{buildin}
open-dir = (p str) (dirp i64) {
}

; read-dir: 讀取下一個目錄條目名稱
; ⚠ 遵循 POSIX readdir：逐條迭代會吐出 '.' 和 '..'（當前目錄/父目錄）。
;   任何遞迴遍歷/刪除都必須顯式跳過這兩個條目，否則會經 '..' 向上逃逸。
;   需子項列表時優先使用 fs.dir-entries，而非裸 open-dir+read-dir。
; dirp: open-dir 返回的目錄控制代碼
; name: ok=下一個條目名稱（可為 '.'/'..'）, nil=已讀完或控制代碼無效
; [read-dir](#fs.read-dir)

#{buildin}
read-dir = (dirp i64) (name ?str) {
}

; close-dir: 關閉目錄控制代碼
; dirp: open-dir 返回的目錄控制代碼（關閉後不可再讀）
; ok: true=已釋放目錄串流緩衝區
; [close-dir](#fs.close-dir)

#{buildin}
close-dir = (dirp i64) (ok bool) {
}

; touch-file: 更新檔案時間戳為當前時間
; p: 檔案路徑
; ok: true=存取/修改時間已刷新為當下（路徑不可達時為 false）
; [touch-file](#fs.touch-file)

#{buildin}
touch-file = (p str) (ok bool) {
}

; open() 旗標常數（平台特定）
; O_RDONLY/O_WRONLY/O_RDWR 跨平台通用（0/1/2）
O-RDONLY = 0
O-WRONLY = 1
O-RDWR = 2

; O_CREAT: macOS=512, Linux=64, Windows=256, WASI=512 (wasi-libc POSIX 相容值)

#{mac-amd64}
O-CREAT = 512

#{mac-arm64}
O-CREAT = 512

#{linux-amd64}
O-CREAT = 64

#{linux-arm64}
O-CREAT = 64

#{win-amd64}
O-CREAT = 256

#{win-arm64}
O-CREAT = 256

#{wasi-wasm32}
O-CREAT = 512

; O_TRUNC: macOS=1024, Linux=512, Windows=512, WASI=1024

#{mac-amd64}
O-TRUNC = 1024

#{mac-arm64}
O-TRUNC = 1024

#{linux-amd64}
O-TRUNC = 512

#{linux-arm64}
O-TRUNC = 512

#{win-amd64}
O-TRUNC = 512

#{win-arm64}
O-TRUNC = 512

#{wasi-wasm32}
O-TRUNC = 1024

; O_APPEND: macOS=8, Linux=1024, Windows=8, WASI=8

#{mac-amd64}
O-APPEND = 8

#{mac-arm64}
O-APPEND = 8

#{linux-amd64}
O-APPEND = 1024

#{linux-arm64}
O-APPEND = 1024

#{win-amd64}
O-APPEND = 8

#{win-arm64}
O-APPEND = 8

#{wasi-wasm32}
O-APPEND = 8

; O_EXCL: macOS=2048, Linux=128, Windows=1024, WASI=2048

#{mac-amd64}
O-EXCL = 2048

#{mac-arm64}
O-EXCL = 2048

#{linux-amd64}
O-EXCL = 128

#{linux-arm64}
O-EXCL = 128

#{win-amd64}
O-EXCL = 1024

#{win-arm64}
O-EXCL = 1024

#{wasi-wasm32}
O-EXCL = 2048

; 標準檔案描述符
; fd 是檔案描述符的 newtype 別名（底層 i64），與 i64 在型別系統中互斥，
; 防止 fd 被亂用為任意整數（端口号、PID 等）。
; 整數字面量可賦值給 fd（如 STDIN-FD fd = 0），fd 可與整數字面量比較。
fd = i64
STDIN-FD fd = 0
STDOUT-FD fd = 1
STDERR-FD fd = 2

; ═══════════════════════════════════════════════
; file 結構體：封裝開啟中的檔案
; ═══════════════════════════════════════════════

; file: 開啟的檔案
; fd=-1 表示未開啟；path 為來源路徑
file {
    fd fd
    path str
}

; ═══════════════════════════════════════════════
; 特殊檔案：標準輸入/輸出/錯誤
; ═══════════════════════════════════════════════

; 標準輸入（fd=0）
STDIN = file {
    fd: 0
    path: '<stdin>'
}

; 標準輸出（fd=1）
STDOUT = file {
    fd: 1
    path: '<stdout>'
}

; 標準錯誤（fd=2）
STDERR = file {
    fd: 2
    path: '<stderr>'
}

; file-mode: 檔案開啟模式（預組合）
file-mode {
    read,
    write,
    append,
    read-write,
}

; file-perm: 檔案權限（預組合）
file-perm {
    perm-600,
    perm-644,
    perm-664,
    perm-666,
    perm-755,
    perm-777,
}

; file-opts: open() 選項
; mode: 檔案模式（file-mode 枚舉）
; perm: 權限（file-perm 枚舉）
; excl: 獨佔建立（同 O_EXCL）
; truncate: 截斷至 0 長度（同 O_TRUNC）
; append: 附加寫入（同 O_APPEND）
file-opts {
    mode file-mode
    perm file-perm
    excl bool
    truncate bool
    append bool
}

; 開啟檔案（建構函式）
; opts: file-opts 結構體
; 成功：f = file{ fd, path }（自動轉為 ?file）
; 失敗：f = err('錯誤訊息')
; p: 檔案路徑
; f: ok=已依 opts 開啟的檔案, err=開啟失敗（附錯誤訊息）
; [open](#fs.open)
open = (p str, opts file-opts) (f ?file) {
    flags = 0

    ; 從 opts.mode 取得基礎旗標
    m = opts.mode
    m: {
        read -> flags = O-RDONLY

        write -> flags = O-WRONLY | O-CREAT | O-TRUNC

        append -> flags = O-WRONLY | O-CREAT | O-APPEND

        read-write -> flags = O-RDWR | O-CREAT | O-TRUNC
    }

    ; 附加旗標
    opts.excl -> flags = flags | O-EXCL
    opts.truncate -> flags = flags | O-TRUNC
    opts.append -> flags = flags | O-APPEND

    ; 從 opts.perm 取得權限值
    perm-val = 420
    pv = opts.perm
    pv: {
        perm-600 -> perm-val = 384

        perm-644 -> perm-val = 420

        perm-664 -> perm-val = 436

        perm-666 -> perm-val = 438

        perm-755 -> perm-val = 493

        perm-777 -> perm-val = 511
    }
    fd = open-file(p, flags, perm-val)
    fd < 0 -> {

        ; 獲取 errno 並返回詳細錯誤信息
        errno = os.get-errno()
        err-msg = os.strerror(errno)
        f = err(err-msg)
        return
    }
    f = file {
        fd: fd
        path: p
    }
}

; 從檔案讀取最多 n 位元組到 buf
; buf: 讀入緩衝區（須預留至少 n 位元組）
; n: 本輪最多讀取的位元組數
; read-n: 實際讀取位元組數（0=EOF, -1=錯誤或未開啟）
; [read](#fs.file.read)
file.read = (buf []byte, n i64) (read-n i64) {
    read-n = 0
    .fd < 0 -> return
    read-n = read(.fd, buf, n)
}

; 從檔案讀取一行（最多 4096 位元組）
; 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
; line: ok=讀到的一行（不含換行符）, nil=EOF、逾 4096 位元組或錯誤
; [read-line](#fs.file.read-line)
file.read-line = () (line ?str) {
    line = nil
    .fd < 0 -> return
    buf []byte = with-len(4096)
    n = read(.fd, buf, 4096)
    n > 0 -> line = buf.slice(0, n).to-bytes-str()
}

; 將 data 的前 n 位元組寫入檔案
; data: 待寫入資料（僅取其前 n 個位元組）
; n: 要寫入的位元組數
; written: 實際寫入位元組數（-1=錯誤或未開啟）
; [write](#fs.file.write)
file.write = (data []byte, n i64) (written i64) {
    written = 0
    .fd < 0 -> return
    written = write(.fd, data, n)
}

; 關閉檔案
; 成功後 fd 重設為 -1
; 標準檔案（STDIN/STDOUT/STDERR）不會被關閉
; ok: true=已成功關閉（fd 隨後重設為 -1；標準流與重複關閉為 false）
; [close](#fs.file.close)
file.close = () (ok bool) {
    {
        .fd < 0 -> {
            ok = false
            return
        }

        .fd <= 2 -> {
            ok = true
            return
        }
    }
    rc = close(.fd)
    .fd = -1
    ok = rc == 0
}

; 檢查檔案是否已開啟
; yes: true=fd ≥ 0，即檔案仍在開啟狀態
; [is-open](#fs.file.is-open)
file.is-open = () (yes bool) {
    yes = .fd >= 0
}

; 取得開啟中檔案的大小（透過 fstat(fd)，消除 TOCTOU）
; sz: 以 fstat 取得的檔案當前大小（位元組）
; [size](#fs.file.size)
file.size = () (sz i64) {
    sz = fstat-size(.fd)
}

; 讀取整個檔案為字串
; 返回 content ?str:
;   ok(str) — 成功，含檔案內容
;   nil     — 檔案為空
;   err     — 檔案未開啟或讀取失敗
; content: ok=檔案內容, nil=檔案為空, err=未開啟或讀取失敗
; [read-str](#fs.file.read-str)
file.read-str = () (content ?str) {
    b = .read-bytes()
    b: {
        err -> content = err(it)

        nil -> return

        -> content = it.to-bytes-str()
    }
}

; 讀取整個檔案為 []byte（Rust 混合策略）
; 返回 content ?[]byte:
;   ok([]byte) — 成功，含檔案內容
;   nil        — 檔案為空
;   err        — 檔案未開啟或讀取失敗
; content: ok=檔案內容, nil=檔案為空, err=未開啟或讀取失敗
; [read-bytes](#fs.file.read-bytes)
file.read-bytes = () (content ?[]byte) {
    .fd < 0 -> {
        content = err('file not open')
        return
    }

    ; 用 fstat(fd) 取得大小 — 消除 TOCTOU
    size ?= fstat-size(.fd)
    size == 0 -> {
        content = nil
        return
    }

    ; 精確分配 buffer（len=size, cap=size）
    buf []byte = with-len(size)

    ; 循環 read 直到讀完或 EOF
    total = 0
    (total < size) {

        total >= size -> break

        #{overflow=wrap}
        n = read(.fd, buf[total..], size - total)
        n <= 0 -> break

        #{overflow=wrap}
        total = total + n
    }

    ; 截斷到實際讀取長度
    buf.truncate(total)
    total == 0 -> {
        content = nil
        return
    }
    content = buf
}

; 將字串寫入檔案（覆寫整個檔案）
; data str: 要寫入的字串
; 返回 ok ?bool:
;   ok(true)  — 成功
;   err       — 檔案未開啟或寫入失敗
; data: 要寫入的字串（整檔覆寫，原內容被替換）
; ok: ok(true)=寫入成功, err=未開啟或寫入失敗
; [write-str](#fs.file.write-str)
file.write-str = (data str) (ok ?bool) {
    .fd < 0 -> {
        ok = err('file not open')
        return
    }
    s = data.to-bytes()
    total = 0
    (total < s.len()) {

        total >= s.len() -> break

        #{overflow=wrap}
        n = write(.fd, s[total..], s.len() - total)
        n <= 0 -> break

        #{overflow=wrap}
        total = total + n
    }
    total == s.len() -> ok = true
}

; 將 []byte 寫入檔案（覆寫整個檔案）
; data []byte: 要寫入的位元組陣列
; 返回 ok ?bool:
;   ok(true)  — 成功
;   err       — 檔案未開啟或寫入失敗
; data: 要寫入的位元組（整檔覆寫）
; ok: ok(true)=寫入成功, err=未開啟或寫入失敗
; [write-bytes](#fs.file.write-bytes)
file.write-bytes = (data []byte) (ok ?bool) {
    .fd < 0 -> {
        ok = err('file not open')
        return
    }
    total = 0
    (total < data.len()) {

        total >= data.len() -> break

        #{overflow=wrap}
        n = write(.fd, data[total..], data.len() - total)
        n <= 0 -> break

        #{overflow=wrap}
        total = total + n
    }
    total == data.len() -> ok = true
}

; ═══════════════════════════════════════════════
; 全域快捷函數（等價 open + file 方法）
; ═══════════════════════════════════════════════

; 讀取整個檔案為 []byte
; p str: 檔案路徑
; 返回 content ?[]byte:
;   ok([]byte) — 成功，含檔案內容
;   nil        — 檔案為空
;   err        — 讀取失敗
; p: 檔案路徑
; content: ok=檔案內容, nil=檔案為空, err=開啟或讀取失敗
; [read-bytes](#fs.read-bytes)
read-bytes = (p str) (content ?[]byte) {
    f = open(p,  {
        mode: read
        perm: perm-644
        excl: false
        truncate: false
        append: false
    })
    f: {
        err -> content = err('open failed')

        nil -> return

        -> {
            content = it.read-bytes()
            it.close()
        }
    }
}

; 讀取整個檔案為字串
; p str: 檔案路徑
; 返回 content ?str:
;   ok(str) — 成功，含檔案內容
;   nil     — 檔案為空
;   err     — 讀取失敗
; p: 檔案路徑
; content: ok=檔案內容, nil=檔案為空, err=開啟或讀取失敗
; [read-str](#fs.read-str)
read-str = (p str) (content ?str) {
    f = open(p,  {
        mode: read
        perm: perm-644
        excl: false
        truncate: false
        append: false
    })
    f: {
        err -> content = err('open failed')

        nil -> return

        -> {
            content = it.read-str()
            it.close()
        }
    }
}

; 將字串寫入檔案（覆寫）
; p str: 檔案路徑
; data str: 要寫入的字串
; 返回 ok ?bool:
;   ok(true) — 成功
;   err      — 寫入失敗
; p: 目標路徑（不存在則建立）
; data: 要寫入的字串
; ok: ok(true)=成功, err=寫入失敗
; [write-str](#fs.write-str)
write-str = (p str, data str) (ok ?bool) {
    f = open(p,  {
        mode: write
        perm: perm-644
        excl: false
        truncate: false
        append: false
    })
    f: {
        err -> ok = err('open failed')

        nil -> ok = err('open failed')

        -> {
            ok = it.write-str(data)
            it.close()
        }
    }
}

; 將 []byte 寫入檔案（覆寫）
; p str: 檔案路徑
; data []byte: 要寫入的位元組陣列
; 返回 ok ?bool:
;   ok(true) — 成功
;   err      — 寫入失敗
; p: 目標路徑（不存在則建立）
; data: 要寫入的位元組
; ok: ok(true)=成功, err=寫入失敗
; [write-bytes](#fs.write-bytes)
write-bytes = (p str, data []byte) (ok ?bool) {
    f = open(p,  {
        mode: write
        perm: perm-644
        excl: false
        truncate: false
        append: false
    })
    f: {
        err -> ok = err('open failed')

        nil -> ok = err('open failed')

        -> {
            ok = it.write-bytes(data)
            it.close()
        }
    }
}

; 追加資料到檔案末尾
; 簡化實作：先讀取現有內容再合併寫入
; data: 要追加的文字（僅取其前 n 個位元組）
; n: 要追加的位元組數
; success: true=既有內容與新資料皆已寫回（追加靠「重寫整檔」達成）
; [append](#fs.file.append)
file.append = (data str, n i64) (success bool) {
    success = false
    .fd < 0 -> return
    save-path = .path
    .close()
    rd-fd = open-read(save-path)
    rd-fd < 0 -> return
    existing []byte = with-len(4096)
    exist-n = 0
    size = stat-size(save-path)
    size: {
        ok(it1) -> {
            it1 > 4096 -> exist-n = read(rd-fd, existing, 4096)

            it1 > 0 -> exist-n = read(rd-fd, existing, it1)
        }

        ; stat 失敗：視為空檔案，不預讀既有內容
        -> exist-n = 0
    }

    close(rd-fd)
    wr-fd = open-file(save-path, 1537, 420)
    wr-fd < 0 -> return
    .fd = wr-fd
    exist-n > 0 -> write(.fd, existing, exist-n)
    b = data.to-bytes()
    written = write(.fd, b, n)
    success = written == n
}

; 將本檔案複製到 dst-path
; 返回 true=成功, false=失敗
; dst-path: 目標檔案路徑（已存在會被覆寫）
; ok: true=複製完成
; [copy-to](#fs.file.copy-to)
file.copy-to = (dst-path str) (ok bool) {
    ok = false
    .fd < 0 -> return
    fd-w = open-file(dst-path, 1537, 420)
    fd-w < 0 -> return
    buf []byte = with-len(4096)
    !! {
        n = read(.fd, buf, 4096)
        n <= 0 -> *
        write(fd-w, buf, n)
    }
    close(fd-w)
    ok = true
}

; ═══════════════════════════════════════════════
; 檔案複製
; ═══════════════════════════════════════════════

; 複製檔案內容
; src: 來源檔案路徑
; dst: 目標檔案路徑
; ok: true=複製完成
; [copy-file](#fs.copy-file)
copy-file = (src str, dst str) (ok bool) {
    ok = false
    fd-r = open-read(src)
    fd-r < 0 -> return
    fd-w = open-write(dst)
    fd-w < 0 -> {
        close(fd-r)
        return
    }
    buf []byte = with-len(4096)
    !! {
        n = read(fd-r, buf, 4096)
        n <= 0 -> break
        write(fd-w, buf, n)
    }
    close(fd-r)
    close(fd-w)
    ok = true
}

; ═══════════════════════════════════════════════
; 目錄列表
; ═══════════════════════════════════════════════

; 列出目錄中的所有條目名稱
; 包含 '.' 和 '..' 條目（遵循 POSIX readdir）。失敗時返回空 slice。
; ⚠ 警告： '.'/'..' 會被遞歸遍歷誤當普通子項——尤其搭配 fs.remove/fs.rmdir
;   遞歸刪除時，進入 '..' 會向上逃逸出目標目錄、誤刪整棵父樹。
;   遞歸遍歷/刪除請改用 fs.dir-entries（已自動過濾 '.'/'..'）。
;
; 用法：
;   names = list-dir('/path/to/dir')
;   i <- [0..names.len()): {
;       print(names[i])
;   }
; dirpath: 目錄路徑
; entries: 條目名稱列表（含 '.' 與 '..'；目錄打不開時為空列表）
; [list-dir](#fs.list-dir)
#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
list-dir = (dirpath str) (entries []str) {
    dirp = open-dir(dirpath)
    {
        dirp == 0 -> return
    }
    result []str
    more = true
    (more == true) {
        name-opt = read-dir(dirp)
        name-opt: {
            ok -> result.push(it)
            -> more = false
        }
    }
    close-dir(dirp)
    entries = result
}

; Windows 版本：使用 FindFirstFileA/FindNextFileA/FindClose
; FindFirstFileA 需要路徑附加 '\*' 萬用字元
; dirpath: 目錄路徑（內部附加 '\\*' 後呼叫 FindFirstFileA）
; entries: 條目名稱列表（Windows _FIND_DATA 不返回 '.'/'..'）
; [list-dir](#fs.list-dir-2)
#{win-amd64, win-arm64}
list-dir = (dirpath str) (entries []str) {

    winpath = dirpath - '\\*'
    bufptr = os.win-find-first-file(winpath)
    {
        bufptr == 0 -> return
    }
    result []str
    more = true
    (more == true) {
        name-opt = os.win-find-next-file(bufptr)
        name-opt: {
            ok -> result.push(it)
            -> more = false
        }
    }
    os.win-find-close(bufptr)
    entries = result
}

; WASI 版本：使用 POSIX opendir/readdir/closedir
; wasi-libc 提供 opendir/readdir/closedir（包裝 WASI fd_readdir）
; dirpath: 目錄路徑
; entries: 條目名稱列表（WASI readdir 的原樣輸出）
; [list-dir](#fs.list-dir-3)
#{wasi-wasm32}
list-dir = (dirpath str) (entries []str) {
    dirp = open-dir(dirpath)
    {
        dirp == 0 -> return
    }
    result []str
    more = true
    (more == true) {
        name-opt = read-dir(dirp)
        name-opt: {
            ok -> result.push(it)
            -> more = false
        }
    }
    close-dir(dirp)
    entries = result
}

; ═══════════════════════════════════════════════
; 目錄條目（不含 '.' 和 '..'）
; ═══════════════════════════════════════════════

; 列出目錄中的條目名稱，自動過濾 '.' 和 '..'
; 失敗時返回空 slice。
;
; 用法：
;   names = dir-entries('/path/to/dir')
;   i <- [0..names.len()): {
;       print(names[i])
;   }
; dirpath: 目錄路徑
; entries: 子項名稱列表（已排除 '.'/'..'；目錄打不開時為空列表）
; [dir-entries](#fs.dir-entries)
dir-entries = (dirpath str) (entries []str) {
    all []str
    all = list-dir(dirpath)
    n = all.len()
    i <- [0..n): {

        #{index-out=zero}
        name = all[i]
        skip = false
        name.len-bytes() == 1 && name[0] == 46 -> {

            skip = true
        }
        name.len-bytes() == 2 && name[0] == 46 && name[1] == 46 -> {

            skip = true
        }
        skip == false -> entries.push(name)
    }
}

; ═══════════════════════════════════════════════
; 遞迴遍歷目錄樹
; ═══════════════════════════════════════════════

; 遞迴遍歷目錄樹，返回所有檔案路徑
; root str: 根目錄路徑
; 返回 paths []str: 所有檔案的完整路徑（不含目錄本身）
;
; 用法：
;   paths = walk('/path/to/dir')
;   i <- [0..paths.len()): {
;       print(paths[i])
;   }
; root: 根目錄路徑
; paths: 樹內所有檔案的完整路徑（目錄本身不列入）
; [walk](#fs.walk)
walk = (root str) (paths []str) {
    paths = walk-collect(root, paths)
}

; walk 的內部遞迴實作
; dirpath: 當前遍歷的目錄
; paths: 已收集的路徑累加器（遞迴往下傳）
; out: 追加完本層條目後的列表
; [walk-collect](#fs.walk-collect)
walk-collect = (dirpath str, paths []str) (out []str) {
    out = paths
    names []str
    names = dir-entries(dirpath)
    n = names.len()
    n == 0 -> return
    sep = 47
    i <- [0..n): {

        #{index-out=zero}
        name = names[i]
        fullpath str
        {
            dirpath.len-bytes() > 0 -> {

                #{overflow=wrap}
                last = dirpath[dirpath.len-bytes() - 1]
                last == sep -> fullpath = dirpath - name

                last != sep -> fullpath = dirpath - '/' - name
            }

            dirpath.len-bytes() == 0 -> fullpath = name
        }
        is-d = is-dir(fullpath)
        {
            is-d -> out = walk-collect(fullpath, out)

            is-d == false -> out.push(fullpath)
        }
    }
}
