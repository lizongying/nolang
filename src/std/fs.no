; fs — 檔案系統工具
;
; 以 file 結構體封裝開啟中的檔案，以 path 結構體封裝路徑。
; 包含檔案操作、讀寫、資訊查詢等底層系統調用。
;
; 用法：
;   f = open(FILE-PATH, {
;       mode: write
;       perm: perm-644
;       excl: false
;       truncate: false
;       append: false
;   })
;   f.write('hello', 5)                     // 方法呼叫
;   f.close()
;
;   line = stdin.read-line()              // 從標準輸入讀取一行，返回 ?str
;   n = stdout.write('hello', 5)             // 寫入標準輸出
;   n = stderr.write('error', 5)             // 寫入標準錯誤
;
;   p = path{
;       p: '/tmp'
;   }
;   yes = p.exists()

; ═══════════════════════════════════════════════
; 檔案操作（內建函數）
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: unlink)
; remove: 刪除檔案
; remove = (p str) (ok bool) {  // LLVM: call i32 @unlink → zext
; }

; build-in (ForwardFunc: rename)
; rename: 重新命名檔案
; rename = (o str, n str) (ok bool) {  // LLVM: call i32 @rename → zext
; }

; build-in (CLibCall: symlink)
; symlink: 建立符號連結
; target: 連結指向的目標路徑
; linkpath: 符號連結本身的路徑
; 成功返回 true，失敗返回 false
; symlink = (target str, linkpath str) (ok bool) {  // LLVM: call i32 @symlink → icmp eq 0 → zext
; }

; build-in (CLibCall: link)
; link: 建立硬連結
; oldpath: 既有檔案路徑
; newpath: 新硬連結路徑
; 成功返回 true，失敗返回 false
; link = (oldpath str, newpath str) (ok bool) {  // LLVM: call i32 @link → icmp eq 0 → zext
; }

; build-in (ForwardFunc: realpath)
; realpath: 解析絕對路徑
; p: 輸入路徑（可能是相對路徑或含 . / .. 的路徑）
; 成功返回規範化的絕對路徑字串，失敗返回空串
; realpath = (p str) (abs str) {  // LLVM: call i8* @realpath(p, NULL) → emitStrLongFromCStr
; }

; build-in (ForwardFunc: readlink)
; readlink: 讀取符號連結的目標路徑
; p: 符號連結路徑
; 成功返回目標路徑字串與 ok=true，失敗返回空串與 ok=false
; readlink = (p str) (target str, ok bool) {  // LLVM: call i64 @readlink(p, buf, n) → emitStrLongFromCStr
; }

; build-in (ForwardFunc: mkstemp)
; mkstemp: 建立並開啟唯一臨時檔案
; tmpl: 模板字串，末尾必須為 'XXXXXX'（六個 X）
; 成功返回實際檔名與檔案描述符，失敗返回空串與 fd=-1
; 注意：返回順序為 (name, fd) 而非 (fd, name)，因為 lastBuiltinExtra 機制要求
;       第二返回值必須是 i64/bool 型別，str 必須為主返回值
; mkstemp = (tmpl str) (name str, fd fd) {  // LLVM: call i32 @mkstemp(buf) → emitStrLongFromCStr
; }

; build-in (ForwardFunc: mkdtemp)
; mkdtemp: 建立唯一臨時目錄
; tmpl: 模板字串，末尾必須為 'XXXXXX'
; 成功返回實際目錄名與 ok=true，失敗返回空串與 ok=false
; mkdtemp = (tmpl str) (name str, ok bool) {  // LLVM: call i8* @mkdtemp(buf) → emitStrLongFromCStr
; }

; build-in (CLibCall: mkfifo)
; mkfifo: 建立命名管道（FIFO）
; p: 管道路徑
; mode: 權限模式（如 0o644 = 420）
; 成功返回 true，失敗返回 false
; mkfifo = (p str, mode i64) (ok bool) {  // LLVM: call i32 @mkfifo → icmp eq 0 → zext
; }

; build-in (ForwardFunc: utime)
; utime: 設定檔案的存取與修改時間
; p: 檔案路徑
; atime: 存取時間（Unix 秒）
; mtime: 修改時間（Unix 秒）
; 成功返回 true，失敗返回 false
; utime = (p str, atime i64, mtime i64) (ok bool) {  // LLVM: alloca [16 x i8] times → call i32 @utimes
; }

; build-in (ForwardFunc: stat-file)
; is-file: 判斷路徑是否為普通檔案
; is-file = (p str) (exists bool) {  // LLVM: call i32 @stat → icmp eq → zext
; }

; build-in (ForwardFunc: stat-dir)
; is-dir: 判斷路徑是否為目錄
; is-dir = (p str) (yes bool) {  // LLVM: call @stat + S-ISDIR(st-mode) → zext
; }

; build-in (ForwardFunc: stat-size)
; stat-size: 取得檔案大小
; stat-size = (p str) (size ?i64) {  // LLVM: call @stat → st-size
; }

; build-in (ForwardFunc: read-file)
; read-file: 讀取整個檔案內容為字串
; read-file = (p str) (content str) {  // LLVM: stat+open+malloc+read+close → %str-long
; }

; build-in (ForwardFunc: write-file)
; write-file: 將 []byte 寫入檔案（覆寫）
; write-file = (p str, data []byte) (ok bool) {  // LLVM: open+write+close → icmp
; }

; build-in (ForwardFunc: stat-size)
; file-size: 取得檔案大小（同 stat-size）
; file-size = (p str) (size ?i64) {  // LLVM: call @stat → st-size
; }

; ═══════════════════════════════════════════════
; 檔案讀寫（內建函數）
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: open-read)
; open-read: 以唯讀模式開啟檔案
; open-read = (path str) (fd fd) {  // LLVM: call i32 @open(O-RDONLY) → zext
; }

; build-in (ForwardFunc: open-write)
; open-write: 以寫入模式開啟檔案（O-WRONLY|O-CREAT|O-TRUNC, 0644）
; open-write = (path str) (fd fd) {  // LLVM: call i32 @open → zext
; }

; build-in (CLibCall: open)
; open-file: 以自訂旗標和權限開啟檔案
; open-file = (path str, flags i64, mode i64) (fd fd) {  // LLVM: call i32 (i8*, i32, ...) @open → sext
; }

; build-in (ForwardFunc: read)
; read: 從檔案描述符讀取最多 n 位元組到 buf
; read = (fd fd, buf str, n i64) (n i64) {  // LLVM: call i64 @read(fd, buf, n)
; }

; build-in (ForwardFunc: write)
; write: 將 data 的前 n 位元組寫入檔案描述符
; write = (fd fd, data str, n i64) (written i64) {  // LLVM: call i64 @write(fd, data, n)
; }

; build-in (ForwardFunc: close)
; close: 關閉檔案描述符
; close = (fd fd) (ok i64) {  // LLVM: call i32 @close(fd) → zext
; }

; ═══════════════════════════════════════════════
; 標準輸入（內建函數）
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: read-stdin-line)
; get-line: 從標準輸入讀取一行
; get-line = () (line ?str) {  // LLVM: call i8* @fgets(buf, size, stdin)
; }

; ═══════════════════════════════════════════════
; 目錄操作（內建函數）
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: open-dir)
; open-dir: 開啟目錄以讀取條目
; open-dir = (p str) (dirp i64) {  // LLVM: call i8* @opendir → ptrtoint to i64
; }

; build-in (ForwardFunc: read-dir)
; read-dir: 讀取下一個目錄條目名稱
; read-dir = (dirp i64) (name str, ok bool) {  // LLVM: call i8* @readdir → extract d_name → strlen → %str-long
; }

; build-in (ForwardFunc: close-dir)
; close-dir: 關閉目錄控制代碼
; close-dir = (dirp i64) (ok bool) {  // LLVM: call i32 @closedir → icmp eq 0 → zext
; }

; build-in (ForwardFunc: touch-file)
; touch-file: 更新檔案時間戳為當前時間
; touch-file = (p str) (ok bool) {  // LLVM: call i32 @utimensat(AT_FDCWD, path, NULL, 0) → icmp eq 0 → zext
; }

; open() 旗標常數（平台特定）
; O_RDONLY/O_WRONLY/O_RDWR 跨平台通用（0/1/2）
O-RDONLY = 0
O-WRONLY = 1
O-RDWR = 2

; O_CREAT: macOS=512, Linux=64, Windows=256, WASI=512 (wasi-libc POSIX 相容值)

#{mac-amd64}
O-CREAT = 512
#{mac-arm64}
O-CREAT = 512
#{linux-amd64}
O-CREAT = 64
#{linux-arm64}
O-CREAT = 64
#{win-amd64}
O-CREAT = 256
#{win-arm64}
O-CREAT = 256
#{wasi-wasm32}
O-CREAT = 512

; O_TRUNC: macOS=1024, Linux=512, Windows=512, WASI=1024

#{mac-amd64}
O-TRUNC = 1024
#{mac-arm64}
O-TRUNC = 1024
#{linux-amd64}
O-TRUNC = 512
#{linux-arm64}
O-TRUNC = 512
#{win-amd64}
O-TRUNC = 512
#{win-arm64}
O-TRUNC = 512
#{wasi-wasm32}
O-TRUNC = 1024

; O_APPEND: macOS=8, Linux=1024, Windows=8, WASI=8

#{mac-amd64}
O-APPEND = 8
#{mac-arm64}
O-APPEND = 8
#{linux-amd64}
O-APPEND = 1024
#{linux-arm64}
O-APPEND = 1024
#{win-amd64}
O-APPEND = 8
#{win-arm64}
O-APPEND = 8
#{wasi-wasm32}
O-APPEND = 8

; O_EXCL: macOS=2048, Linux=128, Windows=1024, WASI=2048

#{mac-amd64}
O-EXCL = 2048
#{mac-arm64}
O-EXCL = 2048
#{linux-amd64}
O-EXCL = 128
#{linux-arm64}
O-EXCL = 128
#{win-amd64}
O-EXCL = 1024
#{win-arm64}
O-EXCL = 1024
#{wasi-wasm32}
O-EXCL = 2048

; 標準檔案描述符
; fd 是檔案描述符的 newtype 別名（底層 i64），與 i64 在型別系統中互斥，
; 防止 fd 被亂用為任意整數（端口号、PID 等）。
; 整數字面量可賦值給 fd（如 STDIN-FD fd = 0），fd 可與整數字面量比較。
fd = i64

STDIN-FD fd = 0
STDOUT-FD fd = 1
STDERR-FD fd = 2

; ═══════════════════════════════════════════════
; file 結構體：封裝開啟中的檔案
; ═══════════════════════════════════════════════

; file: 開啟的檔案
; fd=-1 表示未開啟；path 為來源路徑
file {
    fd fd
    path str
}

; ═══════════════════════════════════════════════
; 特殊檔案：標準輸入/輸出/錯誤
; ═══════════════════════════════════════════════

; stdin: 標準輸入（fd=0）
stdin = file{
    fd: 0
    path: '<stdin>'
}

; stdout: 標準輸出（fd=1）
stdout = file{
    fd: 1
    path: '<stdout>'
}

; stderr: 標準錯誤（fd=2）
stderr = file{
    fd: 2
    path: '<stderr>'
}

; file-mode: 檔案開啟模式（預組合）
file-mode {
    read,
    write,
    append,
    read-write,
}

; file-perm: 檔案權限（預組合）
file-perm {
    perm-600,
    perm-644,
    perm-664,
    perm-666,
    perm-755,
    perm-777,
}

; file-opts: open() 選項
; mode: 檔案模式（file-mode 枚舉）
; perm: 權限（file-perm 枚舉）
; excl: 獨佔建立（同 O_EXCL）
; truncate: 截斷至 0 長度（同 O_TRUNC）
; append: 附加寫入（同 O_APPEND）
file-opts {
    mode file-mode
    perm file-perm
    excl bool
    truncate bool
    append bool
}

; open: 開啟檔案（建構函式）
; opts: file-opts 結構體
; 成功：f = file{ fd, path }（自動轉為 ?file）
; 失敗：f = err('錯誤訊息')
open = (p str, opts file-opts) (f ?file) {
    flags = 0

    ; 從 opts.mode 取得基礎旗標
    m file-mode = opts.mode
    m: {
        read -> flags = O-RDONLY
        write -> flags = O-WRONLY | O-CREAT | O-TRUNC
        append -> flags = O-WRONLY | O-CREAT | O-APPEND
        read-write -> flags = O-RDWR | O-CREAT | O-TRUNC
    }

    ; 附加旗標
    opts.excl -> flags = flags | O-EXCL
    opts.truncate -> flags = flags | O-TRUNC
    opts.append -> flags = flags | O-APPEND

    ; 從 opts.perm 取得權限值
    perm-val = 420
    pv file-perm = opts.perm
    pv: {
        perm-600 -> perm-val = 384
        perm-644 -> perm-val = 420
        perm-664 -> perm-val = 436
        perm-666 -> perm-val = 438
        perm-755 -> perm-val = 493
        perm-777 -> perm-val = 511
    }

    fd = open-file(p, flags, perm-val)
    fd < 0 -> {
        ; 獲取 errno 並返回詳細錯誤信息
        errno = os.get-errno()
        err-msg = os.strerror(errno)
        f = err(err-msg)
        return
    }
    f = file{
        fd: fd
        path: p
    }
}

; read: 從檔案讀取最多 n 位元組到 buf
file.read = (buf str, n i64) (read-n i64) {
    read-n = 0
    .fd < 0 -> return
    read-n = read(.fd, buf, n)
}

; read-line: 從檔案讀取一行（最多 4096 位元組）
; 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
file.read-line = () (line ?str) {
    line = nil
    .fd < 0 -> return
    buf str = with-cap(4096)
    n = read(.fd, buf, 4096)
    n > 0 -> line = buf
}

; write: 將 data 的前 n 位元組寫入檔案
file.write = (data str, n i64) (written i64) {
    written = 0
    .fd < 0 -> return
    written = write(.fd, data, n)
}

; close: 關閉檔案
; 成功後 fd 重設為 -1
; 標準檔案（stdin/stdout/stderr）不會被關閉
file.close = () (ok bool) {
    .fd < 0 -> {
        ok = false
        return
    }
    .fd <= 2 -> {
        ok = true
        return
    }
    rc = close(.fd)
    .fd = -1
    ok = rc == 0
}

; is-open: 檢查檔案是否已開啟
file.is-open = () (yes bool) {
    yes = .fd >= 0
}

; size: 取得開啟中檔案的大小（透過 .path 取得原始路徑）
file.size = () (sz i64) {
    sz = stat-size(.path)
}

; read-all: 讀取整個檔案（依據 .path 取得大小）
file.read-all = () (content str, n i64) {
    n = 0
    .fd < 0 -> return
    size = stat-size(.path)
    size > 0 -> {
        buf str = ' '.repeat(size)
        n = read(.fd, buf, size)
        i <- [0..n): {
            content[i] = buf[i]
        }
    }
}

; write-all: 將 data 的前 n 位元組寫入檔案（覆寫）
; 返回 true=成功, false=失敗
file.write-all = (data str, n i64) (ok bool) {
    ok = false
    .fd < 0 -> return
    written = write(.fd, data, n)
    ok = written == n
}

; append: 追加資料到檔案末尾
; 簡化實作：先讀取現有內容再合併寫入
file.append = (data str, n i64) (ok bool) {
    ok = false
    .fd < 0 -> return
    save-path = .path
    .close()

    rd-fd = open-read(save-path)
    rd-fd < 0 -> return
    existing [4096]byte
    exist-n = 0
    size = stat-size(save-path)
    size > 0 -> {
        size > 4096 -> exist-n = read(rd-fd, existing, 4096)
        -> exist-n = read(rd-fd, existing, size)
    }
    close(rd-fd)

    wr-fd = open-file(save-path, 1537, 420)
    wr-fd < 0 -> return
    .fd = wr-fd
    exist-n > 0 -> write(.fd, existing, exist-n)
    written = write(.fd, data, n)
    ok = written == n
}

; copy-to: 將本檔案複製到 dst-path
; 返回 true=成功, false=失敗
file.copy-to = (dst-path str) (ok bool) {
    ok = false
    .fd < 0 -> return
    fd-w = open-file(dst-path, 1537, 420)
    fd-w < 0 -> return
    buf [4096]byte
    {
        n = read(.fd, buf, 4096)
        n <= 0 -> *
        write(fd-w, buf, n)
    } ()
    close(fd-w)
    ok = true
}

; ═══════════════════════════════════════════════
; 檔案複製
; ═══════════════════════════════════════════════

; copy-file: 複製檔案內容
copy-file = (src str, dst str) (ok bool) {
    ok = false
    fd-r = open-read(src)
    fd-r < 0 -> return
    fd-w = open-write(dst)
    fd-w < 0 -> {
        close(fd-r)
        return
    }
    buf [4096]byte
    {
        n = read(fd-r, buf, 4096)
        n <= 0 -> break
        write(fd-w, buf, n)
    } (true)
    close(fd-r)
    close(fd-w)
    ok = true
}

; ═══════════════════════════════════════════════
; 目錄列表
; ═══════════════════════════════════════════════

; list-dir: 列出目錄中的所有條目名稱
; 包含 '.' 和 '..' 條目。失敗時返回空 slice。
;
; 用法：
;   names = list-dir('/path/to/dir')
;   i <- [0..names.len): {
;       print(names[i])
;   }

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
list-dir = (dirpath str) (entries []str) {
    dirp = open-dir(dirpath)

    {
        dirp == 0 -> return
    }

    {
        name, ok = read-dir(dirp)
        {
            ok == false -> {
                close-dir(dirp)
                return
            }
        }
        entries.push(name)
    } ()
}

; Windows 版本：使用 FindFirstFileA/FindNextFileA/FindClose
; FindFirstFileA 需要路徑附加 '\*' 萬用字元

#{win-amd64, win-arm64}
list-dir = (dirpath str) (entries []str) {
    winpath = dirpath - '\\*'
    bufptr = os.win-find-first-file(winpath)

    {
        bufptr == 0 -> return
    }

    {
        name, ok = os.win-find-next-file(bufptr)
        {
            ok == false -> {
                os.win-find-close(bufptr)
                return
            }
        }
        entries.push(name)
    } ()
}

; WASI 版本：使用 POSIX opendir/readdir/closedir
; wasi-libc 提供 opendir/readdir/closedir（包裝 WASI fd_readdir）

#{wasi-wasm32}
list-dir = (dirpath str) (entries []str) {
    dirp = open-dir(dirpath)

    {
        dirp == 0 -> return
    }

    {
        name, ok = read-dir(dirp)
        {
            ok == false -> {
                close-dir(dirp)
                return
            }
        }
        entries.push(name)
    } ()
}

; ═══════════════════════════════════════════════
; 目錄條目（不含 '.' 和 '..'）
; ═══════════════════════════════════════════════

; dir-entries: 列出目錄中的條目名稱，自動過濾 '.' 和 '..'
; 失敗時返回空 slice。
;
; 用法：
;   names = dir-entries('/path/to/dir')
;   i <- [0..names.len): {
;       print(names[i])
;   }

dir-entries = (dirpath str) (entries []str) {
    all []str
    all = list-dir(dirpath)
    n = all.len
    i <- [0..n): {
        name = all[i]
        skip = false
        name.len == 1 && name[0] == 46 -> skip = true
        name.len == 2 && name[0] == 46 && name[1] == 46 -> skip = true
        skip == false -> entries.push(name)
    }
}

; ═══════════════════════════════════════════════
; 遞迴遍歷目錄樹
; ═══════════════════════════════════════════════

; walk: 遞迴遍歷目錄樹，返回所有檔案路徑
; root str: 根目錄路徑
; 返回 paths []str: 所有檔案的完整路徑（不含目錄本身）
;
; 用法：
;   paths = walk('/path/to/dir')
;   i <- [0..paths.len): {
;       print(paths[i])
;   }

walk = (root str) (paths []str) {
    paths = _walk-collect(root, paths)
}

; _walk-collect: walk 的內部遞迴實作
_walk-collect = (dirpath str, paths []str) (out []str) {
    out = paths
    names []str
    names = dir-entries(dirpath)

    n = names.len
    n == 0 -> return

    SEP = 47

    i <- [0..n): {
        name = names[i]

        fullpath str
        dirpath.len > 0 -> {
            last = dirpath[dirpath.len - 1]
            last == SEP -> fullpath = dirpath - name
            last != SEP -> fullpath = dirpath - '/' - name
        }
        dirpath.len == 0 -> fullpath = name

        is-d = is-dir(fullpath)

        is-d -> out = _walk-collect(fullpath, out)
        is-d == false -> out.push(fullpath)
    }
}