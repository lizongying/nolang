// fs — 檔案系統工具
//
// 以 file 結構體封裝開啟中的檔案，以 path 結構體封裝路徑。
// 底層依賴 os 模組的系統調用（open-read、open-write、read、write、close 等）。
//
// 用法：
//   f = open(FILE-PATH, write, perm-644)   // 建構函式：回傳 ?file
//   f.write('hello', 5)                     // 方法呼叫
//   f.close()
//
//   p = path{ p: '/tmp' }
//   yes = p.exists()

// ═══════════════════════════════════════════════
// file 結構體：封裝開啟中的檔案
// ═══════════════════════════════════════════════

// file: 開啟的檔案
// fd=-1 表示未開啟；path 為來源路徑
file {
    fd i64
    path str
}

// file-mode: 檔案開啟模式（預組合）
file-mode {
    read,
    write,
    append,
    read-write,
}

// file-perm: 檔案權限（預組合）
file-perm {
    perm-644,
    perm-664,
    perm-666,
    perm-755,
    perm-777,
}

// open: 開啟檔案（建構函式）
// 成功：f = some(file{ fd, path })
// 失敗：f = nil
open = (p str, mode file-mode, perm file-perm) (f ?file) {
    flags i64 = 0
    mode: {
        read -> flags = 0
        write -> flags = 1537
        append -> flags = 521
        read-write -> flags = 1538
    }

    perm-val i64 = 420
    perm: {
        perm-644 -> perm-val = 420
        perm-664 -> perm-val = 436
        perm-666 -> perm-val = 438
        perm-755 -> perm-val = 493
        perm-777 -> perm-val = 511
    }

    fd = open-file(p, flags, perm-val)
    if fd < 0 {
        f = nil
        return
    }
    f = file{
        fd: fd
        path: p
    }
}

// read: 從檔案讀取最多 n 位元組到 buf
file.read = (buf str, n i64) (read-n i64) {
    read-n = 0
    if .fd < 0 {
        return
    }
    read-n = read(.fd, buf, n)
}

// write: 將 data 的前 n 位元組寫入檔案
file.write = (data str, n i64) (written i64) {
    written = 0
    if .fd < 0 {
        return
    }
    written = write(.fd, data, n)
}

// close: 關閉檔案
// 成功後 fd 重設為 -1
file.close = () (ok bool) {
    if .fd < 0 {
        ok = false
        return
    }
    rc = close(.fd)
    .fd = -1
    ok = rc == 0
}

// is-open: 檢查檔案是否已開啟
file.is-open = () (yes bool) {
    yes = .fd >= 0
}

// size: 取得開啟中檔案的大小（透過 .path 取得原始路徑）
file.size = () (sz i64) {
    sz = stat-size(.path)
}

// read-all: 讀取整個檔案（依據 .path 取得大小）
file.read-all = () (content str, n i64) {
    n = 0
    if .fd < 0 {
        return
    }
    size = stat-size(.path)
    if size > 0 {
        n = read(.fd, content, size)
    }
}

// write-all: 將 data 的前 n 位元組寫入檔案（覆寫）
// 返回 true=成功, false=失敗
file.write-all = (data str, n i64) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    written = write(.fd, data, n)
    ok = written == n
}

// append: 追加資料到檔案末尾
// 簡化實作：先讀取現有內容再合併寫入
file.append = (data str, n i64) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    save-path str = .path
    .close()

    rd-fd = open-read(save-path)
    if rd-fd < 0 {
        return
    }
    existing [4096]byte
    exist-n = 0
    size = stat-size(save-path)
    if size > 0 {
        if size > 4096 {
            exist-n = read(rd-fd, existing, 4096)
        } else {
            exist-n = read(rd-fd, existing, size)
        }
    }
    close(rd-fd)

    wr-fd = open-file(save-path, 1537, 420)
    if wr-fd < 0 {
        return
    }
    .fd = wr-fd
    if exist-n > 0 {
        write(.fd, existing, exist-n)
    }
    written = write(.fd, data, n)
    ok = written == n
}

// copy-to: 將本檔案複製到 dst-path
// 返回 true=成功, false=失敗
file.copy-to = (dst-path str) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    fd-w = open-file(dst-path, 1537, 420)
    if fd-w < 0 {
        return
    }
    buf [4096]byte
    ! {
        n = read(.fd, buf, 4096)
        if n <= 0 {
            *
        }
        write(fd-w, buf, n)
    }
    close(fd-w)
    ok = true
}