// fs — 檔案系統工具
//
// 以 file 結構體封裝開啟中的檔案，以 path 結構體封裝路徑。
// 包含檔案操作、讀寫、資訊查詢等底層系統調用。
//
// 用法：
//   f = open(FILE-PATH, {
//       mode: write
//       perm: perm-644
//       excl: false
//       truncate: false
//       append: false
//   })
//   f.write('hello', 5)                     // 方法呼叫
//   f.close()
//
//   line = stdin.read-line()              // 從標準輸入讀取一行，返回 ?str
//   n = stdout.write('hello', 5)             // 寫入標準輸出
//   n = stderr.write('error', 5)             // 寫入標準錯誤
//
//   p = path{
//       p: '/tmp'
//   }
//   yes = p.exists()

// ═══════════════════════════════════════════════
// 檔案操作（內建函數）
// ═══════════════════════════════════════════════

// build-in (ForwardFunc: unlink)
// remove: 刪除檔案
// remove = (p str) (ok bool) {  // LLVM: call i32 @unlink → zext
// }

// build-in (ForwardFunc: rename)
// rename: 重新命名檔案
// rename = (o str, n str) (ok bool) {  // LLVM: call i32 @rename → zext
// }

// build-in (ForwardFunc: stat-file)
// is-file: 判斷路徑是否為普通檔案
// is-file = (p str) (exists bool) {  // LLVM: call i32 @stat → icmp eq → zext
// }

// build-in (ForwardFunc: stat-dir)
// is-dir: 判斷路徑是否為目錄
// is-dir = (p str) (yes bool) {  // LLVM: call @stat + S-ISDIR(st-mode) → zext
// }

// build-in (ForwardFunc: stat-size)
// stat-size: 取得檔案大小
// stat-size = (p str) (size ?i64) {  // LLVM: call @stat → st-size
// }

// build-in (ForwardFunc: stat-size)
// file-size: 取得檔案大小（同 stat-size）
// file-size = (p str) (size ?i64) {  // LLVM: call @stat → st-size
// }

// ═══════════════════════════════════════════════
// 檔案讀寫（內建函數）
// ═══════════════════════════════════════════════

// build-in (ForwardFunc: open-read)
// open-read: 以唯讀模式開啟檔案
// open-read = (path str) (fd i64) {  // LLVM: call i32 @open(O-RDONLY) → zext
// }

// build-in (ForwardFunc: open-write)
// open-write: 以寫入模式開啟檔案（O-WRONLY|O-CREAT|O-TRUNC, 0644）
// open-write = (path str) (fd i64) {  // LLVM: call i32 @open → zext
// }

// build-in (CLibCall: nolang.open3)
// open-file: 以自訂旗標和權限開啟檔案
// open-file = (path str, flags i64, mode i64) (fd i64) {  // LLVM: call i32 @nolang.open3 → zext
// }

// build-in (ForwardFunc: read)
// read: 從檔案描述符讀取最多 n 位元組到 buf
// read = (fd i64, buf str, n i64) (n i64) {  // LLVM: call i64 @read(fd, buf, n)
// }

// build-in (ForwardFunc: write)
// write: 將 data 的前 n 位元組寫入檔案描述符
// write = (fd i64, data str, n i64) (written i64) {  // LLVM: call i64 @write(fd, data, n)
// }

// build-in (ForwardFunc: close)
// close: 關閉檔案描述符
// close = (fd i64) (ok i64) {  // LLVM: call i32 @close(fd) → zext
// }

// ═══════════════════════════════════════════════
// 標準輸入（內建函數）
// ═══════════════════════════════════════════════

// build-in (ForwardFunc: read-stdin-line)
// get-line: 從標準輸入讀取一行
// get-line = () (line ?str) {  // LLVM: call i8* @fgets(buf, size, stdin)
// }

// macOS open() 旗標常量
O-RDONLY = 0
O-WRONLY = 1
O-RDWR = 2
O-CREAT = 512
O-TRUNC = 1024
O-APPEND = 8
O-EXCL = 2048

// 標準檔案描述符
STDIN-FD = 0
STDOUT-FD = 1
STDERR-FD = 2

// ═══════════════════════════════════════════════
// file 結構體：封裝開啟中的檔案
// ═══════════════════════════════════════════════

// file: 開啟的檔案
// fd=-1 表示未開啟；path 為來源路徑
file {
    fd i64
    path str
}

// ═══════════════════════════════════════════════
// 特殊檔案：標準輸入/輸出/錯誤
// ═══════════════════════════════════════════════

// stdin: 標準輸入（fd=0）
stdin = file{
    fd: 0
    path: '<stdin>'
}

// stdout: 標準輸出（fd=1）
stdout = file{
    fd: 1
    path: '<stdout>'
}

// stderr: 標準錯誤（fd=2）
stderr = file{
    fd: 2
    path: '<stderr>'
}

// file-mode: 檔案開啟模式（預組合）
file-mode {
    read,
    write,
    append,
    read-write,
}

// file-perm: 檔案權限（預組合）
file-perm {
    perm-600,
    perm-644,
    perm-664,
    perm-666,
    perm-755,
    perm-777,
}

// file-opts: open() 選項
// mode: 檔案模式（file-mode 枚舉）
// perm: 權限（file-perm 枚舉）
// excl: 獨佔建立（同 O_EXCL）
// truncate: 截斷至 0 長度（同 O_TRUNC）
// append: 附加寫入（同 O_APPEND）
file-opts {
    mode file-mode
    perm file-perm
    excl bool
    truncate bool
    append bool
}

// open: 開啟檔案（建構函式）
// opts: file-opts 結構體
// 成功：f = file{ fd, path }（自動轉為 ?file）
// 失敗：f = nil
open = (p str, opts file-opts) (f ?file) {
    flags = 0

    // 從 opts.mode 取得基礎旗標
    m file-mode = opts.mode
    m: {
        read -> flags = O-RDONLY
        write -> flags = O-WRONLY | O-CREAT | O-TRUNC
        append -> flags = O-WRONLY | O-CREAT | O-APPEND
        read-write -> flags = O-RDWR | O-CREAT | O-TRUNC
    }

    // 附加旗標
    if opts.excl {
        flags = flags | O-EXCL
    }
    if opts.truncate {
        flags = flags | O-TRUNC
    }
    if opts.append {
        flags = flags | O-APPEND
    }

    // 從 opts.perm 取得權限值
    perm-val = 420
    pv file-perm = opts.perm
    pv: {
        perm-600 -> perm-val = 384
        perm-644 -> perm-val = 420
        perm-664 -> perm-val = 436
        perm-666 -> perm-val = 438
        perm-755 -> perm-val = 493
        perm-777 -> perm-val = 511
    }

    fd = open-file(p, flags, perm-val)
    if fd < 0 {
        f = nil
        return
    }
    f = file{
        fd: fd
        path: p
    }
}

// read: 從檔案讀取最多 n 位元組到 buf
file.read = (buf str, n i64) (read-n i64) {
    read-n = 0
    if .fd < 0 {
        return
    }
    read-n = read(.fd, buf, n)
}

// read-line: 從檔案讀取一行（最多 4096 位元組）
// 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
file.read-line = () (line ?str) {
    line = nil
    if .fd < 0 {
        return
    }
    buf str = ' '.repeat(4096)
    n = read(.fd, buf, 4096)
    if n > 0 {
        line = buf
    }
}

// write: 將 data 的前 n 位元組寫入檔案
file.write = (data str, n i64) (written i64) {
    written = 0
    if .fd < 0 {
        return
    }
    written = write(.fd, data, n)
}

// close: 關閉檔案
// 成功後 fd 重設為 -1
// 標準檔案（stdin/stdout/stderr）不會被關閉
file.close = () (ok bool) {
    if .fd < 0 {
        ok = false
        return
    }
    if .fd <= 2 {
        ok = true
        return
    }
    rc = close(.fd)
    .fd = -1
    ok = rc == 0
}

// is-open: 檢查檔案是否已開啟
file.is-open = () (yes bool) {
    yes = .fd >= 0
}

// size: 取得開啟中檔案的大小（透過 .path 取得原始路徑）
file.size = () (sz i64) {
    sz = stat-size(.path)
}

// read-all: 讀取整個檔案（依據 .path 取得大小）
file.read-all = () (content str, n i64) {
    n = 0
    if .fd < 0 {
        return
    }
    size = stat-size(.path)
    if size > 0 {
        n = read(.fd, content, size)
    }
}

// write-all: 將 data 的前 n 位元組寫入檔案（覆寫）
// 返回 true=成功, false=失敗
file.write-all = (data str, n i64) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    written = write(.fd, data, n)
    ok = written == n
}

// append: 追加資料到檔案末尾
// 簡化實作：先讀取現有內容再合併寫入
file.append = (data str, n i64) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    save-path = .path
    .close()

    rd-fd = open-read(save-path)
    if rd-fd < 0 {
        return
    }
    existing [4096]byte
    exist-n = 0
    size = stat-size(save-path)
    if size > 0 {
        if size > 4096 {
            exist-n = read(rd-fd, existing, 4096)
        } else {
            exist-n = read(rd-fd, existing, size)
        }
    }
    close(rd-fd)

    wr-fd = open-file(save-path, 1537, 420)
    if wr-fd < 0 {
        return
    }
    .fd = wr-fd
    if exist-n > 0 {
        write(.fd, existing, exist-n)
    }
    written = write(.fd, data, n)
    ok = written == n
}

// copy-to: 將本檔案複製到 dst-path
// 返回 true=成功, false=失敗
file.copy-to = (dst-path str) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    fd-w = open-file(dst-path, 1537, 420)
    if fd-w < 0 {
        return
    }
    buf [4096]byte
    ! {
        n = read(.fd, buf, 4096)
        if n <= 0 {
            *
        }
        write(fd-w, buf, n)
    }
    close(fd-w)
    ok = true
}

// ═══════════════════════════════════════════════
// 檔案複製
// ═══════════════════════════════════════════════

// copy-file: 複製檔案內容
copy-file = (src str, dst str) (ok bool) {
    ok = false
    fd-r = open-read(src)
    if fd-r < 0 {
        return
    }
    fd-w = open-write(dst)
    if fd-w < 0 {
        close(fd-r)
        return
    }
    buf [4096]byte
    for true {
        n = read(fd-r, buf, 4096)
        if n <= 0 {
            break
        }
        write(fd-w, buf, n)
    }
    close(fd-r)
    close(fd-w)
    ok = true
}