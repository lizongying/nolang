; arr — 陣列操作
;
; 提供固定大小陣列的通用操作。
; 泛型參數用單字母 a-z 自動推斷。
;
; 切片是視圖，非獨立類型：對 arr 進行切片操作（如 a[1..3]）會產生 []t（vec）視圖，
; 共享 arr 的底層記憶體，不複製資料。
; 因此 vec 的所有方法（len、push、pop、contains、reverse、clone、fill、to-arr 等）
; 均適用於 arr 的切片視圖。通過切片修改元素會影響原始 arr。
; 只存固定大小
; <=8 字节存值指針（i8..i64/u8..u64/f32/f64/bool），
; >8 字节存指针指針
; arr {
;     len i64 read-only
;     data i64 sealed
; }

; 注意：[n]t 方法中不能用 .len，因為 [n]t 的 self 是原始陣列 [N x T]*，
; 沒有 len 欄位。改用泛型參數 n（substitution 後替換為具體大小）。
; 範圍用 [0..n)（兩點 + 裸標識符 n），不能用 [0...len)（三點）。

; [n]t.len: 回傳陣列長度
; 註：輸出參數用 out 而非 n，避免與泛型參數 n 衝突
[n]t.len = () (out i64) {
    out = n
}

; [n]t.clone: 將陣列複製到 dst
[n]t.clone = () (dst [n]t) {
    i <- [0..n): {
        dst[i] = .[i]
    }
}

; [n]t.eq: 比較兩個陣列是否相等
[n]t.eq = (b [n]t) (yes bool) {
    yes = true
    i <- [0..n): {
        .[i] != b[i] -> {
            yes = false
            return
        }
    }
}

; [n]t.fill: 全部填充為 val
[n]t.fill = (val t) {
    i <- [0..n): {
        .[i] = val
    }
}

; [n]t.reverse: 反轉陣列
[n]t.reverse = () {
    i = 0
    j = n - 1
    {
        tmp = .[i]
        .[i] = .[j]
        .[j] = tmp
        i = i + 1
        j = j - 1
    } (i < j)
}

; [n]t.contains: 是否包含值 val
[n]t.contains = (val t) (found bool) {
    i <- [0..n): {
        .[i] == val -> {
            found = true
            return
        }
    }
}

; [n]t.to-vec: 陣列方法，轉為 []t vec
[n]t.to-vec = () (out []t) {
    out = with-len(n)
    i <- [0..n): {
        out[i] = .[i]
    }
}

; [n]t.max: 陣列中的最大值
[n]t.max = () (max t) {
    max = .[0]
    i <- [1..n): {
        .[i] > max -> max = .[i]
    }
}

; [n]t.min: 陣列中的最小值
[n]t.min = () (min t) {
    min = .[0]
    i <- [1..n): {
        .[i] < min -> min = .[i]
    }
}

; [n]t.sum: 陣列元素總和
[n]t.sum = () (sum t) {
    sum = 0
    i <- [0..n): {
        sum = sum + .[i]
    }
}

; [n]t.index-of: 找到值返回索引，否則 -1
[n]t.index-of = (val t) (idx i64) {
    idx = -1
    i <- [0..n): {
        .[i] == val -> {
            idx = i
            return
        }
    }
}

; [n]t.last: 最後一個元素
[n]t.last = () (val t) {
    idx = n - 1
    val = .[idx]
}

; [n]t.first: 第一個元素
[n]t.first = () (val t) {
    val = .[0]
}

; [n]t.sort-asc: 升序原地排序（插入排序）
[n]t.sort-asc = () {
    i <- [1..n): {
        key = .[i]
        j = i - 1
        {
            .[j] <= key -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}

; [n]t.sort-desc: 降序原地排序（插入排序）
[n]t.sort-desc = () {
    i <- [1..n): {
        key = .[i]
        j = i - 1
        {
            .[j] >= key -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}

; [n]t.swap: 交換兩位置元素
; i i64, j i64: 位置
[n]t.swap = (i i64, j i64) {
    tmp = .[i]
    .[i] = .[j]
    .[j] = tmp
}

; [n]t.count: 統計值出現次數
; val t: 要統計的值
; 返回 cnt i64: 出現次數
[n]t.count = (val t) (cnt i64) {
    cnt = 0
    i <- [0..n): {
        .[i] == val -> cnt = cnt + 1
    }
}

; [n]t.at: 安全索引訪問
; i i64: 索引
; 返回 val ?t: 越界返回 nil
[n]t.at = (i i64) (val ?t) {
    {
        i < 0 -> val = nil
        i >= n -> val = nil
        -> val = .[i]
    }
}

; [n]t.to-str: 字串表示
; 返回 out str: 格式如 '[1, 2, 3]'
; 元素轉字串：i64 用 i64-to-str（在 number.no 中定義，自動加載）
[n]t.to-str = () (out str) {
    {
        n == 0 -> out = '[]'
        -> {
            out = '['
            last = n - 1
            i <- [0..n): {
                out = out - number.i64-to-str(.[i])
                i < last -> out = out - ', '
            }
            out = out - ']'
        }
    }
}
