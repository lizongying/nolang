; arr — 陣列操作
;
; 提供固定大小陣列的通用操作。
; 泛型參數用單字母 a-z 自動推斷。
;
; 切片是視圖，非獨立類型：對 arr 進行切片操作（如 a[1..3]）會產生 []t（vec）視圖，
; 共享 arr 的底層記憶體，不複製資料。
; 因此 vec 的所有方法（len、push、pop、contains、reverse、clone、fill、to-arr 等）
; 均適用於 arr 的切片視圖。通過切片修改元素會影響原始 arr。
; 只存固定大小
; <=8 字节存值指針（i8..i64/u8..u64/f32/f64/bool），
; >8 字节存指针指針
; arr {
;     len i64 read-only
;     data i64 sealed
; }

; [n]t.len: 回傳陣列長度
[n]t.len = () (n i64) {
    n = .len
}

; [n]t.clone: 將陣列複製到 dst
[n]t.clone = () (dst [n]t) {
    i <- [0..n): {
        dst[i] = .[i]
    }
}

; [n]t.eq: 比較兩個陣列是否相等
[n]t.eq = (b [n]t) (yes bool) {
    yes = true
    i <- [0..n): {
        d = .[i] - b[i]
        d != 0 -> {
            yes = false
            return
        }
    }
}

; [n]t.fill: 全部填充為 val
[n]t.fill = (val t) {
    i <- [0..n): {
        .[i] = val
    }
}

; [n]t.reverse: 反轉陣列
[n]t.reverse = () {
    i = 0
    j = n - 1
    {
        tmp = .[i]
        .[i] = .[j]
        .[j] = tmp
        i = i + 1
        j = j - 1
    } (i < j)
}

; [n]t.contains: 是否包含值 val
[n]t.contains = (val t) (found i64) {
    found = 0
    i <- [0..n): {
        d = .[i] - val
        d == 0 -> {
            found = 1
            return
        }
    }
}

; [n]t.to-vec: 陣列方法，轉為 []t vec
[n]t.to-vec = () (out []t) {
    out = with-len(n)
    i <- [0..n): {
        out[i] = .[i]
    }
}

; [n]t.max: 陣列中的最大值
[n]t.max = () (max t) {
    max = .[0]
    i <- [1..n): {
        d = .[i] - max
        d > 0 -> max = .[i]
    }
}

; [n]t.min: 陣列中的最小值
[n]t.min = () (min t) {
    min = .[0]
    i <- [1..n): {
        d = .[i] - min
        d < 0 -> min = .[i]
    }
}

; [n]t.sum: 陣列元素總和
[n]t.sum = () (sum t) {
    sum = 0
    i <- [0..n): {
        sum = sum + .[i]
    }
}

; [n]t.index-of: 找到值返回索引，否則 -1
[n]t.index-of = (val t) (idx i64) {
    idx = -1
    i <- [0..n): {
        d = .[i] - val
        d == 0 -> {
            idx = i
            return
        }
    }
}

; [n]t.last: 最後一個元素
[n]t.last = () (val t) {
    val = .[n - 1]
}

; [n]t.first: 第一個元素
[n]t.first = () (val t) {
    val = .[0]
}

; [n]t.sort-asc: 升序原地排序（插入排序）
[n]t.sort-asc = () {
    i <- [1..n): {
        key = .[i]
        j = i - 1
        {
            d = .[j] - key
            d <= 0 -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}

; [n]t.sort-desc: 降序原地排序（插入排序）
[n]t.sort-desc = () {
    i <- [1..n): {
        key = .[i]
        j = i - 1
        {
            d = .[j] - key
            d >= 0 -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}
