; char — 字元操作
;
; char 本質為 i32（Unicode 碼點/rune）。
; 提供字元分類、大小寫轉換、UTF-8 編碼等方法。
;
; 用法：
;   c = "A"                  // 雙引號 = char 字面量（單字符 rune）
;   yes = c.is-upper()       // true
;   u = c.to-lower()         // "a"
;   s = c.to-str()           // s = 'A'（單引號 = str）

; ═══════════════════════════════════════════════
; 字元分類
; ═══════════════════════════════════════════════

; is-digit: 判斷是否為數字（0-9）
char.is-digit = () (result bool) {
    . >= 48 && . <= 57 -> result = true
}

; is-letter: 判斷是否為字母（A-Z a-z）
char.is-letter = () (result bool) {
    . >= 65 && . <= 90 -> {
        result = true
        return
    }
    . >= 97 && . <= 122 -> result = true
}

; is-alpha: 判斷是否為字母（A-Z a-z）
; is-letter 的別名
char.is-alpha = () (result bool) {
    . >= 65 && . <= 90 -> {
        result = true
        return
    }
    . >= 97 && . <= 122 -> result = true
}

; is-alnum: 判斷是否為字母或數字
char.is-alnum = () (result bool) {
    .is-digit() || .is-alpha() -> result = true
}

; is-space: 判斷是否為空白字元（space tab newline cr）
char.is-space = () (result bool) {
    . == 32 || . == 9 || . == 10 || . == 13 -> result = true
}

; is-upper: 判斷是否為大寫字母（A-Z）
char.is-upper = () (result bool) {
    . >= 65 && . <= 90 -> result = true
}

; is-lower: 判斷是否為小寫字母（a-z）
char.is-lower = () (result bool) {
    . >= 97 && . <= 122 -> result = true
}

; ═══════════════════════════════════════════════
; 大小寫轉換
; ═══════════════════════════════════════════════

; to-upper: 轉為大寫（僅 ASCII）
char.to-upper = () (result char) {
    {
        . >= 97 && . <= 122 -> {
            #{overflow=wrap}
            result = . - 32
        }

        -> result = .
    }
}

; to-lower: 轉為小寫（僅 ASCII）
char.to-lower = () (result char) {
    {
        . >= 65 && . <= 90 -> {
            #{overflow=wrap}
            result = . + 32
        }

        -> result = .
    }
}

; ═══════════════════════════════════════════════
; UTF-8 編碼
; ═══════════════════════════════════════════════

; to-bytes: 轉為 UTF-8 編碼的位元組陣列
char.to-bytes = () (out []byte) {
    buf [4]byte = [0x00, 0x00, 0x00, 0x00]
    len = 0
    {
        . < 0x80 -> {
            buf[0] = .
            len = 1
        }

        . < 0x800 -> {
            buf[0] = 0xc0 | ((. >> 6) & 0x1f)
            buf[1] = 0x80 | (. & 0x3f)
            len = 2
        }

        . < 0x10000 -> {
            buf[0] = 0xe0 | ((. >> 12) & 0x0f)
            buf[1] = 0x80 | ((. >> 6) & 0x3f)
            buf[2] = 0x80 | (. & 0x3f)
            len = 3
        }

        -> {
            buf[0] = 0xf0 | ((. >> 18) & 0x07)
            buf[1] = 0x80 | ((. >> 12) & 0x3f)
            buf[2] = 0x80 | ((. >> 6) & 0x3f)
            buf[3] = 0x80 | (. & 0x3f)
            len = 4
        }
    }
    out = with-len(len)
    i <- [0..len): {
        out[i] = buf[i]
    }
}

; to-str: 轉為 UTF-8 編碼的字串
char.to-str = () (s str) {
    s = with-cap(4)
    {
        . < 0x80 -> s[0] = .

        . < 0x800 -> {
            s[0] = 0xc0 | ((. >> 6) & 0x1f)
            s[1] = 0x80 | (. & 0x3f)
        }

        . < 0x10000 -> {
            s[0] = 0xe0 | ((. >> 12) & 0x0f)
            s[1] = 0x80 | ((. >> 6) & 0x3f)
            s[2] = 0x80 | (. & 0x3f)
        }

        -> {
            s[0] = 0xf0 | ((. >> 18) & 0x07)
            s[1] = 0x80 | ((. >> 12) & 0x3f)
            s[2] = 0x80 | ((. >> 6) & 0x3f)
            s[3] = 0x80 | (. & 0x3f)
        }
    }
}

; ═══════════════════════════════════════════════
; []char 切片 → 字符串
; ═══════════════════════════════════════════════

; []char.to-str: 将字符切片转为字符串（按 UTF-8 编码每个码点）
; 每个码点按 UTF-8 写成 1~4 字节，push 进一个 []byte 临时切片；最后用循环下标
; 把临时字节切片一次性拷入 out（out[j] = tmp[j]，下标用循环变量 j）。
;
; ⚠️ 注意：截至 2026-09-06，nolang 编译器对 []char 切片类型的支持不完整，本方法尚不可用：
;   - legacy 后端：[]char 的 with-cap/push 对 len/cap 的单位（元素数 vs 字节数）处理有误，
;     导致 .len() 返回的元素数偏大，[]char.to-str 会越界读取产生乱码（实测单个 push(72)
;     也输出 "H"+乱码）。[]char 字面量与索引读取本身是 i32 stride 正确的，但 push 构造出的
;     切片 len 字段被破坏。
;   - MIR=3 门禁：编译器对 []char 元素类型与新增的 []t.to-chars 泛型方法均无支持，
;     直接报 "unknown callee []t.to-chars"，无法编译通过。
; 在编译器修复 []char 切片支持前，请勿依赖 to-chars / []char.to-str。
[]char.to-str = () (out str) {
    n = .len()

    #{overflow=saturate}
    tmp []byte = with-cap(n * 4)
    i <- [0..n): {
        cp = .[i]
        {
            cp < 0x80 -> tmp.push(cp & 0xff)

            cp < 0x800 -> {
                tmp.push(0xc0 | ((cp >> 6) & 0x1f))
                tmp.push(0x80 | (cp & 0x3f))
            }

            cp < 0x10000 -> {
                tmp.push(0xe0 | ((cp >> 12) & 0x0f))
                tmp.push(0x80 | ((cp >> 6) & 0x3f))
                tmp.push(0x80 | (cp & 0x3f))
            }

            -> {
                tmp.push(0xf0 | ((cp >> 18) & 0x07))
                tmp.push(0x80 | ((cp >> 12) & 0x3f))
                tmp.push(0x80 | ((cp >> 6) & 0x3f))
                tmp.push(0x80 | (cp & 0x3f))
            }
        }
    }
    m = tmp.len()
    out = with-len(m)
    j <- [0..m): {
        out[j] = tmp[j]
    }
}
