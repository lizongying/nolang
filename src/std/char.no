; char — 字元操作
;
; char 本質為 i32（Unicode 碼點/rune）。
; 提供字元分類、大小寫轉換、UTF-8 編碼等方法。
;
; 用法：
;   c = "A"                  // 雙引號 = char 字面量（單字符 rune）
;   yes = c.is-upper()       // true
;   u = c.to-lower()         // "a"
;   s = c.to-str()           // s = 'A'（單引號 = str）

; ═══════════════════════════════════════════════
; 字元分類
; ═══════════════════════════════════════════════

; is-digit: 判斷是否為數字（0-9）
char.is-digit = () (result bool) {
    . >= 48 && . <= 57 -> result = true
}

; is-letter: 判斷是否為字母（A-Z a-z）
char.is-letter = () (result bool) {
    . >= 65 && . <= 90 -> {
        result = true
        return
    }
    . >= 97 && . <= 122 -> result = true
}

; is-alpha: 判斷是否為字母（A-Z a-z）
; is-letter 的別名
char.is-alpha = () (result bool) {
    . >= 65 && . <= 90 -> {
        result = true
        return
    }
    . >= 97 && . <= 122 -> result = true
}

; is-alnum: 判斷是否為字母或數字
char.is-alnum = () (result bool) {
    .is-digit() || .is-alpha() -> result = true
}

; is-space: 判斷是否為空白字元（space tab newline cr）
char.is-space = () (result bool) {
    . == 32 || . == 9 || . == 10 || . == 13 -> result = true
}

; is-upper: 判斷是否為大寫字母（A-Z）
char.is-upper = () (result bool) {
    . >= 65 && . <= 90 -> result = true
}

; is-lower: 判斷是否為小寫字母（a-z）
char.is-lower = () (result bool) {
    . >= 97 && . <= 122 -> result = true
}

; ═══════════════════════════════════════════════
; 大小寫轉換
; ═══════════════════════════════════════════════

; to-upper: 轉為大寫（僅 ASCII）
char.to-upper = () (result char) {
    {
        . >= 97 && . <= 122 -> result = . - 32
        -> result = .
    }
}

; to-lower: 轉為小寫（僅 ASCII）
char.to-lower = () (result char) {
    {
        . >= 65 && . <= 90 -> result = . + 32
        -> result = .
    }
}

; ═══════════════════════════════════════════════
; UTF-8 編碼
; ═══════════════════════════════════════════════

; to-bytes: 轉為 UTF-8 編碼的位元組陣列
char.to-bytes = () (out []byte) {
    buf [4]byte = [0x00, 0x00, 0x00, 0x00]
    len = 0

    {
        . < 0x80 -> {
            buf[0] = .
            len = 1
        }
        . < 0x800 -> {
            buf[0] = 0xC0 | ((. >> 6) & 0x1F)
            buf[1] = 0x80 | (. & 0x3F)
            len = 2
        }
        . < 0x10000 -> {
            buf[0] = 0xE0 | ((. >> 12) & 0x0F)
            buf[1] = 0x80 | ((. >> 6) & 0x3F)
            buf[2] = 0x80 | (. & 0x3F)
            len = 3
        }
        -> {
            buf[0] = 0xF0 | ((. >> 18) & 0x07)
            buf[1] = 0x80 | ((. >> 12) & 0x3F)
            buf[2] = 0x80 | ((. >> 6) & 0x3F)
            buf[3] = 0x80 | (. & 0x3F)
            len = 4
        }
    }

    out = with-len(len)
    i <- [0..len): {
        out[i] = buf[i]
    }
}

; to-str: 轉為 UTF-8 編碼的字串
char.to-str = () (s str) {
    s = with-cap(4)
    {
        . < 0x80 -> s[0] = .
        . < 0x800 -> {
            s[0] = 0xC0 | ((. >> 6) & 0x1F)
            s[1] = 0x80 | (. & 0x3F)
        }
        . < 0x10000 -> {
            s[0] = 0xE0 | ((. >> 12) & 0x0F)
            s[1] = 0x80 | ((. >> 6) & 0x3F)
            s[2] = 0x80 | (. & 0x3F)
        }
        -> {
            s[0] = 0xF0 | ((. >> 18) & 0x07)
            s[1] = 0x80 | ((. >> 12) & 0x3F)
            s[2] = 0x80 | ((. >> 6) & 0x3F)
            s[3] = 0x80 | (. & 0x3F)
        }
    }
}
