; args — 命令行參數解析
;
; 依賴 os.args() / os.arg() 提供底層存取。
; 提供標記偵測、選項讀取、位置參數等高階介面。

; ═══════════════════════════════════════════════
; 基礎
; ═══════════════════════════════════════════════

; 參數數量（含程式名）
; 委派至 os.args() builtin（回傳完整 argv 向量，取其長度）
; 回傳的計數包含 argv[0]（程式名），故沒有額外參數時最小值為 1。
; n i64: argv 的總元素數（即命令列參數個數 + 1）
; [count](#args.count)
count = () (n i64) {
    n = os.args().len()
}

; 獲取第 i 個原始參數（不做任何旗標 / 位置參數的解析）
; 委派至 os.arg(i) builtin（讀取 main 的 argv[i]）。
; i i64: 下標，0 為程式名，1 起為使用者輸入的參數
; val ?str: ok=argv[i], nil=下標越界（負數或 ≥ 參數數量）
; [get](#args.get)
get = (i i64) (val ?str) {
    val = os.arg(i)
}

; 程式名（第 0 個參數，即 argv[0] 原樣）
; name ?str: ok=argv[0]（通常是執行檔路徑，可能含目錄）, nil=argv 為空
; [program](#args.program)
program = () (name ?str) {
    name = os.arg(0)
}

; ═══════════════════════════════════════════════
; 標記偵測
; ═══════════════════════════════════════════════

; 判斷標記是否存在（如 --verbose, -v）
; 從 argv[1] 起逐一與 flag 做逐字元精確比對（非子串匹配，也不展開 --k=v）。
; 空字串 flag 永遠不匹配。
; flag str: 要比對的完整標記字串（含前導 - 或 --）
; yes bool: true=argv 中存在與 flag 完全相同的元素, false=不存在
; [has-flag](#args.has-flag)
has-flag = (flag str) (yes bool) {
    flagn = flag.len-bytes()
    n = count()
    i <- [1..n): {
        arg str = ''
        opt-arg = get(i)
        opt-arg: {
            ok -> arg = it

            -> _
        }

        ; 精確比對 arg 與 flag
        matched = true
        flagn == 0 -> matched = false
        j <- [0..flagn): {

            ac = arg[j]

            fc = flag[j]
            ac != fc -> {
                matched = false
                break
            }
        }
        matched == true -> {
            yes = true
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 選項讀取
; ═══════════════════════════════════════════════

; 獲取選項值（如 --output=xxx）
; 逐一比對 argv[1..]，找出以 key 開頭且緊接 '='（0x3D）的參數，
; 回傳 '=' 之後的剩餘部分（按位元組切片，可為空字串）。只取第一個匹配項。
; key str: 選項鍵（含前導 - 或 --，如 '--output'）
; val ?str: ok='=' 後的值（可能為 ''）, nil=沒有任何參數符合 key=...
; [get-option](#args.get-option)
get-option = (key str) (val ?str) {
    val = nil
    keyn = key.len-bytes()
    n = count()
    i <- [1..n): {
        arg str = ''
        opt-arg = get(i)
        opt-arg: {
            ok -> arg = it

            -> _
        }

        ; 檢查 arg 是否以 key + '=' 開頭
        matched-prefix = 1
        j <- [0..keyn): {

            ac = arg[j]

            kc = key[j]
            ac != kc -> {
                matched-prefix = 0
                break
            }
        }
        matched-prefix == 1 -> {

            ; 檢查 key 後是 '='
            eq = arg[keyn]
            eq == 61 -> {

                ; 取 '=' 後的內容作為 val
                #{overflow=wrap}
                start = keyn + 1
                val = arg.slice-bytes(start, arg.len-bytes())
                return
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 位置參數
; ═══════════════════════════════════════════════

; 獲取第 idx 個位置參數（從 0 起算），期間跳過所有旗標
; 掃描 argv[1..]：以 '-' 開頭的參數一律跳過；若它是單橫線形式（如 -o），
; 還會額外跳過其後一個不以 '-' 開頭的參數（視為該選項的值）；
; 雙橫線形式（如 --output=xxx）只跳過自身。其餘參數按出現順序計數。
; idx i64: 位置參數序號，0 表示第一個非旗標參數
; val ?str: ok=第 idx 個位置參數, nil=位置參數數量不足
; [get-positional](#args.get-positional)
get-positional = (idx i64) (val ?str) {
    val = nil
    n = count()
    pos = 0
    j = 1
    (j < n) {

        arg str = ''
        opt-arg = get(j)
        opt-arg: {
            ok -> arg = it

            -> _
        }

        ; 跳過以 '-' 開頭的參數
        c0 = arg[0]

        #{overflow=wrap}
        c0 == 45 -> {

            #{overflow=wrap}
            j = j + 1

            ; 如果是 --key value 形式，也跳過下一個
            c1 = arg[1]
            c1 != 45 -> j < n -> {

                next str = ''
                opt-next = get(j)
                opt-next: {
                    ok -> next = it

                    -> _
                }

                nc = next[0]
                nc != 45 -> j = j + 1
            }
            continue
        }

        pos == idx -> {

            val = arg
            return
        }

        #{overflow=wrap}
        pos = pos + 1

        #{overflow=wrap}
        j = j + 1
    }
}
