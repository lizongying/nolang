; args — 命令行參數解析
;
; 依賴 os.args() / os.arg() 提供底層存取。
; 提供標記偵測、選項讀取、位置參數等高階介面。

; ═══════════════════════════════════════════════
; 基礎
; ═══════════════════════════════════════════════

; 參數數量（含程式名）
; 委派至 os.args() builtin（回傳完整 argv 向量，取其長度）
; [count](#args.count)
count = () (n i64) {
    n = os.args().len()
}

; 獲取第 i 個參數
; 委派至 os.arg(i) builtin（讀取 main 的 argv[i]）；越界回傳 nil
; [get](#args.get)
get = (i i64) (val ?str) {
    val = os.arg(i)
}

; 程式名（第 0 個參數）
; [program](#args.program)
program = () (name ?str) {
    name = os.arg(0)
}

; ═══════════════════════════════════════════════
; 標記偵測
; ═══════════════════════════════════════════════

; 判斷標記是否存在（如 --verbose, -v）
; [has-flag](#args.has-flag)
has-flag = (flag str) (yes bool) {
    flagn = flag.len-bytes()
    n = count()
    i <- [1..n): {
        arg str = ''
        opt-arg = get(i)
        opt-arg: {
            ok -> arg = it
            -> _
        }

        ; 精確比對 arg 與 flag
        matched = true
        flagn == 0 -> matched = false
        j <- [0..flagn): {

            ac = arg[j]

            fc = flag[j]
            ac != fc -> {
                matched = false
                break
            }
        }
        matched == true -> {
            yes = true
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 選項讀取
; ═══════════════════════════════════════════════

; 獲取選項值（如 --output=xxx）
; 返回 val ?str: ok=選項值, nil=未找到
; [get-option](#args.get-option)
get-option = (key str) (val ?str) {
    val = nil
    keyn = key.len-bytes()
    n = count()
    i <- [1..n): {
        arg str = ''
        opt-arg = get(i)
        opt-arg: {
            ok -> arg = it
            -> _
        }

        ; 檢查 arg 是否以 key + '=' 開頭
        matched-prefix = 1
        j <- [0..keyn): {

            ac = arg[j]

            kc = key[j]
            ac != kc -> {
                matched-prefix = 0
                break
            }
        }
        matched-prefix == 1 -> {

            ; 檢查 key 後是 '='
            eq = arg[keyn]
            eq == 61 -> {

                ; 取 '=' 後的內容作為 val
                #{overflow=wrap}
                start = keyn + 1
                val = arg.slice-bytes(start, arg.len-bytes())
                return
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 位置參數
; ═══════════════════════════════════════════════

; 獲取第 i 個位置參數（跳過標記）
; 返回 val ?str: ok=位置參數值, nil=不存在
; [get-positional](#args.get-positional)
get-positional = (idx i64) (val ?str) {
    val = nil
    n = count()
    pos = 0
    j = 1
    (j < n) {

        arg str = ''
        opt-arg = get(j)
        opt-arg: {
            ok -> arg = it
            -> _
        }

        ; 跳過以 '-' 開頭的參數
        c0 = arg[0]

        #{overflow=wrap}
        c0 == 45 -> {

            #{overflow=wrap}
            j = j + 1

            ; 如果是 --key value 形式，也跳過下一個
            c1 = arg[1]
            c1 != 45 -> j < n -> {

                next str = ''
                opt-next = get(j)
                opt-next: {
                    ok -> next = it
                    -> _
                }

                nc = next[0]
                nc != 45 -> j = j + 1
            }
            continue
        }

        pos == idx -> {

            val = arg
            return
        }

        #{overflow=wrap}
        pos = pos + 1

        #{overflow=wrap}
        j = j + 1
    }
}
