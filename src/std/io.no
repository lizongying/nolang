; io — 基本輸入輸出介面
;
; 提供 reader/writer 抽象介面與便捷函數，
; 統一檔案、標準輸入輸出、字串等資料流的讀寫操作。
; 底層依賴 fs 模組的 read/write/get-line 內建函數，
; 透過 fs.read / fs.write / fs.get-line 呼叫。
;
; 用法：
;   r = reader.from-stdin()
;   line = r.read-line()
;
;   w = writer.from-stdout()
;   n = w.write-str('hello')
;
;   io.out('hello')
;   io.outln('world')
;   line = io.read-line()

; ═══════════════════════════════════════════════
; 標準檔案描述符
; ═══════════════════════════════════════════════

STDIN-FD fd = 0
STDOUT-FD fd = 1
STDERR-FD fd = 2

; ═══════════════════════════════════════════════
; reader 結構體：封裝讀取來源
; ═══════════════════════════════════════════════

; reader: 讀取器
; fd: 底層檔案描述符
reader {
    fd fd
}

; reader.from-fd: 從檔案描述符建立讀取器
reader.from-fd = (fd fd) (r reader) {
    r.fd = fd
}

; reader.from-stdin: 從標準輸入建立讀取器
reader.from-stdin = () (r reader) {
    r.fd = STDIN-FD
}

; read: 從讀取器讀取最多 n 位元組到 buf
; 返回實際讀取的位元組數，0 表示 EOF 或錯誤
reader.read = (buf []byte, n i64) (read-n i64) {
    read-n = 0
    .fd < 0 -> return
    read-n = fs.read(.fd, buf, n)
}

; read-byte: 讀取一個位元組
; 返回 b ?i64: ok=位元組值, nil=EOF 或錯誤
reader.read-byte = () (b ?i64) {
    b = nil
    .fd < 0 -> return
    buf []byte = with-len(1)
    n = fs.read(.fd, buf, 1)
    n > 0 -> b = buf[0]
}

; read-line: 讀取一行（最多 4096 位元組）
; 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
reader.read-line = () (line ?str) {
    line = nil
    .fd < 0 -> return
    buf []byte = with-cap(4096)
    n = fs.read(.fd, buf, 4096)
    n > 0 -> line = buf.slice(0, n).to-str()
}

; read-all: 讀取全部內容到 buf（最多 size 位元組）
; 需要呼叫者傳入大小
reader.read-all = (buf []byte, size i64) (total i64) {
    total = 0
    .fd < 0 -> return
    total = fs.read(.fd, buf, size)
}

; ═══════════════════════════════════════════════
; writer 結構體：封裝寫入目標
; ═══════════════════════════════════════════════

; writer: 寫入器
; fd: 底層檔案描述符
writer {
    fd fd
}

; writer.from-fd: 從檔案描述符建立寫入器
writer.from-fd = (fd fd) (w writer) {
    w.fd = fd
}

; writer.from-stdout: 從標準輸出建立寫入器
writer.from-stdout = () (w writer) {
    w.fd = STDOUT-FD
}

; writer.from-stderr: 從標準錯誤建立寫入器
writer.from-stderr = () (w writer) {
    w.fd = STDERR-FD
}

; write: 將 data 的前 n 位元組寫入
; 返回實際寫入的位元組數
writer.write = (data []byte, n i64) (written i64) {
    written = 0
    .fd < 0 -> return
    written = fs.write(.fd, data, n)
}

; write-str: 寫入整個字串
; 返回實際寫入的位元組數
writer.write-str = (s str) (written i64) {
    written = 0
    .fd < 0 -> return
    b = s.to-bytes()
    written = fs.write(.fd, b, b.len)
}

; write-byte: 寫入一個位元組
; 返回實際寫入的位元組數（0 或 1）
writer.write-byte = (b i64) (written i64) {
    written = 0
    .fd < 0 -> return
    buf []byte = with-len(1)
    buf[0] = b & 255
    written = fs.write(.fd, buf, 1)
}

; write-line: 寫入字串並附加換行符
; 返回實際寫入的位元組數
writer.write-line = (s str) (written i64) {
    written = 0
    .fd < 0 -> return
    b = s.to-bytes()
    n = fs.write(.fd, b, b.len)
    nl []byte = with-len(1)
    nl[0] = 10
    written = fs.write(.fd, nl, 1)
    written = written + n
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; out: 寫入字串到標準輸出（不換行）
out = (s str) (n i64) {
    b = s.to-bytes()
    n = fs.write(STDOUT-FD, b, b.len)
}

; outln: 寫入字串到標準輸出並換行
outln = (s str) (n i64) {
    b = s.to-bytes()
    n = fs.write(STDOUT-FD, b, b.len)
    nl []byte = with-len(1)
    nl[0] = 10
    m = fs.write(STDOUT-FD, nl, 1)
    n = n + m
}

; err: 寫入字串到標準錯誤（不換行）
err = (s str) (n i64) {
    b = s.to-bytes()
    n = fs.write(STDERR-FD, b, b.len)
}

; errln: 寫入字串到標準錯誤並換行
errln = (s str) (n i64) {
    b = s.to-bytes()
    n = fs.write(STDERR-FD, b, b.len)
    nl []byte = with-len(1)
    nl[0] = 10
    m = fs.write(STDERR-FD, nl, 1)
    n = n + m
}

; read-line: 從標準輸入讀取一行
; 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
read-line = () (line ?str) {
    line = nil
    s = ''
    ok = false
    s, ok = fs.get-line()
    ok -> line = s
}
