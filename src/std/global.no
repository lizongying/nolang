; ═══════════════════════════════════════════════════════════
; global.no — 全局內置函數声明
;
; 本文件声明了無需模塊前綴即可調用的全局函數。
; 這些函數由編譯器內置實現（builtin），此處的注释声明
; 僅供文檔查看和 LSP go-to-definition 導航使用。
;
; 規则：全局只有以下 7 個函數可以不帶模塊名調用，
;       其餘所有跨模塊調用都必須加模塊前綴（如 fs.read、os.get-env）。
;       此外文件末尾的 `@ std/err.new err` 以**可呼叫别名**的形式再登記一個
;       裸名 `err`（详見該行上方的说明），它不是 buildin，走的是普通調用。
;       别名有兩種等價寫法：`@ <path>.<fn> <alias>` 與 `<alias> = <mod>.<fn>`。
; ═══════════════════════════════════════════════════════════

# std/err error

; ── 容量/長度構造 ──────────────────────────────────────────

; 建立指定容量的字串或切片（len=0），型别由賦值左侧推斷
;   s str = with-cap(256)       → 预分配 256 位元組的 str
;   v []i64 = with-cap(100)     → 预分配 100 個元素的切片
; cap i64: 要預分配的容量（str 為位元組數、vec 為元素個數），長度仍為 0
; [with-cap](#global.with-cap)
#{buildin}
with-cap = (cap i64) {
}

; 建立指定長度的字串或切片，型别由賦值左侧推斷
;   s str = with-len(10)        → 長度為 10 的 str
;   v []i64 = with-len(100)     → 長度為 100 的切片
; len i64: 目標長度（str 為位元組數、vec 為元素個數），len=cap 一次配置好、可免 push 直接下標
; [with-len](#global.with-len)
#{buildin}
with-len = (len i64) {
}

; 建立指定容量和長度的字串或切片，型别由賦值左侧推斷
;   v []i64 = with-cap-len(200, 100)  → 容量 200、長度 100 的切片
; cap i64: 預分配容量（可大於 len，為後續 push 留空間）
; len i64: 實際長度，可直接下標讀寫而不需先 push
; [with-cap-len](#global.with-cap-len)
#{buildin}
with-cap-len = (cap i64, len i64) {
}

; ── 方法形式（便捷調用）──────────────────────────────────────
; 以上三個全局函數也可作為 str 和 vec 的方法調用：
;   s str = ''.with-cap(256)         → 等同 with-cap(256)
;   s str = ''.with-len(10)          → 等同 with-len(10)
;   s str = ''.with-len-cap(10, 256) → 等同 with-cap-len(256, 10)
;   v []i64 = [].with-cap(100)       → 等同 with-cap(100)
;   v []i64 = [].with-len(100)       → 等同 with-len(100)
;   v []i64 = [].with-len-cap(100, 200) → 等同 with-cap-len(200, 100)
; str 的方法定義在 str.no，vec 的方法由編譯器內置實現（builtin）。

; ── 输出/格式化 ────────────────────────────────────────────
;
; 具名格式：{name[:spec]} 直接引用作用域中的變量，無需位置參數，支援編譯期驗證。
;
; ⚠️ 多參數時，字面量默認是模板，不是 C 風格的格式串：
;     print('result={val}', 42, 'result={val}')
;   → 每個字串字面量**各自**是一個模板：{val} 從**調用點作用域**取值，
;     與同一調用里的其它參數無關。字面量不會去描述/消費後面的參數
;     （不是 C 風格的 printf('%d', 42) 那種替換 —— 且 printf/eprintf 本身已移除，
;      調用即編譯錯誤 [printf-depr]，請一律改用 print/eprint/format）。
;   非字面量參數（變量、表達式）按普通可變參數處理：空格分隔，整行末尾一個換行。
;     tmpl = '{val}'
;     print(tmpl)                 → {val}（變量是純文字，不做替換）
;
; 格式说明符 spec 語法（各字段順序固定，均可省略）：
;   [[fill]align][sign][#][0][width][grouping][.precision][type]
;
;   fill     — 填充字符（默認空格），需與 align 一起使用
;   align    — < 左對齊 | > 右對齊 | = 符號後填充 | ^ 置中
;   sign     — + 正數顯示加號 | - 僅負數顯示（默認）| 空格 正數補空格
;   #        — 進制前綴（0x/0o/0b）
;   0        — 數值前補零至指定寬度
;   width    — 最小欄位寬度（數字）
;   grouping — , 逗號分隔 | _ 下划線分隔
;   .precision — 浮點數小數位數 / 字串截斷長度
;   type     — 見下表
;
;   type 可取值：
;     d  十進制整數
;     b  二進制
;     o  八進制
;     x  十六進制(小寫)
;     X  十六進制(大寫)
;     c  整數轉字符
;     f  定點浮點(小寫)
;     F  定點浮點(大寫)
;     e  科学記號(小寫)
;     E  科学記號(大寫)
;     g  通用浮點(小寫)
;     G  通用浮點(大寫)
;     s  字串(默認)
;     t  數據類型名(編譯期確定)
;     v  字面量值(字符串加單引號, vec 調用 to-str)
;     p  指針地址(十六進制, 帶 0x 前綴)
;
;   示例：
;     {x:06}        → 000042
;     {x:>10}       →        42（右對齊寬度 10）
;     {u:#x}        → 0xff
;     {pi:.2f}      → 3.14
;     {pi:8.3e}     → 3.142e+00
;     {s:<10}       → hello     （左對齊）
;     {s:.3}        → hel（截斷為 3 字符）
;     {x:t}         → i64（打印變量 x 的類型名）
;     {s:v}         → 'hello'（字符串用單引號包裹）
;   {{ 與 }} 用於输出字面 { 與 }，但僅當同一字串中至少還有一個真正的 {name} 欄位時
;   才生效；只含轉義、不含欄位的字面量會原樣输出（print('{{n}}') → {{n}}）。
;   要输出單獨的大括號，直接用 print('{') / print('}')。

; 输出字串到標準输出並換行，支援 {name:spec} 命名格式欄位
;   print('hello {name}')       → hello world（若 name = 'world'）
;   print('{x:.2f}')            → 3.14（若 x = 3.14159）
;   多參數：print(a, b, c) 以空格分隔，整行末尾只有一個換行。
;   多參數時每個字串字面量各自是模板（見上方「多參數時，字面量默認是模板」）：
;     print('result={val}', 42, 'result={val}')  → result=42 42 result=42
; s str: 格式模板字串；{name:spec} 會按同名字面量取值替換，後面可接任意多個具名實參依次填空
; [print](#global.print)
#{buildin}
print = (s str) {
}

; 输出字串到標準錯誤並換行，支援 {name:spec} 命名格式欄位
;   eprint('error: {msg}')
;   多參數：eprint('err:', a, b) 以空格分隔，整行末尾只有一個換行；
;           每個字串字面量各自是模板（同 print）
; s str: 格式模板字串（規則同 print）；後面可接任意多個具名實參依次填空
; [eprint](#global.eprint)
#{buildin}
eprint = (s str) {
}

; 使用 {name:spec} 命名欄位格式化字串並返回結果（取代 sprintf）
;   s = format('{x:.2f}')       → '3.14'
;   s = format('{name} is {age}')  → 'Alice is 30'
;   ⚠️ 只接受單一格式字串（没有多參數形式）
; s str: 格式模板字串（規則同 print），且只能傳這一個參數
; out str: 模板展開後的新字串（不输出到任何串流）
; [format](#global.format)
#{buildin}
format = (s str) (out str) {
}

; ── 行程控制 ────────────────────────────────────

; 結束行程（以状態碼 c 終止當前進程）
;   exit(0)   → 正常退出
;   exit(1)   → 異常退出
; c i64: 進程退出碼（0 表示成功，非 0 依慣例表示失敗；超出 0–255 的值由作業系統截斷）
; [exit](#global.exit)
#{buildin}
exit = (c i64) {
}

; ── 選項型別（option — 內建標籤列舉/union）──────────────────
;
; 以 #{buildin} 宣告為內建標籤列舉：變體供匹配/窮盡性檢查，底層表示與構造由
; 內建 runtime 提供（%option 型別 + ok(...)/nil/err(...) 構造器）。
; tag: 0=ok, 1=nil, 2=err
;
; 用法：
;   x ?t                       // 宣告 option<t>
;   x = 42                     // 設為有值
;   x = nil                    // 設為空
;   x = err('msg')             // 設為錯誤
;   x = err('msg', code.io)    // 設為錯誤並指定 code（TODO: 待 err.err 載荷落地）
;
;   match
;   x: {
;       nil -> log(it)
;       err -> log(it)
;       -> log(it)
;   }
#{buildin}
option {
    ok(v t),
    nil,
    err(e error.err),
}

; err: 建立結構化錯誤（別名 → std/err.new）
;
; `@ <path>.<fn> <alias>` 宣告一個全域可用的第二名稱：下面這一行讓
; `err('msg')` / `err('msg', err.code.io)` 就是 `err.new('msg')` 的呼叫，
; 而不是編譯器裡另寫的一條特殊規則。
;
; 與選項的 err 變體不衝突：在期望型別是 option 的位置（`x ?i64` 之後的
; `x = err('msg')`、`err ->` 匹配臂、回傳 ?T 的函式），`err(...)` 仍然是
; 選項的 err 變體構造器（tag 2），由 MIR 依期望型別分派；其餘位置才走這個
; 別名。std 模組內部呼叫自己的同名函式（io.no 的 stderr 寫入器 io.err）
; 也不受影響。
;
; 兩種寫法**都支援**，語義完全相同（編譯器把兩者正規化成同一個宣告）：
;
;   @ std/err.new err      ; 導出式語句（目前啟用）
;   err = err.new          ; 賦值式（目前註解，未來再評估用哪一種）
;
; 目前先用 `@` 形式：它把「目標模組路徑」寫全，一眼看得出 err 來自哪個模組，
; 也和 lib.no 的導出語法同形。賦值式較短，但 `err = err.new` 長得像一般變數
; 宣告，讀者可能誤以為 err 是個值。等實際使用一段時間後再定。
@ std/err.new err
; err = err.new
