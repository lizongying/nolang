; ═══════════════════════════════════════════════════════════
; global.no — 全局内置函数声明
;
; 本文件声明了无需模块前缀即可调用的全局函数。
; 这些函数由编译器内置实现（builtin），此处的注释声明
; 仅供文档查看和 LSP go-to-definition 导航使用。
;
; 规则：全局只有以下 7 个函数可以不带模块名调用，
;       其余所有跨模块调用都必须加模块前缀（如 fs.read、os.get-env）。
;       此外文件末尾的 `@ std/err.new err` 以**可呼叫别名**的形式再登记一个
;       裸名 `err`（详见该行上方的说明），它不是 buildin，走的是普通调用。
;       别名有两种等价写法：`@ <path>.<fn> <alias>` 与 `<alias> = <mod>.<fn>`。
; ═══════════════════════════════════════════════════════════

# std/err error

; ── 容量/长度构造 ──────────────────────────────────────────

; with-cap: 建立指定容量的字串或切片（len=0），型别由赋值左侧推断
;   s str = with-cap(256)       → 预分配 256 位元组的 str
;   v []i64 = with-cap(100)     → 预分配 100 个元素的切片
#{buildin}
with-cap = (cap i64) {
}

; with-len: 建立指定长度的字串或切片，型别由赋值左侧推断
;   s str = with-len(10)        → 长度为 10 的 str
;   v []i64 = with-len(100)     → 长度为 100 的切片
#{buildin}
with-len = (len i64) {
}

; with-cap-len: 建立指定容量和长度的字串或切片，型别由赋值左侧推断
;   v []i64 = with-cap-len(200, 100)  → 容量 200、长度 100 的切片
#{buildin}
with-cap-len = (cap i64, len i64) {
}

; ── 方法形式（便捷调用）──────────────────────────────────────
; 以上三个全局函数也可作为 str 和 vec 的方法调用：
;   s str = ''.with-cap(256)         → 等同 with-cap(256)
;   s str = ''.with-len(10)          → 等同 with-len(10)
;   s str = ''.with-len-cap(10, 256) → 等同 with-cap-len(256, 10)
;   v []i64 = [].with-cap(100)       → 等同 with-cap(100)
;   v []i64 = [].with-len(100)       → 等同 with-len(100)
;   v []i64 = [].with-len-cap(100, 200) → 等同 with-cap-len(200, 100)
; str 的方法定义在 str.no，vec 的方法由编译器内置实现（builtin）。

; ── 输出/格式化 ────────────────────────────────────────────
;
; 具名格式：{name[:spec]} 直接引用作用域中的变量，无需位置参数，支援编译期验证。
;
; ⚠️ 多参数时，字面量默认是模板，不是 C 风格的格式串：
;     print('result={val}', 42, 'result={val}')
;   → 每个字串字面量**各自**是一个模板：{val} 从**调用点作用域**取值，
;     与同一调用里的其它参数无关。字面量不会去描述/消费后面的参数
;     （不是 C 风格的 printf('%d', 42) 那种替换 —— 且 printf/eprintf 本身已移除，
;      调用即编译错误 [printf-depr]，请一律改用 print/eprint/format）。
;   非字面量参数（变量、表达式）按普通可变参数处理：空格分隔，整行末尾一个换行。
;     tmpl = '{val}'
;     print(tmpl)                 → {val}（变量是纯文字，不做替换）
;
; 格式说明符 spec 语法（各字段顺序固定，均可省略）：
;   [[fill]align][sign][#][0][width][grouping][.precision][type]
;
;   fill     — 填充字符（默认空格），需与 align 一起使用
;   align    — < 左对齐 | > 右对齐 | = 符号后填充 | ^ 置中
;   sign     — + 正数显示加号 | - 仅负数显示（默认）| 空格 正数补空格
;   #        — 进制前缀（0x/0o/0b）
;   0        — 数值前补零至指定宽度
;   width    — 最小栏位宽度（数字）
;   grouping — , 逗号分隔 | _ 下划线分隔
;   .precision — 浮点数小数位数 / 字串截断长度
;   type     — 见下表
;
;   type 可取值：
;     d  十进制整数
;     b  二进制
;     o  八进制
;     x  十六进制(小写)
;     X  十六进制(大写)
;     c  整数转字符
;     f  定点浮点(小写)
;     F  定点浮点(大写)
;     e  科学记号(小写)
;     E  科学记号(大写)
;     g  通用浮点(小写)
;     G  通用浮点(大写)
;     s  字串(默认)
;     t  数据类型名(编译期确定)
;     v  字面量值(字符串加单引号, vec 调用 to-str)
;     p  指针地址(十六进制, 带 0x 前缀)
;
;   示例：
;     {x:06}        → 000042
;     {x:>10}       →        42（右对齐宽度 10）
;     {u:#x}        → 0xff
;     {pi:.2f}      → 3.14
;     {pi:8.3e}     → 3.142e+00
;     {s:<10}       → hello     （左对齐）
;     {s:.3}        → hel（截断为 3 字符）
;     {x:t}         → i64（打印变量 x 的类型名）
;     {s:v}         → 'hello'（字符串用单引号包裹）
;   {{ 与 }} 用于输出字面 { 与 }，但仅当同一字串中至少还有一个真正的 {name} 栏位时
;   才生效；只含转义、不含栏位的字面量会原样输出（print('{{n}}') → {{n}}）。
;   要输出单独的大括号，直接用 print('{') / print('}')。

; print: 输出字串到标准输出并换行，支援 {name:spec} 命名格式栏位
;   print('hello {name}')       → hello world（若 name = 'world'）
;   print('{x:.2f}')            → 3.14（若 x = 3.14159）
;   多参数：print(a, b, c) 以空格分隔，整行末尾只有一个换行。
;   多参数时每个字串字面量各自是模板（见上方「多参数时，字面量默认是模板」）：
;     print('result={val}', 42, 'result={val}')  → result=42 42 result=42
#{buildin}
print = (s str) {
}

; eprint: 输出字串到标准错误并换行，支援 {name:spec} 命名格式栏位
;   eprint('error: {msg}')
;   多参数：eprint('err:', a, b) 以空格分隔，整行末尾只有一个换行；
;           每个字串字面量各自是模板（同 print）
#{buildin}
eprint = (s str) {
}

; format: 使用 {name:spec} 命名栏位格式化字串并返回结果（取代 sprintf）
;   s = format('{x:.2f}')       → '3.14'
;   s = format('{name} is {age}')  → 'Alice is 30'
;   ⚠️ 只接受单一格式字串（没有多参数形式）
#{buildin}
format = (s str) (out str) {
}

; ── 行程控制 ────────────────────────────────────

; exit: 結束行程（以状态码 c 终止当前进程）
;   exit(0)   → 正常退出
;   exit(1)   → 异常退出
#{buildin}
exit = (c i64) {
}

; ── 選項型別（option — 內建標籤列舉/union）──────────────────
;
; 以 #{buildin} 宣告為內建標籤列舉：變體供匹配/窮盡性檢查，底層表示與構造由
; 內建 runtime 提供（%option 型別 + ok(...)/nil/err(...) 構造器）。
; tag: 0=ok, 1=nil, 2=err
;
; 用法：
;   x ?t                       // 宣告 option<t>
;   x = 42                     // 設為有值
;   x = nil                    // 設為空
;   x = err('msg')             // 設為錯誤
;   x = err('msg', code.io)    // 設為錯誤並指定 code（TODO: 待 err.err 載荷落地）
;
;   match
;   x: {
;       nil -> log(it)
;       err -> log(it)
;       -> log(it)
;   }
#{buildin}
option {
    ok(v t),
    nil,
    err(e error.err),
}

; err: 建立結構化錯誤（別名 → std/err.new）
;
; `@ <path>.<fn> <alias>` 宣告一個全域可用的第二名稱：下面這一行讓
; `err('msg')` / `err('msg', err.code.io)` 就是 `err.new('msg')` 的呼叫，
; 而不是編譯器裡另寫的一條特殊規則。
;
; 與選項的 err 變體不衝突：在期望型別是 option 的位置（`x ?i64` 之後的
; `x = err('msg')`、`err ->` 匹配臂、回傳 ?T 的函式），`err(...)` 仍然是
; 選項的 err 變體構造器（tag 2），由 MIR 依期望型別分派；其餘位置才走這個
; 別名。std 模組內部呼叫自己的同名函式（io.no 的 stderr 寫入器 io.err）
; 也不受影響。
;
; 兩種寫法**都支援**，語義完全相同（編譯器把兩者正規化成同一個宣告）：
;
;   @ std/err.new err      ; 導出式語句（目前啟用）
;   err = err.new          ; 賦值式（目前註解，未來再評估用哪一種）
;
; 目前先用 `@` 形式：它把「目標模組路徑」寫全，一眼看得出 err 來自哪個模組，
; 也和 lib.no 的導出語法同形。賦值式較短，但 `err = err.new` 長得像一般變數
; 宣告，讀者可能誤以為 err 是個值。等實際使用一段時間後再定。
@ std/err.new err
; err = err.new
