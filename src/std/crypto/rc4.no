; rc4 — RC4 串流加密器
;
; RC4 是一個簡單的串流加密器，使用 256-byte 狀態陣列。
; 加密和解密使用相同的操作（XOR）。
;
; 注意：RC4 已被認為不安全，僅供遺留系統相容使用。
;
; 用法：
;   # std/crypto/rc4
;   key []byte = 'secret key'
;   cipher = rc4(plain, key)   // 加密
;   plain = rc4(cipher, key)   // 解密（相同操作）
; [rc4](#rc4)

; RC4 加密/解密
; 同一函式既加密也解密：out = in XOR 金鑰流，對 out 再跑一次即還原 in。
; in []byte: 輸入資料（明文或密文，長度不變）
; key []byte: 金鑰（1–256 位元組）；為空時內部索引會越界，呼叫方需自行保證非空
; 返回 out []byte: 與 in 等長的金鑰流異或結果
; [rc4](#rc4.rc4)
rc4 = (in []byte, key []byte) (out []byte) {

    ; KSA: 金鑰排程
    s [256]byte
    i <- [0..256): {
        s[i]: {
            ok -> it = i

            -> _
        }
    }
    key-len = key.len()
    j = 0
    i <- [0..256): {
        ixout36c19 = s[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        ixout36c28 = key[i % key-len]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        j = (j + (ixout36c19) + (ixout36c28)) % 256

        ; Swap s[i] and s[j]
        ixout52ce = s[i]: {
            ok -> it

            -> _
        }

        t = ixout52ce

        ixout43c24 = s[j]: {
            ok -> it

            -> _
        }

        s[i]: {
            ok -> it = ixout43c24

            -> _
        }

        s[j]: {
            ok -> it = t

            -> _
        }
    }

    ; PRGA: 偽隨機生成
    out = with-len(in.len())
    i = 0
    j = 0
    pos <- [0..in.len()): {

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt = (i + 1) % 256
            i-opt: {
                ok -> i = it

                ->
            }
        }

        ixout65c19 = s[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        j = (j + (ixout65c19)) % 256

        ; Swap s[i] and s[j]
        t = s[i]: {
            ok -> it

            -> _
        }

        ixout76c24 = s[j]: {
            ok -> it

            -> _
        }

        s[i]: {
            ok -> it = ixout76c24

            -> _
        }

        s[j]: {
            ok -> it = t

            -> _
        }

        ; 生成密鑰流位元組
        ; s[i] 與 s[j] 都是 byte：`s[i] + s[j]` 的結果型別取左運算元（byte），
        ; 直接寫 `(s[i] + s[j]) % 256` 會讓常數 256 被窄化成 byte 0，觸發執行期
        ; 除零並把索引強制成 0（金鑰流全錯）。
        ; → 先把兩個位元組各自綁進 i64 綁定（宣告型別決定存儲與算術域），
        ;   `si + sj` 才在 64 位域相加。
        si i64 = s[i]: {
            ok -> it

            -> 0
        }

        sj i64 = s[j]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        k = s[(si + sj) % 256]

        ixout107c21 = in[pos]: {
            ok -> it

            -> _
        }

        out[pos] = (ixout107c21) ^ (k & 255)
    }
}
