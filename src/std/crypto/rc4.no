; rc4 — RC4 串流加密器
;
; RC4 是一個簡單的串流加密器，使用 256-byte 狀態陣列。
; 加密和解密使用相同的操作（XOR）。
;
; 注意：RC4 已被認為不安全，僅供遺留系統相容使用。
;
; 用法：
;   # std/crypto/rc4
;   key []byte = 'secret key'
;   cipher = rc4(plain, key)   // 加密
;   plain = rc4(cipher, key)   // 解密（相同操作）

; rc4: RC4 加密/解密
; in []byte: 輸入資料
; key []byte: 金鑰（1-256 位元組）
; 返回 out []byte: 輸出資料
rc4 = (in []byte, key []byte) (out []byte) {

    ; KSA: 金鑰排程
    s [256]byte
    i <- [0..256): {
        #{index-out = 0}
        s[i] = i
    }
    key-len = key.len()
    j = 0
    i <- [0..256): {
        #{overflow=wrap}
        #{index-out = 0}
        j = (j + (s[i]) + (key[i % key-len])) % 256

        #{index-out = 0}
        ; Swap s[i] and s[j]
        #{index-out = 0}
        t = s[i]
        #{index-out = 0}
        s[i] = s[j]
        #{index-out = 0}
        s[j] = t
    }

    ; PRGA: 偽隨機生成
    out = with-len(in.len())
    i = 0
    j = 0
    pos <- [0..in.len()): {
        #{overflow=wrap}
        i = (i + 1) % 256
        #{overflow=wrap}
        #{index-out = 0}
        j = (j + (s[i])) % 256

        #{index-out = 0}
        ; Swap s[i] and s[j]
        #{index-out = 0}
        t = s[i]
        #{index-out = 0}
        s[i] = s[j]
        #{index-out = 0}
        s[j] = t

        ; 生成密鑰流位元組
        #{overflow=wrap}
        #{index-out = 0}
        k = s[((s[i]) + (s[j])) % 256]
        #{index-out = 0}
        out[pos] = (in[pos]) ^ (k & 255)
    }
}
