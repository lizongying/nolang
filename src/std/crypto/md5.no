        #{overflow=wrap}
        c = (d + md5-rotl(t, 16)) & 4294967295
        f = c ^ d ^ a

        #{overflow=wrap}
        t = (b + f + w6 + 76029189) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 23)) & 4294967295
        f = b ^ c ^ d

        #{overflow=wrap}
        t = (a + f + w9 + 3654602809) & 4294967295

        #{overflow=wrap}
