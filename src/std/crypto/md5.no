        #{overflow=wrap}
        b = (c + md5-rotl(t, 21)) & 4294967295

        ; 累加回初始值（u32 自然溢出）
        #{overflow=wrap}
        h0 = (h0 + a) & 4294967295

        #{overflow=wrap}
        h1 = (h1 + b) & 4294967295

        #{overflow=wrap}
        h2 = (h2 + c) & 4294967295

        #{overflow=wrap}
        h3 = (h3 + d) & 4294967295
    }

    ; 輸出 16 位元組（小端序 32-bit 字，使用 store-le-u32 單條 store 指令）
    out.store-le-u32(0, h0)
    out.store-le-u32(4, h1)
    out.store-le-u32(8, h2)
    out.store-le-u32(12, h3)
}
