; md5 — MD5 訊息摘要算法（128-bit）
;
; 計算位元組陣列的 MD5 哈希值。
;
; 用法：
;   data = [0x61, 0x62, 0x63]  // ["a", "b", c"]
;   hash = md5(data)
;   // hash == [0x90, 0x01, 0x50, 0x98, ...]

; md5: 計算 MD5 哈希
; in: 輸入位元組陣列
; out: 輸出 16 位元組哈希值
md5 = (data []byte) (out [16]byte) {
    ; MD5 初始值（u32 自然 32-bit 溢出）
    h0 u32 = 1732584193
    h1 u32 = 4023233417
    h2 u32 = 2562383102
    h3 u32 = 271733878

    dlen = data.len
    blen = dlen * 8

    ; 全塊數量（這些區塊直接從 data 載入，無需拷貝，無邊界檢查）
    num-full = dlen / 64

    ; 壓縮函數工作變數（提升到迴圈外宣告一次，迴圈內外均為重新賦值，
    ; 避免「迴圈內宣告 + 迴圈後使用」的 undef 問題與重複宣告錯誤）
    a u32 = 0
    b u32 = 0
    c u32 = 0
    d u32 = 0
    f u32 = 0
    t u32 = 0

    ; 處理全塊：直接從 data 載入 16 個 32-bit 字（load-le-u32 使用指標運算，無邊界檢查）
    bidx <- [0..num-full): {
        off = bidx * 64
        w0 = data.load-le-u32(off)
        w1 = data.load-le-u32(off + 4)
        w2 = data.load-le-u32(off + 8)
        w3 = data.load-le-u32(off + 12)
        w4 = data.load-le-u32(off + 16)
        w5 = data.load-le-u32(off + 20)
        w6 = data.load-le-u32(off + 24)
        w7 = data.load-le-u32(off + 28)
        w8 = data.load-le-u32(off + 32)
        w9 = data.load-le-u32(off + 36)
        w10 = data.load-le-u32(off + 40)
        w11 = data.load-le-u32(off + 44)
        w12 = data.load-le-u32(off + 48)
        w13 = data.load-le-u32(off + 52)
        w14 = data.load-le-u32(off + 56)
        w15 = data.load-le-u32(off + 60)
        ; MD5 壓縮函數（64 輪）— u32 算術自然 32-bit 溢出
        a = h0
        b = h1
        c = h2
        d = h3
        ; 第 1 輪 (F): f = d ^ (b & (c ^ d))
        f = d ^ (b & (c ^ d))
        t = a + f + w0 + 3614090360
        a = b + number.rotate-left(t, 7)
        f = c ^ (a & (b ^ c))
        t = d + f + w1 + 3905402710
        d = a + number.rotate-left(t, 12)
        f = b ^ (d & (a ^ b))
        t = c + f + w2 + 606105819
        c = d + number.rotate-left(t, 17)
        f = a ^ (c & (d ^ a))
        t = b + f + w3 + 3250441966
        b = c + number.rotate-left(t, 22)
        f = d ^ (b & (c ^ d))
        t = a + f + w4 + 4118548399
        a = b + number.rotate-left(t, 7)
        f = c ^ (a & (b ^ c))
        t = d + f + w5 + 1200080426
        d = a + number.rotate-left(t, 12)
        f = b ^ (d & (a ^ b))
        t = c + f + w6 + 2821735955
        c = d + number.rotate-left(t, 17)
        f = a ^ (c & (d ^ a))
        t = b + f + w7 + 4249261313
        b = c + number.rotate-left(t, 22)
        f = d ^ (b & (c ^ d))
        t = a + f + w8 + 1770035416
        a = b + number.rotate-left(t, 7)
        f = c ^ (a & (b ^ c))
        t = d + f + w9 + 2336552879
        d = a + number.rotate-left(t, 12)
        f = b ^ (d & (a ^ b))
        t = c + f + w10 + 4294925233
        c = d + number.rotate-left(t, 17)
        f = a ^ (c & (d ^ a))
        t = b + f + w11 + 2304563134
        b = c + number.rotate-left(t, 22)
        f = d ^ (b & (c ^ d))
        t = a + f + w12 + 1804603682
        a = b + number.rotate-left(t, 7)
        f = c ^ (a & (b ^ c))
        t = d + f + w13 + 4254626195
        d = a + number.rotate-left(t, 12)
        f = b ^ (d & (a ^ b))
        t = c + f + w14 + 2792965006
        c = d + number.rotate-left(t, 17)
        f = a ^ (c & (d ^ a))
        t = b + f + w15 + 1236535329
        b = c + number.rotate-left(t, 22)
        ; 第 2 輪 (G): f = c ^ (d & (b ^ c))
        f = c ^ (d & (b ^ c))
        t = a + f + w1 + 4129170786
        a = b + number.rotate-left(t, 5)
        f = b ^ (c & (a ^ b))
        t = d + f + w6 + 3225465664
        d = a + number.rotate-left(t, 9)
        f = a ^ (b & (d ^ a))
        t = c + f + w11 + 643717713
        c = d + number.rotate-left(t, 14)
        f = d ^ (a & (c ^ d))
        t = b + f + w0 + 3921069994
        b = c + number.rotate-left(t, 20)
        f = c ^ (d & (b ^ c))
        t = a + f + w5 + 3593408605
        a = b + number.rotate-left(t, 5)
        f = b ^ (c & (a ^ b))
        t = d + f + w10 + 38016083
        d = a + number.rotate-left(t, 9)
        f = a ^ (b & (d ^ a))
        t = c + f + w15 + 3634488961
        c = d + number.rotate-left(t, 14)
        f = d ^ (a & (c ^ d))
        t = b + f + w4 + 3889429448
        b = c + number.rotate-left(t, 20)
        f = c ^ (d & (b ^ c))
        t = a + f + w9 + 568446438
        a = b + number.rotate-left(t, 5)
        f = b ^ (c & (a ^ b))
        t = d + f + w14 + 3275163606
        d = a + number.rotate-left(t, 9)
        f = a ^ (b & (d ^ a))
        t = c + f + w3 + 4107603335
        c = d + number.rotate-left(t, 14)
        f = d ^ (a & (c ^ d))
        t = b + f + w8 + 1163531501
        b = c + number.rotate-left(t, 20)
        f = c ^ (d & (b ^ c))
        t = a + f + w13 + 2850285829
        a = b + number.rotate-left(t, 5)
        f = b ^ (c & (a ^ b))
        t = d + f + w2 + 4243563512
        d = a + number.rotate-left(t, 9)
        f = a ^ (b & (d ^ a))
        t = c + f + w7 + 1735328473
        c = d + number.rotate-left(t, 14)
        f = d ^ (a & (c ^ d))
        t = b + f + w12 + 2368359562
        b = c + number.rotate-left(t, 20)
        ; 第 3 輪 (H): f = x ^ y ^ z
        f = b ^ c ^ d
        t = a + f + w5 + 4294588738
        a = b + number.rotate-left(t, 4)
        f = a ^ b ^ c
        t = d + f + w8 + 2272392833
        d = a + number.rotate-left(t, 11)
        f = d ^ a ^ b
        t = c + f + w11 + 1839030562
        c = d + number.rotate-left(t, 16)
        f = c ^ d ^ a
        t = b + f + w14 + 4259657740
        b = c + number.rotate-left(t, 23)
        f = b ^ c ^ d
        t = a + f + w1 + 2763975236
        a = b + number.rotate-left(t, 4)
        f = a ^ b ^ c
        t = d + f + w4 + 1272893353
        d = a + number.rotate-left(t, 11)
        f = d ^ a ^ b
        t = c + f + w7 + 4139469664
        c = d + number.rotate-left(t, 16)
        f = c ^ d ^ a
        t = b + f + w10 + 3200236656
        b = c + number.rotate-left(t, 23)
        f = b ^ c ^ d
        t = a + f + w13 + 681279174
        a = b + number.rotate-left(t, 4)
        f = a ^ b ^ c
        t = d + f + w0 + 3936430074
        d = a + number.rotate-left(t, 11)
        f = d ^ a ^ b
        t = c + f + w3 + 3572445317
        c = d + number.rotate-left(t, 16)
        f = c ^ d ^ a
        t = b + f + w6 + 76029189
        b = c + number.rotate-left(t, 23)
        f = b ^ c ^ d
        t = a + f + w9 + 3654602809
        a = b + number.rotate-left(t, 4)
        f = a ^ b ^ c
        t = d + f + w12 + 3873151461
        d = a + number.rotate-left(t, 11)
        f = d ^ a ^ b
        t = c + f + w15 + 530742520
        c = d + number.rotate-left(t, 16)
        f = c ^ d ^ a
        t = b + f + w2 + 3299628645
        b = c + number.rotate-left(t, 23)
        ; 第 4 輪 (I): f = y ^ (x | ~z)  — ~d 即按位取反
        f = c ^ (b | ~d)
        t = a + f + w0 + 4096336452
        a = b + number.rotate-left(t, 6)
        f = b ^ (a | ~c)
        t = d + f + w7 + 1126891415
        d = a + number.rotate-left(t, 10)
        f = a ^ (d | ~b)
        t = c + f + w14 + 2878612391
        c = d + number.rotate-left(t, 15)
        f = d ^ (c | ~a)
        t = b + f + w5 + 4237533241
        b = c + number.rotate-left(t, 21)
        f = c ^ (b | ~d)
        t = a + f + w12 + 1700485571
        a = b + number.rotate-left(t, 6)
        f = b ^ (a | ~c)
        t = d + f + w3 + 2399980690
        d = a + number.rotate-left(t, 10)
        f = a ^ (d | ~b)
        t = c + f + w10 + 4293915773
        c = d + number.rotate-left(t, 15)
        f = d ^ (c | ~a)
        t = b + f + w1 + 2240044497
        b = c + number.rotate-left(t, 21)
        f = c ^ (b | ~d)
        t = a + f + w8 + 1873313359
        a = b + number.rotate-left(t, 6)
        f = b ^ (a | ~c)
        t = d + f + w15 + 4264355552
        d = a + number.rotate-left(t, 10)
        f = a ^ (d | ~b)
        t = c + f + w6 + 2734768916
        c = d + number.rotate-left(t, 15)
        f = d ^ (c | ~a)
        t = b + f + w13 + 1309151649
        b = c + number.rotate-left(t, 21)
        f = c ^ (b | ~d)
        t = a + f + w4 + 4149444226
        a = b + number.rotate-left(t, 6)
        f = b ^ (a | ~c)
        t = d + f + w11 + 3174756917
        d = a + number.rotate-left(t, 10)
        f = a ^ (d | ~b)
        t = c + f + w2 + 718787259
        c = d + number.rotate-left(t, 15)
        f = d ^ (c | ~a)
        t = b + f + w9 + 3951481745
        b = c + number.rotate-left(t, 21)
        ; 累加回初始值（u32 自然溢出）
        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
    }

    ; 處理末塊（含填充）
    buf [64]byte
    off = num-full * 64
    dremain = dlen - off

    ; 以 4 位元組為單位拷貝資料（load-le-u32/store-le-u32 使用指標運算，無邊界檢查）
    num-copy-words = dremain / 4
    j <- [0..num-copy-words): {
        buf.store-le-u32(j * 4, data.load-le-u32(off + j * 4))
    }

    ; 處理剩餘 0-3 位元組
    copy-rem = dremain % 4
    copy-rem > 0 -> {
        base = num-copy-words * 4
        k <- [0..copy-rem): buf[base + k] = data[off + base + k]
    }

    ; 添加 0x80 填充和長度
    buf[dremain] = 128

    ; 僅清零 dremain+1 ~ 55 這一段，是MD5規範要求補0的區間
    dremain < 55 -> {
        pad-idx <- (dremain..56): buf[pad-idx] = 0
    }
    buf.store-le-u32(56, blen & 4294967295)
    buf.store-le-u32(60, blen >> 32)

    ; 從緩衝區載入 16 個 32-bit 字
    w0 = buf.load-le-u32(0)
    w1 = buf.load-le-u32(4)
    w2 = buf.load-le-u32(8)
    w3 = buf.load-le-u32(12)
    w4 = buf.load-le-u32(16)
    w5 = buf.load-le-u32(20)
    w6 = buf.load-le-u32(24)
    w7 = buf.load-le-u32(28)
    w8 = buf.load-le-u32(32)
    w9 = buf.load-le-u32(36)
    w10 = buf.load-le-u32(40)
    w11 = buf.load-le-u32(44)
    w12 = buf.load-le-u32(48)
    w13 = buf.load-le-u32(52)
    w14 = buf.load-le-u32(56)
    w15 = buf.load-le-u32(60)

    ; MD5 壓縮函數（64 輪）
    a = h0
    b = h1
    c = h2
    d = h3

    ; 第 1 輪 (F): f = d ^ (b & (c ^ d))
    f = d ^ (b & (c ^ d))
    t = a + f + w0 + 3614090360
    a = b + number.rotate-left(t, 7)
    f = c ^ (a & (b ^ c))
    t = d + f + w1 + 3905402710
    d = a + number.rotate-left(t, 12)
    f = b ^ (d & (a ^ b))
    t = c + f + w2 + 606105819
    c = d + number.rotate-left(t, 17)
    f = a ^ (c & (d ^ a))
    t = b + f + w3 + 3250441966
    b = c + number.rotate-left(t, 22)
    f = d ^ (b & (c ^ d))
    t = a + f + w4 + 4118548399
    a = b + number.rotate-left(t, 7)
    f = c ^ (a & (b ^ c))
    t = d + f + w5 + 1200080426
    d = a + number.rotate-left(t, 12)
    f = b ^ (d & (a ^ b))
    t = c + f + w6 + 2821735955
    c = d + number.rotate-left(t, 17)
    f = a ^ (c & (d ^ a))
    t = b + f + w7 + 4249261313
    b = c + number.rotate-left(t, 22)
    f = d ^ (b & (c ^ d))
    t = a + f + w8 + 1770035416
    a = b + number.rotate-left(t, 7)
    f = c ^ (a & (b ^ c))
    t = d + f + w9 + 2336552879
    d = a + number.rotate-left(t, 12)
    f = b ^ (d & (a ^ b))
    t = c + f + w10 + 4294925233
    c = d + number.rotate-left(t, 17)
    f = a ^ (c & (d ^ a))
    t = b + f + w11 + 2304563134
    b = c + number.rotate-left(t, 22)
    f = d ^ (b & (c ^ d))
    t = a + f + w12 + 1804603682
    a = b + number.rotate-left(t, 7)
    f = c ^ (a & (b ^ c))
    t = d + f + w13 + 4254626195
    d = a + number.rotate-left(t, 12)
    f = b ^ (d & (a ^ b))
    t = c + f + w14 + 2792965006
    c = d + number.rotate-left(t, 17)
    f = a ^ (c & (d ^ a))
    t = b + f + w15 + 1236535329
    b = c + number.rotate-left(t, 22)

    ; 第 2 輪 (G): f = c ^ (d & (b ^ c))
    f = c ^ (d & (b ^ c))
    t = a + f + w1 + 4129170786
    a = b + number.rotate-left(t, 5)
    f = b ^ (c & (a ^ b))
    t = d + f + w6 + 3225465664
    d = a + number.rotate-left(t, 9)
    f = a ^ (b & (d ^ a))
    t = c + f + w11 + 643717713
    c = d + number.rotate-left(t, 14)
    f = d ^ (a & (c ^ d))
    t = b + f + w0 + 3921069994
    b = c + number.rotate-left(t, 20)
    f = c ^ (d & (b ^ c))
    t = a + f + w5 + 3593408605
    a = b + number.rotate-left(t, 5)
    f = b ^ (c & (a ^ b))
    t = d + f + w10 + 38016083
    d = a + number.rotate-left(t, 9)
    f = a ^ (b & (d ^ a))
    t = c + f + w15 + 3634488961
    c = d + number.rotate-left(t, 14)
    f = d ^ (a & (c ^ d))
    t = b + f + w4 + 3889429448
    b = c + number.rotate-left(t, 20)
    f = c ^ (d & (b ^ c))
    t = a + f + w9 + 568446438
    a = b + number.rotate-left(t, 5)
    f = b ^ (c & (a ^ b))
    t = d + f + w14 + 3275163606
    d = a + number.rotate-left(t, 9)
    f = a ^ (b & (d ^ a))
    t = c + f + w3 + 4107603335
    c = d + number.rotate-left(t, 14)
    f = d ^ (a & (c ^ d))
    t = b + f + w8 + 1163531501
    b = c + number.rotate-left(t, 20)
    f = c ^ (d & (b ^ c))
    t = a + f + w13 + 2850285829
    a = b + number.rotate-left(t, 5)
    f = b ^ (c & (a ^ b))
    t = d + f + w2 + 4243563512
    d = a + number.rotate-left(t, 9)
    f = a ^ (b & (d ^ a))
    t = c + f + w7 + 1735328473
    c = d + number.rotate-left(t, 14)
    f = d ^ (a & (c ^ d))
    t = b + f + w12 + 2368359562
    b = c + number.rotate-left(t, 20)

    ; 第 3 輪 (H): f = x ^ y ^ z
    f = b ^ c ^ d
    t = a + f + w5 + 4294588738
    a = b + number.rotate-left(t, 4)
    f = a ^ b ^ c
    t = d + f + w8 + 2272392833
    d = a + number.rotate-left(t, 11)
    f = d ^ a ^ b
    t = c + f + w11 + 1839030562
    c = d + number.rotate-left(t, 16)
    f = c ^ d ^ a
    t = b + f + w14 + 4259657740
    b = c + number.rotate-left(t, 23)
    f = b ^ c ^ d
    t = a + f + w1 + 2763975236
    a = b + number.rotate-left(t, 4)
    f = a ^ b ^ c
    t = d + f + w4 + 1272893353
    d = a + number.rotate-left(t, 11)
    f = d ^ a ^ b
    t = c + f + w7 + 4139469664
    c = d + number.rotate-left(t, 16)
    f = c ^ d ^ a
    t = b + f + w10 + 3200236656
    b = c + number.rotate-left(t, 23)
    f = b ^ c ^ d
    t = a + f + w13 + 681279174
    a = b + number.rotate-left(t, 4)
    f = a ^ b ^ c
    t = d + f + w0 + 3936430074
    d = a + number.rotate-left(t, 11)
    f = d ^ a ^ b
    t = c + f + w3 + 3572445317
    c = d + number.rotate-left(t, 16)
    f = c ^ d ^ a
    t = b + f + w6 + 76029189
    b = c + number.rotate-left(t, 23)
    f = b ^ c ^ d
    t = a + f + w9 + 3654602809
    a = b + number.rotate-left(t, 4)
    f = a ^ b ^ c
    t = d + f + w12 + 3873151461
    d = a + number.rotate-left(t, 11)
    f = d ^ a ^ b
    t = c + f + w15 + 530742520
    c = d + number.rotate-left(t, 16)
    f = c ^ d ^ a
    t = b + f + w2 + 3299628645
    b = c + number.rotate-left(t, 23)

    ; 第 4 輪 (I): f = y ^ (x | ~z)  — ~d 即按位取反
    f = c ^ (b | ~d)
    t = a + f + w0 + 4096336452
    a = b + number.rotate-left(t, 6)
    f = b ^ (a | ~c)
    t = d + f + w7 + 1126891415
    d = a + number.rotate-left(t, 10)
    f = a ^ (d | ~b)
    t = c + f + w14 + 2878612391
    c = d + number.rotate-left(t, 15)
    f = d ^ (c | ~a)
    t = b + f + w5 + 4237533241
    b = c + number.rotate-left(t, 21)
    f = c ^ (b | ~d)
    t = a + f + w12 + 1700485571
    a = b + number.rotate-left(t, 6)
    f = b ^ (a | ~c)
    t = d + f + w3 + 2399980690
    d = a + number.rotate-left(t, 10)
    f = a ^ (d | ~b)
    t = c + f + w10 + 4293915773
    c = d + number.rotate-left(t, 15)
    f = d ^ (c | ~a)
    t = b + f + w1 + 2240044497
    b = c + number.rotate-left(t, 21)
    f = c ^ (b | ~d)
    t = a + f + w8 + 1873313359
    a = b + number.rotate-left(t, 6)
    f = b ^ (a | ~c)
    t = d + f + w15 + 4264355552
    d = a + number.rotate-left(t, 10)
    f = a ^ (d | ~b)
    t = c + f + w6 + 2734768916
    c = d + number.rotate-left(t, 15)
    f = d ^ (c | ~a)
    t = b + f + w13 + 1309151649
    b = c + number.rotate-left(t, 21)
    f = c ^ (b | ~d)
    t = a + f + w4 + 4149444226
    a = b + number.rotate-left(t, 6)
    f = b ^ (a | ~c)
    t = d + f + w11 + 3174756917
    d = a + number.rotate-left(t, 10)
    f = a ^ (d | ~b)
    t = c + f + w2 + 718787259
    c = d + number.rotate-left(t, 15)
    f = d ^ (c | ~a)
    t = b + f + w9 + 3951481745
    b = c + number.rotate-left(t, 21)

    ; 累加回初始值（u32 自然溢出）
    h0 = h0 + a
    h1 = h1 + b
    h2 = h2 + c
    h3 = h3 + d

    ; 輸出 16 位元組（小端序 32-bit 字，使用 store-le-u32 單條 store 指令）
    out.store-le-u32(0, h0)
    out.store-le-u32(4, h1)
    out.store-le-u32(8, h2)
    out.store-le-u32(12, h3)
}
