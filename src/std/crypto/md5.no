; md5 — MD5 訊息摘要算法（128-bit）
;
; 計算位元組陣列的 MD5 哈希值。
;
; 用法：
;   data = [0x61, 0x62, 0x63]  // ["a", "b", c"]
;   hash = md5(data)
;   // hash == [0x90, 0x01, 0x50, 0x98, ...]

; md5-rotl: 32-bit 左旋。math.rotate-left 為 64-bit 寬度，不適用於 MD5 的 u32 輪函數，
; 故以移位＋遮罩 (0xFFFFFFFF) 手動實作真正的 32-bit 旋轉。
md5-rotl = (x u32, n i64) (r u32) {
    mask u32 = 4294967295

    #{overflow=wrap}
    r = ((x >> (32 - n)) | (x << n)) & mask
}

; md5: 計算 MD5 哈希
; in: 輸入位元組陣列
; out: 輸出 16 位元組哈希值
md5 = (data []byte) (out [16]byte) {

    ; MD5 初始值（u32 自然 32-bit 溢出）
    h0 u32 = 1732584193
    h1 u32 = 4023233417
    h2 u32 = 2562383102
    h3 u32 = 271733878
    dlen = data.len()

    #{overflow=wrap}
    blen = dlen * 8

    ; 全塊數量（這些區塊直接從 data 載入，無需拷貝，無邊界檢查）
    #{overflow=wrap}
    num-full = dlen / 64

    ; 壓縮函數工作變數（提升到迴圈外宣告一次，迴圈內外均為重新賦值，
    ; 避免「迴圈內宣告 + 迴圈後使用」的 undef 問題與重複宣告錯誤）
    a u32 = 0
    b u32 = 0
    c u32 = 0
    d u32 = 0
    f u32 = 0
    t u32 = 0

    ; 處理全塊：直接從 data 載入 16 個 32-bit 字（load-le-u32 使用指標運算，無邊界檢查）
    bidx <- [0..num-full): {

        #{overflow=wrap}
        off = bidx * 64
        w0 = data.load-le-u32(off)

        #{overflow=wrap}
        w1 = data.load-le-u32(off + 4)

        #{overflow=wrap}
        w2 = data.load-le-u32(off + 8)

        #{overflow=wrap}
        w3 = data.load-le-u32(off + 12)

        #{overflow=wrap}
        w4 = data.load-le-u32(off + 16)

        #{overflow=wrap}
        w5 = data.load-le-u32(off + 20)

        #{overflow=wrap}
        w6 = data.load-le-u32(off + 24)

        #{overflow=wrap}
        w7 = data.load-le-u32(off + 28)

        #{overflow=wrap}
        w8 = data.load-le-u32(off + 32)

        #{overflow=wrap}
        w9 = data.load-le-u32(off + 36)

        #{overflow=wrap}
        w10 = data.load-le-u32(off + 40)

        #{overflow=wrap}
        w11 = data.load-le-u32(off + 44)

        #{overflow=wrap}
        w12 = data.load-le-u32(off + 48)

        #{overflow=wrap}
        w13 = data.load-le-u32(off + 52)

        #{overflow=wrap}
        w14 = data.load-le-u32(off + 56)

        #{overflow=wrap}
        w15 = data.load-le-u32(off + 60)

        ; MD5 壓縮函數（64 輪）— u32 算術自然 32-bit 溢出
        a = h0
        b = h1
        c = h2
        d = h3

        ; 第 1 輪 (F): f = d ^ (b & (c ^ d))
        f = d ^ (b & (c ^ d))

        #{overflow=wrap}
        t = (a + f + w0 + 3614090360) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 7)) & 4294967295
        f = c ^ (a & (b ^ c))

        #{overflow=wrap}
        t = (d + f + w1 + 3905402710) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 12)) & 4294967295
        f = b ^ (d & (a ^ b))

        #{overflow=wrap}
        t = (c + f + w2 + 606105819) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 17)) & 4294967295
        f = a ^ (c & (d ^ a))

        #{overflow=wrap}
        t = (b + f + w3 + 3250441966) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 22)) & 4294967295
        f = d ^ (b & (c ^ d))

        #{overflow=wrap}
        t = (a + f + w4 + 4118548399) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 7)) & 4294967295
        f = c ^ (a & (b ^ c))

        #{overflow=wrap}
        t = (d + f + w5 + 1200080426) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 12)) & 4294967295
        f = b ^ (d & (a ^ b))

        #{overflow=wrap}
        t = (c + f + w6 + 2821735955) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 17)) & 4294967295
        f = a ^ (c & (d ^ a))

        #{overflow=wrap}
        t = (b + f + w7 + 4249261313) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 22)) & 4294967295
        f = d ^ (b & (c ^ d))

        #{overflow=wrap}
        t = (a + f + w8 + 1770035416) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 7)) & 4294967295
        f = c ^ (a & (b ^ c))

        #{overflow=wrap}
        t = (d + f + w9 + 2336552879) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 12)) & 4294967295
        f = b ^ (d & (a ^ b))

        #{overflow=wrap}
        t = (c + f + w10 + 4294925233) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 17)) & 4294967295
        f = a ^ (c & (d ^ a))

        #{overflow=wrap}
        t = (b + f + w11 + 2304563134) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 22)) & 4294967295
        f = d ^ (b & (c ^ d))

        #{overflow=wrap}
        t = (a + f + w12 + 1804603682) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 7)) & 4294967295
        f = c ^ (a & (b ^ c))

        #{overflow=wrap}
        t = (d + f + w13 + 4254626195) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 12)) & 4294967295
        f = b ^ (d & (a ^ b))

        #{overflow=wrap}
        t = (c + f + w14 + 2792965006) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 17)) & 4294967295
        f = a ^ (c & (d ^ a))

        #{overflow=wrap}
        t = (b + f + w15 + 1236535329) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 22)) & 4294967295

        ; 第 2 輪 (G): f = c ^ (d & (b ^ c))
        f = c ^ (d & (b ^ c))

        #{overflow=wrap}
        t = (a + f + w1 + 4129170786) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 5)) & 4294967295
        f = b ^ (c & (a ^ b))

        #{overflow=wrap}
        t = (d + f + w6 + 3225465664) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 9)) & 4294967295
        f = a ^ (b & (d ^ a))

        #{overflow=wrap}
        t = (c + f + w11 + 643717713) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 14)) & 4294967295
        f = d ^ (a & (c ^ d))

        #{overflow=wrap}
        t = (b + f + w0 + 3921069994) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 20)) & 4294967295
        f = c ^ (d & (b ^ c))

        #{overflow=wrap}
        t = (a + f + w5 + 3593408605) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 5)) & 4294967295
        f = b ^ (c & (a ^ b))

        #{overflow=wrap}
        t = (d + f + w10 + 38016083) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 9)) & 4294967295
        f = a ^ (b & (d ^ a))

        #{overflow=wrap}
        t = (c + f + w15 + 3634488961) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 14)) & 4294967295
        f = d ^ (a & (c ^ d))

        #{overflow=wrap}
        t = (b + f + w4 + 3889429448) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 20)) & 4294967295
        f = c ^ (d & (b ^ c))

        #{overflow=wrap}
        t = (a + f + w9 + 568446438) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 5)) & 4294967295
        f = b ^ (c & (a ^ b))

        #{overflow=wrap}
        t = (d + f + w14 + 3275163606) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 9)) & 4294967295
        f = a ^ (b & (d ^ a))

        #{overflow=wrap}
        t = (c + f + w3 + 4107603335) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 14)) & 4294967295
        f = d ^ (a & (c ^ d))

        #{overflow=wrap}
        t = (b + f + w8 + 1163531501) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 20)) & 4294967295
        f = c ^ (d & (b ^ c))

        #{overflow=wrap}
        t = (a + f + w13 + 2850285829) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 5)) & 4294967295
        f = b ^ (c & (a ^ b))

        #{overflow=wrap}
        t = (d + f + w2 + 4243563512) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 9)) & 4294967295
        f = a ^ (b & (d ^ a))

        #{overflow=wrap}
        t = (c + f + w7 + 1735328473) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 14)) & 4294967295
        f = d ^ (a & (c ^ d))

        #{overflow=wrap}
        t = (b + f + w12 + 2368359562) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 20)) & 4294967295

        ; 第 3 輪 (H): f = x ^ y ^ z
        f = b ^ c ^ d

        #{overflow=wrap}
        t = (a + f + w5 + 4294588738) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 4)) & 4294967295
        f = a ^ b ^ c

        #{overflow=wrap}
        t = (d + f + w8 + 2272392833) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 11)) & 4294967295
        f = d ^ a ^ b

        #{overflow=wrap}
        t = (c + f + w11 + 1839030562) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 16)) & 4294967295
        f = c ^ d ^ a

        #{overflow=wrap}
        t = (b + f + w14 + 4259657740) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 23)) & 4294967295
        f = b ^ c ^ d

        #{overflow=wrap}
        t = (a + f + w1 + 2763975236) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 4)) & 4294967295
        f = a ^ b ^ c

        #{overflow=wrap}
        t = (d + f + w4 + 1272893353) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 11)) & 4294967295
        f = d ^ a ^ b

        #{overflow=wrap}
        t = (c + f + w7 + 4139469664) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 16)) & 4294967295
        f = c ^ d ^ a

        #{overflow=wrap}
        t = (b + f + w10 + 3200236656) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 23)) & 4294967295
        f = b ^ c ^ d

        #{overflow=wrap}
        t = (a + f + w13 + 681279174) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 4)) & 4294967295
        f = a ^ b ^ c

        #{overflow=wrap}
        t = (d + f + w0 + 3936430074) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 11)) & 4294967295
        f = d ^ a ^ b

        #{overflow=wrap}
        t = (c + f + w3 + 3572445317) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 16)) & 4294967295
        f = c ^ d ^ a

        #{overflow=wrap}
        t = (b + f + w6 + 76029189) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 23)) & 4294967295
        f = b ^ c ^ d

        #{overflow=wrap}
        t = (a + f + w9 + 3654602809) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 4)) & 4294967295
        f = a ^ b ^ c

        #{overflow=wrap}
        t = (d + f + w12 + 3873151461) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 11)) & 4294967295
        f = d ^ a ^ b

        #{overflow=wrap}
        t = (c + f + w15 + 530742520) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 16)) & 4294967295
        f = c ^ d ^ a

        #{overflow=wrap}
        t = (b + f + w2 + 3299628645) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 23)) & 4294967295

        ; 第 4 輪 (I): f = y ^ (x | ~z)  — ~d 即按位取反
        f = c ^ (b | (~d & 4294967295))

        #{overflow=wrap}
        t = (a + f + w0 + 4096336452) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 6)) & 4294967295
        f = b ^ (a | (~c & 4294967295))

        #{overflow=wrap}
        t = (d + f + w7 + 1126891415) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 10)) & 4294967295
        f = a ^ (d | (~b & 4294967295))

        #{overflow=wrap}
        t = (c + f + w14 + 2878612391) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 15)) & 4294967295
        f = d ^ (c | (~a & 4294967295))

        #{overflow=wrap}
        t = (b + f + w5 + 4237533241) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 21)) & 4294967295
        f = c ^ (b | (~d & 4294967295))

        #{overflow=wrap}
        t = (a + f + w12 + 1700485571) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 6)) & 4294967295
        f = b ^ (a | (~c & 4294967295))

        #{overflow=wrap}
        t = (d + f + w3 + 2399980690) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 10)) & 4294967295
        f = a ^ (d | (~b & 4294967295))

        #{overflow=wrap}
        t = (c + f + w10 + 4293915773) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 15)) & 4294967295
        f = d ^ (c | (~a & 4294967295))

        #{overflow=wrap}
        t = (b + f + w1 + 2240044497) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 21)) & 4294967295
        f = c ^ (b | (~d & 4294967295))

        #{overflow=wrap}
        t = (a + f + w8 + 1873313359) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 6)) & 4294967295
        f = b ^ (a | (~c & 4294967295))

        #{overflow=wrap}
        t = (d + f + w15 + 4264355552) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 10)) & 4294967295
        f = a ^ (d | (~b & 4294967295))

        #{overflow=wrap}
        t = (c + f + w6 + 2734768916) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 15)) & 4294967295
        f = d ^ (c | (~a & 4294967295))

        #{overflow=wrap}
        t = (b + f + w13 + 1309151649) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 21)) & 4294967295
        f = c ^ (b | (~d & 4294967295))

        #{overflow=wrap}
        t = (a + f + w4 + 4149444226) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 6)) & 4294967295
        f = b ^ (a | (~c & 4294967295))

        #{overflow=wrap}
        t = (d + f + w11 + 3174756917) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 10)) & 4294967295
        f = a ^ (d | (~b & 4294967295))

        #{overflow=wrap}
        t = (c + f + w2 + 718787259) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 15)) & 4294967295
        f = d ^ (c | (~a & 4294967295))

        #{overflow=wrap}
        t = (b + f + w9 + 3951481745) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 21)) & 4294967295

        ; 累加回初始值（u32 自然溢出）
        #{overflow=wrap}
        h0 = (h0 + a) & 4294967295

        #{overflow=wrap}
        h1 = (h1 + b) & 4294967295

        #{overflow=wrap}
        h2 = (h2 + c) & 4294967295

        #{overflow=wrap}
        h3 = (h3 + d) & 4294967295
    }

    ; 處理末塊（含填充）：dremain >= 56 時需第二個純填充區塊
    buf [128]byte

    ; 固定陣列不保證零初始化，先全部清零
    zi <- [0..128): buf[zi] = 0

    #{overflow=wrap}
    off = num-full * 64

    #{overflow=wrap}
    dremain = dlen - off

    ; 以 4 位元組為單位拷貝資料（load-le-u32/store-le-u32 使用指標運算，無邊界檢查）
    #{overflow=wrap}
    num-copy-words = dremain / 4
    j <- [0..num-copy-words): {

        #{overflow=wrap}
        buf.store-le-u32(j * 4, data.load-le-u32(off + j * 4))
    }

    ; 處理剩餘 0-3 位元組
    copy-rem = dremain % 4

    #{overflow=wrap}
    copy-rem > 0 -> {

        #{overflow=wrap}
        base = num-copy-words * 4

        #{index-out=zero}
        k <- [0..copy-rem): buf[base + k] = data[off + base + k]
    }

    ; 添加 0x80 填充
    buf[dremain] = 128

    ; 決定末塊數量：填充後需為 64 的倍數且末 8 位元組放長度
    ntail = 1
    dremain >= 56 -> ntail = 2

    ; 長度寫入最後一個末塊的 [56..63]
    #{overflow=wrap}
    len-off = (ntail - 1) * 64

    #{overflow=wrap}
    buf.store-le-u32(len-off + 56, blen & 4294967295)

    #{overflow=wrap}
    buf.store-le-u32(len-off + 60, blen >> 32)

    ; 逐末塊壓縮（1 或 2 個區塊）
    tb <- [0..ntail): {

        #{overflow=wrap}
        tboff = tb * 64

        ; 從緩衝區載入 16 個 32-bit 字
        w0 = buf.load-le-u32(tboff)

        #{overflow=wrap}
        w1 = buf.load-le-u32(tboff + 4)

        #{overflow=wrap}
        w2 = buf.load-le-u32(tboff + 8)

        #{overflow=wrap}
        w3 = buf.load-le-u32(tboff + 12)

        #{overflow=wrap}
        w4 = buf.load-le-u32(tboff + 16)

        #{overflow=wrap}
        w5 = buf.load-le-u32(tboff + 20)

        #{overflow=wrap}
        w6 = buf.load-le-u32(tboff + 24)

        #{overflow=wrap}
        w7 = buf.load-le-u32(tboff + 28)

        #{overflow=wrap}
        w8 = buf.load-le-u32(tboff + 32)

        #{overflow=wrap}
        w9 = buf.load-le-u32(tboff + 36)

        #{overflow=wrap}
        w10 = buf.load-le-u32(tboff + 40)

        #{overflow=wrap}
        w11 = buf.load-le-u32(tboff + 44)

        #{overflow=wrap}
        w12 = buf.load-le-u32(tboff + 48)

        #{overflow=wrap}
        w13 = buf.load-le-u32(tboff + 52)

        #{overflow=wrap}
        w14 = buf.load-le-u32(tboff + 56)

        #{overflow=wrap}
        w15 = buf.load-le-u32(tboff + 60)

        ; MD5 壓縮函數（64 輪）
        a = h0
        b = h1
        c = h2
        d = h3

        ; 第 1 輪 (F): f = d ^ (b & (c ^ d))
        f = d ^ (b & (c ^ d))

        #{overflow=wrap}
        t = (a + f + w0 + 3614090360) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 7)) & 4294967295
        f = c ^ (a & (b ^ c))

        #{overflow=wrap}
        t = (d + f + w1 + 3905402710) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 12)) & 4294967295
        f = b ^ (d & (a ^ b))

        #{overflow=wrap}
        t = (c + f + w2 + 606105819) & 4294967295

        #{overflow=wrap}
        c = (d + md5-rotl(t, 17)) & 4294967295
        f = a ^ (c & (d ^ a))

        #{overflow=wrap}
        t = (b + f + w3 + 3250441966) & 4294967295

        #{overflow=wrap}
        b = (c + md5-rotl(t, 22)) & 4294967295
        f = d ^ (b & (c ^ d))

        #{overflow=wrap}
        t = (a + f + w4 + 4118548399) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 7)) & 4294967295
