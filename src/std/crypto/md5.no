        #{overflow=wrap}
        b = (c + md5-rotl(t, 23)) & 4294967295
        f = b ^ c ^ d

        #{overflow=wrap}
        t = (a + f + w13 + 681279174) & 4294967295

        #{overflow=wrap}
        a = (b + md5-rotl(t, 4)) & 4294967295
        f = a ^ b ^ c

        #{overflow=wrap}
        t = (d + f + w0 + 3936430074) & 4294967295

        #{overflow=wrap}
        d = (a + md5-rotl(t, 11)) & 4294967295
        f = d ^ a ^ b

        #{overflow=wrap}
