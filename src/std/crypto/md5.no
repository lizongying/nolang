        ; 第 4 輪 (I): f = y ^ (x | ~z)  — ~d 即按位取反
        f = c ^ (b | (~d & 4294967295))

        #{overflow=wrap}
        t = (a + f + w0 + 4096336452) & 4294967295

        #{overflow=wrap}
