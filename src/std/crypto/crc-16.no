; crc16 — CRC-16 循環冗餘校驗（CCITT 變體）
;
; 使用 CRC-16-CCITT 多項式 0x1021，初始值 0xFFFF。
;
; 用法：
;   h = new(data)

; 計算 CRC-16-CCITT（多項式 0x1021，初值 0xFFFF）校驗和
; data []byte: 輸入位元組，全部參與計算
; crc i64: 16-bit 校驗和（0..65535）
; [new](#crc-16.new)
new = (data []byte) (crc i64) {
    crc = 65535
    i <- [0..data.len()): {

        #{index-out=zero}
        crc = crc ^ ((data[i]) << 8)
        j <- [0..8): {
            {
                crc & 32768 != 0 -> crc = ((crc << 1) ^ 4129) & 65535

                -> crc = (crc << 1) & 65535
            }
        }
    }
}

; 計算 CRC-16 並返回 4 位小寫 hex 字串
; data []byte: 輸入位元組，全部參與計算
; hex str: 固定 4 字元的十六進位表示（高位在前，不含 0x 前綴）
; [hex](#crc-16.hex)
hex = (data []byte) (hex str) {
    crc = new(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(4)

    hex[0]: {
        ok -> it = hex-chars[(crc >> 12) & 15]
        -> _
    }

    hex[1]: {
        ok -> it = hex-chars[(crc >> 8) & 15]
        -> _
    }

    hex[2]: {
        ok -> it = hex-chars[(crc >> 4) & 15]
        -> _
    }

    hex[3]: {
        ok -> it = hex-chars[crc & 15]
        -> _
    }
}
