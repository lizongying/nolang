; scrypt — Scrypt 記憶體困難金鑰推導函數（RFC 7914）
;
; Scrypt 設計為記憶體困難的 KDF，抵抗 ASIC/GPU 破解。
; 使用 PBKDF2-HMAC-SHA256 + Salsa20/8 核心函數。
;
; 用法：
;   # std/crypto/scrypt
;   password []byte = 'password'
;   salt []byte = 'salt'
;   N = 16384    // CPU/Memory 參數（必須是 2 的冪）
;   r = 8        // 區塊大小參數
;   p = 1        // 並行參數
;   key-len = 32
;   derived = scrypt(password, salt, N, r, p, key-len)
; [scrypt](#scrypt)

; 32-bit 循環左移（用於 Salsa20 quarter-round 的旋轉）
; x u32: 要旋轉的 32 位元值
; n i64: 左旋位元數（0..31；32 會使移位量溢出）
; r u32: 左旋結果，已 & 0xFFFFFFFF
; [rotl32](#scrypt.rotl32)
rotl32 = (x u32, n i64) (r u32) {
    mask u32 = 4294967295

    r = ((x >> (32 - n)) | (x << n)) & mask
}

; Salsa20/8 核心函數
...

; Salsa20/8 核心：對 64 位元組區塊進行 8 輪混合
; 先讀入 16 個小端 32-bit 字，執行 8 輪 add-rotate-xor 後再與原值相加並寫回。
; block []byte: 64 位元組輸入/輸出；原地修改，少於 64 位元組時缺失部分按 0 處理
; [salsa20-8-core](#scrypt.salsa20-8-core)
; Salsa20 四分之一輪（原位更新 16 字工作向量）
; 依 RFC 7914 §3.1 的 QR(a,b,c,d)：b/c/d/a 依次以 7/9/13/18 位左旋混合
; x []u32: 16 字工作向量（原地更新）
; a i64, b i64, c i64, d i64: 本輪四個字在向量中的下標
; mask u32: 32 位遮罩
; 每一步都讀上一步剛寫入的字，故各自具名讀出，不共用暫存。
; [salsa-quarter-round](#scrypt.salsa-quarter-round)
salsa-quarter-round = (x []u32, a i64, b i64, c i64, d i64, mask u32) {
    {
        ; b ^= rotl(a + d, 7)
        a-base ?= x[a]
        d-base ?= x[d]
        b-before ?= x[b]

        x[b]: {
            ok -> it = (b-before ^ rotl32((a-base + d-base) & mask, 7)) & mask

            -> _
        }

        ; c ^= rotl(b + a, 9)
        b-after ?= x[b]
        a-second ?= x[a]
        c-before ?= x[c]

        x[c]: {
            ok -> it = (c-before ^ rotl32((b-after + a-second) & mask, 9)) & mask

            -> _
        }

        ; d ^= rotl(c + b, 13)
        c-after ?= x[c]
        b-second ?= x[b]
        d-before ?= x[d]

        x[d]: {
            ok -> it = (d-before ^ rotl32((c-after + b-second) & mask, 13)) & mask

            -> _
        }

        ; a ^= rotl(d + c, 18)
        d-after ?= x[d]
        c-second ?= x[c]
        a-third ?= x[a]

        x[a]: {
            ok -> it = (a-third ^ rotl32((d-after + c-second) & mask, 18)) & mask

            -> _
        }
    }: {
        err -> _

        -> _
    }
}

; 處理一個 64 位元組區塊（Salsa20/8：4 次雙輪 = 8 輪，RFC 7914 §3）
; 輸出為 core(block) + block（逐字模 2^32 相加），寫回同一區塊
; block []byte: 64 位元組區塊（原地更新）
; [salsa20-8-core](#scrypt.salsa20-8-core)
salsa20-8-core = (block []byte) {

    ; 載入 16 個 32-bit 字（小端序）
    x [16]u32
    i <- [0..16): {
        {
            #{overflow=wrap}
            word-start ?= i * 4

            ; 逐位元組小端組字：第 j 個位元組佔 bit [8j, 8j+8)
            word u32 = 0
            j <- [0..4): {
                {
                    #{overflow=wrap}
                    byte-at ?= word-start + j

                    raw-byte ?= block[byte-at]

                    #{overflow=wrap}
                    bit-shift ?= j * 8

                    word = word | (raw-byte << bit-shift)
                }: {
                    err -> _

                    -> _
                }
            }

            x[i]: {
                ok -> it = word

                -> _
            }
        }: {
            err -> _

            -> _
        }
    }

    ; 保存初始值（8 輪後要加回來）
    init [16]u32
    i <- [0..16): {
        {
            word ?= x[i]

            init[i]: {
                ok -> it = word

                -> _
            }
        }: {
            err -> _

            -> _
        }
    }

    ; 4 次雙輪：先 4 個列四分之一輪，再 4 個行四分之一輪
    mask u32 = 4294967295
    round <- [0..4): {
        ; 列
        salsa-quarter-round(x, 0, 4, 8, 12, mask)
        salsa-quarter-round(x, 5, 9, 13, 1, mask)
        salsa-quarter-round(x, 10, 14, 2, 6, mask)
        salsa-quarter-round(x, 15, 3, 7, 11, mask)

        ; 行
        salsa-quarter-round(x, 0, 1, 2, 3, mask)
        salsa-quarter-round(x, 5, 6, 7, 4, mask)
        salsa-quarter-round(x, 10, 11, 8, 9, mask)
        salsa-quarter-round(x, 15, 12, 13, 14, mask)
    }

    ; x += init，再以小端序寫回 64 位元組
    i <- [0..16): {
        {
            word ?= x[i]
            base ?= init[i]

            #{overflow=wrap}
            sum = (word + base) & 4294967295

            #{overflow=wrap}
            word-start ?= i * 4

            block[word-start]: {
                ok -> it = sum & 255

                -> _
            }

            #{overflow=wrap}
            second-byte-at ?= word-start + 1

            block[second-byte-at]: {
                ok -> it = (sum >> 8) & 255

                -> _
            }

            #{overflow=wrap}
            third-byte-at ?= word-start + 2

            block[third-byte-at]: {
                ok -> it = (sum >> 16) & 255

                -> _
            }

            #{overflow=wrap}
            fourth-byte-at ?= word-start + 3

            block[fourth-byte-at]: {
                ok -> it = (sum >> 24) & 255

                -> _
            }
        }: {
            err -> _

            -> _
        }
    }
}

; BlockMix
...

; 區塊混合函數（RFC 7914 §4）
; 以尾部 64 位元組為初始 X，對 2r 個 64 位元組子區塊迭代 Salsa20/8，
; 偶數塊放前半、奇數塊放後半，得到新的 128*r 位元組輸出。
; b []byte: 輸入區塊（128*r 位元組）
; r i64: 區塊大小參數（每個子區塊 64 位元組，共 2r 塊）
; 返回 out []byte: 混合後的區塊（長度 128*r）
; [scrypt-blockmix](#scrypt.scrypt-blockmix)
scrypt-blockmix = (b []byte, r i64) (out []byte) {

    #{overflow=wrap}
    out = with-cap(2 * r * 64)
    block-size = 64

    #{overflow=wrap}
    total = 2 * r

    ; X = B[2r-1]（最後一個 64 位元組區塊）
    x []byte
    i <- [0..64): {
        {

            #{overflow=wrap}
            x[i] ?= b[(total - 1) * 64 + i]
        }: {
            err -> _

            -> _
        }
    }

    ; Y 陣列（2r 個 64 位元組區塊）
    y []byte

    ; 逐區塊處理
    i <- [0..total): {

        ; X = B[i] XOR X
        j <- [0..64): {

            #{overflow=wrap}
            b-i-64-j = b[i * 64 + j]: {
                ok -> it

                -> _
            }

            x-j = x[j]: {
                ok -> it

                -> _
            }

            x[j]: {
                ok -> it = (b-i-64-j) ^ (x-j)

                -> _
            }
        }

        ; X = Salsa20/8(X)
        salsa20-8-core(x)

        ; Y[i] = X
        j <- [0..64): {
            {

                #{overflow=wrap}
                y[i * 64 + j] ?= x[j]
            }: {
                err -> _

                -> _
            }
        }
    }

    ; 輸出: (Y[0], Y[2], ..., Y[2r-2], Y[1], Y[3], ..., Y[2r-1])
    i <- [0..r): {
        j <- [0..64): {
            {

                #{overflow=wrap}
                out[i * 64 + j] ?= y[(2 * i) * 64 + j]
            }: {
                err -> _

                -> _
            }
        }
    }
    i <- [0..r): {
        j <- [0..64): {
            {

                #{overflow=wrap}
                out[(r + i) * 64 + j] ?= y[(2 * i + 1) * 64 + j]
            }: {
                err -> _

                -> _
            }
        }
    }
}

; ROMix
...

; 記憶體困難混合函數（RFC 7914 §5，亦稱 ROMix）
; 先填充 n 個區塊的 V 表，再做 n 次隨機索引讀取 + BlockMix，最終得到新的 128*r 位元組。
; b []byte: 輸入區塊（128*r 位元組）
; n i64: CPU/記憶體成本參數，須為大於 1 的 2 的冪（如 16384）
; r i64: 區塊大小參數，決定每個子區塊的 64 位元組塊數
; 返回 out []byte: 混合後的區塊（長度 128*r）
; [scrypt-romix](#scrypt.scrypt-romix)
scrypt-romix = (b []byte, n i64, r i64) (out []byte) {

    #{overflow=wrap}
    out = with-cap(2 * r * 64)

    #{overflow=wrap}
    block-bytes = 128 * r

    ; V 陣列：n 個區塊，每個 block-bytes 位元組
    ; 由於記憶體限制，逐塊處理

    ; X = B
    x []byte
    i <- [0..block-bytes): {
        {
            x[i] ?= b[i]
        }: {
            err -> _

            -> _
        }
    }

    ; 第一階段：填充 V
    ; V[0] = X, V[i] = BlockMix(V[i-1])
    v []byte
    i <- [0..block-bytes): {
        {
            v[i] ?= x[i]
        }: {
            err -> _

            -> _
        }
    }
    n-idx = 1
    (n-idx < n) {

        ; X = BlockMix(X)
        mixed = scrypt-blockmix(x, r)
        i <- [0..block-bytes): {
            {
                x[i] ?= mixed[i]
            }: {
                err -> _

                -> _
            }

            {

                #{overflow=wrap}
                v[n-idx * block-bytes + i] ?= mixed[i]
            }: {
                err -> _

                -> _
            }
        }

        {
            #{overflow=wrap}
            n-idx ?= n-idx + 1
        }: {
            err -> _

            -> _
        }
    }

    ; 第一階段結束後，X 需再套用一次 BlockMix（標準 ROMix：X = BlockMix^N(B)）
    x = scrypt-blockmix(x, r)

    ; 第二階段：偽隨機存取
    n-idx = 0
    (n-idx < n) {

        ; j = Integerify(X) mod N
        ; Integerify: 將 X 的最後 64 位元組的前 8 位元組解釋為小端整數（取 mod N）
        ; 用 Horner 法逐位元組累積，避免 byte<<56 在 i64 造成符號負值
        #{overflow=wrap}
        base-j = (2 * r - 1) * 64
        j = 0
        k <- [0..8): {

            #{overflow=wrap}
            x-base-j-7-k = x[base-j + (7 - k)]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            j = (j * 256 + x-base-j-7-k) % n
        }

        ; X = X XOR V[j]
        i <- [0..block-bytes): {
            x-i = x[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            v-j-block-bytes-i = v[j * block-bytes + i]: {
                ok -> it

                -> _
            }

            x[i]: {
                ok -> it = (x-i) ^ (v-j-block-bytes-i)

                -> _
            }
        }

        ; X = BlockMix(X)
        mixed = scrypt-blockmix(x, r)
        i <- [0..block-bytes): {
            {
                x[i] ?= mixed[i]
            }: {
                err -> _

                -> _
            }
        }

        {
            #{overflow=wrap}
            n-idx ?= n-idx + 1
        }: {
            err -> _

            -> _
        }
    }

    ; 輸出 X
    i <- [0..block-bytes): {
        out[i] = x[i]: {
            ok -> it

            -> _
        }
    }
}

; Scrypt 公開 API
...

; Scrypt 金鑰推導（RFC 7914 §7）
; 先以 PBKDF2-HMAC-SHA256(迭代 1 次) 把密碼展開為 p*128*r 位元組，
; 逐段做 ROMix，最後再做一輪 PBKDF2 輸出 key-len 位元組。
; password []byte: 密碼（UTF-8 位元組序列）
; salt []byte: 鹽值，建議 16 位元組以上且每帳號不同
; n i64: CPU/記憶體成本，須為大於 1 的 2 的冪；越大越安全也越慢
; r i64: 區塊大小（如 8），與 n 共同決定記憶體用量 128*n*r 位元組
; p i64: 並行度（如 1），影響 CPU 時間
; key-len i64: 期望金鑰長度（位元組）
; 返回 out []byte: 推導出的金鑰，長度恰為 key-len
; [scrypt](#scrypt.scrypt)
scrypt = (password []byte, salt []byte, n i64, r i64, p i64, key-len i64) (out []byte) {

    ; 1. B = PBKDF2-HMAC-SHA256(password, salt, 1, p * 128 * r)
    #{overflow=wrap}
    b-len = p * 128 * r
    b []byte
    b = pbkdf2.pbkdf2-hmac-sha256(password, salt, 1, b-len)

    ; 2. For i = 0 to p-1: B_i = ROMix(B_i, N, r)
    #{overflow=wrap}
    block-bytes = 128 * r
    i <- [0..p): {

        ; 提取 B_i
        b-i []byte
        j <- [0..block-bytes): {
            {

                #{overflow=wrap}
                b-i[j] ?= b[i * block-bytes + j]
            }: {
                err -> _

                -> _
            }
        }

        ; ROMix
        mixed = scrypt-romix(b-i, n, r)

        ; 寫回 B
        j <- [0..block-bytes): {
            {

                #{overflow=wrap}
                b[i * block-bytes + j] ?= mixed[j]
            }: {
                err -> _

                -> _
            }
        }
    }

    ; 3. DK = PBKDF2-HMAC-SHA256(password, B, 1, key-len)
    out = pbkdf2.pbkdf2-hmac-sha256(password, b, 1, key-len)
}
