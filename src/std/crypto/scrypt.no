            -> _
        }

        ixout181c49 = x[3]: {
            ok -> it

            -> _
        }

        x[1]: {
            ok -> it = (ixout181c26 ^ (rotl32((ixout181c42 + ixout181c49) & mask, 7))) & mask

            -> _
        }
        ixout186c26 = x[2]: {
            ok -> it

