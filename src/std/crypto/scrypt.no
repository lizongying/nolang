; scrypt — Scrypt 記憶體困難金鑰推導函數（RFC 7914）
;
; Scrypt 設計為記憶體困難的 KDF，抵抗 ASIC/GPU 破解。
; 使用 PBKDF2-HMAC-SHA256 + Salsa20/8 核心函數。
;
; 用法：
;   # std/crypto/scrypt
;   password []byte = 'password'
;   salt []byte = 'salt'
;   N = 16384    // CPU/Memory 參數（必須是 2 的冪）
;   r = 8        // 區塊大小參數
;   p = 1        // 並行參數
;   key-len = 32
;   derived = scrypt(password, salt, N, r, p, key-len)

; ═══════════════════════════════════════════════
; 32-bit 循環左移（用於 Salsa20 quarter-round 的旋轉）
; x u32: 要旋轉的 32 位元值
; n i64: 左旋位元數（0..31；32 會使移位量溢出）
; r u32: 左旋結果，已 & 0xFFFFFFFF
; [rotl32](#scrypt.rotl32)
rotl32 = (x u32, n i64) (r u32) {
    mask u32 = 4294967295

    r = ((x >> (32 - n)) | (x << n)) & mask
}

; Salsa20/8 核心函數
; ═══════════════════════════════════════════════

; Salsa20/8 核心：對 64 位元組區塊進行 8 輪混合
; 先讀入 16 個小端 32-bit 字，執行 8 輪 add-rotate-xor 後再與原值相加並寫回。
; block []byte: 64 位元組輸入/輸出；原地修改，少於 64 位元組時缺失部分按 0 處理
; [salsa20-8-core](#scrypt.salsa20-8-core)
salsa20-8-core = (block []byte) {

    ; 載入 16 個 32-bit 字（小端序）
    x [16]u32
    i <- [0..16): {

        #{overflow=wrap}
        off = i * 4

        #{index-out=zero}
        x[i]: {
            ok -> it = (block[off]) | ((block[off + 1]) << 8) | ((block[off + 2]) << 16) | ((block[off + 3]) << 24)

            -> _
        }
    }

    ; 保存初始值
    init [16]u32
    i <- [0..16): {
        init[i]: {
            ok -> it = x[i]

            -> _
        }
    }

    ; 8 輪（4 次雙輪）
    mask u32 = 4294967295
    round <- [0..4): {

        ; 列輪
        ; QR(x[0], x[4], x[8], x[12])
        x[4]: {
            ok -> it = (x[4] ^ (rotl32((x[0] + x[12]) & mask, 7))) & mask

            -> _
        }
        x[8]: {
            ok -> it = (x[8] ^ (rotl32((x[4] + x[0]) & mask, 9))) & mask

            -> _
        }
        x[12]: {
            ok -> it = (x[12] ^ (rotl32((x[8] + x[4]) & mask, 13))) & mask

            -> _
        }
        x[0]: {
            ok -> it = (x[0] ^ (rotl32((x[12] + x[8]) & mask, 18))) & mask

            -> _
        }

        ; QR(x[5], x[9], x[13], x[1])
        x[9]: {
            ok -> it = (x[9] ^ (rotl32((x[5] + x[1]) & mask, 7))) & mask

            -> _
        }
        x[13]: {
            ok -> it = (x[13] ^ (rotl32((x[9] + x[5]) & mask, 9))) & mask

            -> _
        }
        x[1]: {
            ok -> it = (x[1] ^ (rotl32((x[13] + x[9]) & mask, 13))) & mask

            -> _
        }
        x[5]: {
            ok -> it = (x[5] ^ (rotl32((x[1] + x[13]) & mask, 18))) & mask

            -> _
        }

        ; QR(x[10], x[14], x[2], x[6])
        x[14]: {
            ok -> it = (x[14] ^ (rotl32((x[10] + x[6]) & mask, 7))) & mask

            -> _
        }
        x[2]: {
            ok -> it = (x[2] ^ (rotl32((x[14] + x[10]) & mask, 9))) & mask

            -> _
        }
        x[6]: {
            ok -> it = (x[6] ^ (rotl32((x[2] + x[14]) & mask, 13))) & mask

            -> _
        }
        x[10]: {
            ok -> it = (x[10] ^ (rotl32((x[6] + x[2]) & mask, 18))) & mask

            -> _
        }

        ; QR(x[15], x[3], x[7], x[11])
        x[3]: {
            ok -> it = (x[3] ^ (rotl32((x[15] + x[11]) & mask, 7))) & mask

            -> _
        }
        x[7]: {
            ok -> it = (x[7] ^ (rotl32((x[3] + x[15]) & mask, 9))) & mask

            -> _
        }
        x[11]: {
            ok -> it = (x[11] ^ (rotl32((x[7] + x[3]) & mask, 13))) & mask

            -> _
        }
        x[15]: {
            ok -> it = (x[15] ^ (rotl32((x[11] + x[7]) & mask, 18))) & mask

            -> _
        }

        ; 行輪
        ; QR(x[0], x[1], x[2], x[3])
        x[1]: {
            ok -> it = (x[1] ^ (rotl32((x[0] + x[3]) & mask, 7))) & mask

            -> _
        }
        x[2]: {
            ok -> it = (x[2] ^ (rotl32((x[1] + x[0]) & mask, 9))) & mask

            -> _
        }
        x[3]: {
            ok -> it = (x[3] ^ (rotl32((x[2] + x[1]) & mask, 13))) & mask

            -> _
        }
        x[0]: {
            ok -> it = (x[0] ^ (rotl32((x[3] + x[2]) & mask, 18))) & mask

            -> _
        }

        ; QR(x[5], x[6], x[7], x[4])
        x[6]: {
            ok -> it = (x[6] ^ (rotl32((x[5] + x[4]) & mask, 7))) & mask

            -> _
        }
        x[7]: {
            ok -> it = (x[7] ^ (rotl32((x[6] + x[5]) & mask, 9))) & mask

            -> _
        }
        x[4]: {
            ok -> it = (x[4] ^ (rotl32((x[7] + x[6]) & mask, 13))) & mask

            -> _
        }
        x[5]: {
            ok -> it = (x[5] ^ (rotl32((x[4] + x[7]) & mask, 18))) & mask

            -> _
        }

        ; QR(x[10], x[11], x[8], x[9])
        x[11]: {
            ok -> it = (x[11] ^ (rotl32((x[10] + x[9]) & mask, 7))) & mask

            -> _
        }
        x[8]: {
            ok -> it = (x[8] ^ (rotl32((x[11] + x[10]) & mask, 9))) & mask

            -> _
        }
        x[9]: {
            ok -> it = (x[9] ^ (rotl32((x[8] + x[11]) & mask, 13))) & mask

            -> _
        }
        x[10]: {
            ok -> it = (x[10] ^ (rotl32((x[9] + x[8]) & mask, 18))) & mask

            -> _
        }

        ; QR(x[15], x[12], x[13], x[14])
        x[12]: {
            ok -> it = (x[12] ^ (rotl32((x[15] + x[14]) & mask, 7))) & mask

            -> _
        }
        x[13]: {
            ok -> it = (x[13] ^ (rotl32((x[12] + x[15]) & mask, 9))) & mask

            -> _
        }
        x[14]: {
            ok -> it = (x[14] ^ (rotl32((x[13] + x[12]) & mask, 13))) & mask

            -> _
        }
        x[15]: {
            ok -> it = (x[15] ^ (rotl32((x[14] + x[13]) & mask, 18))) & mask

            -> _
        }
    }

    ; 加上初始值並寫回（小端序）
    i <- [0..16): {
        val = (x[i] + init[i]) & 4294967295

        #{overflow=wrap}
        off = i * 4
        block[off]: {
            ok -> it = val & 255

            -> _
        }

        #{overflow=wrap}
        block[off + 1]: {
            ok -> it = (val >> 8) & 255

            -> _
        }

        #{overflow=wrap}
        block[off + 2]: {
            ok -> it = (val >> 16) & 255

            -> _
        }

        #{overflow=wrap}
        block[off + 3]: {
            ok -> it = (val >> 24) & 255

            -> _
        }
    }
}

; ═══════════════════════════════════════════════
; BlockMix
; ═══════════════════════════════════════════════

; 區塊混合函數（RFC 7914 §4）
; 以尾部 64 位元組為初始 X，對 2r 個 64 位元組子區塊迭代 Salsa20/8，
; 偶數塊放前半、奇數塊放後半，得到新的 128*r 位元組輸出。
; b []byte: 輸入區塊（128*r 位元組）
; r i64: 區塊大小參數（每個子區塊 64 位元組，共 2r 塊）
; 返回 out []byte: 混合後的區塊（長度 128*r）
; [scrypt-blockmix](#scrypt.scrypt-blockmix)
scrypt-blockmix = (b []byte, r i64) (out []byte) {

    #{overflow=wrap}
    out = with-cap(2 * r * 64)
    block-size = 64

    #{overflow=wrap}
    total = 2 * r

    ; X = B[2r-1]（最後一個 64 位元組區塊）
    x []byte
    i <- [0..64): {

        #{index-out=zero, overflow=wrap}
        x[i]: {
            ok -> it = b[(total - 1) * 64 + i]

            -> _
        }
    }

    ; Y 陣列（2r 個 64 位元組區塊）
    y []byte

    ; 逐區塊處理
    i <- [0..total): {

        ; X = B[i] XOR X
        j <- [0..64): {

            #{index-out=zero}
            x[j]: {
                ok -> it = (b[i * 64 + j]) ^ (x[j])

                -> _
            }
        }

        ; X = Salsa20/8(X)
        salsa20-8-core(x)

        ; Y[i] = X
        j <- [0..64): {

            #{index-out=zero, overflow=wrap}
            y[i * 64 + j]: {
                ok -> it = x[j]

                -> _
            }
        }
    }

    ; 輸出: (Y[0], Y[2], ..., Y[2r-2], Y[1], Y[3], ..., Y[2r-1])
    i <- [0..r): {
        j <- [0..64): {

            #{index-out=zero, overflow=wrap}
            out[i * 64 + j] = y[(2 * i) * 64 + j]
        }
    }
    i <- [0..r): {
        j <- [0..64): {

            #{index-out=zero, overflow=wrap}
            out[(r + i) * 64 + j] = y[(2 * i + 1) * 64 + j]
        }
    }
}

; ═══════════════════════════════════════════════
; ROMix
; ═══════════════════════════════════════════════

; 記憶體困難混合函數（RFC 7914 §5，亦稱 ROMix）
; 先填充 n 個區塊的 V 表，再做 n 次隨機索引讀取 + BlockMix，最終得到新的 128*r 位元組。
; b []byte: 輸入區塊（128*r 位元組）
; n i64: CPU/記憶體成本參數，須為大於 1 的 2 的冪（如 16384）
; r i64: 區塊大小參數，決定每個子區塊的 64 位元組塊數
; 返回 out []byte: 混合後的區塊（長度 128*r）
; [scrypt-romix](#scrypt.scrypt-romix)
scrypt-romix = (b []byte, n i64, r i64) (out []byte) {

    #{overflow=wrap}
    out = with-cap(2 * r * 64)

    #{overflow=wrap}
    block-bytes = 128 * r

    ; V 陣列：n 個區塊，每個 block-bytes 位元組
    ; 由於記憶體限制，逐塊處理

    ; X = B
    x []byte
    i <- [0..block-bytes): {

        #{index-out=zero}
        x[i]: {
            ok -> it = b[i]

            -> _
        }
    }

    ; 第一階段：填充 V
    ; V[0] = X, V[i] = BlockMix(V[i-1])
    v []byte
    i <- [0..block-bytes): {

        #{index-out=zero}
        v[i]: {
            ok -> it = x[i]

            -> _
        }
    }
    n-idx = 1
    (n-idx < n) {

        ; X = BlockMix(X)
        mixed = scrypt-blockmix(x, r)
        i <- [0..block-bytes): {

            #{index-out=zero}
            x[i]: {
                ok -> it = mixed[i]

                -> _
            }

            #{index-out=zero, overflow=wrap}
            v[n-idx * block-bytes + i]: {
                ok -> it = mixed[i]

                -> _
            }
        }

        #{overflow=wrap}
        n-idx = n-idx + 1
    }

    ; 第一階段結束後，X 需再套用一次 BlockMix（標準 ROMix：X = BlockMix^N(B)）
    x = scrypt-blockmix(x, r)

    ; 第二階段：偽隨機存取
    n-idx = 0
    (n-idx < n) {

        ; j = Integerify(X) mod N
        ; Integerify: 將 X 的最後 64 位元組的前 8 位元組解釋為小端整數（取 mod N）
        ; 用 Horner 法逐位元組累積，避免 byte<<56 在 i64 造成符號負值
        #{overflow=wrap}
        base-j = (2 * r - 1) * 64
        j = 0
        k <- [0..8): {

            #{index-out=zero, overflow=wrap}
            j = (j * 256 + x[base-j + (7 - k)]) % n
        }

        ; X = X XOR V[j]
        i <- [0..block-bytes): {

            #{index-out=zero}
            x[i]: {
                ok -> it = (x[i]) ^ (v[j * block-bytes + i])

                -> _
            }
        }

        ; X = BlockMix(X)
        mixed = scrypt-blockmix(x, r)
        i <- [0..block-bytes): {

            #{index-out=zero}
            x[i]: {
                ok -> it = mixed[i]

                -> _
            }
        }

        #{overflow=wrap}
        n-idx = n-idx + 1
    }

    ; 輸出 X
    i <- [0..block-bytes): {

        #{index-out=zero}
        out[i] = x[i]
    }
}

; ═══════════════════════════════════════════════
; Scrypt 公開 API
; ═══════════════════════════════════════════════

; Scrypt 金鑰推導（RFC 7914 §7）
; 先以 PBKDF2-HMAC-SHA256(迭代 1 次) 把密碼展開為 p*128*r 位元組，
; 逐段做 ROMix，最後再做一輪 PBKDF2 輸出 key-len 位元組。
; password []byte: 密碼（UTF-8 位元組序列）
; salt []byte: 鹽值，建議 16 位元組以上且每帳號不同
; n i64: CPU/記憶體成本，須為大於 1 的 2 的冪；越大越安全也越慢
; r i64: 區塊大小（如 8），與 n 共同決定記憶體用量 128*n*r 位元組
; p i64: 並行度（如 1），影響 CPU 時間
; key-len i64: 期望金鑰長度（位元組）
; 返回 out []byte: 推導出的金鑰，長度恰為 key-len
; [scrypt](#scrypt.scrypt)
scrypt = (password []byte, salt []byte, n i64, r i64, p i64, key-len i64) (out []byte) {

    ; 1. B = PBKDF2-HMAC-SHA256(password, salt, 1, p * 128 * r)
    #{overflow=wrap}
    b-len = p * 128 * r
    b []byte
    b = pbkdf2.pbkdf2-hmac-sha256(password, salt, 1, b-len)

    ; 2. For i = 0 to p-1: B_i = ROMix(B_i, N, r)
    #{overflow=wrap}
    block-bytes = 128 * r
    i <- [0..p): {

        ; 提取 B_i
        b-i []byte
        j <- [0..block-bytes): {

            #{index-out=zero, overflow=wrap}
            b-i[j]: {
                ok -> it = b[i * block-bytes + j]

                -> _
            }
        }

        ; ROMix
        mixed = scrypt-romix(b-i, n, r)

        ; 寫回 B
        j <- [0..block-bytes): {

            #{index-out=zero, overflow=wrap}
            b[i * block-bytes + j]: {
                ok -> it = mixed[j]

                -> _
            }
        }
    }

    ; 3. DK = PBKDF2-HMAC-SHA256(password, B, 1, key-len)
    out = pbkdf2.pbkdf2-hmac-sha256(password, b, 1, key-len)
}
