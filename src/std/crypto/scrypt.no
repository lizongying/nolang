            -> _
        }

        ixout191c49 = x[1]: {
            ok -> it

            -> _
        }

        x[3]: {
            ok -> it = (ixout191c26 ^ (rotl32((ixout191c42 + ixout191c49) & mask, 13))) & mask

            -> _
