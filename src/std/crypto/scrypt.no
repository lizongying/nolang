        ixout107c42 = x[12]: {
            ok -> it

            -> _
        }

        ixout107c50 = x[8]: {
            ok -> it

            -> _
        }

        x[0]: {
            ok -> it = (ixout107c26 ^ (rotl32((ixout107c42 + ixout107c50) & mask, 18))) & mask

            -> _
        }

        ; QR(x[5], x[9], x[13], x[1])
        ixout114c26 = x[9]: {
            ok -> it

            -> _
        }

        ixout114c42 = x[5]: {
            ok -> it

            -> _
        }

        ixout114c49 = x[1]: {
            ok -> it

            -> _
