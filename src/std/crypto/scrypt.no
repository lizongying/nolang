; scrypt — Scrypt 記憶體困難金鑰推導函數（RFC 7914）
;
; Scrypt 設計為記憶體困難的 KDF，抵抗 ASIC/GPU 破解。
; 使用 PBKDF2-HMAC-SHA256 + Salsa20/8 核心函數。
;
; 用法：
;   # std/crypto/scrypt
;   password []byte = 'password'
;   salt []byte = 'salt'
;   N = 16384    // CPU/Memory 參數（必須是 2 的冪）
;   r = 8        // 區塊大小參數
;   p = 1        // 並行參數
;   key-len = 32
;   derived = scrypt(password, salt, N, r, p, key-len)
; [scrypt](#scrypt)

; 32-bit 循環左移（用於 Salsa20 quarter-round 的旋轉）
; x u32: 要旋轉的 32 位元值
; n i64: 左旋位元數（0..31；32 會使移位量溢出）
; r u32: 左旋結果，已 & 0xFFFFFFFF
; [rotl32](#scrypt.rotl32)
rotl32 = (x u32, n i64) (r u32) {
    mask u32 = 4294967295

    r = ((x >> (32 - n)) | (x << n)) & mask
}

; Salsa20/8 核心函數
...

; Salsa20/8 核心：對 64 位元組區塊進行 8 輪混合
; 先讀入 16 個小端 32-bit 字，執行 8 輪 add-rotate-xor 後再與原值相加並寫回。
; block []byte: 64 位元組輸入/輸出；原地修改，少於 64 位元組時缺失部分按 0 處理
; [salsa20-8-core](#scrypt.salsa20-8-core)
salsa20-8-core = (block []byte) {

    ; 載入 16 個 32-bit 字（小端序）
    x [16]u32
    i <- [0..16): {

        #{overflow=wrap}
        off = i * 4

        ixout46c25 = block[off]: {
            ok -> it

            -> _
        }

        ixout46c41 = block[off + 1]: {
            ok -> it

            -> _
        }

        ixout46c67 = block[off + 2]: {
            ok -> it

            -> _
        }

        ixout46c94 = block[off + 3]: {
            ok -> it

            -> _
        }

        x[i]: {
            ok -> it = (ixout46c25) | ((ixout46c41) << 8) | ((ixout46c67) << 16) | ((ixout46c94) << 24)

            -> _
        }
    }

    ; 保存初始值
    init [16]u32
    i <- [0..16): {
        init[i]: {
            ok -> it = x[i]: {
                ok -> it

                -> _
            }

            -> _
        }
    }

    ; 8 輪（4 次雙輪）
    mask u32 = 4294967295
    round <- [0..4): {

        ; 列輪
        ; QR(x[0], x[4], x[8], x[12])
        ixout92c26 = x[4]: {
            ok -> it

            -> _
        }

        ixout92c42 = x[0]: {
            ok -> it

            -> _
        }

        ixout92c49 = x[12]: {
            ok -> it

            -> _
        }

        x[4]: {
            ok -> it = (ixout92c26 ^ (rotl32((ixout92c42 + ixout92c49) & mask, 7))) & mask

            -> _
        }
        ixout97c26 = x[8]: {
            ok -> it

            -> _
        }

        ixout97c42 = x[4]: {
            ok -> it

            -> _
        }

        ixout97c49 = x[0]: {
            ok -> it

            -> _
        }

        x[8]: {
            ok -> it = (ixout97c26 ^ (rotl32((ixout97c42 + ixout97c49) & mask, 9))) & mask

            -> _
        }
        ixout102c26 = x[12]: {
            ok -> it

            -> _
        }

        ixout102c43 = x[8]: {
            ok -> it

            -> _
        }

        ixout102c50 = x[4]: {
            ok -> it

            -> _
