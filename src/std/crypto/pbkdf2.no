; pbkdf2 — PBKDF2 金鑰推導函數（RFC 2898 / PKCS#5 v2.0）
;
; 使用 HMAC-SHA256 作為偽隨機函數（PRF），通過迭代派生金鑰。
;
; 用法：
;   # std/crypto/pbkdf2
;   password []byte = 'password'
;   salt []byte = 'salt'
;   iterations = 10000
;   key-len = 32
;   derived = pbkdf2-hmac-sha256(password, salt, iterations, key-len)

; ═══════════════════════════════════════════════
; PBKDF2-HMAC-SHA256
; ═══════════════════════════════════════════════

; pbkdf2-hmac-sha256: PBKDF2 使用 HMAC-SHA256
; password []byte: 密碼
; salt []byte: 鹽值
; iterations i64: 迭代次數
; key-len i64: 期望金鑰長度（位元組）
; 返回 out []byte: 推導出的金鑰
pbkdf2-hmac-sha256 = (password []byte, salt []byte, iterations i64, key-len i64) (out []byte) {

    ; HMAC-SHA256 輸出為 32 位元組
    #{overflow=wrap}
    h-len = 32

    ; 計算需要多少個區塊
    #{overflow=wrap}
    blocks = (key-len + h-len - 1) / h-len

    out = with-len(key-len)
    block-idx = 1
    out-pos = 0
    (block-idx <= blocks) {

        ; 構建 U1 的輸入: salt || INT_32_BE(block_idx)
        #{overflow=wrap}
        salt-len = salt.len()
        u-input []byte
        i <- [0..salt-len): {

            #{index-out=0, overflow=wrap}
            u-input[i] = salt[i]
        }

        ; INT_32_BE(block_idx)
        #{index-out=0}
        u-input[salt-len] = (block-idx >> 24) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 1] = (block-idx >> 16) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 2] = (block-idx >> 8) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 3] = block-idx & 255

        ; U1 = HMAC(password, salt || INT_32_BE(block_idx))
        u [32]byte
        u = hmac.hmac-sha256(password, u-input)

        ; T = U1
        t [32]byte
        i <- [0..32): {

            #{index-out=0, overflow=wrap}
            t[i] = u[i]
        }

        ; U2..Uc
        iter <- [1..iterations): {

            ; U_{iter+1} = HMAC(password, U_iter)
            #{overflow=wrap}
            u = hmac.hmac-sha256(password, u)

            ; T = T XOR U
            i <- [0..32): {

                #{index-out=0, overflow=wrap}
                t[i] = t[i] ^ u[i]
            }
        }

        ; 輸出到 out（最後一個區塊可能截斷）
        copy-len = h-len

        #{overflow=wrap}
        out-pos + copy-len > key-len -> copy-len = key-len - out-pos
        i <- [0..copy-len): {

            #{index-out=0, overflow=wrap}
            out[out-pos + i] = t[i]
        }

        #{overflow=wrap}
        out-pos = out-pos + copy-len

        #{overflow=wrap}
        block-idx = block-idx + 1
    }
}

; ═══════════════════════════════════════════════
; PBKDF2-HMAC-SHA512
; ═══════════════════════════════════════════════

; pbkdf2-hmac-sha512: PBKDF2 使用 HMAC-SHA512
; password []byte: 密碼
; salt []byte: 鹽值
; iterations i64: 迭代次數
; key-len i64: 期望金鑰長度（位元組）
; 返回 out []byte: 推導出的金鑰
pbkdf2-hmac-sha512 = (password []byte, salt []byte, iterations i64, key-len i64) (out []byte) {

    #{overflow=wrap}
    h-len = 64

    #{overflow=wrap}
    blocks = (key-len + h-len - 1) / h-len

    out = with-len(key-len)
    block-idx = 1
    out-pos = 0
    (block-idx <= blocks) {

        #{overflow=wrap}
        u-input []byte
        salt-len = salt.len()
        i <- [0..salt-len): {

            #{index-out=0, overflow=wrap}
            u-input[i] = salt[i]
        }

        #{index-out=0}
        u-input[salt-len] = (block-idx >> 24) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 1] = (block-idx >> 16) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 2] = (block-idx >> 8) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 3] = block-idx & 255

        u [64]byte
        u = hmac.hmac-sha512(password, u-input)

        t [64]byte
        i <- [0..64): {

            #{index-out=0, overflow=wrap}
            t[i] = u[i]
        }
        iter <- [1..iterations): {

            #{overflow=wrap}
            u = hmac.hmac-sha512(password, u)
            i <- [0..64): {

                #{index-out=0, overflow=wrap}
                t[i] = t[i] ^ u[i]
            }
        }
        copy-len = h-len

        #{overflow=wrap}
        out-pos + copy-len > key-len -> copy-len = key-len - out-pos
        i <- [0..copy-len): {

            #{index-out=0, overflow=wrap}
            out[out-pos + i] = t[i]
        }

        #{overflow=wrap}
        out-pos = out-pos + copy-len

        #{overflow=wrap}
        block-idx = block-idx + 1
    }
}

; ═══════════════════════════════════════════════
; PBKDF2-HMAC-SHA1
; ═══════════════════════════════════════════════

; pbkdf2-hmac-sha1: PBKDF2 使用 HMAC-SHA1
; password []byte: 密碼
; salt []byte: 鹽值
; iterations i64: 迭代次數
; key-len i64: 期望金鑰長度（位元組）
; 返回 out []byte: 推導出的金鑰
pbkdf2-hmac-sha1 = (password []byte, salt []byte, iterations i64, key-len i64) (out []byte) {

    #{overflow=wrap}
    h-len = 20

    #{overflow=wrap}
    blocks = (key-len + h-len - 1) / h-len

    out = with-len(key-len)
    block-idx = 1
    out-pos = 0
    (block-idx <= blocks) {

        #{overflow=wrap}
        u-input []byte
        salt-len = salt.len()
        i <- [0..salt-len): {

            #{index-out=0, overflow=wrap}
            u-input[i] = salt[i]
        }

        #{index-out=0}
        u-input[salt-len] = (block-idx >> 24) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 1] = (block-idx >> 16) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 2] = (block-idx >> 8) & 255

        #{index-out=0, overflow=wrap}
        u-input[salt-len + 3] = block-idx & 255

        u [20]byte
        u = hmac.hmac-sha1(password, u-input)

        t [20]byte
        i <- [0..20): {

            #{index-out=0, overflow=wrap}
            t[i] = u[i]
        }
        iter <- [1..iterations): {

            #{overflow=wrap}
            u = hmac.hmac-sha1(password, u)
            i <- [0..20): {

                #{index-out=0, overflow=wrap}
                t[i] = t[i] ^ u[i]
            }
        }
        copy-len = h-len

        #{overflow=wrap}
        out-pos + copy-len > key-len -> copy-len = key-len - out-pos
        i <- [0..copy-len): {

            #{index-out=0, overflow=wrap}
            out[out-pos + i] = t[i]
        }

        #{overflow=wrap}
        out-pos = out-pos + copy-len

        #{overflow=wrap}
        block-idx = block-idx + 1
    }
}
