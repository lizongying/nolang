; pbkdf2 — PBKDF2 金鑰推導函數（RFC 2898 / PKCS#5 v2.0）
;
; 使用 HMAC-SHA256 作為偽隨機函數（PRF），通過迭代派生金鑰。
;
; 用法：
;   # std/crypto/pbkdf2
;   password []byte = 'password'
;   salt []byte = 'salt'
;   iterations = 10000
;   key-len = 32
;   derived = pbkdf2-hmac-sha256(password, salt, iterations, key-len)
; [pbkdf2](#pbkdf2)

; PBKDF2-HMAC-SHA256
...

; PBKDF2 使用 HMAC-SHA256
; password []byte: 密碼（UTF-8 位元組序列）
; salt []byte: 鹽值，建議至少 16 位元組且每個帳號不同
; iterations i64: 迭代次數；越大越難暴力破解（常見 100000 以上），太小則不安全
; key-len i64: 期望金鑰長度（位元組），按 32 位元組一塊逐塊生成
; 返回 out []byte: 推導出的金鑰，長度恰為 key-len
; [pbkdf2-hmac-sha256](#pbkdf2.pbkdf2-hmac-sha256)
pbkdf2-hmac-sha256 = (password []byte, salt []byte, iterations i64, key-len i64) (out []byte) {

    ; HMAC-SHA256 輸出為 32 位元組
    h-len = 32

    ; 計算需要多少個區塊
    #{overflow=wrap}
    blocks = (key-len + h-len - 1) / h-len

    out = with-len(key-len)
    block-idx = 1
    out-pos = 0
    (block-idx <= blocks) {

        ; 構建 U1 的輸入: salt || INT_32_BE(block_idx)
        salt-len = salt.len()
        u-input []byte
        i <- [0..salt-len): {
            {
                u-input[i] ?= salt[i]
            }: {
                err -> _

                -> _
            }
        }

        ; INT_32_BE(block_idx)
        u-input[salt-len]: {
            ok -> it = (block-idx >> 24) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 1]: {
            ok -> it = (block-idx >> 16) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 2]: {
            ok -> it = (block-idx >> 8) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 3]: {
            ok -> it = block-idx & 255

            -> _
        }

        ; U1 = HMAC(password, salt || INT_32_BE(block_idx))
        u [32]byte
        u = hmac.hmac-sha256(password, u-input)

        ; T = U1
        t [32]byte
        i <- [0..32): {
            t[i]: {
                ok -> it = u[i]: {
                    ok -> it

                    -> _
                }

                -> _
            }
        }

        ; U2..Uc
        iter <- [1..iterations): {

            ; U_{iter+1} = HMAC(password, U_iter)
            u = hmac.hmac-sha256(password, u)

            ; T = T XOR U
            i <- [0..32): {
                ixout107c33 = t[i]: {
                    ok -> it

                    -> _
                }

                ixout107c40 = u[i]: {
                    ok -> it

                    -> _
                }

                t[i]: {
                    ok -> it = ixout107c33 ^ ixout107c40

                    -> _
                }
            }
        }

        ; 輸出到 out（最後一個區塊可能截斷）
        copy-len = h-len

        #{overflow=wrap}
        out-pos + copy-len > key-len -> {
            {

                #{overflow=wrap}
                copy-len-opt = key-len - out-pos
                copy-len-opt: {
                    ok -> copy-len = it

                    ->
                }
            }
        }
        i <- [0..copy-len): {
            {

                #{overflow=wrap}
                out[out-pos + i] ?= t[i]
            }: {
                err -> _

                -> _
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            out-pos-opt = out-pos + copy-len
            out-pos-opt: {
                ok -> out-pos = it

                ->
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            block-idx-opt = block-idx + 1
            block-idx-opt: {
                ok -> block-idx = it

                ->
            }
        }
    }
}

; PBKDF2-HMAC-SHA512
...

; PBKDF2 使用 HMAC-SHA512
; password []byte: 密碼（UTF-8 位元組序列）
; salt []byte: 鹽值，建議至少 16 位元組且每個帳號不同
; iterations i64: 迭代次數；越大越難暴力破解，太小則不安全
; key-len i64: 期望金鑰長度（位元組），按 64 位元組一塊逐塊生成
; 返回 out []byte: 推導出的金鑰，長度恰為 key-len
; [pbkdf2-hmac-sha512](#pbkdf2.pbkdf2-hmac-sha512)
pbkdf2-hmac-sha512 = (password []byte, salt []byte, iterations i64, key-len i64) (out []byte) {
    h-len = 64

    #{overflow=wrap}
    blocks = (key-len + h-len - 1) / h-len

    out = with-len(key-len)
    block-idx = 1
    out-pos = 0
    (block-idx <= blocks) {
        u-input []byte
        salt-len = salt.len()
        i <- [0..salt-len): {
            {
                u-input[i] ?= salt[i]
            }: {
                err -> _

                -> _
            }
        }

        u-input[salt-len]: {
            ok -> it = (block-idx >> 24) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 1]: {
            ok -> it = (block-idx >> 16) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 2]: {
            ok -> it = (block-idx >> 8) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 3]: {
            ok -> it = block-idx & 255

            -> _
        }

        u [64]byte
        u = hmac.hmac-sha512(password, u-input)

        t [64]byte
        i <- [0..64): {
            t[i]: {
                ok -> it = u[i]: {
                    ok -> it

                    -> _
                }

                -> _
            }
        }
        iter <- [1..iterations): {
            u = hmac.hmac-sha512(password, u)
            i <- [0..64): {
                ixout219c33 = t[i]: {
                    ok -> it

                    -> _
                }

                ixout219c40 = u[i]: {
                    ok -> it

                    -> _
                }

                t[i]: {
                    ok -> it = ixout219c33 ^ ixout219c40

                    -> _
                }
            }
        }
        copy-len = h-len

        #{overflow=wrap}
        out-pos + copy-len > key-len -> {
            {

                #{overflow=wrap}
                copy-len-opt2 = key-len - out-pos
                copy-len-opt2: {
                    ok -> copy-len = it

                    ->
                }
            }
        }
        i <- [0..copy-len): {
            {

                #{overflow=wrap}
                out[out-pos + i] ?= t[i]
            }: {
                err -> _

                -> _
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            out-pos-opt2 = out-pos + copy-len
            out-pos-opt2: {
                ok -> out-pos = it

                ->
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            block-idx-opt2 = block-idx + 1
            block-idx-opt2: {
                ok -> block-idx = it

                ->
            }
        }
    }
}

; PBKDF2-HMAC-SHA1
...

; PBKDF2 使用 HMAC-SHA1
; 僅供相容舊協議；新設計請用 SHA-256 / SHA-512 版本。
; password []byte: 密碼（UTF-8 位元組序列）
; salt []byte: 鹽值
; iterations i64: 迭代次數；越大越難暴力破解，太小則不安全
; key-len i64: 期望金鑰長度（位元組），按 20 位元組一塊逐塊生成
; 返回 out []byte: 推導出的金鑰，長度恰為 key-len
; [pbkdf2-hmac-sha1](#pbkdf2.pbkdf2-hmac-sha1)
pbkdf2-hmac-sha1 = (password []byte, salt []byte, iterations i64, key-len i64) (out []byte) {
    h-len = 20

    #{overflow=wrap}
    blocks = (key-len + h-len - 1) / h-len

    out = with-len(key-len)
    block-idx = 1
    out-pos = 0
    (block-idx <= blocks) {
        u-input []byte
        salt-len = salt.len()
        i <- [0..salt-len): {
            {
                u-input[i] ?= salt[i]
            }: {
                err -> _

                -> _
            }
        }

        u-input[salt-len]: {
            ok -> it = (block-idx >> 24) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 1]: {
            ok -> it = (block-idx >> 16) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 2]: {
            ok -> it = (block-idx >> 8) & 255

            -> _
        }

        #{overflow=wrap}
        u-input[salt-len + 3]: {
            ok -> it = block-idx & 255

            -> _
        }

        u [20]byte
        u = hmac.hmac-sha1(password, u-input)

        t [20]byte
        i <- [0..20): {
            t[i]: {
                ok -> it = u[i]: {
                    ok -> it

                    -> _
                }

                -> _
            }
        }
        iter <- [1..iterations): {
            u = hmac.hmac-sha1(password, u)
            i <- [0..20): {
                ixout330c33 = t[i]: {
                    ok -> it

                    -> _
                }

                ixout330c40 = u[i]: {
                    ok -> it

                    -> _
                }

                t[i]: {
                    ok -> it = ixout330c33 ^ ixout330c40

                    -> _
                }
            }
        }
        copy-len = h-len

        #{overflow=wrap}
        out-pos + copy-len > key-len -> {
            {

                #{overflow=wrap}
                copy-len-opt3 = key-len - out-pos
                copy-len-opt3: {
                    ok -> copy-len = it

                    ->
                }
            }
        }
        i <- [0..copy-len): {
            {

                #{overflow=wrap}
                out[out-pos + i] ?= t[i]
            }: {
                err -> _

                -> _
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            out-pos-opt3 = out-pos + copy-len
            out-pos-opt3: {
                ok -> out-pos = it

                ->
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            block-idx-opt3 = block-idx + 1
            block-idx-opt3: {
                ok -> block-idx = it

                ->
            }
        }
    }
}
