; aes-cbc — AES-CBC 加密/解密模式（AES-128 與 AES-256）
;
; 在 AES 區塊加密器之上實作 CBC（Cipher Block Chaining）模式。
; CBC 加密: C_i = AES_enc(P_i ⊕ C_{i-1}), C_0 = IV
; CBC 解密: P_i = AES_dec(C_i) ⊕ C_{i-1}, C_0 = IV
;
; 金鑰長度不是檔案維度：同一份 CBC 邏輯服務 AES-128 與 AES-256，
; 差別只在入口用 aes.key-expand 還是 aes.key-expand-256。
;
; 用法：
;   iv [16]byte
;   key [16]byte
;   padded = aes-cbc.pkcs7-pad(plain)
;   cipher = aes-cbc.enc-128(padded, key, iv)
;   plain  = aes-cbc.dec-128(cipher, key, iv)
;   n      = aes-cbc.pkcs7-unpad(plain)
;   ; AES-256 改用 key [32]byte 與 enc-256 / dec-256

; AES 區塊大小
AES-BLOCK-SIZE = 16

; CBC 加密核心（輪金鑰由呼叫端展開一次）
; 每塊先與前一段密文異或再跑 AES-ECB；不做填充，不足 16 位元組的尾部會被丟棄。
; in []byte: 輸入資料（長度需為 16 的倍數）
; iv [16]byte: 初始向量；同一金鑰下不可重複使用
; ek []byte: aes.key-expand / aes.key-expand-256 展開後的輪金鑰
; 返回 out []byte: 加密後的密文，長度與 in 相同
; [cbc-enc](#aes-cbc.cbc-enc)
cbc-enc = (in []byte, iv [16]byte, ek []byte) (out []byte) {

    ; 上一個密文區塊（初始為 IV）
    prev [16]byte
    i <- [0..16): {

        prev[i]: {
            ok -> it = iv[i]
            -> _
        }
    }

    ; 逐區塊加密
    out = with-len(in.len())
    blk = 0
    (blk < in.len()) {

        ; XOR 當前區塊與 prev
        xored [16]byte
        i <- [0..16): {

            #{index-out=zero}
            xored[i]: {
                ok -> it = (in[blk + i]) ^ (prev[i])
                -> _
            }
        }

        ; AES 加密
        enc-blk [16]byte
        enc-blk = aes.enc-block(xored, ek)

        ; 輸出密文
        i <- [0..16): {

            #{overflow=wrap}
            out[blk + i] = enc-blk[i]
        }

        ; 更新 prev 為當前密文區塊
        i <- [0..16): {

            #{overflow=wrap}
            prev[i]: {
                ok -> it = out[blk + i]
                -> _
            }
        }

        #{overflow=wrap}
        blk = blk + 16
    }
}

; CBC 解密核心（輪金鑰由呼叫端展開一次）
; 每塊先跑 AES-ECB 解密，再與前一段密文異或；不校驗填充。
; in []byte: 輸入密文（長度需為 16 的倍數）
; iv [16]byte: 初始向量，必須與加密時相同
; ek []byte: aes.key-expand / aes.key-expand-256 展開後的輪金鑰
; 返回 out []byte: 解密後的明文，長度與 in 相同（仍帶著 PKCS#7 填充）
; [cbc-dec](#aes-cbc.cbc-dec)
cbc-dec = (in []byte, iv [16]byte, ek []byte) (out []byte) {

    ; 上一個密文區塊（初始為 IV）
    prev [16]byte
    i <- [0..16): {

        prev[i]: {
            ok -> it = iv[i]
            -> _
        }
    }

    ; 逐區塊解密
    out = with-len(in.len())
    blk = 0
    (blk < in.len()) {

        ; 保存當前密文區塊（解密前）
        cur-cipher [16]byte
        i <- [0..16): {

            #{index-out=zero, overflow=wrap}
            cur-cipher[i]: {
                ok -> it = in[blk + i]
                -> _
            }
        }

        ; AES 解密
        dec-blk [16]byte
        dec-blk = aes.dec-block(cur-cipher, ek)

        ; XOR 與 prev 得到明文
        i <- [0..16): {

            #{overflow=wrap}
            out[blk + i] = (dec-blk[i]) ^ (prev[i])
        }

        ; 更新 prev 為當前密文區塊
        i <- [0..16): {

            prev[i]: {
                ok -> it = cur-cipher[i]
                -> _
            }
        }

        #{overflow=wrap}
        blk = blk + 16
    }
}

; AES-128-CBC 加密
; 展開 16 位元組金鑰後走 cbc-enc；不做填充，明文長度需自行補到 16 的倍數。
; in []byte: 輸入資料（長度需為 16 的倍數）
; key [16]byte: 128-bit 金鑰
; iv [16]byte: 初始向量，每個訊息應隨機且唯一
; 返回 out []byte: 加密後的密文，長度與 in 相同
; [enc-128](#aes-cbc.enc-128)
enc-128 = (in []byte, key [16]byte, iv [16]byte) (out []byte) {
    ek = aes.key-expand(key)
    out = cbc-enc(in, iv, ek)
}

; AES-128-CBC 解密
; in []byte: 輸入密文（長度需為 16 的倍數）
; key [16]byte: 128-bit 金鑰，必須與加密時一致
; iv [16]byte: 初始向量，必須與加密時一致
; 返回 out []byte: 解密結果（仍含 PKCS#7 填充，需再用 pkcs7-unpad 去除）
; [dec-128](#aes-cbc.dec-128)
dec-128 = (in []byte, key [16]byte, iv [16]byte) (out []byte) {
    ek = aes.key-expand(key)
    out = cbc-dec(in, iv, ek)
}

; AES-256-CBC 加密
; 使用 32 位元組（14 輪）金鑰；其餘行為同 enc-128。
; in []byte: 輸入資料（長度需為 16 的倍數）
; key [32]byte: 256-bit 金鑰
; iv [16]byte: 初始向量，每個訊息應隨機且唯一
; 返回 out []byte: 加密後的密文，長度與 in 相同
; [enc-256](#aes-cbc.enc-256)
enc-256 = (in []byte, key [32]byte, iv [16]byte) (out []byte) {
    ek = aes.key-expand-256(key)
    out = cbc-enc(in, iv, ek)
}

; AES-256-CBC 解密
; in []byte: 輸入密文（長度需為 16 的倍數）
; key [32]byte: 256-bit 金鑰，必須與加密時一致
; iv [16]byte: 初始向量，必須與加密時一致
; 返回 out []byte: 解密結果（仍含 PKCS#7 填充，需再用 pkcs7-unpad 去除）
; [dec-256](#aes-cbc.dec-256)
dec-256 = (in []byte, key [32]byte, iv [16]byte) (out []byte) {
    ek = aes.key-expand-256(key)
    out = cbc-dec(in, iv, ek)
}

; PKCS#7 填充
; 總是追加 1–16 個值為 n 的位元組（明文已是 16 的倍數時追加一整塊 16）。
; in []byte: 輸入資料
; 返回 out []byte: 填充後的資料（長度為 16 的倍數，且嚴格大於原長）
; [pkcs7-pad](#aes-cbc.pkcs7-pad)
pkcs7-pad = (in []byte) (out []byte) {

    #{overflow=wrap}
    pad-len = 16 - (in.len() % 16)
    pad-len == 0 -> pad-len = 16

    #{overflow=wrap}
    out = with-len(in.len() + pad-len)
    i <- [0..in.len()): {

        #{index-out=zero}
        out[i] = in[i]
    }
    i <- [0..pad-len): {

        #{overflow=wrap}
        out[in.len() + i] = pad-len
    }
}

; PKCS#7 去填充
; 讀取最後一個位元組作為填充長度，並校驗末尾 pad-len 個位元組都等於該值。
; in []byte: 解密後的資料（含 PKCS#7 填充；長度為 0 視為填充錯誤）
; out-n i64: 去填充後的有效長度；填充值非法、越界或校驗不符時為 -1
; [pkcs7-unpad](#aes-cbc.pkcs7-unpad)
pkcs7-unpad = (in []byte) (out-n i64) {

    in.len() == 0 -> {
        out-n = -1
        return
    }

    #{index-out=zero, overflow=wrap}
    pad-len = in[in.len() - 1]
    pad-len == 0 || pad-len > 16 -> {
        out-n = -1
        return
    }

    ; 驗證填充
    i <- [0..pad-len): {

        (in[in.len() - 1 - i]) != pad-len -> {
            out-n = -1
            return
        }
    }

    #{overflow=wrap}
    out-n = in.len() - pad-len
}
