; aes-cbc — AES-CBC 加密/解密模式（AES-128 與 AES-256）
;
; 在 AES 區塊加密器之上實作 CBC（Cipher Block Chaining）模式。
; CBC 加密: C_i = AES_enc(P_i ⊕ C_{i-1}), C_0 = IV
; CBC 解密: P_i = AES_dec(C_i) ⊕ C_{i-1}, C_0 = IV
;
; 金鑰長度不是檔案維度：同一份 CBC 邏輯服務 AES-128 與 AES-256，
; 差別只在入口用 aes.key-expand 還是 aes.key-expand-256。
;
; 用法：
;   iv [16]byte
;   key [16]byte
;   padded = aes-cbc.pkcs7-pad(plain)
;   cipher = aes-cbc.enc-128(padded, key, iv)
;   plain  = aes-cbc.dec-128(cipher, key, iv)
;   n      = aes-cbc.pkcs7-unpad(plain)
;   ; AES-256 改用 key [32]byte 與 enc-256 / dec-256

; AES 區塊大小
AES-BLOCK-SIZE = 16

; cbc-enc: CBC 加密核心（輪金鑰由呼叫端展開一次）
; in []byte: 輸入資料（長度需為 16 的倍數）
; iv [16]byte: 初始向量
; ek []byte: aes.key-expand / aes.key-expand-256 的結果
; 返回 out []byte: 加密後的資料
cbc-enc = (in []byte, iv [16]byte, ek []byte) (out []byte) {

    ; 上一個密文區塊（初始為 IV）
    prev [16]byte
    i <- [0..16): {
        #{index-out = 0}
        prev[i] = iv[i]
    }

    ; 逐區塊加密
    out = with-len(in.len())
    blk = 0
    {

        ; XOR 當前區塊與 prev
        #{overflow=wrap}
        xored [16]byte
        i <- [0..16): {
            #{overflow=wrap}
            #{index-out = 0}
            xored[i] = (in[blk + i]) ^ (prev[i])
        }

        ; AES 加密
        enc-blk [16]byte
        enc-blk = aes.enc-block(xored, ek)

        ; 輸出密文
        i <- [0..16): {
            #{overflow=wrap}
            #{index-out = 0}
            out[blk + i] = enc-blk[i]
        }

        ; 更新 prev 為當前密文區塊
        i <- [0..16): {
            #{overflow=wrap}
            #{index-out = 0}
            prev[i] = out[blk + i]
        }
        #{overflow=wrap}
        blk = blk + 16
    } (blk < in.len())
}

; cbc-dec: CBC 解密核心（輪金鑰由呼叫端展開一次）
; in []byte: 輸入密文（長度需為 16 的倍數）
; iv [16]byte: 初始向量
; ek []byte: aes.key-expand / aes.key-expand-256 的結果
; 返回 out []byte: 解密後的資料
cbc-dec = (in []byte, iv [16]byte, ek []byte) (out []byte) {

    ; 上一個密文區塊（初始為 IV）
    prev [16]byte
    i <- [0..16): {
        #{index-out = 0}
        prev[i] = iv[i]
    }

    ; 逐區塊解密
    out = with-len(in.len())
    blk = 0
    {

        ; 保存當前密文區塊（解密前）
        #{overflow=wrap}
        cur-cipher [16]byte
        i <- [0..16): {
            #{overflow=wrap}
            #{index-out = 0}
            cur-cipher[i] = in[blk + i]
        }

        ; AES 解密
        dec-blk [16]byte
        dec-blk = aes.dec-block(cur-cipher, ek)

        ; XOR 與 prev 得到明文
        i <- [0..16): {
            #{overflow=wrap}
            #{index-out = 0}
            out[blk + i] = (dec-blk[i]) ^ (prev[i])
        }

        ; 更新 prev 為當前密文區塊
        i <- [0..16): {
            #{overflow=wrap}
            #{index-out = 0}
            prev[i] = cur-cipher[i]
        }
        #{overflow=wrap}
        blk = blk + 16
    } (blk < in.len())
}

; enc-128: AES-128-CBC 加密
; in []byte: 輸入資料（長度需為 16 的倍數）
; key [16]byte: 金鑰
; iv [16]byte: 初始向量
; 返回 out []byte: 加密後的資料
enc-128 = (in []byte, key [16]byte, iv [16]byte) (out []byte) {
    ek []byte = aes.key-expand(key)
    out = cbc-enc(in, iv, ek)
}

; dec-128: AES-128-CBC 解密
; in []byte: 輸入密文（長度需為 16 的倍數）
; key [16]byte: 金鑰
; iv [16]byte: 初始向量
; 返回 out []byte: 解密後的資料
dec-128 = (in []byte, key [16]byte, iv [16]byte) (out []byte) {
    ek []byte = aes.key-expand(key)
    out = cbc-dec(in, iv, ek)
}

; enc-256: AES-256-CBC 加密
; in []byte: 輸入資料（長度需為 16 的倍數）
; key [32]byte: 金鑰
; iv [16]byte: 初始向量
; 返回 out []byte: 加密後的資料
enc-256 = (in []byte, key [32]byte, iv [16]byte) (out []byte) {
    ek []byte = aes.key-expand-256(key)
    out = cbc-enc(in, iv, ek)
}

; dec-256: AES-256-CBC 解密
; in []byte: 輸入密文（長度需為 16 的倍數）
; key [32]byte: 金鑰
; iv [16]byte: 初始向量
; 返回 out []byte: 解密後的資料
dec-256 = (in []byte, key [32]byte, iv [16]byte) (out []byte) {
    ek []byte = aes.key-expand-256(key)
    out = cbc-dec(in, iv, ek)
}

; pkcs7-pad: PKCS#7 填充
; in []byte: 輸入資料
; 返回 out []byte: 填充後的資料（長度為 16 的倍數）
pkcs7-pad = (in []byte) (out []byte) {
    #{overflow=wrap}
    pad-len = 16 - (in.len() % 16)
    pad-len == 0 -> pad-len = 16
    #{overflow=wrap}
    out = with-len(in.len() + pad-len)
    i <- [0..in.len()): {
        #{overflow=wrap}
        #{index-out = 0}
        out[i] = in[i]
    }
    i <- [0..pad-len): {
        #{overflow=wrap}
        #{index-out = 0}
        out[in.len() + i] = pad-len
    }
}

; pkcs7-unpad: PKCS#7 去填充
; in []byte: 輸入資料（含填充）
; 返回 out-n i64: 去填充後的長度（-1=填充錯誤）
pkcs7-unpad = (in []byte) (out-n i64) {
    #{overflow=wrap}
    in.len() == 0 -> {
        out-n = -1
        return
    }
    #{overflow=wrap}
    #{index-out = 0}
    pad-len = in[in.len() - 1]
    pad-len == 0 || pad-len > 16 -> {
        out-n = -1
        return
    }

    ; 驗證填充
    i <- [0..pad-len): {
        #{overflow=wrap}
        (in[in.len() - 1 - i]) != pad-len -> {
            out-n = -1
            return
        }
    }
    #{overflow=wrap}
    out-n = in.len() - pad-len
}
