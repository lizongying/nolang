; fnv — FNV-1a 哈希函數（32-bit 和 64-bit）
;
; FNV (Fowler-Noll-Vo) 是一個快速非加密哈希函數。
; FNV-1a: hash = (hash XOR byte) * prime
;
; 用法：
;   h32 = fnv-1a-32(data)
;   h64 = fnv-1a-64(data)

; FNV-1a-32 參數
FNV32-OFFSET = 2166136261
FNV32-PRIME = 16777619

; FNV-1a-64 參數
FNV64-OFFSET u64 = 14695981039346656037
FNV64-PRIME u64 = 1099511628211

; 計算 FNV-1a 32-bit 哈希（offset basis 2166136261、prime 16777619）
; data []byte: 輸入位元組，全部參與計算
; hash i64: 32-bit 哈希值（每步乘積後 & 0xFFFFFFFF）
; [fnv-1a-32](#fnv.fnv-1a-32)
fnv-1a-32 = (data []byte) (hash i64) {
    hash = FNV32-OFFSET
    i <- [0..data.len()): {

        #{index-out=zero}
        hash = hash ^ (data[i])

        hash = (hash * FNV32-PRIME) & 4294967295
    }
}

; 計算 FNV-1a 64-bit 哈希（offset basis 14695981039346656037、prime 1099511628211）
; data []byte: 輸入位元組，全部參與計算
; hash u64: 64-bit 哈希值（每步乘法以 mask 截回 64 位元）
; [fnv-1a-64](#fnv.fnv-1a-64)
fnv-1a-64 = (data []byte) (hash u64) {
    mask u64 = 18446744073709551615
    hash = FNV64-OFFSET
    i <- [0..data.len()): {

        #{index-out=zero}
        hash = hash ^ (data[i])

        hash = (hash * FNV64-PRIME) & mask
    }
}
