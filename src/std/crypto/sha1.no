; 計算 SHA-1 雜湊（含填充與多區塊處理）
; data []byte: 輸入位元組陣列（任意長度）
; hash [20]byte: 160-bit 摘要，按 FIPS 180-4 定義的大端序存放
; 注意：SHA-1 已不具碰撞安全性，僅供相容舊協議 / 校驗使用
; [sha1](#sha1.sha1)
sha1 = (data []byte) (hash [20]byte) {

    ; SHA-1 初始狀態
    h0 u32 = 1732584193
    h1 u32 = 4023233417
    h2 u32 = 2562383102
    h3 u32 = 271733878
    h4 u32 = 3285377520

    dlen = data.len()

    ; 計算填充長度
    ; 填充：0x80 + 0x00*pad + 8-byte big-endian bit length
    ; 總長度需為 64 的倍數
    #{overflow=wrap}
    bit-len = dlen * 8

    #{overflow=wrap}
    mod-val = (dlen + 9) % 64
    pad-len = 0

    #{overflow=wrap}
    mod-val != 0 -> pad-len = 64 - mod-val

    #{overflow=wrap}
    total-len = dlen + 1 + pad-len + 8

    ; 建立填充緩衝區：with-len 直接給出 len=total-len 的全零緩衝。
    ; 不可寫成 `padded []byte`（nil、len=0）再用 place-match 填充——
    ; 越界的 ok 臂永不觸發，資料會被靜默丟棄。
    padded []byte = with-len(total-len)

    ; 複製原始資料
    i <- [0..dlen): {

        ixout1177c24 = data[i]: {
            ok -> it

            -> _
        }

        padded[i]: {
            ok -> it = ixout1177c24

            -> _
        }
    }

    ; 填充 0x80
    padded[dlen]: {
        ok -> it = 128

        -> _
    }

    ; 填充 0x00
    i <- [dlen + 1..total-len - 8): {
        padded[i]: {
            ok -> it = 0

            -> _
        }
    }

    ; 填充 bit-len（big-endian 64-bit）
    i <- [0..8): {

        #{overflow=wrap}
        padded[total-len - 8 + i]: {
            ok -> it = (bit-len >> (56 - i * 8)) & 255

            -> _
        }
    }

    ; 處理每個 64 位元組區塊（with-len 預填緩衝：逐字直接下標寫入是合法增長寫法）
    block []u32 = with-len(16)

    offset = 0
    (offset < total-len) {

        ; 將 64 位元組轉為 16 個 32-bit big-endian 字
        ; 注意：必須用普通賦值；option 寫入 ok 分支主體內讀 []byte 會被編譯器錯算 GEP（+0x100）→ digest 錯。
        i <- [0..16): {

            #{overflow=wrap}
            ixout1221c25 = padded[offset + i * 4]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            ixout1221c58 = padded[offset + i * 4 + 1]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            ixout1221c95 = padded[offset + i * 4 + 2]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            ixout1221c130 = padded[offset + i * 4 + 3]: {
                ok -> it

                -> _
            }

            block[i] = (ixout1221c25 << 24) | (ixout1221c58 << 16) | (ixout1221c95 << 8) | ixout1221c130
        }
        h0, h1, h2, h3, h4 = sha1-block(block, h0, h1, h2, h3, h4)

        #{overflow=wrap}
        {
            #{overflow=wrap}
            offset-opt = offset + 64
            offset-opt: {
                ok -> offset = it
                ->
            }
        }
    }

    ; 輸出 20 位元組雜湊值（big-endian）
    hash[0] = (h0 >> 24) & 255

    hash[1] = (h0 >> 16) & 255

    hash[2] = (h0 >> 8) & 255

    hash[3] = h0 & 255

    hash[4] = (h1 >> 24) & 255

    hash[5] = (h1 >> 16) & 255

    hash[6] = (h1 >> 8) & 255

    hash[7] = h1 & 255

    hash[8] = (h2 >> 24) & 255

    hash[9] = (h2 >> 16) & 255

    hash[10] = (h2 >> 8) & 255

    hash[11] = h2 & 255

    hash[12] = (h3 >> 24) & 255

    hash[13] = (h3 >> 16) & 255

    hash[14] = (h3 >> 8) & 255

    hash[15] = h3 & 255

    hash[16] = (h4 >> 24) & 255

    hash[17] = (h4 >> 16) & 255

    hash[18] = (h4 >> 8) & 255

    hash[19] = h4 & 255
}

; 計算 SHA-1 雜湊並返回 hex 字串
; data []byte: 輸入位元組陣列（任意長度）
; hex str: 40 字元小寫十六進位摘要
; [sha1-hex](#sha1.sha1-hex)
sha1-hex = (data []byte) (hex str) {
    hash = sha1(data)

    hex-chars = '0123456789abcdef'
    hex str = with-len(40)

    i <- [0..20): {

        ixout1627c39 = hash[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hex[i * 2]: {
            ok -> it = hex-chars[(ixout1627c39 >> 4) & 15]

            -> _
        }

        ixout1634c38 = hash[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hex[i * 2 + 1]: {
            ok -> it = hex-chars[ixout1634c38 & 15]

            -> _
        }
    }
}
