; hmac — HMAC 金鑰雜湊訊息認證碼（RFC 2104）
;
; 實作 RFC 2104 定義的 HMAC 演算法，支援多種底層雜湊函數。
; HMAC(K, m) = H((K' ⊕ opad) || H((K' ⊕ ipad) || m))
;
; 支援的變體：
;   hmac-sha1(key, msg) -> [20]byte
;   hmac-sha256(key, msg) -> [32]byte
;   hmac-sha384(key, msg) -> [48]byte
;   hmac-sha512(key, msg) -> [64]byte
;   hmac-md5(key, msg) -> [16]byte
;
; 用法：
;   key []byte
;   msg []byte = 'hello'
;   out = hmac-sha256(key, msg)
;   // out 為 [32]byte 雜湊值

; ─── 常量 ─────────────────────────────────────────

; SHA-256 區塊大小（位元組）
HMAC-BLOCK-SIZE = 64

; SHA-256 輸出大小（位元組）
HMAC-HASH-SIZE = 32

; ipad / opad 常量
HMAC-IPAD = 54
HMAC-OPAD = 92

; ─── HMAC-SHA256 ─────────────────────────────────

; 計算 HMAC-SHA256
; key: 雜湊金鑰（超過底層雜湊區塊長度 64 位元組時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out [32]byte: 32 位元組 HMAC 值
; [hmac-sha256](#hmac.hmac-sha256)
hmac-sha256 = (key []byte, msg []byte) (out [32]byte) {
    key-n = key.len()
    msg-n = msg.len()

    ; K': 將金鑰調整為區塊大小（64 位元組）
    ; 若金鑰 > 64 位元組，先雜湊；若 < 64 位元組，補零
    k [64]byte
    i <- [0..64): {

        k[i]: {
            ok -> it = 0
            -> _
        }
    }
    {
        key-n <= 64 -> {
            i <- [0..key-n): {

                #{index-out=zero}
                k[i]: {
                    ok -> it = key[i]
                    -> _
                }
            }
        }

        -> {

            ; 金鑰太長，先雜湰
            h = sha256.sha256(key)
            i <- [0..32): {

                k[i]: {
                    ok -> it = h[i]
                    -> _
                }
            }
        }
    }

    ; ipad-key = K' ⊕ ipad
    ipad-key [64]byte
    i <- [0..64): {

        ipad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-IPAD
            -> _
        }
    }

    ; opad-key = K' ⊕ opad
    opad-key [64]byte
    i <- [0..64): {

        opad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-OPAD
            -> _
        }
    }

    ; inner = H(ipad-key || msg)
    inner-data []byte = with-len(64 + msg-n)
    i <- [0..64): {

        inner-data[i]: {
            ok -> it = ipad-key[i]
            -> _
        }
    }
    i <- [0..msg-n): {

        #{index-out=zero, overflow=wrap}
        inner-data[64 + i]: {
            ok -> it = msg[i]
            -> _
        }
    }
    inner-hash = sha256.sha256(inner-data)

    ; outer = H(opad-key || inner)
    outer-data []byte = with-len(96)
    i <- [0..64): {

        outer-data[i]: {
            ok -> it = opad-key[i]
            -> _
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        outer-data[64 + i]: {
            ok -> it = inner-hash[i]
            -> _
        }
    }
    out = sha256.sha256(outer-data)
}

; 計算 HMAC-SHA256，返回 []byte（方便串接）
; key: 雜湊金鑰（超過 64 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out []byte: 32 位元組 HMAC 值
; [hmac-sha256-vec](#hmac.hmac-sha256-vec)
hmac-sha256-vec = (key []byte, msg []byte) (out []byte) {
    h [32]byte
    h = hmac-sha256(key, msg)
    out = h[..32)
    out.truncate(32)
}

; ─── HMAC-SHA1 ──────────────────────────────────

; HMAC-SHA1 區塊大小
HMAC-SHA1-BLOCK-SIZE = 64

; HMAC-SHA1 輸出大小
HMAC-SHA1-HASH-SIZE = 20

; 計算 HMAC-SHA1
; key: 雜湊金鑰（超過 64 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out [20]byte: 20 位元組 HMAC 值
; [hmac-sha1](#hmac.hmac-sha1)
hmac-sha1 = (key []byte, msg []byte) (out [20]byte) {
    key-n = key.len()
    msg-n = msg.len()

    k [64]byte
    i <- [0..64): {

        k[i]: {
            ok -> it = 0
            -> _
        }
    }
    {
        key-n <= 64 -> {
            i <- [0..key-n): {

                #{index-out=zero}
                k[i]: {
                    ok -> it = key[i]
                    -> _
                }
            }
        }

        -> {
            h = sha1.sha1(key)
            i <- [0..20): {

                k[i]: {
                    ok -> it = h[i]
                    -> _
                }
            }
        }
    }
    ipad-key [64]byte
    i <- [0..64): {

        ipad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-IPAD
            -> _
        }
    }
    opad-key [64]byte
    i <- [0..64): {

        opad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-OPAD
            -> _
        }
    }
    inner-data []byte = with-len(64 + msg-n)
    i <- [0..64): {

        inner-data[i]: {
            ok -> it = ipad-key[i]
            -> _
        }
    }
    i <- [0..msg-n): {

        #{index-out=zero, overflow=wrap}
        inner-data[64 + i]: {
            ok -> it = msg[i]
            -> _
        }
    }
    inner-hash = sha1.sha1(inner-data)

    outer-data []byte = with-len(84)
    i <- [0..64): {

        outer-data[i]: {
            ok -> it = opad-key[i]
            -> _
        }
    }
    i <- [0..20): {

        #{overflow=wrap}
        outer-data[64 + i]: {
            ok -> it = inner-hash[i]
            -> _
        }
    }
    out = sha1.sha1(outer-data)
}

; 計算 HMAC-SHA1，返回 []byte
; key: 雜湊金鑰（超過 64 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out []byte: 20 位元組 HMAC 值
; [hmac-sha1-vec](#hmac.hmac-sha1-vec)
hmac-sha1-vec = (key []byte, msg []byte) (out []byte) {
    h [20]byte
    h = hmac-sha1(key, msg)
    out = h[..20)
}

; ─── HMAC-SHA512 ─────────────────────────────────

; HMAC-SHA512 區塊大小（SHA-512 使用 128 位元組區塊）
HMAC-SHA512-BLOCK-SIZE = 128

; HMAC-SHA512 輸出大小
HMAC-SHA512-HASH-SIZE = 64

; 計算 HMAC-SHA512
; key: 雜湊金鑰（超過 128 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out [64]byte: 64 位元組 HMAC 值
; [hmac-sha512](#hmac.hmac-sha512)
hmac-sha512 = (key []byte, msg []byte) (out [64]byte) {
    key-n = key.len()
    msg-n = msg.len()

    ; SHA-512 區塊大小 = 128 位元組
    k [128]byte
    i <- [0..128): {

        k[i]: {
            ok -> it = 0
            -> _
        }
    }
    {
        key-n <= 128 -> {
            i <- [0..key-n): {

                #{index-out=zero}
                k[i]: {
                    ok -> it = key[i]
                    -> _
                }
            }
        }

        -> {
            h = sha512.sha512(key)
            i <- [0..64): {

                k[i]: {
                    ok -> it = h[i]
                    -> _
                }
            }
        }
    }
    ipad-key [128]byte
    i <- [0..128): {

        ipad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-IPAD
            -> _
        }
    }
    opad-key [128]byte
    i <- [0..128): {

        opad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-OPAD
            -> _
        }
    }
    inner-data []byte = with-len(128 + msg-n)
    i <- [0..128): {

        inner-data[i]: {
            ok -> it = ipad-key[i]
            -> _
        }
    }
    i <- [0..msg-n): {

        #{index-out=zero, overflow=wrap}
        inner-data[128 + i]: {
            ok -> it = msg[i]
            -> _
        }
    }
    inner-hash = sha512.sha512(inner-data)

    outer-data []byte = with-len(192)
    i <- [0..128): {

        outer-data[i]: {
            ok -> it = opad-key[i]
            -> _
        }
    }
    i <- [0..64): {

        #{overflow=wrap}
        outer-data[128 + i]: {
            ok -> it = inner-hash[i]
            -> _
        }
    }
    out = sha512.sha512(outer-data)
}

; 計算 HMAC-SHA512，返回 []byte
; key: 雜湊金鑰（超過 128 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out []byte: 64 位元組 HMAC 值
; [hmac-sha512-vec](#hmac.hmac-sha512-vec)
hmac-sha512-vec = (key []byte, msg []byte) (out []byte) {
    h [64]byte
    h = hmac-sha512(key, msg)
    out = h[..64)
}

; ─── HMAC-SHA384 ─────────────────────────────────

; 計算 HMAC-SHA384（使用 SHA-384 底層雜湊，區塊大小 128）
; key: 雜湊金鑰（超過 128 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out [48]byte: 48 位元組 HMAC 值
; [hmac-sha384](#hmac.hmac-sha384)
hmac-sha384 = (key []byte, msg []byte) (out [48]byte) {
    key-n = key.len()
    msg-n = msg.len()

    k [128]byte
    i <- [0..128): {

        k[i]: {
            ok -> it = 0
            -> _
        }
    }
    {
        key-n <= 128 -> {
            i <- [0..key-n): {

                #{index-out=zero}
                k[i]: {
                    ok -> it = key[i]
                    -> _
                }
            }
        }

        -> {
            h = sha384.sha384(key)
            i <- [0..48): {

                k[i]: {
                    ok -> it = h[i]
                    -> _
                }
            }
        }
    }
    ipad-key [128]byte
    i <- [0..128): {

        ipad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-IPAD
            -> _
        }
    }
    opad-key [128]byte
    i <- [0..128): {

        opad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-OPAD
            -> _
        }
    }
    inner-data []byte = with-len(128 + msg-n)
    i <- [0..128): {

        inner-data[i]: {
            ok -> it = ipad-key[i]
            -> _
        }
    }
    i <- [0..msg-n): {

        #{index-out=zero, overflow=wrap}
        inner-data[128 + i]: {
            ok -> it = msg[i]
            -> _
        }
    }
    inner-hash = sha384.sha384(inner-data)

    outer-data []byte = with-len(176)
    i <- [0..128): {

        outer-data[i]: {
            ok -> it = opad-key[i]
            -> _
        }
    }
    i <- [0..48): {

        #{overflow=wrap}
        outer-data[128 + i]: {
            ok -> it = inner-hash[i]
            -> _
        }
    }
    out = sha384.sha384(outer-data)
}

; 計算 HMAC-SHA384，返回 []byte
; key: 雜湊金鑰（超過 128 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out []byte: 48 位元組 HMAC 值
; [hmac-sha384-vec](#hmac.hmac-sha384-vec)
hmac-sha384-vec = (key []byte, msg []byte) (out []byte) {
    h [48]byte
    h = hmac-sha384(key, msg)
    out = h[..48)
}

; ─── HMAC-MD5 ───────────────────────────────────

; 計算 HMAC-MD5（使用 MD5 底層雜湊，區塊大小 64）
; key: 雜湊金鑰（超過 64 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out [16]byte: 16 位元組 HMAC 值
; [hmac-md5](#hmac.hmac-md5)
hmac-md5 = (key []byte, msg []byte) (out [16]byte) {
    key-n = key.len()
    msg-n = msg.len()

    k [64]byte
    i <- [0..64): {

        k[i]: {
            ok -> it = 0
            -> _
        }
    }
    {
        key-n <= 64 -> {
            i <- [0..key-n): {

                #{index-out=zero}
                k[i]: {
                    ok -> it = key[i]
                    -> _
                }
            }
        }

        -> {
            h = md5.md5(key)
            i <- [0..16): {

                k[i]: {
                    ok -> it = h[i]
                    -> _
                }
            }
        }
    }
    ipad-key [64]byte
    i <- [0..64): {

        ipad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-IPAD
            -> _
        }
    }
    opad-key [64]byte
    i <- [0..64): {

        opad-key[i]: {
            ok -> it = (k[i]) ^ HMAC-OPAD
            -> _
        }
    }
    inner-data []byte = with-len(64 + msg-n)
    i <- [0..64): {

        inner-data[i]: {
            ok -> it = ipad-key[i]
            -> _
        }
    }
    i <- [0..msg-n): {

        #{index-out=zero, overflow=wrap}
        inner-data[64 + i]: {
            ok -> it = msg[i]
            -> _
        }
    }
    inner-hash = md5.md5(inner-data)

    outer-data []byte = with-len(80)
    i <- [0..64): {

        outer-data[i]: {
            ok -> it = opad-key[i]
            -> _
        }
    }
    i <- [0..16): {

        #{overflow=wrap}
        outer-data[64 + i]: {
            ok -> it = inner-hash[i]
            -> _
        }
    }
    out = md5.md5(outer-data)
}

; 計算 HMAC-MD5，返回 []byte
; key: 雜湊金鑰（超過 64 位元組區塊時先雜湊縮減，不足則補零）
; msg: 待認證的訊息位元組
; 返回 out []byte: 16 位元組 HMAC 值
; [hmac-md5-vec](#hmac.hmac-md5-vec)
hmac-md5-vec = (key []byte, msg []byte) (out []byte) {
    h [16]byte
    h = hmac-md5(key, msg)
    out = h[..16)
}
