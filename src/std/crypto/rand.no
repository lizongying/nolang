; rand — 簡易隨機數生成器 (xorshift32)
;
; 使用 xorshift32 演算法，簡單快速的偽隨機數生成器。
;
; 用法：
;   seed = 123456789
;   r = rand(seed)    // r = 隨機數 0..4294967295
; [rand](#rand)

; 產生下一個偽隨機數（xorshift32）
; state: 輸入狀態（任意非零種子；內部先裁到 32 位元，且每一步都重新遮罩）
; new-state: 更新後的狀態（32 位元），供下一次調用作為種子
; r: 本次輸出值（0..4294967295）
; [rand](#rand.rand)
rand = (state i64) (new-state i64, r i64) {

    ; xorshift32 必須每一步都裁到 32-bit，否則 i64 不溢位會讓 state 無限增長、
    ; 偏移量與 >>17 的語義都偏離標準 xorshift32（歷史 bug：僅在輸出 r 處遮罩）。
    s = state & 4294967295

    s = (s ^ (s << 13)) & 4294967295

    s = (s ^ (s >> 17)) & 4294967295

    s = (s ^ (s << 5)) & 4294967295
    new-state = s
    r = s
}

; 產生指定長度的隨機字母數字字串
; state: 輸入/輸出狀態變數
; n: 產生的字元數
; s: 輸出字串（長度 n）
; chars: 可用字元集 (A-Z a-z 0-9)
; [rand-str](#rand.rand-str)
rand-str = (state i64, n i64) (s str) {
    chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
    r = 0

    ; 2026-11-11：str 下標直寫已全域禁用 ⇒ 用 []byte 緩衝承接，收尾整體轉回 str。
    ; （這裡不能用 place-match：它對 str 是「碼點」閘門，不保證位元組保真。）
    sb []byte = with-cap-len(n, n)
    i <- [0..n): {
        r = 0
        state, r = rand(state)
        sb[i] = chars[r % 62]: {
            ok -> it

            -> "A"
        }
    }
    s = sb.to-bytes-str()
}
