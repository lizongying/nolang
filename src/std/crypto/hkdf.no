; hkdf — HMAC-based Key Derivation Function（RFC 5869）
;
; 實作 HKDF-Extract 和 HKDF-Expand，以及 TLS 1.3 專用的 HKDF-Expand-Label。
; 基於 HMAC-SHA256（32 位元組輸出）。
;
; 用法：
;   # std/hash/hkdf
;   prk = hkdf-extract(salt, ikm)           // 返回 [32]byte
;   okm = hkdf-expand(prk, info, 32)        // 返回 []byte
;   okm = hkdf-expand-label(prk, 'label', ctx, 32)  // TLS 1.3 專用

; ═══════════════════════════════════════════════
; HKDF-Extract
; ═══════════════════════════════════════════════

; hkdf-extract: HKDF-Extract（RFC 5869 §2.2）
; salt []byte: 鹽值（可為空）
; ikm []byte: 輸入金鑰材料
; 返回 prk [32]byte: 偽隨機金鑰
hkdf-extract = (salt []byte, ikm []byte) (prk [32]byte) {
    ; PRK = HMAC-SHA256(salt, IKM)
    ; 若 salt 為空，使用 32 個零位元組
    k []byte = with-len(32)
    {
        salt.len == 0 -> {
            i <- [0..32): {
                k[i] = 0
            }
        }
        -> {
            i <- [0..salt.len): {
                k[i] = salt[i]
            }
        }
    }
    prk = hmac.hmac-sha256(k, ikm)
}

; ═══════════════════════════════════════════════
; HKDF-Expand
; ═══════════════════════════════════════════════

; hkdf-expand-hmac: 計算 HMAC-SHA256(prk, t-prefix || info || counter-byte)
; 內部輔助函數，避免在 hkdf-expand 中修改 slice.len
; prk-vec []byte: 金鑰（32 位元組）
; t-data []byte: T(i) 前綴（可為空，長度由 t-len 決定）
; t-len i64: T(i) 的有效長度
; info []byte: info 字串
; counter i64: 計數器位元組（1-255），0 表示不加
; 返回 out [32]byte: HMAC 結果
hkdf-expand-hmac = (prk-vec []byte, t-data []byte, t-len i64, info []byte, counter i64) (out [32]byte) {
    ; 計算訊息長度: t-len + info.len + (counter > 0 ? 1 : 0)
    msg-len = t-len + info.len
    counter > 0 -> msg-len = msg-len + 1

    msg []byte = with-len(msg-len)
    i <- [0..t-len): {
        msg[i] = t-data[i]
    }
    i <- [0..info.len): {
        msg[t-len + i] = info[i]
    }
    counter > 0 -> msg[t-len + info.len] = counter & 255

    out = hmac.hmac-sha256(prk-vec, msg)
}

; hkdf-expand: HKDF-Expand（RFC 5869 §2.3）
; prk [32]byte: 偽隨機金鑰
; info []byte: 上下文資訊（可為空）
; out-len i64: 需要的輸出長度（最大 255*32 = 8160）
; 返回 okm []byte: 展開後的金鑰材料
hkdf-expand = (prk [32]byte, info []byte, out-len i64) (okm []byte) {
    ; 將 prk 轉為 []byte
    prk-vec []byte = with-len(32)
    i <- [0..32): {
        prk-vec[i] = prk[i]
    }

    ; T 緩衝區（固定大小陣列，stack-allocated）
    t [32]byte
    t-valid = false

    okm = with-len(out-len)
    off = 0
    counter = 1

    out-len <= 32 -> {
        ; T(1) = HMAC-SHA256(PRK, info || 1)
        t-tmp [32]byte
        t-tmp = hkdf-expand-hmac(prk-vec, t, 0, info, counter)

        copy-n = out-len
        i <- [0..copy-n): {
            okm[i] = t-tmp[i]
        }
    }

    out-len > 32 -> {
        {
            t-len-for-hmac = 0
            t-valid -> t-len-for-hmac = 32

            t-tmp [32]byte
            t-tmp = hkdf-expand-hmac(prk-vec, t, t-len-for-hmac, info, counter)

            i <- [0..32): {
                t[i] = t-tmp[i]
            }
            t-valid = true

            copy-n = 32
            off + copy-n > out-len -> copy-n = out-len - off
            i <- [0..copy-n): {
                okm[off + i] = t[i]
            }
            off = off + copy-n
            counter = counter + 1
        } (off < out-len)
    }
}

; ═══════════════════════════════════════════════
; HKDF-Expand-Label（TLS 1.3 專用）
; ═══════════════════════════════════════════════

; hkdf-expand-label: TLS 1.3 HKDF-Expand-Label（RFC 8446 §7.1）
; prk [32]byte: 偽隨機金鑰
; label str: 標籤（不含 "tls13 " 前綴）
; context []byte: 上下文（可為空）
; out-len i64: 需要的輸出長度
; 返回 okm []byte: 展開後的金鑰材料
hkdf-expand-label = (prk [32]byte, label str, context []byte, out-len i64) (okm []byte) {
    ; HkdfLabel struct:
    ;   uint16 length = out-len
    ;   opaque label<7..255> = "tls13 " + label
    ;   opaque context<0..255> = context

    full-label = 'tls13 ' - label
    label-bytes []byte = full-label.to-bytes()

    ; 構建 info: length(2) + label-len(1) + label + ctx-len(1) + ctx
    info-len = 2 + 1 + label-bytes.len + 1 + context.len
    info []byte = with-len(info-len)
    pos = 0

    ; length (2 bytes, big-endian)
    info[0] = (out-len >> 8) & 255
    info[1] = out-len & 255
    pos = 2

    ; label length (1 byte)
    info[2] = label-bytes.len & 255
    pos = 3

    ; label bytes
    i <- [0..label-bytes.len): {
        info[pos + i] = label-bytes[i]
    }
    pos = pos + label-bytes.len

    ; context length (1 byte)
    info[pos] = context.len & 255
    pos = pos + 1

    ; context bytes
    i <- [0..context.len): {
        info[pos + i] = context[i]
    }
    info.len = info-len

    okm = hkdf-expand(prk, info, out-len)
}

; hkdf-expand-label-vec: 與 hkdf-expand-label 相同，但 prk 以 []byte 接收
; prk []byte: 偽隨機金鑰（32 位元組）
; label str: 標籤
; context []byte: 上下文
; out-len i64: 輸出長度
; 返回 okm []byte: 展開後的金鑰材料
hkdf-expand-label-vec = (prk []byte, label str, context []byte, out-len i64) (okm []byte) {
    prk-arr [32]byte
    i <- [0..32): {
        prk-arr[i] = prk[i]
    }
    okm = hkdf-expand-label(prk-arr, label, context, out-len)
}

; ═══════════════════════════════════════════════
; 輔助：Derive-Secret（TLS 1.3 §7.1）
; ═══════════════════════════════════════════════

; hkdf-derive-secret: Derive-Secret(Secret, Label, Messages)
; secret []byte: 32 位元組金鑰
; label str: 標籤
; messages []byte: 交握訊息雜湊（SHA-256 的輸出）
; 返回 out []byte: 32 位元組推導金鑰
hkdf-derive-secret = (secret []byte, label str, messages []byte) (out []byte) {
    out = hkdf-expand-label-vec(secret, label, messages, 32)
}
