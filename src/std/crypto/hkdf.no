; hkdf — HMAC-based Key Derivation Function（RFC 5869）
;
; 實作 HKDF-Extract 和 HKDF-Expand，以及 TLS 1.3 專用的 HKDF-Expand-Label。
; 基於 HMAC-SHA256（32 位元組輸出）。
;
; 用法：
;   # std/crypto/hkdf
;   prk = hkdf-extract(salt, ikm)           // 返回 [32]byte
;   okm = hkdf-expand(prk, info, 32)        // 返回 []byte
;   okm = hkdf-expand-label(prk, 'label', ctx, 32)  // TLS 1.3 專用

; ═══════════════════════════════════════════════
; HKDF-Extract
; ═══════════════════════════════════════════════

; HKDF-Extract（RFC 5869 §2.2）
; salt []byte: 鹽值（可為空；空時以 32 個零位元組代替）
; ikm []byte: 輸入金鑰材料（任意長度）
; 返回 prk [32]byte: HMAC-SHA256(salt, IKM) 算出的偽隨機金鑰
; [hkdf-extract](#hkdf.hkdf-extract)
hkdf-extract = (salt []byte, ikm []byte) (prk [32]byte) {

    ; PRK = HMAC-SHA256(salt, IKM)
    ; 若 salt 為空，使用 32 個零位元組
    k []byte = with-len(32)
    {
        salt.len() == 0 -> {
            i <- [0..32): {

                k[i]: {
                    ok -> it = 0
                    -> _
                }
            }
        }

        -> {
            i <- [0..salt.len()): {

                #{index-out=zero}
                k[i]: {
                    ok -> it = salt[i]
                    -> _
                }
            }
        }
    }
    prk = hmac.hmac-sha256(k, ikm)
}

; ═══════════════════════════════════════════════
; HKDF-Expand
; ═══════════════════════════════════════════════

; 計算 HMAC-SHA256(prk, t-prefix || info || counter-byte)
; 內部輔助函數，避免在 hkdf-expand 中修改 slice.len()
; prk-vec []byte: 金鑰（32 位元組）
; t-data []byte: T(i) 前綴（可為空，長度由 t-len 決定）
; t-len i64: T(i) 的有效長度
; info []byte: 上下文資訊（可為空）
; counter i64: 計數器位元組（RFC 要求 1–255），0 表示不加這個位元組
; 返回 out [32]byte: HMAC-SHA256(prk, T(i-1) || info || counter) 的結果
; [hkdf-expand-hmac](#hkdf.hkdf-expand-hmac)
hkdf-expand-hmac = (prk-vec []byte, t-data []byte, t-len i64, info []byte, counter i64) (out [32]byte) {

    ; 計算訊息長度: t-len + info.len() + (counter > 0 ? 1 : 0)
    #{overflow=wrap}
    msg-len = t-len + info.len()

    #{overflow=wrap}
    counter > 0 -> msg-len = msg-len + 1
    msg []byte = with-len(msg-len)
    i <- [0..t-len): {

        #{index-out=zero}
        msg[i]: {
            ok -> it = t-data[i]
            -> _
        }
    }
    i <- [0..info.len()): {

        #{index-out=zero, overflow=wrap}
        msg[t-len + i]: {
            ok -> it = info[i]
            -> _
        }
    }

    #{overflow=wrap}
    counter > 0 -> {

        msg[t-len + info.len()]: {
            ok -> it = counter & 255
            -> _
        }
    }
    out = hmac.hmac-sha256(prk-vec, msg)
}

; HKDF-Expand（RFC 5869 §2.3）
; prk [32]byte: 偽隨機金鑰
; info []byte: 上下文資訊（可為空，參與每一輪 HMAC）
; out-len i64: 需要的輸出長度；RFC 5869 上限為 255*32 = 8160，超過後 counter 會回繞，結果不再符合規範
; 返回 okm []byte: 展開後的金鑰材料（長度恰為 out-len）
; [hkdf-expand](#hkdf.hkdf-expand)
hkdf-expand = (prk [32]byte, info []byte, out-len i64) (okm []byte) {

    ; 將 prk 轉為 []byte
    prk-vec []byte = with-len(32)
    i <- [0..32): {

        prk-vec[i]: {
            ok -> it = prk[i]
            -> _
        }
    }

    ; T 緩衝區（固定大小陣列，stack-allocated）
    t [32]byte
    t-valid = false

    okm = with-len(out-len)
    off = 0
    counter = 1

    {
        out-len <= 32 -> {

            ; T(1) = HMAC-SHA256(PRK, info || 1)
            t-tmp [32]byte
            t-tmp = hkdf-expand-hmac(prk-vec, t, 0, info, counter)

            copy-n = out-len
            i <- [0..copy-n): {

                okm[i] = t-tmp[i]
            }
        }

        out-len > 32 -> {
            (off < out-len) {

                t-len-for-hmac = 0
                t-valid -> t-len-for-hmac = 32
                t-tmp [32]byte
                t-tmp = hkdf-expand-hmac(prk-vec, t, t-len-for-hmac, info, counter)

                i <- [0..32): {

                    t[i]: {
                        ok -> it = t-tmp[i]
                        -> _
                    }
                }
                t-valid = true

                copy-n = 32

                #{overflow=wrap}
                off + copy-n > out-len -> copy-n = out-len - off
                i <- [0..copy-n): {

                    #{index-out=zero, overflow=wrap}
                    okm[off + i] = t[i]
                }

                #{overflow=wrap}
                off = off + copy-n

                #{overflow=wrap}
                counter = counter + 1
            }
        }
    }
}

; ═══════════════════════════════════════════════
; HKDF-Expand-Label（TLS 1.3 專用）
; ═══════════════════════════════════════════════

; TLS 1.3 HKDF-Expand-Label（RFC 8446 §7.1）
; 先按 HkdfLabel 結構組出 info（length + "tls13 "+label + context），再調用 HKDF-Expand。
; prk [32]byte: 偽隨機金鑰（32 位元組，通常來自 HKDF-Extract）
; label str: 標籤（不含 "tls13 " 前綴，本文會自動補上）
; context []byte: 上下文（通常為交握訊息雜湊；可為空）
; out-len i64: 需要的輸出位元組數
; okm []byte: 展開後的金鑰材料，長度恰為 out-len
; [hkdf-expand-label](#hkdf.hkdf-expand-label)
hkdf-expand-label = (prk [32]byte, label str, context []byte, out-len i64) (okm []byte) {

    ; HkdfLabel struct:
    ;   uint16 length = out-len
    ;   opaque label<7..255> = "tls13 " + label
    ;   opaque context<0..255> = context

    full-label = 'tls13 ' - label
    label-bytes = full-label.to-bytes()

    ; 構建 info: length(2) + label-len(1) + label + ctx-len(1) + ctx
    #{overflow=wrap}
    info-len = 2 + 1 + label-bytes.len() + 1 + context.len()
    info []byte = with-len(info-len)
    pos = 0

    ; length (2 bytes, big-endian)
    info[0]: {
        ok -> it = (out-len >> 8) & 255
        -> _
    }

    info[1]: {
        ok -> it = out-len & 255
        -> _
    }
    pos = 2

    ; label length (1 byte)
    info[2]: {
        ok -> it = label-bytes.len() & 255
        -> _
    }
    pos = 3

    ; label bytes
    i <- [0..label-bytes.len()): {

        #{index-out=zero, overflow=wrap}
        info[pos + i]: {
            ok -> it = label-bytes[i]
            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + label-bytes.len()

    ; context length (1 byte)
    info[pos]: {
        ok -> it = context.len() & 255
        -> _
    }

    #{overflow=wrap}
    pos = pos + 1

    ; context bytes
    i <- [0..context.len()): {

        #{index-out=zero, overflow=wrap}
        info[pos + i]: {
            ok -> it = context[i]
            -> _
        }
    }
    info.truncate(info-len)

    okm = hkdf-expand(prk, info, out-len)
}

; 與 hkdf-expand-label 相同，但 prk 以 []byte 接收（不足 32 位元組的尾部以 0 補齊）
; prk []byte: 偽隨機金鑰，取前 32 位元組使用
; label str: 標籤（不含 "tls13 " 前綴）
; context []byte: 上下文（可為空）
; out-len i64: 需要的輸出位元組數
; okm []byte: 展開後的金鑰材料，長度恰為 out-len
; [hkdf-expand-label-vec](#hkdf.hkdf-expand-label-vec)
hkdf-expand-label-vec = (prk []byte, label str, context []byte, out-len i64) (okm []byte) {
    prk-arr [32]byte
    i <- [0..32): {

        #{index-out=zero}
        prk-arr[i]: {
            ok -> it = prk[i]
            -> _
        }
    }
    okm = hkdf-expand-label(prk-arr, label, context, out-len)
}

; ═══════════════════════════════════════════════
; 輔助：Derive-Secret（TLS 1.3 §7.1）
; ═══════════════════════════════════════════════

; Derive-Secret(Secret, Label, Messages)（TLS 1.3 §7.1）
; 等同 hkdf-expand-label-vec(secret, label, messages, 32)。
; secret []byte: 32 位元組金鑰
; label str: 標籤（不含 "tls13 " 前綴）
; messages []byte: 交握訊息雜湊（SHA-256 的輸出，作為 context）
; out []byte: 32 位元組推導金鑰
; [hkdf-derive-secret](#hkdf.hkdf-derive-secret)
hkdf-derive-secret = (secret []byte, label str, messages []byte) (out []byte) {
    out = hkdf-expand-label-vec(secret, label, messages, 32)
}
