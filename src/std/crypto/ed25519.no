; ed25519 — Ed25519 簽名算法（RFC 8032）
;
; 基於 twisted Edwards 曲線的 EdDSA 簽名方案。
; 曲線: -x² + y² = 1 + d*x²*y² (mod 2^255-19)
; 基點 B，群階 L = 2^252 + 27742317777372353535851937790883648493
;
; 域元素（GF(2^255-19)）運算複用 x25519.no，但一律透過其「回值形式」
; fe-*-v 包裝函式取得結果——跨模組呼叫不會把「就地寫入 slice 參數」
; 回傳給呼叫端，只有「回傳值」會，故本模組所有中間值都以回值組裝。
;
; 點以 []i64（長度 40）表示 extended 座標 (X,Y,Z,T)，各佔 10 個 limb，
; 偏移 0/10/20/30。座標讀取可用切片視圖（唯讀跨模組安全），
; 寫入則透過本模組內的 set-coord（就地寫入同模組參數會回傳）。
;
; 用法：
;   # std/crypto/ed25519
;   pub [32]byte = ed25519-publickey(seed)
;   sig [64]byte = ed25519-sign(seed, msg)
;   ok = ed25519-verify(pub, msg, sig)

; ═══════════════════════════════════════════════
; 常量（皆為小端 32 位元組編碼，執行期以 fe-frombytes 載入為域元素）
; ═══════════════════════════════════════════════

; 基點 B 的 x 座標（小端 32 位元組）
ED-GX-BYTES [32]byte = [
    0x1a, 0xd5, 0x25, 0x8f, 0x60, 0x2d, 0x56, 0xc9,
    0xb2, 0xa7, 0x25, 0x95, 0x60, 0xc7, 0x2c, 0x69,
    0x5c, 0xdc, 0xd6, 0xfd, 0x31, 0xe2, 0xa4, 0xc0,
    0xfe, 0x53, 0x6e, 0xcd, 0xd3, 0x36, 0x69, 0x21,
]

; 基點 B 的 y 座標 = 4/5 mod p（小端 32 位元組）
; 0x6666666666666666666666666666666666666666666666666666666666666658
ED-GY-BYTES [32]byte = [
    0x58, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66,
    0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66,
    0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66,
    0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66,
]

; 曲線參數 d = -121665/121666 mod p（小端 32 位元組）
ED-D-BYTES [32]byte = [
    0xa3, 0x78, 0x59, 0x13, 0xca, 0x4d, 0xeb, 0x75,
    0xab, 0xd8, 0x41, 0x41, 0x4d, 0x0a, 0x70, 0x00,
    0x98, 0xe8, 0x79, 0x77, 0x79, 0x40, 0xc7, 0x8c,
    0x73, 0xfe, 0x6f, 0x2b, 0xee, 0x6c, 0x03, 0x52,
]

; sqrt(-1) mod p = 2^((p-1)/4)（小端 32 位元組），用於點解壓開方修正
ED-SQM1-BYTES [32]byte = [
    0xb0, 0xa0, 0x0e, 0x4a, 0x27, 0x1b, 0xee, 0xc4,
    0x78, 0xe4, 0x2f, 0xad, 0x06, 0x18, 0x43, 0x2f,
    0xa7, 0xd7, 0xfb, 0x3d, 0x99, 0x00, 0x4d, 0x2b,
    0x0b, 0xdf, 0xc1, 0x4f, 0x80, 0x24, 0x83, 0x2b,
]

; 開方指數 (p-5)/8 = 2^252 - 3（小端 32 位元組）
ED-EXP-BYTES [32]byte = [
    0xfd, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x0f,
]

; 群階 L = 2^252 + 27742317777372353535851937790883648493（小端 32 位元組）
ED-L [32]byte = [
    0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58,
    0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10,
]

; ═══════════════════════════════════════════════
; 點（extended 座標）輔助——皆為同模組函式，就地寫入有效
; ═══════════════════════════════════════════════

; set-coord: 將 10-limb 域元素 src 寫入點 p 的偏移 off 處
set-coord = (p []i64, off i64, src []i64) {

    i <- [0..10): {

        #{index-out=zero, overflow=wrap}
        p[off + i] = src[i]
    }
}

; pcopy: 整點複製 dst = src（40 limb）
pcopy = (dst []i64, src []i64) {

    i <- [0..40): {

        #{index-out=zero}
        dst[i] = src[i]
    }
}

; ed-d: 回傳曲線常數 d 的域元素
ed-d = () (h []i64) {
    h = x25519.fe-frombytes-v(ED-D-BYTES)
}

; ed-sqm1: 回傳 sqrt(-1) 的域元素
ed-sqm1 = () (h []i64) {
    h = x25519.fe-frombytes-v(ED-SQM1-BYTES)
}

; is-zero-arr: 32 位元組全為 0 回傳 1，否則 0
is-zero-arr = (a [32]byte) (z i64) {

    z = 1
    i <- [0..32): {
        {
            a[i] != 0 -> z = 0
        }
    }
}

; ═══════════════════════════════════════════════
; Extended Twisted Edwards 座標點操作
; 點: (X, Y, Z, T)，x=X/Z, y=Y/Z, T=XY/Z
; Ed25519 (a=-1) 的統一加法法是完整的，故倍乘亦用 ge-add(P,P)
; ═══════════════════════════════════════════════

; ge-add: R = P + Q（add-2008-hwcd, a=-1 完整加法法）
ge-add = (r []i64, p []i64, q []i64) {

    d = ed-d()

    ; A = (Y1-X1)*(Y2-X2)
    a = x25519.fe-mul-v(x25519.fe-sub-v(p[10..], p), x25519.fe-sub-v(q[10..], q))

    ; B = (Y1+X1)*(Y2+X2)
    b = x25519.fe-mul-v(x25519.fe-add-v(p[10..], p), x25519.fe-add-v(q[10..], q))

    ; C = 2*d*T1*T2
    tt = x25519.fe-mul-v(p[30..], q[30..])
    cd = x25519.fe-mul-v(tt, d)
    c = x25519.fe-add-v(cd, cd)

    ; D = 2*Z1*Z2
    zz = x25519.fe-mul-v(p[20..], q[20..])
    dd = x25519.fe-add-v(zz, zz)

    ; E = B-A, F = D-C, G = D+C, H = B+A
    e = x25519.fe-sub-v(b, a)
    f = x25519.fe-sub-v(dd, c)
    g = x25519.fe-add-v(dd, c)
    hh = x25519.fe-add-v(b, a)

    ; X3=E*F, Y3=G*H, Z3=F*G, T3=E*H
    set-coord(r, 0, x25519.fe-mul-v(e, f))
    set-coord(r, 10, x25519.fe-mul-v(g, hh))
    set-coord(r, 20, x25519.fe-mul-v(f, g))
    set-coord(r, 30, x25519.fe-mul-v(e, hh))
}

; ge-scalar-mult: R = scalar * P（double-and-add，逐位元 254..0）
; scalar: []byte（小端，長度 >= 32）
ge-scalar-mult = (r []i64, scalar []byte, p []i64) {

    ; 初始化 R 為單位元 (0,1,1,0)
    set-coord(r, 0, x25519.fe-zero-v())
    set-coord(r, 10, x25519.fe-one-v())
    set-coord(r, 20, x25519.fe-one-v())
    set-coord(r, 30, x25519.fe-zero-v())

    tmp []i64 = with-len(40)

    t = 254
    (t >= 0) {

        ; R = 2*R（用完整加法法 P+P）
        ge-add(tmp, r, r)
        pcopy(r, tmp)

        ; bit t 為 1 → R = R + P
        #{index-out=zero, overflow=wrap}
        bit = (scalar[t / 8] >> (t % 8)) & 1

        bit == 1 -> {
            ge-add(tmp, r, p)
            pcopy(r, tmp)
        }

        #{overflow=wrap}
        t = t - 1
    }
}

; ═══════════════════════════════════════════════
; 點編碼/解碼
; ═══════════════════════════════════════════════

; ge-pack: 點壓縮為 32 位元組（y 的小端編碼，最高位為 x 符號位）
ge-pack = (p []i64) (out [32]byte) {

    zinv = x25519.fe-invert-v(p[20..])
    x = x25519.fe-mul-v(p, zinv)
    y = x25519.fe-mul-v(p[10..], zinv)

    out = x25519.fe-tobytes-v(y)
    xb = x25519.fe-tobytes-v(x)

    #{overflow=wrap}
    out[31] = out[31] | ((xb[0] & 1) << 7)
}

; fe-pow: 回傳 base^e（e 為小端 32 位元組指數，平方-乘法）
fe-pow = (base []i64, e [32]byte) (out []i64) {

    out = x25519.fe-one-v()
    t = 255
    (t >= 0) {

        out = x25519.fe-sq-v(out)

        #{index-out=zero, overflow=wrap}
        bit = (e[t / 8] >> (t % 8)) & 1

        bit == 1 -> {
            out = x25519.fe-mul-v(out, base)
        }

        #{overflow=wrap}
        t = t - 1
    }
}

; ge-unpack: 從 32 位元組解壓縮點。回傳 ok(1/0)、p(長度 40 的點)
ge-unpack = (s [32]byte) (ok i64, p []i64) {

    p = with-len(40)

    sign = (s[31] >> 7) & 1
    sc [32]byte
    i <- [0..32): {
        sc[i] = s[i]
    }
    sc[31] = sc[31] & 127

    ; y
    y = x25519.fe-frombytes-v(sc)

    ; u = y^2 - 1, v = d*y^2 + 1
    y2 = x25519.fe-sq-v(y)
    one = x25519.fe-one-v()
    d = ed-d()
    u = x25519.fe-sub-v(y2, one)
    v = x25519.fe-add-v(x25519.fe-mul-v(y2, d), one)

    ; x = u*v^3 * (u*v^7)^((p-5)/8)
    v2 = x25519.fe-sq-v(v)
    v3 = x25519.fe-mul-v(v2, v)
    v7 = x25519.fe-mul-v(x25519.fe-sq-v(v3), v)
    uv7 = x25519.fe-mul-v(u, v7)
    pw = fe-pow(uv7, ED-EXP-BYTES)
    x = x25519.fe-mul-v(x25519.fe-mul-v(u, v3), pw)

    ; 檢查 v*x^2 == u；否則若 == -u 則 x *= sqrt(-1)；否則拒絕
    vx2 = x25519.fe-mul-v(v, x25519.fe-sq-v(x))
    eq-u = is-zero-arr(x25519.fe-tobytes-v(x25519.fe-sub-v(vx2, u)))
    eq-u == 0 -> {
        eq-nu = is-zero-arr(x25519.fe-tobytes-v(x25519.fe-add-v(vx2, u)))
        eq-nu == 0 -> {
            ok = 0
            return
        }
        x = x25519.fe-mul-v(x, ed-sqm1())
    }

    ; 符號修正：x 最低位 != sign → 取負
    xb = x25519.fe-tobytes-v(x)
    (xb[0] & 1) != sign -> {
        x = x25519.fe-sub-v(x25519.fe-zero-v(), x)
    }

    ; 組裝點 (X,Y,Z,T) = (x, y, 1, x*y)
    set-coord(p, 0, x)
    set-coord(p, 10, y)
    set-coord(p, 20, one)
    set-coord(p, 30, x25519.fe-mul-v(x, y))

    ok = 1
}

; ═══════════════════════════════════════════════
; 基點
; ═══════════════════════════════════════════════

; ge-basepoint: 回傳基點 B 的 extended 座標（長度 40）
ge-basepoint = () (bp []i64) {

    bp = with-len(40)
    x = x25519.fe-frombytes-v(ED-GX-BYTES)
    y = x25519.fe-frombytes-v(ED-GY-BYTES)
    one = x25519.fe-one-v()

    set-coord(bp, 0, x)
    set-coord(bp, 10, y)
    set-coord(bp, 20, one)
    set-coord(bp, 30, x25519.fe-mul-v(x, y))
}

; ═══════════════════════════════════════════════
; 純量算術 mod L
; ═══════════════════════════════════════════════

; sc-ge-l: 比較 acc(32 byte) >= L 回傳 1 否則 0
sc-ge-l = (acc []i64) (ge i64) {

    ge = 1
    done = 0
    i = 31
    (i >= 0 && done == 0) {

        #{index-out=zero}
        av = acc[i]

        #{index-out=zero}
        lv = ED-L[i]

        {
            av > lv -> done = 1

            av < lv -> {
                ge = 0
                done = 1
            }
        }

        #{overflow=wrap}
        i = i - 1
    }
}

; sc-reduce: 將 s（小端整數，長度任意）規約 mod L，回傳 [32]byte
; 逐位元 long division：acc 恆 < L，acc=acc*2+bit 後若 >= L 則減 L
sc-reduce = (s []byte) (out [32]byte) {
    acc []i64 = with-len(32)

    #{overflow=wrap}
    nb = s.len() * 8

    #{overflow=wrap}
    i = nb - 1
    (i >= 0) {

        #{index-out=zero, overflow=wrap}
        bit = (s[i / 8] >> (i % 8)) & 1

        ; acc = acc*2 + bit
        carry = bit
        j <- [0..32): {

            #{index-out=zero, overflow=wrap}
            v = acc[j] * 2 + carry

            #{index-out=zero}
            acc[j] = v & 255

            #{overflow=wrap}
            carry = v >> 8
        }

        ; 若 acc >= L 則 acc -= L
        ge = sc-ge-l(acc)
        ge == 1 -> {
            borrow = 0
            j <- [0..32): {

                #{index-out=zero}
                lv = ED-L[j]

                #{index-out=zero, overflow=wrap}
                dv = acc[j] - lv - borrow
                {
                    dv < 0 -> {

                        #{overflow=wrap}
                        dv = dv + 256
                        borrow = 1
                    }

                    -> borrow = 0
                }

                #{index-out=zero}
                acc[j] = dv
            }
        }

        #{overflow=wrap}
        i = i - 1
    }
    i <- [0..32): {

        #{index-out=zero}
        out[i] = acc[i]
    }
}

; sc-muladd: 回傳 (a*b + c) mod L（a,b,c 各 [32]byte）
sc-muladd = (a [32]byte, b [32]byte, c [32]byte) (s [32]byte) {

    prod []i64 = with-len(64)

    ; schoolbook 乘法 a*b → prod（64 byte）
    i <- [0..32): {

        carry = 0
        j <- [0..32): {

            #{index-out=zero, overflow=wrap}
            idx = i + j

            #{index-out=zero, overflow=wrap}
            v = prod[idx] + a[i] * b[j] + carry

            #{index-out=zero}
            prod[idx] = v & 255

            #{overflow=wrap}
            carry = v >> 8
        }

        #{overflow=wrap}
        k = i + 32
        (k < 64 && carry != 0) {

            #{index-out=zero, overflow=wrap}
            v = prod[k] + carry

            #{index-out=zero}
            prod[k] = v & 255

            #{overflow=wrap}
            carry = v >> 8

            #{overflow=wrap}
            k = k + 1
        }
    }

    ; 加上 c
    carry = 0
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        v = prod[i] + c[i] + carry

        #{index-out=zero}
        prod[i] = v & 255

        #{overflow=wrap}
        carry = v >> 8
    }
    i = 32
    (i < 64 && carry != 0) {

        #{index-out=zero, overflow=wrap}
        v = prod[i] + carry

        #{index-out=zero}
        prod[i] = v & 255

        #{overflow=wrap}
        carry = v >> 8

        #{overflow=wrap}
        i = i + 1
    }

    ; 轉成 []byte 再規約 mod L
    pb []byte = with-len(64)
    i <- [0..64): {

        #{index-out=zero}
        pb[i] = prod[i]
    }
    s = sc-reduce(pb)
}

; ═══════════════════════════════════════════════
; Ed25519 公開 API
; ═══════════════════════════════════════════════

; ed25519-publickey: 從種子計算公鑰
ed25519-publickey = (seed [32]byte) (pub [32]byte) {

    h = sha512.sha512(seed)

    ; a = clamp(H[0:32])
    a []byte = with-len(32)
    i <- [0..32): {

        #{index-out=zero}
        a[i] = h[i]
    }
    a[0] = a[0] & 248
    a[31] = a[31] & 127
    a[31] = a[31] | 64

    ; A = a * B
    point []i64 = with-len(40)
    bp = ge-basepoint()
    ge-scalar-mult(point, a, bp)
    pub = ge-pack(point)
}

; ed25519-sign: 簽名，回傳 R || S（64 位元組）
ed25519-sign = (seed [32]byte, msg []byte) (sig [64]byte) {

    h = sha512.sha512(seed)
    a []byte = with-len(32)
    i <- [0..32): {

        #{index-out=zero}
        a[i] = h[i]
    }
    a[0] = a[0] & 248
    a[31] = a[31] & 127
    a[31] = a[31] | 64

    ; prefix = H[32:64]
    prefix [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        prefix[i] = h[32 + i]
    }

    ; 公鑰 A
    pub [32]byte
    pub = ed25519-publickey(seed)

    ; r = SHA-512(prefix || msg) mod L
    msg-len = msg.len()

    #{overflow=wrap}
    rin []byte = with-len(32 + msg-len)
    i <- [0..32): {
        rin[i] = prefix[i]
    }
    i <- [0..msg-len): {

        #{index-out=zero, overflow=wrap}
        rin[32 + i] = msg[i]
    }
    rh = sha512.sha512(rin)
    rhb []byte = with-len(64)
    i <- [0..64): {

        #{index-out=zero}
        rhb[i] = rh[i]
    }
    rsc [32]byte
    rsc = sc-reduce(rhb)

    ; R = r * B
    rpoint []i64 = with-len(40)
    bp = ge-basepoint()
    ge-scalar-mult(rpoint, rsc, bp)
    r [32]byte
    r = ge-pack(rpoint)

    ; k = SHA-512(R || A || msg) mod L

    #{overflow=wrap}
    kin []byte = with-len(64 + msg-len)
    i <- [0..32): {
        kin[i] = r[i]
    }
    i <- [0..32): {

        #{overflow=wrap}
        kin[32 + i] = pub[i]
    }
    i <- [0..msg-len): {

        #{index-out=zero, overflow=wrap}
        kin[64 + i] = msg[i]
    }
    kh = sha512.sha512(kin)
    khb []byte = with-len(64)
    i <- [0..64): {

        #{index-out=zero}
        khb[i] = kh[i]
    }
    k [32]byte
    k = sc-reduce(khb)

    ; S = (r + k * a) mod L
    aarr [32]byte
    i <- [0..32): {

        #{index-out=zero}
        aarr[i] = a[i]
    }
    s [32]byte
    s = sc-muladd(k, aarr, rsc)

    ; sig = R || S
    i <- [0..32): {

        sig[i] = r[i]

        #{overflow=wrap}
        sig[32 + i] = s[i]
    }
}

; ed25519-verify: 驗證簽名，回傳 ok（1=有效, 0=無效）
ed25519-verify = (pub [32]byte, msg []byte, sig [64]byte) (ok i64) {

    ; R = sig[0:32], S = sig[32:64]
    r [32]byte
    i <- [0..32): {
        r[i] = sig[i]
    }
    s [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        s[i] = sig[32 + i]
    }

    ; 檢查 S < L
    i = 31
    (i >= 0) {
        {
            s[i] > ED-L[i] -> {
                ok = 0
                return
            }

            s[i] < ED-L[i] -> break
        }

        #{overflow=wrap}
        i = i - 1
    }

    ; 解壓 A、R
    a-ok = 0
    a-point []i64
    a-ok, a-point = ge-unpack(pub)
    a-ok == 0 -> {
        ok = 0
        return
    }
    r-ok = 0
    r-point []i64
    r-ok, r-point = ge-unpack(r)
    r-ok == 0 -> {
        ok = 0
        return
    }

    ; k = SHA-512(R || A || msg) mod L
    msg-len = msg.len()

    #{overflow=wrap}
    kin []byte = with-len(64 + msg-len)
    i <- [0..32): {
        kin[i] = r[i]
    }
    i <- [0..32): {

        #{overflow=wrap}
        kin[32 + i] = pub[i]
    }
    i <- [0..msg-len): {

        #{index-out=zero, overflow=wrap}
        kin[64 + i] = msg[i]
    }
    kh = sha512.sha512(kin)
    khb []byte = with-len(64)
    i <- [0..64): {

        #{index-out=zero}
        khb[i] = kh[i]
    }
    k [32]byte
    k = sc-reduce(khb)

    ; 比較 S*B 與 R + k*A
    sb []i64 = with-len(40)
    bp = ge-basepoint()
    ge-scalar-mult(sb, s, bp)

    ka []i64 = with-len(40)
    ge-scalar-mult(ka, k, a-point)
    rka []i64 = with-len(40)
    ge-add(rka, r-point, ka)
    sb-bytes [32]byte
    sb-bytes = ge-pack(sb)
    rka-bytes [32]byte
    rka-bytes = ge-pack(rka)

    ok = 1
    i <- [0..32): {
        sb-bytes[i] != rka-bytes[i] -> ok = 0
    }
}
