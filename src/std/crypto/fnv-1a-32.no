; fnv-1a — FNV-1a 非加密哈希（32bit）
;
; 快速、簡單的非加密哈希，適用於哈希表等場景。
;
; 用法：
;   h = fnv-1a-32('hello', 5)

; 計算 32-bit FNV-1a 哈希（offset basis 2166136261、prime 16777619）
; s []byte: 輸入位元組緩衝區
; n i64: 實際參與計算的位元組數；只掃描 s[0..n)
; h i64: 32-bit 哈希值（每步乘積後 & 0xFFFFFFFF），範圍 0..4294967295
; [fnv-1a-32](#fnv-1a-32.fnv-1a-32)
fnv-1a-32 = (s []byte, n i64) (h i64) {
    h = 2166136261
    i <- [0..n): {

        #{index-out=zero}
        h = h ^ s[i]

        h = (h * 16777619) & 4294967295
    }
}
