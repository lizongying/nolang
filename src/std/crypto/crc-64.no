; crc64 — CRC-64 循環冗餘校驗（ECMA-182 變體）
;
; 使用 CRC-64-ECMA 多項式 0x42F0E1EBA9EA3693。
; 反射輸入和輸出（LSB first），初始值 0，無最終異或。
;
; 用法：
;   h = new(data)

; CRC-64 反射多項式（0xC96C5795D7870F42 = reflect(0x42F0E1EBA9EA3693)）
; 由於 64-bit 常量可能溢出，使用多項式逐位計算

; 計算 CRC-64/ECMA-182（反射多項式 0xC96C5795D7870F42，初值全 1）校驗和
; data []byte: 輸入位元組，全部參與計算
; crc u64: 64-bit 校驗和（已做最終 xorout）
; [new](#crc-64.new)
new = (data []byte) (crc u64) {
    mask u64 = 18446744073709551615

    ; 反射多項式: 0xC96C5795D7870F42
    ; ⚠️ 原本常數寫成 14180682008813511362（= 0xC4CBE727901A22C2），
    ;    與註解宣稱的多項式不符 —— 小數點錯字。0xC96C5795D7870F42 的
    ;    正確十進位為 14514072000185962306。
    poly u64 = 14514072000185962306
    crc = 0
    i <- [0..data.len()): {

        #{index-out=zero}
        crc = crc ^ (data[i])
        j <- [0..8): {
            {
                crc & 1 != 0 -> crc = ((crc >> 1) ^ poly) & mask

                -> crc = (crc >> 1) & mask
            }
        }
    }
}

; 計算 CRC-64 並返回 16 位小寫 hex 字串
; data []byte: 輸入位元組，全部參與計算
; hex str: 固定 16 字元的十六進位表示（高位在前，不含 0x 前綴）
; [hex](#crc-64.hex)
hex = (data []byte) (hex str) {
    crc = new(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(16)
    i <- [0..16): {

        hex[i]: {
            ok -> it = hex-chars[(crc >> (60 - i * 4)) & 15]
            -> _
        }
    }
}
