; tdes — Triple DES (3DES) 加密/解密（ECB 模式）
;
; Triple DES 使用三個 8-byte 金鑰（K1, K2, K3），對 DES 進行三次操作。
; 加密: C = E_K3(D_K2(E_K1(P)))
; 解密: P = D_K1(E_K2(D_K3(C)))
;
; 支援 2-key 模式（K1=K3）和 3-key 模式。
;
; 用法：
;   # std/crypto/tdes
;   key [24]byte  // K1=key[0:8], K2=key[8:16], K3=key[16:24]
;   out = tdes-enc(plain, plain.len(), key)   // 加密
;   out = tdes-dec(cipher, cipher.len(), key) // 解密
; [tdes](#tdes)

; Triple DES 加密（ECB 模式）
; 對每個 8 位元組區塊執行 E_K1 → D_K2 → E_K3，區塊之間互不影響（相同明文得到相同密文）。
; in []byte: 輸入資料（長度需為 8 的倍數；不足一區塊的尾部不會被處理）
; n i64: 實際要處理的位元組數（通常為 in.len()）
; key [24]byte: 金鑰（K1 || K2 || K3，每段 8 位元組）
; 返回 out []byte: 加密後的資料，長度與 n 相同
; [tdes-enc](#tdes.tdes-enc)
tdes-enc = (in []byte, n i64, key [24]byte) (out []byte) {

    ; 提取三個金鑰
    k1 [8]byte
    k2 [8]byte
    k3 [8]byte
    i <- [0..8): {
        k1[i]: {
            ok -> it = key[i]

            -> _
        }

        #{overflow=wrap}
        ixout37c24 = key[8 + i]: {
            ok -> it

            -> _
        }

        k2[i]: {
            ok -> it = ixout37c24

            -> _
        }

        #{overflow=wrap}
        ixout44c24 = key[16 + i]: {
            ok -> it

            -> _
        }

        k3[i]: {
            ok -> it = ixout44c24

            -> _
        }
    }

    ; 逐區塊處理（每區塊 8 位元組）
    out = with-len(n)
    blk = 0
    (blk < n) {

        ; 提取當前區塊
        block []byte
        i <- [0..8): {

            #{overflow=wrap}
            ixout61c28 = in[blk + i]: {
                ok -> it

                -> _
            }

            block[i]: {
                ok -> it = ixout61c28

                -> _
            }
        }

        ; 步驟 1: E_K1
        tmp1 []byte
        tmp1 = des.des-enc(block, 8, k1)

        ; 步驟 2: D_K2
        tmp2 []byte
        tmp2 = des.des-dec(tmp1, 8, k2)

        ; 步驟 3: E_K3
        tmp3 []byte
        tmp3 = des.des-enc(tmp2, 8, k3)

        ; 寫回輸出
        i <- [0..8): {

            ixout83c28 = tmp3[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            out[blk + i] = ixout83c28
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            blk-opt = blk + 8
            blk-opt: {
                ok -> blk = it
                ->
            }
        }
    }
}

; Triple DES 解密（ECB 模式）
; 與加密相反：D_K3 → E_K2 → D_K1；同樣逐 8 位元組區塊獨立處理。
; in []byte: 輸入密文（長度需為 8 的倍數）
; n i64: 實際要處理的位元組數（通常為 in.len()）
; key [24]byte: 金鑰（K1 || K2 || K3），必須與加密時一致
; 返回 out []byte: 解密後的資料，長度與 n 相同
; [tdes-dec](#tdes.tdes-dec)
tdes-dec = (in []byte, n i64, key [24]byte) (out []byte) {
    k1 [8]byte
    k2 [8]byte
    k3 [8]byte
    i <- [0..8): {
        k1[i]: {
            ok -> it = key[i]

            -> _
        }

        #{overflow=wrap}
        ixout111c24 = key[8 + i]: {
            ok -> it

            -> _
        }

        k2[i]: {
            ok -> it = ixout111c24

            -> _
        }

        #{overflow=wrap}
        ixout118c24 = key[16 + i]: {
            ok -> it

            -> _
        }

        k3[i]: {
            ok -> it = ixout118c24

            -> _
        }
    }
    out = with-len(n)
    blk = 0
    (blk < n) {
        block []byte
        i <- [0..8): {

            #{overflow=wrap}
            ixout131c28 = in[blk + i]: {
                ok -> it

                -> _
            }

            block[i]: {
                ok -> it = ixout131c28

                -> _
            }
        }

        ; 步驟 1: D_K3
        tmp1 []byte
        tmp1 = des.des-dec(block, 8, k3)

        ; 步驟 2: E_K2
        tmp2 []byte
        tmp2 = des.des-enc(tmp1, 8, k2)

        ; 步驟 3: D_K1
        tmp3 []byte
        tmp3 = des.des-dec(tmp2, 8, k1)

        i <- [0..8): {

            ixout152c28 = tmp3[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            out[blk + i] = ixout152c28
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            blk-opt2 = blk + 8
            blk-opt2: {
                ok -> blk = it
                ->
            }
        }
    }
}

; 3DES-CBC 模式
...

; Triple DES-CBC 加密
; 每個區塊先與前一區塊的密文（首塊為 iv）異或再走 3DES-ECB，
; 因此相同明文在不同 iv 下得到不同密文。
; in []byte: 輸入資料（長度需為 8 的倍數）
; key [24]byte: 金鑰（K1 || K2 || K3）
; iv [8]byte: 初始向量，每個訊息應唯一
; 返回 out []byte: 加密後的資料，長度與 in 相同
; [tdes-cbc-enc](#tdes.tdes-cbc-enc)
tdes-cbc-enc = (in []byte, key [24]byte, iv [8]byte) (out []byte) {
    prev [8]byte
    i <- [0..8): {
        prev[i]: {
            ok -> it = iv[i]

            -> _
        }
    }
    out = with-len(in.len())
    blk = 0
    (blk < in.len()) {

        ; XOR 當前區塊與 prev
        xored [8]byte
        i <- [0..8): {

            ixout191c29 = in[blk + i]: {
                ok -> it

                -> _
            }

            ixout191c45 = prev[i]: {
                ok -> it

                -> _
            }

            xored[i]: {
                ok -> it = (ixout191c29) ^ (ixout191c45)

                -> _
            }
        }

        ; 3DES 加密
        enc-block []byte
        enc-block = tdes-enc(xored, 8, key)

        ; 寫回輸出並更新 prev
        i <- [0..8): {

            ixout205c28 = enc-block[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            out[blk + i] = ixout205c28

            ixout209c28 = enc-block[i]: {
                ok -> it

                -> _
            }

            prev[i]: {
                ok -> it = ixout209c28

                -> _
            }
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            blk-opt3 = blk + 8
            blk-opt3: {
                ok -> blk = it
                ->
            }
        }
    }
}

; Triple DES-CBC 解密
; 每塊先做 3DES-ECB 解密，再與前一段密文（首塊為 iv）異或還原明文。
; in []byte: 輸入密文（長度需為 8 的倍數）
; key [24]byte: 金鑰（K1 || K2 || K3），必須與加密時一致
; iv [8]byte: 初始向量，必須與加密時相同
; 返回 out []byte: 解密後的資料，長度與 in 相同
; [tdes-cbc-dec](#tdes.tdes-cbc-dec)
tdes-cbc-dec = (in []byte, key [24]byte, iv [8]byte) (out []byte) {
    prev [8]byte
    i <- [0..8): {
        prev[i]: {
            ok -> it = iv[i]

            -> _
        }
    }
    out = with-len(in.len())
    blk = 0
    (blk < in.len()) {
        cipher-block [8]byte
        i <- [0..8): {

            #{overflow=wrap}
            ixout244c28 = in[blk + i]: {
                ok -> it

                -> _
            }

            cipher-block[i]: {
                ok -> it = ixout244c28

                -> _
            }
        }
        dec-block []byte
        dec-block = tdes-dec(cipher-block, 8, key)

        i <- [0..8): {

            ixout255c29 = dec-block[i]: {
                ok -> it

                -> _
            }

            ixout255c46 = prev[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            out[blk + i] = (ixout255c29) ^ (ixout255c46)

            prev[i]: {
                ok -> it = cipher-block[i]

                -> _
            }
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            blk-opt4 = blk + 8
            blk-opt4: {
                ok -> blk = it
                ->
            }
        }
    }
}
