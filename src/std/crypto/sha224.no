; sha224 — SHA-224 安全哈希算法（224-bit）
;
; SHA-224 使用與 SHA-256 相同的壓縮函數，但使用不同的初始值並截斷輸出為 28 位元組。
; 底層呼叫 sha256-block 處理 512-bit 區塊。
;
; 用法：
;   # std/crypto/sha224
;   hash = sha224(data)       // hash = 28 位元組 [28]byte
;   hex = sha224-hex(data)    // hex = 56 字元 hex 字串

; 計算 SHA-224 雜湊（含填充與多區塊處理；壓縮函數與 SHA-256 相同，初始值不同）
; data []byte: 輸入位元組陣列（任意長度）
; hash [28]byte: 224-bit 摘要（取 SHA-256 前 7 個狀態字），大端序存放
; [sha224](#sha224.sha224)
sha224 = (data []byte) (hash [28]byte) {

    ; SHA-224 初始狀態（不同於 SHA-256）
    h0 u32 = 3238371032
    h1 u32 = 914150663
    h2 u32 = 812702999
    h3 u32 = 4144912697
    h4 u32 = 4290775857
    h5 u32 = 1750603025
    h6 u32 = 1694076839
    h7 u32 = 3204075428

    dlen = data.len()

    ; 填充：0x80 + 0x00*pad + 8-byte big-endian bit length
    ; 總長度需為 64 的倍數
    #{overflow=wrap}
    bit-len = dlen * 8

    #{overflow=wrap}
    mod-val = (dlen + 9) % 64
    pad-len = 0

    #{overflow=wrap}
    mod-val != 0 -> pad-len = 64 - mod-val

    #{overflow=wrap}
    total-len = dlen + 1 + pad-len + 8

    ; 建立填充緩衝區：with-len 直接給出 len=total-len 的全零緩衝。
    ; 不可寫成 `padded []byte`（nil、len=0）再用 place-match 填充——
    ; 越界的 ok 臂永不觸發，資料會被靜默丟棄。
    padded []byte = with-len(total-len)

    ; 複製原始資料
    i <- [0..dlen): {

        #{index-out=zero}
        padded[i]: {
            ok -> it = data[i]
            -> _
        }
    }

    ; 填充 0x80
    padded[dlen]: {
        ok -> it = 128
        -> _
    }

    ; 填充 0x00
    i <- [dlen + 1..total-len - 8): {

        padded[i]: {
            ok -> it = 0
            -> _
        }
    }

    ; 填充 bit-len（big-endian 64-bit）
    i <- [0..8): {

        #{overflow=wrap}
        padded[total-len - 8 + i]: {
            ok -> it = (bit-len >> (56 - i * 8)) & 255
            -> _
        }
    }

    ; 處理每個 64 位元組區塊（同樣必須 with-len，否則 place-match 寫入不生效）
    block []u32 = with-len(16)
    offset = 0
    (offset < total-len) {
        ; 注意：必須用普通賦值；option 寫入 ok 分支主體內讀 []byte 會被編譯器錯算 GEP（+0x100）→ digest 錯。
        i <- [0..16): {

            #{index-out=zero, overflow=wrap}
            block[i] = (padded[offset + i * 4] << 24) | (padded[offset + i * 4 + 1] << 16) | (padded[offset + i * 4 + 2] << 8) | padded[offset + i * 4 + 3]
        }

        h0, h1, h2, h3, h4, h5, h6, h7 = sha256.sha256-block(block, h0, h1, h2, h3, h4, h5, h6, h7)

        #{overflow=wrap}
        offset = offset + 64
    }

    ; 輸出 28 位元組雜湊值（big-endian，截斷 h0..h6 的前 28 位元組）
    hash[0] = (h0 >> 24) & 255

    hash[1] = (h0 >> 16) & 255

    hash[2] = (h0 >> 8) & 255

    hash[3] = h0 & 255

    hash[4] = (h1 >> 24) & 255

    hash[5] = (h1 >> 16) & 255

    hash[6] = (h1 >> 8) & 255

    hash[7] = h1 & 255

    hash[8] = (h2 >> 24) & 255

    hash[9] = (h2 >> 16) & 255

    hash[10] = (h2 >> 8) & 255

    hash[11] = h2 & 255

    hash[12] = (h3 >> 24) & 255

    hash[13] = (h3 >> 16) & 255

    hash[14] = (h3 >> 8) & 255

    hash[15] = h3 & 255

    hash[16] = (h4 >> 24) & 255

    hash[17] = (h4 >> 16) & 255

    hash[18] = (h4 >> 8) & 255

    hash[19] = h4 & 255

    hash[20] = (h5 >> 24) & 255

    hash[21] = (h5 >> 16) & 255

    hash[22] = (h5 >> 8) & 255

    hash[23] = h5 & 255

    hash[24] = (h6 >> 24) & 255

    hash[25] = (h6 >> 16) & 255

    hash[26] = (h6 >> 8) & 255

    hash[27] = h6 & 255
}

; 計算 SHA-224 雜湊並返回 hex 字串
; data []byte: 輸入位元組陣列（任意長度）
; hex str: 56 字元小寫十六進位摘要
; [sha224-hex](#sha224.sha224-hex)
sha224-hex = (data []byte) (hex str) {
    hash = sha224(data)

    hex-chars = '0123456789abcdef'
    hex str = with-len(56)

    i <- [0..28): {

        #{overflow=wrap}
        hex[i * 2]: {
            ok -> it = hex-chars[(hash[i] >> 4) & 15]
            -> _
        }

        #{overflow=wrap}
        hex[i * 2 + 1]: {
            ok -> it = hex-chars[hash[i] & 15]
            -> _
        }
    }
}
