; sha3 — SHA-3 (Keccak) 安全哈希算法
;
; 實作 NIST FIPS 202 定義的 SHA-3 系列，基於 Keccak 海綿結構。
; 提供 SHA3-224、SHA3-256、SHA3-384、SHA3-512 四種輸出長度。
;
; 內部狀態為 1600-bit（25 × 64-bit lanes），Keccak-f[1600] 含 24 輪。
;
; 用法：
;   # std/crypto/sha3
;   hash28 = sha3.sha3-224(data)     // [28]byte
;   hash32 = sha3.sha3-256(data)     // [32]byte
;   hash48 = sha3.sha3-384(data)     // [48]byte
;   hash64 = sha3.sha3-512(data)     // [64]byte
;   hex = sha3.sha3-256-hex(data)    // 64 字元 hex

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 旋轉偏移表（rho），25 個 lane 的旋轉量
; 排列: lane[x][y] -> index = x + 5*y (x=0..4, y=0..4)
KECCAK-RHO [25]i64 = [
    0, 1, 62, 28, 27, 36, 44, 6,
    55, 20, 3, 10, 43, 25, 39, 41,
    45, 15, 21, 8, 18, 2, 61, 56,
    14,
]

; 輪常量（iota），24 輪
; rc[t] 由 8-bit LFSR（x^8 + x^6 + x^5 + x^4 + 1）產生，
; 位元分佈在 2^j - 1（j = 0..6，即 bit 0/1/3/7/15/31/63）。
KECCAK-RC [24]u64 = [
    1, 32898, 9223372036854808714, 9223372039002292224,
    32907, 2147483649, 9223372039002292353, 9223372036854808585,
    138, 136, 2147516425, 2147483658,
    2147516555, 9223372036854775947, 9223372036854808713, 9223372036854808579,
    9223372036854808578, 9223372036854775936, 32778, 9223372039002259466,
    9223372039002292353, 9223372036854808704, 2147483649, 9223372039002292232,
]

; 64-bit 全 1 遮罩
SHA3-MASK64 u64 = 18446744073709551615

; 填充最高位元（0x80 落在 lane 的最高位元組時用，避免 i64 位移溢位）
SHA3-PAD-HIGH u64 = 128

; ═══════════════════════════════════════════════
; 輔助函數
; ═══════════════════════════════════════════════

; rotl64: 64-bit 循環左移
; x u64: 待旋轉的值
; n i64: 旋轉量（0..63，會先 mod 64，避免位移 64 的未定義行為）
rotl64 = (x u64, n i64) (r u64) {
    #{overflow=wrap}
    m = n % 64
    m == 0 -> {
        r = x & SHA3-MASK64
        return
    }
    #{overflow=wrap}
    r = ((x << m) | (x >> (64 - m))) & SHA3-MASK64
}

; ═══════════════════════════════════════════════
; Keccak-f[1600] 置換
; ═══════════════════════════════════════════════

; keccak-f1600: 執行 Keccak-f[1600] 置換（24 輪）
; state []u64: 25 個 64-bit lane（輸入/輸出）
keccak-f1600 = (state []u64) {
    round <- [0..24): {

        ; θ (theta)
        c [5]u64
        x <- [0..5): {
            #{overflow=wrap}
            #{index-out = 0}
            c[x] = state[x] ^ state[x + 5] ^ state[x + 10] ^ state[x + 15] ^ state[x + 20]
        }
        d [5]u64
        x <- [0..5): {
            #{overflow=wrap}
            x1 = (x + 1) % 5
            #{overflow=wrap}
            x4 = (x + 4) % 5
            #{index-out = 0}
            d[x] = c[x4] ^ rotl64(c[x1], 1)
        }
        x <- [0..5): {
            y <- [0..5): {
                #{overflow=wrap}
                #{index-out = 0}
                state[x + 5 * y] = state[x + 5 * y] ^ d[x]
            }
        }

        ; ρ (rho) + π (pi) 合併
        b [25]u64
        x <- [0..5): {
            y <- [0..5): {
                #{overflow=wrap}
                #{index-out = 0}
                rc = KECCAK-RHO[x + 5 * y]
                #{overflow=wrap}
                #{index-out = 0}
                val = state[x + 5 * y]
                #{index-out = 0}
                rotated = rotl64(val, rc)

                ; π: new[x'][y'] where x' = y, y' = (2x+3y) % 5
                nx = y
                #{overflow=wrap}
                ny = (2 * x + 3 * y) % 5
                #{overflow=wrap}
                #{index-out = 0}
                b[nx + 5 * ny] = rotated
            }
        }

        ; χ (chi)
        x <- [0..5): {
            y <- [0..5): {
                #{overflow=wrap}
                x1 = (x + 1) % 5
                #{overflow=wrap}
                x2 = (x + 2) % 5
                #{overflow=wrap}
                #{index-out = 0}
                state[x + 5 * y] = b[x + 5 * y] ^ ((SHA3-MASK64 ^ b[x1 + 5 * y]) & b[x2 + 5 * y])
            }
        }

        ; ι (iota)
        #{index-out = 0}
        state[0] = state[0] ^ KECCAK-RC[round]
    }
}

; ═══════════════════════════════════════════════
; 海綿函數
; ═══════════════════════════════════════════════

; keccak-sponge: Keccak 海綿函數
; data []byte: 輸入資料
; rate i64: 位元率（以位元組為單位，必須是 8 的倍數）
; capacity i64: 容量（以位元組為單位，rate + capacity = 200）
; out-len i64: 輸出長度（位元組）
; suffix byte: 填充後綴（SHA-3 = 0x06, SHAKE = 0x1F）
; 返回 out []byte: 輸出雜湊值
keccak-sponge = (data []byte, rate i64, capacity i64, out-len i64, suffix byte) (out []byte) {
    #{overflow=wrap}
    out = with-len(out-len)

    ; 初始化狀態（25 個 64-bit lane，全零）
    state []u64 = with-len(25)
    i <- [0..25): {
        #{index-out = 0}
        state[i] = 0
    }
    dlen = data.len()

    ; 吸收階段（absorbing）
    ; 先處理所有「完整」的 rate 位元組區塊，每區塊吸收後立即置換
    absorbed = 0
    w u64 = 0
    s-term u64 = suffix
    {
        i <- [0..rate): {
            #{overflow=wrap}
            lane-idx = i / 8
            #{overflow=wrap}
            byte-idx = i % 8
            #{index-out = 0}
            w = data[absorbed + i]
            #{overflow=wrap}
            #{index-out = 0}
            state[lane-idx] = state[lane-idx] ^ (w << (byte-idx * 8))
        }

        #{overflow=wrap}
        keccak-f1600(state)
        #{overflow=wrap}
        absorbed = absorbed + rate
    } (absorbed + rate <= dlen)

    ; 剩餘的最後一個區塊（0..rate-1 位元組）：只吸收，尚未置換
    i <- [0..rate): {
        absorbed + i < dlen -> {
            #{overflow=wrap}
            lane-idx = i / 8
            #{overflow=wrap}
            byte-idx = i % 8
            #{index-out = 0}
            w = data[absorbed + i]
            #{overflow=wrap}
            #{index-out = 0}
            state[lane-idx] = state[lane-idx] ^ (w << (byte-idx * 8))
        }
    }

    ; 填充：suffix || 0x00... || 0x80（在同一個 rate 區塊內）
    ; SHA-3: domain separation = 0x06，最後一個位元組的最高位元設為 1
    ; remaining == rate - 1 時，suffix 與 0x80 落在同一位元組，兩次 XOR 自然合成 0x86
    #{overflow=wrap}
    remaining = dlen - absorbed
    #{overflow=wrap}
    pad-lane-idx = remaining / 8
    #{overflow=wrap}
    pad-byte-idx = remaining % 8
    #{overflow=wrap}
    #{index-out = 0}
    state[pad-lane-idx] = state[pad-lane-idx] ^ (s-term << (pad-byte-idx * 8))

    #{overflow=wrap}
    last-lane-idx = (rate - 1) / 8
    #{overflow=wrap}
    last-byte-idx = (rate - 1) % 8
    #{overflow=wrap}
    #{index-out = 0}
    state[last-lane-idx] = state[last-lane-idx] ^ (SHA3-PAD-HIGH << (last-byte-idx * 8))

    keccak-f1600(state)

    ; 擠出階段（squeezing）
    squeezed = 0
    {
        i <- [0..rate): {
            squeezed + i < out-len -> {
                #{overflow=wrap}
                lane-idx = i / 8
                #{overflow=wrap}
                byte-idx = i % 8
                #{index-out = 0}
                out[squeezed + i] = (state[lane-idx] >> (byte-idx * 8)) & 255
            }
        }

        #{overflow=wrap}
        squeezed = squeezed + rate
        squeezed < out-len -> keccak-f1600(state)
    } (squeezed < out-len)
}

; ═══════════════════════════════════════════════
; SHA-3 公開 API
; ═══════════════════════════════════════════════

; sha3-224: 計算 SHA3-224 雜湊
; data []byte: 輸入資料
; 返回 hash [28]byte: 28 位元組雜湊值
sha3-224 = (data []byte) (hash [28]byte) {
    out []byte = keccak-sponge(data, 144, 56, 28, 0x06)
    i <- [0..28): {
        #{index-out = 0}
        hash[i] = out[i]
    }
}

; sha3-256: 計算 SHA3-256 雜湊
; data []byte: 輸入資料
; 返回 hash [32]byte: 32 位元組雜湊值
sha3-256 = (data []byte) (hash [32]byte) {
    out []byte = keccak-sponge(data, 136, 64, 32, 0x06)
    i <- [0..32): {
        #{index-out = 0}
        hash[i] = out[i]
    }
}

; sha3-384: 計算 SHA3-384 雜湊
; data []byte: 輸入資料
; 返回 hash [48]byte: 48 位元組雜湊值
sha3-384 = (data []byte) (hash [48]byte) {
    out []byte = keccak-sponge(data, 104, 96, 48, 0x06)
    i <- [0..48): {
        #{index-out = 0}
        hash[i] = out[i]
    }
}

; sha3-512: 計算 SHA3-512 雜湊
; data []byte: 輸入資料
; 返回 hash [64]byte: 64 位元組雜湊值
sha3-512 = (data []byte) (hash [64]byte) {
    out []byte = keccak-sponge(data, 72, 128, 64, 0x06)
    i <- [0..64): {
        #{index-out = 0}
        hash[i] = out[i]
    }
}

; ═══════════════════════════════════════════════
; Hex 便捷函數
; ═══════════════════════════════════════════════

; sha3-224-hex: 計算 SHA3-224 並返回 hex 字串
; data []byte: 輸入資料
; 返回 hex str: 56 字元 hex 字串
sha3-224-hex = (data []byte) (hex str) {
    hash = sha3-224(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(56)
    i <- [0..28): {
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2] = hex-chars[(hash[i] >> 4) & 15]
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2 + 1] = hex-chars[hash[i] & 15]
    }
}

; sha3-256-hex: 計算 SHA3-256 並返回 hex 字串
; data []byte: 輸入資料
; 返回 hex str: 64 字元 hex 字串
sha3-256-hex = (data []byte) (hex str) {
    hash = sha3-256(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(64)
    i <- [0..32): {
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2] = hex-chars[(hash[i] >> 4) & 15]
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2 + 1] = hex-chars[hash[i] & 15]
    }
}

; sha3-384-hex: 計算 SHA3-384 並返回 hex 字串
; data []byte: 輸入資料
; 返回 hex str: 96 字元 hex 字串
sha3-384-hex = (data []byte) (hex str) {
    hash = sha3-384(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(96)
    i <- [0..48): {
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2] = hex-chars[(hash[i] >> 4) & 15]
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2 + 1] = hex-chars[hash[i] & 15]
    }
}

; sha3-512-hex: 計算 SHA3-512 並返回 hex 字串
; data []byte: 輸入資料
; 返回 hex str: 128 字元 hex 字串
sha3-512-hex = (data []byte) (hex str) {
    hash = sha3-512(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(128)
    i <- [0..64): {
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2] = hex-chars[(hash[i] >> 4) & 15]
        #{overflow=wrap}
        #{index-out = 0}
        hex[i * 2 + 1] = hex-chars[hash[i] & 15]
    }
}
