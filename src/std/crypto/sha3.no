; sha3 — SHA-3 (Keccak) 安全哈希算法
;
; 實作 NIST FIPS 202 定義的 SHA-3 系列，基於 Keccak 海綿結構。
; 提供 SHA3-224、SHA3-256、SHA3-384、SHA3-512 四種輸出長度。
;
; 內部狀態為 1600-bit（25 × 64-bit lanes），Keccak-f[1600] 含 24 輪。
;
; 用法：
;   # std/crypto/sha3
;   hash28 = sha3.sha3-224(data)     // [28]byte
;   hash32 = sha3.sha3-256(data)     // [32]byte
;   hash48 = sha3.sha3-384(data)     // [48]byte
;   hash64 = sha3.sha3-512(data)     // [64]byte
;   hex = sha3.sha3-256-hex(data)    // 64 字元 hex
; [sha3](#sha3)

; 常量
...

; 旋轉偏移表（rho），25 個 lane 的旋轉量
; 排列: lane[x][y] -> index = x + 5*y (x=0..4, y=0..4)
; [KECCAK-RHO](#sha3.keccak-rho)
KECCAK-RHO = [
    0, 1, 62, 28, 27, 36, 44, 6,
    55, 20, 3, 10, 43, 25, 39, 41,
    45, 15, 21, 8, 18, 2, 61, 56,
    14,
]

; 輪常量（iota），24 輪
; rc[t] 由 8-bit LFSR（x^8 + x^6 + x^5 + x^4 + 1）產生，
; 位元分佈在 2^j - 1（j = 0..6，即 bit 0/1/3/7/15/31/63）。
; [KECCAK-RC](#sha3.keccak-rc)
KECCAK-RC [24]u64 = [
    1, 32898, 9223372036854808714, 9223372039002292224, 32907, 2147483649, 9223372039002292353, 9223372036854808585,
    138, 136, 2147516425, 2147483658, 2147516555, 9223372036854775947, 9223372036854808713, 9223372036854808579,
    9223372036854808578, 9223372036854775936, 32778, 9223372039002259466, 9223372039002292353, 9223372036854808704, 2147483649, 9223372039002292232,
]

; 64-bit 全 1 遮罩
; [SHA3-MASK64](#sha3.sha3-mask64)
SHA3-MASK64 u64 = 18446744073709551615

; 填充最高位元（0x80 落在 lane 的最高位元組時用，避免 i64 位移溢位）
; [SHA3-PAD-HIGH](#sha3.sha3-pad-high)
SHA3-PAD-HIGH u64 = 128

; 輔助函數
...

; 64-bit 循環左移
; x: 待循環左移的 64 位元值
; n: 左移量（0..63，會先 mod 64，避免位移 64 的未定義行為）
; r: 循環左移後的結果
; [rotl64](#sha3.rotl64)
rotl64 = (x u64, n i64) (r u64) {

    #{overflow=wrap}
    m = n % 64
    m == 0 -> {
        r = x & SHA3-MASK64
        return
    }

    r = ((x << m) | (x >> (64 - m))) & SHA3-MASK64
}

; Keccak-f[1600] 置換
...

; 執行 Keccak-f[1600] 置換（24 輪）
; state: 25 個 64-bit lane 的狀態陣列（原地輸入/輸出）
; [keccak-f1600](#sha3.keccak-f1600)
keccak-f1600 = (state []u64) {
    round <- [0..24): {

        ; θ (theta)
        c [5]u64
        x <- [0..5): {
            ; 每列的 5 個 lane 依 stride 5 展開後 XOR 起來
            column u64 = 0
            k <- [0..5): {
                {
                    #{overflow=wrap}
                    lane-at ?= x + k * 5

                    lane ?= state[lane-at]

                    column = column ^ lane
                }: {
                    err -> _

                    -> _
                }
            }

            c[x]: {
                ok -> it = column

                -> _
            }
        }
        d [5]u64
        x <- [0..5): {

            #{overflow=wrap}
            x1 = (x + 1) % 5

            #{overflow=wrap}
            x4 = (x + 4) % 5

            c-x4 = c[x4]: {
                ok -> it

                -> _
            }

            c-x1 = c[x1]: {
                ok -> it

                -> _
            }

            d[x]: {
                ok -> it = c-x4 ^ rotl64(c-x1, 1)

                -> _
            }
        }
        x <- [0..5): {
            y <- [0..5): {

                #{overflow=wrap}
                state-x-5-y = state[x + 5 * y]: {
                    ok -> it

                    -> _
                }

                d-x = d[x]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                state[x + 5 * y]: {
                    ok -> it = state-x-5-y ^ d-x

                    -> _
                }
            }
        }

        ; ρ (rho) + π (pi) 合併
        b [25]u64
        x <- [0..5): {
            y <- [0..5): {

                #{overflow=wrap}
                rc u64 = KECCAK-RHO[x + 5 * y]

                #{overflow=wrap}
                val u64 = state[x + 5 * y]: {
                    ok -> it

                    -> 0
                }

                rotated = rotl64(val, rc)

                ; π: new[x'][y'] where x' = y, y' = (2x+3y) % 5
                nx = y

                #{overflow=wrap}
                ny = (2 * x + 3 * y) % 5

                #{overflow=wrap}
                b[nx + 5 * ny]: {
                    ok -> it = rotated

                    -> _
                }
            }
        }

        ; χ (chi)
        x <- [0..5): {
            y <- [0..5): {

                #{overflow=wrap}
                x1 = (x + 1) % 5

                #{overflow=wrap}
                x2 = (x + 2) % 5

                #{overflow=wrap}
                b-x-5-y = b[x + 5 * y]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                b-x1-5-y = b[x1 + 5 * y]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                b-x2-5-y = b[x2 + 5 * y]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                state[x + 5 * y]: {
                    ok -> it = b-x-5-y ^ ((SHA3-MASK64 ^ b-x1-5-y) & b-x2-5-y)

                    -> _
                }
            }
        }

        ; ι (iota)
        lane-zero = state[0]: {
            ok -> it

            -> _
        }

        keccak-rc-round = KECCAK-RC[round]: {
            ok -> it

            -> _
        }

        state[0]: {
            ok -> it = lane-zero ^ keccak-rc-round

            -> _
        }
    }
}

; 海綿函數
...

; Keccak 海綿函數
; data: 要吸收（absorb）到海綿狀態的原始位元組，可為空
; rate: 吸收率（以位元組為單位，必須是 8 的倍數）
; capacity: 容量（以位元組為單位，rate + capacity = 200）
; out-len: 期望輸出的位元組長度
; suffix: 填充後綴（SHA-3 = 0x06, SHAKE = 0x1F）
; 返回 out: 擠出（squeeze）出的雜湊/輸出位元組
; [keccak-sponge](#sha3.keccak-sponge)
keccak-sponge = (data []byte, rate i64, capacity i64, out-len i64, suffix byte) (out []byte) {
    out = with-len(out-len)

    ; 初始化狀態（25 個 64-bit lane，全零）
    state []u64 = with-len(25)
    e <- state: {
        e: {
            ok -> it = 0

            -> _
        }
    }
    dlen = data.len()

    ; 吸收階段（absorbing）
    ; 先處理所有「完整」的 rate 位元組區塊，每區塊吸收後立即置換
    absorbed = 0
    w u64 = 0
    s-term u64 = suffix

    (absorbed + rate <= dlen) {
        i <- [0..rate): {

            #{overflow=wrap}
            lane-idx = i / 8

            #{overflow=wrap}
            byte-idx = i % 8

            #{overflow=wrap}
            w = data[absorbed + i]: {
                ok -> it

                -> 0
            }

            state-lane-idx = state[lane-idx]: {
                ok -> it

                -> _
            }

            state[lane-idx]: {
                ok -> it = state-lane-idx ^ (w << (byte-idx * 8))

                -> _
            }
        }

        keccak-f1600(state)

        {
            #{overflow=wrap}
            absorbed ?= absorbed + rate
        }: {
            err -> _

            -> _
        }
    }

    ; 剩餘的最後一個區塊（0..rate-1 位元組）：只吸收，尚未置換
    i <- [0..rate): {

        #{overflow=wrap}
        absorbed + i < dlen -> {

            #{overflow=wrap}
            lane-idx = i / 8

            #{overflow=wrap}
            byte-idx = i % 8

            #{overflow=wrap}
            w = data[absorbed + i]: {
                ok -> it

                -> 0
            }

            state-lane-idx = state[lane-idx]: {
                ok -> it

                -> _
            }

            state[lane-idx]: {
                ok -> it = state-lane-idx ^ (w << (byte-idx * 8))

                -> _
            }
        }
    }

    ; 填充：suffix || 0x00... || 0x80（在同一個 rate 區塊內）
    ; SHA-3: domain separation = 0x06，最後一個位元組的最高位元設為 1
    ; remaining == rate - 1 時，suffix 與 0x80 落在同一位元組，兩次 XOR 自然合成 0x86
    #{overflow=wrap}
    remaining = dlen - absorbed

    #{overflow=wrap}
    pad-lane-idx = remaining / 8

    #{overflow=wrap}
    pad-byte-idx = remaining % 8

    state-pad-lane-idx = state[pad-lane-idx]: {
        ok -> it

        -> _
    }

    state[pad-lane-idx]: {
        ok -> it = state-pad-lane-idx ^ (s-term << (pad-byte-idx * 8))

        -> _
    }

    #{overflow=wrap}
    last-lane-idx = (rate - 1) / 8

    #{overflow=wrap}
    last-byte-idx = (rate - 1) % 8

    state-last-lane-idx = state[last-lane-idx]: {
        ok -> it

        -> _
    }

    state[last-lane-idx]: {
        ok -> it = state-last-lane-idx ^ (SHA3-PAD-HIGH << (last-byte-idx * 8))

        -> _
    }

    keccak-f1600(state)

    ; 擠出階段（squeezing）
    squeezed = 0
    (squeezed < out-len) {
        i <- [0..rate): {

            #{overflow=wrap}
            squeezed + i < out-len -> {

                #{overflow=wrap}
                lane-idx = i / 8

                #{overflow=wrap}
                byte-idx = i % 8

                state-lane-idx = state[lane-idx]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                out[squeezed + i]: {
                    ok -> it = (state-lane-idx >> (byte-idx * 8)) & 255

                    -> _
                }
            }
        }

        {
            #{overflow=wrap}
            squeezed ?= squeezed + rate
        }: {
            err -> _

            -> _
        }
        squeezed < out-len -> keccak-f1600(state)
    }
}

; SHA-3 公開 API
...

; 計算 SHA3-224 雜湊
; data: 待雜湊的原始位元組，可為空
; 返回 hash: 28 位元組雜湊值
; [sha3-224](#sha3.sha3-224)
sha3-224 = (data []byte) (hash [28]byte) {
    out = keccak-sponge(data, 144, 56, 28, 0x06)
    i <- [0..28): {
        hash[i] = out[i]: {
            ok -> it

            -> _
        }
    }
}

; 計算 SHA3-256 雜湊
; data: 待雜湊的原始位元組，可為空
; 返回 hash: 32 位元組雜湊值
; [sha3-256](#sha3.sha3-256)
sha3-256 = (data []byte) (hash [32]byte) {
    out = keccak-sponge(data, 136, 64, 32, 0x06)
    i <- [0..32): {
        hash[i] = out[i]: {
            ok -> it

            -> _
        }
    }
}

; 計算 SHA3-384 雜湊
; data: 待雜湊的原始位元組，可為空
; 返回 hash: 48 位元組雜湊值
; [sha3-384](#sha3.sha3-384)
sha3-384 = (data []byte) (hash [48]byte) {
    out = keccak-sponge(data, 104, 96, 48, 0x06)
    i <- [0..48): {
        hash[i] = out[i]: {
            ok -> it

            -> _
        }
    }
}

; 計算 SHA3-512 雜湊
; data: 待雜湊的原始位元組，可為空
; 返回 hash: 64 位元組雜湊值
; [sha3-512](#sha3.sha3-512)
sha3-512 = (data []byte) (hash [64]byte) {
    out = keccak-sponge(data, 72, 128, 64, 0x06)
    i <- [0..64): {
        hash[i] = out[i]: {
            ok -> it

            -> _
        }
    }
}

; Hex 便捷函數
...

; 計算 SHA3-224 並返回 hex 字串
; data: 待雜湊的原始位元組，可為空
; 返回 hex: 56 字元 hex 字串
; [sha3-224-hex](#sha3.sha3-224-hex)
sha3-224-hex = (data []byte) (hex str) {
    hash = sha3-224(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(56)
    i <- [0..28): {
        {
            word ?= hash[i]

            #{overflow=wrap}
            hex[i * 2] ?= hex-chars[(word >> 4) & 15]

            #{overflow=wrap}
            hex[i * 2 + 1] ?= hex-chars[word & 15]
        }: {
            err -> _

            -> _
        }
    }
}

; 計算 SHA3-256 並返回 hex 字串
; data: 待雜湊的原始位元組，可為空
; 返回 hex: 64 字元 hex 字串
; [sha3-256-hex](#sha3.sha3-256-hex)
sha3-256-hex = (data []byte) (hex str) {
    hash = sha3-256(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(64)
    i <- [0..32): {
        {
            word ?= hash[i]

            #{overflow=wrap}
            hex[i * 2] ?= hex-chars[(word >> 4) & 15]

            #{overflow=wrap}
            hex[i * 2 + 1] ?= hex-chars[word & 15]
        }: {
            err -> _

            -> _
        }
    }
}

; 計算 SHA3-384 並返回 hex 字串
; data: 待雜湊的原始位元組，可為空
; 返回 hex: 96 字元 hex 字串
; [sha3-384-hex](#sha3.sha3-384-hex)
sha3-384-hex = (data []byte) (hex str) {
    hash = sha3-384(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(96)
    i <- [0..48): {
        {
            word ?= hash[i]

            #{overflow=wrap}
            hex[i * 2] ?= hex-chars[(word >> 4) & 15]

            #{overflow=wrap}
            hex[i * 2 + 1] ?= hex-chars[word & 15]
        }: {
            err -> _

            -> _
        }
    }
}

; 計算 SHA3-512 並返回 hex 字串
; data: 待雜湊的原始位元組，可為空
; 返回 hex: 128 字元 hex 字串
; [sha3-512-hex](#sha3.sha3-512-hex)
sha3-512-hex = (data []byte) (hex str) {
    hash = sha3-512(data)
    hex-chars = '0123456789abcdef'
    hex str = with-len(128)
    i <- [0..64): {
        {
            word ?= hash[i]

            #{overflow=wrap}
            hex[i * 2] ?= hex-chars[(word >> 4) & 15]

            #{overflow=wrap}
            hex[i * 2 + 1] ?= hex-chars[word & 15]
        }: {
            err -> _

            -> _
        }
    }
}
