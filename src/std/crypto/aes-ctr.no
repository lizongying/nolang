; aes-ctr — AES-CTR 計數器模式（AES-128 與 AES-256）
;
; CTR 模式將區塊加密器轉為串流加密器。
; 計數器遞增並加密，產生的密鑰流與明文 XOR；加解密是同一個操作。
;
; 金鑰長度不是檔案維度：同一份 CTR 邏輯服務 AES-128 與 AES-256，
; 差別只在入口用 aes.key-expand 還是 aes.key-expand-256。
;
; 用法：
;   iv [16]byte
;   key [16]byte
;   cipher = aes-ctr.crypt-128(plain, key, iv)   ; 加密
;   plain  = aes-ctr.crypt-128(cipher, key, iv)  ; 解密（同一個函式）
;   ; AES-256 改用 key [32]byte 與 crypt-256
; [aes-ctr](#aes-ctr)

; 計數器遞增（大端序，先加最低 32 位元，進位再往高位傳播）
; cb: 16 位元組計數器區塊，原地修改；只會動到後 4 位元組（下標 12–15）
; [ctr-inc](#aes-ctr.ctr-inc)
ctr-inc = (cb []byte) {
    ; 大端計數器加 1：從最低位元組往上加，位元組回繞成 0 才繼續進位
    carry = 1
    j = 15
    (j >= 0 && carry == 1) {
        {
            #{overflow=wrap}
            old-byte ?= cb[j]

            #{overflow=wrap}
            new-byte = (old-byte + carry) & 255

            cb[j]: {
                ok -> it = new-byte

                -> _
            }

            carry = 0

            new-byte == 0 -> carry = 1
        }: {
            err -> _

            -> _
        }

        {
            #{overflow=wrap}
            j ?= j - 1
        }: {
            err -> _

            -> _
        }
    }
}

; CTR 加解密核心（輪金鑰由呼叫端展開一次）
; 每個計數器值加密後與明文異或，因此任意長度皆可，且加解密同一個函式。
; in: 輸入資料（任意長度，不足一塊的尾部只異或前 n 個位元組）
; iv: 初始計數器值；同一金鑰下絕不可重複使用
; ek: aes.key-expand / aes.key-expand-256 展開後的輪金鑰
; 返回 out: 與 in 等長的輸出（加密或解密結果）
; [ctr-crypt](#aes-ctr.ctr-crypt)
ctr-crypt = (in []byte, iv [16]byte, ek []byte) (out []byte) {

    ; 計數器（初始為 IV）
    cb []byte = with-len(16)
    i <- [0..16): {
        cb[i]: {
            ok -> it = iv[i]: {
                ok -> it

                -> _
            }

            -> _
        }
    }
    out = with-len(in.len())
    pos = 0
    (pos < in.len()) {

        ; 加密當前計數器區塊
        blk [16]byte
        i <- [0..16): {
            blk[i]: {
                ok -> it = cb[i]: {
                    ok -> it

                    -> _
                }

                -> _
            }
        }
        ks [16]byte
        ks = aes.enc-block(blk, ek)

        ; XOR
        n = 16

        #{overflow=wrap}
        pos + n > in.len() -> n = in.len() - pos
        i <- [0..n): {

            #{overflow=wrap}
            in-pos-i = in[pos + i]: {
                ok -> it

                -> _
            }

            ks-i = ks[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            out[pos + i] = (in-pos-i) ^ (ks-i)
        }

        ctr-inc(cb)

        {
            #{overflow=wrap}
            pos ?= pos + n
        }: {
            err -> _

            -> _
        }
    }
}

; AES-128-CTR 加密/解密（對稱操作）
; 用同一把金鑰與同一個 iv（nonce）呼叫兩次即可還原；絕不可重用 (key, iv) 組合。
; in: 輸入資料（任意長度）
; key: 128-bit 金鑰
; iv: 初始計數器值（nonce），必須唯一
; 返回 out: 與 in 等長的輸出
; [crypt-128](#aes-ctr.crypt-128)
crypt-128 = (in []byte, key [16]byte, iv [16]byte) (out []byte) {
    ek = aes.key-expand(key)
    out = ctr-crypt(in, iv, ek)
}

; AES-256-CTR 加密/解密（對稱操作）
; 行為同 crypt-128，只是金鑰展開為 32 位元組（14 輪）。
; in: 輸入資料（任意長度）
; key: 256-bit 金鑰
; iv: 初始計數器值（nonce），必須唯一
; 返回 out: 與 in 等長的輸出
; [crypt-256](#aes-ctr.crypt-256)
crypt-256 = (in []byte, key [32]byte, iv [16]byte) (out []byte) {
    ek = aes.key-expand-256(key)
    out = ctr-crypt(in, iv, ek)
}
