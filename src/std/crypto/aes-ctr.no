; aes-ctr — AES-CTR 計數器模式（AES-128 與 AES-256）
;
; CTR 模式將區塊加密器轉為串流加密器。
; 計數器遞增並加密，產生的密鑰流與明文 XOR；加解密是同一個操作。
;
; 金鑰長度不是檔案維度：同一份 CTR 邏輯服務 AES-128 與 AES-256，
; 差別只在入口用 aes.key-expand 還是 aes.key-expand-256。
;
; 用法：
;   iv [16]byte
;   key [16]byte
;   cipher = aes-ctr.crypt-128(plain, key, iv)   ; 加密
;   plain  = aes-ctr.crypt-128(cipher, key, iv)  ; 解密（同一個函式）
;   ; AES-256 改用 key [32]byte 與 crypt-256

; ctr-inc: 計數器遞增（大端序，先加最低 32 位元，進位再往高位傳播）
ctr-inc = (cb []byte) {
    j = 15
    {
        #{overflow=wrap}
        #{index-out = 0}
        cb[j] = (cb[j] + 1) & 255
        cb[j] != 0 -> {
            break
        }
        #{overflow=wrap}
        j = j - 1
    } (j >= 12)

    ; 進位傳播
    #{overflow=wrap}
    cb[12] == 0 && cb[13] == 0 && cb[14] == 0 && cb[15] == 0 -> {
        j = 11
        {
            #{overflow=wrap}
            #{index-out = 0}
            cb[j] = (cb[j] + 1) & 255
            cb[j] != 0 -> {
                break
            }
            #{overflow=wrap}
            j = j - 1
        } (j >= 0)
    }
}

; ctr-crypt: CTR 加解密核心（輪金鑰由呼叫端展開一次）
; in []byte: 輸入資料（任意長度）
; iv [16]byte: 初始計數器值
; ek []byte: aes.key-expand / aes.key-expand-256 的結果
; 返回 out []byte: 輸出資料
ctr-crypt = (in []byte, iv [16]byte, ek []byte) (out []byte) {

    ; 計數器（初始為 IV）
    cb []byte = with-len(16)
    i <- [0..16): {
        #{index-out = 0}
        cb[i] = iv[i]
    }
    out = with-len(in.len())
    pos = 0
    {

        ; 加密當前計數器區塊
        #{overflow=wrap}
        blk [16]byte
        i <- [0..16): {
            #{index-out = 0}
            blk[i] = cb[i]
        }
        ks [16]byte
        ks = aes.enc-block(blk, ek)

        ; XOR
        n = 16
        #{overflow=wrap}
        pos + n > in.len() -> n = in.len() - pos
        i <- [0..n): {
            #{overflow=wrap}
            #{index-out = 0}
            out[pos + i] = (in[pos + i]) ^ (ks[i])
        }

        ctr-inc(cb)
        #{overflow=wrap}
        pos = pos + n
    } (pos < in.len())
}

; crypt-128: AES-128-CTR 加密/解密（對稱操作）
; in []byte: 輸入資料
; key [16]byte: 金鑰
; iv [16]byte: 初始計數器值
; 返回 out []byte: 輸出資料
crypt-128 = (in []byte, key [16]byte, iv [16]byte) (out []byte) {
    ek []byte = aes.key-expand(key)
    out = ctr-crypt(in, iv, ek)
}

; crypt-256: AES-256-CTR 加密/解密（對稱操作）
; in []byte: 輸入資料
; key [32]byte: 金鑰
; iv [16]byte: 初始計數器值
; 返回 out []byte: 輸出資料
crypt-256 = (in []byte, key [32]byte, iv [16]byte) (out []byte) {
    ek []byte = aes.key-expand-256(key)
    out = ctr-crypt(in, iv, ek)
}
