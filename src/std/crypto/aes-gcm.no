; aes-gcm — AES-GCM AEAD 加密/解密（NIST SP 800-38D，AES-128 與 AES-256）
;
; GCM = AES-CTR（計數器模式）+ GHASH（GF(2^128) 認證）。
; 計數器遞增邏輯複用 aes-ctr.ctr-inc；金鑰長度不是檔案維度，
; 差別只在入口用 aes.key-expand 還是 aes.key-expand-256。
;
; 用法：
;   key [16]byte
;   iv [12]byte
;   aad []byte = 'additional data'
;   plain []byte = 'plaintext'
;   sealed = aes-gcm.seal-128(key, iv, aad, plain)   ; 密文 + 16-byte tag
;   opened = aes-gcm.open-128(key, iv, aad, sealed)  ; 明文，認證失敗則長度 0
;   ; AES-256 改用 key [32]byte 與 seal-256 / open-256

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

GCM-BLOCK-SIZE = 16
GCM-TAG-SIZE = 16
GCM-IV-SIZE = 12

; GHASH 規約多項式: x^128 + x^7 + x^2 + x + 1 → 0xE1000000...
; 在 GF(2^128) 中，位元序為大端序。

; ═══════════════════════════════════════════════
; GHASH — GF(2^128) 乘法與雜湊
; ═══════════════════════════════════════════════

; ghash-mul: GF(2^128) 乘法（用於 GHASH）
; X = X * H mod P，其中 P = x^128 + x^7 + x^2 + x + 1
; x [16]byte: 輸入（大端序位元）
; h [16]byte: 雜湊子金鑰
; 返回 out [16]byte: 乘積
ghash-mul = (x [16]byte, h [16]byte) (out [16]byte) {

    ; 將 x 和 h 視為 128 位元整數（大端序）
    ; 使用 bit-by-bit 乘法

    ; z = 0
    z [16]byte
    i <- [0..16): {

        #{index-out=0}
        z[i] = 0
    }

    ; v = h（V 初始化為 H，即 hash subkey，依據 GCM 規範 V_0 = Y）
    v [16]byte
    i <- [0..16): {

        #{index-out=0}
        v[i] = h[i]
    }

    ; 逐位元處理 x 的每一位
    i <- [0..128): {

        ; 取 x 的第 i 位元（從最高位開始）
        #{overflow=wrap}
        byte-idx = i / 8

        #{overflow=wrap}
        bit-idx = 7 - (i % 8)

        #{index-out=0}
        xi = (x[byte-idx] >> bit-idx) & 1

        ; z = z XOR (xi * v) — 僅在 xi == 1 時執行
        xi == 1 -> {
            j <- [0..16): {

                #{index-out=0}
                z[j] = z[j] ^ v[j]
            }
        }

        ; 判斷 v 的最低位元
        #{index-out=0}
        v-lsb = v[15] & 1

        ; v = v >> 1
        j = 15
        (j > 0) {

            #{index-out=0, overflow=wrap}
            v[j] = (v[j] >> 1) | ((v[j - 1] & 1) << 7)

            #{overflow=wrap}
            j = j - 1
        }

        #{index-out=0}
        v[0] = v[0] >> 1

        ; 若 v_lsb == 1，v = v XOR R（R = 0xE1000...0）
        v-lsb == 1 -> {

            #{index-out=0}
            v[0] = v[0] ^ 225
        }
    }
    i <- [0..16): {

        #{index-out=0}
        out[i] = z[i]
    }
}

; ghash: 計算 GHASH
; h [16]byte: 雜湊子金鑰（AES-enc(0^128)）
; aad []byte: 額外認證資料
; cipher []byte: 密文
; 返回 out [16]byte: GHASH 值
ghash = (h [16]byte, aad []byte, cipher []byte) (out [16]byte) {

    ; y = 0
    #{overflow=wrap}
    y [16]byte
    blk [16]byte
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        y[i] = 0
    }

    ; 處理 AAD（每 16 位元組一區塊）
    pos = 0

    #{overflow=wrap}
    (pos + 16 <= aad.len()) {
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            blk[i] = aad[pos + i]
        }

        ; y = (y XOR block) * H
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            y[i] = y[i] ^ blk[i]
        }

        #{overflow=wrap}
        y = ghash-mul(y, h)

        #{overflow=wrap}
        pos = pos + 16
    }

    ; AAD 最後不完整區塊
    #{overflow=wrap}
    pos < aad.len() -> {
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            blk[i] = 0
        }
        i <- [0..aad.len() - pos): {

            #{index-out=0, overflow=wrap}
            blk[i] = aad[pos + i]
        }
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            y[i] = y[i] ^ blk[i]
        }

        #{overflow=wrap}
        y = ghash-mul(y, h)
    }

    ; 處理密文
    pos = 0

    #{overflow=wrap}
    (pos + 16 <= cipher.len()) {
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            blk[i] = cipher[pos + i]
        }
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            y[i] = y[i] ^ blk[i]
        }

        #{overflow=wrap}
        y = ghash-mul(y, h)

        #{overflow=wrap}
        pos = pos + 16
    }

    #{overflow=wrap}
    pos < cipher.len() -> {
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            blk[i] = 0
        }
        i <- [0..cipher.len() - pos): {

            #{index-out=0, overflow=wrap}
            blk[i] = cipher[pos + i]
        }
        i <- [0..16): {

            #{index-out=0, overflow=wrap}
            y[i] = y[i] ^ blk[i]
        }

        #{overflow=wrap}
        y = ghash-mul(y, h)
    }

    ; 最後區塊: len(AAD)_64bit || len(cipher)_64bit（以位元為單位）
    len-blk [16]byte
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        len-blk[i] = 0
    }

    #{overflow=wrap}
    aad-bits = aad.len() * 8

    #{overflow=wrap}
    cipher-bits = cipher.len() * 8

    ; aad-bits 的高 64 位元（大端序）
    #{index-out=0}
    len-blk[0] = (aad-bits >> 56) & 255

    #{index-out=0}
    len-blk[1] = (aad-bits >> 48) & 255

    #{index-out=0}
    len-blk[2] = (aad-bits >> 40) & 255

    #{index-out=0}
    len-blk[3] = (aad-bits >> 32) & 255

    #{index-out=0}
    len-blk[4] = (aad-bits >> 24) & 255

    #{index-out=0}
    len-blk[5] = (aad-bits >> 16) & 255

    #{index-out=0}
    len-blk[6] = (aad-bits >> 8) & 255

    #{index-out=0}
    len-blk[7] = aad-bits & 255

    ; cipher-bits 的高 64 位元（大端序）
    #{index-out=0}
    len-blk[8] = (cipher-bits >> 56) & 255

    #{index-out=0}
    len-blk[9] = (cipher-bits >> 48) & 255

    #{index-out=0}
    len-blk[10] = (cipher-bits >> 40) & 255

    #{index-out=0}
    len-blk[11] = (cipher-bits >> 32) & 255

    #{index-out=0}
    len-blk[12] = (cipher-bits >> 24) & 255

    #{index-out=0}
    len-blk[13] = (cipher-bits >> 16) & 255

    #{index-out=0}
    len-blk[14] = (cipher-bits >> 8) & 255

    #{index-out=0}
    len-blk[15] = cipher-bits & 255

    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        y[i] = y[i] ^ len-blk[i]
    }
    y = ghash-mul(y, h)

    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        out[i] = y[i]
    }
}

; ═══════════════════════════════════════════════
; AES-CTR 密鑰流
; ═══════════════════════════════════════════════

; ctr-xor: 以 AES-CTR 生成密鑰流並與資料 XOR
; icb [16]byte: 初始計數器區塊
; data []byte: 輸入資料
; ek []byte: aes.key-expand / aes.key-expand-256 的結果
; 返回 out []byte: XOR 後的資料
ctr-xor = (icb [16]byte, data []byte, ek []byte) (out []byte) {
    cb []byte = with-len(16)
    i <- [0..16): {

        #{index-out=0}
        cb[i] = icb[i]
    }
    out = with-len(data.len())
    pos = 0
    (pos < data.len()) {

        ; 加密當前計數器區塊
        #{overflow=wrap}
        blk [16]byte
        i <- [0..16): {

            #{index-out=0}
            blk[i] = cb[i]
        }
        ks [16]byte
        ks = aes.enc-block(blk, ek)

        ; XOR 16 位元組（或剩餘部分）
        n = 16

        #{overflow=wrap}
        pos + n > data.len() -> n = data.len() - pos
        i <- [0..n): {

            #{index-out=0, overflow=wrap}
            out[pos + i] = (data[pos + i]) ^ (ks[i])
        }

        aes-ctr.ctr-inc(cb)

        #{overflow=wrap}
        pos = pos + n
    }
}

; ═══════════════════════════════════════════════
; GCM Seal / Open 核心（輪金鑰由呼叫端展開一次）
; ═══════════════════════════════════════════════

; gcm-j0: 由 12-byte IV 構建 J0 = iv || 0x00000001
gcm-j0 = (iv [12]byte) (j0 [16]byte) {
    i <- [0..12): {

        #{index-out=0, overflow=wrap}
        j0[i] = iv[i]
    }

    #{index-out=0}
    j0[12] = 0

    #{index-out=0}
    j0[13] = 0

    #{index-out=0}
    j0[14] = 0

    #{index-out=0}
    j0[15] = 1
}

; gcm-h: 計算雜湊子金鑰 H = AES-enc(0^128)
gcm-h = (ek []byte) (h [16]byte) {
    zero-block [16]byte
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        zero-block[i] = 0
    }
    h = aes.enc-block(zero-block, ek)
}

; gcm-seal: GCM 加密核心
; iv [12]byte: IV（nonce）
; aad []byte: 額外認證資料
; plain []byte: 明文
; ek []byte: aes.key-expand / aes.key-expand-256 的結果
; 返回 sealed []byte: 密文 + 16 位元組 tag
gcm-seal = (iv [12]byte, aad []byte, plain []byte, ek []byte) (sealed []byte) {

    ; 1. H = AES-enc(key, 0^128)
    h [16]byte
    h = gcm-h(ek)

    ; 2. J0 = iv || 0x00000001
    j0 [16]byte
    j0 = gcm-j0(iv)

    ; 3. 加密: CTR 從 J0+1 開始
    ctr []byte = with-len(16)
    i <- [0..16): {

        #{index-out=0}
        ctr[i] = j0[i]
    }
    aes-ctr.ctr-inc(ctr)
    ctr0 [16]byte
    i <- [0..16): {

        #{index-out=0}
        ctr0[i] = ctr[i]
    }
    cipher []byte
    cipher = ctr-xor(ctr0, plain, ek)

    ; 4. GHASH
    ghash-out [16]byte
    ghash-out = ghash(h, aad, cipher)

    ; 5. tag = AES-enc(key, J0) XOR GHASH
    j0-enc [16]byte
    j0-enc = aes.enc-block(j0, ek)
    tag [16]byte
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        tag[i] = (j0-enc[i]) ^ (ghash-out[i])
    }

    ; 6. 輸出密文 + tag
    #{overflow=wrap}
    sealed = with-len(cipher.len() + 16)
    i <- [0..cipher.len()): {

        #{index-out=0, overflow=wrap}
        sealed[i] = cipher[i]
    }
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        sealed[cipher.len() + i] = tag[i]
    }
}

; gcm-open: GCM 解密核心
; iv [12]byte: IV
; aad []byte: 額外認證資料
; sealed []byte: 密文 + 16 位元組 tag
; ek []byte: aes.key-expand / aes.key-expand-256 的結果
; 返回 plain []byte: 明文（認證失敗時長度為 0）
gcm-open = (iv [12]byte, aad []byte, sealed []byte, ek []byte) (plain []byte) {

    #{overflow=wrap}
    sealed.len() < 16 -> return

    #{overflow=wrap}
    cipher-len = sealed.len() - 16

    ; 1. H
    h [16]byte
    h = gcm-h(ek)

    ; 2. J0
    j0 [16]byte
    j0 = gcm-j0(iv)

    ; 3. 拆出密文與 tag
    cipher []byte = with-len(cipher-len)
    i <- [0..cipher-len): {

        #{index-out=0, overflow=wrap}
        cipher[i] = sealed[i]
    }
    tag [16]byte
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        tag[i] = sealed[cipher-len + i]
    }

    ; 4. 驗證 tag
    ghash-out [16]byte
    ghash-out = ghash(h, aad, cipher)
    j0-enc [16]byte
    j0-enc = aes.enc-block(j0, ek)
    exp-tag [16]byte
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        exp-tag[i] = (j0-enc[i]) ^ (ghash-out[i])
    }

    ; 常數時間比較
    diff = 0
    i <- [0..16): {

        #{index-out=0, overflow=wrap}
        diff = diff | (tag[i] ^ exp-tag[i])
    }
    diff != 0 -> {

        ; 認證失敗
        return
    }

    ; 5. 解密
    ctr []byte = with-len(16)
    i <- [0..16): {

        #{index-out=0}
        ctr[i] = j0[i]
    }
    aes-ctr.ctr-inc(ctr)
    ctr0 [16]byte
    i <- [0..16): {

        #{index-out=0}
        ctr0[i] = ctr[i]
    }
    plain = ctr-xor(ctr0, cipher, ek)
}

; ═══════════════════════════════════════════════
; AES-128 / AES-256 入口
; ═══════════════════════════════════════════════

; seal-128: AES-128-GCM 加密
; key [16]byte: 金鑰
; iv [12]byte: IV（nonce）
; aad []byte: 額外認證資料
; plain []byte: 明文
; 返回 sealed []byte: 密文 + 16 位元組 tag（長度 = plain.len() + 16）
seal-128 = (key [16]byte, iv [12]byte, aad []byte, plain []byte) (sealed []byte) {
    ek []byte = aes.key-expand(key)
    sealed = gcm-seal(iv, aad, plain, ek)
}

; open-128: AES-128-GCM 解密
; key [16]byte: 金鑰
; iv [12]byte: IV
; aad []byte: 額外認證資料
; sealed []byte: 密文 + 16 位元組 tag
; 返回 plain []byte: 明文（認證失敗時長度為 0）
open-128 = (key [16]byte, iv [12]byte, aad []byte, sealed []byte) (plain []byte) {
    ek []byte = aes.key-expand(key)
    plain = gcm-open(iv, aad, sealed, ek)
}

; seal-256: AES-256-GCM 加密
; key [32]byte: 金鑰
; iv [12]byte: IV（nonce）
; aad []byte: 額外認證資料
; plain []byte: 明文
; 返回 sealed []byte: 密文 + 16 位元組 tag
seal-256 = (key [32]byte, iv [12]byte, aad []byte, plain []byte) (sealed []byte) {
    ek []byte = aes.key-expand-256(key)
    sealed = gcm-seal(iv, aad, plain, ek)
}

; open-256: AES-256-GCM 解密
; key [32]byte: 金鑰
; iv [12]byte: IV
; aad []byte: 額外認證資料
; sealed []byte: 密文 + 16 位元組 tag
; 返回 plain []byte: 明文（認證失敗時長度為 0）
open-256 = (key [32]byte, iv [12]byte, aad []byte, sealed []byte) (plain []byte) {
    ek []byte = aes.key-expand-256(key)
    plain = gcm-open(iv, aad, sealed, ek)
}
