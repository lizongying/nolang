; rsa — RSA 加解密（多精度整數模冪）
;
; 使用多精度整數（base 2^32，little-endian）進行 RSA 模冪運算：
;   result = base^exp mod modulus
;
; 不包含金鑰生成；呼叫者需自行提供 n、e、d。
; 支援 1024~4096-bit 金鑰（32~128 個 32-bit limbs）。
;
; 用法：
;   // 高階介面（推薦）：位元組串按大端無符號整數解釋，輸出為最短大端編碼（0 為單位元組 [0]）
;   cipher = rsa-encrypt-bytes(msg, pub-exp, mod)
;   plain  = rsa-decrypt-bytes(cipher, priv-exp, mod)
;   // 低階數值介面（手動管理 limb 計數，呼叫端可傳修剪後的計數少掃位）：
;   // base, exp, mod 為 []i64 切片（base 2^32 little-endian）
;   result, result-n = rsa-modpow(base, base-n, exp, exp-n, mod, mod-n)
;   // 其餘 _ 底線開頭符號（limb 包裝/大數工具/位元組轉換）為模組內部實作，跨模組禁用（private_std 守衛會報 ERROR）
;
; 注意：
; - 所有內部函數命名為 _rsa-bn-* 以避免與 ecdsa.no 的 bn-* 函數衝突
;   （兩者同屬 crypto 套件，未加模組前綴會被解析到錯誤的函數）
; - Nolang 的 && 不會短路求值，因此 trim 迴圈不可使用 && 作為條件
;   需使用 keep-trimming 旗標變數替代。
; - ⚠️ 歷史上 `(keep-trimming) { ... }` 曾是**死碼**：parser 的 isCondLoopPrefix
;   （src/parser/stmt.go）把「括號內只有單一 IDENT」誤判為匿名函式字面量的參數列，
;   於是 `(flag) { ... }` 不是迴圈，而是一個什麼都不做的敘述 —— 迴圈一次都不執行，
;   長度也就不會被修剪。當時的權宜寫法是 `(flag == true) { ... }`。
;   2026-09-24 已在 parser 修掉（Nolang 的函式字面量參數一律要寫型別，`(flag)`
;   根本不是合法參數列），因此現在**直接寫 `(keep-trimming) { ... }` 即可**，
;   下面 4 處皆已改回此寫法。此 bug 曾讓未修剪的 rn 使 rsa-modpow 越界讀取，
;   並在 tests/https-server.no 造成 SIGSEGV。
; [rsa](#rsa)

; 大數比較
...

; 比較兩個大數 a 和 b
; 返回 cmp: 1 = a > b, 0 = a == b, -1 = a < b
; a: 第一個大數（32-bit limb 陣列，低位在前）
; an: a 參與比較的有效 limb 數
; b: 第二個大數
; bn: b 參與比較的有效 limb 數
; cmp: 1=a>b, 0=a==b, -1=a<b（先比 limb 數，再自最高位逐位比）
; [_rsa-bn-cmp](#rsa._rsa-bn-cmp)
_rsa-bn-cmp = (a []i64, an i64, b []i64, bn i64) (cmp i64) {
    cmp = 0

    #{overflow=wrap}
    {
        an > bn -> cmp = 1

        an < bn -> cmp = -1

        an == bn -> {
            an == 0 -> cmp = 0

            an > 0 -> {
                i = an - 1
                (cmp == 0 && i >= 0) {
                    cmp == 0 -> {
                        ixout58c26 = a[i]: {
                            ok -> it

                            -> _
                        }

                        ixout58c33 = b[i]: {
                            ok -> it

                            -> _
                        }

                        ixout58c26 > ixout58c33 -> {
                            cmp = 1
                        }
                        ixout61c26 = a[i]: {
                            ok -> it

                            -> _
                        }

                        ixout61c33 = b[i]: {
                            ok -> it

                            -> _
                        }

                        ixout61c26 < ixout61c33 -> {
                            cmp = -1
                        }
                        cmp == 0 -> {
                            {
                                i-opt = i - 1
                                i-opt: {
                                    ok -> i = it

                                    ->
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; 大數加法
...

; c = a + b
; a: 加數（唯讀，不被修改）
; an: a 的有效 limb 數
; b: 加數（唯讀，不被修改）
; bn: b 的有效 limb 數
; c: a+b 的結果（超出較長操作數的最終進位會追加一個 limb）
; cn: c 的實際 limb 數（含進位，未修剪）
; [_rsa-bn-add](#rsa._rsa-bn-add)
_rsa-bn-add = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {

    ; 分配輸出緩衝區（結果最多 max(an, bn) + 1 個 limb）
    max-ab = an
    bn > max-ab -> max-ab = bn

    #{overflow=wrap}
    c = with-len(max-ab + 2)
    carry = 0
    i = 0
    (i < an || i < bn || carry != 0) {
        sum = carry

        #{overflow=wrap}
        {
            i < an -> {
                ixout100c29 = a[i]: {
                    ok -> it

                    -> _
                }

                sum = sum + ixout100c29
            }

            i < bn -> {
                ixout106c29 = b[i]: {
                    ok -> it

                    -> _
                }

                sum = sum + ixout106c29
            }
        }

        c[i] = sum & 4294967295
        carry = sum >> 32

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt2 = i + 1
            i-opt2: {
                ok -> i = it

                ->
            }
        }
    }
    cn = i
}

; 大數減法
...

; c = a - b（需 a ≥ b）
; a: 被減數（須 ≥ b，否則結果按 2^32 借位迴繞）
; an: a 的有效 limb 數（決定減法迴圈長度與輸出分配）
; b: 減數
; bn: b 的有效 limb 數（i ≥ bn 的部分視為 0）
; c: a-b 的結果（已修剪前導零）
; cn: c 修剪後的 limb 數（至少為 1）
; [_rsa-bn-sub](#rsa._rsa-bn-sub)
_rsa-bn-sub = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {

    ; 分配輸出緩衝區（多配置 1 個 limb 供後續左移使用）
    #{overflow=wrap}
    c = with-len(an + 2)
    borrow = 0
    i <- [0..an): {
        ixout138c16 = a[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        diff = ixout138c16 - borrow

        #{overflow=wrap}
        i < bn -> {
            ixout144c27 = b[i]: {
                ok -> it

                -> _
            }

            diff = diff - ixout144c27
        }

        #{overflow=wrap}
        {
            diff < 0 -> {

                #{overflow=wrap}
                diff = diff + 4294967296
                borrow = 1
            }

            -> borrow = 0
        }

        c[i] = diff & 4294967295
    }

    ; 移除前導零（使用局部變數避免輸出參數 aliasing 問題）
    local-cn = an
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-cn > 1 -> {

                #{overflow=wrap}
                c[local-cn - 1] == 0 -> {
                    {
                        local-cn-opt2 = local-cn - 1
                        local-cn-opt2: {
                            ok -> local-cn = it

                            ->
                        }
                    }
                }
                c[local-cn - 1] != 0 -> {
                    keep-trimming = false
                }
            }
            local-cn <= 1 -> keep-trimming = false
        }
    }
    cn = local-cn
}

; 大數乘法
...

; c = a × b
; a: 乘數
; an: a 的有效 limb 數
; b: 被乘數
; bn: b 的有效 limb 數
; c: a×b 的結果（最多 an+bn 個 limb，已修剪前導零）
; cn: c 修剪後的 limb 數（至少為 1）
; [_rsa-bn-mul](#rsa._rsa-bn-mul)
_rsa-bn-mul = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {

    ; 分配輸出緩衝區
    #{overflow=wrap}
    c = with-len(an + bn + 1)

    i <- [0..an + bn): {
        c[i] = 0
    }
    i <- [0..an): {
        ixout226c10 = a[i]: {
            ok -> it

            -> _
        }

        ixout226c10 == 0 -> {
            continue
        }
        carry = 0
        j <- [0..bn): {

            #{overflow=wrap}
            ixout212c21 = c[i + j]: {
                ok -> it

                -> _
            }

            ixout212c47 = a[i]: {
                ok -> it

                -> _
            }

            ixout212c69 = b[j]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            prod = (ixout212c21 & 4294967295) + (ixout212c47 & 4294967295) * (ixout212c69 & 4294967295) + carry

            #{overflow=wrap}
            c[i + j] = prod & 4294967295
            carry = prod >> 32
        }

        #{overflow=wrap}
        c[i + bn] = carry & 4294967295
    }

    ; 計算實際長度（使用局部變數避免輸出參數 aliasing 問題）
    ; D1：`+` 的結果恆為 `?i64`，此處要的是回繞的普通整數 → 以兩段式 match 解包。
    #{overflow=wrap}
    local-cn = an + bn: {
        ok -> it

        -> 0
    }
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-cn > 1 -> {

                #{overflow=wrap}
                c[local-cn - 1] == 0 -> {
                    {
                        local-cn-opt3 = local-cn - 1
                        local-cn-opt3: {
                            ok -> local-cn = it

                            ->
                        }
                    }
                }
                c[local-cn - 1] != 0 -> {
                    keep-trimming = false
                }
            }
            local-cn <= 1 -> keep-trimming = false
        }
    }
    cn = local-cn
}

; 大數左移 1 位元
...

; a = a << 1（原地左移 1 位元）
; a: 被移位的大數（原地修改，最高位溢出時會寫入 a[an]，呼叫端須預留空間）
; an: 移位前的有效 limb 數
; new-an: 移位後的 limb 數（原最高位 ≥ 2^31 時為 an+1）
; [_rsa-bn-shl1](#rsa._rsa-bn-shl1)
_rsa-bn-shl1 = (a []i64, an i64) (new-an i64) {
    carry = 0
    i <- [0..an): {
        ixout266c20 = a[i]: {
            ok -> it

            -> _
        }

        new-val = (ixout266c20 << 1) | carry

        ixout269c17 = a[i]: {
            ok -> it

            -> _
        }

        carry = ixout269c17 >> 31

        a[i]: {
            ok -> it = new-val & 4294967295

            -> _
        }
    }
    new-an = an
    carry != 0 -> {
        a[an]: {
            ok -> it = carry

            -> _
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            new-an-opt = an + 1
            new-an-opt: {
                ok -> new-an = it

                ->
            }
        }
    }
}

; 大數右移 1 位元
...

; a = a >> 1（原地右移 1 位元）
; a: 被移位的大數（原地修改）
; an: 移位前的有效 limb 數
; new-an: 移位並修剪前導零後的 limb 數（至少為 1）
; [_rsa-bn-shr1](#rsa._rsa-bn-shr1)
_rsa-bn-shr1 = (a []i64, an i64) (new-an i64) {
    carry = 0

    #{overflow=wrap}
    i = an - 1
    (i >= 0) {
        ixout305c36 = a[i]: {
            ok -> it

            -> _
        }

        new-val = (carry << 31) | (ixout305c36 >> 1)

        ixout308c17 = a[i]: {
            ok -> it

            -> _
        }

        carry = ixout308c17 & 1

        a[i]: {
            ok -> it = new-val & 4294967295

            -> _
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt3 = i - 1
            i-opt3: {
                ok -> i = it

                ->
            }
        }
    }
    local-an = an

    ; 移除前導零（使用局部變數避免輸出參數 aliasing 問題）
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-an > 1 -> {
                ixout390c18 = a[local-an - 1]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                ixout390c18 == 0 -> {
                    {
                        local-an-opt = local-an - 1
                        local-an-opt: {
                            ok -> local-an = it

                            ->
                        }
                    }
                }
                ixout393c18 = a[local-an - 1]: {
                    ok -> it

                    -> _
                }

                ixout393c18 != 0 -> {
                    keep-trimming = false
                }
            }
            local-an <= 1 -> keep-trimming = false
        }
    }
    new-an = local-an
}

; 大數除法（二進位長除法）
...

; q = a / b, r = a % b
; a []i64: 被除數（低位在前的 limb 陣列）
; an i64: 被除數有效 limb 數
; b []i64: 除數（同 limb 排布）
; bn i64: 除數有效 limb 數（bn=1 且 b[0]=0 時視為除零，輸出全零）
; q: 商數（輸出）, qn: 商長度
; r: 餘數（輸出）, rn: 餘長度
; qn: 商修剪後的 limb 數（b=0 時 q、r 全零且 qn=rn=0）
; rn: 餘數修剪後的 limb 數（恆小於 b）
; [_rsa-bn-div-mod](#rsa._rsa-bn-div-mod)
_rsa-bn-div-mod = (a []i64, an i64, b []i64, bn i64) (q []i64, qn i64, r []i64, rn i64) {

    ; 處理 b = 0
    ixout418c17 = b[0]: {
        ok -> it

        -> _
    }

    bn == 1 && ixout418c17 == 0 -> {
        q = with-len(1)

        q[0] = 0
        r = with-len(1)

        r[0] = 0
        qn = 0
        rn = 0
        return
    }

    ; 使用局部變數避免輸出參數寫入問題
    ; local-r 需至少 bn + 2 個 limb：中間餘數可達 2*b - 1（bn + 1 limbs）
    ; local-q 需至少 an + 2 個 limb：商數最多 (bits/32)+1 ≈ an+1 limbs
    buf-len = an
    bn > buf-len -> buf-len = bn

    #{overflow=wrap}
    {

        #{overflow=wrap}
        buf-len-opt = buf-len + 2
        buf-len-opt: {
            ok -> buf-len = it

            ->
        }
    }
    local-r []i64 = with-len(buf-len)
    local-q []i64 = with-len(buf-len)
    local-rn = 1
    local-qn = 1

    ; 初始化
    i <- [0..buf-len): {
        local-r[i]: {
            ok -> it = 0

            -> _
        }

        local-q[i]: {
            ok -> it = 0

            -> _
        }
    }

    ; 計算 a 的最高有效位元數
    #{overflow=wrap}
    top = a[an - 1]: {
        ok -> it

        -> 0
    }
    lead = 0
    tmp = top
    (tmp != 0) {
        tmp = tmp >> 1

        #{overflow=wrap}
        {

            #{overflow=wrap}
            lead-opt = lead + 1
            lead-opt: {
                ok -> lead = it

                ->
            }
        }
    }
    an > 0 && top == 0 -> lead = 0

    #{overflow=wrap}
    bits = (an - 1) * 32 + lead

    ; 二進位長除法：從最高位到最低位
    #{overflow=wrap}
    i = bits - 1
    (i >= 0) {

        ; r = r << 1
        carry-shl = 0
        j <- [0..local-rn): {
            ixout428c24 = local-r[j]: {
                ok -> it

                -> _
            }

            new-val = (ixout428c24 << 1) | carry-shl

            ixout431c25 = local-r[j]: {
                ok -> it

                -> _
            }

            carry-shl = ixout431c25 >> 31

            local-r[j]: {
                ok -> it = new-val & 4294967295

                -> _
            }
        }

        #{overflow=wrap}
        carry-shl != 0 -> {
            local-r[local-rn]: {
                ok -> it = carry-shl

                -> _
            }
            {
                local-rn-opt = local-rn + 1
                local-rn-opt: {
                    ok -> local-rn = it

                    ->
                }
            }
        }

        ; r[0] 設為 a 的第 i 位元
        #{overflow=wrap}
        limb = i / 32
        bit-pos = i % 32

        ixout456c18 = a[limb]: {
            ok -> it

            -> _
        }

        a-bit = (ixout456c18 >> bit-pos) & 1

        ixout460c24 = local-r[0]: {
            ok -> it

            -> _
        }

        local-r[0]: {
            ok -> it = ixout460c24 | a-bit

            -> _
        }

        ; 如果 r >= b: r = r - b; q 的第 i 位元設為 1
        cmp = 0
        cmp = _rsa-bn-cmp(local-r, local-rn, b, bn)

        #{overflow=wrap}
        cmp >= 0 -> {
            sub-r []i64
            sub-rn = 0
            sub-r, sub-rn = _rsa-bn-sub(local-r, local-rn, b, bn)

            ; 複製 sub-r 回 local-r
            k <- [0..sub-rn): {
                ixout480c32 = sub-r[k]: {
                    ok -> it

                    -> _
                }

                local-r[k]: {
                    ok -> it = ixout480c32

                    -> _
                }
            }

            ; 清除剩餘的高位 limb
            k = sub-rn
            (k < local-rn) {

                #{overflow=wrap}
                k < local-rn -> {
                    local-r[k]: {
                        ok -> it = 0

                        -> _
                    }
                    {
                        k-opt = k + 1
                        k-opt: {
                            ok -> k = it

                            ->
                        }
                    }
                }
            }
            local-rn = sub-rn
            q-limb = i / 32
            q-bit = i % 32

            ixout506c28 = local-q[q-limb]: {
                ok -> it

                -> _
            }

            local-q[q-limb]: {
                ok -> it = ixout506c28 | (1 << q-bit)

                -> _
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt4 = i - 1
            i-opt4: {
                ok -> i = it

                ->
            }
        }
    }

    ; 計算 q 的長度（Nolang && 不短路，需用旗標變數）
    #{overflow=wrap}
    local-qn = (bits / 32) + 1: {
        ok -> it

        -> _
    }
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-qn > 1 -> {
                ixout622c24 = local-q[local-qn - 1]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                ixout622c24 == 0 -> {
                    {
                        local-qn-opt = local-qn - 1
                        local-qn-opt: {
                            ok -> local-qn = it

                            ->
                        }
                    }
                }
                ixout625c24 = local-q[local-qn - 1]: {
                    ok -> it

                    -> _
                }

                ixout625c24 != 0 -> {
                    keep-trimming = false
                }
            }
            local-qn <= 1 -> keep-trimming = false
        }
    }

    ; 賦值給輸出參數
    r = local-r
    rn = local-rn
    q = local-q
    qn = local-qn
}

; 模冪運算
...

; 單步平方乘（獨立函數以確保每步釋放暫存緩衝區）
; result = result^2 mod modulus; 若 exp-bit == 1，再 result = result * base mod modulus
; result: 當前累乘值（平方前的底）
; rn: result 的 limb 數
; base: 模冪的底，僅在 exp-bit=1 時乘入
; bn: base 的 limb 數
; exp-bit: 指數的當前位（1=本步額外乘 base，0=僅平方）
; modulus: 取模用的除數
; mn: modulus 的 limb 數
; new-result: (result² × base^exp-bit) mod modulus
; new-rn: new-result 的 limb 數
; [_rsa-modpow-step](#rsa._rsa-modpow-step)
_rsa-modpow-step = (result []i64, rn i64, base []i64, bn i64, exp-bit i64, modulus []i64, mn i64) (new-result []i64, new-rn i64) {

    ; t = result * result
    t []i64
    prod-n = 0
    t, prod-n = _rsa-bn-mul(result, rn, result, rn)

    ; local-result = t mod modulus
    q []i64
    qn = 0
    local-r []i64
    local-rn = 0
    q, qn, local-r, local-rn = _rsa-bn-div-mod(t, prod-n, modulus, mn)

    ; 若 exp-bit 為 1：local-result = local-result * base mod modulus
    exp-bit == 1 -> {
        t2 []i64
        prod-n2 = 0
        t2, prod-n2 = _rsa-bn-mul(local-r, local-rn, base, bn)
        q2 []i64
        qn2 = 0
        q2, qn2, local-r, local-rn = _rsa-bn-div-mod(t2, prod-n2, modulus, mn)
    }
    new-result = local-r
    new-rn = local-rn
}

; result = base^exp mod modulus
; 使用左右掃描平方乘（square-and-multiply）
; 注意：loop body 提取為 _rsa-modpow-step 以確保每步釋放暫存緩衝區
; （Nolang heap 變數在函數返回時才釋放，若在 loop body 內分配會累積至 OOM）
; base: 冪的底（須小於 modulus）
; bn: base 的 limb 數
; exp: 指數（limb 陣列，自最高位向低位掃描）
; en: exp 的 limb 數（用於算出實際位數）
; modulus: 模數
; mn: modulus 的 limb 數（結果緩衝區按此長度分配）
; result: base^exp mod modulus（從 1 開始逐位平方乘）
; rn: result 的 limb 數
; [rsa-modpow](#rsa.rsa-modpow)
rsa-modpow = (base []i64, bn i64, exp []i64, en i64, modulus []i64, mn i64) (result []i64, rn i64) {

    ; 使用局部變數避免輸出參數 aliasing 問題
    local-result []i64 = with-len(mn)
    i <- [0..mn): {
        local-result[i]: {
            ok -> it = 0

            -> _
        }
    }

    local-result[0]: {
        ok -> it = 1

        -> _
    }
    local-rn = 1

    ; 計算 exp 的位元數
    #{overflow=wrap}
    top = exp[en - 1]: {
        ok -> it

        -> 0
    }
    lead = 0
    tmp = top
    (tmp != 0) {
        tmp = tmp >> 1

        #{overflow=wrap}
        {

            #{overflow=wrap}
            lead-opt2 = lead + 1
            lead-opt2: {
                ok -> lead = it

                ->
            }
        }
    }
    en > 0 && top == 0 -> lead = 0

    #{overflow=wrap}
    bits = (en - 1) * 32 + lead

    ; 從最高位到最低位
    #{overflow=wrap}
    i = bits - 1
    (i >= 0) {

        #{overflow=wrap}
        e-limb = i / 32
        e-bit = i % 32

        ixout653c20 = exp[e-limb]: {
            ok -> it

            -> _
        }

        exp-bit = (ixout653c20 >> e-bit) & 1

        new-result []i64
        new-rn = 0
        new-result, new-rn = _rsa-modpow-step(local-result, local-rn, base, bn, exp-bit, modulus, mn)
        local-result = new-result
        local-rn = new-rn

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt5 = i - 1
            i-opt5: {
                ok -> i = it

                ->
            }
        }
    }
    result = local-result
    rn = local-rn
}

; RSA 加密/解密（高階介面）
...

; 公開介面不再手動傳 limb 計數：輸入以 vec 自身 .len() 量得（前導零 limb 僅多掃位、不影響正確性）；
; 輸出為精確修剪後的 vec，out.len() 即有效 limb 數（低階 rsa-modpow 回傳的緩衝區長度含多餘零 limb）。
; 把 rsa-modpow 的寬緩衝輸出修剪成精確長度的 vec
; base: 冪的底
; bn: base 的 limb 數
; exp: 指數
; en: exp 的 limb 數
; modulus: 模數
; mn: modulus 的 limb 數
; out: base^exp mod modulus（長度恰為有效 limb 數，rn==0 時回傳單個零 limb）
; [_rsa-modpow-trimmed](#rsa._rsa-modpow-trimmed)
_rsa-modpow-trimmed = (base []i64, bn i64, exp []i64, en i64, modulus []i64, mn i64) (out []i64) {
    raw []i64
    rn = 0
    raw, rn = rsa-modpow(base, bn, exp, en, modulus, mn)
    n = rn
    rn == 0 -> n = 1
    out = with-len(n)
    rn == 0 -> out[0] = 0
    i <- [0..rn): {
        out[i] = raw[i]
    }
}

; 高階包裝（模組內私有；外部請用 rsa-encrypt-bytes）：limb 級 RSA 加密（c = m^e mod n）
; msg []i64: 明文大數 m（低位在前的 32-bit limb 陣列，須小於 mod，未做 PKCS#1 填充）
; pub-exp []i64: 公開指數 e（limb 陣列）
; mod []i64: 模數 n（limb 陣列）
; out []i64: 密文 c = m^e mod n（已精確修剪，out.len() 即 limb 數）
; [_rsa-encrypt](#rsa._rsa-encrypt)
_rsa-encrypt = (msg []i64, pub-exp []i64, mod []i64) (out []i64) {
    out = _rsa-modpow-trimmed(msg, msg.len(), pub-exp, pub-exp.len(), mod, mod.len())
}

; 高階包裝（模組內私有；外部請用 rsa-decrypt-bytes）：limb 級 RSA 解密（m = c^d mod n）
; ct []i64: 密文大數 c（低位在前的 limb 陣列，須小於 mod）
; priv-exp []i64: 私鑰指數 d（limb 陣列）
; mod []i64: 模數 n（limb 陣列）
; out []i64: 明文 m = c^d mod n（未做 PKCS#1 去填充；已精確修剪，out.len() 即 limb 數）
; [_rsa-decrypt](#rsa._rsa-decrypt)
_rsa-decrypt = (ct []i64, priv-exp []i64, mod []i64) (out []i64) {
    out = _rsa-modpow-trimmed(ct, ct.len(), priv-exp, priv-exp.len(), mod, mod.len())
}

; bytes → limbs（模組內私有）：大端無符號位元組串轉 base 2^32 little-endian limb 陣列
; v []byte: 大端無符號整數（前導零位元組無害）
; out []i64: limb 陣列，長度 ceil(len/4)；空輸入回傳 [0]
; [_bytes-to-limbs](#rsa._bytes-to-limbs)
_bytes-to-limbs = (v []byte) (out []i64) {
    n = v.len()
    limbs-n = (n + 3) / 4
    limbs-n == 0 -> limbs-n = 1
    out = with-len(limbs-n)
    k <- [0..limbs-n): {
        out[k] = 0
    }
    i <- [0..n): {

        ; 大端第 i 位元組的 bit 位置（以 2 的冪計）
        bit-pos = (n - 1 - i) * 8
        limb = bit-pos / 32
        shift = bit-pos % 32
        b64 i64
        ixout828c16 = v[i]: {
            ok -> it

            -> _
        }

        b64 = ixout828c16 & 255
        out[limb] = out[limb] | (b64 << shift)
    }
}

; limbs → bytes（模組內私有）：base 2^32 little-endian limb 陣列轉最短大端無符號位元組串
; v []i64: limb 陣列（允許前導零 limb）
; out []byte: 最短大端編碼；值 0 回傳單位元組 [0]
; [_limbs-to-bytes](#rsa._limbs-to-bytes)
_limbs-to-bytes = (v []i64) (out []byte) {
    n = v.len()

    ; 有效 limb 數 top = 最高非零 limb 下標 + 1（全零時為 1）
    top = 1
    k <- [0..n): {
        ixout750c9 = v[k]: {
            ok -> it

            -> _
        }

        ixout750c9 != 0 -> top = k + 1
    }

    ; 最高 limb 的有效位元組數 hb（不含前導零位元組；hi==0 時保留 1）
    hi = v[top - 1]: {
        ok -> it

        -> 0
    }
    hb = 1
    j <- [0..4): {
        ((hi >> (j * 8)) & 255) != 0 -> hb = j + 1
    }
    total = (top - 1) * 4 + hb
    out = with-len(total)
    i <- [0..total): {
        out[i] = 0
    }
    k <- [0..top): {
        limb = v[k]
        j <- [0..4): {

            ; limb k 的第 j 個位元組（LSB 起）落在大端輸出的 idx 位置；最高 limb 的前導零位元組越界省略
            idx = total - 1 - (k * 4 + j)
            idx >= 0 -> out[idx] = (limb >> (j * 8)) & 255
        }
    }
}

; RSA 加密（位元組介面）：c = m^e mod n
; msg []byte: 明文大數 m，大端無符號位元組串（未做 PKCS#1 填充，須小於 mod）
; pub-exp []byte: 公開指數 e，大端無符號位元組串
; mod []byte: 模數 n，大端無符號位元組串
; out []byte: 密文 c = m^e mod n，最短大端無符號編碼（0 為單位元組 [0]）
; [rsa-encrypt-bytes](#rsa.rsa-encrypt-bytes)
rsa-encrypt-bytes = (msg []byte, pub-exp []byte, mod []byte) (out []byte) {
    m-bn = _bytes-to-limbs(msg)
    e-bn = _bytes-to-limbs(pub-exp)
    n-bn = _bytes-to-limbs(mod)
    c-bn = _rsa-encrypt(m-bn, e-bn, n-bn)
    out = _limbs-to-bytes(c-bn)
}

; RSA 解密（位元組介面）：m = c^d mod n
; ct []byte: 密文大數 c，大端無符號位元組串（須小於 mod）
; priv-exp []byte: 私鑰指數 d，大端無符號位元組串
; mod []byte: 模數 n，大端無符號位元組串
; out []byte: 明文 m = c^d mod n，最短大端無符號編碼（未做 PKCS#1 去填充）
; [rsa-decrypt-bytes](#rsa.rsa-decrypt-bytes)
rsa-decrypt-bytes = (ct []byte, priv-exp []byte, mod []byte) (out []byte) {
    c-bn = _bytes-to-limbs(ct)
    d-bn = _bytes-to-limbs(priv-exp)
    n-bn = _bytes-to-limbs(mod)
    m-bn = _rsa-decrypt(c-bn, d-bn, n-bn)
    out = _limbs-to-bytes(m-bn)
}
