; rsa — RSA 加解密（多精度整數模冪）
;
; 使用多精度整數（base 2^32，little-endian）進行 RSA 模冪運算：
;   result = base^exp mod modulus
;
; 不包含金鑰生成；呼叫者需自行提供 n、e、d。
; 支援 1024~4096-bit 金鑰（32~128 個 32-bit limbs）。
;
; 用法：
;   // base, exp, mod 為 []i64 切片
;   result, result-n = rsa-modpow(base, base-n, exp, exp-n, mod, mod-n)
;
; 注意：
; - 所有內部函數命名為 rsa-bn-* 以避免與 ecdsa.no 的 bn-* 函數衝突
;   （兩者同屬 crypto 套件，未加模組前綴會被解析到錯誤的函數）
; - Nolang 的 && 不會短路求值，因此 trim 迴圈不可使用 && 作為條件
;   需使用 keep-trimming 旗標變數替代

; ─── 大數比較 ─────────────────────────────────────

; rsa-bn-cmp: 比較兩個大數 a 和 b
; 返回 cmp: 1 = a > b, 0 = a == b, -1 = a < b
rsa-bn-cmp = (a []i64, an i64, b []i64, bn i64) (cmp i64) {
    cmp = 0
    an > bn -> cmp = 1
    an < bn -> cmp = -1
    an == bn -> {
        an == 0 -> cmp = 0
        an > 0 -> {
            i = an - 1
            {
                cmp == 0 -> {
                    a[i] > b[i] -> cmp = 1
                    a[i] < b[i] -> cmp = -1
                    cmp == 0 -> i = i - 1
                }
            } (cmp == 0 && i >= 0)
        }
    }
}

; ─── 大數加法 ─────────────────────────────────────

; rsa-bn-add: c = a + b
rsa-bn-add = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {
    ; 分配輸出緩衝區（結果最多 max(an, bn) + 1 個 limb）
    max-ab = an
    bn > max-ab -> max-ab = bn
    c = with-len(max-ab + 2)
    carry = 0
    i = 0
    {
        sum = carry
        i < an -> sum = sum + a[i]
        i < bn -> sum = sum + b[i]
        c[i] = sum & 4294967295
        carry = sum >> 32
        i = i + 1
    } (i < an || i < bn || carry != 0)
    cn = i
}

; ─── 大數減法 ─────────────────────────────────────

; rsa-bn-sub: c = a - b（需 a ≥ b）
rsa-bn-sub = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {
    ; 分配輸出緩衝區（多配置 1 個 limb 供後續左移使用）
    c = with-len(an + 2)
    borrow = 0
    i <- [0..an): {
        diff = a[i] - borrow
        i < bn -> diff = diff - b[i]
        {
            diff < 0 -> {
                diff = diff + 4294967296
                borrow = 1
            }
            -> borrow = 0
        }
        c[i] = diff & 4294967295
    }

    ; 移除前導零（使用局部變數避免輸出參數 aliasing 問題）
    local-cn = an
    keep-trimming = true
    {
        keep-trimming -> {
            local-cn > 1 -> {
                c[local-cn - 1] == 0 -> local-cn = local-cn - 1
                c[local-cn - 1] != 0 -> keep-trimming = false
            }
            local-cn <= 1 -> keep-trimming = false
        }
    } (keep-trimming)
    cn = local-cn
}

; ─── 大數乘法 ─────────────────────────────────────

; rsa-bn-mul: c = a × b
rsa-bn-mul = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {
    ; 分配輸出緩衝區
    c = with-len(an + bn + 1)
    i <- [0..an + bn): {
        c[i] = 0
    }
    i <- [0..an): {
        a[i] == 0 -> continue
        carry = 0
        j <- [0..bn): {
            prod = (c[i + j] & 4294967295) + (a[i] & 4294967295) * (b[j] & 4294967295) + carry
            c[i + j] = prod & 4294967295
            carry = prod >> 32
        }
        c[i + bn] = carry & 4294967295
    }

    ; 計算實際長度（使用局部變數避免輸出參數 aliasing 問題）
    local-cn = an + bn
    keep-trimming = true
    {
        keep-trimming -> {
            local-cn > 1 -> {
                c[local-cn - 1] == 0 -> local-cn = local-cn - 1
                c[local-cn - 1] != 0 -> keep-trimming = false
            }
            local-cn <= 1 -> keep-trimming = false
        }
    } (keep-trimming)
    cn = local-cn
}

; ─── 大數左移 1 位元 ─────────────────────────────

; rsa-bn-shl1: a = a << 1（原地左移 1 位元）
rsa-bn-shl1 = (a []i64, an i64) (new-an i64) {
    carry = 0
    i <- [0..an): {
        new-val = (a[i] << 1) | carry
        carry = a[i] >> 31
        a[i] = new-val & 4294967295
    }
    new-an = an
    carry != 0 -> {
        a[an] = carry
        new-an = an + 1
    }
}

; ─── 大數右移 1 位元 ─────────────────────────────

; rsa-bn-shr1: a = a >> 1（原地右移 1 位元）
rsa-bn-shr1 = (a []i64, an i64) (new-an i64) {
    carry = 0
    i i64 = an - 1
    {
        new-val = (carry << 31) | (a[i] >> 1)
        carry = a[i] & 1
        a[i] = new-val & 4294967295
        i = i - 1
    } (i >= 0)
    local-an = an

    ; 移除前導零（使用局部變數避免輸出參數 aliasing 問題）
    keep-trimming = true
    {
        keep-trimming -> {
            local-an > 1 -> {
                a[local-an - 1] == 0 -> local-an = local-an - 1
                a[local-an - 1] != 0 -> keep-trimming = false
            }
            local-an <= 1 -> keep-trimming = false
        }
    } (keep-trimming)
    new-an = local-an
}

; ─── 大數除法（二進位長除法）────────────────────

; rsa-bn-div-mod: q = a / b, r = a % b
; a: 被除數, an: 長度
; b: 除數, bn: 長度
; q: 商數（輸出）, qn: 商長度
; r: 餘數（輸出）, rn: 餘長度
rsa-bn-div-mod = (a []i64, an i64, b []i64, bn i64) (q []i64, qn i64, r []i64, rn i64) {
    ; 處理 b = 0
    bn == 1 && b[0] == 0 -> {
        q = with-len(1)
        q[0] = 0
        r = with-len(1)
        r[0] = 0
        qn = 0
        rn = 0
        return
    }

    ; 使用局部變數避免輸出參數寫入問題
    ; local-r 需至少 bn + 2 個 limb：中間餘數可達 2*b - 1（bn + 1 limbs）
    ; local-q 需至少 an + 2 個 limb：商數最多 (bits/32)+1 ≈ an+1 limbs
    buf-len = an
    bn > buf-len -> buf-len = bn
    buf-len = buf-len + 2
    local-r []i64 = with-len(buf-len)
    local-q []i64 = with-len(buf-len)
    local-rn = 1
    local-qn = 1

    ; 初始化
    i <- [0..buf-len): {
        local-r[i] = 0
        local-q[i] = 0
    }

    ; 計算 a 的最高有效位元數
    top = a[an - 1]
    lead = 0
    tmp i64 = top
    {
        tmp = tmp >> 1
        lead = lead + 1
    } (tmp != 0)
    an > 0 && top == 0 -> lead = 0
    bits i64 = (an - 1) * 32 + lead

    ; 二進位長除法：從最高位到最低位
    i = bits - 1
    {
        ; r = r << 1
        carry-shl = 0
        j <- [0..local-rn): {
            new-val = (local-r[j] << 1) | carry-shl
            carry-shl = local-r[j] >> 31
            local-r[j] = new-val & 4294967295
        }
        carry-shl != 0 -> {
            local-r[local-rn] = carry-shl
            local-rn = local-rn + 1
        }

        ; r[0] 設為 a 的第 i 位元
        limb = i / 32
        bit-pos = i % 32
        a-bit = (a[limb] >> bit-pos) & 1
        local-r[0] = local-r[0] | a-bit

        ; 如果 r >= b: r = r - b; q 的第 i 位元設為 1
        cmp = 0
        cmp = rsa-bn-cmp(local-r, local-rn, b, bn)
        cmp >= 0 -> {
            sub-r []i64
            sub-rn = 0
            sub-r, sub-rn = rsa-bn-sub(local-r, local-rn, b, bn)

            ; 複製 sub-r 回 local-r
            k <- [0..sub-rn): {
                local-r[k] = sub-r[k]
            }

            ; 清除剩餘的高位 limb
            k = sub-rn
            {
                k < local-rn -> {
                    local-r[k] = 0
                    k = k + 1
                }
            } (k < local-rn)
            local-rn = sub-rn
            q-limb = i / 32
            q-bit = i % 32
            local-q[q-limb] = local-q[q-limb] | (1 << q-bit)
        }

        i = i - 1
    } (i >= 0)

    ; 計算 q 的長度（Nolang && 不短路，需用旗標變數）
    local-qn = (bits / 32) + 1
    keep-trimming = true
    {
        keep-trimming -> {
            local-qn > 1 -> {
                local-q[local-qn - 1] == 0 -> local-qn = local-qn - 1
                local-q[local-qn - 1] != 0 -> keep-trimming = false
            }
            local-qn <= 1 -> keep-trimming = false
        }
    } (keep-trimming)

    ; 賦值給輸出參數
    r = local-r
    rn = local-rn
    q = local-q
    qn = local-qn
}

; ─── 模冪運算 ─────────────────────────────────────

; rsa-modpow-step: 單步平方乘（獨立函數以確保每步釋放暫存緩衝區）
; result = result^2 mod modulus; 若 exp-bit == 1，再 result = result * base mod modulus
rsa-modpow-step = (result []i64, rn i64, base []i64, bn i64, exp-bit i64, modulus []i64, mn i64) (new-result []i64, new-rn i64) {
    ; t = result * result
    t []i64
    prod-n = 0
    t, prod-n = rsa-bn-mul(result, rn, result, rn)

    ; local-result = t mod modulus
    q []i64
    qn = 0
    local-r []i64
    local-rn = 0
    q, qn, local-r, local-rn = rsa-bn-div-mod(t, prod-n, modulus, mn)

    ; 若 exp-bit 為 1：local-result = local-result * base mod modulus
    exp-bit == 1 -> {
        t2 []i64
        prod-n2 = 0
        t2, prod-n2 = rsa-bn-mul(local-r, local-rn, base, bn)
        q2 []i64
        qn2 = 0
        q2, qn2, local-r, local-rn = rsa-bn-div-mod(t2, prod-n2, modulus, mn)
    }

    new-result = local-r
    new-rn = local-rn
}

; rsa-modpow: result = base^exp mod modulus
; 使用左右掃描平方乘（square-and-multiply）
; 注意：loop body 提取為 rsa-modpow-step 以確保每步釋放暫存緩衝區
; （Nolang heap 變數在函數返回時才釋放，若在 loop body 內分配會累積至 OOM）
rsa-modpow = (base []i64, bn i64, exp []i64, en i64, modulus []i64, mn i64) (result []i64, rn i64) {
    ; 使用局部變數避免輸出參數 aliasing 問題
    local-result []i64 = with-len(mn)
    i <- [0..mn): {
        local-result[i] = 0
    }
    local-result[0] = 1
    local-rn = 1

    ; 計算 exp 的位元數
    top i64 = exp[en - 1]
    lead = 0
    tmp i64 = top
    {
        tmp = tmp >> 1
        lead = lead + 1
    } (tmp != 0)
    en > 0 && top == 0 -> lead = 0
    bits i64 = (en - 1) * 32 + lead

    ; 從最高位到最低位
    i = bits - 1
    {
        e-limb = i / 32
        e-bit = i % 32
        exp-bit = (exp[e-limb] >> e-bit) & 1

        new-result []i64
        new-rn = 0
        new-result, new-rn = rsa-modpow-step(local-result, local-rn, base, bn, exp-bit, modulus, mn)
        local-result = new-result
        local-rn = new-rn

        i = i - 1
    } (i >= 0)

    result = local-result
    rn = local-rn
}

; ─── RSA 加密/解密（高階介面）────────────────────

; rsa-encrypt: RSA 加密（c = m^e mod n）
rsa-encrypt = (msg []i64, msgn i64, pub-exp []i64, pubn i64, mod []i64, modn i64) (out []i64, outn i64) {
    out, outn = rsa-modpow(msg, msgn, pub-exp, pubn, mod, modn)
}

; rsa-decrypt: RSA 解密（m = c^d mod n）
rsa-decrypt = (ct []i64, ctn i64, priv-exp []i64, privn i64, mod []i64, modn i64) (out []i64, outn i64) {
    out, outn = rsa-modpow(ct, ctn, priv-exp, privn, mod, modn)
}
