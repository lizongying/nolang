; rsa — RSA 加解密（多精度整數模冪）
;
; 使用多精度整數（base 2^32，little-endian）進行 RSA 模冪運算：
;   result = base^exp mod modulus
;
; 不包含金鑰生成；呼叫者需自行提供 n、e、d。
; 支援 1024~4096-bit 金鑰（32~128 個 32-bit limbs）。
;
; 用法：
;   // base, exp, mod 為 []i64 切片
;   result, result-n = rsa-modpow(base, base-n, exp, exp-n, mod, mod-n)
;
; 注意：
; - 所有內部函數命名為 rsa-bn-* 以避免與 ecdsa.no 的 bn-* 函數衝突
;   （兩者同屬 crypto 套件，未加模組前綴會被解析到錯誤的函數）
; - Nolang 的 && 不會短路求值，因此 trim 迴圈不可使用 && 作為條件
;   需使用 keep-trimming 旗標變數替代。
; - ⚠️ 歷史上 `(keep-trimming) { ... }` 曾是**死碼**：parser 的 isCondLoopPrefix
;   （src/parser/stmt.go）把「括號內只有單一 IDENT」誤判為匿名函式字面量的參數列，
;   於是 `(flag) { ... }` 不是迴圈，而是一個什麼都不做的敘述 —— 迴圈一次都不執行，
;   長度也就不會被修剪。當時的權宜寫法是 `(flag == true) { ... }`。
;   2026-09-24 已在 parser 修掉（Nolang 的函式字面量參數一律要寫型別，`(flag)`
;   根本不是合法參數列），因此現在**直接寫 `(keep-trimming) { ... }` 即可**，
;   下面 4 處皆已改回此寫法。此 bug 曾讓未修剪的 rn 使 rsa-modpow 越界讀取，
;   並在 tests/https-server.no 造成 SIGSEGV。

; ─── 大數比較 ─────────────────────────────────────

; 比較兩個大數 a 和 b
; 返回 cmp: 1 = a > b, 0 = a == b, -1 = a < b
; a: 第一個大數（32-bit limb 陣列，低位在前）
; an: a 參與比較的有效 limb 數
; b: 第二個大數
; bn: b 參與比較的有效 limb 數
; cmp: 1=a>b, 0=a==b, -1=a<b（先比 limb 數，再自最高位逐位比）
; [rsa-bn-cmp](#rsa.rsa-bn-cmp)
rsa-bn-cmp = (a []i64, an i64, b []i64, bn i64) (cmp i64) {
    cmp = 0

    #{overflow=wrap}
    {
        an > bn -> cmp = 1

        an < bn -> cmp = -1

        an == bn -> {
            an == 0 -> cmp = 0

            an > 0 -> {
                i = an - 1
                (cmp == 0 && i >= 0) {
                    cmp == 0 -> {
                        a[i] > b[i] -> {

                            cmp = 1
                        }
                        a[i] < b[i] -> {

                            cmp = -1
                        }
                        cmp == 0 -> i = i - 1
                    }
                }
            }
        }
    }
}

; ─── 大數加法 ─────────────────────────────────────

; c = a + b
; a: 加數（唯讀，不被修改）
; an: a 的有效 limb 數
; b: 加數（唯讀，不被修改）
; bn: b 的有效 limb 數
; c: a+b 的結果（超出較長操作數的最終進位會追加一個 limb）
; cn: c 的實際 limb 數（含進位，未修剪）
; [rsa-bn-add](#rsa.rsa-bn-add)
rsa-bn-add = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {

    ; 分配輸出緩衝區（結果最多 max(an, bn) + 1 個 limb）
    max-ab = an
    bn > max-ab -> max-ab = bn

    #{overflow=wrap}
    c = with-len(max-ab + 2)
    carry = 0
    i = 0
    (i < an || i < bn || carry != 0) {

        sum = carry

        #{overflow=wrap}
        {
            i < an -> {

                #{index-out=zero}
                sum = sum + a[i]
            }

            i < bn -> {

                #{index-out=zero}
                sum = sum + b[i]
            }
        }

        c[i] = sum & 4294967295
        carry = sum >> 32

        #{overflow=wrap}
        i = i + 1
    }
    cn = i
}

; ─── 大數減法 ─────────────────────────────────────

; c = a - b（需 a ≥ b）
; a: 被減數（須 ≥ b，否則結果按 2^32 借位迴繞）
; an: a 的有效 limb 數（決定減法迴圈長度與輸出分配）
; b: 減數
; bn: b 的有效 limb 數（i ≥ bn 的部分視為 0）
; c: a-b 的結果（已修剪前導零）
; cn: c 修剪後的 limb 數（至少為 1）
; [rsa-bn-sub](#rsa.rsa-bn-sub)
rsa-bn-sub = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {

    ; 分配輸出緩衝區（多配置 1 個 limb 供後續左移使用）
    #{overflow=wrap}
    c = with-len(an + 2)
    borrow = 0
    i <- [0..an): {

        #{index-out=zero, overflow=wrap}
        diff = a[i] - borrow

        #{overflow=wrap}
        i < bn -> {

            #{index-out=zero}
            diff = diff - b[i]
        }

        #{overflow=wrap}
        {
            diff < 0 -> {

                #{overflow=wrap}
                diff = diff + 4294967296
                borrow = 1
            }

            -> borrow = 0
        }

        c[i] = diff & 4294967295
    }

    ; 移除前導零（使用局部變數避免輸出參數 aliasing 問題）
    local-cn = an
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-cn > 1 -> {

                #{overflow=wrap}
                c[local-cn - 1] == 0 -> {

                    local-cn = local-cn - 1
                }
                c[local-cn - 1] != 0 -> {

                    keep-trimming = false
                }
            }
            local-cn <= 1 -> keep-trimming = false
        }
    }
    cn = local-cn
}

; ─── 大數乘法 ─────────────────────────────────────

; c = a × b
; a: 乘數
; an: a 的有效 limb 數
; b: 被乘數
; bn: b 的有效 limb 數
; c: a×b 的結果（最多 an+bn 個 limb，已修剪前導零）
; cn: c 修剪後的 limb 數（至少為 1）
; [rsa-bn-mul](#rsa.rsa-bn-mul)
rsa-bn-mul = (a []i64, an i64, b []i64, bn i64) (c []i64, cn i64) {

    ; 分配輸出緩衝區
    #{overflow=wrap}
    c = with-len(an + bn + 1)

    i <- [0..an + bn): {

        c[i] = 0
    }
    i <- [0..an): {

        a[i] == 0 -> {

            continue
        }
        carry = 0
        j <- [0..bn): {

            #{index-out=zero, overflow=wrap}
            prod = (c[i + j] & 4294967295) + (a[i] & 4294967295) * (b[j] & 4294967295) + carry

            #{overflow=wrap}
            c[i + j] = prod & 4294967295
            carry = prod >> 32
        }

        #{overflow=wrap}
        c[i + bn] = carry & 4294967295
    }

    ; 計算實際長度（使用局部變數避免輸出參數 aliasing 問題）
    ; D1：`+` 的結果恆為 `?i64`，此處要的是回繞的普通整數 → 以兩段式 match 解包。
    #{overflow=wrap}
    local-cn-opt = an + bn
    local-cn = 0
    local-cn-opt: {
        ok -> local-cn = it

        -> local-cn = 0
    }
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-cn > 1 -> {

                #{overflow=wrap}
                c[local-cn - 1] == 0 -> {

                    local-cn = local-cn - 1
                }
                c[local-cn - 1] != 0 -> {

                    keep-trimming = false
                }
            }
            local-cn <= 1 -> keep-trimming = false
        }
    }
    cn = local-cn
}

; ─── 大數左移 1 位元 ─────────────────────────────

; a = a << 1（原地左移 1 位元）
; a: 被移位的大數（原地修改，最高位溢出時會寫入 a[an]，呼叫端須預留空間）
; an: 移位前的有效 limb 數
; new-an: 移位後的 limb 數（原最高位 ≥ 2^31 時為 an+1）
; [rsa-bn-shl1](#rsa.rsa-bn-shl1)
rsa-bn-shl1 = (a []i64, an i64) (new-an i64) {
    carry = 0
    i <- [0..an): {

        #{index-out=zero}
        new-val = (a[i] << 1) | carry

        #{index-out=zero}
        carry = a[i] >> 31

        a[i]: {
            ok -> it = new-val & 4294967295

            -> _
        }
    }
    new-an = an
    carry != 0 -> {

        a[an]: {
            ok -> it = carry

            -> _
        }

        #{overflow=wrap}
        new-an = an + 1
    }
}

; ─── 大數右移 1 位元 ─────────────────────────────

; a = a >> 1（原地右移 1 位元）
; a: 被移位的大數（原地修改）
; an: 移位前的有效 limb 數
; new-an: 移位並修剪前導零後的 limb 數（至少為 1）
; [rsa-bn-shr1](#rsa.rsa-bn-shr1)
rsa-bn-shr1 = (a []i64, an i64) (new-an i64) {

    carry = 0

    #{overflow=wrap}
    i = an - 1
    (i >= 0) {

        #{index-out=zero}
        new-val = (carry << 31) | (a[i] >> 1)

        #{index-out=zero}
        carry = a[i] & 1

        a[i]: {
            ok -> it = new-val & 4294967295

            -> _
        }

        #{overflow=wrap}
        i = i - 1
    }
    local-an = an

    ; 移除前導零（使用局部變數避免輸出參數 aliasing 問題）
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-an > 1 -> {

                #{overflow=wrap}
                a[local-an - 1] == 0 -> {

                    local-an = local-an - 1
                }
                a[local-an - 1] != 0 -> {

                    keep-trimming = false
                }
            }
            local-an <= 1 -> keep-trimming = false
        }
    }
    new-an = local-an
}

; ─── 大數除法（二進位長除法）────────────────────

; q = a / b, r = a % b
; a []i64: 被除數（低位在前的 limb 陣列）
; an i64: 被除數有效 limb 數
; b []i64: 除數（同 limb 排布）
; bn i64: 除數有效 limb 數（bn=1 且 b[0]=0 時視為除零，輸出全零）
; q: 商數（輸出）, qn: 商長度
; r: 餘數（輸出）, rn: 餘長度
; qn: 商修剪後的 limb 數（b=0 時 q、r 全零且 qn=rn=0）
; rn: 餘數修剪後的 limb 數（恆小於 b）
; [rsa-bn-div-mod](#rsa.rsa-bn-div-mod)
rsa-bn-div-mod = (a []i64, an i64, b []i64, bn i64) (q []i64, qn i64, r []i64, rn i64) {

    ; 處理 b = 0
    bn == 1 && b[0] == 0 -> {
        q = with-len(1)

        q[0] = 0
        r = with-len(1)

        r[0] = 0
        qn = 0
        rn = 0
        return
    }

    ; 使用局部變數避免輸出參數寫入問題
    ; local-r 需至少 bn + 2 個 limb：中間餘數可達 2*b - 1（bn + 1 limbs）
    ; local-q 需至少 an + 2 個 limb：商數最多 (bits/32)+1 ≈ an+1 limbs
    buf-len = an
    bn > buf-len -> buf-len = bn

    #{overflow=wrap}
    buf-len = buf-len + 2
    local-r []i64 = with-len(buf-len)
    local-q []i64 = with-len(buf-len)
    local-rn = 1
    local-qn = 1

    ; 初始化
    i <- [0..buf-len): {

        local-r[i]: {
            ok -> it = 0

            -> _
        }

        local-q[i]: {
            ok -> it = 0

            -> _
        }
    }

    ; 計算 a 的最高有效位元數
    #{index-out=zero, overflow=wrap}
    top = a[an - 1]
    lead = 0
    tmp = top
    (tmp != 0) {

        tmp = tmp >> 1

        #{overflow=wrap}
        lead = lead + 1
    }
    an > 0 && top == 0 -> lead = 0

    #{overflow=wrap}
    bits = (an - 1) * 32 + lead

    ; 二進位長除法：從最高位到最低位
    #{overflow=wrap}
    i = bits - 1
    (i >= 0) {

        ; r = r << 1
        carry-shl = 0
        j <- [0..local-rn): {

            #{index-out=zero}
            new-val = (local-r[j] << 1) | carry-shl

            #{index-out=zero}
            carry-shl = local-r[j] >> 31

            local-r[j]: {
                ok -> it = new-val & 4294967295

                -> _
            }
        }

        #{overflow=wrap}
        carry-shl != 0 -> {

            local-r[local-rn]: {
                ok -> it = carry-shl

                -> _
            }
            local-rn = local-rn + 1
        }

        ; r[0] 設為 a 的第 i 位元
        #{overflow=wrap}
        limb = i / 32
        bit-pos = i % 32

        #{index-out=zero}
        a-bit = (a[limb] >> bit-pos) & 1

        #{index-out=zero}
        local-r[0]: {
            ok -> it = local-r[0] | a-bit

            -> _
        }

        ; 如果 r >= b: r = r - b; q 的第 i 位元設為 1
        cmp = 0
        cmp = rsa-bn-cmp(local-r, local-rn, b, bn)

        #{overflow=wrap}
        cmp >= 0 -> {

            sub-r []i64
            sub-rn = 0
            sub-r, sub-rn = rsa-bn-sub(local-r, local-rn, b, bn)

            ; 複製 sub-r 回 local-r
            k <- [0..sub-rn): {

                #{index-out=zero}
                local-r[k]: {
                    ok -> it = sub-r[k]

                    -> _
                }
            }

            ; 清除剩餘的高位 limb
            k = sub-rn
            (k < local-rn) {

                #{overflow=wrap}
                k < local-rn -> {

                    local-r[k]: {
                        ok -> it = 0

                        -> _
                    }
                    k = k + 1
                }
            }
            local-rn = sub-rn
            q-limb = i / 32
            q-bit = i % 32

            #{index-out=zero}
            local-q[q-limb]: {
                ok -> it = local-q[q-limb] | (1 << q-bit)

                -> _
            }
        }

        #{overflow=wrap}
        i = i - 1
    }

    ; 計算 q 的長度（Nolang && 不短路，需用旗標變數）
    #{overflow=wrap}
    qn-step = (bits / 32) + 1
    local-qn = qn-step: {
        ok -> it

        -> _
    }
    keep-trimming = true
    (keep-trimming) {

        #{overflow=wrap}
        keep-trimming -> {
            local-qn > 1 -> {

                #{overflow=wrap}
                local-q[local-qn - 1] == 0 -> {

                    local-qn = local-qn - 1
                }
                local-q[local-qn - 1] != 0 -> {

                    keep-trimming = false
                }
            }
            local-qn <= 1 -> keep-trimming = false
        }
    }

    ; 賦值給輸出參數
    r = local-r
    rn = local-rn
    q = local-q
    qn = local-qn
}

; ─── 模冪運算 ─────────────────────────────────────

; 單步平方乘（獨立函數以確保每步釋放暫存緩衝區）
; result = result^2 mod modulus; 若 exp-bit == 1，再 result = result * base mod modulus
; result: 當前累乘值（平方前的底）
; rn: result 的 limb 數
; base: 模冪的底，僅在 exp-bit=1 時乘入
; bn: base 的 limb 數
; exp-bit: 指數的當前位（1=本步額外乘 base，0=僅平方）
; modulus: 取模用的除數
; mn: modulus 的 limb 數
; new-result: (result² × base^exp-bit) mod modulus
; new-rn: new-result 的 limb 數
; [rsa-modpow-step](#rsa.rsa-modpow-step)
rsa-modpow-step = (result []i64, rn i64, base []i64, bn i64, exp-bit i64, modulus []i64, mn i64) (new-result []i64, new-rn i64) {

    ; t = result * result
    t []i64
    prod-n = 0
    t, prod-n = rsa-bn-mul(result, rn, result, rn)

    ; local-result = t mod modulus
    q []i64
    qn = 0
    local-r []i64
    local-rn = 0
    q, qn, local-r, local-rn = rsa-bn-div-mod(t, prod-n, modulus, mn)

    ; 若 exp-bit 為 1：local-result = local-result * base mod modulus
    exp-bit == 1 -> {
        t2 []i64
        prod-n2 = 0
        t2, prod-n2 = rsa-bn-mul(local-r, local-rn, base, bn)
        q2 []i64
        qn2 = 0
        q2, qn2, local-r, local-rn = rsa-bn-div-mod(t2, prod-n2, modulus, mn)
    }
    new-result = local-r
    new-rn = local-rn
}

; result = base^exp mod modulus
; 使用左右掃描平方乘（square-and-multiply）
; 注意：loop body 提取為 rsa-modpow-step 以確保每步釋放暫存緩衝區
; （Nolang heap 變數在函數返回時才釋放，若在 loop body 內分配會累積至 OOM）
; base: 冪的底（須小於 modulus）
; bn: base 的 limb 數
; exp: 指數（limb 陣列，自最高位向低位掃描）
; en: exp 的 limb 數（用於算出實際位數）
; modulus: 模數
; mn: modulus 的 limb 數（結果緩衝區按此長度分配）
; result: base^exp mod modulus（從 1 開始逐位平方乘）
; rn: result 的 limb 數
; [rsa-modpow](#rsa.rsa-modpow)
rsa-modpow = (base []i64, bn i64, exp []i64, en i64, modulus []i64, mn i64) (result []i64, rn i64) {

    ; 使用局部變數避免輸出參數 aliasing 問題
    local-result []i64 = with-len(mn)
    i <- [0..mn): {

        local-result[i]: {
            ok -> it = 0

            -> _
        }
    }

    local-result[0]: {
        ok -> it = 1

        -> _
    }
    local-rn = 1

    ; 計算 exp 的位元數
    #{index-out=zero, overflow=wrap}
    top = exp[en - 1]
    lead = 0
    tmp = top
    (tmp != 0) {

        tmp = tmp >> 1

        #{overflow=wrap}
        lead = lead + 1
    }
    en > 0 && top == 0 -> lead = 0

    #{overflow=wrap}
    bits = (en - 1) * 32 + lead

    ; 從最高位到最低位
    #{overflow=wrap}
    i = bits - 1
    (i >= 0) {

        #{overflow=wrap}
        e-limb = i / 32
        e-bit = i % 32

        #{index-out=zero}
        exp-bit = (exp[e-limb] >> e-bit) & 1

        new-result []i64
        new-rn = 0
        new-result, new-rn = rsa-modpow-step(local-result, local-rn, base, bn, exp-bit, modulus, mn)
        local-result = new-result
        local-rn = new-rn

        #{overflow=wrap}
        i = i - 1
    }
    result = local-result
    rn = local-rn
}

; ─── RSA 加密/解密（高階介面）────────────────────

; RSA 加密（c = m^e mod n）
; msg: 明文大數 m（須小於 mod，未做 PKCS#1 填充）
; msgn: msg 的 limb 數
; pub-exp: 公開指數 e
; pubn: pub-exp 的 limb 數
; mod: 模數 n
; modn: mod 的 limb 數
; out: 密文 c = m^e mod n
; outn: out 的 limb 數
; [rsa-encrypt](#rsa.rsa-encrypt)
rsa-encrypt = (msg []i64, msgn i64, pub-exp []i64, pubn i64, mod []i64, modn i64) (out []i64, outn i64) {
    out, outn = rsa-modpow(msg, msgn, pub-exp, pubn, mod, modn)
}

; RSA 解密（m = c^d mod n）
; ct: 密文大數 c（須小於 mod）
; ctn: ct 的 limb 數
; priv-exp: 私鑰指數 d
; privn: priv-exp 的 limb 數
; mod: 模數 n
; modn: mod 的 limb 數
; out: 明文 m = c^d mod n（未做 PKCS#1 去填充）
; outn: out 的 limb 數
; [rsa-decrypt](#rsa.rsa-decrypt)
rsa-decrypt = (ct []i64, ctn i64, priv-exp []i64, privn i64, mod []i64, modn i64) (out []i64, outn i64) {
    out, outn = rsa-modpow(ct, ctn, priv-exp, privn, mod, modn)
}
