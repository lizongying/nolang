; base32 — Base32 編碼/解碼（RFC 4648）
;
; 將位元組資料編碼為 Base32 字串（A-Z, 2-7）。
; 每 5 位元組編碼為 8 個字元，不足部分以 '=' 填充。
;
; 用法：
;   encoded = encode(data)
;   decoded = decode(encoded)

; Base32 字母表
BASE32-ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'

; encode: Base32 編碼
; data []byte: 輸入資料
; 返回 out str: Base32 編碼字串
encode = (data []byte) (out str) {
    #{overflow=wrap}
    dlen = data.len()

    ; 計算輸出長度
    ; 每 5 位元組 → 8 字元，不足部分加填充
    #{overflow=wrap}
    full-groups = dlen / 5
    remainder = dlen % 5
    #{overflow=wrap}
    out-len = full-groups * 8
    #{overflow=wrap}
    remainder != 0 -> out-len = out-len + 8
    out str = with-len(out-len)
    out-pos = 0

    pos = 0
    {

        ; 提取 5 位元組 → 40 位元 → 8 個 5-bit 值
        #{overflow=wrap}
        #{index-out = 0}
        b0 = data[pos]
        #{overflow=wrap}
        #{index-out = 0}
        b1 = data[pos + 1]
        #{overflow=wrap}
        #{index-out = 0}
        b2 = data[pos + 2]
        #{overflow=wrap}
        #{index-out = 0}
        b3 = data[pos + 3]
        #{overflow=wrap}
        #{index-out = 0}
        b4 = data[pos + 4]

        #{index-out = 0}
        out[out-pos] = BASE32-ALPHABET[(b0 >> 3) & 31]
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 1] = BASE32-ALPHABET[((b0 & 7) << 2) | ((b1 >> 6) & 3)]
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 2] = BASE32-ALPHABET[(b1 >> 1) & 31]
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 3] = BASE32-ALPHABET[((b1 & 1) << 4) | ((b2 >> 4) & 15)]
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 4] = BASE32-ALPHABET[((b2 & 15) << 1) | ((b3 >> 7) & 1)]
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 5] = BASE32-ALPHABET[(b3 >> 2) & 31]
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 6] = BASE32-ALPHABET[((b3 & 3) << 3) | ((b4 >> 5) & 7)]
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 7] = BASE32-ALPHABET[b4 & 31]

        #{overflow=wrap}
        pos = pos + 5
        #{overflow=wrap}
        out-pos = out-pos + 8
    } (pos + 5 <= dlen)

    ; 處理剩餘位元組
    #{overflow=wrap}
    remainder != 0 -> {

        ; 補零到 5 位元組
        #{overflow=wrap}
        b0 = 0
        b1 = 0
        b2 = 0
        b3 = 0
        b4 = 0
                remainder >= 1 -> {
            #{index-out = 0}
            b0 = data[pos]
        }
                remainder >= 2 -> {
            #{index-out = 0}
            b1 = data[pos + 1]
        }
                remainder >= 3 -> {
            #{index-out = 0}
            b2 = data[pos + 2]
        }
                remainder >= 4 -> {
            #{index-out = 0}
            b3 = data[pos + 3]
        }

        ; 根據剩餘位元組數決定輸出字元和填充
        #{index-out = 0}
        out[out-pos] = BASE32-ALPHABET[(b0 >> 3) & 31]
        #{index-out = 0}
        out[out-pos + 1] = BASE32-ALPHABET[((b0 & 7) << 2) | ((b1 >> 6) & 3)]

        {
            remainder == 1 -> {
                ; 1 byte → 2 chars + 6 padding
                #{overflow=wrap}
                #{index-out = 0}
                out[out-pos + 2] = '='
                #{index-out = 0}
                out[out-pos + 3] = '='
                #{index-out = 0}
                out[out-pos + 4] = '='
                #{index-out = 0}
                out[out-pos + 5] = '='
                #{index-out = 0}
                out[out-pos + 6] = '='
                #{index-out = 0}
                out[out-pos + 7] = '='
            }

            remainder == 2 -> {
                #{overflow=wrap}
                #{index-out = 0}
                out[out-pos + 2] = BASE32-ALPHABET[(b1 >> 1) & 31]
                #{index-out = 0}
                out[out-pos + 3] = BASE32-ALPHABET[((b1 & 1) << 4) | ((b2 >> 4) & 15)]
                #{index-out = 0}
                out[out-pos + 4] = '='
                #{index-out = 0}
                out[out-pos + 5] = '='
                #{index-out = 0}
                out[out-pos + 6] = '='
                #{index-out = 0}
                out[out-pos + 7] = '='
            }

            remainder == 3 -> {
                #{overflow=wrap}
                #{index-out = 0}
                out[out-pos + 2] = BASE32-ALPHABET[(b1 >> 1) & 31]
                #{index-out = 0}
                out[out-pos + 3] = BASE32-ALPHABET[((b1 & 1) << 4) | ((b2 >> 4) & 15)]
                #{index-out = 0}
                out[out-pos + 4] = BASE32-ALPHABET[((b2 & 15) << 1) | ((b3 >> 7) & 1)]
                #{index-out = 0}
                out[out-pos + 5] = '='
                #{index-out = 0}
                out[out-pos + 6] = '='
                #{index-out = 0}
                out[out-pos + 7] = '='
            }

            remainder == 4 -> {
                #{overflow=wrap}
                #{index-out = 0}
                out[out-pos + 2] = BASE32-ALPHABET[(b1 >> 1) & 31]
                #{index-out = 0}
                out[out-pos + 3] = BASE32-ALPHABET[((b1 & 1) << 4) | ((b2 >> 4) & 15)]
                #{index-out = 0}
                out[out-pos + 4] = BASE32-ALPHABET[((b2 & 15) << 1) | ((b3 >> 7) & 1)]
                #{index-out = 0}
                out[out-pos + 5] = BASE32-ALPHABET[(b3 >> 2) & 31]
                #{index-out = 0}
                out[out-pos + 6] = BASE32-ALPHABET[((b3 & 3) << 3) | ((b4 >> 5) & 7)]
                #{index-out = 0}
                out[out-pos + 7] = '='
            }
        }
    }
}

; decode: Base32 解碼
; in str: Base32 編碼字串
; 返回 out []byte: 解碼後的資料
decode = (in str) (out []byte) {
    #{overflow=wrap}
    out = with-cap(in.len-bytes() * 5 / 8)
    in-len = in.len-bytes()

    ; 計算填充數
    pad-count = 0
    #{overflow=wrap}
    i = in-len - 1
    {
        #{overflow=wrap}
        {
                        in[i] == '=' -> {
                #{index-out = 0}
                pad-count = pad-count + 1
            }

            -> break
        }
        #{overflow=wrap}
        i = i - 1
    } (i >= 0)
    out-pos = 0
    pos = 0
    {

        ; 解碼 8 個字元 → 5 位元組
        #{overflow=wrap}
        v0 = 0
        v1 = 0
        v2 = 0
        v3 = 0
        v4 = 0
        v5 = 0
        v6 = 0
        v7 = 0

        ; 將字元映射回 5-bit 值
        i <- [0..8): {
            #{overflow=wrap}
            #{index-out = 0}
            c = in[pos + i]
            val = 0
            #{overflow=wrap}
            {
                c >= 'A' && c <= 'Z' -> val = c - 'A'

                c >= 'a' && c <= 'z' -> val = c - 'a'

                c >= '2' && c <= '7' -> val = c - '2' + 26

                c == '=' -> val = 0
            }
            {
                i == 0 -> v0 = val

                i == 1 -> v1 = val

                i == 2 -> v2 = val

                i == 3 -> v3 = val

                i == 4 -> v4 = val

                i == 5 -> v5 = val

                i == 6 -> v6 = val

                i == 7 -> v7 = val
            }
        }

        ; 組合為 5 位元組
        #{index-out = 0}
        out[out-pos] = ((v0 << 3) | (v1 >> 2)) & 255
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 1] = (((v1 & 3) << 6) | (v2 << 1) | (v3 >> 4)) & 255
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 2] = (((v3 & 15) << 4) | (v4 >> 1)) & 255
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 3] = (((v4 & 1) << 7) | (v5 << 2) | (v6 >> 3)) & 255
        #{overflow=wrap}
        #{index-out = 0}
        out[out-pos + 4] = (((v6 & 7) << 5) | v7) & 255

        #{overflow=wrap}
        pos = pos + 8
        #{overflow=wrap}
        out-pos = out-pos + 5
    } (pos + 8 <= in-len)

    ; 根據填充數調整輸出長度
    ; 6 padding → 1 byte, 4 padding → 2 bytes, 3 padding → 3 bytes, 1 padding → 4 bytes
    #{overflow=wrap}
    {
        pad-count == 6 -> out-pos = out-pos - 4

        pad-count == 4 -> out-pos = out-pos - 3

        pad-count == 3 -> out-pos = out-pos - 2

        pad-count == 1 -> out-pos = out-pos - 1
    }
}
