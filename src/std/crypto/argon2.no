; argon2 — Argon2id 記憶體困難金鑰推導函數（RFC 9106）
;
; Argon2 是 Password Hashing Competition 的優勝者。
; Argon2id 是混合模式，同時抵抗時間和空間攻擊。
;
; 使用 Blake2b 作為底層哈希函數。
;
; 用法：
;   # std/crypto/argon2
;   password []byte = 'password'
;   salt []byte = 'somesalt'
;   // 參數: time_cost=3, memory_cost=4096, parallelism=1, output_len=32
;   derived = id(password, salt, 3, 4096, 1, 32)
; [argon2](#argon2)

; 常量
...

; Argon2 版本
; [ARGON2-VERSION](#argon2.argon2-version)
ARGON2-VERSION = 19

; Argon2 類型
; [ARGON2-ID](#argon2.argon2-id)
ARGON2-ID = 2

; 區塊大小（1024 位元組 = 128 × 8 位元組）
; [ARGON2-BLOCK-SIZE](#argon2.argon2-block-size)
ARGON2-BLOCK-SIZE = 1024
ARGON2-BLOCK-QWORDS = 128

; 64-bit 全 1 遮罩
; [ARGON2-MASK](#argon2.argon2-mask)
ARGON2-MASK u64 = 18446744073709551615

; 輔助函數
...

; rotr64: 64-bit 循環右移
; x u64: 要旋轉的 64-bit 字
; n i64: 右移位數（1–63；0 或 64 時移位未定義）
; r u64: (x >> n) | (x << (64-n))，只保留低 64 位
; [rotr](#argon2.rotr)
rotr = (x u64, n i64) (r u64) {
    r = ((x >> n) | (x << (64 - n))) & ARGON2-MASK
}

; Blake2b G 函數（Argon2 壓縮函數的基本混合步驟）
; 直接原地修改 v 陣列中下標 a/b/c/d 的 64 位元字（兩兩相加、異或、旋轉）。
; v []u64: 16 字工作區（Argon2 區塊），會被原地修改
; a i64: 下標 a（0..15）
; b i64: 下標 b
; c i64: 下標 c
; d i64: 下標 d
; x u64: 保留參數（本實作未使用；混合所需的乘數由 v[a]/v[b] 的低 32 位即時算出）
; y u64: 保留參數（本實作未使用）
; 無返回值：結果留在 v[a]/v[b]/v[c]/v[d]
; [blake-g](#argon2.blake-g)
blake-g = (v []u64, a i64, b i64, c i64, d i64, x u64, y u64) {
    ixout60c21 = v[a]: {
        ok -> it

        -> _
    }

    ixout60c28 = v[b]: {
        ok -> it

        -> _
    }

    ixout60c40 = v[a]: {
        ok -> it

        -> _
    }

    ixout60c62 = v[b]: {
        ok -> it

        -> _
    }

    v[a]: {
        ok -> it = (ixout60c21 + ixout60c28 + 2 * (ixout60c40 & 4294967295) * (ixout60c62 & 4294967295)) & ARGON2-MASK

        -> _
    }

    ixout67c25 = v[d]: {
        ok -> it

        -> _
    }

    ixout67c32 = v[a]: {
        ok -> it

        -> _
    }

    v[d]: {
        ok -> it = rotr(ixout67c25 ^ ixout67c32, 32)

        -> _
    }

    ixout74c21 = v[c]: {
        ok -> it

        -> _
    }

    ixout74c28 = v[d]: {
        ok -> it

        -> _
    }

    ixout74c40 = v[c]: {
        ok -> it

        -> _
    }

    ixout74c62 = v[d]: {
        ok -> it

        -> _
    }

    v[c]: {
        ok -> it = (ixout74c21 + ixout74c28 + 2 * (ixout74c40 & 4294967295) * (ixout74c62 & 4294967295)) & ARGON2-MASK

        -> _
    }

    ixout81c25 = v[b]: {
        ok -> it

        -> _
    }

    ixout81c32 = v[c]: {
        ok -> it

        -> _
    }

    v[b]: {
        ok -> it = rotr(ixout81c25 ^ ixout81c32, 24)

        -> _
    }

    ixout88c21 = v[a]: {
        ok -> it

        -> _
    }

    ixout88c28 = v[b]: {
        ok -> it

        -> _
    }

    ixout88c40 = v[a]: {
        ok -> it

        -> _
    }

    ixout88c62 = v[b]: {
        ok -> it

        -> _
    }

    v[a]: {
        ok -> it = (ixout88c21 + ixout88c28 + 2 * (ixout88c40 & 4294967295) * (ixout88c62 & 4294967295)) & ARGON2-MASK

        -> _
    }

    ixout95c25 = v[d]: {
        ok -> it

        -> _
    }

    ixout95c32 = v[a]: {
        ok -> it

        -> _
    }

    v[d]: {
        ok -> it = rotr(ixout95c25 ^ ixout95c32, 16)

        -> _
    }

    ixout102c21 = v[c]: {
        ok -> it

        -> _
    }

    ixout102c28 = v[d]: {
        ok -> it

        -> _
    }

    ixout102c40 = v[c]: {
        ok -> it

        -> _
    }

    ixout102c62 = v[d]: {
        ok -> it

        -> _
    }

    v[c]: {
        ok -> it = (ixout102c21 + ixout102c28 + 2 * (ixout102c40 & 4294967295) * (ixout102c62 & 4294967295)) & ARGON2-MASK

        -> _
    }

    ixout109c25 = v[b]: {
        ok -> it

        -> _
    }

    ixout109c32 = v[c]: {
        ok -> it

        -> _
    }

    v[b]: {
        ok -> it = rotr(ixout109c25 ^ ixout109c32, 63)

        -> _
    }
}

; 可變長度 Blake2b（H'）
...

; 可變長度 Blake2b（H'）：Argon2 用它把區塊摘要擴展成任意長度的輸出
; input []byte: 輸入資料（通常為 64 位元組的 Blake2b 摘要）
; out-len i64: 期望的輸出位元組數；<=64 時只需一次 Blake2b
; out []byte: 恰好 out-len 位元組的派生結果
; [h-prime](#argon2.h-prime)
h-prime = (input []byte, out-len i64) (out []byte) {
    out = with-cap(out-len)

    ; 輸出長度的 32-bit 小端表示
    len-bytes [4]byte

    len-bytes[0]: {
        ok -> it = out-len & 255

        -> _
    }

    len-bytes[1]: {
        ok -> it = (out-len >> 8) & 255

        -> _
    }

    len-bytes[2]: {
        ok -> it = (out-len >> 16) & 255

        -> _
    }

    len-bytes[3]: {
        ok -> it = (out-len >> 24) & 255

        -> _
    }

    {
        out-len <= 64 -> {

            ; Blake2b 輸出，參數: out_len 作為 salt
            ; 構建輸入: len_bytes || input
            ; combined 必須先分配：4 位元組長度前綴 || input。空 vec 下標寫
            ; 沒有增長護欄，會越界寫 → SIGSEGV。
            combined []byte = with-len(4 + input.len())

            combined[0]: {
                ok -> it = len-bytes[0]: {
                    ok -> it

                    -> _
                }

                -> _
            }

            combined[1]: {
                ok -> it = len-bytes[1]: {
                    ok -> it

                    -> _
                }

                -> _
            }

            combined[2]: {
                ok -> it = len-bytes[2]: {
                    ok -> it

                    -> _
                }

                -> _
            }

            combined[3]: {
                ok -> it = len-bytes[3]: {
                    ok -> it

                    -> _
                }

                -> _
            }
            i <- [0..input.len()): {
                ixout190c32 = input[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                combined[4 + i]: {
                    ok -> it = ixout190c32

                    -> _
                }
            }

            ; 使用 Blake2b 自定義輸出長度
            ; 由於 blake2b 固定輸出 64 位元組，這裡截斷
            hash [64]byte
            hash = blake2.b(combined)
            i <- [0..out-len): {
                ixout343c1e = hash[i]: {
                    ok -> it

                    -> _
                }

                out[i] = ixout343c1e
            }
        }

        -> {

            ; 輸出 > 64 位元組，需要多次 Blake2b
            ; V = Blake2b(len_bytes || input)
            ; combined 必須先分配：4 位元組長度前綴 || input。空 vec 下標寫
            ; 沒有增長護欄，會越界寫 → SIGSEGV。
            combined []byte = with-len(4 + input.len())

            combined[0]: {
                ok -> it = len-bytes[0]: {
                    ok -> it

                    -> _
                }

                -> _
            }

            combined[1]: {
                ok -> it = len-bytes[1]: {
                    ok -> it

                    -> _
                }

                -> _
            }

            combined[2]: {
                ok -> it = len-bytes[2]: {
                    ok -> it

                    -> _
                }

                -> _
            }

            combined[3]: {
                ok -> it = len-bytes[3]: {
                    ok -> it

                    -> _
                }

                -> _
            }
            i <- [0..input.len()): {
                ixout240c32 = input[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                combined[4 + i]: {
                    ok -> it = ixout240c32

                    -> _
                }
            }
            v [64]byte
            v = blake2.b(combined)

            ; 輸出前 32 位元組
            i <- [0..32): {
                ixout397c1b = v[i]: {
                    ok -> it

                    -> _
                }

                out[i] = ixout397c1b
            }

            #{overflow=wrap}
            remaining = out-len - 32
            pos = 32
            (remaining > 64) {
                v = blake2.b(v)
                i <- [0..32): {
                    ixout408c25 = v[i]: {
                        ok -> it

                        -> _
                    }

                    #{overflow=wrap}
                    out[pos + i] = ixout408c25
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    pos-opt = pos + 32
                    pos-opt: {
                        ok -> pos = it

                        ->
                    }
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    remaining-opt = remaining - 32
                    remaining-opt: {
                        ok -> remaining = it

                        ->
                    }
                }
            }

            ; 最後一個區塊
            last-hash [64]byte
            last-hash = blake2.b(v)
            i <- [0..remaining): {
                ixout442c29 = last-hash[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                out[pos + i] = ixout442c29
            }
        }
    }
}

; 壓縮函數 G
...

; Argon2 壓縮函數 G(X, Y)
; 先把 X XOR Y 寫入暫存 r，對 r 的每個 16-word 列與行各跑一輪 blake-g，
; 最後把結果與原 r 再 XOR 一次寫回 out。
; x []byte: 1024 位元組區塊 X
; y []byte: 1024 位元組區塊 Y
; 返回 out []byte: 1024 位元組壓縮結果
; [compress](#argon2.compress)
compress = (x []byte, y []byte) (out []byte) {
    out = with-len(1024)

    ; R = X XOR Y
    ; r 必須先分配 1024 位元組：`r []byte` 是空 vec，下標寫沒有增長護欄，
    ; 直接 `r[i]: { ok -> it = … }` 是越界寫 → SIGSEGV（compress 崩潰根因）。
    r []byte = with-len(1024)
    i <- [0..1024): {
        ixout305c25 = x[i]: {
            ok -> it

            -> _
        }

        ixout305c34 = y[i]: {
            ok -> it

            -> _
        }

        r[i]: {
            ok -> it = (ixout305c25) ^ (ixout305c34)

            -> _
        }
    }

    ; 載入為 128 個 u64（16×8 矩陣）
    v [128]u64
    i <- [0..128): {

        #{overflow=wrap}
        off = i * 8

        ixout320c25 = r[off]: {
            ok -> it

            -> _
        }

        ixout320c37 = r[off + 1]: {
            ok -> it

            -> _
        }

        ixout320c59 = r[off + 2]: {
            ok -> it

            -> _
        }

        ixout320c82 = r[off + 3]: {
            ok -> it

            -> _
        }

        ixout320c105 = r[off + 4]: {
            ok -> it

            -> _
        }

        ixout320c128 = r[off + 5]: {
            ok -> it

            -> _
        }

        ixout320c151 = r[off + 6]: {
            ok -> it

            -> _
        }

        ixout320c174 = r[off + 7]: {
            ok -> it

            -> _
        }

        v[i]: {
            ok -> it = (ixout320c25) | ((ixout320c37) << 8) | ((ixout320c59) << 16) | ((ixout320c82) << 24) | ((ixout320c105) << 32) | ((ixout320c128) << 40) | ((ixout320c151) << 48) | ((ixout320c174) << 56)

            -> _
        }
    }

    ; 應用 P 函數（Blake2b 排列）到每行
    i <- [0..8): {

        ; 行 i: v[16*i .. 16*i+15]
        #{overflow=wrap}
        base = i * 16

        ; 兩輪 G
        #{overflow=wrap}
        blake-g(v, base + 0, base + 4, base + 8, base + 12, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 1, base + 5, base + 9, base + 13, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 2, base + 6, base + 10, base + 14, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 3, base + 7, base + 11, base + 15, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 0, base + 5, base + 10, base + 15, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 1, base + 6, base + 11, base + 12, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 2, base + 7, base + 8, base + 13, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 3, base + 4, base + 9, base + 14, 0, 0)
    }

    ; 應用 P 函數到每列（stride 8），依 RFC 9106 §3.4：T[j] = v[base + 8*j]
    i <- [0..8): {
        base = i

        #{overflow=wrap}
        blake-g(v, base + 0, base + 32, base + 64, base + 96, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 8, base + 40, base + 72, base + 104, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 16, base + 48, base + 80, base + 112, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 24, base + 56, base + 88, base + 120, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 0, base + 40, base + 80, base + 120, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 8, base + 48, base + 88, base + 96, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 16, base + 56, base + 64, base + 104, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 24, base + 32, base + 72, base + 112, 0, 0)
    }

    ; 輸出 = (X XOR Y) XOR Z（即 R XOR P(R)）
    i <- [0..128): {

        #{overflow=wrap}
        off = i * 8

        val = v[i]

        ixout397c35 = r[off]: {
            ok -> it

            -> _
        }

        out[off] = ((val & 255) ^ ixout397c35) & 255

        #{overflow=wrap}
        ixout400c46 = r[off + 1]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[off + 1] = (((val >> 8) & 255) ^ ixout400c46) & 255

        #{overflow=wrap}
        ixout403c47 = r[off + 2]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[off + 2] = (((val >> 16) & 255) ^ ixout403c47) & 255

        #{overflow=wrap}
        ixout406c47 = r[off + 3]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[off + 3] = (((val >> 24) & 255) ^ ixout406c47) & 255

        #{overflow=wrap}
        ixout409c47 = r[off + 4]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[off + 4] = (((val >> 32) & 255) ^ ixout409c47) & 255

        #{overflow=wrap}
        ixout412c47 = r[off + 5]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[off + 5] = (((val >> 40) & 255) ^ ixout412c47) & 255

        #{overflow=wrap}
        ixout415c47 = r[off + 6]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[off + 6] = (((val >> 48) & 255) ^ ixout415c47) & 255

        #{overflow=wrap}
        ixout418c47 = r[off + 7]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[off + 7] = (((val >> 56) & 255) ^ ixout418c47) & 255
    }
}

; Argon2id 公開 API
...

; Argon2id 金鑰推導（RFC 9106，Argon2id v=0x13）
; 先算區塊數 m（向下取整到 4*parallelism 的倍數，且至少 8*parallelism），
; 初始化 h0 後逐 lane 填塊、跑 time-cost 輪混合，最後抽出 out-len 位元組。
; password []byte: 密碼（UTF-8 位元組序列，可為空）
; salt []byte: 鹽值，至少 8 位元組且每帳號不同
; time-cost i64: 時間成本（迭代輪數，如 3）；越大越慢也越安全
; memory-cost i64: 記憶體成本（KB，如 65536 = 64MB）；過小會被提升到 8*parallelism 塊
; parallelism i64: 平行道數（如 1）；需 ≥ 1，且決定區塊數的取整粒度
; out-len i64: 輸出金鑰長度（位元組，常見 32）
; 返回 out []byte: 推導出的金鑰，長度恰為 out-len
; [id](#argon2.id)
id = (password []byte, salt []byte, time-cost i64, memory-cost i64, parallelism i64, out-len i64) (out []byte) {

    ; 計算記憶體區塊數
    ; D1：`/` `*` 的結果恆為 `?T`（除零／溢位），此處要的是普通整數（除零由
    ; codegen 守衛強制 0），故以以兩段式 match 解包。
    #{overflow=wrap}
    m = memory-cost / (4 * parallelism) * 4 * parallelism: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    m < 8 * parallelism -> {
        {

            #{overflow=wrap}
            m-opt2 = 8 * parallelism
            m-opt2: {
                ok -> m = it

                ->
            }
        }
    }
    lanes = parallelism
    blocks = m

    #{overflow=wrap}
    blocks-per-lane = blocks / lanes: {
        ok -> it

        -> 0
    }

    ; 構建 H0 輸入
    ; H0 = Blake2b(p || tau || m || t || v || y || len(P) || P || len(S) || S || len(K) || K || len(X) || X)
    ; h0-input 必須先分配：6 個 32-bit 欄位(p/out-len/m/t/v/y) + len(P)||P +
    ; len(S)||S + len(K) + len(X) = 40 + password.len() + salt.len()。空 vec
    ; 下標寫會越界 → SIGSEGV（id() 崩潰根因）。
    h0-input []byte = with-len(40 + password.len() + salt.len())
    pos = 0

    ; parallelism (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = parallelism & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (parallelism >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (parallelism >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (parallelism >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt2 = pos + 4
        pos-opt2: {
            ok -> pos = it

            ->
        }
    }

    ; out-len (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = out-len & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (out-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (out-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (out-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt3 = pos + 4
        pos-opt3: {
            ok -> pos = it

            ->
        }
    }

    ; memory-cost m (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = m & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (m >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (m >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (m >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt4 = pos + 4
        pos-opt4: {
            ok -> pos = it

            ->
        }
    }

    ; time-cost t (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = time-cost & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (time-cost >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (time-cost >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (time-cost >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt5 = pos + 4
        pos-opt5: {
            ok -> pos = it

            ->
        }
    }

    ; version v (32-bit LE) = 0x13
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = ARGON2-VERSION & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (ARGON2-VERSION >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt6 = pos + 4
        pos-opt6: {
            ok -> pos = it

            ->
        }
    }

    ; type y (32-bit LE) = 2 (Argon2id)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = ARGON2-ID & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt7 = pos + 4
        pos-opt7: {
            ok -> pos = it

            ->
        }
    }

    ; len(P) (32-bit LE) || P
    pw-len = password.len()

    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = pw-len & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (pw-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (pw-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (pw-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt8 = pos + 4
        pos-opt8: {
            ok -> pos = it

            ->
        }
    }
    i <- [0..pw-len): {
        ixout702c24 = password[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        h0-input[pos + i]: {
            ok -> it = ixout702c24

            -> _
        }
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt9 = pos + pw-len
        pos-opt9: {
            ok -> pos = it

            ->
        }
    }

    ; len(S) (32-bit LE) || S
    salt-len = salt.len()

    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = salt-len & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (salt-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (salt-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (salt-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt10 = pos + 4
        pos-opt10: {
            ok -> pos = it

            ->
        }
    }
    i <- [0..salt-len): {
        ixout748c24 = salt[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        h0-input[pos + i]: {
            ok -> it = ixout748c24

            -> _
        }
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt11 = pos + salt-len
        pos-opt11: {
            ok -> pos = it

            ->
        }
    }

    ; len(K) = 0, len(X) = 0（不使用金鑰和關聯資料）
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt12 = pos + 4
        pos-opt12: {
            ok -> pos = it

            ->
        }
    }

    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt13 = pos + 4
        pos-opt13: {
            ok -> pos = it

            ->
        }
    }

    ; H0 = Blake2b(h0-input)
    h0 [64]byte
    h0 = blake2.b(h0-input)

    ; 初始化記憶體矩陣
    ; 簡化：使用單個 lane（parallelism=1）
    ; 對於 parallelism > 1，需要更複雜的處理

    ; 計算每個區塊的初始值
    ; B[0] = H'(H0 || 0 || lane || 0)
    ; B[1] = H'(H0 || 1 || lane || 0)
    ; ...

    ; 記憶體矩陣（簡化為單 lane）
    ; blocks-per-lane 個 1024-byte 區塊。
    ; 必須預先 with-len 分配：MIR 下對空 vec 按下標寫入沒有增長護欄，
    ; 未分配就寫會越界 SIGSEGV（2026-10-30 argon2 回歸根因之一）。
    mem []byte = with-len(blocks-per-lane * 1024)

    ; 由於記憶體限制，使用 blocks-per-lane 個 1024-byte 區塊

    ; 初始化前兩個區塊
    ; 72 位元組 = H0(64) || i(32-bit LE) || lane(32-bit LE)
    init-input []byte = with-len(72)
    i <- [0..64): {
        init-input[i]: {
            ok -> it = h0[i]: {
                ok -> it

                -> _
            }

            -> _
        }
    }

    ; B[0]: H0 || 0 (32-bit LE) || 0 (32-bit LE)
    init-input[64]: {
        ok -> it = 0

        -> _
    }

    init-input[65]: {
        ok -> it = 0

        -> _
    }

    init-input[66]: {
        ok -> it = 0

        -> _
    }

    init-input[67]: {
        ok -> it = 0

        -> _
    }

    init-input[68]: {
        ok -> it = 0

        -> _
    }

    init-input[69]: {
        ok -> it = 0

        -> _
    }

    init-input[70]: {
        ok -> it = 0

        -> _
    }

    init-input[71]: {
        ok -> it = 0

        -> _
    }

    block0 []byte
    block0 = h-prime(init-input, 1024)

    ; B[1]: H0 || 1 (32-bit LE) || 0 (32-bit LE)
    init-input[68]: {
        ok -> it = 1

        -> _
    }
    block1 []byte
    block1 = h-prime(init-input, 1024)

    ; 複製到記憶體
    i <- [0..1024): {
        ixout918c24 = block0[i]: {
            ok -> it

            -> _
        }

        mem[i]: {
            ok -> it = ixout918c24

            -> _
        }

        ixout925c24 = block1[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mem[1024 + i]: {
            ok -> it = ixout925c24

            -> _
        }
    }

    ; 填充剩餘區塊
    curr-idx = 2
    (curr-idx < blocks-per-lane) {

        ; 參考區塊（前一個）
        #{overflow=wrap}
        prev-idx = curr-idx - 1

        ; Argon2id: 第一 pass 的前半部分使用 data-independent 定址
        ; 簡化：使用前一個區塊作為參考
        #{overflow=wrap}
        ref-idx = curr-idx - 1
        ref-idx < 0 -> ref-idx = 0

        ; 計算新區塊 = G(mem[prev], mem[ref])
        new-block = compress(mem[prev-idx * 1024..], mem[ref-idx * 1024..])

        i <- [0..1024): {
            ixout952c28 = new-block[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            mem[curr-idx * 1024 + i]: {
                ok -> it = ixout952c28

                -> _
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            curr-idx-opt = curr-idx + 1
            curr-idx-opt: {
                ok -> curr-idx = it

                ->
            }
        }
    }

    ; 迭代 passes
    pass <- [1..time-cost): {
        curr-idx = 0
        (curr-idx < blocks-per-lane) {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                prev-idx-opt = curr-idx - 1
                prev-idx-opt: {
                    ok -> prev-idx = it

                    ->
                }
            }

            #{overflow=wrap}
            prev-idx < 0 -> {
                {

                    #{overflow=wrap}
                    prev-idx-opt2 = blocks-per-lane - 1
                    prev-idx-opt2: {
                        ok -> prev-idx = it

                        ->
                    }
                }
            }
            ref-idx = curr-idx
            ref-idx < 0 -> ref-idx = 0

            ; 新區塊 = G(mem[prev], mem[ref]) XOR 舊區塊
            new-block = compress(mem[prev-idx * 1024..], mem[ref-idx * 1024..])

            i <- [0..1024): {

                #{overflow=wrap}
                ixout982c33 = mem[curr-idx * 1024 + i]: {
                    ok -> it

                    -> _
                }

                ixout982c62 = new-block[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                mem[curr-idx * 1024 + i]: {
                    ok -> it = (ixout982c33) ^ (ixout982c62)

                    -> _
                }
            }

            #{overflow=wrap}
            {

                #{overflow=wrap}
                curr-idx-opt2 = curr-idx + 1
                curr-idx-opt2: {
                    ok -> curr-idx = it

                    ->
                }
            }
        }
    }

    ; 最終區塊 = XOR 所有 lane 的最後區塊
    ; 簡化（單 lane）：最終區塊 = 最後一個區塊
    final-block []byte = with-len(1024)

    #{overflow=wrap}
    last-idx = blocks-per-lane - 1
    i <- [0..1024): {

        #{overflow=wrap}
        ixout1003c24 = mem[last-idx * 1024 + i]: {
            ok -> it

            -> _
        }

        final-block[i]: {
            ok -> it = ixout1003c24

            -> _
        }
    }

    ; 輸出 = H'(final_block, out_len)
    out = h-prime(final-block, out-len)
}
