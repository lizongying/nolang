; argon2 — Argon2id 記憶體困難金鑰推導函數（RFC 9106）
;
; Argon2 是 Password Hashing Competition 的優勝者。
; Argon2id 是混合模式，同時抵抗時間和空間攻擊。
;
; 使用 Blake2b 作為底層哈希函數。
;
; 用法：
;   # std/crypto/argon2
;   password []byte = 'password'
;   salt []byte = 'somesalt'
;   // 參數: time_cost=3, memory_cost=4096, parallelism=1, output_len=32
;   derived = id(password, salt, 3, 4096, 1, 32)

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; Argon2 版本
ARGON2-VERSION = 19

; Argon2 類型
ARGON2-ID = 2

; 區塊大小（1024 位元組 = 128 × 8 位元組）
ARGON2-BLOCK-SIZE = 1024
ARGON2-BLOCK-QWORDS = 128

; 64-bit 全 1 遮罩
ARGON2-MASK u64 = 18446744073709551615

; ═══════════════════════════════════════════════
; 輔助函數
; ═══════════════════════════════════════════════

; rotr64: 64-bit 循環右移
; x u64: 要旋轉的 64-bit 字
; n i64: 右移位數（1–63；0 或 64 時移位未定義）
; r u64: (x >> n) | (x << (64-n))，只保留低 64 位
; [rotr](#argon2.rotr)
rotr = (x u64, n i64) (r u64) {

    r = ((x >> n) | (x << (64 - n))) & ARGON2-MASK
}

; Blake2b G 函數（Argon2 壓縮函數的基本混合步驟）
; 直接原地修改 v 陣列中下標 a/b/c/d 的 64 位元字（兩兩相加、異或、旋轉）。
; v []u64: 16 字工作區（Argon2 區塊），會被原地修改
; a i64: 下標 a（0..15）
; b i64: 下標 b
; c i64: 下標 c
; d i64: 下標 d
; x u64: 保留參數（本實作未使用；混合所需的乘數由 v[a]/v[b] 的低 32 位即時算出）
; y u64: 保留參數（本實作未使用）
; 無返回值：結果留在 v[a]/v[b]/v[c]/v[d]
; [blake-g](#argon2.blake-g)
blake-g = (v []u64, a i64, b i64, c i64, d i64, x u64, y u64) {

    #{index-out=zero}
    v[a]: {
        ok -> it = (v[a] + v[b] + 2 * (v[a] & 4294967295) * (v[b] & 4294967295)) & ARGON2-MASK

        -> _
    }

    #{index-out=zero}
    v[d]: {
        ok -> it = rotr(v[d] ^ v[a], 32)

        -> _
    }

    #{index-out=zero}
    v[c]: {
        ok -> it = (v[c] + v[d] + 2 * (v[c] & 4294967295) * (v[d] & 4294967295)) & ARGON2-MASK

        -> _
    }

    #{index-out=zero}
    v[b]: {
        ok -> it = rotr(v[b] ^ v[c], 24)

        -> _
    }

    #{index-out=zero}
    v[a]: {
        ok -> it = (v[a] + v[b] + 2 * (v[a] & 4294967295) * (v[b] & 4294967295)) & ARGON2-MASK

        -> _
    }

    #{index-out=zero}
    v[d]: {
        ok -> it = rotr(v[d] ^ v[a], 16)

        -> _
    }

    #{index-out=zero}
    v[c]: {
        ok -> it = (v[c] + v[d] + 2 * (v[c] & 4294967295) * (v[d] & 4294967295)) & ARGON2-MASK

        -> _
    }

    #{index-out=zero}
    v[b]: {
        ok -> it = rotr(v[b] ^ v[c], 63)

        -> _
    }
}

; ═══════════════════════════════════════════════
; 可變長度 Blake2b（H'）
; ═══════════════════════════════════════════════

; 可變長度 Blake2b（H'）：Argon2 用它把區塊摘要擴展成任意長度的輸出
; input []byte: 輸入資料（通常為 64 位元組的 Blake2b 摘要）
; out-len i64: 期望的輸出位元組數；<=64 時只需一次 Blake2b
; out []byte: 恰好 out-len 位元組的派生結果
; [h-prime](#argon2.h-prime)
h-prime = (input []byte, out-len i64) (out []byte) {
    out = with-cap(out-len)

    ; 輸出長度的 32-bit 小端表示
    len-bytes [4]byte

    len-bytes[0]: {
        ok -> it = out-len & 255

        -> _
    }

    len-bytes[1]: {
        ok -> it = (out-len >> 8) & 255

        -> _
    }

    len-bytes[2]: {
        ok -> it = (out-len >> 16) & 255

        -> _
    }

    len-bytes[3]: {
        ok -> it = (out-len >> 24) & 255

        -> _
    }

    {
        out-len <= 64 -> {

            ; Blake2b 輸出，參數: out_len 作為 salt
            ; 構建輸入: len_bytes || input
            ; combined 必須先分配：4 位元組長度前綴 || input。空 vec 下標寫
            ; 沒有增長護欄，會越界寫 → SIGSEGV。
            combined []byte = with-len(4 + input.len())

            combined[0]: {
                ok -> it = len-bytes[0]

                -> _
            }

            combined[1]: {
                ok -> it = len-bytes[1]

                -> _
            }

            combined[2]: {
                ok -> it = len-bytes[2]

                -> _
            }

            combined[3]: {
                ok -> it = len-bytes[3]

                -> _
            }
            i <- [0..input.len()): {

                #{index-out=zero, overflow=wrap}
                combined[4 + i]: {
                    ok -> it = input[i]

                    -> _
                }
            }

            ; 使用 Blake2b 自定義輸出長度
            ; 由於 blake2b 固定輸出 64 位元組，這裡截斷
            hash [64]byte
            hash = blake2.b(combined)
            i <- [0..out-len): {

                out[i] = hash[i]
            }
        }

        -> {

            ; 輸出 > 64 位元組，需要多次 Blake2b
            ; V = Blake2b(len_bytes || input)
            ; combined 必須先分配：4 位元組長度前綴 || input。空 vec 下標寫
            ; 沒有增長護欄，會越界寫 → SIGSEGV。
            combined []byte = with-len(4 + input.len())

            combined[0]: {
                ok -> it = len-bytes[0]

                -> _
            }

            combined[1]: {
                ok -> it = len-bytes[1]

                -> _
            }

            combined[2]: {
                ok -> it = len-bytes[2]

                -> _
            }

            combined[3]: {
                ok -> it = len-bytes[3]

                -> _
            }
            i <- [0..input.len()): {

                #{index-out=zero, overflow=wrap}
                combined[4 + i]: {
                    ok -> it = input[i]

                    -> _
                }
            }
            v [64]byte
            v = blake2.b(combined)

            ; 輸出前 32 位元組
            i <- [0..32): {

                out[i] = v[i]
            }

            #{overflow=wrap}
            remaining = out-len - 32
            pos = 32
            (remaining > 64) {

                v = blake2.b(v)
                i <- [0..32): {

                    #{overflow=wrap}
                    out[pos + i] = v[i]
                }

                #{overflow=wrap}
                pos = pos + 32

                #{overflow=wrap}
                remaining = remaining - 32
            }

            ; 最後一個區塊
            last-hash [64]byte
            last-hash = blake2.b(v)
            i <- [0..remaining): {

                #{overflow=wrap}
                out[pos + i] = last-hash[i]
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 壓縮函數 G
; ═══════════════════════════════════════════════

; Argon2 壓縮函數 G(X, Y)
; 先把 X XOR Y 寫入暫存 r，對 r 的每個 16-word 列與行各跑一輪 blake-g，
; 最後把結果與原 r 再 XOR 一次寫回 out。
; x []byte: 1024 位元組區塊 X
; y []byte: 1024 位元組區塊 Y
; 返回 out []byte: 1024 位元組壓縮結果
; [compress](#argon2.compress)
compress = (x []byte, y []byte) (out []byte) {
    out = with-len(1024)

    ; R = X XOR Y
    ; r 必須先分配 1024 位元組：`r []byte` 是空 vec，下標寫沒有增長護欄，
    ; 直接 `r[i]: { ok -> it = … }` 是越界寫 → SIGSEGV（compress 崩潰根因）。
    r []byte = with-len(1024)
    i <- [0..1024): {

        #{index-out=zero}
        r[i]: {
            ok -> it = (x[i]) ^ (y[i])

            -> _
        }
    }

    ; 載入為 128 個 u64（16×8 矩陣）
    v [128]u64
    i <- [0..128): {

        #{overflow=wrap}
        off = i * 8

        #{index-out=zero}
        v[i]: {
            ok -> it = (r[off]) | ((r[off + 1]) << 8) | ((r[off + 2]) << 16) | ((r[off + 3]) << 24) | ((r[off + 4]) << 32) | ((r[off + 5]) << 40) | ((r[off + 6]) << 48) | ((r[off + 7]) << 56)

            -> _
        }
    }

    ; 應用 P 函數（Blake2b 排列）到每行
    i <- [0..8): {

        ; 行 i: v[16*i .. 16*i+15]
        #{overflow=wrap}
        base = i * 16

        ; 兩輪 G
        #{overflow=wrap}
        blake-g(v, base + 0, base + 4, base + 8, base + 12, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 1, base + 5, base + 9, base + 13, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 2, base + 6, base + 10, base + 14, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 3, base + 7, base + 11, base + 15, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 0, base + 5, base + 10, base + 15, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 1, base + 6, base + 11, base + 12, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 2, base + 7, base + 8, base + 13, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 3, base + 4, base + 9, base + 14, 0, 0)
    }

    ; 應用 P 函數到每列（stride 8），依 RFC 9106 §3.4：T[j] = v[base + 8*j]
    i <- [0..8): {

        base = i

        #{overflow=wrap}
        blake-g(v, base + 0, base + 32, base + 64, base + 96, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 8, base + 40, base + 72, base + 104, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 16, base + 48, base + 80, base + 112, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 24, base + 56, base + 88, base + 120, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 0, base + 40, base + 80, base + 120, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 8, base + 48, base + 88, base + 96, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 16, base + 56, base + 64, base + 104, 0, 0)

        #{overflow=wrap}
        blake-g(v, base + 24, base + 32, base + 72, base + 112, 0, 0)
    }

    ; 輸出 = (X XOR Y) XOR Z（即 R XOR P(R)）
    i <- [0..128): {

        #{overflow=wrap}
        off = i * 8

        val = v[i]

        #{index-out=zero}
        out[off] = ((val & 255) ^ r[off]) & 255

        #{index-out=zero, overflow=wrap}
        out[off + 1] = (((val >> 8) & 255) ^ r[off + 1]) & 255

        #{index-out=zero, overflow=wrap}
        out[off + 2] = (((val >> 16) & 255) ^ r[off + 2]) & 255

        #{index-out=zero, overflow=wrap}
        out[off + 3] = (((val >> 24) & 255) ^ r[off + 3]) & 255

        #{index-out=zero, overflow=wrap}
        out[off + 4] = (((val >> 32) & 255) ^ r[off + 4]) & 255

        #{index-out=zero, overflow=wrap}
        out[off + 5] = (((val >> 40) & 255) ^ r[off + 5]) & 255

        #{index-out=zero, overflow=wrap}
        out[off + 6] = (((val >> 48) & 255) ^ r[off + 6]) & 255

        #{index-out=zero, overflow=wrap}
        out[off + 7] = (((val >> 56) & 255) ^ r[off + 7]) & 255
    }
}

; ═══════════════════════════════════════════════
; Argon2id 公開 API
; ═══════════════════════════════════════════════

; Argon2id 金鑰推導（RFC 9106，Argon2id v=0x13）
; 先算區塊數 m（向下取整到 4*parallelism 的倍數，且至少 8*parallelism），
; 初始化 h0 後逐 lane 填塊、跑 time-cost 輪混合，最後抽出 out-len 位元組。
; password []byte: 密碼（UTF-8 位元組序列，可為空）
; salt []byte: 鹽值，至少 8 位元組且每帳號不同
; time-cost i64: 時間成本（迭代輪數，如 3）；越大越慢也越安全
; memory-cost i64: 記憶體成本（KB，如 65536 = 64MB）；過小會被提升到 8*parallelism 塊
; parallelism i64: 平行道數（如 1）；需 ≥ 1，且決定區塊數的取整粒度
; out-len i64: 輸出金鑰長度（位元組，常見 32）
; 返回 out []byte: 推導出的金鑰，長度恰為 out-len
; [id](#argon2.id)
id = (password []byte, salt []byte, time-cost i64, memory-cost i64, parallelism i64, out-len i64) (out []byte) {

    ; 計算記憶體區塊數
    ; D1：`/` `*` 的結果恆為 `?T`（除零／溢位），此處要的是普通整數（除零由
    ; codegen 守衛強制 0），故以以兩段式 match 解包。
    #{overflow=wrap}
    m-opt = memory-cost / (4 * parallelism) * 4 * parallelism
    m = 0
    m-opt: {
        ok -> m = it

        -> m = 0
    }

    #{overflow=wrap}
    m < 8 * parallelism -> m = 8 * parallelism
    lanes = parallelism
    blocks = m

    #{overflow=wrap}
    blocks-per-lane-opt = blocks / lanes
    blocks-per-lane = 0
    blocks-per-lane-opt: {
        ok -> blocks-per-lane = it

        -> blocks-per-lane = 0
    }

    ; 構建 H0 輸入
    ; H0 = Blake2b(p || tau || m || t || v || y || len(P) || P || len(S) || S || len(K) || K || len(X) || X)
    ; h0-input 必須先分配：6 個 32-bit 欄位(p/out-len/m/t/v/y) + len(P)||P +
    ; len(S)||S + len(K) + len(X) = 40 + password.len() + salt.len()。空 vec
    ; 下標寫會越界 → SIGSEGV（id() 崩潰根因）。
    h0-input []byte = with-len(40 + password.len() + salt.len())
    pos = 0

    ; parallelism (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = parallelism & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (parallelism >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (parallelism >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (parallelism >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    ; out-len (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = out-len & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (out-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (out-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (out-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    ; memory-cost m (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = m & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (m >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (m >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (m >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    ; time-cost t (32-bit LE)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = time-cost & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (time-cost >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (time-cost >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (time-cost >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    ; version v (32-bit LE) = 0x13
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = ARGON2-VERSION & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (ARGON2-VERSION >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    ; type y (32-bit LE) = 2 (Argon2id)
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = ARGON2-ID & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    ; len(P) (32-bit LE) || P
    pw-len = password.len()

    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = pw-len & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (pw-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (pw-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (pw-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4
    i <- [0..pw-len): {

        #{index-out=zero, overflow=wrap}
        h0-input[pos + i]: {
            ok -> it = password[i]

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + pw-len

    ; len(S) (32-bit LE) || S
    salt-len = salt.len()

    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = salt-len & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = (salt-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = (salt-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = (salt-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4
    i <- [0..salt-len): {

        #{index-out=zero, overflow=wrap}
        h0-input[pos + i]: {
            ok -> it = salt[i]

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + salt-len

    ; len(K) = 0, len(X) = 0（不使用金鑰和關聯資料）
    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    #{overflow=wrap}
    h0-input[pos + 0]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 1]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 2]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    h0-input[pos + 3]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    pos = pos + 4

    ; H0 = Blake2b(h0-input)
    h0 [64]byte
    h0 = blake2.b(h0-input)

    ; 初始化記憶體矩陣
    ; 簡化：使用單個 lane（parallelism=1）
    ; 對於 parallelism > 1，需要更複雜的處理

    ; 計算每個區塊的初始值
    ; B[0] = H'(H0 || 0 || lane || 0)
    ; B[1] = H'(H0 || 1 || lane || 0)
    ; ...

    ; 記憶體矩陣（簡化為單 lane）
    ; blocks-per-lane 個 1024-byte 區塊。
    ; 必須預先 with-len 分配：MIR 下對空 vec 按下標寫入沒有增長護欄，
    ; 未分配就寫會越界 SIGSEGV（2026-10-30 argon2 回歸根因之一）。
    mem []byte = with-len(blocks-per-lane * 1024)

    ; 由於記憶體限制，使用 blocks-per-lane 個 1024-byte 區塊

    ; 初始化前兩個區塊
    ; 72 位元組 = H0(64) || i(32-bit LE) || lane(32-bit LE)
    init-input []byte = with-len(72)
    i <- [0..64): {

        init-input[i]: {
            ok -> it = h0[i]

            -> _
        }
    }

    ; B[0]: H0 || 0 (32-bit LE) || 0 (32-bit LE)
    init-input[64]: {
        ok -> it = 0

        -> _
    }

    init-input[65]: {
        ok -> it = 0

        -> _
    }

    init-input[66]: {
        ok -> it = 0

        -> _
    }

    init-input[67]: {
        ok -> it = 0

        -> _
    }

    init-input[68]: {
        ok -> it = 0

        -> _
    }

    init-input[69]: {
        ok -> it = 0

        -> _
    }

    init-input[70]: {
        ok -> it = 0

        -> _
    }

    init-input[71]: {
        ok -> it = 0

        -> _
    }

    block0 []byte
    block0 = h-prime(init-input, 1024)

    ; B[1]: H0 || 1 (32-bit LE) || 0 (32-bit LE)
    init-input[68]: {
        ok -> it = 1

        -> _
    }
    block1 []byte
    block1 = h-prime(init-input, 1024)

    ; 複製到記憶體
    i <- [0..1024): {

        #{index-out=zero}
        mem[i]: {
            ok -> it = block0[i]

            -> _
        }

        #{index-out=zero, overflow=wrap}
        mem[1024 + i]: {
            ok -> it = block1[i]

            -> _
        }
    }

    ; 填充剩餘區塊
    curr-idx = 2
    (curr-idx < blocks-per-lane) {

        ; 參考區塊（前一個）
        #{overflow=wrap}
        prev-idx = curr-idx - 1

        ; Argon2id: 第一 pass 的前半部分使用 data-independent 定址
        ; 簡化：使用前一個區塊作為參考
        #{overflow=wrap}
        ref-idx = curr-idx - 1
        ref-idx < 0 -> ref-idx = 0

        ; 計算新區塊 = G(mem[prev], mem[ref])
        new-block = compress(mem[prev-idx * 1024..], mem[ref-idx * 1024..])

        i <- [0..1024): {

            #{index-out=zero, overflow=wrap}
            mem[curr-idx * 1024 + i]: {
                ok -> it = new-block[i]

                -> _
            }
        }

        #{overflow=wrap}
        curr-idx = curr-idx + 1
    }

    ; 迭代 passes
    pass <- [1..time-cost): {

        curr-idx = 0
        (curr-idx < blocks-per-lane) {

            #{overflow=wrap}
            prev-idx = curr-idx - 1

            #{overflow=wrap}
            prev-idx < 0 -> prev-idx = blocks-per-lane - 1
            ref-idx = curr-idx
            ref-idx < 0 -> ref-idx = 0

            ; 新區塊 = G(mem[prev], mem[ref]) XOR 舊區塊
            new-block = compress(mem[prev-idx * 1024..], mem[ref-idx * 1024..])

            i <- [0..1024): {

                #{index-out=zero, overflow=wrap}
                mem[curr-idx * 1024 + i]: {
                    ok -> it = (mem[curr-idx * 1024 + i]) ^ (new-block[i])

                    -> _
                }
            }

            #{overflow=wrap}
            curr-idx = curr-idx + 1
        }
    }

    ; 最終區塊 = XOR 所有 lane 的最後區塊
    ; 簡化（單 lane）：最終區塊 = 最後一個區塊
    final-block []byte = with-len(1024)

    #{overflow=wrap}
    last-idx = blocks-per-lane - 1
    i <- [0..1024): {

        #{index-out=zero, overflow=wrap}
        final-block[i]: {
            ok -> it = mem[last-idx * 1024 + i]

            -> _
        }
    }

    ; 輸出 = H'(final_block, out_len)
    out = h-prime(final-block, out-len)
}
