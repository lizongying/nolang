; x25519 — X25519 橢圓曲線 Diffie-Hellman 金鑰交換（RFC 7748）
;
; 實作 Curve25519 上的 Montgomery ladder 純量乘法。
; 使用 10-limb 表示法（交替 26/25 位元）表示 GF(2^255-19) 域元素。
;
; 用法：
;   # std/crypto/x25519
;   // 生成金鑰對
;   priv [32]byte
;   pub [32]byte = x25519-scalarmult-base(priv)
;   // 共享金鑰
;   shared [32]byte = x25519-scalarmult(priv, peer-pub)
; [x25519](#x25519)

; 常量
...

; 域元素 limb 遮罩
; [MASK-26](#x25519.mask-26)
MASK-26 = 67108863
MASK-25 = 33554431

; Curve25519 常數
; [X25519-A24](#x25519.x25519-a24)
X25519-A24 = 121665

; 域元素基本操作
...

; 零元素
; h: 被寫成零元素的域元素（10 個 limb 全部置 0）
; [fe-zero](#x25519.fe-zero)
fe-zero = (h []i64) {
    i <- [0..10): {
        {
            h[i] ?= 0
        }: {
            err -> _

            -> _
        }
    }
}

; 一元素
; h: 被寫成單位元的域元素（limb0=1，其餘 0）
; [fe-one](#x25519.fe-one)
fe-one = (h []i64) {
    {
        h[0] ?= 1
    }: {
        err -> _

        -> _
    }

    i <- [1..10): {
        {
            h[i] ?= 0
        }: {
            err -> _

            -> _
        }
    }
}

; 複製域元素
; h: 目的域元素（原地被填入 f 的 10 個 limb）
; f: 來源域元素
; [fe-copy](#x25519.fe-copy)
fe-copy = (h []i64, f []i64) {
    i <- [0..10): {
        {
            h[i] ?= f[i]
        }: {
            err -> _

            -> _
        }
    }
}

; 域元素加法 h = f + g
; h: 逐 limb 相加的結果（未做進位傳播，等價性由後續乘/序列化保證）
; f: 左加數
; g: 右加數
; [fe-add](#x25519.fe-add)
fe-add = (h []i64, f []i64, g []i64) {
    i <- [0..10): {
        {
            f-limb ?= f[i]
            g-limb ?= g[i]

            #{overflow=wrap}
            h[i] ?= f-limb + g-limb
        }: {
            err -> _

            -> _
        }
    }
}

; 域元素減法 h = f - g
; h: 逐 limb 相減的結果（limb 可為負，靠後續規約轉回正代表）
; f: 被減數
; g: 減數
; [fe-sub](#x25519.fe-sub)
fe-sub = (h []i64, f []i64, g []i64) {
    i <- [0..10): {
        {
            f-limb ?= f[i]
            g-limb ?= g[i]

            #{overflow=wrap}
            h[i] ?= f-limb - g-limb
        }: {
            err -> _

            -> _
        }
    }
}

; 條件交換（Montgomery ladder 使用）
; 掩碼 b: 0=不交換, 1=交換
; a: 第一個域元素（原地參與交換）
; b: 第二個域元素（原地參與交換）
; mask: 0=不交換, 1=交換（內部展成全 1 遮碼，維持常數時間）
; [fe-cswap](#x25519.fe-cswap)
fe-cswap = (a []i64, b []i64, mask i64) {

    ; 常數時間：mask=0 時不交換，mask=-1（即全1）時交換
    ; 使用 mask = -mask 將 0/1 轉為 0/0xFFFFFFFFFFFFFFFF
    #{overflow=wrap}
    m = 0 - mask
    i <- [0..10): {
        {
            a-limb ?= a[i]
            b-limb ?= b[i]
            flip = m & (a-limb ^ b-limb)
            a[i] ?= a-limb ^ flip
            b[i] ?= b-limb ^ flip
        }: {
            err -> _

            -> _
        }
    }
}

; 域元素乘法
...

; 域元素乘法 h = f * g mod p
; 使用 ref10 交叉項展開
; 注意：使用陣列 t[] 儲存中間結果以避免編譯器最佳化問題
; h: 乘積域元素（f × g mod p）
; f: 因數（10 limb）
; g: 因數（10 limb）
; [fe-mul](#x25519.fe-mul)
fe-mul = (h []i64, f []i64, g []i64) {

    ; 提取 f / g 的各 limb（越界視為 0，與舊 `#{index-out=zero}` 的語意一致）
    {
        f0 ?= f[0]
        f1 ?= f[1]
        f2 ?= f[2]
        f3 ?= f[3]
        f4 ?= f[4]
        f5 ?= f[5]
        f6 ?= f[6]
        f7 ?= f[7]
        f8 ?= f[8]
        f9 ?= f[9]

        g0 ?= g[0]
        g1 ?= g[1]
        g2 ?= g[2]
        g3 ?= g[3]
        g4 ?= g[4]
        g5 ?= g[5]
        g6 ?= g[6]
        g7 ?= g[7]
        g8 ?= g[8]
        g9 ?= g[9]
    }: {
        err -> _

        -> _
    }

    ; 預計算 g 的 19 倍數（用於 wrap-around 折疊）
    #{overflow=wrap}
    g1-times-19 = 19 * g1
    #{overflow=wrap}
    g2-times-19 = 19 * g2
    #{overflow=wrap}
    g3-times-19 = 19 * g3
    #{overflow=wrap}
    g4-times-19 = 19 * g4
    #{overflow=wrap}
    g5-times-19 = 19 * g5
    #{overflow=wrap}
    g6-times-19 = 19 * g6
    #{overflow=wrap}
    g7-times-19 = 19 * g7
    #{overflow=wrap}
    g8-times-19 = 19 * g8
    #{overflow=wrap}
    g9-times-19 = 19 * g9

    ; 預計算 f 的 2 倍數（僅奇數索引 f1,f3,f5,f7,f9 需要）
    ; 偶數索引 f2,f4,f6,f8 不需要 2 倍，因為 h1/h3/h5/h7 的高位項
    ; wrap-around 因子為 19（shift_sum=255+shift_k），非 38（2*19）
    #{overflow=wrap}
    f1-doubled = 2 * f1
    #{overflow=wrap}
    f3-doubled = 2 * f3
    #{overflow=wrap}
    f5-doubled = 2 * f5
    #{overflow=wrap}
    f7-doubled = 2 * f7
    #{overflow=wrap}
    f9-doubled = 2 * f9

    ; 使用陣列儲存未進位的輸出 limb（避免編譯器最佳化問題）
    t []i64 = with-len(10)

    ; 計算各輸出 limb（未進位）— ref10 交叉項展開
    ; 規則：h_k 中，若 shift_i+shift_j = shift_k+255（wrap 19）或 = shift_k+256（wrap 38=2*19）
    ; shift 序列: 0,26,51,77,102,128,153,179,204,230
    ; 偶數 shift_k（0,51,102,153,204）: 奇數 i 的低位對稱項與奇數 i 的高位項都有 shift 和 = shift_k+1，故需 2 倍
    ; 奇數 shift_k（26,77,128,179,230）: 所有 wrap 項 shift 和恰好 = 255+shift_k，故只需 19 倍（無 2 倍）
    {
        #{overflow=wrap}
        t[0] ?= f0 * g0 + f1-doubled * g9-times-19 + f2 * g8-times-19 + f3-doubled * g7-times-19 + f4 * g6-times-19 + f5-doubled * g5-times-19 + f6 * g4-times-19 + f7-doubled * g3-times-19 + f8 * g2-times-19 + f9-doubled * g1-times-19

        #{overflow=wrap}
        t[1] ?= f0 * g1 + f1 * g0 + f2 * g9-times-19 + f3 * g8-times-19 + f4 * g7-times-19 + f5 * g6-times-19 + f6 * g5-times-19 + f7 * g4-times-19 + f8 * g3-times-19 + f9 * g2-times-19

        #{overflow=wrap}
        t[2] ?= f0 * g2 + f1-doubled * g1 + f2 * g0 + f3-doubled * g9-times-19 + f4 * g8-times-19 + f5-doubled * g7-times-19 + f6 * g6-times-19 + f7-doubled * g5-times-19 + f8 * g4-times-19 + f9-doubled * g3-times-19

        #{overflow=wrap}
        t[3] ?= f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4 * g9-times-19 + f5 * g8-times-19 + f6 * g7-times-19 + f7 * g6-times-19 + f8 * g5-times-19 + f9 * g4-times-19

        #{overflow=wrap}
        t[4] ?= f0 * g4 + f1-doubled * g3 + f2 * g2 + f3-doubled * g1 + f4 * g0 + f5-doubled * g9-times-19 + f6 * g8-times-19 + f7-doubled * g7-times-19 + f8 * g6-times-19 + f9-doubled * g5-times-19

        #{overflow=wrap}
        t[5] ?= f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6 * g9-times-19 + f7 * g8-times-19 + f8 * g7-times-19 + f9 * g6-times-19

        #{overflow=wrap}
        t[6] ?= f0 * g6 + f1-doubled * g5 + f2 * g4 + f3-doubled * g3 + f4 * g2 + f5-doubled * g1 + f6 * g0 + f7-doubled * g9-times-19 + f8 * g8-times-19 + f9-doubled * g7-times-19

        #{overflow=wrap}
        t[7] ?= f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8 * g9-times-19 + f9 * g8-times-19

        #{overflow=wrap}
        t[8] ?= f0 * g8 + f1-doubled * g7 + f2 * g6 + f3-doubled * g5 + f4 * g4 + f5-doubled * g3 + f6 * g2 + f7-doubled * g1 + f8 * g0 + f9-doubled * g9-times-19

        #{overflow=wrap}
        t[9] ?= f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0
    }: {
        err -> _

        -> _
    }

    ; 進位傳播 (ref10 風格：使用捨入常數 + floor division)
    ; Nolang 的 >> 對 i64 是邏輯右移（零填充），非算術右移（符號擴展）
    ; floor(x / 2^b) = (x >> b) - ((x >> 63) << (64 - b))
    ; 26-bit limbs: carry = floor((t + (1<<25)) / 2^26)
    ; 25-bit limbs: carry = floor((t + (1<<24)) / 2^25)
    ; limb 0 (26 bits)
    {
        limb ?= t[0]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c0 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[0] ?= limb - (c0 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 1 (25 bits)
    {
        prev ?= t[1]

        #{overflow=wrap}
        limb = prev + c0

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c1 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[1] ?= limb - (c1 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 2 (26 bits)
    {
        prev ?= t[2]

        #{overflow=wrap}
        limb = prev + c1

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c2 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[2] ?= limb - (c2 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 3 (25 bits)
    {
        prev ?= t[3]

        #{overflow=wrap}
        limb = prev + c2

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c3 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[3] ?= limb - (c3 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 4 (26 bits)
    {
        prev ?= t[4]

        #{overflow=wrap}
        limb = prev + c3

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c4 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[4] ?= limb - (c4 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 5 (25 bits)
    {
        prev ?= t[5]

        #{overflow=wrap}
        limb = prev + c4

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c5 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[5] ?= limb - (c5 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 6 (26 bits)
    {
        prev ?= t[6]

        #{overflow=wrap}
        limb = prev + c5

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c6 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[6] ?= limb - (c6 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 7 (25 bits)
    {
        prev ?= t[7]

        #{overflow=wrap}
        limb = prev + c6

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c7 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[7] ?= limb - (c7 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 8 (26 bits)
    {
        prev ?= t[8]

        #{overflow=wrap}
        limb = prev + c7

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c8 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[8] ?= limb - (c8 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 9 (25 bits)
    {
        prev ?= t[9]

        #{overflow=wrap}
        limb = prev + c8

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c9 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[9] ?= limb - (c9 << 25)
    }: {
        err -> _

        -> _
    }

    ; wrap-around: 2^255 ≡ 19
    {
        limb ?= t[0]

        #{overflow=wrap}
        wrapped = limb + c9 * 19

        #{overflow=wrap}
        rounded = wrapped + 33554432

        #{overflow=wrap}
        c10 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[0] ?= wrapped - (c10 << 26)
    }: {
        err -> _

        -> _
    }

    ; 第二次進位（處理 wrap-around 進位）：limb 1 與 limb 2
    {
        prev ?= t[1]

        #{overflow=wrap}
        limb = prev + c10

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c11 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[1] ?= limb - (c11 << 25)
    }: {
        err -> _

        -> _
    }

    {
        prev ?= t[2]

        #{overflow=wrap}
        t[2] ?= prev + c11
    }: {
        err -> _

        -> _
    }

    ; 寫回結果（t 的長度不足時該 limb 寫 0，與舊語意一致）
    i <- [0..10): {
        {
            limb ?= t[i]

            h[i] ?= limb
        }: {
            err -> _

            -> _
        }
    }
}

; 域元素平方 h = f^2 mod p
; 直接使用 fe-mul
; h: 平方結果（f² mod p）
; f: 被平方的域元素
; [fe-sq](#x25519.fe-sq)
fe-sq = (h []i64, f []i64) {
    fe-mul(h, f, f)
}

; 域元素乘以常數 121665 (= (A-2)/4, A=486662)
; Montgomery ladder 倍點公式 z2 = E*(AA + a24*E) 中 a24 必須是 121665，
; 不是 121666。121666 會讓 ladder 倍點錯誤（某些純量下輸出全零/錯誤）。
; 使用陣列儲存中間結果以避免編譯器最佳化問題
; h: 乘以 121665 後的域元素
; f: 被乘的域元素
; [fe-mul121665](#x25519.fe-mul121665)
fe-mul121665 = (h []i64, f []i64) {
    t []i64 = with-len(10)

    ; 逐 limb 乘常數（越界視為 0，與舊 `#{index-out=zero}` 的語意一致）
    i <- [0..10): {
        {
            limb ?= f[i]

            #{overflow=wrap}
            t[i] ?= 121665 * limb
        }: {
            err -> _

            -> _
        }
    }

    ; 進位傳播 (ref10 風格 + floor division，正確處理負數)
    ; limb 0 (26 bits)
    {
        limb ?= t[0]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c0 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[0] ?= limb - (c0 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 1 (25 bits)
    {
        prev ?= t[1]

        #{overflow=wrap}
        limb = prev + c0

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c1 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[1] ?= limb - (c1 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 2 (26 bits)
    {
        prev ?= t[2]

        #{overflow=wrap}
        limb = prev + c1

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c2 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[2] ?= limb - (c2 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 3 (25 bits)
    {
        prev ?= t[3]

        #{overflow=wrap}
        limb = prev + c2

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c3 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[3] ?= limb - (c3 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 4 (26 bits)
    {
        prev ?= t[4]

        #{overflow=wrap}
        limb = prev + c3

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c4 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[4] ?= limb - (c4 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 5 (25 bits)
    {
        prev ?= t[5]

        #{overflow=wrap}
        limb = prev + c4

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c5 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[5] ?= limb - (c5 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 6 (26 bits)
    {
        prev ?= t[6]

        #{overflow=wrap}
        limb = prev + c5

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c6 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[6] ?= limb - (c6 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 7 (25 bits)
    {
        prev ?= t[7]

        #{overflow=wrap}
        limb = prev + c6

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c7 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[7] ?= limb - (c7 << 25)
    }: {
        err -> _

        -> _
    }

    ; limb 8 (26 bits)
    {
        prev ?= t[8]

        #{overflow=wrap}
        limb = prev + c7

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c8 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[8] ?= limb - (c8 << 26)
    }: {
        err -> _

        -> _
    }

    ; limb 9 (25 bits)
    {
        prev ?= t[9]

        #{overflow=wrap}
        limb = prev + c8

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c9 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[9] ?= limb - (c9 << 25)
    }: {
        err -> _

        -> _
    }

    ; wrap-around: 2^255 ≡ 19，把 limb 9 溢出的進位折回 limb 0
    {
        limb ?= t[0]

        #{overflow=wrap}
        wrapped = limb + c9 * 19

        #{overflow=wrap}
        rounded = wrapped + 33554432

        #{overflow=wrap}
        c10 = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        t[0] ?= wrapped - (c10 << 26)
    }: {
        err -> _

        -> _
    }

    ; 第二次進位（處理 wrap-around 進位）：limb 1 與 limb 2
    {
        prev ?= t[1]

        #{overflow=wrap}
        limb = prev + c10

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c11 = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        t[1] ?= limb - (c11 << 25)
    }: {
        err -> _

        -> _
    }

    {
        prev ?= t[2]

        #{overflow=wrap}
        t[2] ?= prev + c11
    }: {
        err -> _

        -> _
    }

    ; 寫回結果（t 的長度不足時該 limb 寫 0，與舊語意一致）
    i <- [0..10): {
        {
            limb ?= t[i]

            h[i] ?= limb
        }: {
            err -> _

            -> _
        }
    }
}

; 域元素求逆（費馬小定理: a^(p-2) mod p）
; p-2 = 2^255 - 21
...

; 計算 a^(-1) mod p
; 使用 ref10 加法鏈計算 a^(p-2) = a^(2^255-21)
; 完整對齊 libsodium fe25519_invert 的加法鏈
; out: 寫入結果的域元素（10 limb）
; a: 待求逆的域元素（不可為零元素）
; [fe-invert](#x25519.fe-invert)
fe-invert = (out []i64, a []i64) {
    t0 []i64 = with-len(10)
    t1 []i64 = with-len(10)
    t2 []i64 = with-len(10)
    t3 []i64 = with-len(10)

    ; t0 = a^2
    fe-sq(t0, a)

    ; t1 = a^4
    fe-sq(t1, t0)

    ; t1 = a^8
    fe-sq(t1, t1)

    ; t1 = a * a^8 = a^9
    fe-mul(t1, a, t1)

    ; t0 = a^2 * a^9 = a^11
    fe-mul(t0, t0, t1)

    ; t2 = (a^11)^2 = a^22
    fe-sq(t2, t0)

    ; t1 = a^9 * a^22 = a^31 = a^(2^5 - 1)
    fe-mul(t1, t1, t2)

    ; t2 = (a^31)^(2^5) = a^992  (1 + 4 = 5 squarings)
    fe-sq(t2, t1)
    i <- [0..4): {
        fe-sq(t2, t2)
    }

    ; t1 = a^992 * a^31 = a^1023 = a^(2^10 - 1)
    fe-mul(t1, t2, t1)

    ; t2 = (a^1023)^(2^10) = a^(1023 * 1024)  (1 + 9 = 10 squarings)
    fe-sq(t2, t1)
    i <- [0..9): {
        fe-sq(t2, t2)
    }

    ; t2 = a^(1023*1024) * a^1023 = a^(1023*1025) = a^(2^20 - 1)
    fe-mul(t2, t2, t1)

    ; t3 = (a^(2^20-1))^(2^20) = a^((2^20-1) * 2^20)  (1 + 19 = 20 squarings)
    fe-sq(t3, t2)
    i <- [0..19): {
        fe-sq(t3, t3)
    }

    ; t2 = a^((2^20-1)*2^20) * a^(2^20-1) = a^(2^40 - 1)
    fe-mul(t2, t3, t2)

    ; t2 = (a^(2^40-1))^(2^10)  (NO initial sq, 10 squarings)
    ; ref10: for(i=1;i<11) = 10 iterations, NO fe_sq before loop
    i <- [0..10): {
        fe-sq(t2, t2)
    }

    ; t1 = a^((2^40-1)*2^10) * a^(2^10-1) = a^(2^50-1)
    fe-mul(t1, t2, t1)

    ; t2 = t1^(2^50)  (1 + 49 = 50 squarings)
    fe-sq(t2, t1)
    i <- [0..49): {
        fe-sq(t2, t2)
    }

    ; t2 = t2 * t1
    fe-mul(t2, t2, t1)

    ; t3 = t2^(2^100)  (1 + 99 = 100 squarings)
    fe-sq(t3, t2)
    i <- [0..99): {
        fe-sq(t3, t3)
    }

    ; t2 = t3 * t2
    fe-mul(t2, t3, t2)

    ; t2 = t2^(2^50)  (NO initial sq, 50 squarings)
    ; ref10: for(i=1;i<51) = 50 iterations, NO fe_sq before loop
    i <- [0..50): {
        fe-sq(t2, t2)
    }

    ; t1 = t2 * t1 = a^(2^250-1)
    fe-mul(t1, t2, t1)

    ; t1 = t1^(2^5)  (NO initial sq, 5 squarings)
    ; ref10: for(i=1;i<6) = 5 iterations, NO fe_sq before loop
    i <- [0..5): {
        fe-sq(t1, t1)
    }

    ; out = t1 * t0 = a^(2^255 - 21)
    fe-mul(out, t1, t0)
}

; 位元組序列轉換
...

; 從 32 位元組（小端序）載入域元素
; 使用 ref10 風格：先以位移載入未遮罩的 limb，再做進位傳播
; 進位傳播使用捨入常數 (1<<(bits-1))，產生「半規約」形式（limb 可為小負數）
; 此形式與 fe-tobytes 的預期輸入一致，確保 round-trip 正確
; h: 載入後的域元素（10 limb，已做半規約進位傳播）
; s: 32 位元組小端編碼（最高位元 bit255 會被遮掉）
; [fe-frombytes](#x25519.fe-frombytes)
fe-frombytes = (h []i64, s [32]byte) {

    ; 載入未遮罩 limb（每個 limb 包含「跨界」位元，由後續進位傳播規整）
    {
        b0 ?= s[0]
        b1 ?= s[1]
        b2 ?= s[2]
        b3 ?= s[3]

        b4 ?= s[4]
        b5 ?= s[5]
        b6 ?= s[6]

        b7 ?= s[7]
        b8 ?= s[8]
        b9 ?= s[9]

        b10 ?= s[10]
        b11 ?= s[11]
        b12 ?= s[12]

        b13 ?= s[13]
        b14 ?= s[14]
        b15 ?= s[15]

        b16 ?= s[16]
        b17 ?= s[17]
        b18 ?= s[18]
        b19 ?= s[19]

        b20 ?= s[20]
        b21 ?= s[21]
        b22 ?= s[22]

        b23 ?= s[23]
        b24 ?= s[24]
        b25 ?= s[25]

        b26 ?= s[26]
        b27 ?= s[27]
        b28 ?= s[28]

        b29 ?= s[29]
        b30 ?= s[30]
        b31 ?= s[31]

        h[0] ?= b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        h[1] ?= (b4 | (b5 << 8) | (b6 << 16)) << 6
        h[2] ?= (b7 | (b8 << 8) | (b9 << 16)) << 5
        h[3] ?= (b10 | (b11 << 8) | (b12 << 16)) << 3
        h[4] ?= (b13 | (b14 << 8) | (b15 << 16)) << 2
        h[5] ?= b16 | (b17 << 8) | (b18 << 16) | (b19 << 24)
        h[6] ?= (b20 | (b21 << 8) | (b22 << 16)) << 7
        h[7] ?= (b23 | (b24 << 8) | (b25 << 16)) << 5
        h[8] ?= (b26 | (b27 << 8) | (b28 << 16)) << 4
        h[9] ?= ((b29 | (b30 << 8) | (b31 << 16)) & 8388607) << 2
    }: {
        err -> _

        -> _
    }

    ; ⚠️ 進位順序必須照 ref10：先 25-bit 的奇數 limb（9,1,3,5,7），再 26-bit 的
    ; 偶數 limb（0,2,4,6,8）。跨界載入會產生 loose limb（t[9] 可為負、t[0] 遠離
    ; [0,2^26)），若照 0..9 的順序做，這些殘留直到最後才 wrap 回 t[0]、收不到後續
    ; 進位，輸出的就不是規範形；fe-tobytes 假設輸入已規範（只做兩輪進位），
    ; 直連時會丟掉幾乎整個高位。
    ; 例：inv(2) 用 0..9 順序載入得 [10, 0…0, -16777216]，tobytes 印出
    ; f7ffffff00…0040，正確值為 f7ffff…ff3f。

    {
        limb ?= h[9]

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        h[9] ?= limb - (c << 25)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[0]

        #{overflow=wrap}
        h[0] ?= limb + c * 19
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[1]

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        h[1] ?= limb - (c << 25)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[2]

        #{overflow=wrap}
        h[2] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[3]

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        h[3] ?= limb - (c << 25)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[4]

        #{overflow=wrap}
        h[4] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[5]

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        h[5] ?= limb - (c << 25)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[6]

        #{overflow=wrap}
        h[6] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[7]

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        h[7] ?= limb - (c << 25)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[8]

        #{overflow=wrap}
        h[8] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[0]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        h[0] ?= limb - (c << 26)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[1]

        #{overflow=wrap}
        h[1] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[2]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        h[2] ?= limb - (c << 26)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[3]

        #{overflow=wrap}
        h[3] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[4]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        h[4] ?= limb - (c << 26)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[5]

        #{overflow=wrap}
        h[5] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[6]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        h[6] ?= limb - (c << 26)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[7]

        #{overflow=wrap}
        h[7] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[8]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        h[8] ?= limb - (c << 26)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[9]

        #{overflow=wrap}
        h[9] ?= limb + c
    }: {
        err -> _

        -> _
    }

    ; 最終進位 h0 -> h1 -> h2
    {
        limb ?= h[0]

        #{overflow=wrap}
        rounded = limb + 33554432

        #{overflow=wrap}
        c = (rounded >> 26) - ((rounded >> 63) << 38)

        #{overflow=wrap}
        h[0] ?= limb - (c << 26)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[1]

        #{overflow=wrap}
        h[1] ?= limb + c
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[1]

        #{overflow=wrap}
        rounded = limb + 16777216

        #{overflow=wrap}
        c = (rounded >> 25) - ((rounded >> 63) << 39)

        #{overflow=wrap}
        h[1] ?= limb - (c << 25)
    }: {
        err -> _

        -> _
    }

    {
        limb ?= h[2]

        #{overflow=wrap}
        h[2] ?= limb + c
    }: {
        err -> _

        -> _
    }
}

; fe-tobytes 的純量算術輔助
; nolang 的 i64 算術是「檢查式」的：i64 op i64 會回傳 ?i64，只有含字面量的
; 表達式才維持 i64。把運算收進這幾個 i64→i64 的輔助函式後，呼叫端拿到的
; 一律是純量 i64，可以直接賦值給區域變數。overflow=wrap 讓溢位回繞而非回 0。
...

; i64 相加
; a: 左操作數
; b: 右操作數
; [num-add](#x25519.num-add)
num-add = (a i64, b i64) (v i64) {

    #{overflow=wrap}
    o = a + b

    v = o: {
        ok -> it

        -> 0
    }
}

; i64 相減
; a: 左操作數
; b: 右操作數
; [num-sub](#x25519.num-sub)
num-sub = (a i64, b i64) (v i64) {

    #{overflow=wrap}
    o = a - b

    v = o: {
        ok -> it

        -> 0
    }
}

; floor(x / 2^bits)，對負數亦正確
; 先加 2^40 把被除數抬到非負再右移——這樣不論 >> 是邏輯或算術右移結果都一樣
; （limb 絕對值遠小於 2^40），最後扣回 (2^40 >> bits)。
; x: 被除數
; bits: 位移量（本檔只會用 25 或 26）
; [num-floor](#x25519.num-floor)
num-floor = (x i64, bits i64) (q i64) {
    big = 1099511627776; 2^40
    base = big >> bits

    q = num-sub(num-add(x, big) >> bits, base)
}

; 將域元素序列化為 32 位元組（小端序）
; 依 ref10 fe_tobytes：先用 q 條件約減把值規約到 [0,p)，再逐級進位、遮罩、打包。
;
; ⚠️ 舊版把中間結果寫進區域 vec 再讀回，實測讀到的仍是原值（整條進位鏈等於沒跑）；
;    本版只用純量區域變數，完全避開該路徑。
; s: 寫入序列化結果的 32 位元組緩衝區
; h: 待序列化的域元素（limb 可為小負數）
; [fe-tobytes](#x25519.fe-tobytes)
fe-tobytes = (s [32]byte, h []i64) {
    {
        h0 ?= h[0]
        h1 ?= h[1]
        h2 ?= h[2]
        h3 ?= h[3]
        h4 ?= h[4]
        h5 ?= h[5]
        h6 ?= h[6]
        h7 ?= h[7]
        h8 ?= h[8]
        h9 ?= h[9]
    }: {
        err -> _

        -> _
    }

    ; ---- 條件約減：算出需減去的 p 的倍數 q ----
    q = num-floor(num-add(19 * h9, 16777216), 25)
    q = num-floor(num-add(h0, q), 26)
    q = num-floor(num-add(h1, q), 25)
    q = num-floor(num-add(h2, q), 26)
    q = num-floor(num-add(h3, q), 25)
    q = num-floor(num-add(h4, q), 26)
    q = num-floor(num-add(h5, q), 25)
    q = num-floor(num-add(h6, q), 26)
    q = num-floor(num-add(h7, q), 25)
    q = num-floor(num-add(h8, q), 26)
    q = num-floor(num-add(h9, q), 25)

    ; ⚠️ `19 * q` 必須先落到具名暫存：把它直接寫成 `num-add(h0, 19 * q)` 會觸發
    ; 已知缺陷 —— 實參含中綴表達式時，同一呼叫的第一個實參（此處 h0）在 MIR 取到
    ; 0，`num-add(0, 19*q)` 讓 wrap-around 靜默丟掉進位（fe-frombytes/fe-tobytes
    ; 往返因此全錯）。見 test/README.md §5.2 未修清單。
    #{overflow=wrap}
    wrap-carry = 19 * q
    #{overflow=wrap}
    h0 = num-add(h0, wrap-carry)

    ; ---- 逐級進位，把每個 limb 規約到 [0, 2^bits) ----
    c = num-floor(h0, 26)
    h0 = num-sub(h0, c << 26)
    h1 = num-add(h1, c)

    c = num-floor(h1, 25)
    h1 = num-sub(h1, c << 25)
    h2 = num-add(h2, c)

    c = num-floor(h2, 26)
    h2 = num-sub(h2, c << 26)
    h3 = num-add(h3, c)

    c = num-floor(h3, 25)
    h3 = num-sub(h3, c << 25)
    h4 = num-add(h4, c)

    c = num-floor(h4, 26)
    h4 = num-sub(h4, c << 26)
    h5 = num-add(h5, c)

    c = num-floor(h5, 25)
    h5 = num-sub(h5, c << 25)
    h6 = num-add(h6, c)

    c = num-floor(h6, 26)
    h6 = num-sub(h6, c << 26)
    h7 = num-add(h7, c)

    c = num-floor(h7, 25)
    h7 = num-sub(h7, c << 25)
    h8 = num-add(h8, c)

    c = num-floor(h8, 26)
    h8 = num-sub(h8, c << 26)
    h9 = num-add(h9, c)

    c = num-floor(h9, 25)
    h9 = num-sub(h9, c << 25)

    ; 到此值已在 [0,p)，最後一級進位 c 必為 0

    ; ---- 打包為 32 位元組（小端序） ----
    ; limb 起始位元：0, 26, 51, 77, 102, 128, 153, 179, 204, 230
    ; ⚠️ `s` 是 [N]byte 形參：整值賦值（`s = packed`）只寫到形參副本，`s[k] ?= v`
    ; 的降糖路徑同樣寫副本，兩者都不回傳呼叫端（未修缺陷，見 test/README.md）。
    ; 只有 place-match 逐格寫回「元素位置」才會落到呼叫端的陣列上。
    s[0]: {
        ok -> it = (h0 >> 0) & 255

        -> _
    }

    s[1]: {
        ok -> it = (h0 >> 8) & 255

        -> _
    }

    s[2]: {
        ok -> it = (h0 >> 16) & 255

        -> _
    }

    s[3]: {
        ok -> it = ((h0 >> 24) | (h1 << 2)) & 255

        -> _
    }

    s[4]: {
        ok -> it = (h1 >> 6) & 255

        -> _
    }

    s[5]: {
        ok -> it = (h1 >> 14) & 255

        -> _
    }

    s[6]: {
        ok -> it = ((h1 >> 22) | (h2 << 3)) & 255

        -> _
    }

    s[7]: {
        ok -> it = (h2 >> 5) & 255

        -> _
    }

    s[8]: {
        ok -> it = (h2 >> 13) & 255

        -> _
    }

    s[9]: {
        ok -> it = ((h2 >> 21) | (h3 << 5)) & 255

        -> _
    }

    s[10]: {
        ok -> it = (h3 >> 3) & 255

        -> _
    }

    s[11]: {
        ok -> it = (h3 >> 11) & 255

        -> _
    }

    s[12]: {
        ok -> it = ((h3 >> 19) | (h4 << 6)) & 255

        -> _
    }

    s[13]: {
        ok -> it = (h4 >> 2) & 255

        -> _
    }

    s[14]: {
        ok -> it = (h4 >> 10) & 255

        -> _
    }

    s[15]: {
        ok -> it = (h4 >> 18) & 255

        -> _
    }

    s[16]: {
        ok -> it = (h5 >> 0) & 255

        -> _
    }

    s[17]: {
        ok -> it = (h5 >> 8) & 255

        -> _
    }

    s[18]: {
        ok -> it = (h5 >> 16) & 255

        -> _
    }

    s[19]: {
        ok -> it = ((h5 >> 24) | (h6 << 1)) & 255

        -> _
    }

    s[20]: {
        ok -> it = (h6 >> 7) & 255

        -> _
    }

    s[21]: {
        ok -> it = (h6 >> 15) & 255

        -> _
    }

    s[22]: {
        ok -> it = ((h6 >> 23) | (h7 << 3)) & 255

        -> _
    }

    s[23]: {
        ok -> it = (h7 >> 5) & 255

        -> _
    }

    s[24]: {
        ok -> it = (h7 >> 13) & 255

        -> _
    }

    s[25]: {
        ok -> it = ((h7 >> 21) | (h8 << 4)) & 255

        -> _
    }

    s[26]: {
        ok -> it = (h8 >> 4) & 255

        -> _
    }

    s[27]: {
        ok -> it = (h8 >> 12) & 255

        -> _
    }

    s[28]: {
        ok -> it = ((h8 >> 20) | (h9 << 6)) & 255

        -> _
    }

    s[29]: {
        ok -> it = (h9 >> 2) & 255

        -> _
    }

    s[30]: {
        ok -> it = (h9 >> 10) & 255

        -> _
    }

    s[31]: {
        ok -> it = (h9 >> 18) & 255

        -> _
    }
}

; Montgomery Ladder（核心純量乘法）
...

; X25519 純量乘法
; scalar [32]byte: 純量（私鑰）
; point [32]byte: 點座標（公鑰）
; 返回 out [32]byte: 點乘結果（共享密鑰），小端序域元素位元組
; [x25519-scalarmult](#x25519.x25519-scalarmult)
x25519-scalarmult = (scalar [32]byte, point [32]byte) (out [32]byte) {

    ; Clamping: 固定純量的某些位元
    ; scalar[0] &= 248, scalar[31] &= 127, scalar[31] |= 64
    k []byte = with-len(32)
    i <- [0..32): {
        {
            scalar-byte ?= scalar[i]

            k[i] ?= scalar-byte
        }: {
            err -> _

            -> _
        }
    }

    {
        first ?= k[0]

        k[0] ?= first & 248
    }: {
        err -> _

        -> _
    }

    {
        last ?= k[31]

        k[31] ?= (last & 127) | 64
    }: {
        err -> _

        -> _
    }

    ; 載入點座標
    u []i64 = with-len(10)
    fe-frombytes(u, point)

    ; 初始化 Montgomery ladder
    x1 []i64 = with-len(10)
    i <- [0..10): {
        {
            u-limb ?= u[i]

            x1[i] ?= u-limb
        }: {
            err -> _

            -> _
        }
    }
    x2 []i64 = with-len(10)
    fe-one(x2)

    z2 []i64 = with-len(10)
    fe-zero(z2)

    x3 []i64 = with-len(10)
    i <- [0..10): {
        {
            u-limb ?= u[i]

            x3[i] ?= u-limb
        }: {
            err -> _

            -> _
        }
    }
    z3 []i64 = with-len(10)
    fe-one(z3)

    ; 預分配 Montgomery ladder 臨時變數（循環外分配一次，循環內重複使用）
    a []i64 = with-len(10)
    aa []i64 = with-len(10)
    b-fe []i64 = with-len(10)
    bb []i64 = with-len(10)
    e []i64 = with-len(10)
    c []i64 = with-len(10)
    d []i64 = with-len(10)
    da []i64 = with-len(10)
    cb []i64 = with-len(10)

    swap = 0

    ; 從最高位元到最低位元迭代（bit 254 到 bit 0）
    t = 254
    (t >= 0) {

        ; 提取純量的第 t 位元
        ; ⚠️ `#{overflow=wrap}` 只改溢出行為、不改結果型別：`t / 8` 仍是 `?i64`，
        ; 直接綁到變數再當下標／移位量，取到的是選項包裝值而非商數。必須顯式解包。
        b i64 = 0
        {
            byte-idx ?= t / 8

            bit-idx ?= t % 8

            scalar-byte ?= k[byte-idx]

            b = (scalar-byte >> bit-idx) & 1
        }: {
            err -> _

            -> _
        }

        ; 條件交換
        swap = swap ^ b
        fe-cswap(x2, x3, swap)
        fe-cswap(z2, z3, swap)
        swap = b

        ; Montgomery ladder step (RFC 7748 §5)
        ; A = X2 + Z2; AA = A^2; B = X2 - Z2; BB = B^2; E = AA - BB
        ; C = X3 + Z3; D = X3 - Z3; DA = D*A; CB = C*B
        ; X3 = (DA+CB)^2; Z3 = X1*(DA-CB)^2
        ; X2 = AA*BB; Z2 = E*(AA + a24*E) where a24 = 121665 (= (A-2)/4, A=486662)
        fe-add(a, x2, z2)
        fe-sq(aa, a)
        fe-sub(b-fe, x2, z2)
        fe-sq(bb, b-fe)
        fe-sub(e, aa, bb)
        fe-add(c, x3, z3)
        fe-sub(d, x3, z3)
        fe-mul(da, d, a)
        fe-mul(cb, c, b-fe)

        ; x3 = (da + cb)^2
        fe-add(x3, da, cb)
        fe-sq(x3, x3)

        ; z3 = x1 * (da - cb)^2
        fe-sub(z3, da, cb)
        fe-sq(z3, z3)
        fe-mul(z3, z3, x1)

        ; x2 = aa * bb
        fe-mul(x2, aa, bb)

        ; z2 = e * (aa + 121665 * e) = e*aa + 121665*e^2  (ref10 / RFC 7748 形式)
        ; 標準 Montgomery 倍點公式: z(2P) = E * (AA + a24 * E)，其中 a24 = (A-2)/4 = 121665
        ;   （A = 486662 為 Curve25519 參數）。4*x*z = E = AA-BB，(x+z)^2 = AA。
        ; 注意：此處必須用 AA（(x2+z2)^2），不是 BB（(x2-z2)^2）；用錯會讓 ladder 倍點崩潰→全零/錯誤。
        ; 使用 'a' 作為臨時變數（下次迭代會被覆寫）
        fe-sq(a, e)
        fe-mul121665(a, a)
        fe-mul(z2, e, aa)
        fe-add(z2, z2, a)

        ; 結束 Montgomery ladder step
        {
            t ?= t - 1
        }: {
            err -> _

            -> _
        }
    }

    ; 最後一次交換
    fe-cswap(x2, x3, swap)
    fe-cswap(z2, z3, swap)

    ; 計算結果: x2 * z2^(-1)
    z-inv []i64 = with-len(10)
    fe-invert(z-inv, z2)

    result []i64 = with-len(10)
    fe-mul(result, x2, z-inv)

    ; 寫入局部陣列再複製到回傳值 out（[32]byte 作為參數為值傳遞，
    ; 直接 fe-tobytes(out, result) 不會寫回回傳槽，故需經局部陣列 + 複製）
    out-arr [32]byte
    fe-tobytes(out-arr, result)
    out = out-arr
}

; 基點乘法
...

; 返回基點 u 座標 (9, 0, 0, ..., 0)
; base: 基點 u=9 的 32 位元組小端編碼
; [x25519-get-basepoint](#x25519.x25519-get-basepoint)
x25519-get-basepoint = () (base [32]byte) {

    ; [32]byte 不自動零初始化，需顯式清零
    i <- [0..32): {
        base[i] = 0
    }

    base[0] = 9
}

; 計算純量 * 基點
; scalar [32]byte: 純量（私鑰）
; 返回 out [32]byte: 公鑰
; [x25519-scalarmult-base](#x25519.x25519-scalarmult-base)
x25519-scalarmult-base = (scalar [32]byte) (out [32]byte) {
    base [32]byte
    base = x25519-get-basepoint()
    out = x25519-scalarmult(scalar, base)
}

; []byte 版本（避開全域 [32]byte 傳參的編譯器 bug）
...

; X25519 純量乘法（[]byte 版本）
; scalar []byte: 純量（私鑰，長度 32）
; point []byte: 點座標（公鑰，長度 32）
; 返回 out []byte: 結果（長度 32）
; [x25519-scalarmult-bytes](#x25519.x25519-scalarmult-bytes)
x25519-scalarmult-bytes = (scalar []byte, point []byte) (out []byte) {

    ; Clamping
    k []byte = with-len(32)
    i <- [0..32): {
        {
            k[i] ?= scalar[i]
        }: {
            err -> _

            -> _
        }
    }

    {
        first ?= k[0]

        k[0] ?= first & 248
    }: {
        err -> _

        -> _
    }

    {
        last ?= k[31]

        k[31] ?= (last & 127) | 64
    }: {
        err -> _

        -> _
    }

    ; 載入點座標 — 複製到 local [32]byte 再呼叫 fe-frombytes
    point-arr [32]byte
    i <- [0..32): {
        {
            point-arr[i] ?= point[i]
        }: {
            err -> _

            -> _
        }
    }
    u []i64 = with-len(10)
    fe-frombytes(u, point-arr)

    ; 初始化 Montgomery ladder
    x1 []i64 = with-len(10)
    i <- [0..10): {
        {
            u-limb ?= u[i]

            x1[i] ?= u-limb
        }: {
            err -> _

            -> _
        }
    }
    x2 []i64 = with-len(10)
    fe-one(x2)

    z2 []i64 = with-len(10)
    fe-zero(z2)

    x3 []i64 = with-len(10)
    i <- [0..10): {
        {
            u-limb ?= u[i]

            x3[i] ?= u-limb
        }: {
            err -> _

            -> _
        }
    }
    z3 []i64 = with-len(10)
    fe-one(z3)

    ; 預分配臨時變數
    a []i64 = with-len(10)
    aa []i64 = with-len(10)
    b-fe []i64 = with-len(10)
    bb []i64 = with-len(10)
    e []i64 = with-len(10)
    c []i64 = with-len(10)
    d []i64 = with-len(10)
    da []i64 = with-len(10)
    cb []i64 = with-len(10)

    swap = 0

    t = 254
    (t >= 0) {

        #{overflow=wrap}
        byte-idx = t / 8
        bit-idx = t % 8

        b i64 = k[byte-idx]: {
            ok -> (it >> bit-idx) & 1

            -> 0
        }

        swap = swap ^ b
        fe-cswap(x2, x3, swap)
        fe-cswap(z2, z3, swap)
        swap = b

        fe-add(a, x2, z2)
        fe-sq(aa, a)
        fe-sub(b-fe, x2, z2)
        fe-sq(bb, b-fe)
        fe-sub(e, aa, bb)
        fe-add(c, x3, z3)
        fe-sub(d, x3, z3)
        fe-mul(da, d, a)
        fe-mul(cb, c, b-fe)

        fe-add(x3, da, cb)
        fe-sq(x3, x3)

        fe-sub(z3, da, cb)
        fe-sq(z3, z3)
        fe-mul(z3, z3, x1)

        fe-mul(x2, aa, bb)

        ; 注意：此處必須用 AA（(x2+z2)^2），不是 BB（(x2-z2)^2）；用錯會讓 ladder 倍點崩潰→全零/錯誤。
        ; 使用 'a' 作為臨時變數（下次迭代會被覆寫）
        fe-sq(a, e)
        fe-mul121665(a, a)
        fe-mul(z2, e, aa)
        fe-add(z2, z2, a)

        {
            #{overflow=wrap}
            t ?= t - 1
        }: {
            err -> _

            -> _
        }
    }
    fe-cswap(x2, x3, swap)
    fe-cswap(z2, z3, swap)

    z-inv []i64 = with-len(10)
    fe-invert(z-inv, z2)

    result []i64 = with-len(10)
    fe-mul(result, x2, z-inv)

    ; 輸出 — 複製到 local [32]byte 再呼叫 fe-tobytes，然後複製到 []byte
    out-arr [32]byte
    fe-tobytes(out-arr, result)
    out = out-arr[..32)
}

; 計算純量 * 基點（[]byte 版本）
; scalar []byte: 純量（私鑰，長度 32）
; 返回 out []byte: 公鑰（長度 32）
; [x25519-scalarmult-base-bytes](#x25519.x25519-scalarmult-base-bytes)
x25519-scalarmult-base-bytes = (scalar []byte) (out []byte) {
    base []byte = with-len(32)
    e1 <- base: {
        e1: {
            ok -> it = 0

            -> _
        }
    }

    base[0]: {
        ok -> it = 9

        -> _
    }
    out = x25519-scalarmult-bytes(scalar, base)
}

; 金鑰對生成
...

; 生成隨機金鑰對
; seed i64: 隨機種子
; 返回 priv [32]byte: 私鑰
; 返回 pub [32]byte: 公鑰
; seed: rand 種子（決定私鑰；真實場景需以系統亂源注入）
; priv: 私鑰（已 clamp：bit0-2 清零、bit254 置 1、bit255 清零）
; pub: 對應公鑰（priv × 基點）
; [x25519-gen-keypair](#x25519.x25519-gen-keypair)
x25519-gen-keypair = (seed i64) (priv [32]byte, pub [32]byte) {

    ; 用 PRNG 生成 32 位元組私鑰
    state = seed
    i <- [0..32): {
        state, r = rand.rand(state)

        priv[i] = state & 255
    }

    ; Clamping
    priv[0] = priv[0] & 248

    priv[31] = priv[31] & 127

    priv[31] = priv[31] | 64

    ; 計算公鑰
    pub = x25519-scalarmult-base(priv)
}

; 「回值形式」域元素操作（供 ed25519 等其他曲線模組使用）
...

;
; 跨模組呼叫時，「就地寫入 slice 參數」不會回傳給呼叫端，只有「回傳值」會。
; 因此其他曲線模組不能直接把配置好的 []i64 傳進來讓 fe-* 填充。
; 下面這些包裝函式在本模組內（fe-* 同模組，就地寫入有效）先算好結果，
; 再以「新配置的 []i64（長度 10）」或 [32]byte 回傳，呼叫端只需依賴回值。
; 回傳零域元素
; h: 新建的零域元素（長度 10）
; [fe-zero-v](#x25519.fe-zero-v)
fe-zero-v = () (h []i64) {
    h = with-len(10)
    fe-zero(h)
}

; 回傳一域元素
; h: 新建的單位元域元素（長度 10）
; [fe-one-v](#x25519.fe-one-v)
fe-one-v = () (h []i64) {
    h = with-len(10)
    fe-one(h)
}

; 回傳 a + b
; a: 左加數
; b: 右加數
; h: 新建的和域元素
; [fe-add-v](#x25519.fe-add-v)
fe-add-v = (a []i64, b []i64) (h []i64) {
    h = with-len(10)
    fe-add(h, a, b)
}

; 回傳 a - b
; a: 被減數
; b: 減數
; h: 新建的差域元素
; [fe-sub-v](#x25519.fe-sub-v)
fe-sub-v = (a []i64, b []i64) (h []i64) {
    h = with-len(10)
    fe-sub(h, a, b)
}

; 回傳 a * b mod p
; a: 因數
; b: 因數
; h: 新建的積域元素（a × b mod p）
; [fe-mul-v](#x25519.fe-mul-v)
fe-mul-v = (a []i64, b []i64) (h []i64) {
    h = with-len(10)
    fe-mul(h, a, b)
}

; 回傳 a^2 mod p
; a: 被平方的域元素
; h: 新建的平方結果
; [fe-sq-v](#x25519.fe-sq-v)
fe-sq-v = (a []i64) (h []i64) {
    h = with-len(10)
    fe-sq(h, a)
}

; 回傳 a^(-1) mod p
; a: 待求逆的域元素
; h: 新建的逆元（a^(p-2)）
; [fe-invert-v](#x25519.fe-invert-v)
fe-invert-v = (a []i64) (h []i64) {
    h = with-len(10)
    fe-invert(h, a)
}

; 從 32 位元組（小端）回傳域元素
; s: 32 位元組小端編碼（bit255 無效）
; h: 新建的域元素
; [fe-frombytes-v](#x25519.fe-frombytes-v)
fe-frombytes-v = (s [32]byte) (h []i64) {
    h = with-len(10)
    fe-frombytes(h, s)
}

; 將域元素序列化為 32 位元組（小端）回傳
; [32]byte 為值傳遞，直接 fe-tobytes(s, h) 不會寫回回傳槽，
; 故先寫入局部陣列再整體賦值給回傳值 s。
; h: 待序列化的域元素
; s: 新建的 32 位元組小端編碼
; [fe-tobytes-v](#x25519.fe-tobytes-v)
fe-tobytes-v = (h []i64) (s [32]byte) {
    t [32]byte
    fe-tobytes(t, h)
    s = t
}
