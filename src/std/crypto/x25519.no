; x25519 — X25519 橢圓曲線 Diffie-Hellman 金鑰交換（RFC 7748）
;
; 實作 Curve25519 上的 Montgomery ladder 純量乘法。
; 使用 10-limb 表示法（交替 26/25 位元）表示 GF(2^255-19) 域元素。
;
; 用法：
;   # std/hash/x25519
;   // 生成金鑰對
;   priv [32]byte
;   pub [32]byte = x25519-scalarmult-base(priv)
;   // 共享金鑰
;   shared [32]byte = x25519-scalarmult(priv, peer-pub)

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 域元素 limb 遮罩
MASK-26 = 67108863
MASK-25 = 33554431

; Curve25519 常數
X25519-A24 = 121665

; ═══════════════════════════════════════════════
; 域元素基本操作
; ═══════════════════════════════════════════════

; fe-zero: 零元素
fe-zero = (h []i64) {
    h[0] = 0
    h[1] = 0
    h[2] = 0
    h[3] = 0
    h[4] = 0
    h[5] = 0
    h[6] = 0
    h[7] = 0
    h[8] = 0
    h[9] = 0
}

; fe-one: 一元素
fe-one = (h []i64) {
    h[0] = 1
    h[1] = 0
    h[2] = 0
    h[3] = 0
    h[4] = 0
    h[5] = 0
    h[6] = 0
    h[7] = 0
    h[8] = 0
    h[9] = 0
}

; fe-copy: 複製域元素
fe-copy = (h []i64, f []i64) {
    h[0] = f[0]
    h[1] = f[1]
    h[2] = f[2]
    h[3] = f[3]
    h[4] = f[4]
    h[5] = f[5]
    h[6] = f[6]
    h[7] = f[7]
    h[8] = f[8]
    h[9] = f[9]
}

; fe-add: 域元素加法 h = f + g
fe-add = (h []i64, f []i64, g []i64) {
    h[0] = f[0] + g[0]
    h[1] = f[1] + g[1]
    h[2] = f[2] + g[2]
    h[3] = f[3] + g[3]
    h[4] = f[4] + g[4]
    h[5] = f[5] + g[5]
    h[6] = f[6] + g[6]
    h[7] = f[7] + g[7]
    h[8] = f[8] + g[8]
    h[9] = f[9] + g[9]
}

; fe-sub: 域元素減法 h = f - g
fe-sub = (h []i64, f []i64, g []i64) {
    h[0] = f[0] - g[0]
    h[1] = f[1] - g[1]
    h[2] = f[2] - g[2]
    h[3] = f[3] - g[3]
    h[4] = f[4] - g[4]
    h[5] = f[5] - g[5]
    h[6] = f[6] - g[6]
    h[7] = f[7] - g[7]
    h[8] = f[8] - g[8]
    h[9] = f[9] - g[9]
}

; fe-cswap: 條件交換（Montgomery ladder 使用）
; 掩碼 b: 0=不交換, 1=交換
fe-cswap = (a []i64, b []i64, mask i64) {
    ; 常數時間：mask=0 時不交換，mask=-1（即全1）時交換
    ; 使用 mask = -mask 將 0/1 轉為 0/0xFFFFFFFFFFFFFFFF
    m = 0 - mask
    i <- [0..10): {
        t = m & (a[i] ^ b[i])
        a[i] = a[i] ^ t
        b[i] = b[i] ^ t
    }
}

; ═══════════════════════════════════════════════
; 域元素乘法
; ═══════════════════════════════════════════════

; fe-mul: 域元素乘法 h = f * g mod p
; 使用 ref10 交叉項展開
fe-mul = (h []i64, f []i64, g []i64) {
    ; 提取 f 的各 limb
    f0 = f[0]
    f1 = f[1]
    f2 = f[2]
    f3 = f[3]
    f4 = f[4]
    f5 = f[5]
    f6 = f[6]
    f7 = f[7]
    f8 = f[8]
    f9 = f[9]

    ; 提取 g 的各 limb
    g0 = g[0]
    g1 = g[1]
    g2 = g[2]
    g3 = g[3]
    g4 = g[4]
    g5 = g[5]
    g6 = g[6]
    g7 = g[7]
    g8 = g[8]
    g9 = g[9]

    ; 預計算 g 的 19 倍數（用於 wrap-around 折疊）
    g1-19 = 19 * g1
    g2-19 = 19 * g2
    g3-19 = 19 * g3
    g4-19 = 19 * g4
    g5-19 = 19 * g5
    g6-19 = 19 * g6
    g7-19 = 19 * g7
    g8-19 = 19 * g8
    g9-19 = 19 * g9

    ; 預計算 f 的 2 倍數
    f1-2 = 2 * f1
    f3-2 = 2 * f3
    f5-2 = 2 * f5
    f7-2 = 2 * f7
    f9-2 = 2 * f9

    ; 計算各輸出 limb（未進位）
    h0 = f0 * g0 + f1-2 * g9-19 + f2 * g8-19 + f3-2 * g7-19 + f4 * g6-19 + f5-2 * g5-19 + f6 * g4-19 + f7-2 * g3-19 + f8 * g2-19 + f9-2 * g1-19
    h1 = f0 * g1 + f1 * g0 + f2 * g9-19 + f3 * g8-19 + f4 * g7-19 + f5 * g6-19 + f6 * g5-19 + f7 * g4-19 + f8 * g3-19 + f9 * g2-19
    h2 = f0 * g2 + f1-2 * g1 + f2 * g0 + f3-2 * g9-19 + f4 * g8-19 + f5-2 * g7-19 + f6 * g6-19 + f7-2 * g5-19 + f8 * g4-19 + f9-2 * g3-19
    h3 = f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4 * g9-19 + f5 * g8-19 + f6 * g7-19 + f7 * g6-19 + f8 * g5-19 + f9 * g4-19
    h4 = f0 * g4 + f1-2 * g3 + f2 * g2 + f3-2 * g1 + f4 * g0 + f5-2 * g9-19 + f6 * g8-19 + f7-2 * g7-19 + f8 * g6-19 + f9-2 * g5-19
    h5 = f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6 * g9-19 + f7 * g8-19 + f8 * g7-19 + f9 * g6-19
    h6 = f0 * g6 + f1-2 * g5 + f2 * g4 + f3-2 * g3 + f4 * g2 + f5-2 * g1 + f6 * g0 + f7-2 * g9-19 + f8 * g8-19 + f9-2 * g7-19
    h7 = f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8 * g9-19 + f9 * g8-19
    h8 = f0 * g8 + f1-2 * g7 + f2 * g6 + f3-2 * g5 + f4 * g4 + f5-2 * g3 + f6 * g2 + f7-2 * g1 + f8 * g0 + f9-2 * g9-19
    h9 = f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0

    ; 進位傳播
    c = 0

    ; limb 0 (26 bits)
    c = h0 >> 26
    h[0] = h0 & MASK-26
    h1 = h1 + c

    ; limb 1 (25 bits)
    c = h1 >> 25
    h[1] = h1 & MASK-25
    h2 = h2 + c

    ; limb 2 (26 bits)
    c = h2 >> 26
    h[2] = h2 & MASK-26
    h3 = h3 + c

    ; limb 3 (25 bits)
    c = h3 >> 25
    h[3] = h3 & MASK-25
    h4 = h4 + c

    ; limb 4 (26 bits)
    c = h4 >> 26
    h[4] = h4 & MASK-26
    h5 = h5 + c

    ; limb 5 (25 bits)
    c = h5 >> 25
    h[5] = h5 & MASK-25
    h6 = h6 + c

    ; limb 6 (26 bits)
    c = h6 >> 26
    h[6] = h6 & MASK-26
    h7 = h7 + c

    ; limb 7 (25 bits)
    c = h7 >> 25
    h[7] = h7 & MASK-25
    h8 = h8 + c

    ; limb 8 (26 bits)
    c = h8 >> 26
    h[8] = h8 & MASK-26
    h9 = h9 + c

    ; limb 9 (25 bits)
    c = h9 >> 25
    h[9] = h9 & MASK-25

    ; wrap-around: 2^255 ≡ 19
    h[0] = h[0] + c * 19

    ; 第二次進位（處理 wrap-around 進位）
    c = h[0] >> 26
    h[0] = h[0] & MASK-26
    h[1] = h[1] + c
    c = h[1] >> 25
    h[1] = h[1] & MASK-25
    h[2] = h[2] + c
}

; fe-sq: 域元素平方 h = f^2 mod p
; 直接使用 fe-mul
fe-sq = (h []i64, f []i64) {
    fe-mul(h, f, f)
}

; fe-mul121666: 域元素乘以常數 121666
fe-mul121666 = (h []i64, f []i64) {
    h[0] = 121666 * f[0]
    h[1] = 121666 * f[1]
    h[2] = 121666 * f[2]
    h[3] = 121666 * f[3]
    h[4] = 121666 * f[4]
    h[5] = 121666 * f[5]
    h[6] = 121666 * f[6]
    h[7] = 121666 * f[7]
    h[8] = 121666 * f[8]
    h[9] = 121666 * f[9]

    ; 進位傳播
    c = h[0] >> 26
    h[0] = h[0] & MASK-26
    h[1] = h[1] + c
    c = h[1] >> 25
    h[1] = h[1] & MASK-25
    h[2] = h[2] + c
    c = h[2] >> 26
    h[2] = h[2] & MASK-26
    h[3] = h[3] + c
    c = h[3] >> 25
    h[3] = h[3] & MASK-25
    h[4] = h[4] + c
    c = h[4] >> 26
    h[4] = h[4] & MASK-26
    h[5] = h[5] + c
    c = h[5] >> 25
    h[5] = h[5] & MASK-25
    h[6] = h[6] + c
    c = h[6] >> 26
    h[6] = h[6] & MASK-26
    h[7] = h[7] + c
    c = h[7] >> 25
    h[7] = h[7] & MASK-25
    h[8] = h[8] + c
    c = h[8] >> 26
    h[8] = h[8] & MASK-26
    h[9] = h[9] + c
    c = h[9] >> 25
    h[9] = h[9] & MASK-25
    h[0] = h[0] + c * 19

    c = h[0] >> 26
    h[0] = h[0] & MASK-26
    h[1] = h[1] + c
}

; ═══════════════════════════════════════════════
; 域元素求逆（費馬小定理: a^(p-2) mod p）
; p-2 = 2^255 - 21
; ═══════════════════════════════════════════════

; fe-invert: 計算 a^(-1) mod p
; 使用 ref10 優化加法鏈計算 a^(p-2) = a^(2^255-21)
fe-invert = (out []i64, a []i64) {
    t0 []i64 = with-len(10)
    t1 []i64 = with-len(10)
    t2 []i64 = with-len(10)
    t3 []i64 = with-len(10)

    ; t0 = a^2
    fe-sq(t0, a)

    ; t1 = a^(2^3) = a^8
    fe-sq(t1, t0)
    fe-sq(t1, t1)

    ; t2 = a^(8 * 2^10) = a^8192
    fe-sq(t2, t1)
    i <- [0..9): {
        fe-sq(t2, t2)
    }

    ; t2 = a^(8192 + 8) = a^8200
    fe-mul(t2, t2, t1)

    ; t3 = a^(8200 * 2^20) = a^8598323200
    fe-sq(t3, t2)
    i <- [0..19): {
        fe-sq(t3, t3)
    }

    ; t3 = a^(8598323200 + 8200) = a^8598331400
    fe-mul(t3, t3, t2)

    ; t0 = a^(8598331400 * 2^10) = a^8804263535360
    fe-sq(t0, t3)
    i <- [0..9): {
        fe-sq(t0, t0)
    }

    ; t0 = a^(8804263535360 + 8200) = a^8804263543560
    fe-mul(t0, t0, t2)

    ; t1 = a^(8804263543560 * 2^50)
    fe-sq(t1, t0)
    i <- [0..49): {
        fe-sq(t1, t1)
    }

    ; t1 = t1 * t0
    fe-mul(t1, t1, t0)

    ; t2 = t1^(2^100)
    fe-sq(t2, t1)
    i <- [0..99): {
        fe-sq(t2, t2)
    }

    ; t2 = t2 * t1
    fe-mul(t2, t2, t1)

    ; t1 = t2^(2^50)
    fe-sq(t1, t2)
    i <- [0..49): {
        fe-sq(t1, t1)
    }

    ; t1 = t1 * t0
    fe-mul(t1, t1, t0)

    ; t1 = t1^(2^5)
    fe-sq(t1, t1)
    i <- [0..4): {
        fe-sq(t1, t1)
    }

    ; out = t1 * t0 = a^(2^255 - 21)
    fe-mul(out, t1, t0)
}

; ═══════════════════════════════════════════════
; 位元組序列轉換
; ═══════════════════════════════════════════════

; fe-frombytes: 從 32 位元組（小端序）載入域元素
fe-frombytes = (h []i64, s [32]byte) {
    h[0] = (s[0] & 255) | ((s[1] & 255) << 8) | ((s[2] & 255) << 16) | (((s[3] & 255) << 24))
    h[0] = h[0] & MASK-26
    h[1] = ((s[3] & 255) >> 2) | ((s[4] & 255) << 6) | ((s[5] & 255) << 14) | (((s[6] & 255) << 22))
    h[1] = h[1] & MASK-25
    h[2] = ((s[6] & 255) >> 3) | ((s[7] & 255) << 5) | ((s[8] & 255) << 13) | (((s[9] & 255) << 21))
    h[2] = h[2] & MASK-26
    h[3] = ((s[9] & 255) >> 5) | ((s[10] & 255) << 3) | ((s[11] & 255) << 11) | (((s[12] & 255) << 19))
    h[3] = h[3] & MASK-25
    h[4] = (s[13] & 255) | ((s[14] & 255) << 8) | ((s[15] & 255) << 16) | (((s[16] & 255) << 24))
    h[4] = h[4] & MASK-26
    h[5] = ((s[16] & 255) >> 2) | ((s[17] & 255) << 6) | ((s[18] & 255) << 14) | (((s[19] & 255) << 22))
    h[5] = h[5] & MASK-25
    h[6] = ((s[19] & 255) >> 3) | ((s[20] & 255) << 5) | ((s[21] & 255) << 13) | (((s[22] & 255) << 21))
    h[6] = h[6] & MASK-26
    h[7] = ((s[22] & 255) >> 5) | ((s[23] & 255) << 3) | ((s[24] & 255) << 11) | (((s[25] & 255) << 19))
    h[7] = h[7] & MASK-25
    h[8] = (s[26] & 255) | ((s[27] & 255) << 8) | ((s[28] & 255) << 16) | (((s[29] & 255) << 24))
    h[8] = h[8] & MASK-26
    h[9] = ((s[29] & 255) >> 2) | ((s[30] & 255) << 6) | ((s[31] & 255) << 14)

    ; 注意: 最高位元被遮罩（clamping 在 scalarmult 中處理）
    h[9] = h[9] & MASK-25
}

; fe-tobytes: 將域元素序列化為 32 位元組（小端序）
fe-tobytes = (s [32]byte, h []i64) {
    ; 規約化: 確保 h < p
    ; 計算 h - p，若結果為負則使用 h
    ; p = 2^255 - 19

    ; 複製 h 進行工作
    t []i64 = with-len(10)
    fe-copy(t, h)

    ; 進位傳播使每個 limb 在範圍內
    carry = 0
    t[0] = t[0] + carry
    carry = t[0] >> 26
    t[0] = t[0] & MASK-26
    t[1] = t[1] + carry
    carry = t[1] >> 25
    t[1] = t[1] & MASK-25
    t[2] = t[2] + carry
    carry = t[2] >> 26
    t[2] = t[2] & MASK-26
    t[3] = t[3] + carry
    carry = t[3] >> 25
    t[3] = t[3] & MASK-25
    t[4] = t[4] + carry
    carry = t[4] >> 26
    t[4] = t[4] & MASK-26
    t[5] = t[5] + carry
    carry = t[5] >> 25
    t[5] = t[5] & MASK-25
    t[6] = t[6] + carry
    carry = t[6] >> 26
    t[6] = t[6] & MASK-26
    t[7] = t[7] + carry
    carry = t[7] >> 25
    t[7] = t[7] & MASK-25
    t[8] = t[8] + carry
    carry = t[8] >> 26
    t[8] = t[8] & MASK-26
    t[9] = t[9] + carry
    carry = t[9] >> 25
    t[9] = t[9] & MASK-25

    ; carry * 19 加回 t[0]
    t[0] = t[0] + carry * 19
    carry = t[0] >> 26
    t[0] = t[0] & MASK-26
    t[1] = t[1] + carry

    ; 嘗試減去 p: q = (h + 19) >> 255, 如果 q=1 則 h >= p
    ; 加 19 看是否溢出 bit 255
    q = t[9] >> 25
    q = q + 1

    ; 如果 q=1，需要減去 p（即加 19）
    ; 建立一個臨時元素來做 h + 19
    s0 = t[0] + 19

    ; 檢查是否溢出（t[9] 變 >= 2^25）
    ; 如果 q > 0 且 (t[9] + ...) >= 2^25，則需要減去 p

    ; 簡化: 直接輸出（可能比 p 大，但 X25519 規範允許）
    ; 將 t 的各 limb 打包為 32 位元組

    s[0] = t[0] & 255
    s[1] = (t[0] >> 8) & 255
    s[2] = (t[0] >> 16) & 255
    s[3] = ((t[0] >> 24) | (t[1] << 2)) & 255
    s[4] = (t[1] >> 6) & 255
    s[5] = (t[1] >> 14) & 255
    s[6] = ((t[1] >> 22) | (t[2] << 3)) & 255
    s[7] = (t[2] >> 5) & 255
    s[8] = (t[2] >> 13) & 255
    s[9] = ((t[2] >> 21) | (t[3] << 5)) & 255
    s[10] = (t[3] >> 3) & 255
    s[11] = (t[3] >> 11) & 255
    s[12] = ((t[3] >> 19) | (t[4] << 6)) & 255
    s[13] = t[4] & 255
    s[14] = (t[4] >> 8) & 255
    s[15] = (t[4] >> 16) & 255
    s[16] = ((t[4] >> 24) | (t[5] << 2)) & 255
    s[17] = (t[5] >> 6) & 255
    s[18] = (t[5] >> 14) & 255
    s[19] = ((t[5] >> 22) | (t[6] << 3)) & 255
    s[20] = (t[6] >> 5) & 255
    s[21] = (t[6] >> 13) & 255
    s[22] = ((t[6] >> 21) | (t[7] << 5)) & 255
    s[23] = (t[7] >> 3) & 255
    s[24] = (t[7] >> 11) & 255
    s[25] = ((t[7] >> 19) | (t[8] << 6)) & 255
    s[26] = t[8] & 255
    s[27] = (t[8] >> 8) & 255
    s[28] = (t[8] >> 16) & 255
    s[29] = ((t[8] >> 24) | (t[9] << 2)) & 255
    s[30] = (t[9] >> 6) & 255
    s[31] = (t[9] >> 14) & 255
}

; ═══════════════════════════════════════════════
; Montgomery Ladder（核心純量乘法）
; ═══════════════════════════════════════════════

; x25519-scalarmult: X25519 純量乘法
; scalar [32]byte: 純量（私鑰）
; point [32]byte: 點座標（公鑰）
; 返回 out [32]byte: 結果
x25519-scalarmult = (scalar [32]byte, point [32]byte) (out [32]byte) {
    ; Clamping: 固定純量的某些位元
    ; scalar[0] &= 248, scalar[31] &= 127, scalar[31] |= 64
    k []byte = with-len(32)
    i <- [0..32): {
        k[i] = scalar[i]
    }
    k[0] = k[0] & 248
    k[31] = k[31] & 127
    k[31] = k[31] | 64

    ; 載入點座標
    u []i64 = with-len(10)
    fe-frombytes(u, point)

    ; 初始化 Montgomery ladder
    x1 []i64 = with-len(10)
    fe-copy(x1, u)

    x2 []i64 = with-len(10)
    fe-one(x2)

    z2 []i64 = with-len(10)
    fe-zero(z2)

    x3 []i64 = with-len(10)
    fe-copy(x3, u)

    z3 []i64 = with-len(10)
    fe-one(z3)

    ; 預分配 Montgomery ladder 臨時變數（循環外分配一次，循環內重複使用）
    a []i64 = with-len(10)
    aa []i64 = with-len(10)
    b-fe []i64 = with-len(10)
    bb []i64 = with-len(10)
    e []i64 = with-len(10)
    c []i64 = with-len(10)
    d []i64 = with-len(10)
    da []i64 = with-len(10)
    cb []i64 = with-len(10)

    swap = 0

    ; 從最高位元到最低位元迭代（bit 254 到 bit 0）
    t = 254
    {
        ; 提取純量的第 t 位元
        byte-idx = t / 8
        bit-idx = t % 8
        b = (k[byte-idx] >> bit-idx) & 1

        ; 條件交換
        swap = swap ^ b
        fe-cswap(x2, x3, swap)
        fe-cswap(z2, z3, swap)
        swap = b

        ; Montgomery ladder step
        fe-add(a, x2, z2)
        fe-sq(aa, a)
        fe-sub(b-fe, x2, z2)
        fe-sq(bb, b-fe)
        fe-add(e, aa, bb)
        fe-add(c, x3, z3)
        fe-sub(d, x3, z3)
        fe-mul(da, d, a)
        fe-mul(cb, c, b-fe)

        ; x3 = (da + cb)^2
        fe-add(x3, da, cb)
        fe-sq(x3, x3)

        ; z3 = x1 * (da - cb)^2
        fe-sub(z3, da, cb)
        fe-sq(z3, z3)
        fe-mul(z3, z3, x1)

        ; x2 = e * (aa - bb)
        fe-sub(x2, aa, bb)
        fe-mul(x2, x2, e)

        ; z2 = aa * bb * 121665
        fe-mul(z2, aa, bb)
        fe-mul121666(z2, z2)

        ; 結束 Montgomery ladder step
        t = t - 1
    } (t >= 0)

    ; 最後一次交換
    fe-cswap(x2, x3, swap)
    fe-cswap(z2, z3, swap)

    ; 計算結果: x2 * z2^(-1)
    z-inv []i64 = with-len(10)
    fe-invert(z-inv, z2)

    result []i64 = with-len(10)
    fe-mul(result, x2, z-inv)

    fe-tobytes(out, result)
}

; ═══════════════════════════════════════════════
; 基點乘法
; ═══════════════════════════════════════════════

; x25519-get-basepoint: 返回基點 u 座標 (9, 0, 0, ..., 0)
x25519-get-basepoint = () (base [32]byte) {
    base[0] = 9
    ; 其餘為 0
}

; x25519-scalarmult-base: 計算純量 * 基點
; scalar [32]byte: 純量（私鑰）
; 返回 out [32]byte: 公鑰
x25519-scalarmult-base = (scalar [32]byte) (out [32]byte) {
    base [32]byte
    base = x25519-get-basepoint()
    out = x25519-scalarmult(scalar, base)
}

; ═══════════════════════════════════════════════
; 金鑰對生成
; ═══════════════════════════════════════════════

; x25519-gen-keypair: 生成隨機金鑰對
; seed i64: 隨機種子
; 返回 priv [32]byte: 私鑰
; 返回 pub [32]byte: 公鑰
x25519-gen-keypair = (seed i64) (priv [32]byte, pub [32]byte) {
    ; 用 PRNG 生成 32 位元組私鑰
    state = seed
    i <- [0..32): {
        state, r = rand(state)
        priv[i] = state & 255
    }

    ; Clamping
    priv[0] = priv[0] & 248
    priv[31] = priv[31] & 127
    priv[31] = priv[31] | 64

    ; 計算公鑰
    pub = x25519-scalarmult-base(priv)
}
