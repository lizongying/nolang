; x25519 — X25519 橢圓曲線 Diffie-Hellman 金鑰交換（RFC 7748）
;
; 實作 Curve25519 上的 Montgomery ladder 純量乘法。
; 使用 10-limb 表示法（交替 26/25 位元）表示 GF(2^255-19) 域元素。
;
; 用法：
;   # std/hash/x25519
;   // 生成金鑰對
;   priv [32]byte
;   pub [32]byte = x25519-scalarmult-base(priv)
;   // 共享金鑰
;   shared [32]byte = x25519-scalarmult(priv, peer-pub)

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 域元素 limb 遮罩
MASK-26 = 67108863
MASK-25 = 33554431

; Curve25519 常數
X25519-A24 = 121665

; ═══════════════════════════════════════════════
; 域元素基本操作
; ═══════════════════════════════════════════════

; fe-zero: 零元素
fe-zero = (h []i64) {
    h[0] = 0
    h[1] = 0
    h[2] = 0
    h[3] = 0
    h[4] = 0
    h[5] = 0
    h[6] = 0
    h[7] = 0
    h[8] = 0
    h[9] = 0
}

; fe-one: 一元素
fe-one = (h []i64) {
    h[0] = 1
    h[1] = 0
    h[2] = 0
    h[3] = 0
    h[4] = 0
    h[5] = 0
    h[6] = 0
    h[7] = 0
    h[8] = 0
    h[9] = 0
}

; fe-copy: 複製域元素
fe-copy = (h []i64, f []i64) {
    h[0] = f[0]
    h[1] = f[1]
    h[2] = f[2]
    h[3] = f[3]
    h[4] = f[4]
    h[5] = f[5]
    h[6] = f[6]
    h[7] = f[7]
    h[8] = f[8]
    h[9] = f[9]
}

; fe-add: 域元素加法 h = f + g
fe-add = (h []i64, f []i64, g []i64) {
    h[0] = f[0] + g[0]
    h[1] = f[1] + g[1]
    h[2] = f[2] + g[2]
    h[3] = f[3] + g[3]
    h[4] = f[4] + g[4]
    h[5] = f[5] + g[5]
    h[6] = f[6] + g[6]
    h[7] = f[7] + g[7]
    h[8] = f[8] + g[8]
    h[9] = f[9] + g[9]
}

; fe-sub: 域元素減法 h = f - g
fe-sub = (h []i64, f []i64, g []i64) {
    h[0] = f[0] - g[0]
    h[1] = f[1] - g[1]
    h[2] = f[2] - g[2]
    h[3] = f[3] - g[3]
    h[4] = f[4] - g[4]
    h[5] = f[5] - g[5]
    h[6] = f[6] - g[6]
    h[7] = f[7] - g[7]
    h[8] = f[8] - g[8]
    h[9] = f[9] - g[9]
}

; fe-cswap: 條件交換（Montgomery ladder 使用）
; 掩碼 b: 0=不交換, 1=交換
fe-cswap = (a []i64, b []i64, mask i64) {
    ; 常數時間：mask=0 時不交換，mask=-1（即全1）時交換
    ; 使用 mask = -mask 將 0/1 轉為 0/0xFFFFFFFFFFFFFFFF
    m = 0 - mask
    i <- [0..10): {
        t = m & (a[i] ^ b[i])
        a[i] = a[i] ^ t
        b[i] = b[i] ^ t
    }
}

; ═══════════════════════════════════════════════
; 域元素乘法
; ═══════════════════════════════════════════════

; fe-mul: 域元素乘法 h = f * g mod p
; 使用 ref10 交叉項展開
fe-mul = (h []i64, f []i64, g []i64) {
    ; 提取 f 的各 limb
    f0 = f[0]
    f1 = f[1]
    f2 = f[2]
    f3 = f[3]
    f4 = f[4]
    f5 = f[5]
    f6 = f[6]
    f7 = f[7]
    f8 = f[8]
    f9 = f[9]

    ; 提取 g 的各 limb
    g0 = g[0]
    g1 = g[1]
    g2 = g[2]
    g3 = g[3]
    g4 = g[4]
    g5 = g[5]
    g6 = g[6]
    g7 = g[7]
    g8 = g[8]
    g9 = g[9]

    ; 預計算 g 的 19 倍數（用於 wrap-around 折疊）
    g1-19 = 19 * g1
    g2-19 = 19 * g2
    g3-19 = 19 * g3
    g4-19 = 19 * g4
    g5-19 = 19 * g5
    g6-19 = 19 * g6
    g7-19 = 19 * g7
    g8-19 = 19 * g8
    g9-19 = 19 * g9

    ; 預計算 f 的 2 倍數
    ; 偶數 h 索引（h0,h2,h4,h6,h8）需要奇數 f 索引的 2 倍
    ; 奇數 h 索引（h1,h3,h5,h7）需要偶數 f 索引（>=2）的 2 倍
    f1-2 = 2 * f1
    f2-2 = 2 * f2
    f3-2 = 2 * f3
    f4-2 = 2 * f4
    f5-2 = 2 * f5
    f6-2 = 2 * f6
    f7-2 = 2 * f7
    f8-2 = 2 * f8
    f9-2 = 2 * f9

    ; 計算各輸出 limb（未進位）— ref10 交叉項展開
    h0 = f0 * g0 + f1-2 * g9-19 + f2 * g8-19 + f3-2 * g7-19 + f4 * g6-19 + f5-2 * g5-19 + f6 * g4-19 + f7-2 * g3-19 + f8 * g2-19 + f9-2 * g1-19
    h1 = f0 * g1 + f1 * g0 + f2-2 * g9-19 + f3 * g8-19 + f4-2 * g7-19 + f5 * g6-19 + f6-2 * g5-19 + f7 * g4-19 + f8-2 * g3-19 + f9 * g2-19
    h2 = f0 * g2 + f1-2 * g1 + f2 * g0 + f3-2 * g9-19 + f4 * g8-19 + f5-2 * g7-19 + f6 * g6-19 + f7-2 * g5-19 + f8 * g4-19 + f9-2 * g3-19
    h3 = f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4-2 * g9-19 + f5 * g8-19 + f6-2 * g7-19 + f7 * g6-19 + f8-2 * g5-19 + f9 * g4-19
    h4 = f0 * g4 + f1-2 * g3 + f2 * g2 + f3-2 * g1 + f4 * g0 + f5-2 * g9-19 + f6 * g8-19 + f7-2 * g7-19 + f8 * g6-19 + f9-2 * g5-19
    h5 = f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6-2 * g9-19 + f7 * g8-19 + f8-2 * g7-19 + f9 * g6-19
    h6 = f0 * g6 + f1-2 * g5 + f2 * g4 + f3-2 * g3 + f4 * g2 + f5-2 * g1 + f6 * g0 + f7-2 * g9-19 + f8 * g8-19 + f9-2 * g7-19
    h7 = f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8-2 * g9-19 + f9 * g8-19
    h8 = f0 * g8 + f1-2 * g7 + f2 * g6 + f3-2 * g5 + f4 * g4 + f5-2 * g3 + f6 * g2 + f7-2 * g1 + f8 * g0 + f9-2 * g9-19
    h9 = f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0

    ; 進位傳播 (ref10 風格：使用捨入常數 + floor division)
    ; Nolang 的 >> 對 i64 是邏輯右移（零填充），非算術右移（符號擴展）
    ; floor(x / 2^b) = (x >> b) - ((x >> 63) << (64 - b))
    ; 26-bit limbs: carry = floor((h + (1<<25)) / 2^26)
    ; 25-bit limbs: carry = floor((h + (1<<24)) / 2^25)

    ; limb 0 (26 bits)
    s = h0 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    h0 = h0 - (c << 26)
    h1 = h1 + c

    ; limb 1 (25 bits)
    s = h1 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    h1 = h1 - (c << 25)
    h2 = h2 + c

    ; limb 2 (26 bits)
    s = h2 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    h2 = h2 - (c << 26)
    h3 = h3 + c

    ; limb 3 (25 bits)
    s = h3 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    h3 = h3 - (c << 25)
    h4 = h4 + c

    ; limb 4 (26 bits)
    s = h4 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    h4 = h4 - (c << 26)
    h5 = h5 + c

    ; limb 5 (25 bits)
    s = h5 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    h5 = h5 - (c << 25)
    h6 = h6 + c

    ; limb 6 (26 bits)
    s = h6 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    h6 = h6 - (c << 26)
    h7 = h7 + c

    ; limb 7 (25 bits)
    s = h7 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    h7 = h7 - (c << 25)
    h8 = h8 + c

    ; limb 8 (26 bits)
    s = h8 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    h8 = h8 - (c << 26)
    h9 = h9 + c

    ; limb 9 (25 bits)
    s = h9 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    h9 = h9 - (c << 25)

    ; wrap-around: 2^255 ≡ 19
    h0 = h0 + c * 19

    ; 第二次進位（處理 wrap-around 進位）
    s = h0 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    h0 = h0 - (c << 26)
    h1 = h1 + c
    s = h1 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    h1 = h1 - (c << 25)
    h2 = h2 + c

    ; 寫回結果
    h[0] = h0
    h[1] = h1
    h[2] = h2
    h[3] = h3
    h[4] = h4
    h[5] = h5
    h[6] = h6
    h[7] = h7
    h[8] = h8
    h[9] = h9
}

; fe-sq: 域元素平方 h = f^2 mod p
; 直接使用 fe-mul
fe-sq = (h []i64, f []i64) {
    fe-mul(h, f, f)
}

; fe-mul121666: 域元素乘以常數 121666
fe-mul121666 = (h []i64, f []i64) {
    ; 使用局部變數計算，最後一次寫回
    r0 = 121666 * f[0]
    r1 = 121666 * f[1]
    r2 = 121666 * f[2]
    r3 = 121666 * f[3]
    r4 = 121666 * f[4]
    r5 = 121666 * f[5]
    r6 = 121666 * f[6]
    r7 = 121666 * f[7]
    r8 = 121666 * f[8]
    r9 = 121666 * f[9]

    ; 進位傳播 (ref10 風格 + floor division，正確處理負數)
    s = r0 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    r0 = r0 - (c << 26)
    r1 = r1 + c
    s = r1 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    r1 = r1 - (c << 25)
    r2 = r2 + c
    s = r2 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    r2 = r2 - (c << 26)
    r3 = r3 + c
    s = r3 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    r3 = r3 - (c << 25)
    r4 = r4 + c
    s = r4 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    r4 = r4 - (c << 26)
    r5 = r5 + c
    s = r5 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    r5 = r5 - (c << 25)
    r6 = r6 + c
    s = r6 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    r6 = r6 - (c << 26)
    r7 = r7 + c
    s = r7 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    r7 = r7 - (c << 25)
    r8 = r8 + c
    s = r8 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    r8 = r8 - (c << 26)
    r9 = r9 + c
    s = r9 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    r9 = r9 - (c << 25)
    r0 = r0 + c * 19

    s = r0 + 33554432
    c = (s >> 26) - ((s >> 63) << 38)
    r0 = r0 - (c << 26)
    r1 = r1 + c
    s = r1 + 16777216
    c = (s >> 25) - ((s >> 63) << 39)
    r1 = r1 - (c << 25)
    r2 = r2 + c

    h[0] = r0
    h[1] = r1
    h[2] = r2
    h[3] = r3
    h[4] = r4
    h[5] = r5
    h[6] = r6
    h[7] = r7
    h[8] = r8
    h[9] = r9
}

; ═══════════════════════════════════════════════
; 域元素求逆（費馬小定理: a^(p-2) mod p）
; p-2 = 2^255 - 21
; ═══════════════════════════════════════════════

; fe-invert: 計算 a^(-1) mod p
; 使用 ref10 加法鏈計算 a^(p-2) = a^(2^255-21)
; 完整對齊 libsodium fe25519_invert 的加法鏈
fe-invert = (out []i64, a []i64) {
    t0 []i64 = with-len(10)
    t1 []i64 = with-len(10)
    t2 []i64 = with-len(10)
    t3 []i64 = with-len(10)

    ; t0 = a^2
    fe-sq(t0, a)

    ; t1 = a^4
    fe-sq(t1, t0)

    ; t1 = a^8
    fe-sq(t1, t1)

    ; t1 = a * a^8 = a^9
    fe-mul(t1, a, t1)

    ; t0 = a^2 * a^9 = a^11
    fe-mul(t0, t0, t1)

    ; t2 = (a^11)^2 = a^22
    fe-sq(t2, t0)

    ; t1 = a^9 * a^22 = a^31 = a^(2^5 - 1)
    fe-mul(t1, t1, t2)

    ; t2 = (a^31)^(2^5) = a^992  (1 + 4 = 5 squarings)
    fe-sq(t2, t1)
    i <- [0..4): {
        fe-sq(t2, t2)
    }

    ; t1 = a^992 * a^31 = a^1023 = a^(2^10 - 1)
    fe-mul(t1, t2, t1)

    ; t2 = (a^1023)^(2^10) = a^(1023 * 1024)  (1 + 9 = 10 squarings)
    fe-sq(t2, t1)
    i <- [0..9): {
        fe-sq(t2, t2)
    }

    ; t2 = a^(1023*1024) * a^1023 = a^(1023*1025) = a^(2^20 - 1)
    fe-mul(t2, t2, t1)

    ; t3 = (a^(2^20-1))^(2^20) = a^((2^20-1) * 2^20)  (1 + 19 = 20 squarings)
    fe-sq(t3, t2)
    i <- [0..19): {
        fe-sq(t3, t3)
    }

    ; t2 = a^((2^20-1)*2^20) * a^(2^20-1) = a^(2^40 - 1)
    fe-mul(t2, t3, t2)

    ; t2 = (a^(2^40-1))^(2^10)  (NO initial sq, 10 squarings)
    ; ref10: for(i=1;i<11) = 10 iterations, NO fe_sq before loop
    i <- [0..10): {
        fe-sq(t2, t2)
    }

    ; t1 = a^((2^40-1)*2^10) * a^(2^10-1) = a^(2^50-1)
    fe-mul(t1, t2, t1)

    ; t2 = t1^(2^50)  (1 + 49 = 50 squarings)
    fe-sq(t2, t1)
    i <- [0..49): {
        fe-sq(t2, t2)
    }

    ; t2 = t2 * t1
    fe-mul(t2, t2, t1)

    ; t3 = t2^(2^100)  (1 + 99 = 100 squarings)
    fe-sq(t3, t2)
    i <- [0..99): {
        fe-sq(t3, t3)
    }

    ; t2 = t3 * t2
    fe-mul(t2, t3, t2)

    ; t2 = t2^(2^50)  (NO initial sq, 50 squarings)
    ; ref10: for(i=1;i<51) = 50 iterations, NO fe_sq before loop
    i <- [0..50): {
        fe-sq(t2, t2)
    }

    ; t1 = t2 * t1 = a^(2^250-1)
    fe-mul(t1, t2, t1)

    ; t1 = t1^(2^5)  (NO initial sq, 5 squarings)
    ; ref10: for(i=1;i<6) = 5 iterations, NO fe_sq before loop
    i <- [0..5): {
        fe-sq(t1, t1)
    }

    ; out = t1 * t0 = a^(2^255 - 21)
    fe-mul(out, t1, t0)
}

; ═══════════════════════════════════════════════
; 位元組序列轉換
; ═══════════════════════════════════════════════

; fe-frombytes: 從 32 位元組（小端序）載入域元素
; 使用 ref10 風格：先以位移載入未遮罩的 limb，再做進位傳播
; 進位傳播使用捨入常數 (1<<(bits-1))，產生「半規約」形式（limb 可為小負數）
; 此形式與 fe-tobytes 的預期輸入一致，確保 round-trip 正確
fe-frombytes = (h []i64, s [32]byte) {
    ; 載入未遮罩 limb（每個 limb 包含「跨界」位元，由後續進位傳播規整）
    h[0] = (s[0] & 255) | ((s[1] & 255) << 8) | ((s[2] & 255) << 16) | ((s[3] & 255) << 24)
    h[1] = ((s[4] & 255) | ((s[5] & 255) << 8) | ((s[6] & 255) << 16)) << 6
    h[2] = ((s[7] & 255) | ((s[8] & 255) << 8) | ((s[9] & 255) << 16)) << 5
    h[3] = ((s[10] & 255) | ((s[11] & 255) << 8) | ((s[12] & 255) << 16)) << 3
    h[4] = ((s[13] & 255) | ((s[14] & 255) << 8) | ((s[15] & 255) << 16)) << 2
    h[5] = (s[16] & 255) | ((s[17] & 255) << 8) | ((s[18] & 255) << 16) | ((s[19] & 255) << 24)
    h[6] = ((s[20] & 255) | ((s[21] & 255) << 8) | ((s[22] & 255) << 16)) << 7
    h[7] = ((s[23] & 255) | ((s[24] & 255) << 8) | ((s[25] & 255) << 16)) << 5
    h[8] = ((s[26] & 255) | ((s[27] & 255) << 8) | ((s[28] & 255) << 16)) << 4

    ; 最高 limb：遮罩最高位元（bit 255 之後無效），保留 23 位元後 << 2
    ; 使 V 貢獻 = (bits 232-254) * 2^2 * 2^230 = (bits 232-254) * 2^232（與位元組值一致）
    h[9] = (((s[29] & 255) | ((s[30] & 255) << 8) | ((s[31] & 255) << 16)) & 8388607) << 2

    ; 進位傳播 (ref10 風格 + floor division)
    ; Nolang 的 >> 對 i64 是邏輯右移，需用 floor division 公式處理負數
    ; 26-bit: carry = floor((h + (1<<25)) / 2^26)
    ; 25-bit: carry = floor((h + (1<<24)) / 2^25)

    sum = h[0] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    h[0] = h[0] - (c << 26)
    h[1] = h[1] + c

    sum = h[1] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    h[1] = h[1] - (c << 25)
    h[2] = h[2] + c

    sum = h[2] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    h[2] = h[2] - (c << 26)
    h[3] = h[3] + c

    sum = h[3] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    h[3] = h[3] - (c << 25)
    h[4] = h[4] + c

    sum = h[4] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    h[4] = h[4] - (c << 26)
    h[5] = h[5] + c

    sum = h[5] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    h[5] = h[5] - (c << 25)
    h[6] = h[6] + c

    sum = h[6] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    h[6] = h[6] - (c << 26)
    h[7] = h[7] + c

    sum = h[7] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    h[7] = h[7] - (c << 25)
    h[8] = h[8] + c

    sum = h[8] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    h[8] = h[8] - (c << 26)
    h[9] = h[9] + c

    sum = h[9] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    h[9] = h[9] - (c << 25)

    ; wrap-around: 2^255 ≡ 19
    h[0] = h[0] + c * 19

    ; 最終進位 h0 -> h1 -> h2
    sum = h[0] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    h[0] = h[0] - (c << 26)
    h[1] = h[1] + c

    sum = h[1] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    h[1] = h[1] - (c << 25)
    h[2] = h[2] + c
}

; fe-tobytes: 將域元素序列化為 32 位元組（小端序）
; 使用 ref10 風格進位傳播，正確處理帶號 limb 並規約 mod p
; 注意：使用局部陣列 t 來避免編譯器對個別變數的最佳化問題
fe-tobytes = (s [32]byte, h []i64) {
    ; 複製到局部陣列
    t []i64 = with-len(10)
    t[0] = h[0]
    t[1] = h[1]
    t[2] = h[2]
    t[3] = h[3]
    t[4] = h[4]
    t[5] = h[5]
    t[6] = h[6]
    t[7] = h[7]
    t[8] = h[8]
    t[9] = h[9]

    ; 第一輪進位傳播 (ref10 風格 + floor division)
    sum = t[0] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    t[0] = t[0] - (c << 26)
    t[1] = t[1] + c
    sum = t[1] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    t[1] = t[1] - (c << 25)
    t[2] = t[2] + c
    sum = t[2] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    t[2] = t[2] - (c << 26)
    t[3] = t[3] + c
    sum = t[3] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    t[3] = t[3] - (c << 25)
    t[4] = t[4] + c
    sum = t[4] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    t[4] = t[4] - (c << 26)
    t[5] = t[5] + c
    sum = t[5] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    t[5] = t[5] - (c << 25)
    t[6] = t[6] + c
    sum = t[6] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    t[6] = t[6] - (c << 26)
    t[7] = t[7] + c
    sum = t[7] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    t[7] = t[7] - (c << 25)
    t[8] = t[8] + c
    sum = t[8] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    t[8] = t[8] - (c << 26)
    t[9] = t[9] + c
    sum = t[9] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    t[9] = t[9] - (c << 25)
    t[0] = t[0] + c * 19

    ; 第二輪進位（wrap-around）
    sum = t[0] + 33554432
    c = (sum >> 26) - ((sum >> 63) << 38)
    t[0] = t[0] - (c << 26)
    t[1] = t[1] + c
    sum = t[1] + 16777216
    c = (sum >> 25) - ((sum >> 63) << 39)
    t[1] = t[1] - (c << 25)
    t[2] = t[2] + c

    ; 此時所有 limb 在 [0, 2^bits-1] 範圍內
    ; 但值可能 >= p，需條件減去 p
    ; 測試: 加 19 看是否溢出 bit 255
    t[0] = t[0] + 19

    ; 簡單進位傳播（使用 floor division，正確處理負數 limb）
    ; Nolang 的 >> 對 i64 是邏輯右移（零填充），非算術右移（符號擴展）
    ; floor(x / 2^b) = (x >> b) - ((x >> 63) << (64 - b))
    ; 其中 (x >> 63) 為符號位（1=負數, 0=正數）
    c = (t[0] >> 26) - ((t[0] >> 63) << 38)
    t[0] = t[0] - (c << 26)
    t[1] = t[1] + c
    c = (t[1] >> 25) - ((t[1] >> 63) << 39)
    t[1] = t[1] - (c << 25)
    t[2] = t[2] + c
    c = (t[2] >> 26) - ((t[2] >> 63) << 38)
    t[2] = t[2] - (c << 26)
    t[3] = t[3] + c
    c = (t[3] >> 25) - ((t[3] >> 63) << 39)
    t[3] = t[3] - (c << 25)
    t[4] = t[4] + c
    c = (t[4] >> 26) - ((t[4] >> 63) << 38)
    t[4] = t[4] - (c << 26)
    t[5] = t[5] + c
    c = (t[5] >> 25) - ((t[5] >> 63) << 39)
    t[5] = t[5] - (c << 25)
    t[6] = t[6] + c
    c = (t[6] >> 26) - ((t[6] >> 63) << 38)
    t[6] = t[6] - (c << 26)
    t[7] = t[7] + c
    c = (t[7] >> 25) - ((t[7] >> 63) << 39)
    t[7] = t[7] - (c << 25)
    t[8] = t[8] + c
    c = (t[8] >> 26) - ((t[8] >> 63) << 38)
    t[8] = t[8] - (c << 26)
    t[9] = t[9] + c
    c = (t[9] >> 25) - ((t[9] >> 63) << 39)
    t[9] = t[9] - (c << 25)

    ; c = 1 表示 t + 19 >= 2^255，即原值 >= p，當前 t = 原值 - p（正確）
    ; c = 0 表示原值 < p，需撤銷 +19
    ; mask = 0 - (1 - c): c=0 → mask=-1（全1），c=1 → mask=0
    mask = 0 - (1 - c)
    t[0] = t[0] - (19 & mask)

    ; 打包為 32 位元組（小端序）
    ; limb 布局：t[0](26) t[1](25) t[2](26) t[3](25) t[4](26) t[5](25) t[6](26) t[7](25) t[8](26) t[9](25)
    ; 各 limb 起始位元：0, 26, 51, 77, 102, 128, 153, 179, 204, 230
    s[0] = t[0] & 255
    s[1] = (t[0] >> 8) & 255
    s[2] = (t[0] >> 16) & 255
    s[3] = ((t[0] >> 24) | (t[1] << 2)) & 255
    s[4] = (t[1] >> 6) & 255
    s[5] = (t[1] >> 14) & 255
    s[6] = ((t[1] >> 22) | (t[2] << 3)) & 255
    s[7] = (t[2] >> 5) & 255
    s[8] = (t[2] >> 13) & 255
    s[9] = ((t[2] >> 21) | (t[3] << 5)) & 255
    s[10] = (t[3] >> 3) & 255
    s[11] = (t[3] >> 11) & 255
    s[12] = ((t[3] >> 19) | (t[4] << 6)) & 255
    s[13] = (t[4] >> 2) & 255
    s[14] = (t[4] >> 10) & 255
    s[15] = (t[4] >> 18) & 255
    s[16] = ((t[4] >> 26) | (t[5] << 0)) & 255
    s[17] = (t[5] >> 8) & 255
    s[18] = (t[5] >> 16) & 255
    s[19] = ((t[5] >> 24) | (t[6] << 1)) & 255
    s[20] = (t[6] >> 7) & 255
    s[21] = (t[6] >> 15) & 255
    s[22] = ((t[6] >> 23) | (t[7] << 3)) & 255
    s[23] = (t[7] >> 5) & 255
    s[24] = (t[7] >> 13) & 255
    s[25] = ((t[7] >> 21) | (t[8] << 4)) & 255
    s[26] = (t[8] >> 4) & 255
    s[27] = (t[8] >> 12) & 255
    s[28] = ((t[8] >> 20) | (t[9] << 6)) & 255
    s[29] = (t[9] >> 2) & 255
    s[30] = (t[9] >> 10) & 255
    s[31] = (t[9] >> 18) & 255
}

; ═══════════════════════════════════════════════
; Montgomery Ladder（核心純量乘法）
; ═══════════════════════════════════════════════

; x25519-scalarmult: X25519 純量乘法
; scalar [32]byte: 純量（私鑰）
; point [32]byte: 點座標（公鑰）
; 返回 out [32]byte: 結果
x25519-scalarmult = (scalar [32]byte, point [32]byte) (out [32]byte) {
    ; Clamping: 固定純量的某些位元
    ; scalar[0] &= 248, scalar[31] &= 127, scalar[31] |= 64
    k []byte = with-len(32)
    i <- [0..32): {
        k[i] = scalar[i]
    }
    k[0] = k[0] & 248
    k[31] = k[31] & 127
    k[31] = k[31] | 64

    ; 載入點座標
    u []i64 = with-len(10)
    fe-frombytes(u, point)

    ; 初始化 Montgomery ladder
    x1 []i64 = with-len(10)
    fe-copy(x1, u)

    x2 []i64 = with-len(10)
    fe-one(x2)

    z2 []i64 = with-len(10)
    fe-zero(z2)

    x3 []i64 = with-len(10)
    fe-copy(x3, u)

    z3 []i64 = with-len(10)
    fe-one(z3)

    ; 預分配 Montgomery ladder 臨時變數（循環外分配一次，循環內重複使用）
    a []i64 = with-len(10)
    aa []i64 = with-len(10)
    b-fe []i64 = with-len(10)
    bb []i64 = with-len(10)
    e []i64 = with-len(10)
    c []i64 = with-len(10)
    d []i64 = with-len(10)
    da []i64 = with-len(10)
    cb []i64 = with-len(10)

    swap = 0

    ; 從最高位元到最低位元迭代（bit 254 到 bit 0）
    t = 254
    {
        ; 提取純量的第 t 位元
        byte-idx = t / 8
        bit-idx = t % 8
        b = (k[byte-idx] >> bit-idx) & 1

        ; 條件交換
        swap = swap ^ b
        fe-cswap(x2, x3, swap)
        fe-cswap(z2, z3, swap)
        swap = b

        ; Montgomery ladder step (RFC 7748 §5)
        ; A = X2 + Z2; AA = A^2; B = X2 - Z2; BB = B^2; E = AA - BB
        ; C = X3 + Z3; D = X3 - Z3; DA = D*A; CB = C*B
        ; X3 = (DA+CB)^2; Z3 = X1*(DA-CB)^2
        ; X2 = AA*BB; Z2 = E*(AA + a24*BB) where a24 = 121665
        fe-add(a, x2, z2)
        fe-sq(aa, a)
        fe-sub(b-fe, x2, z2)
        fe-sq(bb, b-fe)
        fe-sub(e, aa, bb)
        fe-add(c, x3, z3)
        fe-sub(d, x3, z3)
        fe-mul(da, d, a)
        fe-mul(cb, c, b-fe)

        ; x3 = (da + cb)^2
        fe-add(x3, da, cb)
        fe-sq(x3, x3)

        ; z3 = x1 * (da - cb)^2
        fe-sub(z3, da, cb)
        fe-sq(z3, z3)
        fe-mul(z3, z3, x1)

        ; x2 = aa * bb
        fe-mul(x2, aa, bb)

        ; z2 = e * (bb + 121666 * e) = e*bb + 121666*e^2
        ; 標準 Montgomery 倍點公式: z(2P) = 4*x*z * ((x-z)^2 + (A+2)/4 * 4*x*z)
        ; 其中 4*x*z = E, (x-z)^2 = BB, (A+2)/4 = 121666
        ; 使用 'a' 作為臨時變數（下次迭代會被覆寫）
        fe-sq(a, e)
        fe-mul121666(a, a)
        fe-mul(z2, e, bb)
        fe-add(z2, z2, a)

        ; 結束 Montgomery ladder step
        t = t - 1
    } (t >= 0)

    ; 最後一次交換
    fe-cswap(x2, x3, swap)
    fe-cswap(z2, z3, swap)

    ; 計算結果: x2 * z2^(-1)
    z-inv []i64 = with-len(10)
    fe-invert(z-inv, z2)

    result []i64 = with-len(10)
    fe-mul(result, x2, z-inv)

    fe-tobytes(out, result)
}

; ═══════════════════════════════════════════════
; 基點乘法
; ═══════════════════════════════════════════════

; x25519-get-basepoint: 返回基點 u 座標 (9, 0, 0, ..., 0)
x25519-get-basepoint = () (base [32]byte) {
    ; [32]byte 不自動零初始化，需顯式清零
    i <- [0..32): {
        base[i] = 0
    }
    base[0] = 9
}

; x25519-scalarmult-base: 計算純量 * 基點
; scalar [32]byte: 純量（私鑰）
; 返回 out [32]byte: 公鑰
x25519-scalarmult-base = (scalar [32]byte) (out [32]byte) {
    base [32]byte
    base = x25519-get-basepoint()
    out = x25519-scalarmult(scalar, base)
}

; ═══════════════════════════════════════════════
; 金鑰對生成
; ═══════════════════════════════════════════════

; x25519-gen-keypair: 生成隨機金鑰對
; seed i64: 隨機種子
; 返回 priv [32]byte: 私鑰
; 返回 pub [32]byte: 公鑰
x25519-gen-keypair = (seed i64) (priv [32]byte, pub [32]byte) {
    ; 用 PRNG 生成 32 位元組私鑰
    state = seed
    i <- [0..32): {
        state, r = rand(state)
        priv[i] = state & 255
    }

    ; Clamping
    priv[0] = priv[0] & 248
    priv[31] = priv[31] & 127
    priv[31] = priv[31] | 64

    ; 計算公鑰
    pub = x25519-scalarmult-base(priv)
}
