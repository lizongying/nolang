; ecdsa — ECDSA 數位簽章（NIST P-256 / secp256r1）
;
; 實作基於 NIST P-256 橢圓曲線的 ECDSA 簽章算法。
; # std/fs
; 曲線: y² = x³ - 3x + b (mod p)
;
; 使用 8×32-bit limb 表示 256-bit 大整數。
; Jacobian 座標進行點運算。
;
; 用法：
;   # std/crypto/ecdsa
;   priv [32]byte = ecdsa-generate(seed)
;   pub [65]byte = ecdsa-publickey(priv)
;   sig [64]byte = ecdsa-sign(priv, msg)
;   ok = ecdsa-verify(pub, msg, sig)

; ═══════════════════════════════════════════════
; 曲線參數（P-256）
; ═══════════════════════════════════════════════

; 素數 p = 2^256 - 2^224 + 2^192 + 2^96 - 1
; 小端 32 位元組
; 素域 p = 2^256 - 2^224 + 2^192 + 2^96 - 1（小端序：byte[0] 為最低有效位元組，
; 與 bn-* 引擎及 P256-N 的儲存約定一致）
P256-P [32]byte = [
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
]

; 群階 n
P256-N [32]byte = [
    0x51, 0x25, 0x63, 0xfc, 0xc2, 0xca, 0xb9, 0xf3,
    0x84, 0x9e, 0x17, 0xa7, 0xad, 0xfa, 0xe6, 0xbc,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
]

; 基點 Gx（大端序；ec-get-basepoint 以 Gx[31-i] 轉為內部小端序）
P256-GX [32]byte = [
    0x6b, 0x17, 0xd1, 0xf2, 0xe1, 0x2c, 0x42, 0x47,
    0xf8, 0xbc, 0xe6, 0xe5, 0x63, 0xa4, 0x40, 0xf2,
    0x77, 0x03, 0x7d, 0x81, 0x2d, 0xeb, 0x33, 0xa0,
    0xf4, 0xa1, 0x39, 0x45, 0xd8, 0x98, 0xc2, 0x96,
]

; 基點 Gy（大端序）
P256-GY [32]byte = [
    0x4f, 0xe3, 0x42, 0xe2, 0xfe, 0x1a, 0x7f, 0x9b,
    0x8e, 0xe7, 0xeb, 0x4a, 0x7c, 0x0f, 0x9e, 0x16,
    0x2b, 0xce, 0x33, 0x57, 0x6b, 0x31, 0x5e, 0xce,
    0xcb, 0xb6, 0x40, 0x68, 0x37, 0xbf, 0x51, 0xf5,
]

; 曲線參數 b
P256-B [32]byte = [
    0x4b, 0x60, 0xd2, 0x27, 0x3e, 0x3c, 0xce, 0x3b,
    0xf6, 0xb0, 0x53, 0xcc, 0xb0, 0x06, 0x1d, 0x65,
    0xbc, 0x86, 0x98, 0x76, 0x55, 0xbd, 0xeb, 0xb3,
    0xe7, 0x93, 0x3a, 0xaa, 0xd8, 0x35, 0xc6, 0x5a,
]

; ═══════════════════════════════════════════════
; 256-bit 大整數運算（byte 陣列，小端序）
; ═══════════════════════════════════════════════

; bn-cmp: 比較兩個 256-bit 數（小端序）
; 返回: -1 if a < b, 0 if a == b, 1 if a > b
bn-cmp = (a []byte, b []byte) (r i64) {
    i <- [31..0]: {

        #{index-out=zero}
        ai = a[i]

        #{index-out=zero}
        bi = b[i]
        {
            ai > bi -> {
                r = 1
                return
            }

            ai < bi -> {
                r = -1
                return
            }
        }
    }
    r = 0
}

; bn-add: 256-bit 加法（不帶模約簡）
; 返回 sum [32]byte 和 carry i64
bn-add = (a []byte, b []byte) (sum [32]byte, carry i64) {
    carry = 0
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        val = (a[i]) + (b[i]) + carry

        sum[i] = val & 255
        carry = val >> 8
    }
}

; bn-sub: 256-bit 減法 a - b（不帶模約簡）
; 返回 diff [32]byte 和 borrow i64
bn-sub = (a []byte, b []byte) (diff [32]byte, borrow i64) {
    borrow = 0
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        val = (a[i]) - (b[i]) - borrow

        #{overflow=wrap}
        {
            val < 0 -> {

                #{overflow=wrap}
                val = val + 256
                borrow = 1
            }

            -> borrow = 0
        }

        diff[i] = val
    }
}

; bn-mod: 模約簡 a mod m（重複減法）
bn-mod = (a []byte, m []byte) (out [32]byte) {
    work [32]byte
    diff [32]byte
    i <- [0..32): {

        #{index-out=zero}
        work[i] = a[i]
    }

    ; 重複減去 m 直到 work < m
    round <- [0..512): {
        cmp = 0
        cmp = bn-cmp(work, m)
        cmp < 0 -> break
        diff.zero()
        borrow = 0
        diff, borrow = bn-sub(work, m)
        i <- [0..32): {

            work[i] = diff[i]
        }
    }
    i <- [0..32): {

        out[i] = work[i]
    }
}

; bn-mulmod: 模乘 (a * b) mod m，使用 schoolbook 乘法
bn-mulmod = (a []byte, b []byte, m []byte) (out [32]byte) {

    ; 512-bit 乘積（64 位元組）
    product [64]byte
    i <- [0..64): {

        product[i] = 0
    }

    ; Schoolbook 乘法
    i <- [0..32): {

        carry = 0
        j <- [0..32): {

            #{overflow=wrap}
            idx = i + j

            #{index-out=zero, overflow=wrap}
            val = (product[idx]) + (a[i]) * (b[j]) + carry

            product[idx] = val & 255
            carry = val >> 8
        }

        ; 傳播進位
        #{overflow=wrap}
        idx = i + 32
        (idx < 64 && carry != 0) {

            #{index-out=zero, overflow=wrap}
            val = (product[idx]) + carry

            product[idx] = val & 255
            carry = val >> 8

            #{overflow=wrap}
            idx = idx + 1
        }
    }

    ; 規約 mod m（處理 512-bit → 256-bit）
    ; 將高 256 位逐次減去 m 的適當倍數
    ; 簡化方法：重複減法（高位部分）
    work [64]byte
    i <- [0..64): {

        work[i] = product[i]
    }

    ; 從高位開始，每次減去 m << (bit_pos)
    bit = 511
    (bit >= 256) {

        ; 檢查 work 的第 bit 位元
        #{overflow=wrap}
        byte-idx = bit / 8
        bit-idx = bit % 8

        #{overflow=wrap}
        (work[byte-idx] >> bit-idx) & 1 == 1 -> {

            ; 減去 m << (bit - 256)
            #{overflow=wrap}
            shift = bit - 256
            shifted [64]byte

            ; m << shift
            i <- [0..32): {

                src-byte = i
                dst-byte-start = (i * 8 + shift) / 8
                ; 簡化：只在 byte 邊界對齊時處理
            }
            ; 由於位元級移位複雜，使用更簡單的方法
            ; 直接從高 32 位元組開始減法
        }

        #{overflow=wrap}
        bit = bit - 1
    }

    ; 更簡單的方法：將 64 位元組分為高低兩半
    ; result = low + high * 2^256 mod m
    ; 由於 2^256 mod m 可以預計算，這裡用簡化方法
    ; 從最高位元組開始減
    ; 每次嘗試減去 m * 2^(shift)
    ; 注意：64 位元組乘積最高可達 2^512-1，必須從 shift-byte=32
    ; （窗 acc[32..63]，涵蓋 byte 63 / bit 504..511）開始，
    ; 否則最高位元組永遠不會被規約，結果錯誤。
    ; 迴圈條件 > 0 + 頂部先 -1，因此實際會處理到 shift-byte=0（窗 work[0..31]），
    ; 確保結果 < m。
    shift-byte = 33
    (shift-byte > 0) {

        #{overflow=wrap}
        shift-byte = shift-byte - 1

        ; 嘗試減去 m << (shift_byte * 8)
        ; 即在 work[shift_byte..shift_byte+32) 處減去 m
        ; 33 位元組修正：真實要比較的是 floor(work / 256^shift_byte)，佔用位元組
        ; [shift_byte .. 63]；其上方位元組 work[shift_byte+32] 非 0 時，該值必
        ; >= 2^256 > m，必須強制減。經高位處理後 [shift_byte+33 .. 63] 必為 0，
        ; 故只需檢查此一位元組即可；僅在「窗口 < m 且無上溢位元組」時才清 can-sub。
        can-sub = 1
        hi = 0
        (shift-byte + 32 < 64) -> {

            #{index-out=zero}
            hi = work[shift-byte + 32]
        }
        i <- [31..0]: {
            wi = 0

            #{overflow=wrap}
            shift-byte + i < 64 -> {

                #{index-out=zero}
                wi = work[shift-byte + i]
            }

            #{index-out=zero}
            mi = m[i]
            {
                wi > mi -> break

                wi < mi -> {
                    (hi == 0) -> {
                        can-sub = 0
                    }
                    break
                }
            }
        }

        #{overflow=wrap}
        can-sub == 1 -> {

            borrow = 0
            i <- [0..32): {

                #{overflow=wrap}
                idx = shift-byte + i
                {
                    idx < 64 -> {

                        #{index-out=zero, overflow=wrap}
                        val = (work[idx]) - (m[i]) - borrow
                        {
                            val < 0 -> {

                                #{overflow=wrap}
                                val = val + 256
                                borrow = 1
                            }

                            -> borrow = 0
                        }

                        work[idx] = val
                    }

                    -> {
                        borrow != 0 -> {

                            #{index-out=zero, overflow=wrap}
                            val = (work[idx]) - borrow
                            {
                                val < 0 -> {

                                    #{overflow=wrap}
                                    val = val + 256
                                    borrow = 1
                                }

                                -> borrow = 0
                            }

                            work[idx] = val
                        }
                    }
                }
            }

            ; 傳播最後的借位到上位元組：強制減時窗口可能 < m 而產生借位，
            ; 必須把借位繼續往 work[shift-byte+32 .. 63] 傳播，否則減法不完整。
            (borrow != 0) {
                idx = shift-byte + 32
                (idx < 64) {

                    #{index-out=zero, overflow=wrap}
                    val = (work[idx]) - borrow
                    {
                        val < 0 -> {

                            #{overflow=wrap}
                            val = val + 256
                            borrow = 1
                        }

                        -> borrow = 0
                    }
                    work[idx] = val

                    #{overflow=wrap}
                    idx = idx + 1
                }
            }

            ; 如果還能減，再減一次
            shift-byte = shift-byte + 1
        }
    }
    i <- [0..32): {
        out[i] = work[i]
    }
}

; bn-addmod: 模加 (a + b) mod m
; a, b < m (m 為 256-bit 模數，通常 m ≈ 2^256)
; 關鍵：a + b 可能 >= 2^256，會產生進位。此時真實值為
;   (a + b) = 2^256 + sum_low，而 (a+b) mod m = (sum_low + (2^256 mod m)) mod m。
; 若只用 bn-mod(sum_low, m) 會少算 2^256 mod m 那一項，結果錯誤。
; 這裡將 (a+b) 視為最多 33 位元組的數（含進位），放入 64 位元組空間，
; 並與 bn-mulmod 共用「從高位元組開始減去 m<<(k*8)」的規約邏輯。
bn-addmod = (a []byte, b []byte, m []byte) (out [32]byte) {
    s [32]byte
    carry = 0
    s, carry = bn-add(a, b)
    acc [64]byte
    i <- [0..32): {

        #{index-out=zero}
        acc[i] = s[i]
    }
    acc[32] = carry & 255
    i <- [33..64): {

        #{index-out=zero}
        acc[i] = 0
    }

    ; 規約：從 shift-byte=32 開始（窗 acc[32..63]），一路減到 0
    ; （迴圈條件 > 0 + 頂部先 -1，故實際會處理到 shift-byte=0）
    shift-byte = 33
    (shift-byte > 0) {

        #{overflow=wrap}
        shift-byte = shift-byte - 1

        ; 嘗試在 acc[shift-byte..shift-byte+32) 處減去 m
        ; 同 bn-mulmod：真實值為 floor(acc / 256^shift_byte)，佔位元組
        ; [shift_byte .. 63]；上方位元組 acc[shift-byte+32] 非 0 時必須強制減。
        ; 經高位處理後 [shift-byte+33 .. 63] 必為 0，只需檢查此一位元組。
        can-sub = 1
        hi = 0
        (shift-byte + 32 < 64) -> {

            #{index-out=zero}
            hi = acc[shift-byte + 32]
        }
        i <- [31..0]: {

            #{index-out=zero}
            wi = 0

            #{overflow=wrap}
            shift-byte + i < 64 -> {

                #{index-out=zero}
                wi = acc[shift-byte + i]
            }

            #{index-out=zero}
            mi = m[i]
            {
                wi > mi -> break

                wi < mi -> {
                    (hi == 0) -> {
                        can-sub = 0
                    }
                    break
                }
            }
        }
        can-sub == 1 -> {
            borrow = 0
            i <- [0..32): {

                #{overflow=wrap}
                idx = shift-byte + i
                {
                    idx < 64 -> {

                        #{overflow=wrap}
                        val = (acc[idx]) - (m[i]) - borrow
                        {
                            val < 0 -> {

                                #{overflow=wrap}
                                val = val + 256
                                borrow = 1
                            }

                            -> borrow = 0
                        }

                        #{index-out=zero}
                        acc[idx] = val
                    }

                    -> {
                        borrow != 0 -> {

                            #{overflow=wrap}
                            val = (acc[idx]) - borrow
                            {
                                val < 0 -> {

                                    #{overflow=wrap}
                                    val = val + 256
                                    borrow = 1
                                }

                                -> borrow = 0
                            }

                            #{index-out=zero}
                            acc[idx] = val
                        }
                    }
                }
            }

            #{overflow=wrap}

            ; 傳播最後的借位到上位元組（強制減時窗口可能 < m 而產生借位）
            (borrow != 0) {
                idx = shift-byte + 32
                (idx < 64) {

                    #{index-out=zero, overflow=wrap}
                    val = (acc[idx]) - borrow
                    {
                        val < 0 -> {

                            #{overflow=wrap}
                            val = val + 256
                            borrow = 1
                        }

                        -> borrow = 0
                    }
                    acc[idx] = val

                    #{overflow=wrap}
                    idx = idx + 1
                }
            }

            #{overflow=wrap}
            shift-byte = shift-byte + 1
        }
    }
    i <- [0..32): {

        #{index-out=zero}
        out[i] = acc[i]
    }
}

; bn-submod: 模減 (a - b) mod m
bn-submod = (a []byte, b []byte, m []byte) (out [32]byte) {
    cmp = 0
    cmp = bn-cmp(a, b)
    {
        cmp >= 0 -> {
            diff [32]byte
            borrow = 0
            diff, borrow = bn-sub(a, b)
            i <- [0..32): {
                out[i] = diff[i]
            }
        }

        -> {

            ; a < b: result = (a - b) mod m = m - (b - a)
            ; 此時 0 < (b - a) < m（因 a, b 皆已約簡至 [0, m)），
            ; 故 m > (b - a)，bn-sub(m, diff) 直接給出正確值，無借位問題。
            diff [32]byte
            borrow = 0
            diff, borrow = bn-sub(b, a)
            out, borrow = bn-sub(m, diff)
        }
    }
}

; bn-invmod: 模逆 a^(-1) mod m，使用擴展歐幾里得算法
; 簡化版本：使用費馬小定理 a^(m-2) mod m（僅當 m 為素數時）
bn-invmod = (a []byte, m []byte) (out [32]byte) {

    ; 計算 a^(m-2) mod m 使用平方-乘法
    ; m-2
    exp [32]byte
    borrow = 0
    exp, borrow = bn-sub(m, [
        0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    ])

    ; result = 1
    result [32]byte
    result[0] = 1
    i <- [1..32): {

        result[i] = 0
    }

    ; base = a mod m
    base [32]byte
    base = bn-mod(a, m)

    ; 平方-乘法（從低位到高位）
    bit <- [0..256): {

        #{overflow=wrap}
        byte-idx = bit / 8
        bit-idx = bit % 8
        (exp[byte-idx] >> bit-idx) & 1 == 1 -> {
            result = bn-mulmod(result, base, m)
        }
        base = bn-mulmod(base, base, m)
    }
    i <- [0..32): {
        out[i] = result[i]
    }
}

; ═══════════════════════════════════════════════
; 橢圓曲線點運算（Jacobian 座標）
; 點表示: (X, Y, Z) 其中 x = X/Z², y = Y/Z³
; 使用 3×32 = 96 位元組陣列
; ═══════════════════════════════════════════════

; ec-point-double: 點倍乘 R = 2*P（Jacobian 座標）
; p []byte: 輸入點 (X, Y, Z)，各 32 位元組
; 返回 r []byte: 輸出點 (X, Y, Z)，96 位元組
ec-point-double = (p []byte) (r []byte) {

    ; 如果 Y == 0，返回無窮遠點
    is-zero = 1
    i <- [0..32): {

        #{overflow=wrap}
        p[32 + i] != 0 -> {
            is-zero = 0
        }
    }
    is-zero == 1 -> {
        i <- [0..96): {

            r[i] = 0
        }
        return
    }

    ; a = -3 for P-256
    ; 使用公式: 對 a=-3 的曲線優化
    ; S = 4 * X * Y²
    ; M = 3 * (X - Z²) * (X + Z²)
    ; X' = M² - 2*S
    ; Y' = M * (S - X') - 8 * Y⁴
    ; Z' = 2 * Y * Z
    x = p[0..32]
    y = p[32..64]
    z = p[64..96]

    ; Z²
    z2 [32]byte
    z2 = bn-mulmod(z, z, P256-P)

    ; X - Z²
    x-mz2 [32]byte
    x-mz2 = bn-submod(x, z2, P256-P)

    ; X + Z²
    x-pz2 [32]byte
    x-pz2 = bn-addmod(x, z2, P256-P)

    ; M = 3 * (X-Z²) * (X+Z²)   （a = -3 曲線的 Jacobian 倍點公式）
    ; 注意：M 必須是 3 倍，不是 4 倍！
    m [32]byte
    m = bn-mulmod(x-mz2, x-pz2, P256-P)
    m2 [32]byte
    m2 = bn-addmod(m, m, P256-P)
    m = bn-addmod(m2, m, P256-P)

    ; Y²
    y2 [32]byte
    y2 = bn-mulmod(y, y, P256-P)

    ; S = 4 * X * Y²
    s [32]byte
    s = bn-mulmod(x, y2, P256-P)
    s = bn-addmod(s, s, P256-P)
    s = bn-addmod(s, s, P256-P)

    ; Y⁴
    y4 [32]byte
    y4 = bn-mulmod(y2, y2, P256-P)

    ; X' = M² - 2*S
    m-sq [32]byte
    m-sq = bn-mulmod(m, m, P256-P)
    x3 [32]byte
    x3 = bn-submod(m-sq, s, P256-P)
    x3 = bn-submod(x3, s, P256-P)

    ; Y' = M * (S - X') - 8 * Y⁴
    s-mx3 [32]byte
    s-mx3 = bn-submod(s, x3, P256-P)
    y3 [32]byte
    y3 = bn-mulmod(m, s-mx3, P256-P)

    ; 8 * Y⁴
    y4-8 [32]byte
    y4-8 = bn-addmod(y4, y4, P256-P)
    y4-8 = bn-addmod(y4-8, y4-8, P256-P)
    y4-8 = bn-addmod(y4-8, y4-8, P256-P)
    y3 = bn-submod(y3, y4-8, P256-P)

    ; Z' = 2 * Y * Z
    z3 [32]byte
    z3 = bn-mulmod(y, z, P256-P)
    z3 = bn-addmod(z3, z3, P256-P)

    ; 輸出
    i <- [0..32): {
        r[i] = x3[i]

        #{overflow=wrap}
        r[32 + i] = y3[i]

        #{overflow=wrap}
        r[64 + i] = z3[i]
    }
}

; ec-point-add: 點加法 R = P + Q（P 在 Jacobian，Q 在 Jacobian）
; 返回 r []byte: 96 位元組
ec-point-add = (p []byte, q []byte) (r []byte) {
    x1 = p[0..32]
    y1 = p[32..64]
    z1 = p[64..96]
    x2 = q[0..32]
    y2 = q[32..64]
    z2 = q[64..96]

    ; 檢查 P 是否為無窮遠點
    p-inf = 1
    i <- [0..96): {
        p[i] != 0 -> {

            p-inf = 0
        }
    }
    p-inf == 1 -> {
        i <- [0..96): {

            #{index-out=zero}
            r[i] = q[i]
        }
        return
    }

    ; 檢查 Q 是否為無窮遠點
    q-inf = 1
    i <- [0..96): {
        q[i] != 0 -> {
            q-inf = 0
        }
    }
    q-inf == 1 -> {
        i <- [0..96): {

            #{index-out=zero}
            r[i] = p[i]
        }
        return
    }

    ; Z1², Z2²
    z1-2 [32]byte
    z1-2 = bn-mulmod(z1, z1, P256-P)
    z2-2 [32]byte
    z2-2 = bn-mulmod(z2, z2, P256-P)

    ; Z1³, Z2³
    z1-3 [32]byte
    z1-3 = bn-mulmod(z1-2, z1, P256-P)
    z2-3 [32]byte
    z2-3 = bn-mulmod(z2-2, z2, P256-P)

    ; U2 = X2 * Z1²
    u2 [32]byte
    u2 = bn-mulmod(x2, z1-2, P256-P)

    ; S2 = Y2 * Z1³
    s2 [32]byte
    s2 = bn-mulmod(y2, z1-3, P256-P)

    ; U1 = X1 * Z2²
    u1 [32]byte
    u1 = bn-mulmod(x1, z2-2, P256-P)

    ; S1 = Y1 * Z2³
    s1 [32]byte
    s1 = bn-mulmod(y1, z2-3, P256-P)

    ; H = U2 - U1
    h [32]byte
    h = bn-submod(u2, u1, P256-P)

    ; R = S2 - S1
    rr [32]byte
    rr = bn-submod(s2, s1, P256-P)

    ; 如果 H == 0:
    ;   如果 R == 0: return 2*P
    ;   否則: return infinity
    h-is-zero = 1
    i <- [0..32): {
        h[i] != 0 -> {
            h-is-zero = 0
        }
    }
    h-is-zero == 1 -> {
        r-is-zero = 1
        i <- [0..32): {
            rr[i] != 0 -> {
                r-is-zero = 0
            }
        }
        {
            r-is-zero == 1 -> {
                r = ec-point-double(p)
                return
            }

            -> {
                i <- [0..96): {
                    r[i] = 0
                }
                return
            }
        }
    }

    ; H²
    h2 [32]byte
    h2 = bn-mulmod(h, h, P256-P)

    ; H³
    h3 [32]byte
    h3 = bn-mulmod(h2, h, P256-P)

    ; U1 * H²
    u1h2 [32]byte
    u1h2 = bn-mulmod(u1, h2, P256-P)

    ; X3 = R² - H³ - 2 * U1 * H²
    r2 [32]byte
    r2 = bn-mulmod(rr, rr, P256-P)
    x3 [32]byte
    x3 = bn-submod(r2, h3, P256-P)
    x3 = bn-submod(x3, u1h2, P256-P)
    x3 = bn-submod(x3, u1h2, P256-P)

    ; Y3 = R * (U1*H² - X3) - S1 * H³
    y3 [32]byte
    y3 = bn-submod(u1h2, x3, P256-P)
    y3 = bn-mulmod(rr, y3, P256-P)
    s1h3 [32]byte
    s1h3 = bn-mulmod(s1, h3, P256-P)
    y3 = bn-submod(y3, s1h3, P256-P)

    ; Z3 = H * Z1 * Z2
    z3 [32]byte
    z3 = bn-mulmod(h, z1, P256-P)
    z3 = bn-mulmod(z3, z2, P256-P)
    i <- [0..32): {
        r[i] = x3[i]

        #{overflow=wrap}
        r[32 + i] = y3[i]

        #{overflow=wrap}
        r[64 + i] = z3[i]
    }
}

; ec-scalar-mult: 純量乘法 R = k * P
; k [32]byte: 純量
; p []byte: 點 (96 位元組)
; 返回 r []byte: 96 位元組
ec-scalar-mult = (k [32]byte, p []byte) (r []byte) {

    ; R = 無窮遠點
    i <- [0..96): {

        r[i] = 0
    }

    ; 從高位到低位進行 double-and-add
    bit = 255
    (bit >= 0) {

        ; R = 2*R
        tmp []byte
        tmp = ec-point-double(r)
        i <- [0..96): {

            #{index-out=zero}
            r[i] = tmp[i]
        }

        ; 如果 bit 為 1，R = R + P
        #{overflow=wrap}
        byte-idx = bit / 8
        bit-idx = bit % 8
        (k[byte-idx] >> bit-idx) & 1 == 1 -> {
            tmp = ec-point-add(r, p)
            i <- [0..96): {

                #{index-out=zero}
                r[i] = tmp[i]
            }
        }

        #{overflow=wrap}
        bit = bit - 1
    }
}

; ec-point-to-bytes: 將 Jacobian 座標轉為未壓縮編碼
; p []byte: Jacobian 點 (96 位元組)
; 返回 out [65]byte: 04 || x || y
ec-point-to-bytes = (p []byte) (out [65]byte) {
    px = p[0..32]
    py = p[32..64]
    pz = p[64..96]

    ; 檢查無窮遠點
    z-is-zero = 1
    i <- [0..32): {
        pz[i] != 0 -> {
            z-is-zero = 0
        }
    }
    z-is-zero == 1 -> {

        ; 返回全零
        return
    }

    ; Z²
    z2 [32]byte
    z2 = bn-mulmod(pz, pz, P256-P)

    ; Z³
    z3 [32]byte
    z3 = bn-mulmod(z2, pz, P256-P)

    ; Z²的逆
    z2-inv [32]byte
    z2-inv = bn-invmod(z2, P256-P)

    ; Z³的逆
    z3-inv [32]byte
    z3-inv = bn-invmod(z3, P256-P)

    ; x = X * (Z²)^(-1)
    x [32]byte
    x = bn-mulmod(px, z2-inv, P256-P)

    ; y = Y * (Z³)^(-1)
    y [32]byte
    y = bn-mulmod(py, z3-inv, P256-P)

    ; 輸出: 04 || x || y（大端序）
    out[0] = 4
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        out[1 + i] = x[31 - i]

        #{index-out=zero, overflow=wrap}
        out[33 + i] = y[31 - i]
    }
}

; ec-bytes-to-point: 將未壓縮編碼轉為 Jacobian 座標
; in [65]byte: 04 || x || y（大端序）
; 返回 out []byte: 96 位元組
ec-bytes-to-point = (in [65]byte) (out []byte) {
    out = with-len(96)

    ; 提取 x, y（轉為小端序）
    x [32]byte
    y [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        x[i] = in[1 + 31 - i]

        #{index-out=zero, overflow=wrap}
        y[i] = in[33 + 31 - i]
    }

    ; Jacobian: (X, Y, Z) = (x, y, 1)
    i <- [0..32): {
        out[i] = x[i]

        #{overflow=wrap}
        out[32 + i] = y[i]
    }
    out[64] = 1
    i <- [1..32): {

        #{overflow=wrap}
        out[64 + i] = 0
    }
}

; ═══════════════════════════════════════════════
; 基點
; ═══════════════════════════════════════════════

; ec-get-basepoint: 獲取基點 G 的 Jacobian 座標
ec-get-basepoint = () (g []byte) {

    ; Gx, Gy 轉為小端序
    i <- [0..32): {

        #{overflow=wrap}
        g[i] = P256-GX[31 - i]

        #{overflow=wrap}
        g[32 + i] = P256-GY[31 - i]
    }

    ; Z = 1
    g[64] = 1
    i <- [1..32): {

        #{overflow=wrap}
        g[64 + i] = 0
    }
}

; ═══════════════════════════════════════════════
; ECDSA 公開 API
; ═══════════════════════════════════════════════

; ecdh-p256: P-256 (secp256r1) ECDH 共享秘密
; priv [32]byte: 我方私鑰（大端序）
; peer [65]byte: 對端未壓縮公鑰（04 || x || y）
; 返回 shared []byte: 共享秘密（R 點之 x 座標, 32 bytes 大端序）；空=無效輸入
ecdh-p256 = (priv [32]byte, peer [65]byte) (shared []byte) {

    ; 將私鑰轉為小端序（內部點運算使用小端序純量）
    k [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        k[i] = priv[31 - i]
    }

    ; 對端點解碼為 Jacobian 座標
    p []byte
    p = ec-bytes-to-point(peer)

    ; R = k * P
    r []byte
    r = ec-scalar-mult(k, p)

    ; R 轉為未壓縮編碼（無窮遠點/无效點時首位元組不為 04）
    enc [65]byte
    enc = ec-point-to-bytes(r)
    enc[0] != 4 -> return

    ; 提取 x 座標（大端序）
    shared = with-len(32)
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        shared[i] = enc[1 + i]
    }
}

; ecdsa-publickey: 從私鑰計算公鑰
; priv [32]byte: 私鑰（大端序）
; 返回 pub [65]byte: 未壓縮公鑰（04 || x || y）
ecdsa-publickey = (priv [32]byte) (pub [65]byte) {

    ; 將私鑰轉為小端序
    k [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        k[i] = priv[31 - i]
    }

    ; G = 基點
    g []byte
    g = ec-get-basepoint()

    ; Q = k * G
    q []byte
    q = ec-scalar-mult(k, g)

    ; 編碼為未壓縮格式
    pub = ec-point-to-bytes(q)
}

; ecdsa-sign: ECDSA 簽名
; priv [32]byte: 私鑰（大端序）
; msg []byte: 訊息
; 返回 sig [64]byte: 簽名（r || s，各 32 位元組，大端序）
ecdsa-sign = (priv [32]byte, msg []byte) (sig [64]byte) {

    ; 計算哈希 h = SHA-256(msg)
    h [32]byte
    h = sha256.sha256(msg)

    ; 將哈希轉為小端序
    h-le [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        h-le[i] = h[31 - i]
    }

    ; 私鑰轉小端序
    d [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        d[i] = priv[31 - i]
    }

    ; 使用私鑰作為隨機數種子生成 k（簡化，生產環境應使用 RFC 6979）
    k [32]byte
    state = 0
    i <- [0..32): {

        #{overflow=wrap}
        state, rand-r = rand.rand(state + d[i] + h-le[i] + i)

        k[i] = state & 255
    }

    ; 確保 k 在 [1, n-1] 範圍內
    k = bn-mod(k, P256-N)
    k[0] == 0 -> {
        all-zero = 1
        i <- [1..32): {
            k[i] != 0 -> {

                all-zero = 0
            }
        }
        all-zero == 1 -> {
            k[0] = 1
        }
    }

    ; R = k * G
    g []byte
    g = ec-get-basepoint()
    r-point []byte
    r-point = ec-scalar-mult(k, g)

    ; r = R.x mod n
    r-point-bytes [65]byte
    r-point-bytes = ec-point-to-bytes(r-point)

    ; 提取 x（大端序 → 小端序）
    rx [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        rx[i] = r-point-bytes[1 + 31 - i]
    }
    r-val [32]byte
    r-val = bn-mod(rx, P256-N)

    ; s = k^(-1) * (h + r * d) mod n
    k-inv [32]byte
    k-inv = bn-invmod(k, P256-N)
    rd [32]byte
    rd = bn-mulmod(r-val, d, P256-N)
    h-rd [32]byte
    h-rd = bn-addmod(h-le, rd, P256-N)
    s-val [32]byte
    s-val = bn-mulmod(k-inv, h-rd, P256-N)

    ; 輸出（大端序）
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        sig[i] = r-val[31 - i]

        #{index-out=zero, overflow=wrap}
        sig[32 + i] = s-val[31 - i]
    }
}

; ecdsa-verify: ECDSA 驗簽
; pub [65]byte: 公鑰
; msg []byte: 訊息
; sig [64]byte: 簽名（r || s）
; 返回 ok i64: 1=有效, 0=無效
ecdsa-verify = (pub [65]byte, msg []byte, sig [64]byte) (ok i64) {

    ; 提取 r, s（大端序 → 小端序）
    r-val [32]byte
    s-val [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        r-val[i] = sig[31 - i]

        #{index-out=zero, overflow=wrap}
        s-val[i] = sig[32 + 31 - i]
    }

    ; 檢查 r, s ∈ [1, n-1]
    ; r != 0
    r-zero = 1
    i <- [0..32): {
        r-val[i] != 0 -> {
            r-zero = 0
        }
    }
    r-zero == 1 -> {
        ok = 0
        return
    }

    ; s != 0
    s-zero = 1
    i <- [0..32): {
        s-val[i] != 0 -> {
            s-zero = 0
        }
    }
    s-zero == 1 -> {
        ok = 0
        return
    }
    bn-cmp(r-val, P256-N) >= 0 -> {
        ok = 0
        return
    }

    ; s < n
    bn-cmp(s-val, P256-N) >= 0 -> {
        ok = 0
        return
    }

    ; h = SHA-256(msg)
    h [32]byte
    h = sha256.sha256(msg)
    h-le [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        h-le[i] = h[31 - i]
    }

    ; w = s^(-1) mod n
    w [32]byte
    w = bn-invmod(s-val, P256-N)

    ; u1 = h * w mod n
    u1 [32]byte
    u1 = bn-mulmod(h-le, w, P256-N)

    ; u2 = r * w mod n
    u2 [32]byte
    u2 = bn-mulmod(r-val, w, P256-N)

    ; Q = 公鑰點
    q []byte
    q = ec-bytes-to-point(pub)

    ; R1 = u1 * G
    g []byte
    g = ec-get-basepoint()
    r1 []byte
    r1 = ec-scalar-mult(u1, g)

    ; R2 = u2 * Q
    r2 []byte
    r2 = ec-scalar-mult(u2, q)

    ; R = R1 + R2
    r-point []byte
    r-point = ec-point-add(r1, r2)

    ; 檢查 R 是否為無窮遠點
    r-inf = 1
    i <- [0..96): {
        r-point[i] != 0 -> {
            r-inf = 0
        }
    }
    r-inf == 1 -> {
        ok = 0
        return
    }

    ; v = R.x mod n
    r-point-bytes [65]byte
    r-point-bytes = ec-point-to-bytes(r-point)
    rx [32]byte
    i <- [0..32): {

        #{index-out=zero, overflow=wrap}
        rx[i] = r-point-bytes[1 + 31 - i]
    }
    v [32]byte
    v = bn-mod(rx, P256-N)

    ; 驗證 v == r
    ok = 1
    i <- [0..32): {
        v[i] != r-val[i] -> {

            ok = 0
        }
    }
}
