; ecdsa — ECDSA 數位簽章（NIST P-256 / secp256r1）
;
; 實作基於 NIST P-256 橢圓曲線的 ECDSA 簽章算法。
; # std/fs
; 曲線: y² = x³ - 3x + b (mod p)
;
; 使用 8×32-bit limb 表示 256-bit 大整數。
; Jacobian 座標進行點運算。
;
; 用法：
;   # std/crypto/ecdsa
;   priv [32]byte = ecdsa-generate(seed)
;   pub [65]byte = ecdsa-publickey(priv)
;   sig [64]byte = ecdsa-sign(priv, msg)
;   ok = ecdsa-verify(pub, msg, sig)
; [ecdsa](#ecdsa)

; 曲線參數（P-256）
...

; 素數 p = 2^256 - 2^224 + 2^192 + 2^96 - 1
; 小端 32 位元組
; 素域 p = 2^256 - 2^224 + 2^192 + 2^96 - 1（小端序：byte[0] 為最低有效位元組，
; 與 bn-* 引擎及 P256-N 的儲存約定一致）
; [P256-P](#ecdsa.p256-p)
P256-P [32]byte = [
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
]

; 群階 n
; [P256-N](#ecdsa.p256-n)
P256-N [32]byte = [
    0x51, 0x25, 0x63, 0xfc, 0xc2, 0xca, 0xb9, 0xf3,
    0x84, 0x9e, 0x17, 0xa7, 0xad, 0xfa, 0xe6, 0xbc,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
]

; 基點 Gx（大端序；ec-get-basepoint 以 Gx[31-i] 轉為內部小端序）
; [P256-GX](#ecdsa.p256-gx)
P256-GX [32]byte = [
    0x6b, 0x17, 0xd1, 0xf2, 0xe1, 0x2c, 0x42, 0x47,
    0xf8, 0xbc, 0xe6, 0xe5, 0x63, 0xa4, 0x40, 0xf2,
    0x77, 0x03, 0x7d, 0x81, 0x2d, 0xeb, 0x33, 0xa0,
    0xf4, 0xa1, 0x39, 0x45, 0xd8, 0x98, 0xc2, 0x96,
]

; 基點 Gy（大端序）
; [P256-GY](#ecdsa.p256-gy)
P256-GY [32]byte = [
    0x4f, 0xe3, 0x42, 0xe2, 0xfe, 0x1a, 0x7f, 0x9b,
    0x8e, 0xe7, 0xeb, 0x4a, 0x7c, 0x0f, 0x9e, 0x16,
    0x2b, 0xce, 0x33, 0x57, 0x6b, 0x31, 0x5e, 0xce,
    0xcb, 0xb6, 0x40, 0x68, 0x37, 0xbf, 0x51, 0xf5,
]

; 曲線參數 b
; [P256-B](#ecdsa.p256-b)
P256-B [32]byte = [
    0x4b, 0x60, 0xd2, 0x27, 0x3e, 0x3c, 0xce, 0x3b,
    0xf6, 0xb0, 0x53, 0xcc, 0xb0, 0x06, 0x1d, 0x65,
    0xbc, 0x86, 0x98, 0x76, 0x55, 0xbd, 0xeb, 0xb3,
    0xe7, 0x93, 0x3a, 0xaa, 0xd8, 0x35, 0xc6, 0x5a,
]

; 256-bit 大整數運算（byte 陣列，小端序）
...

; 比較兩個 256-bit 數（小端序）
; 返回: -1 if a < b, 0 if a == b, 1 if a > b
; a: 第一 256-bit 運算元（小端序 32 位元組）
; b: 第二 256-bit 運算元（小端序 32 位元組）
; r: 比較結果（a<b→-1、a==b→0、a>b→1；自最高位元組 31 起比至首個差異）
; [bn-cmp](#ecdsa.bn-cmp)
bn-cmp = (a []byte, b []byte) (r i64) {
    i <- [31..0]: {
        ai = a[i]: {
            ok -> it

            -> 0
        }

        bi = b[i]: {
            ok -> it

            -> 0
        }
        {
            ai > bi -> {
                r = 1
                return
            }

            ai < bi -> {
                r = -1
                return
            }
        }
    }
    r = 0
}

; 256-bit 加法（不帶模約簡）
; 返回 sum [32]byte 和 carry i64
; a: 加數（小端序 32 位元組）
; b: 加數（小端序 32 位元組）
; sum: a + b 之和（不模約簡，溢位部分由 carry 承載）
; carry: 最高位進位（0 或 1）
; [bn-add](#ecdsa.bn-add)
bn-add = (a []byte, b []byte) (sum [32]byte, carry i64) {
    carry = 0
    i <- [0..32): {

        ; ⚠️ 必須先把兩個位元組讀成 i64 再相加。`byte + byte + i64` 的結果
        ; 型別是**左運算元的 byte**（docs/lang/syntax.md〈特例：byte 與 char
        ; 算術〉：byte 算術不產生 option、溢出靜默 2's 補數回繞），所以
        ; 直接寫 `(a[i]) + (b[i]) + carry` 會得到 mod 256 的加和 ——
        ; 200 + 100 → 44，`carry = val >> 8` 恆為 0，整條 P-256 大數加法
        ; 因而不進位（ecdsa 公鑰/簽名/ECDH 全部失配，2026-11-04）。
        av i64 = a[i]: {
            ok -> it

            -> 0
        }

        bv i64 = b[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        val = av + bv + carry

        sum[i] = val & 255
        carry = val >> 8
    }
}

; 256-bit 減法 a - b（不帶模約簡）
; 返回 diff [32]byte 和 borrow i64
; a: 被減數（小端序 32 位元組）
; b: 減數（小端序 32 位元組）
; diff: a - b 之差（不模約簡，借位部分由 borrow 反映）
; borrow: 是否向高位借位（0 或 1）
; [bn-sub](#ecdsa.bn-sub)
bn-sub = (a []byte, b []byte) (diff [32]byte, borrow i64) {
    borrow = 0
    i <- [0..32): {

        ; 同 bn-add：左運算元是 byte 時結果恆為 byte（mod 256 回繞），
        ; `val < 0` 永遠不成立、borrow 恆為 0。先讀成 i64 才有負值可比。
        av i64 = a[i]: {
            ok -> it

            -> 0
        }

        bv i64 = b[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        val = av - bv - borrow

        {
            val < 0 -> {
                {

                    #{overflow=wrap}
                    val-opt = val + 256
                    val-opt: {
                        ok -> val = it

                        ->
                    }
                }
                borrow = 1
            }

            -> borrow = 0
        }

        diff[i] = val
    }
}

; 模約簡 a mod m（重複減法）
; a: 被除數（小端序 32 位元組）
; m: 除數/模（小端序 32 位元組）
; out: a mod m 的餘數（重複減法求得，32 位元組）
; [bn-mod](#ecdsa.bn-mod)
bn-mod = (a []byte, m []byte) (out [32]byte) {
    work [32]byte
    diff [32]byte
    i <- [0..32): {
        {
            work[i] ?= a[i]
        }: {
            err -> _

            -> _
        }
    }

    ; 重複減去 m 直到 work < m
    round <- [0..512): {
        cmp = 0
        cmp = bn-cmp(work, m)
        cmp < 0 -> break
        diff.zero()
        borrow = 0
        diff, borrow = bn-sub(work, m)
        i <- [0..32): {
            work[i]: {
                ok -> it = diff[i]: {
                    ok -> it

                    -> _
                }

                -> _
            }
        }
    }
    i <- [0..32): {
        out[i] = work[i]: {
            ok -> it

            -> _
        }
    }
}

; 模乘 (a * b) mod m，使用 schoolbook 乘法
; a: 被乘數（小端序 32 位元組）
; b: 乘數（小端序 32 位元組）
; m: 模（小端序 32 位元組）。**限制：m 需 ≳ 2^255**（實際只用 P256-P）。
;    約簡是「每個位置一次 q*m 乘減 + ≤4 次單減」的定額校正，殘量必須落在
;    m 的數個倍數之內才會收斂；對 1e9 等級的小模數結果不正確（會留下遠大
;    於 m 的殘量）。小模數請改用 bn-mod 的反覆減法。
; out: (a * b) mod m 結果（32 位元組）
; [bn-mulmod](#ecdsa.bn-mulmod)
bn-mulmod = (a []byte, b []byte, m []byte) (out [32]byte) {

    ; 512-bit 乘積（64 位元組）
    product [64]byte
    e <- product: {
        e: {
            ok -> it = 0

            -> _
        }
    }

    ; Schoolbook 乘法
    i <- [0..32): {
        carry = 0
        j <- [0..32): {

            #{overflow=wrap}
            idx = i + j

            ; byte 是回繞型別（見 bn-add 註解）：最左操作數先讀成 i64，
            ; 否則 `a[i] * b[j]` 只算到 mod 256，加法也帶不出進位。
            pv i64 = product[idx]: {
                ok -> it

                -> 0
            }

            av i64 = a[i]: {
                ok -> it

                -> 0
            }

            ixout268c31 i64 = b[j]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            val = pv + av * (ixout268c31) + carry

            product[idx]: {
                ok -> it = val & 255

                -> _
            }
            carry = val >> 8
        }

        ; 傳播進位
        #{overflow=wrap}
        idx = i + 32
        (idx < 64 && carry != 0) {
            pv2 i64 = product[idx]: {
                ok -> it

                -> 0
            }

            {

                #{overflow=wrap}
                val-opt2 = pv2 + carry
                val-opt2: {
                    ok -> val = it

                    ->
                }
            }

            product[idx]: {
                ok -> it = val & 255

                -> _
            }
            carry = val >> 8

            #{overflow=wrap}
            idx = idx + 1
        }
    }

    ; 規約 mod m（處理 512-bit → 256-bit）
    ; 將高 256 位逐次減去 m 的適當倍數
    ; 簡化方法：重複減法（高位部分）
    work [64]byte
    i <- [0..64): {
        work[i]: {
            ok -> it = product[i]: {
                ok -> it

                -> _
            }

            -> _
        }
    }

    ; 從高位開始，每次減去 m << (bit_pos)
    bit = 511
    (bit >= 256) {

        ; 檢查 work 的第 bit 位元
        #{overflow=wrap}
        byte-idx = bit / 8
        bit-idx = bit % 8

        ixout325c14 = work[byte-idx]: {
            ok -> it

            -> _
        }

        (ixout325c14 >> bit-idx) & 1 == 1 -> {

            ; 減去 m << (bit - 256)
            #{overflow=wrap}
            shift = bit - 256
            shifted [64]byte

            ; m << shift
            i <- [0..32): {
                src-byte = i
                _ = (i * 8 + shift) / 8
                ; 簡化：只在 byte 邊界對齊時處理
            }
            ; 由於位元級移位複雜，使用更簡單的方法
            ; 直接從高 32 位元組開始減法
        }

        {

            #{overflow=wrap}
            bit-opt = bit - 1
            bit-opt: {
                ok -> bit = it

                ->
            }
        }
    }

    ; 更簡單的方法：將 64 位元組分為高低兩半
    ; result = low + high * 2^256 mod m
    ; 由於 2^256 mod m 可以預計算，這裡用簡化方法
    ; 從最高位元組開始減
    ; 每次嘗試減去 m * 2^(shift)
    ; 注意：64 位元組乘積最高可達 2^512-1，必須從 shift-byte=32
    ; （窗 acc[32..63]，涵蓋 byte 63 / bit 504..511）開始，
    ; 否則最高位元組永遠不會被規約，結果錯誤。
    ; 迴圈條件 > 0 + 頂部先 -1，因此實際會處理到 shift-byte=0（窗 work[0..31]），
    ; 確保結果 < m。
    ; ── 高效率模約簡（取代逐次減 m）──
    ; 對每個高位元組位置 pos（32..0）：以「商估計 q = hi」一次性減去 q*m
    ; （hi = work[pos+32] 代表 hi*2^256 項），再以 ≤2 次單次減 m 校正到
    ; 窗口 < m。相較於逐次減 m（每位置最多約 254 次），此做法每位置僅
    ; O(32) 位元組運算，把單次約簡從 O(256n) 降到 O(n)。
    pos = 32
    (pos >= 0) {

        ; hi = work[pos+32]（越界視為 0）
        hi = 0
        (pos + 32 < 64) -> {

            #{overflow=wrap}
            hi = work[pos + 32]: {
                ok -> it

                -> 0
            }
        }

        ; 一次乘減：work[pos..pos+32] -= hi * m
        (hi != 0) -> {
            prod [33]byte
            carry = 0
            i <- [0..32): {
                mi = m[i]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                t = (hi) * (mi) + carry

                prod[i]: {
                    ok -> it = t & 255

                    -> _
                }

                carry = t >> 8
            }
            prod[32]: {
                ok -> it = carry & 255

                -> _
            }

            borrow = 0
            i <- [0..33): {

                #{overflow=wrap}
                idx = pos + i
                (idx < 64) -> {
                    pi = prod[i]: {
                        ok -> it

                        -> 0
                    }

                    ; byte 回繞：最左操作數先讀成 i64，否則 `val < 0` 永不成立
                    wv i64 = work[idx]: {
                        ok -> it

                        -> 0
                    }

                    {

                        #{overflow=wrap}
                        val-opt3 = wv - pi - borrow
                        val-opt3: {
                            ok -> val = it

                            ->
                        }
                    }
                    {
                        val < 0 -> {
                            {

                                #{overflow=wrap}
                                val-opt4 = val + 256
                                val-opt4: {
                                    ok -> val = it

                                    ->
                                }
                            }
                            borrow = 1
                        }

                        -> borrow = 0
                    }
                    work[idx]: {
                        ok -> it = val

                        -> _
                    }
                }
            }
        }

        ; 校正：33 位元組值 [pos..pos+32] >= m 就再減 m（通常 ≤1 次）
        corr = 0
        (corr < 4) {
            chi = 0
            (pos + 32 < 64) -> {

                #{overflow=wrap}
                chi = work[pos + 32]: {
                    ok -> it

                    -> 0
                }
            }
            ge = 0
            (chi != 0) -> {
                ge = 1
            }
            (chi == 0) -> {
                ge = 1
                j <- [31..0]: {

                    #{overflow=wrap}
                    wj = work[pos + j]: {
                        ok -> it

                        -> 0
                    }

                    mj = m[j]: {
                        ok -> it

                        -> 0
                    }
                    {
                        wj > mj -> break

                        wj < mj -> {
                            ge = 0
                            break
                        }
                    }
                }
            }
            (ge == 1) -> {
                borrow = 0
                j <- [0..32): {

                    #{overflow=wrap}
                    idx = pos + j

                    wv i64 = work[idx]: {
                        ok -> it

                        -> 0
                    }

                    ixout495c34 = m[j]: {
                        ok -> it

                        -> _
                    }

                    #{overflow=wrap}
                    val = wv - (ixout495c34) - borrow
                    {
                        val < 0 -> {
                            {

                                #{overflow=wrap}
                                val-opt5 = val + 256
                                val-opt5: {
                                    ok -> val = it

                                    ->
                                }
                            }
                            borrow = 1
                        }

                        -> borrow = 0
                    }
                    work[idx]: {
                        ok -> it = val

                        -> _
                    }
                }
                (borrow != 0) {
                    {
                        idx-opt = pos + 32
                        idx-opt: {
                            ok -> idx = it

                            ->
                        }
                    }
                    (idx < 64) {
                        wv i64 = work[idx]: {
                            ok -> it

                            -> 0
                        }

                        {

                            #{overflow=wrap}
                            val-opt6 = wv - borrow
                            val-opt6: {
                                ok -> val = it

                                ->
                            }
                        }
                        {
                            val < 0 -> {
                                {

                                    #{overflow=wrap}
                                    val-opt7 = val + 256
                                    val-opt7: {
                                        ok -> val = it

                                        ->
                                    }
                                }
                                borrow = 1
                            }

                            -> borrow = 0
                        }
                        work[idx]: {
                            ok -> it = val

                            -> _
                        }

                        {

                            #{overflow=wrap}
                            idx-opt2 = idx + 1
                            idx-opt2: {
                                ok -> idx = it

                                ->
                            }
                        }
                    }
                }
            }
            (ge == 0) -> {
                corr = 4
            }

            {

                #{overflow=wrap}
                corr-opt = corr + 1
                corr-opt: {
                    ok -> corr = it

                    ->
                }
            }
        }

        {

            #{overflow=wrap}
            pos-opt = pos - 1
            pos-opt: {
                ok -> pos = it

                ->
            }
        }
    }
    i <- [0..32): {
        out[i] = work[i]: {
            ok -> it

            -> _
        }
    }
}

; 模加 (a + b) mod m
; a, b < m (m 為 256-bit 模數，通常 m ≈ 2^256)
; 關鍵：a + b 可能 >= 2^256，會產生進位。此時真實值為
;   (a + b) = 2^256 + sum_low，而 (a+b) mod m = (sum_low + (2^256 mod m)) mod m。
; 若只用 bn-mod(sum_low, m) 會少算 2^256 mod m 那一項，結果錯誤。
; 這裡將 (a+b) 視為最多 33 位元組的數（含進位），放入 64 位元組空間，
; 並與 bn-mulmod 共用「從高位元組開始減去 m<<(k*8)」的規約邏輯。
; a: 加數（小端序 32 位元組，須 < m）
; b: 加數（小端序 32 位元組，須 < m）
; m: 模（256-bit 小端序 32 位元組）
; out: (a + b) mod m 結果（含 2^256 進位項，32 位元組）
; [bn-addmod](#ecdsa.bn-addmod)
bn-addmod = (a []byte, b []byte, m []byte) (out [32]byte) {
    s [32]byte
    carry = 0
    s, carry = bn-add(a, b)
    acc [64]byte
    i <- [0..32): {
        acc[i]: {
            ok -> it = s[i]: {
                ok -> it

                -> _
            }

            -> _
        }
    }
    acc[32]: {
        ok -> it = carry & 255

        -> _
    }
    i <- [33..64): {
        acc[i]: {
            ok -> it = 0

            -> _
        }
    }

    ; 規約：從 shift-byte=32 開始（窗 acc[32..63]），一路減到 0
    ; （迴圈條件 > 0 + 頂部先 -1，故實際會處理到 shift-byte=0）
    shift-byte = 33
    (shift-byte > 0) {
        {

            #{overflow=wrap}
            shift-byte-opt = shift-byte - 1
            shift-byte-opt: {
                ok -> shift-byte = it

                ->
            }
        }

        ; 嘗試在 acc[shift-byte..shift-byte+32) 處減去 m
        ; 同 bn-mulmod：真實值為 floor(acc / 256^shift_byte)，佔位元組
        ; [shift_byte .. 63]；上方位元組 acc[shift-byte+32] 非 0 時必須強制減。
        ; 經高位處理後 [shift-byte+33 .. 63] 必為 0，只需檢查此一位元組。
        can-sub = 1
        hi = 0
        (shift-byte + 32 < 64) -> {

            #{overflow=wrap}
            hi = acc[shift-byte + 32]: {
                ok -> it

                -> 0
            }
        }
        i <- [31..0]: {
            wi = 0

            #{overflow=wrap}
            shift-byte + i < 64 -> {

                #{overflow=wrap}
                wi = acc[shift-byte + i]: {
                    ok -> it

                    -> 0
                }
            }

            mi = m[i]: {
                ok -> it

                -> 0
            }
            {
                wi > mi -> break

                wi < mi -> {
                    (hi == 0) -> {
                        can-sub = 0
                    }
                    break
                }
            }
        }
        can-sub == 1 -> {
            borrow = 0
            i <- [0..32): {

                #{overflow=wrap}
                idx = shift-byte + i
                {
                    idx < 64 -> {
                        av i64 = acc[idx]: {
                            ok -> it

                            -> 0
                        }

                        ixout661c38 i64 = m[i]: {
                            ok -> it

                            -> _
                        }

                        #{overflow=wrap}
                        val = av - (ixout661c38) - borrow
                        {
                            val < 0 -> {
                                {

                                    #{overflow=wrap}
                                    val-opt8 = val + 256
                                    val-opt8: {
                                        ok -> val = it

                                        ->
                                    }
                                }
                                borrow = 1
                            }

                            -> borrow = 0
                        }

                        acc[idx]: {
                            ok -> it = val

                            -> _
                        }
                    }

                    -> {
                        borrow != 0 -> {
                            av i64 = acc[idx]: {
                                ok -> it

                                -> 0
                            }

                            {

                                #{overflow=wrap}
                                val-opt9 = av - borrow
                                val-opt9: {
                                    ok -> val = it

                                    ->
                                }
                            }
                            {
                                val < 0 -> {
                                    {

                                        #{overflow=wrap}
                                        val-opt10 = val + 256
                                        val-opt10: {
                                            ok -> val = it

                                            ->
                                        }
                                    }
                                    borrow = 1
                                }

                                -> borrow = 0
                            }

                            acc[idx]: {
                                ok -> it = val

                                -> _
                            }
                        }
                    }
                }
            }

            ; 傳播最後的借位到上位元組（強制減時窗口可能 < m 而產生借位）
            (borrow != 0) {
                {
                    idx-opt3 = shift-byte + 32
                    idx-opt3: {
                        ok -> idx = it

                        ->
                    }
                }
                (idx < 64) {
                    av i64 = acc[idx]: {
                        ok -> it

                        -> 0
                    }

                    {

                        #{overflow=wrap}
                        val-opt11 = av - borrow
                        val-opt11: {
                            ok -> val = it

                            ->
                        }
                    }
                    {
                        val < 0 -> {
                            {

                                #{overflow=wrap}
                                val-opt12 = val + 256
                                val-opt12: {
                                    ok -> val = it

                                    ->
                                }
                            }
                            borrow = 1
                        }

                        -> borrow = 0
                    }
                    acc[idx]: {
                        ok -> it = val

                        -> _
                    }

                    {

                        #{overflow=wrap}
                        idx-opt4 = idx + 1
                        idx-opt4: {
                            ok -> idx = it

                            ->
                        }
                    }
                }
            }

            {

                #{overflow=wrap}
                shift-byte-opt2 = shift-byte + 1
                shift-byte-opt2: {
                    ok -> shift-byte = it

                    ->
                }
            }
        }
    }
    i <- [0..32): {
        out[i] = acc[i]: {
            ok -> it

            -> _
        }
    }
}

; 模減 (a - b) mod m
; a: 被減數（小端序 32 位元組，須 < m）
; b: 減數（小端序 32 位元組，須 < m）
; m: 模（小端序 32 位元組）
; out: (a - b) mod m 結果（為負時回加 m，32 位元組）
; [bn-submod](#ecdsa.bn-submod)
bn-submod = (a []byte, b []byte, m []byte) (out [32]byte) {
    cmp = 0
    cmp = bn-cmp(a, b)
    {
        cmp >= 0 -> {
            diff [32]byte
            borrow = 0
            diff, borrow = bn-sub(a, b)
            i <- [0..32): {
                out[i] = diff[i]: {
                    ok -> it

                    -> _
                }
            }
        }

        -> {

            ; a < b: result = (a - b) mod m = m - (b - a)
            ; 此時 0 < (b - a) < m（因 a, b 皆已約簡至 [0, m)），
            ; 故 m > (b - a)，bn-sub(m, diff) 直接給出正確值，無借位問題。
            diff [32]byte
            borrow = 0
            diff, borrow = bn-sub(b, a)
            out, borrow = bn-sub(m, diff)
        }
    }
}

; 模逆 a^(-1) mod m，使用擴展歐幾里得算法
; 簡化版本：使用費馬小定理 a^(m-2) mod m（僅當 m 為素數時）
; a: 求逆元（小端序 32 位元組，須與 m 互質）
; m: 模（此簡化版用費馬小定理，須為素數；小端序 32 位元組）
; out: a 的模乘法逆元 a^(-1) mod m（32 位元組）
; [bn-invmod](#ecdsa.bn-invmod)
bn-invmod = (a []byte, m []byte) (out [32]byte) {

    ; 計算 a^(m-2) mod m 使用平方-乘法
    ; m-2
    exp [32]byte
    borrow = 0
    exp, borrow = bn-sub(m, [
        0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    ])

    ; result = 1
    result [32]byte
    result[0]: {
        ok -> it = 1

        -> _
    }
    i <- [1..32): {
        result[i]: {
            ok -> it = 0

            -> _
        }
    }

    ; base = a mod m
    base [32]byte
    base = bn-mod(a, m)

    ; 平方-乘法（從低位到高位）
    bit <- [0..256): {

        #{overflow=wrap}
        byte-idx = bit / 8
        bit-idx = bit % 8
        ixout831c13 = exp[byte-idx]: {
            ok -> it

            -> _
        }

        (ixout831c13 >> bit-idx) & 1 == 1 -> {
            result = bn-mulmod(result, base, m)
        }
        base = bn-mulmod(base, base, m)
    }
    i <- [0..32): {
        out[i] = result[i]: {
            ok -> it

            -> _
        }
    }
}

; 橢圓曲線點運算（Jacobian 座標）
; 點表示: (X, Y, Z) 其中 x = X/Z², y = Y/Z³
; 使用 3×32 = 96 位元組陣列
...

; 點倍乘 R = 2*P（Jacobian 座標）
; p []byte: 輸入點 (X, Y, Z)，各 32 位元組
; 返回 r []byte: 輸出點 (X, Y, Z)，96 位元組
; [ec-point-double](#ecdsa.ec-point-double)
ec-point-double = (p []byte) (r []byte) {

    ; 如果 Y == 0，返回無窮遠點
    is-zero = 1
    i <- [0..32): {

        #{overflow=wrap}
        ixout858c10 = p[32 + i]: {
            ok -> it

            -> _
        }

        ixout858c10 != 0 -> {
            is-zero = 0
        }
    }
    is-zero == 1 -> {
        i <- [0..96): {
            r[i] = 0
        }
        return
    }

    ; a = -3 for P-256
    ; 使用公式: 對 a=-3 的曲線優化
    ; S = 4 * X * Y²
    ; M = 3 * (X - Z²) * (X + Z²)
    ; X' = M² - 2*S
    ; Y' = M * (S - X') - 8 * Y⁴
    ; Z' = 2 * Y * Z
    x = p[0..32]
    y = p[32..64]
    z = p[64..96]

    ; Z²
    z2 [32]byte
    z2 = bn-mulmod(z, z, P256-P)

    ; X - Z²
    x-mz2 [32]byte
    x-mz2 = bn-submod(x, z2, P256-P)

    ; X + Z²
    x-pz2 [32]byte
    x-pz2 = bn-addmod(x, z2, P256-P)

    ; M = 3 * (X-Z²) * (X+Z²)   （a = -3 曲線的 Jacobian 倍點公式）
    ; 注意：M 必須是 3 倍，不是 4 倍！
    m [32]byte
    m = bn-mulmod(x-mz2, x-pz2, P256-P)
    m2 [32]byte
    m2 = bn-addmod(m, m, P256-P)
    m = bn-addmod(m2, m, P256-P)

    ; Y²
    y2 [32]byte
    y2 = bn-mulmod(y, y, P256-P)

    ; S = 4 * X * Y²
    s [32]byte
    s = bn-mulmod(x, y2, P256-P)
    s = bn-addmod(s, s, P256-P)
    s = bn-addmod(s, s, P256-P)

    ; Y⁴
    y4 [32]byte
    y4 = bn-mulmod(y2, y2, P256-P)

    ; X' = M² - 2*S
    m-sq [32]byte
    m-sq = bn-mulmod(m, m, P256-P)
    x3 [32]byte
    x3 = bn-submod(m-sq, s, P256-P)
    x3 = bn-submod(x3, s, P256-P)

    ; Y' = M * (S - X') - 8 * Y⁴
    s-mx3 [32]byte
    s-mx3 = bn-submod(s, x3, P256-P)
    y3 [32]byte
    y3 = bn-mulmod(m, s-mx3, P256-P)

    ; 8 * Y⁴
    y4-8 [32]byte
    y4-8 = bn-addmod(y4, y4, P256-P)
    y4-8 = bn-addmod(y4-8, y4-8, P256-P)
    y4-8 = bn-addmod(y4-8, y4-8, P256-P)
    y3 = bn-submod(y3, y4-8, P256-P)

    ; Z' = 2 * Y * Z
    z3 [32]byte
    z3 = bn-mulmod(y, z, P256-P)
    z3 = bn-addmod(z3, z3, P256-P)

    ; 輸出
    i <- [0..32): {
        r[i] = x3[i]: {
            ok -> it

            -> _
        }

        {

            #{overflow=wrap}
            r[32 + i] ?= y3[i]
        }: {
            err -> _

            -> _
        }

        {

            #{overflow=wrap}
            r[64 + i] ?= z3[i]
        }: {
            err -> _

            -> _
        }
    }
}

; 點加法 R = P + Q（P 在 Jacobian，Q 在 Jacobian）
; 返回 r []byte: 96 位元組
; p: 加數點（Jacobian 座標，96 位元組 X‖Y‖Z 小端序）
; q: 被加點（Jacobian 座標，96 位元組）
; [ec-point-add](#ecdsa.ec-point-add)
ec-point-add = (p []byte, q []byte) (r []byte) {
    x1 = p[0..32]
    y1 = p[32..64]
    z1 = p[64..96]
    x2 = q[0..32]
    y2 = q[32..64]
    z2 = q[64..96]

    ; 檢查 P 是否為無窮遠點
    p-inf = 1
    i <- [0..96): {
        ixout967c10 = p[i]: {
            ok -> it

            -> _
        }

        ixout967c10 != 0 -> {
            p-inf = 0
        }
    }
    p-inf == 1 -> {
        i <- [0..96): {
            {
                r[i] ?= q[i]
            }: {
                err -> _

                -> _
            }
        }
        return
    }

    ; 檢查 Q 是否為無窮遠點
    q-inf = 1
    i <- [0..96): {
        ixout992c10 = q[i]: {
            ok -> it

            -> _
        }

        ixout992c10 != 0 -> {
            q-inf = 0
        }
    }
    q-inf == 1 -> {
        i <- [0..96): {
            {
                r[i] ?= p[i]
            }: {
                err -> _

                -> _
            }
        }
        return
    }

    ; Z1², Z2²
    z1-2 [32]byte
    z1-2 = bn-mulmod(z1, z1, P256-P)
    z2-2 [32]byte
    z2-2 = bn-mulmod(z2, z2, P256-P)

    ; Z1³, Z2³
    z1-3 [32]byte
    z1-3 = bn-mulmod(z1-2, z1, P256-P)
    z2-3 [32]byte
    z2-3 = bn-mulmod(z2-2, z2, P256-P)

    ; U2 = X2 * Z1²
    u2 [32]byte
    u2 = bn-mulmod(x2, z1-2, P256-P)

    ; S2 = Y2 * Z1³
    s2 [32]byte
    s2 = bn-mulmod(y2, z1-3, P256-P)

    ; U1 = X1 * Z2²
    u1 [32]byte
    u1 = bn-mulmod(x1, z2-2, P256-P)

    ; S1 = Y1 * Z2³
    s1 [32]byte
    s1 = bn-mulmod(y1, z2-3, P256-P)

    ; H = U2 - U1
    h [32]byte
    h = bn-submod(u2, u1, P256-P)

    ; R = S2 - S1
    rr [32]byte
    rr = bn-submod(s2, s1, P256-P)

    ; 如果 H == 0:
    ;   如果 R == 0: return 2*P
    ;   否則: return infinity
    h-is-zero = 1
    i <- [0..32): {
        ixout1055c10 = h[i]: {
            ok -> it

            -> _
        }

        ixout1055c10 != 0 -> {
            h-is-zero = 0
        }
    }
    h-is-zero == 1 -> {
        r-is-zero = 1
        i <- [0..32): {
            ixout1062c15 = rr[i]: {
                ok -> it

                -> _
            }

            ixout1062c15 != 0 -> {
                r-is-zero = 0
            }
        }
        {
            r-is-zero == 1 -> {
                r = ec-point-double(p)
                return
            }

            -> {
                i <- [0..96): {
                    r[i]: {
                        ok -> it = 0

                        -> _
                    }
                }
                return
            }
        }
    }

    ; H²
    h2 [32]byte
    h2 = bn-mulmod(h, h, P256-P)

    ; H³
    h3 [32]byte
    h3 = bn-mulmod(h2, h, P256-P)

    ; U1 * H²
    u1h2 [32]byte
    u1h2 = bn-mulmod(u1, h2, P256-P)

    ; X3 = R² - H³ - 2 * U1 * H²
    r2 [32]byte
    r2 = bn-mulmod(rr, rr, P256-P)
    x3 [32]byte
    x3 = bn-submod(r2, h3, P256-P)
    x3 = bn-submod(x3, u1h2, P256-P)
    x3 = bn-submod(x3, u1h2, P256-P)

    ; Y3 = R * (U1*H² - X3) - S1 * H³
    y3 [32]byte
    y3 = bn-submod(u1h2, x3, P256-P)
    y3 = bn-mulmod(rr, y3, P256-P)
    s1h3 [32]byte
    s1h3 = bn-mulmod(s1, h3, P256-P)
    y3 = bn-submod(y3, s1h3, P256-P)

    ; Z3 = H * Z1 * Z2
    z3 [32]byte
    z3 = bn-mulmod(h, z1, P256-P)
    z3 = bn-mulmod(z3, z2, P256-P)
    i <- [0..32): {
        r[i]: {
            ok -> it = x3[i]: {
                ok -> it

                -> _
            }

            -> _
        }

        #{overflow=wrap}
        r[32 + i]: {
            ok -> it = y3[i]: {
                ok -> it

                -> _
            }

            -> _
        }

        #{overflow=wrap}
        r[64 + i]: {
            ok -> it = z3[i]: {
                ok -> it

                -> _
            }

            -> _
        }
    }
}

; 純量乘法 R = k * P
; k [32]byte: 純量
; p []byte: 點 (96 位元組)
; 返回 r []byte: 96 位元組
; [ec-scalar-mult](#ecdsa.ec-scalar-mult)
ec-scalar-mult = (k [32]byte, p []byte) (r []byte) {

    ; R = 無窮遠點
    i <- [0..96): {
        r[i] = 0
    }

    ; 從高位到低位進行 double-and-add
    bit = 255
    (bit >= 0) {

        ; R = 2*R
        tmp []byte
        tmp = ec-point-double(r)
        i <- [0..96): {
            r[i] = tmp[i]: {
                ok -> it

                -> _
            }
        }

        ; 如果 bit 為 1，R = R + P
        #{overflow=wrap}
        byte-idx = bit / 8
        bit-idx = bit % 8
        ixout1174c11 = k[byte-idx]: {
            ok -> it

            -> _
        }

        (ixout1174c11 >> bit-idx) & 1 == 1 -> {
            tmp = ec-point-add(r, p)
            i <- [0..96): {
                r[i] = tmp[i]: {
                    ok -> it

                    -> _
                }
            }
        }

        {

            #{overflow=wrap}
            bit-opt2 = bit - 1
            bit-opt2: {
                ok -> bit = it

                ->
            }
        }
    }
}

; 將 Jacobian 座標轉為未壓縮編碼
; p []byte: Jacobian 點 (96 位元組)
; 返回 out [65]byte: 04 || x || y
; [ec-point-to-bytes](#ecdsa.ec-point-to-bytes)
ec-point-to-bytes = (p []byte) (out [65]byte) {

    ; 先把輸出清零：無窮遠點（Z=0）走下面的提前 return，若不預清就會把
    ; 未初始化的固定陣列內容當成編碼回傳（曾觀測到 `0421 0000…` 這類殘留）。
    i <- [0..65): {
        out[i]: {
            ok -> it = 0

            -> _
        }
    }

    px = p[0..32]
    py = p[32..64]
    pz = p[64..96]

    ; 檢查無窮遠點
    z-is-zero = 1
    i <- [0..32): {
        ixout1205c11 = pz[i]: {
            ok -> it

            -> _
        }

        ixout1205c11 != 0 -> {
            z-is-zero = 0
        }
    }
    z-is-zero == 1 -> {

        ; 返回全零
        return
    }

    ; Z²
    z2 [32]byte
    z2 = bn-mulmod(pz, pz, P256-P)

    ; Z³
    z3 [32]byte
    z3 = bn-mulmod(z2, pz, P256-P)

    ; Z²的逆
    z2-inv [32]byte
    z2-inv = bn-invmod(z2, P256-P)

    ; Z³的逆
    z3-inv [32]byte
    z3-inv = bn-invmod(z3, P256-P)

    ; x = X * (Z²)^(-1)
    x [32]byte
    x = bn-mulmod(px, z2-inv, P256-P)

    ; y = Y * (Z³)^(-1)
    y [32]byte
    y = bn-mulmod(py, z3-inv, P256-P)

    ; 輸出: 04 || x || y（大端序）
    out[0] = 4
    i <- [0..32): {
        {

            #{overflow=wrap}
            out[1 + i] ?= x[31 - i]
        }: {
            err -> _

            -> _
        }

        {

            #{overflow=wrap}
            out[33 + i] ?= y[31 - i]
        }: {
            err -> _

            -> _
        }
    }
}

; 將未壓縮編碼轉為 Jacobian 座標
; in [65]byte: 04 || x || y（大端序）
; 返回 out []byte: 96 位元組
; [ec-bytes-to-point](#ecdsa.ec-bytes-to-point)
ec-bytes-to-point = (in [65]byte) (out []byte) {
    out = with-len(96)

    ; 提取 x, y（轉為小端序）
    x [32]byte
    y [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            x[i] ?= in[1 + 31 - i]
        }: {
            err -> _

            -> _
        }

        {

            #{overflow=wrap}
            y[i] ?= in[33 + 31 - i]
        }: {
            err -> _

            -> _
        }
    }

    ; Jacobian: (X, Y, Z) = (x, y, 1)
    i <- [0..32): {
        out[i] = x[i]: {
            ok -> it

            -> _
        }

        {

            #{overflow=wrap}
            out[32 + i] ?= y[i]
        }: {
            err -> _

            -> _
        }
    }
    out[64] = 1
    i <- [1..32): {

        #{overflow=wrap}
        out[64 + i] = 0
    }
}

; 基點
...

; 獲取基點 G 的 Jacobian 座標
; g: 基點 G 的 Jacobian 座標（96 位元組：X‖Y‖Z，各 32 位元組小端序）
; [ec-get-basepoint](#ecdsa.ec-get-basepoint)
ec-get-basepoint = () (g []byte) {

    ; Gx, Gy 轉為小端序
    i <- [0..32): {

        #{overflow=wrap}
        g[i] = P256-GX[31 - i]

        #{overflow=wrap}
        g[32 + i] = P256-GY[31 - i]
    }

    ; Z = 1
    g[64] = 1
    i <- [1..32): {

        #{overflow=wrap}
        g[64 + i] = 0
    }
}

; ECDSA 公開 API
...

; P-256 (secp256r1) ECDH 共享秘密
; priv [32]byte: 我方私鑰（大端序）
; peer [65]byte: 對端未壓縮公鑰（04 || x || y）
; 返回 shared []byte: 共享秘密（R 點之 x 座標, 32 bytes 大端序）；空=無效輸入
; [ecdh-p256](#ecdsa.ecdh-p256)
ecdh-p256 = (priv [32]byte, peer [65]byte) (shared []byte) {

    ; 將私鑰轉為小端序（內部點運算使用小端序純量）
    k [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            k[i] ?= priv[31 - i]
        }: {
            err -> _

            -> _
        }
    }

    ; 對端點解碼為 Jacobian 座標
    p []byte
    p = ec-bytes-to-point(peer)

    ; R = k * P
    r []byte
    r = ec-scalar-mult(k, p)

    ; R 轉為未壓縮編碼（無窮遠點/無效點時首位元組不為 04）
    enc [65]byte
    enc = ec-point-to-bytes(r)
    ixout1387c8 = enc[0]: {
        ok -> it

        -> _
    }

    ixout1387c8 != 4 -> return

    ; 提取 x 座標（大端序）
    shared = with-len(32)
    i <- [0..32): {

        #{overflow=wrap}
        shared[i] = enc[1 + i]: {
            ok -> it

            -> _
        }
    }
}

; 從私鑰計算公鑰
; priv [32]byte: 私鑰（大端序）
; 返回 pub [65]byte: 未壓縮公鑰（04 || x || y）
; [ecdsa-publickey](#ecdsa.ecdsa-publickey)
ecdsa-publickey = (priv [32]byte) (pub [65]byte) {

    ; 將私鑰轉為小端序
    k [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            k[i] ?= priv[31 - i]
        }: {
            err -> _

            -> _
        }
    }

    ; G = 基點
    g []byte
    g = ec-get-basepoint()

    ; Q = k * G
    q []byte
    q = ec-scalar-mult(k, g)

    ; 編碼為未壓縮格式
    pub = ec-point-to-bytes(q)
}

; ECDSA 簽名
; priv [32]byte: 私鑰（大端序）
; msg []byte: 待簽名原文（內部先做 SHA-256 再簽，非預哈希輸入）
; 返回 sig [64]byte: 簽名（r || s，各 32 位元組，大端序）
; [ecdsa-sign](#ecdsa.ecdsa-sign)
ecdsa-sign = (priv [32]byte, msg []byte) (sig [64]byte) {

    ; 計算哈希 h = SHA-256(msg)
    h [32]byte
    h = sha256.sha256(msg)

    ; 將哈希轉為小端序
    h-le [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            h-le[i] ?= h[31 - i]
        }: {
            err -> _

            -> _
        }
    }

    ; 私鑰轉小端序
    d [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            d[i] ?= priv[31 - i]
        }: {
            err -> _

            -> _
        }
    }

    ; 使用私鑰作為隨機數種子生成 k（簡化，生產環境應使用 RFC 6979）
    k [32]byte
    state = 0
    i <- [0..32): {
        ixout1493c44 = d[i]: {
            ok -> it

            -> _
        }

        ixout1493c54 = h-le[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        state, rand-r = rand.rand(state + ixout1493c44 + ixout1493c54 + i)

        k[i]: {
            ok -> it = state & 255

            -> _
        }
    }

    ; 確保 k 在 [1, n-1] 範圍內
    k = bn-mod(k, P256-N)
    ixout1504c6 = k[0]: {
        ok -> it

        -> _
    }

    ixout1504c6 == 0 -> {
        all-zero = 1
        i <- [1..32): {
            ixout1507c14 = k[i]: {
                ok -> it

                -> _
            }

            ixout1507c14 != 0 -> {
                all-zero = 0
            }
        }
        all-zero == 1 -> {
            k[0]: {
                ok -> it = 1

                -> _
            }
        }
    }

    ; R = k * G
    g []byte
    g = ec-get-basepoint()
    r-point []byte
    r-point = ec-scalar-mult(k, g)

    ; r = R.x mod n
    r-point-bytes [65]byte
    r-point-bytes = ec-point-to-bytes(r-point)

    ; 提取 x（大端序 → 小端序）
    rx [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            rx[i] ?= r-point-bytes[1 + 31 - i]
        }: {
            err -> _

            -> _
        }
    }
    r-val [32]byte
    r-val = bn-mod(rx, P256-N)

    ; s = k^(-1) * (h + r * d) mod n
    k-inv [32]byte
    k-inv = bn-invmod(k, P256-N)
    rd [32]byte
    rd = bn-mulmod(r-val, d, P256-N)
    h-rd [32]byte
    h-rd = bn-addmod(h-le, rd, P256-N)
    s-val [32]byte
    s-val = bn-mulmod(k-inv, h-rd, P256-N)

    ; 輸出（大端序）
    i <- [0..32): {

        #{overflow=wrap}
        sig[i] = r-val[31 - i]: {
            ok -> it

            -> _
        }

        {

            #{overflow=wrap}
            sig[32 + i] ?= s-val[31 - i]
        }: {
            err -> _

            -> _
        }
    }
}

; ECDSA 驗簽
; pub [65]byte: 公鑰
; msg []byte: 待驗簽原文（內部先做 SHA-256，需與簽名時一致）
; sig [64]byte: 簽名（r || s）
; 返回 ok i64: 1=有效, 0=無效
; [ecdsa-verify](#ecdsa.ecdsa-verify)
ecdsa-verify = (pub [65]byte, msg []byte, sig [64]byte) (ok i64) {

    ; 提取 r, s（大端序 → 小端序）
    r-val [32]byte
    s-val [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            r-val[i] ?= sig[31 - i]
        }: {
            err -> _

            -> _
        }

        {

            #{overflow=wrap}
            s-val[i] ?= sig[32 + 31 - i]
        }: {
            err -> _

            -> _
        }
    }

    ; 檢查 r, s ∈ [1, n-1]
    ; r != 0
    r-zero = 1
    i <- [0..32): {
        ixout1628c14 = r-val[i]: {
            ok -> it

            -> _
        }

        ixout1628c14 != 0 -> {
            r-zero = 0
        }
    }
    r-zero == 1 -> {
        ok = 0
        return
    }

    ; s != 0
    s-zero = 1
    i <- [0..32): {
        ixout1640c14 = s-val[i]: {
            ok -> it

            -> _
        }

        ixout1640c14 != 0 -> {
            s-zero = 0
        }
    }
    s-zero == 1 -> {
        ok = 0
        return
    }
    bn-cmp(r-val, P256-N) >= 0 -> {
        ok = 0
        return
    }

    ; s < n
    bn-cmp(s-val, P256-N) >= 0 -> {
        ok = 0
        return
    }

    ; h = SHA-256(msg)
    h [32]byte
    h = sha256.sha256(msg)
    h-le [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            h-le[i] ?= h[31 - i]
        }: {
            err -> _

            -> _
        }
    }

    ; w = s^(-1) mod n
    w [32]byte
    w = bn-invmod(s-val, P256-N)

    ; u1 = h * w mod n
    u1 [32]byte
    u1 = bn-mulmod(h-le, w, P256-N)

    ; u2 = r * w mod n
    u2 [32]byte
    u2 = bn-mulmod(r-val, w, P256-N)

    ; Q = 公鑰點
    q []byte
    q = ec-bytes-to-point(pub)

    ; R1 = u1 * G
    g []byte
    g = ec-get-basepoint()
    r1 []byte
    r1 = ec-scalar-mult(u1, g)

    ; R2 = u2 * Q
    r2 []byte
    r2 = ec-scalar-mult(u2, q)

    ; R = R1 + R2
    r-point []byte
    r-point = ec-point-add(r1, r2)

    ; 檢查 R 是否為無窮遠點
    r-inf = 1
    i <- [0..96): {
        ixout1712c16 = r-point[i]: {
            ok -> it

            -> _
        }

        ixout1712c16 != 0 -> {
            r-inf = 0
        }
    }
    r-inf == 1 -> {
        ok = 0
        return
    }

    ; v = R.x mod n
    r-point-bytes [65]byte
    r-point-bytes = ec-point-to-bytes(r-point)
    rx [32]byte
    i <- [0..32): {
        {

            #{overflow=wrap}
            rx[i] ?= r-point-bytes[1 + 31 - i]
        }: {
            err -> _

            -> _
        }
    }
    v [32]byte
    v = bn-mod(rx, P256-N)

    ; 驗證 v == r
    ok = 1
    i <- [0..32): {
        ixout1746c10 = v[i]: {
            ok -> it

            -> _
        }

        ixout1746c22 = r-val[i]: {
            ok -> it

            -> _
        }

        ixout1746c10 != ixout1746c22 -> {
            ok = 0
        }
    }
}
