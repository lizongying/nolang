; chacha20-poly1305 — ChaCha20-Poly1305 AEAD 加密（RFC 8439）
;
; ChaCha20 是一個 256-bit 金鑰的串流加密器，Poly1305 是一個 128-bit MAC。
; 組合成 ChaCha20-Poly1305 AEAD，提供機密性與完整性。
;
; 用法：
;   # std/crypto/chacha20-poly1305
;   key [32]byte: 256-bit 金鑰
;   nonce [12]byte: 96-bit nonce
;   aad []byte: 額外認證資料
;   plain []byte: 明文
;   sealed = chacha20-poly1305-seal(key, nonce, aad, plain)
;   opened = chacha20-poly1305-open(key, nonce, aad, sealed)
; [chacha20-poly1305](#chacha20-poly1305)

; 常量
...

; ChaCha20 常量 "expand 32-byte k"
; 各 32-bit 小端值
; [CC-SIGMA0](#chacha20-poly1305.cc-sigma0)
CC-SIGMA0 u32 = 1634760805; "expa"
CC-SIGMA1 u32 = 857760878; "nd 3"
CC-SIGMA2 u32 = 2036477234; "2-by"
CC-SIGMA3 u32 = 1797285236; "te k"

; 32-bit 全 1 遮罩
; [CC-MASK32](#chacha20-poly1305.cc-mask32)
CC-MASK32 u32 = 4294967295

; 輔助函數
...

; 32-bit 循環左移
; x: 待循環左移的 32 位元無符號值
; n: 左移量（位元數，調用端保證小於 32，函式內不做取模）
; r: 循環左移後的結果（已掩碼至 32 位元）
; [rotl32](#chacha20-poly1305.rotl32)
rotl32 = (x u32, n i64) (r u32) {
    r = ((x << n) | (x >> (32 - n))) & CC-MASK32
}

; quarter-round: ChaCha20 四分之一輪
; state: ChaCha20 的 16 個 u32 字狀態陣列（原地更新）
; a: 累加器 a 的字索引（加法式操作的起點）
; b: 累加器 b 的字索引（提供加數，輪中後段被異或並循環左移 8/7 位）
; c: 累加器 c 的字索引（第二輪加法的被加數）
; d: 累加器 d 的字索引（被異或後循環左移 16/12 位）
; [qr](#chacha20-poly1305.qr)
qr = (state []u32, a i64, b i64, c i64, d i64) {
    ixout53c21 = state[a]: {
        ok -> it

        -> _
    }

    ixout53c32 = state[b]: {
        ok -> it

        -> _
    }

    state[a]: {
        ok -> it = (ixout53c21 + ixout53c32) & CC-MASK32

        -> _
    }

    ixout60c27 = state[d]: {
        ok -> it

        -> _
    }

    ixout60c38 = state[a]: {
        ok -> it

        -> _
    }

    state[d]: {
        ok -> it = rotl32(ixout60c27 ^ ixout60c38, 16)

        -> _
    }

    ixout67c21 = state[c]: {
        ok -> it

        -> _
    }

    ixout67c32 = state[d]: {
        ok -> it

        -> _
    }

    state[c]: {
        ok -> it = (ixout67c21 + ixout67c32) & CC-MASK32

        -> _
    }

    ; ⚠️ 原錯寫成 state[d] = rotl(state[d]^state[c], 12)：quarter-round 中
    ;    輪 16/8 作用於 d，輪 12/7 應作用於 b（RFC 8439 §2.1）。
    ixout76c27 = state[b]: {
        ok -> it

        -> _
    }

    ixout76c38 = state[c]: {
        ok -> it

        -> _
    }

    state[b]: {
        ok -> it = rotl32(ixout76c27 ^ ixout76c38, 12)

        -> _
    }

    ixout83c21 = state[a]: {
        ok -> it

        -> _
    }

    ixout83c32 = state[b]: {
        ok -> it

        -> _
    }

    state[a]: {
        ok -> it = (ixout83c21 + ixout83c32) & CC-MASK32

        -> _
    }

    ixout90c27 = state[d]: {
        ok -> it

        -> _
    }

    ixout90c38 = state[a]: {
        ok -> it

        -> _
    }

    state[d]: {
        ok -> it = rotl32(ixout90c27 ^ ixout90c38, 8)

        -> _
    }

    ixout97c21 = state[c]: {
        ok -> it

        -> _
    }

    ixout97c32 = state[d]: {
        ok -> it

        -> _
    }

    state[c]: {
        ok -> it = (ixout97c21 + ixout97c32) & CC-MASK32

        -> _
    }

    ixout104c27 = state[b]: {
        ok -> it

        -> _
    }

    ixout104c38 = state[c]: {
        ok -> it

        -> _
    }

    state[b]: {
        ok -> it = rotl32(ixout104c27 ^ ixout104c38, 7)

        -> _
    }
}

; ChaCha20 核心函數
...

; 生成一個 64-byte 密鑰流區塊
; key [32]byte: 256-bit 金鑰
; counter u32: 區塊計數器
; nonce [12]byte: 96-bit nonce
; 返回 out [64]byte: 密鑰流
; [chacha20-block](#chacha20-poly1305.chacha20-block)
chacha20-block = (key [32]byte, counter u32, nonce [12]byte) (out [64]byte) {

    ; 初始化狀態（16 個 32-bit 字）
    ; 先以 with-len 填出 16 個元素：下方 `state[i]: { ok -> it = … }` 是「索引在
    ; 界內才寫」的 option 語義，空 vec 時 ok 恆不成立、寫入被靜默跳過（state 不會
    ; 因索引寫自動 grow），會令金鑰流全為 0、seal 原樣回傳明文（見 test/std/ccpoly）。
    state []u32
    state = with-len(16)

    state[0]: {
        ok -> it = CC-SIGMA0

        -> _
    }

    state[1]: {
        ok -> it = CC-SIGMA1

        -> _
    }

    state[2]: {
        ok -> it = CC-SIGMA2

        -> _
    }

    state[3]: {
        ok -> it = CC-SIGMA3

        -> _
    }

    ; 金鑰（8 個 32-bit 小端字）
    i <- [0..8): {

        #{overflow=wrap}
        ixout158c25 = key[i * 4]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        ixout158c41 = key[i * 4 + 1]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        ixout158c67 = key[i * 4 + 2]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        ixout158c94 = key[i * 4 + 3]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        state[4 + i]: {
            ok -> it = (ixout158c25) | ((ixout158c41) << 8) | ((ixout158c67) << 16) | ((ixout158c94) << 24)

            -> _
        }
    }

    ; 計數器
    state[12]: {
        ok -> it = counter

        -> _
    }

    ; Nonce（3 個 32-bit 小端字）
    i <- [0..3): {

        #{overflow=wrap}
        ixout176c25 = nonce[i * 4]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        ixout176c43 = nonce[i * 4 + 1]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        ixout176c71 = nonce[i * 4 + 2]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        ixout176c100 = nonce[i * 4 + 3]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        state[13 + i]: {
            ok -> it = (ixout176c25) | ((ixout176c43) << 8) | ((ixout176c71) << 16) | ((ixout176c100) << 24)

            -> _
        }
    }

    ; 複製初始狀態
    init []u32
    init = with-len(16)
    i <- [0..16): {
        ixout189c24 = state[i]: {
            ok -> it

            -> _
        }

        init[i]: {
            ok -> it = ixout189c24

            -> _
        }
    }

    ; 20 輪（10 次雙輪）
    round <- [0..10): {

        ; 列輪
        qr(state, 0, 4, 8, 12)
        qr(state, 1, 5, 9, 13)
        qr(state, 2, 6, 10, 14)
        qr(state, 3, 7, 11, 15)

        ; 對角輪
        qr(state, 0, 5, 10, 15)
        qr(state, 1, 6, 11, 12)
        qr(state, 2, 7, 8, 13)
        qr(state, 3, 4, 9, 14)
    }

    ; state += init（序列化為小端位元組）
    i <- [0..16): {
        ixout215c16 = state[i]: {
            ok -> it

            -> _
        }

        ixout215c27 = init[i]: {
            ok -> it

            -> _
        }

        val = (ixout215c16 + ixout215c27) & CC-MASK32

        #{overflow=wrap}
        out[i * 4] = val & 255

        #{overflow=wrap}
        out[i * 4 + 1] = (val >> 8) & 255

        #{overflow=wrap}
        out[i * 4 + 2] = (val >> 16) & 255

        #{overflow=wrap}
        out[i * 4 + 3] = (val >> 24) & 255
    }
}

; ChaCha20 串流加密/解密
; key [32]byte: 金鑰
; counter u32: 初始計數器
; nonce [12]byte: nonce
; data []byte: 輸入資料
; 返回 out []byte: XOR 後的資料
; [chacha20-xor](#chacha20-poly1305.chacha20-xor)
chacha20-xor = (key [32]byte, counter u32, nonce [12]byte, data []byte) (out []byte) {
    out = with-len(data.len())
    pos = 0
    blk-counter = counter
    (pos < data.len()) {
        ks [64]byte
        ks = chacha20-block(key, blk-counter, nonce)

        n = 64

        #{overflow=wrap}
        pos + n > data.len() -> n = data.len() - pos
        i <- [0..n): {

            #{overflow=wrap}
            ixout253c29 = data[pos + i]: {
                ok -> it

                -> _
            }

            ixout253c47 = ks[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            out[pos + i] = (ixout253c29) ^ (ixout253c47)
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            pos-opt = pos + n
            pos-opt: {
                ok -> pos = it

                ->
            }
        }

        blk-counter = (blk-counter + 1) & CC-MASK32
    }
}

; Poly1305 MAC
...

; 將 x 約簡到 [0, 2^130-5)
; 利用 2^130 ≡ 5 (mod p) 的摺疊約簡，僅使用已驗證的 bigint 運算
; 不用 bigint.mod —— 其 div-mod 對多 limb 除數存在未還原 normalize shift 的錯誤
; x: 待約簡的大整數（Poly1305 累乘結果，可能遠超 130 位）
; out: 約簡後的值，落在 [0, 2^130-5) 區間內
; [poly1305-reduce](#chacha20-poly1305.poly1305-reduce)
poly1305-reduce = (x bigint.bigint) (out bigint.bigint) {
    out = x
    hi = bigint.shr(out, 130)
    (! hi.is-zero()) {
        lo bigint.bigint = out._sub(bigint.shl(hi, 130))
        out = lo + (hi * 5)
        hi = bigint.shr(out, 130)
    }
    p = bigint.shl(bigint.one(), 130)._sub(bigint.from-i64(5))
    out.cmp(p) >= 0 -> out = out._sub(p)
}

; 計算 Poly1305 MAC
; key [32]byte: 一次性金鑰（前 16 位元組為 r，後 16 位元組為 s）
; data []byte: 輸入資料
; 返回 tag [16]byte: 16 位元組認證標籤
; [poly1305](#chacha20-poly1305.poly1305)
poly1305 = (key [32]byte, data []byte) (tag [16]byte) {

    ; 用 bigint 直接表達 Poly1305 數学：tag = (h + s) mod 2^128
    ;   h = Σ c_i · r^(n-1-i) mod (2^130 - 5)

    ; r = clamp(key[0..16])（小端 128-bit）
    ; 字節 3,7,11,15 高兩位清零（& 15）；字節 4,8,12 低兩位清零（& 252）
    r = bigint.zero()
    i <- [15..0]: {
        bvr i64 = 0
        {
            bvr ?= key[i]
        }: {
            err -> _

            -> _
        }
        {
            i == 3 || i == 7 || i == 11 || i == 15 -> bvr = bvr & 15

            i == 4 || i == 8 || i == 12 -> bvr = bvr & 252
        }
        r = r * 256 + bigint.from-i64(bvr)
    }

    ; s = key[16..32]（小端 128-bit，無 clamp）
    s = bigint.zero()
    j <- [31..16]: {
        bvs i64 = 0
        {
            bvs ?= key[j]
        }: {
            err -> _

            -> _
        }
        s = s * 256 + bigint.from-i64(bvs)
    }

    ; 累加器 h = 0
    h = bigint.zero()

    ; 逐 16 字節區塊：h = (h + c) * r mod p
    pos = 0
    (pos < data.len()) {
        n = 16

        #{overflow=wrap}
        pos + n > data.len() -> n = data.len() - pos

        ; c = 區塊小端值 + 2^(8n)（最高位 1）
        c bigint.bigint = bigint.zero()

        #{overflow=wrap}
        k <- [n - 1..0]: {

            #{overflow=wrap}
            bvk i64 = data[pos + k]: {
                ok -> it

                -> 0
            }
            c = c * 256 + bigint.from-i64(bvk)
        }

        #{overflow=wrap}
        c = c._add(bigint.shl(bigint.one(), n * 8))
        hc = h._add(c)
        h = poly1305-reduce(hc._mul(r))

        #{overflow=wrap}
        {

            #{overflow=wrap}
            pos-opt2 = pos + 16
            pos-opt2: {
                ok -> pos = it

                ->
            }
        }
    }

    ; tag = (h + s) 的低 128 位，小端输出（逐字節）
    ; 注意：不可用 2^32 取 32-bit limb —— 除數 2^32 會讓 _mod-i64 內部 rem<<32 溢出 i64。
    ; 改用 shr + `% 256`：小除數保證 rem<256，rem<<32 不溢出。
    hs = h._add(s)
    out <- [0..16): {

        #{overflow=wrap}
        shifted bigint.bigint = bigint.shr(hs, out * 8)
        bs = shifted % 256
        bv = bs.to-i64(): {
            ok -> it

            -> 0
        }
        tag[out] = bv & 255
    }
}

; ChaCha20-Poly1305 AEAD
...

; 生成 Poly1305 一次性金鑰
; key [32]byte: ChaCha20 金鑰
; nonce [12]byte: nonce
; 返回 otk [32]byte: 一次性 Poly1305 金鑰
; [poly1305-key-gen](#chacha20-poly1305.poly1305-key-gen)
poly1305-key-gen = (key [32]byte, nonce [12]byte) (otk [32]byte) {

    ; 使用 ChaCha20(block_counter=0) 生成 64 位元組
    ; 前 32 位元組作為 Poly1305 金鑰
    block [64]byte
    block = chacha20-block(key, 0, nonce)
    i <- [0..32): {
        otk[i] = block[i]
    }
}

; ChaCha20-Poly1305 加密
; key [32]byte: 金鑰
; nonce [12]byte: nonce
; aad []byte: 額外認證資料
; plain []byte: 明文
; 返回 sealed []byte: 密文 + 16 位元組 tag
; [chacha20-poly1305-seal](#chacha20-poly1305.chacha20-poly1305-seal)
chacha20-poly1305-seal = (key [32]byte, nonce [12]byte, aad []byte, plain []byte) (sealed []byte) {

    ; 1. 生成 Poly1305 金鑰
    otk [32]byte
    otk = poly1305-key-gen(key, nonce)

    ; 2. 加密（計數器從 1 開始）
    cipher []byte
    cipher = chacha20-xor(key, 1, nonce, plain)

    ; 3. 構建 Poly1305 輸入: aad || pad16 || cipher || pad16 || aad_len || cipher_len
    ; 先算出 mac-input 的總長度並 with-len 填充：下方的 `mac-input[k]: { ok -> it = … }`
    ; 為「界內才寫」的 option 語義，空 vec 會靜默略過所有寫入，令 mac-input 恆為空、
    ; poly1305 對 0 位元組運算而得到全零 tag。
    mac-input []byte
    pad-aad i64 = 16 - (aad.len() % 16)
    pad-aad == 16 -> pad-aad = 0
    pad-cipher i64 = 16 - (cipher.len() % 16)
    pad-cipher == 16 -> pad-cipher = 0
    mac-input = with-len(aad.len() + pad-aad + cipher.len() + pad-cipher + 16)
    pos = 0

    ; AAD
    i <- [0..aad.len()): {
        ixout423c24 = aad[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = ixout423c24

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + aad.len()

    ; pad16 for AAD
    #{overflow=wrap}
    pad-len = 16 - (aad.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = 0

            -> _
        }
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt3 = pos + pad-len
        pos-opt3: {
            ok -> pos = it

            ->
        }
    }

    ; Cipher
    i <- [0..cipher.len()): {
        ixout454c24 = cipher[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = ixout454c24

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + cipher.len()

    ; pad16 for cipher
    #{overflow=wrap}
    pad-len = 16 - (cipher.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = 0

            -> _
        }
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt4 = pos + pad-len
        pos-opt4: {
            ok -> pos = it

            ->
        }
    }

    ; aad_len (64-bit LE)
    aad-len = aad.len()

    #{overflow=wrap}
    mac-input[pos + 0]: {
        ok -> it = aad-len & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 1]: {
        ok -> it = (aad-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 2]: {
        ok -> it = (aad-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 3]: {
        ok -> it = (aad-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 4]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 5]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 6]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 7]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt5 = pos + 8
        pos-opt5: {
            ok -> pos = it

            ->
        }
    }

    ; cipher_len (64-bit LE)
    cipher-len = cipher.len()

    #{overflow=wrap}
    mac-input[pos + 0]: {
        ok -> it = cipher-len & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 1]: {
        ok -> it = (cipher-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 2]: {
        ok -> it = (cipher-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 3]: {
        ok -> it = (cipher-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 4]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 5]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 6]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 7]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt6 = pos + 8
        pos-opt6: {
            ok -> pos = it

            ->
        }
    }

    ; 4. 計算 tag
    tag [16]byte
    tag = poly1305(otk, mac-input)

    ; 5. 輸出密文 + tag
    #{overflow=wrap}
    sealed = with-len(cipher.len() + 16)
    i <- [0..cipher.len()): {
        ixout614c21 = cipher[i]: {
            ok -> it

            -> _
        }

        sealed[i] = ixout614c21
    }
    i <- [0..16): {

        #{overflow=wrap}
        sealed[cipher.len() + i] = tag[i]
    }
}

; ChaCha20-Poly1305 解密
; key [32]byte: 金鑰
; nonce [12]byte: nonce
; aad []byte: 額外認證資料
; sealed []byte: 密文 + 16 位元組 tag
; 返回 plain []byte: 明文（認證失敗時長度為 0）
; [chacha20-poly1305-open](#chacha20-poly1305.chacha20-poly1305-open)
chacha20-poly1305-open = (key [32]byte, nonce [12]byte, aad []byte, sealed []byte) (plain []byte) {
    sealed.len() < 16 -> return

    #{overflow=wrap}
    cipher-len = sealed.len() - 16

    ; 1. 生成 Poly1305 金鑰
    otk [32]byte
    otk = poly1305-key-gen(key, nonce)

    ; 2. 提取密文和 tag
    cipher []byte
    cipher = with-len(cipher-len)
    i <- [0..cipher-len): {
        ixout647c24 = sealed[i]: {
            ok -> it

            -> _
        }

        cipher[i]: {
            ok -> it = ixout647c24

            -> _
        }
    }
    tag [16]byte
    i <- [0..16): {

        #{overflow=wrap}
        ixout657c24 = sealed[cipher-len + i]: {
            ok -> it

            -> _
        }

        tag[i]: {
            ok -> it = ixout657c24

            -> _
        }
    }

    ; 3. 構建 Poly1305 輸入並計算期望 tag
    ; 同 seal：先 with-len 填出 mac-input 總長度，否則 `mac-input[k]: { ok -> it = … }`
    ; 對空 vec 靜默略過，mac-input 恆空。
    mac-input []byte
    pad-aad i64 = 16 - (aad.len() % 16)
    pad-aad == 16 -> pad-aad = 0
    pad-cipher i64 = 16 - (cipher.len() % 16)
    pad-cipher == 16 -> pad-cipher = 0
    mac-input = with-len(aad.len() + pad-aad + cipher.len() + pad-cipher + 16)
    pos = 0
    i <- [0..aad.len()): {
        ixout677c24 = aad[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = ixout677c24

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + aad.len()

    #{overflow=wrap}
    pad-len = 16 - (aad.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = 0

            -> _
        }
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt7 = pos + pad-len
        pos-opt7: {
            ok -> pos = it

            ->
        }
    }

    i <- [0..cipher.len()): {
        ixout706c24 = cipher[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = ixout706c24

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + cipher.len()

    #{overflow=wrap}
    pad-len = 16 - (cipher.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i]: {
            ok -> it = 0

            -> _
        }
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt8 = pos + pad-len
        pos-opt8: {
            ok -> pos = it

            ->
        }
    }

    aad-len = aad.len()

    #{overflow=wrap}
    mac-input[pos + 0]: {
        ok -> it = aad-len & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 1]: {
        ok -> it = (aad-len >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 2]: {
        ok -> it = (aad-len >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 3]: {
        ok -> it = (aad-len >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 4]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 5]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 6]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 7]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt9 = pos + 8
        pos-opt9: {
            ok -> pos = it

            ->
        }
    }
    cipher-len-val = cipher.len()

    #{overflow=wrap}
    mac-input[pos + 0]: {
        ok -> it = cipher-len-val & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 1]: {
        ok -> it = (cipher-len-val >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 2]: {
        ok -> it = (cipher-len-val >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 3]: {
        ok -> it = (cipher-len-val >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 4]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 5]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 6]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    mac-input[pos + 7]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {

        #{overflow=wrap}
        pos-opt10 = pos + 8
        pos-opt10: {
            ok -> pos = it

            ->
        }
    }
    exp-tag [16]byte
    exp-tag = poly1305(otk, mac-input)

    ; 4. 常數時間比較
    diff = 0
    i <- [0..16): {
        ixout1070c27 = tag[i]: {
            ok -> it

            -> _
        }

        ixout1070c40 = exp-tag[i]: {
            ok -> it

            -> _
        }

        diff = diff | (ixout1070c27 ^ ixout1070c40)
    }
    diff != 0 -> return

    ; 5. 解密
    plain = chacha20-xor(key, 1, nonce, cipher)
}
