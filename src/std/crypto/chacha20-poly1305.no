; chacha20-poly1305 — ChaCha20-Poly1305 AEAD 加密（RFC 8439）
;
; ChaCha20 是一個 256-bit 金鑰的串流加密器，Poly1305 是一個 128-bit MAC。
; 組合成 ChaCha20-Poly1305 AEAD，提供機密性與完整性。
;
; 用法：
;   # std/crypto/chacha20-poly1305
;   key [32]byte: 256-bit 金鑰
;   nonce [12]byte: 96-bit nonce
;   aad []byte: 額外認證資料
;   plain []byte: 明文
;   sealed = chacha20-poly1305-seal(key, nonce, aad, plain)
;   opened = chacha20-poly1305-open(key, nonce, aad, sealed)

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; ChaCha20 常量 "expand 32-byte k"
; 各 32-bit 小端值
CC-SIGMA0 u32 = 1634760805; "expa"
CC-SIGMA1 u32 = 857760878; "nd 3"
CC-SIGMA2 u32 = 2036477234; "2-by"
CC-SIGMA3 u32 = 1797285236; "te k"

; 32-bit 全 1 遮罩
CC-MASK32 u32 = 4294967295

; ═══════════════════════════════════════════════
; 輔助函數
; ═══════════════════════════════════════════════

; rotl32: 32-bit 循環左移
rotl32 = (x u32, n i64) (r u32) {

    r = ((x << n) | (x >> (32 - n))) & CC-MASK32
}

; quarter-round: ChaCha20 四分之一輪
qr = (state []u32, a i64, b i64, c i64, d i64) {

    #{index-out=zero}
    state[a] = (state[a] + state[b]) & CC-MASK32

    #{index-out=zero}
    state[d] = rotl32(state[d] ^ state[a], 16)

    #{index-out=zero}
    state[c] = (state[c] + state[d]) & CC-MASK32

    ; ⚠️ 原錯寫成 state[d] = rotl(state[d]^state[c], 12)：quarter-round 中
    ;    輪 16/8 作用於 d，輪 12/7 應作用於 b（RFC 8439 §2.1）。
    #{index-out=zero}
    state[b] = rotl32(state[b] ^ state[c], 12)

    #{index-out=zero}
    state[a] = (state[a] + state[b]) & CC-MASK32

    #{index-out=zero}
    state[d] = rotl32(state[d] ^ state[a], 8)

    #{index-out=zero}
    state[c] = (state[c] + state[d]) & CC-MASK32

    #{index-out=zero}
    state[b] = rotl32(state[b] ^ state[c], 7)
}

; ═══════════════════════════════════════════════
; ChaCha20 核心函數
; ═══════════════════════════════════════════════

; chacha20-block: 生成一個 64-byte 密鑰流區塊
; key [32]byte: 256-bit 金鑰
; counter u32: 區塊計數器
; nonce [12]byte: 96-bit nonce
; 返回 out [64]byte: 密鑰流
chacha20-block = (key [32]byte, counter u32, nonce [12]byte) (out [64]byte) {

    ; 初始化狀態（16 個 32-bit 字）
    state []u32

    state[0] = CC-SIGMA0

    state[1] = CC-SIGMA1

    state[2] = CC-SIGMA2

    state[3] = CC-SIGMA3

    ; 金鑰（8 個 32-bit 小端字）
    i <- [0..8): {

        #{index-out=zero, overflow=wrap}
        state[4 + i] = (key[i * 4]) | ((key[i * 4 + 1]) << 8) | ((key[i * 4 + 2]) << 16) | ((key[i * 4 + 3]) << 24)
    }

    ; 計數器
    state[12] = counter

    ; Nonce（3 個 32-bit 小端字）
    i <- [0..3): {

        #{index-out=zero, overflow=wrap}
        state[13 + i] = (nonce[i * 4]) | ((nonce[i * 4 + 1]) << 8) | ((nonce[i * 4 + 2]) << 16) | ((nonce[i * 4 + 3]) << 24)
    }

    ; 複製初始狀態
    init []u32
    i <- [0..16): {

        #{index-out=zero}
        init[i] = state[i]
    }

    ; 20 輪（10 次雙輪）
    round <- [0..10): {

        ; 列輪
        qr(state, 0, 4, 8, 12)
        qr(state, 1, 5, 9, 13)
        qr(state, 2, 6, 10, 14)
        qr(state, 3, 7, 11, 15)

        ; 對角輪
        qr(state, 0, 5, 10, 15)
        qr(state, 1, 6, 11, 12)
        qr(state, 2, 7, 8, 13)
        qr(state, 3, 4, 9, 14)
    }

    ; state += init（序列化為小端位元組）
    i <- [0..16): {

        #{index-out=zero}
        val = (state[i] + init[i]) & CC-MASK32

        #{overflow=wrap}
        out[i * 4] = val & 255

        #{overflow=wrap}
        out[i * 4 + 1] = (val >> 8) & 255

        #{overflow=wrap}
        out[i * 4 + 2] = (val >> 16) & 255

        #{overflow=wrap}
        out[i * 4 + 3] = (val >> 24) & 255
    }
}

; chacha20-xor: ChaCha20 串流加密/解密
; key [32]byte: 金鑰
; counter u32: 初始計數器
; nonce [12]byte: nonce
; data []byte: 輸入資料
; 返回 out []byte: XOR 後的資料
chacha20-xor = (key [32]byte, counter u32, nonce [12]byte, data []byte) (out []byte) {
    out = with-len(data.len())
    pos = 0
    blk-counter = counter
    (pos < data.len()) {

        ks [64]byte
        ks = chacha20-block(key, blk-counter, nonce)

        n = 64

        #{overflow=wrap}
        pos + n > data.len() -> n = data.len() - pos
        i <- [0..n): {

            #{index-out=zero, overflow=wrap}
            out[pos + i] = (data[pos + i]) ^ (ks[i])
        }

        #{overflow=wrap}
        pos = pos + n

        blk-counter = (blk-counter + 1) & CC-MASK32
    }
}

; ═══════════════════════════════════════════════
; Poly1305 MAC
; ═══════════════════════════════════════════════

; poly1305-reduce: 将 x 约简到 [0, 2^130-5)
; 利用 2^130 ≡ 5 (mod p) 的折叠约简，仅使用已验证的 bigint 运算
; 不用 bigint.mod —— 其 div-mod 对多 limb 除数存在未还原 normalize shift 的错误
poly1305-reduce = (x bigint.bigint) (out bigint.bigint) {
    out = x
    hi = bigint.shr(out, 130)
    (! hi.is-zero()) {
        lo bigint.bigint = bigint.sub(out, bigint.shl(hi, 130))
        out = bigint.add(lo, bigint.mul-i64(hi, 5))
        hi = bigint.shr(out, 130)
    }
    p = bigint.sub(bigint.shl(bigint.one(), 130), bigint.from-i64(5))
    out.cmp(p) >= 0 -> out = bigint.sub(out, p)
}

; poly1305: 計算 Poly1305 MAC
; key [32]byte: 一次性金鑰（前 16 位元組為 r，後 16 位元組為 s）
; data []byte: 輸入資料
; 返回 tag [16]byte: 16 位元組認證標籤
poly1305 = (key [32]byte, data []byte) (tag [16]byte) {

    ; 用 bigint 直接表达 Poly1305 数学：tag = (h + s) mod 2^128
    ;   h = Σ c_i · r^(n-1-i) mod (2^130 - 5)

    ; r = clamp(key[0..16])（小端 128-bit）
    ; 字节 3,7,11,15 高两位清零（& 15）；字节 4,8,12 低两位清零（& 252）
    r = bigint.zero()
    i <- [15..0]: {
        bvr i64 = key[i]
        {
            i == 3 || i == 7 || i == 11 || i == 15 -> bvr = bvr & 15

            i == 4 || i == 8 || i == 12 -> bvr = bvr & 252
        }
        r = bigint.add(bigint.mul-i64(r, 256), bigint.from-i64(bvr))
    }

    ; s = key[16..32]（小端 128-bit，无 clamp）
    s = bigint.zero()
    j <- [31..16]: {
        bvs i64 = key[j]
        s = bigint.add(bigint.mul-i64(s, 256), bigint.from-i64(bvs))
    }

    ; 累加器 h = 0
    h = bigint.zero()

    ; 逐 16 字节区块：h = (h + c) * r mod p
    pos = 0
    (pos < data.len()) {
        n = 16

        #{overflow=wrap}
        pos + n > data.len() -> n = data.len() - pos

        ; c = 区块小端值 + 2^(8n)（最高位 1）
        c bigint.bigint = bigint.zero()

        #{overflow=wrap}
        k <- [n - 1..0]: {

            #{index-out=zero, overflow=wrap}
            bvk i64 = data[pos + k]
            c = bigint.add(bigint.mul-i64(c, 256), bigint.from-i64(bvk))
        }

        #{overflow=wrap}
        c = bigint.add(c, bigint.shl(bigint.one(), n * 8))
        h = poly1305-reduce(bigint.mul(bigint.add(h, c), r))

        #{overflow=wrap}
        pos = pos + 16
    }

    ; tag = (h + s) 的低 128 位，小端输出（逐字节）
    ; 注意：不可用 mod-i64/div-i64 取 32-bit limb —— 除数 2^32 会让内部 rem<<32 溢出 i64。
    ; 改用 shr + mod-i64(.,256)：小除数保证 rem<256，rem<<32 不溢出。
    hs = bigint.add(h, s)
    out <- [0..16): {

        #{overflow=wrap}
        shifted bigint.bigint = bigint.shr(hs, out * 8)
        b i64 = bigint.mod-i64(shifted, 256)
        tag[out] = b & 255
    }
}

; ═══════════════════════════════════════════════
; ChaCha20-Poly1305 AEAD
; ═══════════════════════════════════════════════

; poly1305-key-gen: 生成 Poly1305 一次性金鑰
; key [32]byte: ChaCha20 金鑰
; nonce [12]byte: nonce
; 返回 otk [32]byte: 一次性 Poly1305 金鑰
poly1305-key-gen = (key [32]byte, nonce [12]byte) (otk [32]byte) {

    ; 使用 ChaCha20(block_counter=0) 生成 64 位元組
    ; 前 32 位元組作為 Poly1305 金鑰
    block [64]byte
    block = chacha20-block(key, 0, nonce)
    i <- [0..32): {
        otk[i] = block[i]
    }
}

; chacha20-poly1305-seal: ChaCha20-Poly1305 加密
; key [32]byte: 金鑰
; nonce [12]byte: nonce
; aad []byte: 額外認證資料
; plain []byte: 明文
; 返回 sealed []byte: 密文 + 16 位元組 tag
chacha20-poly1305-seal = (key [32]byte, nonce [12]byte, aad []byte, plain []byte) (sealed []byte) {

    ; 1. 生成 Poly1305 金鑰
    otk [32]byte
    otk = poly1305-key-gen(key, nonce)

    ; 2. 加密（計數器從 1 開始）
    cipher []byte
    cipher = chacha20-xor(key, 1, nonce, plain)

    ; 3. 構建 Poly1305 輸入: aad || pad16 || cipher || pad16 || aad_len || cipher_len
    mac-input []byte
    pos = 0

    ; AAD
    i <- [0..aad.len()): {

        #{index-out=zero, overflow=wrap}
        mac-input[pos + i] = aad[i]
    }

    #{overflow=wrap}
    pos = pos + aad.len()

    ; pad16 for AAD
    #{overflow=wrap}
    pad-len = 16 - (aad.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i] = 0
    }

    #{overflow=wrap}
    pos = pos + pad-len

    ; Cipher
    i <- [0..cipher.len()): {

        #{index-out=zero, overflow=wrap}
        mac-input[pos + i] = cipher[i]
    }

    #{overflow=wrap}
    pos = pos + cipher.len()

    ; pad16 for cipher
    #{overflow=wrap}
    pad-len = 16 - (cipher.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i] = 0
    }

    #{overflow=wrap}
    pos = pos + pad-len

    ; aad_len (64-bit LE)
    aad-len = aad.len()

    #{overflow=wrap}
    mac-input[pos + 0] = aad-len & 255

    #{overflow=wrap}
    mac-input[pos + 1] = (aad-len >> 8) & 255

    #{overflow=wrap}
    mac-input[pos + 2] = (aad-len >> 16) & 255

    #{overflow=wrap}
    mac-input[pos + 3] = (aad-len >> 24) & 255

    #{overflow=wrap}
    mac-input[pos + 4] = 0

    #{overflow=wrap}
    mac-input[pos + 5] = 0

    #{overflow=wrap}
    mac-input[pos + 6] = 0

    #{overflow=wrap}
    mac-input[pos + 7] = 0

    #{overflow=wrap}
    pos = pos + 8

    ; cipher_len (64-bit LE)
    cipher-len = cipher.len()

    #{overflow=wrap}
    mac-input[pos + 0] = cipher-len & 255

    #{overflow=wrap}
    mac-input[pos + 1] = (cipher-len >> 8) & 255

    #{overflow=wrap}
    mac-input[pos + 2] = (cipher-len >> 16) & 255

    #{overflow=wrap}
    mac-input[pos + 3] = (cipher-len >> 24) & 255

    #{overflow=wrap}
    mac-input[pos + 4] = 0

    #{overflow=wrap}
    mac-input[pos + 5] = 0

    #{overflow=wrap}
    mac-input[pos + 6] = 0

    #{overflow=wrap}
    mac-input[pos + 7] = 0

    #{overflow=wrap}
    pos = pos + 8

    ; 4. 計算 tag
    tag [16]byte
    tag = poly1305(otk, mac-input)

    ; 5. 輸出密文 + tag
    #{overflow=wrap}
    sealed = with-len(cipher.len() + 16)
    i <- [0..cipher.len()): {

        #{index-out=zero}
        sealed[i] = cipher[i]
    }
    i <- [0..16): {

        #{overflow=wrap}
        sealed[cipher.len() + i] = tag[i]
    }
}

; chacha20-poly1305-open: ChaCha20-Poly1305 解密
; key [32]byte: 金鑰
; nonce [12]byte: nonce
; aad []byte: 額外認證資料
; sealed []byte: 密文 + 16 位元組 tag
; 返回 plain []byte: 明文（認證失敗時長度為 0）
chacha20-poly1305-open = (key [32]byte, nonce [12]byte, aad []byte, sealed []byte) (plain []byte) {
    sealed.len() < 16 -> return

    #{overflow=wrap}
    cipher-len = sealed.len() - 16

    ; 1. 生成 Poly1305 金鑰
    otk [32]byte
    otk = poly1305-key-gen(key, nonce)

    ; 2. 提取密文和 tag
    cipher []byte
    i <- [0..cipher-len): {

        #{index-out=zero}
        cipher[i] = sealed[i]
    }
    tag [16]byte
    i <- [0..16): {

        #{index-out=zero, overflow=wrap}
        tag[i] = sealed[cipher-len + i]
    }

    ; 3. 構建 Poly1305 輸入並計算期望 tag
    mac-input []byte
    pos = 0
    i <- [0..aad.len()): {

        #{index-out=zero, overflow=wrap}
        mac-input[pos + i] = aad[i]
    }

    #{overflow=wrap}
    pos = pos + aad.len()

    #{overflow=wrap}
    pad-len = 16 - (aad.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i] = 0
    }

    #{overflow=wrap}
    pos = pos + pad-len

    i <- [0..cipher.len()): {

        #{index-out=zero, overflow=wrap}
        mac-input[pos + i] = cipher[i]
    }

    #{overflow=wrap}
    pos = pos + cipher.len()

    #{overflow=wrap}
    pad-len = 16 - (cipher.len() % 16)
    pad-len == 16 -> pad-len = 0
    i <- [0..pad-len): {

        #{overflow=wrap}
        mac-input[pos + i] = 0
    }

    #{overflow=wrap}
    pos = pos + pad-len

    aad-len = aad.len()

    #{overflow=wrap}
    mac-input[pos + 0] = aad-len & 255

    #{overflow=wrap}
    mac-input[pos + 1] = (aad-len >> 8) & 255

    #{overflow=wrap}
    mac-input[pos + 2] = (aad-len >> 16) & 255

    #{overflow=wrap}
    mac-input[pos + 3] = (aad-len >> 24) & 255

    #{overflow=wrap}
    mac-input[pos + 4] = 0

    #{overflow=wrap}
    mac-input[pos + 5] = 0

    #{overflow=wrap}
    mac-input[pos + 6] = 0

    #{overflow=wrap}
    mac-input[pos + 7] = 0

    #{overflow=wrap}
    pos = pos + 8
    cipher-len-val = cipher.len()

    #{overflow=wrap}
    mac-input[pos + 0] = cipher-len-val & 255

    #{overflow=wrap}
    mac-input[pos + 1] = (cipher-len-val >> 8) & 255

    #{overflow=wrap}
    mac-input[pos + 2] = (cipher-len-val >> 16) & 255

    #{overflow=wrap}
    mac-input[pos + 3] = (cipher-len-val >> 24) & 255

    #{overflow=wrap}
    mac-input[pos + 4] = 0

    #{overflow=wrap}
    mac-input[pos + 5] = 0

    #{overflow=wrap}
    mac-input[pos + 6] = 0

    #{overflow=wrap}
    mac-input[pos + 7] = 0

    #{overflow=wrap}
    pos = pos + 8
    exp-tag [16]byte
    exp-tag = poly1305(otk, mac-input)

    ; 4. 常數時間比較
    diff = 0
    i <- [0..16): {

        diff = diff | (tag[i] ^ exp-tag[i])
    }
    diff != 0 -> return

    ; 5. 解密
    plain = chacha20-xor(key, 1, nonce, cipher)
}
