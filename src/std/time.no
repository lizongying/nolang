; time — 時間操作
;
; 提供 Unix 時間戳、格式化、睡眠、時長計算、計時器。
; 底層依賴 os 模組的系統調用（now、now-ms、now-us、now-ns、sleep、sleep-us、sleep-ns）。
;
; 另提供 time 結構體（sec + nsec 表示的絕對時間點）：now-time、unix-to-time、
; duration-time、since-time、parse-time 等函式，以及 .unix/.date/.format 等方法，
; 讓呼叫端以 time 而非裸 i64 時間戳操作時間。
;
; 注意：now-ms、now-us、now-ns、sleep-us、sleep-ns 已由 builtin 提供，
; 此處不再重新定義（用戶函式會遮蔽同名 builtin 造成遞迴），
; 直接以 builtin 形式供使用者呼叫。

; ═══════════════════════════════════════════════
; 時間戳
; ═══════════════════════════════════════════════

; 當前 Unix 時間戳（秒）
; 包裝 builtin now()
; [now-s](#time.now-s)
now-s = () (ts i64) {
    ts = os.now()
}

; 當前 Unix 時間戳（毫秒）
; [now-ms](#time.now-ms)
#{buildin}
now-ms = () (ts i64) {
}

; 當前 Unix 時間戳（微秒）
; [now-us](#time.now-us)
#{buildin}
now-us = () (ts i64) {
}

; 當前時間戳（奈秒）
; [now-ns](#time.now-ns)
#{buildin}
now-ns = () (ts i64) {
}

; ═══════════════════════════════════════════════
; 睡眠
; ═══════════════════════════════════════════════

; 睡眠指定秒數
; 包裝 builtin sleep()
; [sleep-s](#time.sleep-s)
sleep-s = (s i64) {
    os.sleep(s)
}

; 睡眠指定毫秒數
; sleep-ms 無對應 builtin，以 sleep-us(ms * 1000) 實作
; [sleep-ms](#time.sleep-ms)
sleep-ms = (ms i64) {

    #{overflow=wrap}
    us = ms * 1000
    sleep-us(us)
}

; 睡眠指定微秒數
; [sleep-us](#time.sleep-us)
#{buildin}
sleep-us = (us i64) {
}

; 睡眠指定奈秒數
; [sleep-ns](#time.sleep-ns)
#{buildin}
sleep-ns = (ns i64) {
}

; ═══════════════════════════════════════════════
; 時長計算
; ═══════════════════════════════════════════════

; 計算兩個時間戳的差（秒）
; [duration-between](#time.duration-between)
duration-between = (start i64, end i64) (diff i64) {

    #{overflow=wrap}
    diff = end - start
}

; 計算兩個時間戳的差（毫秒）
; [duration-ms-between](#time.duration-ms-between)
duration-ms-between = (start i64, end i64) (diff i64) {

    #{overflow=wrap}
    diff = end - start
}

; 計算兩個時間戳的差（微秒）
; [duration-us-between](#time.duration-us-between)
duration-us-between = (start i64, end i64) (diff i64) {

    #{overflow=wrap}
    diff = end - start
}

; 從 start 到現在的經過秒數
; [since-s](#time.since-s)
since-s = (start i64) (diff i64) {

    end i64 = os.now()

    #{overflow=wrap}
    diff = end - start
}

; 從 start 到現在的經過毫秒數
; [since-ms](#time.since-ms)
since-ms = (start i64) (diff i64) {

    end = now-ms()

    #{overflow=wrap}
    diff = end - start
}

; 從 start 到現在的經過微秒數
; [since-us](#time.since-us)
since-us = (start i64) (diff i64) {

    end = now-us()

    #{overflow=wrap}
    diff = end - start
}

; ═══════════════════════════════════════════════
; 格式化
; ═══════════════════════════════════════════════

; 將秒數格式化為人類可讀字串
; 例：3661 → '1h1m1s'
; [format-duration](#time.format-duration)
format-duration = (seconds i64) (out str) {

    #{overflow=wrap}
    h = seconds / 3600
    rem-opt = seconds % 3600
    rem = 0
    rem-opt: {
        ok -> rem = it

        -> rem = 0
    }

    #{overflow=wrap}
    m = rem / 60
    sec-opt = rem % 60
    sec = 0
    sec-opt: {
        ok -> sec = it

        -> sec = 0
    }
    h-s = h.to-str()
    m-s = m.to-str()
    sec-s = sec.to-str()

    out = h-s - 'h' - m-s - 'm' - sec-s - 's'
}

; ═══════════════════════════════════════════════
; 計時器
; ═══════════════════════════════════════════════

; timer: 計時器結構體
; start-ts: 起始時間戳（毫秒）
; end-ts: 結束時間戳（毫秒）
timer {
    start-ts i64
    end-ts i64
}

; 開始計時
; [start](#time.timer.start)
timer.start = () {
    .start-ts = now-ms()
}

; 停止計時
; [stop](#time.timer.stop)
timer.stop = () {
    .end-ts = now-ms()
}

; 經過毫秒數
; [elapsed-ms](#time.timer.elapsed-ms)
timer.elapsed-ms = () (ms i64) {

    #{overflow=wrap}
    ms = .end-ts - .start-ts
}

; 經過秒數
; [elapsed-s](#time.timer.elapsed-s)
timer.elapsed-s = () (s i64) {

    #{overflow=wrap}
    ms = .end-ts - .start-ts

    #{overflow=wrap}
    s = ms / 1000
}

; 經過微秒數
; [elapsed-us](#time.timer.elapsed-us)
timer.elapsed-us = () (us i64) {

    #{overflow=wrap}
    ms = .end-ts - .start-ts

    #{overflow=wrap}
    us = ms * 1000
}

; ═══════════════════════════════════════════════
; 日期與時間
; ═══════════════════════════════════════════════

; date: 日期時間結構體（UTC）
date {
    year i64
    month i64
    day i64
    hour i64
    min i64
    sec i64
    wday i64
}

; 月份天數表（非閏年）
_days-in-month = [
    31, 28, 31, 30, 31, 30, 31, 31,
    30, 31, 30, 31,
]

; 判斷閏年
; [is-leap](#time.is-leap)
is-leap = (y i64) (leap bool) {
    leap = false
    {
        y % 4 != 0 -> return

        y % 100 == 0 -> {
            y % 400 == 0 -> leap = true
            return
        }
    }
    leap = true
}

; _days-in-month: 取得指定年月的天數
; [days-in-month-fn](#time.days-in-month-fn)
days-in-month-fn = (y i64, m i64) (d i64) {

    d = 31
    {
        m < 1 -> return

        m > 12 -> return
    }

    #{overflow=wrap}
    d = _days-in-month[m - 1]
    m == 2 -> {
        leap bool
        leap = is-leap(y)
        leap -> d = 29
    }
}

; 將 Unix 時間戳（秒）轉換為 date 結構體（UTC）
; 使用經典的 civil-from-days 演算法（Howard Hinnant）
; [unix-to-date](#time.unix-to-date)
unix-to-date = (ts i64) (d date) {

    ; 分離天數和秒數
    #{overflow=wrap}
    days = ts / 86400

    #{overflow=wrap}
    rem = ts % 86400

    #{overflow=wrap}
    rem < 0 -> {

        #{overflow=wrap}
        days = days - 1
        rem = rem + 86400
    }

    ; 時、分、秒
    #{overflow=wrap}
    d.hour = rem / 3600

    #{overflow=wrap}
    d.min = (rem % 3600) / 60
    d.sec = rem % 60

    ; 將 1970-01-01 起的天數轉為日期
    ; days = z - 719468（z 是從 0000-03-01 起的天數）
    #{overflow=wrap}
    z = days + 719468

    #{overflow=wrap}
    era = z / 146097

    #{overflow=wrap}
    z < 0 && z % 146097 != 0 -> era = era - 1

    #{overflow=wrap}
    doe = z - era * 146097

    #{overflow=wrap}
    yoe = doe / 36524
    doe2 = doe % 36524

    #{overflow=wrap}
    yoe2 = doe2 / 1461
    doe3 = doe2 % 1461

    #{overflow=wrap}
    yoe3 = doe3 / 365
    yoe3 == 4 -> yoe3 = 3

    #{overflow=wrap}
    y = era * 400 + yoe * 100 + yoe2 * 4 + yoe3

    #{overflow=wrap}
    doy = doe - yoe * 36524 - yoe2 * 1461 - yoe3 * 365

    #{overflow=wrap}
    mp = (5 * doy + 2) / 153

    #{overflow=wrap}
    d.day = doy - (153 * mp + 2) / 5 + 1

    #{overflow=wrap}
    d.month = mp + 3

    #{overflow=wrap}
    mp >= 10 -> d.month = mp - 9

    #{overflow=wrap}
    {
        d.month <= 2 -> d.year = y + 1

        -> d.year = y
    }

    ; 星期幾（1970-01-01 是星期四 = 4）
    w = days % 7

    #{overflow=wrap}
    w < 0 -> w = w + 7

    #{overflow=wrap}
    d.wday = (w + 4) % 7
}

; 將 date 結構體（UTC）轉換為 Unix 時間戳（秒）
; 使用 days-from-civil 演算法（Howard Hinnant）
; [date-to-unix](#time.date-to-unix)
date-to-unix = (d date) (ts i64) {

    y = d.year
    m = d.month

    ; 調整：3月為年初
    #{overflow=wrap}
    m <= 2 -> y = y - 1

    #{overflow=wrap}
    era = y / 400

    #{overflow=wrap}
    y < 0 && y % 400 != 0 -> era = era - 1

    #{overflow=wrap}
    yoe = y - era * 400
    m2 = m

    #{overflow=wrap}
    {
        m2 > 2 -> m2 = m2 - 3

        -> m2 = m2 + 9
    }

    #{overflow=wrap}
    doy = (153 * m2 + 2) / 5 + d.day - 1

    #{overflow=wrap}
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy

    #{overflow=wrap}
    days = era * 146097 + doe - 719468

    #{overflow=wrap}
    ts = days * 86400 + d.hour * 3600 + d.min * 60 + d.sec
}

; 將 date 結構體格式化為字串
; 格式：YYYY-MM-DD HH:MM:SS（負年份加前綴 '-'）
; [format-date](#time.format-date)
format-date = (d date) (out str) {

    neg = 0
    yr = d.year

    #{overflow=wrap}
    yr < 0 -> {

        neg = 1
        yr = 0 - yr
    }
    out-len = 19
    neg == 1 -> out-len = 20
    out = with-len(out-len)
    pos = 0
    neg == 1 -> {

        out[0] = 45
        pos = 1
    }

    #{overflow=wrap}
    out[pos] = (yr / 1000) % 10 + 48

    #{overflow=wrap}
    out[pos + 1] = (yr / 100) % 10 + 48

    #{overflow=wrap}
    out[pos + 2] = (yr / 10) % 10 + 48

    #{overflow=wrap}
    out[pos + 3] = yr % 10 + 48

    #{overflow=wrap}
    out[pos + 4] = 45

    ; 月
    #{overflow=wrap}
    out[pos + 5] = d.month / 10 + 48

    #{overflow=wrap}
    out[pos + 6] = d.month % 10 + 48

    #{overflow=wrap}
    out[pos + 7] = 45

    ; 日
    #{overflow=wrap}
    out[pos + 8] = d.day / 10 + 48

    #{overflow=wrap}
    out[pos + 9] = d.day % 10 + 48

    #{overflow=wrap}
    out[pos + 10] = 32

    ; 時
    #{overflow=wrap}
    out[pos + 11] = d.hour / 10 + 48

    #{overflow=wrap}
    out[pos + 12] = d.hour % 10 + 48

    #{overflow=wrap}
    out[pos + 13] = 58

    ; 分
    #{overflow=wrap}
    out[pos + 14] = d.min / 10 + 48

    #{overflow=wrap}
    out[pos + 15] = d.min % 10 + 48

    #{overflow=wrap}
    out[pos + 16] = 58

    ; 秒
    #{overflow=wrap}
    out[pos + 17] = d.sec / 10 + 48

    #{overflow=wrap}
    out[pos + 18] = d.sec % 10 + 48
}

; 將 Unix 時間戳格式化為可讀字串
; 格式：YYYY-MM-DD HH:MM:SS（UTC）
; [format-time-str](#time.format-time-str)
format-time-str = (ts i64) (out str) {
    d date
    d = unix-to-date(ts)
    out = format-date(d)
}

; 解析日期字串為 Unix 時間戳
; 支援格式：YYYY-MM-DD HH:MM:SS 或 YYYY-MM-DD
; 返回 ?i64：ok=時間戳, nil=解析失敗
; [parse-date](#time.parse-date)
parse-date = (s str) (ts ?i64) {
    ts = nil
    n = s.len-bytes()
    n < 10 -> return
    d date
    d.year = 0
    d.month = 0
    d.day = 0
    d.hour = 0
    d.min = 0
    d.sec = 0

    ; 解析 YYYY-MM-DD
    i <- [0..4): {

        c = s[i]
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        d.year = d.year * 10 + (c - 48)
    }
    s[4] != 45 -> {

        return
    }
    i <- [5..7): {

        c = s[i]
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        d.month = d.month * 10 + (c - 48)
    }
    s[7] != 45 -> {

        return
    }
    i <- [8..10): {

        c = s[i]
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        d.day = d.day * 10 + (c - 48)
    }

    ; 驗證日期範圍
    {
        d.month < 1 -> return

        d.month > 12 -> return
    }
    {
        d.day < 1 -> return

        d.day > 31 -> return
    }

    ; 可選的時間部分 HH:MM:SS
    n >= 19 -> {
        s[10] != 32 -> {

            return
        }
        i <- [11..13): {

            c = s[i]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            d.hour = d.hour * 10 + (c - 48)
        }
        s[13] != 58 -> {

            return
        }
        i <- [14..16): {

            c = s[i]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            d.min = d.min * 10 + (c - 48)
        }
        s[16] != 58 -> {

            return
        }
        i <- [17..19): {

            c = s[i]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            d.sec = d.sec * 10 + (c - 48)
        }
        d.hour > 23 -> return
        d.min > 59 -> return
        d.sec > 59 -> return
    }
    ts = date-to-unix(d)
}

; 取得當前日期時間結構體（UTC）
; [now-date](#time.now-date)
now-date = () (d date) {
    ts = os.now()
    d = unix-to-date(ts)
}

; ═══════════════════════════════════════════════
; time 結構體（時間點）
; ═══════════════════════════════════════════════

; time: 時間點結構體（UTC）
; 以 Unix 秒（sec）與納秒（nsec，0~999,999,999）表示一個絕對時間點。
; 搭配 now-time、unix-to-time 等構造函式與 .unix、.date、.format 等方法，
; 讓呼叫端以 time 而非裸 i64 時間戳操作時間。
time {
    sec i64
    nsec i64
}

; 當前時間點（UTC）
; 由 builtin now-ns()（CLOCK_REALTIME 奈秒）拆解出 sec 與 nsec
; [now-time](#time.now-time)
now-time = () (t time) {
    ns = now-ns()

    #{overflow=wrap}
    t.sec = ns / 1000000000

    #{overflow=wrap}
    t.nsec = ns % 1000000000
}

; 由 Unix 秒時間戳構造 time（nsec=0）
; [unix-to-time](#time.unix-to-time)
unix-to-time = (ts i64) (t time) {
    t.sec = ts
    t.nsec = 0
}

; 計算兩個 time 的差（秒）
; [duration-time](#time.duration-time)
duration-time = (start time, end time) (diff i64) {

    #{overflow=wrap}
    diff = end.sec - start.sec
}

; 從 start 到現在的經過秒數
; [since-time](#time.since-time)
since-time = (start time) (diff i64) {
    now-t time
    now-t = now-time()

    #{overflow=wrap}
    diff = now-t.sec - start.sec
}

; 解析日期字串為 time
; 支援格式同 parse-date：YYYY-MM-DD HH:MM:SS 或 YYYY-MM-DD
; 返回 ?time：ok=time, nil=解析失敗
; [parse-time](#time.parse-time)
parse-time = (s str) (t ?time) {
    t = nil
    ts = parse-date(s)
    ts: {
        ok -> t = unix-to-time(it)

        ; nil / err → 解析失敗，保持 t = nil
        -> return
    }
}

; 取得 Unix 秒時間戳
; [unix](#time.unix)
time.unix = () (ts i64) {
    ts = .sec
}

; 取得 Unix 毫秒時間戳
; [unix-ms](#time.unix-ms)
time.unix-ms = () (ms i64) {

    #{overflow=wrap}
    ms = .sec * 1000 + .nsec / 1000000
}

; 轉換為 date 結構體（UTC，忽略 nsec）
; [date](#time.date)
time.date = () (d date) {
    d = unix-to-date(.sec)
}

; 格式化為 'YYYY-MM-DD HH:MM:SS'（UTC，忽略 nsec）
; [format](#time.format)
time.format = () (out str) {
    d date
    d = unix-to-date(.sec)
    out = format-date(d)
}

; 增加秒數，回傳新的 time
; [add-seconds](#time.add-seconds)
time.add-seconds = (n i64) (t time) {

    #{overflow=wrap}
    t.sec = .sec + n
    t.nsec = .nsec
}

; 與另一個 time 的差（秒，. - other）
; [sub](#time.sub)
time.sub = (other time) (diff i64) {

    #{overflow=wrap}
    diff = .sec - other.sec
}
