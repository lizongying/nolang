; math - 数学函数标准库
PI = 3.141592653589793
E = 2.718281828459045

; 基础
#{buildin=abs}
abs = (x f64) (res f64) { }

#{buildin=max}
max = (a f64, b f64) (res f64) { }

#{buildin=min}
min = (a f64, b f64) (res f64) { }

; 幂与根
#{buildin=sqrt}
sqrt = (x f64) (res f64) { }

; cbrt: 立方根
; 使用 exp(log(|x|) / 3) 實現，避開與 number.no / bigint.no 中整數 pow 的名稱衝突
cbrt = (x f64) (res f64) {
    x == 0.0 -> {
        res = 0.0
        return
    }
    {
        x < 0.0 -> {
            #{overflow = wrap}
            ax f64 = 0.0 - x
            l f64 = log(ax)
            #{overflow = wrap}
            res = 0.0 - exp(l / 3.0)
        }
        -> {
            l f64 = log(x)
            #{overflow = wrap}
            res = exp(l / 3.0)
        }
    }
}

#{buildin=pow}
pow = (x f64, y f64) (res f64) { }

; hypot: 歐幾里得範數 sqrt(x*x + y*y)
hypot = (x f64, y f64) (res f64) {
    #{overflow = wrap}
    res = sqrt(x * x + y * y)
}

; 三角函数（弧度）
#{buildin=sin}
sin = (x f64) (res f64) { }

#{buildin=cos}
cos = (x f64) (res f64) { }

; tan: tangent = sin/cos
tan = (x f64) (res f64) {
    #{overflow = wrap}
    res = sin(x) / cos(x)
}

#{buildin=asin}
asin = (x f64) (res f64) { }

#{buildin=acos}
acos = (x f64) (res f64) { }

#{buildin=atan}
atan = (x f64) (res f64) { }

#{buildin=atan2}
atan2 = (y f64, x f64) (res f64) { }

; 双曲函数
#{buildin=sinh}
sinh = (x f64) (res f64) { }

#{buildin=cosh}
cosh = (x f64) (res f64) { }

#{buildin=tanh}
tanh = (x f64) (res f64) { }

; 取整
#{buildin=ceil}
ceil = (x f64) (res f64) { }

#{buildin=floor}
floor = (x f64) (res f64) { }

#{buildin=round}
round = (x f64) (res f64) { }

#{buildin=trunc}
trunc = (x f64) (res f64) { }

; 指数对数
#{buildin=exp}
exp = (x f64) (res f64) { }

#{buildin=log}
log = (x f64) (res f64) { }

#{buildin=log10}
log10 = (x f64) (res f64) { }

#{buildin=log2}
log2 = (x f64) (res f64) { }

; 杂项
; fmod: 浮點取餘
fmod = (x f64, y f64) (res f64) {
    y == 0.0 -> {
        #{overflow = wrap}
        res = 0.0 / 0.0
        return
    }
    #{overflow = wrap}
    q f64 = x / y
    #{overflow = wrap}
    res = x - trunc(q) * y
}

; degrees: 弧度转角度
degrees = (r f64) (res f64) {
    #{overflow = wrap}
    res = r * 180.0 / PI
}

; radians: 角度转弧度
radians = (d f64) (res f64) {
    #{overflow = wrap}
    res = d * PI / 180.0
}
; ═══════════════════════════════════════════════
; 整數數學函數（內建）
; ═══════════════════════════════════════════════
; clamp: 將值限制在 [min, max] 範圍內
#{buildin=clamp}
clamp = (val i64, min i64, max i64) (result i64) { }
