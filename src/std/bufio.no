; bufio — 緩衝 I/O
;
; 為 os.read / os.write 提供緩衝讀寫和行讀取功能。

; reader: 緩衝讀取器狀態
; fd fd: 已開啟的檔案描述符，由 fs.read 消費
; buf []byte: 由呼叫方提供的緩衝區（容量決定單次讀取上限）
; pos i64: 下一次從 buf 取用的下標
; avail i64: buf 中已填充、尚未消費的位元組數
reader {
    fd fd
    buf []byte
    pos i64
    avail i64
}

; 建立緩衝讀取器
; fd fd: 已開啟且可讀的檔案描述符
; buf []byte: 專用緩衝區；長度可為 0，fill() 會使用 buf.cap 讀入
; r reader: 初始化後的讀取器（pos=0、avail=0，不預先讀取）
; [init](#bufio.reader.init)
reader.init = (fd fd, buf []byte) (r reader) {
    r.fd = fd
    r.buf = buf
    r.pos = 0
    r.avail = 0
}

; 填充緩衝區
; 已有未消費資料（avail > 0）時直接複用；否則向 fd 讀一次並重置 pos/avail。
; ok bool: true=緩衝區內有新資料可讀；false=EOF、讀取錯誤或 fd 位置無效
; [fill](#bufio.reader.fill)
reader.fill = () (ok bool) {
    .pos < 0 -> return
    .avail > 0 -> {
        ok = true
        return
    }
    n = fs.read(.fd, .buf, .buf.cap)
    n > 0 -> {
        .pos = 0
        .avail = n
        .buf.len = n
        ok = true
    }
}

; 讀取一個位元組
; b ?byte: ok=下一個位元組, nil=已到 EOF 或讀取失敗
; [read-byte](#bufio.reader.read-byte)
reader.read-byte = () (b ?byte) {

    ok = .fill()
    ok == false -> {
        b = nil
        return
    }

    b = .buf[.pos]

    #{overflow=wrap}
    .pos = .pos + 1
}

; 讀取一行（遇 '\n' 停止，換行符不包含在結果內）
; 行尾無換行時返回剩餘內容；file 已空且本次未讀到任何內容時返回 nil。
; line ?str: ok=該行文字（不帶 '\n'）, nil=EOF 且無殘餘內容
; [read-line](#bufio.reader.read-line)
reader.read-line = () (line ?str) {
    line = nil
    acc = ''
    got = false
    !! {

        ; 緩衝區耗盡（pos 到了 avail）時重新填充；fill 只對 avail==0 才真正讀，
        ; 故需先重置 pos/avail，否則 fill 會因殘留 avail>0 直接回 true 而無限迴圈。
        (.pos >= .avail) {
            .pos = 0
            .avail = 0
            fok = .fill()
            fok == false -> {
                got -> line = acc
                return
            }
        }
        (.pos < .avail) {

            c = .buf[.pos]

            #{overflow=wrap}
            .pos = .pos + 1
            c == 10 -> {
                line = acc
                return
            }

            ; 逐字元拼接構建整行（char.to-str 回傳 str，可用 - 拼接；
            ; 避免 []byte.to-str 對 push 構成的向量回空字串的已知問題）。
            ch char = c
            acc = acc - ch.to-str()
            got = true
        }
    }
}

; 關閉讀取器（只關 fd，不釋放 buf；buf 由呼叫方的作用域管理）
; 無參數與返回值；關閉失敗（如 fd 已關）不報錯
; [close](#bufio.reader.close)
reader.close = () {
    fs.close(.fd)
}
