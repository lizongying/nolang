; bufio — 緩衝 I/O
;
; 為 os.read / os.write 提供緩衝讀寫和行讀取功能。

; reader: 緩衝讀取器
reader {
    fd fd
    buf []byte
    pos i64
    avail i64
}

; 建立緩衝讀取器
; [init](#bufio.reader.init)
reader.init = (fd fd, buf []byte) (r reader) {
    r.fd = fd
    r.buf = buf
    r.pos = 0
    r.avail = 0
}

; 填充緩衝區
; [fill](#bufio.reader.fill)
reader.fill = () (ok bool) {
    .pos < 0 -> return
    .avail > 0 -> {
        ok = true
        return
    }
    n = fs.read(.fd, .buf, .buf.cap)
    n > 0 -> {
        .pos = 0
        .avail = n
        .buf.len = n
        ok = true
    }
}

; 讀取一個位元組
; 返回 b ?byte: ok=位元組值, nil=EOF 或錯誤
; [read-byte](#bufio.reader.read-byte)
reader.read-byte = () (b ?byte) {

    ok = .fill()
    ok == false -> {
        b = nil
        return
    }

    b = .buf[.pos]

    #{overflow=wrap}
    .pos = .pos + 1
}

; 讀取一行
; 返回 line ?str: ok=讀取內容, nil=EOF 或錯誤
; [read-line](#bufio.reader.read-line)
reader.read-line = () (line ?str) {
    line = nil
    acc str = ''
    got bool = false
    !! {
        ; 緩衝區耗盡（pos 到了 avail）時重新填充；fill 只對 avail==0 才真正讀，
        ; 故需先重置 pos/avail，否則 fill 會因殘留 avail>0 直接回 true 而無限迴圈。
        (.pos >= .avail) {
            .pos = 0
            .avail = 0
            fok = .fill()
            fok == false -> {
                got -> line = acc
                return
            }
        }
        (.pos < .avail) {

            c = .buf[.pos]

            #{overflow=wrap}
            .pos = .pos + 1
            c == 10 -> {
                line = acc
                return
            }

            ; 逐字元拼接構建整行（char.to-str 回傳 str，可用 - 拼接；
            ; 避免 []byte.to-str 對 push 構成的向量回空字串的已知問題）。
            ch char = c
            acc = acc - ch.to-str()
            got = true
        }
    }
}

; 關閉
; [close](#bufio.reader.close)
reader.close = () {
    fs.close(.fd)
}
