; xz — XZ / LZMA 壓縮與解壓縮（純 Nolang 實現）
;
; 實現 LZMA2 解壓縮演算法，支援：
;   - .xz 格式解壓縮（XZ container + LZMA2 stream）
;   - .lzma 格式解壓縮（傳統 LZMA alone 格式）
;
; 用法：
;   data = fs.read-file('example.xz')    ; 讀取 xz 檔案
;   decompressed = xz.decompress(data)    ; 解壓 xz 格式
;
;   data = fs.read-file('example.lzma')  ; 讀取 lzma 檔案
;   decompressed = lzma-decompress(data)  ; 解壓傳統 lzma 格式
;
; 演算法參考：
;   - LZMA specification: https://www.7-zip.org/sdk.html (LZMA SDK)
;   - XZ format: https://tukaani.org/xz/xz-file-format.txt
; [xz](#xz)

; LZMA 範圍解碼器（Range Decoder）
...

; lzma-range-decoder: LZMA 算術範圍解碼器
; [lzma-rd](#xz.lzma-rd)
lzma-rd {
    data []byte
    pos i64
    range i64
    code i64
}

; 初始化範圍解碼器
; data: 待解碼的 LZMA 壓縮位元組流
; start-pos: 資料中開始解碼的位元組偏移
; [init](#xz.lzma-rd.init)
lzma-rd.init = (data []byte, start-pos i64) {
    .data = data

    ; 跳過第一個位元組（必須為 0）
    #{overflow=wrap}
    .pos = start-pos + 1: {
        ok -> it

        ->
    }
    .range = 0xffffffff
    .code = 0
    i <- [0..4): {
        {
            v ?= .data[.pos]
            .code = (.code << 8) | v
        }: {
            err -> _

            -> _
        }

        #{overflow=wrap}
        .pos = .pos + 1: {
            ok -> it

            ->
        }
    }
}

; 範圍解碼器正規化
; [normalize](#xz.lzma-rd.normalize)
lzma-rd.normalize = () {
    .range < 0x1000000 -> {
        {
            v ?= .data[.pos]
            .code = (.code << 8) | v
        }: {
            err -> _

            -> _
        }

        #{overflow=wrap}
        .pos = .pos + 1: {
            ok -> it

            ->
        }
        .range = .range << 8
    }
}

; 解碼一個位元
; prob: 機率值（0-0x7FFF），返回 bit 和更新後的 prob
; bit: 解出的位元（0 或 1）
; new-prob: 自適應更新後的機率值（供下次解碼續用）
; [decode-bit](#xz.lzma-rd.decode-bit)
lzma-rd.decode-bit = (prob i64) (bit i64, new-prob i64) {
    .normalize()

    #{overflow=wrap}
    bound = (.range >> 11) * prob

    bit = 0

    {
        .code < bound -> {
            .range = bound

            #{overflow=wrap}
            new-prob = prob + ((0x800 - prob) >> 5)
            bit = 0
        }

        .code >= bound -> {

            #{overflow=wrap}
            .range = .range - bound: {
                ok -> it

                ->
            }

            #{overflow=wrap}
            .code = .code - bound: {
                ok -> it

                ->
            }

            #{overflow=wrap}
            new-prob = prob - (prob >> 5)
            bit = 1
        }
    }
}

; 解碼 n 個直接位元
; num-bits: 要解碼的直接位元數（不走機率模型）
; res: num-bits 個位元拼出的原始整數值
; [decode-direct-bits](#xz.lzma-rd.decode-direct-bits)
lzma-rd.decode-direct-bits = (num-bits i64) (res i64) {
    res = 0
    i <- [0..num-bits): {
        .normalize()
        .range = .range >> 1

        #{overflow=wrap}
        t = .code - .range: {
            ok -> it

            ->
        }
        {
            t < 0 -> .code = t

            t >= 0 -> {
                .code = .range
                res = (res << 1) | 1
            }
        }
        res < 0 -> res = res & 0x7fffffffffffffff; 防止溢位
    }
}

; 解碼位元樹
; num-bits: 樹的深度，probs: 機率陣列，返回符號
; probs: 位元樹各節點的機率陣列
; sym: 沿樹逐位元走到底解出的符號值
; [decode-bit-tree](#xz.lzma-rd.decode-bit-tree)
lzma-rd.decode-bit-tree = (probs []i64, num-bits i64) (sym i64) {
    m = 1
    i <- [0..num-bits): {
        probs-m = probs[m]: {
            ok -> it

            -> _
        }

        bit, tmp = .decode-bit(probs-m)

        probs[m]: {
            ok -> it = tmp

            -> _
        }
        m = (m << 1) | bit
    }

    #{overflow=wrap}
    sym = m - (1 << num-bits)
}

; 解碼反向位元樹
; probs: 位元樹各節點的機率陣列
; num-bits: 樹深（解出符號的位元數）
; sym: 反向（低位到高位）走樹解出的符號值
; [decode-reverse-bit-tree](#xz.lzma-rd.decode-reverse-bit-tree)
lzma-rd.decode-reverse-bit-tree = (probs []i64, num-bits i64) (sym i64) {
    m = 1
    sym = 0
    i <- [0..num-bits): {
        {
            ; 取出當前節點機率，走一位後把更新後的機率寫回同一節點
            node-prob ?= probs[m]

            bit, new-prob = .decode-bit(node-prob)

            probs[m]: {
                ok -> it = new-prob

                -> _
            }

            m = (m << 1) | bit
            sym = sym | (bit << i)
        }: {
            err -> _

            -> _
        }
    }
}

; LZMA 解碼器狀態
...

; LZMA 機率模型大小
; [LZMA-NUM-STATES](#xz.lzma-num-states)
LZMA-NUM-STATES = 12
LZMA-NUM-LEN-LOW-BITS = 3
LZMA-NUM-LEN-LOW-SYMS = 8; 1 << 3
LZMA-NUM-LEN-MID-BITS = 3
LZMA-NUM-LEN-MID-SYMS = 8; 1 << 3
LZMA-NUM-LEN-HIGH-BITS = 8
LZMA-NUM-LEN-HIGH-SYMS = 256; 1 << 8
LZMA-NUM-LEN-PROBS = 0x200; 2 + 2*(8+8+256)
LZMA-NUM-DIST-SLOTS = 64
LZMA-NUM-DIST-LOW-BITS = 4
LZMA-NUM-DIST-MID-BITS = 4
LZMA-NUM-DIST-HIGH-BITS = 8
LZMA-NUM-FULL-DISTANCES = 128; 1 << (4+3)
LZMA-NUM-ALIGN-BITS = 4
LZMA-NUM-ALIGN-SYMS = 16; 1 << 4

; LZMA 解碼常數
; [LZMA-EOF-SYM](#xz.lzma-eof-sym)
LZMA-EOF-SYM = 0x100
LZMA-MIN-MATCH = 2

; lzma-decoder: LZMA 解碼器
; [lzma-decoder](#xz.lzma-decoder)
lzma-decoder {
    rd lzma-rd
    lc i64
    lp i64
    pb i64
    out []byte
    is-match [16]i64
    is-rep [16]i64
    is-rep-g0 [16]i64
    is-rep-g1 [16]i64
    is-rep-g2 [16]i64
    is-rep0-long [16]i64
    pos-slot [256]i64
    spec-pos [128]i64
    align [16]i64
    len-coder []i64
    rep-len-coder []i64
    literal [768]i64
    state i64
    rep0 i64
    rep1 i64
    rep2 i64
    rep3 i64
    prev-byte i64
}

; 屬性
; literal context bits
; literal position bits
; position bits
; 輸出
; 機率模型
; 12 states * 4 (padded)
; 4 states * 64 slots (flattened)
; special positions
; alignment
; length coder
; rep length coder
; literal (simplified)
; 狀態
; 前一個字節
; 初始化所有機率值為 0x400（一半機率）
; [init-probs](#xz.lzma-decoder.init-probs)
lzma-decoder.init-probs = () {
    {
        i <- [0..16): {
            .is-match[i] ?= 0x400

            .is-rep[i] ?= 0x400

            .is-rep-g0[i] ?= 0x400

            .is-rep-g1[i] ?= 0x400

            .is-rep-g2[i] ?= 0x400

            .is-rep0-long[i] ?= 0x400
        }
        i <- [0..4): {
            j <- [0..64): {

                #{overflow=wrap}
                lid = i * 64 + j
                .pos-slot[lid] ?= 0x400
            }
        }
        i <- [0..128): {
            .spec-pos[i] ?= 0x400
        }
        i <- [0..16): {
            .align[i] ?= 0x400
        }
        i <- [0..0x200): {
            .len-coder[i] ?= 0x400

            .rep-len-coder[i] ?= 0x400
        }
        i <- [0..0x300): {
            .literal[i] ?= 0x400
        }
        .state = 0
        .rep0 = 0
        .rep1 = 0
        .rep2 = 0
        .rep3 = 0
        .prev-byte = 0
    }: {
        err -> _

        -> _
    }
}

; 更新狀態（字面量後）
; [update-state-literal](#xz.lzma-decoder.update-state-literal)
lzma-decoder.update-state-literal = () {
    .state < 4 -> {
        .state = 0
        return
    }
    .state < 10 -> {

        #{overflow=wrap}
        st = .state - 3
        .state = st: {
            ok -> it

            -> .state
        }
        return
    }

    #{overflow=wrap}
    st2 = .state - 6
    .state = st2: {
        ok -> it

        -> .state
    }
}

; 更新狀態（匹配後）
; [update-state-match](#xz.lzma-decoder.update-state-match)
lzma-decoder.update-state-match = () {
    .state >= 7 -> {
        .state = 10
        return
    }
    .state = 7
}

; 更新狀態（重複匹配後）
; [update-state-rep](#xz.lzma-decoder.update-state-rep)
lzma-decoder.update-state-rep = () {
    .state >= 7 -> {
        .state = 11
        return
    }
    .state = 8
}

; 更新狀態（短重複後）
; [update-state-shortrep](#xz.lzma-decoder.update-state-shortrep)
lzma-decoder.update-state-shortrep = () {
    .state >= 7 -> {
        .state = 11
        return
    }
    .state = 9
}

; 解碼字面量
; [decode-literal](#xz.lzma-decoder.decode-literal)
lzma-decoder.decode-literal = () {

    ; 簡化版：直接從範圍解碼器讀取一個位元組
    ; 完整版本需要考慮 lc/lp/pb 和前一個字節的上下文
    prev = .prev-byte

    ; 使用前一個字節的高位作為上下文
    ctx = prev >> (8 - .lc)

    ; 解碼 8 個位元
    b = 0
    i <- [0..8): {

        ; 選擇機率
        #{overflow=wrap}
        prob-idx = ctx + 0x100
        symbol = 1
        (symbol < 0x100) {
            {

                #{overflow=wrap}
                lid = prob-idx + symbol

                p ?= .literal[lid]

                bit, tmp = .rd.decode-bit(p)

                .literal[lid] ?= tmp
                symbol = (symbol << 1) | bit
            }: {
                err -> _

                -> _
            }
        }
        b = (b << 1) | (symbol & 1)
    }
    .out.push(b)
    .prev-byte = b
    .update-state-literal()
}

; 解碼匹配長度
; probs: 機率陣列，返回長度
; length: 解出的匹配長度（含選擇器與低位/對齊位元組合）
; [decode-length](#xz.lzma-decoder.decode-length)
lzma-decoder.decode-length = (probs []i64) (length i64) {

    ; 選擇低位/中位/高位
    selector-prob = probs[0]: {
        ok -> it

        -> 0
    }

    is-mid, new-prob = .rd.decode-bit(selector-prob)

    probs[0]: {
        ok -> it = new-prob

        -> _
    }
    is-mid == 0 -> {

        ; 低位：3 bits
        sym = .rd.decode-bit-tree(probs, 3)
        length = sym
        return
    }

    second-prob = probs[1]: {
        ok -> it

        -> 0
    }

    is-high, new-prob-2 = .rd.decode-bit(second-prob)

    probs[1]: {
        ok -> it = new-prob-2

        -> _
    }

    is-high == 0 -> {

        ; 中位：3 bits + 8（使用從 index 2 起的子陣列）
        sub-probs []i64
        i <- [0..8): {
            {
                #{overflow=wrap}
                tree-at ?= 2 + i

                tree-prob ?= probs[tree-at]

                sub-probs.push(tree-prob)
            }: {
                err -> _

                -> _
            }
        }
        sym = .rd.decode-bit-tree(sub-probs, 3)
        {
            #{overflow=wrap}
            length ?= sym + 8
        }: {
            err -> _

            -> _
        }
        return
    }

    ; 高位：8 bits + 16（使用從 index 10 起的子陣列）
    sub-probs []i64
    i <- [0..256): {
        {
            #{overflow=wrap}
            tree-at ?= 10 + i

            tree-prob ?= probs[tree-at]

            sub-probs.push(tree-prob)
        }: {
            err -> _

            -> _
        }
    }
    sym = .rd.decode-bit-tree(sub-probs, 8)

    {
        #{overflow=wrap}
        length ?= sym + 16
    }: {
        err -> _

        -> _
    }
}

; 解碼匹配距離
; length: 匹配長度（用於決定距離編碼方式）
; dist: 匹配距離（自當前寫入位置向後回溯的位元組偏移）
; [decode-distance](#xz.lzma-decoder.decode-distance)
lzma-decoder.decode-distance = (length i64) (dist i64) {

    ; 根據狀態選擇 pos-slot 機率表
    st = .state
    st > 3 -> st = 3

    ; 解碼 pos-slot（6 bits）
    slot-probs []i64
    i <- [0..64): {
        {

            #{overflow=wrap}
            v ?= .pos-slot[st * 64 + i]
            slot-probs.push(v)
        }: {
            err -> _

            -> _
        }
    }
    pos-slot = .rd.decode-bit-tree(slot-probs, 6)

    ; 根據 pos-slot 計算距離
    pos-slot < 4 -> {
        dist = pos-slot
        return
    }

    ; 計算額外位元數
    #{overflow=wrap}
    num-direct-bits = (pos-slot >> 1) - 1
    base = (2 | (pos-slot & 1)) << num-direct-bits

    pos-slot < 14 -> {

        ; 使用反向位元樹
        sub-probs []i64
        i <- [0..1 << num-direct-bits): {
            {

                #{overflow=wrap}
                v ?= .spec-pos[base - pos-slot - 1 + i]
                sub-probs.push(v)
            }: {
                err -> _

                -> _
            }
        }
        sym = .rd.decode-reverse-bit-tree(sub-probs, num-direct-bits)
        {
            #{overflow=wrap}
            dist ?= base + sym
        }: {
            err -> _

            -> _
        }
        return
    }

    ; 直接位元 + 對齊
    #{overflow=wrap}
    direct = .rd.decode-direct-bits(num-direct-bits - 4)
    align-probs []i64
    i <- [0..16): {
        {
            v ?= .align[i]
            align-probs.push(v)
        }: {
            err -> _

            -> _
        }
    }
    align = .rd.decode-reverse-bit-tree(align-probs, 4)

    #{overflow=wrap}
    dist = base + (direct << 4) + align
}

; LZMA 解碼主迴圈
; data: 壓縮資料，start-pos: 資料起始位置
; unpacked-size: 預期解壓大小（-1 表示未知）
; start-pos: data 中 LZMA 流的解碼起始偏移
; [decode](#xz.lzma-decoder.decode)
lzma-decoder.decode = (data []byte, start-pos i64, unpacked-size i64) {
    .rd.init(data, start-pos)
    .init-probs()

    !! {

        ; 檢查是否達到預期大小
        unpacked-size >= 0 -> .out.len() >= unpacked-size -> break

        ; 解碼 is_match
        bit = 0
        tmp = 0
        {
            prob ?= .is-match[.state]

            bit, tmp = .rd.decode-bit(prob)

            .is-match[.state] ?= tmp
        }: {
            err -> _

            -> _
        }

        bit == 0 -> {

            ; 字面量
            .decode-literal()
        }
        bit == 1 -> {

            ; 匹配或重複
            bit2 = 0
            {
                prob ?= .is-rep[.state]

                bit2, tmp = .rd.decode-bit(prob)

                .is-rep[.state] ?= tmp
            }: {
                err -> _

                -> _
            }

            {
                bit2 == 0 -> {

                    ; 簡單匹配
                    length = .decode-length(.len-coder)
                    dist = .decode-distance(length)

                    ; 更新重複距離
                    .rep3 = .rep2
                    .rep2 = .rep1
                    .rep1 = .rep0
                    .rep0 = dist

                    .update-state-match()

                    ; 複製匹配資料
                    ; length + LZMA-MIN-MATCH 個字節
                    #{overflow=wrap}
                    actual-len = length + LZMA-MIN-MATCH
                    i <- [0..actual-len): {

                        #{overflow=wrap}
                        src-pos = .out.len() - .rep0 - 1
                        src-pos >= 0 -> {
                            b = .out[src-pos]: {
                                ok -> it

                                -> _
                            }
                            .out.push(b)
                            .prev-byte = b
                        }
                        src-pos < 0 -> {
                            .out.push(0)
                            .prev-byte = 0
                        }
                    }
                }

                bit2 == 1 -> {

                    ; 重複匹配
                    bit3 = 0
                    {
                        prob ?= .is-rep-g0[.state]

                        bit3, tmp = .rd.decode-bit(prob)

                        .is-rep-g0[.state] ?= tmp
                    }: {
                        err -> _

                        -> _
                    }

                    bit3 == 0 -> {

                        ; rep0
                        bit4 = 0
                        {
                            prob ?= .is-rep0-long[.state]

                            bit4, tmp = .rd.decode-bit(prob)

                            .is-rep0-long[.state] ?= tmp
                        }: {
                            err -> _

                            -> _
                        }
                        bit4 == 0 -> {

                            ; 短重複（1 字節）
                            .update-state-shortrep()

                            #{overflow=wrap}
                            src-pos = .out.len() - .rep0 - 1
                            src-pos >= 0 -> {
                                b = .out[src-pos]: {
                                    ok -> it

                                    -> _
                                }
                                .out.push(b)
                                .prev-byte = b
                            }
                        }
                        bit4 == 1 -> {

                            ; 長重複
                            length = .decode-length(.rep-len-coder)
                            .update-state-rep()
                            i <- [0..length + LZMA-MIN-MATCH): {

                                #{overflow=wrap}
                                src-pos = .out.len() - .rep0 - 1
                                src-pos >= 0 -> {
                                    b = .out[src-pos]: {
                                        ok -> it

                                        -> _
                                    }
                                    .out.push(b)
                                    .prev-byte = b
                                }
                                src-pos < 0 -> {
                                    .out.push(0)
                                    .prev-byte = 0
                                }
                            }
                        }
                    }
                    bit3 == 1 -> {

                        ; rep1, rep2, or rep3
                        ; 簡化處理
                        .rep3 = .rep2
                        .rep2 = .rep1
                        .rep1 = .rep0

                        length = .decode-length(.rep-len-coder)
                        .update-state-rep()

                        i <- [0..length + LZMA-MIN-MATCH): {

                            #{overflow=wrap}
                            src-pos = .out.len() - .rep0 - 1
                            src-pos >= 0 -> {
                                b = .out[src-pos]: {
                                    ok -> it

                                    -> _
                                }
                                .out.push(b)
                                .prev-byte = b
                            }
                            src-pos < 0 -> {
                                .out.push(0)
                                .prev-byte = 0
                            }
                        }
                    }
                }
            }
        }
    }
}

; .lzma 格式解壓縮（傳統 LZMA alone 格式）
...

; 解壓縮傳統 .lzma 格式
;   data: .lzma 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
;
; .lzma 格式：
;   - 1 byte: properties (lc, lp, pb 編碼)
;   - 4 bytes: dict size (little-endian)
;   - 8 bytes: unpacked size (little-endian, 0xFFFFFFFFFFFFFFFF = unknown)
;   - compressed data
; [lzma-decompress](#xz.lzma-decompress)
lzma-decompress = (data []byte) (out []byte) {
    data.len() < 13 -> return

    ; 解析屬性
    props = data[0]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    pb = props / (9 * 5)

    rem = props % (9 * 5)

    #{overflow=wrap}
    lp = rem / 9
    lc = rem % 9

    ; 解析 dict size (4 bytes LE)：第 i 個位元組佔 bit [8*i, 8*i+8)
    dict-size i64 = 0
    i <- [0..4): {
        {
            #{overflow=wrap}
            byte-at ?= 1 + i

            dict-byte ?= data[byte-at]

            #{overflow=wrap}
            bit-shift ?= i * 8

            dict-size = dict-size | (dict-byte << bit-shift)
        }: {
            err -> _

            -> _
        }
    }

    ; 解析 unpacked size (8 bytes LE)
    unpacked-size i64 = 0
    i <- [0..8): {
        {
            #{overflow=wrap}
            byte-at ?= 5 + i

            size-byte ?= data[byte-at]

            #{overflow=wrap}
            bit-shift ?= i * 8

            unpacked-size = unpacked-size | (size-byte << bit-shift)
        }: {
            err -> _

            -> _
        }
    }

    ; 0xFFFFFFFFFFFFFFFF 表示未知大小
    unpacked-size < 0 -> unpacked-size = -1

    ; 建立解碼器
    dec = lzma-decoder{
        prev-byte: 0
    }
    dec.lc = lc
    dec.lp = lp
    pb: {
        ok -> dec.pb = it

        -> _
    }
    dec.state = 0
    dec.rep0 = 0
    dec.rep1 = 0
    dec.rep2 = 0
    dec.rep3 = 0
    dec.prev-byte = 0
    dec.decode(data, 13, unpacked-size)

    out = dec.out
}

; .xz 格式解壓縮（XZ container + LZMA2）
...

; XZ 常數
; [XZ-MAGIC](#xz.xz-magic)
XZ-MAGIC = [0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00]

; 解壓縮 .xz 格式
;   data: .xz 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
;
; .xz 格式：
;   - Stream Header: 6 bytes magic + 2 bytes stream flags
;   - Blocks: Block Header + Compressed Data + Block Padding + Check
;   - Index
;   - Stream Footer: 12 bytes
; [decompress](#xz.decompress)
decompress = (data []byte) (out []byte) {

    ; 先給空結果；Block 解壓時由 lzma2-decompress-stream 的結果覆寫
    out = []

    ; 檢查 XZ magic
    data.len() < 12 -> return
    i <- [0..6): {
        {
            magic-byte ?= data[i]

            magic-byte != XZ-MAGIC[i] -> { return }
        }: {
            err -> _

            -> _
        }
    }

    ; 跳過 Stream Header (12 bytes)
    pos = 12

    ; 讀取區塊
    (pos < data.len()) {
        pos >= data.len() -> break

        ; Index marker（0x00）代表後面已無 Block
        marker-byte = data[pos]: {
            ok -> it

            -> 0
        }

        marker-byte == 0 -> { break }

        ; Block Header Size：實際大小 = (value + 1) * 4
        header-start = pos
        header-field = data[pos]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        header-size = (header-field + 1) * 4

        ; 逐欄位解析 Block Header（Block Flags → 可選大小 → Filter ID → 屬性）
        block-flags i64 = 0
        props-size i64 = 0
        {
            ; Block Flags 欄位
            #{overflow=wrap}
            pos ?= pos + 1

            block-flags ?= data[pos]

            #{overflow=wrap}
            pos ?= pos + 1

            ; filter count（低 2 bits）此解析器不消費，顯式丟棄 option
            _ = (block-flags & 0x3) + 1

            ; 可選的壓縮大小／解壓大小欄位（變長整數，此解析器只跳過 1 byte）
            skipped-fields = 0
            (block-flags & 0x40) != 0 -> skipped-fields = 1
            (block-flags & 0x80) != 0 -> skipped-fields = 2

            #{overflow=wrap}
            pos ?= pos + skipped-fields

            ; Filter ID（固定 0x21 = LZMA2，此解析器不驗證）
            _ = data[pos]

            #{overflow=wrap}
            pos ?= pos + 1

            ; Filter Properties Size，後接等長度的屬性位元組
            props-size ?= data[pos]

            #{overflow=wrap}
            pos ?= pos + 1

            ; 屬性位元組（解碼端不使用，僅跳過）
            prop-bytes = 0
            props-size > 0 -> prop-bytes = 1

            #{overflow=wrap}
            pos ?= pos + prop-bytes
        }: {
            err -> _

            -> _
        }

        ; 壓縮資料緊接在 Block Header 之後
        {
            #{overflow=wrap}
            pos ?= header-start + header-size
        }: {
            err -> _

            -> _
        }

        ; 解壓 LZMA2 資料流（LHS 綁定：結果透過具名結果參數交付）
        out = lzma2-decompress-stream(data, pos)

        ; 尋找下一個區塊（跳過 padding 和 check）
        ; 簡化處理：假設只有一個區塊
        break
    }
}

; 解壓縮 LZMA2 資料流
; LZMA2 使用控制位元組來切分資料塊：
;   0x00 = 結束
;   0x01 = 未壓縮字典重置（帶 4-byte 字典 ID）
;   0x02 = 未壓縮無字典重置
;   0x80-0xBF = LZMA 壓縮（可能帶字典重置）
; out 是具名結果參數（out-parameter 語法糖）：呼叫處以 LHS 綁定接收變數。
; 函式體內先累積到本地 res，最後 out = res 交付（與 gzip.no 的
; inflate-decompress 等同一模式）；若把 out 宣告成普通輸入參數，輸入參數
; 為唯讀引用，push 的結果回不到呼叫方。
; data: 含控制位元組的 LZMA2 資料流
; start-pos: 資料流的起始偏移
; out: 解壓出的明文位元組流（具名輸出參數，函式末一次性交付）
; [lzma2-decompress-stream](#xz.lzma2-decompress-stream)
lzma2-decompress-stream = (data []byte, start-pos i64) (out []byte) {
    pos = start-pos
    res []byte

    !! {
        pos >= data.len() -> break

        ctrl = data[pos]: {
            ok -> it

            -> 0
        }

        {
            #{overflow=wrap}
            pos ?= pos + 1
        }: {
            err -> _

            -> _
        }

        ; 結束標記
        ctrl == 0 -> break

        ; 未壓縮區塊（字典重置）：2-byte 長度 + 4-byte 字典 ID + 原始位元組
        ctrl == 1 -> {
            chunk-size i64 = 0
            {
                ; 長度欄位：值 = 實際大小 - 1（大端序）
                high-byte ?= data[pos]

                low-byte ?= data[pos + 1]

                #{overflow=wrap}
                chunk-size ?= ((high-byte << 8) | low-byte) + 1

                ; 跳過長度欄位
                #{overflow=wrap}
                pos ?= pos + 2

                ; 跳過 4-byte 字典 ID（解碼端不使用）
                #{overflow=wrap}
                pos ?= pos + 4
            }: {
                err -> _

                -> _
            }

            ; 複製未壓縮資料
            i <- [0..chunk-size): {
                {
                    #{overflow=wrap}
                    byte-at ?= pos + i

                    copy-byte ?= data[byte-at]

                    res.push(copy-byte)
                }: {
                    err -> _

                    -> _
                }
            }

            {
                #{overflow=wrap}
                pos ?= pos + chunk-size
            }: {
                err -> _

                -> _
            }
        }

        ; 未壓縮區塊（無字典重置）：2-byte 長度 + 原始位元組
        ctrl == 2 -> {
            chunk-size i64 = 0
            {
                ; 長度欄位：值 = 實際大小 - 1（大端序）
                high-byte ?= data[pos]

                low-byte ?= data[pos + 1]

                #{overflow=wrap}
                chunk-size ?= ((high-byte << 8) | low-byte) + 1

                #{overflow=wrap}
                pos ?= pos + 2
            }: {
                err -> _

                -> _
            }

            i <- [0..chunk-size): {
                {
                    #{overflow=wrap}
                    byte-at ?= pos + i

                    copy-byte ?= data[byte-at]

                    res.push(copy-byte)
                }: {
                    err -> _

                    -> _
                }
            }

            {
                #{overflow=wrap}
                pos ?= pos + chunk-size
            }: {
                err -> _

                -> _
            }
        }

        ; LZMA 壓縮區塊
        ctrl >= 0x80 -> {

            ; 壓縮大小：高 5 bits 在 ctrl（bits 4-0），低 16 bits 在隨後 2 bytes
            size-high-part = ctrl & 0x1f

            comp-size i64 = 0
            plain-size i64 = 0
            {
                high-byte ?= data[pos]

                low-byte ?= data[pos + 1]

                comp-size = (size-high-part << 16) | (high-byte << 8) | low-byte

                #{overflow=wrap}
                pos ?= pos + 2

                ; 解壓後大小 (2 bytes，大端序)
                out-high-byte ?= data[pos]

                out-low-byte ?= data[pos + 1]

                plain-size = (out-high-byte << 8) | out-low-byte

                #{overflow=wrap}
                pos ?= pos + 2

                ; 字典重置位（此解析器不消費，顯式丟棄 option）
                _ = (ctrl & 0x20) != 0
            }: {
                err -> _

                -> _
            }

            ; 字典重置時緊跟 1 byte LZMA 屬性（解碼端固定 lc/lp/pb，不解析）
            props-skip = 0
            ctrl >= 0xc0 -> props-skip = 1
            {
                #{overflow=wrap}
                pos ?= pos + props-skip
            }: {
                err -> _

                -> _
            }

            ; 使用 LZMA 解碼器解壓縮
            dec lzma-decoder
            dec.lc = 3
            dec.lp = 0
            dec.pb = 2
            dec.state = 0
            dec.rep0 = 0
            dec.rep1 = 0
            dec.rep2 = 0
            dec.rep3 = 0
            dec.prev-byte = 0

            ; 取出本區塊的壓縮資料
            comp-data []byte
            i <- [0..comp-size): {
                {
                    #{overflow=wrap}
                    byte-at ?= pos + i

                    comp-byte ?= data[byte-at]

                    comp-data.push(comp-byte)
                }: {
                    err -> _

                    -> _
                }
            }

            {
                #{overflow=wrap}
                pos ?= pos + comp-size
            }: {
                err -> _

                -> _
            }

            #{overflow=wrap}
            dec.decode(comp-data, 0, plain-size + 1)

            ; 將解壓結果附加到輸出
            i <- [0..dec.out.len()): {
                {
                    b ?= dec.out[i]

                    res.push(b)
                }: {
                    err -> _

                    -> _
                }
            }
        }
    }

    ; 交付結果（具名結果參數）
    out = res
}

; 壓縮（基本實現 — stored block）
...

; 使用 xz 格式壓縮資料（基本實現）
;   data: 原始資料 ([]byte)
;   out: xz 壓縮後的資料 ([]byte)
; 注意：目前使用 stored block 的基本實現，
;       完整 LZMA2 壓縮待後續實現。
; [compress](#xz.compress)
compress = (data []byte) (out []byte) {

    ; Stream Header: magic (6 bytes) + stream flags (2 bytes) + CRC32 (4 bytes)
    ; 共 12 bytes（decompress 跳過的正是 12 bytes，缺 CRC32 會讓 Block
    ; 整體前移 4 bytes 而解不出來）
    ; `XZ-MAGIC[i]` 與任何下標讀取一樣是 ?byte（越界為 err）。先解包再 push：
    ; 直接把 option 交給 `push` 會讓 MIR 以 option 的寬度寫進按元素寬度配置的
    ; 緩衝區（codegen 現在直接拒絕，見 §5.2s）。
    i <- [0..6): {
        magic-byte = XZ-MAGIC[i]: {
            ok -> it

            -> 0
        }
        out.push(magic-byte)
    }

    ; Stream Flags: Check = CRC32 (0x01)
    out.push(0x01)
    out.push(0x00)

    ; Stream Flags CRC32（解碼端未驗證，填 0；真實 xz 工具需要 CRC32）
    out.push(0x00)
    out.push(0x00)
    out.push(0x00)
    out.push(0x00)

    ; 空輸入：不寫任何 Block，直接進 Index（與解碼端一致：pos=12 讀到
    ; 0x00 即 Index marker，返回空結果）
    (data.len() > 0) -> {

        ; Block Header: 12 bytes
        ;   [0] header-size 欄位 = (12/4)-1 = 2
        ;   [1] block-flags = 0x00（1 個 filter，無壓縮/解壓大小欄位）
        ;   [2] filter-id = 0x21（LZMA2）
        ;   [3] filter props size = 1
        ;   [4] LZMA2 dict props（解碼端未使用）
        ;   [5..7] 保留 0
        ;   [8..11] header CRC32（解碼端未驗證，填 0）
        out.push(0x02)
        out.push(0x00)
        out.push(0x21)
        out.push(0x01)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)

        ; LZMA2 未壓縮區塊（ctrl=0x01，字典重置）
        ; 規格：2-byte 大小欄位 = 實際大小 - 1（大端序），後跟 4-byte 字典 ID
        out.push(0x01)

        ; 大小欄位 = 實際大小 - 1（大端序）。算術結果是 ?i64，靠 match 解包；
        ; 已由 `(data.len() > 0)` 保證 len >= 1，減一不會溢出。
        chunk-size = data.len() - 1: {
            ok -> it

            -> 0
        }
        hi = (chunk-size >> 8) & 0xff
        lo = chunk-size & 0xff
        out.push(hi)
        out.push(lo)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)
        out.push(0x00)
        b <- data: {
            out.push(b)
        }

        ; LZMA2 結束標記
        out.push(0x00)

        ; Block Padding：Block（header + 資料）對齊到 4-byte 邊界
        ; 已寫 12(stream) + 12(header) + 7(chunk 頭 + 字典 ID) + len + 1(結束標記)
        ; = 32 + len，故 padding = (-len) & 0x3
        ;
        ; 這裡用 `?=` 而非值位 match：`&` 是位元運算，結果不是 option（D6 的
        ; option 算術只含 `+ - * / %`），寫成 `pad = <expr>: { ok -> it }` 會把
        ; 純量當標籤比對，永遠落到兜底臂而拿到 0 ⇒ Block 不對齊（實測 48 而非 49）。
        pad = 0
        {
            pad ?= (0 - data.len()) & 0x3
        }: {
            err -> _

            -> _
        }
        (pad > 0) -> {
            i <- [0..pad): {
                out.push(0x00)
            }
        }
    }

    ; Index
    out.push(0x00); Index indicator

    ; Stream Footer (12 bytes)
    ; CRC32 (4 bytes) + Backward Size (4 bytes) + Stream Flags (2 bytes) + Magic (2 bytes)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0x01)
    out.push(0x00)
    out.push(0x59)
    out.push(0x5a)
}
