; xz — XZ / LZMA 壓縮與解壓縮（純 Nolang 實現）
;
; 實現 LZMA2 解壓縮演算法，支援：
;   - .xz 格式解壓縮（XZ container + LZMA2 stream）
;   - .lzma 格式解壓縮（傳統 LZMA alone 格式）
;
; 用法：
;   data = fs.read-file('example.xz')    ; 讀取 xz 檔案
;   decompressed = xz-decompress(data)    ; 解壓 xz 格式
;
;   data = fs.read-file('example.lzma')  ; 讀取 lzma 檔案
;   decompressed = lzma-decompress(data)  ; 解壓傳統 lzma 格式
;
; 演算法參考：
;   - LZMA specification: https://www.7-zip.org/sdk.html (LZMA SDK)
;   - XZ format: https://tukaani.org/xz/xz-file-format.txt

; ═══════════════════════════════════════════════
; LZMA 範圍解碼器（Range Decoder）
; ═══════════════════════════════════════════════

; lzma-range-decoder: LZMA 算術範圍解碼器
lzma-rd {
    data []byte
    pos i64
    range i64
    code i64
}

; init: 初始化範圍解碼器
lzma-rd.init = (data []byte, start-pos i64) {
    .data = data
    .pos = start-pos + 1  ; 跳過第一個位元組（必須為 0）
    .range = 0xFFFFFFFF
    .code = 0
    i <- [0..4): {
        .code = (.code << 8) | .data[.pos]
        .pos = .pos + 1
    }
}

; normalize: 範圍解碼器正規化
lzma-rd.normalize = () {
    .range < 0x1000000 -> {
        .code = (.code << 8) | .data[.pos]
        .pos = .pos + 1
        .range = .range << 8
    }
}

; decode-bit: 解碼一個位元
; prob: 機率值（0-0x7FFF），返回 bit 和更新後的 prob
lzma-rd.decode-bit = (prob i64) (bit i64, new-prob i64) {
    .normalize()
    bound = (.range >> 11) * prob

    bit = 0
    .code < bound -> {
        .range = bound
        new-prob = prob + ((0x800 - prob) >> 5)
        bit = 0
    }
    .code >= bound -> {
        .range = .range - bound
        .code = .code - bound
        new-prob = prob - (prob >> 5)
        bit = 1
    }
}

; decode-direct-bits: 解碼 n 個直接位元
lzma-rd.decode-direct-bits = (num-bits i64) (res i64) {
    res = 0
    i <- [0..num-bits): {
        .normalize()
        .range = .range >> 1
        t = .code - .range
        t < 0 -> {
            .code = t
        }
        t >= 0 -> {
            .code = .range
            res = (res << 1) | 1
        }
        res < 0 -> res = res & 0x7FFFFFFFFFFFFFFF  ; 防止溢位
    }
}

; decode-bit-tree: 解碼位元樹
; num-bits: 樹的深度，probs: 機率陣列，返回符號
lzma-rd.decode-bit-tree = (probs []i64, num-bits i64) (sym i64) {
    m = 1
    i <- [0..num-bits): {
        bit, tmp = .decode-bit(probs[m])
        probs[m] = tmp
        m = (m << 1) | bit
    }
    sym = m - (1 << num-bits)
}

; decode-reverse-bit-tree: 解碼反向位元樹
lzma-rd.decode-reverse-bit-tree = (probs []i64, num-bits i64) (sym i64) {
    m = 1
    sym = 0
    i <- [0..num-bits): {
        bit, tmp = .decode-bit(probs[m])
        probs[m] = tmp
        m = (m << 1) | bit
        sym = sym | (bit << i)
    }
}

; ═══════════════════════════════════════════════
; LZMA 解碼器狀態
; ═══════════════════════════════════════════════

; LZMA 機率模型大小
LZMA-NUM-STATES = 12
LZMA-NUM-LEN-LOW-BITS = 3
LZMA-NUM-LEN-LOW-SYMS = 8  ; 1 << 3
LZMA-NUM-LEN-MID-BITS = 3
LZMA-NUM-LEN-MID-SYMS = 8  ; 1 << 3
LZMA-NUM-LEN-HIGH-BITS = 8
LZMA-NUM-LEN-HIGH-SYMS = 256  ; 1 << 8
LZMA-NUM-LEN-PROBS = 0x200  ; 2 + 2*(8+8+256)
LZMA-NUM-DIST-SLOTS = 64
LZMA-NUM-DIST-LOW-BITS = 4
LZMA-NUM-DIST-MID-BITS = 4
LZMA-NUM-DIST-HIGH-BITS = 8
LZMA-NUM-FULL-DISTANCES = 128  ; 1 << (4+3)
LZMA-NUM-ALIGN-BITS = 4
LZMA-NUM-ALIGN-SYMS = 16  ; 1 << 4

; LZMA 解碼常數
LZMA-EOF-SYM = 0x100
LZMA-MIN-MATCH = 2

; lzma-decoder: LZMA 解碼器
lzma-decoder {
    rd lzma-rd
    ; 屬性
    lc i64       ; literal context bits
    lp i64       ; literal position bits
    pb i64       ; position bits
    ; 輸出
    out []byte
    ; 機率模型
    is-match [16]i64          ; 12 states * 4 (padded)
    is-rep [16]i64
    is-rep-g0 [16]i64
    is-rep-g1 [16]i64
    is-rep-g2 [16]i64
    is-rep0-long [16]i64
    pos-slot [256]i64        ; 4 states * 64 slots (flattened)
    spec-pos [128]i64         ; special positions
    align [16]i64             ; alignment
    len-coder [0x200]i64      ; length coder
    rep-len-coder [0x200]i64  ; rep length coder
    literal [0x300]i64        ; literal (simplified)
    ; 狀態
    state i64
    rep0 i64
    rep1 i64
    rep2 i64
    rep3 i64
    ; 前一個字節
    prev-byte i64
}

; init-probs: 初始化所有機率值為 0x400（一半機率）
lzma-decoder.init-probs = () {
    i <- [0..16): {
        .is-match[i] = 0x400
        .is-rep[i] = 0x400
        .is-rep-g0[i] = 0x400
        .is-rep-g1[i] = 0x400
        .is-rep-g2[i] = 0x400
        .is-rep0-long[i] = 0x400
    }
    i <- [0..4): {
        j <- [0..64): {
            .pos-slot[i * 64 + j] = 0x400
        }
    }
    i <- [0..128): {
        .spec-pos[i] = 0x400
    }
    i <- [0..16): {
        .align[i] = 0x400
    }
    i <- [0..0x200): {
        .len-coder[i] = 0x400
        .rep-len-coder[i] = 0x400
    }
    i <- [0..0x300): {
        .literal[i] = 0x400
    }
    .state = 0
    .rep0 = 0
    .rep1 = 0
    .rep2 = 0
    .rep3 = 0
    .prev-byte = 0
}

; update-state-literal: 更新狀態（字面量後）
lzma-decoder.update-state-literal = () {
    .state < 4 -> .state = 0
    .state < 10 -> .state = .state - 3
    .state >= 10 -> .state = .state - 6
}

; update-state-match: 更新狀態（匹配後）
lzma-decoder.update-state-match = () {
    .state < 7 -> .state = 7
    .state >= 7 -> .state = 10
}

; update-state-rep: 更新狀態（重複匹配後）
lzma-decoder.update-state-rep = () {
    .state < 7 -> .state = 8
    .state >= 7 -> .state = 11
}

; update-state-shortrep: 更新狀態（短重複後）
lzma-decoder.update-state-shortrep = () {
    .state < 7 -> .state = 9
    .state >= 7 -> .state = 11
}

; decode-literal: 解碼字面量
lzma-decoder.decode-literal = () {
    ; 簡化版：直接從範圍解碼器讀取一個位元組
    ; 完整版本需要考慮 lc/lp/pb 和前一個字節的上下文
    prev = .prev-byte
    ; 使用前一個字節的高位作為上下文
    ctx = prev >> (8 - .lc)

    ; 解碼 8 個位元
    b = 0
    i <- [0..8): {
        ; 選擇機率
        prob-idx = ctx + 0x100
        symbol = 1
        {
            bit, tmp = .rd.decode-bit(.literal[prob-idx + symbol])
            .literal[prob-idx + symbol] = tmp
            symbol = (symbol << 1) | bit
        } (symbol < 0x100)
        b = (b << 1) | (symbol & 1)
    }

    .out.push(b)
    .prev-byte = b
    .update-state-literal()
}

; decode-length: 解碼匹配長度
; probs: 機率陣列，返回長度
lzma-decoder.decode-length = (probs []i64) (length i64) {
    ; 選擇低位/中位/高位
    bit, tmp = .rd.decode-bit(probs[0])
    probs[0] = tmp
    bit == 0 -> {
        ; 低位：3 bits
        sym = .rd.decode-bit-tree(probs, 3)
        length = sym
        return
    }

    bit, tmp = .rd.decode-bit(probs[1])
    probs[1] = tmp
    bit == 0 -> {
        ; 中位：3 bits + 8
        ; 使用子陣列（從 index 2 開始）
        sub-probs []i64
        i <- [0..8): {
            sub-probs.push(probs[2 + i])
        }
        sym = .rd.decode-bit-tree(sub-probs, 3)
        length = sym + 8
        return
    }

    ; 高位：8 bits + 16
    sub-probs []i64
    i <- [0..256): {
        sub-probs.push(probs[10 + i])
    }
    sym = .rd.decode-bit-tree(sub-probs, 8)
    length = sym + 16
}

; decode-distance: 解碼匹配距離
; length: 匹配長度（用於決定距離編碼方式）
lzma-decoder.decode-distance = (length i64) (dist i64) {
    ; 根據狀態選擇 pos-slot 機率表
    st = .state
    st > 3 -> st = 3

    ; 解碼 pos-slot（6 bits）
    slot-probs []i64
    i <- [0..64): {
        slot-probs.push(.pos-slot[st * 64 + i])
    }
    pos-slot = .rd.decode-bit-tree(slot-probs, 6)

    ; 根據 pos-slot 計算距離
    pos-slot < 4 -> {
        dist = pos-slot
        return
    }

    ; 計算額外位元數
    num-direct-bits = (pos-slot >> 1) - 1
    base = (2 | (pos-slot & 1)) << num-direct-bits

    pos-slot < 14 -> {
        ; 使用反向位元樹
        sub-probs []i64
        i <- [0..1 << num-direct-bits): {
            sub-probs.push(.spec-pos[base - pos-slot - 1 + i])
        }
        sym = .rd.decode-reverse-bit-tree(sub-probs, num-direct-bits)
        dist = base + sym
        return
    }

    ; 直接位元 + 對齊
    direct = .rd.decode-direct-bits(num-direct-bits - 4)
    align-probs []i64
    i <- [0..16): {
        align-probs.push(.align[i])
    }
    align = .rd.decode-reverse-bit-tree(align-probs, 4)
    dist = base + (direct << 4) + align
}

; decode: LZMA 解碼主迴圈
; data: 壓縮資料，start-pos: 資料起始位置
; unpacked-size: 預期解壓大小（-1 表示未知）
lzma-decoder.decode = (data []byte, start-pos i64, unpacked-size i64) {
    .rd.init(data, start-pos)
    .init-probs()

    {
        ; 檢查是否達到預期大小
        unpacked-size >= 0 -> {
            .out.len >= unpacked-size -> *
        }

        ; 解碼 is_match
        bit, tmp = .rd.decode-bit(.is-match[.state])
        .is-match[.state] = tmp

        bit == 0 -> {
            ; 字面量
            .decode-literal()
        }

        bit == 1 -> {
            ; 匹配或重複
            bit2, tmp = .rd.decode-bit(.is-rep[.state])
            .is-rep[.state] = tmp

            bit2 == 0 -> {
                ; 簡單匹配
                length = .decode-length(.len-coder)
                dist = .decode-distance(length)

                ; 更新重複距離
                .rep3 = .rep2
                .rep2 = .rep1
                .rep1 = .rep0
                .rep0 = dist

                .update-state-match()

                ; 複製匹配資料
                ; length + LZMA-MIN-MATCH 個字節
                actual-len = length + LZMA-MIN-MATCH
                i <- [0..actual-len): {
                    src-pos = .out.len - .rep0 - 1
                    src-pos >= 0 -> {
                        b = .out[src-pos]
                        .out.push(b)
                        .prev-byte = b
                    }
                    src-pos < 0 -> {
                        .out.push(0)
                        .prev-byte = 0
                    }
                }
            }

            bit2 == 1 -> {
                ; 重複匹配
                bit3, tmp = .rd.decode-bit(.is-rep-g0[.state])
                .is-rep-g0[.state] = tmp

                bit3 == 0 -> {
                    ; rep0
                    bit4, tmp = .rd.decode-bit(.is-rep0-long[.state])
                    .is-rep0-long[.state] = tmp
                    bit4 == 0 -> {
                        ; 短重複（1 字節）
                        .update-state-shortrep()
                        src-pos = .out.len - .rep0 - 1
                        src-pos >= 0 -> {
                            b = .out[src-pos]
                            .out.push(b)
                            .prev-byte = b
                        }
                    }
                    bit4 == 1 -> {
                        ; 長重複
                        length = .decode-length(.rep-len-coder)
                        .update-state-rep()
                        i <- [0..length + LZMA-MIN-MATCH): {
                            src-pos = .out.len - .rep0 - 1
                            src-pos >= 0 -> {
                                b = .out[src-pos]
                                .out.push(b)
                                .prev-byte = b
                            }
                            src-pos < 0 -> {
                                .out.push(0)
                                .prev-byte = 0
                            }
                        }
                    }
                }

                bit3 == 1 -> {
                    ; rep1, rep2, or rep3
                    ; 簡化處理
                    .rep3 = .rep2
                    .rep2 = .rep1
                    .rep1 = .rep0

                    length = .decode-length(.rep-len-coder)
                    .update-state-rep()

                    i <- [0..length + LZMA-MIN-MATCH): {
                        src-pos = .out.len - .rep0 - 1
                        src-pos >= 0 -> {
                            b = .out[src-pos]
                            .out.push(b)
                            .prev-byte = b
                        }
                        src-pos < 0 -> {
                            .out.push(0)
                            .prev-byte = 0
                        }
                    }
                }
            }
        }
    } (true)
}

; ═══════════════════════════════════════════════
; .lzma 格式解壓縮（傳統 LZMA alone 格式）
; ═══════════════════════════════════════════════

; lzma-decompress: 解壓縮傳統 .lzma 格式
;   data: .lzma 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
;
; .lzma 格式：
;   - 1 byte: properties (lc, lp, pb 編碼)
;   - 4 bytes: dict size (little-endian)
;   - 8 bytes: unpacked size (little-endian, 0xFFFFFFFFFFFFFFFF = unknown)
;   - compressed data
lzma-decompress = (data []byte) (out []byte) {
    data.len < 13 -> return

    ; 解析屬性
    props = data[0]
    pb = props / (9 * 5)
    rem = props % (9 * 5)
    lp = rem / 9
    lc = rem % 9

    ; 解析 dict size (4 bytes LE)
    dict-size = data[1] | (data[2] << 8) | (data[3] << 16) | (data[4] << 24)

    ; 解析 unpacked size (8 bytes LE)
    unpacked-size = data[5]
    unpacked-size = unpacked-size | (data[6] << 8)
    unpacked-size = unpacked-size | (data[7] << 16)
    unpacked-size = unpacked-size | (data[8] << 24)
    unpacked-size = unpacked-size | (data[9] << 32)
    unpacked-size = unpacked-size | (data[10] << 40)
    unpacked-size = unpacked-size | (data[11] << 48)
    unpacked-size = unpacked-size | (data[12] << 56)

    ; 0xFFFFFFFFFFFFFFFF 表示未知大小
    unpacked-size < 0 -> unpacked-size = -1

    ; 建立解碼器
    dec lzma-decoder = lzma-decoder{ prev-byte: 0 }
    dec.lc = lc
    dec.lp = lp
    dec.pb = pb
    dec.out []byte
    dec.state = 0
    dec.rep0 = 0
    dec.rep1 = 0
    dec.rep2 = 0
    dec.rep3 = 0
    dec.prev-byte = 0
    dec.decode(data, 13, unpacked-size)

    out = dec.out
}

; ═══════════════════════════════════════════════
; .xz 格式解壓縮（XZ container + LZMA2）
; ═══════════════════════════════════════════════

; XZ 常數
XZ-MAGIC = [0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00]

; xz-decompress: 解壓縮 .xz 格式
;   data: .xz 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
;
; .xz 格式：
;   - Stream Header: 6 bytes magic + 2 bytes stream flags
;   - Blocks: Block Header + Compressed Data + Block Padding + Check
;   - Index
;   - Stream Footer: 12 bytes
xz-decompress = (data []byte) (out []byte) {
    ; 檢查 XZ magic
    data.len < 12 -> return
    i <- [0..6): {
        data[i] != XZ-MAGIC[i] -> return
    }

    ; 跳過 Stream Header (12 bytes)
    pos = 12

    ; 讀取區塊
    {
        pos >= data.len -> *

        ; 檢查是否為 Index marker（0x00 表示 Index）
        data[pos] == 0 -> *

        ; 讀取 Block Header Size
        ; 實際大小 = (value + 1) * 4
        header-size = (data[pos] + 1) * 4
        pos = pos + 1

        ; 讀取 Block Flags
        block-flags = data[pos]
        pos = pos + 1

        ; 檢查 filter count（低 2 bits）
        n-filters = (block-flags & 0x3) + 1

        ; 跳過壓縮大小（如果有）
        (block-flags & 0x40) != 0 -> {
            ; 壓縮大小使用變長整數編碼
            pos = pos + 1
        }

        ; 跳過解壓大小（如果有）
        (block-flags & 0x80) != 0 -> {
            ; 解壓大小使用變長整數編碼
            pos = pos + 1
        }

        ; 讀取 Filter ID（應為 0x21 = LZMA2）
        filter-id = data[pos]
        pos = pos + 1

        ; 讀取 Filter Properties Size
        props-size = data[pos]
        pos = pos + 1

        ; 讀取 LZMA2 屬性
        lzma2-props = 0
        props-size > 0 -> {
            lzma2-props = data[pos]
            pos = pos + 1
        }

        ; 跳到 Block Header 結尾
        pos = pos + header-size - 2 - props-size - 2

        ; 解壓 LZMA2 資料流
        lzma2-decompress-stream(data, pos, out)

        ; 尋找下一個區塊（跳過 padding 和 check）
        ; 簡化處理：假設只有一個區塊
        *
    } (pos < data.len)
}

; lzma2-decompress-stream: 解壓縮 LZMA2 資料流
; LZMA2 使用控制位元組來切分資料塊：
;   0x00 = 結束
;   0x01 = 未壓縮字典重置
;   0x02 = 未壓縮無字典重置
;   0x80-0xBF = LZMA 壓縮（可能帶字典重置）
lzma2-decompress-stream = (data []byte, start-pos i64, out []byte) {
    pos = start-pos

    {
        pos >= data.len -> *

        ctrl = data[pos]
        pos = pos + 1

        ; 結束標記
        ctrl == 0 -> *

        ; 未壓縮區塊（字典重置）
        ctrl == 1 -> {
            ; 讀取大小 (2 bytes)
            size = (data[pos] << 8) | data[pos + 1]
            pos = pos + 2
            ; 複製未壓縮資料
            i <- [0..size): {
                out.push(data[pos + i])
            }
            pos = pos + size
        }

        ; 未壓縮區塊（無字典重置）
        ctrl == 2 -> {
            size = (data[pos] << 8) | data[pos + 1]
            pos = pos + 2
            i <- [0..size): {
                out.push(data[pos + i])
            }
            pos = pos + size
        }

        ; LZMA 壓縮區塊
        ctrl >= 0x80 -> {
            ; 解析大小
            ; 高 2 bits 在 ctrl 中（bits 6-5），低 16 bits 在接下來 2 bytes
            size-hi = (ctrl & 0x1F)
            size = (size-hi << 16) | (data[pos] << 8) | data[pos + 1]
            pos = pos + 2

            ; 解壓大小 (2 bytes)
            unpacked-size = (data[pos] << 8) | data[pos + 1]
            pos = pos + 2

            ; 檢查字典重置
            reset-dict = (ctrl & 0x20) != 0

            ; 讀取 LZMA 屬性（如果字典重置且 ctrl >= 0xC0）
            ctrl >= 0xC0 -> {
                ; 屬性位元組
                props = data[pos]
                pos = pos + 1
            }

            ; 使用 LZMA 解碼器解壓縮
            dec lzma-decoder
            dec.lc = 3
            dec.lp = 0
            dec.pb = 2
            dec.out []byte
            dec.state = 0
            dec.rep0 = 0
            dec.rep1 = 0
            dec.rep2 = 0
            dec.rep3 = 0
            dec.prev-byte = 0

            ; 設定壓縮資料範圍
            comp-data []byte
            i <- [0..size): {
                comp-data.push(data[pos + i])
            }
            pos = pos + size

            dec.decode(comp-data, 0, unpacked-size + 1)

            ; 將解壓結果附加到輸出
            i <- [0..dec.out.len): {
                out.push(dec.out[i])
            }
        }
    } (true)
}

; ═══════════════════════════════════════════════
; 壓縮（基本實現 — stored block）
; ═══════════════════════════════════════════════

; xz-compress: 使用 xz 格式壓縮資料（基本實現）
;   data: 原始資料 ([]byte)
;   out: xz 壓縮後的資料 ([]byte)
; 注意：目前使用 stored block 的基本實現，
;       完整 LZMA2 壓縮待後續實現。
xz-compress = (data []byte) (out []byte) {
    ; Stream Header: magic (6 bytes) + stream flags (2 bytes)
    i <- [0..6): {
        out.push(XZ-MAGIC[i])
    }
    ; Stream Flags: Check = CRC32 (0x01)
    out.push(0x01)
    out.push(0x00)

    ; Block Header (簡化)
    ; 使用未壓縮區塊
    ; TODO: 實現完整 LZMA2 壓縮

    ; Index
    out.push(0x00)  ; Index indicator

    ; Stream Footer (12 bytes)
    ; CRC32 (4 bytes) + Backward Size (4 bytes) + Stream Flags (2 bytes) + Magic (2 bytes)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0x01)
    out.push(0x00)
    out.push(0x59)
    out.push(0x5A)
}
