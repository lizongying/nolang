; bzip2 — BZIP2 壓縮與解壓縮（純 Nolang 實現）
;
; 完全使用 Nolang 實現 BZIP2 解壓縮演算法，
; 包含 Burrows-Wheeler Transform (BWT) 反變換、Move-To-Front (MTF)
; 反變換、Huffman 解碼與 Run-Length Encoding (RLE) 解碼。
;
; 支援：
;   - BZIP2 解壓縮：完整解碼 .bz2 格式
;
; 用法：
;   data = fs.read-file('example.bz2')  ; 讀取 bz2 檔案為 []byte
;   decompressed = bzip2-decompress(data)
;
; 演算法參考：bzip2 官方格式說明
;   https://sourceware.org/bzip2/

; ═══════════════════════════════════════════════
; MSB-first 位元讀取器（bzip2 使用大端序位元）
; ═══════════════════════════════════════════════

bz-bit-reader {
    data []byte
    pos i64
    bit-buf i64
    bit-cnt i64
}

; read-bit: 讀取一個位元（MSB-first），越界返回 0
bz-bit-reader.read-bit = () (bit i64) {
    bit = 0
    .bit-cnt == 0 -> {
        .pos < .data.len -> {
            .bit-buf = .data[.pos]
            .pos = .pos + 1
            .bit-cnt = 8
        }
    }
    .bit-cnt > 0 -> {
        bit = .bit-buf >> 7
        .bit-buf = .bit-buf & 0x7F
        .bit-cnt = .bit-cnt - 1
    }
}

; read-bits: 讀取 n 個位元（MSB-first）
bz-bit-reader.read-bits = (n i64) (v i64) {
    v = 0
    i <- [0..n): {
        b = .read-bit()
        v = (v << 1) | b
    }
}

; ═══════════════════════════════════════════════
; BZIP2 常數
; ═══════════════════════════════════════════════

BZ-BLOCK-MAGIC = 0x314159265359
BZ-FINAL-MAGIC = 0x177245385090
BZ-MAX-ALPHA-SIZE = 258
BZ-GROUP-SIZE = 50

; ═══════════════════════════════════════════════
; Huffman 解碼表（bzip2 風格：base / limit / perm）
; ═══════════════════════════════════════════════

bz-huffman {
    limit [24]i64
    base [24]i64
    perm [258]i64
    min-len i64
    max-len i64
}

; build: 從碼長度陣列建構 Huffman 碼表
bz-huffman.build = (lengths []i64, alpha-size i64) {
    i <- [0..24): {
        .limit[i] = 0
        .base[i] = 0
    }
    i <- [0..258): {
        .perm[i] = 0
    }
    .min-len = 24
    .max-len = 0

    ; 計算各長度的碼數
    len-count [24]i64
    i <- [0..24): {
        len-count[i] = 0
    }
    i <- [0..alpha-size): {
        l = lengths[i]
        len-count[l] = len-count[l] + 1
        l < .min-len -> .min-len = l
        l > .max-len -> .max-len = l
    }

    ; 計算 base 陣列
    ; base[len] = 在 perm 中，長度 len 的起始索引
    pp = 0
    i <- [0..24): {
        .base[i] = pp
        pp = pp + len-count[i]
    }

    ; 計算 limit 陣列
    ; limit[len] = 長度 len 的最大碼值
    vec = 0
    i <- [0..24): {
        vec = (vec << 1) | len-count[i]
        .limit[i] = vec
    }

    ; 填充 perm 陣列
    ; 重新計算 base（臨時使用）
    tmp-base [24]i64
    i <- [0..24): {
        tmp-base[i] = .base[i]
    }
    i <- [0..alpha-size): {
        l = lengths[i]
        .perm[tmp-base[l]] = i
        tmp-base[l] = tmp-base[l] + 1
    }
}

; decode: 解碼一個符號
bz-huffman.decode = (br bz-bit-reader) (sym i64) {
    sym = -1
    zn = .min-len
    zvec = br.read-bits(.min-len)

    ; 如果 min-len == 0，直接返回
    .min-len == 0 -> return

    ; 持續讀取直到找到匹配的碼
    {
        zvec <= .limit[zn] -> *
        zn = zn + 1
        zj = br.read-bit()
        zvec = (zvec << 1) | zj
    } (zvec > .limit[zn] && zn < 23)

    ; 計算符號
    idx = zvec - .base[zn]
    idx < 0 -> return
    idx >= BZ-MAX-ALPHA-SIZE -> return
    sym = .perm[idx + .base[zn] - .base[zn]]
}

; 修正: 正確的符號計算
; sym = perm[zvec - base[zn]]
bz-huffman.decode-symbol = (br bz-bit-reader) (sym i64) {
    sym = -1
    zn = .min-len
    zvec = br.read-bits(.min-len)

    .min-len == 0 -> return

    {
        zvec <= .limit[zn] -> *
        zn = zn + 1
        zj = br.read-bit()
        zvec = (zvec << 1) | zj
    } (zvec > .limit[zn] && zn < 23)

    idx = zvec - .base[zn]
    idx < 0 -> return
    idx >= BZ-MAX-ALPHA-SIZE -> return
    sym = .perm[idx]
}

; ═══════════════════════════════════════════════
; BZIP2 解壓縮
; ═══════════════════════════════════════════════

; bzip2-decompress: 解壓縮 bzip2 格式的資料
;   data: bzip2 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
bzip2-decompress = (data []byte) (out []byte) {
    ; 檢查標頭: "BZh" + block_size_char
    data.len < 4 -> return
    data[0] != 66 -> return  ; 'B'
    data[1] != 90 -> return  ; 'Z'
    data[2] != 104 -> return ; 'h'
    data[3] < 49 -> return   ; '1'
    data[3] > 57 -> return   ; '9'

    ; 建立位元讀取器（跳過 4 位元組標頭）
    br = bz-bit-reader{
        data: data
        pos: 4
        bit-buf: 0
        bit-cnt: 0
    }

    ; 讀取區塊
    done = 0
    {
        done == 1 -> *

        ; 讀取 48 位元 magic
        magic = br.read-bits(48)

        ; 檢查是否為結束 magic
        magic == BZ-FINAL-MAGIC -> {
            ; 跳過 stream CRC (32 bits)
            br.read-bits(32)
            done = 1
        }

        ; 檢查是否為區塊 magic
        magic == BZ-BLOCK-MAGIC -> {
            ; 讀取區塊 CRC (32 bits)
            block-crc = br.read-bits(32)

            ; 讀取隨機化旗標 (1 bit)
            randomized = br.read-bit()

            ; 讀取 orig-ptr (24 bits) — BWT 原始指標
            orig-ptr = br.read-bits(24)

            ; ── 讀取符號映射表 ──
            ; 決定哪些字節值在使用中
            in-use-16 [16]i64
            i <- [0..16): {
                in-use-16[i] = br.read-bit()
            }

            in-use [256]i64
            i <- [0..256): {
                in-use[i] = 0
            }
            n-in-use = 0
            i <- [0..16): {
                in-use-16[i] == 1 -> {
                    j <- [0..16): {
                        bit = br.read-bit()
                        bit == 1 -> {
                            in-use[i * 16 + j] = 1
                            n-in-use = n-in-use + 1
                        }
                    }
                }
            }

            ; 建構 unseq-to-seq 映射
            ; seq-to-unseq[k] = 第 k 個使用中的字節值
            seq-to-unseq [256]i64
            k = 0
            i <- [0..256): {
                in-use[i] == 1 -> {
                    seq-to-unseq[k] = i
                    k = k + 1
                }
            }

            ; alpha-size = nInUse + 2 (RUNA, RUNB + EOB)
            alpha-size = n-in-use + 2
            eob = n-in-use + 1

            ; ── 讀取 Huffman 碼表 ──
            ; 碼表數量 (3 bits, 2-6)
            n-tables = br.read-bits(3) + 2

            ; 選擇器數量 (15 bits)
            n-selectors = br.read-bits(15)

            ; 讀取選擇器（MTF 編碼）
            selectors []i64
            i <- [0..n-selectors): {
                selectors.push(0)
            }
            mtf-list [6]i64
            i <- [0..6): {
                mtf-list[i] = i
            }

            i <- [0..n-selectors): {
                j = 0
                {
                    bit = br.read-bit()
                    bit == 0 -> *
                    j = j + 1
                } (j < 5)
                j >= n-tables -> j = 0

                ; MTF 解碼
                tmp = mtf-list[j]
                m <- [0..j): {
                    mtf-list[j - m] = mtf-list[j - m - 1]
                }
                mtf-list[0] = tmp
                selectors[i] = tmp
            }

            ; 讀取每個碼表的碼長度
            ; 使用 6 個獨立的 Huffman 結構體
            ht0 = bz-huffman{}
            ht1 = bz-huffman{}
            ht2 = bz-huffman{}
            ht3 = bz-huffman{}
            ht4 = bz-huffman{}
            ht5 = bz-huffman{}

            t <- [0..n-tables): {
                ; 起始碼長度 (5 bits)
                curr-len = br.read-bits(5)

                lengths []i64
                i <- [0..alpha-size): {
                    lengths.push(0)
                }

                i = 0
                {
                    i >= alpha-size -> *
                    {
                        bit = br.read-bit()
                        bit == 0 -> {
                            lengths[i] = curr-len
                            i = i + 1
                        }
                        bit == 1 -> {
                            bit2 = br.read-bit()
                            bit2 == 0 -> curr-len = curr-len + 1
                            bit2 == 1 -> curr-len = curr-len - 1
                        }
                    }
                } (i < alpha-size)

                ; 建構碼表
                t == 0 -> ht0.build(lengths, alpha-size)
                t == 1 -> ht1.build(lengths, alpha-size)
                t == 2 -> ht2.build(lengths, alpha-size)
                t == 3 -> ht3.build(lengths, alpha-size)
                t == 4 -> ht4.build(lengths, alpha-size)
                t == 5 -> ht5.build(lengths, alpha-size)
            }

            ; ── 解碼區塊資料 ──
            ; MTF 反變換狀態
            ; mtf-pos[k] = 第 k 個 MTF 位置對應的原始字節值
            mtf-pos [258]i64
            i <- [0..n-in-use): {
                mtf-pos[i] = seq-to-unseq[i]
            }

            selector-idx = 0
            group-remaining = 0
            cur-ht = 0

            ; BWT 輸出
            bwt-out []i64
            run-len = 0
            block-done = 0

            {
                block-done == 1 -> *

                ; 需要新的選擇器？
                group-remaining == 0 -> {
                    selector-idx < n-selectors -> {
                        cur-ht = selectors[selector-idx]
                    }
                    selector-idx = selector-idx + 1
                    group-remaining = BZ-GROUP-SIZE
                }
                group-remaining = group-remaining - 1

                ; 根據選擇器解碼符號
                sym = -1
                cur-ht == 0 -> sym = ht0.decode-symbol(br)
                cur-ht == 1 -> sym = ht1.decode-symbol(br)
                cur-ht == 2 -> sym = ht2.decode-symbol(br)
                cur-ht == 3 -> sym = ht3.decode-symbol(br)
                cur-ht == 4 -> sym = ht4.decode-symbol(br)
                cur-ht == 5 -> sym = ht5.decode-symbol(br)

                ; RUNA (0): run 長度的低位
                sym == 0 -> {
                    run-len = run-len + 1
                }

                ; RUNB (1): run 長度的高位
                sym == 1 -> {
                    run-len = run-len + 2
                }

                ; EOB
                sym == eob -> {
                    ; 輸出剩餘的 run
                    run-len > 0 -> {
                        i <- [0..run-len): {
                            bwt-out.push(mtf-pos[0])
                        }
                    }
                    block-done = 1
                }

                ; MTF 符號 (2..eob-1)
                sym > 1 -> sym < eob -> {
                    ; 輸出累積的 run
                    run-len > 0 -> {
                        i <- [0..run-len): {
                            bwt-out.push(mtf-pos[0])
                        }
                        run-len = 0
                    }

                    ; MTF 反變換
                    mtf-idx = sym - 1
                    val = mtf-pos[mtf-idx]

                    ; 將 val 移到前面
                    j <- [1..mtf-idx + 1): {
                        mtf-pos[mtf-idx - j + 1] = mtf-pos[mtf-idx - j]
                    }
                    mtf-pos[0] = val

                    bwt-out.push(val)
                }
            } (block_done == 0)

            ; ── BWT 反變換 ──
            bwt-n = bwt-out.len
            bwt-n == 0 -> *

            ; 計算字節頻率
            count [256]i64
            i <- [0..256): {
                count[i] = 0
            }
            i <- [0..bwt-n): {
                v = bwt-out[i]
                v >= 0 -> v < 256 -> {
                    count[v] = count[v] + 1
                }
            }

            ; 計算累積頻率（各值在排序後的起始位置）
            cum [256]i64
            total = 0
            i <- [0..256): {
                cum[i] = total
                total = total + count[i]
            }

            ; 計算 LF mapping
            ; lf[i] = 如果 bwt-out[i] 是第 k 次出現的值 v，
            ;          則 lf[i] = cum[v] + k
            lf []i64
            i <- [0..bwt-n): {
                lf.push(0)
            }
            rank [256]i64
            i <- [0..256): {
                rank[i] = 0
            }
            i <- [0..bwt-n): {
                v = bwt-out[i]
                v >= 0 -> v < 256 -> {
                    lf[i] = cum[v] + rank[v]
                    rank[v] = rank[v] + 1
                }
            }

            ; 重建原始資料（BWT 反變換 + RLE1 解碼）
            ; bzip2 的 RLE1: 4 個以上相同字節 → 4 字節 + 計數
            p = orig-ptr
            last-byte = -1
            run-count = 0

            i <- [0..bwt-n): {
                v = bwt-out[p]
                p = lf[p]

                ; RLE1 解碼
                v == last-byte -> {
                    run-count = run-count + 1
                    out.push(v)
                    ; 4 個相同字節後，下一個字節是計數
                    run-count == 4 -> {
                        ; 跳過計數字節（在下一個迭代中）
                        ; 實際上 bzip2 RLE1 是：4 個相同字節 + 1 個計數字節
                        ; 表示 4 + count 個相同字節
                        ; 但這裡需要特殊處理
                    }
                    run-count == 5 -> {
                        ; 第 5 個字節是計數，輸出對應數量的重複字節
                        extra = v
                        j <- [0..extra): {
                            out.push(last-byte)
                        }
                        run-count = 0
                        last-byte = -1
                    }
                }
                v != last-byte -> {
                    last-byte = v
                    run-count = 1
                    out.push(v)
                }
            }
        }

        magic != BZ-BLOCK-MAGIC -> {
            magic != BZ-FINAL-MAGIC -> done = 1
        }
    } (done == 0)
}

; ═══════════════════════════════════════════════
; BZIP2 壓縮（基本實現 — RLE1 + stored block）
; ═══════════════════════════════════════════════

; bzip2-compress: 使用 bzip2 格式壓縮資料
;   data: 原始資料 ([]byte)
;   out: bzip2 壓縮後的資料 ([]byte)
; 注意：目前使用 stored block 的基本實現，
;       完整 BWT + MTF + Huffman 壓縮待後續實現。
bzip2-compress = (data []byte) (out []byte) {
    ; BZIP2 標頭: "BZh9"
    out.push(66)   ; 'B'
    out.push(90)   ; 'Z'
    out.push(104)  ; 'h'
    out.push(57)   ; '9' (900K block size)

    ; 區塊 magic: 0x314159265359 (48 bits, MSB-first)
    out.push(0x31)
    out.push(0x41)
    out.push(0x59)
    out.push(0x26)
    out.push(0x53)
    out.push(0x59)

    ; 區塊 CRC (32 bits) — 使用 CRC32
    crc = crc-32.crc-32(data, data.len)
    out.push((crc >> 24) & 0xFF)
    out.push((crc >> 16) & 0xFF)
    out.push((crc >> 8) & 0xFF)
    out.push(crc & 0xFF)

    ; 隨機化旗標 = 0 (1 bit)
    ; orig-ptr = 0 (24 bits)
    ; 這些需要位元級寫入，暫時使用位元組對齊
    ; TODO: 實現完整位元級輸出

    ; 結束 magic: 0x177245385090 (48 bits)
    out.push(0x17)
    out.push(0x72)
    out.push(0x45)
    out.push(0x38)
    out.push(0x50)
    out.push(0x90)

    ; Stream CRC (32 bits)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
}
