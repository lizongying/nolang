; bzip2 — BZIP2 壓縮與解壓縮（純 Nolang 實現）
;
; 完全使用 Nolang 實現 BZIP2 解壓縮演算法，
; 包含 Burrows-Wheeler Transform (BWT) 反變換、Move-To-Front (MTF)
; 反變換、Huffman 解碼與 Run-Length Encoding (RLE) 解碼。
;
; 支援：
;   - BZIP2 解壓縮：完整解碼 .bz2 格式
;
; 用法：
;   data = fs.read-file('example.bz2')  ; 讀取 bz2 檔案為 []byte
;   decompressed = bzip2-decompress(data)
;
; 演算法參考：bzip2 官方格式說明
;   https://sourceware.org/bzip2/
; [bzip2](#bzip2)

; MSB-first 位元讀取器（bzip2 使用大端序位元）
...

; bz-bit-reader: bzip2 位元讀取器（MSB-first）
; data []byte: 待解碼的原始位元組緩衝
; pos i64: 下一個要載入 bit-buf 的位元組下標
; bit-buf i64: 位元緩衝；只剩尚未消費的低 bit-cnt 位
; bit-cnt i64: bit-buf 中仍可讀的位元數（0 表示需要載入下一個位元組）
; [bz-bit-reader](#bzip2.bz-bit-reader)
bz-bit-reader {
    data []byte
    pos i64
    bit-buf i64
    bit-cnt i64
}

; 讀取一個位元（MSB-first），越界返回 0
; bit i64: 讀出的位元（0 或 1）；位元組耗盡後固定返回 0，不報錯
; [read-bit](#bzip2.bz-bit-reader.read-bit)
bz-bit-reader.read-bit = () (bit i64) {
    bit = 0
    {
        .bit-cnt == 0 -> {
            .pos < .data.len() -> {
                .bit-buf = .data[.pos]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                .pos = .pos + 1: {
                    ok -> it

                    ->
                }
                .bit-cnt = 8
            }
        }

        .bit-cnt > 0 -> {
            bit = .bit-buf >> 7
            .bit-buf = (.bit-buf << 1) & 0xff

            #{overflow=wrap}
            .bit-cnt = .bit-cnt - 1: {
                ok -> it

                ->
            }
        }
    }
}

; 讀取 n 個位元（MSB-first）
; n i64: 要連續讀取的位元數
; v i64: 拼出的整數；先讀到的位元放在高位
; [read-bits](#bzip2.bz-bit-reader.read-bits)
bz-bit-reader.read-bits = (n i64) (v i64) {
    v = 0
    i <- [0..n): {
        b = .read-bit()
        v = (v << 1) | b
    }
}

; BZIP2 常數
...

BZ-BLOCK-MAGIC = 0x314159265359
BZ-FINAL-MAGIC = 0x177245385090
BZ-MAX-ALPHA-SIZE = 258
BZ-GROUP-SIZE = 50

; Huffman 解碼表（bzip2 風格：base / limit / perm）
...

; bz-huffman: bzip2 風格的 Huffman 解碼表（base / limit / perm 三陣列）
; limit [24]i64: 每個碼長下可接受的最大碼值（由小到大遞增）
; base [24]i64: 每個碼長在 perm 中的起始偏移
; perm [258]i64: 按碼長與字典序排好的符號表
; min-len i64: 最短碼長；為 0 表示此表為空，解碼直接失敗
; max-len i64: 最長碼長
; [bz-huffman](#bzip2.bz-huffman)
bz-huffman {
    limit [24]i64
    base [24]i64
    perm [258]i64
    min-len i64
    max-len i64
}

; 從碼長度陣列建構 Huffman 碼表
; 先統計各碼長個數，再累加出 limit / base，最後填 perm。
; lengths []i64: 每個符號的碼長（0 表示該符號不使用）
; alpha-size i64: 字母表大小（有效符號數上限，≤ 258）
; [build](#bzip2.bz-huffman.build)
bz-huffman.build = (lengths []i64, alpha-size i64) {
    i <- [0..24): {
        {
            .limit[i] ?= 0

            .base[i] ?= 0
        }: {
            err -> _

            -> _
        }
    }
    i <- [0..258): {
        {
            .perm[i] ?= 0
        }: {
            err -> _

            -> _
        }
    }
    .min-len = 24
    .max-len = 0

    ; 計算各長度的碼數
    len-count [24]i64
    e <- len-count: {
        e: {
            ok -> it = 0

            -> _
        }
    }
    i <- [0..alpha-size): {
        l = lengths[i]: {
            ok -> it

            -> 0
        }

        ixout133c24 = len-count[l]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        len-count[l]: {
            ok -> it = ixout133c24 + 1

            -> _
        }
        {
            l < .min-len -> .min-len = l

            l > .max-len -> .max-len = l
        }
    }

    ; 計算 base 陣列
    ; base[len] = 在 perm 中，長度 len 的起始索引
    pp = 0
    i <- [0..24): {
        {
            .base[i] ?= pp
        }: {
            err -> _

            -> _
        }

        ixout157c28 = len-count[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        pp = pp + ixout157c28
    }

    ; 計算 limit 陣列
    ; limit[len] = 長度 len 的最大 canon code 值
    ;            = first-code[len] + count[len] - 1
    ; first-code[len+1] = (first-code[len] + count[len]) << 1
    vec = 0
    i <- [0..24): {
        ixout166c36 = len-count[i]: {
            ok -> it

            -> _
        }

        {
            .limit[i] ?= vec + ixout166c36 - 1
        }: {
            err -> _

            -> _
        }
        ixout167c31 = len-count[i]: {
            ok -> it

            -> _
        }

        vec = (vec + ixout167c31) << 1
    }

    ; 填充 perm 陣列
    ; 重新計算 base（臨時使用）
    tmp-base [24]i64
    i <- [0..24): {
        tmp-base[i]: {
            ok -> it = .base[i]: {
                ok -> it

                -> _
            }

            -> _
        }
    }
    i <- [0..alpha-size): {
        l = lengths[i]: {
            ok -> it

            -> 0
        }

        ixout182c15 = tmp-base[l]: {
            ok -> it

            -> _
        }

        {
            .perm[ixout182c15] ?= i
        }: {
            err -> _

            -> _
        }

        ixout186c24 = tmp-base[l]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        tmp-base[l]: {
            ok -> it = ixout186c24 + 1

            -> _
        }
    }

    ; 轉成解碼用的 base 偏移：bzip2 在填完 perm 後就地把 base 由「perm 起始
    ; 索引」改寫為「解碼偏移」= ((limit[len-1] + 1) << 1) - base[len]。
    ; 解碼時以 perm[zvec - base[zn]] 取得符號。
    i <- [0..24): {
        i > .min-len -> {
            {
                lim ?= .limit[i - 1]
                b ?= .base[i]

                #{overflow=wrap}
                nb = ((lim + 1) << 1) - b
                .base[i] ?= nb
            }: {
                err -> _

                -> _
            }
        }
    }
}

; 解碼一個符號
; 先讀 min-len 位元，再逐位擴展直到落入 limit 範圍；越界或碼過長時回 -1。
; br bz-bit-reader: 位元來源（每輪可能多讀 1 位元）
; sym i64: 解出的符號值，-1=非法碼或空表
; [decode](#bzip2.bz-huffman.decode)
bz-huffman.decode = (br bz-bit-reader) (sym i64) {
    sym = -1
    zn = .min-len
    zvec = br.read-bits(.min-len)

    ; 如果 min-len == 0，直接返回
    .min-len == 0 -> return

    ; 持續讀取直到找到匹配的碼
    {
        lim ?= .limit[zn]
        (zvec > lim && zn < 23) {
            zvec <= lim -> {
                break
            }

            #{overflow=wrap}
            {

                #{overflow=wrap}
                zn = zn + 1: {
                    ok -> it

                    ->
                }
            }
            zj = br.read-bit()
            zvec = (zvec << 1) | zj
            lim ?= .limit[zn]
        }

        ; 計算符號
        b ?= .base[zn]

        #{overflow=wrap}
        idx = zvec - b
        {
            idx < 0 -> return

            idx >= BZ-MAX-ALPHA-SIZE -> return
        }

        #{overflow=wrap}
        sym = .perm[idx + b - b]: {
            ok -> it

            -> _
        }
    }: {
        err -> _

        -> _
    }
}

; 解碼一個符號（修正版：直接用 perm[zvec - base[zn]] 取符號）
; 與 decode 的差異只在最後一步的索引運算，其餘解碼流程相同；bzip2 主流程用此版本。
; br bz-bit-reader: 位元來源（每輪可能多讀 1 位元）
; sym i64: 解出的符號值，-1=非法碼或空表
; [decode-symbol](#bzip2.bz-huffman.decode-symbol)
bz-huffman.decode-symbol = (br bz-bit-reader) (sym i64) {
    sym = -1
    zn = .min-len
    zvec = br.read-bits(.min-len)

    .min-len == 0 -> return
    {
        lim ?= .limit[zn]
        (zvec > lim && zn < 23) {
            zvec <= lim -> {
                break
            }

            #{overflow=wrap}
            {

                #{overflow=wrap}
                zn = zn + 1: {
                    ok -> it

                    ->
                }
            }
            zj = br.read-bit()
            zvec = (zvec << 1) | zj
            lim ?= .limit[zn]
        }

        b ?= .base[zn]

        #{overflow=wrap}
        idx = zvec - b
        {
            idx < 0 -> return

            idx >= BZ-MAX-ALPHA-SIZE -> return
        }

        sym = .perm[idx]: {
            ok -> it

            -> _
        }
    }: {
        err -> _

        -> _
    }
}

; BZIP2 解壓縮
...

; 解壓縮 bzip2 格式的資料
;   data: bzip2 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
; [bzip2-decompress](#bzip2.bzip2-decompress)
bzip2-decompress = (data []byte) (out []byte) {

    ; 檢查標頭: "BZh" + block_size_char
    data.len() < 4 -> return
    ixout304c9 = data[0]: {
        ok -> it

        -> _
    }

    ixout304c9 != 66 -> {

        ; 'B'
        return
    }
    ixout309c9 = data[1]: {
        ok -> it

        -> _
    }

    ixout309c9 != 90 -> {

        ; 'Z'
        return
    }
    ixout314c9 = data[2]: {
        ok -> it

        -> _
    }

    ixout314c9 != 104 -> {

        ; 'h'
        return
    }
    {
        ixout320c13 = data[3]: {
            ok -> it

            -> _
        }

        ixout320c13 < 49 -> {

            ; '1'
            return
        }

        ixout326c13 = data[3]: {
            ok -> it

            -> _
        }

        ixout326c13 > 57 -> {

            ; '9'
            return
        }
    }

    ; 建立位元讀取器（跳過 4 位元組標頭）
    br = bz-bit-reader{
        data: data
        pos: 4
        bit-buf: 0
        bit-cnt: 0
    }

    ; 讀取區塊
    done = 0
    (done == 0) {
        done == 1 -> break

        ; 讀取 48 位元 magic
        magic = br.read-bits(48)

        ; 檢查是否為結束 magic
        magic == BZ-FINAL-MAGIC -> {

            ; 跳過 stream CRC (32 bits)
            br.read-bits(32)
            done = 1
        }

        ; 檢查是否為區塊 magic
        magic == BZ-BLOCK-MAGIC -> {

            ; 讀取區塊 CRC (32 bits)
            block-crc = br.read-bits(32)

            ; 讀取隨機化旗標 (1 bit)——必須消費掉以維持位元流對齊；本實作不還原隨機化表
            randomized = br.read-bit()

            ; 讀取 orig-ptr (24 bits) — BWT 原始指標
            orig-ptr = br.read-bits(24)

            ; ── 讀取符號映射表 ──
            ; 決定哪些字節值在使用中
            in-use-16 [16]i64
            e1 <- in-use-16: {
                e1: {
                    ok -> it = br.read-bit()

                    -> _
                }
            }
            in-use [256]i64
            e2 <- in-use: {
                e2: {
                    ok -> it = 0

                    -> _
                }
            }
            n-in-use = 0
            i <- [0..16): {
                ixout391c26 = in-use-16[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                ixout391c26 == 1 -> {
                    j <- [0..16): {
                        bit = br.read-bit()
                        bit == 1 -> {

                            #{overflow=wrap}
                            in-use[i * 16 + j]: {
                                ok -> it = 1

                                -> _
                            }
                            {
                                n-in-use = n-in-use + 1: {
                                    ok -> it

                                    ->
                                }
                            }
                        }
                    }
                }
            }

            ; 建構 unseq-to-seq 映射
            ; seq-to-unseq[k] = 第 k 個使用中的字節值
            seq-to-unseq [256]i64
            k = 0
            i <- [0..256): {
                ixout415c23 = in-use[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                ixout415c23 == 1 -> {
                    seq-to-unseq[k]: {
                        ok -> it = i

                        -> _
                    }
                    {
                        k = k + 1: {
                            ok -> it

                            ->
                        }
                    }
                }
            }

            ; alpha-size = nInUse + 2 (RUNA, RUNB + EOB)
            #{overflow=wrap}
            alpha-size = n-in-use + 2

            #{overflow=wrap}
            eob = n-in-use + 1

            ; ── 讀取 Huffman 碼表 ──
            ; 碼表數量 (3 bits, 直接存 nGroups，取值 2-6；bzip2 bsW(3, nGroups))
            n-tables = br.read-bits(3)

            ; 選擇器數量 (15 bits)
            n-selectors = br.read-bits(15)

            ; 讀取選擇器（MTF 編碼）
            selectors []i64
            i <- [0..n-selectors): {
                selectors.push(0)
            }
            mtf-list [6]i64
            i <- [0..6): {
                mtf-list[i]: {
                    ok -> it = i

                    -> _
                }
            }
            i <- [0..n-selectors): {
                j = 0
                (j < 5) {
                    bit = br.read-bit()
                    bit == 0 -> break

                    #{overflow=wrap}
                    {

                        #{overflow=wrap}
                        j = j + 1: {
                            ok -> it

                            ->
                        }
                    }
                }
                j >= n-tables -> j = 0

                ; MTF 解碼
                tmp = mtf-list[j]: {
                    ok -> it

                    -> 0
                }
                m <- [0..j): {
                    {

                        #{overflow=wrap}
                        mtf-list[j - m] ?= mtf-list[j - m - 1]
                    }: {
                        err -> _

                        -> _
                    }
                }

                mtf-list[0]: {
                    ok -> it = tmp

                    -> _
                }

                selectors[i]: {
                    ok -> it = tmp

                    -> _
                }
            }

            ; 讀取每個碼表的碼長度
            ; 使用 6 個獨立的 Huffman 結構體
            ht0 = bz-huffman{}
            ht1 = bz-huffman{}
            ht2 = bz-huffman{}
            ht3 = bz-huffman{}
            ht4 = bz-huffman{}
            ht5 = bz-huffman{}

            t <- [0..n-tables): {

                ; 起始碼長度 (5 bits)
                curr-len = br.read-bits(5)

                lengths []i64
                i <- [0..alpha-size): {
                    lengths.push(0)
                }
                i = 0
                (i < alpha-size) {
                    i >= alpha-size -> break
                    bit = br.read-bit()
                    bit == 0 -> {
                        lengths[i]: {
                            ok -> it = curr-len

                            -> _
                        }

                        #{overflow=wrap}
                        {

                            #{overflow=wrap}
                            i = i + 1: {
                                ok -> it

                                ->
                            }
                        }
                    }
                    bit == 1 -> {
                        bit2 = br.read-bit()
                        {
                            bit2 == 0 -> {

                                #{overflow=wrap}
                                {

                                    #{overflow=wrap}
                                    curr-len = curr-len + 1: {
                                        ok -> it

                                        ->
                                    }
                                }
                            }

                            bit2 == 1 -> {

                                #{overflow=wrap}
                                {

                                    #{overflow=wrap}
                                    curr-len = curr-len - 1: {
                                        ok -> it

                                        ->
                                    }
                                }
                            }
                        }
                    }
                }

                ; 建構碼表
                {
                    t == 0 -> ht0.build(lengths, alpha-size)

                    t == 1 -> ht1.build(lengths, alpha-size)

                    t == 2 -> ht2.build(lengths, alpha-size)

                    t == 3 -> ht3.build(lengths, alpha-size)

                    t == 4 -> ht4.build(lengths, alpha-size)

                    t == 5 -> ht5.build(lengths, alpha-size)
                }
            }

            ; ── 解碼區塊資料 ──
            ; MTF 反變換狀態
            ; mtf-pos[k] = 第 k 個 MTF 位置對應的原始字節值
            mtf-pos [258]i64
            i <- [0..n-in-use): {
                {
                    mtf-pos[i] ?= seq-to-unseq[i]
                }: {
                    err -> _

                    -> _
                }
            }
            selector-idx = 0
            group-remaining = 0
            cur-ht = 0

            ; BWT 輸出
            bwt-out []i64
            run-len = 0
            run-n = 1
            block-done = 0

            (block-done == 0) {
                block-done == 1 -> break

                ; 需要新的選擇器？
                group-remaining == 0 -> {
                    selector-idx < n-selectors -> {
                        cur-ht = selectors[selector-idx]: {
                            ok -> it

                            -> 0
                        }
                    }

                    #{overflow=wrap}
                    {

                        #{overflow=wrap}
                        selector-idx = selector-idx + 1: {
                            ok -> it

                            ->
                        }
                    }
                    group-remaining = BZ-GROUP-SIZE
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    group-remaining = group-remaining - 1: {
                        ok -> it

                        ->
                    }
                }

                ; 根據選擇器解碼符號
                sym = -1
                cur-ht == 0 -> sym = ht0.decode-symbol(br)
                cur-ht == 1 -> sym = ht1.decode-symbol(br)
                cur-ht == 2 -> sym = ht2.decode-symbol(br)
                cur-ht == 3 -> sym = ht3.decode-symbol(br)
                cur-ht == 4 -> sym = ht4.decode-symbol(br)
                cur-ht == 5 -> sym = ht5.decode-symbol(br)

                ; RUNA (0) / RUNB (1)：base-2 run-length。第一個 run 符號為最低位，
                ; 每多一個符號權重翻倍（bzip2：es += val*N; N *= 2，RUNA=1、RUNB=2）。
                #{overflow=wrap}
                sym == 0 -> {
                    {
                        run-len = run-len + run-n: {
                            ok -> it

                            ->
                        }
                    }
                    {
                        run-n = run-n * 2: {
                            ok -> it

                            ->
                        }
                    }
                }

                #{overflow=wrap}
                sym == 1 -> {
                    {
                        run-len = run-len + 2 * run-n: {
                            ok -> it

                            ->
                        }
                    }
                    {
                        run-n = run-n * 2: {
                            ok -> it

                            ->
                        }
                    }
                }

                ; EOB
                sym == eob -> {

                    ; 輸出剩餘的 run
                    run-len > 0 -> {
                        i <- [0..run-len): {
                            ixout643c49 = mtf-pos[0]: {
                                ok -> it

                                -> _
                            }

                            bwt-out.push(ixout643c49)
                        }
                    }
                    block-done = 1
                }

                ; MTF 符號 (2..eob-1)
                sym > 1 -> sym < eob -> {

                    ; 輸出累積的 run
                    run-len > 0 -> {
                        i <- [0..run-len): {
                            ixout655c49 = mtf-pos[0]: {
                                ok -> it

                                -> _
                            }

                            bwt-out.push(ixout655c49)
                        }
                        run-len = 0
                        run-n = 1
                    }

                    ; MTF 反變換
                    #{overflow=wrap}
                    mtf-idx = sym - 1

                    val = mtf-pos[mtf-idx]: {
                        ok -> it

                        -> 0
                    }

                    ; 將 val 移到前面
                    j <- [1..mtf-idx + 1): {
                        {

                            #{overflow=wrap}
                            mtf-pos[mtf-idx - j + 1] ?= mtf-pos[mtf-idx - j]
                        }: {
                            err -> _

                            -> _
                        }
                    }

                    mtf-pos[0]: {
                        ok -> it = val

                        -> _
                    }

                    bwt-out.push(val)
                }
            }

            ; ── BWT 反變換 ──
            bwt-n = bwt-out.len()
            bwt-n == 0 -> break

            ; 計算字節頻率
            count [256]i64
            e3 <- count: {
                e3: {
                    ok -> it = 0

                    -> _
                }
            }
            i <- [0..bwt-n): {
                v = bwt-out[i]: {
                    ok -> it

                    -> 0
                }
                v >= 0 -> {
                    v < 256 -> {
                        ixout687c40 = count[v]: {
                            ok -> it

                            -> _
                        }

                        #{overflow=wrap}
                        count[v]: {
                            ok -> it = ixout687c40 + 1

                            -> _
                        }
                    }
                }
            }

            ; 計算累積頻率（各值在排序後的起始位置）
            cum [256]i64
            total = 0
            i <- [0..256): {
                cum[i]: {
                    ok -> it = total

                    -> _
                }

                ixout748c38 = count[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                total = total + ixout748c38
            }

            ; 計算 LF mapping
            ; lf[i] = 如果 bwt-out[i] 是第 k 次出現的值 v，
            ;          則 lf[i] = cum[v] + k
            lf []i64
            i <- [0..bwt-n): {
                lf.push(0)
            }
            rank [256]i64
            e4 <- rank: {
                e4: {
                    ok -> it = 0

                    -> _
                }
            }
            i <- [0..bwt-n): {
                v = bwt-out[i]: {
                    ok -> it

                    -> 0
                }
                v >= 0 -> v < 256 -> {
                    ixout734c36 = cum[v]: {
                        ok -> it

                        -> _
                    }

                    ixout734c45 = rank[v]: {
                        ok -> it

                        -> _
                    }

                    #{overflow=wrap}
                    lf[i]: {
                        ok -> it = ixout734c36 + ixout734c45

                        -> _
                    }

                    ixout741c36 = rank[v]: {
                        ok -> it

                        -> _
                    }

                    #{overflow=wrap}
                    rank[v]: {
                        ok -> it = ixout741c36 + 1

                        -> _
                    }
                }
            }

            ; 重建原始資料：依 LF 走訪攤平 BWT，再反轉成正序，最後做 RLE1 解碼。
            ; 註一：LF 走訪（bwt-out[p]；前進 p = lf[p]）產生的是反序字串，故先攤平到
            ;       flat-data（反序）再反轉為 rle-data（正序）供 RLE1 使用。
            flat-data []i64
            p = orig-ptr
            k = 0
            (k < bwt-n) {
                v = bwt-out[p]: {
                    ok -> it

                    -> 0
                }
                flat-data.push(v)

                p = lf[p]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    k = k + 1: {
                        ok -> it

                        ->
                    }
                }
            }

            ; 反轉成正序（bwt-n 個元素）
            rle-data []i64
            ri = bwt-n
            (ri > 0) {

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    ri = ri - 1: {
                        ok -> it

                        ->
                    }
                }

                rv = flat-data[ri]: {
                    ok -> it

                    -> 0
                }
                rle-data.push(rv)
            }

            ; RLE1 解碼：連續 4 個相同字節後跟一個計數字節 c，
            ; 表示總共 4 + c 個該字節（c = 0 表示恰好 4 個）。
            i = 0
            rep = 0
            last-b = -1
            (i < bwt-n) {
                v = rle-data[i]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    i = i + 1: {
                        ok -> it

                        ->
                    }
                }
                out.push(v)
                {
                    v == last-b -> {
                        {
                            rep = rep + 1: {
                                ok -> it

                                ->
                            }
                        }
                    }

                    v != last-b -> {
                        last-b = v
                        rep = 1
                    }
                }
                rep == 4 -> {
                    c = 0
                    i < bwt-n -> {
                        c = rle-data[i]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        {

                            #{overflow=wrap}
                            i = i + 1: {
                                ok -> it

                                ->
                            }
                        }
                    }
                    j <- [0..c): {
                        out.push(last-b)
                    }
                    rep = 0
                    last-b = -1
                }
            }
        }
        magic != BZ-BLOCK-MAGIC -> magic != BZ-FINAL-MAGIC -> done = 1
    }
}

; BZIP2 壓縮（基本實現 — RLE1 + stored block）
...

; 使用 bzip2 格式壓縮資料
;   data: 原始資料 ([]byte)
;   out: bzip2 壓縮後的資料 ([]byte)
; 注意：目前使用 stored block 的基本實現，
;       完整 BWT + MTF + Huffman 壓縮待後續實現。
; [bzip2-compress](#bzip2.bzip2-compress)
bzip2-compress = (data []byte) (out []byte) {

    ; BZIP2 標頭: "BZh9"
    out.push(66); 'B'
    out.push(90); 'Z'
    out.push(104); 'h'
    out.push(57); '9' (900K block size)

    ; 區塊 magic: 0x314159265359 (48 bits, MSB-first)
    out.push(0x31)
    out.push(0x41)
    out.push(0x59)
    out.push(0x26)
    out.push(0x53)
    out.push(0x59)

    ; 區塊 CRC (32 bits) — 使用 CRC32
    crc = crc-32.new(data, data.len())
    out.push((crc >> 24) & 0xff)
    out.push((crc >> 16) & 0xff)
    out.push((crc >> 8) & 0xff)
    out.push(crc & 0xff)

    ; 隨機化旗標 = 0 (1 bit)
    ; orig-ptr = 0 (24 bits)
    ; 這些需要位元級寫入，暫時使用位元組對齊
    ; TODO: 實現完整位元級輸出

    ; 結束 magic: 0x177245385090 (48 bits)
    out.push(0x17)
    out.push(0x72)
    out.push(0x45)
    out.push(0x38)
    out.push(0x50)
    out.push(0x90)

    ; Stream CRC (32 bits)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
}
