; tar — TAR 歸檔讀寫
;
; 讀取/寫入 POSIX ustar 格式的 TAR 歸檔。
; 不依賴外部庫，僅操作 []byte。
;
; 用法（讀取）：
;   archive = tar{
;       data: raw-bytes
;   }
;   n = archive.count()
;   i <- [0..n): {
;       e = archive.entry(i)
;       name = e.name()
;       sz = e.size()
;       typ = e.type()
;       content = e.read()
;   }
;
; 用法（讀取 .tar.gz）：
;   archive = tar-open-gz(gz-data)
;   n = archive.count()
;   ...
;
; 用法（寫入）：
;   builder = tar-builder{}
;   builder.add-file('hello.txt', 'hello world')
;   builder.add-dir('subdir/')
;   archive = builder.finish()

; ─── 結構體定義 ───────────────────────────────

; tar: TAR 歸檔唯讀視圖
tar {
    data []byte
}

; tar-entry: TAR 條目（指向 archive.data 中的某個 header）
tar-entry {
    data []byte
    idx i64
}

; tar-builder: TAR 歸檔建構器
tar-builder {
    buf []byte
    pos i64
}

; ─── 常量 ─────────────────────────────────────

; TAR 區塊大小
TAR-BLOCK = 512

; 條目類型
TAR-TYPE-FILE = "0"
TAR-TYPE-DIR = "5"

; ─── tar 方法 ─────────────────────────────────

; 從 gzip 壓縮資料建立 tar 視圖（.tar.gz）
;   gz-data: gzip 壓縮的 tar 資料 ([]byte)
;   archive: 解壓後的 tar 歸檔
; [tar-open-gz](#tar.tar-open-gz)
tar-open-gz = (gz-data []byte) (archive tar) {
    archive.data = gzip.gzip-decompress(gz-data)
}

; 計算 TAR 中的有效條目數
; count: 結束標記（全零區塊）前的條目數量
; [count](#tar.tar.count)
tar.count = () (count i64) {
    count = 0
    off = 0
    n = len(.data)

    ; 先檢查再執行，避免資料不足時越界
    #{overflow=wrap}
    (off + TAR-BLOCK <= n) {

        ; 檢查是否為結束標記（全零區塊）
        empty = 1
        i <- [0..TAR-BLOCK): {

            (.data[off + i]) != 0 -> {

                empty = 0
            }
        }
        empty == 1 -> return

        #{overflow=wrap}
        count = count + 1

        ; 讀取 size 欄位（偏移 124，12 位元組八進制）
        sz = 0
        j <- [0..12): {

            #{overflow=wrap}
            c = .data[off + 124 + j]

            #{overflow=wrap}
            c >= 48 && c <= 57 -> sz = sz * 8 + (c - 48)
        }

        #{overflow=wrap}
        blocks = (sz + 511) / TAR-BLOCK
        blocks < 0 -> blocks = 0

        #{overflow=wrap}
        off = off + TAR-BLOCK + blocks * TAR-BLOCK
    }
}

; 計算第 idx 個條目的實際位元組偏移（遍歷前面所有條目）
; idx: 條目序號（0 ~ 數量-1）
; off: 該條目標頭在歸檔資料中的起始位元組偏移
; [offset](#tar.tar.offset)
tar.offset = (idx i64) (off i64) {
    off = 0
    i <- [0..idx): {

        sz = 0
        j <- [0..12): {

            #{overflow=wrap}
            c = .data[off + 124 + j]

            #{overflow=wrap}
            c >= 48 && c <= 57 -> sz = sz * 8 + (c - 48)
        }

        #{overflow=wrap}
        blocks = (sz + 511) / TAR-BLOCK
        blocks < 0 -> blocks = 0

        #{overflow=wrap}
        off = off + TAR-BLOCK + blocks * TAR-BLOCK
    }
}

; 取得第 idx 個條目
; idx: 條目序號
; e: 指向該 512 位元組標頭的 tar-entry（再經其方法讀欄位）
; [entry](#tar.tar.entry)
tar.entry = (idx i64) (e tar-entry) {
    e.data = .data
    e.idx = .offset(idx)
}

; 讀取第 idx 個條目的檔名
; idx: 條目序號
; name: 檔名（標頭 name 欄，遇 NUL/空白截斷）
; [name](#tar.tar.name)
tar.name = (idx i64) (name str) {
    hdr = .offset(idx)
    name = ''
    i <- [0..100): {

        #{overflow=wrap}
        c char = .data[hdr + i]
        c == 0 -> break

        name = name - c.to-str()
    }
}

; 讀取第 idx 個條目的檔案大小（八進制）
; idx: 條目序號
; sz: 檔案原始位元組數（size 欄八進位解碼）
; [size](#tar.tar.size)
tar.size = (idx i64) (sz i64) {
    hdr = .offset(idx)
    sz = 0
    i <- [0..12): {

        #{overflow=wrap}
        c = .data[hdr + 124 + i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> sz = sz * 8 + (c - 48)
    }
}

; 讀取第 idx 個條目的類型字串
; 返回 "file"、"dir" 或 "unknown"
; idx: 條目序號
; typ: 條目型別字串（依 typeflag 映射為 "file"、"dir" 或 "unknown"）
; [type](#tar.tar.type)
tar.type = (idx i64) (typ str) {

    hdr = .offset(idx)

    #{overflow=wrap}
    c = .data[hdr + 156]
    typ = 'unknown'
    {
        c == 48 || c == 0 -> typ = 'file'

        c == 53 -> typ = 'dir'
    }
}

; 判斷第 idx 個條目是否為目錄
; idx: 條目序號
; yes: 是否為目錄條目（typeflag 為 5）
; [is-dir](#tar.tar.is-dir)
tar.is-dir = (idx i64) (yes bool) {

    hdr = .offset(idx)

    #{overflow=wrap}
    c = .data[hdr + 156]
    yes = (c == 53)
}

; 判斷第 idx 個條目是否為普通檔案
; idx: 條目序號
; yes: 是否為普通檔案條目（typeflag 為 0）
; [is-file](#tar.tar.is-file)
tar.is-file = (idx i64) (yes bool) {

    hdr = .offset(idx)

    #{overflow=wrap}
    c = .data[hdr + 156]
    yes = (c == 48 || c == 0)
}

; 提取第 idx 個條目的內容
; idx: 條目序號
; out: 條目內容位元組（依 size 欄長度讀取，目錄為空）
; [read](#tar.tar.read)
tar.read = (idx i64) (out []byte) {
    sz = .size(idx)
    hdr = .offset(idx)
    sz > 0 -> {
        i <- [0..sz): {

            #{overflow=wrap}
            out.push(.data[hdr + TAR-BLOCK + i])
        }
    }
}

; 讀取第 idx 個條目的權限（八進制）
; idx: 條目序號
; mode: 檔案權限位元（mode 欄八進位解碼，如 0o644）
; [mode](#tar.tar.mode)
tar.mode = (idx i64) (mode i64) {
    hdr = .offset(idx)
    mode = 0
    i <- [0..8): {

        #{overflow=wrap}
        c = .data[hdr + 100 + i]

        #{overflow=wrap}
        c >= 48 && c <= 55 -> mode = mode * 8 + (c - 48)
    }
}

; 讀取第 idx 個條目的修改時間（八進制 Unix 時間戳）
; idx: 條目序號
; ts: 修改時間（Unix 秒，mtime 欄八進位解碼）
; [mtime](#tar.tar.mtime)
tar.mtime = (idx i64) (ts i64) {
    hdr = .offset(idx)
    ts = 0
    i <- [0..12): {

        #{overflow=wrap}
        c = .data[hdr + 136 + i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> ts = ts * 8 + (c - 48)
    }
}

; ─── tar-entry 方法 ───────────────────────────

; 讀取條目檔名
; name: 該條目的檔名
; [name](#tar.tar-entry.name)
tar-entry.name = () (name str) {
    hdr = .idx
    name = ''
    i <- [0..100): {

        #{overflow=wrap}
        c char = .data[hdr + i]
        c == 0 -> break

        name = name - c.to-str()
    }
}

; 讀取條目檔案大小
; sz: 條目原始位元組數
; [size](#tar.tar-entry.size)
tar-entry.size = () (sz i64) {
    hdr = .idx
    sz = 0
    i <- [0..12): {

        #{overflow=wrap}
        c = .data[hdr + 124 + i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> sz = sz * 8 + (c - 48)
    }
}

; 讀取條目類型
; typ: 型別字串（"file"、"dir" 或 "unknown"）
; [type](#tar.tar-entry.type)
tar-entry.type = () (typ str) {

    hdr = .idx

    #{overflow=wrap}
    c = .data[hdr + 156]
    typ = 'unknown'
    {
        c == 48 || c == 0 -> typ = 'file'

        c == 53 -> typ = 'dir'
    }
}

; 判斷是否為目錄
; yes: 該條目是否為目錄
; [is-dir](#tar.tar-entry.is-dir)
tar-entry.is-dir = () (yes bool) {

    hdr = .idx

    #{overflow=wrap}
    c = .data[hdr + 156]
    yes = (c == 53)
}

; 判斷是否為普通檔案
; yes: 該條目是否為普通檔案
; [is-file](#tar.tar-entry.is-file)
tar-entry.is-file = () (yes bool) {

    hdr = .idx

    #{overflow=wrap}
    c = .data[hdr + 156]
    yes = (c == 48 || c == 0)
}

; 提取條目內容
; out: 條目內容位元組（目錄為空）
; [read](#tar.tar-entry.read)
tar-entry.read = () (out []byte) {
    sz = .size()
    hdr = .idx
    sz > 0 -> {
        i <- [0..sz): {

            #{overflow=wrap}
            out.push(.data[hdr + TAR-BLOCK + i])
        }
    }
}

; 讀取條目權限
; mode: 權限位元（八進位解碼）
; [mode](#tar.tar-entry.mode)
tar-entry.mode = () (mode i64) {
    hdr = .idx
    mode = 0
    i <- [0..8): {

        #{overflow=wrap}
        c = .data[hdr + 100 + i]

        #{overflow=wrap}
        c >= 48 && c <= 55 -> mode = mode * 8 + (c - 48)
    }
}

; 讀取條目修改時間
; ts: 修改時間（Unix 秒，八進位解碼）
; [mtime](#tar.tar-entry.mtime)
tar-entry.mtime = () (ts i64) {
    hdr = .idx
    ts = 0
    i <- [0..12): {

        #{overflow=wrap}
        c = .data[hdr + 136 + i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> ts = ts * 8 + (c - 48)
    }
}

; ─── tar-builder 方法 ─────────────────────────

; 預分配緩衝區（用局部變數 push，避免結構體欄位 push 限制）
; size: 預分配的緩衝區位元組數（零填充至該長度）
; [pre-alloc](#tar.tar-builder.pre-alloc)
tar-builder.pre-alloc = (size i64) {
    buf []byte
    i <- [0..size): {
        buf.push(0)
    }
    .buf = buf
}

; 新增檔案條目
; name: 檔名（寫入標頭 name 欄）
; content: 檔案內容（寫入後補零對齊 512 位元組邊界）
; [add-file](#tar.tar-builder.add-file)
tar-builder.add-file = (name str, content []byte) {

    .write-header(name, TAR-TYPE-FILE, len(content))

    ; 寫入檔案內容
    sz = len(content)
    i <- [0..sz): {

        #{index-out=zero, overflow=wrap}
        .buf[.pos + i] = content[i]
    }

    #{overflow=wrap}
    .pos = .pos + sz

    ; 補齊到 512 邊界
    rem = sz % TAR-BLOCK

    #{overflow=wrap}
    rem > 0 -> {

        #{overflow=wrap}
        pad = TAR-BLOCK - rem
        j <- [0..pad): {

            #{overflow=wrap}
            .buf[.pos + j] = 0
        }
        .pos = .pos + pad
    }
}

; 新增目錄條目
; name: 目錄名（慣例以 / 結尾，無內容區）
; [add-dir](#tar.tar-builder.add-dir)
tar-builder.add-dir = (name str) {
    .write-header(name, TAR-TYPE-DIR, 0)
}

; 新增原始位元組條目
; name: 條目名
; content: 條目內容位元組
; typ: 條目型別碼（TAR-TYPE-FILE / TAR-TYPE-DIR）
; [add-bytes](#tar.tar-builder.add-bytes)
tar-builder.add-bytes = (name str, content []byte, typ i64) {

    .write-header(name, typ, len(content))
    sz = len(content)
    i <- [0..sz): {

        #{index-out=zero, overflow=wrap}
        .buf[.pos + i] = content[i]
    }

    #{overflow=wrap}
    .pos = .pos + sz

    ; 補齊到 512 邊界
    rem = sz % TAR-BLOCK

    #{overflow=wrap}
    rem > 0 -> {

        #{overflow=wrap}
        pad = TAR-BLOCK - rem
        j <- [0..pad): {

            #{overflow=wrap}
            .buf[.pos + j] = 0
        }
        .pos = .pos + pad
    }
}

; 寫入 512 位元組 header（內部方法）
; name: 檔名（寫入標頭偏移 0）
; typ: typeflag 字元碼（48=檔案、53=目錄）
; sz: 內容位元組數（以八進位寫入 size 欄）
; [write-header](#tar.tar-builder.write-header)
tar-builder.write-header = (name str, typ i64, sz i64) {

    ; 清零 header 區
    i <- [0..TAR-BLOCK): {

        #{overflow=wrap}
        .buf[.pos + i] = 0
    }

    ; 名稱（偏移 0，最多 100 位元組）
    name-len = len(name)
    i <- [0..name-len): {

        #{overflow=wrap}
        i < 100 -> {

            .buf[.pos + i] = name.byte(i)
        }
    }

    ; 模式（偏移 100，8 位元組八進制 "0000644\0"）
    .write-octal(100, 7, 420)

    ; UID（偏移 108，8 位元組）
    .write-octal(108, 7, 0)

    ; GID（偏移 116，8 位元組）
    .write-octal(116, 7, 0)

    ; 大小（偏移 124，12 位元組八進制）
    .write-octal(124, 11, sz)

    ; 修改時間（偏移 136，12 位元組八進制）
    .write-octal(136, 11, 0)

    ; 類型（偏移 156，1 位元組）
    #{overflow=wrap}
    .buf[.pos + 156] = typ

    ; ustar magic（偏移 257，6 位元組 "ustar\0"）
    #{overflow=wrap}
    .buf[.pos + 257] = 117

    #{overflow=wrap}
    .buf[.pos + 258] = 115

    #{overflow=wrap}
    .buf[.pos + 259] = 116

    #{overflow=wrap}
    .buf[.pos + 260] = 97

    #{overflow=wrap}
    .buf[.pos + 261] = 114

    #{overflow=wrap}
    .buf[.pos + 262] = 0

    ; 計算校驗和（偏移 148，8 位元組）
    ; 先填空白
    #{overflow=wrap}
    .buf[.pos + 148] = 32

    #{overflow=wrap}
    .buf[.pos + 149] = 32

    #{overflow=wrap}
    .buf[.pos + 150] = 32

    #{overflow=wrap}
    .buf[.pos + 151] = 32

    #{overflow=wrap}
    .buf[.pos + 152] = 32

    #{overflow=wrap}
    .buf[.pos + 153] = 32

    #{overflow=wrap}
    .buf[.pos + 154] = 32

    #{overflow=wrap}
    .buf[.pos + 155] = 32

    checksum = 0
    i <- [0..TAR-BLOCK): {

        #{overflow=wrap}
        checksum = checksum + (.buf[.pos + i])
    }
    .write-octal(148, 6, checksum)

    #{overflow=wrap}
    .buf[.pos + 154] = 0

    #{overflow=wrap}
    .buf[.pos + 155] = 32

    #{overflow=wrap}
    .pos = .pos + TAR-BLOCK
}

; 在指定偏移寫入八進制數字（內部方法）
; offset: 欄位在當前標頭區塊內的偏移
; width: 欄位寬度（右對齊八進位數字、左側補空白）
; val: 待編碼的整數值（區塊尾另補 NUL）
; [write-octal](#tar.tar-builder.write-octal)
tar-builder.write-octal = (offset i64, width i64, val i64) {

    #{overflow=wrap}
    base = .pos + offset

    ; 先填空白
    i <- [0..width): {

        #{overflow=wrap}
        .buf[base + i] = 32
    }

    ; 從右往左填數字
    v = val

    #{overflow=wrap}
    pos = width - 1
    (v > 0) {

        #{overflow=wrap}
        .buf[base + pos] = 48 + (v % 8)

        #{overflow=wrap}
        v = v / 8

        #{overflow=wrap}
        pos = pos - 1
    }

    #{overflow=wrap}
    .buf[base + width] = 0
}

; 結束建構，寫入結束標記並返回 tar 歸檔
; archive: 含兩個全零結束區塊的 tar 唯讀視圖
; [finish](#tar.tar-builder.finish)
tar-builder.finish = () (archive tar) {

    ; 寫入兩個全零區塊作為結束標記
    #{overflow=wrap}
    i <- [0..TAR-BLOCK * 2): {

        #{overflow=wrap}
        .buf[.pos + i] = 0
    }

    ; 構建 tar 結構體
    archive.data = .buf
}
