; zip — ZIP 歸檔解析
;
; 讀取 ZIP 檔案格式，列出條目和提取內容。
; 支援 stored（method 0）和 deflate（method 8）條目提取。
;
; 用法：
;   archive = zip{
;       data: raw-bytes
;   }
;   n = archive.count()
;   i <- [0..n): {
;       e = archive.entry(i)
;       name = e.name()
;       sz = e.size()
;       content = e.extract()
;   }

; ─── 結構體定義 ───────────────────────────────

; zip: ZIP 歸檔唯讀視圖
zip {
    data []byte
}

; zip-entry: ZIP 條目（指向 archive.data 中的某個 central directory 條目）
zip-entry {
    data []byte
    off i64
}

; ─── 位元組輔助 ─────────────────────────────

; u32le: 讀取 4 位元組小端序無號整數
u32le = (data []byte, off i64) (v i64) {
    #{overflow=wrap}
    off1 = off + 1
    #{overflow=wrap}
    off2 = off + 2
    #{overflow=wrap}
    off3 = off + 3
    #{index-out = 0}
    b0 = data[off]
    #{index-out = 0}
    b1 = data[off1]
    #{index-out = 0}
    b2 = data[off2]
    #{index-out = 0}
    b3 = data[off3]
    v = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

; u16le: 讀取 2 位元組小端序無號整數
u16le = (data []byte, off i64) (v i64) {
    #{overflow=wrap}
    off1 = off + 1
    #{index-out = 0}
    b0 = data[off]
    #{index-out = 0}
    b1 = data[off1]
    v = b0 | (b1 << 8)
}

; ─── zip 方法 ─────────────────────────────────

; find-eocd: 從結尾搜尋 EOCD 簽名
zip.find-eocd = () (off i64) {
    #{overflow=wrap}
    off = -1
    n = len(.data)
    ! n >= 22 -> return
    #{overflow=wrap}
    start = n - 22
    #{overflow=wrap}
    i <- [0..start + 1): {
        #{overflow=wrap}
        idx = start - i
        sig = u32le(.data, idx)
        ! sig == 101010256 -> continue
        off = idx
        break
    }
}

; get-cd-off: 讀取中央目錄偏移（單值返回，避免多值 compiler bug）
zip.get-cd-off = () (cd-off i64) {
    #{overflow=wrap}
    eocd = .find-eocd()
    eocd < 0 -> {
        cd-off = 0
        return
    }
    #{overflow=wrap}
    off16 = eocd + 16
    cd-off = u32le(.data, off16)
}

; get-total: 讀取條目數（單值返回）
zip.get-total = () (total i64) {
    #{overflow=wrap}
    eocd = .find-eocd()
    eocd < 0 -> {
        total = 0
        return
    }
    #{overflow=wrap}
    off8 = eocd + 8
    total = u16le(.data, off8)
}

; entry-off: 第 idx 個 central directory 條目的偏移
zip.entry-off = (idx i64) (off i64) {
    cd-off = .get-cd-off()
    total = .get-total()
    cur = cd-off
    j <- [0..idx): {
        #{overflow=wrap}
        j >= total -> break
        #{overflow=wrap}
        off28 = cur + 28
        #{overflow=wrap}
        off30 = cur + 30
        #{overflow=wrap}
        off32 = cur + 32
        name-len = u16le(.data, off28)
        extra-len = u16le(.data, off30)
        comment-len = u16le(.data, off32)
        #{overflow=wrap}
        skip = 46 + name-len + extra-len + comment-len
        #{overflow=wrap}
        cur = cur + skip
    }
    off = cur
}

; count: 傳回 ZIP 中的條目數
zip.count = () (count i64) {
    count = .get-total()
}

; entry: 取得第 idx 個條目
zip.entry = (idx i64) (e zip-entry) {
    e.data = .data
    e.off = .entry-off(idx)
}

; name: 第 idx 個條目的檔名
zip.name = (idx i64) (name str) {
    #{overflow=wrap}
    off = .entry-off(idx)
    #{overflow=wrap}
    off28 = off + 28
    name-len = u16le(.data, off28)
    #{overflow=wrap}
    off46 = off + 46
    result = ''
    i <- [0..name-len): {
        #{overflow=wrap}
        idx2 = off46 + i
        #{overflow=wrap}
        #{index-out = 0}
        result = result - number.char-to-str(.data[idx2])
    }
    name = result
}

; size: 原始大小
zip.size = (idx i64) (sz i64) {
    #{overflow=wrap}
    off = .entry-off(idx)
    #{overflow=wrap}
    off24 = off + 24
    sz = u32le(.data, off24)
}

; compressed-size: 壓縮後大小
zip.compressed-size = (idx i64) (csz i64) {
    #{overflow=wrap}
    off = .entry-off(idx)
    #{overflow=wrap}
    off20 = off + 20
    csz = u32le(.data, off20)
}

; method: 壓縮方式（0=stored, 8=deflate）
zip.method = (idx i64) (method i64) {
    #{overflow=wrap}
    off = .entry-off(idx)
    #{overflow=wrap}
    off10 = off + 10
    method = u16le(.data, off10)
}

; extract: 提取第 idx 個條目的內容（stored 和 deflate）
zip.extract = (idx i64) (out []byte) {
    #{overflow=wrap}
    off = .entry-off(idx)
    #{overflow=wrap}
    off24 = off + 24
    #{overflow=wrap}
    off10 = off + 10
    #{overflow=wrap}
    off42 = off + 42
    #{overflow=wrap}
    off20 = off + 20
    sz = u32le(.data, off24)
    csz = u32le(.data, off20)
    method = u16le(.data, off10)
    local-off = u32le(.data, off42)

    ; local file header: 30 + name-len + extra-len
    #{overflow=wrap}
    off26 = local-off + 26
    #{overflow=wrap}
    off28 = local-off + 28
    #{overflow=wrap}
    off30 = local-off + 30
    name-len2 = u16le(.data, off26)
    extra-len2 = u16le(.data, off28)
    #{overflow=wrap}
    data-off = off30 + name-len2 + extra-len2
    result []byte
    #{overflow=wrap}
    {
        method == 0 && sz > 0 -> {
            i <- [0..sz): {
                #{overflow=wrap}
                src-off = data-off + i
                #{index-out = 0}
                result.push(.data[src-off])
            }
        }

        method == 8 && sz > 0 -> {
            ; 提取壓縮資料
            compressed []byte
            i <- [0..csz): {
                #{overflow=wrap}
                #{index-out = 0}
                compressed.push(.data[data-off + i])
            }

            ; 解壓縮 DEFLATE
            result = gzip.inflate-decompress(compressed, sz)
        }
    }
    out = result
}

; ─── zip-entry 方法 ───────────────────────────

; name: 讀取條目檔名
zip-entry.name = () (name str) {
    #{overflow=wrap}
    off = .off
    #{overflow=wrap}
    off28 = off + 28
    name-len = u16le(.data, off28)
    #{overflow=wrap}
    off46 = off + 46
    result = ''
    i <- [0..name-len): {
        #{overflow=wrap}
        idx2 = off46 + i
        #{overflow=wrap}
        #{index-out = 0}
        result = result - number.char-to-str(.data[idx2])
    }
    name = result
}

; size: 讀取條目原始大小
zip-entry.size = () (sz i64) {
    #{overflow=wrap}
    off24 = .off + 24
    sz = u32le(.data, off24)
}

; compressed-size: 讀取條目壓縮後大小
zip-entry.compressed-size = () (csz i64) {
    #{overflow=wrap}
    off20 = .off + 20
    csz = u32le(.data, off20)
}

; method: 讀取條目壓縮方式（0=stored, 8=deflate）
zip-entry.method = () (method i64) {
    #{overflow=wrap}
    off10 = .off + 10
    method = u16le(.data, off10)
}

; extract: 提取條目內容（stored 和 deflate）
zip-entry.extract = () (out []byte) {
    #{overflow=wrap}
    off = .off
    #{overflow=wrap}
    off24 = off + 24
    #{overflow=wrap}
    off10 = off + 10
    #{overflow=wrap}
    off42 = off + 42
    #{overflow=wrap}
    off20 = off + 20
    sz = u32le(.data, off24)
    csz = u32le(.data, off20)
    method = u16le(.data, off10)
    local-off = u32le(.data, off42)

    ; local file header: 30 + name-len + extra-len
    #{overflow=wrap}
    off26 = local-off + 26
    #{overflow=wrap}
    off28 = local-off + 28
    #{overflow=wrap}
    off30 = local-off + 30
    name-len2 = u16le(.data, off26)
    extra-len2 = u16le(.data, off28)
    #{overflow=wrap}
    data-off = off30 + name-len2 + extra-len2
    result []byte
    #{overflow=wrap}
    {
        method == 0 && sz > 0 -> {
            i <- [0..sz): {
                #{overflow=wrap}
                src-off = data-off + i
                #{index-out = 0}
                result.push(.data[src-off])
            }
        }

        method == 8 && sz > 0 -> {
            ; 提取壓縮資料
            compressed []byte
            i <- [0..csz): {
                #{overflow=wrap}
                #{index-out = 0}
                compressed.push(.data[data-off + i])
            }

            ; 解壓縮 DEFLATE
            result = gzip.inflate-decompress(compressed, sz)
        }
    }
    out = result
}

; ─── ZIP 寫入器 ───────────────────────────────

; zip-writer: ZIP 歸檔寫入器
;
; 用法：
;   w = zip-writer{}
;   w.add-file('test.txt', content-bytes)
;   w.add-dir('subdir/')
;   data = w.finalize()
;   fs.write-file('out.zip', data)

zip-writer {
    data []byte
    cd-data []byte
    count i64
}

; add-file: 添加檔案到歸檔（自動計算 CRC32）
zip-writer.add-file = (name str, content []byte) {
    #{overflow=wrap}
    crc = crc-32.crc-32(content, content.len())
    off = .data.len()
    .write-local-file(name, content, crc)
    .write-cd-entry(name, off, content.len(), content.len(), crc)
    #{overflow=wrap}
    .count = .count + 1
}

; add-dir: 添加目錄條目
zip-writer.add-dir = (name str) {
    #{overflow=wrap}
    dname = name
    #{overflow=wrap}
    dname.ends-with('/') == false -> dname = dname - '/'
    empty []byte
    off = .data.len()
    .write-local-file(dname, empty, 0)
    .write-cd-entry(dname, off, 0, 0, 0)
    #{overflow=wrap}
    .count = .count + 1
}

; put: 追加一個位元組到 data（透過局部變數支援 push）
zip-writer.put = (b i64) {
    d []byte
    d = .data
    d.push(b)
    .data = d
}

; cd-put: 追加一個位元組到 cd-data
zip-writer.cd-put = (b i64) {
    d []byte
    d = .cd-data
    d.push(b)
    .cd-data = d
}

; finalize: 寫入中央目錄和 EOCD，返回完整歸檔資料
zip-writer.finalize = () (out []byte) {
    cd-offset = .data.len()
    cd-size = .cd-data.len()
    i <- [0..cd-size): {
        #{index-out = 0}
        .put(.cd-data[i])
    }
    .write-eocd(cd-offset, cd-size)
    dlen = .data.len()
    out = with-cap(.data.len())
    i <- [0..dlen): {
        #{index-out = 0}
        out[i] = .data[i]
    }
}

; write-u16: 寫入 2 位元組小端序整數
zip-writer.write-u16 = (v i64) {
    .put(v & 255)
    .put((v >> 8) & 255)
}

; write-u32: 寫入 4 位元組小端序整數
zip-writer.write-u32 = (v i64) {
    .put(v & 255)
    .put((v >> 8) & 255)
    .put((v >> 16) & 255)
    .put((v >> 24) & 255)
}

; write-local-file: 寫入本地檔案標頭和內容
zip-writer.write-local-file = (name str, content []byte, crc i64) {

    ; 簽名 PK\x03\x04
    sig []byte = [0x50, 0x4b, 0x03, 0x04]
    i <- [0..4): {
        #{index-out = 0}
        .put(sig[i])
    }

    ; 版本 (20)
    .write-u16(20)

    ; 旗標 (0)
    .write-u16(0)

    ; 壓縮方式 (0=stored)
    .write-u16(0)

    ; 修改時間、日期 (0)
    .write-u16(0)
    .write-u16(0)

    ; CRC32
    .write-u32(crc)

    ; 壓縮後大小
    .write-u32(content.len())

    ; 原始大小
    .write-u32(content.len())

    ; 檔名長度
    name-len = name.len-bytes()
    .write-u16(name-len)

    ; 額外欄位長度 (0)
    .write-u16(0)

    ; 檔名
    i <- [0..name-len): {
        #{index-out = 0}
        .put(name[i])
    }

    ; 檔案內容
    i <- [0..content.len()): {
        #{index-out = 0}
        .put(content[i])
    }
}

; cd-write-u16: 寫入 2 位元組小端序整數到中央目錄
zip-writer.cd-write-u16 = (v i64) {
    .cd-put(v & 255)
    .cd-put((v >> 8) & 255)
}

; cd-write-u32: 寫入 4 位元組小端序整數到中央目錄
zip-writer.cd-write-u32 = (v i64) {
    .cd-put(v & 255)
    .cd-put((v >> 8) & 255)
    .cd-put((v >> 16) & 255)
    .cd-put((v >> 24) & 255)
}

; write-cd-entry: 寫入中央目錄條目
zip-writer.write-cd-entry = (name str, offset i64, size i64, compressed-size i64, crc i64) {

    ; 簽名 PK\x01\x02
    sig []byte = [0x50, 0x4b, 0x01, 0x02]
    i <- [0..4): {
        #{index-out = 0}
        .cd-put(sig[i])
    }

    ; 版本 (20)
    .cd-write-u16(20)

    ; 版本需要 (20)
    .cd-write-u16(20)

    ; 旗標 (0)
    .cd-write-u16(0)

    ; 壓縮方式 (0=stored)
    .cd-write-u16(0)

    ; 修改時間、日期 (0)
    .cd-write-u16(0)
    .cd-write-u16(0)

    ; CRC32
    .cd-write-u32(crc)

    ; 壓縮後大小
    .cd-write-u32(compressed-size)

    ; 原始大小
    .cd-write-u32(size)

    ; 檔名長度
    name-len = name.len-bytes()
    .cd-write-u16(name-len)

    ; 額外欄位長度 (0)
    .cd-write-u16(0)

    ; 註解長度 (0)
    .cd-write-u16(0)

    ; 磁碟號 (0)
    .cd-write-u16(0)

    ; 內部屬性 (0)
    .cd-write-u16(0)

    ; 外部屬性 (0)
    .cd-write-u32(0)

    ; 本地檔案標頭偏移
    .cd-write-u32(offset)

    ; 檔名
    i <- [0..name-len): {
        #{index-out = 0}
        .cd-put(name[i])
    }
}

; write-eocd: 寫入結束記錄 (End of Central Directory)
zip-writer.write-eocd = (cd-offset i64, cd-size i64) {

    ; 簽名 PK\x05\x06
    sig []byte = [0x50, 0x4b, 0x05, 0x06]
    i <- [0..4): {
        #{index-out = 0}
        .put(sig[i])
    }

    ; 磁碟號 (0)
    .write-u16(0)

    ; 中央目錄所在磁碟 (0)
    .write-u16(0)

    ; 此磁碟上的條目數
    .write-u16(.count)

    ; 總條目數
    .write-u16(.count)

    ; 中央目錄大小
    .write-u32(cd-size)

    ; 中央目錄偏移
    .write-u32(cd-offset)

    ; 註解長度 (0)
    .write-u16(0)
}
