; zip — ZIP 歸檔解析
;
; 讀取 ZIP 檔案格式，列出條目和提取內容。
; 支援 stored（method 0）和 deflate（method 8）條目提取。
;
; 用法：
;   archive = zip{
;       data: raw-bytes
;   }
;   n = archive.count()
;   i <- [0..n): {
;       e = archive.entry(i)
;       name = e.name()
;       sz = e.size()
;       content = e.extract()
;   }

; ─── 結構體定義 ───────────────────────────────

; zip: ZIP 歸檔唯讀視圖
zip {
    data []byte
}

; zip-entry: ZIP 條目（指向 archive.data 中的某個 central directory 條目）
zip-entry {
    data []byte
    off i64
}

; ─── 位元組輔助 ─────────────────────────────

; 讀取 4 位元組小端序無號整數
; data: ZIP 檔案位元組陣列
; off: 讀取起始位置（0 起始）
; v: 4 位元組小端序無號整數（0 ~ 2^32-1）
; [u32le](#zip.u32le)
u32le = (data []byte, off i64) (v i64) {

    #{overflow=wrap}
    off1 = off + 1

    #{overflow=wrap}
    off2 = off + 2

    #{overflow=wrap}
    off3 = off + 3

    #{index-out=zero}
    b0 = data[off]

    #{index-out=zero}
    b1 = data[off1]

    #{index-out=zero}
    b2 = data[off2]

    #{index-out=zero}
    b3 = data[off3]
    v = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

; 讀取 2 位元組小端序無號整數
; data: 待讀取的位元組陣列
; off: 讀取起始位置（0 起始）
; v: 2 位元組小端序無號整數（0 ~ 65535）
; [u16le](#zip.u16le)
u16le = (data []byte, off i64) (v i64) {

    #{overflow=wrap}
    off1 = off + 1

    #{index-out=zero}
    b0 = data[off]

    #{index-out=zero}
    b1 = data[off1]
    v = b0 | (b1 << 8)
}

; ─── zip 方法 ─────────────────────────────────

; 從結尾搜尋 EOCD 簽名
; off: EOCD 簽名所在偏移（找不到返回 -1）
; [find-eocd](#zip.zip.find-eocd)
zip.find-eocd = () (off i64) {

    off = -1
    n = len(.data)
    ! n >= 22 -> return

    #{overflow=wrap}
    start = n - 22

    #{overflow=wrap}
    i <- [0..start + 1): {

        #{overflow=wrap}
        idx = start - i
        sig = u32le(.data, idx)
        ! sig == 101010256 -> continue
        off = idx
        break
    }
}

; 讀取中央目錄偏移（單值返回，避免多值 compiler bug）
; cd-off: 中央目錄的起始偏移（無 EOCD 時返回 0）
; [get-cd-off](#zip.zip.get-cd-off)
zip.get-cd-off = () (cd-off i64) {

    eocd = .find-eocd()
    eocd < 0 -> {
        cd-off = 0
        return
    }

    #{overflow=wrap}
    off16 = eocd + 16
    cd-off = u32le(.data, off16)
}

; 讀取條目數（單值返回）
; total: 歸檔內的條目總數（無 EOCD 時返回 0）
; [get-total](#zip.zip.get-total)
zip.get-total = () (total i64) {

    eocd = .find-eocd()
    eocd < 0 -> {
        total = 0
        return
    }

    #{overflow=wrap}
    off8 = eocd + 8
    total = u16le(.data, off8)
}

; 第 idx 個 central directory 條目的偏移
; idx: 條目序號（0 ~ 總數-1）
; off: 該中央目錄條目在檔案資料中的絕對偏移
; [entry-off](#zip.zip.entry-off)
zip.entry-off = (idx i64) (off i64) {
    cd-off = .get-cd-off()
    total = .get-total()
    cur = cd-off
    j <- [0..idx): {

        j >= total -> break

        #{overflow=wrap}
        off28 = cur + 28

        #{overflow=wrap}
        off30 = cur + 30

        #{overflow=wrap}
        off32 = cur + 32
        name-len = u16le(.data, off28)
        extra-len = u16le(.data, off30)
        comment-len = u16le(.data, off32)

        #{overflow=wrap}
        skip = 46 + name-len + extra-len + comment-len

        #{overflow=wrap}
        cur = cur + skip
    }
    off = cur
}

; 傳回 ZIP 中的條目數
; count: 條目總數（歸檔損壞時為 0）
; [count](#zip.zip.count)
zip.count = () (count i64) {
    count = .get-total()
}

; 取得第 idx 個條目
; idx: 條目序號
; e: 綁定該條目偏移的 zip-entry 句柄（再經其方法讀欄位）
; [entry](#zip.zip.entry)
zip.entry = (idx i64) (e zip-entry) {
    e.data = .data
    e.off = .entry-off(idx)
}

; 第 idx 個條目的檔名
; idx: 條目序號
; name: 檔名（可含以 / 分隔的相對路徑）
; [name](#zip.zip.name)
zip.name = (idx i64) (name str) {

    off = .entry-off(idx)

    #{overflow=wrap}
    off28 = off + 28
    name-len = u16le(.data, off28)

    #{overflow=wrap}
    off46 = off + 46
    result = ''
    i <- [0..name-len): {

        #{overflow=wrap}
        idx2 = off46 + i

        cc char = .data[idx2]
        result = result - cc.to-str()
    }
    name = result
}

; 原始大小
; idx: 條目序號
; sz: 壓縮前的原始位元組數
; [size](#zip.zip.size)
zip.size = (idx i64) (sz i64) {

    off = .entry-off(idx)

    #{overflow=wrap}
    off24 = off + 24
    sz = u32le(.data, off24)
}

; 壓縮後大小
; idx: 條目序號
; csz: 壓縮後的位元組數（stored 時與原始相同）
; [compressed-size](#zip.zip.compressed-size)
zip.compressed-size = (idx i64) (csz i64) {

    off = .entry-off(idx)

    #{overflow=wrap}
    off20 = off + 20
    csz = u32le(.data, off20)
}

; 壓縮方式（0=stored, 8=deflate）
; idx: 條目序號
; method: 壓縮方式（0=stored 未壓縮、8=deflate）
; [method](#zip.zip.method)
zip.method = (idx i64) (method i64) {

    off = .entry-off(idx)

    #{overflow=wrap}
    off10 = off + 10
    method = u16le(.data, off10)
}

; 提取第 idx 個條目的內容（stored 和 deflate）
; idx: 條目序號
; out: 解壓後的原始位元組（stored 直接拷貝、deflate 自動 inflate）
; [extract](#zip.zip.extract)
zip.extract = (idx i64) (out []byte) {

    off = .entry-off(idx)

    #{overflow=wrap}
    off24 = off + 24

    #{overflow=wrap}
    off10 = off + 10

    #{overflow=wrap}
    off42 = off + 42

    #{overflow=wrap}
    off20 = off + 20
    sz = u32le(.data, off24)
    csz = u32le(.data, off20)
    method = u16le(.data, off10)
    local-off = u32le(.data, off42)

    ; local file header: 30 + name-len + extra-len
    #{overflow=wrap}
    off26 = local-off + 26

    #{overflow=wrap}
    off28 = local-off + 28

    #{overflow=wrap}
    off30 = local-off + 30
    name-len2 = u16le(.data, off26)
    extra-len2 = u16le(.data, off28)

    #{overflow=wrap}
    data-off = off30 + name-len2 + extra-len2
    result []byte

    #{overflow=wrap}
    {
        method == 0 && sz > 0 -> {
            i <- [0..sz): {

                #{overflow=wrap}
                src-off = data-off + i

                result.push(.data[src-off])
            }
        }

        method == 8 && sz > 0 -> {

            ; 提取壓縮資料
            compressed []byte
            i <- [0..csz): {

                #{overflow=wrap}
                compressed.push(.data[data-off + i])
            }

            ; 解壓縮 DEFLATE
            result = gzip.inflate-decompress(compressed, sz)
        }
    }
    out = result
}

; ─── zip-entry 方法 ───────────────────────────

; 讀取條目檔名
; name: 該條目的檔名
; [name](#zip.zip-entry.name)
zip-entry.name = () (name str) {

    off = .off

    #{overflow=wrap}
    off28 = off + 28
    name-len = u16le(.data, off28)

    #{overflow=wrap}
    off46 = off + 46
    result = ''
    i <- [0..name-len): {

        #{overflow=wrap}
        idx2 = off46 + i

        cc char = .data[idx2]
        result = result - cc.to-str()
    }
    name = result
}

; 讀取條目原始大小
; sz: 壓縮前的原始位元組數
; [size](#zip.zip-entry.size)
zip-entry.size = () (sz i64) {

    #{overflow=wrap}
    off24 = .off + 24
    sz = u32le(.data, off24)
}

; 讀取條目壓縮後大小
; csz: 壓縮後的位元組數
; [compressed-size](#zip.zip-entry.compressed-size)
zip-entry.compressed-size = () (csz i64) {

    #{overflow=wrap}
    off20 = .off + 20
    csz = u32le(.data, off20)
}

; 讀取條目壓縮方式（0=stored, 8=deflate）
; method: 壓縮方式（0=stored、8=deflate）
; [method](#zip.zip-entry.method)
zip-entry.method = () (method i64) {

    #{overflow=wrap}
    off10 = .off + 10
    method = u16le(.data, off10)
}

; 提取條目內容（stored 和 deflate）
; out: 解壓後的原始位元組（stored 直接拷貝、deflate 自動 inflate）
; [extract](#zip.zip-entry.extract)
zip-entry.extract = () (out []byte) {

    off = .off

    #{overflow=wrap}
    off24 = off + 24

    #{overflow=wrap}
    off10 = off + 10

    #{overflow=wrap}
    off42 = off + 42

    #{overflow=wrap}
    off20 = off + 20
    sz = u32le(.data, off24)
    csz = u32le(.data, off20)
    method = u16le(.data, off10)
    local-off = u32le(.data, off42)

    ; local file header: 30 + name-len + extra-len
    #{overflow=wrap}
    off26 = local-off + 26

    #{overflow=wrap}
    off28 = local-off + 28

    #{overflow=wrap}
    off30 = local-off + 30
    name-len2 = u16le(.data, off26)
    extra-len2 = u16le(.data, off28)

    #{overflow=wrap}
    data-off = off30 + name-len2 + extra-len2
    result []byte

    #{overflow=wrap}
    {
        method == 0 && sz > 0 -> {
            i <- [0..sz): {

                #{overflow=wrap}
                src-off = data-off + i

                result.push(.data[src-off])
            }
        }

        method == 8 && sz > 0 -> {

            ; 提取壓縮資料
            compressed []byte
            i <- [0..csz): {

                #{overflow=wrap}
                compressed.push(.data[data-off + i])
            }

            ; 解壓縮 DEFLATE
            result = gzip.inflate-decompress(compressed, sz)
        }
    }
    out = result
}

; ─── ZIP 寫入器 ───────────────────────────────

; zip-writer: ZIP 歸檔寫入器
;
; 用法：
;   w = zip-writer{}
;   w.add-file('test.txt', content-bytes)
;   w.add-dir('subdir/')
;   data = w.finalize()
;   fs.write-file('out.zip', data)

zip-writer {
    data []byte
    cd-data []byte
    count i64
}

; 添加檔案到歸檔（自動計算 CRC32）
; name: 歸檔內儲存的路徑名
; content: 檔案內容（以 stored 方式原樣儲存，自動計算 CRC32）
; [add-file](#zip.zip-writer.add-file)
zip-writer.add-file = (name str, content []byte) {

    crc = crc-32.new(content, content.len())
    off = .data.len()
    .write-local-file(name, content, crc)
    .write-cd-entry(name, off, content.len(), content.len(), crc)

    #{overflow=wrap}
    .count = .count + 1
}

; 添加目錄條目
; name: 目錄名（未以 / 結尾時自動補上）
; [add-dir](#zip.zip-writer.add-dir)
zip-writer.add-dir = (name str) {

    dname = name

    dname.ends-with('/') == false -> dname = dname - '/'
    empty []byte
    off = .data.len()
    .write-local-file(dname, empty, 0)
    .write-cd-entry(dname, off, 0, 0, 0)

    #{overflow=wrap}
    .count = .count + 1
}

; 追加一個位元組到 data（透過局部變數支援 push）
; b: 待追加的位元組值（取低 8 位寫入本地資料區）
; [put](#zip.zip-writer.put)
zip-writer.put = (b i64) {
    d []byte
    d = .data
    d.push(b)
    .data = d
}

; 追加一個位元組到 cd-data
; b: 待追加的位元組值（取低 8 位寫入中央目錄緩衝）
; [cd-put](#zip.zip-writer.cd-put)
zip-writer.cd-put = (b i64) {
    d []byte
    d = .cd-data
    d.push(b)
    .cd-data = d
}

; 寫入中央目錄和 EOCD，返回完整歸檔資料
; out: 完整 ZIP 歸檔位元組（本地資料 + 中央目錄 + EOCD）
; [finalize](#zip.zip-writer.finalize)
zip-writer.finalize = () (out []byte) {
    cd-offset = .data.len()
    cd-size = .cd-data.len()
    i <- [0..cd-size): {

        .put(.cd-data[i])
    }
    .write-eocd(cd-offset, cd-size)
    dlen = .data.len()
    out = with-cap(.data.len())
    i <- [0..dlen): {

        out[i] = .data[i]
    }
}

; 寫入 2 位元組小端序整數
; v: 待寫入整數（取低 16 位以小端序追加）
; [write-u16](#zip.zip-writer.write-u16)
zip-writer.write-u16 = (v i64) {
    .put(v & 255)
    .put((v >> 8) & 255)
}

; 寫入 4 位元組小端序整數
; v: 待寫入整數（取低 32 位以小端序追加）
; [write-u32](#zip.zip-writer.write-u32)
zip-writer.write-u32 = (v i64) {
    .put(v & 255)
    .put((v >> 8) & 255)
    .put((v >> 16) & 255)
    .put((v >> 24) & 255)
}

; 寫入本地檔案標頭和內容
; name: 檔名（寫入標頭與資料區）
; content: 檔案內容（不壓縮、原樣 stored 寫入）
; crc: 內容的 CRC32 校驗值
; [write-local-file](#zip.zip-writer.write-local-file)
zip-writer.write-local-file = (name str, content []byte, crc i64) {

    ; 簽名 PK\x03\x04
    sig = [0x50, 0x4b, 0x03, 0x04]
    i <- [0..4): {

        #{index-out=zero}
        .put(sig[i])
    }

    ; 版本 (20)
    .write-u16(20)

    ; 旗標 (0)
    .write-u16(0)

    ; 壓縮方式 (0=stored)
    .write-u16(0)

    ; 修改時間、日期 (0)
    .write-u16(0)
    .write-u16(0)

    ; CRC32
    .write-u32(crc)

    ; 壓縮後大小
    .write-u32(content.len())

    ; 原始大小
    .write-u32(content.len())

    ; 檔名長度
    name-len = name.len-bytes()
    .write-u16(name-len)

    ; 額外欄位長度 (0)
    .write-u16(0)

    ; 檔名
    i <- [0..name-len): {

        .put(name.byte(i))
    }

    ; 檔案內容
    i <- [0..content.len()): {

        #{index-out=zero}
        .put(content[i])
    }
}

; 寫入 2 位元組小端序整數到中央目錄
; v: 待寫入整數（取低 16 位以小端序追加到中央目錄緩衝）
; [cd-write-u16](#zip.zip-writer.cd-write-u16)
zip-writer.cd-write-u16 = (v i64) {
    .cd-put(v & 255)
    .cd-put((v >> 8) & 255)
}

; 寫入 4 位元組小端序整數到中央目錄
; v: 待寫入整數（取低 32 位以小端序追加到中央目錄緩衝）
; [cd-write-u32](#zip.zip-writer.cd-write-u32)
zip-writer.cd-write-u32 = (v i64) {
    .cd-put(v & 255)
    .cd-put((v >> 8) & 255)
    .cd-put((v >> 16) & 255)
    .cd-put((v >> 24) & 255)
}

; 寫入中央目錄條目
; name: 檔名
; offset: 該條目本地檔案標頭的起始偏移
; size: 壓縮前大小
; compressed-size: 壓縮後大小
; crc: 內容的 CRC32 校驗值
; [write-cd-entry](#zip.zip-writer.write-cd-entry)
zip-writer.write-cd-entry = (name str, offset i64, size i64, compressed-size i64, crc i64) {

    ; 簽名 PK\x01\x02
    sig = [0x50, 0x4b, 0x01, 0x02]
    i <- [0..4): {

        #{index-out=zero}
        .cd-put(sig[i])
    }

    ; 版本 (20)
    .cd-write-u16(20)

    ; 版本需要 (20)
    .cd-write-u16(20)

    ; 旗標 (0)
    .cd-write-u16(0)

    ; 壓縮方式 (0=stored)
    .cd-write-u16(0)

    ; 修改時間、日期 (0)
    .cd-write-u16(0)
    .cd-write-u16(0)

    ; CRC32
    .cd-write-u32(crc)

    ; 壓縮後大小
    .cd-write-u32(compressed-size)

    ; 原始大小
    .cd-write-u32(size)

    ; 檔名長度
    name-len = name.len-bytes()
    .cd-write-u16(name-len)

    ; 額外欄位長度 (0)
    .cd-write-u16(0)

    ; 註解長度 (0)
    .cd-write-u16(0)

    ; 磁碟號 (0)
    .cd-write-u16(0)

    ; 內部屬性 (0)
    .cd-write-u16(0)

    ; 外部屬性 (0)
    .cd-write-u32(0)

    ; 本地檔案標頭偏移
    .cd-write-u32(offset)

    ; 檔名
    i <- [0..name-len): {

        .cd-put(name.byte(i))
    }
}

; 寫入結束記錄 (End of Central Directory)
; cd-offset: 中央目錄的起始偏移
; cd-size: 中央目錄的總位元組數
; [write-eocd](#zip.zip-writer.write-eocd)
zip-writer.write-eocd = (cd-offset i64, cd-size i64) {

    ; 簽名 PK\x05\x06
    sig = [0x50, 0x4b, 0x05, 0x06]
    i <- [0..4): {

        #{index-out=zero}
        .put(sig[i])
    }

    ; 磁碟號 (0)
    .write-u16(0)

    ; 中央目錄所在磁碟 (0)
    .write-u16(0)

    ; 此磁碟上的條目數
    .write-u16(.count)

    ; 總條目數
    .write-u16(.count)

    ; 中央目錄大小
    .write-u32(cd-size)

    ; 中央目錄偏移
    .write-u32(cd-offset)

    ; 註解長度 (0)
    .write-u16(0)
}
