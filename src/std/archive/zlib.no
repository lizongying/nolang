; zlib — RFC 1950 zlib 壓縮與解壓縮（純 Nolang 實現）
;
; Git stores every loose object and every pack-object payload as a zlib
; stream: a 2-byte header, raw DEFLATE data, and a 4-byte big-endian
; Adler-32 checksum of the uncompressed data.
;
; 支援：
;   - zlib 壓縮：使用 stored blocks (BTYPE=00) 構造合法 zlib 串流
;   - zlib 解壓：支援 stored blocks 及透過 gzip.inflate-decompress 的完整 DEFLATE
;
; 用法：
;   data = fs.read-file('blob')          ; 讀取為 []byte
;   compressed = compress(data)     ; 壓縮為 zlib 格式
;   decompressed, ok = decompress(compressed)  ; 解壓 zlib 格式
;
; 演算法參考：RFC 1950 (zlib), RFC 1951 (DEFLATE)
; [zlib](#zlib)

; Adler-32 校驗和 (RFC 1950)
...

; 計算 Adler-32 校驗和
;   data: 輸入資料 ([]byte)
;   n: 實際參與計算的位元組數 (i64)
;   返回 sum: 32 位元校驗和 (i64)，高位為 b、低位為 a，可與 RFC 1950 的實作互相比對
; [adler-32](#zlib.adler-32)
adler-32 = (data []byte, n i64) (sum i64) {
    mod-base = 65521
    a = 1
    b = 0
    i <- [0..n): {
        data-i = data[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        a = (a + data-i) % mod-base

        {
            #{overflow=wrap}
            b ?= (b + a) % mod-base
        }: {
            err -> _

            -> _
        }
    }
    sum = ((b << 16) | a) & 4294967295
}

; zlib 壓縮
...

; 壓縮資料為 zlib 串流
;   data: 未壓縮輸入資料 ([]byte)
;   返回 out: zlib 串流（2-byte header + DEFLATE + 4-byte Adler-32）
;
; 使用 stored blocks (BTYPE=00) 構造 zlib 串流：
;   - 2-byte zlib header (78 9c)
;   - DEFLATE stored blocks（每塊最大 65535 bytes）
;   - 4-byte big-endian Adler-32 checksum
; out: 完整 zlib 串流（2-byte header + stored blocks + 4-byte Adler-32）
; [compress](#zlib.compress)
compress = (data []byte) (out []byte) {
    result []byte

    ; zlib header: CMF=0x78 (CM=8, CINFO=7), FLG=0x9c (FCHECK, no dict)
    result.push(0x78)
    result.push(0x9c)

    ; DEFLATE 資料（stored blocks）
    deflated = gzip.deflate-stored(data)
    b <- deflated: {
        result.push(b)
    }

    ; Adler-32 checksum（big-endian 4 bytes）
    adler = adler-32(data, data.len())
    result.push((adler >> 24) & 255)
    result.push((adler >> 16) & 255)
    result.push((adler >> 8) & 255)
    result.push(adler & 255)

    out = result
}

; zlib 解壓縮
...

; 解壓 zlib 串流
;   data: zlib 串流 ([]byte)
;   返回 out: 解壓後資料（some），失敗為 nil
;
; 支援所有 DEFLATE 區塊類型（stored, fixed Huffman, dynamic Huffman）
; 透過 gzip.inflate-decompress 進行解壓。
; 先嘗試 stored-block 掃描（快速路徑），失敗則使用 inflate 解壓。
; out: 解壓後資料（ok）；長度不足 6、header 非法或解壓失敗皆為 nil
; [decompress](#zlib.decompress)
decompress = (data []byte) (out ?[]byte) {
    out = nil
    data.len() < 6 -> return

    ; 檢查 zlib header：CM(低 4 位)必須為 8(deflate)，CINFO(高 4 位)≤7
    ; 窗口大小僅供參考，inflate 一律用 32K 窗口解碼，故接受任意合法 CMF(如 sips 的 0x08)
    cmf-byte = data[0]: {
        ok -> it

        -> 0
    }

    (cmf-byte & 0x0f) != 8 || (cmf-byte >> 4) > 7 -> {
        return
    }

    ; 跳過 zlib header(2 bytes；若 FLG.FDICT 置位再多 4 bytes DICTID)，取 raw DEFLATE 資料
    hdr-len = 2

    flg-byte = data[1]: {
        ok -> it

        -> 0
    }

    flg-byte & 0x20 != 0 -> hdr-len = 6

    #{overflow=wrap}
    data.len() < hdr-len + 4 -> {
        return
    }

    #{overflow=wrap}
    deflate-len = data.len() - hdr-len - 4; 去掉 header + 4-byte Adler-32
    deflate-data []byte
    i <- [0..deflate-len): {
        {
            #{overflow=wrap}
            payload-at ?= hdr-len + i

            payload-byte ?= data[payload-at]

            deflate-data.push(payload-byte)
        }: {
            err -> _

            -> _
        }
    }

    ; 預估輸出大小：100 倍輸入（上限 1MB，下限 64 bytes）
    #{overflow=wrap}
    est-out = deflate-len * 100
    est-out > 1048576 -> est-out = 1048576
    est-out < 64 -> est-out = 64

    ; 使用 inflate 解壓 DEFLATE 資料
    out = gzip.inflate-decompress(deflate-data, est-out)
}

; 輔助函式
...

; 僅解壓 stored-block 的 zlib 串流
;   data: 僅含 BTYPE=00 區塊的 zlib 串流 ([]byte)
;   返回 out: 解壓後資料（some），非 stored 區塊或失敗為 nil
; out: 僅由 BTYPE=00 區塊解出的位元組；遇其他區塊類型或結尾不符即回 nil
; [decompress-stored](#zlib.decompress-stored)
decompress-stored = (data []byte) (out ?[]byte) {
    out = nil
    data.len() < 6 -> return

    buf []byte
    p = 2; 跳過 2-byte zlib header
    !! {
        p >= data.len() -> break

        hdr i64 = data[p]: {
            ok -> it

            -> 0
        }
        bfinal i64 = hdr & 1
        btype i64 = (hdr >> 1) & 3
        btype != 0 -> return

        #{overflow=wrap}
        p ?= p + 1

        ; 區塊長度 LEN（2 bytes 小端）與其補數 NLEN
        blk-len i64 = 0
        {
            len-low ?= data[p]

            len-high ?= data[p + 1]

            blk-len = len-low | (len-high << 8)

            ; 跳過 LEN(2) + NLEN(2)
            #{overflow=wrap}
            p ?= p + 4
        }: {
            err -> _

            -> _
        }

        ; 提取 payload
        i <- [0..blk-len): {
            {
                #{overflow=wrap}
                payload-at ?= p + i

                payload-byte ?= data[payload-at]

                buf.push(payload-byte)
            }: {
                err -> _

                -> _
            }
        }

        #{overflow=wrap}
        p ?= p + blk-len
        bfinal == 1 -> break
    }
    out = buf
}

; 計算 stored-block zlib 串流的消耗位元組數
;   data: 從偏移 0 開始的 zlib 串流 ([]byte)
;   返回 consumed: 總消耗位元組數（含 header 和 Adler-32），0 表示非 stored 區塊
;     逐塊累加 5 位元組塊頭 + 資料長度 + 4 位元組校驗和，遇到 BFINAL 或非 stored 區塊即停止
; [consumed-stored](#zlib.consumed-stored)
consumed-stored = (data []byte) (consumed i64) {
    consumed = 0
    data.len() < 6 -> return

    p = 2; 跳過 2-byte zlib header
    !! {
        p >= data.len() -> return

        hdr i64 = data[p]: {
            ok -> it

            -> 0
        }

        bfinal i64 = hdr & 1

        btype i64 = (hdr >> 1) & 3
        btype != 0 -> return

        ; 區塊長度 LEN（2 bytes 小端）與其補數 NLEN
        blk-len i64 = 0
        {
            #{overflow=wrap}
            p ?= p + 1

            len-low ?= data[p]

            len-high ?= data[p + 1]

            blk-len = (len-low & 255) | ((len-high & 255) << 8)

            ; 跳過 LEN(2) + NLEN(2) 與 payload
            #{overflow=wrap}
            p ?= p + 4 + blk-len
        }: {
            err -> _

            -> _
        }

        bfinal == 1 -> break
    }

    ; p 現在指向 Adler-32（4 bytes）
    {
        #{overflow=wrap}
        consumed ?= p + 4
    }: {
        err -> _

        -> _
    }
}
