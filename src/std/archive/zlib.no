; zlib — RFC 1950 zlib 壓縮與解壓縮（純 Nolang 實現）
;
; Git stores every loose object and every pack-object payload as a zlib
; stream: a 2-byte header, raw DEFLATE data, and a 4-byte big-endian
; Adler-32 checksum of the uncompressed data.
;
; 支援：
;   - zlib 壓縮：使用 stored blocks (BTYPE=00) 構造合法 zlib 串流
;   - zlib 解壓：支援 stored blocks 及透過 gzip.inflate-decompress 的完整 DEFLATE
;
; 用法：
;   data = fs.read-file('blob')          ; 讀取為 []byte
;   compressed = zlib-compress(data)     ; 壓縮為 zlib 格式
;   decompressed, ok = zlib-decompress(compressed)  ; 解壓 zlib 格式
;
; 演算法參考：RFC 1950 (zlib), RFC 1951 (DEFLATE)

; ═══════════════════════════════════════════════
; Adler-32 校驗和 (RFC 1950)
; ═══════════════════════════════════════════════

; adler-32: 計算 Adler-32 校驗和
;   data: 輸入資料 ([]byte)
;   n: 資料長度 (i64)
;   返回 sum: 32 位校驗和 (i64)
adler-32 = (data []byte, n i64) (sum i64) {
    MOD i64 = 65521
    a i64 = 1
    b i64 = 0
    i <- [0..n): {
        a = (a + data[i]) % MOD
        b = (b + a) % MOD
    }
    sum = ((b << 16) | a) & 4294967295
}

; ═══════════════════════════════════════════════
; zlib 壓縮
; ═══════════════════════════════════════════════

; zlib-compress: 壓縮資料為 zlib 串流
;   data: 未壓縮輸入資料 ([]byte)
;   返回 out: zlib 串流（2-byte header + DEFLATE + 4-byte Adler-32）
;
; 使用 stored blocks (BTYPE=00) 構造 zlib 串流：
;   - 2-byte zlib header (78 9c)
;   - DEFLATE stored blocks（每塊最大 65535 bytes）
;   - 4-byte big-endian Adler-32 checksum
zlib-compress = (data []byte) (out []byte) {
    result []byte

    ; zlib header: CMF=0x78 (CM=8, CINFO=7), FLG=0x9c (FCHECK, no dict)
    result.push(0x78)
    result.push(0x9c)

    ; DEFLATE 資料（stored blocks）
    deflated []byte = gzip.deflate-stored(data)
    i <- [0..deflated.len): {
        result.push(deflated[i])
    }

    ; Adler-32 checksum（big-endian 4 bytes）
    adler i64 = adler-32(data, data.len)
    result.push((adler >> 24) & 255)
    result.push((adler >> 16) & 255)
    result.push((adler >> 8) & 255)
    result.push(adler & 255)

    out = result
}

; ═══════════════════════════════════════════════
; zlib 解壓縮
; ═══════════════════════════════════════════════

; zlib-decompress: 解壓 zlib 串流
;   data: zlib 串流 ([]byte)
;   返回 out: 解壓後資料 ([]byte)
;   返回 ok: 是否成功 (bool)
;
; 支援所有 DEFLATE 區塊類型（stored, fixed Huffman, dynamic Huffman）
; 透過 gzip.inflate-decompress 進行解壓。
; 先嘗試 stored-block 掃描（快速路徑），失敗則使用 inflate 解壓。
zlib-decompress = (data []byte) (out []byte, ok bool) {
    ok = false
    data.len < 6 -> return

    ; 檢查 zlib header（應以 0x78 開頭）
    data[0] != 0x78 -> return

    ; 跳過 2-byte zlib header，取 raw DEFLATE 資料
    deflate-len i64 = data.len - 6  ; 去掉 2-byte header + 4-byte Adler-32
    deflate-data []byte
    i <- [0..deflate-len): {
        deflate-data.push(data[2 + i])
    }

    ; 預估輸出大小：100 倍輸入（上限 1MB，下限 64 bytes）
    est-out i64 = deflate-len * 100
    est-out > 1048576 -> est-out = 1048576
    est-out < 64 -> est-out = 64

    ; 使用 inflate 解壓 DEFLATE 資料
    out = gzip.inflate-decompress(deflate-data, est-out)
    ok = true
}

; ═══════════════════════════════════════════════
; 輔助函式
; ═══════════════════════════════════════════════

; zlib-decompress-stored: 僅解壓 stored-block 的 zlib 串流
;   data: 僅含 BTYPE=00 區塊的 zlib 串流 ([]byte)
;   返回 out: 解壓後資料 ([]byte)
;   返回 ok: 是否成功 (bool)，非 stored 區塊時返回 false
zlib-decompress-stored = (data []byte) (out []byte, ok bool) {
    ok = false
    data.len < 6 -> return

    p i64 = 2  ; 跳過 2-byte zlib header
    {
        p >= data.len -> break
        hdr i64 = data[p]
        bfinal i64 = hdr & 1
        btype i64 = (hdr >> 1) & 3
        btype != 0 -> return
        p = p + 1
        blk-len i64 = data[p] | (data[p + 1] << 8)
        p = p + 4  ; 跳過 LEN(2) + NLEN(2)

        ; 提取 payload
        i <- [0..blk-len): {
            out.push(data[p + i])
        }
        p = p + blk-len
        bfinal == 1 -> break
    } (true)
    ok = true
}

; zlib-consumed-stored: 計算 stored-block zlib 串流的消耗位元組數
;   data: 從偏移 0 開始的 zlib 串流 ([]byte)
;   返回 consumed: 總消耗位元組數（含 header 和 Adler-32），0 表示非 stored 區塊
zlib-consumed-stored = (data []byte) (consumed i64) {
    consumed = 0
    data.len < 6 -> return

    p i64 = 2  ; 跳過 2-byte zlib header
    {
        p >= data.len -> return
        bfinal i64 = data[p] & 1
        btype i64 = (data[p] >> 1) & 3
        btype != 0 -> return
        p = p + 1
        blk-len i64 = (data[p] & 255) | ((data[p + 1] & 255) << 8)
        p = p + 4 + blk-len
        bfinal == 1 -> break
    } (true)
    ; p 現在指向 Adler-32（4 bytes）
    consumed = p + 4
}
