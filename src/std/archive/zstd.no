; zstd — Zstandard 壓縮與解壓縮（純 Nolang 實現）
;
; 實現 Zstandard (zstd) 解壓縮演算法，包含：
;   - FSE (Finite State Entropy) 解碼
;   - Huffman 解碼
;   - LZ77 序列解碼
;   - Zstandard frame 格式解析
;
; 用法：
;   data = fs.read-file('example.zst')   ; 讀取 zst 檔案
;   decompressed = zstd-decompress(data)  ; 解壓 zstd 格式
;
; 演算法參考：
;   - Zstandard format: https://datatracker.ietf.org/doc/html/rfc8878
;   - FSE: https://github.com/Cyan4973/FiniteStateEntropy

; ═══════════════════════════════════════════════
; 位元讀取器（LSB-first，zstd 使用小端序位元）
; ═══════════════════════════════════════════════

zs-bit-reader {
    data []byte
    pos i64
    bit-buf i64
    bit-cnt i64
}

; 初始化
; data: 待解碼的壓縮位元組流（只讀不改）
; pos: 開始讀取的位元組偏移（解碼器從這裡進入位元流）
zs-bit-reader.init = (data []byte, pos i64) {
    .data = data
    .pos = pos
    .bit-buf = 0
    .bit-cnt = 0
}

; 讀取一個位元（LSB-first）
; bit: 讀出的位元（0 或 1）；資料耗盡時返回 0
; [read-bit](#zstd.zs-bit-reader.read-bit)
zs-bit-reader.read-bit = () (bit i64) {
    bit = 0
    {
        .bit-cnt == 0 -> {
            .pos < .data.len() -> {
                .bit-buf = .data[.pos]

                #{overflow=wrap}
                .pos = .pos + 1
                .bit-cnt = 8
            }
        }

        .bit-cnt > 0 -> {
            bit = .bit-buf & 1
            .bit-buf = .bit-buf >> 1

            #{overflow=wrap}
            .bit-cnt = .bit-cnt - 1
        }
    }
}

; 讀取 n 個位元（LSB-first）
; n: 要讀取的位元數（由 LSB 起逐位元拼入整數）
; v: 讀出的 n 個位元拼合而成的整數值
; [read-bits](#zstd.zs-bit-reader.read-bits)
zs-bit-reader.read-bits = (n i64) (v i64) {
    v = 0
    i <- [0..n): {
        b = .read-bit()
        v = v | (b << i)
    }
}

; 讀取變長整數（LSB-first，每 7 位元一組）
; v: 解出的整數值（每字節低 7 位有效、最高位 1 表示續讀）
; [read-varint](#zstd.zs-bit-reader.read-varint)
zs-bit-reader.read-varint = () (v i64) {
    v = 0
    shift = 0
    !! {
        b = .data[.pos]

        #{overflow=wrap}
        .pos = .pos + 1
        v = v | ((b & 0x7f) << shift)
        (b & 0x80) == 0 -> break

        #{overflow=wrap}
        shift = shift + 7
    }
}

; 對齊到下一個位元組邊界
; [align-to-byte](#zstd.zs-bit-reader.align-to-byte)
zs-bit-reader.align-to-byte = () {
    .bit-cnt = 0
}

; ═══════════════════════════════════════════════
; FSE (Finite State Entropy) 解碼表
; ═══════════════════════════════════════════════

; Zstandard 常數
ZS-MAGIC = 0xfd2fb528
ZS-WINDOW-LOG-MAX = 27
ZS-MAX-SEQ = 3
ZS-MAX-SYMBOL = 255

; fse-table: FSE 解碼表
fse-table {
    table-log i64
    table-size i64
    next-state [512]i64
    symbol [512]i64
    nb-bits [512]i64
    norm-count [256]i64
    n-symbols i64
}

; 狀態轉移表

; 符號表

; 位元數表

; 符號出現次數

; 從正規化計數建構 FSE 表
; norm-count: 各符號的正規化計數
; max-symbol: 最大符號值
; table-log: 表大小對數
; [build](#zstd.fse-table.build)
fse-table.build = (norm-count []i64, max-symbol i64, table-log i64) {
    .table-log = table-log
    .table-size = 1 << table-log

    #{overflow=wrap}
    .n-symbols = max-symbol + 1

    ; 儲存 norm-count
    i <- [0..256): {
        .norm-count[i]: {
            ok -> it = 0

            -> _
        }
    }

    i <- [0..max-symbol + 1): {
        {
            .norm-count[i] ?= norm-count[i]
        }: {
            err -> _

            -> _
        }
    }

    ; 步驟 1: 計算每個符號的起始位置
    ; 使用 "spread" 方法分配符號到表中
    #{overflow=wrap}
    step = (.table-size >> 1) + (.table-size >> 3) + 3

    #{overflow=wrap}
    mask = .table-size - 1

    ; 計算每個符號的累積計數
    positions [256]i64

    #{overflow=wrap}
    high-thresh = .table-size - 1

    ; 找到第一個負數（低機率符號）
    pos = 0

    #{overflow=wrap}
    i <- [0..max-symbol + 1): {

        ixout179c19 = norm-count[i]: {
            ok -> it

            -> _
        }

        ixout179c19 == -1 -> {
            {
                .symbol[high-thresh] ?= i

                #{overflow=wrap}
                high-thresh = high-thresh - 1
            }: {
                err -> _

                -> _
            }
        }
    }

    #{overflow=wrap}
    i <- [0..max-symbol + 1): {
        positions[i]: {
            ok -> it = pos

            -> _
        }

        nc = norm-count[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nc > 0 -> pos = pos + nc
    }

    ; 分配符號到表中
    position = 0

    #{overflow=wrap}
    i <- [0..max-symbol + 1): {
        nc = norm-count[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nc > 0 -> {
            j <- [0..nc): {

                ixout214c25 = positions[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                .symbol[ixout214c25 + j]: {
                    ok -> it = i

                    -> _
                }
            }
        }
    }

    ; 步驟 2: 建構狀態轉移表
    i <- [0..self.table-size): {
        sym = .symbol[i]

        nc = norm-count[sym]: {
            ok -> it

            -> 0
        }

        {
            #{overflow=wrap}
            .nb-bits[i] ?= table-log - bits-for-count(nc)

            nb = .nb-bits[i]

            ixout233c53 = positions[sym]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            .next-state[i] ?= (nc << nb) + (i - ixout233c53)
        }: {
            err -> _

            -> _
        }
    }
}

; 計算 count 對應的位元數
; count > 0: 返回 count 的有效位數（floor(log2(count)) + 1）
; count <= 0: 返回 0
; count: FSE 歸一化表中某符號的頻率計數
; n: count 所需的最少位元數（調用端用 tableLog - n 得該狀態的額外位元數）
; [bits-for-count](#zstd.bits-for-count)
bits-for-count = (count i64) (n i64) {
    r-count = count
    n = 0
    r-count <= 0 -> return
    (r-count > 0) {
        r-count = r-count >> 1

        #{overflow=wrap}
        n = n + 1
    }
}

; FSE 解碼一個符號
; 返回符號和新的狀態
; br: 位元讀取器，用於讀取狀態轉移到下一代所需的額外位元
; state: 當前 FSE 解碼狀態（符號表的行索引）
; sym: 當前狀態對應的符號
; new-state: 轉移到下一代後的狀態（由 next-state[state] 加上讀出的額外位元值合成）
; [decode](#zstd.fse-table.decode)
fse-table.decode = (br zs-bit-reader, state i64) (sym i64, new-state i64) {

    ; 從當前狀態讀取符號
    sym = .symbol[state]

    ; 讀取額外位元
    nb = .nb-bits[state]
    extra = br.read-bits(nb)

    ; 計算新狀態
    base = .next-state[state]

    #{overflow=wrap}
    new-state = base + extra
}

; ═══════════════════════════════════════════════
; Huffman 解碼（zstd 風格）
; ═══════════════════════════════════════════════

; zs-huffman: zstd Huffman 解碼表
zs-huffman {
    max-symbol i64
    table-log i64
    lengths [256]i64
    count [16]i64
    base [16]i64
    symbol [256]i64
}

; 碼長度

; 解碼表（簡化版：使用碼長度 + 符號映射）

; 建構 Huffman 解碼表
; lengths: 各符號的 Huffman 碼長度表（長度決定碼的分佈權重）
; max-symbol: 符號值上界（遍歷 lengths 的終點，zstd 字節符號通常為 255）
; [build](#zstd.zs-huffman.build)
zs-huffman.build = (lengths []i64, max-symbol i64) {
    .max-symbol = max-symbol
    .table-log = 0

    ; 找最大碼長度
    i <- [0..max-symbol + 1): {

        ixout308c23 = lengths[i]: {
            ok -> it

            -> _
        }

        .lengths[i]: {
            ok -> it = ixout308c23

            -> _
        }
        ixout331c16 = lengths[i]: {
            ok -> it

            -> _
        }

        ixout331c16 > .table-log -> {

            ixout312c26 = lengths[i]: {
                ok -> it

                -> _
            }

            .table-log = ixout312c26
        }
    }

    ; 計算各長度的碼數
    i <- [0..16): {
        .count[i]: {
            ok -> it = 0

            -> _
        }
    }

    #{overflow=wrap}
    i <- [0..max-symbol + 1): {
        l = lengths[i]: {
            ok -> it

            -> 0
        }

        {
            c ?= .count[l]

            #{overflow=wrap}
            .count[l] ?= c + 1
        }: {
            err -> _

            -> _
        }
    }

    ; 計算 base
    pp = 0
    i <- [0..16): {
        .base[i]: {
            ok -> it = pp

            -> _
        }

        cnt-i = .count[i]

        #{overflow=wrap}
        pp = pp + cnt-i
    }

    ; 填充 symbol 表
    tmp-base [16]i64
    i <- [0..16): {
        tmp-base[i]: {
            ok -> it = .base[i]

            -> _
        }
    }

    #{overflow=wrap}
    i <- [0..max-symbol + 1): {
        l = lengths[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        l > 0 -> {

            ixout364c21 = tmp-base[l]: {
                ok -> it

                -> _
            }

            .symbol[ixout364c21]: {
                ok -> it = i

                -> _
            }

            ixout368c28 = tmp-base[l]: {
                ok -> it

                -> _
            }

            tmp-base[l]: {
                ok -> it = ixout368c28 + 1

                -> _
            }
        }
    }
}

; 解碼一個符號
; br: 讀取碼位的位元讀取器（碼字從 MSB 端逐位元拼出）
; sym: 解出的符號值；在最大碼長內未命中任何碼時返回 0
; [decode](#zstd.zs-huffman.decode)
zs-huffman.decode = (br zs-bit-reader) (sym i64) {
    sym = 0

    ; 讀取最大碼長度位元，然後逐步縮小
    ; 簡化版：逐位元解碼
    code = 0
    len = 1
    (len <= .table-log) {
        bit = br.read-bit()
        code = (code << 1) | bit

        cnt = .count[len]

        {
            b ?= .base[len]

            #{overflow=wrap}
            code - b < cnt -> {

                #{overflow=wrap}
                v ?= .symbol[b + code - b]

                sym = v
                return
            }
        }: {
            err -> _

            -> _
        }

        #{overflow=wrap}
        len = len + 1
    }
}

; ═══════════════════════════════════════════════
; Zstandard Frame 解碼
; ═══════════════════════════════════════════════

; zs-frame: Zstandard frame 解碼狀態
zs-frame {
    data []byte
    pos i64
    out []byte
    window-size i64
    dict []byte
}

; window size

; 上一個 frame 的字典

; 讀取 frame header
; ok: magic 魔數驗證通過且 header 字段解析完整時為 true（此時 pos 已推進到首個區塊起點）
; [read-frame-header](#zstd.zs-frame.read-frame-header)
zs-frame.read-frame-header = () (ok bool) {
    ok = false
    .pos < .data.len() -> break
    hb0 = .data[.pos]: {
        ok -> it

        -> _
    }
    hb0 != 0x28 -> {

        ; magic 低字節
        break
    }

    #{overflow=wrap}
    .pos = .pos + 1
    m1 = .data[.pos]
    m1 != 0xb5 -> {
        break
    }

    #{overflow=wrap}
    .pos = .pos + 1
    m2 = .data[.pos]
    m2 != 0x2f -> {
        break
    }

    #{overflow=wrap}
    .pos = .pos + 1
    m3 = .data[.pos]
    m3 != 0xfd -> {
        break
    }

    #{overflow=wrap}
    .pos = .pos + 1

    ; Frame Header
    ; Frame_Header_Descriptor
    fhd = .data[.pos]

    #{overflow=wrap}
    .pos = .pos + 1

    ; 解析 frame header descriptor
    single-segment = (fhd & 0x20) != 0
    content-checksum = (fhd & 0x04) != 0
    dict-id-flag = fhd & 0x03
    fcs-flag = (fhd >> 6) & 0x03

    ; Window Descriptor（如果 single-segment == 0）
    .window-size = 0

    #{overflow=wrap}
    single-segment == false -> {
        wd = .data[.pos]
        .pos = .pos + 1

        ; window_size = (1 << (10 + (wd >> 3))) + (wd & 7) * (1 << (10 + (wd >> 3)))
        exponent = wd >> 3
        mantissa = wd & 7
        base = 1 << (10 + exponent)
        .window-size = base + mantissa * base
    }

    ; Dictionary ID（如果存在）
    #{overflow=wrap}
    dict-id-flag > 0 -> {
        dict-id-size = 1 << (dict-id-flag - 1)
        .pos = .pos + dict-id-size
    }

    ; Frame Content Size（如果存在）
    #{overflow=wrap}
    {
        fcs-flag == 0 -> {
            single-segment -> {
                fcs = .data[.pos]
                .pos = .pos + 1
            }
        }

        fcs-flag == 1 -> {
            lo = .data[.pos]
            hi = .data[.pos + 1]
            fcs = lo | (hi << 8)
            .pos = .pos + 2
            fcs = fcs + 256
        }

        fcs-flag == 2 -> {
            e0 = .data[.pos]
            e1 = .data[.pos + 1]
            e2 = .data[.pos + 2]
            e3 = .data[.pos + 3]
            fcs = e0 | (e1 << 8) | (e2 << 16) | (e3 << 24)
            .pos = .pos + 4
        }

        fcs-flag == 3 -> {
            fcs = .data[.pos]

            g1 = .data[.pos + 1]

            fcs = fcs | (g1 << 8)

            g2 = .data[.pos + 2]

            fcs = fcs | (g2 << 16)

            g3 = .data[.pos + 3]

            fcs = fcs | (g3 << 24)

            g4 = .data[.pos + 4]

            fcs = fcs | (g4 << 32)
            .pos = .pos + 5
        }
    }
    ok = true
}

; 解碼一個區塊（回傳 last-block ?bool：some=成功並帶是否最後區塊，nil=失敗）
; last-block: 三態結果 — ok(true) 末個區塊、ok(false) 中間區塊均解碼成功；nil 表示區塊頭不足或遇到保留區塊型別
; [decode-block](#zstd.zs-frame.decode-block)
zs-frame.decode-block = () (last-block ?bool) {
    last-block = nil

    ; 讀取 Block_Header (3 bytes)
    #{overflow=wrap}
    .pos + 3 > .data.len() -> return

    b0 = .data[.pos]

    #{overflow=wrap}
    b1 = .data[.pos + 1]

    #{overflow=wrap}
    b2 = .data[.pos + 2]

    #{overflow=wrap}
    .pos = .pos + 3

    ; 解析 block header
    last-block = (b0 & 1) != 0
    block-type = (b0 >> 1) & 3
    block-size = (b0 >> 3) | (b1 << 5) | (b2 << 13)

    ; Raw_Block (type 0)
    #{overflow=wrap}
    {
        block-type == 0 -> {

            ; 直接複製未壓縮資料
            i <- [0..block-size): {
                #{overflow=wrap}
                d ?= .data[.pos + i]

                .out.push(d)
            }

            #{overflow=wrap}
            .pos = .pos + block-size
            return
        }

        block-type == 1 -> {

            ; RLE_Block (type 1)

            ; 重複單個字節
            b = .data[.pos]
            .pos = .pos + 1
            i <- [0..block-size): {
                .out.push(b)
            }
            return
        }

        block-type == 2 -> {

            ; Compressed_Block (type 2)

            sub-ok = .decode-compressed-block(block-size)
            sub-ok == false -> last-block = nil
            return
        }
    }

    ; 保留 (type 3)
    last-block = nil
}

; 解碼壓縮區塊
; block-size: 壓縮區塊大小
; ok: 壓縮區塊的 literals 與序列段解析並展開成功時為 true（解出字節已追加到 out）
; [decode-compressed-block](#zstd.zs-frame.decode-compressed-block)
zs-frame.decode-compressed-block = (block-size i64) (ok bool) {
    ok = false

    #{overflow=wrap}
    block-end = .pos + block-size

    ; 建立位元讀取器
    br = zs-bit-reader {}
    br.init(.data, .pos)

    ; 讀取 Literals_Section
    ; 簡化處理：讀取 raw literals
    lit-type = br.read-bits(2)

    ; Raw_Literals (type 0)
    #{overflow=wrap}
    lit-type == 0 -> {

        ; 讀取 literals 大小
        lit-size-format = br.read-bits(2)
        lit-size = 0
        lit-size-format == 0 -> lit-size = br.read-bits(5)
        lit-size-format == 1 -> lit-size = br.read-bits(12)
        lit-size-format == 2 -> lit-size = br.read-bits(20)
        lit-size-format == 3 -> {

            ; 單段，size = block_size
            lit-size = block-size
        }

        ; 讀取 literals
        br.align-to-byte()
        literals []byte
        i <- [0..lit-size): {
            {
                #{overflow=wrap}
                d ?= .data[br.pos + i]

                literals.push(d)
            }: {
                err -> _

                -> _
            }
        }
        br.pos = br.pos + lit-size

        ; 讀取 Sequences_Section
        ; 簡化處理：如果沒有序列，直接輸出 literals
        br.pos >= block-end -> {
            b <- literals: {
                .out.push(b)
            }
            ok = true
            .pos = block-end
            return
        }

        ; 讀取序列數量
        seq-count = br.read-varint()

        ; 讀取序列
        ; 簡化處理：如果有序列，需要讀取 sequence tables 並解碼
        ; 這裡先輸出 literals，序列解碼待完整實現
        b1 <- literals: {
            .out.push(b1)
        }
        ok = true
        .pos = block-end
        return
    }

    ; 其他 literals 類型（RLE, Compressed, Tree）
    ; 簡化處理：跳過
    .pos = block-end
    ok = true
}

; ═══════════════════════════════════════════════
; Zstandard 解壓縮主函數
; ═══════════════════════════════════════════════

; 解壓縮 Zstandard 格式的資料
;   data: zstd 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
; [zstd-decompress](#zstd.zstd-decompress)
zstd-decompress = (data []byte) (out []byte) {
    data.len() < 4 -> return

    ; 檢查 Zstandard magic number (小端序)
    ixout722c9 = data[0]: {
        ok -> it

        -> _
    }

    ixout722c9 != 0x28 -> {
        return
    }
    ixout725c9 = data[1]: {
        ok -> it

        -> _
    }

    ixout725c9 != 0xb5 -> {
        return
    }
    ixout728c9 = data[2]: {
        ok -> it

        -> _
    }

    ixout728c9 != 0x2f -> {
        return
    }
    ixout731c9 = data[3]: {
        ok -> it

        -> _
    }

    ixout731c9 != 0xfd -> {
        return
    }

    ; 建立 frame 解碼器
    frame = zs-frame {
        data: data
        pos: 0
        window-size: 0
    }

    ; 讀取 frame header
    ok = frame.read-frame-header()
    ok == false -> return

    ; 解碼區塊
    !! {
        lb-opt = frame.decode-block()
        success = false
        last-block = false
        lb-opt: {
            ok -> {
                last-block = it
                success = true
            }

            -> success = false
        }

        success == false -> break
        last-block == true -> break
    }

    ; 複製結果
    out = frame.out
}

; ═══════════════════════════════════════════════
; Zstandard 壓縮（基本實現 — raw block）
; ═══════════════════════════════════════════════

; 使用 zstd 格式壓縮資料（基本實現）
;   data: 原始資料 ([]byte)
;   out: zstd 壓縮後的資料 ([]byte)
; 注意：目前使用 raw block 的基本實現，
;       完整 FSE + Huffman + LZ77 壓縮待後續實現。
; [zstd-compress](#zstd.zstd-compress)
zstd-compress = (data []byte) (out []byte) {

    ; Zstandard magic number (小端序)
    out.push(0x28)
    out.push(0xb5)
    out.push(0x2f)
    out.push(0xfd)

    ; Frame Header
    ; Frame_Header_Descriptor: single_segment=1, fcs_flag=1
    out.push(0xa0)

    ; Frame Content Size (1 byte, size = value + 256)
    ; 限制：data.len() <= 511 (256 + 255)
    #{overflow=wrap}
    fcs = data.len() - 256
    fcs < 0 -> fcs = 0
    out.push(fcs & 0xff)

    ; Block Header: last_block=1, block_type=0 (raw), block_size=data.len()
    block-size = data.len()
    b0 = 1 | (0 << 1) | ((block-size & 0x1f) << 3)
    b1 = (block-size >> 5) & 0xff
    b2 = (block-size >> 13) & 0xff
    out.push(b0)
    out.push(b1)
    out.push(b2)

    ; 原始資料
    raw-b <- data: {
        out.push(raw-b)
    }
    ; Content Checksum (可選，這裡跳過)
}
