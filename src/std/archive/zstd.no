; zstd — Zstandard 壓縮與解壓縮（純 Nolang 實現）
;
; 實現 Zstandard (zstd) 解壓縮演算法，包含：
;   - FSE (Finite State Entropy) 解碼
;   - Huffman 解碼
;   - LZ77 序列解碼
;   - Zstandard frame 格式解析
;
; 用法：
;   data = fs.read-file('example.zst')   ; 讀取 zst 檔案
;   decompressed = zstd-decompress(data)  ; 解壓 zstd 格式
;
; 演算法參考：
;   - Zstandard format: https://datatracker.ietf.org/doc/html/rfc8878
;   - FSE: https://github.com/Cyan4973/FiniteStateEntropy

; ═══════════════════════════════════════════════
; 位元讀取器（LSB-first，zstd 使用小端序位元）
; ═══════════════════════════════════════════════

zs-bit-reader {
    data []byte
    pos i64
    bit-buf i64
    bit-cnt i64
}

zs-bit-reader.init = (data []byte, pos i64) {
    .data = data
    .pos = pos
    .bit-buf = 0
    .bit-cnt = 0
}

; read-bit: 讀取一個位元（LSB-first）
zs-bit-reader.read-bit = () (bit i64) {
    bit = 0
    .bit-cnt == 0 -> {
        .pos < .data.len -> {
            .bit-buf = .data[.pos]
            .pos = .pos + 1
            .bit-cnt = 8
        }
    }
    .bit-cnt > 0 -> {
        bit = .bit-buf & 1
        .bit-buf = .bit-buf >> 1
        .bit-cnt = .bit-cnt - 1
    }
}

; read-bits: 讀取 n 個位元（LSB-first）
zs-bit-reader.read-bits = (n i64) (v i64) {
    v = 0
    i <- [0..n): {
        b = .read-bit()
        v = v | (b << i)
    }
}

; read-varint: 讀取變長整數（LSB-first，每 7 位元一組）
zs-bit-reader.read-varint = () (v i64) {
    v = 0
    shift = 0
    {
        b = .data[.pos]
        .pos = .pos + 1
        v = v | ((b & 0x7F) << shift)
        (b & 0x80) == 0 -> *
        shift = shift + 7
    } (true)
}

; align-to-byte: 對齊到下一個位元組邊界
zs-bit-reader.align-to-byte = () {
    .bit-cnt = 0
}

; ═══════════════════════════════════════════════
; FSE (Finite State Entropy) 解碼表
; ═══════════════════════════════════════════════

; Zstandard 常數
ZS-MAGIC = 0xFD2FB528
ZS-WINDOW-LOG-MAX = 27
ZS-MAX-SEQ = 3
ZS-MAX-SYMBOL = 255

; fse-table: FSE 解碼表
fse-table {
    table-log i64
    table-size i64
    ; 狀態轉移表
    next-state [512]i64
    ; 符號表
    symbol [512]i64
    ; 位元數表
    nb-bits [512]i64
    ; 符號出現次數
    norm-count [256]i64
    n-symbols i64
}

; build: 從正規化計數建構 FSE 表
; norm-count: 各符號的正規化計數
; max-symbol: 最大符號值
; table-log: 表大小對數
fse-table.build = (norm-count []i64, max-symbol i64, table-log i64) {
    .table-log = table-log
    .table-size = 1 << table-log
    .n-symbols = max-symbol + 1

    ; 儲存 norm-count
    i <- [0..256): {
        .norm-count[i] = 0
    }
    i <- [0..max-symbol + 1): {
        .norm-count[i] = norm-count[i]
    }

    ; 步驟 1: 計算每個符號的起始位置
    ; 使用 "spread" 方法分配符號到表中
    step = (.table-size >> 1) + (.table-size >> 3) + 3
    mask = .table-size - 1

    ; 計算每個符號的累積計數
    positions [256]i64
    high-thresh = .table-size - 1

    ; 找到第一個負數（低機率符號）
    pos = 0
    i <- [0..max-symbol + 1): {
        norm-count[i] == -1 -> {
            .symbol[high-thresh] = i
            high-thresh = high-thresh - 1
        }
    }

    i <- [0..max-symbol + 1): {
        positions[i] = pos
        nc = norm-count[i]
        nc > 0 -> {
            pos = pos + nc
        }
    }

    ; 分配符號到表中
    position = 0
    i <- [0..max-symbol + 1): {
        nc = norm-count[i]
        nc > 0 -> {
            j <- [0..nc): {
                .symbol[positions[i] + j] = i
            }
        }
    }

    ; 步驟 2: 建構狀態轉移表
    i <- [0...table-size): {
        sym = .symbol[i]
        nc = norm-count[sym]
        .nb-bits[i] = table-log - bits-for-count(nc)
        .next-state[i] = (nc << .nb-bits[i]) + (i - positions[sym])
    }
}

; bits-for-count: 計算 count 對應的位元數
; count > 0: 返回 tableLog - floor(log2(count))
; count <= 0: 返回 tableLog
bits-for-count = (count i64) (n i64) {
    n = 0
    count <= 0 -> return
    {
        count = count >> 1
        n = n + 1
    } (count > 0)
}

; decode: FSE 解碼一個符號
; 返回符號和新的狀態
fse-table.decode = (br zs-bit-reader, state i64) (sym i64, new-state i64) {
    ; 從當前狀態讀取符號
    sym = .symbol[state]

    ; 讀取額外位元
    nb = .nb-bits[state]
    extra = br.read-bits(nb)

    ; 計算新狀態
    base = .next-state[state]
    new-state = base + extra
}

; ═══════════════════════════════════════════════
; Huffman 解碼（zstd 風格）
; ═══════════════════════════════════════════════

; zs-huffman: zstd Huffman 解碼表
zs-huffman {
    max-symbol i64
    table-log i64
    ; 碼長度
    lengths [256]i64
    ; 解碼表（簡化版：使用碼長度 + 符號映射）
    count [16]i64
    base [16]i64
    symbol [256]i64
}

; build: 建構 Huffman 解碼表
zs-huffman.build = (lengths []i64, max-symbol i64) {
    .max-symbol = max-symbol
    .table-log = 0

    ; 找最大碼長度
    i <- [0..max-symbol + 1): {
        .lengths[i] = lengths[i]
        lengths[i] > .table-log -> .table-log = lengths[i]
    }

    ; 計算各長度的碼數
    i <- [0..16): {
        .count[i] = 0
    }
    i <- [0..max-symbol + 1): {
        l = lengths[i]
        .count[l] = .count[l] + 1
    }

    ; 計算 base
    pp = 0
    i <- [0..16): {
        .base[i] = pp
        pp = pp + .count[i]
    }

    ; 填充 symbol 表
    tmp-base [16]i64
    i <- [0..16): {
        tmp-base[i] = .base[i]
    }
    i <- [0..max-symbol + 1): {
        l = lengths[i]
        l > 0 -> {
            .symbol[tmp-base[l]] = i
            tmp-base[l] = tmp-base[l] + 1
        }
    }
}

; decode: 解碼一個符號
zs-huffman.decode = (br zs-bit-reader) (sym i64) {
    sym = 0
    ; 讀取最大碼長度位元，然後逐步縮小
    ; 簡化版：逐位元解碼
    code = 0
    len = 1
    {
        bit = br.read-bit()
        code = (code << 1) | bit
        cnt = .count[len]
        code - .base[len] < cnt -> {
            sym = .symbol[.base[len] + code - .base[len]]
            return
        }
        len = len + 1
    } (len <= .table-log)
}

; ═══════════════════════════════════════════════
; Zstandard Frame 解碼
; ═══════════════════════════════════════════════

; zs-frame: Zstandard frame 解碼狀態
zs-frame {
    data []byte
    pos i64
    out []byte
    ; window size
    window-size i64
    ; 上一個 frame 的字典
    dict []byte
}

; read-frame-header: 讀取 frame header
zs-frame.read-frame-header = () (ok bool) {
    ok = false
    .pos < .data.len -> *
    .data[.pos] != 0x28 -> *  ; magic 低字節
    .pos = .pos + 1
    .data[.pos] != 0xB5 -> *
    .pos = .pos + 1
    .data[.pos] != 0x2F -> *
    .pos = .pos + 1
    .data[.pos] != 0xFD -> *
    .pos = .pos + 1

    ; Frame Header
    ; Frame_Header_Descriptor
    fhd = .data[.pos]
    .pos = .pos + 1

    ; 解析 frame header descriptor
    single-segment = (fhd & 0x20) != 0
    content-checksum = (fhd & 0x04) != 0
    dict-id-flag = fhd & 0x03
    fcs-flag = (fhd >> 6) & 0x03

    ; Window Descriptor（如果 single-segment == 0）
    .window-size = 0
    single-segment == false -> {
        wd = .data[.pos]
        .pos = .pos + 1
        ; window_size = (1 << (10 + (wd >> 3))) + (wd & 7) * (1 << (10 + (wd >> 3)))
        exponent = wd >> 3
        mantissa = wd & 7
        base = 1 << (10 + exponent)
        .window-size = base + mantissa * base
    }

    ; Dictionary ID（如果存在）
    dict-id-flag > 0 -> {
        dict-id-size = 1 << (dict-id-flag - 1)
        .pos = .pos + dict-id-size
    }

    ; Frame Content Size（如果存在）
    fcs-flag == 0 -> {
        single-segment -> {
            fcs = .data[.pos]
            .pos = .pos + 1
        }
    }
    fcs-flag == 1 -> {
        fcs = .data[.pos] | (.data[.pos + 1] << 8)
        .pos = .pos + 2
        fcs = fcs + 256
    }
    fcs-flag == 2 -> {
        fcs = .data[.pos] | (.data[.pos + 1] << 8) | (.data[.pos + 2] << 16) | (.data[.pos + 3] << 24)
        .pos = .pos + 4
    }
    fcs-flag == 3 -> {
        fcs = .data[.pos]
        fcs = fcs | (.data[.pos + 1] << 8)
        fcs = fcs | (.data[.pos + 2] << 16)
        fcs = fcs | (.data[.pos + 3] << 24)
        fcs = fcs | (.data[.pos + 4] << 32)
        .pos = .pos + 5
    }

    ok = true
}

; decode-block: 解碼一個區塊
zs-frame.decode-block = () (last-block bool, ok bool) {
    last-block = false
    ok = false

    ; 讀取 Block_Header (3 bytes)
    .pos + 3 > .data.len -> return

    b0 = .data[.pos]
    b1 = .data[.pos + 1]
    b2 = .data[.pos + 2]
    .pos = .pos + 3

    ; 解析 block header
    last-block = (b0 & 1) != 0
    block-type = (b0 >> 1) & 3
    block-size = (b0 >> 3) | (b1 << 5) | (b2 << 13)

    ; Raw_Block (type 0)
    block-type == 0 -> {
        ; 直接複製未壓縮資料
        i <- [0..block-size): {
            .out.push(.data[.pos + i])
        }
        .pos = .pos + block-size
        ok = true
        return
    }

    ; RLE_Block (type 1)
    block-type == 1 -> {
        ; 重複單個字節
        b = .data[.pos]
        .pos = .pos + 1
        i <- [0..block-size): {
            .out.push(b)
        }
        ok = true
        return
    }

    ; Compressed_Block (type 2)
    block-type == 2 -> {
        ok = .decode-compressed-block(block-size)
        return
    }

    ; 保留 (type 3)
    ok = false
}

; decode-compressed-block: 解碼壓縮區塊
; block-size: 壓縮區塊大小
zs-frame.decode-compressed-block = (block-size i64) (ok bool) {
    ok = false
    block-end = .pos + block-size

    ; 建立位元讀取器
    br = zs-bit-reader{}
    br.init(.data, .pos)

    ; 讀取 Literals_Section
    ; 簡化處理：讀取 raw literals
    lit-type = br.read-bits(2)

    ; Raw_Literals (type 0)
    lit-type == 0 -> {
        ; 讀取 literals 大小
        lit-size-format = br.read-bits(2)
        lit-size = 0
        lit-size-format == 0 -> lit-size = br.read-bits(5)
        lit-size-format == 1 -> lit-size = br.read-bits(12)
        lit-size-format == 2 -> lit-size = br.read-bits(20)
        lit-size-format == 3 -> {
            ; 單段，size = block_size
            lit-size = block-size
        }

        ; 讀取 literals
        br.align-to-byte()
        literals []byte
        i <- [0..lit-size): {
            literals.push(.data[br.pos + i])
        }
        br.pos = br.pos + lit-size

        ; 讀取 Sequences_Section
        ; 簡化處理：如果沒有序列，直接輸出 literals
        br.pos >= block-end -> {
            i <- [0..literals.len): {
                .out.push(literals[i])
            }
            ok = true
            .pos = block-end
            return
        }

        ; 讀取序列數量
        seq-count = br.read-varint()

        ; 讀取序列
        ; 簡化處理：如果有序列，需要讀取 sequence tables 並解碼
        ; 這裡先輸出 literals，序列解碼待完整實現
        i <- [0..literals.len): {
            .out.push(literals[i])
        }

        ok = true
        .pos = block-end
        return
    }

    ; 其他 literals 類型（RLE, Compressed, Tree）
    ; 簡化處理：跳過
    .pos = block-end
    ok = true
}

; ═══════════════════════════════════════════════
; Zstandard 解壓縮主函數
; ═══════════════════════════════════════════════

; zstd-decompress: 解壓縮 Zstandard 格式的資料
;   data: zstd 壓縮資料 ([]byte)
;   out: 解壓後的資料 ([]byte)
zstd-decompress = (data []byte) (out []byte) {
    data.len < 4 -> return

    ; 檢查 Zstandard magic number (小端序)
    data[0] != 0x28 -> return
    data[1] != 0xB5 -> return
    data[2] != 0x2F -> return
    data[3] != 0xFD -> return

    ; 建立 frame 解碼器
    frame = zs-frame{
        data: data
        pos: 0
        window-size: 0
    }
    frame.out []byte
    frame.dict []byte

    ; 讀取 frame header
    ok = frame.read-frame-header()
    ok == false -> return

    ; 解碼區塊
    {
        last-block, success = frame.decode-block()

        success == false -> *

        last-block == true -> *
    } (true)

    ; 複製結果
    out = frame.out
}

; ═══════════════════════════════════════════════
; Zstandard 壓縮（基本實現 — raw block）
; ═══════════════════════════════════════════════

; zstd-compress: 使用 zstd 格式壓縮資料（基本實現）
;   data: 原始資料 ([]byte)
;   out: zstd 壓縮後的資料 ([]byte)
; 注意：目前使用 raw block 的基本實現，
;       完整 FSE + Huffman + LZ77 壓縮待後續實現。
zstd-compress = (data []byte) (out []byte) {
    ; Zstandard magic number (小端序)
    out.push(0x28)
    out.push(0xB5)
    out.push(0x2F)
    out.push(0xFD)

    ; Frame Header
    ; Frame_Header_Descriptor: single_segment=1, fcs_flag=1
    out.push(0xA0)

    ; Frame Content Size (1 byte, size = value + 256)
    ; 限制：data.len <= 511 (256 + 255)
    fcs = data.len - 256
    fcs < 0 -> fcs = 0
    out.push(fcs & 0xFF)

    ; Block Header: last_block=1, block_type=0 (raw), block_size=data.len
    block-size = data.len
    b0 = 1 | (0 << 1) | ((block-size & 0x1F) << 3)
    b1 = (block-size >> 5) & 0xFF
    b2 = (block-size >> 13) & 0xFF
    out.push(b0)
    out.push(b1)
    out.push(b2)

    ; 原始資料
    i <- [0..data.len): {
        out.push(data[i])
    }

    ; Content Checksum (可選，這裡跳過)
}
