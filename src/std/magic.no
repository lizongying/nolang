; magic — 簡化版檔案類型檢測
;
; 基於擴展名與魔數（magic bytes）判斷檔案類型，不依賴 libmagic。
; 優先順序：先檢查擴展名，再檢查魔數。
;
; 用法：
;   kind = magic.detect-type('/path/to/file')
;   print(kind)

; ═══════════════════════════════════════════════
; 主入口
; ═══════════════════════════════════════════════

; detect-type: 檢測檔案類型
; path: 檔案路徑
; 返回類型描述字串（如 'PNG image'、'ELF executable'、'ASCII text'、'directory'、'unknown'）
detect-type = (path str) (kind str) {
    kind = 'unknown'

    ; 先檢查是否為目錄
    is-d = fs.is-dir(path)
    is-d -> {
        kind = 'directory'
        return
    }

    ; 檢查是否為普通檔案
    is-f = fs.is-file(path)
    is-f == false -> {
        kind = 'unknown (not found)'
        return
    }

    ; 1. 基於擴展名判斷
    ext = get-extension(path)
    ext-kind = detect-by-extension(ext)
    ext-kind.len > 0 -> {
        kind = ext-kind
        return
    }

    ; 2. 基於魔數判斷
    magic-kind = detect-by-magic(path)
    magic-kind.len > 0 -> {
        kind = magic-kind
        return
    }

    ; 3. 預設為資料檔案
    kind = 'data'
}

; ═══════════════════════════════════════════════
; 輔助函數
; ═══════════════════════════════════════════════

; get-extension: 取得檔案副檔名（小寫）
; path: 檔案路徑
; 返回副檔名（不含 '.'），無副檔名返回空串
get-extension = (path str) (ext str) {
    n = path.len
    i = n - 1
    {
        i < 0 -> return
        c = path[i]
        c == 47 -> return  ; '/' - 目錄分隔符，停止查找
        c == 46 -> {  ; '.' - 找到副檔名
            ext = path.slice(i + 1, n)
            ext = ext.to-lower()
            return
        }
        i = i - 1
    } (i >= 0)
}

; detect-by-extension: 基於副檔名判斷類型
; ext: 副檔名（小寫）
; 返回類型描述，未知返回空串
detect-by-extension = (ext str) (kind str) {
    {
        ext == 'txt' -> kind = 'ASCII text'
        ext == 'md' -> kind = 'Markdown text'
        ext == 'json' -> kind = 'JSON data'
        ext == 'xml' -> kind = 'XML document'
        ext == 'csv' -> kind = 'CSV data'
        ext == 'html' || ext == 'htm' -> kind = 'HTML document'
        ext == 'css' -> kind = 'CSS stylesheet'
        ext == 'js' -> kind = 'JavaScript source'
        ext == 'ts' -> kind = 'TypeScript source'
        ext == 'no' -> kind = 'Nolang source'
        ext == 'go' -> kind = 'Go source'
        ext == 'py' -> kind = 'Python source'
        ext == 'sh' -> kind = 'Shell script'
        ext == 'c' -> kind = 'C source'
        ext == 'h' -> kind = 'C header'
        ext == 'cpp' || ext == 'cc' -> kind = 'C++ source'
        ext == 'hpp' -> kind = 'C++ header'
        ext == 'rs' -> kind = 'Rust source'
        ext == 'java' -> kind = 'Java source'
        ext == 'png' -> kind = 'PNG image'
        ext == 'jpg' || ext == 'jpeg' -> kind = 'JPEG image'
        ext == 'gif' -> kind = 'GIF image'
        ext == 'bmp' -> kind = 'BMP image'
        ext == 'svg' -> kind = 'SVG image'
        ext == 'ico' -> kind = 'ICO image'
        ext == 'pdf' -> kind = 'PDF document'
        ext == 'zip' -> kind = 'Zip archive'
        ext == 'gz' -> kind = 'Gzip compressed'
        ext == 'tar' -> kind = 'Tar archive'
        ext == 'bz2' -> kind = 'Bzip2 compressed'
        ext == 'xz' -> kind = 'XZ compressed'
        ext == '7z' -> kind = '7-Zip archive'
        ext == 'rar' -> kind = 'RAR archive'
        ext == 'wav' -> kind = 'WAV audio'
        ext == 'mp3' -> kind = 'MP3 audio'
        ext == 'mp4' -> kind = 'MP4 video'
        ext == 'avi' -> kind = 'AVI video'
        ext == 'mkv' -> kind = 'MKV video'
        ext == 'exe' -> kind = 'Windows executable'
        ext == 'dll' -> kind = 'Windows DLL'
        ext == 'so' -> kind = 'Shared library'
        ext == 'dylib' -> kind = 'macOS shared library'
        ext == 'o' -> kind = 'Object file'
        ext == 'a' -> kind = 'Static library'
        ext == 'wasm' -> kind = 'WebAssembly module'
        ext == 'yaml' || ext == 'yml' -> kind = 'YAML document'
        ext == 'toml' -> kind = 'TOML document'
        ext == 'ini' -> kind = 'INI configuration'
        ext == 'conf' -> kind = 'Configuration file'
        ext == 'log' -> kind = 'Log file'
        ext == 'lock' -> kind = 'Lock file'
        -> kind = ''
    }
}

; detect-by-magic: 基於魔數判斷類型
; path: 檔案路徑
; 返回類型描述，未知返回空串
detect-by-magic = (path str) (kind str) {
    kind = ''

    ; 開啟檔案讀取前 64 字節
    fd = fs.open-read(path)
    fd < 0 -> return

    ; 讀取魔數（使用 with-len 確保可安全索引）
    buf str = with-len(64)
    n = fs.read(fd, buf, 64)
    fs.close(fd)

    n < 4 -> return  ; 至少需要 4 字節才能判斷

    ; 取得前 4 個位元組
    b0 = buf[0]
    b1 = buf[1]
    b2 = buf[2]
    b3 = buf[3]

    {
        ; PNG: 89 50 4E 47 (\x89PNG)
        b0 == 137 && b1 == 80 && b2 == 78 && b3 == 71 -> {
            kind = 'PNG image'
            return
        }
        ; JPEG: FF D8 FF
        b0 == 255 && b1 == 216 && b2 == 255 -> {
            kind = 'JPEG image'
            return
        }
        ; GIF: 47 49 46 38 (GIF8)
        b0 == 71 && b1 == 73 && b2 == 70 && b3 == 56 -> {
            kind = 'GIF image'
            return
        }
        ; BMP: 42 4D (BM)
        b0 == 66 && b1 == 77 -> {
            kind = 'BMP image'
            return
        }
        ; PDF: 25 50 44 46 (%PDF)
        b0 == 37 && b1 == 80 && b2 == 68 && b3 == 70 -> {
            kind = 'PDF document'
            return
        }
        ; ZIP: 50 4B 03 04 (PK\x03\x04)
        b0 == 80 && b1 == 75 && b2 == 3 && b3 == 4 -> {
            kind = 'Zip archive'
            return
        }
        ; GZIP: 1F 8B
        b0 == 31 && b1 == 139 -> {
            kind = 'Gzip compressed'
            return
        }
        ; ELF: 7F 45 4C 46 (\x7fELF)
        b0 == 127 && b1 == 69 && b2 == 76 && b3 == 70 -> {
            kind = 'ELF executable'
            return
        }
        ; Mach-O 64-bit LE: CF FA ED FE
        b0 == 207 && b1 == 250 && b2 == 237 && b3 == 254 -> {
            kind = 'Mach-O 64-bit executable'
            return
        }
        ; Mach-O 32-bit BE: FE ED FA CE
        b0 == 254 && b1 == 237 && b2 == 250 && b3 == 206 -> {
            kind = 'Mach-O executable'
            return
        }
        ; Mach-O 64-bit BE: FE ED FA CF
        b0 == 254 && b1 == 237 && b2 == 250 && b3 == 207 -> {
            kind = 'Mach-O 64-bit executable'
            return
        }
        ; Mach-O 32-bit LE: CE FA ED FE
        b0 == 206 && b1 == 250 && b2 == 237 && b3 == 254 -> {
            kind = 'Mach-O executable'
            return
        }
        ; PE/COFF: 4D 5A (MZ)
        b0 == 77 && b1 == 90 -> {
            kind = 'PE executable'
            return
        }
        ; WebAssembly: 00 61 73 6D (\0asm)
        b0 == 0 && b1 == 97 && b2 == 115 && b3 == 109 -> {
            kind = 'WebAssembly module'
            return
        }
        ; Bzip2: 42 5A 68 (BZh)
        b0 == 66 && b1 == 90 && b2 == 104 -> {
            kind = 'Bzip2 compressed'
            return
        }
        ; XZ: FD 37 7A 58 5A 00
        b0 == 253 && b1 == 55 && b2 == 122 && b3 == 88 -> {
            kind = 'XZ compressed'
            return
        }
        ; RAR: 52 61 72 21 (Rar!)
        b0 == 82 && b1 == 97 && b2 == 114 && b3 == 33 -> {
            kind = 'RAR archive'
            return
        }
        ; 7-Zip: 37 7A BC AF 27 1C
        b0 == 55 && b1 == 122 && b2 == 188 && b3 == 175 -> {
            kind = '7-Zip archive'
            return
        }
        ; WAV: 52 49 46 46 (RIFF) + offset 8: 57 41 56 45 (WAVE)
        b0 == 82 && b1 == 73 && b2 == 70 && b3 == 70 -> {
            n >= 12 -> {
                w4 = buf[8]
                w5 = buf[9]
                w6 = buf[10]
                w7 = buf[11]
                w4 == 87 && w5 == 65 && w6 == 86 && w7 == 69 -> {
                    kind = 'WAV audio'
                    return
                }
            }
            kind = 'RIFF container'
            return
        }
        ; MP3 ID3: 49 44 33 (ID3)
        b0 == 73 && b1 == 68 && b2 == 33 -> {
            kind = 'MP3 audio'
            return
        }
        ; MP3 frame sync: FF FB or FF F3 or FF F2
        b0 == 255 && (b1 == 251 || b1 == 243 || b1 == 242) -> {
            kind = 'MP3 audio'
            return
        }
        -> kind = ''
    }
}
