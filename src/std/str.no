; str — 字符串操作标准库
;
; str 是对外统一的字符串类型
; 内部实现：str-long（堆分配）
;
; 切片是視圖，非獨立類型：對 str 進行切片操作（如 s[1..3]）仍產生 str 視圖，
; 共享 str 的底層記憶體，不複製資料。
; 因此 str 的所有方法（to-upper、to-lower、index、contains、slice、copy、fill 等）
; 均適用於 str 的切片視圖。通過切片修改元素會影響原始 str。
;
; str {
;     len i64 read-only       // 对外：i64 长度
;     cap i64 read-only       // 对外：i64 容量（仅 str-long 有效）
;     data *byte sealed       // 对外：数据指针
; }

; ═══════════════════════════════════════════════
; 基础操作
; ═══════════════════════════════════════════════

; str.len: 返回字符串长度
str.len = () (n i64) {
    n = .len
}

; str.cap: 返回字符串容量（内置字段访问，s.cap 直接可用）
; 返回堆缓冲区容量
; build-in
; str.cap = () (n int64) {
;    n = .cap
; }

; str[n]: 返回指定位置的字节值
; build-in
; str[n] = (i i64) (c byte) {
;     c = s[i]
; }

; str.eq: 比较两个字符串的前 n 个字节是否相等
; 返回 true=相等, false=不相等
; build-in (ForwardFunc: eq-raw)
; str.eq = (b str, n i64) (eq bool) { ... }

; str.copy: 将 src 复制到 dst（整個字串）
str.copy = () (dst str) {
    dst = with-cap(.len)
    i <- [0...len): {
        dst[i] = .[i]
    }
}

; str.fill: 用 byte 值填充整個字串
str.fill = (val byte) {
    i <- [0...len): {
        .[i] = val
    }
}

; ═══════════════════════════════════════════════
; UTF-8 解碼公共函數
; ═══════════════════════════════════════════════

; str.decode-cp: 從位置 i 解碼一個 UTF-8 碼點
; 返回 cp=碼點值, clen=序列位元組長度（1~4）
str.decode-cp = (i i64) (cp i64, clen i64) {
    b = .[i]
    cp = b
    clen = 1
    {
        b < 0x80 -> {
            cp = b
            clen = 1
        }
        b < 0xe0 -> {
            cp = ((b & 0x1f) << 6) | (.[i + 1] & 0x3f)
            clen = 2
        }
        b < 0xf0 -> {
            cp = ((b & 0x0f) << 12) | ((.[i + 1] & 0x3f) << 6) | (.[i + 2] & 0x3f)
            clen = 3
        }
        -> {
            cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3f) << 12) | ((.[i + 2] & 0x3f) << 6) | (.[i + 3] & 0x3f)
            clen = 4
        }
    }
}

; ═══════════════════════════════════════════════
; 查找
; ═══════════════════════════════════════════════

; str.index: 在 s 中查找 target 子串
; 使用 Sunday 算法，平均 O(n/m)，最壞 O(n*m)
; 返回首次出現的位置，未找到返回 -1
str.index = (target str) (pos i64) {
    pos = -1
    target.len == 0 -> {
        pos = 0
        return
    }
    n = .len
    m = target.len
    n < m -> return
    limit = n - m
    i <- [0..limit]: {
        matched = 1
        j <- [0..m): {
            .[i + j] != target[j] -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
    }
}

; str.index-from: 在 s 中從 from 位置開始查找 target 子串
; 使用 Sunday 算法
; 返回首次出現的位置，未找到返回 -1
str.index-from = (target str, from i64) (pos i64) {
    pos = -1
    from < 0 -> from = 0
    target.len == 0 -> {
        from <= .len -> pos = from
        return
    }
    n = .len
    m = target.len
    n < m -> return
    limit = n - m
    from > limit -> return
    i <- [from..limit]: {
        matched = 1
        j <- [0..m): {
            .[i + j] != target[j] -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
    }
}

; str.contains: 判断 s 是否包含 target 子串
; 返回 true=包含, false=不包含
str.contains = (target str) (yes bool) {
    pos = .index(target)
    pos >= 0 -> yes = true
}

; str.starts-with: 判断 s 是否以 target 开头
; 返回 true=是, false=否
str.starts-with = (target str) (yes bool) {
    yes = true
    target.len > .len -> {
        yes = false
        return
    }
    i <- [0..target.len): {
        si = .[i]
        ti = target[i]
        si != ti -> {
            yes = false
            return
        }
    }
}

; str.ends-with: 判断 s 是否以 target 结尾
; 返回 true=是, false=否
str.ends-with = (target str) (yes bool) {
    yes = true
    target.len > .len -> {
        yes = false
        return
    }
    off = .len - target.len
    i <- [0..target.len): {
        si = .[off + i]
        ti = target[i]
        si != ti -> {
            yes = false
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 转换
; ═══════════════════════════════════════════════

; str.to-upper: 将字符串转为大写
; 返回新字符串
str.to-upper = () (val str) {
    val = with-cap(.len)
    i <- [0...len): {
        c = .[i]
        {
            c >= 97 && c <= 122 -> val[i] = c - 32
            -> val[i] = c
        }
    }
}

; str.to-lower: 将字符串转为小写
; 返回新字符串
str.to-lower = () (val str) {
    val = with-cap(.len)
    i <- [0...len): {
        c = .[i]
        {
            c >= 65 && c <= 90 -> val[i] = c + 32
            -> val[i] = c
        }
    }
}

; str.trim: 去除字符串首尾空白字符
; 返回新字符串
str.trim = () (val str) {
    start <- [0...len): {
        c = .[start]
        c != 32 && c != 9 && c != 10 && c != 13 -> break
    }
    end = .len - 1
    {
        c = .[end]
        c != 32 && c != 9 && c != 10 && c != 13 -> break
        end = end - 1
    } (end >= start)
    n = end - start + 1
    n < 0 -> return
    val = with-cap(n)
    i <- [0..n): {
        val[i] = .[start + i]
    }
}

; ═══════════════════════════════════════════════
; 重复与切片
; ═══════════════════════════════════════════════

; str.repeat: 将字符串重复 times 次
; 返回新字符串
str.repeat = (times i64) (val str) {
    val = with-cap(.len * times)
    i <- [0..times): {
        j <- [0...len): {
            val[i * .len + j] = .[j]
        }
    }
}

; str.slice: 截取子串 [start, end)
; 返回新字符串
str.slice = (start i64, end i64) (val str) {
    start < 0 -> start = 0
    end > .len -> end = .len
    start >= end -> return
    n = end - start
    val = with-cap(n)
    i <- [0..n): {
        val[i] = .[start + i]
    }
}

; ═══════════════════════════════════════════════
; 类型转换
; ═══════════════════════════════════════════════

; str.to-bytes: 将字符串转为字节数组
str.to-bytes = () (val []byte) {
    val = with-len(.len)
    i <- [0...len): {
        val[i] = .[i]
    }
}

; str.to-i64: 將字串解析為有號 64 位整數
; 返回 Option：
;   ok(n) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或格式錯誤
str.to-i64 = () (val ?i64) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    neg = 0
    c = .[0]
    {
        c == 45 -> {
            neg = 1
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone minus')
                return
            }
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    limit = 922337203685477580
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        d = c - 48
        n > limit -> {
            val = err('out of range for i64')
            return
        }
        n == limit -> {
            neg == 1 -> {
                ; 允許 i64.MIN: -9223372036854775808
                d > 8 -> {
                    val = err('out of range for i64')
                    return
                }
                d == 8 -> {
                    ; 特殊處理 i64.MIN，避免溢出
                    ; 必須是最後一位數字
                    i == .len - 1 -> {
                        n = 0 - 922337203685477580
                        n = n * 10 - 8
                        val = n
                        return
                    }
                    -> {
                        val = err('out of range for i64')
                        return
                    }
                }
            }
            d > 7 -> {
                val = err('out of range for i64')
                return
            }
        }
        n = n * 10 + d
    }
    neg == 1 -> n = 0 - n
    val = n
}

; str.to-i8: 將字串解析為 i8
; 返回 Option：
;   ok(n) - 成功（-128 ~ 127）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i8 = () (val ?i8) {
    v = .to-i64()
    v: {
        err -> val = err(it)
        nil -> return
        ok -> {
            n = it
            n >= 0 - 128 && n <= 127 -> val = n
            -> val = err('out of range for i8')
        }
    }
}

; str.to-i16: 將字串解析為 i16
; 返回 Option：
;   ok(n) - 成功（-32768 ~ 32767）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i16 = () (val ?i16) {
    v = .to-i64()
    v: {
        err -> val = err(it)
        nil -> return
        ok -> {
            n = it
            n >= 0 - 32768 && n <= 32767 -> val = n
            -> val = err('out of range for i16')
        }
    }
}

; str.to-i32: 將字串解析為 i32
; 返回 Option：
;   ok(n) - 成功（-2147483648 ~ 2147483647）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i32 = () (val ?i32) {
    v = .to-i64()
    v: {
        err -> val = err(it)
        nil -> return
        ok -> {
            n = it
            n >= 0 - 2147483648 && n <= 2147483647 -> val = n
            -> val = err('out of range for i32')
        }
    }
}

; str.to-u8: 將字串解析為 u8
; 返回 Option：
;   ok(n) - 成功（0 ~ 255）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u8 = () (val ?u8) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .[0]
    {
        c == 45 -> {
            val = err('invalid u8: negative sign not allowed')
            return
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n
        -> val = err('out of range for u8')
    }
}

; str.to-u16: 將字串解析為 u16
; 返回 Option：
;   ok(n) - 成功（0 ~ 65535）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u16 = () (val ?u16) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .[0]
    {
        c == 45 -> {
            val = err('invalid u16: negative sign not allowed')
            return
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 65535 -> val = n
        -> val = err('out of range for u16')
    }
}

; str.to-u32: 將字串解析為 u32
; 返回 Option：
;   ok(n) - 成功（0 ~ 4294967295）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u32 = () (val ?u32) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .[0]
    {
        c == 45 -> {
            val = err('invalid u32: negative sign not allowed')
            return
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 4294967295 -> val = n
        -> val = err('out of range for u32')
    }
}

; str.to-u64: 將字串解析為 u64
; 拒絕負號；不檢查 i64 範圍溢位（截斷由 LLVM 自動處理）
str.to-u64 = () (val ?u64) {
    .len == 0 -> {
        val = nil
        return
    }
    c = .[0]
    c == 45 -> {
        val = err('invalid u64: negative sign not allowed')
        return
    }
    n = 0
    start = 0
    c == 43 -> start = 1
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    val = n
}

; str.to-byte: 將字串解析為 byte（與 u8 等價）
; 返回 Option：
;   ok(n) - 成功（0 ~ 255）
;   nil    - 空字串
;   err('msg') - 含非數字字元、負號或超出範圍
str.to-byte = () (val ?byte) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .[0]
    {
        c == 45 -> {
            val = err('invalid byte: negative sign not allowed')
            return
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n
        -> val = err('out of range for byte')
    }
}

; str-to-f64: 將字串解析為 f64（底層實作）
; 支援格式：[空白][+-][數字][.數字][eE[+-]數字]
; 空字串或無數字回傳 0.0
str-to-f64 = (s str) (result f64) {
    n i64 = s.len
    n == 0 -> return
    i i64 = 0
    sign f64 = 1.0
    int-part f64 = 0.0
    frac-part f64 = 0.0
    frac-div f64 = 1.0
    exp i64 = 0
    exp-sign i64 = 1
    has-digit i64 = 0
    c i64 = 0

    ; 跳過前導空白
    {
        c = s[i]
        {
            c == 32 || c == 9 || c == 10 || c == 13 -> i = i + 1
            -> break
        }
    } (i < n)
    i >= n -> return

    ; 處理正負號
    c = s[i]
    {
        c == 45 -> {
            sign = -1.0
            i = i + 1
        }
        c == 43 -> i = i + 1
    }

    ; 解析整數部分
    {
        c = s[i]
        {
            c >= 48 && c <= 57 -> {
                int-part = int-part * 10.0 + number.i64-to-f64(c - 48)
                has-digit = 1
                i = i + 1
            }
            -> break
        }
    } (i < n)

    ; 解析小數部分
    i < n -> {
        c = s[i]
        c == 46 -> {
            i = i + 1
            {
                c = s[i]
                {
                    c >= 48 && c <= 57 -> {
                        frac-part = frac-part * 10.0 + number.i64-to-f64(c - 48)
                        frac-div = frac-div * 10.0
                        has-digit = 1
                        i = i + 1
                    }
                    -> break
                }
            } (i < n)
        }
    }
    has-digit == 0 -> return

    ; 解析指數部分
    i < n -> {
        c = s[i]
        c == 101 || c == 69 -> {
            i = i + 1
            i < n -> {
                c = s[i]
                c == 45 -> {
                    exp-sign = -1
                    i = i + 1
                }
                c == 43 -> i = i + 1
            }
            {
                c = s[i]
                {
                    c >= 48 && c <= 57 -> {
                        exp = exp * 10 + (c - 48)
                        i = i + 1
                    }
                    -> break
                }
            } (i < n)
        }
    }

    ; 合併結果：result = sign * (int-part + frac-part / frac-div) * 10^(exp-sign * exp)
    result = int-part + frac-part / frac-div
    exp != 0 -> {

        ; 以迴圈計算 10^exp，避免與 number.no / bigint.no 的整數 pow 名稱衝突
        p f64 = 1.0
        ei i64 = exp
        {
            p = p * 10.0
            ei = ei - 1
        } (ei > 0)
        exp-sign == 1 -> result = result * p
        exp-sign == -1 -> result = result / p
    }
    result = result * sign
}

; str.to-f64: 將字串解析為 f64
; 返回 Option：
;   ok(f) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元
; 使用 Nolang 實作 str-to-f64 進行解析（已移除 strtod CLibCall 依賴）
str.to-f64 = () (val ?f64) {
    .len == 0 -> {
        val = nil
        return
    }

    ; 簡易驗證：至少含一個數字字元
    has-digit = 0
    start = 0
    c = .[0]
    c == 45 || c == 43 -> start = 1
    i <- [start...len): {
        c = .[i]
        {
            c >= 48 && c <= 57 -> has-digit = 1
            c == 46 -> {
                ; 小數點 - 允許
            }
            c == 101 || c == 69 -> {
                ; 科學記號 e/E - 允許
            }
            -> {
                val = err('invalid float')
                return
            }
        }
    }
    has-digit == 0 -> {
        val = nil
        return
    }

    ; 呼叫 Nolang 實作 str-to-f64 進行解析
    f = str-to-f64(.)
    val = f
}

; str.to-f32: 將字串解析為 f32
; 返回 Option：
;   ok(f) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元
; 使用 Nolang 實作 str-to-f64 + f64-to-f32（已移除 strtod CLibCall 依賴）
str.to-f32 = () (val ?f32) {
    f ?f64 = .to-f64()
    {
        f == nil -> {
            val = nil
            return
        }
        f == err -> {
            val = err('str.to-f32: parse error')
            return
        }
    }
    val = number.f64-to-f32(f)
}

; str.to-bool: 將字串 "true" / "false" 解析為 bool
; 大小寫敏感；空字串 → nil，其他 → err
; 使用逐字節比較以避免 strcmp 在跨函數呼叫時的記憶體問題
str.to-bool = () (val ?bool) {
    {
        .len == 0 -> {
            val = nil
            return
        }
        .len == 4 -> {

            ; 比較 "true" (4 bytes)
            .[0] == 116 && .[1] == 114 && .[2] == 117 && .[3] == 101 -> {
                val = true
                return
            }
        }
        .len == 5 -> {

            ; 比較 "false" (5 bytes)
            .[0] == 102 && .[1] == 97 && .[2] == 108 && .[3] == 115 && .[4] == 101 -> {
                val = false
                return
            }
        }
    }
    val = err('not a bool')
}

; ═══════════════════════════════════════════════
; 反转与比较
; ═══════════════════════════════════════════════

; str.reverse: 反转字符串
; 将 s 反转后写入 val
str.reverse = () (val str) {
    val = with-cap(.len)
    i <- [0...len): {
        val[i] = .[.len - 1 - i]
    }
}

; str.compare: 字典序比较两个字符串
; 返回 -1(a<b), 0(相等), 1(a>b)
str.compare = (b str) (r i64) {
    an = .len
    bn = b.len
    min-n = an
    bn < min-n -> min-n = bn
    i <- [0..min-n): {
        ai = .[i]
        bi = b[i]
        {
            ai < bi -> {
                r = -1
                return
            }
            ai > bi -> {
                r = 1
                return
            }
        }
    }
    {
        an < bn -> r = -1
        an > bn -> r = 1
        -> r = 0
    }
}

; ═══════════════════════════════════════════════
; 统计
; ═══════════════════════════════════════════════

; str.count: 统计字串中的 char（code point）數量
; 因為 .len 已經是 byte 數，count 提供 code point 數
str.count = () (cnt i64) {
    cnt = 0
    i = 0
    {
        b = .[i]
        {
            b < 0x80 -> i = i + 1
            b < 0xe0 -> i = i + 2
            b < 0xf0 -> i = i + 3
            -> i = i + 4
        }
        cnt = cnt + 1
    } (i < .len)
}

; ═══════════════════════════════════════════════
; 替换
; ═══════════════════════════════════════════════

; str.replace-char: 将 s 中所有 old-ch 替换为 new-ch（UTF-8 码点）
; 返回结果字符串
str.replace-char = (old-ch char, new-ch char) (val str) {

    ; 第一遍：計算輸出長度
    out-n = 0
    i = 0
    {
        b = .[i]
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.[i + 1] & 0x3f)
                clen = 2
            }
            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.[i + 1] & 0x3f) << 6) | (.[i + 2] & 0x3f)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3f) << 12) | ((.[i + 2] & 0x3f) << 6) | (.[i + 3] & 0x3f)
                clen = 4
            }
        }
        {
            cp == old-ch -> {
                new-ch < 0x80 -> out-n = out-n + 1
                new-ch < 0x800 -> out-n = out-n + 2
                new-ch < 0x10000 -> out-n = out-n + 3
                -> out-n = out-n + 4
            }
            -> out-n = out-n + clen
        }
        i = i + clen
    } (i < .len)

    ; 第二遍：写入输出
    val = with-cap(out-n)
    j = 0
    i = 0
    {
        b = .[i]
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.[i + 1] & 0x3f)
                clen = 2
            }
            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.[i + 1] & 0x3f) << 6) | (.[i + 2] & 0x3f)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3f) << 12) | ((.[i + 2] & 0x3f) << 6) | (.[i + 3] & 0x3f)
                clen = 4
            }
        }
        {
            cp == old-ch -> {
                new-ch < 0x80 -> {
                    val[j] = new-ch
                    j = j + 1
                }
                new-ch < 0x800 -> {
                    val[j] = 0xc0 | ((new-ch >> 6) & 0x1f)
                    val[j + 1] = 0x80 | (new-ch & 0x3f)
                    j = j + 2
                }
                new-ch < 0x10000 -> {
                    val[j] = 0xe0 | ((new-ch >> 12) & 0x0f)
                    val[j + 1] = 0x80 | ((new-ch >> 6) & 0x3f)
                    val[j + 2] = 0x80 | (new-ch & 0x3f)
                    j = j + 3
                }
                -> {
                    val[j] = 0xf0 | ((new-ch >> 18) & 0x07)
                    val[j + 1] = 0x80 | ((new-ch >> 12) & 0x3f)
                    val[j + 2] = 0x80 | ((new-ch >> 6) & 0x3f)
                    val[j + 3] = 0x80 | (new-ch & 0x3f)
                    j = j + 4
                }
            }
            -> {
                k <- [0..clen): {
                    val[j + k] = .[i + k]
                }
                j = j + clen
            }
        }
        i = i + clen
    } (i < .len)
}

; ═══════════════════════════════════════════════
; 裁剪（指定字符）
; ═══════════════════════════════════════════════

; str.trim-char: 去除字符串首尾指定字符（UTF-8 码点）
str.trim-char = (ch char) (val str) {

    ; 前向裁剪：跳过所有等于 ch 的 code point
    start = 0
    {
        b = .[start]
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.[start + 1] & 0x3f)
                clen = 2
            }
            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.[start + 1] & 0x3f) << 6) | (.[start + 2] & 0x3f)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[start + 1] & 0x3f) << 12) | ((.[start + 2] & 0x3f) << 6) | (.[start + 3] & 0x3f)
                clen = 4
            }
        }
        cp != ch -> break
        start = start + clen
    } (start < .len)

    ; 後向裁剪：從 start 開始掃描，找到最後一個不等於 ch 的 code point 的結束位置
    end = start
    i = start
    {
        b = .[i]
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.[i + 1] & 0x3f)
                clen = 2
            }
            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.[i + 1] & 0x3f) << 6) | (.[i + 2] & 0x3f)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3f) << 12) | ((.[i + 2] & 0x3f) << 6) | (.[i + 3] & 0x3f)
                clen = 4
            }
        }
        cp != ch -> end = i + clen
        i = i + clen
    } (i < .len)
    n = end - start
    n < 0 -> return
    val = with-len(n)
    j <- [0..n): {
        val[j] = .[start + j]
    }
}

; ═══════════════════════════════════════════════
; 判空
; ═══════════════════════════════════════════════

; str.empty: 判断字符串是否为空
; 返回 true=空, false=非空
str.empty = () (yes bool) {
    yes = true
    .len != 0 -> yes = false
}

; str.clear: 清空字符串（原地修改长度为 0）
; 不 free 堆、不改变 cap/ptr，仅 len=0
; 只有写入带长度新内容（拼接、赋值非空字符串、填充等）时，才走扩容/缩容逻辑
; build-in
; str.clear = () { }

; str.truncate: 原地截斷字串至至多 n 個位元組（len = min(len, n)）
; 不 free 堆、不改变 cap/ptr，仅调整 len
; 替代低阶 s.len = n 写法（验证器拒绝直接修改 .len）
; build-in
; str.truncate = (n i64) { }

; 全局函数 with-cap / with-len / with-cap-len 的声明已移至 global.no

; ═══════════════════════════════════════════════
; 便捷构造方法（方法形式的全局 with-cap / with-len / with-cap-len）
; ═══════════════════════════════════════════════

; str.with-cap: 建立指定容量的新字串（len=0）
;   s = ''.with-cap(256)  → 預分配 256 位元組的空字串
; 便捷方法，等同全域 with-cap(cap)
str.with-cap = (cap i64) (out str) {
    out = with-cap(cap)
}

; str.with-len: 建立指定長度的字串
;   s = ''.with-len(10)  → 長度為 10 的字串
; 便捷方法，等同全域 with-len(len)
str.with-len = (len i64) (out str) {
    out = with-len(len)
}

; str.with-len-cap: 建立指定長度和容量的字串
;   s = ''.with-len-cap(10, 256)  → 長度 10、容量 256 的字串
; 便捷方法，等同全域 with-cap-len(cap, len)
str.with-len-cap = (len i64, cap i64) (out str) {
    out = with-cap-len(cap, len)
}

; ═══════════════════════════════════════════════
; 十六進制解碼
; ═══════════════════════════════════════════════

; hex-val: 單個十六進制字元轉數值
; 無效字元回傳 -1
hex-val = (c i64) (v i64) {
    v = -1
    {
        c >= 48 && c <= 57 -> {
            v = c - 48
            return
        }
        c >= 65 && c <= 70 -> {
            v = c - 65 + 10
            return
        }
        c >= 97 && c <= 102 -> v = c - 97 + 10
    }
}

; str.from-hex: 將十六進制字串解碼為 []byte
; 返回 Option：
;   ok(bytes) - 成功
;   nil        - 空字串
;   err('msg') - 含無效十六進制字元
str.from-hex = () (out ?[]byte) {
    {
        .len == 0 -> {
            out = nil
            return
        }
        .len % 2 != 0 -> {
            out = err('odd-length hex string')
            return
        }
    }
    n = .len / 2
    out = with-len(n)
    i <- [0..n): {
        hi = hex-val(.[i * 2])
        lo = hex-val(.[i * 2 + 1])
        hi < 0 || lo < 0 -> {
            out = err('invalid hex character')
            return
        }
        out[i] = (hi << 4) | lo
    }
}

; ═══════════════════════════════════════════════
; 分割與連接
; ═══════════════════════════════════════════════

; str.split: 用分隔符將字串分割為多個子字串
; sep str: 分隔符
; 返回 out []str: 分割後的子字串切片
; 空分隔符時返回整個字串作為唯一元素
; 注意：使用本地 result 切片再賦值給 out，避免 out.push 在輸出參數上不生效的編譯器 bug
str.split = (sep str) (out []str) {
    result []str
    sep.len == 0 -> {
        result.push(.slice(0, .len))
        out = result
        return
    }
    start = 0
    pos = .index-from(sep, start)
    {
        result.push(.slice(start, pos))
        start = pos + sep.len
        pos = .index-from(sep, start)
    } (pos >= 0)
    result.push(.slice(start, .len))
    out = result
}

; []str.join: 用分隔符連接字串切片中的所有元素
; sep str: 分隔符
; 返回 out str: 連接後的字串
[]str.join = (sep str) (out str) {
    n = .len
    n == 0 -> return
    total = 0
    i <- [0..n): {
        i > 0 -> total = total + sep.len
        total = total + .[i].len
    }
    out = with-cap(total)
    pos = 0
    i <- [0..n): {
        i > 0 -> {
            j <- [0..sep.len): {
                out[pos] = sep[j]
                pos = pos + 1
            }
        }
        s = .[i]
        j <- [0..s.len): {
            out[pos] = s[j]
            pos = pos + 1
        }
    }
}

; ═══════════════════════════════════════════════
; 子串替換
; ═══════════════════════════════════════════════

; str.replace-str: 將 s 中所有 old 子串替換為 new 子串
; old str: 要替換的子串
; new str: 替換後的子串
; 返回 val str: 替換後的結果字串
; 若 old 為空字串，直接返回原字串的副本
str.replace-str = (old str, new str) (val str) {
    old.len == 0 -> {
        val = .slice(0, .len)
        return
    }

    ; 第一遍：計算結果長度
    n = .len
    old-len = old.len
    new-len = new.len
    out-len = 0
    i = 0
    {
        ; 嘗試在位置 i 匹配 old
        match = true
        j = 0
        {
            i + j >= n -> {
                match = false
                break
            }
            .[i + j] != old[j] -> {
                match = false
                break
            }
            j = j + 1
        } (j < old-len)

        match -> {
            out-len = out-len + new-len
            i = i + old-len
        }
        -> {
            out-len = out-len + 1
            i = i + 1
        }
    } (i < n)

    ; 第二遍：寫入結果
    val = with-cap(out-len)
    pos = 0
    i = 0
    {
        ; 嘗試在位置 i 匹配 old
        match = true
        j = 0
        {
            i + j >= n -> {
                match = false
                break
            }
            .[i + j] != old[j] -> {
                match = false
                break
            }
            j = j + 1
        } (j < old-len)

        match -> {
            k <- [0..new-len): {
                val[pos] = new[k]
                pos = pos + 1
            }
            i = i + old-len
        }
        -> {
            val[pos] = .[i]
            pos = pos + 1
            i = i + 1
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; 按空白分割
; ═══════════════════════════════════════════════

; str.fields: 按一個或多個連續空白字元分割字串
; 空白字元：空格(32)、定位(9)、換行(10)、歸位(13)
; 返回 out []str: 分割後的非空子字串切片
; 連續空白被視為單一分隔符，首尾空白不產生空元素
str.fields = () (out []str) {
    n = .len
    n == 0 -> return
    result []str
    start = -1
    i <- [0..n): {
        b = .[i]
        {
            b != 32 && b != 9 && b != 10 && b != 13 -> {
                start < 0 -> start = i
            }
            start >= 0 -> {
                result.push(.slice(start, i))
                start = -1
            }
            ->
        }
    }

    ; 處理最後一個欄位
    start >= 0 -> result.push(.slice(start, n))
    out = result
}

; ═══════════════════════════════════════════════
; f64 轉字串（可配置精度）
; ═══════════════════════════════════════════════

; f64-to-str-fixed: 定點格式轉換
; x f64: 要轉換的浮點數
; precision i64: 小數位數（>= 0，建議 <= 17 以避免 i64 溢出）
; 返回 out str: 字串表示（如 "3.14"、"-0.005"、"100"）
f64-to-str-fixed = (x f64, precision i64) (out str) {

    ; NaN
    ! (x == x) -> {
        out = 'nan'.copy()
        return
    }

    ; 零（包括 +0.0 和 -0.0）
    {
        x == 0.0 -> {
            neg = 0
            check f64 = 1.0 / x
            check < 0.0 -> neg = 1
            total = 1
            neg == 1 -> total = total + 1
            precision > 0 -> total = total + 1 + precision
            out = with-cap(total)
            pos = 0
            neg == 1 -> {
                out[pos] = 45
                pos = pos + 1
            }
            out[pos] = 48
            pos = pos + 1
            precision > 0 -> {
                out[pos] = 46
                pos = pos + 1
                i <- [0..precision): {
                    out[pos] = 48
                    pos = pos + 1
                }
            }
            return
        }
        x + x == x -> {

            ; 無限

            x < 0.0 -> {
                out = '-inf'.copy()
                return
            }
            out = 'inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax f64 = x
    x < 0.0 -> {
        neg = 1
        ax = 0.0 - x
    }

    ; m = round(ax * 10^precision)
    scale f64 = 1.0
    pi <- [0..precision): {
        scale = scale * 10.0
    }
    scaled f64 = ax * scale
    m i64 = number.f64-to-i64(scaled + 0.5)

    ; 將 m 轉為字串
    mstr = number.i64-to-str(m)
    mn = mstr.len

    ; 補零到至少 precision+1 位（保證整數部分至少一位）
    pad = 0
    mn <= precision -> pad = precision + 1 - mn

    ; 計算長度
    digits-len = mn + pad
    int-len = digits-len - precision
    total = digits-len
    neg == 1 -> total = total + 1
    precision > 0 -> total = total + 1
    out = with-cap(total)
    pos = 0
    neg == 1 -> {
        out[pos] = 45
        pos = pos + 1
    }

    ; 整數部分
    j <- [0..int-len): {
        {
            j < pad -> out[pos] = 48
            -> out[pos] = mstr[j - pad]
        }
        pos = pos + 1
    }

    ; 小數部分
    precision > 0 -> {
        out[pos] = 46
        pos = pos + 1
        j <- [0..precision): {
            idx = int-len + j
            {
                idx < pad -> out[pos] = 48
                -> out[pos] = mstr[idx - pad]
            }
            pos = pos + 1
        }
    }
}

; f64-to-str-sci: 科學記號格式
; x f64: 要轉換的浮點數
; precision i64: 小數部分位數（>= 0）
; 返回 out str: 字串表示（如 "3.14e+2"、"-5.0e-3"）
f64-to-str-sci = (x f64, precision i64) (out str) {

    ; NaN
    ! (x == x) -> {
        out = 'nan'.copy()
        return
    }

    ; 零
    {
        x == 0.0 -> {
            neg = 0
            check f64 = 1.0 / x
            check < 0.0 -> neg = 1
            total = 5
            neg == 1 -> total = total + 1
            precision > 0 -> total = total + 1 + precision
            out = with-cap(total)
            pos = 0
            neg == 1 -> {
                out[pos] = 45
                pos = pos + 1
            }
            out[pos] = 48
            pos = pos + 1
            precision > 0 -> {
                out[pos] = 46
                pos = pos + 1
                i <- [0..precision): {
                    out[pos] = 48
                    pos = pos + 1
                }
            }
            out[pos] = 101
            pos = pos + 1
            out[pos] = 43
            pos = pos + 1
            out[pos] = 48
            pos = pos + 1
            out[pos] = 48
            return
        }
        x + x == x -> {

            ; 無限

            x < 0.0 -> {
                out = '-inf'.copy()
                return
            }
            out = 'inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax f64 = x
    x < 0.0 -> {
        neg = 1
        ax = 0.0 - x
    }

    ; 計算指數 e = floor(log10(ax))
    ln10 f64 = 2.302585092994046
    e i64 = number.f64-to-i64(math.floor(math.log10(ax)))
    upper f64 = math.exp(number.i64-to-f64(e + 1) * ln10)
    ax >= upper -> e = e + 1
    base f64 = math.exp(number.i64-to-f64(e) * ln10)
    ax < base -> {
        e = e - 1
        base = math.exp(number.i64-to-f64(e) * ln10)
    }

    ; m = round(ax / base * 10^precision)
    scale f64 = 1.0
    pi <- [0..precision): {
        scale = scale * 10.0
    }
    m i64 = number.f64-to-i64(ax / base * scale + 0.5)

    ; 四捨五入溢出處理（m 變成 10^(precision+1)）
    overflow = 1
    i <- [0..precision + 1): {
        overflow = overflow * 10
    }
    m >= overflow -> {
        m = m / 10
        e = e + 1
    }

    ; 構建 mantissa 字串
    mstr = number.i64-to-str(m)
    mn = mstr.len

    ; 指數位數
    ae i64 = e
    e < 0 -> ae = 0 - ae
    elen = 1
    {
        ae >= 100 -> elen = 3
        ae >= 10 && ae < 100 -> elen = 2
    }

    ; 總長度
    total = mn
    neg == 1 -> total = total + 1
    precision > 0 -> total = total + 1
    total = total + 2 + elen
    elen < 2 -> total = total + 1
    out = with-cap(total)
    pos = 0
    neg == 1 -> {
        out[pos] = 45
        pos = pos + 1
    }

    ; 第一位數字
    out[pos] = mstr[0]
    pos = pos + 1

    ; 小數部分
    precision > 0 -> {
        out[pos] = 46
        pos = pos + 1
        j <- [0..precision): {
            idx = j + 1
            {
                idx < mn -> out[pos] = mstr[idx]
                -> out[pos] = 48
            }
            pos = pos + 1
        }
    }

    ; 'e' 和符號
    out[pos] = 101
    pos = pos + 1
    {
        e < 0 -> out[pos] = 45
        -> out[pos] = 43
    }
    pos = pos + 1

    ; 指數位數（至少 2 位，前導補零）
    estr = number.i64-to-str(ae)
    elen2 = estr.len
    elen2 == 1 -> {
        out[pos] = 48
        pos = pos + 1
    }
    j <- [0..elen2): {
        out[pos] = estr[j]
        pos = pos + 1
    }
}

; f64-to-str-general: 通用格式（自動選擇定點或科學記號）
; x f64: 要轉換的浮點數
; precision i64: 最大有效數字位數（>= 1）
; 返回 out str: 字串表示（自動去尾隨零）
f64-to-str-general = (x f64, precision i64) (out str) {

    ; NaN
    ! (x == x) -> {
        out = 'nan'.copy()
        return
    }

    ; 零
    {
        x == 0.0 -> {
            neg = 0
            check f64 = 1.0 / x
            check < 0.0 -> neg = 1
            out = with-cap(2)
            pos = 0
            neg == 1 -> {
                out[pos] = 45
                pos = pos + 1
            }
            out[pos] = 48
            return
        }
        x + x == x -> {

            ; 無限

            x < 0.0 -> {
                out = '-inf'.copy()
                return
            }
            out = 'inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax f64 = x
    x < 0.0 -> {
        neg = 1
        ax = 0.0 - x
    }

    ; 計算指數
    ln10 f64 = 2.302585092994046
    e i64 = number.f64-to-i64(math.floor(math.log10(ax)))
    upper f64 = math.exp(number.i64-to-f64(e + 1) * ln10)
    ax >= upper -> e = e + 1
    base f64 = math.exp(number.i64-to-f64(e) * ln10)
    ax < base -> {
        e = e - 1
        base = math.exp(number.i64-to-f64(e) * ln10)
    }

    ; m = round(ax / base * 10^(precision-1))
    p-1 i64 = precision - 1
    scale f64 = 1.0
    pi <- [0..p-1): {
        scale = scale * 10.0
    }
    m i64 = number.f64-to-i64(ax / base * scale + 0.5)

    ; 四捨五入溢出處理
    overflow = 1
    i <- [0..precision): {
        overflow = overflow * 10
    }
    m >= overflow -> {
        m = m / 10
        e = e + 1
    }

    ; mantissa 字串
    mstr = number.i64-to-str(m)
    mn = mstr.len
    pad = 0
    mn < precision -> pad = precision - mn

    ; 找最後一個非零位（用於去尾隨零）
    last-nz = 0
    i = precision - 1
    {
        idx = i - pad
        idx >= 0 -> mstr[idx] != 48 -> {
            last-nz = i
            i = -1
        }
        i = i - 1
    } (i >= 0)

    ; 決定格式：%g 規則
    use-sci = 0
    {
        e < -4 -> use-sci = 1
        e >= precision -> use-sci = 1
    }
    use-sci == 1 -> {

        ; 科學記號
        ae i64 = e
        e < 0 -> ae = 0 - ae
        elen = 1
        ae >= 100 -> elen = 3
        ae >= 10 && ae < 100 -> elen = 2
        total = 1
        neg == 1 -> total = total + 1
        last-nz >= 1 -> total = total + 1 + last-nz
        total = total + 2 + elen
        elen < 2 -> total = total + 1
        out = with-cap(total)
        pos = 0
        neg == 1 -> {
            out[pos] = 45
            pos = pos + 1
        }

        ; 第一位數字
        {
            pad > 0 -> out[pos] = 48
            -> out[pos] = mstr[0]
        }
        pos = pos + 1

        ; 小數部分
        last-nz >= 1 -> {
            out[pos] = 46
            pos = pos + 1
            j <- [1..last-nz + 1): {
                idx = j - pad
                {
                    idx >= 0 && idx < mn -> out[pos] = mstr[idx]
                    -> out[pos] = 48
                }
                pos = pos + 1
            }
        }

        ; 'e' 和符號
        out[pos] = 101
        pos = pos + 1
        {
            e < 0 -> out[pos] = 45
            -> out[pos] = 43
        }
        pos = pos + 1

        ; 指數位數（至少 2 位）
        estr = number.i64-to-str(ae)
        elen2 = estr.len
        elen2 == 1 -> {
            out[pos] = 48
            pos = pos + 1
        }
        j <- [0..elen2): {
            out[pos] = estr[j]
            pos = pos + 1
        }
        return
    }

    ; 定點格式（e >= 0）
    e >= 0 -> {
        int-digits = e + 1
        frac-digits = 0
        last-nz >= int-digits -> frac-digits = last-nz - int-digits + 1
        total = int-digits
        neg == 1 -> total = total + 1
        frac-digits > 0 -> total = total + 1 + frac-digits
        out = with-cap(total)
        pos = 0
        neg == 1 -> {
            out[pos] = 45
            pos = pos + 1
        }
        j <- [0..int-digits): {
            idx = j - pad
            {
                idx >= 0 && idx < mn -> out[pos] = mstr[idx]
                -> out[pos] = 48
            }
            pos = pos + 1
        }
        frac-digits > 0 -> {
            out[pos] = 46
            pos = pos + 1
            j <- [0..frac-digits): {
                idx = int-digits + j - pad
                {
                    idx >= 0 && idx < mn -> out[pos] = mstr[idx]
                    -> out[pos] = 48
                }
                pos = pos + 1
            }
        }
        return
    }

    ; 定點格式（e < 0: 0.00dddd）
    lead-zeros = 0 - e - 1
    total = 2 + lead-zeros + last-nz + 1
    neg == 1 -> total = total + 1
    out = with-cap(total)
    pos = 0
    neg == 1 -> {
        out[pos] = 45
        pos = pos + 1
    }
    out[pos] = 48
    pos = pos + 1
    out[pos] = 46
    pos = pos + 1
    j <- [0..lead-zeros): {
        out[pos] = 48
        pos = pos + 1
    }
    j <- [0..last-nz + 1): {
        idx = j - pad
        {
            idx >= 0 && idx < mn -> out[pos] = mstr[idx]
            -> out[pos] = 48
        }
        pos = pos + 1
    }
}

; ═══════════════════════════════════════════════
; 全等比較
; ═══════════════════════════════════════════════

; str.eq-full: 全等比較兩個字串
; b str: 比較目標
; 返回 yes bool: true=相等 false=不相等
str.eq-full = (b str) (yes bool) {
    .len != b.len -> return
    yes = true
    i <- [0...len): {
        .[i] != b[i] -> {
            yes = false
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 反向查找
; ═══════════════════════════════════════════════

; str.rindex: 反向查找子串最後出現位置
; target str: 要查找的子串
; 返回 pos i64: 找到的字節位置，未找到 -1
str.rindex = (target str) (pos i64) {
    pos = -1
    {
        target.len == 0 -> {
            pos = .len
            return
        }
        target.len > .len -> return
    }
    limit = .len - target.len
    i = limit
    {
        matched = 1
        j <- [0..target.len): {
            sj = .[i + j]
            tj = target[j]
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
        i = i - 1
    } (i >= 0)
}

; str.last-index: 反向查找子串最後出現位置（last-index 是 rindex 的別名）
; target str: 要查找的子串
; 返回 pos i64: 找到的字節位置，未找到 -1
str.last-index = (target str) (pos i64) {
    pos = .rindex(target)
}

; str.rindex-from: 從 from 位置反向查找子串
; 語義同 Python rfind(target, from)：在 [from, .len) 範圍內查找 target 最後出現位置
; target str: 要查找的子串
; from i64: 起始位置（含，下界）
; 返回 pos i64: 找到的字節位置，未找到 -1
str.rindex-from = (target str, from i64) (pos i64) {
    pos = -1
    from < 0 -> from = 0
    {
        target.len == 0 -> {
            from <= .len -> pos = .len
            return
        }
        target.len > .len -> return
    }
    limit = .len - target.len
    from > limit -> return
    i = limit
    {
        matched = 1
        j <- [0..target.len): {
            sj = .[i + j]
            tj = target[j]
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
        i = i - 1
    } (i >= from)
}

; ═══════════════════════════════════════════════
; 限定次數替換
; ═══════════════════════════════════════════════

; str.replace-n: 限定替換次數
; old str: 舊子串
; new str: 新子串
; n i64: 最大替換次數，n <= 0 不替換
; 返回 val str: 替換後字串
str.replace-n = (old str, new str, n i64) (val str) {
    n <= 0 -> {
        val = .slice(0, .len)
        return
    }
    old.len == 0 -> {
        val = .slice(0, .len)
        return
    }
    parts = .split(old)
    np = parts.len
    np <= 1 -> {
        val = .slice(0, .len)
        return
    }
    repl = np - 1
    repl > n -> repl = n
    total = 0
    i <- [0..np): {
        i > 0 -> i <= repl -> total = total + new.len -> total = total + old.len
        total = total + parts[i].len
    }
    val = with-cap(total)
    pos = 0
    i <- [0..np): {
        i > 0 -> {
            sep = new
            i > repl -> sep = old
            j <- [0..sep.len): {
                val[pos] = sep[j]
                pos = pos + 1
            }
        }
        s = parts[i]
        j <- [0..s.len): {
            val[pos] = s[j]
            pos = pos + 1
        }
    }
}

; ═══════════════════════════════════════════════
; 限定次數分割
; ═══════════════════════════════════════════════

; str.split-n: 限定分割次數
; sep str: 分隔符
; maxsplit i64: 最大分割次數（產生 maxsplit+1 個元素），maxsplit <= 0 不限制
; 返回 out []str: 分割結果
str.split-n = (sep str, maxsplit i64) (out []str) {
    result []str
    sep.len == 0 -> {
        result.push(.slice(0, .len))
        out = result
        return
    }
    maxsplit <= 0 -> {
        out = .split(sep)
        return
    }
    start = 0
    pos = .index-from(sep, start)
    count = 0
    {
        count >= maxsplit -> {
            result.push(.slice(start, .len))
            out = result
            return
        }
        result.push(.slice(start, pos))
        start = pos + sep.len
        count = count + 1
        pos = .index-from(sep, start)
    } (pos >= 0)
    result.push(.slice(start, .len))
    out = result
}

; ═══════════════════════════════════════════════
; 按行分割
; ═══════════════════════════════════════════════

; str.lines: 按換行符分割
; 支持 \n 與 \r\n
; 返回 out []str: 行列表（末尾換行不產生空行）
str.lines = () (out []str) {
    .len == 0 -> return
    result []str
    start = 0
    i = 0
    {
        c = .[i]
        c == 10 -> {
            end = i
            i > start -> {
                prev = .[i - 1]
                prev == 13 -> end = i - 1
            }
            result.push(.slice(start, end))
            start = i + 1
        }
        i = i + 1
    } (i < .len)
    start < .len -> result.push(.slice(start, .len))
    out = result
}

; ═══════════════════════════════════════════════
; 十六進制編碼
; ═══════════════════════════════════════════════

; str.to-hex: 字串轉十六進制編碼
; 每字節轉兩個十六進制字符（小寫）
; 返回 out str: 十六進制字串
str.to-hex = () (out str) {
    .len == 0 -> return
    out = with-cap(.len * 2)
    hex = '0123456789abcdef'
    i <- [0...len): {
        b = .[i]
        out[i * 2] = hex[b >> 4]
        out[i * 2 + 1] = hex[b & 15]
    }
}

; ═══════════════════════════════════════════════
; 安全索引
; ═══════════════════════════════════════════════

; str.at: 安全索引訪問
; i i64: 字節索引
; 返回 val ?byte: 越界返回 nil
str.at = (i i64) (val ?byte) {
    {
        i < 0 -> {
            val = nil
            return
        }
        i >= .len -> {
            val = nil
            return
        }
    }
    val = .[i]
}
