}

; 將字串解析為 u64
; 拒絕負號；不檢查 i64 範圍溢位（截斷由 LLVM 自動處理）
; val: ok=非負整數（拒絕負號）, nil=空字串, err=含非數字字元
; [to-u64](#str.to-u64)
str.to-u64 = () (val ?u64) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    c = .byte(0)
    c == 45 -> {
        val = err('invalid u64: negative sign not allowed')
        return
    }
    n = 0
    start = 0
    c == 43 -> start = 1
    i <- [start..self.len-bytes()): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    val = n
}

; 將字串解析為 byte（與 u8 等價）
; 返回 Option：
;   ok(n) - 成功（0 ~ 255）
;   nil    - 空字串
;   err('msg') - 含非數字字元、負號或超出範圍
; val: ok=範圍內（0~255）的 byte, nil=空字串, err=非法或超出範圍
; [to-byte](#str.to-byte)
str.to-byte = () (val ?byte) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid byte: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..self.len-bytes()): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for byte')
    }
}

; str-to-f64: 將字串精確解析為 f64（bigint 精確 strtod）
; 以 bigint 建立精確有理數 int-mant * 10^K，再求最近可表示 f64（捨入至偶），
; 取代原本 f64 累積（17 位字面量會差 1 ULP）。支援 [+-][數字][.數字][eE[+-]數字]。
; 回傳正 bigint 的位元長度（floor(log2)+1）
; b: 正 bigint 值
; out: 位元長度（floor(log2)+1）
; [bigint-bitlen](#str.bigint-bitlen)
bigint-bitlen = (b bigint) (out i64) {
    bm = 4294967295
    out = (b.len - 1) * 32
    top = (b.limbs[b.len - 1] & bm)
    sh = 0
    t = top
    (t > 0) {
        t = t >> 1
        {
            sh-opt = sh + 1
            sh-opt: {
                ok -> sh = it

                ->
            }
        }
    }
    {
        out-opt = out + sh
        out-opt: {
            ok -> out = it

            ->
        }
    }
}

; 將十進位/科學記號文本解析為 f64（Nolang 實作，不依賴 strtod）
; s: 數字文本
; result: 解析得到的 f64（合法性由呼叫端 to-f64 先行校驗）
; [str-to-f64](#str.str-to-f64)
str-to-f64 = (s str) (result f64) {
    n i64 = s.len-bytes()
    n == 0 -> return
    i = 0
    sign = 1
    has-digit = 0
    int-mant = bigint.zero()
    ten = bigint.from-i64(10)
    frac-count = 0
    exp-val = 0
    exp-sign = 1
    c = 0

    ; 跳過前導空白
    (i < n) {
        c = s.byte(i): {
            ok -> it

            -> 0
        }
        {
            c == 32 || c == 9 || c == 10 || c == 13 -> {
                {
                    i-opt = i + 1
                    i-opt: {
                        ok -> i = it

                        ->
                    }
                }
            }

            -> break
        }
    }
    i >= n -> return

    ; 正負號
    c = s.byte(i): {
        ok -> it

        -> 0
    }
    {
        c == 45 -> {
            sign = -1
            {
                i-opt2 = i + 1
                i-opt2: {
                    ok -> i = it

                    ->
                }
            }
        }

        c == 43 -> {
            {
                i-opt3 = i + 1
                i-opt3: {
                    ok -> i = it

                    ->
                }
            }
        }
    }

    ; 整數部分 → int-mant = int-mant * 10 + digit
    (i < n) {
        c = s.byte(i): {
            ok -> it

            -> 0
        }
        {
            c >= 48 && c <= 57 -> {

                ; 逐位累積走公開 bigint 方法鏈，而非 `int-mant * 10 + dig`：
                ; 後者在「迴圈 + match 臂的巢狀 block」裡目前不會把運算符重載的
                ; bigint 結果寫回變數（實測恆為 0），故用具體方法形式。
                dig = bigint.from-i64(c - 48)
                int-mant = int-mant.mul-bigint(ten).add-bigint(dig)
                has-digit = 1
                {
                    i-opt4 = i + 1
                    i-opt4: {
                        ok -> i = it

                        ->
                    }
                }
            }

            -> break
        }
    }

    ; 小數部分 → int-mant = int-mant * 10 + digit; frac-count++
    (i < n) {
        c = s.byte(i): {
            ok -> it

            -> 0
        }
        {
            c == 46 -> {
                {
                    i-opt5 = i + 1
                    i-opt5: {
                        ok -> i = it

                        ->
                    }
                }
                (i < n) {
                    c = s.byte(i): {
                        ok -> it

                        -> 0
                    }
                    {
                        c >= 48 && c <= 57 -> {

                            ; 同整數部分：巢狀 block 裡用公開方法鏈累積。
                            dig = bigint.from-i64(c - 48)
                            int-mant = int-mant.mul-bigint(ten).add-bigint(dig)
                            {
                                frac-count-opt = frac-count + 1
                                frac-count-opt: {
                                    ok -> frac-count = it

                                    ->
                                }
                            }
                            has-digit = 1
                            {
                                i-opt6 = i + 1
                                i-opt6: {
                                    ok -> i = it

                                    ->
                                }
                            }
                        }

                        -> break
                    }
                }
            }

            -> break
        }
    }
    has-digit == 0 -> return

    ; 指數部分
    (i < n) {
        c = s.byte(i): {
            ok -> it

            -> 0
        }
        {
            c == 101 || c == 69 -> {
                {
                    i-opt7 = i + 1
                    i-opt7: {
                        ok -> i = it

                        ->
                    }
                }
                (i < n) {
                    c = s.byte(i): {
                        ok -> it

                        -> 0
                    }
                    {
                        c == 45 -> {
                            exp-sign = -1
                            {
                                i-opt8 = i + 1
                                i-opt8: {
                                    ok -> i = it

                                    ->
                                }
                            }
                        }

                        c == 43 -> {
                            {
                                i-opt9 = i + 1
                                i-opt9: {
                                    ok -> i = it

                                    ->
                                }
                            }
                        }

                        -> break
                    }
                }
                (i < n) {
                    c = s.byte(i): {
                        ok -> it

                        -> 0
                    }
                    {
                        c >= 48 && c <= 57 -> {

                            #{overflow=wrap}
                            {

                                #{overflow=wrap}
                                exp-val-opt = exp-val * 10 + (c - 48)
                                exp-val-opt: {
                                    ok -> exp-val = it

                                    ->
                                }
                            }
                            {
                                i-opt10 = i + 1
                                i-opt10: {
                                    ok -> i = it

                                    ->
                                }
                            }
                        }

                        -> break
                    }
                }
            }

            -> break
        }
    }

    ; exp-adj = exp-val * exp-sign - frac-count：精確有理數 = int-mant * 10^exp-adj
    exp-adj = exp-val * exp-sign - frac-count

    num = bigint.copy(int-mant)
    den = bigint.one()
    {
        (exp-adj >= 0) -> {
            t10 bigint = bigint.from-i64(10)
            num = int-mant.mul-bigint(t10.pow(exp-adj))
        }

        -> {
            t10d bigint = bigint.from-i64(10)
            den = t10d.pow(0 - exp-adj)
        }
    }

    ; 零值特例（含 -0.0）
    (num.is-zero()) -> {
        result = 0.0
        (sign < 0) -> result = -result
        return
    }

    ; e = floor(log2(num/den))
    nbl = bigint-bitlen(num)
    dbl = bigint-bitlen(den)

    #{overflow=wrap}
    e = nbl - dbl
    {
        e >= 0 -> {
            (bigint.shl(den, e).cmp(num) > 0) -> {
                {
                    e-opt = e - 1
                    e-opt: {
                        ok -> e = it

                        ->
                    }
                }
            }
        }

        -> {
            (bigint.shl(num, 0 - e).cmp(den) < 0) -> {
                {
                    e-opt2 = e - 1
                    e-opt2: {
                        ok -> e = it

                        ->
                    }
                }
            }
        }
    }

    ; 超出上界 → ±inf
    (e > 1023) -> {
        result = 1.0
        (result * 2.0 != result) {
            result = result * 2.0
        }
        (sign < 0) -> result = -result
        return
    }

    two52 = bigint.from-i64(4503599627370496)
    two53 = bigint.from-i64(9007199254740992)
    one = bigint.one()
    two = bigint.from-i64(2)

    ; 次正規：value = F * 2^-1074（F 為 52-bit 分數）
    {
        (e < -1022) -> {
            num-s = bigint.shl(num, 1074)
            qS, rS = num-s.div-mod(den)
            two-r = bigint.shl(rS, 1)
            c2 = two-r.cmp(den)
            fb-q = qS
            (c2 > 0) -> fb-q = qS.add-bigint(one)
            (c2 == 0) -> {

                ; 取奇偶：公開 div-mod 的餘數恆落在 {0,1}，用 is-zero 判別即可，
                ; 不必把 bigint 拆回 i64，也不碰 bigint 的私有快速路徑。
                _, qm = qS.div-mod(two)
                {
                    (qm.is-zero()) -> fb-q = qS

                    -> fb-q = qS.add-bigint(one)
                }
            }
            _, frac-b = fb-q.div-mod(two52)
            inv1074f f64 = 1.0
            j = 0
            (j < 1074) {
                inv1074f = inv1074f / 2.0
                {
                    j-opt = j + 1
                    j-opt: {
                        ok -> j = it

                        ->
                    }
                }
            }
            frac-f64 f64 = frac-b.to-i64(): {
                ok -> it.to-f64()

                -> _
            }
            result = frac-f64 * inv1074f
            (sign < 0) -> result = -result
            return
        }

        ; 正規：value = (1 + m/2^52) * 2^e（m 為 52-bit 分數）
        (e >= 0) -> {
            num-s = bigint.shl(num, 52)
            den-s = bigint.shl(den, e)
        }

        -> {
            num-s = bigint.shl(num, 52 - e)
            den-s = den.copy()
        }
    }
    qw, rw = num-s.div-mod(den-s)
    two-r = bigint.shl(rw, 1)
    c2 = two-r.cmp(den-s)
    wv = qw
    (c2 > 0) -> wv = qw.add-bigint(one)
    (c2 == 0) -> {

        ; 同次正規分支：奇偶判別走公開 div-mod + is-zero，不碰 bigint 私有快速路徑。
        _, qm2 = qw.div-mod(two)
        {
            (qm2.is-zero()) -> wv = qw

            -> wv = qw.add-bigint(one)
        }
    }

    ; 溢位保護：wv >= 2^53 ⇒ e+1, m=0（最終由 scale 迴圈得 inf）
    (wv.cmp(two53) >= 0) -> {
        {
            e-opt3 = e + 1
            e-opt3: {
                ok -> e = it

                ->
            }
        }
        wv = two52.copy()
    }

    ; m = (wv - 2^52) % 2^52，且 wv >= 2^52（本分支 wv = round((num/den)·2^(52-e))
    ; = 2^52 + m），故餘數非負且恆 < 2^52，必落在 i64 值域內；
    ; to-i64 是取回 i64 的公開出口（值域守衛見 bigint.no）。
    mw = wv.sub-bigint(two52)
    _, mb = mw.div-mod(two52)
    mv = mb.to-i64(): {
        ok -> it.to-f64()

        -> _
    }
    two52f = 1.0
    k = 0
    (k < 52) {
        two52f = two52f * 2.0
        {
            k-opt = k + 1
            k-opt: {
                ok -> k = it

                ->
            }
        }
    }
    val-f = 1.0 + (mv / two52f)
    scale = 1.0
    (e > 0) {
        scale = scale * 2.0
        {
            e-opt4 = e - 1
            e-opt4: {
                ok -> e = it

                ->
            }
        }
    }
    (e < 0) {
        scale = scale / 2.0
        {
            e-opt5 = e + 1
            e-opt5: {
                ok -> e = it

                ->
            }
        }
    }
    result = val-f * scale
    (sign < 0) -> result = -result
}

; 將字串解析為 f64
; 返回 Option：
;   ok(f) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元
; 使用 Nolang 實作 str-to-f64 進行解析（已移除 strtod CLibCall 依賴）
; val: ok=解析出的 f64, nil=空字串, err=含非數字字元
; [to-f64](#str.to-f64)
str.to-f64 = () (val ?f64) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }

    ; 簡易驗證：至少含一個數字字元
    has-digit = 0
    start = 0
    c = .byte(0)
    c == 45 || c == 43 -> start = 1
    i <- [start..self.len-bytes()): {
        c = .byte(i)
        {
            c >= 48 && c <= 57 -> has-digit = 1

            c == 46 -> {
                ; 小數點 - 允許
            }

            c == 101 || c == 69 -> {
                ; 科學記號 e/E - 允許
            }

            c == 43 || c == 45 -> {
                ; 正負號（首位或指數位）- 允許
            }

            c == 32 || c == 9 || c == 10 || c == 13 -> {
                ; 前後空白 - 允許（str-to-f64 自行跳過）
            }

            -> {
                val = err('invalid float')
                return
            }
        }
    }
    has-digit == 0 -> {
        val = nil
        return
    }

    ; 呼叫 Nolang 實作 str-to-f64 進行解析
    f = str-to-f64(.)
    val = f
}

; 將字串解析為 f32
; 返回 Option：
;   ok(f) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元
; 使用 Nolang 實作 str-to-f64 + f64-to-f32（已移除 strtod CLibCall 依賴）
; val: ok=單精度 f32（經 str-to-f64 再收窄）, nil=空字串, err=含非數字字元
; [to-f32](#str.to-f32)
str.to-f32 = () (val ?f32) {
    f = .to-f64()
    {
        f == nil -> {
            val = nil
            return
        }

        f == err -> {
            val = err('str.to-f32: parse error')
            return
        }
    }
    val = f.to-f32()
}

; 將字串 "true" / "false" 解析為 bool
; 大小寫敏感；空字串 → nil，其他 → err
; 使用逐字節比較以避免 strcmp 在跨函數呼叫時的記憶體問題
; val: ok=true/false（僅認 '"true"'/'"false"'，大小寫敏感）, nil=空字串, err=其他
; [to-bool](#str.to-bool)
str.to-bool = () (val ?bool) {
    {
        .len-bytes() == 0 -> {
            val = nil
            return
        }

        .len-bytes() == 4 -> {

            ; 比較 "true" (4 bytes)
            .byte(0) == 116 && .byte(1) == 114 && .byte(2) == 117 && .byte(3) == 101 -> {
                val = true
                return
            }
        }

        .len-bytes() == 5 -> {

            ; 比較 "false" (5 bytes)
            .byte(0) == 102 && .byte(1) == 97 && .byte(2) == 108 && .byte(3) == 115 && .byte(4) == 101 -> {
                val = false
                return
            }
        }
    }
    val = err('not a bool')
}

; 反轉與比較
...

; 反轉字串
; 將 s 反轉後寫入 val
; val: 反轉後的副本（按位元組逆序寫入）
; [reverse](#str.reverse)
str.reverse = () (val str) {
    n = .len-bytes()
    buf []byte = with-cap-len(n, n)
    i <- [0..n): {

        #{overflow=wrap}
        j = n - 1 - i
        buf[i] = .byte(j)
    }
    val = buf.to-bytes-str()
}

; 字典序比較兩個字串
; 返回 -1(a<b), 0(相等), 1(a>b)
; b: 比較目標串
; r: 字典序 -1(接收者<b)/0(相等)/1(>)
; [compare](#str.compare)
str.compare = (b str) (r i64) {
    an = .len-bytes()
    bn = b.len-bytes()
    min-n = an
    bn < min-n -> min-n = bn
    i <- [0..min-n): {
        ai = .byte(i)
        bi = b.byte(i)
        {
            ai < bi -> {
                r = -1
                return
            }

            ai > bi -> {
                r = 1
                return
            }
        }
    }
    {
        an < bn -> r = -1

        an > bn -> r = 1

        -> r = 0
    }
}

; 統計
...

; 統計字串中的 char（code point）數量
; 因為 .len 已經是 byte 數，count 提供 code point 數
; cnt: 碼點（char）數量
; [count](#str.count)
str.count = () (cnt i64) {
    cnt = 0
    i = 0
    (i < .len-bytes()) {
        b = .byte(i)

        #{overflow=wrap}
        {
            b < 0x80 -> {
                {
                    i-opt11 = i + 1
                    i-opt11: {
                        ok -> i = it

                        ->
                    }
                }
            }

            b < 0xe0 -> {
                {
                    i-opt12 = i + 2
                    i-opt12: {
                        ok -> i = it

                        ->
                    }
                }
            }

            b < 0xf0 -> {
                {
                    i-opt13 = i + 3
                    i-opt13: {
                        ok -> i = it

                        ->
                    }
                }
            }

            -> {
                {
                    i-opt14 = i + 4
                    i-opt14: {
                        ok -> i = it

                        ->
                    }
                }
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            cnt-opt = cnt + 1
            cnt-opt: {
                ok -> cnt = it

                ->
            }
        }
    }
}

; 替換
...

; 將 s 中所有 old-ch 替換為 new-ch（UTF-8 碼點）
; 返回結果字串
; old-ch: 被替換的碼點
; new-ch: 替換後的碼點
; val: 逐碼點替換後的副本
; [replace-char](#str.replace-char)
str.replace-char = (old-ch char, new-ch char) (val str) {

    ; 第一遍：計算輸出長度
    out-n = 0
    i = 0
    (i < .len-bytes()) {
        b = .byte(i): {
            ok -> it

            -> _
        }
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        {
            cp == old-ch -> {

                #{overflow=wrap}
                {
                    new-ch < 0x80 -> {
                        {
                            out-n-opt = out-n + 1
                            out-n-opt: {
                                ok -> out-n = it

                                ->
                            }
                        }
                    }

                    new-ch < 0x800 -> {
                        {
                            out-n-opt2 = out-n + 2
                            out-n-opt2: {
                                ok -> out-n = it

                                ->
                            }
                        }
                    }

                    new-ch < 0x10000 -> {
                        {
                            out-n-opt3 = out-n + 3
                            out-n-opt3: {
                                ok -> out-n = it

                                ->
                            }
                        }
                    }

                    -> {
                        {
                            out-n-opt4 = out-n + 4
                            out-n-opt4: {
                                ok -> out-n = it

                                ->
                            }
                        }
                    }
                }
            }

            -> {
                {
                    out-n-opt5 = out-n + clen
                    out-n-opt5: {
                        ok -> out-n = it

                        ->
                    }
                }
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt15 = i + clen
            i-opt15: {
                ok -> i = it

                ->
            }
        }
    }

    ; 第二遍：寫入输出
    buf []byte = with-cap(out-n)
    j = 0
    i = 0
    (i < .len-bytes()) {
        b = .byte(i): {
            ok -> it

            -> _
        }
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        {
            cp == old-ch -> {
                new-ch < 0x80 -> {
                    buf[j] = new-ch
                    {
                        j-opt2 = j + 1
                        j-opt2: {
                            ok -> j = it

                            ->
                        }
                    }
                }

                new-ch < 0x800 -> {
                    buf[j] = 0xc0 | ((new-ch >> 6) & 0x1f)
                    buf[j + 1] = 0x80 | (new-ch & 0x3f)
                    {
                        j-opt3 = j + 2
                        j-opt3: {
                            ok -> j = it

                            ->
                        }
                    }
                }

                new-ch < 0x10000 -> {
                    buf[j] = 0xe0 | ((new-ch >> 12) & 0x0f)
                    buf[j + 1] = 0x80 | ((new-ch >> 6) & 0x3f)
                    buf[j + 2] = 0x80 | (new-ch & 0x3f)
                    {
                        j-opt4 = j + 3
                        j-opt4: {
                            ok -> j = it

                            ->
                        }
                    }
                }

                -> {
                    buf[j] = 0xf0 | ((new-ch >> 18) & 0x07)
                    buf[j + 1] = 0x80 | ((new-ch >> 12) & 0x3f)
                    buf[j + 2] = 0x80 | ((new-ch >> 6) & 0x3f)
                    buf[j + 3] = 0x80 | (new-ch & 0x3f)
                    {
                        j-opt5 = j + 4
                        j-opt5: {
                            ok -> j = it

                            ->
                        }
                    }
                }
            }

            -> {
                k <- [0..clen): {

                    #{overflow=wrap}
                    buf[j + k] = .byte(i + k)
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    j-opt6 = j + clen
                    j-opt6: {
                        ok -> j = it

                        ->
                    }
                }
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt16 = i + clen
            i-opt16: {
                ok -> i = it

                ->
            }
        }
    }
    val = buf.to-bytes-str()
}

; 裁剪（指定字符）
...

; 去除字串首尾指定字符（UTF-8 碼點）
; ch: 首尾要去除的碼點
; val: 去除首尾 ch 後的副本
; [trim-char](#str.trim-char)
str.trim-char = (ch char) (val str) {

    ; 前向裁剪：跳過所有等於 ch 的 code point
    start = 0
    (start < .len-bytes()) {
        b = .byte(start): {
            ok -> it

            -> _
        }
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(start + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(start + 1) & 0x3f) << 6) | (.byte(start + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(start + 1) & 0x3f) << 12) | ((.byte(start + 2) & 0x3f) << 6) | (.byte(start + 3) & 0x3f)
                clen = 4
            }
        }
        cp != ch -> break

        #{overflow=wrap}
        {

            #{overflow=wrap}
            start-opt = start + clen
            start-opt: {
                ok -> start = it

                ->
            }
        }
    }

    ; 後向裁剪：從 start 開始掃描，找到最後一個不等於 ch 的 code point 的結束位置
    end = start
    i = start
    (i < .len-bytes()) {
        b = .byte(i): {
            ok -> it

            -> _
        }
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        cp != ch -> {
            {

                #{overflow=wrap}
                end-opt = i + clen
                end-opt: {
                    ok -> end = it

                    ->
                }
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt17 = i + clen
            i-opt17: {
                ok -> i = it

                ->
            }
        }
    }

    #{overflow=wrap}
    n = end - start
    n < 0 -> return
    buf []byte = with-cap-len(n, n)
    j <- [0..n): {

        #{overflow=wrap}
        buf[j] = .byte(start + j)
    }
    val = buf.to-bytes-str()
}

; 判空
...

; 判斷字串是否為空
; 返回 true=空, false=非空
; yes: 字串長度是否為 0
; [empty](#str.empty)
str.empty = () (yes bool) {
    yes = true
    .len-bytes() != 0 -> yes = false
}

; str.clear: 清空字串（原地修改長度為 0）
; 不 free 堆、不改變 cap/ptr，僅 len=0
; 只有寫入帶長度新內容（拼接、賦值非空字串、填充等）時，才走擴容/縮容邏輯
; build-in
; str.clear = () { }
; str.truncate: 原地截斷字串至至多 n 個位元組（len = min(len, n)）
; 不 free 堆、不改變 cap/ptr，僅調整 len
; 替代低階 s.len = n 寫法（驗證器拒絕直接修改 .len）
; build-in
; str.truncate = (n i64) { }
; 全局函數 with-cap / with-len / with-cap-len 的声明已移至 global.no

; 便捷構造方法（方法形式的全局 with-cap / with-len / with-cap-len）
...

; 建立指定容量的新字串（len=0）
;   s = ''.with-cap(256)  → 預分配 256 位元組的空字串
; 便捷方法，等同全域 with-cap(cap)
; cap: 預分配容量（位元組）
; out: len=0、已分配 cap 的新空字串
; [with-cap](#str.with-cap)
str.with-cap = (cap i64) (out str) {
    out = with-cap(cap)
}

; 建立指定長度的字串
;   s = ''.with-len(10)  → 長度為 10 的字串
; 便捷方法，等同全域 with-len(len)
; len: 初始長度（位元組）
; out: 指定長度的新字串
; [with-len](#str.with-len)
str.with-len = (len i64) (out str) {
    out = with-len(len)
}

; 建立指定長度和容量的字串
;   s = ''.with-len-cap(10, 256)  → 長度 10、容量 256 的字串
; 便捷方法，等同全域 with-cap-len(cap, len)
; len: 長度（位元組）
; cap: 容量（位元組）
; out: 指定長度與容量的新字串
; [with-len-cap](#str.with-len-cap)
str.with-len-cap = (len i64, cap i64) (out str) {
    out = with-cap-len(cap, len)
}

; str.new: 從 char 切片構造 str（模組級構造器）
; 編譯期內建（ForwardFunc: chars-new）：[]char 直接逐位元組轉成 bytes 並一次性設定長度，
; 無逐位元組 .no 迴圈。str 是內建類型，位元組/長度無法在用戶代碼裡操作，故整體轉換由編譯器生成 IR。
; cs: 碼點切片（[]char）
; s: 逐位元組重編碼後的 str
; [new](#str.new)
#{buildin}
new = (cs []char) (s str) {
}

; 十六進制解碼
...

; 單個十六進制字元轉數值
; 無效字元回傳 -1（原名 hex-val 與 uuid.hex-val 撞名，跨模組解析會被要求限定，改掛模組前綴同 txt-hex-val 慣例）
; c: 十六進位字元的碼點值
; v: 0~15；無效字元返回 -1
; [str-hex-val](#str.str-hex-val)
str-hex-val = (c i64) (v i64) {
    v = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                v-opt = c - 48
                v-opt: {
                    ok -> v = it

                    ->
                }
            }
            return
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                v-opt2 = c - 65 + 10
                v-opt2: {
                    ok -> v = it

                    ->
                }
            }
            return
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                v-opt3 = c - 97 + 10
                v-opt3: {
                    ok -> v = it

                    ->
                }
            }
        }
    }
}

; 將十六進制字串解碼為 []byte
; 返回 Option：
;   ok(bytes) - 成功
;   nil        - 空字串
;   err('msg') - 含無效十六進制字元
; out: ok=解碼後的位元組, nil=空字串, err=含非法十六進制字元或奇數長度
; [from-hex](#str.from-hex)
str.from-hex = () (out ?[]byte) {
    n = .len-bytes()
    n == 0 -> {
        out = nil
        return
    }
    n % 2 != 0 -> {
        out = err('odd-length hex string')
        return
    }

    #{overflow=wrap}
    half = n / 2
    buf []byte = with-len(half)
    i <- [0..half): {

        #{overflow=wrap}
        hi = str-hex-val(.byte(i * 2))

        #{overflow=wrap}
        lo = str-hex-val(.byte(i * 2 + 1))
        hi < 0 || lo < 0 -> {
            out = err('invalid hex character')
            return
        }

        ; out 的回傳型別是 ?[]byte，不能直接在上面寫下標（option 沒有成員）；
        ; 寫進 plain 緩衝 buf，迴圈結束再統一包成 ok。
        buf[i]: {
            ok -> it = (hi << 4) | lo

            -> _
        }
    }
    out = buf
}

; 大數（bigint）轉換
...

; 單個數字字元轉數值（0-15），無效字元回傳 -1
; c: 數字字元的碼點值
; d: 0~15；無效字元返回 -1
; [_str-dig-val](#str._str-dig-val)
_str-dig-val = (c i64) (d i64) {
    d = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                d-opt = c - 48
                d-opt: {
                    ok -> d = it

                    ->
                }
            }
            return
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                d-opt2 = c - 55
                d-opt2: {
                    ok -> d = it

                    ->
                }
            }
            return
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            {

                #{overflow=wrap}
                d-opt3 = c - 87
                d-opt3: {
                    ok -> d = it

                    ->
                }
            }
        }
    }
}

; 將字串解析為 bigint，自動判斷進位制
;   前綴 0b/0B → 二進位、0o/0O → 八進位、0x/0X → 十六進位；無前綴 → 十進位
;   支援可選前導空白與正負號（+ / -）
; 返回 ?bigint：ok(bigint) 成功 / nil 空字串 / err('msg') 無有效數字
; out: ok=按前綴進位制（0b/0o/0x 或十進）解析的大整數, nil=空字串, err=無有效數字
; [to-bigint](#str.to-bigint)
str.to-bigint = () (out ?bigint) {
    n = .len-bytes()
    n == 0 -> {
        out = nil
        return
    }

    acc = bigint.zero()
    pos = 0

    ; 跳過前導空白
    (pos < n) {
        c = .byte(pos)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        pos ?= pos + 1
    }

    ; 可選正負號
    sign = 1
    pos < n -> {
        c = .byte(pos)
        c == 45 -> {
            sign = -1

            #{overflow=wrap}
            pos ?= pos + 1
        }

        c == 43 -> {

            #{overflow=wrap}
            pos ?= pos + 1
        }
    }

    ; 進位制前綴
    radix = 10
    pos + 1 < n -> {
        c0 = .byte(pos)
        c0 == 48 -> {
            c1 = .byte(pos + 1)
            {
                c1 == 98 || c1 == 66 -> {
                    radix = 2

                    #{overflow=wrap}
                    pos ?= pos + 2
                }

                c1 == 111 || c1 == 79 -> {
                    radix = 8

                    #{overflow=wrap}
                    pos ?= pos + 2
                }

                c1 == 120 || c1 == 88 -> {
                    radix = 16

                    #{overflow=wrap}
                    pos ?= pos + 2
                }
            }
        }
    }

    ; 逐位解析數字
    ; ⚠️ `d` 必須標註 i64：`d = <call>()` 這種「未標註的呼叫結果」在 `acc + d` 的
    ;    運算符重載聯集臂派發裡會被誤判成 bigint 臂（i64 位元當 bigint 描述符用，
    ;    實測整段回 0 或 abort trap）。標註後 `_add` 正確走 `_add-i64` 臂。
    started = 0
    (pos < n) {
        d i64 = _str-dig-val(.byte(pos))
        d < 0 -> break
        d >= radix -> break

        acc = acc * radix

        acc = acc + d
        started = 1

        #{overflow=wrap}
        pos ?= pos + 1
    }

    started == 0 -> {
        out = err('no digits to parse')
        return
    }

    sign == -1 -> acc.sign = -1
    acc.normalize()
    out = acc
}

; 分割與連接
...

; 用分隔符將字串分割為多個子字串
; sep str: 切分點子串；在每個出現處切開，本身不進入結果
; 返回 out []str: 分割後的子字串切片
; 空分隔符時返回整個字串作為唯一元素
; 注意：使用本地 result 切片再賦值給 out，避免 out.push 在輸出參數上不生效的編譯器 bug
; [split](#str.split)
str.split = (sep str) (out []str) {
    result []str
    sep.len-bytes() == 0 -> {
        result.push(.slice-bytes(0, .len-bytes()))
        out = result
        return
    }
    start = 0
    pos = .find-byte-from(sep, start)
    (pos >= 0) {
        result.push(.slice-bytes(start, pos))

        #{overflow=wrap}
        start = pos + sep.len-bytes()
        pos = .find-byte-from(sep, start)
    }
    result.push(.slice-bytes(start, .len-bytes()))
    out = result
}

; []str.join: 用分隔符連接字串切片中的所有元素
; sep str: 分隔符
; 返回 out str: 連接後的字串
; [join](#strs.join)
[]str.join = (sep str) (out str) {
    n = .len()
    n == 0 -> return
    total = 0
    i <- [0..n): {

        #{overflow=wrap}
        i > 0 -> total = total + sep.len-bytes()

        #{overflow=wrap}
        total = total + .[i].len-bytes()
    }
    buf []byte = with-cap-len(total, total)
    pos = 0
    i <- [0..n): {
        i > 0 -> {
            j <- [0..sep.len-bytes()): {
                buf[pos] = sep.byte(j)

                #{overflow=wrap}
                pos = pos + 1
            }
        }
        s = .[i]
        j <- [0..s.len-bytes()): {
            buf[pos] = s.byte(j)

            #{overflow=wrap}
            pos = pos + 1
        }
    }
    out = buf.to-bytes-str()
}

; 子串替換
...

; 將 s 中所有 old 子串替換為 new 子串
; old str: 要替換的子串
; new str: 替換後的子串
; 返回 val str: 替換後的結果字串
; 若 old 為空字串，直接返回原字串的副本
; [replace-str](#str.replace-str)
str.replace-str = (old str, new str) (val str) {
    old.len-bytes() == 0 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }

    ; 第一遍：計算結果長度
    n = .len-bytes()
    old-len = old.len-bytes()
    new-len = new.len-bytes()
    out-len = 0
    i = 0
    (i < n) {

        ; 嘗試在位置 i 匹配 old
        match = true
        j = 0
        (j < old-len) {

            #{overflow=wrap}
            i + j >= n -> {
                match = false
                break
            }

            #{overflow=wrap}
            .byte(i + j) != old.byte(j) -> {
                match = false
                break
            }

            #{overflow=wrap}
            {

                #{overflow=wrap}
                j-opt7 = j + 1
                j-opt7: {
                    ok -> j = it

                    ->
                }
            }
        }
        {
            match -> {

                #{overflow=wrap}
                out-len = out-len + new-len

                #{overflow=wrap}
                i = i + old-len
            }

            -> {

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    out-len-opt = out-len + 1
                    out-len-opt: {
                        ok -> out-len = it

                        ->
                    }
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    i-opt18 = i + 1
                    i-opt18: {
                        ok -> i = it

                        ->
                    }
                }
            }
        }
    }

    ; 第二遍：寫入結果
    buf []byte = with-cap-len(out-len, out-len)
    pos = 0
    i = 0
    (i < n) {

        ; 嘗試在位置 i 匹配 old
        match = true
        j = 0
        (j < old-len) {

            #{overflow=wrap}
            i + j >= n -> {
                match = false
                break
            }

            #{overflow=wrap}
            .byte(i + j) != old.byte(j) -> {
                match = false
                break
            }

            #{overflow=wrap}
            {

                #{overflow=wrap}
                j-opt8 = j + 1
                j-opt8: {
                    ok -> j = it

                    ->
                }
            }
        }
        {
            match -> {
                k <- [0..new-len): {
                    buf[pos] = new.byte(k)

                    #{overflow=wrap}
                    {

                        #{overflow=wrap}
                        pos-opt = pos + 1
                        pos-opt: {
                            ok -> pos = it

                            ->
                        }
                    }
                }

                #{overflow=wrap}
                i = i + old-len
            }

            -> {
                buf[pos] = .byte(i)

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    pos-opt2 = pos + 1
                    pos-opt2: {
                        ok -> pos = it

                        ->
                    }
                }

                #{overflow=wrap}
                {

                    #{overflow=wrap}
                    i-opt19 = i + 1
                    i-opt19: {
                        ok -> i = it

                        ->
                    }
                }
            }
        }
    }
    val = buf.to-bytes-str()
}

; 按空白分割
...

; 按一個或多個連續空白字元分割字串
; 空白字元：空格(32)、定位(9)、換行(10)、歸位(13)
; 返回 out []str: 分割後的非空子字串切片
; 連續空白被視為單一分隔符，首尾空白不產生空元素
; [fields](#str.fields)
str.fields = () (out []str) {
    n = .len-bytes()
    n == 0 -> return
    result []str
    start = -1
    i <- [0..n): {
        b = .byte(i)
        {
            b != 32 && b != 9 && b != 10 && b != 13 -> {
                start < 0 -> start = i
            }

            start >= 0 -> {
                result.push(.slice-bytes(start, i))
                start = -1
            }

            ->
        }
    }

    ; 處理最後一個欄位
    start >= 0 -> result.push(.slice-bytes(start, n))
    out = result
}

; 全等比較
...

; 全等比較兩個字串
; b str: 比較目標
; 返回 yes bool: true=相等 false=不相等
; [eq-full](#str.eq-full)
str.eq-full = (b str) (yes bool) {
    .len-bytes() != b.len-bytes() -> return
    yes = true
    i <- [0..self.len-bytes()): {
        .byte(i) != b.byte(i) -> {
            yes = false
            return
        }
    }
}

; 反向查找
...

; 反向查找子串最後出現位置
; target str: 要查找的子串
; 返回 pos i64: 找到的碼點（字符）位置，未找到 -1
; [rindex](#str.rindex)
str.rindex = (target str) (pos i64) {
    b = .rfind-byte-from(target, 0)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; 反向查找子串最後出現位置（last-index 是 rindex 的別名）
; target str: 要查找的子串
; 返回 pos i64: 找到的碼點（字符）位置，未找到 -1
; [last-index](#str.last-index)
str.last-index = (target str) (pos i64) {
    pos = .rindex(target)
}

; 從 from（碼點位置）反向查找子串
; 語義同 Python rfind(target, from)：在 [from, .len) 範圍內查找 target 最後出現位置
; target str: 要查找的子串
; from i64: 起始位置（含，下界，碼點）
; 返回 pos i64: 找到的碼點（字符）位置，未找到 -1
; [rindex-from](#str.rindex-from)
str.rindex-from = (target str, from i64) (pos i64) {
    fb = .byte-index(from)
    b = .rfind-byte-from(target, fb)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; 限定次數替換
...

; 限定替換次數
; old str: 舊子串
; new str: 新子串
; n i64: 最大替換次數，n <= 0 不替換
; 返回 val str: 替換後字串
; [replace-n](#str.replace-n)
str.replace-n = (old str, new str, n i64) (val str) {
    n <= 0 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }
    old.len-bytes() == 0 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }
    parts = .split(old)
    np = parts.len()
    np <= 1 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }

    #{overflow=wrap}
    repl = np - 1
    repl > n -> repl = n
    total = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {
            i <= repl -> {

                #{overflow=wrap}
                total = total + new.len-bytes()
                total = total + old.len-bytes()
            }
        }

        ixout2352c25 = parts[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        total = total + ixout2352c25.len-bytes()
    }
    buf []byte = with-cap-len(total, total)
    pos = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {
            sep = new
            i > repl -> sep = old
            j <- [0..sep.len-bytes()): {
                buf[pos] = sep.byte(j)
                {
                    pos-opt3 = pos + 1
                    pos-opt3: {
                        ok -> pos = it

                        ->
                    }
                }
            }
        }

        s = parts[i]: {
            ok -> it

            -> ''
        }
        j <- [0..s.len-bytes()): {
            buf[pos] = s.byte(j)

            #{overflow=wrap}
            {

                #{overflow=wrap}
                pos-opt4 = pos + 1
                pos-opt4: {
                    ok -> pos = it

                    ->
                }
            }
        }
    }
    val = buf.to-bytes-str()
}

; 限定次數分割
...

; 限定分割次數
; sep str: 切分點子串；在每個出現處切開，本身不進入結果
; maxsplit i64: 最大分割次數（產生 maxsplit+1 個元素），maxsplit <= 0 不限制
; 返回 out []str: 分割結果
; [split-n](#str.split-n)
str.split-n = (sep str, maxsplit i64) (out []str) {
    result []str
    sep.len-bytes() == 0 -> {
        result.push(.slice-bytes(0, .len-bytes()))
        out = result
        return
    }
    maxsplit <= 0 -> {
        out = .split(sep)
        return
    }
    start = 0
    pos = .find-byte-from(sep, start)
    count = 0
    (pos >= 0) {
        count >= maxsplit -> {
            result.push(.slice-bytes(start, .len-bytes()))
            out = result
            return
        }
        result.push(.slice-bytes(start, pos))

        #{overflow=wrap}
        start = pos + sep.len-bytes()

        #{overflow=wrap}
        {

            #{overflow=wrap}
            count-opt = count + 1
            count-opt: {
                ok -> count = it

                ->
            }
        }
        pos = .find-byte-from(sep, start)
    }
    result.push(.slice-bytes(start, .len-bytes()))
    out = result
}

; 按行分割
...

; 按換行符分割
; 支持 \n 與 \r\n
; 返回 out []str: 行列表（末尾換行不產生空行）
; [lines](#str.lines)
str.lines = () (out []str) {
    .len-bytes() == 0 -> return
    result []str
    start = 0
    i = 0
    (i < .len-bytes()) {
        c = .byte(i)

        #{overflow=wrap}
        c == 10 -> {
            end = i
            i > start -> {

                #{overflow=wrap}
                prev = .byte(i - 1)
                prev == 13 -> {
                    {
                        end-opt2 = i - 1
                        end-opt2: {
                            ok -> end = it

                            ->
                        }
                    }
                }
            }
            result.push(.slice-bytes(start, end))
            {
                start-opt2 = i + 1
                start-opt2: {
                    ok -> start = it

                    ->
                }
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            i-opt20 = i + 1
            i-opt20: {
                ok -> i = it

                ->
            }
        }
    }
    start < .len-bytes() -> result.push(.slice-bytes(start, .len-bytes()))
    out = result
}

; 十六進制編碼
...

; 字串轉十六進制編碼
; 每字節轉兩個十六進制字符（小寫）
; 返回 out str: 十六進制字串
; [to-hex](#str.to-hex)
str.to-hex = () (out str) {
    nb = .len-bytes()
    nb == 0 -> return

    #{overflow=wrap}
    m = nb * 2
    buf []byte = with-cap-len(m, m)
    hex = '0123456789abcdef'
    i <- [0..nb): {
        b = .byte(i)

        #{overflow=wrap}
        buf[i * 2] = hex[b >> 4]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        buf[i * 2 + 1] = hex[b & 15]: {
            ok -> it

            -> _
        }
    }
    out = buf.to-bytes-str()
}

; 安全索引
...

; [deprecated] str.at: 字符（碼點）索引讀取——請改用 s[idx]（原生索引，回傳 ?char）
; 安全索引訪問（字符索引；位元組偏移請用 s.byte(i)）
; i i64: 字符（碼點）索引
; 返回 val ?byte: 該字符的碼點值（超出 byte 範圍時截斷）；越界返回 nil
; [at](#str.at)
str.at = (i i64) (val ?byte) {
    {
        i < 0 -> {
            val = nil
            return
        }

        i >= .len() -> {
            val = nil
            return
        }
    }
    val = .[i]
}

; txt 轉換
...

; 將 str 轉換為 txt（最長 255 位元組）
; 返回 out ?txt: ok(txt) / nil（超過 255 位元組，txt 容納不下，不再靜默截斷）
; [to-txt](#str.to-txt)
str.to-txt = () (out ?txt) {
    n = .len-bytes()
    n > 255 -> {
        out = nil
        return
    }

    ; 委派 txt.from-str：它就是「逐位元組拷入內聯緩衝 + 設 len」，語義完全等價。
    ; 舊寫法是 t._set-byte(i, .byte(i)) 逐位元組灌，但 txt._set-byte 已私有
    ; （raqvyltn 會擋跨模組呼叫），且這裡本來就有現成的公開構造器。
    ; ⚠️ 必須先綁到區域變數再傳，不能寫 `txt.from-str(.)` 或 `txt.from-str(self)`：
    ; 把 self（本身就是一個 out 參數指針）直接當實參傳會讓 codegen 段錯誤
    ; （2026-11-11 實測：`(.)` 與 `(self)` 都 SIGSEGV，`s = self` 後傳 `s` 正常）。
    s = self
    t = txt.from-str(s)
    out = t
}
