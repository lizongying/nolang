// str — 字符串操作标准库
//
// str 是对外统一的字符串类型
// 内部实现：str-long（堆分配）
//
// 切片是視圖，非獨立類型：對 str 進行切片操作（如 s[1..3]）仍產生 str 視圖，
// 共享 str 的底層記憶體，不複製資料。
// 因此 str 的所有方法（to-upper、to-lower、index、contains、slice、copy、fill 等）
// 均適用於 str 的切片視圖。通過切片修改元素會影響原始 str。
//
// str {
//     len i64 read-only       // 对外：i64 长度
//     cap i64 read-only       // 对外：i64 容量（仅 str-long 有效）
//     data *byte sealed       // 对外：数据指针
// }

// ═══════════════════════════════════════════════
// 基础操作
// ═══════════════════════════════════════════════

// str.len: 返回字符串长度（内置字段访问，s.len 直接可用）
// build-in
// str.len = () (n int64) {
//    n = .len
// }

// str.cap: 返回字符串容量（内置字段访问，s.cap 直接可用）
// 返回堆缓冲区容量
// build-in
// str.cap = () (n int64) {
//    n = .cap
// }

// str[n]: 返回指定位置的字节值
// build-in
// str[n] = (i i64) (c byte) {
//     c = s[i]
// }

// str.eq: 比较两个字符串的前 n 个字节是否相等
// 返回 true=相等, false=不相等
// build-in (ForwardFunc: eq-raw)
// str.eq = (b str, n i64) (eq bool) { ... }

// str.copy: 将 src 复制到 dst（整個字串）
str.copy = () (dst str) {
    dst = with-cap(.len)
    i <- [0...len): {
        dst[i] = .[i]
    }
}

// str.fill: 用 byte 值填充整個字串
str.fill = (val byte) {
    i <- [0...len): {
        .[i] = val
    }
}

// ═══════════════════════════════════════════════
// 查找
// ═══════════════════════════════════════════════

// str.index: 在 s 中查找 target 子串
// 返回首次出现的位置，未找到返回 -1
str.index = (target str) (pos i64) {
    pos = -1
    target.len == 0 -> {
        pos = 0
        return
    }
    limit = .len - target.len
    i = 0
    for i <= limit {
        matched = 1
        j <- [0..target.len): {
            sj = .[i + j]
            tj = target[j]
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
        i = i + 1
    }
}

// str.index-from: 在 s 中從 from 位置開始查找 target 子串
// 返回首次出現的位置，未找到返回 -1
str.index-from = (target str, from i64) (pos i64) {
    pos = -1
    target.len == 0 -> {
        from <= .len -> pos = from
        return
    }
    from < 0 -> from = 0
    limit = .len - target.len
    i = from
    for i <= limit {
        matched = 1
        j <- [0..target.len): {
            sj = .[i + j]
            tj = target[j]
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
        i = i + 1
    }
}

// str.contains: 判断 s 是否包含 target 子串
// 返回 true=包含, false=不包含
str.contains = (target str) (yes bool) {
    yes = false
    pos = .index(target)
    pos >= 0 -> yes = true
}

// str.starts-with: 判断 s 是否以 target 开头
// 返回 true=是, false=否
str.starts-with = (target str) (yes bool) {
    yes = true
    target.len > .len -> {
        yes = false
        return
    }
    i <- [0..target.len): {
        si = .[i]
        ti = target[i]
        si != ti -> {
            yes = false
            return
        }
    }
}

// str.ends-with: 判断 s 是否以 target 结尾
// 返回 true=是, false=否
str.ends-with = (target str) (yes bool) {
    yes = true
    target.len > .len -> {
        yes = false
        return
    }
    off = .len - target.len
    i <- [0..target.len): {
        si = .[off + i]
        ti = target[i]
        si != ti -> {
            yes = false
            return
        }
    }
}

// ═══════════════════════════════════════════════
// 转换
// ═══════════════════════════════════════════════

// str.to-upper: 将字符串转为大写
// 返回新字符串
str.to-upper = () (val str) {
    val = with-cap(.len)
    i <- [0...len): {
        c = .[i]
        {
            c >= 97 && c <= 122 -> val[i] = c - 32
            -> val[i] = c
        }
    }
}

// str.to-lower: 将字符串转为小写
// 返回新字符串
str.to-lower = () (val str) {
    val = with-cap(.len)
    i <- [0...len): {
        c = .[i]
        {
            c >= 65 && c <= 90 -> val[i] = c + 32
            -> val[i] = c
        }
    }
}

// str.trim: 去除字符串首尾空白字符
// 返回新字符串
str.trim = () (val str) {
    start <- [0...len): {
        c = .[start]
        c != 32 && c != 9 && c != 10 && c != 13 -> break
    }
    end = .len - 1
    for end >= start {
        c = .[end]
        c != 32 && c != 9 && c != 10 && c != 13 -> break
        end = end - 1
    }
    n = end - start + 1
    n < 0 -> return
    val = with-cap(n)
    i <- [0..n): {
        val[i] = .[start + i]
    }
}

// ═══════════════════════════════════════════════
// 重复与切片
// ═══════════════════════════════════════════════

// str.repeat: 将字符串重复 times 次
// 返回新字符串
str.repeat = (times i64) (val str) {
    val = with-cap(.len * times)
    i <- [0..times): {
        j <- [0...len): {
            val[i * .len + j] = .[j]
        }
    }
}

// str.slice: 截取子串 [start, end)
// 返回新字符串
str.slice = (start i64, end i64) (val str) {
    start < 0 -> start = 0
    end > .len -> end = .len
    start >= end -> return
    n = end - start
    val = with-cap(n)
    i <- [0..n): {
        val[i] = .[start + i]
    }
}

// ═══════════════════════════════════════════════
// 类型转换
// ═══════════════════════════════════════════════

// str.to-bytes: 将字符串转为字节数组
str.to-bytes = () (val []byte) {
    val = with-cap(.len)
    i <- [0...len): {
        val[i] = .[i]
    }
}

// str.to-i64: 將字串解析為有號 64 位整數
// 返回 Option：
//   val(n) - 成功
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或格式錯誤
str.to-i64 = () (val ?i64) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    neg = 0
    c = .[0]
    {
        c == 45 -> {
            neg = 1
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone minus')
                return
            }
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    neg == 1 -> n = 0 - n
    val = n
}

// str.to-i8: 將字串解析為 i8
// 返回 Option：
//   val(n) - 成功（-128 ~ 127）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i8 = () (val ?i8) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    neg = 0
    c = .[0]
    {
        c == 45 -> {
            neg = 1
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone minus')
                return
            }
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    neg == 1 -> n = 0 - n
    {
        n >= 0 - 128 && n <= 127 -> val = n
        -> val = err('val of range for i8')
    }
}

// str.to-i16: 將字串解析為 i16
// 返回 Option：
//   val(n) - 成功（-32768 ~ 32767）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i16 = () (val ?i16) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    neg = 0
    c = .[0]
    {
        c == 45 -> {
            neg = 1
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone minus')
                return
            }
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    neg == 1 -> n = 0 - n
    {
        n >= 0 - 32768 && n <= 32767 -> val = n
        -> val = err('val of range for i16')
    }
}

// str.to-i32: 將字串解析為 i32
// 返回 Option：
//   val(n) - 成功（-2147483648 ~ 2147483647）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i32 = () (val ?i32) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    neg = 0
    c = .[0]
    {
        c == 45 -> {
            neg = 1
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone minus')
                return
            }
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    neg == 1 -> n = 0 - n
    {
        n >= 0 - 2147483648 && n <= 2147483647 -> val = n
        -> val = err('val of range for i32')
    }
}

// str.to-u8: 將字串解析為 u8
// 返回 Option：
//   val(n) - 成功（0 ~ 255）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u8 = () (val ?u8) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .[0]
    {
        c == 45 -> {
            val = err('invalid u8: negative sign not allowed')
            return
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n
        -> val = err('out of range for u8')
    }
}

// str.to-u16: 將字串解析為 u16
// 返回 Option：
//   val(n) - 成功（0 ~ 65535）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u16 = () (val ?u16) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .[0]
    {
        c == 45 -> {
            val = err('invalid u16: negative sign not allowed')
            return
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 65535 -> val = n
        -> val = err('out of range for u16')
    }
}

// str.to-u32: 將字串解析為 u32
// 返回 Option：
//   val(n) - 成功（0 ~ 4294967295）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u32 = () (val ?u32) {
    .len == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .[0]
    {
        c == 45 -> {
            val = err('invalid u32: negative sign not allowed')
            return
        }
        c == 43 -> {
            start = 1
            .len == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 4294967295 -> val = n
        -> val = err('out of range for u32')
    }
}

// str.to-u64: 將字串解析為 u64
// 拒絕負號；不檢查 i64 範圍溢位（截斷由 LLVM 自動處理）
str.to-u64 = () (val ?u64) {
    .len == 0 -> {
        val = nil
        return
    }
    c = .[0]
    c == 45 -> {
        val = err('invalid u64: negative sign not allowed')
        return
    }
    n = 0
    start = 0
    c == 43 -> start = 1
    i <- [start...len): {
        c = .[i]
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
    }
    val = n
}

// str.to-byte: 將字串解析為 byte（與 u8 等價）
// 返回 Option：
//   val(n) - 成功（0 ~ 255）
//   nil    - 空字串
//   err('msg') - 含非數字字元、負號或超出範圍
str.to-byte = () (val ?byte) {
    n ?i64 = .to-i64()
    n: {
        -> n
    }
}

// str.to-f64: 將字串解析為 f64
// 返回 Option：
//   val(f) - 成功
//   nil    - 空字串
//   err('msg') - 含非數字字元
// 使用內建 strtod 進行實際解析，此處負責驗證與 Option 包裝
str.to-f64 = () (val ?f64) {
    .len == 0 -> {
        val = nil
        return
    }

    // 簡易驗證：至少含一個數字字元
    has-digit = 0
    start = 0
    c = .[0]
    c == 45 || c == 43 -> start = 1
    i <- [start...len): {
        c = .[i]
        {
            c >= 48 && c <= 57 -> has-digit = 1
            c == 46 -> c == 101 || c == 69
            -> {
                // 小數點 - 允許
                // 科學記號 e/E - 允許

                val = err('invalid float')
                return
            }
            ->
        }
    }

    has-digit == 0 -> {
        val = nil
        return
    }

    // 呼叫內建 strtod 進行解析
    f = .parse-f64-raw()
    val = f
}

// str.to-bool: 將字串 "true" / "false" 解析為 bool
// 大小寫敏感；空字串 → nil，其他 → err
// 使用逐字節比較以避免 strcmp 在跨函數呼叫時的記憶體問題
str.to-bool = () (val ?bool) {
    .len == 0 -> {
        val = nil
        return
    }

    // 比較 "true" (4 bytes)
    .len == 4 -> .[0] == 116 && .[1] == 114 && .[2] == 117 && .[3] == 101 -> {
        val = true
        return
    }

    // 比較 "false" (5 bytes)
    .len == 5 -> .[0] == 102 && .[1] == 97 && .[2] == 108 && .[3] == 115 && .[4] == 101 -> {
        val = false
        return
    }
    val = err('not a bool')
}

// ═══════════════════════════════════════════════
// 反转与比较
// ═══════════════════════════════════════════════

// str.reverse: 反转字符串
// 将 s 反转后写入 val
str.reverse = () (val str) {
    val = with-cap(.len)
    i <- [0...len): {
        val[i] = .[.len - 1 - i]
    }
}

// str.compare: 字典序比较两个字符串
// 返回 -1(a<b), 0(相等), 1(a>b)
str.compare = (b str) (r i64) {
    an = .len
    bn = b.len
    min-n = an
    bn < min-n -> min-n = bn
    i <- [0..min-n): {
        ai = .[i]
        bi = b[i]
        ai < bi -> {
            r = -1
            return
        }
        ai > bi -> {
            r = 1
            return
        }
    }
    {
        an < bn -> r = -1
        an > bn -> r = 1
        -> r = 0
    }
}

// ═══════════════════════════════════════════════
// 统计
// ═══════════════════════════════════════════════

// str.count: 统计字串中的 char（code point）數量
// 因為 .len 已經是 byte 數，count 提供 code point 數
str.count = () (cnt i64) {
    cnt = 0
    i = 0
    for i < .len {
        b = .[i]
        {
            b < 0x80 -> i = i + 1
            b < 0xE0 -> i = i + 2
            b < 0xF0 -> i = i + 3
            -> i = i + 4
        }
        cnt = cnt + 1
    }
}

// ═══════════════════════════════════════════════
// 替换
// ═══════════════════════════════════════════════

// str.replace-char: 将 s 中所有 old-ch 替换为 new-ch（UTF-8 码点）
// 返回结果字符串
str.replace-char = (old-ch char, new-ch char) (val str) {
    // 第一遍：計算輸出長度
    out-n = 0
    i = 0
    for i < .len {
        b = .[i]
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xE0 -> {
                cp = ((b & 0x1F) << 6) | (.[i + 1] & 0x3F)
                clen = 2
            }
            b < 0xF0 -> {
                cp = ((b & 0x0F) << 12) | ((.[i + 1] & 0x3F) << 6) | (.[i + 2] & 0x3F)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3F) << 12) | ((.[i + 2] & 0x3F) << 6) | (.[i + 3] & 0x3F)
                clen = 4
            }
        }
        {
            cp == old-ch -> {
                new-ch < 0x80 -> out-n = out-n + 1
                new-ch < 0x800 -> out-n = out-n + 2
                new-ch < 0x10000 -> out-n = out-n + 3
                -> out-n = out-n + 4
            }
            -> out-n = out-n + clen
        }
        i = i + clen
    }

    // 第二遍：写入输出
    val = with-cap(out-n)
    j = 0
    i = 0
    for i < .len {
        b = .[i]
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xE0 -> {
                cp = ((b & 0x1F) << 6) | (.[i + 1] & 0x3F)
                clen = 2
            }
            b < 0xF0 -> {
                cp = ((b & 0x0F) << 12) | ((.[i + 1] & 0x3F) << 6) | (.[i + 2] & 0x3F)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3F) << 12) | ((.[i + 2] & 0x3F) << 6) | (.[i + 3] & 0x3F)
                clen = 4
            }
        }
        {
            cp == old-ch -> {
                new-ch < 0x80 -> {
                    val[j] = new-ch
                    j = j + 1
                }
                new-ch < 0x800 -> {
                    val[j] = 0xC0 | ((new-ch >> 6) & 0x1F)
                    val[j + 1] = 0x80 | (new-ch & 0x3F)
                    j = j + 2
                }
                new-ch < 0x10000 -> {
                    val[j] = 0xE0 | ((new-ch >> 12) & 0x0F)
                    val[j + 1] = 0x80 | ((new-ch >> 6) & 0x3F)
                    val[j + 2] = 0x80 | (new-ch & 0x3F)
                    j = j + 3
                }
                -> {
                    val[j] = 0xF0 | ((new-ch >> 18) & 0x07)
                    val[j + 1] = 0x80 | ((new-ch >> 12) & 0x3F)
                    val[j + 2] = 0x80 | ((new-ch >> 6) & 0x3F)
                    val[j + 3] = 0x80 | (new-ch & 0x3F)
                    j = j + 4
                }
            }
            -> {
                k <- [0..clen): {
                    val[j + k] = .[i + k]
                }
                j = j + clen
            }
        }
        i = i + clen
    }
}

// ═══════════════════════════════════════════════
// 裁剪（指定字符）
// ═══════════════════════════════════════════════

// str.trim-char: 去除字符串首尾指定字符（UTF-8 码点）
str.trim-char = (ch char) (val str) {
    // 前向裁剪：跳过所有等于 ch 的 code point
    start = 0
    for start < .len {
        b = .[start]
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xE0 -> {
                cp = ((b & 0x1F) << 6) | (.[start + 1] & 0x3F)
                clen = 2
            }
            b < 0xF0 -> {
                cp = ((b & 0x0F) << 12) | ((.[start + 1] & 0x3F) << 6) | (.[start + 2] & 0x3F)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[start + 1] & 0x3F) << 12) | ((.[start + 2] & 0x3F) << 6) | (.[start + 3] & 0x3F)
                clen = 4
            }
        }
        cp != ch -> break
        start = start + clen
    }

    // 後向裁剪：從 start 開始掃描，找到最後一個不等於 ch 的 code point 的結束位置
    end = start
    i = start
    for i < .len {
        b = .[i]
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }
            b < 0xE0 -> {
                cp = ((b & 0x1F) << 6) | (.[i + 1] & 0x3F)
                clen = 2
            }
            b < 0xF0 -> {
                cp = ((b & 0x0F) << 12) | ((.[i + 1] & 0x3F) << 6) | (.[i + 2] & 0x3F)
                clen = 3
            }
            -> {
                cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3F) << 12) | ((.[i + 2] & 0x3F) << 6) | (.[i + 3] & 0x3F)
                clen = 4
            }
        }
        cp != ch -> end = i + clen
        i = i + clen
    }
    n = end - start
    n < 0 -> return
    j <- [0..n): {
        val[j] = .[start + j]
    }
}

// ═══════════════════════════════════════════════
// 判空
// ═══════════════════════════════════════════════

// str.empty: 判断字符串是否为空
// 返回 true=空, false=非空
str.empty = () (yes bool) {
    yes = true
    .len != 0 -> yes = false
}

// str.clear: 清空字符串（原地修改长度为 0）
// 不 free 堆、不改变 cap/ptr，仅 len=0
// 只有写入带长度新内容（拼接、赋值非空字符串、填充等）时，才走扩容/缩容逻辑
// build-in
// str.clear = () { }

// with-cap: 建立指定容量的新字串或切片（len=0）
// 內建語法，不屬於任何模組，根據賦值左側型別推斷：
//   s str = with-cap(256)     → 預分配 256 位元組的 str
//   v []i64 = with-cap(100)   → 預分配 100 個元素的切片
// build-in (ForwardFunc: with-cap)

// ═══════════════════════════════════════════════
// 十六進制解碼
// ═══════════════════════════════════════════════

// hex-val: 單個十六進制字元轉數值
// 無效字元回傳 -1
hex-val = (c i64) (v i64) {
    v = -1
    c >= 48 && c <= 57 -> {
        v = c - 48
        return
    }
    c >= 65 && c <= 70 -> {
        v = c - 65 + 10
        return
    }
    c >= 97 && c <= 102 -> v = c - 97 + 10
}

// str.from-hex: 將十六進制字串解碼為 []byte
// 返回 Option：
//   val(bytes) - 成功
//   nil        - 空字串
//   err('msg') - 含無效十六進制字元
str.from-hex = () (out ?[]byte) {
    .len == 0 -> {
        out = nil
        return
    }
    n = .len / 2
    out.len = n
    i <- [0..n): {
        hi = hex-val(.[i * 2])
        lo = hex-val(.[i * 2 + 1])
        hi < 0 || lo < 0 -> {
            out = err('invalid hex character')
            return
        }
        out[i] = (hi << 4) | lo
    }
}

// ═══════════════════════════════════════════════
// 分割與連接
// ═══════════════════════════════════════════════

// str.split: 用分隔符將字串分割為多個子字串
// sep str: 分隔符
// 返回 out []str: 分割後的子字串切片
// 空分隔符時返回整個字串作為唯一元素
str.split = (sep str) (out []str) {
    sep.len == 0 -> {
        out.push(.slice(0, .len))
        return
    }
    start = 0
    pos = .index-from(sep, start)
    for pos >= 0 {
        out.push(.slice(start, pos))
        start = pos + sep.len
        pos = .index-from(sep, start)
    }
    out.push(.slice(start, .len))
}

// []str.join: 用分隔符連接字串切片中的所有元素
// sep str: 分隔符
// 返回 out str: 連接後的字串
[]str.join = (sep str) (out str) {
    n = .len
    n == 0 -> return
    total = 0
    i <- [0..n): {
        i > 0 -> total = total + sep.len
        total = total + .[i].len
    }
    out = with-cap(total)
    pos = 0
    i <- [0..n): {
        i > 0 -> {
            j <- [0..sep.len): {
                out[pos] = sep[j]
                pos = pos + 1
            }
        }
        s = .[i]
        j <- [0..s.len): {
            out[pos] = s[j]
            pos = pos + 1
        }
    }
}