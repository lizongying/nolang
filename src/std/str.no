// str — 字符串操作标准库
//
// str 是对外统一的字符串类型
// 内部实现：str-short（栈分配 SSO）| str-long（堆分配）
// str-short 仅作为编译器内部优化，不出现在公开 API
//
// str {
//     len i64 read-only       // 对外：i64 长度
//     data *byte sealed       // 对外：数据指针
// }

// ═══════════════════════════════════════════════
// 基础操作
// ═══════════════════════════════════════════════

// str.len: 返回字符串长度（内置字段访问，s.len 直接可用）
// build-in
// str.len = () (n int64) {
//    n = .len
// }

// str[n]: 返回指定位置的字节值
// build-in
// str[n] = (i i64) (c byte) {
//     c = s[i]
// }

// str.eq: 比较两个字符串的前 n 个字节是否相等
// 返回 true=相等, false=不相等
// build-in (ForwardFunc: eq-raw)
// str.eq = (b str, n i64) (eq bool) { ... }

// str.copy: 将 src 复制到 dst（整個字串）
str.copy = () (dst str) {
    i = 0
    for i < .len {
        dst[i] = .[i]
        i = i + 1
    }
}

// str.fill: 用 byte 值填充整個字串
str.fill = (val byte) {
    i = 0
    for i < .len {
        .[i] = val
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 查找
// ═══════════════════════════════════════════════

// str.index: 在 s 中查找 target 子串
// 返回首次出现的位置，未找到返回 -1
str.index = (target str) (pos i64) {
    pos = -1
    if target.len == 0 {
        pos = 0
        return
    }
    limit = .len - target.len
    i = 0
    for i <= limit {
        matched = 1
        j = 0
        for j < target.len {
            sj = .[i + j]
            tj = target[j]
            if sj != tj {
                matched = 0
                break
            }
            j = j + 1
        }
        if matched == 1 {
            pos = i
            return
        }
        i = i + 1
    }
}

// str.contains: 判断 s 是否包含 target 子串
// 返回 true=包含, false=不包含
str.contains = (target str) (yes bool) {
    yes = false
    pos = .index(target)
    if pos >= 0 {
        yes = true
    }
}

// str.starts-with: 判断 s 是否以 target 开头
// 返回 true=是, false=否
str.starts-with = (target str) (yes bool) {
    yes = true
    if target.len > .len {
        yes = false
        return
    }
    i = 0
    for i < target.len {
        si = .[i]
        ti = target[i]
        if si != ti {
            yes = false
            return
        }
        i = i + 1
    }
}

// str.ends-with: 判断 s 是否以 target 结尾
// 返回 true=是, false=否
str.ends-with = (target str) (yes bool) {
    yes = true
    if target.len > .len {
        yes = false
        return
    }
    off = .len - target.len
    i = 0
    for i < target.len {
        si = .[off + i]
        ti = target[i]
        if si != ti {
            yes = false
            return
        }
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 转换
// ═══════════════════════════════════════════════

// str.to-upper: 将字符串转为大写
// 返回新字符串
str.to-upper = () (val str) {
    val.len = .len
    i = 0
    for i < .len {
        c = .[i]
        if c >= 97 && c <= 122 {
            val[i] = c - 32
        } else {
            val[i] = c
        }
        i = i + 1
    }
}

// str.to-lower: 将字符串转为小写
// 返回新字符串
str.to-lower = () (val str) {
    val.len = .len
    i = 0
    for i < .len {
        c = .[i]
        if c >= 65 && c <= 90 {
            val[i] = c + 32
        } else {
            val[i] = c
        }
        i = i + 1
    }
}

// str.trim: 去除字符串首尾空白字符
// 返回新字符串
str.trim = () (val str) {
    start = 0
    for start < .len {
        c = .[start]
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        start = start + 1
    }
    end = .len - 1
    for end >= start {
        c = .[end]
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        end = end - 1
    }
    val.len = end - start + 1
    if val.len < 0 {
        val.len = 0
        return
    }
    i = 0
    for i < val.len {
        val[i] = .[start + i]
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 重复与切片
// ═══════════════════════════════════════════════

// str.repeat: 将字符串重复 times 次
// 返回新字符串
str.repeat = (times i64) (val str) {
    val.len = .len * times
    i = 0
    for i < times {
        j = 0
        for j < .len {
            val[i * .len + j] = .[j]
            j = j + 1
        }
        i = i + 1
    }
}

// str.slice: 截取子串 [start, end)
// 返回新字符串
str.slice = (start i64, end i64) (val str) {
    if start < 0 {
        start = 0
    }
    if end > .len {
        end = .len
    }
    if start >= end {
        val.len = 0
        return
    }
    val.len = end - start
    i = 0
    for i < val.len {
        val[i] = .[start + i]
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 类型转换
// ═══════════════════════════════════════════════

// str.to-bytes: 将字符串转为字节数组
str.to-bytes = () (val []byte) {
    val.len = .len
    i = 0
    for i < .len {
        val[i] = .[i]
        i = i + 1
    }
}

// str.to-i64: 將字串解析為有號 64 位整數
// 返回 Option：
//   val(n) - 成功
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或格式錯誤
str.to-i64 = () (val ?i64) {
    if .len == 0 {
        val = nil
        return
    }
    n = 0
    i = 0
    neg = 0
    c = .[0]
    if c == 45 {
        neg = 1
        i = 1
        if .len == 1 {
            val = err('invalid number: lone minus')
            return
        }
    } elif c == 43 {
        i = 1
        if .len == 1 {
            val = err('invalid number: lone plus')
            return
        }
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    if neg == 1 {
        n = 0 - n
    }
    val = val(n)
}

// str.to-i8: 將字串解析為 i8
// 返回 Option：
//   val(n) - 成功（-128 ~ 127）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i8 = () (val ?i8) {
    if .len == 0 {
        val = nil
        return
    }
    n = 0
    i = 0
    neg = 0
    c = .[0]
    if c == 45 {
        neg = 1
        i = 1
        if .len == 1 {
            val = err('invalid number: lone minus')
            return
        }
    } elif c == 43 {
        i = 1
        if .len == 1 {
            val = err('invalid number: lone plus')
            return
        }
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    if neg == 1 {
        n = 0 - n
    }
    if n >= 0 - 128 && n <= 127 {
        val = val(n)
    } else {
        val = err('val of range for i8')
    }
}

// str.to-i16: 將字串解析為 i16
// 返回 Option：
//   val(n) - 成功（-32768 ~ 32767）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i16 = () (val ?i16) {
    if .len == 0 {
        val = nil
        return
    }
    n = 0
    i = 0
    neg = 0
    c = .[0]
    if c == 45 {
        neg = 1
        i = 1
        if .len == 1 {
            val = err('invalid number: lone minus')
            return
        }
    } elif c == 43 {
        i = 1
        if .len == 1 {
            val = err('invalid number: lone plus')
            return
        }
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    if neg == 1 {
        n = 0 - n
    }
    if n >= 0 - 32768 && n <= 32767 {
        val = val(n)
    } else {
        val = err('val of range for i16')
    }
}

// str.to-i32: 將字串解析為 i32
// 返回 Option：
//   val(n) - 成功（-2147483648 ~ 2147483647）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-i32 = () (val ?i32) {
    if .len == 0 {
        val = nil
        return
    }
    n = 0
    i = 0
    neg = 0
    c = .[0]
    if c == 45 {
        neg = 1
        i = 1
        if .len == 1 {
            val = err('invalid number: lone minus')
            return
        }
    } elif c == 43 {
        i = 1
        if .len == 1 {
            val = err('invalid number: lone plus')
            return
        }
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    if neg == 1 {
        n = 0 - n
    }
    if n >= 0 - 2147483648 && n <= 2147483647 {
        val = val(n)
    } else {
        val = err('val of range for i32')
    }
}

// str.to-u8: 將字串解析為 u8
// 返回 Option：
//   val(n) - 成功（0 ~ 255）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u8 = () (val ?u8) {
    if .len == 0 {
        val = nil
        return
    }
    n i64 = 0
    i = 0
    c = .[0]
    if c == 45 {
        val = err('invalid u8: negative sign not allowed')
        return
    } elif c == 43 {
        i = 1
        if .len == 1 {
            val = err('invalid number: lone plus')
            return
        }
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    if n >= 0 && n <= 255 {
        val = val(n)
    } else {
        val = err('out of range for u8')
    }
}

// str.to-u16: 將字串解析為 u16
// 返回 Option：
//   val(n) - 成功（0 ~ 65535）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u16 = () (val ?u16) {
    if .len == 0 {
        val = nil
        return
    }
    n i64 = 0
    i = 0
    c = .[0]
    if c == 45 {
        val = err('invalid u16: negative sign not allowed')
        return
    } elif c == 43 {
        i = 1
        if .len == 1 {
            val = err('invalid number: lone plus')
            return
        }
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    if n >= 0 && n <= 65535 {
        val = val(n)
    } else {
        val = err('out of range for u16')
    }
}

// str.to-u32: 將字串解析為 u32
// 返回 Option：
//   val(n) - 成功（0 ~ 4294967295）
//   nil    - 空字串
//   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
str.to-u32 = () (val ?u32) {
    if .len == 0 {
        val = nil
        return
    }
    n i64 = 0
    i = 0
    c = .[0]
    if c == 45 {
        val = err('invalid u32: negative sign not allowed')
        return
    } elif c == 43 {
        i = 1
        if .len == 1 {
            val = err('invalid number: lone plus')
            return
        }
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    if n >= 0 && n <= 4294967295 {
        val = val(n)
    } else {
        val = err('out of range for u32')
    }
}

// str.to-u64: 將字串解析為 u64
// 拒絕負號；不檢查 i64 範圍溢位（截斷由 LLVM 自動處理）
str.to-u64 = () (val ?u64) {
    if .len == 0 {
        val = nil
        return
    }
    c = .[0]
    if c == 45 {
        val = err('invalid u64: negative sign not allowed')
        return
    }
    n = 0
    i = 0
    if c == 43 {
        i = 1
    }
    for i < .len {
        c = .[i]
        if c < 48 || c > 57 {
            val = err('invalid number: non-digit character')
            return
        }
        n = n * 10 + c - 48
        i = i + 1
    }
    val = val(n)
}

// str.to-byte: 將字串解析為 byte（與 u8 等價）
// 返回 Option：
//   val(n) - 成功（0 ~ 255）
//   nil    - 空字串
//   err('msg') - 含非數字字元、負號或超出範圍
str.to-byte = () (val ?byte) {
    n = .to-i64()
    if n == nil {
        val = nil
    } elif n == err {
        val = err('invalid byte')
    } elif n >= 0 && n <= 255 {
        val = val(n)
    } else {
        val = err('out of range for byte')
    }
}

// str.to-f64: 將字串解析為 f64
// 返回 Option：
//   val(f) - 成功
//   nil    - 空字串
//   err('msg') - 含非數字字元
// 使用內建 strtod 進行實際解析，此處負責驗證與 Option 包裝
str.to-f64 = () (val ?f64) {
    if .len == 0 {
        val = nil
        return
    }

    // 簡易驗證：至少含一個數字字元
    hasDigit = 0
    i = 0
    c = .[0]
    if c == 45 || c == 43 {
        i = 1
    }
    for i < .len {
        c = .[i]
        if c >= 48 && c <= 57 {
            hasDigit = 1
        } elif c == 46 {
            // 小數點 - 允許
        } elif c == 101 || c == 69 {
            // 科學記號 e/E - 允許
        } else {
            val = err('invalid float')
            return
        }
        i = i + 1
    }
    if hasDigit == 0 {
        val = nil
        return
    }

    // 呼叫內建 strtod 進行解析
    f = .parse-f64-raw()
    val = val(f)
}

// str.to-bool: 將字串 "true" / "false" 解析為 bool
// 大小寫敏感；空字串 → nil，其他 → err
// 使用逐字節比較以避免 strcmp 在跨函數呼叫時的記憶體問題
str.to-bool = () (val ?bool) {
    if .len == 0 {
        val = nil
        return
    }

    // 比較 "true" (4 bytes)
    if .len == 4 {
        if .[0] == 116 && .[1] == 114 && .[2] == 117 && .[3] == 101 {
            val = val(true)
            return
        }
    }

    // 比較 "false" (5 bytes)
    if .len == 5 {
        if .[0] == 102 && .[1] == 97 && .[2] == 108 && .[3] == 115 && .[4] == 101 {
            val = val(false)
            return
        }
    }
    val = err('not a bool')
}

// ═══════════════════════════════════════════════
// 反转与比较
// ═══════════════════════════════════════════════

// str.reverse: 反转字符串
// 将 s 反转后写入 val
str.reverse = () (val str) {
    val.len = .len
    i = 0
    for i < .len {
        val[i] = .[.len - 1 - i]
        i = i + 1
    }
}

// str.compare: 字典序比较两个字符串
// 返回 -1(a<b), 0(相等), 1(a>b)
str.compare = (b str) (r i64) {
    an = .len
    bn = b.len
    min-n = an
    if bn < min-n {
        min-n = bn
    }
    i = 0
    for i < min-n {
        ai = .[i]
        bi = b[i]
        if ai < bi {
            r = -1
            return
        }
        if ai > bi {
            r = 1
            return
        }
        i = i + 1
    }
    if an < bn {
        r = -1
    } elif an > bn {
        r = 1
    } else {
        r = 0
    }
}

// ═══════════════════════════════════════════════
// 统计
// ═══════════════════════════════════════════════

// str.count: 统计字串中的 char（code point）數量
// 因為 .len 已經是 byte 數，count 提供 code point 數
str.count = () (cnt i64) {
    cnt = 0
    i = 0
    for i < .len {
        b = .[i]
        if b < 0x80 {
            i = i + 1
        } elif b < 0xE0 {
            i = i + 2
        } elif b < 0xF0 {
            i = i + 3
        } else {
            i = i + 4
        }
        cnt = cnt + 1
    }
}

// ═══════════════════════════════════════════════
// 替换
// ═══════════════════════════════════════════════

// str.replace-char: 将 s 中所有 old-ch 替换为 new-ch（UTF-8 码点）
// 返回结果字符串
str.replace-char = (old-ch char, new-ch char) (val str) {
    // 第一遍：计算输出长度
    val.len = 0
    i = 0
    for i < .len {
        b = .[i]
        cp i64 = b
        clen i64 = 1
        if b < 0x80 {
            cp = b
            clen = 1
        } elif b < 0xE0 {
            cp = ((b & 0x1F) << 6) | (.[i + 1] & 0x3F)
            clen = 2
        } elif b < 0xF0 {
            cp = ((b & 0x0F) << 12) | ((.[i + 1] & 0x3F) << 6) | (.[i + 2] & 0x3F)
            clen = 3
        } else {
            cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3F) << 12) | ((.[i + 2] & 0x3F) << 6) | (.[i + 3] & 0x3F)
            clen = 4
        }
        if cp == old-ch {
            if new-ch < 0x80 {
                val.len = val.len + 1
            } elif new-ch < 0x800 {
                val.len = val.len + 2
            } elif new-ch < 0x10000 {
                val.len = val.len + 3
            } else {
                val.len = val.len + 4
            }
        } else {
            val.len = val.len + clen
        }
        i = i + clen
    }

    // 第二遍：写入输出
    j = 0
    i = 0
    for i < .len {
        b = .[i]
        cp = b
        clen = 1
        if b < 0x80 {
            cp = b
            clen = 1
        } elif b < 0xE0 {
            cp = ((b & 0x1F) << 6) | (.[i + 1] & 0x3F)
            clen = 2
        } elif b < 0xF0 {
            cp = ((b & 0x0F) << 12) | ((.[i + 1] & 0x3F) << 6) | (.[i + 2] & 0x3F)
            clen = 3
        } else {
            cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3F) << 12) | ((.[i + 2] & 0x3F) << 6) | (.[i + 3] & 0x3F)
            clen = 4
        }
        if cp == old-ch {
            if new-ch < 0x80 {
                val[j] = new-ch
                j = j + 1
            } elif new-ch < 0x800 {
                val[j] = 0xC0 | ((new-ch >> 6) & 0x1F)
                val[j + 1] = 0x80 | (new-ch & 0x3F)
                j = j + 2
            } elif new-ch < 0x10000 {
                val[j] = 0xE0 | ((new-ch >> 12) & 0x0F)
                val[j + 1] = 0x80 | ((new-ch >> 6) & 0x3F)
                val[j + 2] = 0x80 | (new-ch & 0x3F)
                j = j + 3
            } else {
                val[j] = 0xF0 | ((new-ch >> 18) & 0x07)
                val[j + 1] = 0x80 | ((new-ch >> 12) & 0x3F)
                val[j + 2] = 0x80 | ((new-ch >> 6) & 0x3F)
                val[j + 3] = 0x80 | (new-ch & 0x3F)
                j = j + 4
            }
        } else {
            k = 0
            for k < clen {
                val[j + k] = .[i + k]
                k = k + 1
            }
            j = j + clen
        }
        i = i + clen
    }
}

// ═══════════════════════════════════════════════
// 裁剪（指定字符）
// ═══════════════════════════════════════════════

// str.trim-char: 去除字符串首尾指定字符（UTF-8 码点）
str.trim-char = (ch char) (val str) {
    // 前向裁剪：跳过所有等于 ch 的 code point
    start = 0
    for start < .len {
        b = .[start]
        cp i64 = b
        clen i64 = 1
        if b < 0x80 {
            cp = b
            clen = 1
        } elif b < 0xE0 {
            cp = ((b & 0x1F) << 6) | (.[start + 1] & 0x3F)
            clen = 2
        } elif b < 0xF0 {
            cp = ((b & 0x0F) << 12) | ((.[start + 1] & 0x3F) << 6) | (.[start + 2] & 0x3F)
            clen = 3
        } else {
            cp = ((b & 0x07) << 18) | ((.[start + 1] & 0x3F) << 12) | ((.[start + 2] & 0x3F) << 6) | (.[start + 3] & 0x3F)
            clen = 4
        }
        if cp != ch {
            break
        }
        start = start + clen
    }

    // 後向裁剪：從 start 開始掃描，找到最後一個不等於 ch 的 code point 的結束位置
    end = start
    i = start
    for i < .len {
        b = .[i]
        cp = b
        clen = 1
        if b < 0x80 {
            cp = b
            clen = 1
        } elif b < 0xE0 {
            cp = ((b & 0x1F) << 6) | (.[i + 1] & 0x3F)
            clen = 2
        } elif b < 0xF0 {
            cp = ((b & 0x0F) << 12) | ((.[i + 1] & 0x3F) << 6) | (.[i + 2] & 0x3F)
            clen = 3
        } else {
            cp = ((b & 0x07) << 18) | ((.[i + 1] & 0x3F) << 12) | ((.[i + 2] & 0x3F) << 6) | (.[i + 3] & 0x3F)
            clen = 4
        }
        if cp != ch {
            end = i + clen
        }
        i = i + clen
    }
    val.len = end - start
    if val.len < 0 {
        val.len = 0
        return
    }
    j = 0
    for j < val.len {
        val[j] = .[start + j]
        j = j + 1
    }
}

// ═══════════════════════════════════════════════
// 判空
// ═══════════════════════════════════════════════

// str.empty: 判断字符串是否为空
// 返回 true=空, false=非空
str.empty = () (yes bool) {
    yes = true
    if .len != 0 {
        yes = false
    }
}