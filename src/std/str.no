; str — 字串操作標準庫

; str 是對外統一的字串類型
; 內部實現：str-long（堆分配）
;
; 切片是視圖，非獨立類型：對 str 進行切片操作（如 s[1..3]）仍產生 str 視圖，
; 共享 str 的底層記憶體，不複製資料。
; 因此 str 的所有方法（to-upper、to-lower、index、contains、slice、copy、fill 等）
; 均適用於 str 的切片視圖。通過切片修改元素會影響原始 str。
; [str](#str)
#{buildin}
str {
    len u32; 對外：i64 長度
    cap u32; 對外：i64 容量（僅 str-long 有效）
    data []byte; 對外：數據指標
}

; 基础操作
...

; string = str | txt —— 字串族聯合類型別名（對標 number.no 的 num = int | float）
; 用法：函數參數/返回值聲稱 string，調用時傳入 str 或 txt 實參，
; 編譯期按實參具體型別單態化（ValidateUnionTypes + FlattenUnion + clone），
; 每個成員各生成一份具體函數（如 f__str / f__txt）。
; 能力邊界（與 num 完全相同的既有限制）：
;   - 函數體內對 union 參數調用成員方法（s.len()/s.to-upper()）尚不支持
;     （單態化名限定缺陷），請改用全域內建（len(s) 為字節數）或拆成
;     str/txt 兩個具體函數；
;   - 聯合變數聲明（s string = 'x'）尚不支持；
;   - 不要定義 string.len 這類「與成員同名」的別名方法：會接管 s.len()
;     調用且方法體遞迴分發回自身（段錯誤）。成員方法請直接用 str.*/txt.* 原版。
; [string](#str.string)
string = str | txt

; str.len-bytes(): 返回字串的「字節數量」（底層 UTF-8 緩衝區長度）
; 由編譯器內建處理（build-in，等同舊 .len 結構體字段）；標準庫內部位元組級迴圈/切片請用本方法
; [len-bytes](#str.len-bytes)
#{buildin}
str.len-bytes = () (n i64) {
   n = .len.to-i64()
}

; 返回字串的「字符（碼點）數量」
; 與 s[i] 的碼點索引語義一致；要字節數請用 s.len-bytes()
; n: 碼點（字符）數量（與 s[i] 索引語義一致）
; [len](#str.len)
str.len = () (n i64) {
    n = .cp-index(.len-bytes())
}

; str.cap: 返回字串容量（內置字段訪問，s.cap 直接可用）
; 返回堆緩衝區容量
#{buildin}
str.cap = () (n int64) {
   n = .cap
}

; 返回「位元組」下標 i 處的原始位元組值（raw byte 讀取）
; 與 s[i] 不同：s[i] 按碼點索引，本方法按底層 UTF-8 緩衝區的位元組偏移取值
; 回傳 ?byte：越界（i < 0 或 i >= len-bytes()）時回傳 nil，與 arr[i] 的
; 安全索引語義一致；呼叫端必須處理 option（match / ?= / place-match 顯式消費）
; 由編譯器內建處理（#{buildin}）：codegen 攔截後展開為「邊界檢查 + GEP+load」，
; 不存在 std 函式體；簽名同時註冊於 src/builtin/str.go 的 BuiltinMethodList
; （MethodName "byte"，Intercepted，經 bare-name 回落同時覆蓋 str 與 txt）
; i: 位元組下標（非碼點）
; c: ok=該位置原始位元組值, nil=i 越界
; [byte](#str.byte)
#{buildin}
str.byte = (i i64) (c ?byte) {
}

;
; str._set-byte: 在「位元組」下標 i 處寫入原始位元組 b（raw byte 寫入，長度不變）
; 🔒 私有（`_` 前綴，2026-11-11 由公開的 `set-byte` 收歸模組內）：跨模組呼叫會被
; checker 以 raqvyltn 拒絕。**用戶碼請用 str.from-chars** —— 一次把整串位元組建成
; 新 str，而不是逐位元組改一個既有的 str。
;
; 為什麼私有化：`s[i] = v`（位元組級寫入）與 `s[i]`（碼點級讀取）在 str 上語意分叉，
; 是明確的陷阱；配套的 `set-byte` 逃生艙一旦公開，等於給這個陷阱留了後門。現在
; `s[i] = v` 也在編譯期被禁用（見 checker 的 str 下標寫入規則），str 的位元組級
; 構建只有兩條合法路徑：公開的 from-chars，或本模組內部的 _set-byte。
;
; b 宣告為 byte：表層實參若是 option（.byte(i) 等）由內建參數檢查直接放過
; （funcargs.go 的 `?` 跳過）；若為純 i64/char 則在呼叫端以遮罩 `& 255` 窄化。
; 這與 src/builtin/str.go 的 BuiltinMethodList 條目一致（裸名註冊，故同時覆蓋 str/txt）。
;
; 回傳 ?bool（可失敗）：越界（i < 0 或 i >= 實體容量 cap）時回傳 nil 並**跳過寫入**，
; 成功回傳 some(true)。邊界以 %str-long 的 cap（實體容量）為準而非 len，故「先填緩衝
; 再 set len」的構建程式照舊可用。呼叫端以裸陳述丟棄 ?bool 合法（optunuse 只管綁定名）。
; i: 位元組下標
; b: 寫入的位元組值
; ok: ok=true=寫入成功, nil=i 越界（跳過寫入）
; [_set-byte](#str._set-byte)
#{buildin}
str._set-byte = (i i64, b byte) (ok ?bool) {
}

; 註：`str.eq(b, n)` 不在本檔案宣告 —— 它是 src/builtin/str.go 註冊的編譯器內建
; （MethodName "str.eq", ForwardFunc "eq-raw" → emitBuiltinEqRaw，比較前 n 位元組）。
; 此處曾有一個 `#{buildin} eq-raw = (b str, n i64) (eq bool) {}` 的空殼宣告，但那只是
; 個死符號（全域零呼叫點，用戶碼 `a.eq-raw(...)` / `str.eq-raw(...)` 兩種形態都調不到），
; 已移除，見 test/README.md §5.0h。

; str._from-bytes: 私有構造器 —— 以「接管緩衝」語義把 []byte 包裝成 str（零拷貝）
; 🔒 私有（`_` 前綴）：只有 src/std/str.no 自己可調用，使用者碼調用會被 checker
;    拒絕（raqvyltn）。公開路徑請用 from-chars() —— 它由編譯器分配新緩衝，
;    不涉及所有權移轉，不會 double free。
; 直接用 bs 的底層 data 指標組出 str，不複製；n 是字串長度，會被夾到
; [0, bs.len()]（負數或超長都不會越界），cap 也取夾後的值。
; 結果 str 與 bs 共享緩衝（codegen 已 vec_retain），兩者各釋放一次；原 bs
; 不得再當作獨立緩衝使用。
; 由編譯器內建處理（#{buildin}）：codegen 攔截後由 %vec 的 data 指標 + n
; 組出 %str-long；簽名同時註冊於 src/builtin/str.go（ForwardFunc "str-from-bytes"）。
; bs: 位元組切片（與結果共享緩衝）
; n: 字串長度（字節數，夾到 [0, bs.len()]）
; s: 共享 bs 緩衝的 str（零拷貝）
; [_from-bytes](#str._from-bytes)
#{buildin}
_from-bytes = (bs []byte, n i64) (s str) {
}

; str.from-chars: 從 []char 安全構造 str（公開構造器，每個 char 寫成一個原始位元組）
; 由編譯器內建處理（#{buildin}，ForwardFunc "chars-new"，與 new() 同一實作）：
; 一次性分配新緩衝、逐位元組寫入並設定長度（len = cap = cs.len()），不借用
; 呼叫方記憶體，故對使用者完全安全（不會 double free / 越界）。
; 注意：每個 char 只取低 8 位寫成 1 個位元組（trunc i32→i8），不做 UTF-8 重編碼；
; 需要 UTF-8 位元組請用 char.to-bytes() 逐個拼，或先 to-str() 再 to-bytes()。
; cs: 碼點切片（[]char）
; s: 由 cs 逐位元組構造的 str（新緩衝，擁有所有權）
; [from-chars](#str.from-chars)
#{buildin}
from-chars = (cs []char) (s str) {
}

; 將 src 複製到 dst（整個字串）
; ⚠️ 已棄用（DEPRECATED）：賦值 `dst = src` 即為複製語義——所有權分析會在 src
; 後續仍被讀取時自動改寫為深拷貝（OpClone），無需手動 copy。保留僅為兼容。
; dst: 副本（已棄用：直接賦值即深拷貝語義）
; [copy](#str.copy)
str.copy = () (dst str) {
    ; 已棄用：賦值即深拷貝，`dst = .` 走的就是所有權分析的 OpClone。
    dst = .
}

; 用 byte 值填充整個字串
; val: 用於填充整個字串的位元組值
; [fill](#str.fill)
str.fill = (val byte) {
    ; 原地改寫既有位元組，長度不變 —— 這是 _set-byte 真正必要的場景
    ; （若要換內容請建新 str，見 from-chars）。
    i <- [0..self.len-bytes()): {
        ._set-byte(i, val)
    }
}

; UTF-8 解碼公共函數
...

; 從位置 i 解碼一個 UTF-8 碼點
; 返回 cp=碼點值, clen=序列位元組長度（1~4）
; i: 起解碼的位元組下標
; cp: 解出的碼點值
; clen: 該碼點 UTF-8 序列的位元組長度（1~4）
; [decode-cp](#str.decode-cp)
str.decode-cp = (i i64) (cp i64, clen i64) {
    b = .byte(i): {
        ok -> it

        -> _
    }
    cp = b
    clen = 1
    {
        b < 0x80 -> {
            cp = b
            clen = 1
        }

        b < 0xe0 -> {
            cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
            clen = 2
        }

        b < 0xf0 -> {
            cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
            clen = 3
        }

        -> {
            cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
            clen = 4
        }
    }
}

; 查找
...

; str.index: 在 s 中查找 target 子串
; 使用 Sunday 算法，平均 O(n/m)，最壞 O(n*m)
; 返回首次出現的位置，未找到返回 -1
; 內部字節級查找（Sunday 算法）
; 返回 target 首次出現的「字節偏移」，未找到返回 -1
; from-byte 為起始字節位置；split 等內部按字節切片時使用
; target: 要查找的子串
; from-byte: 起始位元組偏移
; pos: target 首次出現的位元組偏移，未找到 -1
; [find-byte-from](#str.find-byte-from)
str.find-byte-from = (target str, from-byte i64) (pos i64) {
    r-from = from-byte

    pos = -1
    r-from < 0 -> r-from = 0
    target.len-bytes() == 0 -> {
        r-from <= .len-bytes() -> pos = r-from
        return
    }
    n = .len-bytes()
    m = target.len-bytes()
    n < m -> return

    #{overflow=wrap}
    limit = n - m
    r-from > limit -> return
    i <- [r-from..limit]: {
        matched = 1
        j <- [0..m): {

            #{overflow=wrap}

            .byte(i + j) != target.byte(j) -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
    }
}

; 內部字節級反向查找
; 返回 target 最後一次出現的「字節偏移」（>= from-byte），未找到返回 -1
; target: 要查找的子串
; from-byte: 反向查找的下界位元組偏移
; pos: target 最後一次出現（>= from-byte）的位元組偏移，未找到 -1
; [rfind-byte-from](#str.rfind-byte-from)
str.rfind-byte-from = (target str, from-byte i64) (pos i64) {
    r-from = from-byte

    pos = -1
    r-from < 0 -> r-from = 0
    {
        target.len-bytes() == 0 -> {
            r-from <= .len-bytes() -> pos = .len-bytes()
            return
        }

        target.len-bytes() > .len-bytes() -> return
    }

    #{overflow=wrap}
    limit = .len-bytes() - target.len-bytes()
    r-from > limit -> return
    i = limit
    (i >= r-from) {
        matched = 1
        j <- [0..target.len-bytes()): {

            #{overflow=wrap}

            .byte(i + j) != target.byte(j) -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }

        #{overflow=wrap}
        i = i - 1
    }
}

; 將字節偏移轉為碼點（字符）下標
; 返回 s[0..byte-pos) 內的碼點數量
; byte-pos: 位元組偏移
; cp: s[0..byte-pos) 內的碼點數量
; [cp-index](#str.cp-index)
str.cp-index = (byte-pos i64) (cp i64) {
    cp = 0
    i <- [0..byte-pos): {
        b = .byte(i)

        #{overflow=wrap}
        b < 0x80 -> {
            {

                #{overflow=wrap}
                cp-opt = cp + 1
                cp-opt: {
                    ok -> cp = it

                    ->
                }
            }
        }

        #{overflow=wrap}
        b >= 0x80 && (b & 0xc0) == 0xc0 -> {
            {

                #{overflow=wrap}
                cp-opt2 = cp + 1
                cp-opt2: {
                    ok -> cp = it

                    ->
                }
            }
        }
    }
}

; 將碼點（字符）下標轉為字節偏移
; 返回第 cp-pos 個碼點起始的字節位置；越界（cp-pos 超出）返回 .len
; cp-pos: 碼點（字符）下標
; byte: 位元組
; [byte-index](#str.byte-index)
str.byte-index = (cp-pos i64) (byte i64) {
    byte = 0
    cp = 0
    (byte < .len-bytes()) {
        cp >= cp-pos -> return
        b = .byte(byte)

        #{overflow=wrap}
        {
            b < 0x80 -> {
                {
                    byte-opt = byte + 1
                    byte-opt: {
                        ok -> byte = it

                        ->
                    }
                }
            }

            -> {

                #{overflow=wrap}
                {
                    b >= 0xf0 -> {
                        {
                            byte-opt2 = byte + 4
                            byte-opt2: {
                                ok -> byte = it

                                ->
                            }
                        }
                    }

                    b >= 0xe0 -> {
                        {
                            byte-opt3 = byte + 3
                            byte-opt3: {
                                ok -> byte = it

                                ->
                            }
                        }
                    }

                    -> {
                        {
                            byte-opt4 = byte + 2
                            byte-opt4: {
                                ok -> byte = it

                                ->
                            }
                        }
                    }
                }
            }
        }

        #{overflow=wrap}
        {

            #{overflow=wrap}
            cp-opt3 = cp + 1
            cp-opt3: {
                ok -> cp = it

                ->
            }
        }
    }
    byte = .len-bytes()
}

; 在 s 中查找 target 子串
; 使用 Sunday 算法，平均 O(n/m)，最壞 O(n*m)
; 返回首次出現的「碼點（字符）位置」，與 s[i] 碼點索引語義一致；未找到返回 -1
; target: 要查找的子串
; pos: 首次出現的碼點位置，未找到 -1
; [index](#str.index)
str.index = (target str) (pos i64) {
    b = .find-byte-from(target, 0)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; 在 s 中從 from（碼點位置）開始查找 target 子串
; 返回首次出現的「碼點（字符）位置」，未找到返回 -1
; target: 要查找的子串
; from: 起始碼點位置（含）
; pos: 首次出現的碼點位置，未找到 -1
; [index-from](#str.index-from)
str.index-from = (target str, from i64) (pos i64) {
    fb = .byte-index(from)
    b = .find-byte-from(target, fb)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; 判斷 s 是否包含 target 子串
; 返回 true=包含, false=不包含
; target: 要查找的子串
; yes: s 是否含有 target
; [contains](#str.contains)
str.contains = (target str) (yes bool) {
    pos = .index(target)
    pos >= 0 -> yes = true
}

; 判斷 s 是否以 target 開頭
; 返回 true=是, false=否
; target: 前綴子串
; yes: s 是否以 target 開頭
; [starts-with](#str.starts-with)
str.starts-with = (target str) (yes bool) {
    yes = true
    target.len-bytes() > .len-bytes() -> {
        yes = false
        return
    }
    i <- [0..target.len-bytes()): {
        si = .byte(i)
        ti = target.byte(i)
        si != ti -> {
            yes = false
            return
        }
    }
}

; 判斷 s 是否以 target 結尾
; 返回 true=是, false=否
; target: 後綴子串
; yes: s 是否以 target 結尾
; [ends-with](#str.ends-with)
str.ends-with = (target str) (yes bool) {
    yes = true
    target.len-bytes() > .len-bytes() -> {
        yes = false
        return
    }

    #{overflow=wrap}
    off = .len-bytes() - target.len-bytes()
    i <- [0..target.len-bytes()): {

        #{overflow=wrap}
        si = .byte(off + i)
        ti = target.byte(i)
        si != ti -> {
            yes = false
            return
        }
    }
}

; 轉換
...

; 將字串轉為大寫
; 返回新字串
; val: 英文小寫轉大寫後的副本（其餘碼點原樣保留）
; [to-upper](#str.to-upper)
str.to-upper = () (val str) {
    n = .len-bytes()
    buf []byte = with-cap-len(n, n)
    i <- [0..n): {
        c = .byte(i)
        {
            c >= 97 && c <= 122 -> {

                #{overflow=wrap}
                buf[i] = c - 32
            }

            -> {
                buf[i] = c
            }
        }
    }
    val = buf.to-bytes-str()
}

; 將字串轉為小寫
; 返回新字串
; val: 英文大寫轉小寫後的副本（其餘碼點原樣保留）
; [to-lower](#str.to-lower)
str.to-lower = () (val str) {
    n = .len-bytes()
    buf []byte = with-cap-len(n, n)
    i <- [0..n): {
        c = .byte(i)
        {
            c >= 65 && c <= 90 -> {

                #{overflow=wrap}
                buf[i] = c + 32
            }

            -> {
                buf[i] = c
            }
        }
    }
    val = buf.to-bytes-str()
}

; 去除字串首尾空白字符
; 返回新字串
; val: 去除首尾空白後的副本
; [trim](#str.trim)
str.trim = () (val str) {
    start <- [0..self.len-bytes()): {
        c = .byte(start)
        c != 32 && c != 9 && c != 10 && c != 13 -> break
    }

    #{overflow=wrap}
    end = .len-bytes() - 1
    (end >= start) {
        c = .byte(end)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        end = end - 1
    }

    #{overflow=wrap}
    n = end - start + 1
    n < 0 -> return
    buf []byte = with-cap-len(n, n)
    i <- [0..n): {

        #{overflow=wrap}
        buf[i] = .byte(start + i)
    }
    val = buf.to-bytes-str()
}

; 重複與切片
...

; 將字串重複 times 次
; 返回新字串
; times: 重複次數（<= 0 得空字串）
; val: 串接 times 份後的副本
; [repeat](#str.repeat)
str.repeat = (times i64) (val str) {

    #{overflow=wrap}
    m = .len-bytes() * times
    buf []byte = with-cap-len(m, m)
    i <- [0..times): {
        j <- [0..self.len-bytes()): {

            #{overflow=wrap}
            buf[i * .len-bytes() + j] = .byte(j)
        }
    }
    val = buf.to-bytes-str()
}

; 截取子串 [start, end)，下標為「字符（碼點）位置」
; 與 s[i] 碼點索引語義一致；要按字節偏移切片請用 s.slice-bytes()
; start: 起始碼點下標（含）
; end: 結束碼點下標（不含）
; val: 按碼點範圍 [start,end) 截取的子串副本
; [slice](#str.slice)
str.slice = (start i64, end i64) (val str) {
    r-start = start
    r-end = end

    ncp = .len()
    r-start < 0 -> r-start = 0
    r-end > ncp -> r-end = ncp
    r-start >= r-end -> return
    sb = .byte-index(r-start)
    eb = .byte-index(r-end)

    #{overflow=wrap}
    n = eb - sb
    buf []byte = with-cap-len(n, n)
    i <- [0..n): {

        #{overflow=wrap}
        buf[i] = .byte(sb + i)
    }
    val = buf.to-bytes-str()
}

; 按「字節偏移」截取子串 [start, end)（內部位元組級使用）
; 與 s.byte(i) 語義一致；標準庫 split/replace 等內部按字節切片時使用
; start: 起始位元組偏移（含）
; end: 結束位元組偏移（不含）
; val: 按位元組範圍 [start,end) 截取的子串副本
; [slice-bytes](#str.slice-bytes)
str.slice-bytes = (start i64, end i64) (val str) {
    r-start = start
    r-end = end

    r-start < 0 -> r-start = 0
    r-end > .len-bytes() -> r-end = .len-bytes()
    r-start >= r-end -> return

    #{overflow=wrap}
    n = r-end - r-start
    buf []byte = with-cap-len(n, n)
    i <- [0..n): {

        #{overflow=wrap}
        buf[i] = .byte(r-start + i)
    }
    val = buf.to-bytes-str()
}

; 類型轉換
...

; 恆等轉換（字串轉字串即自身）
;
; 泛型的 []t.to-str / [n]t.to-str 模板逐元素呼叫 `.[i].to-str()`；元素型別為 str 時
; 就落到本方法。此前 std 沒有它，`['a','b'].to-str()` 在建置期報
; `unknown callee str.to-str`（產生自 _xstr.to-str 轉發樁）。
; str 不可變，回傳自身即可（值語義：共享底層緩衝，不複製）。
; out: 自身（str 不可變，值語義共享底層緩衝、不複製）
; [to-str](#str.to-str)
str.to-str = () (out str) {
    out = .
}

; str.bytes(): 返回底層 UTF-8 位元組的「零拷貝視圖」（實際就是 .data）
; 與 to-bytes() 不同：不分配新緩衝、不逐位元組複製。回傳的 []byte 共享 str 的
; data 緩衝，寫入元素會反映到原字串；視圖的 cap 為 0（借用標記），作用域結束時
; vec_free 會跳過釋放，所有權仍屬原 str。呼叫端須保證 str 活得比視圖久。
; 由編譯器內建處理（#{buildin}）：codegen 攔截後直接由 %str-long 的
; len/data 組出 %vec{len, cap=0, data}，不存在 std 函式體；簽名同時註冊於
; src/builtin/str.go 的 BuiltinMethodList（ForwardFunc "str-bytes"）。
; 注意：直接寫 `val []byte = s.data` 目前是壞的（codegen 會把 data 指標當整個
; 聚合來 load），必須走本方法。
; val: 底層 UTF-8 位元組的借用視圖（長度等於 len-bytes()）
; [bytes](#str.bytes)
#{buildin}
str.bytes = () (val []byte) {
}

; 將字串轉為位元組陣列
; val: 底層 UTF-8 位元組副本
; [to-bytes](#str.to-bytes)
str.to-bytes = () (val []byte) {
    n = .len-bytes()
    ; with-cap-len（而非 with-len）讓下面的下標寫入落在 idxwrite 的 with-cap 豁免內；
    ; 也不能改成 with-cap + push：實測（2026-11-11）`val.push(b)` 寫進 out 參數形態的
    ; []byte 會無限成長（`no run` 被 kill），下標寫入版本正確。
    val = with-cap-len(n, n)
    i <- [0..n): {
        val[i] = .byte(i)
    }
}

; 將字串解析為有號 64 位整數
; 返回 Option：
;   ok(n) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或格式錯誤
; val: ok=解析出的 i64, nil=空字串, err=含非數字字元/孤立 +/-/超範圍
; [to-i64](#str.to-i64)
str.to-i64 = () (val ?i64) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    neg = 0
    c = .byte(0)
    {
        c == 45 -> {
            neg = 1
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone minus')
                return
            }
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    limit = 922337203685477580
    i <- [start..self.len-bytes()): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        d = c - 48
        n > limit -> {
            val = err('out of range for i64')
            return
        }

        #{overflow=wrap}
        n == limit -> {
            neg == 1 -> {

                ; 允許 i64.MIN: -9223372036854775808
                d > 8 -> {
                    val = err('out of range for i64')
                    return
                }
                d == 8 -> {

                    ; 特殊處理 i64.MIN，避免溢出
                    ; 必須是最後一位數字

                    #{overflow=wrap}
                    {
                        i == .len-bytes() - 1 -> {

                            #{overflow=wrap}
                            n = 0 - 922337203685477580

                            n ?= n * 10 - 8
                            val = n
                            return
                        }

                        -> {
                            val = err('out of range for i64')
                            return
                        }
                    }
                }
            }
            d > 7 -> {
                val = err('out of range for i64')
                return
            }
        }

        #{overflow=wrap}
        n = n * 10 + d
    }

    #{overflow=wrap}
    neg == 1 -> {
        {

            #{overflow=wrap}
            n-opt = 0 - n
            n-opt: {
                ok -> n = it

                ->
            }
        }
    }
    val = n
}

; 將字串解析為 i8
; 返回 Option：
;   ok(n) - 成功（-128 ~ 127）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; val: ok=範圍內（-128~127）的 i8, nil=空字串, err=非法或超出範圍
; [to-i8](#str.to-i8)
str.to-i8 = () (val ?i8) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            {
                n >= 0 - 128 && n <= 127 -> val = n

                -> val = err('out of range for i8')
            }
        }
    }
}

; 將字串解析為 i16
; 返回 Option：
;   ok(n) - 成功（-32768 ~ 32767）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; val: ok=範圍內（-32768~32767）的 i16, nil=空字串, err=非法或超出範圍
; [to-i16](#str.to-i16)
str.to-i16 = () (val ?i16) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            {
                n >= 0 - 32768 && n <= 32767 -> val = n

                -> val = err('out of range for i16')
            }
        }
    }
}

; 將字串解析為 i32
; 返回 Option：
;   ok(n) - 成功（-2147483648 ~ 2147483647）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; val: ok=範圍內的 i32, nil=空字串, err=非法或超出範圍
; [to-i32](#str.to-i32)
str.to-i32 = () (val ?i32) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            {
                n >= 0 - 2147483648 && n <= 2147483647 -> val = n

                -> val = err('out of range for i32')
            }
        }
    }
}

; 將字串解析為 u8
; 返回 Option：
;   ok(n) - 成功（0 ~ 255）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; val: ok=範圍內（0~255）的 u8, nil=空字串, err=非法或超出範圍
; [to-u8](#str.to-u8)
str.to-u8 = () (val ?u8) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u8: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..self.len-bytes()): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for u8')
    }
}

; 將字串解析為 u16
; 返回 Option：
;   ok(n) - 成功（0 ~ 65535）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; val: ok=範圍內（0~65535）的 u16, nil=空字串, err=非法或超出範圍
; [to-u16](#str.to-u16)
str.to-u16 = () (val ?u16) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u16: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..self.len-bytes()): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 65535 -> val = n

        -> val = err('out of range for u16')
    }
}

; 將字串解析為 u32
; 返回 Option：
;   ok(n) - 成功（0 ~ 4294967295）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; val: ok=範圍內的 u32, nil=空字串, err=非法或超出範圍
; [to-u32](#str.to-u32)
str.to-u32 = () (val ?u32) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u32: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..self.len-bytes()): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
