; str — 字符串操作标准库
;
; str 是对外统一的字符串类型
; 内部实现：str-long（堆分配）
;
; 切片是視圖，非獨立類型：對 str 進行切片操作（如 s[1..3]）仍產生 str 視圖，
; 共享 str 的底層記憶體，不複製資料。
; 因此 str 的所有方法（to-upper、to-lower、index、contains、slice、copy、fill 等）
; 均適用於 str 的切片視圖。通過切片修改元素會影響原始 str。
;
; str {
;     len i64 read-only       // 对外：i64 长度
;     cap i64 read-only       // 对外：i64 容量（仅 str-long 有效）
;     data *byte sealed       // 对外：数据指针
; }

; ═══════════════════════════════════════════════
; 基础操作
; ═══════════════════════════════════════════════

; string = str | txt —— 字符串族聯合類型別名（對標 number.no 的 num = int | float）
; 用法：函數參數/返回值聲稱 string，調用時傳入 str 或 txt 實參，
; 編譯期按實參具體型別單態化（ValidateUnionTypes + FlattenUnion + clone），
; 每個成員各生成一份具體函數（如 f__str / f__txt）。
; 能力邊界（與 num 完全相同的既有限制）：
;   - 函數體內對 union 參數調用成員方法（s.len()/s.to-upper()）尚不支持
;     （單態化名限定缺陷），請改用全域內建（len(s) 為字節數）或拆成
;     str/txt 兩個具體函數；
;   - 聯合變數聲明（s string = 'x'）尚不支持；
;   - 不要定義 string.len 这类「與成員同名」的別名方法：會接管 s.len()
;     調用且方法體遞迴分发回自身（段錯誤）。成员方法請直接用 str.*/txt.* 原版。
string = str | txt

; str.len-bytes(): 返回字符串的「字節數量」（底層 UTF-8 緩衝區長度）
; 由編譯器內建處理（build-in，等同舊 .len 結構體字段）；標準庫內部位元組級迴圈/切片請用本方法
; build-in
; str.len-bytes = () (n i64) {
;    n = .len
; }

; 返回字符串的「字符（碼點）數量」
; 與 s[i] 的碼點索引語義一致；要字節數請用 s.len-bytes()
; [len](#str.len)
str.len = () (n i64) {
    n = .cp-index(.len-bytes())
}

; str.cap: 返回字符串容量（内置字段访问，s.cap 直接可用）
; 返回堆缓冲区容量
; build-in
; str.cap = () (n int64) {
;    n = .cap
; }

; 返回「位元組」下標 i 處的原始位元組值（raw byte 讀取）
; 與 s[i] 不同：s[i] 按碼點索引，本方法按底層 UTF-8 緩衝區的位元組偏移取值
; 回傳 ?byte：越界（i < 0 或 i >= len-bytes()）時回傳 nil，與 arr[i] 的
; 安全索引語義一致；呼叫端必須處理 option（match / ?= / #{index-out = DEF}）
; 由編譯器內建處理（#{buildin}）：codegen 攔截後展開為「邊界檢查 + GEP+load」，
; 不存在 std 函式體；簽名同時註冊於 src/builtin/str.go 的 BuiltinMethodList
; （MethodName "byte"，Intercepted，經 bare-name 回落同時覆蓋 str 與 txt）
; [byte](#str.byte)
#{buildin}
str.byte = (i i64) (c ?byte) {
}

;
; 在「位元組」下標 i 處寫入原始位元組 b（raw byte 寫入，長度不變）
; str.byte 的配對寫者；緩衝區逐位元組構建專用（注意 s[i] = v 是位元組級寫入、
; txt[i] = v 是按碼點重新編碼，語意都不同）
;
; b 宣告為 byte：表層實參若是 option（.byte(i) 等）由內建參數檢查直接放過
; （funcargs.go 的 `?` 跳過）；若為純 i64/char 則在呼叫端以遮罩 `& 255` 窄化。
; 這與 src/builtin/str.go 的 BuiltinMethodList 條目一致。
;
; 回傳 ?bool（可失敗）：越界（i < 0 或 i >= 實體容量 cap）時回傳 nil 並**跳過寫入**，
; 成功回傳 some(true)。邊界以 %str-long 的 cap（實體容量）為準而非 len，故「先填缓冲
; 再 set len」的構建程式照舊可用。呼叫端以裸陳述丟棄 ?bool 合法（optunuse 只管綁定名）。
; [set-byte](#str.set-byte)
#{buildin}
str.set-byte = (i i64, b byte) (ok ?bool) {
}

; str.eq: 比较两个字符串的前 n 个字节是否相等
; 返回 true=相等, false=不相等
; [eq-raw](#str.eq-raw)
#{buildin}
eq-raw = (b str, n i64) (eq bool) {
}

; 将 src 复制到 dst（整個字串）
; ⚠️ 已棄用（DEPRECATED）：賦值 `dst = src` 即為複製語義——所有權分析會在 src
; 後續仍被讀取時自動改寫為深拷貝（OpClone），無需手動 copy。保留僅為兼容。
; [copy](#str.copy)
str.copy = () (dst str) {
    dst = with-cap(.len-bytes())
    i <- [0...len-bytes()): {

        dst[i] = .byte(i)
    }
}

; 用 byte 值填充整個字串
; [fill](#str.fill)
str.fill = (val byte) {
    i <- [0...len-bytes()): {
        .[i] = val
    }
}

; ═══════════════════════════════════════════════
; UTF-8 解碼公共函數
; ═══════════════════════════════════════════════

; 從位置 i 解碼一個 UTF-8 碼點
; 返回 cp=碼點值, clen=序列位元組長度（1~4）
; [decode-cp](#str.decode-cp)
str.decode-cp = (i i64) (cp i64, clen i64) {
    b-opt = .byte(i)
    b = b-opt: {
        ok -> it

        -> _
    }
    cp = b
    clen = 1
    {
        b < 0x80 -> {
            cp = b
            clen = 1
        }

        b < 0xe0 -> {
            cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
            clen = 2
        }

        b < 0xf0 -> {
            cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
            clen = 3
        }

        -> {
            cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
            clen = 4
        }
    }
}

; ═══════════════════════════════════════════════
; 查找
; ═══════════════════════════════════════════════

; str.index: 在 s 中查找 target 子串
; 使用 Sunday 算法，平均 O(n/m)，最壞 O(n*m)
; 返回首次出現的位置，未找到返回 -1
; 內部字節級查找（Sunday 算法）
; 返回 target 首次出現的「字節偏移」，未找到返回 -1
; from-byte 為起始字節位置；split 等內部按字節切片時使用
; [find-byte-from](#str.find-byte-from)
str.find-byte-from = (target str, from-byte i64) (pos i64) {
    r-from = from-byte

    pos = -1
    r-from < 0 -> r-from = 0
    target.len-bytes() == 0 -> {
        r-from <= .len-bytes() -> pos = r-from
        return
    }
    n = .len-bytes()
    m = target.len-bytes()
    n < m -> return

    #{overflow=wrap}
    limit = n - m
    r-from > limit -> return
    i <- [r-from..limit]: {

        matched = 1
        j <- [0..m): {

            #{overflow=wrap}

            .byte(i + j) != target.byte(j) -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
    }
}

; 內部字節級反向查找
; 返回 target 最後一次出現的「字節偏移」（>= from-byte），未找到返回 -1
; [rfind-byte-from](#str.rfind-byte-from)
str.rfind-byte-from = (target str, from-byte i64) (pos i64) {
    r-from = from-byte

    pos = -1
    r-from < 0 -> r-from = 0
    {
        target.len-bytes() == 0 -> {
            r-from <= .len-bytes() -> pos = .len-bytes()
            return
        }

        target.len-bytes() > .len-bytes() -> return
    }

    #{overflow=wrap}
    limit = .len-bytes() - target.len-bytes()
    r-from > limit -> return
    i = limit
    (i >= r-from) {

        matched = 1
        j <- [0..target.len-bytes()): {

            #{overflow=wrap}

            .byte(i + j) != target.byte(j) -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }

        #{overflow=wrap}
        i = i - 1
    }
}

; 將字節偏移轉為碼點（字符）下標
; 返回 s[0..byte-pos) 內的碼點數量
; [cp-index](#str.cp-index)
str.cp-index = (byte-pos i64) (cp i64) {
    cp = 0
    i <- [0..byte-pos): {

        b = .byte(i)

        #{overflow=wrap}
        b < 0x80 -> cp = cp + 1

        #{overflow=wrap}
        b >= 0x80 && (b & 0xc0) == 0xc0 -> cp = cp + 1
    }
}

; 將碼點（字符）下標轉為字節偏移
; 返回第 cp-pos 個碼點起始的字節位置；越界（cp-pos 超出）返回 .len
; [byte-index](#str.byte-index)
str.byte-index = (cp-pos i64) (byte i64) {
    byte = 0
    cp = 0
    (byte < .len-bytes()) {

        cp >= cp-pos -> return
        b = .byte(byte)

        #{overflow=wrap}
        {
            b < 0x80 -> byte = byte + 1

            -> {

                #{overflow=wrap}
                b >= 0xf0 -> byte = byte + 4

                b >= 0xe0 -> byte = byte + 3

                -> byte = byte + 2
            }
        }

        #{overflow=wrap}
        cp = cp + 1
    }
    byte = .len-bytes()
}

; 在 s 中查找 target 子串
; 使用 Sunday 算法，平均 O(n/m)，最壞 O(n*m)
; 返回首次出現的「碼點（字符）位置」，與 s[i] 碼點索引語義一致；未找到返回 -1
; [index](#str.index)
str.index = (target str) (pos i64) {
    b = .find-byte-from(target, 0)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; 在 s 中從 from（碼點位置）開始查找 target 子串
; 返回首次出現的「碼點（字符）位置」，未找到返回 -1
; [index-from](#str.index-from)
str.index-from = (target str, from i64) (pos i64) {
    fb = .byte-index(from)
    b = .find-byte-from(target, fb)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; 判断 s 是否包含 target 子串
; 返回 true=包含, false=不包含
; [contains](#str.contains)
str.contains = (target str) (yes bool) {
    pos = .index(target)
    pos >= 0 -> yes = true
}

; 判断 s 是否以 target 开头
; 返回 true=是, false=否
; [starts-with](#str.starts-with)
str.starts-with = (target str) (yes bool) {
    yes = true
    target.len-bytes() > .len-bytes() -> {
        yes = false
        return
    }
    i <- [0..target.len-bytes()): {
        si = .byte(i)
        ti = target.byte(i)
        si != ti -> {
            yes = false
            return
        }
    }
}

; 判断 s 是否以 target 结尾
; 返回 true=是, false=否
; [ends-with](#str.ends-with)
str.ends-with = (target str) (yes bool) {

    yes = true
    target.len-bytes() > .len-bytes() -> {
        yes = false
        return
    }

    #{overflow=wrap}
    off = .len-bytes() - target.len-bytes()
    i <- [0..target.len-bytes()): {

        #{overflow=wrap}
        si = .byte(off + i)
        ti = target.byte(i)
        si != ti -> {
            yes = false
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 转换
; ═══════════════════════════════════════════════

; 将字符串转为大写
; 返回新字符串
; [to-upper](#str.to-upper)
str.to-upper = () (val str) {
    val = with-cap(.len-bytes())
    i <- [0...len-bytes()): {
        c = .byte(i)
        {
            c >= 97 && c <= 122 -> {

                #{overflow=wrap}
                val[i] = c - 32
            }

            -> {
                val[i] = c
            }
        }
    }
}

; 将字符串转为小写
; 返回新字符串
; [to-lower](#str.to-lower)
str.to-lower = () (val str) {
    val = with-cap(.len-bytes())
    i <- [0...len-bytes()): {
        c = .byte(i)
        {
            c >= 65 && c <= 90 -> {

                #{overflow=wrap}
                val[i] = c + 32
            }

            -> {
                val[i] = c
            }
        }
    }
}

; 去除字符串首尾空白字符
; 返回新字符串
; [trim](#str.trim)
str.trim = () (val str) {
    start <- [0...len-bytes()): {

        c = .byte(start)
        c != 32 && c != 9 && c != 10 && c != 13 -> break
    }

    #{overflow=wrap}
    end = .len-bytes() - 1
    (end >= start) {

        c = .byte(end)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        end = end - 1
    }

    #{overflow=wrap}
    n = end - start + 1
    n < 0 -> return
    val = with-cap(n)
    i <- [0..n): {

        #{overflow=wrap}
        val[i] = .byte(start + i)
    }
}

; ═══════════════════════════════════════════════
; 重复与切片
; ═══════════════════════════════════════════════

; 将字符串重复 times 次
; 返回新字符串
; [repeat](#str.repeat)
str.repeat = (times i64) (val str) {

    #{overflow=wrap}
    val = with-cap(.len-bytes() * times)
    i <- [0..times): {
        j <- [0...len-bytes()): {

            #{overflow=wrap}
            val[i * .len-bytes() + j] = .byte(j)
        }
    }
}

; 截取子串 [start, end)，下標為「字符（碼點）位置」
; 與 s[i] 碼點索引語義一致；要按字節偏移切片請用 s.slice-bytes()
; [slice](#str.slice)
str.slice = (start i64, end i64) (val str) {
    r-start = start
    r-end = end

    ncp = .len()
    r-start < 0 -> r-start = 0
    r-end > ncp -> r-end = ncp
    r-start >= r-end -> return
    sb = .byte-index(r-start)
    eb = .byte-index(r-end)

    #{overflow=wrap}
    n = eb - sb
    val = with-cap(n)
    i <- [0..n): {

        #{overflow=wrap}
        val[i] = .byte(sb + i)
    }
}

; 按「字節偏移」截取子串 [start, end)（內部位元組級使用）
; 與 s.byte(i) 語義一致；標準庫 split/replace 等內部按字節切片時使用
; [slice-bytes](#str.slice-bytes)
str.slice-bytes = (start i64, end i64) (val str) {
    r-start = start
    r-end = end

    r-start < 0 -> r-start = 0
    r-end > .len-bytes() -> r-end = .len-bytes()
    r-start >= r-end -> return

    #{overflow=wrap}
    n = r-end - r-start
    val = with-cap(n)
    i <- [0..n): {

        #{overflow=wrap}
        val[i] = .byte(r-start + i)
    }
}

; ═══════════════════════════════════════════════
; 类型转换
; ═══════════════════════════════════════════════

; 恆等轉換（字串轉字串即自身）
;
; 泛型的 []t.to-str / [n]t.to-str 模板逐元素呼叫 `.[i].to-str()`；元素型別為 str 時
; 就落到本方法。此前 std 沒有它，`['a','b'].to-str()` 在建置期報
; `unknown callee str.to-str`（產生自 _xstr.to-str 轉發樁）。
; str 不可變，回傳自身即可（值語義：共享底層緩衝，不複製）。
; [to-str](#str.to-str)
str.to-str = () (out str) {
    out = .
}

; 将字符串转为字节数组
; [to-bytes](#str.to-bytes)
str.to-bytes = () (val []byte) {
    val = with-len(.len-bytes())
    i <- [0...len-bytes()): {

        val[i] = .byte(i)
    }
}

; 將字串解析為有號 64 位整數
; 返回 Option：
;   ok(n) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或格式錯誤
; [to-i64](#str.to-i64)
str.to-i64 = () (val ?i64) {

    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    neg = 0
    c = .byte(0)
    {
        c == 45 -> {
            neg = 1
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone minus')
                return
            }
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    limit = 922337203685477580
    i <- [start...len-bytes()): {

        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        d = c - 48
        n > limit -> {
            val = err('out of range for i64')
            return
        }

        #{overflow=wrap}
        n == limit -> {
            neg == 1 -> {

                ; 允許 i64.MIN: -9223372036854775808
                d > 8 -> {
                    val = err('out of range for i64')
                    return
                }
                d == 8 -> {

                    ; 特殊處理 i64.MIN，避免溢出
                    ; 必須是最後一位數字

                    #{overflow=wrap}
                    i == .len-bytes() - 1 -> {

                        #{overflow=wrap}
                        n = 0 - 922337203685477580

                        n = n * 10 - 8
                        val = n
                        return
                    }

                    -> {
                        val = err('out of range for i64')
                        return
                    }
                }
            }
            d > 7 -> {
                val = err('out of range for i64')
                return
            }
        }

        #{overflow=wrap}
        n = n * 10 + d
    }

    #{overflow=wrap}
    neg == 1 -> n = 0 - n
    val = n
}

; 將字串解析為 i8
; 返回 Option：
;   ok(n) - 成功（-128 ~ 127）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; [to-i8](#str.to-i8)
str.to-i8 = () (val ?i8) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            n >= 0 - 128 && n <= 127 -> val = n

            -> val = err('out of range for i8')
        }
    }
}

; 將字串解析為 i16
; 返回 Option：
;   ok(n) - 成功（-32768 ~ 32767）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; [to-i16](#str.to-i16)
str.to-i16 = () (val ?i16) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            n >= 0 - 32768 && n <= 32767 -> val = n

            -> val = err('out of range for i16')
        }
    }
}

; 將字串解析為 i32
; 返回 Option：
;   ok(n) - 成功（-2147483648 ~ 2147483647）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; [to-i32](#str.to-i32)
str.to-i32 = () (val ?i32) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            n >= 0 - 2147483648 && n <= 2147483647 -> val = n

            -> val = err('out of range for i32')
        }
    }
}

; 將字串解析為 u8
; 返回 Option：
;   ok(n) - 成功（0 ~ 255）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; [to-u8](#str.to-u8)
str.to-u8 = () (val ?u8) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u8: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len-bytes()): {

        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for u8')
    }
}

; 將字串解析為 u16
; 返回 Option：
;   ok(n) - 成功（0 ~ 65535）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; [to-u16](#str.to-u16)
str.to-u16 = () (val ?u16) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u16: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len-bytes()): {

        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 65535 -> val = n

        -> val = err('out of range for u16')
    }
}

; 將字串解析為 u32
; 返回 Option：
;   ok(n) - 成功（0 ~ 4294967295）
;   nil    - 空字串
;   err('msg') - 含非數字字元、孤立 +/- 或超出範圍
; [to-u32](#str.to-u32)
str.to-u32 = () (val ?u32) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u32: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len-bytes()): {

        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 4294967295 -> val = n

        -> val = err('out of range for u32')
    }
}

; 將字串解析為 u64
; 拒絕負號；不檢查 i64 範圍溢位（截斷由 LLVM 自動處理）
; [to-u64](#str.to-u64)
str.to-u64 = () (val ?u64) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    c = .byte(0)
    c == 45 -> {
        val = err('invalid u64: negative sign not allowed')
        return
    }
    n = 0
    start = 0
    c == 43 -> start = 1
    i <- [start...len-bytes()): {

        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    val = n
}

; 將字串解析為 byte（與 u8 等價）
; 返回 Option：
;   ok(n) - 成功（0 ~ 255）
;   nil    - 空字串
;   err('msg') - 含非數字字元、負號或超出範圍
; [to-byte](#str.to-byte)
str.to-byte = () (val ?byte) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid byte: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start...len-bytes()): {

        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for byte')
    }
}

; str-to-f64: 將字串精確解析為 f64（bigint 精確 strtod）
; 以 bigint 建立精確有理數 int-mant * 10^K，再求最近可表示 f64（捨入至偶），
; 取代原本 f64 累積（17 位字面量會差 1 ULP）。支援 [+-][數字][.數字][eE[+-]數字]。

; 回傳正 bigint 的位元長度（floor(log2)+1）
; [bigint-bitlen](#str.bigint-bitlen)
bigint-bitlen = (b bigint) (out i64) {
    bm = 4294967295
    out = (b.len - 1) * 32
    top = (b.limbs[b.len - 1] & bm)
    sh = 0
    t = top
    (t > 0) {
        t = t >> 1
        sh = sh + 1
    }
    out = out + sh
}

str-to-f64 = (s str) (result f64) {

    n i64 = s.len-bytes()
    n == 0 -> return
    i = 0
    sign = 1
    has-digit = 0
    int-mant bigint = bigint.zero()
    ten bigint = bigint.from-i64(10)
    frac-count = 0
    exp-val = 0
    exp-sign = 1
    c = 0

    ; 跳過前導空白
    (i < n) {
        c = s.byte(i)
        {
            c == 32 || c == 9 || c == 10 || c == 13 -> i = i + 1

            -> break
        }
    }
    i >= n -> return

    ; 正負號
    c = s.byte(i)
    {
        c == 45 -> {
            sign = -1
            i = i + 1
        }

        c == 43 -> i = i + 1
    }

    ; 整數部分 → int-mant = int-mant * 10 + digit
    (i < n) {
        c = s.byte(i)
        {
            c >= 48 && c <= 57 -> {

                ; 逐位累積走公開 bigint 方法鏈，而非 `int-mant * 10 + dig`：
                ; 後者在「迴圈 + match 臂的巢狀 block」裡目前不會把運算符重載的
                ; bigint 結果寫回變數（實測恆為 0），故用具體方法形式。
                dig = bigint.from-i64(c - 48)
                int-mant = int-mant.mul-bigint(ten).add-bigint(dig)
                has-digit = 1
                i = i + 1
            }

            -> break
        }
    }

    ; 小數部分 → int-mant = int-mant * 10 + digit; frac-count++
    (i < n) {
        c = s.byte(i)
        c == 46 -> {
            i = i + 1
            (i < n) {
                c = s.byte(i)
                {
                    c >= 48 && c <= 57 -> {

                        ; 同整數部分：巢狀 block 裡用公開方法鏈累積。
                        dig = bigint.from-i64(c - 48)
                        int-mant = int-mant.mul-bigint(ten).add-bigint(dig)
                        frac-count = frac-count + 1
                        has-digit = 1
                        i = i + 1
                    }

                    -> break
                }
            }
        }

        -> break
    }
    has-digit == 0 -> return

    ; 指數部分
    (i < n) {
        c = s.byte(i)
        c == 101 || c == 69 -> {
            i = i + 1
            (i < n) {
                c = s.byte(i)
                c == 45 -> {
                    exp-sign = -1
                    i = i + 1
                }
                c == 43 -> i = i + 1

                -> break
            }
            (i < n) {
                c = s.byte(i)
                {
                    c >= 48 && c <= 57 -> {

                        #{overflow=wrap}
                        exp-val = exp-val * 10 + (c - 48)
                        i = i + 1
                    }

                    -> break
                }
            }
        }

        -> break
    }

    ; exp-adj = exp-val * exp-sign - frac-count：精確有理數 = int-mant * 10^exp-adj
    exp-adj = exp-val * exp-sign - frac-count

    num = bigint.copy(int-mant)
    den = bigint.one()
    (exp-adj >= 0) -> {
        t10 bigint = bigint.from-i64(10)
        num = int-mant.mul-bigint(t10.pow(exp-adj))
    }

    -> {
        t10d bigint = bigint.from-i64(10)
        den = t10d.pow(0 - exp-adj)
    }

    ; 零值特例（含 -0.0）
    (num.is-zero()) -> {
        result = 0.0
        (sign < 0) -> result = -result
        return
    }

    ; e = floor(log2(num/den))
    nbl = bigint-bitlen(num)
    dbl = bigint-bitlen(den)

    #{overflow=wrap}
    e = nbl - dbl
    {
        e >= 0 -> {
            (bigint.shl(den, e).cmp(num) > 0) -> e = e - 1
        }

        -> {
            (bigint.shl(num, 0 - e).cmp(den) < 0) -> e = e - 1
        }
    }

    ; 超出上界 → ±inf
    (e > 1023) -> {
        result = 1.0
        (result * 2.0 != result) {
            result = result * 2.0
        }
        (sign < 0) -> result = -result
        return
    }

    two52 = bigint.from-i64(4503599627370496)
    two53 = bigint.from-i64(9007199254740992)
    one = bigint.one()
    two = bigint.from-i64(2)

    ; 次正規：value = F * 2^-1074（F 為 52-bit 分數）
    (e < -1022) -> {
        num-s = bigint.shl(num, 1074)
        qS, rS = num-s.div-mod(den)
        two-r = bigint.shl(rS, 1)
        c2 = two-r.cmp(den)
        fb-q = qS
        (c2 > 0) -> fb-q = qS.add-bigint(one)
        (c2 == 0) -> {

            ; 取奇偶：公開 div-mod 的餘數恆落在 {0,1}，用 is-zero 判別即可，
            ; 不必把 bigint 拆回 i64，也不碰 bigint 的私有快速路徑。
            _, qm = qS.div-mod(two)
            (qm.is-zero()) -> fb-q = qS

            -> fb-q = qS.add-bigint(one)
        }
        _, frac-b = fb-q.div-mod(two52)
        frac-i64 ?i64 = frac-b.to-i64()
        inv1074f f64 = 1.0
        j = 0
        (j < 1074) {
            inv1074f = inv1074f / 2.0
            j = j + 1
        }
        frac-f64 f64 = frac-i64: {
            ok -> it.to-f64()

            -> _
        }
        result = frac-f64 * inv1074f
        (sign < 0) -> result = -result
        return
    }

    ; 正規：value = (1 + m/2^52) * 2^e（m 為 52-bit 分數）
    (e >= 0) -> {
        num-s = bigint.shl(num, 52)
        den-s = bigint.shl(den, e)
    }

    -> {
        num-s = bigint.shl(num, 52 - e)
        den-s = den.copy()
    }
    qw, rw = num-s.div-mod(den-s)
    two-r = bigint.shl(rw, 1)
    c2 = two-r.cmp(den-s)
    wv = qw
    (c2 > 0) -> wv = qw.add-bigint(one)
    (c2 == 0) -> {

        ; 同次正規分支：奇偶判別走公開 div-mod + is-zero，不碰 bigint 私有快速路徑。
        _, qm2 = qw.div-mod(two)
        (qm2.is-zero()) -> wv = qw

        -> wv = qw.add-bigint(one)
    }

    ; 溢位保護：wv >= 2^53 ⇒ e+1, m=0（最終由 scale 迴圈得 inf）
    (wv.cmp(two53) >= 0) -> {
        e = e + 1
        wv = two52.copy()
    }

    ; m = (wv - 2^52) % 2^52，且 wv >= 2^52（本分支 wv = round((num/den)·2^(52-e))
    ; = 2^52 + m），故餘數非負且恆 < 2^52，必落在 i64 值域內；
    ; to-i64 是取回 i64 的公開出口（值域守衛見 bigint.no）。
    mw = wv.sub-bigint(two52)
    _, mb = mw.div-mod(two52)
    m ?i64 = mb.to-i64()
    mv = m: {
        ok -> it.to-f64()

        -> _
    }
    two52f = 1.0
    k = 0
    (k < 52) {
        two52f = two52f * 2.0
        k = k + 1
    }
    val-f = 1.0 + (mv / two52f)
    scale = 1.0
    (e > 0) {
        scale = scale * 2.0
        e = e - 1
    }
    (e < 0) {
        scale = scale / 2.0
        e = e + 1
    }
    result = val-f * scale
    (sign < 0) -> result = -result
}

; 將字串解析為 f64
; 返回 Option：
;   ok(f) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元
; 使用 Nolang 實作 str-to-f64 進行解析（已移除 strtod CLibCall 依賴）
; [to-f64](#str.to-f64)
str.to-f64 = () (val ?f64) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }

    ; 簡易驗證：至少含一個數字字元
    has-digit = 0
    start = 0
    c = .byte(0)
    c == 45 || c == 43 -> start = 1
    i <- [start...len-bytes()): {
        c = .byte(i)
        {
            c >= 48 && c <= 57 -> has-digit = 1

            c == 46 -> {
                ; 小數點 - 允許
            }

            c == 101 || c == 69 -> {
                ; 科學記號 e/E - 允許
            }

            c == 43 || c == 45 -> {
                ; 正負號（首位或指數位）- 允許
            }

            c == 32 || c == 9 || c == 10 || c == 13 -> {
                ; 前後空白 - 允許（str-to-f64 自行跳過）
            }

            -> {
                val = err('invalid float')
                return
            }
        }
    }
    has-digit == 0 -> {
        val = nil
        return
    }

    ; 呼叫 Nolang 實作 str-to-f64 進行解析
    f = str-to-f64(.)
    val = f
}

; 將字串解析為 f32
; 返回 Option：
;   ok(f) - 成功
;   nil    - 空字串
;   err('msg') - 含非數字字元
; 使用 Nolang 實作 str-to-f64 + f64-to-f32（已移除 strtod CLibCall 依賴）
; [to-f32](#str.to-f32)
str.to-f32 = () (val ?f32) {
    f = .to-f64()
    {
        f == nil -> {
            val = nil
            return
        }

        f == err -> {
            val = err('str.to-f32: parse error')
            return
        }
    }
    val = f.to-f32()
}

; 將字串 "true" / "false" 解析為 bool
; 大小寫敏感；空字串 → nil，其他 → err
; 使用逐字節比較以避免 strcmp 在跨函數呼叫時的記憶體問題
; [to-bool](#str.to-bool)
str.to-bool = () (val ?bool) {
    {
        .len-bytes() == 0 -> {
            val = nil
            return
        }

        .len-bytes() == 4 -> {

            ; 比較 "true" (4 bytes)
            .byte(0) == 116 && .byte(1) == 114 && .byte(2) == 117 && .byte(3) == 101 -> {
                val = true
                return
            }
        }

        .len-bytes() == 5 -> {

            ; 比較 "false" (5 bytes)
            .byte(0) == 102 && .byte(1) == 97 && .byte(2) == 108 && .byte(3) == 115 && .byte(4) == 101 -> {
                val = false
                return
            }
        }
    }
    val = err('not a bool')
}

; ═══════════════════════════════════════════════
; 反转与比较
; ═══════════════════════════════════════════════

; 反转字符串
; 将 s 反转后写入 val
; [reverse](#str.reverse)
str.reverse = () (val str) {
    val = with-cap(.len-bytes())
    i <- [0...len-bytes()): {

        #{overflow=wrap}
        val[i] = .byte(.len-bytes() - 1 - i)
    }
}

; 字典序比较两个字符串
; 返回 -1(a<b), 0(相等), 1(a>b)
; [compare](#str.compare)
str.compare = (b str) (r i64) {
    an = .len-bytes()
    bn = b.len-bytes()
    min-n = an
    bn < min-n -> min-n = bn
    i <- [0..min-n): {
        ai = .byte(i)
        bi = b.byte(i)
        {
            ai < bi -> {
                r = -1
                return
            }

            ai > bi -> {
                r = 1
                return
            }
        }
    }
    {
        an < bn -> r = -1

        an > bn -> r = 1

        -> r = 0
    }
}

; ═══════════════════════════════════════════════
; 统计
; ═══════════════════════════════════════════════

; 统计字串中的 char（code point）數量
; 因為 .len 已經是 byte 數，count 提供 code point 數
; [count](#str.count)
str.count = () (cnt i64) {
    cnt = 0
    i = 0
    (i < .len-bytes()) {
        b = .byte(i)

        #{overflow=wrap}
        {
            b < 0x80 -> i = i + 1

            b < 0xe0 -> i = i + 2

            b < 0xf0 -> i = i + 3

            -> i = i + 4
        }

        #{overflow=wrap}
        cnt = cnt + 1
    }
}

; ═══════════════════════════════════════════════
; 替换
; ═══════════════════════════════════════════════

; 将 s 中所有 old-ch 替换为 new-ch（UTF-8 码点）
; 返回结果字符串
; [replace-char](#str.replace-char)
str.replace-char = (old-ch char, new-ch char) (val str) {

    ; 第一遍：計算輸出長度
    out-n = 0
    i = 0
    (i < .len-bytes()) {
        b-opt = .byte(i)
        b = b-opt: {
            ok -> it

            -> _
        }
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        {
            cp == old-ch -> {

                #{overflow=wrap}
                new-ch < 0x80 -> out-n = out-n + 1
                new-ch < 0x800 -> out-n = out-n + 2
                new-ch < 0x10000 -> out-n = out-n + 3

                -> out-n = out-n + 4
            }

            -> out-n = out-n + clen
        }

        #{overflow=wrap}
        i = i + clen
    }

    ; 第二遍：写入输出
    val str = with-cap(out-n)
    j = 0
    i = 0
    (i < .len-bytes()) {
        b-opt = .byte(i)
        b = b-opt: {
            ok -> it

            -> _
        }
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        {
            cp == old-ch -> {
                new-ch < 0x80 -> {
                    val[j] = new-ch
                    j = j + 1
                }

                new-ch < 0x800 -> {
                    val[j] = 0xc0 | ((new-ch >> 6) & 0x1f)
                    val[j + 1] = 0x80 | (new-ch & 0x3f)
                    j = j + 2
                }

                new-ch < 0x10000 -> {
                    val[j] = 0xe0 | ((new-ch >> 12) & 0x0f)
                    val[j + 1] = 0x80 | ((new-ch >> 6) & 0x3f)
                    val[j + 2] = 0x80 | (new-ch & 0x3f)
                    j = j + 3
                }

                -> {
                    val[j] = 0xf0 | ((new-ch >> 18) & 0x07)
                    val[j + 1] = 0x80 | ((new-ch >> 12) & 0x3f)
                    val[j + 2] = 0x80 | ((new-ch >> 6) & 0x3f)
                    val[j + 3] = 0x80 | (new-ch & 0x3f)
                    j = j + 4
                }
            }

            -> {
                k <- [0..clen): {

                    #{overflow=wrap}
                    val[j + k] = .byte(i + k)
                }

                #{overflow=wrap}
                j = j + clen
            }
        }

        #{overflow=wrap}
        i = i + clen
    }
}

; ═══════════════════════════════════════════════
; 裁剪（指定字符）
; ═══════════════════════════════════════════════

; 去除字符串首尾指定字符（UTF-8 码点）
; [trim-char](#str.trim-char)
str.trim-char = (ch char) (val str) {

    ; 前向裁剪：跳过所有等于 ch 的 code point
    start = 0
    (start < .len-bytes()) {
        b-opt = .byte(start)
        b = b-opt: {
            ok -> it

            -> _
        }
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(start + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(start + 1) & 0x3f) << 6) | (.byte(start + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(start + 1) & 0x3f) << 12) | ((.byte(start + 2) & 0x3f) << 6) | (.byte(start + 3) & 0x3f)
                clen = 4
            }
        }
        cp != ch -> break

        #{overflow=wrap}
        start = start + clen
    }

    ; 後向裁剪：從 start 開始掃描，找到最後一個不等於 ch 的 code point 的結束位置
    end = start
    i = start
    (i < .len-bytes()) {
        b-opt = .byte(i)
        b = b-opt: {
            ok -> it

            -> _
        }
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        cp != ch -> end = i + clen

        #{overflow=wrap}
        i = i + clen
    }

    #{overflow=wrap}
    n = end - start
    n < 0 -> return
    val str = with-len(n)
    j <- [0..n): {

        #{overflow=wrap}
        val[j] = .byte(start + j)
    }
}

; ═══════════════════════════════════════════════
; 判空
; ═══════════════════════════════════════════════

; 判断字符串是否为空
; 返回 true=空, false=非空
; [empty](#str.empty)
str.empty = () (yes bool) {
    yes = true
    .len-bytes() != 0 -> yes = false
}

; str.clear: 清空字符串（原地修改长度为 0）
; 不 free 堆、不改变 cap/ptr，仅 len=0
; 只有写入带长度新内容（拼接、赋值非空字符串、填充等）时，才走扩容/缩容逻辑
; build-in
; str.clear = () { }

; str.truncate: 原地截斷字串至至多 n 個位元組（len = min(len, n)）
; 不 free 堆、不改变 cap/ptr，仅调整 len
; 替代低阶 s.len = n 写法（验证器拒绝直接修改 .len）
; build-in
; str.truncate = (n i64) { }

; 全局函数 with-cap / with-len / with-cap-len 的声明已移至 global.no

; ═══════════════════════════════════════════════
; 便捷构造方法（方法形式的全局 with-cap / with-len / with-cap-len）
; ═══════════════════════════════════════════════

; 建立指定容量的新字串（len=0）
;   s = ''.with-cap(256)  → 預分配 256 位元組的空字串
; 便捷方法，等同全域 with-cap(cap)
; [with-cap](#str.with-cap)
str.with-cap = (cap i64) (out str) {
    out = with-cap(cap)
}

; 建立指定長度的字串
;   s = ''.with-len(10)  → 長度為 10 的字串
; 便捷方法，等同全域 with-len(len)
; [with-len](#str.with-len)
str.with-len = (len i64) (out str) {
    out = with-len(len)
}

; 建立指定長度和容量的字串
;   s = ''.with-len-cap(10, 256)  → 長度 10、容量 256 的字串
; 便捷方法，等同全域 with-cap-len(cap, len)
; [with-len-cap](#str.with-len-cap)
str.with-len-cap = (len i64, cap i64) (out str) {
    out = with-cap-len(cap, len)
}

; str.new: 從 char 切片構造 str（模組級構造器）
; 編譯期內建（ForwardFunc: chars-new）：[]char 直接逐位元組轉成 bytes 並一次性設定長度，
; 無逐位元組 .no 迴圈。str 是內建類型，位元組/長度無法在用戶代碼裡操作，故整體轉換由編譯器生成 IR。
; [new](#str.new)
#{buildin}
new = (cs []char) (s str) {
}

; ═══════════════════════════════════════════════
; 十六進制解碼
; ═══════════════════════════════════════════════

; 單個十六進制字元轉數值
; 無效字元回傳 -1（原名 hex-val 與 uuid.hex-val 撞名，跨模組解析會被要求限定，改掛模組前綴同 txt-hex-val 慣例）
; [str-hex-val](#str.str-hex-val)
str-hex-val = (c i64) (v i64) {
    v = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            v = c - 48
            return
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            v = c - 65 + 10
            return
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            v = c - 97 + 10
        }
    }
}

; 將十六進制字串解碼為 []byte
; 返回 Option：
;   ok(bytes) - 成功
;   nil        - 空字串
;   err('msg') - 含無效十六進制字元
; [from-hex](#str.from-hex)
str.from-hex = () (out ?[]byte) {
    n = .len-bytes()
    n == 0 -> {
        out = nil
        return
    }
    n % 2 != 0 -> {
        out = err('odd-length hex string')
        return
    }

    #{overflow=wrap}
    half = n / 2
    buf []byte = with-len(half)
    out = buf
    i <- [0..half): {

        #{overflow=wrap}
        hi = str-hex-val(.byte(i * 2))

        #{overflow=wrap}
        lo = str-hex-val(.byte(i * 2 + 1))
        hi < 0 || lo < 0 -> {
            out = err('invalid hex character')
            return
        }
        out[i] = (hi << 4) | lo
    }
}

; ═══════════════════════════════════════════════
; 大數（bigint）轉換
; ═══════════════════════════════════════════════

; 單個數字字元轉數值（0-15），無效字元回傳 -1
; [_str-dig-val](#str._str-dig-val)
_str-dig-val = (c i64) (d i64) {
    d = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            d = c - 48
            return
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            d = c - 55
            return
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            d = c - 87
        }
    }
}

; 將字串解析為 bigint，自動判斷進位制
;   前綴 0b/0B → 二進位、0o/0O → 八進位、0x/0X → 十六進位；無前綴 → 十進位
;   支援可選前導空白與正負號（+ / -）
; 返回 ?bigint：ok(bigint) 成功 / nil 空字串 / err('msg') 無有效數字
; [to-bigint](#str.to-bigint)
str.to-bigint = () (out ?bigint) {
    n = .len-bytes()
    n == 0 -> {
        out = nil
        return
    }

    acc = bigint.zero()
    pos = 0

    ; 跳過前導空白
    (pos < n) {
        c = .byte(pos)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        pos = pos + 1
    }

    ; 可選正負號
    sign = 1
    pos < n -> {
        c = .byte(pos)
        c == 45 -> {
            sign = -1

            #{overflow=wrap}
            pos = pos + 1
        }

        c == 43 -> {

            #{overflow=wrap}
            pos = pos + 1
        }
    }

    ; 進位制前綴
    radix = 10
    pos + 1 < n -> {
        c0 = .byte(pos)
        c0 == 48 -> {
            c1 = .byte(pos + 1)
            {
                c1 == 98 || c1 == 66 -> {
                    radix = 2

                    #{overflow=wrap}
                    pos = pos + 2
                }

                c1 == 111 || c1 == 79 -> {
                    radix = 8

                    #{overflow=wrap}
                    pos = pos + 2
                }

                c1 == 120 || c1 == 88 -> {
                    radix = 16

                    #{overflow=wrap}
                    pos = pos + 2
                }
            }
        }
    }

    ; 逐位解析數字
    started = 0
    (pos < n) {

        d = _str-dig-val(.byte(pos))
        d < 0 -> break
        d >= radix -> break

        acc = acc * radix

        acc = acc + d
        started = 1

        #{overflow=wrap}
        pos = pos + 1
    }

    started == 0 -> {
        out = err('no digits to parse')
        return
    }

    sign == -1 -> acc.sign = -1
    acc.normalize()
    out = acc
}

; ═══════════════════════════════════════════════
; 分割與連接
; ═══════════════════════════════════════════════

; 用分隔符將字串分割為多個子字串
; sep str: 分隔符
; 返回 out []str: 分割後的子字串切片
; 空分隔符時返回整個字串作為唯一元素
; 注意：使用本地 result 切片再賦值給 out，避免 out.push 在輸出參數上不生效的編譯器 bug
; [split](#str.split)
str.split = (sep str) (out []str) {
    result []str
    sep.len-bytes() == 0 -> {
        result.push(.slice-bytes(0, .len-bytes()))
        out = result
        return
    }
    start = 0
    pos = .find-byte-from(sep, start)
    (pos >= 0) {
        result.push(.slice-bytes(start, pos))

        #{overflow=wrap}
        start = pos + sep.len-bytes()
        pos = .find-byte-from(sep, start)
    }
    result.push(.slice-bytes(start, .len-bytes()))
    out = result
}

; []str.join: 用分隔符連接字串切片中的所有元素
; sep str: 分隔符
; 返回 out str: 連接後的字串
; [join](#strs.join)
[]str.join = (sep str) (out str) {
    n = .len()
    n == 0 -> return
    total = 0
    i <- [0..n): {

        #{overflow=wrap}
        i > 0 -> total = total + sep.len-bytes()

        #{overflow=wrap}
        total = total + .[i].len-bytes()
    }
    out = with-cap(total)
    pos = 0
    i <- [0..n): {
        i > 0 -> {
            j <- [0..sep.len-bytes()): {
                out[pos] = sep.byte(j)

                #{overflow=wrap}
                pos = pos + 1
            }
        }
        s = .[i]
        j <- [0..s.len-bytes()): {
            out[pos] = s.byte(j)

            #{overflow=wrap}
            pos = pos + 1
        }
    }
}

; ═══════════════════════════════════════════════
; 子串替換
; ═══════════════════════════════════════════════

; 將 s 中所有 old 子串替換為 new 子串
; old str: 要替換的子串
; new str: 替換後的子串
; 返回 val str: 替換後的結果字串
; 若 old 為空字串，直接返回原字串的副本
; [replace-str](#str.replace-str)
str.replace-str = (old str, new str) (val str) {
    old.len-bytes() == 0 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }

    ; 第一遍：計算結果長度
    n = .len-bytes()
    old-len = old.len-bytes()
    new-len = new.len-bytes()
    out-len = 0
    i = 0
    (i < n) {

        ; 嘗試在位置 i 匹配 old
        match = true
        j = 0
        (j < old-len) {

            #{overflow=wrap}
            i + j >= n -> {
                match = false
                break
            }

            #{overflow=wrap}
            .byte(i + j) != old.byte(j) -> {
                match = false
                break
            }

            #{overflow=wrap}
            j = j + 1
        }
        match -> {

            #{overflow=wrap}
            out-len = out-len + new-len

            #{overflow=wrap}
            i = i + old-len
        }

        -> {

            #{overflow=wrap}
            out-len = out-len + 1

            #{overflow=wrap}
            i = i + 1
        }
    }

    ; 第二遍：寫入結果
    val str = with-cap(out-len)
    pos = 0
    i = 0
    (i < n) {

        ; 嘗試在位置 i 匹配 old
        match = true
        j = 0
        (j < old-len) {

            #{overflow=wrap}
            i + j >= n -> {
                match = false
                break
            }

            #{overflow=wrap}
            .byte(i + j) != old.byte(j) -> {
                match = false
                break
            }

            #{overflow=wrap}
            j = j + 1
        }
        match -> {
            k <- [0..new-len): {

                val[pos] = new.byte(k)

                #{overflow=wrap}
                pos = pos + 1
            }

            #{overflow=wrap}
            i = i + old-len
        }

        -> {
            val[pos] = .byte(i)

            #{overflow=wrap}
            pos = pos + 1

            #{overflow=wrap}
            i = i + 1
        }
    }
}

; ═══════════════════════════════════════════════
; 按空白分割
; ═══════════════════════════════════════════════

; 按一個或多個連續空白字元分割字串
; 空白字元：空格(32)、定位(9)、換行(10)、歸位(13)
; 返回 out []str: 分割後的非空子字串切片
; 連續空白被視為單一分隔符，首尾空白不產生空元素
; [fields](#str.fields)
str.fields = () (out []str) {
    n = .len-bytes()
    n == 0 -> return
    result []str
    start = -1
    i <- [0..n): {
        b = .byte(i)
        {
            b != 32 && b != 9 && b != 10 && b != 13 -> {
                start < 0 -> start = i
            }

            start >= 0 -> {
                result.push(.slice-bytes(start, i))
                start = -1
            }

            ->
        }
    }

    ; 處理最後一個欄位
    start >= 0 -> result.push(.slice-bytes(start, n))
    out = result
}

; ═══════════════════════════════════════════════
; 全等比較
; ═══════════════════════════════════════════════

; 全等比較兩個字串
; b str: 比較目標
; 返回 yes bool: true=相等 false=不相等
; [eq-full](#str.eq-full)
str.eq-full = (b str) (yes bool) {
    .len-bytes() != b.len-bytes() -> return
    yes = true
    i <- [0...len-bytes()): {
        .byte(i) != b.byte(i) -> {
            yes = false
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 反向查找
; ═══════════════════════════════════════════════

; 反向查找子串最後出現位置
; target str: 要查找的子串
; 返回 pos i64: 找到的碼點（字符）位置，未找到 -1
; [rindex](#str.rindex)
str.rindex = (target str) (pos i64) {
    b = .rfind-byte-from(target, 0)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; 反向查找子串最後出現位置（last-index 是 rindex 的別名）
; target str: 要查找的子串
; 返回 pos i64: 找到的碼點（字符）位置，未找到 -1
; [last-index](#str.last-index)
str.last-index = (target str) (pos i64) {
    pos = .rindex(target)
}

; 從 from（碼點位置）反向查找子串
; 語義同 Python rfind(target, from)：在 [from, .len) 範圍內查找 target 最後出現位置
; target str: 要查找的子串
; from i64: 起始位置（含，下界，碼點）
; 返回 pos i64: 找到的碼點（字符）位置，未找到 -1
; [rindex-from](#str.rindex-from)
str.rindex-from = (target str, from i64) (pos i64) {
    fb = .byte-index(from)
    b = .rfind-byte-from(target, fb)
    b < 0 -> {
        pos = -1
        return
    }
    pos = .cp-index(b)
}

; ═══════════════════════════════════════════════
; 限定次數替換
; ═══════════════════════════════════════════════

; 限定替換次數
; old str: 舊子串
; new str: 新子串
; n i64: 最大替換次數，n <= 0 不替換
; 返回 val str: 替換後字串
; [replace-n](#str.replace-n)
str.replace-n = (old str, new str, n i64) (val str) {
    n <= 0 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }
    old.len-bytes() == 0 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }
    parts = .split(old)
    np = parts.len()
    np <= 1 -> {
        val = .slice-bytes(0, .len-bytes())
        return
    }

    #{overflow=wrap}
    repl = np - 1
    repl > n -> repl = n
    total = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {
            i <= repl -> {

                #{overflow=wrap}
                total = total + new.len-bytes()
                total = total + old.len-bytes()
            }
        }

        #{index-out=zero, overflow=wrap}
        total = total + parts[i].len-bytes()
    }
    val = with-cap(total)
    pos = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {
            sep = new
            i > repl -> sep = old
            j <- [0..sep.len-bytes()): {
                val[pos] = sep.byte(j)
                pos = pos + 1
            }
        }

        #{index-out=zero}
        s = parts[i]
        j <- [0..s.len-bytes()): {
            val[pos] = s.byte(j)

            #{overflow=wrap}
            pos = pos + 1
        }
    }
}

; ═══════════════════════════════════════════════
; 限定次數分割
; ═══════════════════════════════════════════════

; 限定分割次數
; sep str: 分隔符
; maxsplit i64: 最大分割次數（產生 maxsplit+1 個元素），maxsplit <= 0 不限制
; 返回 out []str: 分割結果
; [split-n](#str.split-n)
str.split-n = (sep str, maxsplit i64) (out []str) {
    result []str
    sep.len-bytes() == 0 -> {
        result.push(.slice-bytes(0, .len-bytes()))
        out = result
        return
    }
    maxsplit <= 0 -> {
        out = .split(sep)
        return
    }
    start = 0
    pos = .find-byte-from(sep, start)
    count = 0
    (pos >= 0) {
        count >= maxsplit -> {
            result.push(.slice-bytes(start, .len-bytes()))
            out = result
            return
        }
        result.push(.slice-bytes(start, pos))

        #{overflow=wrap}
        start = pos + sep.len-bytes()

        #{overflow=wrap}
        count = count + 1
        pos = .find-byte-from(sep, start)
    }
    result.push(.slice-bytes(start, .len-bytes()))
    out = result
}

; ═══════════════════════════════════════════════
; 按行分割
; ═══════════════════════════════════════════════

; 按換行符分割
; 支持 \n 與 \r\n
; 返回 out []str: 行列表（末尾換行不產生空行）
; [lines](#str.lines)
str.lines = () (out []str) {
    .len-bytes() == 0 -> return
    result []str
    start = 0
    i = 0
    (i < .len-bytes()) {
        c = .byte(i)

        #{overflow=wrap}
        c == 10 -> {
            end = i
            i > start -> {

                #{overflow=wrap}
                prev = .byte(i - 1)
                prev == 13 -> end = i - 1
            }
            result.push(.slice-bytes(start, end))
            start = i + 1
        }

        #{overflow=wrap}
        i = i + 1
    }
    start < .len-bytes() -> result.push(.slice-bytes(start, .len-bytes()))
    out = result
}

; ═══════════════════════════════════════════════
; 十六進制編碼
; ═══════════════════════════════════════════════

; 字串轉十六進制編碼
; 每字節轉兩個十六進制字符（小寫）
; 返回 out str: 十六進制字串
; [to-hex](#str.to-hex)
str.to-hex = () (out str) {
    .len-bytes() == 0 -> return

    #{overflow=wrap}
    out = with-cap(.len-bytes() * 2)
    hex = '0123456789abcdef'
    i <- [0...len-bytes()): {
        b = .byte(i)

        #{overflow=wrap}
        out[i * 2] = hex[b >> 4]

        #{overflow=wrap}
        out[i * 2 + 1] = hex[b & 15]
    }
}

; ═══════════════════════════════════════════════
; 安全索引
; ═══════════════════════════════════════════════

; [deprecated] str.at: 字符（碼點）索引讀取——請改用 s[idx]（原生索引，回傳 ?char）
; 安全索引訪問（字符索引；位元組偏移請用 s.byte(i)）
; i i64: 字符（碼點）索引
; 返回 val ?byte: 該字符的碼點值（超出 byte 範圍時截斷）；越界返回 nil
; [at](#str.at)
str.at = (i i64) (val ?byte) {
    {
        i < 0 -> {
            val = nil
            return
        }

        i >= .len() -> {
            val = nil
            return
        }
    }
    val = .[i]
}

; ═══════════════════════════════════════════════
; txt 转换
; ═══════════════════════════════════════════════

; 将 str 转换为 txt（最长 255 字节）
; 返回 out ?txt: ok(txt) / nil（超过 255 字节，txt 容纳不下，不再静默截断）
; [to-txt](#str.to-txt)
str.to-txt = () (out ?txt) {
    n = .len-bytes()
    n > 255 -> {
        out = nil
        return
    }
    t txt
    i <- [0..n): {
        t.set-byte(i, .byte(i))
    }
    t.len = n
    out = t
}
