// str — 字符串操作标准库
//
// str 是对外统一的字符串类型
// 内部实现：str-short（栈分配 SSO）| str-long（堆分配）
// str-short 仅作为编译器内部优化，不出现在公开 API
//
// str {
//     len i64 read-only       // 对外：i64 长度
//     data *byte sealed       // 对外：数据指针
// }

// ═══════════════════════════════════════════════
// 基础操作
// ═══════════════════════════════════════════════

// str.len: 返回字符串长度（内置字段访问，s.len 直接可用）
// build-in
// str.len = () (n int64) {
//    n = .len
// }

// str[n]: 返回指定位置的字节值
// build-in
// str[n] = (i i64) (c byte) {
//     c = s[i] & 255
// }

// str.eq: 比较两个字符串的前 n 个字节是否相等
// 返回 true=相等, false=不相等
// build-in (ForwardFunc: eq-raw)
// str.eq = (b str, n i64) (eq bool) { ... }

// str.copy: 将 src 的前 n 个字节复制到 dst
// build-in (ForwardFunc: memcpy)
// str.copy = (dst str, n i64) { ... }

str.fill = (val char, n i64) {
    // UTF-8 編碼 char 到臨時緩衝區
    buf [4]byte = [0x00, 0x00, 0x00, 0x00]
    len i64 = 0

    if val < 0x80 {
        buf[0] = val & 255
        len = 1
    } elif val < 0x800 {
        buf[0] = 0xC0 | ((val >> 6) & 0x1F)
        buf[1] = 0x80 | (val & 0x3F)
        len = 2
    } elif val < 0x10000 {
        buf[0] = 0xE0 | ((val >> 12) & 0x0F)
        buf[1] = 0x80 | ((val >> 6) & 0x3F)
        buf[2] = 0x80 | (val & 0x3F)
        len = 3
    } else {
        buf[0] = 0xF0 | ((val >> 18) & 0x07)
        buf[1] = 0x80 | ((val >> 12) & 0x3F)
        buf[2] = 0x80 | ((val >> 6) & 0x3F)
        buf[3] = 0x80 | (val & 0x3F)
        len = 4
    }

    // 循環填充字符串
    i <- [0..n): {
        .[i] = buf[i % len]
    }
}

// ═══════════════════════════════════════════════
// 查找
// ═══════════════════════════════════════════════

// str.index: 在 s 中查找 target 子串
// 返回首次出现的位置，未找到返回 -1
str.index = (target str) (pos i64) {
    pos = -1
    if target.len == 0 {
        pos = 0
        return
    }
    limit = .len - target.len
    i = 0
    for i <= limit {
        matched = 1
        j = 0
        for j < target.len {
            sj = .[i + j] & 255
            tj = target[j] & 255
            if sj != tj {
                matched = 0
                break
            }
            j = j + 1
        }
        if matched == 1 {
            pos = i
            return
        }
        i = i + 1
    }
}

// str.contains: 判断 s 是否包含 target 子串
// 返回 true=包含, false=不包含
str.contains = (target str) (yes bool) {
    yes = false
    pos = .index(target)
    if pos >= 0 {
        yes = true
    }
}

// str.starts-with: 判断 s 是否以 target 开头
// 返回 true=是, false=否
str.starts-with = (target str) (yes bool) {
    yes = true
    if target.len > .len {
        yes = false
        return
    }
    i = 0
    for i < target.len {
        si = .[i] & 255
        ti = target[i] & 255
        if si != ti {
            yes = false
            return
        }
        i = i + 1
    }
}

// str.ends-with: 判断 s 是否以 target 结尾
// 返回 true=是, false=否
str.ends-with = (target str) (yes bool) {
    yes = true
    if target.len > .len {
        yes = false
        return
    }
    off = .len - target.len
    i = 0
    for i < target.len {
        si = .[off + i] & 255
        ti = target[i] & 255
        if si != ti {
            yes = false
            return
        }
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 转换
// ═══════════════════════════════════════════════

// str.to-upper: 将字符串转为大写
// 返回新字符串
str.to-upper = (out str) {
    out.len = .len
    i = 0
    for i < .len {
        c = .[i] & 255
        if c >= 97 && c <= 122 {
            out[i] = c - 32
        } else {
            out[i] = c
        }
        i = i + 1
    }
}

// str.to-lower: 将字符串转为小写
// 返回新字符串
str.to-lower = (out str) {
    out.len = .len
    i = 0
    for i < .len {
        c = .[i] & 255
        if c >= 65 && c <= 90 {
            out[i] = c + 32
        } else {
            out[i] = c
        }
        i = i + 1
    }
}

// str.trim: 去除字符串首尾空白字符
// 返回新字符串
str.trim = (out str) {
    start = 0
    for start < .len {
        c = .[start] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        start = start + 1
    }
    end = .len - 1
    for end >= start {
        c = .[end] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        end = end - 1
    }
    out.len = end - start + 1
    if out.len < 0 {
        out.len = 0
        return
    }
    i = 0
    for i < out.len {
        out[i] = .[start + i]
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 重复与切片
// ═══════════════════════════════════════════════

// str.repeat: 将字符串重复 times 次
// 返回新字符串
str.repeat = (times i64, out str) {
    out.len = .len * times
    i = 0
    for i < times {
        j = 0
        for j < .len {
            out[i * .len + j] = .[j]
            j = j + 1
        }
        i = i + 1
    }
}

// str.slice: 截取子串 [start, end)
// 返回新字符串
str.slice = (start i64, end i64, out str) {
    if start < 0 {
        start = 0
    }
    if end > .len {
        end = .len
    }
    if start >= end {
        out.len = 0
        return
    }
    out.len = end - start
    i = 0
    for i < out.len {
        out[i] = .[start + i]
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 类型转换
// ═══════════════════════════════════════════════

// str.to-bytes: 将字符串转为字节数组
str.to-bytes = (out []byte) {
    out.len = .len
    i = 0
    for i < .len {
        out[i] = .[i] & 255
        i = i + 1
    }
}

// str.to-i64: 将字符串转为整数
str.to-i64 = (val i64) {
    val = 0
    i = 0
    neg = 0
    if .len > 0 {
        c = .[0] & 255
        if c == 45 {
            neg = 1
            i = 1
        }
    }
    for i < .len {
        c = .[i] & 255
        if c >= 48 && c <= 57 {
            val = val * 10 + c - 48
        }
        i = i + 1
    }
    if neg == 1 {
        val = 0 - val
    }
}

// ═══════════════════════════════════════════════
// 反转与比较
// ═══════════════════════════════════════════════

// str.reverse: 反转字符串
// 将 s 反转后写入 out
str.reverse = (out str) {
    out.len = .len
    i = 0
    for i < .len {
        out[i] = .[.len - 1 - i]
        i = i + 1
    }
}

// str.compare: 字典序比较两个字符串
// 返回 -1(a<b), 0(相等), 1(a>b)
str.compare = (b str) (r i64) {
    an = .len
    bn = b.len
    min-n = an
    if bn < min-n {
        min-n = bn
    }
    i = 0
    for i < min-n {
        ai = .[i] & 255
        bi = b[i] & 255
        if ai < bi {
            r = -1
            return
        }
        if ai > bi {
            r = 1
            return
        }
        i = i + 1
    }
    if an < bn {
        r = -1
    } elif an > bn {
        r = 1
    } else {
        r = 0
    }
}

// ═══════════════════════════════════════════════
// 统计
// ═══════════════════════════════════════════════

// str.count: 统计字串中的 char（code point）數量
// 因為 .len 已經是 byte 數，count 提供 code point 數
str.count = () (cnt i64) {
    cnt = 0
    i = 0
    for i < .len {
        b = .[i] & 255
        if b < 0x80 {
            i = i + 1
        } elif b < 0xE0 {
            i = i + 2
        } elif b < 0xF0 {
            i = i + 3
        } else {
            i = i + 4
        }
        cnt = cnt + 1
    }
}

// ═══════════════════════════════════════════════
// 替换
// ═══════════════════════════════════════════════

// str.replace-char: 将 s 中所有 old-ch 替换为 new-ch
// 返回结果字符串
str.replace-char = (old-ch char, new-ch char, out str) {
    out.len = .len
    old-c = old-ch & 255
    new-c = new-ch & 255
    i = 0
    for i < .len {
        c = .[i] & 255
        if c == old-c {
            out[i] = new-c
        } else {
            out[i] = c
        }
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 裁剪（指定字符）
// ═══════════════════════════════════════════════

// str.trim-char: 去除字符串首尾指定字符
str.trim-char = (ch char, out str) {
    target = ch & 255
    start = 0
    for start < .len {
        c = .[start] & 255
        if c != target {
            break
        }
        start = start + 1
    }
    end = .len - 1
    for end >= start {
        c = .[end] & 255
        if c != target {
            break
        }
        end = end - 1
    }
    out.len = end - start + 1
    if out.len < 0 {
        out.len = 0
        return
    }
    i = 0
    for i < out.len {
        out[i] = .[start + i]
        i = i + 1
    }
}

// ═══════════════════════════════════════════════
// 判空
// ═══════════════════════════════════════════════

// str.empty: 判断字符串是否为空
// 返回 true=空, false=非空
str.empty = (yes bool) {
    yes = true
    if .len != 0 {
        yes = false
    }
}