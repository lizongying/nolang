ord {
    t.gt(b t) (res bool)
}

i8.gt = (b i8) (res bool) {
    res = . > b
}

i16.gt = (b i16) (res bool) {
    res = . > b
}

i32.gt = (b i32) (res bool) {
    res = . > b
}

i64.gt = (b i64) (res bool) {
    res = . > b
}

u8.gt = (b u8) (res bool) {
    res = . > b
}

u16.gt = (b u16) (res bool) {
    res = . > b
}

u32.gt = (b u32) (res bool) {
    res = . > b
}

u64.gt = (b u64) (res bool) {
    res = . > b
}

f32.gt = (b f32) (res bool) {
    res = . > b
}

f64.gt = (b f64) (res bool) {
    res = . > b
}

byte.gt = (b byte) (res bool) {
    res = . > b
}

char.gt = (b char) (res bool) {
    res = . > b
}

str.gt = (b str) (res bool) {
    res = . > b
}

; [n]ord.sort-asc: 升序原地排序（插入排序）
[n]ord.sort-asc = () {
    i <- [1..n): {
        key = .[i]
        j = i - 1
        {
            .[j] <= key -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}

; [n]ord.sort-desc: 降序原地排序（插入排序）
[n]ord.sort-desc = () {
    i <- [1..n): {
        key = .[i]
        j = i - 1
        {
            .[j] >= key -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}

; []ord.sort-asc: 升序原地排序（插入排序）
[]ord.sort-asc = () {
    sz = .len
    i <- [1..sz): {
        key = .[i]
        j = i - 1
        {
            .[j] <= key -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}

; []ord.sort-desc: 降序原地排序（插入排序）
[]ord.sort-desc = () {
    sz = .len
    i <- [1..sz): {
        key = .[i]
        j = i - 1
        {
            .[j] >= key -> break
            .[j + 1] = .[j]
            j = j - 1
        } (j >= 0)
        .[j + 1] = key
    }
}
