; sql — 資料庫存取介面定義
;
; 本檔案定義資料庫存取的標準介面。
; 各驅動（如 SQLite、MySQL、PostgreSQL 等）實作此介面，
; 提供具體的結構體型別與方法。
;
; 介面：
;   db    — 資料庫連線（繼承 enter/leave，作用域結束自動關閉）
;   rows  — 查詢結果集（繼承 enter/leave，作用域結束自動關閉）
;   stmt  — 預編譯陳述式（繼承 enter/leave，作用域結束自動關閉）
;
; 共用結構體：
;   result — 執行結果（所有驅動共用）
;
; 驅動應提供的函式：
;   open = (dsn str) (d db) — 由驅動提供

; ───────────────────────────────────────────────
; 歷史註記：本檔曾宣告 `#{buildin} db-*`（15 個）與 `ffi-cstr-*`（3 個）內建樁。
; 它們的 lowering 原本在 legacy 後端（`src/build/llvm/call_stdlib.go` 的 `callDatabase`，
; cb24869），該目錄已於 c7febdb 整體刪除且從未移植到 MIR。
; 結果是「`no vet` 0 error、`no run` 報 unsupported builtin」的半條命陷阱，已於 2026-09-21
; 連同 Go 側註冊（`src/builtin/database.go`、`src/builtin/ffi.go`）一併移除。
; 資料庫存取一律走驅動（見 `example/sqlite-driver`、`example/mysql-driver`）；
; 需要 C 字串陣列時在驅動裡用 `#{c}` FFI 直呼，不要再做成 builtin。
; ───────────────────────────────────────────────

; result: 執行結果（所有驅動共用）
result {
    last-id i64
    affected i64
}

; ============================================================================
; 介面：db — 資料庫連線
; 繼承 enter/leave 介面，變數離開作用域時自動呼叫 leave()
; ============================================================================

db enter, leave {
    fs.close() (ok bool)
    exec(sql str) (r result)
    query(sql str) (rs rows)
    prepare(sql str) (s stmt)
}

; ============================================================================
; 介面：rows — 查詢結果集
; 繼承 enter/leave 介面，變數離開作用域時自動呼叫 leave()
; ============================================================================

rows enter, leave {
    next() (ok bool)
    scan-int(col i64) (v i64)
    scan-str(col i64) (v str)
    scan-float(col i64) (v f64)
    fs.close() (ok bool)
}

; ============================================================================
; 介面：stmt — 預編譯陳述式
; 繼承 enter/leave 介面，變數離開作用域時自動呼叫 leave()
; ============================================================================

stmt enter, leave {
    bind-int(idx i64, v i64) (ok bool)
    bind-str(idx i64, v str) (ok bool)
    bind-bool(idx i64, v bool) (ok bool)
    exec() (r result)
    query() (rs rows)
    fs.close() (ok bool)
}
