; option — 選項型別（內建標籤列舉/union）
;
; 以 #{buildin} 宣告為內建標籤列舉：變體供匹配/窮盡性檢查，底層表示與構造由
; 內建 runtime 提供（%option 型別 + ok(...)/nil/err(...) 構造器）。
; tag: 0=ok, 1=nil, 2=err
;
; 用法：
;   x ?t                       // 宣告 option<t>
;   x = 42                     // 設為有值
;   x = nil                    // 設為空
;   x = err('msg')             // 設為錯誤
;
;   match
;   x: {
;       nil -> log(it)
;       err -> log(it)
;       -> log(it)
;   }
#{buildin}
option {
    ok(v t),
    nil,
    err(e str),
}
