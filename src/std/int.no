; int — int 聯合型別與 int 方法
;
; int = i8 | i16 | i32 | i64 | i128 | u8 | u16 | u32 | u64 | u128
; （整數聯合型別別名）。
; 本模組承載 int 型別的方法：to-str, div, mod。
; float 聯合型別見 std/float.no；num 聯合型別見 std/num.no；
; 具體型別操作（範圍常數、型別轉換、具體型別 to-str、位元操作等）見 number 模組。
; [int](#int)

int = i8 | i16 | i32 | i64 | i128 | u8 | u16 | u32 | u64 | u128

; 整數轉字串（聯合類型方法，涵蓋所有整數類型）
; transpiler 會將 i64.to-str() 等解析為 int.to-str()
; 直接使用算術運算，避免 int → u64 的類型轉換問題
; 注意：不對負數取絕對值（0 - n 在 n = i64.MIN 時會溢出），
; 改為直接對負數做 srem/sdiv（向零截斷），再將負餘數映射到 [0, 9]。
; out: 十進位表示字串，如 42 / -17；零輸出 '0'，負數帶前導 '-'
; [to-str](#int.to-str)
int.to-str = () (out str) {
    . == 0 -> {
        z []byte = with-cap-len(1, 1)

        z[0] = 48
        out = z.to-bytes-str()
        return
    }
    neg = 0
    n = .
    n < 0 -> neg = 1
    digits = 0
    tmp = n
    (tmp != 0) {
        {
            #{overflow=wrap}
            digits ?= digits + 1
        }: {
            err -> _

            -> _
        }

        #{overflow=wrap}
        tmp = tmp / 10
    }
    total = digits

    neg == 1 -> {
        {
            #{overflow=wrap}
            total ?= total + 1
        }: {
            err -> _

            -> _
        }
    }

    ; str 下標直寫已全域禁用（連 with-cap 基底也不再豁免）⇒ 用 []byte 緩衝承接。
    ob []byte = with-cap-len(total, total)

    #{overflow=wrap}
    pos = digits - 1
    neg == 1 -> pos = digits
    (n != 0) {

        #{overflow=wrap}
        d = n % 10

        #{overflow=wrap}
        neg == 1 -> d = 0 - d

        #{overflow=wrap}
        ascii = d + 48

        ob[pos] = ascii

        #{overflow=wrap}
        n = n / 10

        {
            #{overflow=wrap}
            pos ?= pos - 1
        }: {
            err -> _

            -> _
        }
    }
    neg == 1 -> {
        ob[0] = 45
    }
    out = ob.slice(0, total).to-bytes-str()
}

; 整數除法，回傳商（a ÷ b）
; b 為 0 時回傳 err（編譯器插入的零除守衛；不是 UB）。詳見 docs/docs/lang/syntax.md〈除零〉
; b: 除數，型別需與被除數一致；符號跟隨 C 的向零截斷（-7 / 2 = -3）
; q: ok=商（型別同接收者）, err=除數為 0（無 nil 情形）
; [div](#int.div)
int.div = (b int) (q ?int) {
    q = . / b
}

; 整數取模，回傳餘數（a % b）
; b 為 0 時回傳 err（編譯器插入的零除守衛；不是 UB）。詳見 docs/docs/lang/syntax.md〈除零〉
; b: 除數（不能為 0）；餘數的符號跟隨被除數（-7 % 2 = -1）
; r: ok=餘數（|r| < |b|）, err=除數為 0（無 nil 情形）
; [mod](#int.mod)
int.mod = (b int) (r ?int) {
    r = . % b
}
