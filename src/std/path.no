// path — 路徑操作
//
// 純字串操作，不涉及檔案系統存取。

// 路徑分隔符
SEP = 47  // '/' ASCII

// 當前目錄
DOT = 46  // '.' ASCII

// ═══════════════════════════════════════════════
// path 結構體：封裝路徑字串
// ═══════════════════════════════════════════════

// path: 路徑
path {
    p str
}

// exists: 檢查路徑是否存在（為檔案）
path.exists = () (yes bool) {
    yes = is-file(.p)
}

// is-dir: 檢查路徑是否為目錄
path.is-dir = () (yes bool) {
    yes = is-dir(.p)
}

// is-file: 檢查路徑是否為檔案
path.is-file = () (yes bool) {
    yes = is-file(.p)
}

// size: 取得檔案大小
path.size = () (sz i64) {
    sz = stat-size(.p)
}

// make-dir: 建立目錄
// 返回 true=成功, false=失敗
path.make-dir = () (ok bool) {
    ok = mkdir(.p, 511)
}

// remove: 刪除檔案
// 返回 true=成功, false=失敗
path.remove = () (ok bool) {
    ok = remove(.p)
}

// rename: 將本路徑重新命名為 new-p
// 返回 true=成功, false=失敗
path.rename = (new-p str) (ok bool) {
    ok = rename(.p, new-p)
}

// change-dir: 切換工作目錄到本路徑
// 返回 true=成功, false=失敗
path.change-dir = () (ok bool) {
    ok = ch-dir(.p)
}

// current: 取得當前工作目錄（建構型方法）
// 返回新的 path 結構體
path.current = () (out path) {
    dir = get-wd()
    out.p = dir
}

// ═══════════════════════════════════════════════
// 路徑拼接
// ═══════════════════════════════════════════════

// path.join: 拼接兩個路徑元素
// 處理尾綴/首綴 '/' 的各種組合
// 原地修改 .p，將 b 拼接到 .p 末尾
path.join = (b str) {
    bn = b.len
    out-n = .p.len

    // 如果 a 不以 '/' 結尾且 b 不以 '/' 開頭，加入 '/'
    need-sep = 1
    if out-n > 0 {
        last-a = .p[out-n - 1] & 255
        if last-a == SEP {
            need-sep = 0
        }
    }
    if bn > 0 {
        first-b = b[0] & 255
        if first-b == SEP {
            need-sep = 0
        }
    }
    if out-n == 0 {
        need-sep = 0
    }
    if need-sep == 1 {
        .p[out-n] = SEP
        out-n = out-n + 1
    }

    // 如果 b 以 '/' 開頭，跳過
    start-b = 0
    if bn > 0 {
        first-b = b[0] & 255
        if first-b == SEP {
            start-b = 1
        }
    }

    // 複製 b
    j = start-b
    for j < bn {
        .p[out-n] = b[j]
        out-n = out-n + 1
        j = j + 1
    }

    .p.len = out-n
}

// ═══════════════════════════════════════════════
// 路徑分解
// ═══════════════════════════════════════════════

// path.base: 取出路徑的最後一個元素（檔名）
// 返回檔名字串
path.base = () (out str) {
    // 找最右邊的 '/'
    last-sep = -1
    i = 0
    for i < .p.len {
        c = .p[i] & 255
        if c == SEP {
            last-sep = i
        }
        i = i + 1
    }
    start = last-sep + 1
    out-n = .p.len - start
    i = 0
    for i < out-n {
        out[i] = .p[start + i]
        i = i + 1
    }
    out.len = out-n
}

// path.dir: 取出路徑的目錄部分
// 原地修改 .p
path.dir = () {
    // 找最右邊的 '/'
    last-sep = -1
    i = 0
    for i < .p.len {
        c = .p[i] & 255
        if c == SEP {
            last-sep = i
        }
        i = i + 1
    }
    if last-sep < 0 {
        // 無 '/'，變為 '.'
        .p[0] = DOT
        .p.len = 1
        return
    }
    out-n = last-sep
    if out-n == 0 {
        // 根目錄 '/'
        .p[0] = SEP
        .p.len = 1
        return
    }
    .p.len = out-n
}

// path.ext: 取出檔案副檔名（含點）
// 返回副檔名字串
path.ext = () (out str) {
    out-n = 0

    // 找最右邊的 '/' 之後的 '.'
    last-sep = -1
    last-dot = -1
    i = 0
    for i < .p.len {
        c = .p[i] & 255
        if c == SEP {
            last-sep = i
        }
        if c == DOT {
            last-dot = i
        }
        i = i + 1
    }

    // '.' 必須在 '/' 之後
    if last-dot <= last-sep {
        return
    }

    // 副檔名不能是路徑的最後一個字元（排除 '.' 和 '..'）
    if last-dot == .p.len - 1 {
        return
    }
    start = last-dot
    out-n = .p.len - start
    i = 0
    for i < out-n {
        out[i] = .p[start + i]
        i = i + 1
    }

    out.len = out-n
}

// ═══════════════════════════════════════════════
// 路徑判斷
// ═══════════════════════════════════════════════

// path.is-abs: 判斷路徑是否為絕對路徑
// 返回 true=是, false=否
path.is-abs = () (yes bool) {
    yes = false
    if .p.len > 0 {
        c = .p[0] & 255
        if c == SEP {
            yes = true
        }
    }
}

// ═══════════════════════════════════════════════
// 路徑清理
// ═══════════════════════════════════════════════

// path.clean: 清理路徑（移除 . 和 .. 與重複分隔符）
// 原地修改 .p
path.clean = () {
    out-n = 0
    i = 0
    dot-count = 0
    for i < .p.len {
        c = .p[i] & 255
        if c == SEP {
            // 處理上一段
            if dot-count == 1 {
                // 忽略 './'
            } elif dot-count == 2 {
                // 回退 '..'
                // 找 .p 中前一個 '/'
                j = out-n - 1
                for j >= 0 {
                    if .p[j] == SEP {
                        break
                    }
                    j = j - 1
                }
                if j < 0 {
                    out-n = 0
                } else {
                    out-n = j
                }
            } elif out-n > 0 {
                prev = .p[out-n - 1] & 255
                if prev != SEP {
                    .p[out-n] = SEP
                    out-n = out-n + 1
                }
            } else {
                .p[out-n] = SEP
                out-n = out-n + 1
            }
            dot-count = 0
        } elif c == DOT {
            dot-count = dot-count + 1
        } else {
            // 寫入之前積累的 '.' 字元
            j = 0
            for j < dot-count {
                .p[out-n] = DOT
                out-n = out-n + 1
                j = j + 1
            }
            dot-count = 0
            .p[out-n] = c
            out-n = out-n + 1
        }
        i = i + 1
    }

    // 處理末尾段
    if dot-count == 1 {
        // 忽略末尾 '.'
    } elif dot-count == 2 {
        j = out-n - 1
        for j >= 0 {
            if .p[j] == SEP {
                break
            }
            j = j - 1
        }
        if j < 0 {
            out-n = 0
        } else {
            out-n = j
        }
    }

    // 移除末尾 '/'
    if out-n > 1 {
        prev = .p[out-n - 1] & 255
        if prev == SEP {
            out-n = out-n - 1
        }
    }

    .p.len = out-n
}

// ═══════════════════════════════════════════════
// 路徑分割
// ═══════════════════════════════════════════════

// str.path-split: 將路徑分割為目錄和檔名
// d, f 為輸出緩衝區；dn, fn 為各自的長度
str.path-split = (d str, f str) (dn i64, fn i64) {
    dn = .path-dir(d)
    fn = .path-base(f)
}