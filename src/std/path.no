; path — 路徑操作
;
; 純字串操作，不涉及檔案系統存取。

; 路徑分隔符（'/' = 47）
; ⚠️ 必須是 **char 字面量（雙引號）**，不能是字串字面量 `SEP = '/'`：
; 單引號在 Nolang 是 str，拿 byte 去比 str 永遠為 false，
; 會讓 `c == SEP` 恆為 false → dir()/base()/ext() 永遠找不到分隔符
; （last-sep 停在 -1，dir() 一律回 '.'、base() 回整串）。
; SEP/DOT 只用於**寫入**（`.p[n] = SEP`）；掃描時請用下面的 SEP-BYTE / DOT-BYTE。
SEP = "/"

; 當前目錄（'.' = 46；同上，雙引號 char 字面量）
DOT = "."

; 位元組版分隔符常量。`.p.byte(i)` 讀出的是**數值**（非 char），所以掃描迴圈裡的
; 比較必須用數值常量。所有「讀取」一律走 .byte(i)：語義是位元組，且與 len-bytes()、
; out-n 這些位元組游標同一單位 —— 混用碼點索引（.p[i]）與位元組游標會把非 ASCII
; 路徑切壞（見 tests/std-byte-indexing.no）。
SEP-BYTE = 47

DOT-BYTE = 46

; ═══════════════════════════════════════════════
; path 結構體：封裝路徑字串
; ═══════════════════════════════════════════════

; path: 以字串欄位 p 承載一條路徑的值物件（各方法皆作用於 .p）
path {
    p str
}

; 檢查路徑是否存在（檔案或目錄均算存在）
; yes: true=該路徑（檔案或目錄）存在
; [exists](#path.exists)
path.exists = () (yes bool) {
    yes = fs.is-file(.p)
    yes == false -> yes = fs.is-dir(.p)
}

; 檢查路徑是否為目錄
; yes: true=.p 指向一個目錄
; [is-dir](#path.is-dir)
path.is-dir = () (yes bool) {
    yes = fs.is-dir(.p)
}

; 檢查路徑是否為檔案
; yes: true=.p 指向一個普通檔案
; [is-file](#path.is-file)
path.is-file = () (yes bool) {
    yes = fs.is-file(.p)
}

; 取得檔案大小
; sz: .p 指向檔案的位元組大小
; [size](#path.size)
path.size = () (sz i64) {
    sz = fs.stat-size(.p)
}

; 建立目錄
; 返回 true=成功, false=失敗
; ok: true=目錄建立成功, false=失敗
; [make-dir](#path.make-dir)
path.make-dir = () (ok bool) {
    ok = os.mkdir(.p, 511)
}

; 刪除檔案
; 返回 true=成功, false=失敗
; ok: true=檔案刪除成功, false=失敗
; [remove](#path.remove)
path.remove = () (ok bool) {
    ok = fs.remove(.p)
}

; 將本路徑重新命名為 new-p
; 返回 true=成功, false=失敗
; new-p: 重命名後的目標路徑字串
; ok: true=重命名成功, false=失敗
; [rename](#path.rename)
path.rename = (new-p str) (ok bool) {
    ok = fs.rename(.p, new-p)
}

; 切換工作目錄到本路徑
; 返回 true=成功, false=失敗
; ok: true=工作目錄已切至 .p, false=失敗
; [change-dir](#path.change-dir)
path.change-dir = () (ok bool) {
    ok = os.ch-dir(.p)
}

; 取得當前工作目錄（建構型方法）
; 返回新的 path 結構體
; out: 封裝當前工作目錄路徑的新 path 結構體
; [current](#path.current)
path.current = () (out path) {
    dir = os.get-wd()
    out.p = dir
}

; ═══════════════════════════════════════════════
; 路徑拼接
; ═══════════════════════════════════════════════

; 拼接兩個路徑元素
; 處理尾綴/首綴 '/' 的各種組合
; 原地修改 .p，將 b 拼接到 .p 末尾；**並回傳拼接後的 .p**。
;
; ⚠️ API 一致性：早期 join()/dir() 只做原地修改、沒有回傳值，而 base()/ext()
; 是回傳 str，導致 `x = p.join(...)` 拿到空字串這種陷阱。現在四個方法**都回傳**
; str（join/dir 仍會一併更新 .p，保留既有的原地用法）。
; b: 拼接到 .p 末尾的路徑元素
; out: 處理首尾斜線後拼接完成的完整路徑字串（同時原地更新 .p）
; [join](#path.join)
path.join = (b str) (out str) {
    bn = b.len-bytes()
    out-n = .p.len-bytes()

    ; 如果 a 不以 '/' 結尾且 b 不以 '/' 開頭，加入 '/'
    need-sep = 1
    out-n > 0 -> {

        #{overflow=wrap}
        last-a = .p.byte(out-n - 1)
        last-a == SEP-BYTE -> need-sep = 0
    }
    bn > 0 -> {

        first-b = b.byte(0)
        first-b == SEP-BYTE -> need-sep = 0
    }
    out-n == 0 -> need-sep = 0
    need-sep == 1 -> {

        .p[out-n] = SEP

        #{overflow=wrap}
        out-n = out-n + 1
    }

    ; 如果 b 以 '/' 開頭，跳過
    start-b = 0
    bn > 0 -> {

        first-b = b.byte(0)
        first-b == SEP-BYTE -> start-b = 1
    }

    ; 複製 b
    j <- [start-b..bn): {

        .p[out-n] = b.byte(j)

        #{overflow=wrap}
        out-n = out-n + 1
    }
    out = .p
}

; ═══════════════════════════════════════════════
; 路徑分解
; ═══════════════════════════════════════════════

; 取出路徑的最後一個元素（檔名）
; 返回檔名字串
; out: 路徑最後一段（檔名）字串
; [base](#path.base)
path.base = () (out str) {

    ; 找最右邊的 '/'
    last-sep = -1
    i <- [0...p.len-bytes()): {

        c = .p.byte(i)
        c == SEP-BYTE -> last-sep = i
    }

    #{overflow=wrap}
    start = last-sep + 1

    #{overflow=wrap}
    out-n = .p.len-bytes() - start
    out = with-cap(.p.len-bytes())
    i <- [0..out-n): {

        #{overflow=wrap}
        out[i] = .p.byte(start + i)
    }
}

; 取出路徑的目錄部分
; 原地修改 .p；**並回傳修改後的 .p**（與 base()/ext()/join() 一致，見 join 上的說明）
; out: 去除檔名後的目錄部分（原地更新 .p 並回傳）
; [dir](#path.dir)
path.dir = () (out str) {

    ; 找最右邊的 '/'
    last-sep = -1
    i <- [0...p.len-bytes()): {

        c = .p.byte(i)
        c == SEP-BYTE -> last-sep = i
    }
    {
        last-sep < 0 -> {

            ; 無 '/'，變為 '.'
            .p[0] = DOT
            .p.len = 1
            out = .p
            return
        }

        -> {
            out-n = last-sep
            out-n == 0 -> {

                ; 根目錄 '/'
                .p[0] = SEP
                .p.len = 1
                out = .p
                return
            }
            .p.len = out-n
            out = .p
        }
    }
}

; 取出檔案副檔名（含點）
; 返回副檔名字串
; out: 含前導點的副檔名（無副檔名時為空字串）
; [ext](#path.ext)
path.ext = () (out str) {

    out-n = 0

    ; 找最右邊的 '/' 之後的 '.'
    last-sep = -1
    last-dot = -1
    i <- [0...p.len-bytes()): {

        c = .p.byte(i)
        {
            c == SEP-BYTE -> last-sep = i

            c == DOT-BYTE -> last-dot = i
        }
    }

    ; '.' 必須在 '/' 之後
    {

        last-dot <= last-sep -> return

        #{overflow=wrap}
        last-idx = .p.len-bytes() - 1
        last-dot == last-idx -> {

            ; 副檔名不能是路徑的最後一個字元（排除 '.' 和 '..'）
            return
        }
    }
    start = last-dot

    #{overflow=wrap}
    out-n = .p.len-bytes() - start
    out = with-cap(.p.len-bytes())
    i <- [0..out-n): {

        #{overflow=wrap}
        out[i] = .p.byte(start + i)
    }
}

; ═══════════════════════════════════════════════
; 路徑判斷
; ═══════════════════════════════════════════════

; 判斷路徑是否為絕對路徑
; 返回 true=是, false=否
; yes: true=.p 為絕對路徑, false=相對路徑
; [is-abs](#path.is-abs)
path.is-abs = () (yes bool) {
    .p.len-bytes() > 0 -> {

        c = .p.byte(0)
        c == SEP-BYTE -> yes = true
    }
}

; ═══════════════════════════════════════════════
; 路徑清理
; ═══════════════════════════════════════════════

; 清理路徑（移除 . 和 .. 與重複分隔符）
; 原地修改 .p
; [clean](#path.clean)
path.clean = () {
    out-n = 0
    dot-count = 0
    i <- [0...p.len-bytes()): {

        c = .p.byte(i)
        {
            c == SEP-BYTE -> {

                ; 處理上一段
                {
                    dot-count == 1 ->

                    dot-count == 2 -> {

                        ; 回退 '..'：丟掉前一段，連同它前面的 '/'
                        ; 從 out-n-2 往回找（out-n-1 是剛結束的那個 '/'）
                        #{overflow=wrap}
                        j = out-n - 2
                        (j >= 0) {

                            #{overflow=wrap}
                            .p.byte(j) == SEP-BYTE -> {

                                ; 保留該 '/' 本身 ⇒ 後續內容從它後面接上
                                #{overflow=wrap}
                                out-n-opt = j + 1
                                out-n = 0
                                out-n-opt: {
                                    ok -> out-n = it

                                    -> out-n = 0
                                }

                                break
                            }

                            #{overflow=wrap}
                            j = j - 1
                        }
                        {
                            j < 0 -> {
                                .p.byte(0) == SEP-BYTE -> out-n = 1

                                -> out-n = 0
                            }
                        }
                    }

                    out-n > 0 -> {

                        #{overflow=wrap}
                        prev = .p.byte(out-n - 1)
                        prev != SEP-BYTE -> {

                            .p[out-n] = SEP

                            #{overflow=wrap}
                            out-n = out-n + 1
                        }
                    }

                    -> {
                        .p[out-n] = SEP

                        #{overflow=wrap}
                        out-n = out-n + 1
                    }
                }
                dot-count = 0
            }

            c == DOT-BYTE -> {

                #{overflow=wrap}
                dot-count = dot-count + 1
            }

            -> {

                ; 寫入之前積累的 '.' 字元
                j <- [0..dot-count): {

                    .p[out-n] = DOT

                    #{overflow=wrap}
                    out-n = out-n + 1
                }

                dot-count = 0

                .p[out-n] = c

                #{overflow=wrap}
                out-n = out-n + 1
            }
        }
    }

    ; 處理末尾段
    {
        dot-count == 1 ->

        dot-count == 2 -> {

            #{overflow=wrap}
            j = out-n - 2
            (j >= 0) {

                #{overflow=wrap}
                .p.byte(j) == SEP-BYTE -> {

                    #{overflow=wrap}
                    out-n-opt = j + 1
                    out-n = 0
                    out-n-opt: {
                        ok -> out-n = it

                        -> out-n = 0
                    }

                    break
                }

                #{overflow=wrap}
                j = j - 1
            }
            {
                j < 0 -> {
                    .p.byte(0) == SEP-BYTE -> out-n = 1

                    -> out-n = 0
                }
            }
        }
    }

    ; 移除末尾 '/'
    out-n > 1 -> {

        #{overflow=wrap}
        prev = .p.byte(out-n - 1)

        #{overflow=wrap}
        prev == SEP-BYTE -> out-n = out-n - 1
    }
    .p.len = out-n
}

; ═══════════════════════════════════════════════
; 路徑分割
; ═══════════════════════════════════════════════

; 將路徑分割為目錄和檔名
; 原地修改 .p 為目錄部分，返回檔名
; 例：path{ p: '/a/b/c.txt' }.split() → .p='/a/b', f='c.txt'
; （結構體字面量必須多行，此處為簡寫示意）
; f: 分割出的檔名（.p 原地改為其目錄部分）
; [split](#path.split)
path.split = () (f str) {

    ; 找最右邊的 '/'
    last-sep = -1
    i <- [0...p.len-bytes()): {

        c = .p.byte(i)
        c == SEP-BYTE -> last-sep = i
    }

    ; 提取檔名
    #{overflow=wrap}
    start = last-sep + 1

    #{overflow=wrap}
    out-n = .p.len-bytes() - start
    f = with-len(out-n)
    i <- [0..out-n): {

        #{overflow=wrap}
        f[i] = .p.byte(start + i)
    }

    ; 原地修改 .p 為目錄部分
    {
        last-sep < 0 -> {

            ; 無 '/'，.p 變為 '.'
            .p[0] = DOT
            .p.len = 1
            return
        }

        last-sep == 0 -> {

            ; 根目錄 '/'
            .p[0] = SEP
            .p.len = 1
            return
        }

        -> .p.len = last-sep
    }
}
