; path — 路徑操作
;
; 純字串操作，不涉及檔案系統存取。
; [path](#path)

; 路徑分隔符（'/' = 47）
; ⚠️ 必須是 **char 字面量（雙引號）**，不能是字串字面量 `SEP = '/'`：
; 單引號在 Nolang 是 str，拿 byte 去比 str 永遠為 false，
; 會讓 `c == SEP` 恆為 false → dir()/base()/ext() 永遠找不到分隔符
; （last-sep 停在 -1，dir() 一律回 '.'、base() 回整串）。
; SEP/DOT 只用於**寫入**（`.p[n] = SEP`）；掃描時請用下面的 SEP-BYTE / DOT-BYTE。
; [SEP](#path.sep)
SEP = "/"

; 當前目錄（'.' = 46；同上，雙引號 char 字面量）
; [DOT](#path.dot)
DOT = "."

; 位元組版分隔符常量。`.p.byte(i)` 讀出的是**數值**（非 char），所以掃描迴圈裡的
; 比較必須用數值常量。所有「讀取」一律走 .byte(i)：語義是位元組，且與 len-bytes()、
; out-n 這些位元組游標同一單位 —— 混用碼點索引（.p[i]）與位元組游標會把非 ASCII
; 路徑切壞（見 tests/std-byte-indexing.no）。
; [SEP-BYTE](#path.sep-byte)
SEP-BYTE = 47

DOT-BYTE = 46

; path 結構體：封裝路徑字串
...

; path: 以字串欄位 p 承載一條路徑的值物件（各方法皆作用於 .p）
; [path](#path.path)
path {
    p str
}

; 檢查路徑是否存在（檔案或目錄均算存在）
; yes: true=該路徑（檔案或目錄）存在
; [exists](#path.exists)
path.exists = () (yes bool) {
    yes = fs.is-file(.p)
    yes == false -> yes = fs.is-dir(.p)
}

; 檢查路徑是否為目錄
; yes: true=.p 指向一個目錄
; [is-dir](#path.is-dir)
path.is-dir = () (yes bool) {
    yes = fs.is-dir(.p)
}

; 檢查路徑是否為檔案
; yes: true=.p 指向一個普通檔案
; [is-file](#path.is-file)
path.is-file = () (yes bool) {
    yes = fs.is-file(.p)
}

; 取得檔案大小
; sz: ok=.p 指向檔案的位元組大小, nil/err=取得失敗（檔案不存在或無法 stat）
; [size](#path.size)
path.size = () (sz ?i64) {
    sz = fs.stat-size(.p)
}

; 建立目錄
; 返回 true=成功, false=失敗
; ok: true=目錄建立成功, false=失敗
; [make-dir](#path.make-dir)
path.make-dir = () (ok bool) {
    ok = os.mkdir(.p, 511)
}

; 刪除檔案
; 返回 true=成功, false=失敗
; ok: true=檔案刪除成功, false=失敗
; [remove](#path.remove)
path.remove = () (ok bool) {
    ok = fs.remove(.p)
}

; 將本路徑重新命名為 new-p
; 返回 true=成功, false=失敗
; new-p: 重命名後的目標路徑字串
; ok: true=重命名成功, false=失敗
; [rename](#path.rename)
path.rename = (new-p str) (ok bool) {
    ok = fs.rename(.p, new-p)
}

; 切換工作目錄到本路徑
; 返回 true=成功, false=失敗
; ok: true=工作目錄已切至 .p, false=失敗
; [change-dir](#path.change-dir)
path.change-dir = () (ok bool) {
    ok = os.ch-dir(.p)
}

; 取得當前工作目錄（建構型方法）
; 返回新的 path 結構體
; out: 封裝當前工作目錄路徑的新 path 結構體
; [current](#path.current)
path.current = () (out path) {
    dir = os.get-wd()
    out.p = dir
}

; 路徑拼接
...

; 拼接兩個路徑元素
; 處理尾綴/首綴 '/' 的各種組合
; 原地修改 .p，將 b 拼接到 .p 末尾；**並回傳拼接後的 .p**。
;
; ⚠️ API 一致性：早期 join()/dir() 只做原地修改、沒有回傳值，而 base()/ext()
; 是回傳 str，導致 `x = p.join(...)` 拿到空字串這種陷阱。現在四個方法**都回傳**
; str（join/dir 仍會一併更新 .p，保留既有的原地用法）。
; ⚠️ 實作約束（2026-11-11 修）：**不要**在 .p 上逐位元組成長。
; 舊版用 `.p[out-n] ?= v` 追加 —— `?=` 是「越界就抛 err」，而追加的第一個位元組
; 恰好永遠越界（out-n == len），於是**整條拼接被靜默丟棄**：`path{p:'/a/b'}.join('c.txt')`
; 回傳 `/a/b`。改成 `.p[out-n] = v`（普通下標寫）又會踩另一個既有缺陷：需要擴容時
; 這個路徑不可靠（實測長後綴寫出垃圾並 segfault，見 tests/std-byte-indexing.no）。
; 唯一可靠的形態是「先按上界配置 `[]byte` 緩衝，再從索引 0 起**順序**寫入，
; 最後按實際長度切片轉回 str」—— base()/ext() 即此形態。故本方法建新緩衝，
; 最後整體指派回 .p。（str 下標直寫自 2026-11-11 起全域禁用，連 with-cap 基底
; 也不再豁免，所以緩衝必須是 `[]byte` 而不是 `str`。）
; b: 拼接到 .p 末尾的路徑元素
; out: 處理首尾斜線後拼接完成的完整路徑字串（同時原地更新 .p）
; [join](#path.join)
path.join = (b str) (out str) {
    an = .p.len-bytes()
    bn = b.len-bytes()

    ; 需不需要補一個分隔符？只看 a 是否有尾綴 '/'：
    ; b 的前導 '/' 一律吃掉並由這裡補回，否則 '/a/b'.join('/c.txt') 會得到
    ; '/a/bc.txt'（舊版就是這個 bug）。
    need-sep = 1
    an > 0 -> {

        #{overflow=wrap}
        last-a = .p.byte(an - 1)
        last-a == SEP-BYTE -> need-sep = 0
    }
    an == 0 -> need-sep = 0

    ; b 的前導 '/'：a 非空時跳過（由 need-sep 補回）；a 為空時保留，
    ; 否則 join('', '/c.txt') 會把絕對路徑降級成相對路徑。
    start-b = 0
    an > 0 -> {
        bn > 0 -> {
            b.byte(0) == SEP-BYTE -> start-b = 1
        }
    }

    ; 輸出上界：a + '/' + b。
    ; 用 clamp0 而不是 wrap：這是**容量**，溢出時寧可拿到 0（空緩衝，後續寫入
    ; 失敗走各自的失敗臂）也不要拿到負數（會被當成巨大容量去配置）。
    ;
    ; str 下標直寫自 2026-11-11 起全域禁用（連 with-cap 基底也不再豁免），
    ; 故緩衝改用 `[]byte`，寫完再按實際長度切片轉回 str。
    #{overflow=clamp0}
    o-cap = .p.len-bytes() + b.len-bytes() + 2
    o-b []byte = with-cap-len(o-cap, o-cap)

    ; 1) 複製 a
    i <- [0..an): {
        o-b[i] = .p.byte(i)
    }
    off = an

    ; 2) 需要時插入分隔符
    need-sep == 1 -> {
        o-b[an] = SEP-BYTE

        #{overflow=wrap}
        off = an + 1
    }

    ; 3) 複製 b（跳過前導 '/'）
    #{overflow=wrap}
    bs = bn - start-b
    j <- [0..bs): {

        #{overflow=wrap}
        o-b[off + j] = b.byte(start-b + j)
    }

    #{overflow=wrap}
    olen = off + bs
    .p = o-b.slice(0, olen).to-bytes-str()
    out = .p
}

; 路徑分解
...

; 取出路徑的最後一個元素（檔名）
; 返回檔名字串
; out: 路徑最後一段（檔名）字串
; [base](#path.base)
path.base = () (out str) {

    ; 找最右邊的 '/'
    last-sep = -1
    i <- [0..self.p.len-bytes()): {
        c = .p.byte(i)
        c == SEP-BYTE -> last-sep = i
    }

    #{overflow=wrap}
    start = last-sep + 1

    #{overflow=wrap}
    out-n = .p.len-bytes() - start
    ob []byte = with-cap-len(.p.len-bytes(), .p.len-bytes())
    i <- [0..out-n): {

        #{overflow=wrap}
        ob[i] = .p.byte(start + i)
    }
    out = ob.slice(0, out-n).to-bytes-str()
}

; 取出路徑的目錄部分
; 原地修改 .p；**並回傳修改後的 .p**（與 base()/ext()/join() 一致，見 join 上的說明）
; out: 去除檔名後的目錄部分（原地更新 .p 並回傳）
; [dir](#path.dir)
path.dir = () (out str) {

    ; 找最右邊的 '/'
    last-sep = -1
    i <- [0..self.p.len-bytes()): {
        c = .p.byte(i)
        c == SEP-BYTE -> last-sep = i
    }
    {
        last-sep < 0 -> {

            ; 無 '/'，變為 '.'（含空路徑）
            ; ⚠ 不可寫成 `.p[0] ?= DOT` + `.p.len = 1`：空串時 `?=` 越界走 err 臂
            ; 一個位元組都沒寫進去，接著把 len 設成 1 就等於把**未初始化位元組**當內容
            ; （實測 `path{p:''}.dir()` 回傳 len=1 的垃圾字元）。整體指派字面量最安全。
            .p = '.'
            out = .p
            return
        }

        -> {
            out-n = last-sep
            out-n == 0 -> {

                ; 根目錄 '/'
                .p = '/'
                out = .p
                return
            }
            .p.len = out-n
            out = .p
        }
    }
}

; 取出檔案副檔名（含點）
; 返回副檔名字串
; out: 含前導點的副檔名（無副檔名時為空字串）
; [ext](#path.ext)
path.ext = () (out str) {
    out-n = 0

    ; 找最右邊的 '/' 之後的 '.'
    last-sep = -1
    last-dot = -1
    i <- [0..self.p.len-bytes()): {
        c = .p.byte(i)
        {
            c == SEP-BYTE -> last-sep = i

            c == DOT-BYTE -> last-dot = i
        }
    }

    ; '.' 必須在 '/' 之後
    {
        last-dot <= last-sep -> return

        #{overflow=wrap}
        last-idx = .p.len-bytes() - 1
        last-dot == last-idx -> {

            ; 副檔名不能是路徑的最後一個字元（排除 '.' 和 '..'）
            return
        }
    }
    start = last-dot

    #{overflow=wrap}
    out-n = .p.len-bytes() - start
    ob []byte = with-cap-len(.p.len-bytes(), .p.len-bytes())
    i <- [0..out-n): {

        #{overflow=wrap}
        ob[i] = .p.byte(start + i)
    }
    out = ob.slice(0, out-n).to-bytes-str()
}

; 路徑判斷
...

; 判斷路徑是否為絕對路徑
; 返回 true=是, false=否
; yes: true=.p 為絕對路徑, false=相對路徑
; [is-abs](#path.is-abs)
path.is-abs = () (yes bool) {
    .p.len-bytes() > 0 -> {
        c = .p.byte(0)
        c == SEP-BYTE -> yes = true
    }
}

; 路徑清理
...

; 清理路徑（移除 . 與 .. 段、折疊重複分隔符）
; 原地修改 .p
;
; 語義（對齊 POSIX normpath / Go filepath.Clean）：
;   - 純 '.' 段一律移除；重複 '/' 折疊；末尾 '/' 移除（根 '/' 保留）
;   - '..' 吃掉前一段；前一段是開頭無法回退的 '..' 時不再吃掉
;   - 絕對路徑的 '..' 不可越過根：'/../a' → '/a'、'/a/..' → '/'
;   - 相對路徑開頭無法回退的 '..' **保留**：'../a' 仍是 '../a'，
;     把它丟成 'a' 會指向完全不同的目錄
;   - 結果為空時回 '.'（相對）或 '/'（絕對）—— 空路徑不是合法路徑
;
; ⚠️ 實作約束：不得用 `o[o.len-bytes()] = v` 逐位元組成長（需擴容時不可靠，
; 見 tests/std-byte-indexing.no），必須先配置 `[]byte` 上界緩衝再從索引 0 起
; **順序**寫入，最後按實際長度切片轉回 str 並整體指派回 .p。
; 輸出永遠不比輸入長，故 len-bytes() 就是安全上界。
; [clean](#path.clean)
path.clean = () {
    n = .p.len-bytes()

    ; 絕對路徑：保留根部 '/'
    rooted = false
    n > 0 -> {
        .p.byte(0) == SEP-BYTE -> rooted = true
    }

    o-b []byte = with-cap-len(n, n)
    on = 0
    rooted -> {
        o-b[0] = SEP-BYTE
        on = 1
    }

    ; 可回退的段數（開頭無法回退的 '..' 不計入）
    nseg = 0

    ; 當前段在**輸入**中的起點
    seg-start = 0
    in-seg = false

    ; 掃到 n 為止，並把 i == n 當作一個虛擬分隔符，好收掉最後一段
    #{overflow=wrap}
    lim = n + 1
    i <- [0..lim): {

        ; is-sep：i 是分隔符（或掃描終點）
        is-sep = true
        i < n -> {
            .p.byte(i) != SEP-BYTE -> is-sep = false
        }

        is-sep -> {
            in-seg -> {

                ; 段 = [seg-start, i)
                #{overflow=wrap}
                seg-n = i - seg-start

                ; 分類：0=普通段, 1='.', 2='..'
                kind = 0
                seg-n == 1 -> {
                    .p.byte(seg-start) == DOT-BYTE -> kind = 1
                }
                seg-n == 2 -> {
                    .p.byte(seg-start) == DOT-BYTE -> {

                        .p.byte(seg-start + 1) == DOT-BYTE -> kind = 2
                    }
                }

                ; 動作：0=略過, 1=追加, 2=回退
                act = 0
                kind == 0 -> act = 1
                kind == 2 -> {
                    nseg > 0 -> act = 2
                    nseg == 0 -> {
                        rooted -> act = 0
                        rooted == false -> act = 1
                    }
                }

                act == 2 -> {

                    ; 回退：把 on 收回到上一個 '/' 之前
                    found = false
                    p = on
                    (p > 1) {

                        ; 算式的型別是 ?i64，必須就地解包（見 test/README.md §5.2 #61）
                        #{overflow=wrap}
                        p = p - 1: {
                            ok -> it

                            -> p
                        }

                        ; o-b[p] 是裸索引 → ?byte（D11），必須就地解包再比較
                        at-p = o-b[p]: {
                            ok -> it

                            -> _
                        }
                        at-p == SEP-BYTE -> {
                            on = p
                            found = true
                            p = 1
                        }
                    }
                    found == false -> {
                        rooted -> on = 1
                        rooted == false -> on = 0
                    }

                    #{overflow=wrap}
                    nseg = nseg - 1: {
                        ok -> it

                        -> 0
                    }
                }

                act == 1 -> {

                    ; 需要分隔符嗎？（根 '/' 已帶，或前一段已帶則不加）
                    on > 0 -> {

                        #{overflow=wrap}
                        prev-idx = on - 1

                        ; 同上：裸索引帶 ?byte，先就地解包
                        prev-at = o-b[prev-idx]: {
                            ok -> it

                            -> _
                        }
                        prev-at != SEP-BYTE -> {
                            o-b[on] = SEP-BYTE

                            #{overflow=wrap}
                            on = on + 1: {
                                ok -> it

                                -> on
                            }
                        }
                    }

                    t <- [0..seg-n): {

                        #{overflow=wrap}
                        o-b[on + t] = .p.byte(seg-start + t)
                    }

                    #{overflow=wrap}
                    on = on + seg-n

                    ; 開頭無法回退的 '..' 不算可回退段
                    kind == 0 -> {

                        #{overflow=wrap}
                        nseg = nseg + 1: {
                            ok -> it

                            -> nseg
                        }
                    }
                }
            }
            in-seg = false
        }

        is-sep == false -> {
            in-seg == false -> {
                seg-start = i
                in-seg = true
            }
        }
    }

    {
        on == 0 -> {
            rooted -> .p = '/'

            rooted == false -> .p = '.'
        }

        on > 0 -> {

            ; ⚠ 必須按 on 重新取一次：緩衝的長度是配置上界 n，回退段之後實際內容
            ; 只到 on，整塊取用會把歷史尾巴一起帶出去（實測 'abc/../de' → 'dec'）。
            .p = o-b.slice(0, on).to-bytes-str()
        }
    }
}

; 路徑分割
...

; 將路徑分割為目錄和檔名
; 原地修改 .p 為目錄部分，返回檔名
; 例：path{ p: '/a/b/c.txt' }.split() → .p='/a/b', f='c.txt'
; （結構體字面量必須多行，此處為簡寫示意）
; f: 分割出的檔名（.p 原地改為其目錄部分）
; [split](#path.split)
path.split = () (f str) {

    ; 找最右邊的 '/'
    last-sep = -1
    i <- [0..self.p.len-bytes()): {
        c = .p.byte(i)
        c == SEP-BYTE -> last-sep = i
    }

    ; 提取檔名
    #{overflow=wrap}
    start = last-sep + 1

    #{overflow=wrap}
    out-n = .p.len-bytes() - start

    ; 逐**位元組**拷貝：不能寫 place-match `f[i]: { ok -> it = … }`——str 的
    ; 下標以「碼點」為閘門，非 ASCII 檔名（日本語 / ファイル）在 i 越過已寫入的
    ; 碼點數後會靜默跳過寫入，尾部留垃圾。[]byte 才是位元組保真的路徑。
    f-b []byte = with-cap-len(out-n, out-n)
    i <- [0..out-n): {

        #{overflow=wrap}
        f-b[i] = .p.byte(start + i)
    }
    f = f-b.to-bytes-str()

    ; 原地修改 .p 為目錄部分
    {
        last-sep < 0 -> {

            ; 無 '/'，.p 變為 '.'（含空路徑；見 dir() 上的說明）
            .p = '.'
            return
        }

        last-sep == 0 -> {

            ; 根目錄 '/'
            .p = '/'
            return
        }

        -> .p.len = last-sep
    }
}
