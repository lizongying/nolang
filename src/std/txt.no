; txt — 固定长度文本类型
;
; txt 是固定 256 字节的文本类型：
;   - 前 255 字节存储数据（data [255]byte）
;   - 最后 1 字节存储长度（len byte，范围 0-255）
;   - 整个结构固定 256 字节，不需要堆分配
;
; 用法（必须类型标注）：
;   t txt = 'hello'
;   n = t.len()
;   c = t[0]
;
; txt {
;     data [255]byte read-only   // 数据区域
;     len byte read-only          // 实际长度（0-255）
; }
;
; 与 str 的区别：
;   - str 是堆分配的可变长度字符串
;   - txt 是栈分配的固定大小字符串（256 字节）
;   - txt 不需要堆分配，适合短文本场景
;   - txt 必须类型标注（t txt = 'abc'）

; ═══════════════════════════════════════════════
; 基础操作
; ═══════════════════════════════════════════════

; txt.len: 返回文本长度
txt.len = () (n i64) {
    n = .len
}

; txt[i]: 返回指定位置的字节值
; build-in
; txt[i] = (i i64) (c byte) {
;     c = .[i]
; }

; txt.eq: 比较两个 txt 是否相等
txt.eq = (b txt) (eq bool) {
    eq = true
    an i64 = .len
    bn i64 = b.len
    an != bn -> {
        eq = false
        return
    }
    i <- [0..an): {
        .[i] != b[i] -> {
            eq = false
            return
        }
    }
}

; txt.copy: 复制 txt
txt.copy = () (dst txt) {
    n i64 = .len
    i <- [0..n): {
        dst[i] = .[i]
    }
    dst.len = .len
}

; txt.fill: 用 byte 值填充整个数据区域
txt.fill = (val byte) {
    i <- [0..255): {
        .[i] = val
    }
}

; txt.clear: 清空文本（len=0）
txt.clear = () {
    .len = 0
}

; txt.empty: 判断是否为空
txt.empty = () (yes bool) {
    yes = true
    .len != 0 -> yes = false
}

; ═══════════════════════════════════════════════
; 转换函数
; ═══════════════════════════════════════════════

; txt.to-str: 将 txt 转换为 str
txt.to-str = () (out str) {
    n i64 = .len
    out = with-len(n)
    i <- [0..n): {
        out[i] = .[i]
    }
}

; txt.to-bytes: 将 txt 转换为 []byte
txt.to-bytes = () (out []byte) {
    n i64 = .len
    out = with-len(n)
    i <- [0..n): {
        out[i] = .[i]
    }
}

; txt.to-hex: 将 txt 转换为十六进制字符串
txt.to-hex = () (out str) {
    HEX = '0123456789ABCDEF'
    n i64 = .len
    out = with-len(n * 2)
    i <- [0..n): {
        b = .[i]
        out[i * 2] = HEX[b >> 4]
        out[i * 2 + 1] = HEX[b & 15]
    }
}

; txt.from-str: 从 str 创建 txt（截断至 255 字节）
; 返回 txt，如果 str 超过 255 字节则截断
txt.from-str = (s str) (out txt) {
    n = s.len
    n > 255 -> n = 255
    i <- [0..n): {
        out[i] = s[i]
    }
    out.len = n
}

; txt.from-bytes: 从 []byte 创建 txt（截断至 255 字节）
; 返回 txt，如果 []byte 超过 255 字节则截断
txt.from-bytes = (b []byte) (out txt) {
    n = b.len
    n > 255 -> n = 255
    i <- [0..n): {
        out[i] = b[i]
    }
    out.len = n
}

; ═══════════════════════════════════════════════
; 查找操作
; ═══════════════════════════════════════════════

; txt.index: 查找子串位置
txt.index = (sub txt) (pos i64) {
    pos = -1
    sn i64 = sub.len
    sn == 0 -> {
        pos = 0
        return
    }
    n i64 = .len
    limit = n - sn
    limit < 0 -> return
    i = 0
    {
        matched = 1
        j <- [0..sn): {
            .[i + j] != sub[j] -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
        i = i + 1
    } (i <= limit)
}

; txt.contains: 是否包含子串
txt.contains = (sub txt) (yes bool) {
    pos = .index(sub)
    yes = true
    pos < 0 -> yes = false
}

; txt.starts-with: 是否以指定前缀开头
txt.starts-with = (sub txt) (yes bool) {
    yes = true
    sn i64 = sub.len
    n i64 = .len
    n < sn -> {
        yes = false
        return
    }
    i <- [0..sn): {
        .[i] != sub[i] -> {
            yes = false
            return
        }
    }
}

; txt.ends-with: 是否以指定后缀结尾
txt.ends-with = (sub txt) (yes bool) {
    yes = true
    sn i64 = sub.len
    n i64 = .len
    n < sn -> {
        yes = false
        return
    }
    start = n - sn
    i <- [0..sn): {
        .[start + i] != sub[i] -> {
            yes = false
            return
        }
    }
}

; ═══════════════════════════════════════════════
; 修改操作
; ═══════════════════════════════════════════════

; txt.append: 追加字节（不超出 255 限制）
txt.append = (b byte) {
    n i64 = .len
    n >= 255 -> return
    .[n] = b
    .len = n + 1
}

; txt.append-str: 追加 str（不超出 255 限制）
txt.append-str = (s str) {
    sn i64 = s.len
    n i64 = .len
    remain = 255 - n
    sn > remain -> sn = remain
    i <- [0..sn): {
        .[n + i] = s[i]
    }
    .len = n + sn
}

; txt.append-txt: 追加 txt（不超出 255 限制）
txt.append-txt = (t txt) {
    tn i64 = t.len
    n i64 = .len
    remain = 255 - n
    tn > remain -> tn = remain
    i <- [0..tn): {
        .[n + i] = t[i]
    }
    .len = n + tn
}

; txt.truncate: 截断到指定长度
txt.truncate = (n i64) {
    n > 255 -> n = 255
    .len < n -> return
    .len = n
}

; ═══════════════════════════════════════════════
; 比较操作
; ═══════════════════════════════════════════════

; txt.compare: 字典序比较
; 返回 -1(a<b), 0(相等), 1(a>b)
txt.compare = (b txt) (r i64) {
    an i64 = .len
    bn i64 = b.len
    min-n = an
    bn < min-n -> min-n = bn
    i <- [0..min-n): {
        ai = .[i]
        bi = b[i]
        {
            ai < bi -> {
                r = -1
                return
            }
            ai > bi -> {
                r = 1
                return
            }
        }
    }
    {
        an < bn -> r = -1
        an > bn -> r = 1
        -> r = 0
    }
}

; ═══════════════════════════════════════════════
; 其他操作
; ═══════════════════════════════════════════════

; txt.reverse: 反转文本内容
txt.reverse = () (out txt) {
    n i64 = .len
    i <- [0..n): {
        out[i] = .[n - 1 - i]
    }
    out.len = n
}

; txt.slice: 截取子串 [start, end) 返回新的 txt
txt.slice = (start i64, end i64) (out txt) {
    start < 0 -> start = 0
    cur-len i64 = .len
    end > cur-len -> end = cur-len
    start >= end -> return
    n = end - start
    n > 255 -> n = 255
    i <- [0..n): {
        out[i] = .[start + i]
    }
    out.len = n
}

; txt.at: 获取指定位置的 byte
txt.at = (idx i64) (b byte) {
    b = 0
    cur-len i64 = .len
    idx < 0 -> return
    idx >= cur-len -> return
    b = .[idx]
}
