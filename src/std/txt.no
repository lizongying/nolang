; txt — 固定長度文本類型
;
; txt 是固定 256 字節的文本類型：
;   - 前 255 字節存儲數據（data [255]byte）
;   - 最後 1 字節存儲長度（len byte，範圍 0-255，單位是「字節」）
;   - 整個結構固定 256 字節，不需要堆分配
;
; 長度語義（與 str 對齊）：
;   - t.len()        返回「字符（code point）數量」，等價於 t.count()
;   - t.len-bytes()  返回「字節數量」（底層 UTF-8 緩衝區實際長度）
;   - 內部 len 字段  仍是字節長度；索引/切片/寫入等字節操作都以 len-bytes() 為準
;   - ASCII 內容下三者相等；含多字節 UTF-8 時 len() < len-bytes()
;
; 索引語義（按碼點，與 str 的讀取行為對齊）：
;   - txt[i] 讀取：返回碼點索引 i 處的 char（UTF-8 解碼），越界返回 -1
;   - txt[i] = v 寫入：把 v 作為碼點重新 UTF-8 編碼寫回，後移尾部字節；
;     i == 碼點數時等價追加；總字節長超過 255 的部分丟棄
;     （注意：str 的 s[i] = v 仍是字節級寫入，兩者在此有意分叉）
;   - 字節級原始讀寫用 .byte(i) / .set-byte(i, b) 成對方法（緩衝區構建代碼專用）
;
; 用法（必須類型標注）：
;   t txt = 'hello'
;   n = t.len()          ; 字符數
;   b = t.len-bytes()    ; 字節數
;   c = t[0]             ; 首個碼點（char）
;   b = t.byte(0)        ; 首個字節（byte）
;
; txt {
;     data [255]byte read-only   // 數據區域
;     len byte read-only          // 字節長度（0-255）
; }
;
; 與 str 的區别：
;   - str 是堆分配的可變長度字符串
;   - txt 是棧分配的固定大小字符串（256 字節）
;   - txt 不需要堆分配，适合短文本場景
;   - txt 必須類型標注（t txt = 'abc'）

; ═══════════════════════════════════════════════
; 基础操作
; ═══════════════════════════════════════════════

; 返回字符（code point）數量（與 str.len 對齊；字節長度用 txt.len-bytes()）
; n: 碼點（字符）數量（與 str.len 對齊；位元組長度用 len-bytes()）
; [len](#txt.len)
txt.len = () (n i64) {
    n = .count()
}

; txt[i]: 按碼點索引讀取，返回 char（UTF-8 解碼，越界返回 -1）；
; txt[i] = v 按碼點索引寫入（重新 UTF-8 編碼並移動尾部字節，超 255 字節部分丟棄）。
; 字節級原始訪問請用 .byte(i) / .set-byte(i, b)。
; build-in
; txt[i] = (i i64) (c byte) {
;     c = .[i]
; }
;
; 返回「位元組」下標 i 處的原始位元組值（raw byte 讀取）
; 與 txt[i] 的碼點索引語意不同；緩衝區逐位元組構建程式碼專用
; 回傳 ?byte：越界（i < 0 或 i >= len-bytes()）時回傳 nil，呼叫端必須處理 option
; 由編譯器內建處理（#{buildin}）：codegen 攔截展開為「邊界檢查 + GEP+load」，
; 無 std 函式體；簽名註冊於 src/builtin/str.go 的 BuiltinMethodList
; （Intercepted，經 bare-name 回落與 str.byte 共享同一條目）
; i: 位元組下標（非碼點）
; c: ok=該位置原始位元組值, nil=i 越界
; [byte](#txt.byte)
#{buildin}
txt.byte = (i i64) (c ?byte) {
}

;
; 在「位元組」下標 i 處寫入原始位元組 b（raw byte 寫入，len 不變）
; txt.byte 的配對寫者；取代 txt[i] = b（後者按碼點重新編碼並移動尾部位元組）
;
; b 宣告為 byte：表層實參若是 option（.byte(i)、hex-table[..] 等）由內建參數檢查直接
; 放過（funcargs.go 的 `?` 跳過）；若為純 i64/char（如 bv、hex-table[..] 的 char）則在
; 呼叫端以位元運算遮罩 `& 255` 窄化。與 src/builtin/str.go 條目一致。
;
; 回傳 ?bool（可失敗）：越界（i < 0 或 i >= 255 實體容量）時回傳 nil 並**跳過寫入**，
; 成功回傳 some(true)。邊界以「實體容量」（txt 為固定 255 位元組緩衝區）為準，而非
; len，因此「先填緩衝再 set len」的構建程式（fill / from-str / to-hex / join）照舊可用。
; 呼叫端以裸陳述丟棄 ?bool 是合法的（optunuse 只針對已綁定的名稱）。
; i: 位元組下標
; b: 寫入的位元組值
; ok: ok=true=寫入成功, nil=i 越界（跳過寫入）
; [set-byte](#txt.set-byte)
#{buildin}
txt.set-byte = (i i64, b byte) (ok ?bool) {
}

; 比較兩個 txt 是否相等
; ⚠️ 2026-09-21 重寫。舊實現用一條 `->` 管線（`.byte(k) - b.byte(k); c != 0 -> ok = 0;
; k == an - 1 -> ok == 0 -> eq = false; k = k + 1`）在**最後一個字節**才回頭判定，
; 於是 `t('hello').eq('world')` 這種「長度相同、內容不同」的情況永遠回傳 true
; —— `tests/txt.no` 的 `neq:` 一行一直在打印 1，並且被凍進了 golden baseline。
; txt.compare 已經是逐字節比較且長度不同時正確分流的版本，直接複用即可。
; b: 比較的目標 txt
; eq: true=兩者逐位元組全等
; [eq](#txt.eq)
txt.eq = (b txt) (eq bool) {
    eq = .compare(b) == 0
}

; 複製 txt
; ⚠️ 已廢棄（DEPRECATED）：賦值 `a = b` 即為複製語義——txt 是值類型（棧上 256
; 位元組內聯緩衝區，data[255] + len），賦值即逐位元組拷貝。請改用直接賦值；保留僅為兼容。
; dst: 副本（已棄用：txt 為值類型，賦值即逐位元組拷貝）
; [copy](#txt.copy)
txt.copy = () (dst txt) {
    n i64 = .len-bytes()
    i <- [0..n): {
        dst.set-byte(i, .byte(i))
    }
    dst.len = .len-bytes()
}

; 用 byte 值填充整個數據區域
; val: 用於填充整個資料區的位元組值
; [fill](#txt.fill)
txt.fill = (val byte) {
    i <- [0..255): {
        .set-byte(i, val)
    }
}

; 清空文本（len=0）
; [clear](#txt.clear)
txt.clear = () {
    .len = 0
}

; 判斷是否為空
; yes: 實際長度 len 是否為 0
; [empty](#txt.empty)
txt.empty = () (yes bool) {
    yes = true
    .len-bytes() != 0 -> yes = false
}

; ═══════════════════════════════════════════════
; 轉換函數
; ═══════════════════════════════════════════════

; 將 txt 轉換為 str
; out: 等內容的 str（按實際位元組長度新建堆緩衝）
; [to-str](#txt.to-str)
txt.to-str = () (out str) {
    n i64 = .len-bytes()
    out = with-len(n)
    i <- [0..n): {
        out.set-byte(i, .byte(i))
    }
}

; 將 txt 轉換為 []byte
; out: 前 len 個位元組的拷貝（[]byte）
; [to-bytes](#txt.to-bytes)
txt.to-bytes = () (out []byte) {

    ; ⚠️ 不能用 out.set-byte(i, …)：set-byte 內建只認 str / txt receiver
    ;    （GEP 是按 %txt 內聯緩衝 / %str-long data 指標算的），餵 []byte 會
    ;    報 `EmitLLVM: unsupported builtin []t.set-byte`。改用切片元素寫入。
    n i64 = .len-bytes()
    b []byte = with-len(n)
    i <- [0..n): {
        b[i]: {
            ok -> it = .byte(i)

            -> _
        }
    }
    out = b
}

; 將 txt 轉換為十六進制字符串
; out: 每位元組轉兩個小寫十六進位字元的 str
; [to-hex](#txt.to-hex)
txt.to-hex = () (out str) {

    hex-table = '0123456789ABCDEF'
    n i64 = .len-bytes()

    #{overflow=wrap}
    out = with-len(n * 2)
    i <- [0..n): {

        b = .byte(i)

        #{overflow=wrap}
        out.set-byte(i * 2, hex-table[b >> 4] & 255)

        #{overflow=wrap}
        out.set-byte(i * 2 + 1, hex-table[b & 15] & 255)
    }
}

; 從 str 創建 txt（截斷至 255 字節）
; 返回 txt，如果 str 超過 255 字節则截斷
; s: 來源 str
; out: 拷入 txt 的內容（超過 255 位元組部分截斷）
; [from-str](#txt.from-str)
txt.from-str = (s str) (out txt) {
    n = s.len-bytes()
    n > 255 -> n = 255
    i <- [0..n): {
        out.set-byte(i, s.byte(i))
    }
    out.len = n
}

; 從 []byte 創建 txt（截斷至 255 字節）
; 返回 txt，如果 []byte 超過 255 字節则截斷
; b: 來源位元組
; out: 拷入 txt 的內容（超過 255 位元組部分截斷）
; [from-bytes](#txt.from-bytes)
txt.from-bytes = (b []byte) (out txt) {
    n = b.len()
    n > 255 -> n = 255
    i <- [0..n): {
        out.set-byte(i, b[i])
    }
    out.len = n
}

; ═══════════════════════════════════════════════
; 查找操作
; ═══════════════════════════════════════════════

; 查找子串位置（從 0 開始）
; sub: 要找的子 txt
; pos: 首次出現的碼點位置，未找到 -1
; [index](#txt.index)
txt.index = (sub txt) (pos i64) {
    pos = .index-from(sub, 0)
}

; 是否包含子串
; sub: 要找的子 txt
; yes: 是否含有 sub
; [contains](#txt.contains)
txt.contains = (sub txt) (yes bool) {
    pos = .index-from(sub, 0)
    yes = pos >= 0
}

; 是否以指定前綴開頭
; sub: 前綴子 txt
; yes: 是否以 sub 開頭
; [starts-with](#txt.starts-with)
txt.starts-with = (sub txt) (yes bool) {
    yes = .index-from(sub, 0) == 0
}

; 是否以指定後綴結尾
; sub: 後綴子 txt
; yes: 是否以 sub 結尾
; [ends-with](#txt.ends-with)
txt.ends-with = (sub txt) (yes bool) {

    yes = false
    sn = sub.len-bytes()
    n i64 = .len-bytes()
    sn == 0 -> yes = true
    n < sn -> yes = false

    #{overflow=wrap}
    off = n - sn
    yes = .index-from(sub, off) == off
}

; ═══════════════════════════════════════════════
; 修改操作
; ═══════════════════════════════════════════════

; 追加字節（不超出 255 限制）
; b: 追加的位元組（超出 255 上限則忽略）
; [append](#txt.append)
txt.append = (b byte) {

    n i64 = .len-bytes()
    n >= 255 -> return
    .set-byte(n, b)

    #{overflow=wrap}
    .len = n + 1
}

; 追加 str（不超出 255 限制）
; s: 追加的 str（超出 255 上限則截斷追加）
; [append-str](#txt.append-str)
txt.append-str = (s str) {

    sn i64 = s.len-bytes()
    n i64 = .len-bytes()

    ; D1：`-` 的結果恆為 `?i64`，remain 當普通整數用 → 兩段式 match 解包。
    #{overflow=wrap}
    remain-opt = 255 - n
    remain = 0
    remain-opt: {
        ok -> remain = it

        -> remain = 0
    }
    sn > remain -> sn = remain
    i <- [0..sn): {

        #{overflow=wrap}
        .set-byte(n + i, s.byte(i))
    }

    #{overflow=wrap}
    .len = n + sn
}

; 追加 txt（不超出 255 限制）
; t: 追加的 txt（超出 255 上限則截斷追加）
; [append-txt](#txt.append-txt)
txt.append-txt = (t txt) {
    tn = t.len-bytes()
    n i64 = .len-bytes()

    #{overflow=wrap}
    remain = 255 - n
    tn > remain -> tn = remain
    i <- [0..tn): {

        #{overflow=wrap}
        .set-byte(n + i, t.byte(i))
    }

    #{overflow=wrap}
    .len = n + tn
}

; 截斷到指定長度
; n: 截斷後保留的位元組長度（n 小於現長時生效）
; [truncate](#txt.truncate)
txt.truncate = (n i64) {
    rn = n
    rn > 255 -> rn = 255
    .len-bytes() < rn -> return
    .len = rn
}

; ═══════════════════════════════════════════════
; 比較操作
; ═══════════════════════════════════════════════

; 字典序比較
; 返回 -1(a<b), 0(相等), 1(a>b)
; b: 比較目標 txt
; r: 字典序 -1(接收者<b)/0(相等)/1(>)
; [compare](#txt.compare)
txt.compare = (b txt) (r i64) {
    an i64 = .len-bytes()
    bn = b.len-bytes()
    min-n = an
    bn < min-n -> min-n = bn
    i <- [0..min-n): {
        ai = .byte(i)
        bi = b.byte(i)
        {
            ai < bi -> {
                r = -1
                return
            }

            ai > bi -> {
                r = 1
                return
            }
        }
    }
    {
        an < bn -> r = -1

        an > bn -> r = 1

        -> r = 0
    }
}

; ═══════════════════════════════════════════════
; 其他操作
; ═══════════════════════════════════════════════

; 反轉文本內容
; out: 位元組逆序後的新 txt
; [reverse](#txt.reverse)
txt.reverse = () (out txt) {
    n i64 = .len-bytes()
    i <- [0..n): {

        #{overflow=wrap}
        out.set-byte(i, .byte(n - 1 - i))
    }
    out.len = n
}

; 截取子串 [start, end) 返回新的 txt
; start: 起始碼點下標（含）
; end: 結束碼點下標（不含）
; out: 按碼點範圍 [start,end) 截取的新 txt
; [slice](#txt.slice)
txt.slice = (start i64, end i64) (out txt) {
    r-start = start
    r-end = end
    r-start < 0 -> r-start = 0
    cur-len i64 = .len-bytes()
    r-end > cur-len -> r-end = cur-len

    ; 空區間（start >= end）必須回傳**長度 0 的 txt**。
    ; 直接 return 的話 out 的結果 slot 從沒被寫過，長度是堆疊殘值 ⇒ 非決定性；
    ; 連帶污染 split（前導/尾隨/相鄰分隔符）、split-n、replace-* 的空欄位。
    r-start >= r-end -> {
        out.len = 0
        return
    }

    #{overflow=wrap}
    n = r-end - r-start
    n > 255 -> n = 255
    i <- [0..n): {

        #{overflow=wrap}
        out.set-byte(i, .byte(r-start + i))
    }
    out.len = n
}

; [deprecated] txt.at: 字符（碼點）索引讀取——請改用 t[idx]（原生索引，回傳 ?char）
; 獲取指定字符位置的碼點值（位元組偏移請用 t.byte(i)）
; 返回 b ?byte: 越界返回 nil；超出 byte 範圍的碼點截斷
; idx: 碼點（字符）下標
; b: ok=該碼點值（超 byte 範圍截斷）, nil=越界
; [at](#txt.at)
txt.at = (idx i64) (b ?byte) {
    b = nil
    cur-len = .len()
    idx < 0 -> return
    idx >= cur-len -> return
    b = .[idx]
}

; ═══════════════════════════════════════════════
; UTF-8 解碼
; ═══════════════════════════════════════════════

; 從位置 i 解碼一個 UTF-8 碼點
; 返回 cp=碼點值, clen=序列位元組長度（1~4）
; i: 起解碼的位元組下標
; cp: 解出的碼點值
; clen: 該碼點 UTF-8 序列位元組長度（1~4）
; [decode-cp](#txt.decode-cp)
txt.decode-cp = (i i64) (cp i64, clen i64) {
    b = .byte(i)
    cp = b
    clen = 1
    {
        b < 0x80 -> {
            cp = b
            clen = 1
        }

        b < 0xe0 -> {
            cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
            clen = 2
        }

        b < 0xf0 -> {
            cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
            clen = 3
        }

        -> {
            cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
            clen = 4
        }
    }
}

; ═══════════════════════════════════════════════
; 大小寫轉換
; ═══════════════════════════════════════════════

; 將文字轉為大寫（ASCII）
; 返回新 txt
; val: ASCII 小寫轉大寫後的新 txt（其餘位元組原樣保留）
; [to-upper](#txt.to-upper)
txt.to-upper = () (val txt) {
    n i64 = .len-bytes()
    i <- [0..n): {
        c = .byte(i)
        {
            c >= 97 && c <= 122 -> {

                #{overflow=wrap}
                val.set-byte(i, c - 32)
            }

            -> {
                val.set-byte(i, c)
            }
        }
    }
    val.len = n
}

; 將文字轉為小寫（ASCII）
; 返回新 txt
; val: ASCII 大寫轉小寫後的新 txt（其餘位元組原樣保留）
; [to-lower](#txt.to-lower)
txt.to-lower = () (val txt) {
    n i64 = .len-bytes()
    i <- [0..n): {
        c = .byte(i)
        {
            c >= 65 && c <= 90 -> {

                #{overflow=wrap}
                val.set-byte(i, c + 32)
            }

            -> {
                val.set-byte(i, c)
            }
        }
    }
    val.len = n
}
;
; 從 char 切片構造新 txt（逐碼點寫入，UTF-8 編碼；超過 255 字節 的內容自動丟棄）
; ⚠️ 不可用 `val[i]: { ok -> it = cs[i] }` 逐碼點寫入：D9 的 place-match 以
; **讀取**作閘門，len=0 的新 txt 上讀 `val[0]` 越界回 nil，ok 臂永不執行，
; 整個函式因此回傳空字串（`txt.from-chars` 曾因此靜默失真）。
; txt.new（ForwardFunc: chars-new）正是為此存在的內建：一次寫入全部碼點並設定字節長度。
; cs: 碼點切片（[]char）
; t: ok=逐碼點 UTF-8 編碼後的新 txt, nil=編碼結果超過 255 位元組（超出部分丟棄）
; [from-chars](#txt.from-chars)
txt.from-chars = (cs []char) (t ?txt) {
    v txt = txt.new(cs)
    t = v
}

; txt.new: 從 char 切片構造 txt（模塊級構造器，返回具體 txt）
; 編譯期內建（ForwardFunc: chars-new）：[]char 直接逐字節轉成 bytes 並一次性寫入長度，
; 無逐字節 .no 循环。txt 是內置類型，字節/長度無法在用户代碼裡操作，故整體轉換由編譯器生成 IR。
; 超過 255 字節的部分自動丟棄（長度字節 clamp 到 255）。
; cs: 碼點切片（[]char）
; t: 逐位元組重編碼後的 txt（超過 255 位元組部分自動丟棄）
; [new](#txt.new)
#{buildin}
new = (cs []char) (t txt) {
}

; ═══════════════════════════════════════════════
; 裁剪
; ═══════════════════════════════════════════════

; 去除首尾空白字元
; 返回新 txt
; val: 去除首尾空白後的新 txt
; [trim](#txt.trim)
txt.trim = () (val txt) {
    n i64 = .len-bytes()

    ; 預先宣告 end/m 為 plain i64：統一 option 規則（D6）下，首現算術賦值
    ; （end = n - 1、m = end - start + 1）會被推斷成 ?i64，之後 .byte(end)
    ; 的索引、val.len = m 的字段寫入拿到 option 即報型別錯誤。先宣告再賦值
    ; 可讓迴圈內的算術保持 plain（與 pos = pos + 1 同一機制）。
    end = 0
    m = 0
    start <- [0..n): {
        c = .byte(start)
        c != 32 && c != 9 && c != 10 && c != 13 -> break
    }

    #{overflow=wrap}
    end = n - 1
    (end >= start) {
        c = .byte(end)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        end = end - 1
    }

    #{overflow=wrap}
    m = end - start + 1
    m < 0 -> return
    i <- [0..m): {

        #{overflow=wrap}
        val.set-byte(i, .byte(start + i))
    }
    val.len = m
}

; 去除首尾指定字元（UTF-8 碼點）
; 返回新 txt
; ch: 首尾要去除的碼點
; val: 去除首尾 ch 後的新 txt
; [trim-char](#txt.trim-char)
txt.trim-char = (ch char) (val txt) {
    n i64 = .len-bytes()
    start = 0
    (start < n) {
        b-opt = .byte(start)
        b = b-opt: {
            ok -> it

            -> _
        }
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(start + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(start + 1) & 0x3f) << 6) | (.byte(start + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(start + 1) & 0x3f) << 12) | ((.byte(start + 2) & 0x3f) << 6) | (.byte(start + 3) & 0x3f)
                clen = 4
            }
        }
        cp != ch -> break

        #{overflow=wrap}
        start = start + clen
    }
    end = start
    i = start
    (i < n) {
        b-opt = .byte(i)
        b = b-opt: {
            ok -> it

            -> _
        }
        cp = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        cp != ch -> end = i + clen

        #{overflow=wrap}
        i = i + clen
    }

    #{overflow=wrap}
    m-opt = end - start
    m = 0
    m-opt: {
        ok -> m = it

        -> m = 0
    }
    m < 0 -> return
    j <- [0..m): {

        #{overflow=wrap}
        val.set-byte(j, .byte(start + j))
    }
    val.len = m
}

; ═══════════════════════════════════════════════
; 重複
; ═══════════════════════════════════════════════

; 將內容重複 times 次（上限 255 位元組）
; 返回新 txt
; times: 重複次數
; val: 串接 times 份後的新 txt（超過 255 位元組截斷）
; [repeat](#txt.repeat)
txt.repeat = (times i64) (val txt) {
    n i64 = .len-bytes()
    cap = 255
    pos = 0
    i <- [0..times): {
        j <- [0..n): {
            pos < cap -> {
                val.set-byte(pos, .byte(j))

                #{overflow=wrap}
                pos = pos + 1
            }
        }
    }
    val.len = pos
}

; ═══════════════════════════════════════════════
; 統計
; ═══════════════════════════════════════════════

; 統計 code point 數量
; cnt: 碼點（char）數量
; [count](#txt.count)
txt.count = () (cnt i64) {
    cnt = 0
    n i64 = .len-bytes()
    i = 0
    (i < n) {
        b = .byte(i)

        #{overflow=wrap}
        {
            b < 0x80 -> i = i + 1

            b < 0xe0 -> i = i + 2

            b < 0xf0 -> i = i + 3

            -> i = i + 4
        }

        #{overflow=wrap}
        cnt = cnt + 1
    }
}

; ═══════════════════════════════════════════════
; 反向 / 限定查找
; ═══════════════════════════════════════════════

; 從 from 位置開始查找子串
; 返回首次出現位置，未找到返回 -1
; target: 要找的子 txt
; from: 起始碼點位置（含）
; pos: 首次出現的碼點位置，未找到 -1
; [index-from](#txt.index-from)
txt.index-from = (target txt, from i64) (pos i64) {
    r-from = from
    pos = -1
    r-from < 0 -> r-from = 0
    n i64 = .len-bytes()
    m = target.len-bytes()
    m == 0 -> r-from <= n -> pos = r-from
    n < m -> pos = -1

    #{overflow=wrap}
    limit = n - m
    i <- [0..n]: {

        #{overflow=wrap}
        i >= r-from -> i <= limit -> {
            ok = 1
            k = 0
            (k < m) {

                #{overflow=wrap}
                c = .byte(i + k) - target.byte(k)
                c != 0 -> ok = 0
                k == m - 1 -> ok == 1 -> pos == -1 -> pos = i
                k = k + 1
            }
        }
    }
}

; 反向查找子串最後出現位置
; 返回位置，未找到 -1
; target: 要找的子 txt
; pos: 最後出現的碼點位置，未找到 -1
; [rindex](#txt.rindex)
txt.rindex = (target txt) (pos i64) {
    pos = -1
    n i64 = .len-bytes()
    m = target.len-bytes()
    m == 0 -> pos = n
    n < m -> pos = -1

    #{overflow=wrap}
    limit = n - m
    i <- [0..n]: {

        #{overflow=wrap}
        i <= limit -> {
            ok = 1
            k = 0
            (k < m) {

                #{overflow=wrap}
                c = .byte(i + k) - target.byte(k)
                c != 0 -> ok = 0
                k == m - 1 -> ok == 1 -> pos = i
                k = k + 1
            }
        }
    }
}

; rindex 別名
; target: 要找的子 txt
; pos: 最後出現的碼點位置，未找到 -1（rindex 別名）
; [last-index](#txt.last-index)
txt.last-index = (target txt) (pos i64) {
    pos = .rindex(target)
}

; 從 from 位置反向查找子串（返回位置 >= from 的最後一次出現）
; target: 要找的子 txt
; from: 反向查找下界（含，碼點）
; pos: 最後出現（>= from）的碼點位置，未找到 -1
; [rindex-from](#txt.rindex-from)
txt.rindex-from = (target txt, from i64) (pos i64) {
    r-from = from
    pos = -1
    r-from < 0 -> r-from = 0
    n i64 = .len-bytes()
    m = target.len-bytes()
    m == 0 -> r-from <= n -> pos = n
    n < m -> pos = -1

    #{overflow=wrap}
    limit = n - m
    i <- [0..n]: {

        #{overflow=wrap}
        i >= r-from -> i <= limit -> {
            ok = 1
            k = 0
            (k < m) {

                #{overflow=wrap}
                c = .byte(i + k) - target.byte(k)
                c != 0 -> ok = 0
                k == m - 1 -> ok == 1 -> pos = i
                k = k + 1
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 數值解析
; ═══════════════════════════════════════════════

; 將文字解析為有號 64 位整數
; 返回 Option：ok(n) / nil（空）/ err('msg')
; val: ok=解析出的 i64, nil=空, err=含非數字字元/孤立 +/-/超範圍
; [to-i64](#txt.to-i64)
txt.to-i64 = () (val ?i64) {
    s = .to-str()
    val = s.to-i64()
}

; 解析為 i8（範圍 -128~127）
; val: ok=範圍內（-128~127）的 i8, nil=空, err=非法或超出範圍
; [to-i8](#txt.to-i8)
txt.to-i8 = () (val ?i8) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            n >= 0 - 128 && n <= 127 -> val = n

            -> val = err('out of range for i8')
        }
    }
}

; 解析為 i16（範圍 -32768~32767）
; val: ok=範圍內（-32768~32767）的 i16, nil=空, err=非法或超出範圍
; [to-i16](#txt.to-i16)
txt.to-i16 = () (val ?i16) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            n >= 0 - 32768 && n <= 32767 -> val = n

            -> val = err('out of range for i16')
        }
    }
}

; 解析為 i32（範圍 -2147483648~2147483647）
; val: ok=範圍內的 i32, nil=空, err=非法或超出範圍
; [to-i32](#txt.to-i32)
txt.to-i32 = () (val ?i32) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {
            n = it

            #{overflow=wrap}
            n >= 0 - 2147483648 && n <= 2147483647 -> val = n

            -> val = err('out of range for i32')
        }
    }
}

; 解析為 u8（範圍 0~255）
; val: ok=範圍內（0~255）的 u8, nil=空, err=非法或超出範圍
; [to-u8](#txt.to-u8)
txt.to-u8 = () (val ?u8) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0

    ; ⚠️ 迴圈上界必須是「長度」，不能借累加器 n 來用：
    ;    [start..n) 在 n=0 時是 [0..0) == 空迴圈 ⇒ 永遠回 0。
    n-len i64 = .len-bytes()
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u8: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n-len): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for u8')
    }
}

; 解析為 u16（範圍 0~65535）
; val: ok=範圍內（0~65535）的 u16, nil=空, err=非法或超出範圍
; [to-u16](#txt.to-u16)
txt.to-u16 = () (val ?u16) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0

    ; ⚠️ 迴圈上界必須是「長度」，不能借累加器 n 來用：
    ;    [start..n) 在 n=0 時是 [0..0) == 空迴圈 ⇒ 永遠回 0。
    n-len i64 = .len-bytes()
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u16: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n-len): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 65535 -> val = n

        -> val = err('out of range for u16')
    }
}

; 解析為 u32（範圍 0~4294967295）
; val: ok=範圍內的 u32, nil=空, err=非法或超出範圍
; [to-u32](#txt.to-u32)
txt.to-u32 = () (val ?u32) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0

    ; ⚠️ 迴圈上界必須是「長度」，不能借累加器 n 來用：
    ;    [start..n) 在 n=0 時是 [0..0) == 空迴圈 ⇒ 永遠回 0。
    n-len i64 = .len-bytes()
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u32: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n-len): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 4294967295 -> val = n

        -> val = err('out of range for u32')
    }
}

; 解析為 u64（拒絕負號）
; val: ok=非負整數（拒絕負號）, nil=空, err=含非數字字元
; [to-u64](#txt.to-u64)
txt.to-u64 = () (val ?u64) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    c = .byte(0)
    c == 45 -> {
        val = err('invalid u64: negative sign not allowed')
        return
    }
    n = 0

    ; ⚠️ 迴圈上界必須是「長度」，不能借累加器 n 來用：
    ;    [start..n) 在 n=0 時是 [0..0) == 空迴圈 ⇒ 永遠回 0。
    n-len i64 = .len-bytes()
    start = 0
    c == 43 -> start = 1
    i <- [start..n-len): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    val = n
}

; 解析為 byte（與 u8 等價）
; val: ok=範圍內（0~255）的 byte, nil=空, err=非法或超出範圍
; [to-byte](#txt.to-byte)
txt.to-byte = () (val ?byte) {
    .len-bytes() == 0 -> {
        val = nil
        return
    }
    n = 0

    ; ⚠️ 迴圈上界必須是「長度」，不能借累加器 n 來用：
    ;    [start..n) 在 n=0 時是 [0..0) == 空迴圈 ⇒ 永遠回 0。
    n-len i64 = .len-bytes()
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid byte: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len-bytes() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n-len): {
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for byte')
    }
}

; 將文字解析為 f64（回傳 ?f64，空字串→nil，非數字→err）
; 複用 str 的解析邏輯（先轉 str 再呼叫 str.to-f64）
; val: ok=解析出的 f64, nil=空, err=含非數字字元
; [to-f64](#txt.to-f64)
txt.to-f64 = () (val ?f64) {
    s = .to-str()
    val = s.to-f64()
}

; 將文字解析為 f32
; val: ok=單精度 f32, nil=空, err=含非數字字元
; [to-f32](#txt.to-f32)
txt.to-f32 = () (val ?f32) {
    f = .to-f64()
    {
        f == nil -> {
            val = nil
            return
        }

        f == err -> {
            val = err('txt.to-f32: parse error')
            return
        }
    }
    val = f.to-f32()
}

; 將 "true"/"false" 解析為 bool
; val: ok=true/false（僅認「true」/「false」）, nil=空, err=其他
; [to-bool](#txt.to-bool)
txt.to-bool = () (val ?bool) {
    {
        .len-bytes() == 0 -> {
            val = nil
            return
        }

        .len-bytes() == 4 -> {
            .byte(0) == 116 && .byte(1) == 114 && .byte(2) == 117 && .byte(3) == 101 -> {
                val = true
                return
            }
        }

        .len-bytes() == 5 -> {
            .byte(0) == 102 && .byte(1) == 97 && .byte(2) == 108 && .byte(3) == 115 && .byte(4) == 101 -> {
                val = false
                return
            }
        }
    }
    val = err('not a bool')
}

; ═══════════════════════════════════════════════
; 替換
; ═══════════════════════════════════════════════

; 將所有 old-ch 替換為 new-ch（UTF-8 碼點）
; 返回新 txt（超過 255 位元組則截斷）
; old-ch: 被替換的碼點
; new-ch: 替換後的碼點
; val: 逐碼點替換後的新 txt（超過 255 位元組截斷）
; [replace-char](#txt.replace-char)
txt.replace-char = (old-ch char, new-ch char) (val txt) {
    n i64 = .len-bytes()
    cap = 255
    pos = 0
    i = 0
    (i < n) {
        b-opt = .byte(i)
        b = b-opt: {
            ok -> it

            -> _
        }
        cp i64 = b
        clen = 1
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        {
            cp == old-ch -> {

                ; 先把 new-ch 依 UTF-8 編成 1~4 個位元組，用**迴圈**逐位元組 set-byte 寫入
                ; （不可用多個相鄰 `pos < cap -> { }` 短路易式陳述——實測只有第一個會執行，
                ;  與 replace-str 相同的迴圈寫法才可靠。）
                encw i64 = 1
                lead i64 = 0

                ; 預先宣告 shift/bv 為 plain i64：統一 option 規則（D6）下，迴圈內
                ; 的裸賦值若為首現宣告（shift = (encw-1-enc)*6）會被推斷成 ?i64，
                ; 之後 set-byte 的值參數拿到 option 即報 bad value type。先宣告再賦值
                ; 可讓讀迴圈內的算術保持 plain（與 pos = pos + 1 同一機制）。
                shift i64 = 0
                bv i64 = 0
                {
                    new-ch < 0x80 -> {
                        encw = 1
                        lead = 0
                    }

                    new-ch < 0x800 -> {
                        encw = 2
                        lead = 0xc0
                    }

                    new-ch < 0x10000 -> {
                        encw = 3
                        lead = 0xe0
                    }

                    -> {
                        encw = 4
                        lead = 0xf0
                    }
                }
                enc <- [0..encw): {

                    #{overflow=wrap}
                    shift = (encw - 1 - enc) * 6
                    bv = 0x80 | ((new-ch >> shift) & 0x3f)
                    enc == 0 -> {
                        bv = lead | (new-ch >> shift)
                    }
                    pos < cap -> {
                        val.set-byte(pos, bv & 255)
                        pos = pos + 1
                    }
                }
            }

            -> {
                k <- [0..clen): {
                    pos < cap -> {

                        #{overflow=wrap}
                        val.set-byte(pos, .byte(i + k))
                        pos = pos + 1
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + clen
    }
    val.len = pos
}

; 將所有 old 子串替換為 new 子串
; 返回新 txt（超過 255 位元組則截斷）
; old: 被替換的子 txt
; new: 替換後的子 txt
; val: 替換後的新 txt（超過 255 位元組截斷）
; [replace-str](#txt.replace-str)
txt.replace-str = (old txt, new txt) (val txt) {
    old.len-bytes() == 0 -> {
        val = .slice(0, .len-bytes())
        return
    }
    n i64 = .len-bytes()
    old-len = old.len-bytes()
    new-len = new.len-bytes()
    cap = 255
    pos = 0
    i = 0
    (i < n) {
        match = 1
        j = 0
        (j < old-len) {

            #{overflow=wrap}
            i + j >= n -> {
                match = 0
                break
            }

            #{overflow=wrap}
            .byte(i + j) != old.byte(j) -> {
                match = 0
                break
            }

            #{overflow=wrap}
            j = j + 1
        }
        match -> {
            k <- [0..new-len): {

                #{overflow=wrap}
                pos < cap -> {
                    val.set-byte(pos, new.byte(k))
                    pos = pos + 1
                }
            }

            #{overflow=wrap}
            i = i + old-len
        }

        -> {

            #{overflow=wrap}
            pos < cap -> {
                val.set-byte(pos, .byte(i))
                pos = pos + 1
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
    val.len = pos
}

; 限定替換次數
; old txt, new txt, n i64: 最大替換次數（n<=0 不替換）
; old: 被替換的子 txt
; new: 替換後的子 txt
; n: 最大替換次數（n <= 0 不替換）
; val: 限次替換後的新 txt（超過 255 位元組截斷）
; [replace-n](#txt.replace-n)
txt.replace-n = (old txt, new txt, n i64) (val txt) {
    n <= 0 -> {
        val = .slice(0, .len-bytes())
        return
    }
    old.len-bytes() == 0 -> {
        val = .slice(0, .len-bytes())
        return
    }
    parts = .split(old)
    np = parts.len()
    np <= 1 -> {
        val = .slice(0, .len-bytes())
        return
    }

    #{overflow=wrap}
    repl = np - 1
    repl > n -> repl = n
    total = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {

            ; ⚠️ 原本寫成 `i <= repl -> total = total + new.len() -> total = total + old.len()`。
            ; `->` 是**短路管線運算子**，不是 if/else：條件成立時兩個指派**都會**執行
            ; （副作用節點不會把 state 切成失敗），條件不成立時**兩個都不會**執行
            ; —— 分隔符長度怎麼算都是錯的。要二選一就得用 `{}` if/else-if 群組。
            ; （同一個寫法也讓 `no fmt` 不冪等，見 url.no 的同款註解。）
            {
                i <= repl -> {

                    #{overflow=wrap}
                    total = total + new.len-bytes()
                }

                -> total = total + old.len-bytes()
            }
        }

        #{overflow=wrap}
        total = total + parts[i].len-bytes()
    }
    total > 255 -> total = 255
    cap = 255
    pos = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {
            sep = new
            i > repl -> sep = old
            j <- [0..sep.len-bytes()): {
                pos < cap -> {
                    val.set-byte(pos, sep.byte(j))
                    pos = pos + 1
                }
            }
        }
        parts[i]: {
            ok -> {
                s = it
            }

            -> {
                s = ''
            }
        }
        j <- [0..s.len-bytes()): {

            #{overflow=wrap}
            pos < cap -> {
                val.set-byte(pos, s.byte(j))
                pos = pos + 1
            }
        }
    }
    val.len = pos
}

; ═══════════════════════════════════════════════
; 分割與連接
; ═══════════════════════════════════════════════

; 用分隔符分割為 []txt
; sep: 分隔符 txt
; out: 分割後的子 txt 切片
; [split](#txt.split)
txt.split = (sep txt) (out []txt) {
    result []txt
    sep.len-bytes() == 0 -> {
        result.push(.slice(0, .len-bytes()))
        out = result
        return
    }
    start = 0
    pos = .index-from(sep, start)
    (pos >= 0) {
        result.push(.slice(start, pos))

        #{overflow=wrap}
        start = pos + sep.len-bytes()
        pos = .index-from(sep, start)
    }
    result.push(.slice(start, .len-bytes()))
    out = result
}

; 限定分割次數
; sep txt, maxsplit i64: 最大分割次數（<=0 不限制）
; sep: 分隔符 txt
; maxsplit: 最大分割次數（<= 0 不限制）
; out: 分割結果切片（最多 maxsplit+1 段）
; [split-n](#txt.split-n)
txt.split-n = (sep txt, maxsplit i64) (out []txt) {
    result []txt
    sep.len-bytes() == 0 -> {
        result.push(.slice(0, .len-bytes()))
        out = result
        return
    }
    maxsplit <= 0 -> {
        out = .split(sep)
        return
    }
    start = 0
    pos = .index-from(sep, start)
    count = 0
    (pos >= 0) {
        count >= maxsplit -> {
            result.push(.slice(start, .len-bytes()))
            out = result
            return
        }
        result.push(.slice(start, pos))

        #{overflow=wrap}
        start = pos + sep.len-bytes()

        #{overflow=wrap}
        count = count + 1
        pos = .index-from(sep, start)
    }
    result.push(.slice(start, .len-bytes()))
    out = result
}

; []txt.join: 用分隔符連接 txt 切片（超過 255 位元組則截斷）
; sep txt: 分隔符
; 返回 out txt: 連接結果
; [join](#txt.join)
[]txt.join = (sep txt) (out txt) {
    parts = .
    n = parts.len()
    n == 0 -> return
    cap = 255
    pos = 0
    i <- [0..n): {
        i > 0 -> {
            sj <- [0..sep.len-bytes()): {
                pos < cap -> {
                    out.set-byte(pos, sep.byte(sj))

                    #{overflow=wrap}
                    pos = pos + 1
                }
            }
        }
        parts[i]: {
            ok -> {
                s = it
            }

            -> {
                s = ''
            }
        }
        sl i64 = s.len-bytes()
        sj <- [0..sl): {
            pos < cap -> {
                out.set-byte(pos, s.byte(sj))

                #{overflow=wrap}
                pos = pos + 1
            }
        }
    }
    out.len = pos
}

; 按空白分割為 []txt（連續空白視為單一分隔符）
; out: 按連續空白分割的非空子 txt 切片
; [fields](#txt.fields)
txt.fields = () (out []txt) {
    n i64 = .len-bytes()
    n == 0 -> return
    result []txt
    start = -1
    i <- [0..n): {
        b = .byte(i)
        {
            b != 32 && b != 9 && b != 10 && b != 13 -> {
                start < 0 -> start = i
            }

            start >= 0 -> {
                result.push(.slice(start, i))
                start = -1
            }

            ->
        }
    }
    start >= 0 -> result.push(.slice(start, n))
    out = result
}

; 按換行符分割為 []txt（支援 \n 與 \r\n）
; out: 按換行分割的行切片（支援 \n 與 \r\n，末尾換行不產生空行）
; [lines](#txt.lines)
txt.lines = () (out []txt) {
    n i64 = .len-bytes()
    n == 0 -> return
    result []txt
    start = 0
    i = 0
    (i < n) {
        c = .byte(i)

        #{overflow=wrap}
        c == 10 -> {
            end = i
            i > start -> {

                #{overflow=wrap}
                prev = .byte(i - 1)
                prev == 13 -> end = i - 1
            }
            result.push(.slice(start, end))
            start = i + 1
        }

        #{overflow=wrap}
        i = i + 1
    }
    start < n -> result.push(.slice(start, n))
    out = result
}

; ═══════════════════════════════════════════════
; 十六進制解碼
; ═══════════════════════════════════════════════

; 單個十六進制字元轉數值（無效字元回傳 -1）
; c: 十六進位字元的碼點值
; v: 0~15；無效字元返回 -1
; [txt-hex-val](#txt.txt-hex-val)
txt-hex-val = (c i64) (v i64) {
    v = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            v = c - 48
            return
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            v = c - 65 + 10
            return
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            v = c - 97 + 10
        }
    }
}

; 將十六進制文字解碼為 txt
; 返回 Option：ok(txt) / nil（空）/ err('msg')
; out: ok=解碼後的 txt, nil=空, err=含非法十六進位字元或奇數長度
; [from-hex](#txt.from-hex)
txt.from-hex = () (out ?txt) {
    {
        .len-bytes() == 0 -> {
            out = nil
            return
        }

        .len-bytes() % 2 != 0 -> {
            out = err('odd-length hex string')
            return
        }
    }

    #{overflow=wrap}
    n i64 = .len-bytes() / 2
    out2 txt
    i <- [0..n): {

        #{overflow=wrap}
        hi = txt-hex-val(.byte(i * 2))

        #{overflow=wrap}
        lo = txt-hex-val(.byte(i * 2 + 1))
        hi < 0 || lo < 0 -> {
            out = err('invalid hex character')
            return
        }
        out2.set-byte(i, (hi << 4) | lo)
    }
    out2.len = n
    out = out2
}

; ═══════════════════════════════════════════════
; 大數（bigint）轉換
; ═══════════════════════════════════════════════

; 單個數字字元轉數值（0-15），無效字元回傳 -1
; c: 數字字元的碼點值
; d: 0~15；無效字元返回 -1
; [_txt-dig-val](#txt._txt-dig-val)
_txt-dig-val = (c i64) (d i64) {
    d = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            d = c - 48
            return
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            d = c - 55
            return
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            d = c - 87
        }
    }
}

; 將文字解析為 bigint，自動判斷進位制
;   前綴 0b/0B → 二進位、0o/0O → 八進位、0x/0X → 十六進位；無前綴 → 十進位
;   支援可選前導空白與正負號（+ / -）
; 返回 ?bigint：ok(bigint) 成功 / nil 空字串 / err('msg') 無有效數字
; out: ok=按前綴進位制（0b/0o/0x 或十進）解析的大整數, nil=空, err=無有效數字
; [to-bigint](#txt.to-bigint)
txt.to-bigint = () (out ?bigint) {
    n = .len-bytes()
    n == 0 -> {
        out = nil
        return
    }

    acc = bigint.zero()
    pos = 0

    ; 跳過前導空白
    (pos < n) {
        c = .byte(pos)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        pos = pos + 1
    }

    ; 可選正負號
    sign = 1
    pos < n -> {
        c = .byte(pos)
        c == 45 -> {
            sign = -1

            #{overflow=wrap}
            pos = pos + 1
        }

        c == 43 -> {

            #{overflow=wrap}
            pos = pos + 1
        }
    }

    ; 進位制前綴
    radix = 10
    pos + 1 < n -> {
        c0 = .byte(pos)
        c0 == 48 -> {
            c1 = .byte(pos + 1)
            {
                c1 == 98 || c1 == 66 -> {
                    radix = 2

                    #{overflow=wrap}
                    pos = pos + 2
                }

                c1 == 111 || c1 == 79 -> {
                    radix = 8

                    #{overflow=wrap}
                    pos = pos + 2
                }

                c1 == 120 || c1 == 88 -> {
                    radix = 16

                    #{overflow=wrap}
                    pos = pos + 2
                }
            }
        }
    }

    ; 逐位解析數字
    started = 0
    (pos < n) {

        d = _txt-dig-val(.byte(pos))
        d < 0 -> break
        d >= radix -> break

        acc = acc * radix

        acc = acc + d
        started = 1

        #{overflow=wrap}
        pos = pos + 1
    }

    started == 0 -> {
        out = err('no digits to parse')
        return
    }

    sign == -1 -> acc.sign = -1
    acc.normalize()
    out = acc
}

; ═══════════════════════════════════════════════
; 全等比較
; ═══════════════════════════════════════════════

; 全等比較兩個 txt（長度 + 逐位元組）
; b: 比較目標 txt
; yes: 長度與逐位元組是否全等
; [eq-full](#txt.eq-full)
txt.eq-full = (b txt) (yes bool) {
    .len-bytes() != b.len-bytes() -> return
    yes = true
    n i64 = .len-bytes()
    i <- [0..n): {
        .byte(i) != b.byte(i) -> {
            yes = false
            return
        }
    }
}
