; txt — 固定长度文本类型
;
; txt 是固定 256 字节的文本类型：
;   - 前 255 字节存储数据（data [255]byte）
;   - 最后 1 字节存储长度（len byte，范围 0-255）
;   - 整个结构固定 256 字节，不需要堆分配
;
; 用法（必须类型标注）：
;   t txt = 'hello'
;   n = t.len()
;   c = t[0]
;
; txt {
;     data [255]byte read-only   // 数据区域
;     len byte read-only          // 实际长度（0-255）
; }
;
; 与 str 的区别：
;   - str 是堆分配的可变长度字符串
;   - txt 是栈分配的固定大小字符串（256 字节）
;   - txt 不需要堆分配，适合短文本场景
;   - txt 必须类型标注（t txt = 'abc'）

; ═══════════════════════════════════════════════
; 基础操作
; ═══════════════════════════════════════════════

; txt.len: 返回文本长度
txt.len = () (n i64) {
    n = .len()
}

; txt[i]: 返回指定位置的字节值
; build-in
; txt[i] = (i i64) (c byte) {
;     c = .[i]
; }

; txt.eq: 比较两个 txt 是否相等
; ⚠️ 2026-09-21 重写。旧实现用一条 `->` 管线（`.byte(k) - b.byte(k); c != 0 -> ok = 0;
; k == an - 1 -> ok == 0 -> eq = false; k = k + 1`）在**最后一个字节**才回头判定，
; 于是 `t('hello').eq('world')` 这种「长度相同、内容不同」的情况永远回传 true
; —— `tests/txt.no` 的 `neq:` 一行一直在打印 1，并且被冻进了 golden baseline。
; txt.compare 已经是逐字节比较且长度不同时正确分流的版本，直接复用即可。
txt.eq = (b txt) (eq bool) {
    eq = .compare(b) == 0
}

; txt.copy: 复制 txt
txt.copy = () (dst txt) {
    n i64 = .len()
    i <- [0..n): {

        #{index-out=0}
        dst[i] = .byte(i)
    }
    dst.len = .len()
}

; txt.fill: 用 byte 值填充整个数据区域
txt.fill = (val byte) {
    i <- [0..255): {
        .[i] = val
    }
}

; txt.clear: 清空文本（len=0）
txt.clear = () {
    .len = 0
}

; txt.empty: 判断是否为空
txt.empty = () (yes bool) {
    yes = true
    .len() != 0 -> yes = false
}

; ═══════════════════════════════════════════════
; 转换函数
; ═══════════════════════════════════════════════

; txt.to-str: 将 txt 转换为 str
txt.to-str = () (out str) {
    n i64 = .len()
    out = with-len(n)
    i <- [0..n): {

        #{index-out=0}
        out[i] = .byte(i)
    }
}

; txt.to-bytes: 将 txt 转换为 []byte
txt.to-bytes = () (out []byte) {
    n i64 = .len()
    out = with-len(n)
    i <- [0..n): {

        #{index-out=0}
        out[i] = .byte(i)
    }
}

; txt.to-hex: 将 txt 转换为十六进制字符串
txt.to-hex = () (out str) {

    #{overflow=wrap}
    HEX = '0123456789ABCDEF'
    n i64 = .len()

    #{overflow=wrap}
    out = with-len(n * 2)
    i <- [0..n): {

        #{overflow=wrap}
        b = .byte(i)

        #{index-out=0, overflow=wrap}
        out[i * 2] = HEX[b >> 4]

        #{index-out=0, overflow=wrap}
        out[i * 2 + 1] = HEX[b & 15]
    }
}

; txt.from-str: 从 str 创建 txt（截断至 255 字节）
; 返回 txt，如果 str 超过 255 字节则截断
txt.from-str = (s str) (out txt) {
    n = s.len-bytes()
    n > 255 -> n = 255
    i <- [0..n): {

        #{index-out=0}
        out[i] = s.byte(i)
    }
    out.len = n
}

; txt.from-bytes: 从 []byte 创建 txt（截断至 255 字节）
; 返回 txt，如果 []byte 超过 255 字节则截断
txt.from-bytes = (b []byte) (out txt) {
    n = b.len()
    n > 255 -> n = 255
    i <- [0..n): {

        #{index-out=0}
        out[i] = b[i]
    }
    out.len = n
}

; ═══════════════════════════════════════════════
; 查找操作
; ═══════════════════════════════════════════════

; txt.index: 查找子串位置（從 0 開始）
txt.index = (sub txt) (pos i64) {
    pos = .index-from(sub, 0)
}

; txt.contains: 是否包含子串
txt.contains = (sub txt) (yes bool) {
    pos = .index-from(sub, 0)
    yes = pos >= 0
}

; txt.starts-with: 是否以指定前缀开头
txt.starts-with = (sub txt) (yes bool) {
    yes = .index-from(sub, 0) == 0
}

; txt.ends-with: 是否以指定后缀结尾
txt.ends-with = (sub txt) (yes bool) {

    #{overflow=wrap}
    yes = false
    sn i64 = sub.len()
    n i64 = .len()
    sn == 0 -> yes = true
    n < sn -> yes = false

    #{overflow=wrap}
    off = n - sn
    yes = .index-from(sub, off) == off
}

; ═══════════════════════════════════════════════
; 修改操作
; ═══════════════════════════════════════════════

; txt.append: 追加字节（不超出 255 限制）
txt.append = (b byte) {

    #{overflow=wrap}
    n i64 = .len()
    n >= 255 -> return
    .[n] = b

    #{overflow=wrap}
    .len = n + 1
}

; txt.append-str: 追加 str（不超出 255 限制）
txt.append-str = (s str) {

    #{overflow=wrap}
    sn i64 = s.len-bytes()
    n i64 = .len()

    #{overflow=wrap}
    remain = 255 - n
    sn > remain -> sn = remain
    i <- [0..sn): {

        #{overflow=wrap}
        .[n + i] = s.byte(i)
    }

    #{overflow=wrap}
    .len = n + sn
}

; txt.append-txt: 追加 txt（不超出 255 限制）
txt.append-txt = (t txt) {

    #{overflow=wrap}
    tn i64 = t.len()
    n i64 = .len()

    #{overflow=wrap}
    remain = 255 - n
    tn > remain -> tn = remain
    i <- [0..tn): {

        #{overflow=wrap}
        .[n + i] = t.byte(i)
    }

    #{overflow=wrap}
    .len = n + tn
}

; txt.truncate: 截断到指定长度
txt.truncate = (n i64) {
    rn = n
    rn > 255 -> rn = 255
    .len() < rn -> return
    .len = rn
}

; ═══════════════════════════════════════════════
; 比较操作
; ═══════════════════════════════════════════════

; txt.compare: 字典序比较
; 返回 -1(a<b), 0(相等), 1(a>b)
txt.compare = (b txt) (r i64) {
    an i64 = .len()
    bn i64 = b.len()
    min-n = an
    bn < min-n -> min-n = bn
    i <- [0..min-n): {
        ai = .byte(i)
        bi = b.byte(i)
        {
            ai < bi -> {
                r = -1
                return
            }

            ai > bi -> {
                r = 1
                return
            }
        }
    }
    {
        an < bn -> r = -1

        an > bn -> r = 1

        -> r = 0
    }
}

; ═══════════════════════════════════════════════
; 其他操作
; ═══════════════════════════════════════════════

; txt.reverse: 反转文本内容
txt.reverse = () (out txt) {
    n i64 = .len()
    i <- [0..n): {

        #{index-out=0, overflow=wrap}
        out[i] = .byte(n - 1 - i)
    }
    out.len = n
}

; txt.slice: 截取子串 [start, end) 返回新的 txt
txt.slice = (start i64, end i64) (out txt) {
    r-start = start
    r-end = end

    #{overflow=wrap}
    r-start < 0 -> r-start = 0
    cur-len i64 = .len()
    r-end > cur-len -> r-end = cur-len
    r-start >= r-end -> return

    #{overflow=wrap}
    n = r-end - r-start
    n > 255 -> n = 255
    i <- [0..n): {

        #{index-out=0, overflow=wrap}
        out[i] = .byte(r-start + i)
    }
    out.len = n
}

; txt.at: 获取指定位置的 byte
txt.at = (idx i64) (b byte) {
    b = 0
    cur-len i64 = .len()
    idx < 0 -> return
    idx >= cur-len -> return
    b = .byte(idx)
}

; ═══════════════════════════════════════════════
; UTF-8 解碼
; ═══════════════════════════════════════════════

; txt.decode-cp: 從位置 i 解碼一個 UTF-8 碼點
; 返回 cp=碼點值, clen=序列位元組長度（1~4）
txt.decode-cp = (i i64) (cp i64, clen i64) {
    b = .byte(i)
    cp = b
    clen = 1
    {
        b < 0x80 -> {
            cp = b
            clen = 1
        }

        b < 0xe0 -> {

            #{overflow=wrap}
            cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
            clen = 2
        }

        b < 0xf0 -> {

            #{overflow=wrap}
            cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
            clen = 3
        }

        -> {

            #{overflow=wrap}
            cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
            clen = 4
        }
    }
}

; ═══════════════════════════════════════════════
; 大小寫轉換
; ═══════════════════════════════════════════════

; txt.to-upper: 將文字轉為大寫（ASCII）
; 返回新 txt
txt.to-upper = () (val txt) {
    n i64 = .len()
    i <- [0..n): {
        c = .byte(i)
        {
            c >= 97 && c <= 122 -> {

                #{index-out=0, overflow=wrap}
                val[i] = c - 32
            }

            -> {

                #{index-out=0}
                val[i] = c
            }
        }
    }
    val.len = n
}

; txt.to-lower: 將文字轉為小寫（ASCII）
; 返回新 txt
txt.to-lower = () (val txt) {
    n i64 = .len()
    i <- [0..n): {
        c = .byte(i)
        {
            c >= 65 && c <= 90 -> {

                #{index-out=0, overflow=wrap}
                val[i] = c + 32
            }

            -> {

                #{index-out=0}
                val[i] = c
            }
        }
    }
    val.len = n
}

; ═══════════════════════════════════════════════
; 裁剪
; ═══════════════════════════════════════════════

; txt.trim: 去除首尾空白字元
; 返回新 txt
txt.trim = () (val txt) {

    #{overflow=wrap}
    n i64 = .len()
    start <- [0..n): {

        #{overflow=wrap}
        c = .byte(start)
        c != 32 && c != 9 && c != 10 && c != 13 -> break
    }

    #{overflow=wrap}
    end = n - 1
    (end >= start) {

        #{overflow=wrap}
        c = .byte(end)
        c != 32 && c != 9 && c != 10 && c != 13 -> break

        #{overflow=wrap}
        end = end - 1
    }

    #{overflow=wrap}
    m = end - start + 1
    m < 0 -> return
    i <- [0..m): {

        #{index-out=0, overflow=wrap}
        val[i] = .byte(start + i)
    }
    val.len = m
}

; txt.trim-char: 去除首尾指定字元（UTF-8 碼點）
; 返回新 txt
txt.trim-char = (ch char) (val txt) {

    #{overflow=wrap}
    n i64 = .len()
    start = 0
    (start < n) {

        #{overflow=wrap}
        b = .byte(start)
        cp i64 = b
        clen = 1

        #{overflow=wrap}
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {

                #{overflow=wrap}
                cp = ((b & 0x1f) << 6) | (.byte(start + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {

                #{overflow=wrap}
                cp = ((b & 0x0f) << 12) | ((.byte(start + 1) & 0x3f) << 6) | (.byte(start + 2) & 0x3f)
                clen = 3
            }

            -> {

                #{overflow=wrap}
                cp = ((b & 0x07) << 18) | ((.byte(start + 1) & 0x3f) << 12) | ((.byte(start + 2) & 0x3f) << 6) | (.byte(start + 3) & 0x3f)
                clen = 4
            }
        }
        cp != ch -> break

        #{overflow=wrap}
        start = start + clen
    }
    end = start
    i = start
    (i < n) {

        #{overflow=wrap}
        b = .byte(i)
        cp = b
        clen = 1

        #{overflow=wrap}
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {

                #{overflow=wrap}
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {

                #{overflow=wrap}
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {

                #{overflow=wrap}
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        cp != ch -> end = i + clen

        #{overflow=wrap}
        i = i + clen
    }

    #{overflow=wrap}
    m = end - start
    m < 0 -> return
    j <- [0..m): {

        #{index-out=0, overflow=wrap}
        val[j] = .byte(start + j)
    }
    val.len = m
}

; ═══════════════════════════════════════════════
; 重複
; ═══════════════════════════════════════════════

; txt.repeat: 將內容重複 times 次（上限 255 位元組）
; 返回新 txt
txt.repeat = (times i64) (val txt) {
    n i64 = .len()
    cap = 255
    pos = 0
    i <- [0..times): {
        j <- [0..n): {
            pos < cap -> {

                #{index-out=0, overflow=wrap}
                val[pos] = .byte(j)

                #{overflow=wrap}
                pos = pos + 1
            }
        }
    }
    val.len = pos
}

; ═══════════════════════════════════════════════
; 統計
; ═══════════════════════════════════════════════

; txt.count: 統計 code point 數量
txt.count = () (cnt i64) {
    cnt = 0
    n i64 = .len()
    i = 0
    (i < n) {

        #{overflow=wrap}
        b = .byte(i)

        #{overflow=wrap}
        {
            b < 0x80 -> i = i + 1

            b < 0xe0 -> i = i + 2

            b < 0xf0 -> i = i + 3

            -> i = i + 4
        }

        #{overflow=wrap}
        cnt = cnt + 1
    }
}

; ═══════════════════════════════════════════════
; 反向 / 限定查找
; ═══════════════════════════════════════════════

; txt.index-from: 從 from 位置開始查找子串
; 返回首次出現位置，未找到返回 -1
txt.index-from = (target txt, from i64) (pos i64) {
    r-from = from

    #{overflow=wrap}
    pos = -1
    r-from < 0 -> r-from = 0
    n i64 = .len()
    m i64 = target.len()
    m == 0 -> r-from <= n -> pos = r-from
    n < m -> pos = -1

    #{overflow=wrap}
    limit = n - m
    i <- [0..n]: {

        #{overflow=wrap}
        i >= r-from -> i <= limit -> {
            ok = 1
            k = 0
            (k < m) {

                #{overflow=wrap}
                c = .byte(i + k) - target.byte(k)
                c != 0 -> ok = 0
                k == m - 1 -> ok == 1 -> pos == -1 -> pos = i
                k = k + 1
            }
        }
    }
}

; txt.rindex: 反向查找子串最後出現位置
; 返回位置，未找到 -1
txt.rindex = (target txt) (pos i64) {

    #{overflow=wrap}
    pos = -1
    n i64 = .len()
    m i64 = target.len()
    m == 0 -> pos = n
    n < m -> pos = -1

    #{overflow=wrap}
    limit = n - m
    i <- [0..n]: {

        #{overflow=wrap}
        i <= limit -> {
            ok = 1
            k = 0
            (k < m) {

                #{overflow=wrap}
                c = .byte(i + k) - target.byte(k)
                c != 0 -> ok = 0
                k == m - 1 -> ok == 1 -> pos = i
                k = k + 1
            }
        }
    }
}

; txt.last-index: rindex 別名
txt.last-index = (target txt) (pos i64) {
    pos = .rindex(target)
}

; txt.rindex-from: 從 from 位置反向查找子串（返回位置 >= from 的最後一次出現）
txt.rindex-from = (target txt, from i64) (pos i64) {
    r-from = from

    #{overflow=wrap}
    pos = -1
    r-from < 0 -> r-from = 0
    n i64 = .len()
    m i64 = target.len()
    m == 0 -> r-from <= n -> pos = n
    n < m -> pos = -1

    #{overflow=wrap}
    limit = n - m
    i <- [0..n]: {

        #{overflow=wrap}
        i >= r-from -> i <= limit -> {
            ok = 1
            k = 0
            (k < m) {

                #{overflow=wrap}
                c = .byte(i + k) - target.byte(k)
                c != 0 -> ok = 0
                k == m - 1 -> ok == 1 -> pos = i
                k = k + 1
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 數值解析
; ═══════════════════════════════════════════════

; txt.to-i64: 將文字解析為有號 64 位整數
; 返回 Option：ok(n) / nil（空）/ err('msg')
txt.to-i64 = () (val ?i64) {
    s = .to-str()
    val = s.to-i64()
}

; txt.to-i8: 解析為 i8（範圍 -128~127）
txt.to-i8 = () (val ?i8) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {

            #{overflow=wrap}
            n = it

            #{overflow=wrap}
            n >= 0 - 128 && n <= 127 -> val = n

            -> val = err('out of range for i8')
        }
    }
}

; txt.to-i16: 解析為 i16（範圍 -32768~32767）
txt.to-i16 = () (val ?i16) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {

            #{overflow=wrap}
            n = it

            #{overflow=wrap}
            n >= 0 - 32768 && n <= 32767 -> val = n

            -> val = err('out of range for i16')
        }
    }
}

; txt.to-i32: 解析為 i32（範圍 -2147483648~2147483647）
txt.to-i32 = () (val ?i32) {
    v = .to-i64()
    v: {
        err -> val = err(it)

        nil -> return

        ok -> {

            #{overflow=wrap}
            n = it

            #{overflow=wrap}
            n >= 0 - 2147483648 && n <= 2147483647 -> val = n

            -> val = err('out of range for i32')
        }
    }
}

; txt.to-u8: 解析為 u8（範圍 0~255）
txt.to-u8 = () (val ?u8) {
    .len() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u8: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n): {

        #{overflow=wrap}
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for u8')
    }
}

; txt.to-u16: 解析為 u16（範圍 0~65535）
txt.to-u16 = () (val ?u16) {
    .len() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u16: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n): {

        #{overflow=wrap}
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 65535 -> val = n

        -> val = err('out of range for u16')
    }
}

; txt.to-u32: 解析為 u32（範圍 0~4294967295）
txt.to-u32 = () (val ?u32) {
    .len() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid u32: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n): {

        #{overflow=wrap}
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 4294967295 -> val = n

        -> val = err('out of range for u32')
    }
}

; txt.to-u64: 解析為 u64（拒絕負號）
txt.to-u64 = () (val ?u64) {
    .len() == 0 -> {
        val = nil
        return
    }
    c = .byte(0)
    c == 45 -> {
        val = err('invalid u64: negative sign not allowed')
        return
    }
    n = 0
    start = 0
    c == 43 -> start = 1
    i <- [start..n): {

        #{overflow=wrap}
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    val = n
}

; txt.to-byte: 解析為 byte（與 u8 等價）
txt.to-byte = () (val ?byte) {
    .len() == 0 -> {
        val = nil
        return
    }
    n = 0
    start = 0
    c = .byte(0)
    {
        c == 45 -> {
            val = err('invalid byte: negative sign not allowed')
            return
        }

        c == 43 -> {
            start = 1
            .len() == 1 -> {
                val = err('invalid number: lone plus')
                return
            }
        }
    }
    i <- [start..n): {

        #{overflow=wrap}
        c = .byte(i)
        c < 48 || c > 57 -> {
            val = err('invalid number: non-digit character')
            return
        }

        #{overflow=wrap}
        n = n * 10 + c - 48
    }
    {
        n >= 0 && n <= 255 -> val = n

        -> val = err('out of range for byte')
    }
}

; txt.to-f64: 將文字解析為 f64（回傳 ?f64，空字串→nil，非數字→err）
; 複用 str 的解析邏輯（先轉 str 再呼叫 str.to-f64）
txt.to-f64 = () (val ?f64) {
    s = .to-str()
    val = s.to-f64()
}

; txt.to-f32: 將文字解析為 f32
txt.to-f32 = () (val ?f32) {
    f ?f64 = .to-f64()
    {
        f == nil -> {
            val = nil
            return
        }

        f == err -> {
            val = err('txt.to-f32: parse error')
            return
        }
    }
    val = number.f64-to-f32(f)
}

; txt.to-bool: 將 "true"/"false" 解析為 bool
txt.to-bool = () (val ?bool) {
    {
        .len() == 0 -> {
            val = nil
            return
        }

        .len() == 4 -> {
            .byte(0) == 116 && .byte(1) == 114 && .byte(2) == 117 && .byte(3) == 101 -> {
                val = true
                return
            }
        }

        .len() == 5 -> {
            .byte(0) == 102 && .byte(1) == 97 && .byte(2) == 108 && .byte(3) == 115 && .byte(4) == 101 -> {
                val = false
                return
            }
        }
    }
    val = err('not a bool')
}

; ═══════════════════════════════════════════════
; 替換
; ═══════════════════════════════════════════════

; txt.replace-char: 將所有 old-ch 替換為 new-ch（UTF-8 碼點）
; 返回新 txt（超過 255 位元組則截斷）
txt.replace-char = (old-ch char, new-ch char) (val txt) {
    n i64 = .len()
    cap = 255
    pos = 0
    i = 0
    (i < n) {

        #{overflow=wrap}
        b = .byte(i)
        cp i64 = b
        clen = 1

        #{overflow=wrap}
        {
            b < 0x80 -> {
                cp = b
                clen = 1
            }

            b < 0xe0 -> {

                #{overflow=wrap}
                cp = ((b & 0x1f) << 6) | (.byte(i + 1) & 0x3f)
                clen = 2
            }

            b < 0xf0 -> {

                #{overflow=wrap}
                cp = ((b & 0x0f) << 12) | ((.byte(i + 1) & 0x3f) << 6) | (.byte(i + 2) & 0x3f)
                clen = 3
            }

            -> {

                #{overflow=wrap}
                cp = ((b & 0x07) << 18) | ((.byte(i + 1) & 0x3f) << 12) | ((.byte(i + 2) & 0x3f) << 6) | (.byte(i + 3) & 0x3f)
                clen = 4
            }
        }

        #{overflow=wrap}
        {
            cp == old-ch -> {
                new-ch < 0x80 -> {
                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = new-ch
                        pos = pos + 1
                    }
                }

                new-ch < 0x800 -> {
                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0xc0 | ((new-ch >> 6) & 0x1f)
                        pos = pos + 1
                    }

                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0x80 | (new-ch & 0x3f)
                        pos = pos + 1
                    }
                }

                new-ch < 0x10000 -> {
                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0xe0 | ((new-ch >> 12) & 0x0f)
                        pos = pos + 1
                    }

                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0x80 | ((new-ch >> 6) & 0x3f)
                        pos = pos + 1
                    }

                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0x80 | (new-ch & 0x3f)
                        pos = pos + 1
                    }
                }

                -> {
                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0xf0 | ((new-ch >> 18) & 0x07)
                        pos = pos + 1
                    }

                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0x80 | ((new-ch >> 12) & 0x3f)
                        pos = pos + 1
                    }

                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0x80 | ((new-ch >> 6) & 0x3f)
                        pos = pos + 1
                    }

                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = 0x80 | (new-ch & 0x3f)
                        pos = pos + 1
                    }
                }
            }

            -> {
                k <- [0..clen): {
                    pos < cap -> {

                        #{index-out=0, overflow=wrap}
                        val[pos] = .byte(i + k)
                        pos = pos + 1
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + clen
    }
    val.len = pos
}

; txt.replace-str: 將所有 old 子串替換為 new 子串
; 返回新 txt（超過 255 位元組則截斷）
txt.replace-str = (old txt, new txt) (val txt) {
    old.len() == 0 -> {
        val = .slice(0, .len())
        return
    }
    n i64 = .len()
    old-len i64 = old.len()
    new-len i64 = new.len()
    cap = 255
    pos = 0
    i = 0
    (i < n) {
        match = 1
        j = 0
        (j < old-len) {

            #{overflow=wrap}
            i + j >= n -> {
                match = 0
                break
            }

            #{overflow=wrap}
            .byte(i + j) != old.byte(j) -> {
                match = 0
                break
            }

            #{overflow=wrap}
            j = j + 1
        }
        match -> {
            k <- [0..new-len): {

                #{overflow=wrap}
                pos < cap -> {

                    #{index-out=0, overflow=wrap}
                    val[pos] = new.byte(k)
                    pos = pos + 1
                }
            }

            #{overflow=wrap}
            i = i + old-len
        }

        -> {

            #{overflow=wrap}
            pos < cap -> {

                #{index-out=0, overflow=wrap}
                val[pos] = .byte(i)
                pos = pos + 1
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
    val.len = pos
}

; txt.replace-n: 限定替換次數
; old txt, new txt, n i64: 最大替換次數（n<=0 不替換）
txt.replace-n = (old txt, new txt, n i64) (val txt) {

    #{overflow=wrap}
    n <= 0 -> {
        val = .slice(0, .len())
        return
    }
    old.len() == 0 -> {
        val = .slice(0, .len())
        return
    }
    parts = .split(old)
    np = parts.len()
    np <= 1 -> {
        val = .slice(0, .len())
        return
    }

    #{overflow=wrap}
    repl = np - 1
    repl > n -> repl = n
    total = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {

            ; ⚠️ 原本寫成 `i <= repl -> total = total + new.len() -> total = total + old.len()`。
            ; `->` 是**短路管線運算子**，不是 if/else：條件成立時兩個指派**都會**執行
            ; （副作用節點不會把 state 切成失敗），條件不成立時**兩個都不會**執行
            ; —— 分隔符長度怎麼算都是錯的。要二選一就得用 `{}` if/else-if 群組。
            ; （同一個寫法也讓 `no fmt` 不冪等，見 url.no 的同款註解。）
            {
                i <= repl -> {

                    #{overflow=wrap}
                    total = total + new.len()
                }

                -> total = total + old.len()
            }
        }

        #{index-out=0, overflow=wrap}
        total = total + parts[i].len()
    }
    total > 255 -> total = 255
    cap = 255
    pos = 0
    i <- [0..np): {

        #{overflow=wrap}
        i > 0 -> {
            sep = new
            i > repl -> sep = old
            j <- [0..sep.len()): {
                pos < cap -> {

                    #{index-out=0, overflow=wrap}
                    val[pos] = sep.byte(j)
                    pos = pos + 1
                }
            }
        }

        #{index-out=0}
        s = parts[i]
        j <- [0..s.len()): {

            #{overflow=wrap}
            pos < cap -> {

                #{index-out=0, overflow=wrap}
                val[pos] = s.byte(j)
                pos = pos + 1
            }
        }
    }
    val.len = pos
}

; ═══════════════════════════════════════════════
; 分割與連接
; ═══════════════════════════════════════════════

; txt.split: 用分隔符分割為 []txt
txt.split = (sep txt) (out []txt) {
    result []txt
    sep.len() == 0 -> {
        result.push(.slice(0, .len()))
        out = result
        return
    }
    start = 0
    pos = .index-from(sep, start)
    (pos >= 0) {

        #{overflow=wrap}
        result.push(.slice(start, pos))

        #{overflow=wrap}
        start = pos + sep.len()
        pos = .index-from(sep, start)
    }
    result.push(.slice(start, .len()))
    out = result
}

; txt.split-n: 限定分割次數
; sep txt, maxsplit i64: 最大分割次數（<=0 不限制）
txt.split-n = (sep txt, maxsplit i64) (out []txt) {
    result []txt
    sep.len() == 0 -> {
        result.push(.slice(0, .len()))
        out = result
        return
    }
    maxsplit <= 0 -> {
        out = .split(sep)
        return
    }
    start = 0
    pos = .index-from(sep, start)
    count = 0
    (pos >= 0) {

        #{overflow=wrap}
        count >= maxsplit -> {
            result.push(.slice(start, .len()))
            out = result
            return
        }
        result.push(.slice(start, pos))

        #{overflow=wrap}
        start = pos + sep.len()

        #{overflow=wrap}
        count = count + 1
        pos = .index-from(sep, start)
    }
    result.push(.slice(start, .len()))
    out = result
}

; txt-join: 用分隔符連接 txt 切片（超過 255 位元組則截斷）
; parts []txt: 待連接的 txt 切片
; sep txt: 分隔符
; 返回 out txt: 連接結果
; 注意：編譯器目前不支援 []txt 切片方法，故以全域函數提供
txt-join = (parts []txt, sep txt) (out txt) {
    n = parts.len()
    n == 0 -> return
    cap = 255
    pos = 0
    i <- [0..n): {
        i > 0 -> {
            sj <- [0..sep.len()): {
                pos < cap -> {

                    #{index-out=0, overflow=wrap}
                    out[pos] = sep.byte(sj)

                    #{overflow=wrap}
                    pos = pos + 1
                }
            }
        }

        #{index-out=0}
        s = parts[i]
        sl i64 = s.len()
        sj <- [0..sl): {
            pos < cap -> {

                #{index-out=0, overflow=wrap}
                out[pos] = s.byte(sj)

                #{overflow=wrap}
                pos = pos + 1
            }
        }
    }
    out.len = pos
}

; txt.fields: 按空白分割為 []txt（連續空白視為單一分隔符）
txt.fields = () (out []txt) {
    n i64 = .len()
    n == 0 -> return
    result []txt
    start = -1
    i <- [0..n): {
        b = .byte(i)
        {
            b != 32 && b != 9 && b != 10 && b != 13 -> {
                start < 0 -> start = i
            }

            start >= 0 -> {
                result.push(.slice(start, i))
                start = -1
            }

            ->
        }
    }
    start >= 0 -> result.push(.slice(start, n))
    out = result
}

; txt.lines: 按換行符分割為 []txt（支援 \n 與 \r\n）
txt.lines = () (out []txt) {
    n i64 = .len()
    n == 0 -> return
    result []txt
    start = 0
    i = 0
    (i < n) {

        #{overflow=wrap}
        c = .byte(i)

        #{overflow=wrap}
        c == 10 -> {

            #{overflow=wrap}
            end = i
            i > start -> {

                #{overflow=wrap}
                prev = .byte(i - 1)
                prev == 13 -> end = i - 1
            }
            result.push(.slice(start, end))
            start = i + 1
        }

        #{overflow=wrap}
        i = i + 1
    }
    start < n -> result.push(.slice(start, n))
    out = result
}

; ═══════════════════════════════════════════════
; 十六進制解碼
; ═══════════════════════════════════════════════

; txt-hex-val: 單個十六進制字元轉數值（無效字元回傳 -1）
txt-hex-val = (c i64) (v i64) {
    v = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            v = c - 48
            return
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            v = c - 65 + 10
            return
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            v = c - 97 + 10
        }
    }
}

; txt.from-hex: 將十六進制文字解碼為 txt
; 返回 Option：ok(txt) / nil（空）/ err('msg')
txt.from-hex = () (out ?txt) {
    {
        .len() == 0 -> {
            out = nil
            return
        }

        .len() % 2 != 0 -> {
            out = err('odd-length hex string')
            return
        }
    }

    #{overflow=wrap}
    n i64 = .len() / 2
    out2 txt
    i <- [0..n): {

        #{overflow=wrap}
        hi = txt-hex-val(.byte(i * 2))

        #{overflow=wrap}
        lo = txt-hex-val(.byte(i * 2 + 1))
        hi < 0 || lo < 0 -> {
            out = err('invalid hex character')
            return
        }

        #{index-out=0}
        out2[i] = (hi << 4) | lo
    }
    out2.len = n
    out = out2
}

; ═══════════════════════════════════════════════
; 全等比較
; ═══════════════════════════════════════════════

; txt.eq-full: 全等比較兩個 txt（長度 + 逐位元組）
txt.eq-full = (b txt) (yes bool) {
    .len() != b.len() -> return
    yes = true
    n i64 = .len()
    i <- [0..n): {
        .byte(i) != b.byte(i) -> {
            yes = false
            return
        }
    }
}
