; toml — TOML 設定檔解析與產生
;
; 提供一個輕量、無外部依賴的 TOML 讀寫模組。
; 支援：
;   - 空白行與 # 註解
;   - [table] 表格標頭（以 table.key 形式儲存）
;   - bare / quoted key
;   - basic string、literal string、bool、i64、f64
;   - 保留所有值的 TOML 原始字面值，包含陣列、inline table 與日期時間
;   - 固定容量文件模型：64 keys、32 tables、32 array-of-tables
;
; 用法：
;   cfg = toml.parse('name = "nolang"\n[server]\nport = 8080')
;   doc = toml.new()
;   doc.put('server.port', '8080')
;   text = toml.stringify(doc)
;
; [toml](#toml)

TOML-MAX-ENTRIES = 4
TOML-MAX-TABLES = 2
TOML-MAX-ARRAY-TABLES = 2
TOML-MAX-KEY = 32
TOML-MAX-VALUE = 128

; entry 使用固定 byte 緩衝區，避免文件值在 struct 複製時發生所有權別名。
; [entry](#toml.entry)
entry {
    key [32]byte
    key-len i64
    value [128]byte
    value-len i64
}

table {
    name [32]byte
    name-len i64
}

array-table {
    name [32]byte
    name-len i64
    index i64
}

; toml: TOML 文件。表格以完整 dotted key 儲存，例如 server.port。
; [toml](#toml.toml)
toml {
    entries [4]entry
    count i64
    tables [2]table
    table-count i64
    arrays [2]array-table
    array-count i64
}

; 建立空 TOML 文件
; doc: 空的 TOML 文件（0 條目、0 表格）
; [new](#toml.new)
toml.new = () (doc toml) {
    doc = toml{
        count: 0
        table-count: 0
        array-count: 0
    }
    i <- [0..TOML-MAX-ENTRIES): {
        doc.entries[i].key-len = 0

        doc.entries[i].value-len = 0
    }
    i <- [0..TOML-MAX-TABLES): {
        doc.tables[i].name-len = 0
    }
    i <- [0..TOML-MAX-ARRAY-TABLES): {
        doc.arrays[i].name-len = 0

        doc.arrays[i].index = 0
    }
}

; 讀取 canonical key。
; e: 待讀取的 entry
; s: 條目的 canonical key（標準化點號分隔形式）
; [entry-key](#toml.entry-key)
entry-key = (e entry) (s str) {

    ; 2026-11-11：str 下標直寫已全域禁用 ⇒ []byte 緩衝承接（位元組保真；
    ; 這裡不能用 place-match —— 它對 str 是「碼點」閘門，非 ASCII 名稱會被截斷）。
    sb []byte = with-cap-len(e.key-len, e.key-len)
    i <- [0..e.key-len): {
        sb[i] = e.key[i]: {
            ok -> it

            -> 0
        }
    }
    s = sb.to-bytes-str()
}

; 讀取原始 TOML value。
; e: 待讀取的 entry
; s: 原始 TOML value 字面值（未解碼）
; [entry-value](#toml.entry-value)
entry-value = (e entry) (s str) {

    ; 2026-11-11：str 下標直寫已全域禁用 ⇒ []byte 緩衝承接（位元組保真；
    ; 這裡不能用 place-match —— 它對 str 是「碼點」閘門，非 ASCII 名稱會被截斷）。
    sb []byte = with-cap-len(e.value-len, e.value-len)
    i <- [0..e.value-len): {
        sb[i] = e.value[i]: {
            ok -> it

            -> 0
        }
    }
    s = sb.to-bytes-str()
}

; 比較 entry key 與字串。
; e: 待比較的 entry
; key: 要比對的鍵字串
; same: 條目鍵與 key 是否相同
; [entry-key-eq](#toml.entry-key-eq)
entry-key-eq = (e entry, key str) (same bool) {
    same = false
    e.key-len != key.len-bytes() -> return
    i <- [0..e.key-len): {
        {
            c ?= e.key[i]
            c != key.byte(i) -> return
        }: {
            err -> _

            -> _
        }
    }
    same = true
}

; 將 key/value 複製到固定緩衝區。
; key: 鍵字串
; value: 值字串
; e: 鍵值複製入固定緩衝區後的新條目
; [make-entry](#toml.make-entry)
make-entry = (key str, value str) (e entry) {
    e.key-len = key.len-bytes()
    e.value-len = value.len-bytes()
    i <- [0..e.key-len): {
        e.key[i] = key.byte(i)
    }
    i <- [0..e.value-len): {
        e.value[i] = value.byte(i)
    }
}

; 讀取表格名稱。
; t: 待讀取的表格
; s: 表格名稱
; [table-name](#toml.table-name)
table-name = (t table) (s str) {

    ; 2026-11-11：str 下標直寫已全域禁用 ⇒ []byte 緩衝承接（位元組保真；
    ; 這裡不能用 place-match —— 它對 str 是「碼點」閘門，非 ASCII 名稱會被截斷）。
    sb []byte = with-cap-len(t.name-len, t.name-len)
    i <- [0..t.name-len): {
        sb[i] = t.name[i]: {
            ok -> it

            -> 0
        }
    }
    s = sb.to-bytes-str()
}

; 讀取 array-of-tables 名稱。
; t: 待讀取的 array-of-tables 記錄
; s: 該陣列表格的名稱
; [array-name](#toml.array-name)
array-name = (t array-table) (s str) {

    ; 2026-11-11：str 下標直寫已全域禁用 ⇒ []byte 緩衝承接（位元組保真；
    ; 這裡不能用 place-match —— 它對 str 是「碼點」閘門，非 ASCII 名稱會被截斷）。
    sb []byte = with-cap-len(t.name-len, t.name-len)
    i <- [0..t.name-len): {
        sb[i] = t.name[i]: {
            ok -> it

            -> 0
        }
    }
    s = sb.to-bytes-str()
}

; 比較固定緩衝區中的表格名稱。
; name: 存表格名的固定緩衝區
; name-len: 名稱實際位元組長度
; s: 要比對的表格名
; same: 兩者是否逐位元組相同
; [table-eq](#toml.table-eq)
table-eq = (name [32]byte, name-len i64, s str) (same bool) {
    same = false
    name-len != s.len-bytes() -> return
    i <- [0..name-len): {
        name-i = name[i]: {
            ok -> it

            -> _
        }

        name-i != s.byte(i) -> return
    }
    same = true
}

; 找到未被引號包住的第一個等號
; s: 待解析的鍵值行
; pos: 第一個引號外等號的位元組位置（找不到返回 -1）
; [find-eq](#toml.find-eq)
find-eq = (s str) (pos i64) {
    pos = -1
    quote = 0
    escaped = false
    i = 0
    (i < s.len-bytes()) {
        i >= s.len-bytes() -> break
        c = s.byte(i)
        {
            quote == 34 -> {
                escaped -> escaped = false
                {
                    c == 92 -> escaped = true

                    c == 34 -> quote = 0
                }
            }

            quote == 39 -> {
                c == 39 -> quote = 0
            }

            -> {
                c == 34 -> quote = 34

                c == 39 -> quote = 39

                c == 61 -> {
                    pos = i
                    return
                }
            }
        }

        {
            #{overflow=wrap}
            i ?= i + 1
        }: {
            err -> _

            -> _
        }
    }
}

; 移除字串外的 # 註解並 trim；支援 multiline string。
; s: 原始行文字（支援多行字串內的 #）
; out: 去除字串外註解並 trim 後的內容
; [strip-comment](#toml.strip-comment)
strip-comment = (s str) (out str) {
    quote = 0
    escaped = false
    end = s.len-bytes()
    i = 0
    n = s.len-bytes()
    (i < n) {
        i >= n -> break

        c = s.byte(i)
        {
            quote == 1 -> {
                escaped -> escaped = false
                {
                    c == 92 -> escaped = true

                    c == 34 -> quote = 0
                }
            }

            quote == 2 -> c == 39 -> quote = 0

            quote == 3 -> {

                #{overflow=wrap}
                {

                    c == 34 && i + 2 < n && s.byte(i + 1) == 34 && s.byte(i + 2) == 34 -> {
                        quote = 0

                        {
                            #{overflow=wrap}
                            i ?= i + 2
                        }: {
                            err -> _

                            -> _
                        }
                    }
                }
            }

            quote == 4 -> {
                {
                    c == 39 && i + 2 < n && s.byte(i + 1) == 39 && s.byte(i + 2) == 39 -> {
                        quote = 0

                        {
                            #{overflow=wrap}
                            i ?= i + 2
                        }: {
                            err -> _

                            -> _
                        }
                    }
                }
            }

            -> {

                #{overflow=wrap}
                {

                    c == 34 -> {
                        {
                            i + 2 < n && s.byte(i + 1) == 34 && s.byte(i + 2) == 34 -> {
                                quote = 3

                                {
                                    #{overflow=wrap}
                                    i ?= i + 2
                                }: {
                                    err -> _

                                    -> _
                                }
                            }

                            -> quote = 1
                        }
                    }

                    c == 39 -> {
                        {
                            i + 2 < n && s.byte(i + 1) == 39 && s.byte(i + 2) == 39 -> {
                                quote = 4

                                {
                                    #{overflow=wrap}
                                    i ?= i + 2
                                }: {
                                    err -> _

                                    -> _
                                }
                            }

                            -> quote = 2
                        }
                    }

                    c == 35 -> {
                        end = i
                        break
                    }
                }
            }
        }

        {
            #{overflow=wrap}
            i ?= i + 1
        }: {
            err -> _

            -> _
        }
    }
    out = s.slice-bytes(0, end).trim()
}

; 解析 bare / quoted / dotted key，輸出 canonical dotted key。
; s: 原始鍵文字（bare / quoted / dotted）
; key: ok=標準化點號鍵, nil=鍵不合法的錯誤訊息
; [normalize-key](#toml.normalize-key)
normalize-key = (s str) (key ?str) {
    k = s.trim()
    n = k.len-bytes()
    n == 0 || n > TOML-MAX-KEY -> return
    k = k.replace-str('"', '')
    k = k.replace-str('\'', '')
    n = k.len-bytes()

    a = k.byte(0)

    #{overflow=wrap}
    z = k.byte(n - 1)
    (a == 34 && z == 34) || (a == 39 && z == 39) -> {
        key = unquote(k)
        return
    }
    i <- [0..n): {
        c = k.byte(i)
        valid = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 32 || c == 9
        valid == false -> return
    }
    key = k
}

; 解碼 basic/literal TOML 字串
; raw: 帶引號的原始字串
; value: ok=解碼後的內容, nil=非字串字面值, err=引號/跳脫非法
; [unquote](#toml.unquote)
unquote = (raw str) (value ?str) {
    s = raw.trim()
    n = s.len-bytes()
    n < 2 -> return

    q = s.byte(0)

    #{overflow=wrap}
    s.byte(n - 1) != q -> return
    q != 34 && q != 39 -> return

    q == 39 -> {

        #{overflow=wrap}
        value = s.slice-bytes(1, n - 1)
        return
    }

    ; str 下標直寫自 2026-11-11 起全域禁用 ⇒ `[]byte` 緩衝 + 顯式計數器。
    v-b []byte = with-cap-len(n, n)
    j = 0
    i = 1

    (i < n - 1) {

        #{overflow=wrap}
        i >= n - 1 -> break

        c = s.byte(i)
        c == 92 -> {

            #{overflow=wrap}
            i ?= i + 1

            #{overflow=wrap}
            i >= n - 1 -> return

            c = s.byte(i)
            {
                c == 110 -> c = 10

                c == 114 -> c = 13

                c == 116 -> c = 9

                c == 34 -> c = 34

                c == 92 -> c = 92

                -> return
            }
        }

        v-b[j] = c

        #{overflow=wrap}
        j ?= j + 1

        #{overflow=wrap}
        i ?= i + 1
    }
    value = v-b.slice(0, j).to-bytes-str()
}

; 判斷值是否已閉合；用於多行陣列、inline table、multiline string。
; raw: 值原始文字
; complete: 引號／括號是否已閉合（多行值讀取時決定能否結束）
; [value-complete](#toml.value-complete)
value-complete = (raw str) (complete bool) {
    complete = false
    s = raw.trim()
    n = s.len-bytes()
    n == 0 -> return
    depth = 0
    q = 0
    escaped = false
    i = 0
    (i < n) {
        i >= n -> break

        c = s.byte(i)
        {
            q == 1 -> {
                escaped -> escaped = false
                {
                    c == 92 -> escaped = true

                    c == 34 -> q = 0
                }
            }

            q == 2 -> c == 39 -> q = 0

            q == 3 -> {
                {
                    c == 34 && i + 2 < n && s.byte(i + 1) == 34 && s.byte(i + 2) == 34 -> {
                        q = 0

                        {
                            #{overflow=wrap}
                            i ?= i + 2
                        }: {
                            err -> _

                            -> _
                        }
                    }
                }
            }

            q == 4 -> {
                {
                    c == 39 && i + 2 < n && s.byte(i + 1) == 39 && s.byte(i + 2) == 39 -> {
                        q = 0

                        {
                            #{overflow=wrap}
                            i ?= i + 2
                        }: {
                            err -> _

                            -> _
                        }
                    }
                }
            }

            -> {

                #{overflow=wrap}
                {

                    c == 34 -> {
                        {
                            i + 2 < n && s.byte(i + 1) == 34 && s.byte(i + 2) == 34 -> {
                                q = 3

                                {
                                    #{overflow=wrap}
                                    i ?= i + 2
                                }: {
                                    err -> _

                                    -> _
                                }
                            }

                            -> q = 1
                        }
                    }

                    c == 39 -> {
                        {
                            i + 2 < n && s.byte(i + 1) == 39 && s.byte(i + 2) == 39 -> {
                                q = 4

                                {
                                    #{overflow=wrap}
                                    i ?= i + 2
                                }: {
                                    err -> _

                                    -> _
                                }
                            }

                            -> q = 2
                        }
                    }

                    c == 91 || c == 123 -> {
                        {
                            #{overflow=wrap}
                            depth ?= depth + 1
                        }: {
                            err -> _

                            -> _
                        }
                    }

                    c == 93 || c == 125 -> {
                        {
                            #{overflow=wrap}
                            depth ?= depth - 1
                        }: {
                            err -> _

                            -> _
                        }
                        depth < 0 -> return
                    }
                }
            }
        }

        {
            #{overflow=wrap}
            i ?= i + 1
        }: {
            err -> _

            -> _
        }
    }
    complete = q == 0 && depth == 0
}

; 接受 TOML 1.0 的 scalar、array、inline table 與日期時間字面值。
; raw: 值原始文字
; valid: 是否符合 TOML 1.0 字面值語法
; [valid-value](#toml.valid-value)
valid-value = (raw str) (valid bool) {
    valid = false
    s = raw.trim()
    n = s.len-bytes()
    n == 0 || n > TOML-MAX-VALUE -> return
    complete = value-complete(s)
    complete == false -> return

    c = s.byte(0)
    {
        c == 34 || c == 39 || c == 91 || c == 123 -> valid = true

        -> {
            s == 'true' || s == 'false' || s == 'inf' || s == '+inf' || s == '-inf' || s == 'nan' || s == '+nan' || s == '-nan' -> {
                valid = true
                return
            }
            i <- [0..n): {
                c = s.byte(i)
                allowed = (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) || c == 43 || c == 45 || c == 46 || c == 58 || c == 84 || c == 90 || c == 95 || c == 32 || c == 9 || c == 101 || c == 69 || c == 120 || c == 88 || c == 111 || c == 79 || c == 98 || c == 66
                allowed == false -> return
            }
            valid = true
        }
    }
}

; 記錄已定義表格，重複定義回傳 false。
; doc: 登記目標文件
; name: 表格名稱
; ok: true=首次定義, false=重複定義
; [register-table](#toml.register-table)
register-table = (doc toml, name str) (ok bool) {
    ok = false
    i <- [0..doc.table-count): {
        {
            t ?= doc.tables[i]
            table-name = table-name(t)
            table-name.eq-full(name) -> return
        }: {
            err -> _

            -> _
        }
    }
    doc.table-count >= TOML-MAX-TABLES -> return
    doc.tables[doc.table-count].name-len = name.len-bytes()
    i <- [0..name.len-bytes()): {
        {
            doc.tables[doc.table-count].name[i] ?= name.byte(i)
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    doc.table-count = doc.table-count + 1: {
        ok -> it

        ->
    }
    ok = true
}

; 將 array-of-tables 的子表解析到最近一筆元素。
; doc: 當前文件
; name: 待解析的段落名
; resolved: 屬 array-of-tables 子鍵時改寫為 base[索引].後綴，否則原樣返回
; [resolve-section](#toml.resolve-section)
resolve-section = (doc toml, name str) (resolved str) {
    resolved = name
    i <- [0..doc.array-count): {
        a array-table
        {
            a ?= doc.arrays[i]
            base = array-name(a)
            name.starts-with(base) -> {
                blen = base.len-bytes()
                name.len-bytes() > blen -> {
                    name.byte(blen) == 46 -> {
                        suffix = name.slice-bytes(blen, name.len-bytes())

                        resolved = base - '[' - a.index.to-str() - ']' - suffix
                        return
                    }
                }
            }
        }: {
            err -> _

            -> _
        }
    }
}

; 取得並登記 array-of-tables 的下一個索引。
; doc: 當前文件
; name: array-of-tables 名稱
; idx: ok=本筆元素的索引（自動遞增登記）, nil=同名表未找到且容量已滿
; [next-array-table](#toml.next-array-table)
next-array-table = (doc toml, name str) (idx ?i64) {
    i <- [0..doc.array-count): {
        a ?= doc.arrays[i]
        array-name = array-name(a)
        array-name.eq-full(name) -> {

            #{overflow=wrap}
            n = a.index + 1

            doc.arrays[i].index = n
            idx = n
            return
        }
    }
    doc.array-count >= TOML-MAX-ARRAY-TABLES -> return
    doc.arrays[doc.array-count].name-len = name.len-bytes()
    i <- [0..name.len-bytes()): {
        {
            doc.arrays[doc.array-count].name[i] ?= name.byte(i)
        }: {
            err -> _

            -> _
        }
    }

    doc.arrays[doc.array-count].index = 0

    #{overflow=wrap}
    doc.array-count = doc.array-count + 1: {
        ok -> it

        ->
    }
    idx = 0
}

; 解析 TOML 文件，失敗返回 err(message)
; s: TOML 全文
; result: ok=解析後文件, err=帶原因的錯誤訊息
; [parse](#toml.parse)
toml.parse = (s str) (result ?toml) {
    doc = toml.new()
    section = ''
    lines = s.split('\n')
    line-no = 0
    i = 0
    (i < lines.len()) {
        i >= lines.len() -> break

        ; D11 起索引讀取 `lines[i]` 回傳 `?str`，需以值 match 顯式消費；此處以
        ; place-match 取出 ok 值、nil 臂以 `_` 丟棄（D11 起已移除註解折值），
        ; 再以純 str 傳給 strip-comment（原本的寫法讓 option 直接流入 i64/str 形參）。
        line-raw = lines[i]: {
            ok -> it

            -> _
        }
        line = strip-comment(line-raw)

        #{overflow=wrap}
        line-no ?= i + 1
        line.len-bytes() == 0 -> {

            #{overflow=wrap}
            i ?= i + 1
            continue
        }

        ; [table] 或 [[array-of-tables]]
        line.starts-with('[') -> {
            is-array-table = line.starts-with('[[')
            close-len = 1
            is-array-table -> close-len = 2
            line.ends-with(']') == false -> {
                result = err('toml parse error at line ' - line-no.to-str())
                return
            }
            is-array-table && line.ends-with(']]') == false -> {
                result = err('toml parse error at line ' - line-no.to-str())
                return
            }

            #{overflow=wrap}
            end-pos = line.len-bytes() - close-len
            start-pos = close-len
            end-pos <= start-pos -> {
                result = err('toml parse error at line ' - line-no.to-str())
                return
            }
            raw-section = line.slice-bytes(start-pos, end-pos).trim()
            ; ⚠️ err 臂要 return，只能用语句 match：`?=` 块的臂是独立帧，
            ; 臂内的 return 不会退出所在函数（见 test/README.md §5.2o）。
            normalized-section = normalize-key(raw-section)
            normalized-section: {
                ok -> section = it

                -> {
                    result = err('toml parse error at line ' - line-no.to-str())
                    return
                }
            }
            {
                is-array-table -> {
                    array-table-index = next-array-table(doc, section)
                    array-index = 0
                    array-table-index: {
                        ok -> array-index = it

                        -> {
                            result = err('toml array table limit reached')
                            return
                        }
                    }

                    section = section - '[' - array-index.to-str() - ']'
                }

                -> {
                    section = resolve-section(doc, section)
                    table-ok = register-table(doc, section)
                    table-ok == false -> {
                        result = err('toml duplicate table at line ' - line-no.to-str())
                        return
                    }
                }
            }

            #{overflow=wrap}
            i ?= i + 1
            continue
        }

        eq = find-eq(line)

        #{overflow=wrap}
        eq <= 0 || eq >= line.len-bytes() - 1 -> {
            result = err('toml parse error at line ' - line-no.to-str())
            return
        }
        raw-key = line.slice-bytes(0, eq).trim()
        normalized-key = normalize-key(raw-key)
        key = ''
        normalized-key: {
            ok -> key = it

            -> {
                result = err('toml parse error at line ' - line-no.to-str())
                return
            }
        }

        section.len-bytes() > 0 -> key = section - '.' - key
        raw-value = line.slice-bytes(eq + 1, line.len-bytes()).trim()
        raw-value.len-bytes() == 0 -> {
            result = err('toml parse error at line ' - line-no.to-str())
            return
        }
        complete = value-complete(raw-value)
        {
            complete == false -> {

                #{overflow=wrap}
                j = i + 1: {
                    ok -> it

                    -> 0
                }
                (j < lines.len()) {
                    j >= lines.len() -> break

                    ; D11 起同上 —— 索引讀取回傳 `?str`，以值 match 顯式消費 ?T 再用。
                    next-line-raw = lines[j]: {
                        ok -> it

                        -> _
                    }
                    next-line = strip-comment(next-line-raw)

                    raw-value = raw-value - '\n' - next-line
                    complete = value-complete(raw-value)

                    #{overflow=wrap}
                    j ?= j + 1
                    complete -> break
                }
                complete == false -> {
                    result = err('toml unterminated value at line ' - line-no.to-str())
                    return
                }

                #{overflow=wrap}
                i = j - 1: {
                    ok -> it

                    -> 0
                }
            }
        }
        valid-value = valid-value(raw-value)
        valid-value == false -> {
            result = err('toml invalid value at line ' - line-no.to-str())
            return
        }
        key = key.trim()
        key.len-bytes() == 0 -> {
            result = err('toml parse error at line ' - line-no.to-str())
            return
        }
        key-exists = false
        k <- [0..doc.count): {
            e ?= doc.entries[k]
            entry-key = entry-key(e)
            entry-key.eq-full(key) -> {
                key-exists = true
                break
            }
        }
        key-exists -> {
            result = err('toml duplicate key at line ' - line-no.to-str())
            return
        }
        doc.count >= TOML-MAX-ENTRIES -> {
            result = err('toml document is full')
            return
        }
        doc.entries[doc.count] ?= make-entry(key, raw-value)

        #{overflow=wrap}
        doc.count = doc.count + 1: {
            ok -> it

            ->
        }

        #{overflow=wrap}
        i ?= i + 1
    }
    result = doc
}

; 以 TOML 1.0 語法輸出文件；array-of-tables 會還原為 [[table]] 標頭。
; doc: 待序列化的文件
; out: TOML 1.0 語法文字（逐條目與表格標頭輸出）
; [stringify](#toml.stringify)
stringify = (doc toml) (out str) {
    out = ''
    last-array = ''
    i <- [0..doc.count): {
        entry = doc.entries[i]
        key = entry-key(entry)
        value = entry-value(entry)
        lb = key.index('[')
        {
            lb >= 0 -> {
                rb = key.index(']')
                rb > lb -> {
                    prefix = key.slice-bytes(0, lb)

                    #{overflow=wrap}
                    array-id = key.slice-bytes(0, rb + 1)
                    array-id.eq-full(last-array) == false -> {
                        out.len-bytes() > 0 -> out = out - '\n'

                        out = out - '[[' - prefix - ']]\n'
                        last-array = array-id
                    }

                    #{overflow=wrap}
                    local-start = rb + 1
                    local-start < key.len-bytes() -> {

                        #{overflow=wrap}
                        local-key = key.slice-bytes(local-start + 1, key.len-bytes())

                        out = out - local-key - ' = ' - value
                    }
                }
            }

            -> {
                out = out - key - ' = ' - value
                last-array = ''
            }
        }

        #{overflow=wrap}
        i + 1 < doc.count -> out = out - '\n'
    }
}

; 設定原始 TOML 字面值。
; value 可為陣列、日期時間等 TOML 語法，模組不會替它加引號。
; key: 鍵（鍵無法標準化時失敗）
; value: TOML 原始字面值（經語法校驗後存入）
; ok: true=寫入成功, false=鍵非法／值非法／已滿
; [put](#toml.put)
toml.put = (key str, value str) (ok bool) {
    ok = false
    normalized-key = normalize-key(key)
    normalized-key: {
        ok -> key = it

        -> return
    }
    value-ok = valid-value(value)
    value-ok == false -> return
    i <- [0..self.count): {
        {
            e ?= .entries[i]
            entry-key = entry-key(e)
            entry-key.eq-full(key) -> {
                .entries[i] ?= make-entry(key, value)
                ok = true
                return
            }
        }: {
            err -> _

            -> _
        }
    }
    .count >= TOML-MAX-ENTRIES -> return
    {
        .entries[.count] ?= make-entry(key, value)

        #{overflow=wrap}
        .count = .count + 1: {
            ok -> it

            ->
        }
        ok = true
    }: {
        err -> _

        -> _
    }
}

; 取得原始 TOML 字面值
; 例如陣列、日期時間等尚未轉型的值可由此取得。
; doc: 讀取的文件
; key: 要查詢的鍵
; value: ok=原始字面值, nil=鍵不存在
; [get](#toml.get)
get = (doc toml, key str) (value ?str) {
    i <- [0..doc.count): {
        e ?= doc.entries[i]
        entry-key = entry-key(e)
        entry-key.eq-full(key) -> {
            value = entry-value(e)
            return
        }
    }
}

; 判斷鍵是否存在
; doc: 檢查的文件
; key: 要查詢的鍵
; found: 文件中是否含該鍵
; [has](#toml.has)
has = (doc toml, key str) (found bool) {
    i <- [0..doc.count): {
        {
            e ?= doc.entries[i]
            entry-key = entry-key(e)
            entry-key.eq-full(key) -> {
                found = true
                return
            }
        }: {
            err -> _

            -> _
        }
    }
}

; 取得並解碼字串值
; doc: 讀取的文件
; key: 要查詢的鍵
; value: ok=解碼字串, nil=鍵不存在, err=值非合法字串
; [get-str](#toml.get-str)
get-str = (doc toml, key str) (value ?str) {
    raw = get(doc, key)
    raw: {
        ok -> value = unquote(it)

        nil ->

        err ->
    }
}

; 支援十進位、十六進位、八進位、二進位與底線分隔。
; s: 整數字面值文字
; value: ok=數值, nil=空文字, err=格式非法或溢位
; [parse-i64](#toml.parse-i64)
parse-i64 = (s str) (value ?i64) {
    v = 0
    clean = s.trim()
    n = clean.len-bytes()
    n == 0 -> return
    start = 0
    neg = false

    c = clean.byte(0)
    c == 45 -> {
        neg = true

        #{overflow=wrap}
        start ?= start + 1
    }
    c == 43 -> {

        #{overflow=wrap}
        start ?= start + 1
    }
    base = 10

    #{overflow=wrap}
    start + 2 <= n -> {
        p0 = clean.byte(start)

        #{overflow=wrap}
        p1 = clean.byte(start + 1)
        {
            (p0 == 48 && (p1 == 120 || p1 == 88)) -> {
                base = 16

                #{overflow=wrap}
                start ?= start + 2
            }

            (p0 == 48 && (p1 == 111 || p1 == 79)) -> {
                base = 8

                #{overflow=wrap}
                start ?= start + 2
            }

            (p0 == 48 && (p1 == 98 || p1 == 66)) -> {
                base = 2

                #{overflow=wrap}
                start ?= start + 2
            }
        }
    }
    start >= n -> return
    digits = 0
    i <- [start..n): {
        ch = clean.byte(i): {
            ok -> it

            -> _
        }
        ch == 95 -> continue
        d = -1
        ch >= 48 && ch <= 57 -> {

            #{overflow=wrap}
            d = ch - 48
        }
        ch >= 65 && ch <= 70 -> {

            #{overflow=wrap}
            d = ch - 55
        }
        ch >= 97 && ch <= 102 -> {

            #{overflow=wrap}
            d = ch - 87
        }
        d < 0 || d >= base -> return

        #{overflow=wrap}
        v ?= v * base + d

        #{overflow=wrap}
        digits ?= digits + 1
    }
    digits == 0 -> return
    neg -> {

        #{overflow=wrap}
        v ?= 0 - v
    }
    value = v
}

; 解析浮點數
; s: 浮點字面值文字（自動去除底線分隔）
; value: ok=數值, err=格式非法
; [parse-f64](#toml.parse-f64)
parse-f64 = (s str) (value ?f64) {
    clean = s.replace-str('_', '')
    parsed = clean.to-f64()
    parsed: {
        ok -> value = it

        nil ->

        err ->
    }
}

; 解析布林值
; s: 布林字面值文字（僅 true/false）
; value: ok=布林值, err=非布林字面值
; [parse-bool](#toml.parse-bool)
parse-bool = (s str) (value ?bool) {
    parsed = s.to-bool()
    parsed: {
        ok -> value = it

        nil ->

        err ->
    }
}

; 取得十進位整數（允許 TOML 的底線分隔）
; doc: 讀取的文件
; key: 要查詢的鍵
; value: ok=整數值, err=鍵不存在或解析失敗
; [get-i64](#toml.get-i64)
get-i64 = (doc toml, key str) (value ?i64) {
    raw = get(doc, key)
    raw: {
        ok -> value = parse-i64(it)

        nil ->

        err ->
    }
}

; 取得浮點值（支援 exponent）
; doc: 讀取的文件
; key: 要查詢的鍵
; value: ok=浮點值, err=鍵不存在或解析失敗
; [get-f64](#toml.get-f64)
get-f64 = (doc toml, key str) (value ?f64) {
    raw = get(doc, key)
    raw: {
        ok -> value = parse-f64(it)

        nil ->

        err ->
    }
}

; 取得 true/false
; doc: 讀取的文件
; key: 要查詢的鍵
; value: ok=布林值, err=鍵不存在或非布林字面值
; [get-bool](#toml.get-bool)
get-bool = (doc toml, key str) (value ?bool) {
    raw = get(doc, key)
    raw: {
        ok -> value = parse-bool(it)

        nil ->

        err ->
    }
}
