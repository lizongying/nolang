; pool — TCP 連接池
;
; 提供 TCP 連接的池化管理，避免頻繁建立和關閉連接。
; 支援連接複用、最大連接數限制、空閒逾時回收。
;
; 用法：
;   p = pool{}
;   p.init('127.0.0.1', 8080, 10)    // 初始化：目標 127.0.0.1:8080，最大 10 連接
;   c = p.get()                       // 取得連接（返回 ?net.conn）
;   c: {
;       nil -> print('no connection')
;       ->
;           c.send('hello')
;           p.put(c)                   // 歸還連接（不是關閉）
;   }
;   p.close-all()                     // 關閉所有連接

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 連接池最大容量
POOL-MAX-CONNS = 32

; 空閒逾時（毫秒）
POOL-IDLE-TIMEOUT = 30000

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; pool: TCP 連接池
; host str: 目標主機
; port i64: 目標埠號
; max-size i64: 最大連接數
; conns [32]conn: 連接陣列
; in-use [32]bool: 連接是否在使用中
; count i64: 當前連接數
pool {
    host str
    port i64
    max-size i64
    conns [32]net.conn
    in-use [32]bool
    count i64
}

; ═══════════════════════════════════════════════
; pool 方法
; ═══════════════════════════════════════════════

; 初始化連接池
; host: 目標伺服器的主機名或 IP
; port: 目標伺服器的埠號
; max-size: 池內允許同時持有的最大連接數
; [init](#pool.pool.init)
pool.init = (host str, port i64, max-size i64) {
    r-max-size = max-size
    .host = host
    .port = port
    {
        r-max-size > POOL-MAX-CONNS -> r-max-size = POOL-MAX-CONNS

        r-max-size <= 0 -> r-max-size = 1
    }
    .max-size = r-max-size
    .count = 0
    i <- [0..POOL-MAX-CONNS): {

        .in-use[i] = false
    }
}

; 取得連接（優先複用空閒連接，否則新建）
; 返回 c ?net.conn: ok=連接, nil=失敗
; [get](#pool.pool.get)
pool.get = () (c ?net.conn) {
    c = nil

    ; 尋找空閒連接
    i <- [0...count): {
        .in-use[i] == false -> {

            .in-use[i] = true

            c = .conns[i]
            return
        }
    }

    ; 沒有空閒連接，嘗試新建
    .count < .max-size -> {
        cn = net.conn {}
        ok = false
        ok = cn.dial(.host, .port)
        ok -> {

            .conns[.count] = cn

            .in-use[.count] = true

            #{overflow=wrap}
            .count = .count + 1
            c = cn
        }
    }
}

; 歸還連接到池中（不關閉）
; c: 要歸還進池的連接（保持開啟、不關閉）
; [put](#pool.pool.put)
pool.put = (c net.conn) {

    ; 尋找該連接在池中的位置
    i <- [0...count): {
        .conns[i].fd == c.fd -> {

            .in-use[i] = false
            return
        }
    }

    ; 不在池中，直接關閉
    c.close()
}

; 關閉並移除指定連接
; idx: 池中要關閉並移除的連接索引
; [close-conn](#pool.pool.close-conn)
pool.close-conn = (idx i64) {

    idx < 0 || idx >= .count -> return

    .conns[idx].close()

    ; 將最後一個移到當前位置
    #{overflow=wrap}
    last = .count - 1
    idx != last -> {

        .conns[idx] = .conns[last]

        .in-use[idx] = .in-use[last]
    }

    #{overflow=wrap}
    .count = .count - 1
}

; 關閉所有連接
; [close-all](#pool.pool.close-all)
pool.close-all = () {
    i <- [0...count): {

        .conns[i].close()
    }
    .count = 0
}

; 取得活躍連接數
; 返回 n i64: 活躍連接數
; [active-count](#pool.pool.active-count)
pool.active-count = () (n i64) {
    n = 0
    i <- [0...count): {

        #{overflow=wrap}
        .in-use[i] -> {

            n = n + 1
        }
    }
}

; 取得空閒連接數
; 返回 n i64: 空閒連接數
; [idle-count](#pool.pool.idle-count)
pool.idle-count = () (n i64) {
    n = 0
    i <- [0...count): {

        #{overflow=wrap}
        .in-use[i] == false -> {

            n = n + 1
        }
    }
}

; 取得總連接數
; 返回 n i64: 總連接數
; [total-count](#pool.pool.total-count)
pool.total-count = () (n i64) {
    n = .count
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; 建立並初始化連接池
; host: 目標伺服器的主機名或 IP
; port: 目標伺服器的埠號
; max-size: 允許的最大連接數
; 返回 p pool: 初始化完畢的連接池實例
; [create](#pool.create)
create = (host str, port i64, max-size i64) (p pool) {
    p.init(host, port, max-size)
}

; 使用預設大小建立連接池
; host: 目標伺服器的主機名或 IP
; port: 目標伺服器的埠號
; 返回 p pool: 連接數上限為預設 8 的連接池
; [with-size](#pool.with-size)
with-size = (host str, port i64) (p pool) {
    p.init(host, port, 8)
}
