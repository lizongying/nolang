; proxy — HTTP/HTTPS 代理支援
;
; 提供 HTTP CONNECT 代理隧道功能，支援通過代理伺服器存取 HTTP 和 HTTPS 服務。
;
; 用法：
;   // 通過 HTTP 代理連接
;   c = dial('proxy.example.com', 3128, 'target.example.com', 443)
;   c: {
;       nil -> print('proxy connection failed')
;       -> c.send('hello')
;   }
;
;   // 通過代理建立 TLS 連接
;   tc = proxy-tls-dial('proxy.example.com', 3128, 'target.example.com', 443)
;   tc: {
;       nil -> print('proxy TLS connection failed')
;       -> w = tc.send('GET / HTTP/1.1\r\nHost: target.example.com\r\n\r\n')
;   }

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 代理緩衝區大小
PROXY-BUF-SIZE = 4096

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; config: 代理配置
; host str: 代理伺服器主機
; port i64: 代理伺服器埠號
; username str: 認證用戶名（空=不認證）
; password str: 認證密碼
config {
    host str
    port i64
    username str
    password str
}

; ═══════════════════════════════════════════════
; HTTP CONNECT 代理
; ═══════════════════════════════════════════════

; 通過 HTTP CONNECT 建立代理隧道
; 連上代理後發送 CONNECT target-host:target-port，收到 200 即完成握手；
; username 非空時附帶 Basic 認證標頭。
; proxy-host str: 代理伺服器主機名或 IP
; proxy-port i64: 代理伺服器埠號（HTTP 代理通常為 3128 / 8080）
; target-host str: 要穿透到的目標主機名
; target-port i64: 目標服務埠號（如 HTTPS 的 443）
; username str: Basic 認證用戶名；空字串表示不帶認證頭
; password str: Basic 認證密碼（username 為空時忽略）
; 返回 fd fd: 已建立的隧道 socket 描述符，-1=連接或握手失敗
; [connect](#proxy.connect)
connect = (proxy-host str, proxy-port i64, target-host str, target-port i64, username str, password str) (fd fd) {

    fd = -1

    ; 連接到代理伺服器
    fd = net.net-dial(proxy-host, proxy-port)
    fd < 0 -> return
    cr = '\r'
    lf = '\n'

    crlf = cr - lf

    ; 建構 CONNECT 請求
    target-port-s = target-port.to-str()

    req = 'CONNECT ' - target-host - ':' - target-port-s - ' HTTP/1.1' - crlf

    req = req - 'Host: ' - target-host - ':' - target-port-s - crlf

    ; 代理認證（Basic 認證）
    username.len-bytes() > 0 -> {

        ; 格式: Proxy-Authorization: Basic base64(user:pass)
        auth-raw = username - ':' - password
        auth-bytes []byte = auth-raw.to-bytes()
        enc-str = base64.encode-std(auth-bytes)
        req = req - 'Proxy-Authorization: Basic ' - enc-str - crlf
    }

    req = req - crlf

    ; 發送 CONNECT 請求
    written = net.net-send(fd, req, req.len-bytes())
    written < 0 -> {
        fs.close(fd)
        fd = -1
        return
    }

    ; 接收回應（雙緩衝區：buf 接收, raw 累積）
    buf str = with-len(PROXY-BUF-SIZE)

    #{overflow=wrap}
    raw str = with-len(PROXY-BUF-SIZE * 4)
    total = 0

    separator = crlf - crlf
    sep-pos = -1

    !! {

        #{overflow=wrap}
        total > PROXY-BUF-SIZE * 4 - PROXY-BUF-SIZE -> {
            fs.close(fd)
            fd = -1
            return
        }
        n = net.net-recv(fd, buf, PROXY-BUF-SIZE)
        n <= 0 -> {
            fs.close(fd)
            fd = -1
            return
        }
        i <- [0..n): {

            #{overflow=wrap}
            raw[total + i]: {
                ok -> it = buf.byte(i)

                -> _
            }
        }

        #{overflow=wrap}
        total = total + n
        data = raw.slice(0, total)
        sep-pos = data.index(separator)
        sep-pos >= 0 -> break
    }

    ; 解析狀態行
    head = raw.slice(0, sep-pos)
    first-line-end = head.index(crlf)
    status-line = head
    first-line-end >= 0 -> status-line = head.slice(0, first-line-end)

    ; 檢查狀態碼（200 = 成功）
    sp1 = status-line.index(' ')
    sp1 < 0 -> {
        fs.close(fd)
        fd = -1
        return
    }

    #{overflow=wrap}
    after-code = status-line.slice(sp1 + 1, status-line.len-bytes())
    sp2 = after-code.index(' ')
    code-str = after-code
    sp2 >= 0 -> code-str = after-code.slice(0, sp2)
    code = 0
    i <- [0..code-str.len-bytes()): {

        ch = code-str[i]
        ch < 48 || ch > 57 -> {
            fs.close(fd)
            fd = -1
            return
        }

        #{overflow=wrap}
        code = code * 10 + ch - 48
    }
    code != 200 -> {
        fs.close(fd)
        fd = -1
        return
    }
}

; 通過代理建立 TCP 連接（便捷函數，無認證）
; 等價於 connect(..., '', '')。
; proxy-host str: 代理伺服器主機名或 IP
; proxy-port i64: 代理伺服器埠號
; target-host str: 要穿透到的目標主機名
; target-port i64: 目標服務埠號
; 返回 fd fd: 已建立的隧道 socket 描述符，-1=失敗
; [dial](#proxy.dial)
dial = (proxy-host str, proxy-port i64, target-host str, target-port i64) (fd fd) {
    fd = connect(proxy-host, proxy-port, target-host, target-port, '', '')
}

; 通過代理建立 TCP 連接（含認證）
; 等價於 connect(...)，只是把帳密明寫成參數。
; proxy-host str: 代理伺服器主機名或 IP
; proxy-port i64: 代理伺服器埠號
; target-host str: 要穿透到的目標主機名
; target-port i64: 目標服務埠號
; username str: Basic 認證用戶名
; password str: Basic 認證密碼
; 返回 fd fd: 已建立的隧道 socket 描述符，-1=失敗
; [dial-auth](#proxy.dial-auth)
dial-auth = (proxy-host str, proxy-port i64, target-host str, target-port i64, username str, password str) (fd fd) {
    fd = connect(proxy-host, proxy-port, target-host, target-port, username, password)
}

; ═══════════════════════════════════════════════
; 通過代理建立 TLS 連接
; ═══════════════════════════════════════════════

; 通過代理建立 TLS 連接
; 先做 HTTP CONNECT（不帶認證）得到隧道，再在隧道上發起 TLS 握手。
; proxy-host str: 代理伺服器主機名或 IP
; proxy-port i64: 代理伺服器埠號
; target-host str: TLS 伺服器主機名（也用於握手時的 SNI / 證書校驗）
; target-port i64: TLS 服務埠號（通常 443）
; 返回 tc ?tls.conn: ok=在隧道上完成握手的 TLS 連接, nil=隧道或握手任一階段失敗
; [proxy-tls-dial](#proxy.proxy-tls-dial)
proxy-tls-dial = (proxy-host str, proxy-port i64, target-host str, target-port i64) (tc ?tls.conn) {
    tc = nil

    ; 1. 通過代理建立 TCP 隧道
    fd = connect(proxy-host, proxy-port, target-host, target-port, '', '')
    fd < 0 -> return

    ; 2. 在隧道上建立 TLS 連接
    c tls.conn
    c.init()
    c.fd = fd
    c.connected = true
    c.host = target-host

    ; 發送 TLS ClientHello
    ok = false
    ok = c.send-client-hello-13()
    ok == false -> {
        c.close()
        return
    }

    ; 讀取 ServerHello 並偵測版本
    ok = c.read-server-hello-13()
    {
        ok -> {

            ; TLS 1.3 路徑
            ok = c.connect-13()
            ok == false -> {
                c.close()
                return
            }
        }

        -> {

            ; TLS 1.2 fallback
            c.version = tls.TLS-VERSION

            cert []byte
            ok = c.read-certificate(cert)
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-server-hello-done()
            ok == false -> {
                c.close()
                return
            }

            ; 生成 premaster secret
            premaster []byte

            premaster[0]: {
                ok -> it = 0x03

                -> _
            }

            premaster[1]: {
                ok -> it = 0x03

                -> _
            }
            rand-bytes []byte = tls.rand-bytes(c.rand-state, 46)
            i <- [0..46): {

                #{overflow=wrap}
                premaster[2 + i]: {
                    ok -> it = rand-bytes[i]

                    -> _
                }
            }
            c.derive-keys(premaster)

            ok = c.send-client-key-exchange(premaster, cert)
            ok == false -> {
                c.close()
                return
            }
            c.send-change-cipher-spec()
            c.encrypted = true

            ok = c.send-finished(premaster)
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-change-cipher-spec()
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-finished(premaster)
            ok == false -> {
                c.close()
                return
            }
        }
    }
    tc = c
}

; 使用 config 建立代理連接
; 代理地址與帳密取自接收者（.host / .port / .username / .password）。
; target-host str: 要穿透到的目標主機名
; target-port i64: 目標服務埠號
; 返回 fd fd: 已建立的隧道 socket 描述符，-1=失敗
; [connect](#proxy.config.connect)
config.connect = (target-host str, target-port i64) (fd fd) {
    fd = connect(.host, .port, target-host, target-port, .username, .password)
}

; 使用 config 建立代理 TLS 連接
; 先用接收者的代理設定打通 CONNECT 隧道，再在隧道上完成 TLS 握手。
; target-host str: TLS 伺服器主機名（用於 SNI / 證書校驗）
; target-port i64: TLS 服務埠號
; 返回 tc ?tls.conn: ok=完成握手的 TLS 連接, nil=失敗
; [tls-connect](#proxy.config.tls-connect)
config.tls-connect = (target-host str, target-port i64) (tc ?tls.conn) {
    tc = nil
    fd = connect(.host, .port, target-host, target-port, .username, .password)
    fd < 0 -> return
    c tls.conn
    c.init()
    c.fd = fd
    c.connected = true
    c.host = target-host

    ok = false
    ok = c.send-client-hello-13()
    ok == false -> {
        c.close()
        return
    }
    ok = c.read-server-hello-13()
    {
        ok -> {
            ok = c.connect-13()
            ok == false -> {
                c.close()
                return
            }
        }

        -> {
            c.version = tls.TLS-VERSION
            cert []byte
            ok = c.read-certificate(cert)
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-server-hello-done()
            ok == false -> {
                c.close()
                return
            }
            premaster []byte

            premaster[0]: {
                ok -> it = 0x03

                -> _
            }

            premaster[1]: {
                ok -> it = 0x03

                -> _
            }
            rand-bytes []byte = tls.rand-bytes(c.rand-state, 46)
            i <- [0..46): {

                #{overflow=wrap}
                premaster[2 + i]: {
                    ok -> it = rand-bytes[i]

                    -> _
                }
            }
            c.derive-keys(premaster)
            ok = c.send-client-key-exchange(premaster, cert)
            ok == false -> {
                c.close()
                return
            }
            c.send-change-cipher-spec()
            c.encrypted = true
            ok = c.send-finished(premaster)
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-change-cipher-spec()
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-finished(premaster)
            ok == false -> {
                c.close()
                return
            }
        }
    }
    tc = c
}

; ═══════════════════════════════════════════════
; SOCKS5 代理（基本支援）
; ═══════════════════════════════════════════════

; SOCKS5 版本
SOCKS5-VERSION = 5

; SOCKS5 認證方法
SOCKS5-METHOD-NO-AUTH = 0
SOCKS5-METHOD-USER-PASS = 2
SOCKS5-METHOD-NONE-ACCEPTABLE = 255

; SOCKS5 命令
SOCKS5-CMD-CONNECT = 1

; SOCKS5 地址類型
SOCKS5-ATYP-IPV4 = 1
SOCKS5-ATYP-DOMAIN = 3

; 通過 SOCKS5 代理建立連接
; 先做方法協商（username 非空時走 0x02 用戶名/密碼認證，否則 0x00 無認證），
; 再用 CONNECT 命令把目標地址交給代理。
; proxy-host str: SOCKS5 代理主機名或 IP
; proxy-port i64: SOCKS5 代理埠號（通常 1080）
; target-host str: 要穿透到的目標主機；非 IP 字面量時以域名字串交給代理解析
; target-port i64: 目標服務埠號
; username str: 用戶名；空字串表示不認證
; password str: 密碼（username 為空時忽略）
; 返回 fd fd: 已建立的隧道 socket 描述符，-1=協商或連接失敗
; [socks5-connect](#proxy.socks5-connect)
socks5-connect = (proxy-host str, proxy-port i64, target-host str, target-port i64, username str, password str) (fd fd) {

    fd = -1

    ; 連接到 SOCKS5 代理
    fd = net.net-dial(proxy-host, proxy-port)
    fd < 0 -> return

    ; 1. 握手 — 方法協商
    req []byte

    req[0]: {
        ok -> it = SOCKS5-VERSION

        -> _
    }
    {
        username.len-bytes() > 0 -> {
            req[1]: {
                ok -> it = 2

                -> _
            }

            req[2]: {
                ok -> it = SOCKS5-METHOD-NO-AUTH

                -> _
            }

            req[3]: {
                ok -> it = SOCKS5-METHOD-USER-PASS

                -> _
            }
        }

        -> {
            req[1]: {
                ok -> it = 1

                -> _
            }

            req[2]: {
                ok -> it = SOCKS5-METHOD-NO-AUTH

                -> _
            }
        }
    }
    req-str = req.to-str()

    #{overflow=wrap}
    written = net.net-send(fd, req-str, req.len() + 1)
    written < 0 -> {
        fs.close(fd)
        fd = -1
        return
    }

    ; 接收方法選擇回應（2 bytes）
    resp str = with-len(2)
    n = net.net-recv(fd, resp, 2)
    n != 2 -> {
        fs.close(fd)
        fd = -1
        return
    }

    ver = resp.byte(0)

    method = resp.byte(1)
    ver != SOCKS5-VERSION || method == SOCKS5-METHOD-NONE-ACCEPTABLE -> {
        fs.close(fd)
        fd = -1
        return
    }

    ; 如果需要用戶名/密碼認證
    #{overflow=wrap}
    method == SOCKS5-METHOD-USER-PASS -> {

        auth-req []byte
        pos = 0

        auth-req[pos]: {
            ok -> it = 1

            -> _
        }
        pos = pos + 1

        auth-req[pos]: {
            ok -> it = username.len-bytes() & 255

            -> _
        }
        pos = pos + 1
        i <- [0..username.len-bytes()): {

            auth-req[pos]: {
                ok -> it = username.byte(i)

                -> _
            }
            pos = pos + 1
        }

        auth-req[pos]: {
            ok -> it = password.len-bytes() & 255

            -> _
        }
        pos = pos + 1
        i <- [0..password.len-bytes()): {

            auth-req[pos]: {
                ok -> it = password.byte(i)

                -> _
            }
            pos = pos + 1
        }
        auth-str = auth-req.to-str()
        written = net.net-send(fd, auth-str, pos)
        written < 0 -> {
            fs.close(fd)
            fd = -1
            return
        }

        ; 接收認證回應（2 bytes）
        auth-resp str = with-len(2)
        n = net.net-recv(fd, auth-resp, 2)
        n != 2 -> {
            fs.close(fd)
            fd = -1
            return
        }
        (auth-resp.byte(1)) != 0 -> {
            fs.close(fd)
            fd = -1
            return
        }
    }

    ; 2. 連接請求
    conn-req []byte
    pos = 0

    conn-req[pos]: {
        ok -> it = SOCKS5-VERSION

        -> _
    }

    #{overflow=wrap}
    pos = pos + 1

    conn-req[pos]: {
        ok -> it = SOCKS5-CMD-CONNECT

        -> _
    }

    #{overflow=wrap}
    pos = pos + 1

    conn-req[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    pos = pos + 1

    ; 使用域名地址類型
    conn-req[pos]: {
        ok -> it = SOCKS5-ATYP-DOMAIN

        -> _
    }

    #{overflow=wrap}
    pos = pos + 1

    conn-req[pos]: {
        ok -> it = target-host.len-bytes() & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 1
    i <- [0..target-host.len-bytes()): {

        conn-req[pos]: {
            ok -> it = target-host.byte(i)

            -> _
        }

        #{overflow=wrap}
        pos = pos + 1
    }

    conn-req[pos]: {
        ok -> it = (target-port >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 1

    conn-req[pos]: {
        ok -> it = target-port & 255

        -> _
    }

    #{overflow=wrap}
    pos = pos + 1
    conn-str = conn-req.to-str()
    written = net.net-send(fd, conn-str, pos)
    written < 0 -> {
        fs.close(fd)
        fd = -1
        return
    }

    ; 接收連接回應（至少 10 bytes）
    reply str = with-len(16)
    n = net.net-recv(fd, reply, 16)
    n < 4 -> {
        fs.close(fd)
        fd = -1
        return
    }
    (reply.byte(0)) != SOCKS5-VERSION -> {
        fs.close(fd)
        fd = -1
        return
    }

    rep = reply.byte(1)
    rep != 0 -> {
        fs.close(fd)
        fd = -1
        return
    }
    ; 連接成功
}

; 通過 SOCKS5 代理建立連接（便捷函數，無認證）
; 等價於 socks5-connect(..., '', '')，走 0x00 無認證協商。
; proxy-host str: SOCKS5 代理主機名或 IP
; proxy-port i64: SOCKS5 代理埠號（通常 1080）
; target-host str: 要穿透到的目標主機；非 IP 字面量時以域名字串交給代理解析
; target-port i64: 目標服務埠號
; 返回 fd fd: 已建立的隧道 socket 描述符，-1=失敗
; [socks5-dial](#proxy.socks5-dial)
socks5-dial = (proxy-host str, proxy-port i64, target-host str, target-port i64) (fd fd) {
    fd = socks5-connect(proxy-host, proxy-port, target-host, target-port, '', '')
}
