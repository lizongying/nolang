// proxy — HTTP/HTTPS 代理支援
//
// 提供 HTTP CONNECT 代理隧道功能，支援通過代理伺服器存取 HTTP 和 HTTPS 服務。
//
// 用法：
//   // 通過 HTTP 代理連接
//   c = proxy-dial('proxy.example.com', 3128, 'target.example.com', 443)
//   c: {
//       nil -> print('proxy connection failed')
//       -> c.send('hello')
//   }
//
//   // 通過代理建立 TLS 連接
//   tc = proxy-tls-dial('proxy.example.com', 3128, 'target.example.com', 443)
//   tc: {
//       nil -> print('proxy TLS connection failed')
//       -> w = tc.send('GET / HTTP/1.1\r\nHost: target.example.com\r\n\r\n')
//   }

// ═══════════════════════════════════════════════
// 常量
// ═══════════════════════════════════════════════

// 代理緩衝區大小
PROXY-BUF-SIZE = 4096

// ═══════════════════════════════════════════════
// 結構體
// ═══════════════════════════════════════════════

// proxy-config: 代理配置
// host str: 代理伺服器主機
// port i64: 代理伺服器埠號
// username str: 認證用戶名（空=不認證）
// password str: 認證密碼
proxy-config {
    host str
    port i64
    username str
    password str
}

// ═══════════════════════════════════════════════
// HTTP CONNECT 代理
// ═══════════════════════════════════════════════

// proxy-connect: 通過 HTTP CONNECT 建立代理隧道
// proxy-host str: 代理伺服器主機
// proxy-port i64: 代理伺服器埠號
// target-host str: 目標主機
// target-port i64: 目標埠號
// username str: 認證用戶名（空=不認證）
// password str: 認證密碼
// 返回 fd i64: 隧道 socket fd（-1=失敗）
proxy-connect = (proxy-host str, proxy-port i64, target-host str, target-port i64, username str, password str) (fd i64) {
    fd = -1

    // 連接到代理伺服器
    fd = net-dial(proxy-host, proxy-port)
    fd < 0 -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    // 建構 CONNECT 請求
    target-port-s = target-port.to-str()
    req = 'CONNECT ' - target-host - ':' - target-port-s - ' HTTP/1.1' - crlf
    req = req - 'Host: ' - target-host - ':' - target-port-s - crlf

    // 代理認證（Basic 認證）
    username.len > 0 -> {
        // 格式: Proxy-Authorization: Basic base64(user:pass)
        auth-raw = username - ':' - password
        auth-bytes []byte = auth-raw.to-bytes()
        enc-str = base64.encode-std(auth-bytes)
        req = req - 'Proxy-Authorization: Basic ' - enc-str - crlf
    }

    req = req - crlf

    // 發送 CONNECT 請求
    written = net-send(fd, req, req.len)
    written < 0 -> {
        close(fd)
        fd = -1
        return
    }

    // 接收回應（雙緩衝區：buf 接收, raw 累積）
    space = ' '
    buf = space.repeat(PROXY-BUF-SIZE)
    raw = space.repeat(PROXY-BUF-SIZE * 4)
    total = 0
    separator = crlf - crlf
    sep-pos i64 = -1

    !! {
        total > PROXY-BUF-SIZE * 4 - PROXY-BUF-SIZE -> {
            close(fd)
            fd = -1
            return
        }
        n = net-recv(fd, buf, PROXY-BUF-SIZE)
        n <= 0 -> {
            close(fd)
            fd = -1
            return
        }
        i <- [0..n): {
            raw[total + i] = buf[i]
        }
        total = total + n
        data = raw.slice(0, total)
        sep-pos = data.index(separator)
        sep-pos >= 0 -> break
    }

    // 解析狀態行
    head = raw.slice(0, sep-pos)
    first-line-end = head.index(crlf)
    status-line = head
    first-line-end >= 0 -> status-line = head.slice(0, first-line-end)

    // 檢查狀態碼（200 = 成功）
    sp1 = status-line.index(' ')
    sp1 < 0 -> {
        close(fd)
        fd = -1
        return
    }
    after-code = status-line.slice(sp1 + 1, status-line.len)
    sp2 = after-code.index(' ')
    code-str = after-code
    sp2 >= 0 -> code-str = after-code.slice(0, sp2)
    code = 0
    i <- [0..code-str.len): {
        ch = code-str[i]
        ch < 48 || ch > 57 -> {
            close(fd)
            fd = -1
            return
        }
        code = code * 10 + ch - 48
    }

    code != 200 -> {
        close(fd)
        fd = -1
        return
    }
}

// proxy-dial: 通過代理建立 TCP 連接（便捷函數，無認證）
// proxy-host str: 代理伺服器主機
// proxy-port i64: 代理伺服器埠號
// target-host str: 目標主機
// target-port i64: 目標埠號
// 返回 fd i64: socket fd（-1=失敗）
proxy-dial = (proxy-host str, proxy-port i64, target-host str, target-port i64) (fd i64) {
    fd = proxy-connect(proxy-host, proxy-port, target-host, target-port, '', '')
}

// proxy-dial-auth: 通過代理建立 TCP 連接（含認證）
// proxy-host str: 代理伺服器主機
// proxy-port i64: 代理伺服器埠號
// target-host str: 目標主機
// target-port i64: 目標埠號
// username str: 認證用戶名
// password str: 認證密碼
// 返回 fd i64: socket fd（-1=失敗）
proxy-dial-auth = (proxy-host str, proxy-port i64, target-host str, target-port i64, username str, password str) (fd i64) {
    fd = proxy-connect(proxy-host, proxy-port, target-host, target-port, username, password)
}

// ═══════════════════════════════════════════════
// 通過代理建立 TLS 連接
// ═══════════════════════════════════════════════

// proxy-tls-dial: 通過代理建立 TLS 連接
// proxy-host str: 代理伺服器主機
// proxy-port i64: 代理伺服器埠號
// target-host str: 目標主機
// target-port i64: 目標埠號
// 返回 tc ?tls-conn: ok=TLS 連接, nil=失敗
proxy-tls-dial = (proxy-host str, proxy-port i64, target-host str, target-port i64) (tc ?tls-conn) {
    tc = nil

    // 1. 通過代理建立 TCP 隧道
    fd = proxy-connect(proxy-host, proxy-port, target-host, target-port, '', '')
    fd < 0 -> return

    // 2. 在隧道上建立 TLS 連接
    c tls-conn
    c.init()
    c.fd = fd
    c.connected = true
    c.host = target-host

    // 發送 TLS ClientHello
    ok = false
    ok = c.send-client-hello-13()
    ok == false -> {
        c.close()
        return
    }

    // 讀取 ServerHello 並偵測版本
    ok = c.read-server-hello-13()
    {
        ok -> {
            // TLS 1.3 路徑
            ok = c.connect-13()
            ok == false -> {
                c.close()
                return
            }
        }
        -> {
            // TLS 1.2 fallback
            c.version = tls.TLS-VERSION

            cert []byte
            ok = c.read-certificate(cert)
            ok == false -> {
                c.close()
                return
            }

            ok = c.read-server-hello-done()
            ok == false -> {
                c.close()
                return
            }

            // 生成 premaster secret
            premaster []byte
            premaster[0] = 0x03
            premaster[1] = 0x03
            rand-bytes []byte = tls.tls-rand-bytes(c.rand-state, 46)
            i <- [0..46): {
                premaster[2 + i] = rand-bytes[i]
            }

            c.derive-keys(premaster)

            ok = c.send-client-key-exchange(premaster, cert)
            ok == false -> {
                c.close()
                return
            }

            c.send-change-cipher-spec()
            c.encrypted = true

            ok = c.send-finished(premaster)
            ok == false -> {
                c.close()
                return
            }

            ok = c.read-change-cipher-spec()
            ok == false -> {
                c.close()
                return
            }

            ok = c.read-finished(premaster)
            ok == false -> {
                c.close()
                return
            }
        }
    }

    tc = c
}

// proxy-config.connect: 使用 proxy-config 建立代理連接
// target-host str: 目標主機
// target-port i64: 目標埠號
// 返回 fd i64: socket fd（-1=失敗）
proxy-config.connect = (target-host str, target-port i64) (fd i64) {
    fd = proxy-connect(.host, .port, target-host, target-port, .username, .password)
}

// proxy-config.tls-connect: 使用 proxy-config 建立代理 TLS 連接
// target-host str: 目標主機
// target-port i64: 目標埠號
// 返回 tc ?tls-conn: ok=TLS 連接, nil=失敗
proxy-config.tls-connect = (target-host str, target-port i64) (tc ?tls-conn) {
    tc = nil
    fd = proxy-connect(.host, .port, target-host, target-port, .username, .password)
    fd < 0 -> return
    c tls-conn
    c.init()
    c.fd = fd
    c.connected = true
    c.host = target-host

    ok = false
    ok = c.send-client-hello-13()
    ok == false -> {
        c.close()
        return
    }
    ok = c.read-server-hello-13()
    {
        ok -> {
            ok = c.connect-13()
            ok == false -> {
                c.close()
                return
            }
        }
        -> {
            c.version = tls.TLS-VERSION
            cert []byte
            ok = c.read-certificate(cert)
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-server-hello-done()
            ok == false -> {
                c.close()
                return
            }
            premaster []byte
            premaster[0] = 0x03
            premaster[1] = 0x03
            rand-bytes []byte = tls.tls-rand-bytes(c.rand-state, 46)
            i <- [0..46): {
                premaster[2 + i] = rand-bytes[i]
            }
            c.derive-keys(premaster)
            ok = c.send-client-key-exchange(premaster, cert)
            ok == false -> {
                c.close()
                return
            }
            c.send-change-cipher-spec()
            c.encrypted = true
            ok = c.send-finished(premaster)
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-change-cipher-spec()
            ok == false -> {
                c.close()
                return
            }
            ok = c.read-finished(premaster)
            ok == false -> {
                c.close()
                return
            }
        }
    }
    tc = c
}

// ═══════════════════════════════════════════════
// SOCKS5 代理（基本支援）
// ═══════════════════════════════════════════════

// SOCKS5 版本
SOCKS5-VERSION = 5

// SOCKS5 認證方法
SOCKS5-METHOD-NO-AUTH = 0
SOCKS5-METHOD-USER-PASS = 2
SOCKS5-METHOD-NONE-ACCEPTABLE = 255

// SOCKS5 命令
SOCKS5-CMD-CONNECT = 1

// SOCKS5 地址類型
SOCKS5-ATYP-IPV4 = 1
SOCKS5-ATYP-DOMAIN = 3

// socks5-connect: 通過 SOCKS5 代理建立連接
// proxy-host str: SOCKS5 代理主機
// proxy-port i64: SOCKS5 代理埠號
// target-host str: 目標主機
// target-port i64: 目標埠號
// username str: 認證用戶名（空=不認證）
// password str: 認證密碼
// 返回 fd i64: socket fd（-1=失敗）
socks5-connect = (proxy-host str, proxy-port i64, target-host str, target-port i64, username str, password str) (fd i64) {
    fd = -1

    // 連接到 SOCKS5 代理
    fd = net-dial(proxy-host, proxy-port)
    fd < 0 -> return

    // 1. 握手 — 方法協商
    space = ' '
    req []byte
    req[0] = SOCKS5-VERSION
    {
        username.len > 0 -> {
            req[1] = 2
            req[2] = SOCKS5-METHOD-NO-AUTH
            req[3] = SOCKS5-METHOD-USER-PASS
        }
        -> {
            req[1] = 1
            req[2] = SOCKS5-METHOD-NO-AUTH
        }
    }
    req-str = req.to-str()
    written = net-send(fd, req-str, req.len + 1)
    written < 0 -> {
        close(fd)
        fd = -1
        return
    }

    // 接收方法選擇回應（2 bytes）
    resp = space.repeat(2)
    n = net-recv(fd, resp, 2)
    n != 2 -> {
        close(fd)
        fd = -1
        return
    }
    ver = resp[0] & 255
    method = resp[1] & 255
    ver != SOCKS5-VERSION || method == SOCKS5-METHOD-NONE-ACCEPTABLE -> {
        close(fd)
        fd = -1
        return
    }

    // 如果需要用戶名/密碼認證
    method == SOCKS5-METHOD-USER-PASS -> {
        auth-req []byte
        pos = 0
        auth-req[pos] = 1
        pos = pos + 1
        auth-req[pos] = username.len & 255
        pos = pos + 1
        i <- [0..username.len): {
            auth-req[pos] = username[i] & 255
            pos = pos + 1
        }
        auth-req[pos] = password.len & 255
        pos = pos + 1
        i <- [0..password.len): {
            auth-req[pos] = password[i] & 255
            pos = pos + 1
        }
        auth-str = auth-req.to-str()
        written = net-send(fd, auth-str, pos)
        written < 0 -> {
            close(fd)
            fd = -1
            return
        }

        // 接收認證回應（2 bytes）
        auth-resp = space.repeat(2)
        n = net-recv(fd, auth-resp, 2)
        n != 2 -> {
            close(fd)
            fd = -1
            return
        }
        (auth-resp[1] & 255) != 0 -> {
            close(fd)
            fd = -1
            return
        }
    }

    // 2. 連接請求
    conn-req []byte
    pos = 0
    conn-req[pos] = SOCKS5-VERSION
    pos = pos + 1
    conn-req[pos] = SOCKS5-CMD-CONNECT
    pos = pos + 1
    conn-req[pos] = 0
    pos = pos + 1

    // 使用域名地址類型
    conn-req[pos] = SOCKS5-ATYP-DOMAIN
    pos = pos + 1
    conn-req[pos] = target-host.len & 255
    pos = pos + 1
    i <- [0..target-host.len): {
        conn-req[pos] = target-host[i] & 255
        pos = pos + 1
    }
    conn-req[pos] = (target-port >> 8) & 255
    pos = pos + 1
    conn-req[pos] = target-port & 255
    pos = pos + 1
    conn-str = conn-req.to-str()
    written = net-send(fd, conn-str, pos)
    written < 0 -> {
        close(fd)
        fd = -1
        return
    }

    // 接收連接回應（至少 10 bytes）
    reply = space.repeat(16)
    n = net-recv(fd, reply, 16)
    n < 4 -> {
        close(fd)
        fd = -1
        return
    }
    (reply[0] & 255) != SOCKS5-VERSION -> {
        close(fd)
        fd = -1
        return
    }
    rep = reply[1] & 255
    rep != 0 -> {
        close(fd)
        fd = -1
        return
    }
    // 連接成功
}

// socks5-dial: 通過 SOCKS5 代理建立連接（便捷函數，無認證）
// proxy-host str: SOCKS5 代理主機
// proxy-port i64: SOCKS5 代理埠號
// target-host str: 目標主機
// target-port i64: 目標埠號
// 返回 fd i64: socket fd（-1=失敗）
socks5-dial = (proxy-host str, proxy-port i64, target-host str, target-port i64) (fd i64) {
    fd = socks5-connect(proxy-host, proxy-port, target-host, target-port, '', '')
}
