; net — 網路操作
;
; 提供 TCP 網路編程能力，包括服務端監聽、客戶端連接、資料收發等。
; 底層使用 POSIX socket API（socket/bind/listen/accept/connect/send/recv）實作。
; 支援 AES-256-GCM 加密通道，為明文 TCP 連接提供端對端加密。
;
; 用法：
;   // TCP 服務端
;   l = listen-on('127.0.0.1', 8080)         // 返回 ?listener
;   l: {
;       nil -> return
;       -> c = l.accept()                      // 返回 ?conn
;   }
;   n = c.recv(buf, 1024)
;   n = c.send('hello')
;   c.close()
;   l.close()
;
;   // TCP 客戶端
;   c = dial-to('127.0.0.1', 8080)           // 返回 ?conn
;   n = c.send('hello')
;   n = c.recv(buf, 1024)
;   c.close()
;
;   // 加密通道
;   key [32]byte = [...]  // 共享金鑰
;   ec = enc-conn{}
;   ec.init(c, key)
;   ec.send-encrypted('sensitive data')
;   msg = ec.recv-encrypted()  // 返回 ?str

; ═══════════════════════════════════════════════
; 內建函數（底層實作）
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: net-listen)
; net-listen: 建立 TCP 監聽 socket
; 執行 socket + setsockopt(SO_REUSEADDR) + bind + listen
; 返回 fd（-1=失敗）
; net-listen = (host str, port i64) (fd fd) { }

; build-in (ForwardFunc: net-dial)
; net-dial: 建立 TCP 客戶端連接
; 執行 socket + connect
; 返回 fd（-1=失敗）
; net-dial = (host str, port i64) (fd fd) { }

; build-in (ForwardFunc: net-accept)
; net-accept: 接受 TCP 連接
; 返回客戶端 fd（-1=失敗）
; net-accept = (listen-fd fd) (fd fd) { }

; build-in (ForwardFunc: net-send)
; net-send: 發送資料
; 返回實際發送位元組數（-1=錯誤）
; net-send = (fd fd, data str, n i64) (written i64) { }

; build-in (ForwardFunc: net-recv)
; net-recv: 接收資料
; 返回實際接收位元組數（-1=錯誤, 0=連接關閉）
; net-recv = (fd fd, buf str, n i64) (read-n i64) { }

; build-in (ForwardFunc: close)
; close: 關閉檔案描述符（來自 fs 模組）
; close = (fd fd) (ok i64) { }

; ═══════════════════════════════════════════════
; 網路常量
; ═══════════════════════════════════════════════

; 地址族
AF-INET = 2

; socket 類型
SOCK-STREAM = 1

; setsockopt 層級
SOL-SOCKET = 65535

; socket 選項
SO-REUSEADDR = 4

; 監聽佇列長度
BACKLOG = 128

; 預設緩衝區大小
NET-BUF-SIZE = 4096

; ═══════════════════════════════════════════════
; Windows Winsock 初始化
; ═══════════════════════════════════════════════

; Windows 需要在使用 socket API 前呼叫 WSAStartup 初始化 Winsock 2.2
; 此頂層呼叫在模組載入時自動執行，確保後續所有網路操作可用
#{win-amd64, win-arm64}
os.win-wsa-startup()

; ═══════════════════════════════════════════════
; listener 結構體
; ═══════════════════════════════════════════════

; listener: TCP 監聽器
; fd: 監聽 socket 的檔案描述符（-1=未開啟）
listener {
    fd fd
}

; listen: 開始監聽
; host: 綁定的 IP 地址（如 '127.0.0.1'）
; port: 監聽埠號
; 返回 ok=true=成功
listener.listen = (host str, port i64) (ok bool) {
    ok = false
    .fd = -1
    fd = net-listen(host, port)
    fd < 0 -> return
    .fd = fd
    ok = true
}

; accept: 接受新的 TCP 連接
; 返回 c ?conn: ok=連接結構體, nil=失敗
listener.accept = () (c ?conn) {
    c = nil
    .fd < 0 -> return
    fd = net-accept(.fd)
    fd < 0 -> return
    c = conn{
        fd: fd
    }
}

; close: 關閉監聽 socket
listener.close = () {
    .fd >= 0 -> {
        fs.close(.fd)
        .fd = -1
    }
}

; fd-of: 取得監聽 socket 的檔案描述符
listener.fd-of = () (fd fd) {
    fd = .fd
}

; ═══════════════════════════════════════════════
; conn 結構體
; ═══════════════════════════════════════════════

; conn: TCP 連接
; fd: 連接 socket 的檔案描述符（-1=未連接）
conn {
    fd fd
}

; dial: 建立到服務端的 TCP 連接
; host: 目標 IP 地址（如 '127.0.0.1'）
; port: 目標埠號
; 返回 ok=true=成功
conn.dial = (host str, port i64) (ok bool) {
    ok = false
    .fd = -1
    fd = net-dial(host, port)
    fd < 0 -> return
    .fd = fd
    ok = true
}

; send: 發送字串資料
; data: 要發送的字串
; 返回 written=實際發送位元組數（-1=錯誤）
conn.send = (data str) (written i64) {
    written = -1
    .fd < 0 -> return
    written = net-send(.fd, data, data.len)
}

; recv: 接收資料到緩衝區
; buf: 接收緩衝區（str）
; n: 最多接收的位元組數
; 返回 read-n=實際接收位元組數（-1=錯誤, 0=連接關閉）
conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    .fd < 0 -> return
    read-n = net-recv(.fd, buf, n)
}

; recv-line: 接收一行資料（最多 NET-BUF-SIZE 位元組）
; 返回 line ?str: ok=接收內容, nil=失敗或連接關閉
conn.recv-line = () (line ?str) {
    line = nil
    .fd < 0 -> return
    buf str = with-len(NET-BUF-SIZE)
    n = net-recv(.fd, buf, NET-BUF-SIZE)
    n > 0 -> line = buf
}

; recv-all: 接收全部資料直到連接關閉
; 返回 content=接收的內容, total=總位元組數
conn.recv-all = () (content str, total i64) {
    total = 0
    .fd < 0 -> return
    buf str = with-len(NET-BUF-SIZE)
    {
        chunk-n = net-recv(.fd, buf, NET-BUF-SIZE)
        chunk-n <= 0 -> *
        i <- [0..chunk-n): {
            content[total + i] = buf[i]
        }
        total = total + chunk-n
    } ()
}

; close: 關閉連接
conn.close = () {
    .fd >= 0 -> {
        fs.close(.fd)
        .fd = -1
    }
}

; fd-of: 取得連接 socket 的檔案描述符
conn.fd-of = () (fd fd) {
    fd = .fd
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; listen-on: 建立監聽器並開始監聽
; 返回 l ?listener: ok=監聽器, nil=失敗
listen-on = (host str, port i64) (l ?listener) {
    l = nil
    lst = listener{}
    ok = false
    ok = lst.listen(host, port)
    ok -> l = lst
}

; dial-to: 建立連接並撥號
; 返回 c ?conn: ok=連接, nil=失敗
dial-to = (host str, port i64) (c ?conn) {
    c = nil
    cn = conn{}
    ok = false
    ok = cn.dial(host, port)
    ok -> c = cn
}

; ═══════════════════════════════════════════════
; UDP 結構體與方法
; ═══════════════════════════════════════════════

; build-in (ForwardFunc: net-udp-open)
; net-udp-open: 建立 UDP socket
; 返回 fd（-1=失敗）
; net-udp-open = () (fd fd) { }

; build-in (ForwardFunc: net-udp-sendto)
; net-udp-sendto: 發送 UDP 資料到指定位址
; 返回實際發送位元組數（-1=錯誤）
; net-udp-sendto = (fd fd, data str, n i64, host str, port i64) (written i64) { }

; build-in (ForwardFunc: net-udp-recvfrom)
; net-udp-recvfrom: 接收 UDP 資料
; 返回實際接收位元組數（-1=錯誤, 0=逾時）
; net-udp-recvfrom = (fd fd, buf str, n i64) (read-n i64) { }

; build-in (ForwardFunc: net-set-recv-timeout)
; net-set-recv-timeout: 設定 socket 接收逾時
; 返回 0=成功, -1=錯誤
; net-set-recv-timeout = (fd fd, timeout-ms i64) (ok i64) { }

; socket 類型（UDP）
SOCK-DGRAM = 2

; SO_RCVTIMEO
SO-RCVTIMEO = 20

; udp-conn: UDP 連接
; fd: socket 檔案描述符（-1=未開啟）
; host: 目標主機 IP
; port: 目標埠號
udp-conn {
    fd fd
    host str
    port i64
}

; open: 建立 UDP socket
; 返回 ok=true=成功
udp-conn.open = () (ok bool) {
    ok = false
    .fd = net-udp-open()
    .fd < 0 -> return
    ok = true
}

; set-timeout: 設定接收逾時
; timeout-ms i64: 逾時毫秒數
; 返回 ok=true=成功
udp-conn.set-timeout = (timeout-ms i64) (ok bool) {
    ok = false
    .fd < 0 -> return
    ret = net-set-recv-timeout(.fd, timeout-ms)
    ret == 0 -> ok = true
}

; send: 發送 UDP 資料到 .host:.port
; data str: 要發送的資料
; 返回 written=實際發送位元組數（-1=錯誤）
udp-conn.send = (data str) (written i64) {
    written = -1
    .fd < 0 -> return
    written = net-udp-sendto(.fd, data, data.len, .host, .port)
}

; send-bytes: 發送 UDP 位元組陣列到 .host:.port
; data []byte: 要發送的資料
; 返回 written=實際發送位元組數（-1=錯誤）
udp-conn.send-bytes = (data []byte) (written i64) {
    written = -1
    .fd < 0 -> return
    written = net-udp-sendto(.fd, data, data.len, .host, .port)
}

; recv: 接收 UDP 資料到緩衝區
; buf str: 接收緩衝區
; n i64: 最多接收的位元組數
; 返回 read-n=實際接收位元組數（-1=錯誤, 0=逾時）
udp-conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    .fd < 0 -> return
    read-n = net-udp-recvfrom(.fd, buf, n)
}

; recv-bytes: 接收 UDP 資料到位元組陣列
; buf []byte: 接收緩衝區
; n i64: 最多接收的位元組數
; 返回 read-n=實際接收位元組數（-1=錯誤, 0=逾時）
udp-conn.recv-bytes = (buf []byte, n i64) (read-n i64) {
    read-n = -1
    .fd < 0 -> return
    read-n = net-udp-recvfrom(.fd, buf, n)
}

; close: 關閉 UDP socket
udp-conn.close = () {
    .fd >= 0 -> {
        fs.close(.fd)
        .fd = -1
    }
}

; fd-of: 取得 socket 檔案描述符
; 返回 fd
udp-conn.fd-of = () (fd fd) {
    fd = .fd
}

; ═══════════════════════════════════════════════
; UDP 便捷函數
; ═══════════════════════════════════════════════

; udp-dial-to: 建立 UDP 連接並設定目標位址
; host str: 目標 IP 地址
; port i64: 目標埠號
; 返回 c ?udp-conn: ok=連接, nil=失敗
udp-dial-to = (host str, port i64) (c ?udp-conn) {
    c = nil
    uc = udp-conn{}
    ok = false
    ok = uc.open()
    ok == false -> return
    uc.host = host
    uc.port = port
    c = uc
}

; ═══════════════════════════════════════════════
; 超時/截止時間支援
; ═══════════════════════════════════════════════

; conn.set-recv-timeout: 設定接收逾時
; timeout-ms i64: 逾時毫秒數（0=阻塞, >0=逾時）
; 返回 ok bool: true=成功
conn.set-recv-timeout = (timeout-ms i64) (ok bool) {
    ok = false
    .fd < 0 -> return
    ret = net-set-recv-timeout(.fd, timeout-ms)
    ret == 0 -> ok = true
}

; conn.set-timeout: 設定接收逾時（別名，語義同 set-recv-timeout）
; timeout-ms i64: 逾時毫秒數
; 返回 ok bool: true=成功
conn.set-timeout = (timeout-ms i64) (ok bool) {
    ok = .set-recv-timeout(timeout-ms)
}

; conn.recv-with-timeout: 帶逾時的接收
; buf str: 接收緩衝區
; n i64: 最多接收的位元組數
; timeout-ms i64: 逾時毫秒數
; 返回 read-n i64: 實際接收位元組數（-1=錯誤, 0=逾時或連接關閉）
conn.recv-with-timeout = (buf str, n i64, timeout-ms i64) (read-n i64) {
    read-n = -1
    .fd < 0 -> return
    ret = net-set-recv-timeout(.fd, timeout-ms)
    ret != 0 -> return
    read-n = net-recv(.fd, buf, n)

    ; 恢復為阻塞模式
    net-set-recv-timeout(.fd, 0)
}

; conn.send-with-timeout: 帶逾時的發送（目前直接發送，無獨立 send timeout）
; data str: 要發送的資料
; timeout-ms i64: 逾時毫秒數（目前忽略，僅設置 recv timeout 作為參考）
; 返回 written i64: 實際發送位元組數（-1=錯誤）
conn.send-with-timeout = (data str, timeout-ms i64) (written i64) {
    written = -1
    .fd < 0 -> return

    ; 設定 recv 逾時（send 逾時在底層共享）
    net-set-recv-timeout(.fd, timeout-ms)
    written = net-send(.fd, data, data.len)
    net-set-recv-timeout(.fd, 0)
}

; listener.set-timeout: 設定 accept 逾時
; timeout-ms i64: 逾時毫秒數
; 返回 ok bool: true=成功
listener.set-timeout = (timeout-ms i64) (ok bool) {
    ok = false
    .fd < 0 -> return
    ret = net-set-recv-timeout(.fd, timeout-ms)
    ret == 0 -> ok = true
}

; listener.accept-with-timeout: 帶逾時的 accept
; timeout-ms i64: 逾時毫秒數
; 返回 c ?conn: ok=連接, nil=逾時或失敗
listener.accept-with-timeout = (timeout-ms i64) (c ?conn) {
    c = nil
    .fd < 0 -> return
    ret = net-set-recv-timeout(.fd, timeout-ms)
    ret != 0 -> return
    fd = net-accept(.fd)
    net-set-recv-timeout(.fd, 0)
    fd < 0 -> return
    c = conn{
        fd: fd
    }
}

; ═══════════════════════════════════════════════
; 便捷撥號函數（帶逾時）
; ═══════════════════════════════════════════════

; dial-timeout: 帶連接逾時的撥號
; host str: 目標主機
; port i64: 目標埠號
; timeout-ms i64: 逾時毫秒數（目前用於連接後的 recv 逾時設定）
; 返回 c ?conn: ok=連接, nil=失敗
dial-timeout = (host str, port i64, timeout-ms i64) (c ?conn) {
    c = nil
    fd = net-dial(host, port)
    fd < 0 -> return
    net-set-recv-timeout(fd, timeout-ms)
    cn = conn{
        fd: fd
    }
    c = cn
}

; ═══════════════════════════════════════════════
; 加密連接封裝（AES-256-GCM）
; ═══════════════════════════════════════════════

; enc-conn: 加密 TCP 連接封裝
; 底層使用 conn 進行 TCP 通訊，使用 AES-256-GCM 進行端對端加密。
; 每條訊息格式: [4-byte length][12-byte IV][N-byte ciphertext+tag]
; length 欄位為 IV + ciphertext + tag 的總長度（大端序）。
;
; underlying conn: 底層 TCP 連接
; key [32]byte: AES-256 金鑰
; send-seq i64: 發送序號（用於生成 IV）
; recv-seed i64: 接收序號（用於驗證 IV 唯一性）
; rand-seed i64: 隨機種子（用於生成 IV）
enc-conn {
    underlying conn
    key [32]byte
    send-seq i64
    recv-seq i64
    rand-seed i64
}

; enc-conn.init: 初始化加密連接
; c conn: 底層 TCP 連接
; key [32]byte: AES-256 金鑰
enc-conn.init = (c conn, key [32]byte) {
    .underlying = c
    .key = key
    .send-seq = 0
    .recv-seq = 0
    .rand-seed = 123456789
}

; enc-conn.gen-iv: 生成下一個 IV（nonce）
; 返回 iv [12]byte: 12 位元組 IV
enc-conn.gen-iv = () (iv [12]byte) {
    .send-seq = .send-seq + 1
    seq = .send-seq

    ; IV = seq (4 bytes) || random (8 bytes)
    iv[0] = (seq >> 24) & 255
    iv[1] = (seq >> 16) & 255
    iv[2] = (seq >> 8) & 255
    iv[3] = seq & 255

    ; 用 rand 生成剩餘 8 bytes
    i <- [4..12): {
        s, r = rand.rand(.rand-seed)
        .rand-seed = s
        iv[i] = r & 255
    }
}

; enc-conn.send-encrypted: 加密並發送資料
; data str: 明文資料
; 返回 ok bool: true=成功
enc-conn.send-encrypted = (data str) (ok bool) {
    ok = false
    .underlying.fd < 0 -> return

    ; 生成 IV
    iv [12]byte = .gen-iv()

    ; 加密
    plain []byte = data.to-bytes()
    aad []byte
    sealed []byte = aes-256-gcm.aes-256-gcm-seal(.key, iv, aad, plain)
    sealed-n = sealed.len

    ; 封包格式: [4-byte length][12-byte IV][sealed]
    ; length = 12 + sealed-n
    payload-len = 12 + sealed-n
    packet []byte
    packet[0] = (payload-len >> 24) & 255
    packet[1] = (payload-len >> 16) & 255
    packet[2] = (payload-len >> 8) & 255
    packet[3] = payload-len & 255

    ; 複製 IV
    i <- [0..12): {
        packet[4 + i] = iv[i]
    }

    ; 複製密文
    i <- [0..sealed-n): {
        packet[16 + i] = sealed[i]
    }
    packet-str = packet.to-str()
    packet-total = 4 + payload-len
    written = net-send(.underlying.fd, packet-str, packet-total)
    written == packet-total -> ok = true
}

; enc-conn.recv-encrypted: 接收並解密資料
; 返回 data ?str: ok=解密後明文, nil=失敗
enc-conn.recv-encrypted = () (data ?str) {
    data = nil
    .underlying.fd < 0 -> return

    ; 讀取 4-byte length
    len-buf str = with-len(4)
    n = net-recv(.underlying.fd, len-buf, 4)
    n != 4 -> return
    payload-len = ((len-buf[0]) << 24) | ((len-buf[1]) << 16) | ((len-buf[2]) << 8) | (len-buf[3])
    payload-len < 12 || payload-len > 65536 -> return

    ; 讀取 payload (IV + sealed)
    payload-buf str = with-len(payload-len)
    n = net-recv(.underlying.fd, payload-buf, payload-len)
    n != payload-len -> return

    ; 提取 IV
    iv [12]byte
    i <- [0..12): {
        iv[i] = payload-buf[i]
    }

    ; 提取密文
    sealed-n = payload-len - 12
    sealed []byte
    i <- [0..sealed-n): {
        sealed[i] = payload-buf[12 + i]
    }

    ; 解密
    aad []byte
    opened []byte = aes-256-gcm.aes-256-gcm-open(.key, iv, aad, sealed)
    opened.len == 0 -> {
        data = err('decryption failed')
        return
    }
    data = opened.to-str()
}

; enc-conn.close: 關閉加密連接（同時關閉底層 TCP 連接）
enc-conn.close = () {
    .underlying.close()
}

; enc-dial: 建立加密 TCP 連接
; host str: 目標主機
; port i64: 目標埠號
; key [32]byte: AES-256 金鑰
; 返回 ec ?enc-conn: ok=加密連接, nil=失敗
enc-dial = (host str, port i64, key [32]byte) (ec ?enc-conn) {
    ec = nil
    c ?conn = dial-to(host, port)
    c: {
        nil -> return
        err -> return
        ok -> {
            e enc-conn
            e.init(key)
            ec = e
        }
    }
}

; enc-accept: 在已接受的 TCP 連接上建立加密通道
; c conn: 已接受的 TCP 連接
; key [32]byte: AES-256 金鑰
; 返回 ec enc-conn: 加密連接
enc-accept = (c conn, key [32]byte) (ec enc-conn) {
    ec.init(c, key)
}

; ═══════════════════════════════════════════════
; ICMP Ping（原生 ping 實現）
; ═══════════════════════════════════════════════
;
; 使用 net-icmp-open 建立 ICMP socket，在純 Nolang 中實現 ICMP Echo 協議。
; macOS 使用 SOCK_DGRAM（非特權），Linux 使用 SOCK_RAW（需要 root 或 CAP_NET_RAW）。
;
; 用法：
;   ; 單次 ping
;   r ?i64 = ping('127.0.0.1')
;   r: {
;       nil -> print('ping failed')
;       -> print('rtt: ' + it.to-str() + ' us')
;   }
;
;   ; 多次 ping
;   icmp-conn.ping-host('8.8.8.8', 4)

; build-in (ForwardFunc: net-icmp-open)
; net-icmp-open: 建立 ICMP socket
; 返回 fd fd（-1=失敗）
; net-icmp-open = () (fd fd) { }

; ICMP 常量
ICMP-ECHO-REQUEST = 8
ICMP-ECHO-REPLY = 0
ICMP-HEADER-SIZE = 8
ICMP-PAYLOAD-SIZE = 56
ICMP-PACKET-SIZE = 64
PING-RECV-BUF-SIZE = 128

; icmp-conn: ICMP ping 連接
; fd: socket 檔案描述符（-1=未開啟）
; ident: ICMP 標識符（大端序）
; seq: 當前序號
icmp-conn {
    fd fd
    ident i64
    seq i64
}

; open: 建立 ICMP socket
; 返回 ok=true=成功
icmp-conn.open = () (ok bool) {
    ok = false
    .fd = net-icmp-open()
    .fd < 0 -> return
    .ident = os.get-pid() & 65535
    .seq = 0
    ok = true
}

; close: 關閉 ICMP socket
icmp-conn.close = () {
    .fd >= 0 -> {
        fs.close(.fd)
        .fd = -1
    }
}

; build-echo: 建構 ICMP Echo Request 封包
; pkt []byte: 輸出封包緩衝區（至少 64 位元組）
; seq i64: 序號
icmp-conn.build-echo = (pkt []byte, seq i64) {
    ; Type = 8 (Echo Request)
    pkt[0] = ICMP-ECHO-REQUEST
    ; Code = 0
    pkt[1] = 0
    ; Checksum = 0 (先填 0，之後計算)
    pkt[2] = 0
    pkt[3] = 0
    ; Identifier (big-endian)
    pkt[4] = (.ident >> 8) & 255
    pkt[5] = .ident & 255
    ; Sequence (big-endian)
    pkt[6] = (seq >> 8) & 255
    pkt[7] = seq & 255
    ; Payload: 填入序號作為資料（用於驗證回應）
    i <- [0..ICMP-PAYLOAD-SIZE): {
        pkt[ICMP-HEADER-SIZE + i] = (seq + i) & 255
    }
    ; 計算並填入 checksum
    cksum = icmp-checksum(pkt, ICMP-PACKET-SIZE)
    pkt[2] = (cksum >> 8) & 255
    pkt[3] = cksum & 255
}

; icmp-checksum: 計算 ICMP 校驗和（16 位元一補數和）
; data []byte: 封包資料
; len i64: 封包長度
; 返回 checksum i64（16 位元）
icmp-checksum = (data []byte, len i64) (checksum i64) {
    checksum = 0
    i = 0
    {
        i + 1 < len -> {
            ; 16-bit word: data[i] << 8 | data[i+1]
            w = ((data[i]) << 8) | (data[i + 1])
            checksum = checksum + w
            ; 處理進位
            checksum > 65535 -> {
                checksum = (checksum & 65535) + (checksum >> 16)
            }
        }
        i = i + 2
    } (i < len)
    ; 奇數長度：補零處理最後一個位元組
    len & 1 == 1 -> {
        checksum = checksum + ((data[len - 1]) << 8)
        checksum > 65535 -> {
            checksum = (checksum & 65535) + (checksum >> 16)
        }
    }
    checksum = (checksum & 65535) + (checksum >> 16)
    checksum = (~checksum) & 65535
}

; ping-once: 發送一次 ICMP Echo Request 並等待回應
; host str: 目標 IP 地址
; timeout-ms i64: 逾時毫秒數
; 返回 rtt ?i64: ok=往返延遲（微秒）, nil=失敗
icmp-conn.ping-once = (host str, timeout-ms i64) (rtt ?i64) {
    rtt = nil
    .fd < 0 -> return

    ; 設定接收逾時
    net-set-recv-timeout(.fd, timeout-ms)

    ; 建構 ICMP Echo Request
    pkt []byte = with-len(ICMP-PACKET-SIZE)
    .seq = .seq + 1
    .build-echo(pkt, .seq)

    ; 記錄發送時間
    t-start = os.now-us()

    ; 發送 ICMP Echo Request（port=0）
    written = net-udp-sendto(.fd, pkt, ICMP-PACKET-SIZE, host, 0)
    written < 0 -> return

    ; 接收回應
    recv-buf []byte = with-len(PING-RECV-BUF-SIZE)
    n = net-udp-recvfrom(.fd, recv-buf, PING-RECV-BUF-SIZE)
    n <= 0 -> return

    ; 記錄接收時間
    t-end = os.now-us()

    ; 判斷是否有 IP 標頭（Linux SOCK_RAW 回傳 IP+ICMP，macOS SOCK_DGRAM 只回傳 ICMP）
    offset = 0
    {
        n >= 20 -> {
            ; 檢查 IP 版本 (byte 0 >> 4 == 4 表示 IPv4)
            ver = (recv-buf[0] >> 4) & 15
            ver == 4 -> {
                ; IHL = (byte 0 & 0x0F) * 4
                ihl = (recv-buf[0] & 15) * 4
                offset = ihl
            }
        }
    }

    ; 檢查 ICMP 回應長度
    n - offset < ICMP-HEADER-SIZE -> return

    ; 驗證 ICMP Type = 0 (Echo Reply)
    icmp-type = recv-buf[offset]
    icmp-type != ICMP-ECHO-REPLY -> return

    ; 驗證 Identifier
    recv-ident = ((recv-buf[offset + 4]) << 8) | (recv-buf[offset + 5])
    recv-ident != .ident -> return

    ; 驗證 Sequence（只比較低 16 位）
    recv-seq = ((recv-buf[offset + 6]) << 8) | (recv-buf[offset + 7])
    recv-seq != (.seq & 65535) -> return

    ; 計算 RTT
    rtt = t-end - t-start
}

; ping-host: 對指定主機發送多次 ping
; host str: 目標 IP 地址
; count i64: ping 次數
; timeout-ms i64: 每次逾時毫秒數（預設 1000）
icmp-conn.ping-host = (host str, count i64, timeout-ms i64) {
    i <- [0..count): {
        r ?i64 = .ping-once(host, timeout-ms)
        r: {
            nil -> print(host + ': ping timeout (seq=' + (.seq & 65535).to-str() + ')')
            -> print(host + ': seq=' + (.seq & 65535).to-str() + ' rtt=' + it.to-str() + ' us')
        }
        ; 間隔 1 秒
        count > 1 -> os.sleep(1)
    }
    .close()
}

; ═══════════════════════════════════════════════
; Ping 便捷函數
; ═══════════════════════════════════════════════

; ping: 單次 ping 便捷函數
; host str: 目標 IP 地址
; 返回 rtt ?i64: ok=往返延遲（微秒）, nil=失敗
ping = (host str) (rtt ?i64) {
    rtt = nil
    ic icmp-conn
    ok = ic.open()
    ok == false -> return
    rtt = ic.ping-once(host, 1000)
    ic.close()
}

; ping-count: 多次 ping 便捷函數
; host str: 目標 IP 地址
; count i64: ping 次數
ping-count = (host str, count i64) {
    ic icmp-conn
    ok = ic.open()
    ok == false -> {
        print('ping: cannot create ICMP socket (requires root on Linux)')
        return
    }
    ic.ping-host(host, count, 1000)
}

; ═══════════════════════════════════════════════
; 網路介面/路由/ARP 查詢（notools 擴展：ifconfig/route/arp 命令使用）
; ═══════════════════════════════════════════════

; if-info: 網路介面資訊
; name: 介面名稱（如 eth0, lo）
; rx-bytes: 接收位元組數
; tx-bytes: 發送位元組數
; rx-packets: 接收封包數
; tx-packets: 發送封包數
if-info {
    name str
    rx-bytes i64
    tx-bytes i64
    rx-packets i64
    tx-packets i64
}

; route-info: 路由表項
; destination: 目的地網路（如 00000000=預設路由）
; mask: 子網遮罩
; gateway: 閘道
; flags: 旗標
; iface: 介面名稱
route-info {
    destination str
    mask str
    gateway str
    flags str
    iface str
}

; arp-info: ARP 表項
; ip: IP 地址
; hw-type: 硬體類型
; flags: 旗標
; mac: MAC 地址
; iface: 介面名稱
arp-info {
    ip str
    hw-type str
    flags str
    mac str
    iface str
}

; ifconfig-list: 列出所有網路介面資訊
; 返回 if-info 列表
; Linux: 解析 /proc/net/dev
; macOS/Windows: 暫時返回空列表（需 getifaddrs 或 GetIfTable 系統 API）

#{linux-amd64, linux-arm64}
ifconfig-list = () (ifs []if-info) {
    content = fs.read-file('/proc/net/dev')
    content.len == 0 -> return

    ; /proc/net/dev 格式（前兩行為標題，第三行起為資料）：
    ;   eth0: 12345    678  ...  98765    432  ...
    ; 冒號前為介面名，冒號後為空白分隔的 16 個統計欄位
    lines = content.split('\n')
    i <- [2..lines.len): {
        line = lines[i]
        line.len == 0 -> *
        colon-pos = line.index(':')
        colon-pos < 0 -> *
        name = line.slice(0, colon-pos).trim()
        stats-str = line.slice(colon-pos + 1, line.len).trim()
        fields = split-ws(stats-str)
        fields.len >= 10 -> {
            info = if-info{}
            info.name = name
            v0 ?i64 = fields[0].to-i64()
            v0: {
                ok -> info.rx-bytes = it
                nil -> *
                err -> *
            }
            v1 ?i64 = fields[1].to-i64()
            v1: {
                ok -> info.rx-packets = it
                nil -> *
                err -> *
            }
            v8 ?i64 = fields[8].to-i64()
            v8: {
                ok -> info.tx-bytes = it
                nil -> *
                err -> *
            }
            v9 ?i64 = fields[9].to-i64()
            v9: {
                ok -> info.tx-packets = it
                nil -> *
                err -> *
            }
            ifs.push(info)
        }
    }
}

#{mac-amd64, mac-arm64}
ifconfig-list = () (ifs []if-info) {
    ; macOS 暫時返回空列表（需 getifaddrs(3) 系統 API）
}

#{win-amd64, win-arm64}
ifconfig-list = () (ifs []if-info) {
    ; Windows 暫時返回空列表（需 GetIfTable 系統 API）
}

; route-list: 列出核心路由表
; 返回 route-info 列表
; Linux: 解析 /proc/net/route
; macOS/Windows: 暫時返回空列表（需 PF_ROUTE socket）

#{linux-amd64, linux-arm64}
route-list = () (routes []route-info) {
    content = fs.read-file('/proc/net/route')
    content.len == 0 -> return

    ; /proc/net/route 格式（首行為標題）：
    ; Iface Destination Gateway Flags RefCnt Use Metric Mask MTU Window IRTT
    lines = content.split('\n')
    i <- [1..lines.len): {
        line = lines[i]
        line.len == 0 -> *
        fields = split-ws(line)
        fields.len >= 11 -> {
            r = route-info{}
            r.iface = fields[0]
            r.destination = fields[1]
            r.gateway = fields[2]
            r.flags = fields[3]
            r.mask = fields[7]
            routes.push(r)
        }
    }
}

#{mac-amd64, mac-arm64}
route-list = () (routes []route-info) {
    ; macOS 暫時返回空列表（需 PF_ROUTE socket 或 sysctl CTL_NET/NET_RT_DUMP）
}

#{win-amd64, win-arm64}
route-list = () (routes []route-info) {
    ; Windows 暫時返回空列表（需 GetIpForwardTable 系統 API）
}

; arp-list: 列出 ARP 表
; 返回 arp-info 列表
; Linux: 解析 /proc/net/arp
; macOS/Windows: 暫時返回空列表（需 sysctl net.inet.arp 或 GetIpNetTable）

#{linux-amd64, linux-arm64}
arp-list = () (arps []arp-info) {
    content = fs.read-file('/proc/net/arp')
    content.len == 0 -> return

    ; /proc/net/arp 格式（首行為標題）：
    ; IP address   HW type  Flags   HW address  Mask  Device
    lines = content.split('\n')
    i <- [1..lines.len): {
        line = lines[i]
        line.len == 0 -> *
        fields = split-ws(line)
        fields.len >= 6 -> {
            a = arp-info{}
            a.ip = fields[0]
            a.hw-type = fields[1]
            a.flags = fields[2]
            a.mac = fields[3]
            a.iface = fields[5]
            arps.push(a)
        }
    }
}

#{mac-amd64, mac-arm64}
arp-list = () (arps []arp-info) {
    ; macOS 暫時返回空列表（需 sysctl net.inet.arp 或 ARP ioctls）
}

#{win-amd64, win-arm64}
arp-list = () (arps []arp-info) {
    ; Windows 暫時返回空列表（需 GetIpNetTable 系統 API）
}

; split-ws: 按空白字元（空格/定位字元）分割字串，跳過連續空白
; s str: 輸入字串
; 返回 out []str: 非空欄位列表
split-ws = (s str) (out []str) {
    n = s.len
    i = 0
    {
        ; 跳過前導空白
        {
            i < n -> {
                c = s[i]
                c == 32 || c == 9 -> i = i + 1
                -> *
            }
        } (i < n && (s[i] == 32 || s[i] == 9))
        i >= n -> *
        ; 找到欄位結束
        start = i
        {
            i < n -> {
                c = s[i]
                c == 32 || c == 9 -> *
                i = i + 1
            }
        } (i < n && s[i] != 32 && s[i] != 9)
        out.push(s.slice(start, i))
    } (i < n)
}
