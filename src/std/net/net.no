// net — 網路操作
//
// 提供 TCP 網路編程能力，包括服務端監聽、客戶端連接、資料收發等。
// 底層使用 POSIX socket API（socket/bind/listen/accept/connect/send/recv）實作。
// 支援 AES-256-GCM 加密通道，為明文 TCP 連接提供端對端加密。
//
// 用法：
//   // TCP 服務端
//   l = net-listen-on('127.0.0.1', 8080)         // 返回 ?listener
//   l: {
//       nil -> return
//       -> c = l.accept()                      // 返回 ?conn
//   }
//   n = c.recv(buf, 1024)
//   n = c.send('hello')
//   c.close()
//   l.close()
//
//   // TCP 客戶端
//   c = net-dial-to('127.0.0.1', 8080)           // 返回 ?conn
//   n = c.send('hello')
//   n = c.recv(buf, 1024)
//   c.close()
//
//   // 加密通道
//   key [32]byte = [...]  // 共享金鑰
//   ec = enc-conn{}
//   ec.init(c, key)
//   ec.send-encrypted('sensitive data')
//   msg = ec.recv-encrypted()  // 返回 ?str

# std/hash/aes-256-gcm
# std/hash/rand

// ═══════════════════════════════════════════════
// 內建函數（底層實作）
// ═══════════════════════════════════════════════

// build-in (ForwardFunc: net-listen)
// net-listen: 建立 TCP 監聽 socket
// 執行 socket + setsockopt(SO_REUSEADDR) + bind + listen
// 返回 fd（-1=失敗）
// net-listen = (host str, port i64) (fd i64) { }

// build-in (ForwardFunc: net-dial)
// net-dial: 建立 TCP 客戶端連接
// 執行 socket + connect
// 返回 fd（-1=失敗）
// net-dial = (host str, port i64) (fd i64) { }

// build-in (ForwardFunc: net-accept)
// net-accept: 接受 TCP 連接
// 返回客戶端 fd（-1=失敗）
// net-accept = (listen-fd i64) (fd i64) { }

// build-in (ForwardFunc: net-send)
// net-send: 發送資料
// 返回實際發送位元組數（-1=錯誤）
// net-send = (fd i64, data str, n i64) (written i64) { }

// build-in (ForwardFunc: net-recv)
// net-recv: 接收資料
// 返回實際接收位元組數（-1=錯誤, 0=連接關閉）
// net-recv = (fd i64, buf str, n i64) (read-n i64) { }

// build-in (ForwardFunc: close)
// close: 關閉檔案描述符（來自 fs 模組）
// close = (fd i64) (ok i64) { }

// ═══════════════════════════════════════════════
// 網路常量
// ═══════════════════════════════════════════════

// 地址族
AF-INET = 2

// socket 類型
SOCK-STREAM = 1

// setsockopt 層級
SOL-SOCKET = 65535

// socket 選項
SO-REUSEADDR = 4

// 監聽佇列長度
BACKLOG = 128

// 預設緩衝區大小
NET-BUF-SIZE = 4096

// ═══════════════════════════════════════════════
// listener 結構體
// ═══════════════════════════════════════════════

// listener: TCP 監聽器
// fd: 監聽 socket 的檔案描述符（-1=未開啟）
listener {
    fd i64
}

// listen: 開始監聽
// host: 綁定的 IP 地址（如 '127.0.0.1'）
// port: 監聽埠號
// 返回 ok=true=成功
listener.listen = (host str, port i64) (ok bool) {
    ok = false
    .fd = -1
    fd = net-listen(host, port)
    if fd < 0 {
        return
    }
    .fd = fd
    ok = true
}

// accept: 接受新的 TCP 連接
// 返回 c ?conn: ok=連接結構體, nil=失敗
listener.accept = () (c ?conn) {
    c = nil
    if .fd < 0 {
        return
    }
    fd = net-accept(.fd)
    if fd < 0 {
        return
    }
    c = conn{
        fd: fd
    }
}

// close: 關閉監聽 socket
listener.close = () {
    if .fd >= 0 {
        close(.fd)
        .fd = -1
    }
}

// fd-of: 取得監聽 socket 的檔案描述符
listener.fd-of = () (fd i64) {
    fd = .fd
}

// ═══════════════════════════════════════════════
// conn 結構體
// ═══════════════════════════════════════════════

// conn: TCP 連接
// fd: 連接 socket 的檔案描述符（-1=未連接）
conn {
    fd i64
}

// dial: 建立到服務端的 TCP 連接
// host: 目標 IP 地址（如 '127.0.0.1'）
// port: 目標埠號
// 返回 ok=true=成功
conn.dial = (host str, port i64) (ok bool) {
    ok = false
    .fd = -1
    fd = net-dial(host, port)
    if fd < 0 {
        return
    }
    .fd = fd
    ok = true
}

// send: 發送字串資料
// data: 要發送的字串
// 返回 written=實際發送位元組數（-1=錯誤）
conn.send = (data str) (written i64) {
    written = -1
    if .fd < 0 {
        return
    }
    written = net-send(.fd, data, data.len)
}

// recv: 接收資料到緩衝區
// buf: 接收緩衝區（str）
// n: 最多接收的位元組數
// 返回 read-n=實際接收位元組數（-1=錯誤, 0=連接關閉）
conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    if .fd < 0 {
        return
    }
    read-n = net-recv(.fd, buf, n)
}

// recv-line: 接收一行資料（最多 NET-BUF-SIZE 位元組）
// 返回 line ?str: ok=接收內容, nil=失敗或連接關閉
conn.recv-line = () (line ?str) {
    line = nil
    if .fd < 0 {
        return
    }
    buf str = ' '.repeat(NET-BUF-SIZE)
    n = net-recv(.fd, buf, NET-BUF-SIZE)
    if n > 0 {
        line = buf
    }
}

// recv-all: 接收全部資料直到連接關閉
// 返回 content=接收的內容, total=總位元組數
conn.recv-all = () (content str, total i64) {
    total = 0
    if .fd < 0 {
        return
    }
    ! {
        chunk-n = net-recv(.fd, content, NET-BUF-SIZE)
        if chunk-n <= 0 {
            *
        }
        total = total + chunk-n
    }
}

// close: 關閉連接
conn.close = () {
    if .fd >= 0 {
        close(.fd)
        .fd = -1
    }
}

// fd-of: 取得連接 socket 的檔案描述符
conn.fd-of = () (fd i64) {
    fd = .fd
}

// ═══════════════════════════════════════════════
// 便捷函數
// ═══════════════════════════════════════════════

// net-listen-on: 建立監聽器並開始監聽
// 返回 l ?listener: ok=監聽器, nil=失敗
net-listen-on = (host str, port i64) (l ?listener) {
    l = nil
    lst = listener{}
    ok = false
    ok = lst.listen(host, port)
    if ok {
        l = lst
    }
}

// net-dial-to: 建立連接並撥號
// 返回 c ?conn: ok=連接, nil=失敗
net-dial-to = (host str, port i64) (c ?conn) {
    c = nil
    cn = conn{}
    ok = false
    ok = cn.dial(host, port)
    if ok {
        c = cn
    }
}

// ═══════════════════════════════════════════════
// UDP 結構體與方法
// ═══════════════════════════════════════════════

// build-in (ForwardFunc: net-udp-open)
// net-udp-open: 建立 UDP socket
// 返回 fd（-1=失敗）
// net-udp-open = () (fd i64) { }

// build-in (ForwardFunc: net-udp-sendto)
// net-udp-sendto: 發送 UDP 資料到指定位址
// 返回實際發送位元組數（-1=錯誤）
// net-udp-sendto = (fd i64, data str, n i64, host str, port i64) (written i64) { }

// build-in (ForwardFunc: net-udp-recvfrom)
// net-udp-recvfrom: 接收 UDP 資料
// 返回實際接收位元組數（-1=錯誤, 0=逾時）
// net-udp-recvfrom = (fd i64, buf str, n i64) (read-n i64) { }

// build-in (ForwardFunc: net-set-recv-timeout)
// net-set-recv-timeout: 設定 socket 接收逾時
// 返回 0=成功, -1=錯誤
// net-set-recv-timeout = (fd i64, timeout-ms i64) (ok i64) { }

// socket 類型（UDP）
SOCK-DGRAM = 2

// SO_RCVTIMEO
SO-RCVTIMEO = 20

// udp-conn: UDP 連接
// fd: socket 檔案描述符（-1=未開啟）
// host: 目標主機 IP
// port: 目標埠號
udp-conn {
    fd i64
    host str
    port i64
}

// open: 建立 UDP socket
// 返回 ok=true=成功
udp-conn.open = () (ok bool) {
    ok = false
    .fd = net-udp-open()
    if .fd < 0 {
        return
    }
    ok = true
}

// set-timeout: 設定接收逾時
// timeout-ms i64: 逾時毫秒數
// 返回 ok=true=成功
udp-conn.set-timeout = (timeout-ms i64) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    ret = net-set-recv-timeout(.fd, timeout-ms)
    if ret == 0 {
        ok = true
    }
}

// send: 發送 UDP 資料到 .host:.port
// data str: 要發送的資料
// 返回 written=實際發送位元組數（-1=錯誤）
udp-conn.send = (data str) (written i64) {
    written = -1
    if .fd < 0 {
        return
    }
    written = net-udp-sendto(.fd, data, data.len, .host, .port)
}

// send-bytes: 發送 UDP 位元組陣列到 .host:.port
// data []byte: 要發送的資料
// 返回 written=實際發送位元組數（-1=錯誤）
udp-conn.send-bytes = (data []byte) (written i64) {
    written = -1
    if .fd < 0 {
        return
    }
    written = net-udp-sendto(.fd, data, data.len, .host, .port)
}

// recv: 接收 UDP 資料到緩衝區
// buf str: 接收緩衝區
// n i64: 最多接收的位元組數
// 返回 read-n=實際接收位元組數（-1=錯誤, 0=逾時）
udp-conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    if .fd < 0 {
        return
    }
    read-n = net-udp-recvfrom(.fd, buf, n)
}

// recv-bytes: 接收 UDP 資料到位元組陣列
// buf []byte: 接收緩衝區
// n i64: 最多接收的位元組數
// 返回 read-n=實際接收位元組數（-1=錯誤, 0=逾時）
udp-conn.recv-bytes = (buf []byte, n i64) (read-n i64) {
    read-n = -1
    if .fd < 0 {
        return
    }
    read-n = net-udp-recvfrom(.fd, buf, n)
}

// close: 關閉 UDP socket
udp-conn.close = () {
    if .fd >= 0 {
        close(.fd)
        .fd = -1
    }
}

// fd-of: 取得 socket 檔案描述符
// 返回 fd
udp-conn.fd-of = () (fd i64) {
    fd = .fd
}

// ═══════════════════════════════════════════════
// UDP 便捷函數
// ═══════════════════════════════════════════════

// udp-dial-to: 建立 UDP 連接並設定目標位址
// host str: 目標 IP 地址
// port i64: 目標埠號
// 返回 c ?udp-conn: ok=連接, nil=失敗
udp-dial-to = (host str, port i64) (c ?udp-conn) {
    c = nil
    uc = udp-conn{}
    ok = false
    ok = uc.open()
    if ok == false {
        return
    }
    uc.host = host
    uc.port = port
    c = uc
}

// ═══════════════════════════════════════════════
// 超時/截止時間支援
// ═══════════════════════════════════════════════

// conn.set-recv-timeout: 設定接收逾時
// timeout-ms i64: 逾時毫秒數（0=阻塞, >0=逾時）
// 返回 ok bool: true=成功
conn.set-recv-timeout = (timeout-ms i64) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    ret = net-set-recv-timeout(.fd, timeout-ms)
    if ret == 0 {
        ok = true
    }
}

// conn.set-timeout: 設定接收逾時（別名，語義同 set-recv-timeout）
// timeout-ms i64: 逾時毫秒數
// 返回 ok bool: true=成功
conn.set-timeout = (timeout-ms i64) (ok bool) {
    ok = .set-recv-timeout(timeout-ms)
}

// conn.recv-with-timeout: 帶逾時的接收
// buf str: 接收緩衝區
// n i64: 最多接收的位元組數
// timeout-ms i64: 逾時毫秒數
// 返回 read-n i64: 實際接收位元組數（-1=錯誤, 0=逾時或連接關閉）
conn.recv-with-timeout = (buf str, n i64, timeout-ms i64) (read-n i64) {
    read-n = -1
    if .fd < 0 {
        return
    }
    ret = net-set-recv-timeout(.fd, timeout-ms)
    if ret != 0 {
        return
    }
    read-n = net-recv(.fd, buf, n)
    // 恢復為阻塞模式
    net-set-recv-timeout(.fd, 0)
}

// conn.send-with-timeout: 帶逾時的發送（目前直接發送，無獨立 send timeout）
// data str: 要發送的資料
// timeout-ms i64: 逾時毫秒數（目前忽略，僅設置 recv timeout 作為參考）
// 返回 written i64: 實際發送位元組數（-1=錯誤）
conn.send-with-timeout = (data str, timeout-ms i64) (written i64) {
    written = -1
    if .fd < 0 {
        return
    }
    // 設定 recv 逾時（send 逾時在底層共享）
    net-set-recv-timeout(.fd, timeout-ms)
    written = net-send(.fd, data, data.len)
    net-set-recv-timeout(.fd, 0)
}

// listener.set-timeout: 設定 accept 逾時
// timeout-ms i64: 逾時毫秒數
// 返回 ok bool: true=成功
listener.set-timeout = (timeout-ms i64) (ok bool) {
    ok = false
    if .fd < 0 {
        return
    }
    ret = net-set-recv-timeout(.fd, timeout-ms)
    if ret == 0 {
        ok = true
    }
}

// listener.accept-with-timeout: 帶逾時的 accept
// timeout-ms i64: 逾時毫秒數
// 返回 c ?conn: ok=連接, nil=逾時或失敗
listener.accept-with-timeout = (timeout-ms i64) (c ?conn) {
    c = nil
    if .fd < 0 {
        return
    }
    ret = net-set-recv-timeout(.fd, timeout-ms)
    if ret != 0 {
        return
    }
    fd = net-accept(.fd)
    net-set-recv-timeout(.fd, 0)
    if fd < 0 {
        return
    }
    c = conn{
        fd: fd
    }
}

// ═══════════════════════════════════════════════
// 便捷撥號函數（帶逾時）
// ═══════════════════════════════════════════════

// net-dial-timeout: 帶連接逾時的撥號
// host str: 目標主機
// port i64: 目標埠號
// timeout-ms i64: 逾時毫秒數（目前用於連接後的 recv 逾時設定）
// 返回 c ?conn: ok=連接, nil=失敗
net-dial-timeout = (host str, port i64, timeout-ms i64) (c ?conn) {
    c = nil
    fd = net-dial(host, port)
    if fd < 0 {
        return
    }
    net-set-recv-timeout(fd, timeout-ms)
    cn = conn{
        fd: fd
    }
    c = cn
}

// ═══════════════════════════════════════════════
// 加密連接封裝（AES-256-GCM）
// ═══════════════════════════════════════════════

// enc-conn: 加密 TCP 連接封裝
// 底層使用 conn 進行 TCP 通訊，使用 AES-256-GCM 進行端對端加密。
// 每條訊息格式: [4-byte length][12-byte IV][N-byte ciphertext+tag]
// length 欄位為 IV + ciphertext + tag 的總長度（大端序）。
//
// underlying conn: 底層 TCP 連接
// key [32]byte: AES-256 金鑰
// send-seq i64: 發送序號（用於生成 IV）
// recv-seed i64: 接收序號（用於驗證 IV 唯一性）
// rand-seed i64: 隨機種子（用於生成 IV）
enc-conn {
    underlying conn
    key [32]byte
    send-seq i64
    recv-seq i64
    rand-seed i64
}

// enc-conn.init: 初始化加密連接
// c conn: 底層 TCP 連接
// key [32]byte: AES-256 金鑰
enc-conn.init = (c conn, key [32]byte) {
    .underlying = c
    .key = key
    .send-seq = 0
    .recv-seq = 0
    .rand-seed = 123456789
}

// enc-conn.gen-iv: 生成下一個 IV（nonce）
// 返回 iv [12]byte: 12 位元組 IV
enc-conn.gen-iv = () (iv [12]byte) {
    .send-seq = .send-seq + 1
    seq = .send-seq
    // IV = seq (4 bytes) || random (8 bytes)
    iv[0] = (seq >> 24) & 255
    iv[1] = (seq >> 16) & 255
    iv[2] = (seq >> 8) & 255
    iv[3] = seq & 255
    // 用 rand 生成剩餘 8 bytes
    i = 4
    for i < 12 {
        r = rand(.rand-seed)
        iv[i] = r & 255
        i = i + 1
    }
}

// enc-conn.send-encrypted: 加密並發送資料
// data str: 明文資料
// 返回 ok bool: true=成功
enc-conn.send-encrypted = (data str) (ok bool) {
    ok = false
    if .underlying.fd < 0 {
        return
    }
    // 生成 IV
    iv [12]byte = .gen-iv()
    // 加密
    plain []byte = data.to-bytes()
    aad []byte
    sealed []byte = aes-256-gcm-seal(.key, iv, aad, plain)
    sealed-n = sealed.len
    // 封包格式: [4-byte length][12-byte IV][sealed]
    // length = 12 + sealed-n
    payload-len = 12 + sealed-n
    packet []byte
    packet[0] = (payload-len >> 24) & 255
    packet[1] = (payload-len >> 16) & 255
    packet[2] = (payload-len >> 8) & 255
    packet[3] = payload-len & 255
    // 複製 IV
    i = 0
    for i < 12 {
        packet[4 + i] = iv[i]
        i = i + 1
    }
    // 複製密文
    i = 0
    for i < sealed-n {
        packet[16 + i] = sealed[i]
        i = i + 1
    }
    packet-str = packet.to-str()
    packet-total = 4 + payload-len
    written = net-send(.underlying.fd, packet-str, packet-total)
    if written == packet-total {
        ok = true
    }
}

// enc-conn.recv-encrypted: 接收並解密資料
// 返回 data ?str: ok=解密後明文, nil=失敗
enc-conn.recv-encrypted = () (data ?str) {
    data = nil
    if .underlying.fd < 0 {
        return
    }
    // 讀取 4-byte length
    len-buf = ' '.repeat(4)
    n = net-recv(.underlying.fd, len-buf, 4)
    if n != 4 {
        return
    }
    payload-len = ((len-buf[0] & 255) << 24) | ((len-buf[1] & 255) << 16) | ((len-buf[2] & 255) << 8) | (len-buf[3] & 255)
    if payload-len < 12 || payload-len > 65536 {
        return
    }
    // 讀取 payload (IV + sealed)
    payload-buf = ' '.repeat(payload-len)
    n = net-recv(.underlying.fd, payload-buf, payload-len)
    if n != payload-len {
        return
    }
    // 提取 IV
    iv [12]byte
    i = 0
    for i < 12 {
        iv[i] = payload-buf[i]
        i = i + 1
    }
    // 提取密文
    sealed-n = payload-len - 12
    sealed []byte
    i = 0
    for i < sealed-n {
        sealed[i] = payload-buf[12 + i]
        i = i + 1
    }
    // 解密
    aad []byte
    opened []byte = aes-256-gcm-open(.key, iv, aad, sealed)
    if opened.len == 0 {
        data = err('decryption failed')
        return
    }
    data = opened.to-str()
}

// enc-conn.close: 關閉加密連接（同時關閉底層 TCP 連接）
enc-conn.close = () {
    .underlying.close()
}

// enc-dial: 建立加密 TCP 連接
// host str: 目標主機
// port i64: 目標埠號
// key [32]byte: AES-256 金鑰
// 返回 ec ?enc-conn: ok=加密連接, nil=失敗
enc-dial = (host str, port i64, key [32]byte) (ec ?enc-conn) {
    ec = nil
    c ?conn = net-dial-to(host, port)
    c: {
        nil -> return
        err -> return
        ok -> {
            e enc-conn
            e.init(it, key)
            ec = e
        }
    }
}

// enc-accept: 在已接受的 TCP 連接上建立加密通道
// c conn: 已接受的 TCP 連接
// key [32]byte: AES-256 金鑰
// 返回 ec enc-conn: 加密連接
enc-accept = (c conn, key [32]byte) (ec enc-conn) {
    ec.init(c, key)
}
