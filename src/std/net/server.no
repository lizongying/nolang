; server — HTTP/1.1 伺服器
;
; 提供簡易的 HTTP/1.1 伺服器，支援路由分發、請求解析、回應建構。
; 支援 GET、POST、PUT、DELETE、PATCH 方法，Keep-Alive 連接复用。
; 底層使用 net.no 的 listener/conn 結構體。
;
; 用法：
;   srv = http-server{}
;   ok = srv.listen('0.0.0.0', 8080)
;   ok -> {
;       ! {
;           req = srv.accept()           // 返回 ?http-server-conn
;           req: {
;               nil -> *
;               ->
;                   req.parse()
;                   req.method == 'GET' -> {
;                       req.write-text(200, 'Hello, World!')
;

;                   req.close()
;           }
;       }
;

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 伺服器接收緩衝區大小
HTTP-SRV-BUF-SIZE = 8192

; 單次接收大小
HTTP-SRV-RECV-SIZE = 4096

; 最大請求標頭數
HTTP-SRV-MAX-HEADERS = 32

; 最大請求體大小
HTTP-SRV-MAX-BODY = 1048576

; Keep-Alive 最大請求數
HTTP-SRV-MAX-KEEPALIVE = 100

; Keep-Alive 逾時（毫秒）
HTTP-SRV-KEEPALIVE-TIMEOUT = 5000

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; http-server: HTTP 伺服器
; fd: 監聽 socket fd（-1=未開啟）
; host: 綁定的 IP 地址
; port: 監聽埠號
http-server {
    fd fd
    host str
    port i64
}

; http-server-conn: 伺服器端客戶端連接
; fd: 客戶端 socket fd（-1=未連接）
; method: 請求方法（GET/POST/PUT/DELETE/PATCH）
; path: 請求路徑
; query: 查詢字串（不含 ?）
; version: HTTP 版本（如 HTTP/1.1）
; headers: 原始標頭字串（多行）
; header-names: 解析後的標頭名
; header-values: 解析後的標頭值
; header-count: 標頭數量
; body: 請求體
; remote-addr: 客戶端 IP 地址（未使用，保留）
; keep-alive: 是否保持連接
; recv-buf: 接收緩衝區
; recv-buf-len: 緩衝區中實際資料長度
http-server-conn {
    fd fd
    method str
    path str
    query str
    version str
    headers str
    header-names [32]str
    header-values [32]str
    header-count i64
    body str
    remote-addr str
    keep-alive bool
    recv-buf str
    recv-buf-len i64
}

; ═══════════════════════════════════════════════
; http-server 方法
; ═══════════════════════════════════════════════

; listen: 開始監聽
; host str: 綁定的 IP 地址（如 '0.0.0.0' 或 '127.0.0.1'）
; port i64: 監聽埠號
; 返回 ok bool: true=成功
http-server.listen = (host str, port i64) (ok bool) {
    ok = false
    .fd = -1
    .host = host
    .port = port
    fd = net-listen(host, port)
    fd < 0 -> return
    .fd = fd
    ok = true
}

; accept: 接受新的 HTTP 連接
; 返回 c ?http-server-conn: ok=連接, nil=失敗
http-server.accept = () (c ?http-server-conn) {
    c = nil
    .fd < 0 -> return
    client-fd = net-accept(.fd)
    client-fd < 0 -> return
    space = ' '
    buf = space.repeat(HTTP-SRV-BUF-SIZE)
    conn = http-server-conn{
        fd: client-fd
        method: ''
        path: ''
        query: ''
        version: ''
        headers: ''
        header-count: 0
        body: ''
        remote-addr: ''
        keep-alive: false
        recv-buf: buf
        recv-buf-len: 0
    }
    c = conn
}

; close: 關閉伺服器
http-server.close = () {
    .fd >= 0 -> {
        close(.fd)
        .fd = -1
    }
}

; fd-of: 取得監聽 socket fd
; 返回 fd fd
http-server.fd-of = () (fd fd) {
    fd = .fd
}

; ═══════════════════════════════════════════════
; http-server-conn 方法
; ═══════════════════════════════════════════════

; recv-more: 從 socket 接收更多資料到 recv-buf
; 返回 n i64: 接收的位元組數（-1=錯誤, 0=連接關閉）
http-server-conn.recv-more = () (n i64) {
    n = -1
    .fd < 0 -> return
    space = ' '
    tmp = space.repeat(HTTP-SRV-RECV-SIZE)
    n = net-recv(.fd, tmp, HTTP-SRV-RECV-SIZE)
    n > 0 -> {
        i <- [0..n): {
            .recv-buf[.recv-buf-len + i] = tmp[i]
        }
        .recv-buf-len = .recv-buf-len + n
    }
}

; parse: 解析 HTTP 請求
; 讀取並解析完整的 HTTP 請求（請求行 + 標頭 + 可選的請求體）
; 返回 ok bool: true=解析成功
http-server-conn.parse = () (ok bool) {
    ok = false
    .fd < 0 -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf
    separator = crlf - crlf

    ; 讀取直到找到 \r\n\r\n（標頭結束）
    sep-pos i64 = -1
    {
        ; 檢查緩衝區中是否已有分隔符
        data = .recv-buf.slice(0, .recv-buf-len)
        sep-pos = data.index(separator)
        sep-pos >= 0 -> *

        ; 緩衝區已滿但未找到分隔符
        .recv-buf-len + HTTP-SRV-RECV-SIZE > HTTP-SRV-BUF-SIZE -> return

        ; 接收更多資料
        n = .recv-more()
        n <= 0 -> return
    } ()

    ; 解析請求行和標頭
    head = .recv-buf.slice(0, sep-pos)
    body-start = sep-pos + separator.len

    ; 請求行（第一行）
    first-line-end = head.index(crlf)
    first-line-end < 0 -> return
    request-line = head.slice(0, first-line-end)

    ; 解析方法、路徑、版本
    sp1 = request-line.index(" ")
    sp1 < 0 -> return
    .method = request-line.slice(0, sp1)
    after-method = request-line.slice(sp1 + 1, request-line.len)
    sp2 = after-method.index(" ")
    sp2 < 0 -> return
    full-path = after-method.slice(0, sp2)
    .version = after-method.slice(sp2 + 1, after-method.len)

    ; 分離 path 和 query
    q-pos = full-path.index("?")
    {
        q-pos >= 0 -> {
            .path = full-path.slice(0, q-pos)
            .query = full-path.slice(q-pos + 1, full-path.len)
        }
        -> {
            .path = full-path
            .query = ''
        }
    }

    ; 標頭
    .headers = head.slice(first-line-end + crlf.len, head.len)

    ; 解析標頭到 header-names / header-values
    .header-count = 0
    i <- [0..HTTP-SRV-MAX-HEADERS): {
        .header-names[i] = ' '
        .header-names[i].len = 0
        .header-values[i] = ' '
        .header-values[i].len = 0
    }

    hs = .headers
    hn = hs.len
    hn > 0 -> {
        pos = 0
        {
            pos >= hn -> *
            next-crlf = hs.index-from(crlf, pos)
            line-end = next-crlf
            line-end < 0 -> line-end = hn
            colon-pos = hs.index-from(': ', pos)
            colon-pos >= 0 && colon-pos < line-end -> {
                cnt = .header-count
                cnt < HTTP-SRV-MAX-HEADERS -> {
                    name-len = colon-pos - pos
                    j <- [0..name-len): {
                        .header-names[cnt][j] = hs[pos + j]
                    }
                    .header-names[cnt].len = name-len
                    val-start = colon-pos + 2
                    val-len = line-end - val-start
                    j <- [0..val-len): {
                        .header-values[cnt][j] = hs[val-start + j]
                    }
                    .header-values[cnt].len = val-len
                    .header-count = cnt + 1
                }
            }
            next-crlf < 0 -> *
            pos = next-crlf + 2
        } ()
    }

    ; 判斷 Keep-Alive
    .keep-alive = false
    .version == 'HTTP/1.1' -> .keep-alive = true
    conn-val = .get-header('Connection')
    conn-val: {
        ok -> {
            cl = it
            cl == 'close' -> .keep-alive = false
            cl == 'keep-alive' -> .keep-alive = true
        }
        ->
    }

    ; 讀取請求體（如有 Content-Length）
    .body = ''
    cl-opt = .get-header('Content-Length')
    cl-opt: {
        ok -> {
            cl-str = it
            content-len = 0
            j <- [0..cl-str.len): {
                ch = cl-str[j]
                ch >= 48 && ch <= 57 -> content-len = content-len * 10 + ch - 48
            }
            content-len > 0 && content-len <= HTTP-SRV-MAX-BODY -> {
                ; 標頭後已接收的資料
                available = .recv-buf-len - body-start

                ; 如果不足，繼續接收
                {
                    n = .recv-more()
                    n <= 0 -> return
                    available = .recv-buf-len - body-start
                } (available < content-len)
                .body = .recv-buf.slice(body-start, body-start + content-len)
            }
        }
        ->
    }

    ok = true
}

; get-header: 取得指定標頭值
; name str: 標頭名（如 'Content-Type'）
; 返回 val ?str: ok=標頭值, nil=未找到
http-server-conn.get-header = (name str) (val ?str) {
    val = nil
    cnt = .header-count
    i <- [0..cnt): {
        matched = 1
        .header-names[i].len != name.len -> matched = 0
        matched == 1 -> {
            j <- [0..name.len): {
                c1 = .header-names[i][j]
                c2 = name[j]
                ; 大小寫不敏感比較
                c1 >= 65 && c1 <= 90 -> c1 = c1 + 32
                c2 >= 65 && c2 <= 90 -> c2 = c2 + 32
                c1 != c2 -> {
                    matched = 0
                    break
                }
            }
        }
        matched == 1 -> {
            vlen = .header-values[i].len
            val = .header-values[i].slice(0, vlen)
            return
        }
    }
}

; write-status: 寫入 HTTP 狀態行
; code i64: 狀態碼（如 200, 404, 500）
; 返回 ok bool: true=成功
http-server-conn.write-status = (status i64) (ok bool) {
    ok = false
    .fd < 0 -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    status-s = status.to-str()
    status-text = 'OK'
    {
        status == 200 -> status-text = 'OK'
        status == 201 -> status-text = 'Created'
        status == 204 -> status-text = 'No Content'
        status == 301 -> status-text = 'Moved Permanently'
        status == 302 -> status-text = 'Found'
        status == 304 -> status-text = 'Not Modified'
        status == 400 -> status-text = 'Bad Request'
        status == 401 -> status-text = 'Unauthorized'
        status == 403 -> status-text = 'Forbidden'
        status == 404 -> status-text = 'Not Found'
        status == 405 -> status-text = 'Method Not Allowed'
        status == 408 -> status-text = 'Request Timeout'
        status == 413 -> status-text = 'Payload Too Large'
        status == 414 -> status-text = 'URI Too Long'
        status == 500 -> status-text = 'Internal Server Error'
        status == 501 -> status-text = 'Not Implemented'
        status == 502 -> status-text = 'Bad Gateway'
        status == 503 -> status-text = 'Service Unavailable'
        status == 504 -> status-text = 'Gateway Timeout'
        ->
    }

    line = 'HTTP/1.1 ' - status-s - ' ' - status-text - crlf
    written = net-send(.fd, line, line.len)
    written < 0 -> return
    ok = true
}

; write-header: 寫入單個回應標頭
; name str: 標頭名
; value str: 標頭值
; 返回 ok bool: true=成功
http-server-conn.write-header = (name str, value str) (ok bool) {
    ok = false
    .fd < 0 -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf
    line = name - ': ' - value - crlf
    written = net-send(.fd, line, line.len)
    written < 0 -> return
    ok = true
}

; write-headers-done: 寫入空行表示標頭結束
; 返回 ok bool: true=成功
http-server-conn.write-headers-done = () (ok bool) {
    ok = false
    .fd < 0 -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf
    written = net-send(.fd, crlf, crlf.len)
    written < 0 -> return
    ok = true
}

; write-body: 寫入回應體
; data str: 回應體資料
; 返回 ok bool: true=成功
http-server-conn.write-body = (data str) (ok bool) {
    ok = false
    .fd < 0 -> return
    data.len > 0 -> {
        written = net-send(.fd, data, data.len)
        written < 0 -> return
    }
    ok = true
}

; write-text: 便捷方法 — 寫入完整文字回應
; code i64: 狀態碼
; text str: 回應文字
; content-type str: Content-Type 值（空字串=不寫）
; 返回 ok bool: true=成功
http-server-conn.write-text = (status i64, text str) (ok bool) {
    ok = false
    .fd < 0 -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    ; 狀態行
    ok = .write-status(status)
    ok == false -> return

    ; 標頭
    text-len = text.len
    len-s = text-len.to-str()
    .write-header('Content-Type', 'text/plain; charset=utf-8')
    .write-header('Content-Length', len-s)
    {
        .keep-alive -> .write-header('Connection', 'keep-alive')
        -> .write-header('Connection', 'close')
    }
    .write-header('Server', 'nolang-http/1.0')
    .write-headers-done()

    ; 回應體
    .write-body(text)
    ok = true
}

; write-json: 便捷方法 — 寫入 JSON 回應
; code i64: 狀態碼
; json-str str: JSON 字串
; 返回 ok bool: true=成功
http-server-conn.write-json = (status i64, json-str str) (ok bool) {
    ok = false
    .fd < 0 -> return
    .write-status(status)
    json-len = json-str.len
    len-s = json-len.to-str()
    .write-header('Content-Type', 'application/json; charset=utf-8')
    .write-header('Content-Length', len-s)
    {
        .keep-alive -> .write-header('Connection', 'keep-alive')
        -> .write-header('Connection', 'close')
    }
    .write-header('Server', 'nolang-http/1.0')
    .write-headers-done()
    .write-body(json-str)
    ok = true
}

; write-html: 便捷方法 — 寫入 HTML 回應
; code i64: 狀態碼
; html str: HTML 內容
; 返回 ok bool: true=成功
http-server-conn.write-html = (status i64, html str) (ok bool) {
    ok = false
    .fd < 0 -> return
    .write-status(status)
    html-len = html.len
    len-s = html-len.to-str()
    .write-header('Content-Type', 'text/html; charset=utf-8')
    .write-header('Content-Length', len-s)
    {
        .keep-alive -> .write-header('Connection', 'keep-alive')
        -> .write-header('Connection', 'close')
    }
    .write-header('Server', 'nolang-http/1.0')
    .write-headers-done()
    .write-body(html)
    ok = true
}

; write-redirect: 便捷方法 — 寫入重定向回應
; code i64: 狀態碼（301 或 302）
; location str: 重定向目標 URL
; 返回 ok bool: true=成功
http-server-conn.write-redirect = (status i64, location str) (ok bool) {
    ok = false
    .fd < 0 -> return
    .write-status(status)
    .write-header('Location', location)
    .write-header('Content-Length', '0')
    .write-header('Connection', 'close')
    .write-headers-done()
    ok = true
}

; write-error: 便捷方法 — 寫入錯誤回應
; code i64: 狀態碼（如 404, 500）
; message str: 錯誤訊息
; 返回 ok bool: true=成功
http-server-conn.write-error = (status i64, message str) (ok bool) {
    ok = false
    .fd < 0 -> return
    .write-status(status)
    msg-len = message.len
    len-s = msg-len.to-str()
    .write-header('Content-Type', 'text/plain; charset=utf-8')
    .write-header('Content-Length', len-s)
    .write-header('Connection', 'close')
    .write-header('Server', 'nolang-http/1.0')
    .write-headers-done()
    .write-body(message)
    ok = true
}

; reset: 重置連接狀態以复用（Keep-Alive）
http-server-conn.reset = () {
    .method = ''
    .path = ''
    .query = ''
    .version = ''
    .headers = ''
    .header-count = 0
    .body = ''
    .recv-buf-len = 0
}

; close: 關閉連接
http-server-conn.close = () {
    .fd >= 0 -> {
        close(.fd)
        .fd = -1
    }
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; http-listen-on: 建立 HTTP 伺服器並開始監聽
; host str: 綁定的 IP 地址
; port i64: 監聽埠號
; 返回 s ?http-server: ok=伺服器, nil=失敗
http-listen-on = (host str, port i64) (s ?http-server) {
    s = nil
    srv = http-server{}
    ok = false
    ok = srv.listen(host, port)
    ok -> s = srv
}

; ═══════════════════════════════════════════════
; 伺服器端加密/認證支援
; ═══════════════════════════════════════════════

; get-cookie: 從請求標頭取得指定 Cookie 值
; name str: Cookie 名稱
; 返回 val ?str: ok=Cookie 值, nil=未找到
http-server-conn.get-cookie = (name str) (val ?str) {
    val = nil

    ; 取得 Cookie 標頭
    cookie-header ?str = .get-header('Cookie')
    cookie-header: {
        ->
    }
}

; get-signed-cookie: 取得並驗證簽名 Cookie
; name str: Cookie 名稱
; key []byte: HMAC-SHA256 簽名金鑰
; 返回 val ?str: ok=原始 Cookie 值, nil=未找到或驗證失敗
http-server-conn.get-signed-cookie = (name str, key []byte) (val ?str) {
    val = nil
    signed ?str = .get-cookie(name)
    signed: {
        ->
    }
}

; verify-basic-auth: 驗證 HTTP Basic 認證
; expected-user str: 期望的用戶名
; expected-pass str: 期望的密碼
; 返回 ok bool: true=認證通過
http-server-conn.verify-basic-auth = (expected-user str, expected-pass str) (ok bool) {
    ok = false
    auth-header ?str = .get-header('Authorization')
    auth-header: {
        ->
    }
}

; secure-compare: 常數時間字串比較
; a str: 字串 A
; b str: 字串 B
; 返回 ok bool: true=相等
secure-compare = (a str, b str) (ok bool) {
    ok = false
    a.len != b.len -> return
    diff = 0
    i <- [0..a.len): {
        diff = diff | (a[i] ^ b[i])
    }
    diff == 0 -> ok = true
}

; set-signed-cookie: 設定簽名 Cookie 到回應
; name str: Cookie 名稱
; value str: Cookie 值
; key []byte: HMAC-SHA256 簽名金鑰
http-server-conn.set-signed-cookie = (name str, value str, key []byte) {
    signed-value = cookie.cookie-sign(name, value, key)
    cookie-val = name - '=' - signed-value - '; Path=/; HttpOnly'
    .write-header('Set-Cookie', cookie-val)
}

; ═══════════════════════════════════════════════
; HTTPS 伺服器（TLS 1.2）
; ═══════════════════════════════════════════════

; https-server: HTTPS 伺服器
; fd: 監聽 socket fd（-1=未開啟）
; host: 綁定的 IP 地址
; port: 監聽埠號
https-server {
    fd fd
    host str
    port i64
}

; https-server-conn: HTTPS 伺服器端連接
; tls: 底層 TLS 連接
; method: 請求方法
; path: 請求路徑
; query: 查詢字串
; version: HTTP 版本
; headers: 原始標頭字串
; header-names: 解析後的標頭名
; header-values: 解析後的標頭值
; header-count: 標頭數量
; body: 請求體
; keep-alive: 是否保持連接
; recv-buf: 接收緩衝區
; recv-buf-len: 緩衝區中實際資料長度
https-server-conn {
    tls tls-server-conn
    method str
    path str
    query str
    version str
    headers str
    header-names [32]str
    header-values [32]str
    header-count i64
    body str
    keep-alive bool
    recv-buf str
    recv-buf-len i64
}

; ═══════════════════════════════════════════════
; https-server 方法
; ═══════════════════════════════════════════════

; listen: 開始監聽（TLS）
; host str: 綁定的 IP 地址
; port i64: 監聽埠號
; 返回 ok bool: true=成功
https-server.listen = (host str, port i64) (ok bool) {
    ok = false
    .fd = -1
    .host = host
    .port = port
    fd = tls-server-listen(host, port)
    fd < 0 -> return
    .fd = fd
    ok = true
}

; accept: 接受新的 HTTPS 連接
; 返回 c ?https-server-conn: ok=連接, nil=失敗
https-server.accept = () (c ?https-server-conn) {
    c = nil
    .fd < 0 -> return
    tls-opt = tls-server-accept(.fd)
    tls-opt: {
        nil -> return
        err -> return
        ok -> {
            tls-conn = it
            space = ' '
            buf = space.repeat(HTTP-SRV-BUF-SIZE)
            conn = https-server-conn{
                tls: tls-conn
                method: ''
                path: ''
                query: ''
                version: ''
                headers: ''
                header-count: 0
                body: ''
                keep-alive: false
                recv-buf: buf
                recv-buf-len: 0
            }
            c = conn
        }
    }
}

; close: 關閉伺服器
https-server.close = () {
    .fd >= 0 -> {
        close(.fd)
        .fd = -1
    }
}

; ═══════════════════════════════════════════════
; https-server-conn 方法
; ═══════════════════════════════════════════════

; recv-more: 從 TLS 連接接收更多資料到 recv-buf
; 返回 n i64: 接收的位元組數（-1=錯誤, 0=連接關閉）
https-server-conn.recv-more = () (n i64) {
    n = -1
    space = ' '
    tmp = space.repeat(HTTP-SRV-RECV-SIZE)
    n = .tls.recv(tmp, HTTP-SRV-RECV-SIZE)
    io.errln('[HTTPS-SRV] recv-more: n=' - n.to-str())
    n > 0 -> {
        i <- [0..n): {
            .recv-buf[.recv-buf-len + i] = tmp[i]
        }
        .recv-buf-len = .recv-buf-len + n
        io.errln('[HTTPS-SRV] recv-more: recv-buf-len=' - .recv-buf-len.to-str())
    }
}

; parse: 解析 HTTP 請求（透過 TLS 接收）
; 返回 ok bool: true=解析成功
https-server-conn.parse = () (ok bool) {
    ok = false
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf
    separator = crlf - crlf

    ; 讀取直到找到 \r\n\r\n（標頭結束）
    sep-pos i64 = -1
    {
        data = .recv-buf.slice(0, .recv-buf-len)
        sep-pos = data.index(separator)
        sep-pos >= 0 -> *
        .recv-buf-len + HTTP-SRV-RECV-SIZE > HTTP-SRV-BUF-SIZE -> return
        n = .recv-more()
        n <= 0 -> return
    } ()

    ; 解析請求行和標頭
    head = .recv-buf.slice(0, sep-pos)
    body-start = sep-pos + separator.len

    ; 請求行
    first-line-end = head.index(crlf)
    first-line-end < 0 -> return
    request-line = head.slice(0, first-line-end)

    ; 解析方法、路徑、版本
    sp = char-to-str(32)
    sp1 = request-line.index(sp)
    sp1 < 0 -> return
    .method = request-line.slice(0, sp1)
    after-method = request-line.slice(sp1 + 1, request-line.len)
    sp2 = after-method.index(sp)
    sp2 < 0 -> return
    full-path = after-method.slice(0, sp2)
    .version = after-method.slice(sp2 + 1, after-method.len)

    ; 分離 path 和 query
    qm = char-to-str(63)
    q-pos = full-path.index(qm)
    {
        q-pos >= 0 -> {
            .path = full-path.slice(0, q-pos)
            .query = full-path.slice(q-pos + 1, full-path.len)
        }
        -> {
            .path = full-path
            .query = ''
        }
    }

    ; 標頭
    .headers = head.slice(first-line-end + crlf.len, head.len)

    ; 解析標頭
    .header-count = 0
    i <- [0..HTTP-SRV-MAX-HEADERS): {
        .header-names[i] = ' '
        .header-names[i].len = 0
        .header-values[i] = ' '
        .header-values[i].len = 0
    }

    hs = .headers
    hn = hs.len
    hn > 0 -> {
        pos = 0
        {
            pos >= hn -> *
            next-crlf = hs.index-from(crlf, pos)
            line-end = next-crlf
            line-end < 0 -> line-end = hn
            colon-pos = hs.index-from(': ', pos)
            colon-pos >= 0 && colon-pos < line-end -> {
                cnt = .header-count
                cnt < HTTP-SRV-MAX-HEADERS -> {
                    name-len = colon-pos - pos
                    j <- [0..name-len): {
                        .header-names[cnt][j] = hs[pos + j]
                    }
                    .header-names[cnt].len = name-len
                    val-start = colon-pos + 2
                    val-len = line-end - val-start
                    j <- [0..val-len): {
                        .header-values[cnt][j] = hs[val-start + j]
                    }
                    .header-values[cnt].len = val-len
                    .header-count = cnt + 1
                }
            }
            next-crlf < 0 -> *
            pos = next-crlf + 2
        } ()
    }

    ; 判斷 Keep-Alive
    .keep-alive = false
    .version == 'HTTP/1.1' -> .keep-alive = true
    conn-val = .get-header('Connection')
    conn-val: {
        ok -> {
            cl = it
            cl == 'close' -> .keep-alive = false
            cl == 'keep-alive' -> .keep-alive = true
        }
        ->
    }

    ; 讀取請求體
    .body = ''
    cl-opt = .get-header('Content-Length')
    cl-opt: {
        ok -> {
            cl-str = it
            content-len = 0
            j <- [0..cl-str.len): {
                ch = cl-str[j]
                ch >= 48 && ch <= 57 -> content-len = content-len * 10 + ch - 48
            }
            content-len > 0 && content-len <= HTTP-SRV-MAX-BODY -> {
                available = .recv-buf-len - body-start
                {
                    n = .recv-more()
                    n <= 0 -> return
                    available = .recv-buf-len - body-start
                } (available < content-len)
                .body = .recv-buf.slice(body-start, body-start + content-len)
            }
        }
        ->
    }

    io.errln('[HTTPS-SRV] parse: method=' - .method - ' path=' - .path - ' version=' - .version - ' sp1=' - sp1.to-str() - ' sep-pos=' - sep-pos.to-str() - ' header-count=' - .header-count.to-str())
    ok = true
}

; get-header: 取得指定標頭值
; name str: 標頭名
; 返回 val ?str: ok=標頭值, nil=未找到
https-server-conn.get-header = (name str) (val ?str) {
    val = nil
    cnt = .header-count
    i <- [0..cnt): {
        matched = 1
        .header-names[i].len != name.len -> matched = 0
        matched == 1 -> {
            j <- [0..name.len): {
                c1 = .header-names[i][j]
                c2 = name[j]
                c1 >= 65 && c1 <= 90 -> c1 = c1 + 32
                c2 >= 65 && c2 <= 90 -> c2 = c2 + 32
                c1 != c2 -> {
                    matched = 0
                    break
                }
            }
        }
        matched == 1 -> {
            vlen = .header-values[i].len
            val = .header-values[i].slice(0, vlen)
            return
        }
    }
}

; write-status: 寫入 HTTP 狀態行（透過 TLS）
; status i64: 狀態碼
; 返回 ok bool: true=成功
https-server-conn.write-status = (status i64) (ok bool) {
    ok = false
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    status-s = status.to-str()
    status-text = 'OK'
    {
        status == 200 -> status-text = 'OK'
        status == 201 -> status-text = 'Created'
        status == 204 -> status-text = 'No Content'
        status == 301 -> status-text = 'Moved Permanently'
        status == 302 -> status-text = 'Found'
        status == 304 -> status-text = 'Not Modified'
        status == 400 -> status-text = 'Bad Request'
        status == 401 -> status-text = 'Unauthorized'
        status == 403 -> status-text = 'Forbidden'
        status == 404 -> status-text = 'Not Found'
        status == 405 -> status-text = 'Method Not Allowed'
        status == 500 -> status-text = 'Internal Server Error'
        status == 501 -> status-text = 'Not Implemented'
        status == 502 -> status-text = 'Bad Gateway'
        status == 503 -> status-text = 'Service Unavailable'
        ->
    }

    line = 'HTTP/1.1 ' - status-s - ' ' - status-text - crlf
    tc = .tls
    io.errln('[HTTPS-SRV] write-status: sending line.len=' - line.len.to-str())
    w = tc.send(line)
    .tls = tc
    io.errln('[HTTPS-SRV] write-status: send returned')
    w: {
        nil -> {
            io.errln('[HTTPS-SRV] write-status: send nil')
            return
        }
        err -> {
            io.errln('[HTTPS-SRV] write-status: send err')
            return
        }
        ok -> {
            io.errln('[HTTPS-SRV] write-status: send ok')
            ok = true
        }
    }
}

; write-header: 寫入單個回應標頭（透過 TLS）
; name str: 標頭名
; value str: 標頭值
; 返回 ok bool: true=成功
https-server-conn.write-header = (name str, value str) (ok bool) {
    ok = false
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf
    line = name - ': ' - value - crlf
    tc = .tls
    w = tc.send(line)
    .tls = tc
    {
        nil -> return
        err -> return
        ok -> ok = true
    } (w)
}

; write-headers-done: 寫入空行表示標頭結束（透過 TLS）
; 返回 ok bool: true=成功
https-server-conn.write-headers-done = () (ok bool) {
    ok = false
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf
    tc = .tls
    w = tc.send(crlf)
    .tls = tc
    {
        nil -> return
        err -> return
        ok -> ok = true
    } (w)
}

; write-body: 寫入回應體（透過 TLS）
; data str: 回應體資料
; 返回 ok bool: true=成功
https-server-conn.write-body = (data str) (ok bool) {
    ok = false
    data.len > 0 -> {
        tc = .tls
        w = tc.send(data)
        .tls = tc
        {
            nil -> return
            err -> return
            ok -> ok = true
        } (w)
    }
    ok = true
}

; write-text: 便捷方法 — 寫入完整文字回應（透過 TLS）
; status i64: 狀態碼
; text str: 回應文字
; 返回 ok bool: true=成功
https-server-conn.write-text = (status i64, text str) (ok bool) {
    ok = false

    ok = .write-status(status)
    ok == false -> {
        io.errln('[HTTPS-SRV] write-text: write-status failed')
        return
    }
    io.errln('[HTTPS-SRV] write-text: status ok')

    text-len = text.len
    len-s = text-len.to-str()
    .write-header('Content-Type', 'text/plain; charset=utf-8')
    io.errln('[HTTPS-SRV] write-text: ct-header ok')
    .write-header('Content-Length', len-s)
    io.errln('[HTTPS-SRV] write-text: cl-header ok')
    {
        .keep-alive -> .write-header('Connection', 'keep-alive')
        -> .write-header('Connection', 'close')
    }
    .write-header('Server', 'nolang-https/1.0')
    io.errln('[HTTPS-SRV] write-text: srv-header ok')
    .write-headers-done()
    io.errln('[HTTPS-SRV] write-text: headers-done ok')
    .write-body(text)
    io.errln('[HTTPS-SRV] write-text: body ok')
    ok = true
}

; write-json: 便捷方法 — 寫入 JSON 回應（透過 TLS）
; status i64: 狀態碼
; json-str str: JSON 字串
; 返回 ok bool: true=成功
https-server-conn.write-json = (status i64, json-str str) (ok bool) {
    ok = false
    .write-status(status)
    json-len = json-str.len
    len-s = json-len.to-str()
    .write-header('Content-Type', 'application/json; charset=utf-8')
    .write-header('Content-Length', len-s)
    {
        .keep-alive -> .write-header('Connection', 'keep-alive')
        -> .write-header('Connection', 'close')
    }
    .write-header('Server', 'nolang-https/1.0')
    .write-headers-done()
    .write-body(json-str)
    ok = true
}

; write-html: 便捷方法 — 寫入 HTML 回應（透過 TLS）
; status i64: 狀態碼
; html str: HTML 內容
; 返回 ok bool: true=成功
https-server-conn.write-html = (status i64, html str) (ok bool) {
    ok = false
    .write-status(status)
    html-len = html.len
    len-s = html-len.to-str()
    .write-header('Content-Type', 'text/html; charset=utf-8')
    .write-header('Content-Length', len-s)
    {
        .keep-alive -> .write-header('Connection', 'keep-alive')
        -> .write-header('Connection', 'close')
    }
    .write-header('Server', 'nolang-https/1.0')
    .write-headers-done()
    .write-body(html)
    ok = true
}

; reset: 重置連接狀態以复用（Keep-Alive）
https-server-conn.reset = () {
    .method = ''
    .path = ''
    .query = ''
    .version = ''
    .headers = ''
    .header-count = 0
    .body = ''
    .recv-buf-len = 0
}

; close: 關閉 TLS 連接
https-server-conn.close = () {
    .tls.close()
}

; ═══════════════════════════════════════════════
; HTTPS 便捷函數
; ═══════════════════════════════════════════════

; https-listen-on: 建立 HTTPS 伺服器並開始監聽
; host str: 綁定的 IP 地址
; port i64: 監聽埠號
; 返回 s ?https-server: ok=伺服器, nil=失敗
https-listen-on = (host str, port i64) (s ?https-server) {
    s = nil
    srv = https-server{}
    ok = false
    ok = srv.listen(host, port)
    ok -> s = srv
}
