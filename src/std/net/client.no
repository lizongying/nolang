; client — 高階 TCP 客戶端
;
; 封裝 conn，對稱於 listener，提供連接狀態追蹤、重連、請求-回應模式等便利功能。
; 底層使用 net.no 的 conn 結構體與 net-* built-in 函數。
;
; 用法：
;   c = client{}
;   ok = c.connect('127.0.0.1', 8080)
;   n = c.send('hello')
;   n = c.recv(buf, 1024)
;   c.close()
;
;   // 請求-回應模式
;   response = c.request('PING')              // 返回 ?str
;
;   // 重連
;   ok = c.reconnect()
;
;   // 便捷函數
;   c = client-create('127.0.0.1', 8080)          // 返回 ?client

; ═══════════════════════════════════════════════
; client 結構體
; ═══════════════════════════════════════════════

; client: 高階 TCP 客戶端
; c: 底層 TCP 連接（net.conn 結構體）
; host: 目標主機（記錄供 reconnect 使用）
; port: 目標埠號
; connected: 連接狀態
client {
    c net.conn
    host str
    port i64
    connected bool
}

; 連接到指定主機與埠號
; 記錄 host/port 供後續 reconnect 使用
; host str: 目標伺服器位址
; port i64: 目標伺服器埠號
; ok bool: true=已建立 TCP 連接，false=撥號失敗
; [connect](#client.client.connect)
client.connect = (host str, port i64) (ok bool) {
    ok = false
    .host = host
    .port = port
    .connected = false
    ok = .c.dial(host, port)
    print('DBG client.connect .c.fd=', .c.fd, ' ok=', ok)
    ok -> .connected = true
}

; 使用已記錄的 host/port 重新連接
; 先關閉舊連接（避免 fd 洩漏），再重新 dial
; ok bool: 以先前記錄的 host/port 重新撥號成功時為 true（未記錄過則直接返回 false）
; [reconnect](#client.client.reconnect)
client.reconnect = () (ok bool) {
    ok = false
    .host.len-bytes() == 0 -> return
    .connected -> {
        .c.close()
        .connected = false
    }
    ok = .c.dial(.host, .port)
    ok -> .connected = true
}

; 發送字串資料
; data str: 要發送的位元組內容字串
; written i64: 實際發送位元組數（-1=未連接或底層錯誤）
; [send](#client.client.send)
client.send = (data str) (written i64) {
    written = -1
    print('DBG client.send connected=', .connected)
    .connected == false -> return
    written = .c.send(data)
    print('DBG client.send done written=', written)
}

; 接收資料到緩衝區
; buf str: 接收緩衝區（str）
; n i64: 最多接收的位元組數
; read-n i64: 實際接收位元組數（-1=未連接或錯誤, 0=連接關閉）
; [recv](#client.client.recv)
client.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    .connected == false -> return
    read-n = .c.recv(buf, n)
}

; 接收一行資料（最多 NET-BUF-SIZE 位元組）
; 返回 line ?str: ok=接收內容, nil=失敗或連接關閉
; [recv-line](#client.client.recv-line)
client.recv-line = () (line ?str) {
    line = nil
    .connected == false -> return
    line = .c.recv-line()
}

; 請求-回應模式
; 發送資料後接收全部回應直到連接關閉
; 返回 response ?str: ok=回應內容, nil=失敗
; data: 要發送的請求內容
; [request](#client.client.request)
client.request = (data str) (response ?str) {
    response = nil
    .connected == false -> return
    written = .c.send(data)
    written < 0 -> return
    s str = with-len(net.NET-BUF-SIZE)
    total = 0
    s, total = .c.recv-all()
    response = s
}

; 發送一行（附加換行符 \n）
; line str: 要發送的行文字（自動附加換行符）
; written i64: 實際發送位元組數（含換行符；-1=未連接或錯誤）
; [send-line](#client.client.send-line)
client.send-line = (line str) (written i64) {

    written = -1
    .connected == false -> return

    ; 換行符 \n 作為行終止符
    nl = '\n'

    written = .c.send(line - nl)
}

; 檢查連接狀態
; yes bool: true=當前處於已連接狀態
; [is-connected](#client.client.is-connected)
client.is-connected = () (yes bool) {
    yes = .connected
}

; 關閉連接並重置狀態
; [close](#client.client.close)
client.close = () {
    .connected -> {
        .c.close()
        .connected = false
    }
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; 建立客戶端並連接
; 返回 c ?client: ok=客戶端, nil=失敗
; host: 目標伺服器位址
; port: 目標伺服器埠號
; [client-create](#client.client-create)
client-create = (host str, port i64) (c ?client) {
    c = nil
    cl = client {}
    ok = false
    ok = cl.connect(host, port)
    ok -> c = cl
}
