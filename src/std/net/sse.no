; sse — Server-Sent Events 客戶端與服務端
;
; 支援 W3C EventSource 規範的 SSE 串流接收與發送。
; 底層使用 HTTP/1.1 長連接，支援明文 HTTP 與 HTTPS（TLS，客戶端）。
;
; 用法（客戶端）：
;   client = sse-connect('http://localhost:3000/events')   // 返回 ?client
;   client: {
;       nil -> print('SSE connection failed')
;       ->
;           ! {
;               ev = client.next-event()       // 返回 ?event
;               ev: {
;                   nil -> *
;                   err -> print('error: ' - it)
;                         *
;                   -> print(ev.event - ': ' - ev.data)
;               }
;           }
;           client.close()
;   }
;
; 用法（服務端）：
;   srv = listen-on('0.0.0.0', 3000)   // 返回 ?server
;   srv: {
;       nil -> return
;       ->
;           ! {
;               c = srv.accept()             // 返回 ?server-conn
;               c: {
;                   nil -> *
;                   ->
;                       c.send-event('message', 'hello', '', -1)
;                       c.send-comment('heartbeat')
;                       c.close()
;               }
;           }
;   }

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 接收緩衝區大小
SSE-BUF-SIZE = 8192

; 單次接收大小
SSE-RECV-SIZE = 4096

; 預設 HTTP 埠號
SSE-DEFAULT-PORT = 80

; 預設 HTTPS 埠號
SSE-DEFAULT-TLS-PORT = 443

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; event: SSE 事件
; event: 事件類型（預設 'message'）
; data: 事件資料（多行 data 以 \n 連接）
; id: 事件 ID
; retry: 重連等待毫秒數（-1=未設定）
event {
    event str
    data str
    id str
    retry i64
}

; client: SSE 客戶端連線
; fd: TCP socket 檔案描述符（-1=未連接）
; tls-c: TLS 連線（use-tls=true 時使用）
; use-tls: 是否使用 TLS
; connected: 連線狀態
; host: 伺服器主機名
; port: 埠號
; path: 請求路徑
; last-event-id: 最後收到的事件 ID（用於重連）
; recv-buf: 接收緩衝區
; recv-buf-len: 緩衝區中實際資料長度
client {
    fd fd
    tls-c tls.conn
    use-tls bool
    connected bool
    host str
    port i64
    path str
    last-event-id str
    recv-buf str
    recv-buf-len i64
}

; ═══════════════════════════════════════════════
; client 方法
; ═══════════════════════════════════════════════

; next-event: 讀取下一個 SSE 事件
; 阻塞直到收到完整事件或連線關閉。
; 返回 ev ?event:
;   ok = 事件
;   nil   = 連線已關閉（EOF）
;   err = 錯誤
client.next-event = () (ev ?event) {

    #{overflow=wrap}
    ev = nil
    .connected == false -> {
        ev = err('not connected')
        return
    }
    cr = number.char-to-str(13)
    lf = number.char-to-str(10)

    #{overflow=wrap}
    crlf = cr - lf

    #{overflow=wrap}
    lf-lf = lf - lf

    #{overflow=wrap}
    crlf-crlf = crlf - crlf

    !! {

        ; 建立緩衝區視圖（slice 會複製，安全）
        #{overflow=wrap}
        data = .recv-buf.slice(0, .recv-buf-len)

        ; 搜尋事件分隔符（\n\n 或 \r\n\r\n）
        pos1 = data.index(lf-lf)
        pos2 = data.index(crlf-crlf)
        sep-pos = -1
        sep-len = 0
        {
            pos1 >= 0 && pos2 >= 0 -> {
                pos1 <= pos2 -> {
                    sep-pos = pos1
                    sep-len = 2
                }

                -> {
                    sep-pos = pos2
                    sep-len = 4
                }
            }

            pos1 >= 0 -> {
                sep-pos = pos1
                sep-len = 2
            }

            pos2 >= 0 -> {
                sep-pos = pos2
                sep-len = 4
            }

            ->
        }

        #{overflow=wrap}
        {
            sep-pos >= 0 -> {

                ; 找到事件邊界
                #{overflow=wrap}
                event-block = data.slice(0, sep-pos)
                remaining-start = sep-pos + sep-len
                remaining = data.slice(remaining-start, data.len-bytes())

                ; 將剩餘資料移到緩衝區開頭
                i <- [0..remaining.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    .recv-buf[i] = remaining[i]
                }
                .recv-buf-len = remaining.len-bytes()

                ; 解析事件區塊
                e-event = 'message'
                e-data = ''
                e-id = ''
                e-retry i64 = -1
                has-data = false
                pos = 0
                (pos < event-block.len-bytes()) {

                    #{overflow=wrap}
                    nl = event-block.index-from(lf, pos)
                    line-end = nl
                    line-end < 0 -> line-end = event-block.len-bytes()
                    line = event-block.slice(pos, line-end)

                    ; 去除行尾 \r
                    line.len-bytes() > 0 -> {
                        line[line.len-bytes() - 1] == 13 -> {

                            #{index-out=0}
                            line = line.slice(0, line.len-bytes() - 1)
                        }
                    }

                    ; 跳過空行和註解行
                    line.len-bytes() > 0 -> {
                        line[0] != 58 -> {

                            ; 尋找冒號分隔符
                            colon = line.index(':')
                            field = line
                            value = ''
                            colon >= 0 -> {

                                #{overflow=wrap}
                                field = line.slice(0, colon)
                                val-start = colon + 1
                                val-start < line.len-bytes() -> {
                                    line[val-start] == 32 -> {

                                        #{index-out=0}
                                        val-start = val-start + 1
                                    }
                                }
                                value = line.slice(val-start, line.len-bytes())
                            }
                            {
                                field == 'data' -> {

                                    #{overflow=wrap}
                                    has-data -> e-data = e-data - lf - value

                                    -> {
                                        e-data = value
                                        has-data = true
                                    }
                                }

                                field == 'event' -> e-event = value

                                field == 'id' -> {
                                    e-id = value
                                    .last-event-id = value
                                }

                                field == 'retry' -> {
                                    retry-val ?i64 = value.to-i64()
                                    retry-val: {
                                        nil -> e-retry = -1

                                        err -> e-retry = -1

                                        ok -> e-retry = it
                                    }
                                }
                            }
                        }
                    }
                    pos = line-end + 1
                }

                ; 只有包含 data 的事件才回傳
                has-data -> {
                    ev = event {
                        event: e-event
                        data: e-data
                        id: e-id
                        retry: e-retry
                    }
                    return
                }
                ; 此事件無 data，繼續讀取下一個事件
            }

            sep-pos < 0 -> {

                ; 未找到完整事件，接收更多資料
                #{overflow=wrap}
                .recv-buf-len >= SSE-BUF-SIZE -> {
                    ev = err('event too large')
                    return
                }
                tmp str = with-len(SSE-RECV-SIZE)
                n = 0
                recv-ok = false
                .use-tls -> {
                    rn = .tls-c.recv(tmp, SSE-RECV-SIZE)
                    rn: {
                        ok -> n = it

                        -> {
                            .connected = false
                            ev = err('recv failed')
                            return
                        }
                    }
                }
                .use-tls == false -> n = net.net-recv(.fd, tmp, SSE-RECV-SIZE)
                n <= 0 -> {
                    .connected = false
                    ev = nil
                    return
                }

                ; 複製到緩衝區末尾
                i <- [0..n): {

                    #{index-out=0, overflow=wrap}
                    .recv-buf[.recv-buf-len + i] = tmp[i]
                }
                .recv-buf-len = .recv-buf-len + n
            }
        }
    }
}

; close: 關閉 SSE 連線
client.close = () {
    .connected -> {
        .use-tls -> .tls-c.close()
        .use-tls == false -> .fd >= 0 -> fs.close(.fd)
        .fd = -1
        .connected = false
    }
}

; is-connected: 檢查連線狀態
; 返回 yes bool: true=已連接
client.is-connected = () (yes bool) {
    yes = .connected
}

; reconnect: 重新連線（使用 last-event-id 繼續接收）
; 返回 ok bool: true=成功
client.reconnect = () (ok bool) {

    #{overflow=wrap}
    ok = false
    req = ''
    crlf = ''
    .connected -> .close()
    cr = number.char-to-str(13)
    lf = number.char-to-str(10)

    #{overflow=wrap}
    crlf = cr - lf

    ; 建立連線
    {
        .use-tls -> {
            .tls-c.init()
            ok2 = .tls-c.connect(.host, .port)
            ok2 == false -> return
        }

        .use-tls == false -> {
            .fd = net.net-dial(.host, .port)
            .fd < 0 -> return
        }
    }
    .connected = true

    ; 建構 SSE 請求
    req = 'GET '

    #{overflow=wrap}
    req = req - .path

    #{overflow=wrap}
    req = req - ' HTTP/1.1'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Host: '

    #{overflow=wrap}
    req = req - .host

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Accept: text/event-stream'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Cache-Control: no-cache'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Connection: keep-alive'

    #{overflow=wrap}
    req = req - crlf

    ; 如有 last-event-id，加入標頭
    #{overflow=wrap}
    .last-event-id.len-bytes() > 0 -> {

        #{overflow=wrap}
        req = req - 'Last-Event-ID: '
        req = req - .last-event-id
        req = req - crlf
    }

    #{overflow=wrap}
    req = req - 'User-Agent: nolang-sse/1.0'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - crlf

    ; 發送請求
    written = 0
    {
        .use-tls -> {
            w = .tls-c.send(req)
            w: {
                nil -> {
                    .close()
                    return
                }

                ->
            }
        }

        .use-tls == false -> {
            written = net.net-send(.fd, req, req.len-bytes())
            written < 0 -> {
                .close()
                return
            }
        }
    }

    ; 接收回應標頭（直到 \r\n\r\n）
    raw str = with-len(SSE-BUF-SIZE)
    tmp str = with-len(SSE-RECV-SIZE)
    total = 0
    n = 0

    #{overflow=wrap}
    separator = crlf - crlf
    sep-pos = -1

    !! {

        #{overflow=wrap}
        total + SSE-RECV-SIZE > SSE-BUF-SIZE -> {
            .close()
            return
        }
        .use-tls -> {
            rn = .tls-c.recv(tmp, SSE-RECV-SIZE)
            rn: {
                ok -> n = it

                -> {
                    .close()
                    return
                }
            }
        }
        .use-tls == false -> n = net.net-recv(.fd, tmp, SSE-RECV-SIZE)
        n <= 0 -> {
            .close()
            return
        }
        i <- [0..n): {

            #{index-out=0, overflow=wrap}
            raw[total + i] = tmp[i]
        }

        #{overflow=wrap}
        total = total + n
        data = raw.slice(0, total)
        sep-pos = data.index(separator)
        sep-pos >= 0 -> *
    }

    ; 驗證狀態碼
    head = raw.slice(0, sep-pos)
    first-line-end = head.index(crlf)
    status-line = head
    first-line-end >= 0 -> status-line = head.slice(0, first-line-end)
    sp1 = status-line.index(' ')
    sp1 < 0 -> {
        .close()
        return
    }

    #{overflow=wrap}
    after-code = status-line.slice(sp1 + 1, status-line.len-bytes())
    sp2 = after-code.index(' ')
    code-str = after-code
    sp2 >= 0 -> code-str = after-code.slice(0, sp2)
    status-code = 0
    i <- [0..code-str.len-bytes()): {

        #{index-out=0, overflow=wrap}
        c = code-str[i]
        c < 48 || c > 57 -> {
            .close()
            return
        }

        #{overflow=wrap}
        status-code = status-code * 10 + c - 48
    }
    status-code != 200 -> {
        .close()
        return
    }

    ; 儲存標頭後的剩餘資料
    #{overflow=wrap}
    body-start = sep-pos + separator.len-bytes()
    remaining = raw.slice(body-start, total)

    .recv-buf = with-len(SSE-BUF-SIZE)
    .recv-buf-len = remaining.len-bytes()
    i <- [0..remaining.len-bytes()): {

        #{index-out=0, overflow=wrap}
        .recv-buf[i] = remaining[i]
    }
    ok = true
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; sse-connect: 連接到 SSE 端點
; url str: SSE 端點 URL（http://host:port/path 或 https://host:port/path）
; 返回 client ?client:
;   ok = 已連接的客戶端
;   nil   = 連線失敗
;   err = 錯誤訊息
sse-connect = (url str) (client ?client) {

    #{overflow=wrap}
    client = nil

    ; ── 解析 URL ──
    scheme = 'http://'
    rest = ''
    host = ''
    port i64 = SSE-DEFAULT-PORT
    path = '/'
    host-only = ''
    port-str = ''
    use-tls = false
    fd fd = -1
    tls-c tls.conn

    url.starts-with('https://') -> {
        use-tls = true
        scheme = 'https://'
        port = SSE-DEFAULT-TLS-PORT
    }
    url.starts-with('http://') == false -> use-tls == false -> {
        client = err('invalid URL: must start with http:// or https://')
        return
    }
    rest = url.slice(scheme.len-bytes(), url.len-bytes())

    slash-pos = rest.index('/')
    {
        slash-pos < 0 -> host = rest

        slash-pos >= 0 -> {
            host = rest.slice(0, slash-pos)
            path = rest.slice(slash-pos, rest.len-bytes())
        }
    }
    colon-pos = host.index(':')

    #{overflow=wrap}
    colon-pos >= 0 -> {

        #{overflow=wrap}
        host-only = host.slice(0, colon-pos)
        port-str = host.slice(colon-pos + 1, host.len-bytes())
        p = 0
        i <- [0..port-str.len-bytes()): {

            #{index-out=0, overflow=wrap}
            c = port-str[i]
            c < 48 || c > 57 -> {
                client = err('invalid port')
                return
            }
            p = p * 10 + c - 48
        }
        port = p
        host = host-only
    }
    host.len-bytes() == 0 -> {
        client = err('empty host')
        return
    }

    ; ── 建立連線 ──
    {
        use-tls -> {
            tls-c.init()
            ok2 = tls-c.connect(host, port)
            ok2 == false -> {
                client = err('TLS connection failed')
                return
            }
        }

        use-tls == false -> {
            fd = net.net-dial(host, port)
            fd < 0 -> {
                client = err('TCP connection failed')
                return
            }
        }
    }

    ; ── 建構 SSE 請求 ──
    cr = number.char-to-str(13)
    lf = number.char-to-str(10)

    #{overflow=wrap}
    crlf = cr - lf
    req = 'GET '

    #{overflow=wrap}
    req = req - path

    #{overflow=wrap}
    req = req - ' HTTP/1.1'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Host: '

    #{overflow=wrap}
    req = req - host

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Accept: text/event-stream'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Cache-Control: no-cache'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'Connection: keep-alive'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - 'User-Agent: nolang-sse/1.0'

    #{overflow=wrap}
    req = req - crlf

    #{overflow=wrap}
    req = req - crlf

    ; ── 發送請求 ──
    written = 0
    {
        use-tls -> {
            w = tls-c.send(req)
            w: {
                nil -> {
                    tls-c.close()
                    client = err('send failed')
                    return
                }

                ->
            }
        }

        use-tls == false -> {
            written = net.net-send(fd, req, req.len-bytes())
            written < 0 -> {
                fs.close(fd)
                client = err('send failed')
                return
            }
        }
    }

    ; ── 接收回應標頭（直到 \r\n\r\n）──
    raw str = with-len(SSE-BUF-SIZE)
    tmp str = with-len(SSE-RECV-SIZE)
    total = 0
    n = 0

    #{overflow=wrap}
    separator = crlf - crlf
    sep-pos = -1

    !! {

        #{overflow=wrap}
        total + SSE-RECV-SIZE > SSE-BUF-SIZE -> {
            use-tls -> tls-c.close()
            use-tls == false -> fs.close(fd)
            client = err('response headers too large')
            return
        }
        use-tls -> {
            rn = tls-c.recv(tmp, SSE-RECV-SIZE)
            rn: {
                ok -> n = it

                -> {
                    tls-c.close()
                    client = err('recv failed')
                    return
                }
            }
        }
        use-tls == false -> n = net.net-recv(fd, tmp, SSE-RECV-SIZE)
        n <= 0 -> {
            use-tls -> tls-c.close()
            use-tls == false -> fs.close(fd)
            client = err('connection closed during handshake')
            return
        }
        i <- [0..n): {

            #{index-out=0, overflow=wrap}
            raw[total + i] = tmp[i]
        }

        #{overflow=wrap}
        total = total + n
        data = raw.slice(0, total)
        sep-pos = data.index(separator)
        sep-pos >= 0 -> *
    }

    ; ── 驗證狀態碼 ──
    head = raw.slice(0, sep-pos)
    first-line-end = head.index(crlf)
    status-line = head
    first-line-end >= 0 -> status-line = head.slice(0, first-line-end)
    sp1 = status-line.index(' ')
    sp1 < 0 -> {
        use-tls -> tls-c.close()
        use-tls == false -> fs.close(fd)
        client = err('invalid status line')
        return
    }

    #{overflow=wrap}
    after-code = status-line.slice(sp1 + 1, status-line.len-bytes())
    sp2 = after-code.index(' ')
    code-str = after-code
    sp2 >= 0 -> code-str = after-code.slice(0, sp2)
    status-code = 0
    i <- [0..code-str.len-bytes()): {

        #{index-out=0, overflow=wrap}
        c = code-str[i]
        c < 48 || c > 57 -> {
            use-tls -> tls-c.close()
            use-tls == false -> fs.close(fd)
            client = err('invalid status code')
            return
        }

        #{overflow=wrap}
        status-code = status-code * 10 + c - 48
    }

    #{overflow=wrap}
    status-code != 200 -> {

        #{overflow=wrap}
        use-tls -> tls-c.close()
        use-tls == false -> fs.close(fd)
        code-s = status-code.to-str()
        client = err('server returned status ' - code-s)
        return
    }

    ; ── 建立客戶端，儲存標頭後的剩餘資料 ──
    #{overflow=wrap}
    body-start = sep-pos + separator.len-bytes()
    remaining = raw.slice(body-start, total)

    rb str = with-len(SSE-BUF-SIZE)
    i <- [0..remaining.len-bytes()): {

        #{index-out=0, overflow=wrap}
        rb[i] = remaining[i]
    }
    cli = client {
        fd: fd
        tls-c: tls-c
        use-tls: use-tls
        connected: true
        host: host
        port: port
        path: path
        last-event-id: ''
        recv-buf: rb
        recv-buf-len: remaining.len-bytes()
    }

    client = cli
}

; ═══════════════════════════════════════════════
; SSE 服務端
; ═══════════════════════════════════════════════

; server: SSE 服務端監聽器
; fd: 監聽 socket 檔案描述符（-1=未開啟）
; host: 綁定的 IP 地址
; port: 監聽埠號
server {
    fd fd
    host str
    port i64
}

; server-conn: SSE 服務端客戶端連接
; fd: 客戶端 socket 檔案描述符（-1=未連接）
; connected: 連線狀態
server-conn {
    fd fd
    connected bool
}

; ═══════════════════════════════════════════════
; server 方法
; ═══════════════════════════════════════════════

; listen: 開始監聽
; host str: 綁定的 IP 地址（如 '0.0.0.0' 或 '127.0.0.1'）
; port i64: 監聽埠號
; 返回 ok bool: true=成功
server.listen = (host str, port i64) (ok bool) {
    ok = false
    .fd = -1
    .host = host
    .port = port
    fd = net.net-listen(host, port)
    fd < 0 -> return
    .fd = fd
    ok = true
}

; accept: 接受新的 SSE 客戶端連接並完成 HTTP 交握
; 返回 c ?server-conn: ok=已交握的客戶端, nil=失敗
server.accept = () (c ?server-conn) {
    c = nil
    .fd < 0 -> return
    client-fd = net.net-accept(.fd)
    client-fd < 0 -> return
    conn = server-conn {
        fd: client-fd
        connected: false
    }

    conn.handshake()
    conn.connected == false -> {
        conn.close()
        return
    }
    c = conn
}

; close: 關閉 SSE 服務端
server.close = () {
    .fd >= 0 -> {
        fs.close(.fd)
        .fd = -1
    }
}

; ═══════════════════════════════════════════════
; server-conn 方法
; ═══════════════════════════════════════════════

; handshake: 完成 SSE HTTP 交握
; 讀取客戶端 HTTP 請求，驗證方法為 GET，發送 SSE 回應標頭。
; 返回 ok bool: true=成功
server-conn.handshake = () (ok bool) {

    #{overflow=wrap}
    ok = false
    .fd < 0 -> return
    cr = number.char-to-str(13)
    lf = number.char-to-str(10)

    #{overflow=wrap}
    crlf = cr - lf

    #{overflow=wrap}
    separator = crlf - crlf

    ; 讀取 HTTP 請求（直到 \r\n\r\n）
    raw str = with-len(SSE-BUF-SIZE)
    total = 0
    sep-pos = -1

    !! {

        #{overflow=wrap}
        total + SSE-RECV-SIZE > SSE-BUF-SIZE -> return
        tmp str = with-len(SSE-RECV-SIZE)
        n = net.net-recv(.fd, tmp, SSE-RECV-SIZE)
        n <= 0 -> return
        i <- [0..n): {

            #{index-out=0, overflow=wrap}
            raw[total + i] = tmp[i]
        }

        #{overflow=wrap}
        total = total + n
        data = raw.slice(0, total)
        sep-pos = data.index(separator)
        sep-pos >= 0 -> *
    }

    ; 解析請求行
    head = raw.slice(0, sep-pos)
    first-line-end = head.index(crlf)
    request-line = head
    first-line-end >= 0 -> request-line = head.slice(0, first-line-end)

    ; 驗證方法為 GET
    sp1 = request-line.index(' ')
    sp1 < 0 -> return
    method = request-line.slice(0, sp1)

    #{overflow=wrap}
    method != 'GET' -> {

        #{overflow=wrap}
        resp = 'HTTP/1.1 405 Method Not Allowed' - crlf
        resp = resp - 'Content-Length: 0' - crlf
        resp = resp - 'Allow: GET' - crlf
        resp = resp - crlf
        net.net-send(.fd, resp, resp.len-bytes())
        return
    }

    ; 發送 SSE 回應標頭
    #{overflow=wrap}
    resp = 'HTTP/1.1 200 OK' - crlf

    #{overflow=wrap}
    resp = resp - 'Content-Type: text/event-stream' - crlf

    #{overflow=wrap}
    resp = resp - 'Cache-Control: no-cache' - crlf

    #{overflow=wrap}
    resp = resp - 'Connection: keep-alive' - crlf

    #{overflow=wrap}
    resp = resp - 'Access-Control-Allow-Origin: *' - crlf

    #{overflow=wrap}
    resp = resp - crlf
    written = net.net-send(.fd, resp, resp.len-bytes())
    written < 0 -> return
    .connected = true
    ok = true
}

; send-event: 發送 SSE 事件
; event str: 事件類型（空字串=不發送 event 欄位，使用預設 'message'）
; data str: 事件資料（可多行，每行以 data: 前綴發送）
; id str: 事件 ID（空字串=不發送 id 欄位）
; retry i64: 重連等待毫秒數（-1=不發送 retry 欄位）
; 返回 ok bool: true=成功
server-conn.send-event = (event str, data str, id str, retry i64) (ok bool) {

    #{overflow=wrap}
    ok = false
    .connected == false -> return
    lf = number.char-to-str(10)

    msg = ''

    #{overflow=wrap}
    event.len-bytes() > 0 -> msg = msg - 'event: ' - event - lf

    ; 處理多行 data（每行以 data: 前綴）
    #{overflow=wrap}
    {
        data.len-bytes() > 0 -> {
            pos = 0
            !! {

                #{overflow=wrap}
                nl = data.index-from(lf, pos)
                line-end = nl
                nl < 0 -> line-end = data.len-bytes()
                line = data.slice(pos, line-end)
                msg = msg - 'data: ' - line - lf
                nl < 0 -> *
                pos = nl + 1
            }
        }

        -> msg = msg - 'data: ' - lf
    }

    #{overflow=wrap}
    id.len-bytes() > 0 -> msg = msg - 'id: ' - id - lf

    #{overflow=wrap}
    retry >= 0 -> {

        #{overflow=wrap}
        retry-s = retry.to-str()
        msg = msg - 'retry: ' - retry-s - lf
    }

    ; 事件結束分隔符（空行）
    #{overflow=wrap}
    msg = msg - lf

    written = net.net-send(.fd, msg, msg.len-bytes())
    written < 0 -> {
        .connected = false
        return
    }
    ok = true
}

; send-comment: 發送 SSE 註解（用於心跳保活）
; comment str: 註解內容
; 返回 ok bool: true=成功
server-conn.send-comment = (comment str) (ok bool) {

    #{overflow=wrap}
    ok = false
    .connected == false -> return
    lf = number.char-to-str(10)

    #{overflow=wrap}
    msg = ':' - comment - lf - lf

    written = net.net-send(.fd, msg, msg.len-bytes())
    written < 0 -> {
        .connected = false
        return
    }
    ok = true
}

; is-connected: 檢查連線狀態
; 返回 yes bool: true=已連接
server-conn.is-connected = () (yes bool) {
    yes = .connected
}

; close: 關閉客戶端連接
server-conn.close = () {
    .fd >= 0 -> {
        fs.close(.fd)
        .fd = -1
    }
    .connected = false
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; listen-on: 建立 SSE 服務端並開始監聽
; host str: 綁定的 IP 地址（如 '0.0.0.0'）
; port i64: 監聽埠號
; 返回 s ?server: ok=服務端, nil=失敗
listen-on = (host str, port i64) (s ?server) {
    s = nil
    srv = server {}
    ok = false
    ok = srv.listen(host, port)
    ok -> s = srv
}
