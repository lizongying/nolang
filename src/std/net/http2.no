; http2 — HTTP/2.0 影格與連線管理（RFC 7540）
;
; 純 Nolang 實作，h2c（cleartext）prior knowledge 模式。
; 不支援 Upgrade 協商，直接送出 preface。
;
; 用法：
;   conn = connect(host, port)            // 返回 ?conn
;   resp = do('GET', 'http://host/path', '')  // 返回 ?http.response
; [http2](#http2)

; 常量
...

HTTP2-FRAME-HEADER-SIZE = 9
HTTP2-MAX-PAYLOAD = 16384
HTTP2-DEFAULT-WINDOW = 65535
HTTP2-INITIAL-STREAM-ID = 1
HTTP2-DEFAULT-PORT = 80
HTTP2-DEFAULT-TLS-PORT = 443

; 影格類型
; [FRAME-DATA](#http2.frame-data)
FRAME-DATA = 0
FRAME-HEADERS = 1
FRAME-PRIORITY = 2
FRAME-RST-STREAM = 3
FRAME-SETTINGS = 4
FRAME-PUSH-PROMISE = 5
FRAME-PING = 6
FRAME-GOAWAY = 7
FRAME-WINDOW-UPDATE = 8
FRAME-CONTINUATION = 9

; 旗標
; [FLAG-END-STREAM](#http2.flag-end-stream)
FLAG-END-STREAM = 1
FLAG-ACK = 1
FLAG-END-HEADERS = 4
FLAG-PADDED = 8
FLAG-PRIORITY = 32

; 結構體
...

; frame: HTTP/2 影格
; [frame](#http2.frame)
frame {
    length i64
    frame-type i64
    flags i64
    stream-id i64
    payload str
}

; 影格長度（24-bit）
; 影格類型（8-bit）
; 旗標（8-bit）
; 串流 ID（31-bit）
; 影格資料

; conn: HTTP/2 連線
; [conn](#http2.conn)
conn {
    fd fd
    hpack hpack.tables
    next-stream-id i64
    send-window i64
    recv-window i64
    initialized bool
    use-tls bool
    tls-c tls.conn
}

; 影格解析/序列化
...

; 從 data 的 pos 位置解析 9-byte 影格標頭
; 返回 next-pos: ok=下一個位置, nil=錯誤
; data: HTTP/2 位元組流（自 pos 起解析一筆 9 位元組影格標頭）
; pos: 本次影格標頭在 data 中的起始位移
; next-pos: ok=標頭之後的位移, nil=資料不足/解析失敗
; [parse](#http2.frame.parse)
frame.parse = (data str, pos i64) (next-pos ?i64) {
    next-pos = nil

    #{overflow=wrap}
    pos + HTTP2-FRAME-HEADER-SIZE > data.len-bytes() -> return; 24-bit length（big-endian）

    #{overflow=wrap}
    .length = (data.byte(pos) << 16) | (data.byte(pos + 1) << 8) | data.byte(pos + 2)

    #{overflow=wrap}
    .frame-type = data.byte(pos + 3): {
        ok -> it

        ->
    }

    ; 31-bit stream-id（big-endian，高位保留）
    #{overflow=wrap}
    .flags = data.byte(pos + 4): {
        ok -> it

        ->
    }

    #{overflow=wrap}
    .stream-id = ((data.byte(pos + 5) & 127) << 24) | (data.byte(pos + 6) << 16) | (data.byte(pos + 7) << 8) | data.byte(pos + 8)

    #{overflow=wrap}
    next-pos = pos + HTTP2-FRAME-HEADER-SIZE
}

; 將影格標頭序列化到 buf 的 pos 位置
; 返回 next-pos=下一個位置
; buf: 輸出緩衝（於 buf[pos..] 寫入 9 位元組影格標頭）
; pos: 本次影格標頭寫入 buf 的起始位移
; next-pos: 序列化完成後下一個可寫位移
; [serialize](#http2.frame.serialize)
frame.serialize = (buf str, pos i64) (next-pos i64) {
    buf[pos]: {
        ok -> it = (.length >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 1]: {
        ok -> it = (.length >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 2]: {
        ok -> it = .length & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 3]: {
        ok -> it = .frame-type & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 4]: {
        ok -> it = .flags & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 5]: {
        ok -> it = (.stream-id >> 24) & 127

        -> _
    }

    #{overflow=wrap}
    buf[pos + 6]: {
        ok -> it = (.stream-id >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 7]: {
        ok -> it = (.stream-id >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 8]: {
        ok -> it = .stream-id & 255

        -> _
    }

    #{overflow=wrap}
    next-pos = pos + HTTP2-FRAME-HEADER-SIZE
}

; 連線管理
...

; 初始化連線狀態
; [init](#http2.conn.init)
conn.init = () {
    .fd = -1
    .next-stream-id = HTTP2-INITIAL-STREAM-ID
    .send-window = HTTP2-DEFAULT-WINDOW
    .recv-window = HTTP2-DEFAULT-WINDOW
    .initialized = false
    .hpack.init()
    .initialized = true
}

; 發送影格到 socket
; 返回 ok=true=成功
; frame: 待發送的影格（經 serialize 寫出 9 位元組標頭與載荷）
; ok: true=已寫入 socket, false=寫入錯誤
; [send-frame](#http2.conn.send-frame)
conn.send-frame = (frame frame) (ok bool) {
    ok = false
    .fd < 0 -> return

    ; 序列化標頭
    hdr str = with-len(HTTP2-FRAME-HEADER-SIZE)
    frame.serialize(hdr, 0)

    ; 發送標頭
    written = 0
    {
        .use-tls -> {
            w = .tls-c.send(hdr)
            w: {
                nil -> return

                err -> return

                -> _
            }
        }

        -> {
            written = net.net-send(.fd, hdr, HTTP2-FRAME-HEADER-SIZE)
            written != HTTP2-FRAME-HEADER-SIZE -> return
        }
    }

    ; 發送 payload
    frame.payload.len-bytes() > 0 -> .use-tls -> {
        w = .tls-c.send(frame.payload)
        w: {
            nil -> return

            err -> return

            -> _
        }
    } -> {
        written = net.net-send(.fd, frame.payload, frame.payload.len-bytes())
        written != frame.payload.len-bytes() -> return
    }
    ok = true
}

; 從 socket 接收影格
; 返回 frame: ok=接收到的影格, nil=失敗
; [recv-frame](#http2.conn.recv-frame)
conn.recv-frame = () (frame ?frame) {
    frame = nil
    f frame
    .fd < 0 -> return

    ; 讀取 9-byte 影格標頭
    hdr-buf str = with-len(HTTP2-FRAME-HEADER-SIZE)
    hdr-total = 0
    recv-n = 0
    !! {
        hdr-total >= HTTP2-FRAME-HEADER-SIZE -> break
        {
            .use-tls -> {

                #{overflow=wrap}
                recv-n = .tls-c.recv(hdr-buf, HTTP2-FRAME-HEADER-SIZE - hdr-total)
            }

            -> {

                #{overflow=wrap}
                recv-n = net.net-recv(.fd, hdr-buf, HTTP2-FRAME-HEADER-SIZE - hdr-total)
            }
        }
        recv-n <= 0 -> return

        ; net-recv 覆寫 buf[0]，需要位移複製
        i <- [0..recv-n): {

            #{overflow=wrap}
            hdr-buf[hdr-total + i]: {
                ok -> it = hdr-buf.byte(i)

                -> _
            }
        }

        #{overflow=wrap}
        hdr-total ?= hdr-total + recv-n
    }

    ; 解析標頭
    np = f.parse(hdr-buf, 0)
    np: {
        nil -> return

        -> _
    }

    ; 讀取 payload
    ; ⚠️ 2026-11-12：原本直接寫 `f.payload[payload-total + i] ?= f.payload.byte(i)`，
    ; 但「**結構體欄位（str）的下標寫入**」在目前 codegen 下是**靜默丟棄**的
    ; （place-match 與 `?=` 兩種寫法都不落地，實測見 tmp/sh/h18.no：
    ; 局部 str 寫入正常、結構體欄位寫入恆為 0）。所以 payload 先收到**局部** str，
    ; 全部讀完再整條賦回 f.payload（len 也隨之帶過去）。
    f.length > 0 -> {
        f.length > HTTP2-MAX-PAYLOAD -> return
        pl str = with-len(f.length)
        payload-total = 0
        !! {
            payload-total >= f.length -> break
            {
                .use-tls -> {

                    #{overflow=wrap}
                    recv-n = .tls-c.recv(pl, f.length - payload-total)
                }

                -> {

                    #{overflow=wrap}
                    recv-n = net.net-recv(.fd, pl, f.length - payload-total)
                }
            }
            recv-n <= 0 -> return
            i <- [0..recv-n): {

                #{overflow=wrap}
                pl[payload-total + i]: {
                    ok -> it = pl.byte(i)

                    -> _
                }
            }

            #{overflow=wrap}
            payload-total ?= payload-total + recv-n
        }
        f.payload = pl
    }
    frame = f
}

; 發送空 SETTINGS 影格
; ack: true=附 FLAG-ACK（回應對方設定的 SETTINGS ACK）, false=發出帶參設定的空 SETTINGS
; ok: true=發送成功
; [send-settings](#http2.conn.send-settings)
conn.send-settings = (ack bool) (ok bool) {
    ok = false
    f frame
    f.length = 0
    f.frame-type = FRAME-SETTINGS
    {
        ack -> f.flags = FLAG-ACK

        -> f.flags = 0
    }
    f.stream-id = 0
    ok = .send-frame(f)
}

; 發送 HEADERS 影格
; stream-id: 本 HEADERS 影格所屬的串流識別號
; names: 標頭字段名陣列，與 values 同下標配對
; values: 標頭字段值陣列
; count: 有效標頭條目數（只編碼前 count 對）
; end-stream: true=附加 END_STREAM 旗標，表示本串流不再發送資料
; ok: true=HPACK 編碼並發送成功
; [send-headers](#http2.conn.send-headers)
conn.send-headers = (stream-id i64, names [64]str, values [64]str, count i64, end-stream bool) (ok bool) {
    ok = false

    ; 用 HPACK 編碼標頭
    block str = with-len(HTTP2-MAX-PAYLOAD)
    block-n = 0
    i <- [0..count): {
        {
            ; 用 slice 載入值（避開 IndexExpression codegen 問題）
            name-sw ?= names[i]
            value-sw ?= values[i]

            nlen = name-sw.len-bytes()
            vlen = value-sw.len-bytes()

            n str = name-sw.slice(0, nlen)
            v str = value-sw.slice(0, vlen)
            hdr-out = ' '
            hdr-out = .hpack.encode-header(n, v)

            ; 複製到 block
            j <- [0..hdr-out.len-bytes()): {

                #{overflow=wrap}
                block[block-n + j]: {
                    ok -> it = hdr-out.byte(j)

                    -> _
                }
            }

            #{overflow=wrap}
            block-n = block-n + hdr-out.len-bytes()
        }: {
            err -> _

            -> _
        }
    }

    ; 構建 HEADERS 影格
    f frame
    f.length = block-n
    f.frame-type = FRAME-HEADERS
    f.flags = FLAG-END-HEADERS
    end-stream -> f.flags = f.flags | FLAG-END-STREAM
    f.stream-id = stream-id
    f.payload = block
    f.payload.len = block-n
    ok = .send-frame(f)
}

; 發送 DATA 影格
; stream-id: DATA 影格所屬的串流識別號
; data: 放進 DATA 影格載荷的內容
; end-stream: true=附加 END_STREAM 旗標（表示主體已送完）
; ok: true=發送成功
; [send-data](#http2.conn.send-data)
conn.send-data = (stream-id i64, data str, end-stream bool) (ok bool) {
    ok = false
    n = data.len-bytes()
    f frame
    f.length = n
    f.frame-type = FRAME-DATA
    {
        end-stream -> f.flags = FLAG-END-STREAM

        -> f.flags = 0
    }
    f.stream-id = stream-id
    f.payload = data
    ok = .send-frame(f)
}

; 高層 API
...

; 建立 HTTP/2 h2c 連線
; 送出 preface + SETTINGS，接收並 ACK 伺服器 SETTINGS
; 返回 conn: ok=連線, nil=失敗
; host: 目標伺服器的主機名或 IP
; port: 目標 TCP 埠號（h2c 純文字連線）
; [connect](#http2.connect)
connect = (host str, port i64) (conn ?conn) {
    conn = nil
    fd = net.net-dial(host, port)
    fd < 0 -> return
    c conn
    c.init()
    c.fd = fd

    ; 1. 送出連線 preface
    cr = '\r'
    lf = '\n'

    preface = 'PRI * HTTP/2.0' - cr - lf - cr - lf - 'SM' - cr - lf - cr - lf
    written = net.net-send(fd, preface, preface.len-bytes())
    written != preface.len-bytes() -> {
        fs.close(fd)
        return
    }

    ; 2. 送出空 SETTINGS
    send-ok = false
    send-ok = c.send-settings(false)
    send-ok == false -> {
        fs.close(fd)
        return
    }

    ; 3. 接收伺服器 SETTINGS 並 ACK
    ; ⚠️ 2026-11-12：舊寫法是 `recv-f = c.recv-frame()` 後只留一句殘餘的
    ; `send-ok == false -> { ... }`，既沒檢查 nil（連線壞了也當成功），
    ; 也沒真的送出 ACK（註釋寫了 ACK 但沒有對應動作）。改為三分支檢查 +
    ; 收到非 ACK 的 SETTINGS 就回 ACK。
    recv-f = c.recv-frame()
    recv-f: {
        nil -> {
            fs.close(fd)
            return
        }

        err -> {
            fs.close(fd)
            return
        }

        ok -> {
            f0 frame = it
            f0.frame-type == FRAME-SETTINGS -> {
                (f0.flags & FLAG-ACK) == 0 -> {
                    ack-ok = c.send-settings(true)
                    ack-ok == false -> {
                        fs.close(fd)
                        return
                    }
                }
            }
        }
    }
    conn = c
}

; 建立 HTTP/2 over TLS 連線
; 先建立 TLS 連線，再送出 HTTP/2 preface + SETTINGS
; 返回 conn: ok=連線, nil=失敗
; host: 目標伺服器的主機名或 IP
; port: 目標 TLS 埠號（通常 443）
; [connect-tls](#http2.connect-tls)
connect-tls = (host str, port i64) (conn ?conn) {
    conn = nil

    ; 1. 建立 TLS 連線
    tls-c tls.conn
    tls-c.init()
    ok2 = tls-c.connect(host, port)
    ok2 == false -> return
    c conn
    c.init()
    c.use-tls = true
    c.tls-c = tls-c
    c.fd = tls-c.fd

    ; 2. 送出連線 preface（透過 TLS）
    cr = '\r'
    lf = '\n'

    preface = 'PRI * HTTP/2.0' - cr - lf - cr - lf - 'SM' - cr - lf - cr - lf
    w = tls-c.send(preface)
    w: {
        nil -> {
            tls-c.close()
            return
        }

        err -> {
            tls-c.close()
            return
        }

        ok -> it != preface.len-bytes()
    }

    ; 3. 送出空 SETTINGS
    send-ok = c.send-settings(false)
    send-ok == false -> {
        tls-c.close()
        return
    }

    ; 4. 接收伺服器 SETTINGS 並 ACK
    recv-f ?= c.recv-frame()
    {
        recv-f.frame-type == FRAME-SETTINGS -> {
            (recv-f.flags & FLAG-ACK) == 0 -> {
                ack-ok = c.send-settings(true)
                ack-ok == false -> {
                    tls-c.close()
                    return
                }
            }
        }
    }
    conn = c
}

; 關閉連線（自動處理 TLS/明文）
; [close](#http2.conn.close)
conn.close = () {
    {
        .use-tls -> .tls-c.close()

        .fd >= 0 -> fs.close(.fd)
    }
    .fd = -1
}

; 執行 HTTP/2 請求
; method: 'GET'/'POST'/'PUT'/'DELETE'/'PATCH'
; path: 請求路徑
; host: 主機名（用於 :authority 標頭）
; body: 請求主體（空字串=無主體）
; 返回 resp=回應, ok=true=成功
; names: 回應標頭名稱輸出陣列（至多 header-count 筆）
; values: 回應標頭值輸出陣列（與 names 一一對應）
; header-count: 實際解析到的回應標頭筆數
; resp-body: 回應主體（各 DATA 影格內容串接）
; resp-n: 回應主體的位元組長度
; ok: true=請求順利完成, false=連線/解析失敗
; [request](#http2.conn.request)
conn.request = (method str, path str, host str, body str) (names [32]str, values [32]str, header-count i64, resp-body str, resp-n i64, ok bool) {
    ok = false
    header-count = 0
    resp-n = 0
    resp-body str = with-len(HTTP2-MAX-PAYLOAD)
    .fd < 0 -> return
    stream-id = .next-stream-id

    #{overflow=wrap}
    .next-stream-id = .next-stream-id + 2: {
        ok -> it

        ->
    }

    ; 構建標頭
    hdr-names [64]str
    hdr-values [64]str
    hdr-count = 0

    ; :method
    hdr-names[0]: {
        ok -> it = ':method'

        -> _
    }

    hdr-values[0]: {
        ok -> it = method

        -> _
    }
    hdr-count = 1

    ; :path
    hdr-names[1]: {
        ok -> it = ':path'

        -> _
    }

    hdr-values[1]: {
        ok -> it = path

        -> _
    }
    hdr-count = 2

    ; :scheme
    hdr-names[2]: {
        ok -> it = ':scheme'

        -> _
    }

    hdr-values[2]: {
        ok -> it = 'http'

        -> _
    }
    hdr-count = 3

    ; :authority
    hdr-names[3]: {
        ok -> it = ':authority'

        -> _
    }

    hdr-values[3]: {
        ok -> it = host

        -> _
    }
    hdr-count = 4

    ; body 長度
    has-body = false
    body-len = body.len-bytes()
    body-len > 0 -> {
        has-body = true

        ; content-length
        hdr-names[4]: {
            ok -> it = 'content-length'

            -> _
        }
        blen-str = body-len.to-str()

        hdr-values[4]: {
            ok -> it = blen-str

            -> _
        }
        hdr-count = 5
    }

    ; 發送 HEADERS
    end-stream = false
    has-body == false -> end-stream = true
    send-ok = false
    send-ok = .send-headers(stream-id, hdr-names, hdr-values, hdr-count, end-stream)
    send-ok == false -> return

    ; 發送 DATA（如果有主體）
    has-body -> {
        send-ok = .send-data(stream-id, body, true)
        send-ok == false -> return
    }

    ; 接收回應影格
    ; ⚠️ 2026-11-12：原本迴圈末尾是 `-> return`（未知影格類型一律當失敗返回）。
    ; 實測（tmp/sh/h27.no 對真 Node h2c 伺服器）送完 HEADERS 後收到的**第一個**
    ; 影格是 `type=4 flags=1`（SETTINGS+ACK，伺服器對我們 SETTINGS 的回應），
    ; 之後才依序是 HEADERS(flags=4)、DATA(flags=1)。所以舊寫法第一個影格就
    ; `return` ⇒ ok 永远 false。改為：控制類影格（SETTINGS/PING/WINDOW-UPDATE/
    ; 未知）一律跳過並繼續讀，只有 RST-STREAM/GOAWAY 才算失敗。
    ; 另兩個同批修掉的坑：
    ;   1. 外層迴圈變數原用 `i`，與下面 HPACK 複製的內層 `i <- [0..dec-count)`
    ;      同名遮蔽，外層迭代被覆寫後會反覆重讀 ⇒ 對端不再發影格時掛死；
    ;      外層改名 `fi`。
    ;   2. `break` 埋在兩層 match 內不會真的跳出外層迴圈，改用 `done` 旗標。
    done = false
    fi <- [0..64): {
        done -> break
        f frame
        recv-f = .recv-frame()
        recv-f: {
            nil -> return

            err -> return

            ok -> f = it
        }
        {
            f.frame-type == FRAME-HEADERS -> {

                ; 用 HPACK 解碼標頭
                dec-names [128]str
                dec-values [128]str
                dec-count = 0
                dec-ok = false
                dec-names, dec-values, dec-count, dec-ok = .hpack.decode-headers(f.payload)
                dec-ok == false -> return

                ; 複製到輸出（最多 32 項）
                i <- [0..dec-count): {
                    i >= 32 -> break

                    {
                        name-sw ?= dec-names[i]
                        value-sw ?= dec-values[i]

                        names[i] = name-sw.slice(0, name-sw.len-bytes())
                        values[i] = value-sw.slice(0, value-sw.len-bytes())
                    }: {
                        err -> _

                        -> _
                    }
                }
                {
                    dec-count <= 32 -> header-count = dec-count

                    -> header-count = 32
                }

                ; 檢查 END_STREAM
                (f.flags & FLAG-END-STREAM) != 0 -> {
                    ok = true
                    done = true
                }
            }

            f.frame-type == FRAME-DATA -> {

                ; 複製到 resp-body
                i <- [0..f.payload.len-bytes()): {

                    #{overflow=wrap}
                    resp-body[resp-n + i]: {
                        ok -> it = f.payload.byte(i)

                        -> _
                    }
                }

                #{overflow=wrap}
                resp-n = resp-n + f.payload.len-bytes()
                (f.flags & FLAG-END-STREAM) != 0 -> {
                    ok = true
                    done = true
                }
            }

            f.frame-type == FRAME-RST-STREAM -> {

                ; 伺服器重設串流
                return
            }

            f.frame-type == FRAME-GOAWAY -> {

                ; 伺服器關閉連線
                return
            }

            f.frame-type == FRAME-SETTINGS -> {

                ; 對端 SETTINGS：非 ACK 就回一個 ACK，然後繼續等真正的回應
                (f.flags & FLAG-ACK) == 0 -> .send-settings(true)
            }

            f.frame-type == FRAME-PING -> {

                ; 對端 PING：非 ACK 就原樣回 8 位元組載荷的 ACK
                (f.flags & FLAG-ACK) == 0 -> {
                    pf frame
                    pf.length = 8
                    pf.frame-type = FRAME-PING
                    pf.flags = FLAG-ACK
                    pf.stream-id = 0
                    pf.payload = f.payload
                    pf.payload.len = 8
                    .send-frame(pf)
                }
            }

            ; WINDOW-UPDATE 與未知類型：忽略，繼續讀下一個影格
            -> _
        }
    }
}

; HTTP/2 h2c 便捷函數
; method: 'GET'/'POST'/'PUT'/'DELETE'/'PATCH'
; url: 'http://host:port/path'（port 可選，預設 80）
; body: 請求主體（空字串=無主體）
; 返回 names/values/header-count=回應標頭, resp-body/resp-n=回應主體, ok=true=成功
; names: 回應標頭名稱輸出陣列
; values: 回應標頭值輸出陣列（與 names 一一對應）
; header-count: 實際解析到的回應標頭筆數
; resp-body: 回應主體
; resp-n: 回應主體的位元組長度
; ok: true=請求順利完成, false=連線/解析失敗
; [do](#http2.do)
do = (method str, url-str str, body str) (names [32]str, values [32]str, header-count i64, resp-body str, resp-n i64, ok bool) {
    ok = false
    header-count = 0
    resp-n = 0

    ; ⚠️ 2026-11-12：舊版在函數開頭又宣告了一次 `names [32]str` / `values [32]str`，
    ; 把**結果參數**遮蔽成區域陣列；結尾只 `connect` 之後 `conn: { -> }` 就返回，
    ; **從未呼叫 conn.request** ⇒ do/do-req/get/post/put/delete/patch 全部恒為失敗。
    ; 這裡改為：連線成功後真正發請求、把六個輸出整體接過來，再關閉連線。
    resp-body = ''

    ; 解析 URL
    ; ⚠️ 2026-11-12：舊版手寫 scheme/port 解析，用 `u[i] != prefix[i]` 逐字比對。
    ; `str[i]`（IndexExpression）拿到的是 **?char**，兩個 option 直接 `!=` 的語義
    ; 不可靠（實測永遠朝「前綴匹配」方向走），於是 'https://' 的判斷在先、
    ; 把 http URL 誤判成 https ⇒ 去掉 8 個字元、host 變空、connect 失敗。
    ; 改用 net/url 的 url-parse（已有測試覆蓋），只做 scheme→use-tls/port 的映射。
    ui url.url-info = url.url-parse(url-str)
    ui.ok == false -> return

    host = ui.host
    path = ui.path
    ui.query.len-bytes() > 0 -> path = path - '?' - ui.query
    use-tls = ui.scheme == 'https'
    port = ui.port
    port <= 0 -> {
        {
            use-tls -> port = HTTP2-DEFAULT-TLS-PORT

            -> port = HTTP2-DEFAULT-PORT
        }
    }

    ; 建立連線並發請求
    ; ⚠️ 2026-11-12：不要寫成 `co ?conn = nil` 再在條件塊裡賦值——這種「先宣告
    ; option 變數、後有條件賦值」的寫法在本版 MIR 會把 conn 的全套方法
    ; （含 tls.conn.recv 的分支）都拖進 codegen，觸發
    ; `EmitLLVM: unknown callee tls.conn.recv`（見 tmp/sh/h51.no）。
    ; 所以兩條連線路徑各自就地推斷型別並匹配。
    {
        use-tls -> {
            cs = connect-tls(host, port)
            cs: {
                nil -> return

                err -> return

                ok -> {
                    cn conn = it
                    names, values, header-count, resp-body, resp-n, ok = cn.request(method, path, host, body)
                    cn.close()
                }
            }
        }

        -> {
            cs = connect(host, port)
            cs: {
                nil -> return

                err -> return

                ok -> {
                    cn conn = it
                    names, values, header-count, resp-body, resp-n, ok = cn.request(method, path, host, body)
                    cn.close()
                }
            }
        }
    }
}

; 便捷函數（返回 http.response）
...

; HTTP/2 請求，返回 ?http.response
; method: 'GET'/'POST'/'PUT'/'DELETE'/'PATCH'
; url: 'http://host:port/path'
; body: 請求主體（空字串=無主體）
; 返回 resp: ok=回應, nil=失敗
; [do-req](#http2.do-req)
do-req = (method str, url str, body str) (resp ?http.response) {
    resp = nil
    r http.response
    names [32]str
    values [32]str
    header-count = 0
    raw-body = ''
    body-n = 0
    ok = false
    names, values, header-count, raw-body, body-n, ok = do(method, url, body)
    ok == false -> return

    ; 複製標頭到 r（用 slice 載入值）
    r.header-count = header-count
    i <- [0..header-count): {
        {
            name-sw ?= names[i]
            value-sw ?= values[i]

            nlen = name-sw.len-bytes()
            vlen = value-sw.len-bytes()

            r.header-names[i] ?= name-sw.slice(0, nlen)
            r.header-values[i] ?= value-sw.slice(0, vlen)

            ; 尋找 :status（固定 7 個字元）
            nlen == 7 -> {
                is-status = 1
                status-hdr = ':status'
                j <- [0..7): {
                    name-sw[j] != status-hdr[j] -> {
                        is-status = 0
                        break
                    }
                }
                is-status == 1 -> {
                    r.status-code = 0
                    j <- [0..vlen): {
                        {
                            #{overflow=wrap}
                            digit ?= value-sw[j]

                            #{overflow=wrap}
                            r.status-code = r.status-code * 10 + (digit - 48)
                        }: {
                            err -> _

                            -> _
                        }
                    }

                    r.status-text = value-sw.slice(0, vlen)
                }
            }
        }: {
            err -> _

            -> _
        }
    }

    ; 複製 body
    body-n > 0 -> r.body = raw-body.slice(0, body-n)
    resp = r
}

; HTTP/2 GET 請求
; 返回 resp: ok=回應, nil=失敗
; url: 請求位址 'http://host:port/path'（port 可省，預設 80）
; [get](#http2.get)
get = (url str) (resp ?http.response) {
    resp = do-req('GET', url, '')
}

; HTTP/2 POST 請求
; 返回 resp: ok=回應, nil=失敗
; url: 請求位址
; body: 請求主體（空字串=無主體）
; [post](#http2.post)
post = (url str, body str) (resp ?http.response) {
    resp = do-req('POST', url, body)
}

; HTTP/2 PUT 請求
; 返回 resp: ok=回應, nil=失敗
; url: 請求位址
; body: 請求主體（空字串=無主體）
; [put](#http2.put)
put = (url str, body str) (resp ?http.response) {
    resp = do-req('PUT', url, body)
}

; HTTP/2 DELETE 請求
; 返回 resp: ok=回應, nil=失敗
; url: 請求位址 'http://host:port/path'
; [delete](#http2.delete)
delete = (url str) (resp ?http.response) {
    resp = do-req('DELETE', url, '')
}

; HTTP/2 PATCH 請求
; 返回 resp: ok=回應, nil=失敗
; url: 請求位址
; body: 請求主體（空字串=無主體）
; [patch](#http2.patch)
patch = (url str, body str) (resp ?http.response) {
    resp = do-req('PATCH', url, body)
}
