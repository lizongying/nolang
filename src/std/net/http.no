; http — HTTP/1.1 客戶端（含 REST 支援）
;
; 提供簡易的 HTTP/1.1 用戶端，支援 GET、POST、PUT、DELETE、PATCH 等方法。
; 支援自訂標頭、回應標頭解析。
; 底層使用 net.no 的 built-in 函數（net-dial、net-send、net-recv、close）。
;
; 用法：
;   resp = get('http://example.com/path')   // 返回 ?response
;   resp: {
;       nil -> print('request failed')
;       -> print(resp.status-code)
;         print(resp.body)
;         ct = resp.get-header('Content-Type')  // 返回 ?str
;   }
;
;   resp = post('http://example.com/api', '{"key":"value"}')
;
;   // 一般請求
;   resp = do('PUT', 'http://example.com/item', 'data')
;
;   // 自訂請求（含標頭）
;   req = request{}
;   req.init('PUT', 'http://example.com/item', 'data')
;   req.add-header('Content-Type', 'application/json')
;   req.add-header('Authorization', 'Bearer token123')
;   resp = do-req(req)

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; 接收緩衝區大小
; 必須 ≥ TLS 單筆記錄最大明文 (2^14 = 16384 位元組)。否則 tls.conn.recv 在
; copy-n > n 時會靜默丟棄超過 n 的位元組，造成回應中段缺漏（見 tls.no recv）。
; 使用 16640 (= 16384 + 256 餘量，與 tls 內部 rec 緩衝區一致) 確保單筆記錄完整。
HTTP-BUF-SIZE = 16640

; 最大回應大小
HTTP-MAX-RESPONSE = 16384

; 預設 HTTP 埠號
HTTP-DEFAULT-PORT = 80

; 預設 HTTPS 埠號
HTTPS-DEFAULT-PORT = 443

; 請求最大自訂標頭數
HTTP-MAX-REQ-HEADERS = 16

; 回應最大解析標頭數
HTTP-MAX-RESP-HEADERS = 32

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; request: HTTP 請求（支援自訂標頭）
; headers: 標頭行陣列，每行格式 'Name: Value'
; header-count: 已加入的標頭數
request {
    method str
    url str
    body str
    headers [16]str
    header-count i64
}

; response: HTTP 回應
; status-code: 狀態碼（如 200、404）
; status-text: 狀態文字（如 OK、Not Found）
; headers: 回應標頭（原始字串，含多行，向後相容）
; header-names/header-values: 解析後的標頭名/值（parse-headers 填入）
; header-count: 解析後的標頭數
; body: 回應主體
response {
    status-code i64
    status-text str
    headers str
    header-names [32]str
    header-values [32]str
    header-count i64
    body str
}

; ═══════════════════════════════════════════════
; request 方法
; ═══════════════════════════════════════════════

; init: 初始化請求
; method: HTTP 方法（GET、POST、PUT、DELETE、PATCH 等）
; url: 完整 URL
; body: 請求主體（GET/DELETE 可傳空字串）
request.init = (method str, url str, body str) {
    .method = method
    .url = url
    .body = body
    .header-count = 0
    i <- [0..HTTP-MAX-REQ-HEADERS): {

        ; 用空格字串初始化 headers[i]，使 data buffer 非 null
        .headers[i] = ' '

        .headers[i].len = 0
    }
}

; add-header: 新增自訂標頭
; 將 name 與 value 組裝成 'Name: Value' 存入 headers 陣列
; 返回 ok=true=成功, false=標頭數已滿
request.add-header = (name str, value str) (ok bool) {

    ok = false
    .header-count >= HTTP-MAX-REQ-HEADERS -> return
    idx = .header-count

    ; 用字串串接組裝 'Name: Value'（建立獨立緩衝區，避免逐位元組寫入溢出）
    .headers[idx] = name - ': ' - value

    #{overflow=wrap}
    .header-count = idx + 1
    ok = true
}

; ═══════════════════════════════════════════════
; response 方法
; ═══════════════════════════════════════════════

; parse-headers: 將 headers 字串拆分到 header-names / header-values
; 必須在 headers 欄位被填入後呼叫（do / do-req 內部會自動呼叫）
response.parse-headers = () {

    .header-count = 0

    ; 初始化標頭陣列（用空格字串使 data buffer 非 null）
    i <- [0..HTTP-MAX-RESP-HEADERS): {

        .header-names[i] = ' '

        .header-names[i].len = 0

        .header-values[i] = ' '

        .header-values[i].len = 0
    }
    hs = .headers
    n = hs.len-bytes()
    n == 0 -> return
    cr = '\r'
    lf = '\n'

    crlf = cr - lf

    pos = 0
    !! {

        pos >= n -> *

        ; 找下一個 CRLF
        next-crlf = hs.index-from(crlf, pos)
        line-end = next-crlf
        line-end < 0 -> line-end = n

        ; 在 [pos, line-end) 中找 ': '
        colon-pos = hs.index-from(': ', pos)

        #{overflow=wrap}
        colon-pos >= 0 && colon-pos < line-end -> {
            cnt = .header-count
            cnt < HTTP-MAX-RESP-HEADERS -> {

                ; 用 slice 複製 name/value（建立獨立緩衝區，避免逐位元組寫入溢出）
                name-str = hs.slice(pos, colon-pos)

                .header-names[cnt] = name-str
                val-str = hs.slice(colon-pos + 2, line-end)

                .header-values[cnt] = val-str
                .header-count = cnt + 1
            }
        }
        next-crlf < 0 -> *

        #{overflow=wrap}
        pos = next-crlf + 2
    }
}

; get-header: 取得指定標頭值（線性搜尋）
; name: 標頭名（如 'Content-Type'）
; 返回 val ?str: ok=標頭值, nil=未找到
response.get-header = (name str) (val ?str) {
    val = nil
    cnt = .header-count
    i <- [0..cnt): {

        ; 直接存取 .header-names[i] 比較（避免 local str 從陣列元素賦值的 codegen 限制）
        matched = 1
        .header-names[i].len-bytes() != name.len-bytes() -> {

            matched = 0
        }

        ; ⚠️ `{ arms }` 是 if/else-if 短路群組：**只有第一個條件成立的臂會執行**
        ; （見 docs/docs/lang/syntax.md「short-circuit if-else group」）。
        ; 這裡原本寫了兩個連續的 `matched == 1 ->` 臂，第二個永遠不會執行，
        ; 導致 get-header 永遠回傳 nil。改成巢狀：先比較，命中才取值。
        {
            matched == 1 -> {
                j <- [0..name.len-bytes()): {
                    .header-names[i][j] != name.byte(j) -> {
                        matched = 0
                        break
                    }
                }
                matched == 1 -> {

                    ; 用 slice 複製值到 val（slice 是 CallExpression，正確載入 str-long value）
                    vlen = .header-values[i].len-bytes()

                    val = .header-values[i].slice(0, vlen)
                    return
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 主要 API
; ═══════════════════════════════════════════════

; do: 執行 HTTP 請求
; method: HTTP 方法（GET、POST、PUT、DELETE 等）
; url: 完整 URL（如 http://host:port/path）
; body: 請求主體（GET 應傳空字串）
; 返回 resp ?response: ok=回應, nil=失敗
do = (method str, url str, body str) (resp ?response) {

    resp = nil
    r response

    ; ── 字串變數（頂層宣告，供 if 區塊內使用）──
    ; scheme 初始化為空字串，在 URL 解析分支中只賦值一次（避免重新賦值觸發 double-free）
    scheme-len = 7
    rest = ''
    host = ''
    port i64 = HTTP-DEFAULT-PORT
    path str
    host-only = ''
    port-str = ''
    cr = '\r'
    lf = '\n'

    crlf = cr - lf
    req = ''
    len-str = ''
    buf str = with-len(HTTP-BUF-SIZE)
    raw = ''
    total = 0
    recv-raw = ''

    separator = crlf - crlf
    head = ''
    status-line = ''
    after-code = ''
    code-str = ''
    use-tls = false
    fd fd = -1
    tls-c tls.conn
    written = 0
    n = 0

    ; ── 解析 URL ──
    {
        url.starts-with('https://') -> {
            use-tls = true
            scheme-len = 8
            port = HTTPS-DEFAULT-PORT
        }

        url.starts-with('http://') == false && url.starts-with('https://') == false -> return
    }
    rest = url.slice(scheme-len, url.len-bytes())

    ; 分離 host[:port] 與 path（找到第一個 /）
    slash-pos = rest.index('/')
    {
        slash-pos < 0 -> {
            host = rest
            path = '/'
        }

        -> {
            host = rest.slice(0, slash-pos)
            path = rest.slice(slash-pos, rest.len-bytes())
        }
    }

    ; 檢查 host 是否含 :port
    colon-pos = host.index(':')

    #{overflow=wrap}
    colon-pos >= 0 -> {

        host-only = host.slice(0, colon-pos)

        #{overflow=wrap}
        port-str = host.slice(colon-pos + 1, host.len-bytes())
        p = 0
        i <- [0..port-str.len-bytes()): {

            c = port-str[i]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            p = p * 10 + c - 48
        }
        port = p
        host = host-only
    }
    host.len-bytes() == 0 -> return

    ; ── 建立連接 ──
    {
        use-tls -> {
            tls-c.init()
            ok2 = tls-c.connect(host, port)
            ok2 == false -> {

                ; 純 nolang TLS 目前不可用：顯式回報錯誤，避免靜默回傳 nil 掩蓋原因
                resp = err('tls handshake failed: pure nolang TLS unavailable')
                return
            }
        }

        -> {
            fd = net.net-dial(host, port)
            fd < 0 -> return
        }
    }

    ; ── 建構請求 ──
    req = method
    req = req - ' '
    req = req - path
    req = req - ' HTTP/1.1'
    req = req - crlf
    req = req - 'Host: '
    req = req - host
    req = req - crlf
    req = req - 'Connection: close'
    req = req - crlf
    req = req - 'User-Agent: nolang-http/1.0'
    req = req - crlf
    body.len-bytes() > 0 -> {
        body-len i64 = body.len-bytes()
        len-str = body-len.to-str()
        req = req - 'Content-Length: '
        req = req - len-str
        req = req - crlf
    }
    req = req - crlf
    body.len-bytes() > 0 -> req = req - body

    ; ── 發送請求 ──
    {
        use-tls -> {
            w = tls-c.send(req)
            w: {
                ok ->

                -> {
                    tls-c.close()
                    resp = err('tls send failed: pure nolang TLS unavailable')
                    return
                }
            }
        }

        -> {
            written = net.net-send(fd, req, req.len-bytes())
            written < 0 -> {
                fs.close(fd)
                return
            }
        }
    }

    ; ── 接收回應 ──
    ; net-recv 從 offset 0 覆寫，不更新 len；用 buf 暫存再複製到 raw
    !! {
        {
            use-tls -> n = tls-c.recv(buf, HTTP-BUF-SIZE)

            -> n = net.net-recv(fd, buf, HTTP-BUF-SIZE)
        }
        n <= 0 -> *

        #{overflow=wrap}
        total = total + n

        ; 動態累積到 raw（不再受限於 HTTP-MAX-RESPONSE，避免大回應被截斷）
        raw = raw - buf.slice(0, n)
    }
    {
        use-tls -> tls-c.close()

        -> fs.close(fd)
    }
    total == 0 -> {
        use-tls -> {
            resp = err('tls recv failed: pure nolang TLS unavailable')
            return
        }
        return
    }

    ; 取得實際接收的資料（raw.len 仍為 HTTP-MAX-RESPONSE，用 slice 擷取）
    recv-raw = raw.slice(0, total)

    ; ── 解析回應 ──
    sep-pos = recv-raw.index(separator)
    sep-pos < 0 -> return
    head = recv-raw.slice(0, sep-pos)

    #{overflow=wrap}
    r.body = recv-raw.slice(sep-pos + separator.len-bytes(), recv-raw.len-bytes())

    ; 解析狀態行（第一行）
    first-line-end = head.index(crlf)

    #{overflow=wrap}
    {
        first-line-end < 0 -> {
            status-line = head
            r.headers = ''
        }

        -> {
            status-line = head.slice(0, first-line-end)
            r.headers = head.slice(first-line-end + crlf.len-bytes(), head.len-bytes())
        }
    }

    ; 狀態行格式：HTTP/1.1 200 OK
    sp1 = status-line.index(' ')
    sp1 < 0 -> return

    #{overflow=wrap}
    after-code = status-line.slice(sp1 + 1, status-line.len-bytes())
    sp2 = after-code.index(' ')
    sp2 < 0 -> return
    code-str = after-code.slice(0, sp2)

    #{overflow=wrap}
    r.status-text = after-code.slice(sp2 + 1, after-code.len-bytes())

    ; 解析狀態碼
    code = 0
    i <- [0..code-str.len-bytes()): {

        c = code-str[i]
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        code = code * 10 + c - 48
    }
    r.status-code = code
    r.parse-headers()
    resp = r
}

; do-req: 用 request 發送請求（支援自訂標頭）
; req: 已初始化的 request（含自訂標頭）
; 返回 resp ?response: ok=回應, nil=失敗
do-req = (req request) (resp ?response) {
    resp = nil
    r response

    ; ── 字串變數 ──
    scheme-len = 7
    rest = ''
    host = ''
    port i64 = HTTP-DEFAULT-PORT
    path str
    host-only = ''
    port-str = ''
    cr = '\r'
    lf = '\n'
    crlf = cr - lf
    req-str = ''
    len-str = ''
    buf str = with-len(HTTP-BUF-SIZE)
    raw = ''
    total = 0
    recv-raw = ''

    separator = crlf - crlf
    head = ''
    status-line = ''
    after-code = ''
    code-str = ''
    body = req.body
    method = req.method
    url = req.url
    use-tls = false
    fd fd = -1
    tls-c tls.conn
    written = 0
    n = 0

    ; ── 解析 URL ──
    {
        url.starts-with('https://') -> {
            use-tls = true
            scheme-len = 8
            port = HTTPS-DEFAULT-PORT
        }

        url.starts-with('http://') == false && url.starts-with('https://') == false -> return
    }
    rest = url.slice(scheme-len, url.len-bytes())
    slash-pos = rest.index('/')
    {
        slash-pos < 0 -> {
            host = rest
            path = '/'
        }

        -> {
            host = rest.slice(0, slash-pos)
            path = rest.slice(slash-pos, rest.len-bytes())
        }
    }
    colon-pos = host.index(':')

    #{overflow=wrap}
    colon-pos >= 0 -> {
        host-only = host.slice(0, colon-pos)

        #{overflow=wrap}
        port-str = host.slice(colon-pos + 1, host.len-bytes())
        p = 0
        i <- [0..port-str.len-bytes()): {

            c = port-str[i]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            p = p * 10 + c - 48
        }
        port = p
        host = host-only
    }
    host.len-bytes() == 0 -> return

    ; ── 建立連接 ──
    {
        use-tls -> {
            tls-c.init()
            ok2 = tls-c.connect(host, port)
            ok2 == false -> {

                ; 純 nolang TLS 目前不可用：顯式回報錯誤，避免靜默回傳 nil 掩蓋原因
                resp = err('tls handshake failed: pure nolang TLS unavailable')
                return
            }
        }

        -> {
            fd = net.net-dial(host, port)
            fd < 0 -> return
        }
    }

    ; ── 建構請求（含自訂標頭）──
    req-str = method
    req-str = req-str - ' '

    req-str = req-str - path

    req-str = req-str - ' HTTP/1.1'

    req-str = req-str - crlf

    req-str = req-str - 'Host: '

    req-str = req-str - host

    req-str = req-str - crlf

    req-str = req-str - 'Connection: close'

    req-str = req-str - crlf

    req-str = req-str - 'User-Agent: nolang-http/1.0'

    req-str = req-str - crlf

    ; 附加自訂標頭
    hi <- [0..req.header-count): {

        req-str = req-str - req.headers[hi]
        req-str = req-str - crlf
    }
    body.len-bytes() > 0 -> {

        body-len i64 = body.len-bytes()
        len-str = body-len.to-str()
        req-str = req-str - 'Content-Length: '
        req-str = req-str - len-str
        req-str = req-str - crlf
    }
    req-str = req-str - crlf

    body.len-bytes() > 0 -> req-str = req-str - body

    ; ── 發送請求 ──
    {
        use-tls -> {
            w = tls-c.send(req-str)
            w: {
                ok ->

                -> {
                    tls-c.close()
                    resp = err('tls send failed: pure nolang TLS unavailable')
                    return
                }
            }
        }

        -> {
            written = net.net-send(fd, req-str, req-str.len-bytes())
            written < 0 -> {
                fs.close(fd)
                return
            }
        }
    }

    ; ── 接收回應 ──
    !! {
        {
            use-tls -> n = tls-c.recv(buf, HTTP-BUF-SIZE)

            -> n = net.net-recv(fd, buf, HTTP-BUF-SIZE)
        }
        n <= 0 -> *

        #{overflow=wrap}
        total = total + n
        raw = raw - buf.slice(0, n)
    }
    {
        use-tls -> tls-c.close()

        -> fs.close(fd)
    }
    total == 0 -> {
        use-tls -> {
            resp = err('tls recv failed: pure nolang TLS unavailable')
            return
        }
        return
    }
    recv-raw = raw.slice(0, total)

    ; ── 解析回應 ──
    sep-pos = recv-raw.index(separator)
    sep-pos < 0 -> return
    head = recv-raw.slice(0, sep-pos)

    #{overflow=wrap}
    r.body = recv-raw.slice(sep-pos + separator.len-bytes(), recv-raw.len-bytes())
    first-line-end = head.index(crlf)

    #{overflow=wrap}
    {
        first-line-end < 0 -> {
            status-line = head
            r.headers = ''
        }

        -> {
            status-line = head.slice(0, first-line-end)
            r.headers = head.slice(first-line-end + crlf.len-bytes(), head.len-bytes())
        }
    }
    sp1 = status-line.index(' ')
    sp1 < 0 -> return

    #{overflow=wrap}
    after-code = status-line.slice(sp1 + 1, status-line.len-bytes())
    sp2 = after-code.index(' ')
    sp2 < 0 -> return
    code-str = after-code.slice(0, sp2)

    #{overflow=wrap}
    r.status-text = after-code.slice(sp2 + 1, after-code.len-bytes())
    code = 0
    i <- [0..code-str.len-bytes()): {

        c = code-str[i]
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        code = code * 10 + c - 48
    }
    r.status-code = code

    ; 解析回應標頭
    r.parse-headers()
    resp = r
}

; ═══════════════════════════════════════════════
; 便捷函數
; ═══════════════════════════════════════════════

; get: 執行 HTTP GET 請求
; url: 完整 URL
; 返回 resp ?response: ok=回應, nil=失敗
get = (url str) (resp ?response) {
    resp = do('GET', url, '')
}

; ping — temporary probe to detect source vs embedded std loading
ping = () (s str) {
    s = 'pong'
}

; post: 執行 HTTP POST 請求
; url: 完整 URL
; body: 請求主體
; 返回 resp ?response: ok=回應, nil=失敗
post = (url str, body str) (resp ?response) {
    resp = do('POST', url, body)
}

; put: 執行 HTTP PUT 請求
; url: 完整 URL
; body: 請求主體
; 返回 resp ?response: ok=回應, nil=失敗
put = (url str, body str) (resp ?response) {
    resp = do('PUT', url, body)
}

; delete: 執行 HTTP DELETE 請求
; url: 完整 URL
; 返回 resp ?response: ok=回應, nil=失敗
delete = (url str) (resp ?response) {
    resp = do('DELETE', url, '')
}

; patch: 執行 HTTP PATCH 請求
; url: 完整 URL
; body: 請求主體
; 返回 resp ?response: ok=回應, nil=失敗
patch = (url str, body str) (resp ?response) {
    resp = do('PATCH', url, body)
}

; download: 串流下載（支援任意大小，直接寫入檔案）
; 使用原生 TLS/net，不依賴任何外部元件（curl 等）。
; url str — 完整 URL
; dest str — 目的地檔案路徑
; 返回 ok bool — true=成功（且 HTTP 狀態碼為 2xx）
download = (url str, dest str) (ok bool) {
    ok = false
    scheme-len = 7
    rest = ''
    host = ''
    port i64 = HTTP-DEFAULT-PORT
    path str
    host-only = ''
    port-str = ''
    cr = math.char-to-str(13)
    lf = math.char-to-str(10)
    crlf = cr - lf
    sep-str = crlf - crlf
    req = ''
    use-tls = false
    fd fd = -1
    tls-c tls.conn
    written = 0
    n = 0
    buf str = with-len(HTTP-BUF-SIZE)

    ; 解析 URL
    {
        url.starts-with('https://') -> {
            use-tls = true
            scheme-len = 8
            port = HTTPS-DEFAULT-PORT
        }

        url.starts-with('http://') == false && url.starts-with('https://') == false -> return
    }
    rest = url.slice(scheme-len, url.len-bytes())
    slash-pos = rest.index('/')
    {
        slash-pos < 0 -> {
            host = rest
            path = '/'
        }

        -> {
            host = rest.slice(0, slash-pos)
            path = rest.slice(slash-pos, rest.len-bytes())
        }
    }
    colon-pos = host.index(':')
    colon-pos >= 0 -> {
        host-only = host.slice(0, colon-pos)

        #{overflow=wrap}
        port-str = host.slice(colon-pos + 1, host.len-bytes())
        p = 0
        i <- [0..port-str.len-bytes()): {
            c = port-str[i]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            p = p * 10 + c - 48
        }
        port = p
        host = host-only
    }
    host.len-bytes() == 0 -> return

    ; 建立連線
    {
        use-tls -> {
            tls-c.init()
            ok2 = tls-c.connect(host, port)
            ok2 == false -> return
        }

        -> {
            fd = net.net-dial(host, port)
            fd < 0 -> return
        }
    }

    ; 建構 GET 請求（不帶 Accept-Encoding，取得原始位元組）
    req = 'GET '
    req = req - path
    req = req - ' HTTP/1.1'
    req = req - crlf
    req = req - 'Host: '
    req = req - host
    req = req - crlf
    req = req - 'Connection: close'
    req = req - crlf
    req = req - 'User-Agent: nolang-http/1.0'
    req = req - crlf
    req = req - crlf

    ; 發送請求
    {
        use-tls -> {
            w = tls-c.send(req)
            w: {
                ok ->

                -> {
                    tls-c.close()
                    return
                }
            }
        }

        -> {
            written = net.net-send(fd, req, req.len-bytes())
            written < 0 -> {
                fs.close(fd)
                return
            }
        }
    }

    ; 接收並累積全部回應
    all-str = ''
    !! {
        {
            use-tls -> n = tls-c.recv(buf, HTTP-BUF-SIZE)

            -> n = net.net-recv(fd, buf, HTTP-BUF-SIZE)
        }
        n <= 0 -> *
        all-str = all-str - buf.slice(0, n)
    }
    {
        use-tls -> tls-c.close()

        -> fs.close(fd)
    }

    ; DBG
    total = all-str.len-bytes()
    print('DBG download total=' - total.to-str())
    print('DBG download head=' - all-str.slice(0, 32))

    ; 基本檢查 + 狀態碼必須為 2xx（'HTTP/1.x 2xx' 在第 9 位元組）
    total = all-str.len-bytes()
    total < 12 -> {
        fs.remove(dest)
        return
    }
    all-str[9] != 50 -> {
        fs.remove(dest)
        return
    }
    sep = all-str.index(sep-str)
    sep < 0 -> {
        fs.remove(dest)
        return
    }

    #{overflow=wrap}
    body-str = all-str.slice(sep + 4, all-str.len-bytes())
    fs.write-bytes(dest, body-str.to-bytes())
    ok = true
}

; upload-put: 串流上傳檔案（PUT，原始二進位 body）
; 使用原生 TLS/net，不依賴任何外部元件（curl 等）。
; url str — 完整 URL
; token str — Bearer token（可空）
; file-path str — 要上傳的檔案
; 返回 ok bool — true=成功（且 HTTP 狀態碼為 2xx）
upload-put = (url str, token str, file-path str) (ok bool) {
    ok = false
    content-opt = fs.read-str(file-path)
    content = ''
    content-opt: {
        ok -> content = it

        nil -> return

        err -> return
    }
    fsize = content.len-bytes()

    scheme-len = 7
    rest = ''
    host = ''
    port i64 = HTTP-DEFAULT-PORT
    path str
    host-only = ''
    port-str = ''
    cr = '\r'
    lf = '\n'
    crlf = cr - lf
    req = ''
    use-tls = false
    fd fd = -1
    tls-c tls.conn
    written = 0
    n = 0
    buf str = with-len(HTTP-BUF-SIZE)

    {
        url.starts-with('https://') -> {
            use-tls = true
            scheme-len = 8
            port = HTTPS-DEFAULT-PORT
        }

        url.starts-with('http://') == false && url.starts-with('https://') == false -> return
    }
    rest = url.slice(scheme-len, url.len-bytes())
    slash-pos = rest.index('/')
    {
        slash-pos < 0 -> {
            host = rest
            path = '/'
        }

        -> {
            host = rest.slice(0, slash-pos)
            path = rest.slice(slash-pos, rest.len-bytes())
        }
    }
    colon-pos = host.index(':')
    colon-pos >= 0 -> {
        host-only = host.slice(0, colon-pos)

        #{overflow=wrap}
        port-str = host.slice(colon-pos + 1, host.len-bytes())
        p = 0
        i <- [0..port-str.len-bytes()): {
            c = port-str[i]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            p = p * 10 + c - 48
        }
        port = p
        host = host-only
    }
    host.len-bytes() == 0 -> return

    {
        use-tls -> {
            tls-c.init()
            ok2 = tls-c.connect(host, port)
            ok2 == false -> return
        }

        -> {
            fd = net.net-dial(host, port)
            fd < 0 -> return
        }
    }

    ; 建構 PUT 請求（含 body）
    req = 'PUT '
    req = req - path
    req = req - ' HTTP/1.1'
    req = req - crlf
    req = req - 'Host: '
    req = req - host
    req = req - crlf
    req = req - 'Connection: close'
    req = req - crlf
    req = req - 'User-Agent: nolang-http/1.0'
    req = req - crlf
    req = req - 'Content-Type: application/octet-stream'
    req = req - crlf
    token.len-bytes() > 0 -> {
        req = req - 'Authorization: Bearer '
        req = req - token
        req = req - crlf
    }
    clen = fsize.to-str()
    req = req - 'Content-Length: '
    req = req - clen
    req = req - crlf
    req = req - crlf
    req = req - content

    ; 發送
    {
        use-tls -> {
            w = tls-c.send(req)
            w: {
                ok ->

                -> {
                    tls-c.close()
                    return
                }
            }
        }

        -> {
            written = net.net-send(fd, req, req.len-bytes())
            written < 0 -> {
                fs.close(fd)
                return
            }
        }
    }

    ; 讀取回應狀態
    resp-str = ''
    !! {
        {
            use-tls -> n = tls-c.recv(buf, HTTP-BUF-SIZE)

            -> n = net.net-recv(fd, buf, HTTP-BUF-SIZE)
        }
        n <= 0 -> *
        resp-str = resp-str - buf.slice(0, n)
        resp-str.index(crlf) >= 0 -> *
    }
    {
        use-tls -> tls-c.close()

        -> fs.close(fd)
    }

    ; 狀態碼解析
    sp1 = resp-str.index(' ')
    sp1 < 0 -> return

    #{overflow=wrap}
    after-code = resp-str.slice(sp1 + 1, resp-str.len-bytes())
    sp2 = after-code.index(' ')
    sp2 < 0 -> return
    code-str = after-code.slice(0, sp2)
    code = 0
    i <- [0..code-str.len-bytes()): {
        c = code-str[i]
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        code = code * 10 + c - 48
    }
    code >= 200 && code < 300 -> ok = true
}

; ═══════════════════════════════════════════════
; 認證便捷函數
; ═══════════════════════════════════════════════

; set-basic-auth: 為請求加入 HTTP Basic 認證標頭
; req request: 請求結構體
; user str: 用戶名
; password str: 密碼
; 返回 ok=true=成功
set-basic-auth = (req request, user str, password str) (ok bool) {

    ; 拼接 user:password 並 Base64 編碼
    raw = user - ':' - password
    raw-bytes = raw.to-bytes()
    enc-str = base64.encode-std(raw-bytes)
    auth-val = 'Basic ' - enc-str
    ok = req.add-header('Authorization', auth-val)
}

; set-bearer-auth: 為請求加入 Bearer Token 認證標頭
; req request: 請求結構體
; token str: Bearer token
; 返回 ok=true=成功
set-bearer-auth = (req request, token str) (ok bool) {
    auth-val = 'Bearer ' - token
    ok = req.add-header('Authorization', auth-val)
}

; set-api-key: 為請求加入 API Key 標頭
; req request: 請求結構體
; header-name str: 標頭名稱（如 'X-API-Key'）
; api-key str: API 金鑰
; 返回 ok=true=成功
set-api-key = (req request, header-name str, api-key str) (ok bool) {
    ok = req.add-header(header-name, api-key)
}

; get-auth: 執行帶 Basic 認證的 HTTP GET 請求
; url str: 完整 URL
; user str: 用戶名
; password str: 密碼
; 返回 resp ?response: ok=回應, nil=失敗
get-auth = (url str, user str, password str) (resp ?response) {
    resp = nil
    r request
    r.init('GET', url, '')
    set-basic-auth(r, user, password)
    resp = do-req(r)
}

; post-auth: 執行帶 Basic 認證的 HTTP POST 請求
; url str: 完整 URL
; body str: 請求主體
; user str: 用戶名
; password str: 密碼
; 返回 resp ?response: ok=回應, nil=失敗
post-auth = (url str, body str, user str, password str) (resp ?response) {
    resp = nil
    r request
    r.init('POST', url, body)
    set-basic-auth(r, user, password)
    resp = do-req(r)
}

; ═══════════════════════════════════════════════
; download-to-file: 純 Nolang 二進位下載到檔案
; 與 do/do-req 不同：以 []byte 累積整個回應（不受 HTTP-MAX-RESPONSE 限制），
; 在位元組層級切分標頭與主旨（避免 str 碼點 slice 損壞二進位資料），
; 並處理 chunked 傳輸編碼與 3xx 重定向。適合 tarball 等二進位下載。
; url str: 完整 URL（http:// 或 https://）
; dest str: 本地寫入路徑
; 返回 ok bool: true=成功
; ═══════════════════════════════════════════════

download-to-file = (url str, dest str) (ok bool) {
    ok = http-dl-open(url, dest, 0)
}

; http-dl-open: 實際下載（含 3xx 重定向遞迴，depth 為已跳轉次數）
http-dl-open = (url str, dest str, depth i64) (ok bool) {
    ok = false
    depth > 5 -> return

    ; ── 解析 URL ──
    use-tls = false
    scheme-len = 7
    port i64 = HTTP-DEFAULT-PORT
    {
        url.starts-with('https://') -> {
            use-tls = true
            scheme-len = 8
            port = HTTPS-DEFAULT-PORT
        }

        url.starts-with('http://') == false && url.starts-with('https://') == false -> return
    }
    rest = ''
    rest = url.slice-bytes(scheme-len, url.len-bytes())
    host = ''
    path = '/'
    slash-pos = rest.index('/')
    {
        slash-pos < 0 -> host = rest

        -> {
            host = rest.slice-bytes(0, slash-pos)
            path = rest.slice-bytes(slash-pos, rest.len-bytes())
        }
    }
    host-only = ''
    port-str = ''
    colon-pos = host.index(':')

    #{overflow=wrap}
    colon-pos >= 0 -> {
        host-only = host.slice-bytes(0, colon-pos)

        #{overflow=wrap}
        port-str = host.slice-bytes(colon-pos + 1, host.len-bytes())
        p = 0
        pi <- [0..port-str.len-bytes()): {
            c = port-str[pi]
            c < 48 || c > 57 -> return

            #{overflow=wrap}
            p = p * 10 + c - 48
        }
        port = p
        host = host-only
    }
    host.len-bytes() == 0 -> return

    ; ── 建立連線 ──
    fd fd = -1
    tls-c tls.conn
    {
        use-tls -> {
            tls-c.init()
            okc = tls-c.connect(host, port)
            okc == false -> return
        }

        -> {
            fd = net.net-dial(host, port)
            fd < 0 -> return
        }
    }

    ; ── 送出 GET（Connection: close，讀到 EOF 為止）──
    crlf = '\r\n'
    req-str = ''
    req-str = 'GET ' - path - ' HTTP/1.1'
    req-str = req-str - crlf - 'Host: ' - host
    req-str = req-str - crlf - 'Connection: close'
    req-str = req-str - crlf - 'User-Agent: nolang-http/1.0'
    req-str = req-str - crlf - crlf
    {
        use-tls -> {
            w = tls-c.send(req-str)
            w: {
                ok ->

                -> {
                    tls-c.close()
                    return
                }
            }
        }

        -> {
            written = net.net-send(fd, req-str, req-str.len-bytes())
            written < 0 -> {
                fs.close(fd)
                return
            }
        }
    }

    ; ── 接收全部位元組（vec 累積，無 16KB 上限）──
    acc []byte
    buf str = with-len(HTTP-BUF-SIZE)
    !! {
        n = 0
        {
            use-tls -> n = tls-c.recv(buf, HTTP-BUF-SIZE)

            -> n = net.net-recv(fd, buf, HTTP-BUF-SIZE)
        }
        n <= 0 -> *
        bi <- [0..n): {
            acc.push(buf.byte(bi))
        }
    }
    {
        use-tls -> tls-c.close()

        -> fs.close(fd)
    }
    alen = acc.len()
    alen == 0 -> return

    ; ── 找標頭/主旨分界（CR LF CR LF，位元組層級）──
    sep = -1
    scan = 0

    #{index-out=0}
    (sep < 0 && (scan + 3) < alen) {

        #{index-out=0}
        (acc[scan] == 13 && acc[scan + 1] == 10 && acc[scan + 2] == 13 && acc[scan + 3] == 10) -> sep = scan

        #{overflow=wrap}
        scan = scan + 1
    }
    sep < 0 -> return

    #{overflow=wrap}
    body-start = sep + 4

    ; ── 標頭文字（ASCII，取 [0..sep) 逐位元組）──
    hdr []byte
    hi <- [0..sep): {

        #{index-out=0}
        hdr.push(acc[hi])
    }
    head-str = hdr.to-bytes-str()

    ; 狀態碼（狀態行 "HTTP/1.1 200 OK"）
    first-line = head-str
    nl = head-str.index(crlf)
    nl >= 0 -> first-line = head-str.slice-bytes(0, nl)
    sp1 = first-line.index(' ')
    sp1 < 0 -> return

    #{overflow=wrap}
    code-str = first-line.slice-bytes(sp1 + 1, sp1 + 4)
    code = 0
    ci <- [0..code-str.len-bytes()): {

        #{index-out=0}
        c = code-str[ci]
        c < 48 || c > 57 -> return

        #{overflow=wrap}
        code = code * 10 + c - 48
    }

    ; ── 3xx 重定向 ──
    code >= 300 && code < 400 -> {
        loc = http-dl-location(head-str)
        loc: {
            ok -> {
                target = http-dl-resolve(use-tls, host, port, it)

                #{overflow=wrap}
                ok = http-dl-open(target, dest, depth + 1)
            }

            -> ok = false
        }
        return
    }
    code < 200 || code >= 300 -> return

    ; ── 主旨位元組 [body-start..alen) ──
    body []byte
    body-start < alen -> {
        yi <- [body-start..alen): {

            #{index-out=0}
            body.push(acc[yi])
        }
    }

    ; ── chunked 解框 ──
    data []byte
    is-chunked = head-str.to-lower().contains('chunked')
    is-chunked -> data = http-dl-dechunk(body)

    -> data = body

    ; ── 寫入檔案 ──
    w = fs.write-bytes(dest, data)
    w: {
        ok -> ok = it

        -> ok = false
    }
}

; http-dl-location: 從標頭文字找出 Location 值（大小寫不敏感）
http-dl-location = (head-str str) (loc ?str) {
    loc = nil
    lines = head-str.lines()
    li <- [0..lines.len()): {

        #{index-out=0}
        trimmed = lines[li].trim()
        trimmed.to-lower().starts-with('location:') -> {
            loc = trimmed.slice-bytes(9, trimmed.len-bytes()).trim()
            return
        }
    }
}

; http-dl-resolve: 將 Location 解析為絕對 URL（http(s) 絕對 / 根相對 / 一般相對）
http-dl-resolve = (use-tls bool, host str, port i64, loc str) (out str) {
    loc.starts-with('http://') || loc.starts-with('https://') -> {
        out = loc
        return
    }
    scheme str
    {
        use-tls -> scheme = 'https://'

        -> scheme = 'http://'
    }
    prefix = scheme - host
    port != 80 && port != 443 -> {
        prefix = prefix - ':' - port.to-str()
    }
    loc.starts-with('/') -> {
        out = prefix - loc
        return
    }
    out = prefix - '/' - loc
}

; http-dl-dechunk: 將 chunked 編碼的 body 解框為原始位元組
http-dl-dechunk = (b []byte) (out []byte) {
    out []byte
    blen = b.len()
    pos = 0
    !! {

        #{index-out=0}
        (pos < blen && (b[pos] == 13 || b[pos] == 10)) {

            #{overflow=wrap}
            pos = pos + 1
        }
        pos >= blen -> *
        size = 0
        size-done = false

        #{index-out=0}
        (pos < blen && size-done == false) {

            #{index-out=0}
            c = b[pos]
            {
                c >= 48 && c <= 57 -> {

                    #{overflow=wrap}
                    size = size * 16 + c - 48

                    #{overflow=wrap}
                    pos = pos + 1
                }

                c >= 97 && c <= 102 -> {

                    #{overflow=wrap}
                    size = size * 16 + c - 87

                    #{overflow=wrap}
                    pos = pos + 1
                }

                c >= 65 && c <= 70 -> {

                    #{overflow=wrap}
                    size = size * 16 + c - 55

                    #{overflow=wrap}
                    pos = pos + 1
                }

                -> size-done = true
            }
        }
        line-done = false

        #{index-out=0}
        (pos < blen && line-done == false) {

            #{index-out=0}
            c = b[pos]
            {
                c == 10 -> {

                    #{overflow=wrap}
                    pos = pos + 1
                    line-done = true
                }

                c == 13 -> {

                    #{overflow=wrap}
                    pos = pos + 1

                    #{index-out=0}
                    (pos < blen && b[pos] == 10) -> {

                        #{overflow=wrap}
                        pos = pos + 1
                    }
                    line-done = true
                }

                -> {

                    #{overflow=wrap}
                    pos = pos + 1
                }
            }
        }
        size <= 0 -> *

        #{index-out=0}
        (pos < blen && size > 0) {

            #{index-out=0}
            out.push(b[pos])

            #{overflow=wrap}
            pos = pos + 1

            #{overflow=wrap}
            size = size - 1
        }
    }
}
