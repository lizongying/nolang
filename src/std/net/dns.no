; dns — DNS 解析器（純 Nolang 實作）
;
; 使用 UDP 協定（埠 53）實作 DNS 查詢，支援 A 記錄（IPv4）解析。
; 不依賴 C 庫的 getaddrinfo，直接構造和解析 DNS 封包。
;
; 用法：
;   // 解析域名
;   ip = resolve('example.com')           // 返回 ?str（IP 地址）
;   ip: {
;       nil -> print('解析失敗')
;       -> print(ip)                         // 如 '93.184.216.34'
;   }
;
;   // 指定 DNS 伺服器
;   ip = resolve-from('8.8.8.8', 'example.com')  // 返回 ?str
; [dns](#dns)

; 常量
...

; DNS 埠號
; [DNS-PORT](#dns.dns-port)
DNS-PORT = 53

; 預設 DNS 伺服器（Google Public DNS）
; [DNS-DEFAULT-SERVER](#dns.dns-default-server)
DNS-DEFAULT-SERVER = '8.8.8.8'

; 備用 DNS 伺服器（Cloudflare）
; [DNS-BACKUP-SERVER](#dns.dns-backup-server)
DNS-BACKUP-SERVER = '1.1.1.1'

; DNS 查詢逾時（毫秒）
; [DNS-TIMEOUT](#dns.dns-timeout)
DNS-TIMEOUT = 3000

; 最大 DNS 封包大小
; [DNS-MAX-PACKET](#dns.dns-max-packet)
DNS-MAX-PACKET = 512

; DNS 記錄類型
; [DNS-TYPE-A](#dns.dns-type-a)
DNS-TYPE-A = 1
DNS-TYPE-AAAA = 28
DNS-TYPE-CNAME = 5
DNS-TYPE-MX = 15
DNS-TYPE-TXT = 16
DNS-TYPE-NS = 2

; DNS 類別
; [DNS-CLASS-IN](#dns.dns-class-in)
DNS-CLASS-IN = 1

; DNS 回應碼
; [DNS-RCODE-NO-ERROR](#dns.dns-rcode-no-error)
DNS-RCODE-NO-ERROR = 0
DNS-RCODE-FORMAT-ERROR = 1
DNS-RCODE-SERVER-FAILURE = 2
DNS-RCODE-NAME-ERROR = 3
DNS-RCODE-NOT-IMPLEMENTED = 4
DNS-RCODE-REFUSED = 5

; 結構體
...

; record: DNS 記錄
; rtype: 記錄類型（1=A, 5=CNAME, 28=AAAA）
; name: 域名
; value: 記錄值（A 記錄為 IP 地址）
; ttl: 存活時間
; [record](#dns.record)
record {
    rtype i64
    name str
    value str
    ttl i64
}

; 內部工具函數
...

; 構建 DNS 查詢封包
; domain: 要查詢的域名（以 '.' 分隔，逐段寫成 長度+標籤 格式）
; qtype: 查詢類型（DNS-TYPE-A=1 表示 IPv4 地址）
; 返回 query: 查詢封包（12 位元組標頭 + 問題區），尾部多餘空間未截短
; 返回 qlen: 封包的實際有效長度（應只拿前 qlen 位元組發送）
; [build-query](#dns.build-query)
build-query = (domain str, qtype i64) (query []byte, qlen i64) {

    ; Pre-allocate: header(12) + domain labels(domain.len()+1) + qtype(2) + qclass(2)
    #{overflow=wrap}
    max-len = domain.len-bytes() + 20
    query = with-len(max-len)
    qlen = 0
    pos = 0

    ; Transaction ID（固定為 1，簡化實作）
    query[pos] = 0

    #{overflow=wrap}
    query[pos + 1] = 1

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    ; Flags: 標準查詢（RD=1）
    query[pos] = 0x01

    #{overflow=wrap}
    query[pos + 1] = 0x00

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    ; QDCOUNT = 1
    query[pos] = 0

    #{overflow=wrap}
    query[pos + 1] = 1

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    ; ANCOUNT = 0
    query[pos] = 0

    #{overflow=wrap}
    query[pos + 1] = 0

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    ; NSCOUNT = 0
    query[pos] = 0

    #{overflow=wrap}
    query[pos + 1] = 0

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    ; ARCOUNT = 0
    query[pos] = 0

    #{overflow=wrap}
    query[pos + 1] = 0

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    ; QNAME: 將域名編碼為長度前綴標籤
    label-start = 0
    i = 0
    (i <= domain.len-bytes()) {
        is-dot = false
        {
            i == domain.len-bytes() -> is-dot = true

            domain[i] == 46 -> {
                is-dot = true
            }
        }

        is-dot -> {

            #{overflow=wrap}
            label-len = i - label-start
            label-len > 0 -> {
                query[pos] = label-len & 255
                {
                    pos ?= pos + 1
                }: {
                    err -> _

                    -> _
                }
                j <- [0..label-len): {

                    #{overflow=wrap}
                    query[pos] = domain[label-start + j]: {
                        ok -> it

                        -> _
                    }
                    {
                        pos ?= pos + 1
                    }: {
                        err -> _

                        -> _
                    }
                }
            }
            {
                label-start ?= i + 1
            }: {
                err -> _

                -> _
            }
        }

        {
            #{overflow=wrap}
            i ?= i + 1
        }: {
            err -> _

            -> _
        }
    }

    ; 終止零標籤
    query[pos] = 0

    {
        #{overflow=wrap}
        pos ?= pos + 1
    }: {
        err -> _

        -> _
    }

    ; QTYPE
    query[pos] = (qtype >> 8) & 255

    #{overflow=wrap}
    query[pos + 1] = qtype & 255

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    ; QCLASS = IN (1)
    query[pos] = 0

    #{overflow=wrap}
    query[pos + 1] = 1

    {
        #{overflow=wrap}
        pos ?= pos + 2
    }: {
        err -> _

        -> _
    }

    qlen = pos
}

; 從回應封包中解析域名（支援壓縮指標）
; 逐段讀取 長度+標籤，遇到長度 0 結束；遇到高位為 11 的壓縮指標則把讀取位置跳到指標目標，
; 可連續跳轉；CLASS 等欄位不參與校驗。畸形封包（越界或非法標籤長度）回 next-pos=-1。
; data: DNS 封包
; offset: 域名起始位置（位元組下標）
; 返回 name: 解析出的域名，各標籤以 '.' 連接
; 返回 next-pos: 跳過本域名後的位置（有壓縮指標時為指標之後的位置）
; [parse-name](#dns.parse-name)
parse-name = (data []byte, offset i64) (name str, next-pos i64) {

    ; Use a byte buffer for building the name (str indexed assignment requires cap>0)
    buf []byte = with-len(256)
    buf-pos = 0
    pos = offset
    jumped = false
    jump-pos = 0
    end-pos = 0

    !! {

        ; 遇數據尾端仍未見終止零標籤：畸形封包，標記 next-pos=-1
        pos >= data.len() -> {
            jumped == false -> end-pos = -1
            break
        }

        len-byte = data[pos]: {
            ok -> it

            -> 0
        }

        len-byte == 0 -> {
            {
                #{overflow=wrap}
                pos ?= pos + 1
            }: {
                err -> _

                -> _
            }
            jumped == false -> end-pos = pos
            break
        }

        ; 檢查是否為壓縮指標（前兩位為 11）
        {
            (len-byte & 0xc0) == 0xc0 -> {
                jumped == false -> {
                    {
                        #{overflow=wrap}
                        end-pos ?= pos + 2
                    }: {
                        err -> _

                        -> _
                    }
                }

                #{overflow=wrap}
                pointer-low = data[pos + 1]: {
                    ok -> it

                    -> 0
                }

                pointer i64 = ((len-byte & 0x3f) << 8) | (pointer-low)
                pos = pointer
                jumped = true
            }

            (len-byte & 0xc0) == 0 -> {
                label-len = len-byte
                {
                    pos ?= pos + 1
                }: {
                    err -> _

                    -> _
                }
                i <- [0..label-len): {
                    {

                        #{overflow=wrap}
                        buf[buf-pos] ?= data[pos + i]
                    }: {
                        err -> _

                        -> _
                    }
                    {
                        buf-pos ?= buf-pos + 1
                    }: {
                        err -> _

                        -> _
                    }
                }

                buf[buf-pos]: {
                    ok -> it = 46

                    -> _
                }
                {
                    buf-pos ?= buf-pos + 1
                }: {
                    err -> _

                    -> _
                }
                {
                    pos ?= pos + label-len
                }: {
                    err -> _

                    -> _
                }
            }

            -> {
                end-pos = -1
                break
            }
        }
    }

    ; 移除末尾的點
    buf-pos > 0 -> {
        {
            #{overflow=wrap}
            last-byte ?= buf[buf-pos - 1]

            last-byte == 46 -> {
                #{overflow=wrap}
                buf-pos ?= buf-pos - 1
            }
        }: {
            err -> _

            -> _
        }
    }

    ; Convert buffer to string and trim to actual length.
    ; buf 已是 DNS 名稱的原始 ASCII 位元組流，需 1:1 原樣拷貝，故用 to-bytes-str()
    ; （回傳 str）而非 to-str()（回傳 ?str、且會把每個位元組當碼點重新 UTF-8 編碼）。
    name = buf.to-bytes-str()
    name = name.slice(0, buf-pos)
    {
        jumped -> next-pos = end-pos

        -> next-pos = end-pos
    }
}

; 解析 DNS 回應封包，返回第一個 A 記錄的 IP
; 先檢查 RCODE（非 0 直接放棄）、ANCCOUNT=0 直接放棄，跳過問題區後逐條讀取答案記錄；
; 只接受 TYPE=A 且 RDLENGTH=4 的記錄（不檢查 CLASS）。
; data: DNS 回應封包（至少 12 位元組標頭）
; 返回 ip: ok=第一個 A 記錄的點分十進位 IP, nil=沒有 A 記錄或封包非法
; [parse-response](#dns.parse-response)
parse-response = (data []byte) (ip ?str) {
    ip = nil
    data.len() < 12 -> return

    ; 檢查回應碼
    flags-hi ?= data[2]: {
        ok -> it

        -> 0
    }

    flags-lo = data[3]: {
        ok -> it

        -> 0
    }
    rcode = flags-lo & 0x0f
    rcode != DNS-RCODE-NO-ERROR -> return

    ; QDCOUNT（問題數）：data[4..6] 大端
    qdcount-high = data[4]: {
        ok -> it

        -> 0
    }

    qdcount-low = data[5]: {
        ok -> it

        -> 0
    }

    qdcount = (qdcount-high << 8) | qdcount-low

    ; ANCOUNT（回答數）：data[6..8] 大端
    ancount-high = data[6]: {
        ok -> it

        -> 0
    }

    ancount-low = data[7]: {
        ok -> it

        -> 0
    }

    ancount = (ancount-high << 8) | ancount-low
    ancount == 0 -> return
    pos = 12

    ; 跳過問題部分
    i <- [0..qdcount): {
        qname = ''
        qname, pos = parse-name(data, pos)
        pos < 0 -> return

        ; 跳過 QTYPE(2) + QCLASS(2)
        #{overflow=wrap}
        pos ?= pos + 4
    }

    ; 解析回答部分
    i <- [0..ancount): {
        rname = ''
        rname, pos = parse-name(data, pos)
        pos < 0 -> return

        #{overflow=wrap}
        pos + 10 > data.len() -> return

        type-high = data[pos]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        type-low = data[pos + 1]: {
            ok -> it

            -> 0
        }

        rtype = (type-high << 8) | type-low

        #{overflow=wrap}
        pos ?= pos + 2

        ; CLASS (2 bytes)
        #{overflow=wrap}
        pos ?= pos + 2

        ; TTL (4 bytes)
        #{overflow=wrap}
        pos ?= pos + 4

        ; RDLENGTH (2 bytes)
        rdlen-high = data[pos]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        rdlen-low = data[pos + 1]: {
            ok -> it

            -> 0
        }

        rdlength = (rdlen-high << 8) | rdlen-low

        #{overflow=wrap}
        pos ?= pos + 2

        #{overflow=wrap}
        pos + rdlength > data.len() -> return

        ; A 記錄（4 bytes IPv4）
        rtype == DNS-TYPE-A && rdlength == 4 -> {
            a = data[pos]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            b = data[pos + 1]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            c = data[pos + 2]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            d = data[pos + 3]: {
                ok -> it

                -> 0
            }

            sa = a.to-str()
            sb = b.to-str()
            sc = c.to-str()
            sd = d.to-str()
            ip = sa - '.' - sb - '.' - sc - '.' - sd
            return
        }

        {
            #{overflow=wrap}
            pos ?= pos + rdlength
        }: {
            err -> _

            -> _
        }
    }
}

; 公開 API
...

; 使用指定 DNS 伺服器解析域名
; 採用 UDP，單次查詢最多等待 DNS-TIMEOUT 毫秒，不重試。
; server: DNS 伺服器 IPv4 地址（如 '8.8.8.8'，不含端口）
; domain: 要解析的域名
; 返回 ip: ok=解析到的 IPv4 地址, nil=封包構建失敗、socket/發送失敗、超時或無 A 記錄
; [resolve-from](#dns.resolve-from)
resolve-from = (server str, domain str) (ip ?str) {
    ip = nil

    ; 構建查詢封包
    query []byte
    qlen = 0
    query, qlen = build-query(domain, DNS-TYPE-A)
    qlen == 0 -> return

    ; 建立 UDP socket
    fd = net.net-udp-open()
    fd < 0 -> return

    ; 設定逾時
    net.net-set-recv-timeout(fd, DNS-TIMEOUT)

    ; 發送查詢
    ; DNS 封包是二進位位元組流（transaction ID 可能 >= 0x80），必須 1:1 拷貝，
    ; 不能用按碼點重編碼的 to-str()，否則送出長度與內容都錯。見 §5.2 #88。
    query-str = query.to-bytes-str()
    written = net.net-udp-sendto(fd, query-str, qlen, server, DNS-PORT)
    written < 0 -> {
        fs.close(fd)
        return
    }

    ; 接收回應
    resp-str str = with-len(DNS-MAX-PACKET)
    n = net.net-udp-recvfrom(fd, resp-str, DNS-MAX-PACKET)
    fs.close(fd)
    n <= 0 -> return

    ; 解析回應
    resp []byte = with-len(n)
    i <- [0..n): {
        resp[i]: {

            ; ⚠️ 2026-11-12 修：`.byte(i)` 回 `?byte`，直接寫進 byte 槽位會被
            ; 存成 0（option 的標籤被當成值），於是 resp 全是 0、parse-response
            ; 永遠找不到 A 記錄 —— resolve-from / resolve-all 從來沒成功過。
            ok -> it = resp-str.byte(i): {
                ok -> it

                -> 0
            }

            -> _
        }
    }
    ip = parse-response(resp)
}

; 使用預設 DNS 伺服器解析域名
; 先查 DNS-DEFAULT-SERVER，失敗後再嘗試 DNS-BACKUP-SERVER。
; domain: 要解析的域名
; 返回 ip: ok=解析到的 IPv4 地址, nil=兩台伺服器都失敗
; [resolve](#dns.resolve)
resolve = (domain str) (ip ?str) {

    ; Try primary DNS server first
    ip = resolve-from(DNS-DEFAULT-SERVER, domain)

    ; If primary failed, try backup server
    ip == nil -> ip = resolve-from(DNS-BACKUP-SERVER, domain)
}

; 解析域名，返回第一個 A 記錄
; 與 resolve 的差別：不嘗試備援伺服器，直接向 DNS-DEFAULT-SERVER 發一次查詢（行為與 resolve 的首輪相同）。
; domain: 要解析的域名
; 返回 ip: ok=解析到的 IPv4 地址, nil=解析失敗
; [resolve-all](#dns.resolve-all)
resolve-all = (domain str) (ip ?str) {
    ip = nil

    query []byte
    qlen = 0
    query, qlen = build-query(domain, DNS-TYPE-A)
    qlen == 0 -> return
    fd = net.net-udp-open()
    fd < 0 -> return
    net.net-set-recv-timeout(fd, DNS-TIMEOUT)

    ; DNS 封包是二進位位元組流（transaction ID 可能 >= 0x80），必須 1:1 拷貝，
    ; 不能用按碼點重編碼的 to-str()，否則送出長度與內容都錯。見 §5.2 #88。
    query-str = query.to-bytes-str()
    written = net.net-udp-sendto(fd, query-str, qlen, DNS-DEFAULT-SERVER, DNS-PORT)
    written < 0 -> {
        fs.close(fd)
        return
    }
    resp-str str = with-len(DNS-MAX-PACKET)
    n = net.net-udp-recvfrom(fd, resp-str, DNS-MAX-PACKET)
    fs.close(fd)
    n <= 0 -> return
    resp []byte = with-len(n)
    i <- [0..n): {
        resp[i]: {

            ; ⚠️ 2026-11-12 修：`.byte(i)` 回 `?byte`，直接寫進 byte 槽位會被
            ; 存成 0（option 的標籤被當成值），於是 resp 全是 0、parse-response
            ; 永遠找不到 A 記錄 —— resolve-from / resolve-all 從來沒成功過。
            ok -> it = resp-str.byte(i): {
                ok -> it

                -> 0
            }

            -> _
        }
    }
    ip = parse-response(resp)
}

; 解析域名並建立 TCP 連接
; 先交給 net-dial（內部已支援 hostname 解析）；失敗才用 DNS 取得 IP 後重試一次。
; domain: 域名（或直接寫 IP）
; port: 目標埠號
; 返回 fd: 已連接的 socket 描述符，-1=兩種方式都失敗
; [dial](#dns.dial)
dial = (domain str, port i64) (fd fd) {
    fd = -1

    ; 先嘗試直接連接（net-dial 內建已支援 hostname 解析）
    fd = net.net-dial(domain, port)
    fd >= 0 -> return

    ; 如果直接連接失敗，使用 DNS 解析
    ip = resolve(domain)
    ip: {
        nil ->

        ok -> fd = net.net-dial(ip, port)

        -> _
    }
}
