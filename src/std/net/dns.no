; dns — DNS 解析器（純 Nolang 實作）
;
; 使用 UDP 協定（埠 53）實作 DNS 查詢，支援 A 記錄（IPv4）解析。
; 不依賴 C 庫的 getaddrinfo，直接構造和解析 DNS 封包。
;
; 用法：
;   // 解析域名
;   ip = resolve('example.com')           // 返回 ?str（IP 地址）
;   ip: {
;       nil -> print('解析失敗')
;       -> print(ip)                         // 如 '93.184.216.34'
;   }
;
;   // 指定 DNS 伺服器
;   ip = resolve-from('8.8.8.8', 'example.com')  // 返回 ?str

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; DNS 埠號
DNS-PORT = 53

; 預設 DNS 伺服器（Google Public DNS）
DNS-DEFAULT-SERVER = '8.8.8.8'

; 備用 DNS 伺服器（Cloudflare）
DNS-BACKUP-SERVER = '1.1.1.1'

; DNS 查詢逾時（毫秒）
DNS-TIMEOUT = 3000

; 最大 DNS 封包大小
DNS-MAX-PACKET = 512

; DNS 記錄類型
DNS-TYPE-A = 1
DNS-TYPE-AAAA = 28
DNS-TYPE-CNAME = 5
DNS-TYPE-MX = 15
DNS-TYPE-TXT = 16
DNS-TYPE-NS = 2

; DNS 類別
DNS-CLASS-IN = 1

; DNS 回應碼
DNS-RCODE-NO-ERROR = 0
DNS-RCODE-FORMAT-ERROR = 1
DNS-RCODE-SERVER-FAILURE = 2
DNS-RCODE-NAME-ERROR = 3
DNS-RCODE-NOT-IMPLEMENTED = 4
DNS-RCODE-REFUSED = 5

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; record: DNS 記錄
; rtype i64: 記錄類型（1=A, 5=CNAME, 28=AAAA）
; name str: 域名
; value str: 記錄值（A 記錄為 IP 地址）
; ttl i64: 存活時間
record {
    rtype i64
    name str
    value str
    ttl i64
}

; ═══════════════════════════════════════════════
; 內部工具函數
; ═══════════════════════════════════════════════

; build-query: 構建 DNS 查詢封包
; domain str: 要查詢的域名
; qtype i64: 查詢類型（1=A）
; 返回 query []byte: DNS 查詢封包
build-query = (domain str, qtype i64) (query []byte, qlen i64) {
    ; Pre-allocate: header(12) + domain labels(domain.len+1) + qtype(2) + qclass(2)
    max-len = domain.len + 20
    query = with-len(max-len)
    qlen = 0
    pos = 0

    ; Transaction ID（固定為 1，簡化實作）
    query[pos] = 0
    query[pos + 1] = 1
    pos = pos + 2

    ; Flags: 標準查詢（RD=1）
    query[pos] = 0x01
    query[pos + 1] = 0x00
    pos = pos + 2

    ; QDCOUNT = 1
    query[pos] = 0
    query[pos + 1] = 1
    pos = pos + 2

    ; ANCOUNT = 0
    query[pos] = 0
    query[pos + 1] = 0
    pos = pos + 2

    ; NSCOUNT = 0
    query[pos] = 0
    query[pos + 1] = 0
    pos = pos + 2

    ; ARCOUNT = 0
    query[pos] = 0
    query[pos + 1] = 0
    pos = pos + 2

    ; QNAME: 將域名編碼為長度前綴標籤
    label-start = 0
    i = 0
    {
        is-dot = false
        {
            i == domain.len -> is-dot = true
            domain[i] == 46 -> is-dot = true
        }
        is-dot -> {
            label-len = i - label-start
            label-len > 0 -> {
                query[pos] = label-len & 255
                pos = pos + 1
                j <- [0..label-len): {
                    query[pos] = domain[label-start + j] & 255
                    pos = pos + 1
                }
            }
            label-start = i + 1
        }
        i = i + 1
    } (i <= domain.len)

    ; 終止零標籤
    query[pos] = 0
    pos = pos + 1

    ; QTYPE
    query[pos] = (qtype >> 8) & 255
    query[pos + 1] = qtype & 255
    pos = pos + 2

    ; QCLASS = IN (1)
    query[pos] = 0
    query[pos + 1] = 1
    pos = pos + 2

    qlen = pos
}

; parse-name: 從回應封包中解析域名（支援壓縮指標）
; data []byte: DNS 封包
; offset i64: 起始位置
; 返回 name str: 解析出的域名
; 返回 next-pos i64: 解析後的下一個位置
parse-name = (data []byte, offset i64) (name str, next-pos i64) {
    ; Use a byte buffer for building the name (str indexed assignment requires cap>0)
    buf []byte = with-len(256)
    buf-pos = 0
    pos = offset
    jumped = false
    jump-pos = 0
    end-pos = 0

    {
        pos >= data.len -> *
        len-byte = data[pos] & 255
        len-byte == 0 -> {
            pos = pos + 1
            jumped == false -> end-pos = pos
            *
        }

        ; 檢查是否為壓縮指標（前兩位為 11）
        {
            (len-byte & 0xC0) == 0xC0 -> {
                jumped == false -> end-pos = pos + 2
                pointer = ((len-byte & 0x3F) << 8) | (data[pos + 1] & 255)
                pos = pointer
                jumped = true
            }
            (len-byte & 0xC0) == 0 -> {
                label-len = len-byte
                pos = pos + 1
                i <- [0..label-len): {
                    buf[buf-pos] = data[pos + i]
                    buf-pos = buf-pos + 1
                }
                buf[buf-pos] = 46
                buf-pos = buf-pos + 1
                pos = pos + label-len
            }
        }
    } ()

    ; 移除末尾的點
    buf-pos > 0 -> buf[buf-pos - 1] == 46 -> buf-pos = buf-pos - 1
    ; Convert buffer to string and trim to actual length
    name = buf.to-str()
    name = name.slice(0, buf-pos)
    {
        jumped -> next-pos = end-pos
        -> next-pos = end-pos
    }
}

; parse-response: 解析 DNS 回應封包，返回第一個 A 記錄的 IP
; data []byte: DNS 回應封包
; 返回 ip ?str: ok=IP 地址, nil=未找到 A 記錄
parse-response = (data []byte) (ip ?str) {
    ip = nil
    data.len < 12 -> return

    ; 檢查回應碼
    flags-hi = data[2] & 255
    flags-lo = data[3] & 255
    rcode = flags-lo & 0x0F
    rcode != DNS-RCODE-NO-ERROR -> return

    ; 問題數
    qdcount = ((data[4] & 255) << 8) | (data[5] & 255)

    ; 回答數
    ancount = ((data[6] & 255) << 8) | (data[7] & 255)
    ancount == 0 -> return
    pos = 12

    ; 跳過問題部分
    i <- [0..qdcount): {
        qname = ''
        qname, pos = parse-name(data, pos)
        ; 跳過 QTYPE(2) + QCLASS(2)
        pos = pos + 4
    }

    ; 解析回答部分
    i <- [0..ancount): {
        rname = ''
        rname, pos = parse-name(data, pos)
        pos + 10 > data.len -> return
        rtype = ((data[pos] & 255) << 8) | (data[pos + 1] & 255)
        pos = pos + 2
        ; CLASS (2 bytes)
        pos = pos + 2
        ; TTL (4 bytes)
        pos = pos + 4
        ; RDLENGTH (2 bytes)
        rdlength = ((data[pos] & 255) << 8) | (data[pos + 1] & 255)
        pos = pos + 2
        pos + rdlength > data.len -> return
        ; A 記錄（4 bytes IPv4）
        rtype == DNS-TYPE-A && rdlength == 4 -> {
            a = data[pos] & 255
            b = data[pos + 1] & 255
            c = data[pos + 2] & 255
            d = data[pos + 3] & 255
            sa = a.to-str()
            sb = b.to-str()
            sc = c.to-str()
            sd = d.to-str()
            ip = sa - '.' - sb - '.' - sc - '.' - sd
            return
        }
        pos = pos + rdlength
    }
}

; ═══════════════════════════════════════════════
; 公開 API
; ═══════════════════════════════════════════════

; resolve-from: 使用指定 DNS 伺服器解析域名
; server str: DNS 伺服器 IP（如 '8.8.8.8'）
; domain str: 要解析的域名
; 返回 ip ?str: ok=IP 地址, nil=解析失敗
resolve-from = (server str, domain str) (ip ?str) {
    ip = nil

    ; 構建查詢封包
    query []byte
    qlen = 0
    query, qlen = build-query(domain, DNS-TYPE-A)
    qlen == 0 -> return

    ; 建立 UDP socket
    fd = net.net-udp-open()
    fd < 0 -> return

    ; 設定逾時
    net.net-set-recv-timeout(fd, DNS-TIMEOUT)

    ; 發送查詢
    query-str = query.to-str()
    written = net.net-udp-sendto(fd, query-str, qlen, server, DNS-PORT)
    written < 0 -> {
        fs.close(fd)
        return
    }

    ; 接收回應
    resp-str str = with-len(DNS-MAX-PACKET)
    n = net.net-udp-recvfrom(fd, resp-str, DNS-MAX-PACKET)
    fs.close(fd)
    n <= 0 -> return

    ; 解析回應
    resp []byte = with-len(n)
    i <- [0..n): {
        resp[i] = resp-str[i]
    }
    ip = parse-response(resp)
}

; resolve: 使用預設 DNS 伺服器解析域名
; domain str: 要解析的域名
; 返回 ip ?str: ok=IP 地址, nil=解析失敗
resolve = (domain str) (ip ?str) {
    ; Try primary DNS server first
    ip = resolve-from(DNS-DEFAULT-SERVER, domain)
    ; If primary failed, try backup server
    ip == nil -> ip = resolve-from(DNS-BACKUP-SERVER, domain)
}

; resolve-all: 解析域名，返回第一個 A 記錄
; domain str: 要解析的域名
; 返回 ip ?str: ok=IP 地址, nil=解析失敗
resolve-all = (domain str) (ip ?str) {
    ip = nil

    query []byte
    qlen = 0
    query, qlen = build-query(domain, DNS-TYPE-A)
    qlen == 0 -> return
    fd = net.net-udp-open()
    fd < 0 -> return
    net.net-set-recv-timeout(fd, DNS-TIMEOUT)

    query-str = query.to-str()
    written = net.net-udp-sendto(fd, query-str, qlen, DNS-DEFAULT-SERVER, DNS-PORT)
    written < 0 -> {
        fs.close(fd)
        return
    }

    resp-str str = with-len(DNS-MAX-PACKET)
    n = net.net-udp-recvfrom(fd, resp-str, DNS-MAX-PACKET)
    fs.close(fd)
    n <= 0 -> return
    resp []byte = with-len(n)
    i <- [0..n): {
        resp[i] = resp-str[i]
    }
    ip = parse-response(resp)
}

; dial: 解析域名並建立 TCP 連接
; domain str: 域名
; port i64: 埠號
; 返回 fd fd: socket fd（-1=失敗）
dial = (domain str, port i64) (fd fd) {
    fd = -1

    ; 先嘗試直接連接（net-dial 內建已支援 hostname 解析）
    fd = net.net-dial(domain, port)
    fd >= 0 -> return

    ; 如果直接連接失敗，使用 DNS 解析
    ip = resolve(domain)
    ip: {
        nil ->
        ok -> fd = net.net-dial(ip, port)
        ->
    }
}
