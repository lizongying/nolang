// tls — TLS 用戶端封裝（基於 OpenSSL）
//
// 提供 HTTPS 用的 TLS 連線封裝，可被 http.no 和 http2.no 使用。
// 底層呼叫 tls-init / tls-connect / tls-send / tls-recv / tls-close builtins。
//
// 用法：
//   conn, ok = tls-connect('example.com', 443)
//   if ok {
//       conn.send(data, n)(written, ok)
//       conn.recv(buf, 4096)(n, ok)
//       conn.close()
//   }

// ═══════════════════════════════════════════════
// 常量
// ═══════════════════════════════════════════════

TLS-DEFAULT-PORT = 443
TLS-RECV-BUF = 4096

// ═══════════════════════════════════════════════
// 結構體
// ═══════════════════════════════════════════════

// tls-conn: TLS 連線
// ssl: SSL* 指標（以 i64 儲存，0=未連線）
// fd: 底層 socket fd（用於 close）
// host: 伺服器主機名（用於 SNI）
tls-conn {
    ssl i64
    fd i64
    host str
}

// ═══════════════════════════════════════════════
// 全域初始化
// ═══════════════════════════════════════════════

// tls-global-init: 初始化 OpenSSL 全域 SSL_CTX
// 應用程式啟動時呼叫一次即可
// 返回 ok=true=成功
tls-global-init = () (ok bool) {
    r = tls-init()
    if r == 1 {
        ok = true
    }
}

// ═══════════════════════════════════════════════
// tls-conn 方法
// ═══════════════════════════════════════════════

// tls-conn.init: 初始化（未連線狀態）
tls-conn.init = () {
    .ssl = 0
    .fd = -1
    .host = ''
}

// tls-conn.connect: 建立 TLS 連線
// host: 伺服器主機名（用於 SNI 與 DNS 解析）
// port: 埠號
// 返回 ok=true=成功
tls-conn.connect = (host str, port i64) (ok bool) {
    ok = false
    if .ssl != 0 {
        return
    }
    // 1. TCP 連線
    fd = net-dial(host, port)
    if fd < 0 {
        return
    }
    // 2. TLS 包裝
    ssl = tls-connect(fd, host)
    if ssl == 0 {
        close(fd)
        return
    }
    .ssl = ssl
    .fd = fd
    // 用 slice 載入 host（避免 local str 從陣列元素賦值的 codegen 限制）
    hlen = host.len
    .host = host.slice(0, hlen)
    ok = true
}

// tls-conn.send: 透過 TLS 發送資料
// data: 資料字串, n: 傳送的位元組數
// 返回 written=已傳送位元組數（-1=錯誤）, ok=true=成功
tls-conn.send = (data str, n i64) (written i64, ok bool) {
    ok = false
    written = -1
    if .ssl == 0 {
        return
    }
    written = tls-send(.ssl, data, n)
    if written < 0 {
        return
    }
    ok = true
}

// tls-conn.recv: 透過 TLS 接收資料
// buf: 接收緩衝區, n: 最大接收位元組數
// 返回 read-n=已接收位元組數（-1=錯誤, 0=連線關閉）, ok=true=成功
tls-conn.recv = (buf str, n i64) (read-n i64, ok bool) {
    ok = false
    read-n = -1
    if .ssl == 0 {
        return
    }
    read-n = tls-recv(.ssl, buf, n)
    if read-n < 0 {
        return
    }
    ok = true
}

// tls-conn.close: 關閉 TLS 連線並釋放資源
tls-conn.close = () {
    if .ssl != 0 {
        tls-close(.ssl)
        .ssl = 0
    }
    if .fd >= 0 {
        close(.fd)
        .fd = -1
    }
}

// ═══════════════════════════════════════════════
// 高層 API
// ═══════════════════════════════════════════════

// tls-dial: 便捷函數，建立 TLS 連線
// 會自動呼叫 tls-global-init（內部僅初始化一次）
// 返回 conn=連線, ok=true=成功
tls-dial = (host str, port i64) (conn tls-conn, ok bool) {
    ok = false
    // 確保 OpenSSL 已初始化
    init-ok bool = false
    tls-global-init()(init-ok)
    if init-ok == false {
        return
    }
    conn.init()
    conn.connect(host, port)(ok)
    if ok == false {
        conn.close()
    }
}
