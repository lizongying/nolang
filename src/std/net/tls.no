; tls — TLS 1.2 / 1.3 客戶端（純 Nolang 實現，不依賴 OpenSSL）
;
; TLS 1.3: 支援密碼套件 TLS_AES_128_GCM_SHA256 (0x1301)
;   使用 AES-128-GCM (AEAD) + X25519 ECDHE 金鑰交換 + HKDF 金鑰排程
;
; TLS 1.2: 支援密碼套件 TLS_RSA_WITH_AES_128_CBC_SHA256 (0x003C)
;   使用 AES-128-CBC + HMAC-SHA256 + RSA 金鑰交換
;
; 底層使用 TCP builtins (net-dial, net-send, net-recv, close)
; 加密原語使用 std/hash 下的 AES-128, SHA-256, RSA, HMAC-SHA256, X.509,
; AES-GCM, HKDF, X25519
;
; 用法：
;   conn = tls-dial('example.com', 443)         // 返回 ?tls-conn
;   conn: {
;       nil -> return
;       -> w = conn.send(data)          // 返回 ?i64
;         w: { nil -> return }
;         r = conn.recv(buf, 4096)       // 返回 i64 (-1=錯誤, 0=關閉, >0=位元組數)
;         r < 0 -> return
;         n = r
;         conn.close()
;   }

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

TLS-VERSION = 0x0303
TLS-VERSION-1-3 = 0x0304

; Record content types
TLS-CT-CCS = 20
TLS-CT-ALERT = 21
TLS-CT-HANDSHAKE = 22
TLS-CT-APP-DATA = 23

; Handshake message types
TLS-HS-CLIENT-HELLO = 1
TLS-HS-SERVER-HELLO = 2
TLS-HS-ENCRYPTED-EXTENSIONS = 8
TLS-HS-CERTIFICATE = 11
TLS-HS-SERVER-HELLO-DONE = 14
TLS-HS-CLIENT-KEY-EXCHANGE = 16
TLS-HS-CERTIFICATE-VERIFY = 15
TLS-HS-FINISHED = 20

; Cipher suites
TLS-CIPHER-RSA-AES128-CBC-SHA256 = 0x003C
TLS-CIPHER-AES128-GCM-SHA256 = 0x1301

; Extensions (TLS 1.3)
TLS-EXT-SUPPORTED-GROUPS = 10
TLS-EXT-SIGNATURE-ALGORITHMS = 13
TLS-EXT-SUPPORTED-VERSIONS = 43
TLS-EXT-PSK-KE-MODES = 45
TLS-EXT-KEY-SHARE = 51

; Named groups
TLS-GROUP-X25519 = 0x001D

; Signature algorithms
TLS-SIG-RSA-PKCS1-SHA256 = 0x0401
TLS-SIG-ECDSA-SECP256R1-SHA256 = 0x0403
TLS-SIG-RSA-PKCS1-SHA384 = 0x0501
TLS-SIG-ECDSA-SECP384R1-SHA384 = 0x0503
TLS-SIG-RSA-PKCS1-SHA512 = 0x0601
TLS-SIG-ECDSA-SECP521R1-SHA512 = 0x0603
TLS-SIG-RSA-PSS-RSAE-SHA256 = 0x0804
TLS-SIG-RSA-PSS-RSAE-SHA384 = 0x0805
TLS-SIG-RSA-PSS-RSAE-SHA512 = 0x0806
TLS-SIG-ED25519 = 0x0807

; Key sizes
TLS-MAC-KEY-SIZE = 32
TLS-ENC-KEY-SIZE = 16
TLS-IV-SIZE = 16
TLS-RANDOM-SIZE = 32
TLS-PREMASTER-SIZE = 48
TLS-FINISHED-SIZE = 12

; TLS 1.3 key sizes
TLS13-KEY-SIZE = 16
TLS13-IV-SIZE = 12

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; tls-conn: TLS 連線（支援 1.2 和 1.3）
; fd: 底層 TCP socket fd
; host: 伺服器主機名（用於 SNI）
; connected: 連線狀態
; encrypted: 是否已啟用加密
; version: 協商的 TLS 版本（0x0303=1.2, 0x0304=1.3）
; write-seq / read-seq: 記錄層序號（TLS 1.2 用）
; rand-state: PRNG 狀態
; hs-buf: 交握訊息緩衝區（用於 Finished 驗證）
tls-conn {
    fd fd
    host str
    connected bool
    encrypted bool
    version i64
    write-seq i64
    read-seq i64
    rand-state i64
    client-random [32]byte
    server-random [32]byte
    client-mac-key [32]byte
    server-mac-key [32]byte
    client-enc-key [16]byte
    server-enc-key [16]byte
    hs-buf []byte
    hs-buf-len i64
    client-priv [32]byte
    client-pub [32]byte
    server-pub [32]byte
    shared-secret [32]byte
    hs-client-key [16]byte
    hs-client-iv [12]byte
    hs-server-key [16]byte
    hs-server-iv [12]byte
    ap-client-key [16]byte
    ap-client-iv [12]byte
    ap-server-key [16]byte
    ap-server-iv [12]byte
    hs-write-seq i64
    hs-read-seq i64
    ap-write-seq i64
    ap-read-seq i64
    hs-plain-buf []byte
    hs-plain-pos i64
    hs-plain-len i64
    hs-c-secret [32]byte
    hs-prk-field [32]byte
    master-secret []byte
}

; TLS 1.3 欄位

; ═══════════════════════════════════════════════
; 工具函數
; ═══════════════════════════════════════════════

; tls-rand-bytes: 生成隨機位元組
; n i64: 需要的位元組數
; 返回 out []byte: 隨機位元組陣列
tls-rand-bytes = (state i64, n i64) (out []byte) {
    out = with-len(n)
    i <- [0..n): {
        state, r = rand(state)
        out[i] = state & 255
    }
}

; tls-put-u16: 將 16-bit 大端序值寫入緩衝區
; buf []byte: 緩衝區
; pos i64: 位置
; val i64: 值
tls-put-u16 = (buf []byte, pos i64, val i64) {
    buf[pos] = (val >> 8) & 255
    buf[pos + 1] = val & 255
}

; tls-put-u24: 將 24-bit 大端序值寫入緩衝區
tls-put-u24 = (buf []byte, pos i64, val i64) {
    buf[pos] = (val >> 16) & 255
    buf[pos + 1] = (val >> 8) & 255
    buf[pos + 2] = val & 255
}

; tls-get-u16: 從緩衝區讀取 16-bit 大端序值
tls-get-u16 = (buf []byte, pos i64) (val i64) {
    val = ((buf[pos] & 255) << 8) | (buf[pos + 1] & 255)
}

; tls-get-u24: 從緩衝區讀取 24-bit 大端序值
tls-get-u24 = (buf []byte, pos i64) (val i64) {
    val = ((buf[pos] & 255) << 16) | ((buf[pos + 1] & 255) << 8) | (buf[pos + 2] & 255)
}

; tls-bytes-cat: 串接兩個位元組陣列
tls-bytes-cat = (a []byte, b []byte) (out []byte) {
    an = a.len
    bn = b.len
    out = with-len(an + bn)
    i <- [0..an): {
        out[i] = a[i]
    }
    i <- [0..bn): {
        out[an + i] = b[i]
    }
    out.len = an + bn
}

; ═══════════════════════════════════════════════
; 大整數轉換（用於 RSA）
; ═══════════════════════════════════════════════

; tls-bytes-to-bn: big-endian 位元組陣列 → []i64（little-endian base 2^32）
; data []byte: big-endian 位元組
; 返回 out []i64: 大整數（每個元素為 32-bit limb）
tls-bytes-to-bn = (data []byte) (out []i64) {
    n = data.len
    limb-count = (n + 3) / 4
    out = with-len(limb-count)
    i <- [0..limb-count): {
        out[i] = 0
    }
    i <- [0..n): {
        byte-from-lsb = n - 1 - i
        limb = byte-from-lsb / 4
        shift = (byte-from-lsb % 4) * 8
        out[limb] = out[limb] | ((data[i] & 255) << shift)
    }
    out.len = limb-count
}

; tls-bn-to-bytes: []i64（little-endian base 2^32）→ big-endian 位元組陣列
; num []i64: 大整數
; 返回 out []byte: big-endian 位元組
tls-bn-to-bytes = (num []i64) (out []byte) {
    n = num.len
    out-n = n * 4
    out = with-len(out-n)
    i <- [0..out-n): {
        byte-from-lsb = out-n - 1 - i
        limb = byte-from-lsb / 4
        shift = (byte-from-lsb % 4) * 8
        out[i] = (num[limb] >> shift) & 255
    }

    ; 移除前導零
    {
        i <- [0..out-n - 1): {
            out[i] = out[i + 1]
        }
        out-n = out-n - 1
    } (out-n > 1 && out[0] == 0)
    out.len = out-n
}

; ═══════════════════════════════════════════════
; TLS PRF（基於 HMAC-SHA256）
; ═══════════════════════════════════════════════

; tls-prf: TLS 1.2 PRF（P_SHA256）
; secret []byte: 金鑰材料
; label str: 標籤字串
; seed []byte: 種子
; out-len i64: 需要的輸出長度
; 返回 out []byte: PRF 輸出
tls-prf = (secret []byte, label str, seed []byte, out-len i64) (out []byte) {
    out = with-len(out-len)

    ; label-seed = label || seed
    label-bytes []byte
    label-bytes = label.to-bytes()

    ls []byte
    ls = tls-bytes-cat(label-bytes, seed)

    ; A(0) = HMAC(secret, label-seed)
    ; 注意: hmac-sha256 返回 [32]byte (%arr), 但 tls-bytes-cat/hmac-sha256 的 []byte 參數
    ; 是 %vec, 兩者記憶體佈局不同 (%arr.data 在 offset 8, %vec.data 在 offset 16),
    ; 直接傳遞會造成越界讀取。因此用臨時 [32]byte 接收後複製到 []byte。
    a-tmp [32]byte
    a-tmp = hmac.hmac-sha256(secret, ls)
    a []byte = with-len(32)
    i <- [0..32): {
        a[i] = a-tmp[i]
    }

    out-off = 0
    {

        ; P_i = HMAC(secret, A(i) || label-seed)
        a-and-ls []byte
        a-and-ls = tls-bytes-cat(a, ls)

        p-tmp [32]byte
        p-tmp = hmac.hmac-sha256(secret, a-and-ls)
        p []byte = with-len(32)
        i <- [0..32): {
            p[i] = p-tmp[i]
        }

        ; 複製到輸出
        copy-n = 32
        out-off + copy-n > out-len -> copy-n = out-len - out-off
        i <- [0..copy-n): {
            out[out-off + i] = p[i]
        }
        out-off = out-off + copy-n

        ; A(i+1) = HMAC(secret, A(i))
        a-tmp = hmac.hmac-sha256(secret, a)
        i <- [0..32): {
            a[i] = a-tmp[i]
        }
    } (out-off < out-len)
}

; ═══════════════════════════════════════════════
; 記錄層（Record Layer）
; ═══════════════════════════════════════════════

; tls-recv-n: 從 socket 讀取恰好 n 個位元組
; fd fd: socket fd
; buf []byte: 接收緩衝區
; n i64: 需要讀取的位元組數
; 返回 ok bool: true=成功
tls-recv-n = (fd fd, buf []byte, n i64) (ok bool) {
    ok = false
    total = 0
    {
        tmp str = ' '.repeat(n - total)
        r = net.net-recv(fd, tmp, n - total)
        r <= 0 -> return
        i <- [0..r): {
            buf[total + i] = tmp[i]
        }
        total = total + r
    } (total < n)
    ok = true
}

; tls-read-record: 讀取一筆 TLS 記錄
; fd fd: socket fd
; buf []byte: 記錄緩衝區（含標頭+資料, buf[0..4]=header, buf[5..]=body）
; 返回 ct i64: content type（-1=錯誤）
; 返回 rlen i64: 資料長度（不含標頭）
tls-read-record = (fd fd, buf []byte) (ct i64, rlen i64) {
    ct = -1
    rlen = 0

    ; 讀取 5 位元組標頭 into buf[0..4]
    hdr-total = 0
    {
        tmp str = ' '.repeat(5 - hdr-total)
        r = net.net-recv(fd, tmp, 5 - hdr-total)
        r <= 0 -> return
        i <- [0..r): {
            buf[hdr-total + i] = tmp[i]
        }
        hdr-total = hdr-total + r
    } (hdr-total < 5)

    ; 解析標頭
    ct = buf[0] & 255
    rlen = tls-get-u16(buf, 3)

    rlen > 16384 -> {
        ct = -1
        return
    }

    ; 讀取 body into buf[5..5+rlen-1]
    body-total = 0
    {
        tmp2 str = ' '.repeat(rlen - body-total)
        r = net.net-recv(fd, tmp2, rlen - body-total)
        r <= 0 -> {
            ct = -1
            return
        }
        i <- [0..r): {
            buf[5 + body-total + i] = tmp2[i]
        }
        body-total = body-total + r
    } (body-total < rlen)
    ; 注意：不修改 buf.len（vet 禁止修改 slice 的 len 欄位）。
    ; 呼叫端使用返回的 rlen 來判斷實際資料長度。
}

; tls-send-raw: 發送原始 TLS 記錄（未加密）
; fd fd: socket fd
; ct i64: content type
; data []byte: 資料
tls-send-raw = (fd fd, ct i64, data []byte) {
    n = data.len
    hdr [5]byte
    hdr[0] = ct & 255
    hdr[1] = (TLS-VERSION >> 8) & 255
    hdr[2] = TLS-VERSION & 255
    hdr[3] = (n >> 8) & 255
    hdr[4] = n & 255
    net.net-send(fd, hdr, 5)
    net.net-send(fd, data, n)
}

; ═══════════════════════════════════════════════
; 記錄層加密/解密
; ═══════════════════════════════════════════════

; append-hs: 將交握訊息追加到緩衝區
; data []byte: 訊息資料
tls-conn.append-hs = (data []byte) {
    n = data.len
    i <- [0..n): {
        .hs-buf[.hs-buf-len + i] = data[i]
    }
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; append-hs-from: 從 buf 的 offset 位置追加 n 位元組到交握緩衝區
; buf []byte: 來源緩衝區（含 record header）
; offset i64: 起始偏移（通常為 5, 跳過 record header）
; n i64: 要追加的位元組數
tls-conn.append-hs-from = (buf []byte, offset i64, n i64) {
    i <- [0..n): {
        .hs-buf[.hs-buf-len + i] = buf[offset + i]
    }
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; encrypt-record: 加密記錄並發送
; ct i64: 原始 content type
; data []byte: 明文資料
; 返回 ok bool: true=成功
tls-conn.encrypt-record = (ct i64, data []byte) (ok bool) {
    ok = false
    n = data.len

    ; 1. 計算 MAC
    ; MAC = HMAC-SHA256(mac_key, seq_num(8) + type(1) + version(2) + length(2) + content)
    mac-input []byte = with-len(13 + n)

    ; seq_num (8 bytes big-endian)
    seq = .write-seq
    i <- [0..8): {
        mac-input[7 - i] = (seq >> (i * 8)) & 255
    }
    mac-input[8] = ct & 255
    tls-put-u16(mac-input, 9, TLS-VERSION)
    tls-put-u16(mac-input, 11, n)
    i <- [0..n): {
        mac-input[13 + i] = data[i]
    }
    mac [32]byte
    mac = hmac.hmac-sha256(.client-mac-key[..], mac-input)

    ; 2. 明文 + MAC
    plain []byte = with-len(n + 32)
    i <- [0..n): {
        plain[i] = data[i]
    }
    i <- [0..32): {
        plain[n + i] = mac[i]
    }
    plain-len = n + 32
    plain.len = plain-len

    ; 3. PKCS#7 填充
    padded []byte
    padded = aes-cbc.pkcs7-pad(plain)

    ; 4. 生成隨機 IV
    iv [16]byte
    iv-bytes []byte = tls-rand-bytes(.rand-state, 16)
    i <- [0..16): {
        iv[i] = iv-bytes[i]
    }

    ; 5. AES-128-CBC 加密
    cipher []byte
    cipher = aes-cbc.aes-128-cbc-enc(padded, .client-enc-key, iv)

    ; 6. 構建記錄: type(1) + version(2) + length(2) + IV(16) + cipher
    rec-len = 16 + padded.len
    rec []byte = with-len(5 + rec-len)
    rec[0] = TLS-CT-APP-DATA & 255
    tls-put-u16(rec, 1, TLS-VERSION)
    tls-put-u16(rec, 3, rec-len)
    i <- [0..16): {
        rec[5 + i] = iv[i]
    }
    i <- [0..padded.len): {
        rec[5 + 16 + i] = cipher[i]
    }
    rec.len = 5 + rec-len

    ; 7. 發送
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return
    .write-seq = .write-seq + 1
    ok = true
}

; decrypt-record: 解密記錄
; buf []byte: 接收到的記錄資料（從標頭開始）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
tls-conn.decrypt-record = (buf []byte, expected-ct i64) (ct i64, out []byte) {
    ct = -1

    rlen i64 = tls-get-u16(buf, 3)
    rlen < 16 -> return

    ; 提取 IV
    iv [16]byte
    i <- [0..16): {
        iv[i] = buf[5 + i] & 255
    }

    ; 密文
    cipher-len = rlen - 16
    cipher []byte = with-len(cipher-len)
    i <- [0..cipher-len): {
        cipher[i] = buf[5 + 16 + i] & 255
    }
    cipher.len = cipher-len

    ; AES-128-CBC 解密
    plain []byte
    plain = aes-cbc.aes-128-cbc-dec(cipher, .server-enc-key, iv)
    plain-len = cipher-len

    ; 移除 PKCS#7 填充
    unpad-n i64 = aes-cbc.pkcs7-unpad(plain)
    unpad-n < 0 -> return
    plain-len = unpad-n

    ; 驗證 MAC（最後 32 位元組為 MAC）
    plain-len < 32 -> return
    content-len = plain-len - 32

    ; 計算期望 MAC
    mac-input []byte = with-len(13 + content-len)
    seq = .read-seq
    i <- [0..8): {
        mac-input[7 - i] = (seq >> (i * 8)) & 255
    }

    ; TLS 1.2 中加密記錄的 type 固定為 23，但 MAC 計算使用原始 type
    mac-input[8] = expected-ct & 255
    tls-put-u16(mac-input, 9, TLS-VERSION)
    tls-put-u16(mac-input, 11, content-len)
    i <- [0..content-len): {
        mac-input[13 + i] = plain[i]
    }
    exp-mac [32]byte
    exp-mac = hmac.hmac-sha256(.server-mac-key[..], mac-input)

    ; 驗證 MAC
    recv-mac-off = content-len
    i <- [0..32): {
        b1 = plain[recv-mac-off + i] & 255
        b2 = exp-mac[i] & 255
        b1 != b2 -> return
    }

    ; 輸出明文
    out = with-cap(rlen)
    i <- [0..content-len): {
        out[i] = plain[i]
    }
    out.len = content-len
    ct = expected-ct
    .read-seq = .read-seq + 1
}

; ═══════════════════════════════════════════════
; RSA PKCS#1 v1.5 加密
; ═══════════════════════════════════════════════

; tls-rsa-pkcs1-encrypt: RSA PKCS#1 v1.5 加密
; msg []byte: 訊息（premaster secret, 48 bytes）
; mod-bytes []byte: RSA 模數（big-endian）
; exp i64: RSA 公鑰指數
; 返回 out []byte: 加密後的資料（長度 = mod-bytes.len）
tls-rsa-pkcs1-encrypt = (msg []byte, mod-bytes []byte, exp i64) (out []byte) {
    msg-n = msg.len
    mod-n = mod-bytes.len

    ; PKCS#1 v1.5 填充: 0x00 || 0x02 || PS || 0x00 || msg
    ; PS 長度 = mod-n - msg-n - 3
    ps-len = mod-n - msg-n - 3
    ps-len < 8 -> return

    ; 構建填充後的訊息
    padded []byte = with-len(mod-n)
    padded[0] = 0
    padded[1] = 2

    ; PS: 非零隨機位元組
    state = time.now-ns()
    i <- [0..ps-len): {
        state, r = rand(state)
        b = state & 255
        b == 0 -> b = 1
        padded[2 + i] = b
    }
    padded[2 + ps-len] = 0

    ; 複製訊息
    i <- [0..msg-n): {
        padded[3 + ps-len + i] = msg[i]
    }
    padded-n = mod-n
    padded.len = padded-n

    ; 轉換為大整數
    m-bn []i64
    m-bn = tls-bytes-to-bn(padded)

    ; 模數轉大整數
    n-bn []i64
    n-bn = tls-bytes-to-bn(mod-bytes)

    ; 指數轉大整數
    e-bn []i64 = with-len(1)
    e-bn[0] = exp

    ; RSA 加密: c = m^e mod n
    c-bn []i64
    c-bn, c-bn-n = rsa.rsa-modpow(m-bn, m-bn.len, e-bn, 1, n-bn, n-bn.len)

    ; 轉換回位元組
    raw []byte
    raw = tls-bn-to-bytes(c-bn)

    ; 確保輸出長度 = mod-n（左側補零）
    raw.len == mod-n -> out = raw
    raw.len < mod-n -> {

        ; 建立新緩衝區, 左側補零
        out = with-len(mod-n)
        shift = mod-n - raw.len
        i <- [0..shift): {
            out[i] = 0
        }
        i <- [0..raw.len): {
            out[shift + i] = raw[i]
        }
    }

    raw.len > mod-n -> {

        ; 結果比模數長（不應發生）, 截斷
        out = with-len(mod-n)
        off = raw.len - mod-n
        i <- [0..mod-n): {
            out[i] = raw[off + i]
        }
    }
}

; ═══════════════════════════════════════════════
; 交握協議（Handshake Protocol）
; ═══════════════════════════════════════════════

; send-client-hello: 發送 ClientHello
; 返回 ok bool: true=成功
tls-conn.send-client-hello = () (ok bool) {
    ok = false

    ; ClientHello 訊息
    hs []byte = with-len(256)
    pos = 0

    ; msg_type = 1 (ClientHello)
    hs[0] = TLS-HS-CLIENT-HELLO
    pos = 1

    ; length (3 bytes, 填入後計算)
    pos = 4

    ; version = 0x0303
    tls-put-u16(hs, pos, TLS-VERSION)
    pos = pos + 2

    ; random (32 bytes)
    rand-bytes []byte = tls-rand-bytes(.rand-state, 32)
    i <- [0..32): {
        hs[pos + i] = rand-bytes[i]
        .client-random[i] = rand-bytes[i]
    }
    pos = pos + 32

    ; session_id_length = 0
    hs[pos] = 0
    pos = pos + 1

    ; cipher_suites_length = 2 (一個 cipher suite)
    tls-put-u16(hs, pos, 2)
    pos = pos + 2

    ; cipher_suite = TLS_RSA_WITH_AES_128_CBC_SHA256
    tls-put-u16(hs, pos, TLS-CIPHER-RSA-AES128-CBC-SHA256)
    pos = pos + 2

    ; compression_methods_length = 1
    hs[pos] = 1
    pos = pos + 1

    ; compression_method = 0 (null)
    hs[pos] = 0
    pos = pos + 1

    ; 填入 length
    body-len = pos - 4
    tls-put-u24(hs, 1, body-len)

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 發送為 handshake 記錄
    tls-send-raw(.fd, TLS-CT-HANDSHAKE, hs)

    ok = true
}

; read-server-hello: 讀取 ServerHello
; 返回 ok bool: true=成功
tls-conn.read-server-hello = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return

    ; 追加到交握緩衝區（只追加 handshake 資料部分，跳過 5-byte record header）
    .append-hs-from(buf, 5, rlen)

    ; 解析 handshake message（buf[5] = handshake type, buf[6..8] = length, buf[9+] = data）
    pos = 9
    msg-type = buf[5] & 255
    msg-type != TLS-HS-SERVER-HELLO -> return
    msg-len i64 = tls-get-u24(buf, 6)

    ; version（buf[9..10]）
    pos = pos + 2

    ; random (32 bytes)
    i <- [0..32): {
        .server-random[i] = buf[pos + i] & 255
    }
    pos = pos + 32

    ; session_id
    sid-len = buf[pos] & 255
    pos = pos + 1 + sid-len

    ; cipher_suite
    cipher i64 = tls-get-u16(buf, pos)
    pos = pos + 2
    cipher != TLS-CIPHER-RSA-AES128-CBC-SHA256 -> return

    ; compression_method
    comp = buf[pos] & 255
    pos = pos + 1
    comp != 0 -> return
    ok = true
}

; read-certificate: 讀取 Certificate
; cert-out []byte: 輸出憑證 DER 資料
; 返回 ok bool: true=成功
tls-conn.read-certificate = (cert-out []byte) (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return
    .append-hs-from(buf, 5, rlen)

    ; 解析 handshake message（buf[5] = type, buf[6..8] = length, buf[9+] = data）
    msg-type = buf[5] & 255
    msg-type != TLS-HS-CERTIFICATE -> return
    pos = 9

    ; total certs length (3 bytes)
    total-len i64 = tls-get-u24(buf, pos)
    pos = pos + 3

    ; first cert length (3 bytes)
    cert-len i64 = tls-get-u24(buf, pos)
    pos = pos + 3

    ; 複製憑證
    i <- [0..cert-len): {
        cert-out[i] = buf[pos + i]
    }
    cert-out.len = cert-len
    ok = true
}

; read-server-hello-done: 讀取 ServerHelloDone
; 返回 ok bool: true=成功
tls-conn.read-server-hello-done = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return
    .append-hs-from(buf, 5, rlen)

    msg-type = buf[5] & 255
    msg-type != TLS-HS-SERVER-HELLO-DONE -> return
    ok = true
}

; send-client-key-exchange: 發送 ClientKeyExchange
; premaster []byte: premaster secret (48 bytes)
; cert []byte: 伺服器憑證 DER
; 返回 ok bool: true=成功
tls-conn.send-client-key-exchange = (premaster []byte, cert []byte) (ok bool) {
    ok = false
    cert-n = cert.len

    ; 提取 RSA 公鑰
    mod-bytes []byte
    mod-bytes = x509.x509-rsa-n(cert)
    mod-bytes.len == 0 -> return
    exp i64 = x509.x509-rsa-e(cert)
    exp == 0 -> exp = 65537

    ; RSA 加密 premaster secret
    enc-premaster []byte
    enc-premaster = tls-rsa-pkcs1-encrypt(premaster, mod-bytes, exp)
    enc-premaster.len == 0 -> return

    ; 構建 ClientKeyExchange 訊息
    ; length = 2 + enc-premaster.len
    body-len = 2 + enc-premaster.len
    hs-len = 4 + body-len
    hs []byte = with-len(hs-len)
    hs[0] = TLS-HS-CLIENT-KEY-EXCHANGE

    tls-put-u24(hs, 1, body-len)

    ; encrypted premaster length
    tls-put-u16(hs, 4, enc-premaster.len)

    ; encrypted premaster
    i <- [0..enc-premaster.len): {
        hs[6 + i] = enc-premaster[i]
    }

    .append-hs(hs)
    tls-send-raw(.fd, TLS-CT-HANDSHAKE, hs)

    ok = true
}

; send-change-cipher-spec: 發送 ChangeCipherSpec
tls-conn.send-change-cipher-spec = () {
    ccs [1]byte
    ccs[0] = 1
    hdr [5]byte
    hdr[0] = TLS-CT-CCS & 255
    hdr[1] = (TLS-VERSION >> 8) & 255
    hdr[2] = TLS-VERSION & 255
    hdr[3] = 0
    hdr[4] = 1
    net.net-send(.fd, hdr, 5)
    net.net-send(.fd, ccs, 1)
}

; send-finished: 發送加密的 Finished 訊息
; 返回 ok bool: true=成功
tls-conn.send-finished = () (ok bool) {
    ok = false

    ; 計算 handshake hash
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; verify_data = PRF(master, "client finished", hash, 12)
    verify []byte
    verify = tls-prf(.master-secret, 'client finished', hs-hash, TLS-FINISHED-SIZE)

    ; 構建 Finished 訊息
    hs-len = 4 + TLS-FINISHED-SIZE
    hs []byte = with-len(hs-len)
    hs[0] = TLS-HS-FINISHED
    tls-put-u24(hs, 1, TLS-FINISHED-SIZE)
    i <- [0..TLS-FINISHED-SIZE): {
        hs[4 + i] = verify[i]
    }

    ; 追加到交握緩衝區（在加密之前）
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record(TLS-CT-HANDSHAKE, hs)
}

; read-change-cipher-spec: 讀取 ChangeCipherSpec
; 返回 ok bool: true=成功
tls-conn.read-change-cipher-spec = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-CCS -> return
    rlen != 1 -> return
    (buf[5] & 255) != 1 -> return
    ok = true
}

; read-finished: 讀取加密的 Finished 訊息
; 返回 ok bool: true=成功
tls-conn.read-finished = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-APP-DATA -> return

    ; 解密
    plain []byte
    d-ct = 0
    d-ct, plain = .decrypt-record(buf, TLS-CT-HANDSHAKE)
    d-ct < 0 -> return

    ; 解析 Finished 訊息
    msg-type = plain[0] & 255
    msg-type != TLS-HS-FINISHED -> return

    ; 驗證 verify_data（hash 不包含 server Finished）
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    verify []byte
    verify = tls-prf(.master-secret, 'server finished', hs-hash, TLS-FINISHED-SIZE)

    i <- [0..TLS-FINISHED-SIZE): {
        b1 = plain[4 + i] & 255
        b2 = verify[i] & 255
        b1 != b2 -> return
    }

    ; 驗證成功後追加到交握緩衝區
    .append-hs(plain)

    ok = true
}

; ═══════════════════════════════════════════════
; 金鑰推導
; ═══════════════════════════════════════════════

; derive-keys: 從 premaster secret 推導所有金鑰
; premaster []byte: premaster secret (48 bytes)
tls-conn.derive-keys = (premaster []byte) {

    ; master_secret = PRF(premaster, "master secret", client_random + server_random, 48)
    seed []byte = with-len(64)
    i <- [0..32): {
        seed[i] = .client-random[i]
    }
    i <- [0..32): {
        seed[32 + i] = .server-random[i]
    }
    seed.len = 64

    .master-secret = tls-prf(premaster, 'master secret', seed, 48)

    ; key_block = PRF(master, "key expansion", server_random + client_random, 96)
    ; 96 = 2*MAC_KEY + 2*ENC_KEY (no IVs in TLS 1.2 CBC)
    ks []byte = with-len(64)
    i <- [0..32): {
        ks[i] = .server-random[i]
    }
    i <- [0..32): {
        ks[32 + i] = .client-random[i]
    }
    ks.len = 64

    key-block []byte
    key-block = tls-prf(.master-secret, 'key expansion', ks, 96)

    ; 分割 key_block
    ; client_write_MAC_key (32)
    i <- [0..32): {
        .client-mac-key[i] = key-block[i]
    }

    ; server_write_MAC_key (32)
    i <- [0..32): {
        .server-mac-key[i] = key-block[32 + i]
    }

    ; client_write key (16)
    i <- [0..16): {
        .client-enc-key[i] = key-block[64 + i]
    }

    ; server_write key (16)
    i <- [0..16): {
        .server-enc-key[i] = key-block[80 + i]
    }

    ; 重置序號
    .write-seq = 0
    .read-seq = 0
}

; ═══════════════════════════════════════════════
; TLS 1.3 交握與記錄層
; ═══════════════════════════════════════════════

; send-client-hello-13: 發送 TLS 1.3 ClientHello（含擴展）
; 返回 ok bool: true=成功
tls-conn.send-client-hello-13 = () (ok bool) {
    ok = false

    ; 生成 X25519 金鑰對（內聯實現，避免多返回值 [32]byte 的編譯器 bug）
    seed = .rand-state
    .rand-state = .rand-state + 1

    ; 生成私鑰
    kp-state = seed
    i <- [0..32): {
        kp-state, kp-r = rand(kp-state)
        .client-priv[i] = kp-state & 255
    }
    .client-priv[0] = .client-priv[0] & 248
    .client-priv[31] = .client-priv[31] & 127
    .client-priv[31] = .client-priv[31] | 64

    ; 透過 []byte 傳遞給 x25519（避開全域 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i] = .client-priv[i]
    }
    pub-slice []byte = x25519.x25519-scalarmult-base-bytes(priv-slice)
    i <- [0..32): {
        .client-pub[i] = pub-slice[i]
    }

    ; 構建 ClientHello
    hs []byte = with-len(512)
    pos = 0

    ; msg_type = 1 (ClientHello)
    hs[0] = TLS-HS-CLIENT-HELLO
    pos = 4

    ; version = 0x0303（TLS 1.2，相容性）
    tls-put-u16(hs, pos, TLS-VERSION)
    pos = pos + 2

    ; random (32 bytes)
    rand-bytes []byte = tls-rand-bytes(.rand-state, 32)
    .rand-state = .rand-state + 32
    i <- [0..32): {
        hs[pos + i] = rand-bytes[i]
        .client-random[i] = rand-bytes[i]
    }
    pos = pos + 32

    ; session_id_length = 0
    hs[pos] = 0
    pos = pos + 1

    ; cipher_suites: 2 suites = 4 bytes
    tls-put-u16(hs, pos, 4)
    pos = pos + 2

    ; TLS_AES_128_GCM_SHA256 (TLS 1.3, 0x1301)
    tls-put-u16(hs, pos, TLS-CIPHER-AES128-GCM-SHA256)
    pos = pos + 2

    ; TLS_RSA_WITH_AES_128_CBC_SHA256 (TLS 1.2, 0x003C)
    tls-put-u16(hs, pos, TLS-CIPHER-RSA-AES128-CBC-SHA256)
    pos = pos + 2

    ; compression_methods_length = 1
    hs[pos] = 1
    pos = pos + 1
    hs[pos] = 0
    pos = pos + 1

    ; === 擴展 ===
    ; 計算擴展總長度（先記錄位置，稍後填入）
    ext-len-pos = pos
    pos = pos + 2

    ; 擴展 1: supported_versions (43)
    tls-put-u16(hs, pos, TLS-EXT-SUPPORTED-VERSIONS)
    pos = pos + 2

    ; ext data length = 3
    tls-put-u16(hs, pos, 3)
    pos = pos + 2

    ; versions list length = 2
    hs[pos] = 2
    pos = pos + 1

    ; TLS 1.3 = 0x0304
    tls-put-u16(hs, pos, TLS-VERSION-1-3)
    pos = pos + 2

    ; 擴展 2: supported_groups (10)
    tls-put-u16(hs, pos, TLS-EXT-SUPPORTED-GROUPS)
    pos = pos + 2

    ; ext data length = 4
    tls-put-u16(hs, pos, 4)
    pos = pos + 2

    ; groups list length = 2
    tls-put-u16(hs, pos, 2)
    pos = pos + 2

    ; x25519 = 0x001D
    tls-put-u16(hs, pos, TLS-GROUP-X25519)
    pos = pos + 2

    ; 擴展 3: signature_algorithms (13)
    tls-put-u16(hs, pos, TLS-EXT-SIGNATURE-ALGORITHMS)
    pos = pos + 2

    ; 9 個演算法 = 18 bytes; ext data length = 2 (list len) + 18 = 20
    tls-put-u16(hs, pos, 20)
    pos = pos + 2

    ; sig algs list length = 18
    tls-put-u16(hs, pos, 18)
    pos = pos + 2

    ; 依優先順序：RSA-PSS（現代首選）> ECDSA > RSA-PKCS1
    tls-put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA256)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-ECDSA-SECP256R1-SHA256)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA384)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-ECDSA-SECP384R1-SHA384)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA512)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-ECDSA-SECP521R1-SHA512)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA256)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA384)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA512)
    pos = pos + 2

    ; 擴展 4: key_share (51)
    tls-put-u16(hs, pos, TLS-EXT-KEY-SHARE)
    pos = pos + 2

    ; ext data length = 2 (client_shares_len) + 2 (group) + 2 (key_len) + 32 (key) = 38
    tls-put-u16(hs, pos, 38)
    pos = pos + 2

    ; client key shares length = 2 (group) + 2 (key_len) + 32 (key) = 36
    tls-put-u16(hs, pos, 36)
    pos = pos + 2

    ; group = x25519
    tls-put-u16(hs, pos, TLS-GROUP-X25519)
    pos = pos + 2

    ; key = 32 bytes
    tls-put-u16(hs, pos, 32)
    pos = pos + 2
    i <- [0..32): {
        hs[pos + i] = .client-pub[i]
    }
    pos = pos + 32

    ; 擴展 5: server_name (SNI, 0) — 必須包含，否則伺服器可能拒絕
    tls-put-u16(hs, pos, 0)
    pos = pos + 2

    ; ext data length = 2 + 1 + 2 + host.len
    sni-ext-len = 5 + .host.len
    tls-put-u16(hs, pos, sni-ext-len)
    pos = pos + 2

    ; server name list length = 1 + 2 + host.len
    sni-list-len = 3 + .host.len
    tls-put-u16(hs, pos, sni-list-len)
    pos = pos + 2

    ; name type = 0 (host_name)
    hs[pos] = 0
    pos = pos + 1

    ; name length
    tls-put-u16(hs, pos, .host.len)
    pos = pos + 2

    ; name
    i <- [0...host.len): {
        hs[pos + i] = .host[i]
    }
    pos = pos + .host.len

    ; 填入擴展總長度
    ext-total = pos - ext-len-pos - 2
    tls-put-u16(hs, ext-len-pos, ext-total)

    ; 填入 handshake message length
    body-len = pos - 4
    tls-put-u24(hs, 1, body-len)

    ; 設定實際長度
    hs.len = pos

    ; debug: 列印 ClientHello 內容
    dump = ''
    j <- [0..pos): {
        b = hs[j] & 255
        dump = dump - b.to-str() - ' '
    }

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 發送
    tls-send-raw(.fd, TLS-CT-HANDSHAKE, hs)

    ok = true
}

; read-server-hello-13: 讀取 ServerHello 並偵測 TLS 版本
; 返回 ok bool: true=TLS 1.3, false=TLS 1.2 或失敗
tls-conn.read-server-hello-13 = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> {
        ct == 21 -> {
            ; alert message: buf[5] = level, buf[6] = description
        }
        return
    }
    .append-hs-from(buf, 5, rlen)

    ; 解析 handshake message（buf[5] = type, buf[6..8] = length, buf[9+] = data）
    msg-type = buf[5] & 255
    msg-type != TLS-HS-SERVER-HELLO -> return
    pos = 9

    ; server version（TLS 1.3 中為 0x0303，實際版本在擴展中）
    pos = pos + 2

    ; random (32 bytes)
    i <- [0..32): {
        .server-random[i] = buf[pos + i] & 255
    }
    pos = pos + 32

    ; session_id
    sid-len = buf[pos] & 255
    pos = pos + 1 + sid-len

    ; cipher_suite
    cipher i64 = tls-get-u16(buf, pos)
    pos = pos + 2

    ; compression_method
    pos = pos + 1

    ; 檢查是否有擴展
    pos + 2 > rlen + 5 -> {

        ; 無擴展，TLS 1.2
        .version = TLS-VERSION
        return
    }

    ext-len i64 = tls-get-u16(buf, pos)
    pos = pos + 2
    ext-end = pos + ext-len

    ; 掃描擴展尋找 supported_versions 和 key_share
    is-tls13 = false
    {
        ext-type i64 = tls-get-u16(buf, pos)
        pos = pos + 2
        ext-data-len i64 = tls-get-u16(buf, pos)
        pos = pos + 2

        ext-type == TLS-EXT-SUPPORTED-VERSIONS -> {

            ; supported_versions (server): 2 bytes selected_version
            ; supported_versions (client): 1 byte list length + list
            ; 伺服器版本只有 2 bytes
            ext-data-len == 2 -> {
                sv = tls-get-u16(buf, pos)
                sv == TLS-VERSION-1-3 -> is-tls13 = true
            }
        }

        ext-type == TLS-EXT-KEY-SHARE -> {

            ; key_share: 2 bytes group + 2 bytes key length + key
            ks-group = tls-get-u16(buf, pos)
            ks-len i64 = tls-get-u16(buf, pos + 2)
            ks-group == TLS-GROUP-X25519 && ks-len == 32 -> {
                i <- [0..32): {
                    .server-pub[i] = buf[pos + 4 + i] & 255
                }
            }
        }

        pos = pos + ext-data-len
    } (pos < ext-end)

    {
        is-tls13 -> {
            .version = TLS-VERSION-1-3
            ok = true
        }
        -> .version = TLS-VERSION
    }
}

; compute-shared-secret-13: 計算 ECDHE 共享金鑰
tls-conn.compute-shared-secret-13 = () {

    ; 透過 []byte 傳遞給 x25519（避開 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    pub-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i] = .client-priv[i]
        pub-slice[i] = .server-pub[i]
    }
    shared-slice []byte = x25519.x25519-scalarmult-bytes(priv-slice, pub-slice)
    i <- [0..32): {
        .shared-secret[i] = shared-slice[i]
    }
}

; derive-traffic-keys-13: 推導交握金鑰和應用金鑰
; 使用 HKDF 金鑰排程（RFC 8446 §7.1）
tls-conn.derive-handshake-keys-13 = () {

    ; 1. Early Secret = HKDF-Extract(0, 0^HashLen)
    ;    salt=0 表示使用 HashLen 個零（hkdf-extract 內部處理空 salt）
    ;    ikm=PSK，無 PSK 時為 32 個零位元組（不是空 slice！）
    zero-32 []byte = with-len(32)
    i <- [0..32): {
        zero-32[i] = 0
    }
    empty-ctx []byte = with-len(0)
    early-prk [32]byte
    early-prk = hkdf.hkdf-extract(zero-32, zero-32)

    ; 2. Empty hash = SHA-256("")
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i] = empty-hash-arr[i]
    }

    ; 3. derived = HKDF-Expand-Label(Early, "derived", empty_hash, 32)
    derived-early []byte
    derived-early = hkdf.hkdf-expand-label-vec(early-prk[..], 'derived', empty-hash, 32)

    ; 4. Handshake Secret = HKDF-Extract(derived, ECDHE_shared_secret)
    hs-prk [32]byte
    hs-prk = hkdf.hkdf-extract(derived-early, .shared-secret[..])

    ; 儲存 Handshake Secret 供 derive-application-keys-13 使用
    i <- [0..32): {
        .hs-prk-field[i] = hs-prk[i]
    }

    ; 5. 計算 transcript hash = SHA-256(ClientHello + ServerHello)
    ; .hs-buf 目前包含 ClientHello 和 ServerHello
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; 6. client_handshake_traffic_secret = Derive-Secret(HS, "c hs traffic", transcript)
    c-hs-secret []byte
    c-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 'c hs traffic', hs-hash, 32)

    ; 儲存 client handshake traffic secret 供 send-finished-13 使用
    i <- [0..32): {
        .hs-c-secret[i] = c-hs-secret[i]
    }

    ; 7. server_handshake_traffic_secret = Derive-Secret(HS, "s hs traffic", transcript)
    s-hs-secret []byte
    s-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 's hs traffic', hs-hash, 32)

    ; 8. 推導金鑰和 IV
    ; client handshake key = HKDF-Expand-Label(c_hs_secret, "key", "", 16)
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .hs-client-key[i] = key-tmp[i]
    }

    ; client handshake IV = HKDF-Expand-Label(c_hs_secret, "iv", "", 12)
    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .hs-client-iv[i] = iv-tmp[i]
    }

    ; server handshake key
    key-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .hs-server-key[i] = key-tmp[i]
    }

    ; server handshake IV
    iv-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .hs-server-iv[i] = iv-tmp[i]
    }

    ; 儲存 handshake secret 供後續推導應用金鑰
    ; 保存到 shared-secret 的空間（重用）
    i <- [0..32): {
        .shared-secret[i] = hs-prk[i]
    }

    .hs-write-seq = 0
    .hs-read-seq = 0
}

; derive-application-keys-13: 推導應用層金鑰
tls-conn.derive-application-keys-13 = () {

    ; 從 handshake secret 推導
    hs-prk []byte = with-len(32)
    i <- [0..32): {
        hs-prk[i] = .hs-prk-field[i]
    }

    ; derived = HKDF-Expand-Label(HS, "derived", empty_hash, 32)
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i] = empty-hash-arr[i]
    }
    derived-hs []byte
    derived-hs = hkdf.hkdf-expand-label-vec(hs-prk, 'derived', empty-hash, 32)

    ; Master Secret = HKDF-Extract(derived, 0^HashLen)
    zero-32 []byte = with-len(32)
    i <- [0..32): {
        zero-32[i] = 0
    }
    empty-ctx []byte = with-len(0)
    ms-prk [32]byte
    ms-prk = hkdf.hkdf-extract(derived-hs, zero-32)

    ; transcript hash = SHA-256(ClientHello..server Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; client_application_traffic_secret
    c-ap-secret []byte
    c-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 'c ap traffic', hs-hash, 32)

    ; server_application_traffic_secret
    s-ap-secret []byte
    s-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 's ap traffic', hs-hash, 32)

    ; 推導金鑰和 IV
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .ap-client-key[i] = key-tmp[i]
    }
    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .ap-client-iv[i] = iv-tmp[i]
    }
    key-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .ap-server-key[i] = key-tmp[i]
    }
    iv-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .ap-server-iv[i] = iv-tmp[i]
    }

    .ap-write-seq = 0
    .ap-read-seq = 0
}

; tls13-build-nonce: 構建 AEAD nonce
; iv [12]byte: IV
; seq i64: 序號
; 返回 nonce [12]byte: nonce
tls13-build-nonce = (iv [12]byte, seq i64) (nonce [12]byte) {
    i <- [0..12): {
        nonce[i] = iv[i]
    }

    ; XOR sequence number (right-aligned 8 bytes) with last 8 bytes of IV
    i <- [0..8): {
        nonce[4 + i] = nonce[4 + i] ^ ((seq >> ((7 - i) * 8)) & 255)
    }
}

; encrypt-record-13: TLS 1.3 AEAD 加密記錄並發送
; ct i64: 原始 content type
; data []byte: 明文資料
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 序號
; 返回 ok bool: true=成功
tls-conn.encrypt-record-13 = (ct i64, data []byte, key [16]byte, iv [12]byte, seq i64) (ok bool) {
    ok = false
    n = data.len

    ; 明文 = data + content_type(1 byte)
    plain []byte = with-len(n + 1)
    i <- [0..n): {
        plain[i] = data[i]
    }
    plain[n] = ct & 255
    plain-len = n + 1
    plain.len = plain-len

    ; 構建 nonce
    nonce [12]byte
    nonce = tls13-build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes): type(23) + version(0x0303) + length
    aad []byte = with-len(5)
    aad[0] = TLS-CT-APP-DATA & 255
    tls-put-u16(aad, 1, TLS-VERSION)

    ; 密文長度 = plain_len + 16 (tag)
    tls-put-u16(aad, 3, plain-len + 16)
    aad.len = 5

    ; AES-128-GCM 加密
    sealed []byte
    sealed = aes-gcm.aes-128-gcm-seal(key, nonce, aad, plain)

    ; 構建完整記錄: header(5) + sealed
    rec-len = plain-len + 16
    rec []byte = with-len(5 + rec-len)
    rec[0] = TLS-CT-APP-DATA & 255
    tls-put-u16(rec, 1, TLS-VERSION)
    tls-put-u16(rec, 3, rec-len)
    i <- [0..rec-len): {
        rec[5 + i] = sealed[i]
    }
    rec.len = 5 + rec-len

    ; 發送
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return
    ok = true
}

; decrypt-record-13: TLS 1.3 AEAD 解密記錄
; rec []byte: 接收到的記錄（含標頭）
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 序號
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文（不含 content type byte）
tls-conn.decrypt-record-13 = (rec []byte, key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1

    rlen i64 = tls-get-u16(rec, 3)
    rlen < 16 -> return

    ; 提取密文+tag
    sealed []byte = with-len(rlen)
    i <- [0..rlen): {
        sealed[i] = rec[5 + i] & 255
    }

    ; 構建 nonce
    nonce [12]byte
    nonce = tls13-build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes)
    aad []byte = with-len(5)
    aad[0] = rec[0] & 255
    aad[1] = rec[1] & 255
    aad[2] = rec[2] & 255
    aad[3] = rec[3] & 255
    aad[4] = rec[4] & 255

    ; 解密
    plain []byte
    plain = aes-gcm.aes-128-gcm-open(key, nonce, aad, sealed)
    plain.len == 0 -> return

    ; 最後一個位元組是原始 content type
    plain-len = plain.len
    ct = plain[plain-len - 1] & 255
    plain-len = plain-len - 1

    out = with-len(plain-len)
    i <- [0..plain-len): {
        out[i] = plain[i]
    }
}

; read-encrypted-record-13: 讀取並解密一筆 TLS 1.3 記錄
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 序號（讀取後自動遞增）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
tls-conn.read-encrypted-record-13 = (key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1

    ; 讀取記錄（跳過 TLS 1.3 middlebox compatibility 的 CCS 記錄）
    rec []byte = with-len(16400)
    r-ct = 0
    rlen = 0
    r-ct, rlen = tls-read-record(.fd, rec)
    r-ct < 0 -> return

    ; CCS (content type 20) 是 TLS 1.3 middlebox compatibility 的 dummy 記錄，
    ; 不是加密資料，跳過後繼續讀取下一筆
    ; 注意：使用 break-if 模式避免在沒有 CCS 時多讀一筆記錄
    {
        r-ct != TLS-CT-CCS -> *
        r-ct, rlen = tls-read-record(.fd, rec)
        r-ct < 0 -> return
    } (r-ct == TLS-CT-CCS)
    ct, out = .decrypt-record-13(rec, key, iv, seq)
}

; read-encrypted-handshake-13: 讀取加密的交握訊息
; 支援單一記錄中含多個交握訊息的情況（使用 hs-plain-buf 緩衝剩餘資料）
; 返回 msg-type i64: 訊息類型（-1=錯誤）
; 返回 msg-data []byte: 訊息資料（不含標頭）
tls-conn.read-encrypted-handshake-13 = () (msg-type i64, msg-data []byte) {
    msg-type = -1

    ; 若緩衝區中沒有足夠的資料，讀取新的加密記錄
    ; 一個 handshake 訊息標頭至少 4 bytes（1 byte type + 3 bytes length）
    .hs-plain-pos + 4 > .hs-plain-len -> {
        ct = 0
        plain []byte
        ct, plain = .read-encrypted-record-13(.hs-server-key, .hs-server-iv, .hs-read-seq)
        .hs-read-seq = .hs-read-seq + 1
        ct < 0 -> return

        ; 可能是 alert 或其他
        ct != TLS-CT-HANDSHAKE -> {
            ct == TLS-CT-ALERT -> plain-len = plain.len
            return
        }

        ; 將整個 plain 存入緩衝區
        .hs-plain-buf = plain
        .hs-plain-len = plain.len
        .hs-plain-pos = 0
    }

    ; 從緩衝區解析一個 handshake message
    ; 注意：plain 中最後 1 byte 是 inner content type，真正的 handshake 資料不含它
    ; 但 read-encrypted-record-13 已經移除了 inner content type，plain 就是純 handshake 資料
    pos = .hs-plain-pos
    msg-type = .hs-plain-buf[pos] & 255
    msg-len i64 = tls-get-u24(.hs-plain-buf, pos + 1)

    ; 檢查是否有足夠的資料
    pos + 4 + msg-len > .hs-plain-len -> return

    msg-data = with-len(msg-len)
    i <- [0..msg-len): {
        msg-data[i] = .hs-plain-buf[pos + 4 + i] & 255
    }
    msg-data.len = msg-len

    ; 構建完整的 handshake message（含標頭）用於 transcript hash
    full-msg []byte
    full-msg = with-len(4 + msg-len)
    full-msg[0] = msg-type
    full-msg[1] = (msg-len >> 16) & 255
    full-msg[2] = (msg-len >> 8) & 255
    full-msg[3] = msg-len & 255
    i <- [0..msg-len): {
        full-msg[4 + i] = msg-data[i]
    }
    full-msg.len = 4 + msg-len

    ; 追加到交握緩衝區（用於 transcript hash）
    .append-hs(full-msg)

    ; 更新緩衝區位置
    .hs-plain-pos = pos + 4 + msg-len
}

; connect-13: TLS 1.3 完整交握
; 返回 ok bool: true=成功
tls-conn.connect-13 = () (ok bool) {
    ok = false

    ; 1. 已在 connect() 中發送 ClientHello

    ; 2. 讀取 ServerHello（已在 connect() 中完成）

    ; 3. 計算 ECDHE 共享金鑰
    .compute-shared-secret-13()

    ; 4. 推導交握金鑰
    .derive-handshake-keys-13()

    ; 5. 讀取 EncryptedExtensions
    ee-type = 0
    ee-data []byte
    ee-type, ee-data = .read-encrypted-handshake-13()
    ee-type != TLS-HS-ENCRYPTED-EXTENSIONS -> return

    ; 6. 讀取 Certificate
    cert-type = 0
    cert-data []byte
    cert-type, cert-data = .read-encrypted-handshake-13()
    cert-type != TLS-HS-CERTIFICATE -> return

    ; 7. 讀取 CertificateVerify（跳過Verify（跳過驗證，僅讀取）
    cv-type = 0
    cv-data []byte
    cv-type, cv-data = .read-encrypted-handshake-13()
    cv-type != TLS-HS-CERTIFICATE-VERIFY -> {

        ; 某些伺服器可能不發送 CertificateVerify，嘗試當作 Finished
        cv-type == TLS-HS-FINISHED -> {

            ; 伺服器未發送 CertificateVerify，直接處理 Finished
            ; 推導應用金鑰（transcript 包含到此為止的所有訊息）
            .derive-application-keys-13()

            ; 發送客戶端 Finished
            ok = .send-finished-13()
            ok == false -> return
            .encrypted = true
            ok = true
            return
        }

        return
    }

    ; 8. 讀取 server Finished
    sf-type = 0
    sf-data []byte
    sf-type, sf-data = .read-encrypted-handshake-13()
    sf-type != TLS-HS-FINISHED -> return

    ; 9. 推導應用金鑰
    .derive-application-keys-13()

    ; 10. 發送客戶端 Finished（使用交握金鑰）
    ok = .send-finished-13()
    ok == false -> return
    .encrypted = true
    ok = true
}

; send-finished-13: 發送 TLS 1.3 Finished 訊息
; 返回 ok bool: true=成功
tls-conn.send-finished-13 = () (ok bool) {
    ok = false

    ; 計算 verify_data
    ; client_finished_key = HKDF-Expand-Label(client_handshake_traffic_secret, "finished", "", 32)
    ; BaseKey 是 client_handshake_traffic_secret，不是 handshake secret
    c-hs-secret []byte = with-len(32)
    i <- [0..32): {
        c-hs-secret[i] = .hs-c-secret[i]
    }

    finished-key []byte
    zero-ctx []byte = with-len(0)
    finished-key = hkdf.hkdf-expand-label-vec(c-hs-secret, 'finished', zero-ctx, 32)

    ; transcript hash = SHA-256(ClientHello..server Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; verify_data = HMAC-SHA256(finished_key, transcript_hash)
    verify []byte
    verify = hmac.hmac-sha256-vec(finished-key, hs-hash)

    ; 構建 Finished 訊息
    hs []byte = with-len(36)
    hs[0] = TLS-HS-FINISHED
    tls-put-u24(hs, 1, 32)
    i <- [0..32): {
        hs[4 + i] = verify[i]
    }
    hs.len = 36

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 加密發送（使用交握金鑰）
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-client-key, .hs-client-iv, .hs-write-seq)
    .hs-write-seq = .hs-write-seq + 1
}

; init: 初始化連線（未連線狀態）
tls-conn.init = () {
    .fd = -1
    .host = ''
    .connected = false
    .encrypted = false
    .version = 0
    .write-seq = 0
    .read-seq = 0
    .hs-buf-len = 0
    .hs-buf = with-cap(65536)
    .hs-write-seq = 0
    .hs-read-seq = 0
    .ap-write-seq = 0
    .ap-read-seq = 0

    ; 用時間戳 + PID 初始化 PRNG（fork 後父子進程會有不同 PID）
    .rand-state = time.now-ns() ^ os.get-pid()
    .rand-state == 0 -> .rand-state = 1
}

; connect: 建立 TLS 連線（自動協商 1.3/1.2）
; host str: 伺服器主機名
; port i64: 埠號
; 返回 ok bool: true=成功
tls-conn.connect = (host str, port i64) (ok bool) {
    ok = false
    .host = host

    ; 1. TCP 連線（使用 dns-dial 支援 hostname 解析）
    tcpfd = dns.dns-dial(host, port)
    tcpfd < 0 -> return
    .fd = tcpfd
    .connected = true

    ; 2. 送出 TLS 1.3 ClientHello（同時支援 1.2 fallback）
    ok = .send-client-hello-13()
    ok == false -> {
        .close()
        return
    }

    ; 3. 讀取 ServerHello 並偵測版本
    ok = .read-server-hello-13()
    ok == false -> {
        .version = TLS-VERSION

        ; 4. 讀取 Certificate
        cert []byte = with-len(16400)
        ok = .read-certificate(cert)
        ok == false -> {
            .close()
            return
        }

        ; 5. 讀取 ServerHelloDone
        ok = .read-server-hello-done()
        ok == false -> {
            .close()
            return
        }

        ; 6. 生成 premaster secret
        premaster []byte = with-len(48)
        premaster[0] = 0x03
        premaster[1] = 0x03
        rand-bytes []byte = tls-rand-bytes(.rand-state, 46)
        i <- [0..46): {
            premaster[2 + i] = rand-bytes[i]
        }

        ; 7. 推導金鑰
        .derive-keys(premaster)

        ; 8. 發送 ClientKeyExchange
        ok = .send-client-key-exchange(premaster, cert)
        ok == false -> {
            .close()
            return
        }

        ; 9. 發送 ChangeCipherSpec
        .send-change-cipher-spec()
        .encrypted = true

        ; 10. 發送 Finished（加密）
        ok = .send-finished()
        ok == false -> {
            .close()
            return
        }

        ; 11. 讀取 ChangeCipherSpec
        ok = .read-change-cipher-spec()
        ok == false -> {
            .close()
            return
        }

        ; 12. 讀取 Finished（加密）
        ok = .read-finished()
        ok == false -> {
            .close()
            return
        }
        ok = true
        return
    }

    ; TLS 1.3 路徑
    ok = .connect-13()
    ok == false -> {
        .close()
        return
    }

    ok = true
}

; connect-12: TLS 1.2 完整交握（純 TLS 1.2，不發送 supported_versions 擴展）
; 返回 ok bool: true=成功
tls-conn.connect-12 = (host str, port i64) (ok bool) {
    ok = false
    .host = host

    ; 1. TCP 連線
    tcpfd = dns.dns-dial(host, port)
    tcpfd < 0 -> return
    .fd = tcpfd
    .connected = true

    ; 2. 送出 TLS 1.2 ClientHello（無 supported_versions 擴展）
    ok = .send-client-hello()
    ok == false -> {
        .close()
        return
    }

    ; 3. 讀取 ServerHello
    ok = .read-server-hello()
    ok == false -> {
        .close()
        return
    }

    ; 4. 讀取 Certificate
    cert []byte = with-len(16400)
    ok = .read-certificate(cert)
    ok == false -> {
        .close()
        return
    }

    ; 5. 讀取 ServerHelloDone
    ok = .read-server-hello-done()
    ok == false -> {
        .close()
        return
    }

    ; 6. 生成 premaster secret
    premaster []byte = with-len(48)
    premaster[0] = 0x03
    premaster[1] = 0x03
    rand-bytes []byte = tls-rand-bytes(.rand-state, 46)
    i <- [0..46): {
        premaster[2 + i] = rand-bytes[i]
    }

    ; 7. 推導金鑰
    .derive-keys(premaster)

    ; 8. 發送 ClientKeyExchange
    ok = .send-client-key-exchange(premaster, cert)
    ok == false -> {
        .close()
        return
    }

    ; 9. 發送 ChangeCipherSpec
    .send-change-cipher-spec()
    .encrypted = true

    ; 10. 發送 Finished（加密）
    ok = .send-finished()
    ok == false -> {
        .close()
        return
    }

    ; 11. 讀取 ChangeCipherSpec
    ok = .read-change-cipher-spec()
    ok == false -> {
        .close()
        return
    }

    ; 12. 讀取 Finished（加密）
    ok = .read-finished()
    ok == false -> {
        .close()
        return
    }
    ok = true
}

; tls-dial-12: TLS 1.2 連線（純 TLS 1.2，不協商 1.3）
; host str: 主機名或 IP
; port i64: 埠號
; 返回 conn ?tls-conn: ok=連線, nil=失敗
tls-dial-12 = (host str, port i64) (conn ?tls-conn) {
    conn = nil
    c = tls-conn {}
    c.init()
    ok = c.connect-12(host, port)
    ok == false -> {
        c.close()
        return
    }
    conn = c
}

; send: 透過 TLS 發送資料
; data str: 資料
; 返回 written ?i64: 已傳送位元組數（nil=錯誤）
tls-conn.send = (data str) (written ?i64) {
    written = nil
    .connected == false -> return
    .encrypted == false -> return
    data-bytes []byte = data.to-bytes()

    {
        .version == TLS-VERSION-1-3 -> {

            ; TLS 1.3: 使用 AEAD
            ok = .encrypt-record-13(TLS-CT-APP-DATA, data-bytes, .ap-client-key, .ap-client-iv, .ap-write-seq)
            ok == false -> return
            .ap-write-seq = .ap-write-seq + 1
        }
        -> {

            ; TLS 1.2: 使用 CBC+MAC
            ok = .encrypt-record(TLS-CT-APP-DATA, data-bytes)
            ok == false -> return
        }
    }

    written = data.len
}

; recv: 透過 TLS 接收資料
; buf str: 接收緩衝區
; n i64: 最大接收位元組數
; 返回 read-n i64: 已接收位元組數（-1=錯誤, 0=連線關閉）
tls-conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    .connected == false -> return
    .encrypted == false -> return

    ; 宣告於函式作用域，確保分支內賦值能傳播
    plain []byte
    d-ct i64 = -1
    is-13 bool = (.version == TLS-VERSION-1-3)

    {
        is-13 -> {

            ; TLS 1.3: 使用 AEAD
            rec []byte = with-len(16400)
            r-ct = 0
            rlen = 0
            r-ct, rlen = tls-read-record(.fd, rec)
            r-ct < 0 -> return
            d-ct, plain = .decrypt-record-13(rec, .ap-server-key, .ap-server-iv, .ap-read-seq)
            .ap-read-seq = .ap-read-seq + 1
            d-ct < 0 -> return

            ; 處理 alert
            d-ct == TLS-CT-ALERT -> return
        }
        -> {

            ; TLS 1.2: 使用 CBC+MAC
            rec []byte = with-len(16400)
            ct = 0
            rlen = 0
            ct, rlen = tls-read-record(.fd, rec)
            ct < 0 -> return
            d-ct, plain = .decrypt-record(rec, TLS-CT-APP-DATA)
            d-ct < 0 -> return
        }
    }

    ; 複製到輸出緩衝區（在條件分支外賦值，避免作用域問題）
    copy-n = plain.len
    copy-n > n -> copy-n = n
    i <- [0..copy-n): {
        buf[i] = plain[i]
    }
    read-n = copy-n
}

; close: 關閉 TLS 連線
tls-conn.close = () {
    .connected -> {
        .fd >= 0 -> fs.close(.fd)
        .fd = -1
        .connected = false
        .encrypted = false
    }
}

; ═══════════════════════════════════════════════
; 高層 API
; ═══════════════════════════════════════════════

; tls-dial: 便捷函數，建立 TLS 連線
; host str: 伺服器主機名
; port i64: 埠號
; 返回 conn ?tls-conn: 連線（nil=連線失敗）
tls-dial = (host str, port i64) (conn ?tls-conn) {
    conn = nil
    c = tls-conn {}
    c.init()
    ok = c.connect(host, port)
    ok == false -> {
        c.close()
        return
    }
    conn = c
}

; ═══════════════════════════════════════════════
; TLS 1.2 伺服器端
; ═══════════════════════════════════════════════

; tls-server-conn: TLS 伺服器連線
; fd: 客戶端 socket fd
; rand-state: PRNG 狀態
; client-random / server-random: 交握隨機數
; client-mac-key / server-mac-key: MAC 金鑰（各 32 bytes）
; client-enc-key / server-enc-key: 加密金鑰（各 16 bytes）
; write-seq / read-seq: 記錄層序號
; hs-buf / hs-buf-len: 交握緩衝區（用於 Finished 驗證）
; encrypted: 是否已啟用加密
; master-secret: 主密鑰（48 bytes）
; cert: 預產生憑證 DER
; n-bytes / d-bytes: RSA 金鑰材料
; e-val: RSA 公鑰指數
; version: 協商的 TLS 版本
; is-tls13: 是否使用 TLS 1.3
; client-priv / server-priv / server-pub / client-pub: X25519 金鑰對
; shared-secret: ECDHE 共享金鑰（臨時儲存 handshake secret 供推導應用金鑰）
; hs-c-secret / hs-s-secret: 交握流量金鑰
; hs-{client,server}-{key,iv}: 交握層 AEAD 金鑰/IV
; ap-{client,server}-{key,iv}: 應用層 AEAD 金鑰/IV
; hs-{write,read}-seq / ap-{write,read}-seq: TLS 1.3 序號
; hs-plain-{buf,pos,len}: 交握明文緩衝區
tls-server-conn {
    fd fd
    rand-state i64
    client-random [32]byte
    server-random [32]byte
    client-mac-key [32]byte
    server-mac-key [32]byte
    client-enc-key [16]byte
    server-enc-key [16]byte
    write-seq i64
    read-seq i64
    hs-buf []byte
    hs-buf-len i64
    encrypted bool
    master-secret []byte
    cert []byte
    n-bytes []byte
    d-bytes []byte
    e-val i64
    version i64
    is-tls13 bool
    client-priv [32]byte
    client-pub [32]byte
    server-priv [32]byte
    server-pub [32]byte
    shared-secret [32]byte
    hs-client-key [16]byte
    hs-client-iv [12]byte
    hs-server-key [16]byte
    hs-server-iv [12]byte
    ap-client-key [16]byte
    ap-client-iv [12]byte
    ap-server-key [16]byte
    ap-server-iv [12]byte
    hs-write-seq i64
    hs-read-seq i64
    ap-write-seq i64
    ap-read-seq i64
    hs-plain-buf []byte
    hs-plain-pos i64
    hs-plain-len i64
    hs-c-secret [32]byte
    hs-s-secret [32]byte
    hs-prk-field [32]byte
}

; tls-server-conn.append-hs: 追加交握資料到緩衝區
tls-server-conn.append-hs = (data []byte) {
    n = data.len
    i <- [0..n): {
        .hs-buf[.hs-buf-len + i] = data[i]
    }
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; tls-server-conn.append-hs-from: 從 buf 的 offset 位置追加 n 位元組
tls-server-conn.append-hs-from = (buf []byte, offset i64, n i64) {
    i <- [0..n): {
        .hs-buf[.hs-buf-len + i] = buf[offset + i]
    }
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; tls-server-conn.read-client-hello: 讀取 ClientHello
; 返回 ok bool: true=成功
tls-server-conn.read-client-hello = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return

    ; 追加到交握緩衝區（跳過 5-byte record header）
    .append-hs-from(buf, 5, rlen)

    ; 解析 ClientHello: buf[5]=type, buf[6..8]=length, buf[9..10]=version, buf[11..42]=random
    msg-type = buf[5] & 255
    msg-type != TLS-HS-CLIENT-HELLO -> return

    pos = 11; 跳過 type(1)+length(3)+version(2)

    ; client random (32 bytes)
    i <- [0..32): {
        .client-random[i] = buf[pos + i] & 255
    }
    pos = pos + 32

    ; session_id
    sid-len = buf[pos] & 255
    pos = pos + 1 + sid-len

    ; cipher_suites
    cs-len = tls-get-u16(buf, pos)
    pos = pos + 2

    ; 檢查是否包含 TLS 1.2 或 TLS 1.3 cipher suite
    found-12 = false
    found-13 = false
    j = 0
    {
        j < cs-len -> {
            cs = tls-get-u16(buf, pos + j)
            cs == TLS-CIPHER-RSA-AES128-CBC-SHA256 -> found-12 = true
            cs == TLS-CIPHER-AES128-GCM-SHA256 -> found-13 = true
            j = j + 2
        }
    } (j < cs-len)
    found-12 == false && found-13 == false -> return

    pos = pos + cs-len

    ; compression methods（跳過）
    comp-len = buf[pos] & 255
    pos = pos + 1 + comp-len

    ; 預設 TLS 1.2
    .is-tls13 = false
    .version = TLS-VERSION

    ; 解析擴展（尋找 supported_versions 和 key_share）
    pos + 2 <= rlen + 5 -> {
        ext-total = tls-get-u16(buf, pos)
        pos = pos + 2
        ext-end = pos + ext-total

        {
            pos + 4 <= ext-end -> {
                ext-type = tls-get-u16(buf, pos)
                ext-data-len = tls-get-u16(buf, pos + 2)
                pos = pos + 4

                ; supported_versions (43)
                ext-type == TLS-EXT-SUPPORTED-VERSIONS -> {

                    ; client 端: 1 byte list length + versions
                    sv-list-len = buf[pos] & 255
                    sv-pos = pos + 1
                    sv-end = sv-pos + sv-list-len
                    {
                        sv-pos + 2 <= sv-end -> {
                            sv = tls-get-u16(buf, sv-pos)
                            sv == TLS-VERSION-1-3 -> {
                                .is-tls13 = true
                                .version = TLS-VERSION-1-3
                            }
                            sv-pos = sv-pos + 2
                        }
                    } (sv-pos + 2 <= sv-end)
                }

                ; key_share (51)
                ext-type == TLS-EXT-KEY-SHARE -> {
                    ks-list-len = tls-get-u16(buf, pos)
                    ks-pos = pos + 2
                    ks-end = ks-pos + ks-list-len
                    {
                        ks-pos + 4 <= ks-end -> {
                            ks-group = tls-get-u16(buf, ks-pos)
                            ks-key-len = tls-get-u16(buf, ks-pos + 2)
                            ks-group == TLS-GROUP-X25519 && ks-key-len == 32 -> {
                                i <- [0..32): {
                                    .client-pub[i] = buf[ks-pos + 4 + i] & 255
                                }
                            }
                            ks-pos = ks-pos + 4 + ks-key-len
                        }
                    } (ks-pos + 4 <= ks-end)
                }

                pos = pos + ext-data-len
            }
        } (pos + 4 <= ext-end)
    }

    ; TLS 1.3 需要有 key_share，如果沒拿到 client-pub 則回退 1.2
    .is-tls13 -> {
        has-key = false
        i <- [0..32): {
            .client-pub[i] != 0 -> has-key = true
        }
        has-key == false -> {
            .is-tls13 = false
            .version = TLS-VERSION
        }
    }

    ok = true
}

; tls-server-conn.send-server-hello: 發送 ServerHello
; 返回 ok bool: true=成功
tls-server-conn.send-server-hello = () (ok bool) {
    ok = false

    hs []byte = with-len(64)
    pos = 0

    ; msg_type = 2 (ServerHello)
    hs[0] = TLS-HS-SERVER-HELLO
    pos = 4; 跳過 type(1)+length(3)

    ; version = 0x0303
    tls-put-u16(hs, pos, TLS-VERSION)
    pos = pos + 2

    ; random (32 bytes)
    rand-bytes []byte = tls-rand-bytes(.rand-state, 32)
    .rand-state = .rand-state + 32
    i <- [0..32): {
        hs[pos + i] = rand-bytes[i]
        .server-random[i] = rand-bytes[i]
    }
    pos = pos + 32

    ; session_id_length = 0
    hs[pos] = 0
    pos = pos + 1

    ; cipher_suite = TLS_RSA_WITH_AES_128_CBC_SHA256
    tls-put-u16(hs, pos, TLS-CIPHER-RSA-AES128-CBC-SHA256)
    pos = pos + 2

    ; compression_method = 0
    hs[pos] = 0
    pos = pos + 1

    ; 填入 length
    body-len = pos - 4
    tls-put-u24(hs, 1, body-len)
    hs.len = pos

    .append-hs(hs)
    tls-send-raw(.fd, TLS-CT-HANDSHAKE, hs)

    ok = true
}

; tls-server-conn.send-certificate: 發送 Certificate
; 返回 ok bool: true=成功
tls-server-conn.send-certificate = () (ok bool) {
    ok = false

    cert-len = .cert.len

    ; Certificate 訊息: type(1) + length(3) + total_certs_len(3) + cert_len(3) + cert
    hs-len = 4 + 3 + 3 + cert-len
    hs []byte = with-len(hs-len)

    hs[0] = TLS-HS-CERTIFICATE
    body-len = 3 + 3 + cert-len
    tls-put-u24(hs, 1, body-len)

    ; total certs length
    tls-put-u24(hs, 4, 3 + cert-len)

    ; first cert length
    tls-put-u24(hs, 7, cert-len)

    ; cert data
    i <- [0..cert-len): {
        hs[10 + i] = .cert[i]
    }
    hs.len = hs-len

    .append-hs(hs)
    tls-send-raw(.fd, TLS-CT-HANDSHAKE, hs)

    ok = true
}

; tls-server-conn.send-server-hello-done: 發送 ServerHelloDone
; 返回 ok bool: true=成功
tls-server-conn.send-server-hello-done = () (ok bool) {
    ok = false

    hs []byte = with-len(4)
    hs[0] = TLS-HS-SERVER-HELLO-DONE
    tls-put-u24(hs, 1, 0)
    hs.len = 4

    .append-hs(hs)
    tls-send-raw(.fd, TLS-CT-HANDSHAKE, hs)

    ok = true
}

; tls-rsa-pkcs1-decrypt: RSA PKCS#1 v1.5 解密
; ciphertext []byte: RSA 加密的資料
; n []byte: 模數（big-endian）
; d []byte: 私鑰指數（big-endian）
; 返回 out []byte: 解密後的明文（nil=失敗）
tls-rsa-pkcs1-decrypt = (ciphertext []byte, n []byte, d []byte) (out []byte) {
    mod-len = n.len

    ; 轉換為大整數
    c-bn []i64
    c-bn = tls-bytes-to-bn(ciphertext)

    d-bn []i64
    d-bn = tls-bytes-to-bn(d)

    n-bn []i64
    n-bn = tls-bytes-to-bn(n)

    ; RSA 解密: m = c^d mod n
    m-bn []i64
    m-bn-n = 0
    m-bn, m-bn-n = rsa.rsa-modpow(c-bn, c-bn.len, d-bn, d-bn.len, n-bn, n-bn.len)

    ; 轉換回位元組
    raw []byte
    raw = tls-bn-to-bytes(m-bn)

    ; 左側補零至 mod-len
    m-bytes []byte
    raw.len == mod-len -> m-bytes = raw
    raw.len < mod-len -> {
        m-bytes = with-len(mod-len)
        shift = mod-len - raw.len
        i <- [0..shift): {
            m-bytes[i] = 0
        }
        i <- [0..raw.len): {
            m-bytes[shift + i] = raw[i]
        }
    }
    raw.len > mod-len -> {
        m-bytes = with-len(mod-len)
        off = raw.len - mod-len
        i <- [0..mod-len): {
            m-bytes[i] = raw[off + i]
        }
    }

    ; 驗證 PKCS#1 v1.5 填充: 0x00 0x02 PS 0x00 message
    m-bytes[0] != 0 -> return
    m-bytes[1] != 2 -> return

    ; 尋找 0x00 分隔符（從位置 2 開始）
    sep-pos = 2
    found-sep = false
    {
        sep-pos < mod-len -> {
            m-bytes[sep-pos] == 0 -> found-sep = true
            found-sep == false -> sep-pos = sep-pos + 1
        }
    } (sep-pos < mod-len && found-sep == false)
    found-sep == false -> return

    ; 提取明文
    msg-len = mod-len - sep-pos - 1
    msg-len < 1 -> return
    out = with-len(msg-len)
    i <- [0..msg-len): {
        out[i] = m-bytes[sep-pos + 1 + i]
    }
    out.len = msg-len
}

; tls-server-conn.read-client-key-exchange: 讀取 ClientKeyExchange 並解密 premaster
; 返回 ok bool: true=成功
tls-server-conn.read-client-key-exchange = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return

    .append-hs-from(buf, 5, rlen)

    ; 解析 ClientKeyExchange
    msg-type = buf[5] & 255
    msg-type != TLS-HS-CLIENT-KEY-EXCHANGE -> return

    ; encrypted premaster length (2 bytes)
    enc-len = tls-get-u16(buf, 9)

    ; 提取加密的 premaster
    enc-premaster []byte = with-len(enc-len)
    i <- [0..enc-len): {
        enc-premaster[i] = buf[11 + i] & 255
    }
    enc-premaster.len = enc-len

    ; RSA 解密
    premaster []byte
    premaster = tls-rsa-pkcs1-decrypt(enc-premaster, .n-bytes, .d-bytes)
    premaster.len == 0 -> return

    ; premaster 應為 48 bytes，且前 2 bytes 為版本 0x0303
    premaster.len < 48 -> return

    ; 確保 premaster 為 48 bytes
    fixed-premaster []byte = with-len(48)
    i <- [0..48): {
        fixed-premaster[i] = premaster[i]
    }
    fixed-premaster.len = 48

    ; 推導金鑰
    .derive-keys(fixed-premaster)

    ok = true
}

; tls-server-conn.derive-keys: 從 premaster 推導所有金鑰
; premaster []byte: premaster secret (48 bytes)
tls-server-conn.derive-keys = (premaster []byte) {

    ; master_secret = PRF(premaster, "master secret", client_random + server_random, 48)
    seed []byte = with-len(64)
    i <- [0..32): {
        seed[i] = .client-random[i]
    }
    i <- [0..32): {
        seed[32 + i] = .server-random[i]
    }
    seed.len = 64

    .master-secret = tls-prf(premaster, 'master secret', seed, 48)

    ; key_block = PRF(master, "key expansion", server_random + client_random, 96)
    ks []byte = with-len(64)
    i <- [0..32): {
        ks[i] = .server-random[i]
    }
    i <- [0..32): {
        ks[32 + i] = .client-random[i]
    }
    ks.len = 64

    key-block []byte
    key-block = tls-prf(.master-secret, 'key expansion', ks, 96)

    ; 分割 key_block
    ; client_write_MAC_key (32)
    i <- [0..32): {
        .client-mac-key[i] = key-block[i]
    }

    ; server_write_MAC_key (32)
    i <- [0..32): {
        .server-mac-key[i] = key-block[32 + i]
    }

    ; client_write key (16)
    i <- [0..16): {
        .client-enc-key[i] = key-block[64 + i]
    }

    ; server_write key (16)
    i <- [0..16): {
        .server-enc-key[i] = key-block[80 + i]
    }

    ; 重置序號
    .write-seq = 0
    .read-seq = 0
}

; tls-server-conn.encrypt-record: 加密記錄並發送（使用 SERVER 金鑰）
; ct i64: 原始 content type
; data []byte: 明文資料
; 返回 ok bool: true=成功
tls-server-conn.encrypt-record = (ct i64, data []byte) (ok bool) {
    ok = false
    n = data.len

    ; 1. 計算 MAC = HMAC-SHA256(server_mac_key, seq + type + version + length + content)
    mac-input []byte = with-len(13 + n)
    seq = .write-seq
    i <- [0..8): {
        mac-input[7 - i] = (seq >> (i * 8)) & 255
    }
    mac-input[8] = ct & 255
    tls-put-u16(mac-input, 9, TLS-VERSION)
    tls-put-u16(mac-input, 11, n)
    i <- [0..n): {
        mac-input[13 + i] = data[i]
    }
    mac [32]byte
    mac = hmac.hmac-sha256(.server-mac-key[..], mac-input)

    ; 2. 明文 + MAC
    plain []byte = with-len(n + 32)
    i <- [0..n): {
        plain[i] = data[i]
    }
    i <- [0..32): {
        plain[n + i] = mac[i]
    }
    plain.len = n + 32

    ; 3. PKCS#7 填充
    padded []byte
    padded = aes-cbc.pkcs7-pad(plain)

    ; 4. 生成隨機 IV
    iv [16]byte
    iv-bytes []byte = tls-rand-bytes(.rand-state, 16)
    .rand-state = .rand-state + 16
    i <- [0..16): {
        iv[i] = iv-bytes[i]
    }

    ; 5. AES-128-CBC 加密
    cipher []byte
    cipher = aes-cbc.aes-128-cbc-enc(padded, .server-enc-key, iv)

    ; 6. 構建記錄: type(1) + version(2) + length(2) + IV(16) + cipher
    rec-len = 16 + padded.len
    rec []byte = with-len(5 + rec-len)
    rec[0] = TLS-CT-APP-DATA & 255
    tls-put-u16(rec, 1, TLS-VERSION)
    tls-put-u16(rec, 3, rec-len)
    i <- [0..16): {
        rec[5 + i] = iv[i]
    }
    i <- [0..padded.len): {
        rec[5 + 16 + i] = cipher[i]
    }
    rec.len = 5 + rec-len

    ; 7. 發送
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return
    .write-seq = .write-seq + 1
    ok = true
}

; tls-server-conn.decrypt-record: 解密記錄（使用 CLIENT 金鑰）
; buf []byte: 接收到的記錄資料（從標頭開始）
; expected-ct i64: 原始 content type（TLS-CT-HANDSHAKE 或 TLS-CT-APP-DATA）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
tls-server-conn.decrypt-record = (buf []byte, expected-ct i64) (ct i64, out []byte) {
    ct = -1

    rlen i64 = tls-get-u16(buf, 3)
    rlen < 16 -> return

    ; 提取 IV
    iv [16]byte
    i <- [0..16): {
        iv[i] = buf[5 + i] & 255
    }

    ; 密文
    cipher-len = rlen - 16
    cipher []byte = with-len(cipher-len)
    i <- [0..cipher-len): {
        cipher[i] = buf[5 + 16 + i] & 255
    }
    cipher.len = cipher-len

    ; AES-128-CBC 解密
    plain []byte
    plain = aes-cbc.aes-128-cbc-dec(cipher, .client-enc-key, iv)

    ; 移除 PKCS#7 填充
    unpad-n i64 = aes-cbc.pkcs7-unpad(plain)
    unpad-n < 0 -> return

    ; 明文 = data(0..unpad-n-32) + MAC(unpad-n-32..unpad-n)
    data-len = unpad-n - 32
    data-len < 0 -> return

    ; 驗證 MAC
    ; MAC = HMAC-SHA256(client_mac_key, seq + type + version + length + content)
    ; TLS 1.2 中加密記錄的 type 固定為 23，但 MAC 計算使用原始 type
    mac-input []byte = with-len(13 + data-len)
    seq = .read-seq
    i <- [0..8): {
        mac-input[7 - i] = (seq >> (i * 8)) & 255
    }
    mac-input[8] = expected-ct & 255
    tls-put-u16(mac-input, 9, TLS-VERSION)
    tls-put-u16(mac-input, 11, data-len)
    i <- [0..data-len): {
        mac-input[13 + i] = plain[i]
    }
    exp-mac [32]byte
    exp-mac = hmac.hmac-sha256(.client-mac-key[..], mac-input)

    ; 比較 MAC
    mac-ok = 1
    i <- [0..32): {
        b1 = plain[data-len + i] & 255
        b2 = exp-mac[i] & 255
        b1 != b2 -> mac-ok = 0
    }
    mac-ok == 0 -> return

    ; 提取明文資料
    out = with-len(data-len)
    i <- [0..data-len): {
        out[i] = plain[i]
    }
    out.len = data-len
    ct = expected-ct
    .read-seq = .read-seq + 1
}

; tls-server-conn.send-change-cipher-spec: 發送 ChangeCipherSpec
tls-server-conn.send-change-cipher-spec = () {
    ccs [1]byte
    ccs[0] = 1
    hdr [5]byte
    hdr[0] = TLS-CT-CCS & 255
    hdr[1] = (TLS-VERSION >> 8) & 255
    hdr[2] = TLS-VERSION & 255
    hdr[3] = 0
    hdr[4] = 1
    net.net-send(.fd, hdr, 5)
    net.net-send(.fd, ccs, 1)
}

; tls-server-conn.read-change-cipher-spec: 讀取 ChangeCipherSpec
; 返回 ok bool: true=成功
tls-server-conn.read-change-cipher-spec = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-CCS -> return
    rlen != 1 -> return
    (buf[5] & 255) != 1 -> return
    ok = true
}

; tls-server-conn.read-finished: 讀取加密的 client Finished 並驗證
; 返回 ok bool: true=成功
tls-server-conn.read-finished = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)

    ct = 0
    rlen = 0
    ct, rlen = tls-read-record(.fd, buf)
    ct != TLS-CT-APP-DATA -> return

    ; 解密
    plain []byte
    d-ct = 0
    d-ct, plain = .decrypt-record(buf, TLS-CT-HANDSHAKE)
    d-ct < 0 -> return

    ; 解析 Finished 訊息
    msg-type = plain[0] & 255
    msg-type != TLS-HS-FINISHED -> return

    ; 驗證 verify_data（hash 不包含 client Finished）
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    verify []byte
    verify = tls-prf(.master-secret, 'client finished', hs-hash, TLS-FINISHED-SIZE)

    i <- [0..TLS-FINISHED-SIZE): {
        b1 = plain[4 + i] & 255
        b2 = verify[i] & 255
        b1 != b2 -> return
    }

    ; 驗證成功後追加到交握緩衝區
    .append-hs(plain)

    ok = true
}

; tls-server-conn.send-finished: 發送加密的 server Finished
; 返回 ok bool: true=成功
tls-server-conn.send-finished = () (ok bool) {
    ok = false

    ; 計算 handshake hash（包含 client Finished）
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; verify_data = PRF(master, "server finished", hash, 12)
    verify []byte
    verify = tls-prf(.master-secret, 'server finished', hs-hash, TLS-FINISHED-SIZE)

    ; 構建 Finished 訊息
    hs []byte = with-len(4 + TLS-FINISHED-SIZE)
    hs[0] = TLS-HS-FINISHED
    tls-put-u24(hs, 1, TLS-FINISHED-SIZE)
    i <- [0..TLS-FINISHED-SIZE): {
        hs[4 + i] = verify[i]
    }
    hs.len = 4 + TLS-FINISHED-SIZE

    ; 追加到交握緩衝區（在加密之前）
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record(TLS-CT-HANDSHAKE, hs)
}

; ═══════════════════════════════════════════════
; TLS 1.3 伺服器端交握與記錄層
; ═══════════════════════════════════════════════

; tls-server-conn.send-server-hello-13: 發送 TLS 1.3 ServerHello
; 生成 X25519 金鑰對，構建含 supported_versions 和 key_share 擴展的 ServerHello
; 返回 ok bool: true=成功
tls-server-conn.send-server-hello-13 = () (ok bool) {
    ok = false

    ; 生成 X25519 金鑰對
    seed = .rand-state
    .rand-state = .rand-state + 1

    kp-state = seed
    i <- [0..32): {
        kp-state, kp-r = rand(kp-state)
        .server-priv[i] = kp-state & 255
    }
    .server-priv[0] = .server-priv[0] & 248
    .server-priv[31] = .server-priv[31] & 127
    .server-priv[31] = .server-priv[31] | 64

    ; 透過 []byte 傳遞給 x25519（避開全域 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i] = .server-priv[i]
    }
    pub-slice []byte = x25519.x25519-scalarmult-base-bytes(priv-slice)
    i <- [0..32): {
        .server-pub[i] = pub-slice[i]
    }

    ; 構建 ServerHello
    hs []byte = with-len(128)
    pos = 0

    ; msg_type = 2 (ServerHello)
    hs[0] = TLS-HS-SERVER-HELLO
    pos = 4

    ; version = 0x0303（legacy）
    tls-put-u16(hs, pos, TLS-VERSION)
    pos = pos + 2

    ; random (32 bytes)
    rand-bytes []byte = tls-rand-bytes(.rand-state, 32)
    .rand-state = .rand-state + 32
    i <- [0..32): {
        hs[pos + i] = rand-bytes[i]
        .server-random[i] = rand-bytes[i]
    }
    pos = pos + 32

    ; session_id_length = 0
    hs[pos] = 0
    pos = pos + 1

    ; cipher_suite = TLS_AES_128_GCM_SHA256 (0x1301)
    tls-put-u16(hs, pos, TLS-CIPHER-AES128-GCM-SHA256)
    pos = pos + 2

    ; compression_method = 0
    hs[pos] = 0
    pos = pos + 1

    ; === 擴展 ===
    ext-len-pos = pos
    pos = pos + 2

    ; 擴展 1: supported_versions (43)
    tls-put-u16(hs, pos, TLS-EXT-SUPPORTED-VERSIONS)
    pos = pos + 2
    tls-put-u16(hs, pos, 2)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-VERSION-1-3)
    pos = pos + 2

    ; 擴展 2: key_share (51)
    tls-put-u16(hs, pos, TLS-EXT-KEY-SHARE)
    pos = pos + 2

    ; ext data length = 2 (group) + 2 (key_len) + 32 (key) = 36
    tls-put-u16(hs, pos, 36)
    pos = pos + 2
    tls-put-u16(hs, pos, TLS-GROUP-X25519)
    pos = pos + 2
    tls-put-u16(hs, pos, 32)
    pos = pos + 2
    i <- [0..32): {
        hs[pos + i] = .server-pub[i]
    }
    pos = pos + 32

    ; 填入擴展總長度
    ext-total = pos - ext-len-pos - 2
    tls-put-u16(hs, ext-len-pos, ext-total)

    ; 填入 handshake message length
    body-len = pos - 4
    tls-put-u24(hs, 1, body-len)
    hs.len = pos

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 發送（明文 handshake 記錄）
    tls-send-raw(.fd, TLS-CT-HANDSHAKE, hs)

    ok = true
}

; tls-server-conn.compute-shared-secret-13: 計算 ECDHE 共享金鑰
tls-server-conn.compute-shared-secret-13 = () {

    ; 透過 []byte 傳遞給 x25519（避開全域 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    pub-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i] = .server-priv[i]
        pub-slice[i] = .client-pub[i]
    }
    shared-slice []byte = x25519.x25519-scalarmult-bytes(priv-slice, pub-slice)
    i <- [0..32): {
        .shared-secret[i] = shared-slice[i]
    }
}

; tls-server-conn.derive-handshake-keys-13: 推導交握金鑰（HKDF 金鑰排程）
tls-server-conn.derive-handshake-keys-13 = () {

    ; 1. Early Secret = HKDF-Extract(0, 0^32)
    zero-32 []byte = with-len(32)
    i <- [0..32): {
        zero-32[i] = 0
    }
    empty-ctx []byte = with-len(0)
    early-prk [32]byte
    early-prk = hkdf.hkdf-extract(zero-32, zero-32)

    ; 2. Empty hash = SHA-256("")
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i] = empty-hash-arr[i]
    }

    ; 3. derived = HKDF-Expand-Label(Early, "derived", empty_hash, 32)
    derived-early []byte
    derived-early = hkdf.hkdf-expand-label-vec(early-prk[..], 'derived', empty-hash, 32)

    ; 4. Handshake Secret = HKDF-Extract(derived, ECDHE_shared_secret)
    hs-prk [32]byte
    hs-prk = hkdf.hkdf-extract(derived-early, .shared-secret[..])

    ; 儲存 Handshake Secret 供 derive-application-keys-13 使用
    i <- [0..32): {
        .hs-prk-field[i] = hs-prk[i]
    }

    ; 5. transcript hash = SHA-256(ClientHello + ServerHello)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; 6. client_handshake_traffic_secret
    c-hs-secret []byte
    c-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 'c hs traffic', hs-hash, 32)

    i <- [0..32): {
        .hs-c-secret[i] = c-hs-secret[i]
    }

    ; 7. server_handshake_traffic_secret
    s-hs-secret []byte
    s-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 's hs traffic', hs-hash, 32)

    i <- [0..32): {
        .hs-s-secret[i] = s-hs-secret[i]
    }

    ; 8. 推導金鑰和 IV
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .hs-client-key[i] = key-tmp[i]
    }

    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .hs-client-iv[i] = iv-tmp[i]
    }

    key-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .hs-server-key[i] = key-tmp[i]
    }

    iv-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .hs-server-iv[i] = iv-tmp[i]
    }

    ; 儲存 handshake secret 供推導應用金鑰
    i <- [0..32): {
        .shared-secret[i] = hs-prk[i]
    }

    .hs-write-seq = 0
    .hs-read-seq = 0
}

; tls-server-conn.derive-application-keys-13: 推導應用層金鑰
tls-server-conn.derive-application-keys-13 = () {

    hs-prk []byte = with-len(32)
    i <- [0..32): {
        hs-prk[i] = .hs-prk-field[i]
    }

    ; derived = HKDF-Expand-Label(HS, "derived", empty_hash, 32)
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i] = empty-hash-arr[i]
    }
    derived-hs []byte
    derived-hs = hkdf.hkdf-expand-label-vec(hs-prk, 'derived', empty-hash, 32)

    ; Master Secret = HKDF-Extract(derived, 0^32)
    zero-32 []byte = with-len(32)
    i <- [0..32): {
        zero-32[i] = 0
    }
    empty-ctx []byte = with-len(0)
    ms-prk [32]byte
    ms-prk = hkdf.hkdf-extract(derived-hs, zero-32)

    ; transcript hash = SHA-256(ClientHello..server Finished)
    ; 注意：必須排除 client Finished（read-client-finished-13 會 append CF 到 hs-buf）。
    ; client Finished = 4 位元組標頭 + 32 位元組 verify_data = 36 位元組。
    ; 使用減去 36 後的長度切片，確保只雜湊到 server Finished。
    pre-cf-len = .hs-buf-len - 36
    pre-cf-buf []byte = with-len(pre-cf-len)
    i <- [0..pre-cf-len): {
        pre-cf-buf[i] = .hs-buf[i]
    }
    hs-hash-arr = sha256.sha256(pre-cf-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; client_application_traffic_secret
    c-ap-secret []byte
    c-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 'c ap traffic', hs-hash, 32)

    ; server_application_traffic_secret
    s-ap-secret []byte
    s-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 's ap traffic', hs-hash, 32)

    ; 推導金鑰和 IV
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .ap-client-key[i] = key-tmp[i]
    }
    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .ap-client-iv[i] = iv-tmp[i]
    }

    key-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {
        .ap-server-key[i] = key-tmp[i]
    }
    iv-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {
        .ap-server-iv[i] = iv-tmp[i]
    }

    .ap-write-seq = 0
    .ap-read-seq = 0
}

; tls-server-conn.encrypt-record-13: TLS 1.3 AEAD 加密記錄並發送
; ct i64: 原始 content type
; data []byte: 明文資料
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 序號
; 返回 ok bool: true=成功
tls-server-conn.encrypt-record-13 = (ct i64, data []byte, key [16]byte, iv [12]byte, seq i64) (ok bool) {
    ok = false
    n = data.len

    ; 明文 = data + content_type(1 byte)
    plain []byte = with-len(n + 1)
    i <- [0..n): {
        plain[i] = data[i]
    }
    plain[n] = ct & 255
    plain-len = n + 1
    plain.len = plain-len

    ; 構建 nonce
    nonce [12]byte
    nonce = tls13-build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes)
    aad []byte = with-len(5)
    aad[0] = TLS-CT-APP-DATA & 255
    tls-put-u16(aad, 1, TLS-VERSION)
    tls-put-u16(aad, 3, plain-len + 16)
    aad.len = 5

    ; AES-128-GCM 加密
    sealed []byte
    sealed = aes-gcm.aes-128-gcm-seal(key, nonce, aad, plain)

    ; 構建完整記錄: header(5) + sealed
    rec-len = plain-len + 16
    rec []byte = with-len(5 + rec-len)
    rec[0] = TLS-CT-APP-DATA & 255
    tls-put-u16(rec, 1, TLS-VERSION)
    tls-put-u16(rec, 3, rec-len)
    i <- [0..rec-len): {
        rec[5 + i] = sealed[i]
    }
    rec.len = 5 + rec-len

    ; 發送
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return
    ok = true
}

; tls-server-conn.decrypt-record-13: TLS 1.3 AEAD 解密記錄
; rec []byte: 接收到的記錄（含標頭）
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 序號
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
tls-server-conn.decrypt-record-13 = (rec []byte, key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1

    rlen i64 = tls-get-u16(rec, 3)
    rlen < 16 -> return

    ; 提取密文+tag
    sealed []byte = with-len(rlen)
    i <- [0..rlen): {
        sealed[i] = rec[5 + i] & 255
    }

    ; 構建 nonce
    nonce [12]byte
    nonce = tls13-build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes)
    aad []byte = with-len(5)
    aad[0] = rec[0] & 255
    aad[1] = rec[1] & 255
    aad[2] = rec[2] & 255
    aad[3] = rec[3] & 255
    aad[4] = rec[4] & 255

    ; 解密
    plain []byte
    plain = aes-gcm.aes-128-gcm-open(key, nonce, aad, sealed)
    plain.len == 0 -> return

    ; 最後一個位元組是原始 content type
    plain-len = plain.len
    ct = plain[plain-len - 1] & 255
    plain-len = plain-len - 1

    out = with-len(plain-len)
    i <- [0..plain-len): {
        out[i] = plain[i]
    }
}

; tls-server-conn.read-encrypted-record-13: 讀取並解密一筆 TLS 1.3 記錄
; （跳過 CCS middlebox compatibility 記錄）
tls-server-conn.read-encrypted-record-13 = (key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1

    rec []byte = with-len(16400)
    r-ct = 0
    rlen = 0
    r-ct, rlen = tls-read-record(.fd, rec)
    r-ct < 0 -> return

    ; CCS (content type 20) 為 middlebox compat，跳過後讀取下一筆
    {
        r-ct != TLS-CT-CCS -> *
        r-ct, rlen = tls-read-record(.fd, rec)
        r-ct < 0 -> return
    } (r-ct == TLS-CT-CCS)
    ct, out = .decrypt-record-13(rec, key, iv, seq)
    ct < 0 -> return
}

; tls-server-conn.read-encrypted-handshake-13: 讀取加密的交握訊息
tls-server-conn.read-encrypted-handshake-13 = () (msg-type i64, msg-data []byte) {
    msg-type = -1

    .hs-plain-pos + 4 > .hs-plain-len -> {
        ct = 0
        plain []byte
        ct, plain = .read-encrypted-record-13(.hs-client-key, .hs-client-iv, .hs-read-seq)
        .hs-read-seq = .hs-read-seq + 1
        ct < 0 -> return

        ct != TLS-CT-HANDSHAKE -> return

        .hs-plain-buf = plain
        .hs-plain-len = plain.len
        .hs-plain-pos = 0
    }

    pos = .hs-plain-pos
    msg-type = .hs-plain-buf[pos] & 255
    msg-len i64 = tls-get-u24(.hs-plain-buf, pos + 1)

    pos + 4 + msg-len > .hs-plain-len -> return

    msg-data = with-len(msg-len)
    i <- [0..msg-len): {
        msg-data[i] = .hs-plain-buf[pos + 4 + i] & 255
    }
    msg-data.len = msg-len

    full-msg []byte
    full-msg = with-len(4 + msg-len)
    full-msg[0] = msg-type
    full-msg[1] = (msg-len >> 16) & 255
    full-msg[2] = (msg-len >> 8) & 255
    full-msg[3] = msg-len & 255
    i <- [0..msg-len): {
        full-msg[4 + i] = msg-data[i]
    }
    full-msg.len = 4 + msg-len

    .append-hs(full-msg)

    .hs-plain-pos = pos + 4 + msg-len
}

; tls-server-conn.send-encrypted-extensions-13: 發送 EncryptedExtensions
; 返回 ok bool: true=成功
tls-server-conn.send-encrypted-extensions-13 = () (ok bool) {
    ok = false

    ; EncryptedExtensions: type(1) + length(3) + extensions_list_length(2) = 6 bytes
    hs []byte = with-len(6)
    hs[0] = TLS-HS-ENCRYPTED-EXTENSIONS
    tls-put-u24(hs, 1, 2)
    tls-put-u16(hs, 4, 0)
    hs.len = 6

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 加密發送（使用交握金鑰）
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-server-key, .hs-server-iv, .hs-write-seq)
    .hs-write-seq = .hs-write-seq + 1
}

; tls-server-conn.send-certificate-13: 發送 TLS 1.3 Certificate
; 返回 ok bool: true=成功
tls-server-conn.send-certificate-13 = () (ok bool) {
    ok = false

    cert-len = .cert.len

    ; Certificate: type(1) + length(3) + ctx_len(1) + list_len(3) + cert_len(3) + cert + ext_len(2)
    hs-len = 4 + 1 + 3 + 3 + cert-len + 2
    hs []byte = with-len(hs-len)

    hs[0] = TLS-HS-CERTIFICATE
    body-len = 1 + 3 + 3 + cert-len + 2
    tls-put-u24(hs, 1, body-len)

    ; certificate_request_context length = 0
    hs[4] = 0

    ; certificate_list length = 3 + cert-len + 2
    tls-put-u24(hs, 5, 3 + cert-len + 2)

    ; first cert length
    tls-put-u24(hs, 8, cert-len)

    ; cert data
    i <- [0..cert-len): {
        hs[11 + i] = .cert[i]
    }

    ; extensions length = 0
    tls-put-u16(hs, 11 + cert-len, 0)
    hs.len = hs-len

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-server-key, .hs-server-iv, .hs-write-seq)
    .hs-write-seq = .hs-write-seq + 1
}

; tls-server-conn.send-finished-13: 發送 server Finished
; 返回 ok bool: true=成功
tls-server-conn.send-finished-13 = () (ok bool) {
    ok = false

    ; server_finished_key = HKDF-Expand-Label(s_hs_traffic, "finished", "", 32)
    s-hs-secret []byte = with-len(32)
    i <- [0..32): {
        s-hs-secret[i] = .hs-s-secret[i]
    }

    finished-key []byte
    zero-ctx []byte = with-len(0)
    finished-key = hkdf.hkdf-expand-label-vec(s-hs-secret, 'finished', zero-ctx, 32)

    ; transcript hash = SHA-256(ClientHello..Certificate) (不含 server Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; verify_data = HMAC-SHA256(finished_key, transcript_hash)
    verify []byte
    verify = hmac.hmac-sha256-vec(finished-key, hs-hash)

    ; 構建 Finished 訊息
    hs []byte = with-len(36)
    hs[0] = TLS-HS-FINISHED
    tls-put-u24(hs, 1, 32)
    i <- [0..32): {
        hs[4 + i] = verify[i]
    }
    hs.len = 36

    ; 追加到交握緩衝區（在加密之前）
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-server-key, .hs-server-iv, .hs-write-seq)
    .hs-write-seq = .hs-write-seq + 1
}

; tls-server-conn.read-client-finished-13: 讀取並驗證 client Finished
; 返回 ok bool: true=成功
tls-server-conn.read-client-finished-13 = () (ok bool) {
    ok = false

    ; 先計算 verify_data（transcript hash 需為 ClientHello..server Finished，
    ; 不含 client Finished。read-encrypted-handshake-13 會 append client Finished
    ; 到 hs-buf，故必須在讀取前計算 hash。）

    ; client_finished_key = HKDF-Expand-Label(c_hs_traffic, "finished", "", 32)
    c-hs-secret []byte = with-len(32)
    i <- [0..32): {
        c-hs-secret[i] = .hs-c-secret[i]
    }

    finished-key []byte
    zero-ctx []byte = with-len(0)
    finished-key = hkdf.hkdf-expand-label-vec(c-hs-secret, 'finished', zero-ctx, 32)

    ; transcript hash = SHA-256(ClientHello..server Finished) (不含 client Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash []byte = with-len(32)
    i <- [0..32): {
        hs-hash[i] = hs-hash-arr[i]
    }

    ; verify_data = HMAC-SHA256(finished_key, transcript_hash)
    verify []byte
    verify = hmac.hmac-sha256-vec(finished-key, hs-hash)

    ; 讀取加密的 client Finished（會 append 到 hs-buf，但 hash 已提前計算）
    cf-type = 0
    cf-data []byte
    cf-type, cf-data = .read-encrypted-handshake-13()
    cf-type != TLS-HS-FINISHED -> return

    ; 比較 verify_data
    i <- [0..32): {
        b1 = cf-data[i] & 255
        b2 = verify[i] & 255
        b1 != b2 -> return
    }

    ok = true
}

; tls-server-conn.handshake-13: TLS 1.3 伺服器交握
; 返回 ok bool: true=成功
tls-server-conn.handshake-13 = () (ok bool) {
    ok = false

    ; 1. 發送 ServerHello
    ok = .send-server-hello-13()
    ok == false -> return

    ; 2. 計算 ECDHE 共享金鑰
    .compute-shared-secret-13()

    ; 3. 推導交握金鑰
    .derive-handshake-keys-13()

    ; 4. 發送 ChangeCipherSpec（middlebox compat）
    .send-change-cipher-spec()

    ; 5. 發送 EncryptedExtensions
    ok = .send-encrypted-extensions-13()
    ok == false -> return

    ; 6. 發送 Certificate
    ok = .send-certificate-13()
    ok == false -> return

    ; 7. 發送 server Finished
    ok = .send-finished-13()
    ok == false -> return

    ; 8. 讀取 client Finished
    ok = .read-client-finished-13()
    ok == false -> return

    ; 9. 推導應用金鑰
    .derive-application-keys-13()

    ; 10. 啟用加密
    .encrypted = true
    ok = true
}

; tls-server-conn.handshake: TLS 伺服器交握（自動協商 1.3/1.2）
; 返回 ok bool: true=成功
tls-server-conn.handshake = () (ok bool) {
    ok = false

    ; 1. 讀取 ClientHello
    ok = .read-client-hello()
    ok == false -> return

    ; TLS 1.3 路徑
    .is-tls13 -> {
        ok = .handshake-13()
        return
    }

    ; TLS 1.2 路徑
    ; 2. 發送 ServerHello
    ok = .send-server-hello()
    ok == false -> return

    ; 3. 發送 Certificate
    ok = .send-certificate()
    ok == false -> return

    ; 4. 發送 ServerHelloDone
    ok = .send-server-hello-done()
    ok == false -> return

    ; 5. 讀取 ClientKeyExchange（含 RSA 解密 + 金鑰推導）
    ok = .read-client-key-exchange()
    ok == false -> return

    ; 6. 讀取 ChangeCipherSpec
    ok = .read-change-cipher-spec()
    ok == false -> return

    ; 7. 讀取 client Finished（加密）
    .encrypted = true
    ok = .read-finished()
    ok == false -> return

    ; 8. 發送 ChangeCipherSpec
    .send-change-cipher-spec()

    ; 9. 發送 server Finished（加密）
    ok = .send-finished()
    ok == false -> return

    ok = true
}

; tls-server-conn.send: 透過 TLS 發送資料
; data str: 資料
; 返回 written ?i64: 已傳送位元組數（nil=錯誤）
tls-server-conn.send = (data str) (written ?i64) {
    written = nil
    .encrypted == false -> return

    data-bytes []byte = data.to-bytes()
    data-len = data-bytes.len

    {
        .is-tls13 -> {

            ; TLS 1.3: 使用 AEAD（伺服器應用金鑰）
            ok = .encrypt-record-13(TLS-CT-APP-DATA, data-bytes, .ap-server-key, .ap-server-iv, .ap-write-seq)
            ok == false -> return
            .ap-write-seq = .ap-write-seq + 1
        }
        -> {

            ; TLS 1.2: 使用 CBC+MAC
            ok = .encrypt-record(TLS-CT-APP-DATA, data-bytes)
            ok == false -> return
        }
    }

    written = data-len
}

; tls-server-conn.recv: 接收並解密資料
; buf str: 接收緩衝區
; n i64: 最多接收位元組數
; 返回 read-n i64: 實際接收位元組數（-1=錯誤）
tls-server-conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    .encrypted == false -> return

    plain []byte
    d-ct i64 = -1

    {
        .is-tls13 -> {

            ; TLS 1.3: 使用 AEAD（客戶端應用金鑰），跳過 CCS
            ct = 0
            out []byte
            ct, out = .read-encrypted-record-13(.ap-client-key, .ap-client-iv, .ap-read-seq)
            .ap-read-seq = .ap-read-seq + 1
            ct < 0 -> return

            ; 處理 alert
            ct == TLS-CT-ALERT -> return

            plain = out
            d-ct = ct
        }
        -> {

            ; TLS 1.2: 使用 CBC+MAC
            rec-buf []byte = with-len(16400)

            ct = 0
            rlen = 0
            ct, rlen = tls-read-record(.fd, rec-buf)
            ct != TLS-CT-APP-DATA -> return
            d-ct, plain = .decrypt-record(rec-buf, TLS-CT-APP-DATA)
            d-ct < 0 -> return
        }
    }

    ; 複製到 buf（最多 n 位元組）
    copy-n = plain.len
    copy-n > n -> copy-n = n

    ; 直接寫入 buf（避免 buf = tmp-str 不會傳播到呼叫端）
    i <- [0..copy-n): {
        buf[i] = plain[i] & 255
    }
    read-n = copy-n
}

; tls-server-conn.close: 關閉連線
tls-server-conn.close = () {
    .fd > 0 -> fs.close(.fd)
    .fd = -1
    .encrypted = false
}

; tls-server-init: 初始化伺服器連線（生成憑證、設定金鑰）
; fd fd: 客戶端 socket fd
; 返回 conn ?tls-server-conn: 連線（nil=錯誤）
tls-server-init = (fd fd) (conn ?tls-server-conn) {
    conn = nil
    c = tls-server-conn {}
    c.fd = fd
    c.rand-state = time.now-ns() ^ os.get-pid()
    c.encrypted = false
    c.hs-buf = with-len(65536)
    c.hs-buf-len = 0
    c.write-seq = 0
    c.read-seq = 0

    ; TLS 1.3 欄位初始化
    c.version = TLS-VERSION
    c.is-tls13 = false
    c.hs-write-seq = 0
    c.hs-read-seq = 0
    c.ap-write-seq = 0
    c.ap-read-seq = 0
    c.hs-plain-pos = 0
    c.hs-plain-len = 0
    c.hs-plain-buf = with-len(16400)

    ; 從內嵌金鑰構造 []byte
    c.n-bytes = with-len(256)
    i <- [0..256): {
        c.n-bytes[i] = tls-server-keys.TLS-SERVER-RSA-N[i]
    }
    c.n-bytes.len = 256

    c.d-bytes = with-len(256)
    i <- [0..256): {
        c.d-bytes[i] = tls-server-keys.TLS-SERVER-RSA-D[i]
    }
    c.d-bytes.len = 256

    c.e-val = tls-server-keys.TLS-SERVER-RSA-E

    ; 生成自簽憑證
    c.cert = x509.x509-build-self-signed-cert(c.n-bytes, c.e-val, c.d-bytes, 'nolang-https')

    conn = c
}

; tls-server-accept: 接受 TCP 連線並執行 TLS 交握
; 使用局部變數進行交握（全域變數有編譯器 bug：跨函式位址不一致）
; listen-fd fd: 監聽 socket fd
; 返回 conn ?tls-server-conn: ok=連線（含交握金鑰）, nil=失敗
tls-server-accept = (listen-fd fd) (conn ?tls-server-conn) {
    conn = nil

    ; 接受 TCP 連線
    client-fd = net.net-accept(listen-fd)
    client-fd < 0 -> return

    ; 初始化伺服器連線（返回 ?tls-server-conn）
    init-opt = tls-server-init(client-fd)
    init-opt: {
        nil -> {
            fs.close(client-fd)
            return
        }
        err -> {
            fs.close(client-fd)
            return
        }
        ok -> {
            c = it

            ; 執行 TLS 交握（在局部變數上操作，方法接收者位址一致）
            ok2 = c.handshake()
            ok2 == false -> {
                c.close()
                return
            }

            conn = c
        }
    }
}

; tls-https-serve-once: 完整的 HTTPS 請求-回應週期（單一函式）
; 在同一個函式中完成：accept + handshake + recv HTTP + send HTTP + close
; 所有 TLS 狀態保持在局部變數 c 中，避開全域變數 bug 和結構體複製 bug。
; listen-fd fd: 監聽 socket fd
; status i64: HTTP 回應狀態碼
; body str: HTTP 回應體
; 返回 ok bool: true=成功
tls-https-serve-once = (listen-fd fd, status i64, body str) (ok bool) {
    ok = false

    ; 1. 接受 TCP 連線
    client-fd = net.net-accept(listen-fd)
    client-fd < 0 -> return

    ; 2. 初始化 TLS 連線
    init-opt = tls-server-init(client-fd)
    init-opt: {
        nil -> {
            fs.close(client-fd)
            return
        }
        err -> {
            fs.close(client-fd)
            return
        }
        ok -> {
            c = it

            ; 3. TLS 交握（方法呼叫在局部變數上操作，接收者位址一致）
            hs-ok = c.handshake()
            hs-ok == false -> {
                c.close()
                return
            }

            ; 4. 接收 HTTP 請求（透過 TLS 解密）
            ; 接收直到找到 \r\n\r\n（標頭結束）
            space = ' '
            recv-buf = space.repeat(8192)
            recv-len = 0
            cr = number.char-to-str(13)
            lf = number.char-to-str(10)
            crlf = cr - lf
            separator = crlf - crlf

            sep-found = false
            {
                sep-found -> *
                recv-len + 4096 > 8192 -> *

                tmp = space.repeat(4096)
                rn = c.recv(tmp, 4096)
                rn <= 0 -> *

                i <- [0..rn): {
                    recv-buf[recv-len + i] = tmp[i]
                }
                recv-len = recv-len + rn

                data = recv-buf.slice(0, recv-len)
                pos = data.index(separator)
                pos >= 0 -> sep-found = true
            } (sep-found == false)

            ; 5. 發送 HTTP 回應（透過 TLS 加密）
            status-s = status.to-str()
            status-text = 'OK'
            status == 200 -> status-text = 'OK'
            status == 404 -> status-text = 'Not Found'
            status == 500 -> status-text = 'Internal Server Error'

            body-len = body.len
            len-s = body-len.to-str()

            ; 構建完整回應（一次發送，避免多次 send 的 option 處理）
            response = 'HTTP/1.1 ' - status-s - ' ' - status-text - crlf - 'Content-Type: text/plain; charset=utf-8' - crlf - 'Content-Length: ' - len-s - crlf - 'Connection: close' - crlf - 'Server: nolang-https/1.0' - crlf - crlf - body

            w1 = c.send(response)
            w1: {
                nil -> {
                    c.close()
                    return
                }
                err -> {
                    c.close()
                    return
                }
                ok ->
            }

            ; 6. 關閉連線
            c.close()
            ok = true
        }
    }
}

; tls-server-listen: 建立監聽 socket
; host str: 綁定的 IP 地址
; port i64: 監聽埠號
; 返回 fd fd: 監聽 socket fd（-1=失敗）
tls-server-listen = (host str, port i64) (fd fd) {
    fd = -1
    fd = net.net-listen(host, port)
}
