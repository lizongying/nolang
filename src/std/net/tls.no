; tls — TLS 1.2 / 1.3 客戶端（純 Nolang 實現，不依賴 OpenSSL）
;
; TLS 1.3: 支援密碼套件 TLS_AES_128_GCM_SHA256 (0x1301)
;   使用 AES-128-GCM (AEAD) + X25519 ECDHE 金鑰交換 + HKDF 金鑰排程
;
; TLS 1.2: 支援密碼套件
;   ECDHE（X25519 金鑰交換）:
;     TLS_ECDHE_RSA/AES128-GCM-SHA256 (0xC02F)、TLS_ECDHE_ECDSA_AES128-GCM-SHA256 (0xC02B)
;     TLS_ECDHE_RSA_AES128_CBC-SHA256 (0xC027)、TLS_ECDHE_ECDSA_AES128-CBC-SHA256 (0xC023)
;   static-RSA（相容回退）: TLS_RSA_WITH_AES_128_CBC_SHA256 (0x003C)
;   使用 AES-128-GCM (AEAD, RFC 5288) 或 AES-128-CBC + HMAC-SHA256
;
; 底層使用 TCP builtins (net-dial, net-send, net-recv, close)
; 加密原語使用 std/hash 下的 AES-128, SHA-256, RSA, HMAC-SHA256, X.509,
; AES-GCM, HKDF, X25519
;
; 用法：
;   conn = dial('example.com', 443)         // 返回 ?conn
;   conn: {
;       nil -> return
;       -> w = conn.send(data)          // 返回 ?i64
;         w: { nil -> return }
;         r = conn.recv(buf, 4096)       // 返回 i64 (-1=錯誤, 0=關閉, >0=位元組數)
;         r < 0 -> return
;         n = r
;         conn.close()
;   }

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

TLS-VERSION i64 = 0x0303
TLS-VERSION-1-3 i64 = 0x0304

; Record content types
TLS-CT-CCS = 20
TLS-CT-ALERT = 21
TLS-CT-HANDSHAKE = 22
TLS-CT-APP-DATA = 23

; Handshake message types
TLS-HS-CLIENT-HELLO = 1
TLS-HS-SERVER-HELLO = 2
TLS-HS-ENCRYPTED-EXTENSIONS = 8
TLS-HS-CERTIFICATE = 11
TLS-HS-SERVER-KEY-EXCHANGE = 12
TLS-HS-SERVER-HELLO-DONE = 14
TLS-HS-CLIENT-KEY-EXCHANGE = 16
TLS-HS-CERTIFICATE-VERIFY = 15
TLS-HS-FINISHED = 20

; Cipher suites
TLS-CIPHER-RSA-AES128-CBC-SHA256 i64 = 0x003c
TLS-CIPHER-AES128-GCM-SHA256 i64 = 0x1301

; TLS 1.2 ECDHE cipher suites
TLS-CIPHER-ECDHE-ECDSA-AES128-CBC-SHA256 i64 = 0xc023
TLS-CIPHER-ECDHE-RSA-AES128-CBC-SHA256 i64 = 0xc027
TLS-CIPHER-ECDHE-ECDSA-AES128-GCM-SHA256 i64 = 0xc02b
TLS-CIPHER-ECDHE-RSA-AES128-GCM-SHA256 i64 = 0xc02f

; Extensions (TLS 1.3)
TLS-EXT-SERVER-NAME = 0
TLS-EXT-EC-POINT-FORMATS = 11
TLS-EXT-SUPPORTED-GROUPS = 10
TLS-EXT-SIGNATURE-ALGORITHMS = 13
TLS-EXT-SUPPORTED-VERSIONS = 43
TLS-EXT-PSK-KE-MODES = 45
TLS-EXT-KEY-SHARE = 51

; Named groups
TLS-GROUP-X25519 i64 = 0x001d
TLS-GROUP-SECP256R1 i64 = 0x0017

; Signature algorithms
TLS-SIG-RSA-PKCS1-SHA256 i64 = 0x0401
TLS-SIG-ECDSA-SECP256R1-SHA256 i64 = 0x0403
TLS-SIG-RSA-PKCS1-SHA384 i64 = 0x0501
TLS-SIG-ECDSA-SECP384R1-SHA384 i64 = 0x0503
TLS-SIG-RSA-PKCS1-SHA512 i64 = 0x0601
TLS-SIG-ECDSA-SECP521R1-SHA512 i64 = 0x0603
TLS-SIG-RSA-PSS-RSAE-SHA256 i64 = 0x0804
TLS-SIG-RSA-PSS-RSAE-SHA384 i64 = 0x0805
TLS-SIG-RSA-PSS-RSAE-SHA512 i64 = 0x0806
TLS-SIG-ED25519 i64 = 0x0807

; Key sizes
TLS-MAC-KEY-SIZE = 32
TLS-ENC-KEY-SIZE = 16
TLS-IV-SIZE = 16
TLS-RANDOM-SIZE = 32
TLS-PREMASTER-SIZE = 48
TLS-FINISHED-SIZE = 12

; TLS 1.3 key sizes
TLS13-KEY-SIZE = 16
TLS13-IV-SIZE = 12

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; conn: TLS 連線（支援 1.2 和 1.3）
; fd: 底層 TCP socket fd
; host: 伺服器主機名（用於 SNI）
; connected: 連線狀態
; encrypted: 是否已啟用加密
; version: 協商的 TLS 版本（0x0303=1.2, 0x0304=1.3）
; write-seq / read-seq: 記錄層序號（TLS 1.2 用）
; rand-state: PRNG 狀態
; hs-buf: 交握訊息緩衝區（用於 Finished 驗證）
conn {
    fd fd
    host str
    connected bool
    encrypted bool
    version i64
    cipher-id i64
    write-seq i64
    read-seq i64
    rand-state i64
    client-random [32]byte
    server-random [32]byte
    client-mac-key [32]byte
    server-mac-key [32]byte
    client-enc-key [16]byte
    server-enc-key [16]byte
    client-gcm-salt [4]byte
    server-gcm-salt [4]byte
    hs-buf []byte
    hs-buf-len i64
    client-priv [32]byte
    client-pub [32]byte
    server-pub [32]byte
    shared-secret [32]byte
    kx-group i64
    peer-p256 [65]byte
    pub-p256 [65]byte
    hs-client-key [16]byte
    hs-client-iv [12]byte
    hs-server-key [16]byte
    hs-server-iv [12]byte
    ap-client-key [16]byte
    ap-client-iv [12]byte
    ap-server-key [16]byte
    ap-server-iv [12]byte
    hs-write-seq i64
    hs-read-seq i64
    ap-write-seq i64
    ap-read-seq i64
    hs-plain-buf []byte
    hs-plain-pos i64
    hs-plain-len i64
    hs-c-secret [32]byte
    hs-prk-field [32]byte
    master-secret []byte
}

; TLS 1.3 欄位

; ═══════════════════════════════════════════════
; 工具函數
; ═══════════════════════════════════════════════

; 生成隨機位元組
; n i64: 需要的位元組數
; 返回 out []byte: 隨機位元組陣列
; state i64: 隨機數種子狀態（rand.rand 內部逐位元組推進）
; [rand-bytes](#tls.rand-bytes)
rand-bytes = (state i64, n i64) (out []byte) {
    out = with-len(n)
    i <- [0..n): {
        state, r = rand.rand(state)

        out[i] = state & 255
    }
}

; 將 16-bit 大端序值寫入緩衝區
; buf []byte: 目標緩衝區，寫入 buf[pos..pos+1]
; pos i64: 寫入起始位置（高位元組在前）
; val i64: 要寫入的 16-bit 整數值
; [put-u16](#tls.put-u16)
put-u16 = (buf []byte, pos i64, val i64) {
    buf[pos]: {
        ok -> it = (val >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 1]: {
        ok -> it = val & 255

        -> _
    }
}

; 將 24-bit 大端序值寫入緩衝區
; buf []byte: 目標緩衝區，寫入 buf[pos..pos+2]
; pos i64: 寫入起始位置（高位元組在前）
; val i64: 要寫入的 24-bit 整數值
; [put-u24](#tls.put-u24)
put-u24 = (buf []byte, pos i64, val i64) {
    buf[pos]: {
        ok -> it = (val >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 1]: {
        ok -> it = (val >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 2]: {
        ok -> it = val & 255

        -> _
    }
}

; 從緩衝區讀取 16-bit 大端序值
; buf []byte: 來源緩衝區（讀取 buf[pos..pos+1]）
; pos i64: 讀取起始位置（高位元組在前）
; val i64: 解出的 16-bit 大端值（位元組越界時以零計）
; [get-u16](#tls.get-u16)
get-u16 = (buf []byte, pos i64) (val i64) {

    ixout235c13 = buf[pos]: {
        ok -> it

        -> _
    }

    ixout235c32 = buf[pos + 1]: {
        ok -> it

        -> _
    }

    val = ((ixout235c13) << 8) | (ixout235c32)
}

; 從緩衝區讀取 24-bit 大端序值
; buf []byte: 來源緩衝區（讀取 buf[pos..pos+2]）
; pos i64: 讀取起始位置（高位元組在前）
; val i64: 解出的 24-bit 大端值（位元組越界時以零計）
; [get-u24](#tls.get-u24)
get-u24 = (buf []byte, pos i64) (val i64) {

    ixout246c13 = buf[pos]: {
        ok -> it

        -> _
    }

    ixout246c34 = buf[pos + 1]: {
        ok -> it

        -> _
    }

    ixout246c57 = buf[pos + 2]: {
        ok -> it

        -> _
    }

    val = ((ixout246c13) << 16) | ((ixout246c34) << 8) | (ixout246c57)
}

; 串接兩個位元組陣列
; a []byte: 前段陣列
; b []byte: 後段陣列（接於 a 之後）
; out []byte: 串接後的新陣列（長度 = a.len() + b.len()）
; [bytes-cat](#tls.bytes-cat)
bytes-cat = (a []byte, b []byte) (out []byte) {
    an = a.len()
    bn = b.len()

    #{overflow=wrap}
    out = with-len(an + bn)
    i <- [0..an): {

        ixout263c18 = a[i]: {
            ok -> it

            -> _
        }

        out[i] = ixout263c18
    }
    i <- [0..bn): {

        ixout268c23 = b[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        out[an + i] = ixout268c23
    }

    #{overflow=wrap}
    out.truncate(an + bn)
}

; ═══════════════════════════════════════════════
; 大整數轉換（用於 RSA）
; ═══════════════════════════════════════════════

; big-endian 位元組陣列 → []i64（little-endian base 2^32）
; data []byte: big-endian 位元組
; 返回 out []i64: 大整數（每個元素為 32-bit limb）
; [bytes-to-bn](#tls.bytes-to-bn)
bytes-to-bn = (data []byte) (out []i64) {
    n = data.len()

    #{overflow=wrap}
    limb-count = (n + 3) / 4
    out = with-len(limb-count)
    i <- [0..limb-count): {
        out[i] = 0
    }
    i <- [0..n): {

        #{overflow=wrap}
        byte-from-lsb = n - 1 - i

        #{overflow=wrap}
        limb = byte-from-lsb / 4

        #{overflow=wrap}
        shift = (byte-from-lsb % 4) * 8

        ixout304c21 = out[limb]: {
            ok -> it

            -> _
        }

        ixout304c35 = data[i]: {
            ok -> it

            -> _
        }

        out[limb] = ixout304c21 | ((ixout304c35) << shift)
    }
    out.truncate(limb-count)
}

; []i64（little-endian base 2^32）→ big-endian 位元組陣列
; num []i64: 大整數
; 返回 out []byte: big-endian 位元組
; [bn-to-bytes](#tls.bn-to-bytes)
bn-to-bytes = (num []i64) (out []byte) {
    n = num.len()

    #{overflow=wrap}
    out-n = n * 4
    out = with-len(out-n)
    i <- [0..out-n): {

        #{overflow=wrap}
        byte-from-lsb = out-n - 1 - i

        #{overflow=wrap}
        limb = byte-from-lsb / 4

        #{overflow=wrap}
        shift = (byte-from-lsb % 4) * 8

        ixout331c19 = num[limb]: {
            ok -> it

            -> _
        }

        out[i] = (ixout331c19 >> shift) & 255
    }

    ; 移除前導零
    (out-n > 1 && out[0] == 0) {

        #{overflow=wrap}
        i <- [0..out-n - 1): {

            #{overflow=wrap}
            out[i] = out[i + 1]
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            out-n-opt = out-n - 1
            out-n-opt: {
                ok -> out-n = it
                ->
            }
        }
    }
    out.truncate(out-n)
}

; ═══════════════════════════════════════════════
; TLS PRF（基於 HMAC-SHA256）
; ═══════════════════════════════════════════════

; TLS 1.2 PRF（P_SHA256）
; secret []byte: 金鑰材料
; label str: 標籤字串
; seed []byte: 種子
; out-len i64: 需要的輸出長度
; 返回 out []byte: PRF 輸出
; [prf](#tls.prf)
prf = (secret []byte, label str, seed []byte, out-len i64) (out []byte) {
    out = with-len(out-len)

    ; label-seed = label || seed
    label-bytes []byte
    label-bytes = label.to-bytes()

    ls []byte
    ls = bytes-cat(label-bytes, seed)

    ; A(0) = HMAC(secret, label-seed)
    ; 注意: hmac-sha256 返回 [32]byte (%arr), 但 bytes-cat/hmac-sha256 的 []byte 參數
    ; 是 %vec, 兩者記憶體佈局不同 (%arr.data 在 offset 8, %vec.data 在 offset 16),
    ; 直接傳遞會造成越界讀取。因此用臨時 [32]byte 接收後複製到 []byte。
    a-tmp [32]byte
    a-tmp = hmac.hmac-sha256(secret, ls)
    a = a-tmp[..32)
    out-off = 0
    (out-off < out-len) {

        ; P_i = HMAC(secret, A(i) || label-seed)
        a-and-ls []byte
        a-and-ls = bytes-cat(a, ls)

        p-tmp [32]byte
        p-tmp = hmac.hmac-sha256(secret, a-and-ls)
        p = p-tmp[..32)

        ; 複製到輸出
        copy-n = 32

        #{overflow=wrap}
        out-off + copy-n > out-len -> {
            {
                #{overflow=wrap}
                copy-n-opt = out-len - out-off
                copy-n-opt: {
                    ok -> copy-n = it
                    ->
                }
            }
        }
        i <- [0..copy-n): {

            ixout397c32 = p[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            out[out-off + i] = ixout397c32
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            out-off-opt = out-off + copy-n
            out-off-opt: {
                ok -> out-off = it
                ->
            }
        }

        ; A(i+1) = HMAC(secret, A(i))
        a-tmp = hmac.hmac-sha256(secret, a)
        i <- [0..32): {
            {
                a[i] ?= a-tmp[i]
            }: {
                err -> _

                -> _
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 記錄層（Record Layer）
; ═══════════════════════════════════════════════

; 從 socket 讀取恰好 n 個位元組
; fd fd: socket fd
; buf []byte: 接收緩衝區
; n i64: 需要讀取的位元組數
; 返回 ok bool: true=成功
; [recv-n](#tls.recv-n)
recv-n = (fd fd, buf []byte, n i64) (ok bool) {
    ok = false
    total = 0
    (total < n) {

        #{overflow=wrap}
        tmp str = with-len(n - total)

        #{overflow=wrap}
        n-total = n - total: {
            ok -> it

            -> 0
        }
        r = net-recv-wait(fd, tmp, n-total)
        r <= 0 -> return
        i <- [0..r): {

            ; ⚠️ 必須用 .byte(i)（位元組級），不可用 tmp[i]：
            ; str[i] 是「碼點索引」且回傳 char（見 docs/docs/lang/str.md），
            ; 對 >= 0x80 的位元組會做 UTF-8 解碼，把原始位元組弄壞。
            #{overflow=wrap}
            buf[total + i]: {
                ok -> it = tmp.byte(i)

                -> _
            }
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            total-opt = total + r
            total-opt: {
                ok -> total = it
                ->
            }
        }
    }
    ok = true
}

; 阻塞式接收（用 nb recv + 短睡重試）
; 繞開原生阻塞 recv 在 macOS 上「資料已就緒卻不回傳」的卡死問題。
; 回傳 r: >0=位元組數, 0=對端關閉(FIN), -1=錯誤
; fd: socket fd（輪詢期間以非阻塞方式接收）
; buf: 存放接收資料的字串緩衝
; n: 單次最多接收的位元組數
; r: >0=收到位元組數, 0=對端正常關閉(FIN), -1=錯誤
; [net-recv-wait](#tls.net-recv-wait)
net-recv-wait = (fd fd, buf str, n i64) (r i64) {
    r = -1
    tries = 0
    done = false
    (done == false) {

        #{overflow=wrap}
        {
            #{overflow=wrap}
            tries-opt = tries + 1
            tries-opt: {
                ok -> tries = it
                ->
            }
        }
        tries > 4000 -> {
            print('RECVWAIT giveup tries=')
            print(tries)
            done = true
        }
        done == false -> {
            nr = net.net-recv-nb(fd, buf, n)
            nr > 0 -> {
                r = nr
                done = true
            }
            nr == 0 -> {
                r = 0
                done = true
            }
            nr == -1 -> {
                r = -1
                done = true
            }
            nr < -2 -> {
                r = -1
                done = true
            }

            ; nr == -2：暫無資料（would-block），睡 500us 後繼續迴圈
            nr == -2 -> sleep-us(500)
        }
    }
}

; 讀取一筆 TLS 記錄
; fd fd: socket fd
; buf []byte: 記錄緩衝區（含標頭+資料, buf[0..4]=header, buf[5..]=body）
; 返回 ct i64: content type（-1=錯誤）
; 返回 rlen i64: 資料長度（不含標頭）
; [read-record](#tls.read-record)
read-record = (fd fd, buf []byte) (ct i64, rlen i64) {
    ct = -1
    rlen = 0

    ; 讀取 5 位元組標頭 into buf[0..4]
    hdr-total = 0
    (hdr-total < 5) {

        #{overflow=wrap}
        tmp str = with-len(5 - hdr-total)

        #{overflow=wrap}
        hdr-remain = 5 - hdr-total: {
            ok -> it

            -> 0
        }
        r = net-recv-wait(fd, tmp, hdr-remain)
        r <= 0 -> {
            return
        }
        i <- [0..r): {

            ; ⚠️ .byte(i) 而非 tmp[i]：str[i] 是碼點索引，會把 >= 0x80 的
            ; 位元組（例如 TLS 記錄長度 0x94）解碼成別的碼點再截斷，
            ; 導致 rlen 讀成 20 而不是 148 —— 這正是 e2e 握手失敗的根因。
            #{overflow=wrap}
            buf[hdr-total + i]: {
                ok -> it = tmp.byte(i)

                -> _
            }
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            hdr-total-opt = hdr-total + r
            hdr-total-opt: {
                ok -> hdr-total = it
                ->
            }
        }
    }

    ; 解析標頭

    ct = buf[0]: {
        ok -> it

        -> 0
    }
    rlen = get-u16(buf, 3)

    ; TLS 1.3 app-data 記錄最大密文 = 16384(明文) + 1(內容類型) + 16(GCM tag) = 16401 位元組。
    ; 舊守衛 rlen > 16384 會把 >16401 的記錄誤判為錯誤，導致多記錄流在第一條後中斷。
    ; 改為 16640 (= 2^14 + 256) 留足 padding 餘量。
    rlen > 16640 -> {
        ct = -1
        return
    }

    ; 讀取 body into buf[5..5+rlen-1]
    body-total = 0
    (body-total < rlen) {

        #{overflow=wrap}
        tmp2 str = with-len(rlen - body-total)

        #{overflow=wrap}
        body-remain = rlen - body-total: {
            ok -> it

            -> 0
        }
        r = net-recv-wait(fd, tmp2, body-remain)
        r <= 0 -> {
            ct = -1
            return
        }
        i <- [0..r): {

            ; ⚠️ .byte(i) 而非 tmp2[i]（同上：str[i] 是碼點索引）

            #{overflow=wrap}
            buf[5 + body-total + i]: {
                ok -> it = tmp2.byte(i)

                -> _
            }
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            body-total-opt = body-total + r
            body-total-opt: {
                ok -> body-total = it
                ->
            }
        }
    }
    ; 注意：不修改 buf.len（vet 禁止修改 slice 的 len 欄位）。
    ; 呼叫端使用返回的 rlen 來判斷實際資料長度。
}

; 發送原始 TLS 記錄（未加密）
; fd fd: socket fd
; ct i64: content type（寫入記錄標頭首 byte）
; data []byte: 要寫入該記錄的載荷位元組（本函式不加密，直接送出）
; [send-raw](#tls.send-raw)
send-raw = (fd fd, ct i64, data []byte) {
    n = data.len()
    hdr [5]byte

    hdr[0]: {
        ok -> it = ct & 255

        -> _
    }

    hdr[1]: {
        ok -> it = (TLS-VERSION >> 8) & 255

        -> _
    }

    hdr[2]: {
        ok -> it = TLS-VERSION & 255

        -> _
    }

    hdr[3]: {
        ok -> it = (n >> 8) & 255

        -> _
    }

    hdr[4]: {
        ok -> it = n & 255

        -> _
    }
    net.net-send(fd, hdr, 5)
    net.net-send(fd, data, n)
}

; ═══════════════════════════════════════════════
; 記錄層加密/解密
; ═══════════════════════════════════════════════

; 將交握訊息追加到緩衝區
; data []byte: 待追加到交握緩衝區尾端的訊息位元組
; [append-hs](#tls.conn.append-hs)
conn.append-hs = (data []byte) {
    n = data.len()
    i <- [0..n): {

        ixout660c36 = data[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs-wr-idx = .hs-buf-len + i
        {
            .hs-buf[hs-wr-idx] ?= ixout660c36
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; 從 buf 的 offset 位置追加 n 位元組到交握緩衝區
; buf []byte: 來源緩衝區（含 record header）
; offset i64: 起始偏移（通常為 5, 跳過 record header）
; n i64: 要追加的位元組數
; [append-hs-from](#tls.conn.append-hs-from)
conn.append-hs-from = (buf []byte, offset i64, n i64) {
    i <- [0..n): {

        #{overflow=wrap}
        ixout677c36 = buf[offset + i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs-wr-idx = .hs-buf-len + i
        {
            .hs-buf[hs-wr-idx] ?= ixout677c36
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; TLS 1.2 CBC 填充（RFC 5246 §6.2.3.2）——與 PKCS#7 不同！
; 填充共 pad-count 個位元組，每個位元組的值皆為 pad-count - 1（末位長度位元組值 = pad-count-1）。
; 對端（如 OpenSSL）讀末位元組 P 後移除 P+1 個位元組，並要求這 P+1 個位元組全等於 P。
; 若誤用 PKCS#7（值 = pad-count），當明文已為區塊整數倍時會填 16 個 0x10，
; 對端會試圖移除 17 個位元組而踩到 MAC 尾位元組 → bad record mac。
; in []byte: 明文（content || MAC）
; 返回 out []byte: 填充後的資料（長度為 16 的倍數）
; [tls-pad](#tls.tls-pad)
tls-pad = (in []byte) (out []byte) {
    n = in.len()

    #{overflow=wrap}
    pad-count = 16 - (n % 16)

    pad-val = (pad-count - 1) & 255

    #{overflow=wrap}
    out = with-len(n + pad-count)
    i <- [0..n): {

        ixout706c18 = in[i]: {
            ok -> it

            -> _
        }

        out[i] = ixout706c18
    }
    i <- [0..pad-count): {

        #{overflow=wrap}
        out[n + i] = pad-val
    }
}

; TLS 1.2 CBC 去填充
; in []byte: 解密後的資料（content || MAC || padding）
; 返回 out-n i64: 去除填充後的長度（content+MAC），-1=填充錯誤
; [tls-unpad](#tls.tls-unpad)
tls-unpad = (in []byte) (out-n i64) {
    in.len() == 0 -> {
        out-n = -1
        return
    }

    #{overflow=wrap}
    pad-val = in[in.len() - 1]: {
        ok -> it

        -> 0
    }

    ; TLS: 需移除的位元組數 = pad-val + 1（含末位長度位元組）

    #{overflow=wrap}
    strip = pad-val + 1
    strip > in.len() -> {
        out-n = -1
        return
    }

    ; 驗證被移除的每個位元組都等於 pad-val
    i <- [0..strip): {

        ixout745c10 = in[in.len() - 1 - i]: {
            ok -> it

            -> _
        }

        (ixout745c10) != pad-val -> {
            out-n = -1
            return
        }
    }

    #{overflow=wrap}
    out-n = in.len() - strip
}

; TLS 1.2 AES-128-GCM AEAD 記錄加密（RFC 5288）
; ct i64: content type
; data []byte: 明文
; key [16]byte: client/server_write_key
; salt [4]byte: client/server_write_IV（implicit salt）
; seq i64: 記錄序號
; 返回 ok bool: true=成功
; [encrypt-record-gcm](#tls.conn.encrypt-record-gcm)
conn.encrypt-record-gcm = (ct i64, data []byte, key [16]byte, salt [4]byte, seq i64) (ok bool) {
    ok = false
    n = data.len()

    ; 8-byte 顯式 nonce（隨機）
    exp-nonce = rand-bytes(.rand-state, 8)

    #{overflow=wrap}
    .rand-state = .rand-state + 8

    ; nonce(12) = salt(4) || explicit(8)
    nonce [12]byte
    i <- [0..4): {
        nonce[i]: {
            ok -> it = salt[i]

            -> _
        }
    }
    i <- [0..8): {

        ixout786c24 = exp-nonce[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        nonce[4 + i]: {
            ok -> it = ixout786c24

            -> _
        }
    }

    ; AAD = seq(8) || type(1) || version(2) || plaintext_len(2)
    aad []byte = with-len(13)
    i <- [0..8): {

        #{overflow=wrap}
        aad[7 - i]: {
            ok -> it = (seq >> (i * 8)) & 255

            -> _
        }
    }

    aad[8]: {
        ok -> it = ct & 255

        -> _
    }
    put-u16(aad, 9, TLS-VERSION)
    put-u16(aad, 11, n)
    aad.truncate(13)
    sealed []byte
    sealed = aes-gcm.seal-128(key, nonce, aad, data)
    sealed.len() < 16 -> return

    ; 記錄 = type(1) + version(2) + length(2) + explicit(8) + ciphertext + tag(16)

    #{overflow=wrap}
    frag-len = 8 + sealed.len()

    #{overflow=wrap}
    rec []byte = with-len(5 + frag-len)

    rec[0]: {
        ok -> it = ct & 255

        -> _
    }
    put-u16(rec, 1, TLS-VERSION)
    put-u16(rec, 3, frag-len)
    i <- [0..8): {

        ixout835c24 = exp-nonce[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        rec[5 + i]: {
            ok -> it = ixout835c24

            -> _
        }
    }
    i <- [0..sealed.len()): {

        ixout844c24 = sealed[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        rec[13 + i]: {
            ok -> it = ixout844c24

            -> _
        }
    }

    #{overflow=wrap}
    rec.truncate(5 + frag-len)

    #{overflow=wrap}
    sent = net.net-send(.fd, rec, 5 + frag-len)
    sent < 0 -> return
    ok = true
}

; TLS 1.2 AES-128-GCM AEAD 記錄解密（RFC 5288）
; buf []byte: 接收到的記錄（從標頭開始）
; expected-ct i64: 預期 content type（用於 AAD）
; key [16]byte: server_write_key
; salt [4]byte: server_write_IV（implicit salt）
; seq i64: 記錄序號
; 返回 ct i64: 成功=expected-ct, -1=錯誤
; 返回 out []byte: 解密後的明文
; [decrypt-record-gcm](#tls.conn.decrypt-record-gcm)
conn.decrypt-record-gcm = (buf []byte, expected-ct i64, key [16]byte, salt [4]byte, seq i64) (ct i64, out []byte) {
    ct = -1
    rlen = get-u16(buf, 3)

    ; 最小長度: 8 explicit nonce + 16 tag
    rlen < 24 -> return

    ; nonce(12) = salt(4) || explicit(8)
    nonce [12]byte
    i <- [0..4): {
        nonce[i]: {
            ok -> it = salt[i]

            -> _
        }
    }
    i <- [0..8): {

        #{overflow=wrap}
        ixout888c24 = buf[5 + i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        nonce[4 + i]: {
            ok -> it = ixout888c24

            -> _
        }
    }

    ; sealed = ciphertext || tag（緊接在 8-byte 顯式 nonce 之後）

    #{overflow=wrap}
    sealed-len = rlen - 8
    sealed []byte = with-len(sealed-len)
    i <- [0..sealed-len): {

        #{overflow=wrap}
        ixout903c24 = buf[13 + i]: {
            ok -> it

            -> _
        }

        sealed[i]: {
            ok -> it = ixout903c24

            -> _
        }
    }
    sealed.truncate(sealed-len)

    ; AAD = seq(8) || type(1) || version(2) || plaintext_len(2)

    #{overflow=wrap}
    plain-len = sealed-len - 16
    aad []byte = with-len(13)
    i <- [0..8): {

        #{overflow=wrap}
        aad[7 - i]: {
            ok -> it = (seq >> (i * 8)) & 255

            -> _
        }
    }

    aad[8]: {
        ok -> it = expected-ct & 255

        -> _
    }
    put-u16(aad, 9, TLS-VERSION)
    put-u16(aad, 11, plain-len)
    aad.truncate(13)
    plain []byte
    plain = aes-gcm.open-128(key, nonce, aad, sealed)

    ; 認證失敗時 open 返回長度 0（零長明文本身在記錄層不會出現：握手/應用資料均有內容）
    plain.len() == 0 && plain-len == 0 -> return
    plain.len() == 0 -> return
    out = plain
    ct = expected-ct
}

; 加密記錄並發送
; ct i64: 原始 content type
; data []byte: 明文資料
; 返回 ok bool: true=成功
; [encrypt-record](#tls.conn.encrypt-record)
conn.encrypt-record = (ct i64, data []byte) (ok bool) {
    ok = false

    ; GCM 套件：AEAD 路徑（RFC 5288）
    cipher-is-gcm(.cipher-id) -> {
        ok = .encrypt-record-gcm(ct, data, .client-enc-key, .client-gcm-salt, .write-seq)
        ok == false -> return

        #{overflow=wrap}
        .write-seq = .write-seq + 1
        ok = true
        return
    }
    n = data.len()

    ; 1. 計算 MAC
    ; MAC = HMAC-SHA256(mac_key, seq_num(8) + type(1) + version(2) + length(2) + content)
    #{overflow=wrap}
    mac-input []byte = with-len(13 + n)

    ; seq_num (8 bytes big-endian)
    seq = .write-seq
    i <- [0..8): {

        #{overflow=wrap}
        mac-input[7 - i]: {
            ok -> it = (seq >> (i * 8)) & 255

            -> _
        }
    }

    mac-input[8]: {
        ok -> it = ct & 255

        -> _
    }
    put-u16(mac-input, 9, TLS-VERSION)
    put-u16(mac-input, 11, n)
    i <- [0..n): {

        ixout991c24 = data[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[13 + i]: {
            ok -> it = ixout991c24

            -> _
        }
    }
    mac [32]byte

    mac = hmac.hmac-sha256(.client-mac-key[..], mac-input)

    ; 2. 明文 + MAC

    #{overflow=wrap}
    plain []byte = with-len(n + 32)
    i <- [0..n): {

        ixout1008c24 = data[i]: {
            ok -> it

            -> _
        }

        plain[i]: {
            ok -> it = ixout1008c24

            -> _
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        plain[n + i]: {
            ok -> it = mac[i]

            -> _
        }
    }

    #{overflow=wrap}
    plain-len = n + 32
    plain.truncate(plain-len)

    ; 3. TLS 填充（RFC 5246，非 PKCS#7）
    padded []byte
    padded = tls-pad(plain)

    ; 4. 生成隨機 IV
    iv [16]byte
    iv-bytes = rand-bytes(.rand-state, 16)
    i <- [0..16): {

        ixout1038c24 = iv-bytes[i]: {
            ok -> it

            -> _
        }

        iv[i]: {
            ok -> it = ixout1038c24

            -> _
        }
    }

    ; 5. AES-128-CBC 加密
    cipher []byte
    cipher = aes-cbc.enc-128(padded, .client-enc-key, iv)

    ; 6. 構建記錄: type(1) + version(2) + length(2) + IV(16) + cipher

    #{overflow=wrap}
    rec-len = 16 + padded.len()

    #{overflow=wrap}
    rec []byte = with-len(5 + rec-len)

    ; 記錄外層 type 必須與 MAC 計算所用的 type 一致（握手記錄為 22，應用資料為 23）。
    ; 若強制為 23，對端（如 OpenSSL）會用記錄頭 type 驗 MAC → 與我方用原始 type 算出的 MAC 不符 → bad record mac。
    rec[0]: {
        ok -> it = ct & 255

        -> _
    }
    put-u16(rec, 1, TLS-VERSION)
    put-u16(rec, 3, rec-len)
    i <- [0..16): {

        #{overflow=wrap}
        rec[5 + i]: {
            ok -> it = iv[i]

            -> _
        }
    }
    i <- [0..padded.len()): {

        ixout1078c24 = cipher[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        rec[5 + 16 + i]: {
            ok -> it = ixout1078c24

            -> _
        }
    }

    #{overflow=wrap}
    rec.truncate(5 + rec-len)

    ; 7. 發送

    #{overflow=wrap}
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return

    #{overflow=wrap}
    .write-seq = .write-seq + 1
    ok = true
}

; 解密記錄
; buf []byte: 接收到的記錄資料（從標頭開始）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
; expected-ct i64: 預期 content type（解密後比對，不符即視為錯誤）
; [decrypt-record](#tls.conn.decrypt-record)
conn.decrypt-record = (buf []byte, expected-ct i64) (ct i64, out []byte) {
    ct = -1

    ; GCM 套件：AEAD 路徑（RFC 5288）
    cipher-is-gcm(.cipher-id) -> {
        ct, out = .decrypt-record-gcm(buf, expected-ct, .server-enc-key, .server-gcm-salt, .read-seq)
        ct < 0 -> return

        #{overflow=wrap}
        .read-seq = .read-seq + 1
        return
    }
    rlen = get-u16(buf, 3)
    rlen < 16 -> return

    ; 提取 IV
    iv [16]byte
    i <- [0..16): {

        #{overflow=wrap}
        ixout1125c24 = buf[5 + i]: {
            ok -> it

            -> _
        }

        iv[i]: {
            ok -> it = ixout1125c24

            -> _
        }
    }

    ; 密文

    #{overflow=wrap}
    cipher-len = rlen - 16
    cipher []byte = with-len(cipher-len)
    i <- [0..cipher-len): {

        #{overflow=wrap}
        ixout1140c24 = buf[5 + 16 + i]: {
            ok -> it

            -> _
        }

        cipher[i]: {
            ok -> it = ixout1140c24

            -> _
        }
    }
    cipher.truncate(cipher-len)

    ; AES-128-CBC 解密
    plain []byte
    plain = aes-cbc.dec-128(cipher, .server-enc-key, iv)
    plain-len = cipher-len

    ; 移除 TLS 填充
    unpad-n = tls-unpad(plain)
    unpad-n < 0 -> return
    plain-len = unpad-n

    ; 驗證 MAC（最後 32 位元組為 MAC）
    plain-len < 32 -> return

    #{overflow=wrap}
    content-len = plain-len - 32

    ; 計算期望 MAC

    #{overflow=wrap}
    mac-input []byte = with-len(13 + content-len)
    seq = .read-seq
    i <- [0..8): {

        #{overflow=wrap}
        mac-input[7 - i]: {
            ok -> it = (seq >> (i * 8)) & 255

            -> _
        }
    }

    ; TLS 1.2 中加密記錄的 type 固定為 23，但 MAC 計算使用原始 type

    mac-input[8]: {
        ok -> it = expected-ct & 255

        -> _
    }
    put-u16(mac-input, 9, TLS-VERSION)
    put-u16(mac-input, 11, content-len)
    i <- [0..content-len): {

        ixout1191c24 = plain[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[13 + i]: {
            ok -> it = ixout1191c24

            -> _
        }
    }
    exp-mac [32]byte

    exp-mac = hmac.hmac-sha256(.server-mac-key[..], mac-input)

    ; 驗證 MAC
    recv-mac-off = content-len
    i <- [0..32): {

        #{overflow=wrap}
        b1 = plain[recv-mac-off + i]: {
            ok -> it

            -> 0
        }

        b2 = exp-mac[i]
        b1 != b2 -> return
    }

    ; 輸出明文
    out = with-cap(rlen)
    i <- [0..content-len): {

        ixout1220c18 = plain[i]: {
            ok -> it

            -> _
        }

        out[i] = ixout1220c18
    }
    out.truncate(content-len)
    ct = expected-ct

    #{overflow=wrap}
    .read-seq = .read-seq + 1
}

; ═══════════════════════════════════════════════
; RSA PKCS#1 v1.5 加密
; ═══════════════════════════════════════════════

; RSA PKCS#1 v1.5 加密
; msg []byte: 訊息（premaster secret, 48 bytes）
; mod-bytes []byte: RSA 模數（big-endian）
; exp i64: RSA 公鑰指數
; 返回 out []byte: 加密後的資料（長度 = mod-bytes.len）
; [rsa-pkcs1-encrypt](#tls.rsa-pkcs1-encrypt)
rsa-pkcs1-encrypt = (msg []byte, mod-bytes []byte, exp i64) (out []byte) {
    msg-n = msg.len()
    mod-n = mod-bytes.len()

    ; PKCS#1 v1.5 填充: 0x00 || 0x02 || PS || 0x00 || msg
    ; PS 長度 = mod-n - msg-n - 3
    #{overflow=wrap}
    ps-len = mod-n - msg-n - 3
    ps-len < 8 -> return

    ; 構建填充後的訊息
    padded []byte = with-len(mod-n)

    padded[0]: {
        ok -> it = 0

        -> _
    }

    padded[1]: {
        ok -> it = 2

        -> _
    }

    ; PS: 非零隨機位元組
    state = time.now-ns()
    i <- [0..ps-len): {
        state, r = rand.rand(state)
        b = state & 255
        b == 0 -> b = 1

        #{overflow=wrap}
        padded[2 + i]: {
            ok -> it = b

            -> _
        }
    }

    #{overflow=wrap}
    padded[2 + ps-len]: {
        ok -> it = 0

        -> _
    }

    ; 複製訊息
    i <- [0..msg-n): {

        ixout1291c24 = msg[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        padded[3 + ps-len + i]: {
            ok -> it = ixout1291c24

            -> _
        }
    }
    padded-n = mod-n
    padded.truncate(padded-n)

    ; 轉換為大整數
    m-bn []i64
    m-bn = bytes-to-bn(padded)

    ; 模數轉大整數
    n-bn []i64
    n-bn = bytes-to-bn(mod-bytes)

    ; 指數轉大整數
    e-bn []i64 = with-len(1)

    e-bn[0]: {
        ok -> it = exp

        -> _
    }

    ; RSA 加密: c = m^e mod n
    c-bn []i64
    c-bn, c-bn-n = rsa.rsa-modpow(m-bn, m-bn.len(), e-bn, 1, n-bn, n-bn.len())

    ; 轉換回位元組
    raw []byte
    raw = bn-to-bytes(c-bn)

    ; 確保輸出長度 = mod-n（左側補零）
    #{overflow=wrap}
    {
        raw.len() == mod-n -> out = raw

        raw.len() < mod-n -> {

            ; 建立新緩衝區, 左側補零
            out = with-len(mod-n)
            shift = mod-n - raw.len()
            i <- [0..shift): {
                out[i] = 0
            }
            i <- [0..raw.len()): {

                ixout1340c34 = raw[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                out[shift + i] = ixout1340c34
            }
        }

        raw.len() > mod-n -> {

            ; 結果比模數長（不應發生）, 截斷
            out = with-len(mod-n)
            off = raw.len() - mod-n
            i <- [0..mod-n): {

                #{overflow=wrap}
                ixout1352c26 = raw[off + i]: {
                    ok -> it

                    -> _
                }

                out[i] = ixout1352c26
            }
        }
    }
}

; ═══════════════════════════════════════════════
; 交握協議（Handshake Protocol）
; ═══════════════════════════════════════════════

; send-client-hello: 發送 ClientHello
; 返回 ok bool: true=成功
; 生成臨時 X25519 金鑰對（存入 .client-priv/.client-pub）
; 內聯實現，避免多返回值 [32]byte 的編譯器 bug
; [gen-x25519-keypair](#tls.conn.gen-x25519-keypair)
conn.gen-x25519-keypair = () {
    seed = .rand-state

    #{overflow=wrap}
    .rand-state = .rand-state + 1

    ; 生成私鑰
    kp-state = seed
    i <- [0..32): {
        kp-state, kp-r = rand.rand(kp-state)

        {
            .client-priv[i] ?= kp-state & 255
        }: {
            err -> _

            -> _
        }
    }

    {
        old ?= .client-priv[0]
        .client-priv[0] ?= old & 248
    }: {
        err -> _

        -> _
    }

    {
        old ?= .client-priv[31]
        .client-priv[31] ?= old & 127
    }: {
        err -> _

        -> _
    }

    {
        old ?= .client-priv[31]
        .client-priv[31] ?= old | 64
    }: {
        err -> _

        -> _
    }

    ; 透過 []byte 傳遞給 x25519（避開全域 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i]: {
            ok -> it = .client-priv[i]

            -> _
        }
    }
    pub-slice = x25519.x25519-scalarmult-base-bytes(priv-slice)
    i <- [0..32): {

        ixout1400c26 = pub-slice[i]: {
            ok -> it

            -> _
        }

        {
            .client-pub[i] ?= ixout1400c26
        }: {
            err -> _

            -> _
        }
    }
}

; 生成臨時 P-256 私鑰（大端序）與未壓縮公鑰
; 存入 .client-priv/.pub-p256（secp256r1 ECDHE 使用）
; [gen-p256-keypair](#tls.conn.gen-p256-keypair)
conn.gen-p256-keypair = () {
    s = .rand-state

    #{overflow=wrap}
    .rand-state = .rand-state + 32
    i <- [0..32): {
        s, r = rand.rand(s)

        {
            .client-priv[i] ?= s & 255
        }: {
            err -> _

            -> _
        }
    }

    ; 透過 []byte 複製公鑰（避開跨模組 [65]byte 傳回的編譯器 bug）
    pub-arr [65]byte
    pub-arr = ecdsa.ecdsa-publickey(.client-priv)
    i <- [0..65): {
        {
            .pub-p256[i] ?= pub-arr[i]
        }: {
            err -> _

            -> _
        }
    }
}

; 發送 TLS 1.2 ClientHello（含 ECDHE 密碼套件與擴展）
; 返回 ok bool: true=成功
; [send-client-hello](#tls.conn.send-client-hello)
conn.send-client-hello = () (ok bool) {
    ok = false

    ; 生成臨時 X25519 金鑰對（ECDHE 套件使用；static-RSA 套件無害地忽略）
    .gen-x25519-keypair()

    ; ClientHello 訊息
    hs []byte = with-len(512)
    pos = 0

    ; msg_type = 1 (ClientHello)

    hs[0]: {
        ok -> it = TLS-HS-CLIENT-HELLO

        -> _
    }

    ; length (3 bytes, 填入後計算)
    pos = 4

    ; version = 0x0303
    put-u16(hs, pos, TLS-VERSION)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt = pos + 2
        pos-opt: {
            ok -> pos = it
            ->
        }
    }

    ; random (32 bytes)
    rand-bytes-val = rand-bytes(.rand-state, 32)

    #{overflow=wrap}
    .rand-state = .rand-state + 32
    i <- [0..32): {

        ixout1465c24 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = ixout1465c24

            -> _
        }

        ixout1471c29 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        {
            .client-random[i] ?= ixout1471c29
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt2 = pos + 32
        pos-opt2: {
            ok -> pos = it
            ->
        }
    }

    ; session_id_length = 0

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt3 = pos + 1
        pos-opt3: {
            ok -> pos = it
            ->
        }
    }

    ; cipher_suites_length = 10 (5 個套件)
    put-u16(hs, pos, 10)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt4 = pos + 2
        pos-opt4: {
            ok -> pos = it
            ->
        }
    }

    ; ECDHE-GCM（真實伺服器首選）> ECDHE-CBC-SHA256 > static-RSA-CBC-SHA256（相容回退）
    put-u16(hs, pos, TLS-CIPHER-ECDHE-RSA-AES128-GCM-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt5 = pos + 2
        pos-opt5: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-CIPHER-ECDHE-ECDSA-AES128-GCM-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt6 = pos + 2
        pos-opt6: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-CIPHER-ECDHE-RSA-AES128-CBC-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt7 = pos + 2
        pos-opt7: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-CIPHER-ECDHE-ECDSA-AES128-CBC-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt8 = pos + 2
        pos-opt8: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-CIPHER-RSA-AES128-CBC-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt9 = pos + 2
        pos-opt9: {
            ok -> pos = it
            ->
        }
    }

    ; compression_methods_length = 1

    hs[pos]: {
        ok -> it = 1

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt10 = pos + 1
        pos-opt10: {
            ok -> pos = it
            ->
        }
    }

    ; compression_method = 0 (null)

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt11 = pos + 1
        pos-opt11: {
            ok -> pos = it
            ->
        }
    }

    ; === 擴展（先記錄總長度位置，稍後填入）===
    ext-len-pos = pos

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt12 = pos + 2
        pos-opt12: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 1: server_name (SNI, 0) — 虛擬主機路由的伺服器必要
    put-u16(hs, pos, TLS-EXT-SERVER-NAME)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt13 = pos + 2
        pos-opt13: {
            ok -> pos = it
            ->
        }
    }
    host-n = .host.len-bytes()

    ; ext data length = 2 + 1 + 2 + host-n

    #{overflow=wrap}
    sni-ext-len = 5 + host-n
    put-u16(hs, pos, sni-ext-len)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt14 = pos + 2
        pos-opt14: {
            ok -> pos = it
            ->
        }
    }

    ; server name list length = 1 + 2 + host-n

    #{overflow=wrap}
    sni-list-len = 3 + host-n
    put-u16(hs, pos, sni-list-len)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt15 = pos + 2
        pos-opt15: {
            ok -> pos = it
            ->
        }
    }

    ; name type = 0 (host_name)

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt16 = pos + 1
        pos-opt16: {
            ok -> pos = it
            ->
        }
    }

    ; name length
    put-u16(hs, pos, host-n)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt17 = pos + 2
        pos-opt17: {
            ok -> pos = it
            ->
        }
    }

    ; name
    i <- [0..host-n): {

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = .host.byte(i)

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + host-n

    ; 擴展 2: supported_groups (10) — x25519 + secp256r1
    ; secp256r1 必須在列，否則 OpenSSL 判定 ECDHE-ECDSA 套件不合格（no shared cipher）；
    ; 實際交握 OpenSSL 首選 x25519（列表中排第一）
    put-u16(hs, pos, TLS-EXT-SUPPORTED-GROUPS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt18 = pos + 2
        pos-opt18: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 6（列表長度 2 + 曲線 2×2）
    put-u16(hs, pos, 6)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt19 = pos + 2
        pos-opt19: {
            ok -> pos = it
            ->
        }
    }

    ; groups list length = 4
    put-u16(hs, pos, 4)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt20 = pos + 2
        pos-opt20: {
            ok -> pos = it
            ->
        }
    }

    ; x25519 = 0x001D
    put-u16(hs, pos, TLS-GROUP-X25519)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt21 = pos + 2
        pos-opt21: {
            ok -> pos = it
            ->
        }
    }

    ; secp256r1 = 0x0017
    put-u16(hs, pos, TLS-GROUP-SECP256R1)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt22 = pos + 2
        pos-opt22: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 3: ec_point_formats (11) — 0 = uncompressed（OpenSSL 必要）
    put-u16(hs, pos, TLS-EXT-EC-POINT-FORMATS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt23 = pos + 2
        pos-opt23: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 2（列表長度 1 + 格式 1）
    put-u16(hs, pos, 2)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt24 = pos + 2
        pos-opt24: {
            ok -> pos = it
            ->
        }
    }

    ; formats list length = 1

    hs[pos]: {
        ok -> it = 1

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt25 = pos + 1
        pos-opt25: {
            ok -> pos = it
            ->
        }
    }

    ; format 0 = uncompressed

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt26 = pos + 1
        pos-opt26: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 4: signature_algorithms (13) — 9 個演算法
    put-u16(hs, pos, TLS-EXT-SIGNATURE-ALGORITHMS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt27 = pos + 2
        pos-opt27: {
            ok -> pos = it
            ->
        }
    }

    ; 9 個演算法 = 18 bytes; ext data length = 2 (list len) + 18 = 20
    put-u16(hs, pos, 20)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt28 = pos + 2
        pos-opt28: {
            ok -> pos = it
            ->
        }
    }

    ; sig algs list length = 18
    put-u16(hs, pos, 18)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt29 = pos + 2
        pos-opt29: {
            ok -> pos = it
            ->
        }
    }

    ; 依優先順序：RSA-PSS（現代首選）> ECDSA > RSA-PKCS1
    put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt30 = pos + 2
        pos-opt30: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-ECDSA-SECP256R1-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt31 = pos + 2
        pos-opt31: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA384)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt32 = pos + 2
        pos-opt32: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-ECDSA-SECP384R1-SHA384)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt33 = pos + 2
        pos-opt33: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA512)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt34 = pos + 2
        pos-opt34: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-ECDSA-SECP521R1-SHA512)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt35 = pos + 2
        pos-opt35: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt36 = pos + 2
        pos-opt36: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA384)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt37 = pos + 2
        pos-opt37: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA512)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt38 = pos + 2
        pos-opt38: {
            ok -> pos = it
            ->
        }
    }

    ; 填入擴展總長度

    #{overflow=wrap}
    ext-total = pos - ext-len-pos - 2: {
        ok -> it

        -> 0
    }
    put-u16(hs, ext-len-pos, ext-total)

    ; 填入 length

    #{overflow=wrap}
    body-len = pos - 4: {
        ok -> it

        -> 0
    }
    put-u24(hs, 1, body-len)

    ; 設定實際長度（否則 send-raw/append-hs 會把 with-len 的尾隨 0 位元組一併送出，
    ; 伺服器會把它們當成下一個交握訊息 → fatal unexpected_message）
    hs.truncate(pos)

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 發送為 handshake 記錄
    send-raw(.fd, TLS-CT-HANDSHAKE, hs)
    ok = true
}

; 是否為 ECDHE 密鑰交換的 TLS 1.2 密碼套件
; 目前涵蓋 ECDHE-ECDSA/RSA 搭配 AES128-CBC-SHA256 與 AES128-GCM-SHA256 四種。
; c i64: 密碼套件代碼（TLS-CIPHER-* 常數）
; r bool: true=上述四種之一（可做 ECDHE 金鑰交換）, false=其他套件
; [cipher-is-ecdhe](#tls.cipher-is-ecdhe)
cipher-is-ecdhe = (c i64) (r bool) {
    r = c == TLS-CIPHER-ECDHE-ECDSA-AES128-CBC-SHA256
    r = r || c == TLS-CIPHER-ECDHE-RSA-AES128-CBC-SHA256
    r = r || c == TLS-CIPHER-ECDHE-ECDSA-AES128-GCM-SHA256
    r = r || c == TLS-CIPHER-ECDHE-RSA-AES128-GCM-SHA256
}

; 是否為 AEAD (AES-GCM) 記錄格式的 TLS 1.2 密碼套件
; 只有 ECDHE-ECDSA-AES128-GCM-SHA256 與 ECDHE-RSA-AES128-GCM-SHA256 兩種。
; c i64: 密碼套件代碼（TLS-CIPHER-* 常數）
; r bool: true=使用 AES-GCM 記錄（需 explicit nonce）驗證標籤, false=使用 CBC + HMAC 格式
; [cipher-is-gcm](#tls.cipher-is-gcm)
cipher-is-gcm = (c i64) (r bool) {
    r = c == TLS-CIPHER-ECDHE-ECDSA-AES128-GCM-SHA256
    r = r || c == TLS-CIPHER-ECDHE-RSA-AES128-GCM-SHA256
}

; 讀取 ServerHello
; 返回 ok bool: true=成功
; [read-server-hello](#tls.conn.read-server-hello)
conn.read-server-hello = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return

    ; 追加到交握緩衝區（只追加 handshake 資料部分，跳過 5-byte record header）
    .append-hs-from(buf, 5, rlen)

    ; 解析 handshake message（buf[5] = handshake type, buf[6..8] = length, buf[9+] = data）

    pos = 9

    msg-type = buf[5]
    msg-type != TLS-HS-SERVER-HELLO -> return
    msg-len = get-u24(buf, 6)

    ; version（buf[9..10]）

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt39 = pos + 2
        pos-opt39: {
            ok -> pos = it
            ->
        }
    }

    ; random (32 bytes)
    i <- [0..32): {

        #{overflow=wrap}
        ixout1811c29 = buf[pos + i]: {
            ok -> it

            -> _
        }

        {
            .server-random[i] ?= ixout1811c29
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt40 = pos + 32
        pos-opt40: {
            ok -> pos = it
            ->
        }
    }

    ; session_id

    sid-len = buf[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt41 = pos + 1 + sid-len
        pos-opt41: {
            ok -> pos = it
            ->
        }
    }

    ; cipher_suite — 必須是我方支援的 TLS 1.2 套件
    cipher = get-u16(buf, pos)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt42 = pos + 2
        pos-opt42: {
            ok -> pos = it
            ->
        }
    }
    supported = cipher == TLS-CIPHER-RSA-AES128-CBC-SHA256
    supported = supported || cipher-is-ecdhe(cipher)
    supported == false -> return
    .cipher-id = cipher

    ; compression_method

    comp = buf[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt43 = pos + 1
        pos-opt43: {
            ok -> pos = it
            ->
        }
    }
    comp != 0 -> return
    ok = true
}

; 讀取 Certificate
; cert-out []byte: 輸出憑證 DER 資料
; 返回 ok bool: true=成功
; [read-certificate](#tls.conn.read-certificate)
conn.read-certificate = (cert-out []byte) (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return
    .append-hs-from(buf, 5, rlen)

    ; 解析 handshake message（buf[5] = type, buf[6..8] = length, buf[9+] = data）

    msg-type = buf[5]
    msg-type != TLS-HS-CERTIFICATE -> return
    pos = 9

    ; total certs length (3 bytes)
    total-len = get-u24(buf, pos)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt44 = pos + 3
        pos-opt44: {
            ok -> pos = it
            ->
        }
    }

    ; first cert length (3 bytes)
    cert-len = get-u24(buf, pos)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt45 = pos + 3
        pos-opt45: {
            ok -> pos = it
            ->
        }
    }

    ; 複製憑證
    i <- [0..cert-len): {

        #{overflow=wrap}
        ixout1888c24 = buf[pos + i]: {
            ok -> it

            -> _
        }

        cert-out[i]: {
            ok -> it = ixout1888c24

            -> _
        }
    }
    cert-out.truncate(cert-len)
    ok = true
}

; 讀取 ECDHE ServerKeyExchange（僅 ECDHE 套件）
; 解析出伺服器臨時 X25519 公鑰存入 .server-pub（憑證與簽名不做驗證，與本实现的信任模型一致）
; 返回 ok bool: true=成功
; [read-server-key-exchange](#tls.conn.read-server-key-exchange)
conn.read-server-key-exchange = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return
    .append-hs-from(buf, 5, rlen)

    ; 解析 handshake message（buf[5] = type, buf[6..8] = length, buf[9+] = data）

    msg-type = buf[5]
    msg-type != TLS-HS-SERVER-KEY-EXCHANGE -> return
    pos = 9

    ; curve_type: 3 = named_curve

    curve-type = buf[pos]: {
        ok -> it

        -> 0
    }
    curve-type != 3 -> return

    ; named curve 必須是我方支援的 x25519 / secp256r1

    #{overflow=wrap}
    g-pos = pos + 1: {
        ok -> it

        -> 0
    }
    group = get-u16(buf, g-pos)
    (group != TLS-GROUP-X25519 && group != TLS-GROUP-SECP256R1) -> return
    .kx-group = group

    ; ECPoint: 1-byte 長度 + 公鑰（x25519 為 32 bytes 原始編碼；部分實作帶 0x04 前綴）

    #{overflow=wrap}
    plen = buf[pos + 3]: {
        ok -> it

        -> 0
    }
    group == TLS-GROUP-SECP256R1 -> {

        ; P-256 未壓縮點：0x04 || x(32) || y(32) = 65 bytes
        plen != 65 -> return

        #{overflow=wrap}
        ixout1953c9 = buf[pos + 4]: {
            ok -> it

            -> _
        }

        ixout1953c9 != 4 -> return
        i <- [0..65): {

            #{overflow=wrap}
            ixout1957c29 = buf[pos + 4 + i]: {
                ok -> it

                -> _
            }

            {
                .peer-p256[i] ?= ixout1957c29
            }: {
                err -> _

                -> _
            }
        }
        ok = true
        return
    }
    plen == 32 -> {
        i <- [0..32): {

            #{overflow=wrap}
            ixout1966c30 = buf[pos + 4 + i]: {
                ok -> it

                -> _
            }

            {
                .server-pub[i] ?= ixout1966c30
            }: {
                err -> _

                -> _
            }
        }
        ok = true
        return
    }
    plen == 33 -> {

        ; 0x04 || raw32：剝離前綴

        #{overflow=wrap}
        ixout1976c9 = buf[pos + 4]: {
            ok -> it

            -> _
        }

        ixout1976c9 != 4 -> return
        i <- [0..32): {

            #{overflow=wrap}
            ixout1980c30 = buf[pos + 5 + i]: {
                ok -> it

                -> _
            }

            {
                .server-pub[i] ?= ixout1980c30
            }: {
                err -> _

                -> _
            }
        }
        ok = true
        return
    }
}

; 讀取 ServerHelloDone
; 返回 ok bool: true=成功
; [read-server-hello-done](#tls.conn.read-server-hello-done)
conn.read-server-hello-done = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return
    .append-hs-from(buf, 5, rlen)

    msg-type = buf[5]
    msg-type != TLS-HS-SERVER-HELLO-DONE -> return
    ok = true
}

; 發送 ClientKeyExchange
; premaster []byte: premaster secret（static-RSA 套件用, 48 bytes；ECDHE 套件忽略）
; cert []byte: 伺服器憑證 DER（static-RSA 套件用）
; 返回 ok bool: true=成功
; [send-client-key-exchange](#tls.conn.send-client-key-exchange)
conn.send-client-key-exchange = (premaster []byte, cert []byte) (ok bool) {
    ok = false

    ; ECDHE: body = ECPoint（1-byte 長度 + 臨時公鑰）
    cipher-is-ecdhe(.cipher-id) -> {

        ; secp256r1：04||x||y 共 65 bytes（body = 1 + 65 = 66）
        .kx-group == TLS-GROUP-SECP256R1 -> {
            hs []byte = with-len(70)

            hs[0]: {
                ok -> it = TLS-HS-CLIENT-KEY-EXCHANGE

                -> _
            }
            put-u24(hs, 1, 66)

            hs[4]: {
                ok -> it = 65

                -> _
            }
            i <- [0..65): {

                #{overflow=wrap}
                hs[5 + i]: {
                    ok -> it = .pub-p256[i]

                    -> _
                }
            }
            .append-hs(hs)
            send-raw(.fd, TLS-CT-HANDSHAKE, hs)
            ok = true
            return
        }

        ; x25519：原始 32 bytes（body = 1 + 32 = 33）
        hs []byte = with-len(37)

        hs[0]: {
            ok -> it = TLS-HS-CLIENT-KEY-EXCHANGE

            -> _
        }
        put-u24(hs, 1, 33)

        hs[4]: {
            ok -> it = 32

            -> _
        }
        i <- [0..32): {

            #{overflow=wrap}
            hs[5 + i]: {
                ok -> it = .client-pub[i]

                -> _
            }
        }
        .append-hs(hs)
        send-raw(.fd, TLS-CT-HANDSHAKE, hs)
        ok = true
        return
    }

    ; static-RSA: RSA 加密 premaster
    cert-n = cert.len()

    ; 提取 RSA 公鑰
    mod-bytes []byte
    mod-bytes = x509.x509-rsa-n(cert)
    mod-bytes.len() == 0 -> return
    exp = x509.x509-rsa-e(cert)
    exp == 0 -> exp = 65537

    ; RSA 加密 premaster secret
    enc-premaster []byte
    enc-premaster = rsa-pkcs1-encrypt(premaster, mod-bytes, exp)
    enc-premaster.len() == 0 -> return

    ; 構建 ClientKeyExchange 訊息
    ; length = 2 + enc-premaster.len
    #{overflow=wrap}
    body-len = 2 + enc-premaster.len()

    #{overflow=wrap}
    hs-len = 4 + body-len
    hs []byte = with-len(hs-len)

    hs[0]: {
        ok -> it = TLS-HS-CLIENT-KEY-EXCHANGE

        -> _
    }
    put-u24(hs, 1, body-len)

    ; encrypted premaster length
    put-u16(hs, 4, enc-premaster.len())

    ; encrypted premaster
    i <- [0..enc-premaster.len()): {

        ixout2115c24 = enc-premaster[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[6 + i]: {
            ok -> it = ixout2115c24

            -> _
        }
    }
    .append-hs(hs)
    send-raw(.fd, TLS-CT-HANDSHAKE, hs)
    ok = true
}

; 發送 ChangeCipherSpec
; [send-change-cipher-spec](#tls.conn.send-change-cipher-spec)
conn.send-change-cipher-spec = () {
    ccs [1]byte

    ccs[0]: {
        ok -> it = 1

        -> _
    }
    hdr [5]byte

    hdr[0]: {
        ok -> it = TLS-CT-CCS & 255

        -> _
    }

    hdr[1]: {
        ok -> it = (TLS-VERSION >> 8) & 255

        -> _
    }

    hdr[2]: {
        ok -> it = TLS-VERSION & 255

        -> _
    }

    hdr[3]: {
        ok -> it = 0

        -> _
    }

    hdr[4]: {
        ok -> it = 1

        -> _
    }
    net.net-send(.fd, hdr, 5)
    net.net-send(.fd, ccs, 1)
}

; 發送加密的 Finished 訊息
; 返回 ok bool: true=成功
; [send-finished](#tls.conn.send-finished)
conn.send-finished = () (ok bool) {
    ok = false

    ; 計算 handshake hash
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; verify_data = PRF(master, "client finished", hash, 12)
    verify []byte
    verify = prf(.master-secret, 'client finished', hs-hash, TLS-FINISHED-SIZE)

    ; 構建 Finished 訊息

    #{overflow=wrap}
    hs-len = 4 + TLS-FINISHED-SIZE
    hs []byte = with-len(hs-len)

    hs[0]: {
        ok -> it = TLS-HS-FINISHED

        -> _
    }
    put-u24(hs, 1, TLS-FINISHED-SIZE)
    i <- [0..TLS-FINISHED-SIZE): {

        ixout2201c24 = verify[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[4 + i]: {
            ok -> it = ixout2201c24

            -> _
        }
    }

    ; 追加到交握緩衝區（在加密之前）
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record(TLS-CT-HANDSHAKE, hs)
}

; 讀取 ChangeCipherSpec
; 返回 ok bool: true=成功
; [read-change-cipher-spec](#tls.conn.read-change-cipher-spec)
conn.read-change-cipher-spec = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-CCS -> return
    rlen != 1 -> return
    ixout2473c9 = buf[5]: {
        ok -> it

        -> _
    }

    (ixout2473c9) != 1 -> {
        return
    }
    ok = true
}

; 讀取加密的 Finished 訊息
; 返回 ok bool: true=成功
; [read-finished](#tls.conn.read-finished)
conn.read-finished = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return

    ; 解密
    plain []byte
    d-ct = 0
    d-ct, plain = .decrypt-record(buf, TLS-CT-HANDSHAKE)
    d-ct < 0 -> return

    ; 解析 Finished 訊息

    msg-type = plain[0]: {
        ok -> it

        -> 0
    }
    msg-type != TLS-HS-FINISHED -> return

    ; 驗證 verify_data（hash 不包含 server Finished）
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)
    verify []byte
    verify = prf(.master-secret, 'server finished', hs-hash, TLS-FINISHED-SIZE)
    i <- [0..TLS-FINISHED-SIZE): {

        #{overflow=wrap}
        b1 = plain[4 + i]: {
            ok -> it

            -> 0
        }

        b2 = verify[i]: {
            ok -> it

            -> 0
        }
        b1 != b2 -> return
    }

    ; 驗證成功後追加到交握緩衝區
    .append-hs(plain)
    ok = true
}

; ═══════════════════════════════════════════════
; 金鑰推導
; ═══════════════════════════════════════════════

; 從 premaster secret 推導所有金鑰
; premaster []byte: premaster secret（static-RSA 48 bytes / ECDHE 32 bytes）
; [derive-keys](#tls.conn.derive-keys)
conn.derive-keys = (premaster []byte) {

    ; master_secret = PRF(premaster, "master secret", client_random + server_random, 48)
    seed []byte = with-len(64)
    i <- [0..32): {
        seed[i]: {
            ok -> it = .client-random[i]

            -> _
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        seed[32 + i]: {
            ok -> it = .server-random[i]

            -> _
        }
    }
    seed.truncate(64)
    .master-secret = prf(premaster, 'master secret', seed, 48)

    ; key_block = PRF(master, "key expansion", server_random + client_random, ...)
    ks []byte = with-len(64)
    i <- [0..32): {
        ks[i]: {
            ok -> it = .server-random[i]

            -> _
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        ks[32 + i]: {
            ok -> it = .client-random[i]

            -> _
        }
    }
    ks.truncate(64)
    cipher-is-gcm(.cipher-id) -> {

        ; AEAD (RFC 5288): key_block = client_write_key(16) || server_write_key(16)
        ;                          || client_write_IV(4) || server_write_IV(4)（無 MAC 金鑰）
        key-block []byte
        key-block = prf(.master-secret, 'key expansion', ks, 40)
        i <- [0..16): {

            ixout2343c34 = key-block[i]: {
                ok -> it

                -> _
            }

            {
                .client-enc-key[i] ?= ixout2343c34
            }: {
                err -> _

                -> _
            }
        }
        i <- [0..16): {

            #{overflow=wrap}
            ixout2348c34 = key-block[16 + i]: {
                ok -> it

                -> _
            }

            {
                .server-enc-key[i] ?= ixout2348c34
            }: {
                err -> _

                -> _
            }
        }
        i <- [0..4): {

            #{overflow=wrap}
            ixout2353c35 = key-block[32 + i]: {
                ok -> it

                -> _
            }

            {
                .client-gcm-salt[i] ?= ixout2353c35
            }: {
                err -> _

                -> _
            }
        }
        i <- [0..4): {

            #{overflow=wrap}
            ixout2358c35 = key-block[36 + i]: {
                ok -> it

                -> _
            }

            {
                .server-gcm-salt[i] ?= ixout2358c35
            }: {
                err -> _

                -> _
            }
        }

        ; 重置序號
        .write-seq = 0
        .read-seq = 0
        return
    }

    ; CBC + HMAC (RFC 5246): key_block = mac(32)*2 + enc(16)*2 = 96（IV 為隨機顯式 IV）
    key-block []byte
    key-block = prf(.master-secret, 'key expansion', ks, 96)

    ; client_write_MAC_key (32)
    i <- [0..32): {

        ixout2375c30 = key-block[i]: {
            ok -> it

            -> _
        }

        {
            .client-mac-key[i] ?= ixout2375c30
        }: {
            err -> _

            -> _
        }
    }

    ; server_write_MAC_key (32)
    i <- [0..32): {

        #{overflow=wrap}
        ixout2382c30 = key-block[32 + i]: {
            ok -> it

            -> _
        }

        {
            .server-mac-key[i] ?= ixout2382c30
        }: {
            err -> _

            -> _
        }
    }

    ; client_write key (16)
    i <- [0..16): {

        #{overflow=wrap}
        ixout2389c30 = key-block[64 + i]: {
            ok -> it

            -> _
        }

        {
            .client-enc-key[i] ?= ixout2389c30
        }: {
            err -> _

            -> _
        }
    }

    ; server_write key (16)
    i <- [0..16): {

        #{overflow=wrap}
        ixout2396c30 = key-block[80 + i]: {
            ok -> it

            -> _
        }

        {
            .server-enc-key[i] ?= ixout2396c30
        }: {
            err -> _

            -> _
        }
    }

    ; 重置序號
    .write-seq = 0
    .read-seq = 0
}

; ServerHello 之後的 TLS 1.2 完整交握
; （Certificate → [ECDHE: ServerKeyExchange] → ServerHelloDone → 金鑰交換 → CCS/Finished）
; 依賴 .cipher-id（read-server-hello / read-server-hello-13 已記入）與 ECDHE 時的 .client-priv/.client-pub
; 返回 ok bool: true=成功
; [handshake-12-body](#tls.conn.handshake-12-body)
conn.handshake-12-body = () (ok bool) {
    ok = false

    ; 1. 讀取 Certificate
    cert []byte = with-len(16400)
    ok = .read-certificate(cert)
    ok == false -> return
    ecdhe = cipher-is-ecdhe(.cipher-id)

    ; 2. ECDHE: 讀取 ServerKeyExchange 取得伺服器臨時公鑰
    ecdhe -> {
        ok = .read-server-key-exchange()
        ok == false -> return
    }

    ; 3. 讀取 ServerHelloDone
    ok = .read-server-hello-done()
    ok == false -> return

    ; 4. 計算 premaster secret
    premaster []byte
    ecdhe -> {

        ; ECDHE：依交握曲線分派 premaster
        .kx-group == TLS-GROUP-X25519 -> {

            ; premaster = X25519(client_priv, server_pub)（32 bytes）
            priv-slice []byte = with-len(32)
            pub-slice []byte = with-len(32)
            i <- [0..32): {
                priv-slice[i]: {
                    ok -> it = .client-priv[i]

                    -> _
                }

                pub-slice[i]: {
                    ok -> it = .server-pub[i]

                    -> _
                }
            }
            premaster = x25519.x25519-scalarmult-bytes(priv-slice, pub-slice)
            premaster.len() != 32 -> {
                ok = false
                return
            }
        }
        .kx-group == TLS-GROUP-SECP256R1 -> {

            ; premaster = ECDH-P256(client_priv, peer_point)（32 bytes）
            ; ClientHello 階段未生成 P-256 金鑰對，此處現生現用
            ; 注意：此路徑僅在伺服器強制 secp256r1 臨時密鑰時觸發。
            ; supported_groups 列出 secp256r1 只是為讓 OpenSSL 判定 ECDHE-ECDSA
            ; 套件合格，實際交握 OpenSSL 首選 x25519，不會走到這裡。
            .gen-p256-keypair()
            premaster = ecdsa.ecdh-p256(.client-priv, .peer-p256)
            premaster.len() != 32 -> {
                ok = false
                return
            }
        }
    }
    ecdhe == false -> {

        ; static-RSA: 48 bytes（版本前綴 + 隨機）
        premaster = with-len(48)

        premaster[0]: {
            ok -> it = 0x03

            -> _
        }

        premaster[1]: {
            ok -> it = 0x03

            -> _
        }
        rand-bytes-val = rand-bytes(.rand-state, 46)

        #{overflow=wrap}
        .rand-state = .rand-state + 46
        i <- [0..46): {

            ixout2496c28 = rand-bytes-val[i]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            premaster[2 + i]: {
                ok -> it = ixout2496c28

                -> _
            }
        }
    }

    ; 5. 推導金鑰
    .derive-keys(premaster)

    ; 6. 發送 ClientKeyExchange
    ok = .send-client-key-exchange(premaster, cert)
    ok == false -> return

    ; 7. 發送 ChangeCipherSpec + Finished
    .send-change-cipher-spec()
    .encrypted = true
    ok = .send-finished()
    ok == false -> return

    ; 8. 讀取伺服器 ChangeCipherSpec + Finished
    ok = .read-change-cipher-spec()
    ok == false -> return
    ok = .read-finished()
    ok == false -> return
}

; ═══════════════════════════════════════════════
; TLS 1.3 交握與記錄層
; ═══════════════════════════════════════════════

; 發送 TLS 1.3 ClientHello（含擴展）
; 返回 ok bool: true=成功
; [send-client-hello-13](#tls.conn.send-client-hello-13)
conn.send-client-hello-13 = () (ok bool) {
    ok = false

    ; 生成 X25519 金鑰對
    .gen-x25519-keypair()

    ; 構建 ClientHello
    hs []byte = with-len(512)
    pos = 0

    ; msg_type = 1 (ClientHello)

    hs[0]: {
        ok -> it = TLS-HS-CLIENT-HELLO

        -> _
    }
    pos = 4

    ; version = 0x0303（TLS 1.2，相容性）
    put-u16(hs, pos, TLS-VERSION)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt46 = pos + 2
        pos-opt46: {
            ok -> pos = it
            ->
        }
    }

    ; random (32 bytes)
    rand-bytes-val = rand-bytes(.rand-state, 32)

    #{overflow=wrap}
    .rand-state = .rand-state + 32
    i <- [0..32): {

        ixout2564c24 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = ixout2564c24

            -> _
        }

        ixout2570c29 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        {
            .client-random[i] ?= ixout2570c29
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt47 = pos + 32
        pos-opt47: {
            ok -> pos = it
            ->
        }
    }

    ; session_id_length = 0

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt48 = pos + 1
        pos-opt48: {
            ok -> pos = it
            ->
        }
    }

    ; cipher_suites: 6 suites = 12 bytes
    put-u16(hs, pos, 12)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt49 = pos + 2
        pos-opt49: {
            ok -> pos = it
            ->
        }
    }

    ; TLS_AES_128_GCM_SHA256 (TLS 1.3, 0x1301)
    put-u16(hs, pos, TLS-CIPHER-AES128-GCM-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt50 = pos + 2
        pos-opt50: {
            ok -> pos = it
            ->
        }
    }

    ; TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 (TLS 1.2, 0xC02F)
    put-u16(hs, pos, TLS-CIPHER-ECDHE-RSA-AES128-GCM-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt51 = pos + 2
        pos-opt51: {
            ok -> pos = it
            ->
        }
    }

    ; TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 (TLS 1.2, 0xC02B)
    put-u16(hs, pos, TLS-CIPHER-ECDHE-ECDSA-AES128-GCM-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt52 = pos + 2
        pos-opt52: {
            ok -> pos = it
            ->
        }
    }

    ; TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256 (TLS 1.2, 0xC027)
    put-u16(hs, pos, TLS-CIPHER-ECDHE-RSA-AES128-CBC-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt53 = pos + 2
        pos-opt53: {
            ok -> pos = it
            ->
        }
    }

    ; TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256 (TLS 1.2, 0xC023)
    put-u16(hs, pos, TLS-CIPHER-ECDHE-ECDSA-AES128-CBC-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt54 = pos + 2
        pos-opt54: {
            ok -> pos = it
            ->
        }
    }

    ; TLS_RSA_WITH_AES_128_CBC_SHA256 (TLS 1.2, 0x003C)
    put-u16(hs, pos, TLS-CIPHER-RSA-AES128-CBC-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt55 = pos + 2
        pos-opt55: {
            ok -> pos = it
            ->
        }
    }

    ; compression_methods_length = 1

    hs[pos]: {
        ok -> it = 1

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt56 = pos + 1
        pos-opt56: {
            ok -> pos = it
            ->
        }
    }

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt57 = pos + 1
        pos-opt57: {
            ok -> pos = it
            ->
        }
    }

    ; === 擴展 ===
    ; 計算擴展總長度（先記錄位置，稍後填入）
    ext-len-pos = pos

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt58 = pos + 2
        pos-opt58: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 1: supported_versions (43)
    put-u16(hs, pos, TLS-EXT-SUPPORTED-VERSIONS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt59 = pos + 2
        pos-opt59: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 3
    put-u16(hs, pos, 3)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt60 = pos + 2
        pos-opt60: {
            ok -> pos = it
            ->
        }
    }

    ; versions list length = 2

    hs[pos]: {
        ok -> it = 2

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt61 = pos + 1
        pos-opt61: {
            ok -> pos = it
            ->
        }
    }

    ; TLS 1.3 = 0x0304
    put-u16(hs, pos, TLS-VERSION-1-3)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt62 = pos + 2
        pos-opt62: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 2: supported_groups (10) — x25519 + secp256r1（ECDSA 套件資格所需；key_share 仍僅 x25519）
    put-u16(hs, pos, TLS-EXT-SUPPORTED-GROUPS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt63 = pos + 2
        pos-opt63: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 6（列表長度 2 + 曲線 2×2）
    put-u16(hs, pos, 6)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt64 = pos + 2
        pos-opt64: {
            ok -> pos = it
            ->
        }
    }

    ; groups list length = 4
    put-u16(hs, pos, 4)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt65 = pos + 2
        pos-opt65: {
            ok -> pos = it
            ->
        }
    }

    ; x25519 = 0x001D
    put-u16(hs, pos, TLS-GROUP-X25519)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt66 = pos + 2
        pos-opt66: {
            ok -> pos = it
            ->
        }
    }

    ; secp256r1 = 0x0017
    put-u16(hs, pos, TLS-GROUP-SECP256R1)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt67 = pos + 2
        pos-opt67: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展: ec_point_formats (11) — TLS 1.2 ECDHE fallback 需要
    put-u16(hs, pos, TLS-EXT-EC-POINT-FORMATS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt68 = pos + 2
        pos-opt68: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 2（列表長度 1 + 格式 1）
    put-u16(hs, pos, 2)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt69 = pos + 2
        pos-opt69: {
            ok -> pos = it
            ->
        }
    }

    ; formats list length = 1

    hs[pos]: {
        ok -> it = 1

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt70 = pos + 1
        pos-opt70: {
            ok -> pos = it
            ->
        }
    }

    ; format 0 = uncompressed

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt71 = pos + 1
        pos-opt71: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 3: signature_algorithms (13)
    put-u16(hs, pos, TLS-EXT-SIGNATURE-ALGORITHMS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt72 = pos + 2
        pos-opt72: {
            ok -> pos = it
            ->
        }
    }

    ; 9 個演算法 = 18 bytes; ext data length = 2 (list len) + 18 = 20
    put-u16(hs, pos, 20)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt73 = pos + 2
        pos-opt73: {
            ok -> pos = it
            ->
        }
    }

    ; sig algs list length = 18
    put-u16(hs, pos, 18)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt74 = pos + 2
        pos-opt74: {
            ok -> pos = it
            ->
        }
    }

    ; 依優先順序：RSA-PSS（現代首選）> ECDSA > RSA-PKCS1
    put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt75 = pos + 2
        pos-opt75: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-ECDSA-SECP256R1-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt76 = pos + 2
        pos-opt76: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA384)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt77 = pos + 2
        pos-opt77: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-ECDSA-SECP384R1-SHA384)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt78 = pos + 2
        pos-opt78: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PSS-RSAE-SHA512)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt79 = pos + 2
        pos-opt79: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-ECDSA-SECP521R1-SHA512)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt80 = pos + 2
        pos-opt80: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt81 = pos + 2
        pos-opt81: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA384)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt82 = pos + 2
        pos-opt82: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-SIG-RSA-PKCS1-SHA512)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt83 = pos + 2
        pos-opt83: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 4: key_share (51)
    put-u16(hs, pos, TLS-EXT-KEY-SHARE)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt84 = pos + 2
        pos-opt84: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 2 (client_shares_len) + 2 (group) + 2 (key_len) + 32 (key) = 38
    put-u16(hs, pos, 38)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt85 = pos + 2
        pos-opt85: {
            ok -> pos = it
            ->
        }
    }

    ; client key shares length = 2 (group) + 2 (key_len) + 32 (key) = 36
    put-u16(hs, pos, 36)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt86 = pos + 2
        pos-opt86: {
            ok -> pos = it
            ->
        }
    }

    ; group = x25519
    put-u16(hs, pos, TLS-GROUP-X25519)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt87 = pos + 2
        pos-opt87: {
            ok -> pos = it
            ->
        }
    }

    ; key = 32 bytes
    put-u16(hs, pos, 32)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt88 = pos + 2
        pos-opt88: {
            ok -> pos = it
            ->
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = .client-pub[i]

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt89 = pos + 32
        pos-opt89: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 5: server_name (SNI, 0) — 必須包含，否則伺服器可能拒絕
    put-u16(hs, pos, 0)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt90 = pos + 2
        pos-opt90: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 2 + 1 + 2 + host.len

    #{overflow=wrap}
    sni-ext-len = 5 + .host.len-bytes()
    put-u16(hs, pos, sni-ext-len)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt91 = pos + 2
        pos-opt91: {
            ok -> pos = it
            ->
        }
    }

    ; server name list length = 1 + 2 + host.len

    #{overflow=wrap}
    sni-list-len = 3 + .host.len-bytes()
    put-u16(hs, pos, sni-list-len)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt92 = pos + 2
        pos-opt92: {
            ok -> pos = it
            ->
        }
    }

    ; name type = 0 (host_name)

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt93 = pos + 1
        pos-opt93: {
            ok -> pos = it
            ->
        }
    }

    ; name length
    put-u16(hs, pos, .host.len-bytes())

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt94 = pos + 2
        pos-opt94: {
            ok -> pos = it
            ->
        }
    }

    ; name
    i <- [0..self.host.len-bytes()): {

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = .host.byte(i)

            -> _
        }
    }

    #{overflow=wrap}
    pos = pos + .host.len-bytes()

    ; 填入擴展總長度

    #{overflow=wrap}
    ext-total = pos - ext-len-pos - 2: {
        ok -> it

        -> 0
    }
    put-u16(hs, ext-len-pos, ext-total)

    ; 填入 handshake message length

    #{overflow=wrap}
    body-len = pos - 4: {
        ok -> it

        -> 0
    }
    put-u24(hs, 1, body-len)

    ; 設定實際長度
    hs.truncate(pos)

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; DBG dump ClientHello bytes
    dmp = ''
    i <- [0..pos): {
        ixout3246c29 = hs[i]: {
            ok -> it

            -> _
        }

        dmp = dmp - ' ' - ixout3246c29.to-str()
    }

    ; 發送
    send-raw(.fd, TLS-CT-HANDSHAKE, hs)
    ok = true
}

; 讀取 ServerHello 並偵測 TLS 版本
; 返回 ok bool: true=TLS 1.3, false=TLS 1.2 或失敗
; [read-server-hello-13](#tls.conn.read-server-hello-13)
conn.read-server-hello-13 = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> {
        ct == 21 -> {

            ; alert message: buf[5] = level, buf[6] = description
        }
        return
    }
    .append-hs-from(buf, 5, rlen)

    ; 解析 handshake message（buf[5] = type, buf[6..8] = length, buf[9+] = data）

    msg-type = buf[5]
    msg-type != TLS-HS-SERVER-HELLO -> return
    pos = 9

    ; server version（TLS 1.3 中為 0x0303，實際版本在擴展中）

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt95 = pos + 2
        pos-opt95: {
            ok -> pos = it
            ->
        }
    }

    ; random (32 bytes)
    i <- [0..32): {

        #{overflow=wrap}
        ixout2976c29 = buf[pos + i]: {
            ok -> it

            -> _
        }

        {
            .server-random[i] ?= ixout2976c29
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt96 = pos + 32
        pos-opt96: {
            ok -> pos = it
            ->
        }
    }

    ; session_id

    sid-len = buf[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt97 = pos + 1 + sid-len
        pos-opt97: {
            ok -> pos = it
            ->
        }
    }

    ; cipher_suite
    cipher = get-u16(buf, pos)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt98 = pos + 2
        pos-opt98: {
            ok -> pos = it
            ->
        }
    }

    ; compression_method

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt99 = pos + 1
        pos-opt99: {
            ok -> pos = it
            ->
        }
    }

    ; 檢查是否有擴展

    #{overflow=wrap}
    pos + 2 > rlen + 5 -> {

        ; 無擴展，TLS 1.2
        .version = TLS-VERSION
        .cipher-id = cipher
        return
    }
    ext-len = get-u16(buf, pos)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt100 = pos + 2
        pos-opt100: {
            ok -> pos = it
            ->
        }
    }

    #{overflow=wrap}
    ext-end = pos + ext-len

    ; 掃描擴展尋找 supported_versions 和 key_share
    is-tls13 = false
    (pos < ext-end) {
        ext-type i64 = get-u16(buf, pos)

        #{overflow=wrap}
        {
            #{overflow=wrap}
            pos-opt101 = pos + 2
            pos-opt101: {
                ok -> pos = it
                ->
            }
        }
        ext-data-len i64 = get-u16(buf, pos)

        #{overflow=wrap}
        {
            #{overflow=wrap}
            pos-opt102 = pos + 2
            pos-opt102: {
                ok -> pos = it
                ->
            }
        }

        #{overflow=wrap}
        {
            ext-type == TLS-EXT-SUPPORTED-VERSIONS -> {
                ext-data-len == 2 -> {

                    ; supported_versions (server): 2 bytes selected_version
                    ; supported_versions (client): 1 byte list length + list
                    ; 伺服器版本只有 2 bytes
                    sv = get-u16(buf, pos)
                    sv == TLS-VERSION-1-3 -> is-tls13 = true
                }
            }

            ext-type == TLS-EXT-KEY-SHARE -> {

                ; key_share: 2 bytes group + 2 bytes key length + key
                ks-group = get-u16(buf, pos)
                ks-len i64 = get-u16(buf, pos + 2)
                ks-group == TLS-GROUP-X25519 && ks-len == 32 -> {
                    i <- [0..32): {

                        #{overflow=wrap}
                        ixout3056c42 = buf[pos + 4 + i]: {
                            ok -> it

                            -> _
                        }

                        {
                            .server-pub[i] ?= ixout3056c42
                        }: {
                            err -> _

                            -> _
                        }
                    }
                }
            }
        }

        #{overflow=wrap}
        {
            #{overflow=wrap}
            pos-opt103 = pos + ext-data-len
            pos-opt103: {
                ok -> pos = it
                ->
            }
        }
    }
    {
        is-tls13 -> {
            .version = TLS-VERSION-1-3
            ok = true
        }

        -> {
            .version = TLS-VERSION
            .cipher-id = cipher
        }
    }
}

; 計算 ECDHE 共享金鑰
; [compute-shared-secret-13](#tls.conn.compute-shared-secret-13)
conn.compute-shared-secret-13 = () {

    ; 透過 []byte 傳遞給 x25519（避開 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    pub-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i]: {
            ok -> it = .client-priv[i]

            -> _
        }

        pub-slice[i]: {
            ok -> it = .server-pub[i]

            -> _
        }
    }
    shared-slice = x25519.x25519-scalarmult-bytes(priv-slice, pub-slice)
    i <- [0..32): {

        ixout3102c29 = shared-slice[i]: {
            ok -> it

            -> _
        }

        {
            .shared-secret[i] ?= ixout3102c29
        }: {
            err -> _

            -> _
        }
    }
}

; derive-traffic-keys-13: 推導交握金鑰和應用金鑰
; 使用 HKDF 金鑰排程（RFC 8446 §7.1）
; [derive-handshake-keys-13](#tls.conn.derive-handshake-keys-13)
conn.derive-handshake-keys-13 = () {

    ; 1. Early Secret = HKDF-Extract(0, 0^HashLen)
    ;    salt=0 表示使用 HashLen 個零（hkdf-extract 內部處理空 salt）
    ;    ikm=PSK，無 PSK 時為 32 個零位元組（不是空 slice！）
    zero-32 []byte = with-len(32)
    e1 <- zero-32: {
        e1: {
            ok -> it = 0

            -> _
        }
    }
    empty-ctx []byte = with-len(0)
    early-prk [32]byte
    early-prk = hkdf.hkdf-extract(zero-32, zero-32)

    ; 2. Empty hash = SHA-256("")
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i]: {
            ok -> it = empty-hash-arr[i]

            -> _
        }
    }

    ; 3. derived = HKDF-Expand-Label(Early, "derived", empty_hash, 32)
    derived-early []byte

    derived-early = hkdf.hkdf-expand-label-vec(early-prk[..], 'derived', empty-hash, 32)

    ; 4. Handshake Secret = HKDF-Extract(derived, ECDHE_shared_secret)
    hs-prk [32]byte

    hs-prk = hkdf.hkdf-extract(derived-early, .shared-secret[..])

    ; 儲存 Handshake Secret 供 derive-application-keys-13 使用
    i <- [0..32): {
        {
            .hs-prk-field[i] ?= hs-prk[i]
        }: {
            err -> _

            -> _
        }
    }

    ; 5. 計算 transcript hash = SHA-256(ClientHello + ServerHello)
    ; .hs-buf 目前包含 ClientHello 和 ServerHello
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; 6. client_handshake_traffic_secret = Derive-Secret(HS, "c hs traffic", transcript)
    c-hs-secret []byte

    c-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 'c hs traffic', hs-hash, 32)

    ; 儲存 client handshake traffic secret 供 send-finished-13 使用
    i <- [0..32): {

        ixout3166c27 = c-hs-secret[i]: {
            ok -> it

            -> _
        }

        {
            .hs-c-secret[i] ?= ixout3166c27
        }: {
            err -> _

            -> _
        }
    }

    ; 7. server_handshake_traffic_secret = Derive-Secret(HS, "s hs traffic", transcript)
    s-hs-secret []byte

    s-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 's hs traffic', hs-hash, 32)

    ; 8. 推導金鑰和 IV
    ; client handshake key = HKDF-Expand-Label(c_hs_secret, "key", "", 16)
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout3181c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-client-key[i] ?= ixout3181c29
        }: {
            err -> _

            -> _
        }
    }

    ; client handshake IV = HKDF-Expand-Label(c_hs_secret, "iv", "", 12)
    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout3190c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-client-iv[i] ?= ixout3190c28
        }: {
            err -> _

            -> _
        }
    }

    ; server handshake key
    key-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout3198c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-server-key[i] ?= ixout3198c29
        }: {
            err -> _

            -> _
        }
    }

    ; server handshake IV
    iv-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout3206c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-server-iv[i] ?= ixout3206c28
        }: {
            err -> _

            -> _
        }
    }

    ; 儲存 handshake secret 供後續推導應用金鑰
    ; 保存到 shared-secret 的空間（重用）
    i <- [0..32): {
        {
            .shared-secret[i] ?= hs-prk[i]
        }: {
            err -> _

            -> _
        }
    }
    .hs-write-seq = 0
    .hs-read-seq = 0
}

; 推導應用層金鑰
; [derive-application-keys-13](#tls.conn.derive-application-keys-13)
conn.derive-application-keys-13 = () {

    ; 從 handshake secret 推導
    hs-prk []byte = with-len(32)
    i <- [0..32): {
        hs-prk[i]: {
            ok -> it = .hs-prk-field[i]

            -> _
        }
    }

    ; derived = HKDF-Expand-Label(HS, "derived", empty_hash, 32)
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i]: {
            ok -> it = empty-hash-arr[i]

            -> _
        }
    }
    derived-hs []byte
    derived-hs = hkdf.hkdf-expand-label-vec(hs-prk, 'derived', empty-hash, 32)

    ; Master Secret = HKDF-Extract(derived, 0^HashLen)
    zero-32 []byte = with-len(32)
    e2 <- zero-32: {
        e2: {
            ok -> it = 0

            -> _
        }
    }
    empty-ctx []byte = with-len(0)
    ms-prk [32]byte
    ms-prk = hkdf.hkdf-extract(derived-hs, zero-32)

    ; transcript hash = SHA-256(ClientHello..server Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; client_application_traffic_secret
    c-ap-secret []byte

    c-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 'c ap traffic', hs-hash, 32)

    ; server_application_traffic_secret
    s-ap-secret []byte

    s-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 's ap traffic', hs-hash, 32)

    ; 推導金鑰和 IV
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout3278c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-client-key[i] ?= ixout3278c29
        }: {
            err -> _

            -> _
        }
    }
    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout3285c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-client-iv[i] ?= ixout3285c28
        }: {
            err -> _

            -> _
        }
    }
    key-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout3291c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-server-key[i] ?= ixout3291c29
        }: {
            err -> _

            -> _
        }
    }
    iv-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout3297c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-server-iv[i] ?= ixout3297c28
        }: {
            err -> _

            -> _
        }
    }
    .ap-write-seq = 0
    .ap-read-seq = 0
}

; 構建 AEAD nonce
; iv [12]byte: 由寫入金鑰派生的 AEAD IV
; seq i64: 記錄序號（右對齊 8 位元組後 XOR 進 IV 尾段）
; nonce [12]byte: 本筆記錄的 AEAD nonce
; [build-nonce](#tls.build-nonce)
build-nonce = (iv [12]byte, seq i64) (nonce [12]byte) {
    i <- [0..12): {
        nonce[i] = iv[i]
    }

    ; XOR sequence number (right-aligned 8 bytes) with last 8 bytes of IV
    i <- [0..8): {

        #{overflow=wrap}
        nonce[4 + i] = nonce[4 + i] ^ ((seq >> ((7 - i) * 8)) & 255)
    }
}

; TLS 1.3 AEAD 加密記錄並發送
; ct i64: 原始 content type
; data []byte: 明文資料
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 這筆記錄的序號（每次發送後遞增，參與 nonce 派生）
; 返回 ok bool: true=成功
; [encrypt-record-13](#tls.conn.encrypt-record-13)
conn.encrypt-record-13 = (ct i64, data []byte, key [16]byte, iv [12]byte, seq i64) (ok bool) {
    ok = false
    n = data.len()

    ; 明文 = data + content_type(1 byte)

    #{overflow=wrap}
    plain []byte = with-len(n + 1)
    i <- [0..n): {

        ixout3341c24 = data[i]: {
            ok -> it

            -> _
        }

        plain[i]: {
            ok -> it = ixout3341c24

            -> _
        }
    }

    plain[n]: {
        ok -> it = ct & 255

        -> _
    }

    #{overflow=wrap}
    plain-len = n + 1
    plain.truncate(plain-len)

    ; 構建 nonce
    nonce [12]byte
    nonce = build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes): type(23) + version(0x0303) + length
    aad []byte = with-len(5)

    aad[0]: {
        ok -> it = TLS-CT-APP-DATA & 255

        -> _
    }
    put-u16(aad, 1, TLS-VERSION)

    ; 密文長度 = plain_len + 16 (tag)

    #{overflow=wrap}
    put-u16(aad, 3, plain-len + 16)
    aad.truncate(5)

    ; AES-128-GCM 加密
    sealed []byte
    sealed = aes-gcm.seal-128(key, nonce, aad, plain)

    ; 構建完整記錄: header(5) + sealed

    #{overflow=wrap}
    rec-len = plain-len + 16

    #{overflow=wrap}
    rec []byte = with-len(5 + rec-len)

    rec[0]: {
        ok -> it = TLS-CT-APP-DATA & 255

        -> _
    }
    put-u16(rec, 1, TLS-VERSION)
    put-u16(rec, 3, rec-len)
    i <- [0..rec-len): {

        ixout3400c24 = sealed[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        rec[5 + i]: {
            ok -> it = ixout3400c24

            -> _
        }
    }

    #{overflow=wrap}
    rec.truncate(5 + rec-len)

    ; 發送

    #{overflow=wrap}
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return
    ok = true
}

; TLS 1.3 AEAD 解密記錄
; rec []byte: 接收到的記錄（含標頭）
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 這筆記錄的期望序號（參與 nonce 派生，錯序會令 AEAD 驗證失敗）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文（不含 content type byte）
; [decrypt-record-13](#tls.conn.decrypt-record-13)
conn.decrypt-record-13 = (rec []byte, key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1
    rlen = get-u16(rec, 3)
    rlen < 16 -> return

    ; 提取密文+tag
    sealed []byte = with-len(rlen)
    i <- [0..rlen): {

        #{overflow=wrap}
        ixout3436c24 = rec[5 + i]: {
            ok -> it

            -> _
        }

        sealed[i]: {
            ok -> it = ixout3436c24

            -> _
        }
    }

    ; 構建 nonce
    nonce [12]byte
    nonce = build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes)
    aad []byte = with-len(5)

    ixout3451c20 = rec[0]: {
        ok -> it

        -> _
    }

    aad[0]: {
        ok -> it = ixout3451c20

        -> _
    }

    ixout3458c20 = rec[1]: {
        ok -> it

        -> _
    }

    aad[1]: {
        ok -> it = ixout3458c20

        -> _
    }

    ixout3465c20 = rec[2]: {
        ok -> it

        -> _
    }

    aad[2]: {
        ok -> it = ixout3465c20

        -> _
    }

    ixout3472c20 = rec[3]: {
        ok -> it

        -> _
    }

    aad[3]: {
        ok -> it = ixout3472c20

        -> _
    }

    ixout3479c20 = rec[4]: {
        ok -> it

        -> _
    }

    aad[4]: {
        ok -> it = ixout3479c20

        -> _
    }

    ; 解密
    plain []byte
    plain = aes-gcm.open-128(key, nonce, aad, sealed)
    plain.len() == 0 -> return

    ; 最後一個位元組是原始 content type
    plain-len = plain.len()

    #{overflow=wrap}
    ct = plain[plain-len - 1]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        plain-len-opt = plain-len - 1
        plain-len-opt: {
            ok -> plain-len = it
            ->
        }
    }
    out = with-len(plain-len)
    i <- [0..plain-len): {

        ixout3505c18 = plain[i]: {
            ok -> it

            -> _
        }

        out[i] = ixout3505c18
    }
}

; 讀取並解密一筆 TLS 1.3 記錄
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 序號（讀取後自動遞增）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
; [read-encrypted-record-13](#tls.conn.read-encrypted-record-13)
conn.read-encrypted-record-13 = (key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1

    ; 讀取記錄（跳過 TLS 1.3 middlebox compatibility 的 CCS 記錄）
    rec []byte = with-len(16640)
    r-ct = 0
    rlen = 0
    r-ct, rlen = read-record(.fd, rec)
    r-ct < 0 -> return

    ; CCS (content type 20) 是 TLS 1.3 middlebox compatibility 的 dummy 記錄，
    ; 不是加密資料，跳過後繼續讀取下一筆
    ; 注意：使用 break-if 模式避免在沒有 CCS 時多讀一筆記錄
    (r-ct == TLS-CT-CCS) {
        r-ct != TLS-CT-CCS -> break
        r-ct, rlen = read-record(.fd, rec)
        r-ct < 0 -> return
    }
    ct, out = .decrypt-record-13(rec, key, iv, seq)
}

; 讀取加密的交握訊息
; 支援單一記錄中含多個交握訊息的情況（使用 hs-plain-buf 緩衝剩餘資料）
; 返回 msg-type i64: 訊息類型（-1=錯誤）
; 返回 msg-data []byte: 訊息資料（不含標頭）
; [read-encrypted-handshake-13](#tls.conn.read-encrypted-handshake-13)
conn.read-encrypted-handshake-13 = () (msg-type i64, msg-data []byte) {
    msg-type = -1

    ; 若緩衝區中沒有足夠的資料，讀取新的加密記錄
    ; 一個 handshake 訊息標頭至少 4 bytes（1 byte type + 3 bytes length）
    #{overflow=wrap}
    .hs-plain-pos + 4 > .hs-plain-len -> {
        ct = 0
        plain []byte
        ct, plain = .read-encrypted-record-13(.hs-server-key, .hs-server-iv, .hs-read-seq)
        .hs-read-seq = .hs-read-seq + 1
        ct < 0 -> return

        ; 可能是 alert 或其他
        ct != TLS-CT-HANDSHAKE -> {
            ct == TLS-CT-ALERT -> plain-len = plain.len()
            return
        }

        ; 將整個 plain 存入緩衝區
        .hs-plain-buf = plain
        .hs-plain-len = plain.len()
        .hs-plain-pos = 0
    }

    ; 從緩衝區解析一個 handshake message
    ; 注意：plain 中最後 1 byte 是 inner content type，真正的 handshake 資料不含它
    ; 但 read-encrypted-record-13 已經移除了 inner content type，plain 就是純 handshake 資料
    pos = .hs-plain-pos

    msg-type = .hs-plain-buf[pos]

    #{overflow=wrap}
    msg-len = get-u24(.hs-plain-buf, pos + 1)

    ; 檢查是否有足夠的資料

    #{overflow=wrap}
    pos + 4 + msg-len > .hs-plain-len -> return
    msg-data = with-len(msg-len)
    i <- [0..msg-len): {

        #{overflow=wrap}
        msg-data[i] = .hs-plain-buf[pos + 4 + i]
    }
    msg-data.truncate(msg-len)

    ; 構建完整的 handshake message（含標頭）用於 transcript hash
    full-msg []byte

    #{overflow=wrap}
    full-msg = with-len(4 + msg-len)

    full-msg[0]: {
        ok -> it = msg-type

        -> _
    }

    full-msg[1]: {
        ok -> it = (msg-len >> 16) & 255

        -> _
    }

    full-msg[2]: {
        ok -> it = (msg-len >> 8) & 255

        -> _
    }

    full-msg[3]: {
        ok -> it = msg-len & 255

        -> _
    }
    i <- [0..msg-len): {

        #{overflow=wrap}
        full-msg[4 + i]: {
            ok -> it = msg-data[i]

            -> _
        }
    }

    #{overflow=wrap}
    full-msg.truncate(4 + msg-len)

    ; 追加到交握緩衝區（用於 transcript hash）
    .append-hs(full-msg)

    ; 更新緩衝區位置
    #{overflow=wrap}
    .hs-plain-pos = pos + 4 + msg-len
}

; TLS 1.3 完整交握
; 返回 ok bool: true=成功
; [connect-13](#tls.conn.connect-13)
conn.connect-13 = () (ok bool) {
    ok = false

    ; 1. 已在 connect() 中發送 ClientHello

    ; 2. 讀取 ServerHello（已在 connect() 中完成）

    ; 3. 計算 ECDHE 共享金鑰
    .compute-shared-secret-13()

    ; 4. 推導交握金鑰
    .derive-handshake-keys-13()

    ; 5. 讀取 EncryptedExtensions
    ee-type = 0
    ee-data []byte
    ee-type, ee-data = .read-encrypted-handshake-13()
    ee-type != TLS-HS-ENCRYPTED-EXTENSIONS -> return

    ; 6. 讀取 Certificate
    cert-type = 0
    cert-data []byte
    cert-type, cert-data = .read-encrypted-handshake-13()
    cert-type != TLS-HS-CERTIFICATE -> return

    ; 7. 讀取 CertificateVerify（跳過Verify（跳過驗證，僅讀取）
    cv-type = 0
    cv-data []byte
    cv-type, cv-data = .read-encrypted-handshake-13()
    cv-type != TLS-HS-CERTIFICATE-VERIFY -> {

        ; 某些伺服器可能不發送 CertificateVerify，嘗試當作 Finished
        cv-type == TLS-HS-FINISHED -> {

            ; 伺服器未發送 CertificateVerify，直接處理 Finished
            ; 推導應用金鑰（transcript 包含到此為止的所有訊息）
            .derive-application-keys-13()

            ; 發送客戶端 Finished
            ok = .send-finished-13()
            ok == false -> return
            .encrypted = true
            ok = true
            return
        }
        return
    }

    ; 8. 讀取 server Finished
    sf-type = 0
    sf-data []byte
    sf-type, sf-data = .read-encrypted-handshake-13()
    sf-type != TLS-HS-FINISHED -> return

    ; 9. 推導應用金鑰
    .derive-application-keys-13()

    ; 10. 發送客戶端 Finished（使用交握金鑰）
    ok = .send-finished-13()
    ok == false -> return
    .encrypted = true
    ok = true
}

; 發送 TLS 1.3 Finished 訊息
; 返回 ok bool: true=成功
; [send-finished-13](#tls.conn.send-finished-13)
conn.send-finished-13 = () (ok bool) {
    ok = false

    ; 計算 verify_data
    ; client_finished_key = HKDF-Expand-Label(client_handshake_traffic_secret, "finished", "", 32)
    ; BaseKey 是 client_handshake_traffic_secret，不是 handshake secret
    c-hs-secret []byte = with-len(32)
    i <- [0..32): {
        c-hs-secret[i]: {
            ok -> it = .hs-c-secret[i]

            -> _
        }
    }
    finished-key []byte
    zero-ctx []byte = with-len(0)
    finished-key = hkdf.hkdf-expand-label-vec(c-hs-secret, 'finished', zero-ctx, 32)

    ; transcript hash = SHA-256(ClientHello..server Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; verify_data = HMAC-SHA256(finished_key, transcript_hash)
    verify []byte
    verify = hmac.hmac-sha256-vec(finished-key, hs-hash)

    ; 構建 Finished 訊息
    hs []byte = with-len(36)

    hs[0]: {
        ok -> it = TLS-HS-FINISHED

        -> _
    }
    put-u24(hs, 1, 32)
    i <- [0..32): {

        ixout3748c24 = verify[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[4 + i]: {
            ok -> it = ixout3748c24

            -> _
        }
    }
    hs.truncate(36)

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 加密發送（使用交握金鑰）
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-client-key, .hs-client-iv, .hs-write-seq)

    #{overflow=wrap}
    .hs-write-seq = .hs-write-seq + 1
}

; 初始化連線（未連線狀態）
; [init](#tls.conn.init)
conn.init = () {
    .fd = -1
    .host = ''
    .connected = false
    .encrypted = false
    .version = 0
    .write-seq = 0
    .read-seq = 0
    .hs-buf-len = 0
    .hs-buf = with-cap(65536)
    .hs-write-seq = 0
    .hs-read-seq = 0
    .ap-write-seq = 0
    .ap-read-seq = 0

    ; 用時間戳 + PID 初始化 PRNG（fork 後父子進程會有不同 PID）
    .rand-state = time.now-ns() ^ os.get-pid()
    .rand-state == 0 -> .rand-state = 1
}

; 建立 TLS 連線（自動協商 1.3/1.2）
; host str: 伺服器主機名
; port i64: 埠號
; 返回 ok bool: true=成功
; [connect](#tls.conn.connect)
conn.connect = (host str, port i64) (ok bool) {
    ok = false
    .host = host

    ; 1. TCP 連線（使用 dns-dial 支援 hostname 解析）
    tcpfd = dns.dial(host, port)
    tcpfd < 0 -> return
    .fd = tcpfd
    .connected = true

    ; 2. 送出 TLS 1.3 ClientHello（同時支援 1.2 fallback）
    ok = .send-client-hello-13()
    ok == false -> {
        .close()
        return
    }

    ; 3. 讀取 ServerHello 並偵測版本
    ok = .read-server-hello-13()
    ok == false -> {

        ; TLS 1.3 協商失敗：伺服器可能 (a) 回傳致命 alert（如本環境不支援 1.3，
        ; 連線已失效），或 (b) 回傳 TLS 1.2 ServerHello。兩者都無法在同一条連線上
        ; 安全地接續 1.2 握手，故關閉當前連線並發起全新的 TLS 1.2 握手
        ; （connect-12 自帶 dial + 1.2 ClientHello + 完整握手流程）。
        .version = TLS-VERSION
        .close()
        ok = .connect-12(host, port)
        ok == false -> {
            return
        }
        ok = true
        return
    }

    ; TLS 1.3 路徑
    ok = .connect-13()
    ok == false -> {
        .close()
        return
    }
    ok = true
}

; TLS 1.2 完整交握（純 TLS 1.2，不發送 supported_versions 擴展）
; 返回 ok bool: true=成功
; host: 伺服器主機名或 IP
; port: TCP 埠號
; ok: true=TLS 1.2 交握完成
; [connect-12](#tls.conn.connect-12)
conn.connect-12 = (host str, port i64) (ok bool) {
    ok = false

    ; 重置交握緩衝區：當由 connect() 在 TLS 1.3 協商失敗後回退呼叫時，
    ; hs-buf 仍殘留 1.3 ClientHello，會汙染 1.2 的 Finished 交握雜湊，
    ; 導致伺服器以 decrypt_error 拒絕。此處強制清空，確保 1.2 握手雜湊從頭開始。
    .hs-buf-len = 0
    .host = host

    ; 1. TCP 連線
    tcpfd = dns.dial(host, port)
    tcpfd < 0 -> return
    .fd = tcpfd
    .connected = true

    ; 2. 送出 TLS 1.2 ClientHello
    ok = .send-client-hello()
    ok == false -> {
        .close()
        return
    }

    ; 3. 讀取 ServerHello
    ok = .read-server-hello()
    ok == false -> {
        .close()
        return
    }

    ; 4. 完成交握（依協商套件走 ECDHE / static-RSA 分支）
    ok = .handshake-12-body()
    ok == false -> {
        .close()
        return
    }
    ok = true
}

; TLS 1.2 連線（純 TLS 1.2，不協商 1.3）
; host str: 主機名或 IP
; port i64: 埠號
; 返回 conn ?conn: ok=連線, nil=失敗
; [dial-12](#tls.dial-12)
dial-12 = (host str, port i64) (conn ?conn) {
    conn = nil
    c = conn {}
    c.init()
    ok = c.connect-12(host, port)
    ok == false -> {
        c.close()
        return
    }
    conn = c
}

; 透過 TLS 發送資料
; data str: 待發送的明文
; written: 已寫入位元組數（nil=加密或發送失敗）
; [send](#tls.conn.send)
conn.send = (data str) (written ?i64) {
    written = nil
    .connected == false -> return
    .encrypted == false -> return
    data-bytes = data.to-bytes()
    {
        .version == TLS-VERSION-1-3 -> {

            ; TLS 1.3: 使用 AEAD
            ok = .encrypt-record-13(TLS-CT-APP-DATA, data-bytes, .ap-client-key, .ap-client-iv, .ap-write-seq)
            ok == false -> return

            #{overflow=wrap}
            .ap-write-seq = .ap-write-seq + 1
        }

        -> {

            ; TLS 1.2: 使用 CBC+MAC
            ok = .encrypt-record(TLS-CT-APP-DATA, data-bytes)
            ok == false -> return
        }
    }
    written = data.len-bytes()
}

; recv: 透過 TLS 接收資料
; buf str: 接收緩衝區
; n i64: 最大接收位元組數
; 返回 read-n i64: 已接收位元組數（-1=錯誤, 0=連線關閉）

; 診斷用 — 暴露底層 socket fd
; fd: 底層 socket 的檔案描述符（僅供診斷）
; [get-fd](#tls.conn.get-fd)
conn.get-fd = () (fd fd) {
    fd = .fd
}

; 接收並解密一筆資料，明文寫入 buf
; buf: 接收緩衝區（字串，容量須足夠容納 n 位元組）
; n: 最多接收的位元組數
; read-n: 實際接收位元組數（-1=錯誤）
conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    .connected == false -> return
    .encrypted == false -> return

    ; 宣告於函式作用域，確保分支內賦值能傳播
    plain []byte
    d-ct = -1
    {
        .version == TLS-VERSION-1-3 -> {

            ; TLS 1.3: 使用 AEAD
            ; 跳過 CCS（middlebox compatibility）及非 application_data 記錄
            ; （如 NewSessionTicket 等握手後記錄），只返回應用資料
            got-app-data = false
            (got-app-data == false) {
                rec []byte = with-len(16640)
                r-ct = 0
                rlen = 0
                r-ct, rlen = read-record(.fd, rec)
                {
                    r-ct < 0 -> return

                    ; alert：返回錯誤
                    r-ct == TLS-CT-ALERT -> return

                    r-ct == TLS-CT-APP-DATA -> {
                        d-ct, plain = .decrypt-record-13(rec, .ap-server-key, .ap-server-iv, .ap-read-seq)

                        #{overflow=wrap}
                        .ap-read-seq = .ap-read-seq + 1
                        {
                            d-ct < 0 -> return

                            d-ct == TLS-CT-APP-DATA -> got-app-data = true

                            -> {
                                ; 內層 handshake（NewSessionTicket 等）：跳過，繼續讀下一筆
                            }
                        }
                    }

                    -> {
                        ; 外層非 application_data（如 CCS）：不解密，跳過
                    }
                }
            }
        }

        -> {

            ; TLS 1.2: 使用 CBC+MAC
            rec []byte = with-len(16640)
            ct = 0
            rlen = 0
            ct, rlen = read-record(.fd, rec)
            ct < 0 -> return
            d-ct, plain = .decrypt-record(rec, TLS-CT-APP-DATA)
            d-ct < 0 -> return
        }
    }

    ; 複製到輸出緩衝區（在條件分支外賦值，避免作用域問題）
    copy-n = plain.len()
    copy-n > n -> copy-n = n
    i <- [0..copy-n): {

        ixout4012c24 = plain[i]: {
            ok -> it

            -> _
        }

        buf[i]: {
            ok -> it = ixout4012c24

            -> _
        }
    }
    read-n = copy-n
}

; 關閉 TLS 連線
; [close](#tls.conn.close)
conn.close = () {
    .connected -> {
        .fd >= 0 -> fs.close(.fd)
        .fd = -1
        .connected = false
        .encrypted = false
    }
}

; ═══════════════════════════════════════════════
; 高層 API
; ═══════════════════════════════════════════════

; 便捷函數，建立 TLS 連線
; host str: 伺服器主機名
; port i64: 埠號
; 返回 conn ?conn: 連線（nil=連線失敗）
; [dial](#tls.dial)
dial = (host str, port i64) (conn ?conn) {
    conn = nil
    c = conn {}
    c.init()
    ok = c.connect(host, port)
    ok == false -> {
        c.close()
        return
    }
    conn = c
}

; ═══════════════════════════════════════════════
; TLS 1.2 伺服器端
; ═══════════════════════════════════════════════

; server-conn: TLS 伺服器連線
; fd: 客戶端 socket fd
; rand-state: PRNG 狀態
; client-random / server-random: 交握隨機數
; client-mac-key / server-mac-key: MAC 金鑰（各 32 bytes）
; client-enc-key / server-enc-key: 加密金鑰（各 16 bytes）
; write-seq / read-seq: 記錄層序號
; hs-buf / hs-buf-len: 交握緩衝區（用於 Finished 驗證）
; encrypted: 是否已啟用加密
; master-secret: 主密鑰（48 bytes）
; cert: 預產生憑證 DER
; n-bytes / d-bytes: RSA 金鑰材料
; e-val: RSA 公鑰指數
; version: 協商的 TLS 版本
; is-tls13: 是否使用 TLS 1.3
; client-priv / server-priv / server-pub / client-pub: X25519 金鑰對
; shared-secret: ECDHE 共享金鑰（臨時儲存 handshake secret 供推導應用金鑰）
; hs-c-secret / hs-s-secret: 交握流量金鑰
; hs-{client,server}-{key,iv}: 交握層 AEAD 金鑰/IV
; ap-{client,server}-{key,iv}: 應用層 AEAD 金鑰/IV
; hs-{write,read}-seq / ap-{write,read}-seq: TLS 1.3 序號
; hs-plain-{buf,pos,len}: 交握明文緩衝區
server-conn {
    fd fd
    rand-state i64
    client-random [32]byte
    server-random [32]byte
    client-mac-key [32]byte
    server-mac-key [32]byte
    client-enc-key [16]byte
    server-enc-key [16]byte
    write-seq i64
    read-seq i64
    hs-buf []byte
    hs-buf-len i64
    encrypted bool
    master-secret []byte
    cert []byte
    n-bytes []byte
    d-bytes []byte
    e-val i64
    version i64
    is-tls13 bool
    client-priv [32]byte
    client-pub [32]byte
    server-priv [32]byte
    server-pub [32]byte
    shared-secret [32]byte
    hs-client-key [16]byte
    hs-client-iv [12]byte
    hs-server-key [16]byte
    hs-server-iv [12]byte
    ap-client-key [16]byte
    ap-client-iv [12]byte
    ap-server-key [16]byte
    ap-server-iv [12]byte
    hs-write-seq i64
    hs-read-seq i64
    ap-write-seq i64
    ap-read-seq i64
    hs-plain-buf []byte
    hs-plain-pos i64
    hs-plain-len i64
    hs-c-secret [32]byte
    hs-s-secret [32]byte
    hs-prk-field [32]byte
}

; 追加交握資料到緩衝區
; data []byte: 待追加到交握緩衝區的資料
; [append-hs](#tls.server-conn.append-hs)
server-conn.append-hs = (data []byte) {
    n = data.len()
    i <- [0..n): {

        ixout4132c36 = data[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs-wr-idx = .hs-buf-len + i
        {
            .hs-buf[hs-wr-idx] ?= ixout4132c36
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; 從 buf 的 offset 位置追加 n 位元組
; buf []byte: 來源緩衝區
; offset i64: 讀取起始偏移
; n i64: 要追加的位元組數
; [append-hs-from](#tls.server-conn.append-hs-from)
server-conn.append-hs-from = (buf []byte, offset i64, n i64) {
    i <- [0..n): {

        #{overflow=wrap}
        ixout4149c36 = buf[offset + i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs-wr-idx = .hs-buf-len + i
        {
            .hs-buf[hs-wr-idx] ?= ixout4149c36
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    .hs-buf-len = .hs-buf-len + n
    .hs-buf.len = .hs-buf-len
}

; 讀取 ClientHello
; 返回 ok bool: true=成功
; [read-client-hello](#tls.server-conn.read-client-hello)
server-conn.read-client-hello = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return

    ; 追加到交握緩衝區（跳過 5-byte record header）
    .append-hs-from(buf, 5, rlen)

    ; 解析 ClientHello: buf[5]=type, buf[6..8]=length, buf[9..10]=version, buf[11..42]=random

    msg-type = buf[5]
    msg-type != TLS-HS-CLIENT-HELLO -> return
    pos = 11; 跳過 type(1)+length(3)+version(2)

    ; client random (32 bytes)
    i <- [0..32): {

        #{overflow=wrap}
        ixout4181c29 = buf[pos + i]: {
            ok -> it

            -> _
        }

        {
            .client-random[i] ?= ixout4181c29
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt104 = pos + 32
        pos-opt104: {
            ok -> pos = it
            ->
        }
    }

    ; session_id

    sid-len = buf[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt105 = pos + 1 + sid-len
        pos-opt105: {
            ok -> pos = it
            ->
        }
    }

    ; cipher_suites
    cs-len = get-u16(buf, pos)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt106 = pos + 2
        pos-opt106: {
            ok -> pos = it
            ->
        }
    }

    ; 檢查是否包含 TLS 1.2 或 TLS 1.3 cipher suite
    found-12 = false
    found-13 = false
    j = 0
    (j < cs-len) {

        #{overflow=wrap}
        j < cs-len -> {

            #{overflow=wrap}
            cs-pos = pos + j: {
                ok -> it

                -> 0
            }
            cs = get-u16(buf, cs-pos)
            {
                cs == TLS-CIPHER-RSA-AES128-CBC-SHA256 -> found-12 = true

                cs == TLS-CIPHER-AES128-GCM-SHA256 -> found-13 = true
            }
            {
                j-opt = j + 2
                j-opt: {
                    ok -> j = it
                    ->
                }
            }
        }
    }
    found-12 == false && found-13 == false -> return

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt107 = pos + cs-len
        pos-opt107: {
            ok -> pos = it
            ->
        }
    }

    ; compression methods（跳過）

    comp-len = buf[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt108 = pos + 1 + comp-len
        pos-opt108: {
            ok -> pos = it
            ->
        }
    }

    ; 預設 TLS 1.2
    .is-tls13 = false
    .version = TLS-VERSION

    ; 解析擴展（尋找 supported_versions 和 key_share）
    #{overflow=wrap}
    pos + 2 <= rlen + 5 -> {
        ext-total = get-u16(buf, pos)
        {
            pos-opt109 = pos + 2
            pos-opt109: {
                ok -> pos = it
                ->
            }
        }
        ext-end = pos + ext-total: {
            ok -> it

            -> 0
        }
        (pos + 4 <= ext-end) {

            #{overflow=wrap}
            pos + 4 <= ext-end -> {
                edl-pos = pos + 2: {
                    ok -> it

                    -> 0
                }
                ext-data-len = get-u16(buf, edl-pos)
                {
                    pos-opt110 = pos + 4
                    pos-opt110: {
                        ok -> pos = it
                        ->
                    }
                }

                ; supported_versions (43)
                ext-type == TLS-EXT-SUPPORTED-VERSIONS -> {

                    ; client 端: 1 byte list length + versions

                    sv-list-len = buf[pos]: {
                        ok -> it

                        -> 0
                    }
                    sv-pos = pos + 1: {
                        ok -> it

                        -> 0
                    }
                    sv-end = sv-pos + sv-list-len: {
                        ok -> it

                        -> 0
                    }
                    (sv-pos + 2 <= sv-end) {

                        #{overflow=wrap}
                        sv-pos + 2 <= sv-end -> {
                            sv = get-u16(buf, sv-pos)
                            sv == TLS-VERSION-1-3 -> {
                                .is-tls13 = true
                                .version = TLS-VERSION-1-3
                            }
                            {
                                sv-pos-opt2 = sv-pos + 2
                                sv-pos-opt2: {
                                    ok -> sv-pos = it
                                    ->
                                }
                            }
                        }
                    }
                }

                ; key_share (51)
                ext-type == TLS-EXT-KEY-SHARE -> {
                    ks-list-len = get-u16(buf, pos)
                    ks-pos = pos + 2: {
                        ok -> it

                        -> 0
                    }
                    ks-end = ks-pos + ks-list-len: {
                        ok -> it

                        -> 0
                    }
                    (ks-pos + 4 <= ks-end) {

                        #{overflow=wrap}
                        ks-pos + 4 <= ks-end -> {
                            kkl-pos = ks-pos + 2: {
                                ok -> it

                                -> 0
                            }
                            ks-key-len = get-u16(buf, kkl-pos)
                            ks-group == TLS-GROUP-X25519 && ks-key-len == 32 -> {
                                i <- [0..32): {

                                    #{overflow=wrap}
                                    ixout4347c54 = buf[ks-pos + 4 + i]: {
                                        ok -> it

                                        -> _
                                    }

                                    {
                                        .client-pub[i] ?= ixout4347c54
                                    }: {
                                        err -> _

                                        -> _
                                    }
                                }
                            }
                            {
                                ks-pos-opt2 = ks-pos + 4 + ks-key-len
                                ks-pos-opt2: {
                                    ok -> ks-pos = it
                                    ->
                                }
                            }
                        }
                    }
                }
                {
                    pos-opt111 = pos + ext-data-len
                    pos-opt111: {
                        ok -> pos = it
                        ->
                    }
                }
            }
        }
    }

    ; TLS 1.3 需要有 key_share，如果沒拿到 client-pub 則回退 1.2
    .is-tls13 -> {
        has-key = false
        i <- [0..32): {
            {
                old ?= .client-pub[i]
                old != 0 -> {
                    has-key = true
                }
            }: {
                err -> _

                -> _
            }
        }
        has-key == false -> {
            .is-tls13 = false
            .version = TLS-VERSION
        }
    }
    ok = true
}

; 發送 ServerHello
; 返回 ok bool: true=成功
; [send-server-hello](#tls.server-conn.send-server-hello)
server-conn.send-server-hello = () (ok bool) {
    ok = false

    hs []byte = with-len(64)
    pos = 0

    ; msg_type = 2 (ServerHello)

    hs[0]: {
        ok -> it = TLS-HS-SERVER-HELLO

        -> _
    }
    pos = 4; 跳過 type(1)+length(3)

    ; version = 0x0303
    put-u16(hs, pos, TLS-VERSION)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt112 = pos + 2
        pos-opt112: {
            ok -> pos = it
            ->
        }
    }

    ; random (32 bytes)
    rand-bytes-val = rand-bytes(.rand-state, 32)

    #{overflow=wrap}
    .rand-state = .rand-state + 32
    i <- [0..32): {

        ixout4408c24 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = ixout4408c24

            -> _
        }

        ixout4414c29 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        {
            .server-random[i] ?= ixout4414c29
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt113 = pos + 32
        pos-opt113: {
            ok -> pos = it
            ->
        }
    }

    ; session_id_length = 0

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt114 = pos + 1
        pos-opt114: {
            ok -> pos = it
            ->
        }
    }

    ; cipher_suite = TLS_RSA_WITH_AES_128_CBC_SHA256
    put-u16(hs, pos, TLS-CIPHER-RSA-AES128-CBC-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt115 = pos + 2
        pos-opt115: {
            ok -> pos = it
            ->
        }
    }

    ; compression_method = 0

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt116 = pos + 1
        pos-opt116: {
            ok -> pos = it
            ->
        }
    }

    ; 填入 length

    #{overflow=wrap}
    body-len = pos - 4: {
        ok -> it

        -> 0
    }
    put-u24(hs, 1, body-len)
    hs.truncate(pos)
    .append-hs(hs)
    send-raw(.fd, TLS-CT-HANDSHAKE, hs)
    ok = true
}

; 發送 Certificate
; 返回 ok bool: true=成功
; [send-certificate](#tls.server-conn.send-certificate)
server-conn.send-certificate = () (ok bool) {
    ok = false

    cert-len = .cert.len()

    ; Certificate 訊息: type(1) + length(3) + total_certs_len(3) + cert_len(3) + cert

    #{overflow=wrap}
    hs-len = 4 + 3 + 3 + cert-len
    hs []byte = with-len(hs-len)

    hs[0]: {
        ok -> it = TLS-HS-CERTIFICATE

        -> _
    }

    #{overflow=wrap}
    body-len = 3 + 3 + cert-len
    put-u24(hs, 1, body-len)

    ; total certs length
    #{overflow=wrap}
    put-u24(hs, 4, 3 + cert-len)

    ; first cert length
    put-u24(hs, 7, cert-len)

    ; cert data
    i <- [0..cert-len): {

        #{overflow=wrap}
        hs[10 + i]: {
            ok -> it = .cert[i]

            -> _
        }
    }
    hs.truncate(hs-len)
    .append-hs(hs)
    send-raw(.fd, TLS-CT-HANDSHAKE, hs)
    ok = true
}

; 發送 ServerHelloDone
; 返回 ok bool: true=成功
; [send-server-hello-done](#tls.server-conn.send-server-hello-done)
server-conn.send-server-hello-done = () (ok bool) {
    ok = false
    hs []byte = with-len(4)

    hs[0]: {
        ok -> it = TLS-HS-SERVER-HELLO-DONE

        -> _
    }
    put-u24(hs, 1, 0)
    hs.truncate(4)
    .append-hs(hs)
    send-raw(.fd, TLS-CT-HANDSHAKE, hs)
    ok = true
}

; RSA PKCS#1 v1.5 解密
; ciphertext []byte: RSA 加密的資料
; n []byte: 模數（big-endian）
; d []byte: 私鑰指數（big-endian）
; 返回 out []byte: 解密後的明文（nil=失敗）
; [rsa-pkcs1-decrypt](#tls.rsa-pkcs1-decrypt)
rsa-pkcs1-decrypt = (ciphertext []byte, n []byte, d []byte) (out []byte) {
    mod-len = n.len()

    ; 轉換為大整數
    c-bn []i64
    c-bn = bytes-to-bn(ciphertext)
    d-bn []i64
    d-bn = bytes-to-bn(d)
    n-bn []i64
    n-bn = bytes-to-bn(n)

    ; RSA 解密: m = c^d mod n
    m-bn []i64
    m-bn-n = 0
    m-bn, m-bn-n = rsa.rsa-modpow(c-bn, c-bn.len(), d-bn, d-bn.len(), n-bn, n-bn.len())

    ; 轉換回位元組
    raw []byte
    raw = bn-to-bytes(m-bn)

    ; 左側補零至 mod-len
    m-bytes []byte

    #{overflow=wrap}
    {
        raw.len() == mod-len -> m-bytes = raw

        raw.len() < mod-len -> {
            m-bytes = with-len(mod-len)
            shift = mod-len - raw.len()
            i <- [0..shift): {
                m-bytes[i]: {
                    ok -> it = 0

                    -> _
                }
            }
            i <- [0..raw.len()): {

                ixout4578c32 = raw[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                m-bytes[shift + i]: {
                    ok -> it = ixout4578c32

                    -> _
                }
            }
        }

        raw.len() > mod-len -> {
            m-bytes = with-len(mod-len)
            off = raw.len() - mod-len
            i <- [0..mod-len): {

                #{overflow=wrap}
                ixout4592c32 = raw[off + i]: {
                    ok -> it

                    -> _
                }

                m-bytes[i]: {
                    ok -> it = ixout4592c32

                    -> _
                }
            }
        }
    }

    ; 驗證 PKCS#1 v1.5 填充: 0x00 0x02 PS 0x00 message
    ixout5080c12 = m-bytes[0]: {
        ok -> it

        -> _
    }

    ixout5080c12 != 0 -> {
        return
    }
    ixout5083c12 = m-bytes[1]: {
        ok -> it

        -> _
    }

    ixout5083c12 != 2 -> {
        return
    }

    ; 尋找 0x00 分隔符（從位置 2 開始）
    sep-pos = 2
    found-sep = false
    (sep-pos < mod-len && found-sep == false) {

        #{overflow=wrap}
        sep-pos < mod-len -> {
            ixout5094c20 = m-bytes[sep-pos]: {
                ok -> it

                -> _
            }

            ixout5094c20 == 0 -> {
                found-sep = true
            }
            found-sep == false -> {
                {
                    sep-pos-opt = sep-pos + 1
                    sep-pos-opt: {
                        ok -> sep-pos = it
                        ->
                    }
                }
            }
        }
    }
    found-sep == false -> return

    ; 提取明文
    #{overflow=wrap}
    msg-len = mod-len - sep-pos - 1
    msg-len < 1 -> return
    out = with-len(msg-len)
    i <- [0..msg-len): {

        #{overflow=wrap}
        ixout4631c18 = m-bytes[sep-pos + 1 + i]: {
            ok -> it

            -> _
        }

        out[i] = ixout4631c18
    }
    out.truncate(msg-len)
}

; 讀取 ClientKeyExchange 並解密 premaster
; 返回 ok bool: true=成功
; [read-client-key-exchange](#tls.server-conn.read-client-key-exchange)
server-conn.read-client-key-exchange = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return
    .append-hs-from(buf, 5, rlen)

    ; 解析 ClientKeyExchange
    msg-type = buf[5]
    msg-type != TLS-HS-CLIENT-KEY-EXCHANGE -> return

    ; encrypted premaster length (2 bytes)
    enc-len = get-u16(buf, 9)

    ; 提取加密的 premaster
    enc-premaster []byte = with-len(enc-len)
    i <- [0..enc-len): {

        #{overflow=wrap}
        ixout4661c24 = buf[11 + i]: {
            ok -> it

            -> _
        }

        enc-premaster[i]: {
            ok -> it = ixout4661c24

            -> _
        }
    }
    enc-premaster.truncate(enc-len)

    ; RSA 解密
    premaster []byte
    premaster = rsa-pkcs1-decrypt(enc-premaster, .n-bytes, .d-bytes)
    {
        premaster.len() == 0 -> return

        premaster.len() < 48 -> {

            ; premaster 應為 48 bytes，且前 2 bytes 為版本 0x0303
            return
        }
    }

    ; 確保 premaster 為 48 bytes
    fixed-premaster []byte = with-len(48)
    i <- [0..48): {

        ixout4687c24 = premaster[i]: {
            ok -> it

            -> _
        }

        fixed-premaster[i]: {
            ok -> it = ixout4687c24

            -> _
        }
    }
    fixed-premaster.truncate(48)

    ; 推導金鑰
    .derive-keys(fixed-premaster)
    ok = true
}

; 從 premaster 推導所有金鑰
; premaster []byte: premaster secret (48 bytes)
; [derive-keys](#tls.server-conn.derive-keys)
server-conn.derive-keys = (premaster []byte) {

    ; master_secret = PRF(premaster, "master secret", client_random + server_random, 48)
    seed []byte = with-len(64)
    i <- [0..32): {
        seed[i]: {
            ok -> it = .client-random[i]

            -> _
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        seed[32 + i]: {
            ok -> it = .server-random[i]

            -> _
        }
    }
    seed.truncate(64)
    .master-secret = prf(premaster, 'master secret', seed, 48)

    ; key_block = PRF(master, "key expansion", server_random + client_random, 96)
    ks []byte = with-len(64)
    i <- [0..32): {
        ks[i]: {
            ok -> it = .server-random[i]

            -> _
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        ks[32 + i]: {
            ok -> it = .client-random[i]

            -> _
        }
    }
    ks.truncate(64)
    key-block []byte
    key-block = prf(.master-secret, 'key expansion', ks, 96)

    ; 分割 key_block
    ; client_write_MAC_key (32)
    i <- [0..32): {

        ixout4752c30 = key-block[i]: {
            ok -> it

            -> _
        }

        {
            .client-mac-key[i] ?= ixout4752c30
        }: {
            err -> _

            -> _
        }
    }

    ; server_write_MAC_key (32)
    i <- [0..32): {

        #{overflow=wrap}
        ixout4759c30 = key-block[32 + i]: {
            ok -> it

            -> _
        }

        {
            .server-mac-key[i] ?= ixout4759c30
        }: {
            err -> _

            -> _
        }
    }

    ; client_write key (16)
    i <- [0..16): {

        #{overflow=wrap}
        ixout4766c30 = key-block[64 + i]: {
            ok -> it

            -> _
        }

        {
            .client-enc-key[i] ?= ixout4766c30
        }: {
            err -> _

            -> _
        }
    }

    ; server_write key (16)
    i <- [0..16): {

        #{overflow=wrap}
        ixout4773c30 = key-block[80 + i]: {
            ok -> it

            -> _
        }

        {
            .server-enc-key[i] ?= ixout4773c30
        }: {
            err -> _

            -> _
        }
    }

    ; 重置序號
    .write-seq = 0
    .read-seq = 0
}

; 加密記錄並發送（使用 SERVER 金鑰）
; ct i64: 原始 content type
; data []byte: 明文資料
; 返回 ok bool: true=成功
; [encrypt-record](#tls.server-conn.encrypt-record)
server-conn.encrypt-record = (ct i64, data []byte) (ok bool) {
    ok = false
    n = data.len()

    ; 1. 計算 MAC = HMAC-SHA256(server_mac_key, seq + type + version + length + content)
    #{overflow=wrap}
    mac-input []byte = with-len(13 + n)
    seq = .write-seq
    i <- [0..8): {

        #{overflow=wrap}
        mac-input[7 - i]: {
            ok -> it = (seq >> (i * 8)) & 255

            -> _
        }
    }

    mac-input[8]: {
        ok -> it = ct & 255

        -> _
    }
    put-u16(mac-input, 9, TLS-VERSION)
    put-u16(mac-input, 11, n)
    i <- [0..n): {

        ixout4815c24 = data[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[13 + i]: {
            ok -> it = ixout4815c24

            -> _
        }
    }
    mac [32]byte

    mac = hmac.hmac-sha256(.server-mac-key[..], mac-input)

    ; 2. 明文 + MAC

    #{overflow=wrap}
    plain []byte = with-len(n + 32)
    i <- [0..n): {

        ixout4832c24 = data[i]: {
            ok -> it

            -> _
        }

        plain[i]: {
            ok -> it = ixout4832c24

            -> _
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        plain[n + i]: {
            ok -> it = mac[i]

            -> _
        }
    }

    #{overflow=wrap}
    plain.truncate(n + 32)

    ; 3. TLS 填充（RFC 5246，非 PKCS#7）
    padded []byte
    padded = tls-pad(plain)

    ; 4. 生成隨機 IV
    iv [16]byte
    iv-bytes = rand-bytes(.rand-state, 16)

    #{overflow=wrap}
    .rand-state = .rand-state + 16
    i <- [0..16): {

        ixout4864c24 = iv-bytes[i]: {
            ok -> it

            -> _
        }

        iv[i]: {
            ok -> it = ixout4864c24

            -> _
        }
    }

    ; 5. AES-128-CBC 加密
    cipher []byte
    cipher = aes-cbc.enc-128(padded, .server-enc-key, iv)

    ; 6. 構建記錄: type(1) + version(2) + length(2) + IV(16) + cipher
    #{overflow=wrap}
    rec-len = 16 + padded.len()

    #{overflow=wrap}
    rec []byte = with-len(5 + rec-len)

    ; 記錄外層 type 必須與 MAC 所用的原始 type 一致（見 client 端說明）

    rec[0]: {
        ok -> it = ct & 255

        -> _
    }
    put-u16(rec, 1, TLS-VERSION)
    put-u16(rec, 3, rec-len)
    i <- [0..16): {

        #{overflow=wrap}
        rec[5 + i]: {
            ok -> it = iv[i]

            -> _
        }
    }
    i <- [0..padded.len()): {

        ixout4903c24 = cipher[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        rec[5 + 16 + i]: {
            ok -> it = ixout4903c24

            -> _
        }
    }

    #{overflow=wrap}
    rec.truncate(5 + rec-len)

    ; 7. 發送

    #{overflow=wrap}
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return

    #{overflow=wrap}
    .write-seq = .write-seq + 1
    ok = true
}

; 解密記錄（使用 CLIENT 金鑰）
; buf []byte: 接收到的記錄資料（從標頭開始）
; expected-ct i64: 原始 content type（TLS-CT-HANDSHAKE 或 TLS-CT-APP-DATA）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
; [decrypt-record](#tls.server-conn.decrypt-record)
server-conn.decrypt-record = (buf []byte, expected-ct i64) (ct i64, out []byte) {
    ct = -1
    rlen = get-u16(buf, 3)
    rlen < 16 -> return

    ; 提取 IV
    iv [16]byte
    i <- [0..16): {

        #{overflow=wrap}
        ixout4940c24 = buf[5 + i]: {
            ok -> it

            -> _
        }

        iv[i]: {
            ok -> it = ixout4940c24

            -> _
        }
    }

    ; 密文
    #{overflow=wrap}
    cipher-len = rlen - 16
    cipher []byte = with-len(cipher-len)
    i <- [0..cipher-len): {

        #{overflow=wrap}
        ixout4954c24 = buf[5 + 16 + i]: {
            ok -> it

            -> _
        }

        cipher[i]: {
            ok -> it = ixout4954c24

            -> _
        }
    }
    cipher.truncate(cipher-len)

    ; AES-128-CBC 解密
    plain []byte
    plain = aes-cbc.dec-128(cipher, .client-enc-key, iv)

    ; 移除 TLS 填充
    unpad-n = tls-unpad(plain)
    unpad-n < 0 -> return

    ; 明文 = data(0..unpad-n-32) + MAC(unpad-n-32..unpad-n)
    #{overflow=wrap}
    data-len = unpad-n - 32
    data-len < 0 -> return

    ; 驗證 MAC
    ; MAC = HMAC-SHA256(client_mac_key, seq + type + version + length + content)
    ; TLS 1.2 中加密記錄的 type 固定為 23，但 MAC 計算使用原始 type
    #{overflow=wrap}
    mac-input []byte = with-len(13 + data-len)
    seq = .read-seq
    i <- [0..8): {

        #{overflow=wrap}
        mac-input[7 - i]: {
            ok -> it = (seq >> (i * 8)) & 255

            -> _
        }
    }

    mac-input[8]: {
        ok -> it = expected-ct & 255

        -> _
    }
    put-u16(mac-input, 9, TLS-VERSION)
    put-u16(mac-input, 11, data-len)
    i <- [0..data-len): {

        ixout5001c24 = plain[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mac-input[13 + i]: {
            ok -> it = ixout5001c24

            -> _
        }
    }
    exp-mac [32]byte

    exp-mac = hmac.hmac-sha256(.client-mac-key[..], mac-input)

    ; 比較 MAC
    mac-ok = 1
    i <- [0..32): {

        #{overflow=wrap}
        b1 = plain[data-len + i]: {
            ok -> it

            -> 0
        }

        b2 = exp-mac[i]
        b1 != b2 -> mac-ok = 0
    }
    mac-ok == 0 -> return

    ; 提取明文資料
    out = with-len(data-len)
    i <- [0..data-len): {

        ixout5031c18 = plain[i]: {
            ok -> it

            -> _
        }

        out[i] = ixout5031c18
    }
    out.truncate(data-len)
    ct = expected-ct

    #{overflow=wrap}
    .read-seq = .read-seq + 1
}

; 發送 ChangeCipherSpec
; [send-change-cipher-spec](#tls.server-conn.send-change-cipher-spec)
server-conn.send-change-cipher-spec = () {
    ccs [1]byte

    ccs[0]: {
        ok -> it = 1

        -> _
    }
    hdr [5]byte

    hdr[0]: {
        ok -> it = TLS-CT-CCS & 255

        -> _
    }

    hdr[1]: {
        ok -> it = (TLS-VERSION >> 8) & 255

        -> _
    }

    hdr[2]: {
        ok -> it = TLS-VERSION & 255

        -> _
    }

    hdr[3]: {
        ok -> it = 0

        -> _
    }

    hdr[4]: {
        ok -> it = 1

        -> _
    }
    net.net-send(.fd, hdr, 5)
    net.net-send(.fd, ccs, 1)
}

; 讀取 ChangeCipherSpec
; 返回 ok bool: true=成功
; [read-change-cipher-spec](#tls.server-conn.read-change-cipher-spec)
server-conn.read-change-cipher-spec = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-CCS -> return
    rlen != 1 -> return
    ixout5660c9 = buf[5]: {
        ok -> it

        -> _
    }

    (ixout5660c9) != 1 -> {
        return
    }
    ok = true
}

; 讀取加密的 client Finished 並驗證
; 返回 ok bool: true=成功
; [read-finished](#tls.server-conn.read-finished)
server-conn.read-finished = () (ok bool) {
    ok = false
    buf []byte = with-len(16400)
    ct = 0
    rlen = 0
    ct, rlen = read-record(.fd, buf)
    ct != TLS-CT-HANDSHAKE -> return

    ; 解密
    plain []byte
    d-ct = 0
    d-ct, plain = .decrypt-record(buf, TLS-CT-HANDSHAKE)
    d-ct < 0 -> return

    ; 解析 Finished 訊息
    msg-type = plain[0]: {
        ok -> it

        -> 0
    }
    msg-type != TLS-HS-FINISHED -> return

    ; 驗證 verify_data（hash 不包含 client Finished）
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)
    verify []byte
    verify = prf(.master-secret, 'client finished', hs-hash, TLS-FINISHED-SIZE)
    i <- [0..TLS-FINISHED-SIZE): {

        #{overflow=wrap}
        b1 = plain[4 + i]: {
            ok -> it

            -> 0
        }

        b2 = verify[i]: {
            ok -> it

            -> 0
        }
        b1 != b2 -> return
    }

    ; 驗證成功後追加到交握緩衝區
    .append-hs(plain)
    ok = true
}

; 發送加密的 server Finished
; 返回 ok bool: true=成功
; [send-finished](#tls.server-conn.send-finished)
server-conn.send-finished = () (ok bool) {
    ok = false

    ; 計算 handshake hash（包含 client Finished）
    hs-hash-arr [32]byte
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; verify_data = PRF(master, "server finished", hash, 12)
    verify []byte
    verify = prf(.master-secret, 'server finished', hs-hash, TLS-FINISHED-SIZE)

    ; 構建 Finished 訊息
    #{overflow=wrap}
    hs []byte = with-len(4 + TLS-FINISHED-SIZE)

    hs[0]: {
        ok -> it = TLS-HS-FINISHED

        -> _
    }
    put-u24(hs, 1, TLS-FINISHED-SIZE)
    i <- [0..TLS-FINISHED-SIZE): {

        ixout5184c24 = verify[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[4 + i]: {
            ok -> it = ixout5184c24

            -> _
        }
    }

    #{overflow=wrap}
    hs.truncate(4 + TLS-FINISHED-SIZE)

    ; 追加到交握緩衝區（在加密之前）
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record(TLS-CT-HANDSHAKE, hs)
}

; ═══════════════════════════════════════════════
; TLS 1.3 伺服器端交握與記錄層
; ═══════════════════════════════════════════════

; 發送 TLS 1.3 ServerHello
; 生成 X25519 金鑰對，構建含 supported_versions 和 key_share 擴展的 ServerHello
; 返回 ok bool: true=成功
; [send-server-hello-13](#tls.server-conn.send-server-hello-13)
server-conn.send-server-hello-13 = () (ok bool) {
    ok = false

    ; 生成 X25519 金鑰對
    seed = .rand-state

    #{overflow=wrap}
    .rand-state = .rand-state + 1
    kp-state = seed
    i <- [0..32): {
        kp-state, kp-r = rand.rand(kp-state)

        {
            .server-priv[i] ?= kp-state & 255
        }: {
            err -> _

            -> _
        }
    }

    {
        old ?= .server-priv[0]
        .server-priv[0] ?= old & 248
    }: {
        err -> _

        -> _
    }

    {
        old ?= .server-priv[31]
        .server-priv[31] ?= old & 127
    }: {
        err -> _

        -> _
    }

    {
        old ?= .server-priv[31]
        .server-priv[31] ?= old | 64
    }: {
        err -> _

        -> _
    }

    ; 透過 []byte 傳遞給 x25519（避開全域 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i]: {
            ok -> it = .server-priv[i]

            -> _
        }
    }
    pub-slice = x25519.x25519-scalarmult-base-bytes(priv-slice)
    i <- [0..32): {

        ixout5242c26 = pub-slice[i]: {
            ok -> it

            -> _
        }

        {
            .server-pub[i] ?= ixout5242c26
        }: {
            err -> _

            -> _
        }
    }

    ; 構建 ServerHello
    hs []byte = with-len(128)
    pos = 0

    ; msg_type = 2 (ServerHello)
    hs[0]: {
        ok -> it = TLS-HS-SERVER-HELLO

        -> _
    }
    pos = 4

    ; version = 0x0303（legacy）
    put-u16(hs, pos, TLS-VERSION)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt117 = pos + 2
        pos-opt117: {
            ok -> pos = it
            ->
        }
    }

    ; random (32 bytes)
    rand-bytes-val = rand-bytes(.rand-state, 32)

    #{overflow=wrap}
    .rand-state = .rand-state + 32
    i <- [0..32): {

        ixout5272c24 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = ixout5272c24

            -> _
        }

        ixout5278c29 = rand-bytes-val[i]: {
            ok -> it

            -> _
        }

        {
            .server-random[i] ?= ixout5278c29
        }: {
            err -> _

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt118 = pos + 32
        pos-opt118: {
            ok -> pos = it
            ->
        }
    }

    ; session_id_length = 0

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt119 = pos + 1
        pos-opt119: {
            ok -> pos = it
            ->
        }
    }

    ; cipher_suite = TLS_AES_128_GCM_SHA256 (0x1301)
    put-u16(hs, pos, TLS-CIPHER-AES128-GCM-SHA256)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt120 = pos + 2
        pos-opt120: {
            ok -> pos = it
            ->
        }
    }

    ; compression_method = 0

    hs[pos]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt121 = pos + 1
        pos-opt121: {
            ok -> pos = it
            ->
        }
    }

    ; === 擴展 ===
    ext-len-pos = pos

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt122 = pos + 2
        pos-opt122: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 1: supported_versions (43)
    put-u16(hs, pos, TLS-EXT-SUPPORTED-VERSIONS)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt123 = pos + 2
        pos-opt123: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, 2)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt124 = pos + 2
        pos-opt124: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-VERSION-1-3)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt125 = pos + 2
        pos-opt125: {
            ok -> pos = it
            ->
        }
    }

    ; 擴展 2: key_share (51)
    put-u16(hs, pos, TLS-EXT-KEY-SHARE)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt126 = pos + 2
        pos-opt126: {
            ok -> pos = it
            ->
        }
    }

    ; ext data length = 2 (group) + 2 (key_len) + 32 (key) = 36
    put-u16(hs, pos, 36)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt127 = pos + 2
        pos-opt127: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, TLS-GROUP-X25519)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt128 = pos + 2
        pos-opt128: {
            ok -> pos = it
            ->
        }
    }
    put-u16(hs, pos, 32)

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt129 = pos + 2
        pos-opt129: {
            ok -> pos = it
            ->
        }
    }
    i <- [0..32): {

        #{overflow=wrap}
        hs[pos + i]: {
            ok -> it = .server-pub[i]

            -> _
        }
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        pos-opt130 = pos + 32
        pos-opt130: {
            ok -> pos = it
            ->
        }
    }

    ; 填入擴展總長度

    #{overflow=wrap}
    ext-total = pos - ext-len-pos - 2: {
        ok -> it

        -> 0
    }
    put-u16(hs, ext-len-pos, ext-total)

    ; 填入 handshake message length
    #{overflow=wrap}
    body-len = pos - 4: {
        ok -> it

        -> 0
    }
    put-u24(hs, 1, body-len)
    hs.truncate(pos)

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 發送（明文 handshake 記錄）
    send-raw(.fd, TLS-CT-HANDSHAKE, hs)
    ok = true
}

; 計算 ECDHE 共享金鑰
; [compute-shared-secret-13](#tls.server-conn.compute-shared-secret-13)
server-conn.compute-shared-secret-13 = () {

    ; 透過 []byte 傳遞給 x25519（避開全域 [32]byte 傳參的編譯器 bug）
    priv-slice []byte = with-len(32)
    pub-slice []byte = with-len(32)
    i <- [0..32): {
        priv-slice[i]: {
            ok -> it = .server-priv[i]

            -> _
        }

        pub-slice[i]: {
            ok -> it = .client-pub[i]

            -> _
        }
    }
    shared-slice = x25519.x25519-scalarmult-bytes(priv-slice, pub-slice)
    i <- [0..32): {

        ixout5420c29 = shared-slice[i]: {
            ok -> it

            -> _
        }

        {
            .shared-secret[i] ?= ixout5420c29
        }: {
            err -> _

            -> _
        }
    }
}

; 推導交握金鑰（HKDF 金鑰排程）
; [derive-handshake-keys-13](#tls.server-conn.derive-handshake-keys-13)
server-conn.derive-handshake-keys-13 = () {

    ; 1. Early Secret = HKDF-Extract(0, 0^32)
    zero-32 []byte = with-len(32)
    e3 <- zero-32: {
        e3: {
            ok -> it = 0

            -> _
        }
    }
    empty-ctx []byte = with-len(0)
    early-prk [32]byte
    early-prk = hkdf.hkdf-extract(zero-32, zero-32)

    ; 2. Empty hash = SHA-256("")
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i]: {
            ok -> it = empty-hash-arr[i]

            -> _
        }
    }

    ; 3. derived = HKDF-Expand-Label(Early, "derived", empty_hash, 32)
    derived-early []byte

    derived-early = hkdf.hkdf-expand-label-vec(early-prk[..], 'derived', empty-hash, 32)

    ; 4. Handshake Secret = HKDF-Extract(derived, ECDHE_shared_secret)
    hs-prk [32]byte

    hs-prk = hkdf.hkdf-extract(derived-early, .shared-secret[..])

    ; 儲存 Handshake Secret 供 derive-application-keys-13 使用
    i <- [0..32): {
        {
            .hs-prk-field[i] ?= hs-prk[i]
        }: {
            err -> _

            -> _
        }
    }

    ; 5. transcript hash = SHA-256(ClientHello + ServerHello)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; 6. client_handshake_traffic_secret
    c-hs-secret []byte

    c-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 'c hs traffic', hs-hash, 32)
    i <- [0..32): {

        ixout5478c27 = c-hs-secret[i]: {
            ok -> it

            -> _
        }

        {
            .hs-c-secret[i] ?= ixout5478c27
        }: {
            err -> _

            -> _
        }
    }

    ; 7. server_handshake_traffic_secret
    s-hs-secret []byte

    s-hs-secret = hkdf.hkdf-expand-label-vec(hs-prk[..], 's hs traffic', hs-hash, 32)
    i <- [0..32): {

        ixout5488c27 = s-hs-secret[i]: {
            ok -> it

            -> _
        }

        {
            .hs-s-secret[i] ?= ixout5488c27
        }: {
            err -> _

            -> _
        }
    }

    ; 8. 推導金鑰和 IV
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout5497c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-client-key[i] ?= ixout5497c29
        }: {
            err -> _

            -> _
        }
    }
    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout5504c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-client-iv[i] ?= ixout5504c28
        }: {
            err -> _

            -> _
        }
    }
    key-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout5510c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-server-key[i] ?= ixout5510c29
        }: {
            err -> _

            -> _
        }
    }
    iv-tmp = hkdf.hkdf-expand-label-vec(s-hs-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout5516c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .hs-server-iv[i] ?= ixout5516c28
        }: {
            err -> _

            -> _
        }
    }

    ; 儲存 handshake secret 供推導應用金鑰
    i <- [0..32): {
        {
            .shared-secret[i] ?= hs-prk[i]
        }: {
            err -> _

            -> _
        }
    }
    .hs-write-seq = 0
    .hs-read-seq = 0
}

; 推導應用層金鑰
; [derive-application-keys-13](#tls.server-conn.derive-application-keys-13)
server-conn.derive-application-keys-13 = () {
    hs-prk []byte = with-len(32)
    i <- [0..32): {
        hs-prk[i]: {
            ok -> it = .hs-prk-field[i]

            -> _
        }
    }

    ; derived = HKDF-Expand-Label(HS, "derived", empty_hash, 32)
    empty-hash-arr = sha256.sha256('')
    empty-hash []byte = with-len(32)
    i <- [0..32): {
        empty-hash[i]: {
            ok -> it = empty-hash-arr[i]

            -> _
        }
    }
    derived-hs []byte
    derived-hs = hkdf.hkdf-expand-label-vec(hs-prk, 'derived', empty-hash, 32)

    ; Master Secret = HKDF-Extract(derived, 0^32)
    zero-32 []byte = with-len(32)
    e4 <- zero-32: {
        e4: {
            ok -> it = 0

            -> _
        }
    }
    empty-ctx []byte = with-len(0)
    ms-prk [32]byte
    ms-prk = hkdf.hkdf-extract(derived-hs, zero-32)

    ; transcript hash = SHA-256(ClientHello..server Finished)
    ; 注意：必須排除 client Finished（read-client-finished-13 會 append CF 到 hs-buf）。
    ; client Finished = 4 位元組標頭 + 32 位元組 verify_data = 36 位元組。
    ; 使用減去 36 後的長度切片，確保只雜湊到 server Finished。

    #{overflow=wrap}
    pre-cf-len = .hs-buf-len - 36
    pre-cf-buf []byte = with-len(pre-cf-len)
    i <- [0..pre-cf-len): {
        pre-cf-buf[i]: {
            ok -> it = .hs-buf[i]

            -> _
        }
    }
    hs-hash-arr = sha256.sha256(pre-cf-buf)
    hs-hash = hs-hash-arr[..32)

    ; client_application_traffic_secret
    c-ap-secret []byte

    c-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 'c ap traffic', hs-hash, 32)

    ; server_application_traffic_secret
    s-ap-secret []byte

    s-ap-secret = hkdf.hkdf-expand-label-vec(ms-prk[..], 's ap traffic', hs-hash, 32)

    ; 推導金鑰和 IV
    key-tmp []byte
    key-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout5599c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-client-key[i] ?= ixout5599c29
        }: {
            err -> _

            -> _
        }
    }
    iv-tmp []byte
    iv-tmp = hkdf.hkdf-expand-label-vec(c-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout5606c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-client-iv[i] ?= ixout5606c28
        }: {
            err -> _

            -> _
        }
    }
    key-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'key', empty-ctx, TLS13-KEY-SIZE)
    i <- [0..16): {

        ixout5612c29 = key-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-server-key[i] ?= ixout5612c29
        }: {
            err -> _

            -> _
        }
    }
    iv-tmp = hkdf.hkdf-expand-label-vec(s-ap-secret, 'iv', empty-ctx, TLS13-IV-SIZE)
    i <- [0..12): {

        ixout5618c28 = iv-tmp[i]: {
            ok -> it

            -> _
        }

        {
            .ap-server-iv[i] ?= ixout5618c28
        }: {
            err -> _

            -> _
        }
    }
    .ap-write-seq = 0
    .ap-read-seq = 0
}

; TLS 1.3 AEAD 加密記錄並發送
; ct i64: 原始 content type
; data []byte: 明文資料
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 這筆記錄的序號（每次發送後遞增，參與 nonce 派生）
; 返回 ok bool: true=成功
; [encrypt-record-13](#tls.server-conn.encrypt-record-13)
server-conn.encrypt-record-13 = (ct i64, data []byte, key [16]byte, iv [12]byte, seq i64) (ok bool) {
    ok = false
    n = data.len()

    ; 明文 = data + content_type(1 byte)
    #{overflow=wrap}
    plain []byte = with-len(n + 1)
    i <- [0..n): {

        ixout5643c24 = data[i]: {
            ok -> it

            -> _
        }

        plain[i]: {
            ok -> it = ixout5643c24

            -> _
        }
    }

    plain[n]: {
        ok -> it = ct & 255

        -> _
    }

    #{overflow=wrap}
    plain-len = n + 1
    plain.truncate(plain-len)

    ; 構建 nonce
    nonce [12]byte
    nonce = build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes)
    aad []byte = with-len(5)

    aad[0]: {
        ok -> it = TLS-CT-APP-DATA & 255

        -> _
    }
    put-u16(aad, 1, TLS-VERSION)

    #{overflow=wrap}
    put-u16(aad, 3, plain-len + 16)
    aad.truncate(5)

    ; AES-128-GCM 加密
    sealed []byte
    sealed = aes-gcm.seal-128(key, nonce, aad, plain)

    ; 構建完整記錄: header(5) + sealed
    #{overflow=wrap}
    rec-len = plain-len + 16

    #{overflow=wrap}
    rec []byte = with-len(5 + rec-len)

    rec[0]: {
        ok -> it = TLS-CT-APP-DATA & 255

        -> _
    }
    put-u16(rec, 1, TLS-VERSION)
    put-u16(rec, 3, rec-len)
    i <- [0..rec-len): {

        ixout5699c24 = sealed[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        rec[5 + i]: {
            ok -> it = ixout5699c24

            -> _
        }
    }

    #{overflow=wrap}
    rec.truncate(5 + rec-len)

    ; 發送

    #{overflow=wrap}
    sent = net.net-send(.fd, rec, 5 + rec-len)
    sent < 0 -> return
    ok = true
}

; TLS 1.3 AEAD 解密記錄
; rec []byte: 接收到的記錄（含標頭）
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 這筆記錄的期望序號（參與 nonce 派生，錯序會令 AEAD 驗證失敗）
; 返回 ct i64: 原始 content type（-1=錯誤）
; 返回 out []byte: 解密後的明文
; [decrypt-record-13](#tls.server-conn.decrypt-record-13)
server-conn.decrypt-record-13 = (rec []byte, key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1
    rlen = get-u16(rec, 3)
    rlen < 16 -> return

    ; 提取密文+tag
    sealed []byte = with-len(rlen)
    i <- [0..rlen): {

        #{overflow=wrap}
        ixout5735c24 = rec[5 + i]: {
            ok -> it

            -> _
        }

        sealed[i]: {
            ok -> it = ixout5735c24

            -> _
        }
    }

    ; 構建 nonce
    nonce [12]byte
    nonce = build-nonce(iv, seq)

    ; 構建 AAD = record_header(5 bytes)
    aad []byte = with-len(5)

    ixout5750c20 = rec[0]: {
        ok -> it

        -> _
    }

    aad[0]: {
        ok -> it = ixout5750c20

        -> _
    }

    ixout5757c20 = rec[1]: {
        ok -> it

        -> _
    }

    aad[1]: {
        ok -> it = ixout5757c20

        -> _
    }

    ixout5764c20 = rec[2]: {
        ok -> it

        -> _
    }

    aad[2]: {
        ok -> it = ixout5764c20

        -> _
    }

    ixout5771c20 = rec[3]: {
        ok -> it

        -> _
    }

    aad[3]: {
        ok -> it = ixout5771c20

        -> _
    }

    ixout5778c20 = rec[4]: {
        ok -> it

        -> _
    }

    aad[4]: {
        ok -> it = ixout5778c20

        -> _
    }

    ; 解密
    plain []byte
    plain = aes-gcm.open-128(key, nonce, aad, sealed)
    plain.len() == 0 -> return

    ; 最後一個位元組是原始 content type
    plain-len = plain.len()

    #{overflow=wrap}
    ct = plain[plain-len - 1]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    {
        #{overflow=wrap}
        plain-len-opt2 = plain-len - 1
        plain-len-opt2: {
            ok -> plain-len = it
            ->
        }
    }
    out = with-len(plain-len)
    i <- [0..plain-len): {

        ixout5804c18 = plain[i]: {
            ok -> it

            -> _
        }

        out[i] = ixout5804c18
    }
}

; 讀取並解密一筆 TLS 1.3 記錄
; （跳過 CCS middlebox compatibility 記錄）
; key [16]byte: AEAD 金鑰
; iv [12]byte: AEAD IV
; seq i64: 記錄序號（呼叫方讀取後遞增）
; ct i64: 解密出的原始 content type（-1=錯誤）
; out []byte: 解密後的明文
; [read-encrypted-record-13](#tls.server-conn.read-encrypted-record-13)
server-conn.read-encrypted-record-13 = (key [16]byte, iv [12]byte, seq i64) (ct i64, out []byte) {
    ct = -1
    rec []byte = with-len(16400)
    r-ct = 0
    rlen = 0
    r-ct, rlen = read-record(.fd, rec)
    r-ct < 0 -> return

    ; CCS (content type 20) 為 middlebox compat，跳過後讀取下一筆
    (r-ct == TLS-CT-CCS) {
        r-ct != TLS-CT-CCS -> break
        r-ct, rlen = read-record(.fd, rec)
        r-ct < 0 -> return
    }
    ct, out = .decrypt-record-13(rec, key, iv, seq)
    ct < 0 -> return
}

; 讀取加密的交握訊息
; msg-type i64: 交握訊息類型（-1=錯誤）
; msg-data []byte: 訊息內容（不含標頭）
; [read-encrypted-handshake-13](#tls.server-conn.read-encrypted-handshake-13)
server-conn.read-encrypted-handshake-13 = () (msg-type i64, msg-data []byte) {
    msg-type = -1

    #{overflow=wrap}
    .hs-plain-pos + 4 > .hs-plain-len -> {
        ct = 0
        plain []byte
        ct, plain = .read-encrypted-record-13(.hs-client-key, .hs-client-iv, .hs-read-seq)
        .hs-read-seq = .hs-read-seq + 1
        ct < 0 -> return
        ct != TLS-CT-HANDSHAKE -> return
        .hs-plain-buf = plain
        .hs-plain-len = plain.len()
        .hs-plain-pos = 0
    }
    pos = .hs-plain-pos

    msg-type = .hs-plain-buf[pos]

    #{overflow=wrap}
    msg-len = get-u24(.hs-plain-buf, pos + 1)

    #{overflow=wrap}
    pos + 4 + msg-len > .hs-plain-len -> return
    msg-data = with-len(msg-len)
    i <- [0..msg-len): {

        #{overflow=wrap}
        msg-data[i] = .hs-plain-buf[pos + 4 + i]
    }
    msg-data.truncate(msg-len)
    full-msg []byte

    #{overflow=wrap}
    full-msg = with-len(4 + msg-len)

    full-msg[0]: {
        ok -> it = msg-type

        -> _
    }

    full-msg[1]: {
        ok -> it = (msg-len >> 16) & 255

        -> _
    }

    full-msg[2]: {
        ok -> it = (msg-len >> 8) & 255

        -> _
    }

    full-msg[3]: {
        ok -> it = msg-len & 255

        -> _
    }
    i <- [0..msg-len): {

        #{overflow=wrap}
        full-msg[4 + i]: {
            ok -> it = msg-data[i]

            -> _
        }
    }

    #{overflow=wrap}
    full-msg.truncate(4 + msg-len)
    .append-hs(full-msg)

    #{overflow=wrap}
    .hs-plain-pos = pos + 4 + msg-len
}

; 發送 EncryptedExtensions
; 返回 ok bool: true=成功
; [send-encrypted-extensions-13](#tls.server-conn.send-encrypted-extensions-13)
server-conn.send-encrypted-extensions-13 = () (ok bool) {
    ok = false

    ; EncryptedExtensions: type(1) + length(3) + extensions_list_length(2) = 6 bytes
    hs []byte = with-len(6)

    hs[0]: {
        ok -> it = TLS-HS-ENCRYPTED-EXTENSIONS

        -> _
    }
    put-u24(hs, 1, 2)
    put-u16(hs, 4, 0)
    hs.truncate(6)

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 加密發送（使用交握金鑰）
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-server-key, .hs-server-iv, .hs-write-seq)

    #{overflow=wrap}
    .hs-write-seq = .hs-write-seq + 1
}

; 發送 TLS 1.3 Certificate
; 返回 ok bool: true=成功
; [send-certificate-13](#tls.server-conn.send-certificate-13)
server-conn.send-certificate-13 = () (ok bool) {
    ok = false

    cert-len = .cert.len()

    ; Certificate: type(1) + length(3) + ctx_len(1) + list_len(3) + cert_len(3) + cert + ext_len(2)

    #{overflow=wrap}
    hs-len = 4 + 1 + 3 + 3 + cert-len + 2
    hs []byte = with-len(hs-len)

    hs[0]: {
        ok -> it = TLS-HS-CERTIFICATE

        -> _
    }

    #{overflow=wrap}
    body-len = 1 + 3 + 3 + cert-len + 2
    put-u24(hs, 1, body-len)

    ; certificate_request_context length = 0
    hs[4]: {
        ok -> it = 0

        -> _
    }

    ; certificate_list length = 3 + cert-len + 2

    #{overflow=wrap}
    put-u24(hs, 5, 3 + cert-len + 2)

    ; first cert length
    put-u24(hs, 8, cert-len)

    ; cert data
    i <- [0..cert-len): {

        #{overflow=wrap}
        hs[11 + i]: {
            ok -> it = .cert[i]

            -> _
        }
    }

    ; extensions length = 0
    #{overflow=wrap}
    put-u16(hs, 11 + cert-len, 0)
    hs.truncate(hs-len)

    ; 追加到交握緩衝區
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-server-key, .hs-server-iv, .hs-write-seq)

    #{overflow=wrap}
    .hs-write-seq = .hs-write-seq + 1
}

; 發送 server Finished
; 返回 ok bool: true=成功
; [send-finished-13](#tls.server-conn.send-finished-13)
server-conn.send-finished-13 = () (ok bool) {
    ok = false

    ; server_finished_key = HKDF-Expand-Label(s_hs_traffic, "finished", "", 32)
    s-hs-secret []byte = with-len(32)
    i <- [0..32): {
        s-hs-secret[i]: {
            ok -> it = .hs-s-secret[i]

            -> _
        }
    }
    finished-key []byte
    zero-ctx []byte = with-len(0)
    finished-key = hkdf.hkdf-expand-label-vec(s-hs-secret, 'finished', zero-ctx, 32)

    ; transcript hash = SHA-256(ClientHello..Certificate) (不含 server Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; verify_data = HMAC-SHA256(finished_key, transcript_hash)
    verify []byte
    verify = hmac.hmac-sha256-vec(finished-key, hs-hash)

    ; 構建 Finished 訊息
    hs []byte = with-len(36)

    hs[0]: {
        ok -> it = TLS-HS-FINISHED

        -> _
    }
    put-u24(hs, 1, 32)
    i <- [0..32): {

        ixout6048c24 = verify[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hs[4 + i]: {
            ok -> it = ixout6048c24

            -> _
        }
    }
    hs.truncate(36)

    ; 追加到交握緩衝區（在加密之前）
    .append-hs(hs)

    ; 加密發送
    ok = .encrypt-record-13(TLS-CT-HANDSHAKE, hs, .hs-server-key, .hs-server-iv, .hs-write-seq)

    #{overflow=wrap}
    .hs-write-seq = .hs-write-seq + 1
}

; 讀取並驗證 client Finished
; 返回 ok bool: true=成功
; [read-client-finished-13](#tls.server-conn.read-client-finished-13)
server-conn.read-client-finished-13 = () (ok bool) {
    ok = false

    ; 先計算 verify_data（transcript hash 需為 ClientHello..server Finished，
    ; 不含 client Finished。read-encrypted-handshake-13 會 append client Finished
    ; 到 hs-buf，故必須在讀取前計算 hash。）

    ; client_finished_key = HKDF-Expand-Label(c_hs_traffic, "finished", "", 32)
    c-hs-secret []byte = with-len(32)
    i <- [0..32): {
        c-hs-secret[i]: {
            ok -> it = .hs-c-secret[i]

            -> _
        }
    }
    finished-key []byte
    zero-ctx []byte = with-len(0)
    finished-key = hkdf.hkdf-expand-label-vec(c-hs-secret, 'finished', zero-ctx, 32)

    ; transcript hash = SHA-256(ClientHello..server Finished) (不含 client Finished)
    hs-hash-arr = sha256.sha256(.hs-buf)
    hs-hash = hs-hash-arr[..32)

    ; verify_data = HMAC-SHA256(finished_key, transcript_hash)
    verify []byte
    verify = hmac.hmac-sha256-vec(finished-key, hs-hash)

    ; 讀取加密的 client Finished（會 append 到 hs-buf，但 hash 已提前計算）
    cf-type = 0
    cf-data []byte
    cf-type, cf-data = .read-encrypted-handshake-13()
    cf-type != TLS-HS-FINISHED -> return

    ; 比較 verify_data
    i <- [0..32): {
        b1 = cf-data[i]: {
            ok -> it

            -> 0
        }

        b2 = verify[i]: {
            ok -> it

            -> 0
        }
        b1 != b2 -> return
    }
    ok = true
}

; TLS 1.3 伺服器交握
; 返回 ok bool: true=成功
; [handshake-13](#tls.server-conn.handshake-13)
server-conn.handshake-13 = () (ok bool) {
    ok = false

    ; 1. 發送 ServerHello
    ok = .send-server-hello-13()
    ok == false -> return

    ; 2. 計算 ECDHE 共享金鑰
    .compute-shared-secret-13()

    ; 3. 推導交握金鑰
    .derive-handshake-keys-13()

    ; 4. 發送 ChangeCipherSpec（middlebox compat）
    .send-change-cipher-spec()

    ; 5. 發送 EncryptedExtensions
    ok = .send-encrypted-extensions-13()
    ok == false -> return

    ; 6. 發送 Certificate
    ok = .send-certificate-13()
    ok == false -> return

    ; 7. 發送 server Finished
    ok = .send-finished-13()
    ok == false -> return

    ; 8. 讀取 client Finished
    ok = .read-client-finished-13()
    ok == false -> return

    ; 9. 推導應用金鑰
    .derive-application-keys-13()

    ; 10. 啟用加密
    .encrypted = true
    ok = true
}

; TLS 伺服器交握（自動協商 1.3/1.2）
; 返回 ok bool: true=成功
; [handshake](#tls.server-conn.handshake)
server-conn.handshake = () (ok bool) {
    ok = false

    ; 1. 讀取 ClientHello
    ok = .read-client-hello()
    ok == false -> return

    ; TLS 1.3 路徑
    .is-tls13 -> {
        ok = .handshake-13()
        return
    }

    ; TLS 1.2 路徑
    ; 2. 發送 ServerHello
    ok = .send-server-hello()
    ok == false -> return

    ; 3. 發送 Certificate
    ok = .send-certificate()
    ok == false -> return

    ; 4. 發送 ServerHelloDone
    ok = .send-server-hello-done()
    ok == false -> return

    ; 5. 讀取 ClientKeyExchange（含 RSA 解密 + 金鑰推導）
    ok = .read-client-key-exchange()
    ok == false -> return

    ; 6. 讀取 ChangeCipherSpec
    ok = .read-change-cipher-spec()
    ok == false -> return

    ; 7. 讀取 client Finished（加密）
    .encrypted = true
    ok = .read-finished()
    ok == false -> return

    ; 8. 發送 ChangeCipherSpec
    .send-change-cipher-spec()

    ; 9. 發送 server Finished（加密）
    ok = .send-finished()
    ok == false -> return
    ok = true
}

; 透過 TLS 發送資料
; data str: 待發送的明文
; written: 已寫入位元組數（nil=失敗）
; [send](#tls.server-conn.send)
server-conn.send = (data str) (written ?i64) {
    written = nil
    .encrypted == false -> return
    data-bytes = data.to-bytes()
    data-len = data-bytes.len()
    {
        .is-tls13 -> {

            ; TLS 1.3: 使用 AEAD（伺服器應用金鑰）
            ok = .encrypt-record-13(TLS-CT-APP-DATA, data-bytes, .ap-server-key, .ap-server-iv, .ap-write-seq)
            ok == false -> return

            #{overflow=wrap}
            .ap-write-seq = .ap-write-seq + 1
        }

        -> {

            ; TLS 1.2: 使用 CBC+MAC
            ok = .encrypt-record(TLS-CT-APP-DATA, data-bytes)
            ok == false -> return
        }
    }
    written = data-len
}

; 接收並解密資料
; buf str: 接收緩衝區
; n i64: 最多接收位元組數
; 返回 read-n i64: 實際接收位元組數（-1=錯誤）
; [recv](#tls.server-conn.recv)
server-conn.recv = (buf str, n i64) (read-n i64) {
    read-n = -1
    .encrypted == false -> return
    plain []byte
    d-ct = -1
    {
        .is-tls13 -> {

            ; TLS 1.3: 使用 AEAD（客戶端應用金鑰），跳過 CCS
            ct = 0
            out []byte
            ct, out = .read-encrypted-record-13(.ap-client-key, .ap-client-iv, .ap-read-seq)

            #{overflow=wrap}
            .ap-read-seq = .ap-read-seq + 1
            {
                ct < 0 -> return

                ct == TLS-CT-ALERT -> {

                    ; 處理 alert
                    return
                }
            }
            plain = out
            d-ct = ct
        }

        -> {

            ; TLS 1.2: 使用 CBC+MAC
            rec-buf []byte = with-len(16400)
            ct = 0
            rlen = 0
            ct, rlen = read-record(.fd, rec-buf)
            ct != TLS-CT-APP-DATA -> return
            d-ct, plain = .decrypt-record(rec-buf, TLS-CT-APP-DATA)
            d-ct < 0 -> return
        }
    }

    ; 複製到 buf（最多 n 位元組）
    copy-n = plain.len()
    copy-n > n -> copy-n = n

    ; 直接寫入 buf（避免 buf = tmp-str 不會傳播到呼叫端）
    i <- [0..copy-n): {

        ixout6299c24 = plain[i]: {
            ok -> it

            -> _
        }

        buf[i]: {
            ok -> it = ixout6299c24

            -> _
        }
    }
    read-n = copy-n
}

; 關閉連線
; [close](#tls.server-conn.close)
server-conn.close = () {
    .fd > 0 -> fs.close(.fd)
    .fd = -1
    .encrypted = false
}

; 初始化伺服器連線（生成憑證、設定金鑰）
; fd fd: 客戶端 socket fd
; 返回 conn ?server-conn: 連線（nil=錯誤）
; [server-init](#tls.server-init)
server-init = (fd fd) (conn ?server-conn) {
    conn = nil
    c = server-conn {}
    c.fd = fd
    c.rand-state = time.now-ns() ^ os.get-pid()
    c.encrypted = false
    c.hs-buf = with-len(65536)
    c.hs-buf-len = 0
    c.write-seq = 0
    c.read-seq = 0

    ; TLS 1.3 欄位初始化
    c.version = TLS-VERSION
    c.is-tls13 = false
    c.hs-write-seq = 0
    c.hs-read-seq = 0
    c.ap-write-seq = 0
    c.ap-read-seq = 0
    c.hs-plain-pos = 0
    c.hs-plain-len = 0
    c.hs-plain-buf = with-len(16400)

    ; 從內嵌金鑰構造 []byte
    c.n-bytes = with-len(256)
    i <- [0..256): {
        c.n-bytes[i] = tls-server-keys.TLS-SERVER-RSA-N[i]
    }
    c.n-bytes.len = 256
    c.d-bytes = with-len(256)
    i <- [0..256): {
        c.d-bytes[i] = tls-server-keys.TLS-SERVER-RSA-D[i]
    }
    c.d-bytes.len = 256
    c.e-val = tls-server-keys.TLS-SERVER-RSA-E

    ; 生成自簽憑證
    c.cert = x509.x509-build-self-signed-cert(c.n-bytes, c.e-val, c.d-bytes, 'nolang-https')
    conn = c
}

; 接受 TCP 連線並執行 TLS 交握
; 使用局部變數進行交握（全域變數有編譯器 bug：跨函式位址不一致）
; listen-fd fd: 監聽 socket fd
; 返回 conn ?server-conn: ok=連線（含交握金鑰）, nil=失敗
; [server-accept](#tls.server-accept)
server-accept = (listen-fd fd) (conn ?server-conn) {
    conn = nil

    ; 接受 TCP 連線
    client-fd = net.net-accept(listen-fd)
    client-fd < 0 -> return

    ; 初始化伺服器連線（返回 ?server-conn）
    init-opt = server-init(client-fd)
    init-opt: {
        nil -> {
            fs.close(client-fd)
            return
        }

        err -> {
            fs.close(client-fd)
            return
        }

        ok -> {
            c = it

            ; 執行 TLS 交握（在局部變數上操作，方法接收者位址一致）
            ok2 = c.handshake()
            ok2 == false -> {
                c.close()
                return
            }
            conn = c
        }
    }
}

; 完整的 HTTPS 請求-回應週期（單一函式）
; 在同一個函式中完成：accept + handshake + recv HTTP + send HTTP + close
; 所有 TLS 狀態保持在局部變數 c 中，避開全域變數 bug 和結構體複製 bug。
; listen-fd fd: 監聽 socket fd
; status i64: HTTP 回應狀態碼
; body str: HTTP 回應體
; 返回 ok bool: true=成功
; [https-serve-once](#tls.https-serve-once)
https-serve-once = (listen-fd fd, status i64, body str) (ok bool) {
    ok = false

    ; 1. 接受 TCP 連線
    client-fd = net.net-accept(listen-fd)
    client-fd < 0 -> return

    ; 2. 初始化 TLS 連線
    init-opt = server-init(client-fd)
    init-opt: {
        nil -> {
            fs.close(client-fd)
            return
        }

        err -> {
            fs.close(client-fd)
            return
        }

        ok -> {
            c = it

            ; 3. TLS 交握（方法呼叫在局部變數上操作，接收者位址一致）
            hs-ok = c.handshake()
            hs-ok == false -> {
                c.close()
                return
            }

            ; 4. 接收 HTTP 請求（透過 TLS 解密）
            ; 接收直到找到 \r\n\r\n（標頭結束）
            recv-buf str = with-len(8192)
            recv-len = 0
            cr = '\r'
            lf = '\n'

            #{overflow=wrap}
            crlf = cr - lf

            #{overflow=wrap}
            separator = crlf - crlf
            sep-found = false
            (sep-found == false) {
                sep-found -> break

                #{overflow=wrap}
                recv-len + 4096 > 8192 -> break
                tmp str = with-len(4096)
                rn = c.recv(tmp, 4096)
                rn <= 0 -> break
                i <- [0..rn): {

                    #{overflow=wrap}
                    recv-buf[recv-len + i]: {
                        ok -> it = tmp.byte(i)

                        -> _
                    }
                }

                #{overflow=wrap}
                {
                    #{overflow=wrap}
                    recv-len-opt = recv-len + rn
                    recv-len-opt: {
                        ok -> recv-len = it
                        ->
                    }
                }
                data = recv-buf.slice(0, recv-len)
                pos = data.index(separator)
                pos >= 0 -> sep-found = true
            }

            ; 5. 發送 HTTP 回應（透過 TLS 加密）
            status-s = status.to-str()
            status-text = 'OK'
            {
                status == 200 -> status-text = 'OK'

                status == 404 -> status-text = 'Not Found'

                status == 500 -> status-text = 'Internal Server Error'
            }
            body-len = body.len-bytes()
            len-s = body-len.to-str()

            ; 構建完整回應（一次發送，避免多次 send 的 option 處理）
            response = 'HTTP/1.1 ' - status-s - ' ' - status-text - crlf - 'Content-Type: text/plain; charset=utf-8' - crlf - 'Content-Length: ' - len-s - crlf - 'Connection: close' - crlf - 'Server: nolang-https/1.0' - crlf - crlf - body
            w1 = c.send(response)
            w1: {
                nil -> {
                    c.close()
                    return
                }

                err -> {
                    c.close()
                    return
                }

                ok ->
            }

            ; 6. 關閉連線
            c.close()
            ok = true
        }
    }
}

; 建立監聽 socket
; host str: 綁定的 IP 地址
; port i64: 監聽埠號
; 返回 fd fd: 監聽 socket fd（-1=失敗）
; [server-listen](#tls.server-listen)
server-listen = (host str, port i64) (fd fd) {
    fd = -1
    fd = net.net-listen(host, port)
}
