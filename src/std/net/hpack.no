; hpack — HPACK 標頭壓縮（RFC 7541）
;
; HTTP/2.0 使用的標頭壓縮格式。本實作為純 Nolang，不依賴 FFI。
; 簡化策略：
;   - 字串編碼用 literal（H bit=0），不支援 Huffman 壓縮
;   - 靜態表 61 項（RFC 7541 Appendix A）
;   - 動態表最多 64 項
;   - 編碼優先使用 indexed 表示（完全匹配），其次 literal with incremental indexing
;
; 用法：
;   t = tables{}
;   t.init()
;   out, n = t.encode-header(':method', 'GET')
;   names, values, cnt = t.decode-headers(data)  // cnt=-1 表示失敗
; [hpack](#hpack)

; 常量
...

HPACK-STATIC-COUNT = 61
HPACK-DYN-MAX = 64
HPACK-OUT-BUF = 4096

; 結構體
...

; tables: HPACK 編解碼狀態（含靜態表 + 動態表）
; [tables](#hpack.tables)
tables {
    static-names [61]str
    static-values [61]str
    static-init bool
    dyn-names [64]str
    dyn-values [64]str
    dyn-count i64
    dyn-size i64
    dyn-max i64
}

; 初始化
...

; 初始化 HPACK 表（靜態表 + 動態表）
; [init](#hpack.tables.init)
tables.init = () {
    .dyn-count = 0
    .dyn-size = 0
    .dyn-max = 4096
    {
        i <- [0..HPACK-DYN-MAX): {
            .dyn-names[i] ?= ''

            .dyn-values[i] ?= ''
        }
        .static-init -> return
        .static-init = true

        ; RFC 7541 Appendix A 靜態表（61 項）
        ; 索引 0 保留，1-61 為靜態表項
        .static-names[0] ?= ':authority'

        .static-values[0] ?= ''

        .static-names[1] ?= ':method'

        .static-values[1] ?= 'GET'

        .static-names[2] ?= ':method'

        .static-values[2] ?= 'POST'

        .static-names[3] ?= ':path'

        .static-values[3] ?= '/'

        .static-names[4] ?= ':path'

        .static-values[4] ?= '/index.html'

        .static-names[5] ?= ':scheme'

        .static-values[5] ?= 'http'

        .static-names[6] ?= ':scheme'

        .static-values[6] ?= 'https'

        .static-names[7] ?= ':status'

        .static-values[7] ?= '200'

        .static-names[8] ?= ':status'

        .static-values[8] ?= '204'

        .static-names[9] ?= ':status'

        .static-values[9] ?= '206'

        .static-names[10] ?= ':status'

        .static-values[10] ?= '304'

        .static-names[11] ?= ':status'

        .static-values[11] ?= '400'

        .static-names[12] ?= ':status'

        .static-values[12] ?= '404'

        .static-names[13] ?= ':status'

        .static-values[13] ?= '500'

        .static-names[14] ?= 'accept-charset'

        .static-values[14] ?= ''

        .static-names[15] ?= 'accept-encoding'

        .static-values[15] ?= 'gzip, deflate'

        .static-names[16] ?= 'accept-language'

        .static-values[16] ?= ''

        .static-names[17] ?= 'accept-ranges'

        .static-values[17] ?= ''

        .static-names[18] ?= 'accept'

        .static-values[18] ?= ''

        .static-names[19] ?= 'access-control-allow-origin'

        .static-values[19] ?= ''

        .static-names[20] ?= 'age'

        .static-values[20] ?= ''

        .static-names[21] ?= 'allow'

        .static-values[21] ?= ''

        .static-names[22] ?= 'authorization'

        .static-values[22] ?= ''

        .static-names[23] ?= 'cache-control'

        .static-values[23] ?= ''

        .static-names[24] ?= 'content-disposition'

        .static-values[24] ?= ''

        .static-names[25] ?= 'content-encoding'

        .static-values[25] ?= ''

        .static-names[26] ?= 'content-language'

        .static-values[26] ?= ''

        .static-names[27] ?= 'content-length'

        .static-values[27] ?= ''

        .static-names[28] ?= 'content-location'

        .static-values[28] ?= ''

        .static-names[29] ?= 'content-range'

        .static-values[29] ?= ''

        .static-names[30] ?= 'content-type'

        .static-values[30] ?= ''

        .static-names[31] ?= 'cookie'

        .static-values[31] ?= ''

        .static-names[32] ?= 'date'

        .static-values[32] ?= ''

        .static-names[33] ?= 'etag'

        .static-values[33] ?= ''

        .static-names[34] ?= 'expect'

        .static-values[34] ?= ''

        .static-names[35] ?= 'expires'

        .static-values[35] ?= ''

        .static-names[36] ?= 'from'

        .static-values[36] ?= ''

        .static-names[37] ?= 'host'

        .static-values[37] ?= ''

        .static-names[38] ?= 'if-match'

        .static-values[38] ?= ''

        .static-names[39] ?= 'if-modified-since'

        .static-values[39] ?= ''

        .static-names[40] ?= 'if-none-match'

        .static-values[40] ?= ''

        .static-names[41] ?= 'if-range'

        .static-values[41] ?= ''

        .static-names[42] ?= 'if-unmodified-since'

        .static-values[42] ?= ''

        .static-names[43] ?= 'last-modified'

        .static-values[43] ?= ''

        .static-names[44] ?= 'link'

        .static-values[44] ?= ''

        .static-names[45] ?= 'location'

        .static-values[45] ?= ''

        .static-names[46] ?= 'max-forwards'

        .static-values[46] ?= ''

        .static-names[47] ?= 'proxy-authenticate'

        .static-values[47] ?= ''

        .static-names[48] ?= 'proxy-authorization'

        .static-values[48] ?= ''

        .static-names[49] ?= 'range'

        .static-values[49] ?= ''

        .static-names[50] ?= 'referer'

        .static-values[50] ?= ''

        .static-names[51] ?= 'refresh'

        .static-values[51] ?= ''

        .static-names[52] ?= 'retry-after'

        .static-values[52] ?= ''

        .static-names[53] ?= 'server'

        .static-values[53] ?= ''

        .static-names[54] ?= 'set-cookie'

        .static-values[54] ?= ''

        .static-names[55] ?= 'strict-transport-security'

        .static-values[55] ?= ''

        .static-names[56] ?= 'transfer-encoding'

        .static-values[56] ?= ''

        .static-names[57] ?= 'user-agent'

        .static-values[57] ?= ''

        .static-names[58] ?= 'vary'

        .static-values[58] ?= ''

        .static-names[59] ?= 'via'

        .static-values[59] ?= ''

        .static-names[60] ?= 'www-authenticate'

        .static-values[60] ?= ''
    }: {
        err -> _

        -> _
    }
}

; 動態表操作
...

; 新增標頭到動態表（FIFO，新項在索引 0）
; name: 要插入的標頭字段名（如 :method）
; value: 該標頭字段的值
; [dyn-add](#hpack.tables.dyn-add)
tables.dyn-add = (name str, value str) {
    .dyn-count >= HPACK-DYN-MAX -> return

    ; ⚠️ 2026-11-12 重寫：舊版是「從尾部向後移位 + (i > 0) 手動遞減」，實測會**死循環**。
    ; 根因是編譯器缺陷（最小復現 tmp/sh/h43.no）：區域變數若由**接收者欄位**初始化
    ; （`i = .dyn-count`），其後在 match 臂內 `ok -> i = it` 的賦值**不落地**，
    ; i 永遠停在初值 ⇒ while 空轉（用字面量初始化則正常，見同檔 B 臂）。
    ; 這裡改成：① 用遞減區間 `[cnt-1..0]` 取代手動遞減；
    ; ② 計數器一律先落到**字面量初始化的局部**（nc / ns）再賦回欄位。
    cnt = .dyn-count

    ; ⚠️ 注意：`(cond) { }` 是**條件迴圈（while）**，不是 if。原版用
    ; `(i > 0) { ... }` + 手動遞減，就是靠這個語義退出；這裡只想「有舊項才移位」，
    ; 必須寫守衛塊 `cond -> { }`，否則 cnt 不變就永遠循環。
    cnt > 0 -> {
        {

            ; 從尾部往前搬，dst = src + 1，故高位先寫、低位後寫不會互相覆蓋
            i <- [cnt - 1..0]: {
                prev-name ?= .dyn-names[i]
                prev-name-len = prev-name.len-bytes()

                prev-val ?= .dyn-values[i]
                prev-val-len = prev-val.len-bytes()

                ; 逐 byte 複製 name（str-long 值需重建，不能只搬 handle）
                dn-tmp str = ''.with-len(prev-name-len)
                j <- [0..prev-name-len): {
                    pn ?= .dyn-names[i]
                    dn-tmp[j]: {
                        ok -> it = pn[j]

                        -> _
                    }
                }

                .dyn-names[i + 1] ?= dn-tmp

                ; 逐 byte 複製 value
                dv-tmp str = ''.with-len(prev-val-len)
                j <- [0..prev-val-len): {
                    pv ?= .dyn-values[i]
                    dv-tmp[j]: {
                        ok -> it = pv[j]

                        -> _
                    }
                }

                .dyn-values[i + 1] ?= dv-tmp
            }
        }: {
            err -> _

            -> _
        }
    }

    ; 新項放索引 0
    {
        dn0-tmp = ''.with-len(name.len-bytes())
        j <- [0..name.len-bytes()): {
            dn0-tmp[j]: {
                ok -> it = name.byte(j)

                -> _
            }
        }

        .dyn-names[0] ?= dn0-tmp
        dv0-tmp = ''.with-len(value.len-bytes())
        j <- [0..value.len-bytes()): {
            dv0-tmp[j]: {
                ok -> it = value.byte(j)

                -> _
            }
        }

        .dyn-values[0] ?= dv0-tmp
    }: {
        err -> _

        -> _
    }

    ; 計數 / 尺寸：沿用「運算式-match 直接掛在欄位賦值上」的寫法
    ; （這條路徑原版就是好的；改寫成「先算到局部再賦回」反而會被同一個
    ;   編譯器缺陷吃掉 —— 實測 dyn-count 恒 0，見 tmp/sh/h53.no）
    #{overflow=wrap}
    .dyn-count = .dyn-count + 1: {
        ok -> it

        ->
    }

    #{overflow=wrap}
    .dyn-size = .dyn-size + name.len-bytes() + value.len-bytes() + 32
}

; 查詢
...

; 完全匹配（name+value），返回全局索引（靜態 1-61，動態 62+）
; 返回 idx=0=未找到，idx>0=索引
; name: 待查詢的標頭字段名
; value: 待查詢的標頭字段值（需與 name 同時完全匹配）
; idx: 命中的全局索引（0 表示未找到）
; [find](#hpack.tables.find)
tables.find = (name str, value str) (idx i64) {
    idx = 0

    ; 查靜態表（1-61，靜態表內部從 0 開始存）
    nm-len = name.len-bytes()
    vm-len = value.len-bytes()
    i <- [0..HPACK-STATIC-COUNT): {
        {
            sn ?= .static-names[i]
            sn-len = sn.len-bytes()
            sn-len == nm-len -> {
                matched = 1
                j <- [0..nm-len): {
                    sn[j] != name.byte(j) -> {
                        matched = 0
                        break
                    }
                }
                matched == 1 -> {
                    sv ?= .static-values[i]
                    sv-len = sv.len-bytes()
                    sv-len == vm-len -> {
                        v-matched = 1
                        j <- [0..vm-len): {
                            sv[j] != value.byte(j) -> {
                                v-matched = 0
                                break
                            }
                        }
                        v-matched == 1 -> {

                            #{overflow=wrap}
                            idx = i + 1
                            return
                        }
                    }
                }
            }
        }: {
            err -> _

            -> _
        }
    }

    ; 查動態表（索引從 62 開始）
    i <- [0..self.dyn-count): {
        {
            dn ?= .dyn-names[i]
            dn-len = dn.len-bytes()
            dn-len == nm-len -> {
                matched = 1
                j <- [0..nm-len): {
                    dn[j] != name.byte(j) -> {
                        matched = 0
                        break
                    }
                }
                matched == 1 -> {
                    dv ?= .dyn-values[i]
                    dv-len = dv.len-bytes()
                    dv-len == vm-len -> {
                        v-matched = 1
                        j <- [0..vm-len): {
                            dv[j] != value.byte(j) -> {
                                v-matched = 0
                                break
                            }
                        }
                        v-matched == 1 -> {

                            #{overflow=wrap}
                            idx = HPACK-STATIC-COUNT + i + 1
                            return
                        }
                    }
                }
            }
        }: {
            err -> _

            -> _
        }
    }
}

; 只匹配 name，返回全局索引
; 返回 idx=0=未找到，idx>0=索引
; name: 待查詢的標頭字段名
; idx: 名稱匹配的條目索引（0 表示未找到）
; [find-name](#hpack.tables.find-name)
tables.find-name = (name str) (idx i64) {
    idx = 0
    nm-len = name.len-bytes()
    i <- [0..HPACK-STATIC-COUNT): {
        {
            sn ?= .static-names[i]
            sn-len = sn.len-bytes()
            sn-len == nm-len -> {
                matched = 1
                j <- [0..nm-len): {
                    sn[j] != name.byte(j) -> {
                        matched = 0
                        break
                    }
                }
                matched == 1 -> {

                    #{overflow=wrap}
                    idx = i + 1
                    return
                }
            }
        }: {
            err -> _

            -> _
        }
    }
    i <- [0..self.dyn-count): {
        {
            dn ?= .dyn-names[i]
            dn-len = dn.len-bytes()
            dn-len == nm-len -> {
                matched = 1
                j <- [0..nm-len): {
                    dn[j] != name.byte(j) -> {
                        matched = 0
                        break
                    }
                }
                matched == 1 -> {

                    #{overflow=wrap}
                    idx = HPACK-STATIC-COUNT + i + 1
                    return
                }
            }
        }: {
            err -> _

            -> _
        }
    }
}

; 根據索引取得 name/value
; idx 1-61=靜態表，62+=動態表
; 返回 name, value, ok=true=找到
; idx: 要查詢的全局索引（1-61 查靜態表，62 起查動態表）
; name: 查得的標頭字段名
; value: 查得的標頭字段值
; ok: idx 落在有效範圍並成功取出時為 true
; [lookup](#hpack.tables.lookup)
tables.lookup = (idx i64) (name str, value str, ok bool) {
    ok = false

    {
        idx <= 0 -> return

        idx <= HPACK-STATIC-COUNT -> {

            ; 靜態表（內部從 0 開始）
            #{overflow=wrap}
            arr-idx = idx - 1

            {
                sn ?= .static-names[arr-idx]
                sv ?= .static-values[arr-idx]
                n-len = sn.len-bytes()

                v-len = sv.len-bytes()

                name = sn.slice-bytes(0, n-len)
                v-len > 0 -> {
                    value = sv.slice-bytes(0, v-len)
                }
                ok = true
                return
            }: {
                err -> _

                -> _
            }
        }
    }

    #{overflow=wrap}
    dyn-idx = idx - HPACK-STATIC-COUNT - 1
    dyn-idx < .dyn-count -> {
        {
            dn ?= .dyn-names[dyn-idx]
            dv ?= .dyn-values[dyn-idx]
            n-len = dn.len-bytes()

            v-len = dv.len-bytes()

            name = dn.slice-bytes(0, n-len)
            v-len > 0 -> {
                value = dv.slice-bytes(0, v-len)
            }
            ok = true
            return
        }: {
            err -> _

            -> _
        }
    }
}

; 變長整數編解碼（RFC 7541 §5.1）
...

; 編碼變長整數到 out
; val i64: 要編碼的非負整數
; prefix-bits i64: 首字節可用前綴位數（1-8）；小於 2^prefix-bits-1 時單字節即可完成
; prefix-byte i64: 已填好高位的前綴字節（高 8-prefix-bits 位已設置，低 bits 留給前綴值）
; out str: 編碼結果（首字節 + 若干 continuation 字節，每字節低 7 位承載數值、最高位為延續標誌）
; [encode-int](#hpack.encode-int)
encode-int = (val i64, prefix-bits i64, prefix-byte i64) (out str) {
    r-val = val

    #{overflow=wrap}
    max-prefix = (1 << prefix-bits) - 1
    val < max-prefix -> {
        ob []byte = with-cap-len(1, 1)
        ob[0] = prefix-byte | val
        out = ob.to-bytes-str()
        return
    }

    ; 多 byte 編碼：所需字節數 = 1(首 byte) + 延續 byte 數 + 1(尾 byte，值為 0 也要寫)
    ; （原實現用 out[n] = 0 寫尾部零 byte，零寫入不會推進長度，導致
    ;   val == max-prefix 時丟失 0x00 延續 byte，RFC 7541 回环解碼失败）

    #{overflow=wrap}
    t = r-val - max-prefix
    n = 2
    (t >= 128) {
        t = t >> 7

        {
            #{overflow=wrap}
            n ?= n + 1
        }: {
            err -> _

            -> _
        }
    }

    ; 2026-11-11：str 下標直寫已全域禁用 ⇒ []byte 緩衝承接（位元組保真），
    ; 收尾整體 to-bytes-str()。這裡不能用 place-match：它對 str 是「碼點」閘門，
    ; 這些是 >= 0x80 的延續位元組，會被靜默跳過。
    ob []byte = with-cap-len(n, n)

    ; 第一個 byte: prefix 全 1
    ob[0] = prefix-byte | max-prefix

    {
        #{overflow=wrap}
        r-val ?= r-val - max-prefix
    }: {
        err -> _

        -> _
    }
    i = 1
    (r-val >= 128) {
        ob[i] = (r-val & 127) | 128

        {
            #{overflow=wrap}
            i ?= i + 1
        }: {
            err -> _

            -> _
        }
        r-val = r-val >> 7
    }
    ob[i] = r-val
    out = ob.to-bytes-str()
}

; 從 data 的 pos 位置解碼變長整數
; data str: HPACK 編碼資料
; pos i64: 首字節所在位元組偏移
; prefix-bits i64: 前綴位數（與編碼端一致）
; val i64: 解碼出的整數值（錯誤時不保證）
; next-pos i64: 下一個未讀位元組偏移（-1=越界或 continuation 鏈過長）
; [decode-int](#hpack.decode-int)
decode-int = (data str, pos i64, prefix-bits i64) (val i64, next-pos i64) {
    val = 0
    next-pos = pos
    pos >= data.len-bytes() -> {
        next-pos = -1
        return
    }

    #{overflow=wrap}
    max-prefix = (1 << prefix-bits) - 1

    first-b = data.byte(pos): {
        ok -> it

        -> _
    }
    first = first-b & max-prefix
    val = first

    {
        #{overflow=wrap}
        next-pos ?= pos + 1
    }: {
        err -> _

        -> _
    }
    first < max-prefix -> return

    ; 多 byte 編碼
    m = 0
    !! {
        next-pos >= data.len-bytes() -> {
            next-pos = -1
            break
        }

        b = data.byte(next-pos)

        {
            #{overflow=wrap}
            next-pos ?= next-pos + 1
        }: {
            err -> _

            -> _
        }

        #{overflow=wrap}
        val = val + ((b & 127) << m)

        {
            #{overflow=wrap}
            m ?= m + 7
        }: {
            err -> _

            -> _
        }
        (b & 128) == 0 -> break
        m >= 35 -> {
            next-pos = -1
            break
        }
    }
}

; 字串編解碼（RFC 7541 §5.2，不支援 Huffman）
...

; 編碼字串（literal，H=0）
; s str: 待編碼的字串（長度 varint 前綴 + UTF-8 位元組）
; out str: 編碼結果字節串（7-bit prefix 長度編碼拼接原文，不支援 Huffman）
; [encode-str](#hpack.encode-str)
encode-str = (s str) (out str) {

    ; H bit=0, 長度用 7-bit prefix 編碼
    len-out = encode-int(s.len-bytes(), 7, 0)

    ; 預先設定總長度（原 with-cap + 逐 byte 寫入在長度 byte 為 0x00
    ;   （空字串）時零寫入不推進長度，產生 0 byte 輸出，回環解碼失敗）
    #{overflow=wrap}
    ob []byte = with-cap-len(len-out.len-bytes() + s.len-bytes(), len-out.len-bytes() + s.len-bytes())

    ; 複製長度編碼到 out
    i <- [0..len-out.len-bytes()): {
        ob[i] = len-out.byte(i)
    }
    out-n = len-out.len-bytes()

    ; 複製字串內容
    i <- [0..s.len-bytes()): {

        #{overflow=wrap}
        ob[out-n + i] = s.byte(i)
    }
    out = ob.to-bytes-str()
}

; 從 data 的 pos 位置解碼字串
; data str: HPACK 編碼資料
; pos i64: 長度前綴首字節所在偏移
; out str: 解碼出的字串原文（Huffman 編碼不支援）
; next-pos i64: 下一個未讀位元組偏移（-1=錯誤或資料不足）
; [decode-str](#hpack.decode-str)
decode-str = (data str, pos i64) (out str, next-pos i64) {
    pos >= data.len-bytes() -> {
        next-pos = -1
        return
    }

    ; 長度用 7-bit prefix；H bit（首 byte 的 128 位）為 Huffman 標記，
    ; 本實作不支援 Huffman 編碼，故不解析該位元。
    len = 0
    p = 0
    len, p = decode-int(data, pos, 7)

    {
        p < 0 -> {
            next-pos = -1
            return
        }

        p + len > data.len-bytes() -> {
            next-pos = -1
            return
        }
    }

    ; 複製字串內容
    out-b []byte = with-cap-len(len, len)
    i <- [0..len): {

        #{overflow=wrap}
        out-b[i] = data.byte(p + i)
    }

    {
        #{overflow=wrap}
        next-pos ?= p + len
    }: {
        err -> _

        -> _
    }
    out = out-b.slice(0, len).to-bytes-str()
}

; 標頭編解碼
...

; 編碼單個標頭
; 策略：完全匹配→indexed；name 匹配→literal with indexing（用 name 索引）；
;       否則→literal with indexing（新 name）
; name str: 待編碼的標頭字段名（按查表結果選取索引或字面量形式）
; value str: 待編碼的標頭字段值
; out str: 編碼後的標頭字節串，編碼結果同時加入動態表
; [encode-header](#hpack.tables.encode-header)
tables.encode-header = (name str, value str) (out str) {

    ; 1. 完全匹配 → Indexed Header Field（6.1）
    full-idx = 0
    full-idx = .find(name, value)
    full-idx > 0 -> {

        ; 格式：1xxxxxxx（高 1 位為 1，7-bit 索引）
        out = encode-int(full-idx, 7, 128)
        return
    }

    #{overflow=wrap}
    out-b []byte = with-cap-len(name.len-bytes() + value.len-bytes() + 8, name.len-bytes() + value.len-bytes() + 8)

    ; 2. name 匹配 → Literal with Incremental Indexing（6.2.1），name 用索引
    name-idx = 0
    name-idx = .find-name(name)

    name-idx > 0 -> {

        ; 格式：01xxxxxx（高 2 位為 01，6-bit 索引）
        idx-out = ' '
        idx-out = encode-int(name-idx, 6, 64)

        ; 複製到 out-b（[]byte 緩衝，str 下標直寫自 2026-11-11 起全域禁用）
        i <- [0..idx-out.len-bytes()): {
            out-b[i] = idx-out.byte(i)
        }
        out-n = idx-out.len-bytes()

        ; 編碼 value
        val-out = ' '
        val-out = encode-str(value)
        i <- [0..val-out.len-bytes()): {

            #{overflow=wrap}
            out-b[out-n + i] = val-out.byte(i)
        }

        ; 加入動態表
        .dyn-add(name, value)
        out = out-b.slice(0, out-n + val-out.len-bytes()).to-bytes-str()
        return
    }

    ; 3. 全新標頭 → Literal with Incremental Indexing（6.2.1），新 name
    ; 格式：01000000（索引 0 = 新 name）
    out-b[0] = 64
    out-n = 1

    ; 編碼 name
    name-out = ' '
    name-out = encode-str(name)
    i <- [0..name-out.len-bytes()): {

        #{overflow=wrap}
        out-b[out-n + i] = name-out.byte(i)
    }

    #{overflow=wrap}
    out-n = out-n + name-out.len-bytes()

    ; 編碼 value
    val-out = ' '
    val-out = encode-str(value)
    i <- [0..val-out.len-bytes()): {

        #{overflow=wrap}
        out-b[out-n + i] = val-out.byte(i)
    }

    ; 加入動態表
    .dyn-add(name, value)
    out = out-b.slice(0, out-n + val-out.len-bytes()).to-bytes-str()
}

; 解碼標頭塊
; data str: HPACK 編碼的標頭塊二進位資料
; names [128]str: 解碼出的標頭字段名，與 values 同下標對應（未用槽位為空串）
; values [128]str: 解碼出的標頭字段值
; count i64: 實際解碼出的標頭數（超過 128 條時截斷）
; ok bool: true=整塊解碼成功，false=中途遇錯或輸出槽位用完
; [decode-headers](#hpack.tables.decode-headers)
tables.decode-headers = (data str) (names [128]str, values [128]str, count i64, ok bool) {
    ok = false
    count = 0

    ; 初始化輸出陣列
    ; ⚠️ 不能寫成 `i <- [0..128): { names[i] = '' }`——`[N]str` 型別的**結果
    ; 參數**在編譯器裡沒有零值填充，第一次下標寫就會把未初始化記憶體當成既有的
    ; `str` 去釋放，實測 SIGSEGV（見 MEMORY-RISKS）。`zero()` 是
    ; `math.arr-zero` 的接收者形態，對 `[N]str` 就是整塊 memset。
    names.zero()
    values.zero()
    n = data.len-bytes()
    n == 0 -> {
        ok = true
        return
    }
    pos = 0
    !! {
        pos >= n -> break
        count >= 128 -> break

        b = data.byte(pos)

        ; Indexed Header Field（6.1）：1xxxxxxx
        {
            (b & 128) != 0 -> {
                idx = 0
                next = 0
                idx, next = decode-int(data, pos, 7)
                next < 0 -> return
                lk-name = ''
                lk-val = ''
                found = false
                lk-name, lk-val, found = .lookup(idx)
                found == false -> return

                ; 複製到輸出
                ln-tmp str = ''.with-len(lk-name.len-bytes())
                j <- [0..lk-name.len-bytes()): {
                    ln-tmp[j]: {
                        ok -> it = lk-name.byte(j)

                        -> _
                    }
                }

                names[count] = ln-tmp
                lv-tmp str = ''.with-len(lk-val.len-bytes())
                j <- [0..lk-val.len-bytes()): {
                    lv-tmp[j]: {
                        ok -> it = lk-val.byte(j)

                        -> _
                    }
                }

                values[count] = lv-tmp

                {
                    #{overflow=wrap}
                    count ?= count + 1
                }: {
                    err -> _

                    -> _
                }
                pos = next
            }

            (b & 192) == 64 -> {

                ; Literal with Incremental Indexing（6.2.1）：01xxxxxx

                name-idx = 0
                next = 0
                name-idx, next = decode-int(data, pos, 6)
                next < 0 -> return
                pos = next
                name = ''
                value = ''
                {
                    name-idx == 0 -> {
                        name, pos = decode-str(data, pos)
                        pos < 0 -> return
                    }

                    -> {
                        lk-name = ''
                        lk-val = ''
                        found = false
                        lk-name, lk-val, found = .lookup(name-idx)
                        found == false -> return
                        name = lk-name
                    }
                }
                value, pos = decode-str(data, pos)
                pos < 0 -> return

                ; 複製到輸出
                nb-tmp str = ''.with-len(name.len-bytes())
                j <- [0..name.len-bytes()): {
                    nb-tmp[j]: {
                        ok -> it = name.byte(j)

                        -> _
                    }
                }

                names[count] = nb-tmp
                vb-tmp str = ''.with-len(value.len-bytes())
                j <- [0..value.len-bytes()): {
                    vb-tmp[j]: {
                        ok -> it = value.byte(j)

                        -> _
                    }
                }

                values[count] = vb-tmp

                {
                    #{overflow=wrap}
                    count ?= count + 1
                }: {
                    err -> _

                    -> _
                }

                ; 加入動態表
                .dyn-add(name, value)
            }

            (b & 240) == 0 -> {

                ; Literal without Indexing（6.2.2）：0000xxxx

                name-idx = 0
                next = 0
                name-idx, next = decode-int(data, pos, 4)
                next < 0 -> return
                pos = next
                name = ''
                value = ''
                {
                    name-idx == 0 -> {
                        name, pos = decode-str(data, pos)
                        pos < 0 -> return
                    }

                    -> {
                        lk-name = ''
                        lk-val = ''
                        found = false
                        lk-name, lk-val, found = .lookup(name-idx)
                        found == false -> return
                        name = lk-name
                    }
                }
                value, pos = decode-str(data, pos)
                pos < 0 -> return
                nb-tmp str = ''.with-len(name.len-bytes())
                j <- [0..name.len-bytes()): {
                    nb-tmp[j]: {
                        ok -> it = name.byte(j)

                        -> _
                    }
                }

                names[count] = nb-tmp
                vb-tmp str = ''.with-len(value.len-bytes())
                j <- [0..value.len-bytes()): {
                    vb-tmp[j]: {
                        ok -> it = value.byte(j)

                        -> _
                    }
                }

                values[count] = vb-tmp

                {
                    #{overflow=wrap}
                    count ?= count + 1
                }: {
                    err -> _

                    -> _
                }
            }

            (b & 240) == 16 -> {

                ; Literal Never Indexed（6.2.3）：0001xxxx

                name-idx = 0
                next = 0
                name-idx, next = decode-int(data, pos, 4)
                next < 0 -> return
                pos = next
                name = ''
                value = ''
                {
                    name-idx == 0 -> {
                        name, pos = decode-str(data, pos)
                        pos < 0 -> return
                    }

                    -> {
                        lk-name = ''
                        lk-val = ''
                        found = false
                        lk-name, lk-val, found = .lookup(name-idx)
                        found == false -> return
                        name = lk-name
                    }
                }
                value, pos = decode-str(data, pos)
                pos < 0 -> return
                nb-tmp str = ''.with-len(name.len-bytes())
                j <- [0..name.len-bytes()): {
                    nb-tmp[j]: {
                        ok -> it = name.byte(j)

                        -> _
                    }
                }

                names[count] = nb-tmp
                vb-tmp str = ''.with-len(value.len-bytes())
                j <- [0..value.len-bytes()): {
                    vb-tmp[j]: {
                        ok -> it = value.byte(j)

                        -> _
                    }
                }

                values[count] = vb-tmp

                {
                    #{overflow=wrap}
                    count ?= count + 1
                }: {
                    err -> _

                    -> _
                }
            }

            -> return
        }
        ; 未知表示類型
    }
    ok = true
}
