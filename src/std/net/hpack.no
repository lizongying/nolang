; hpack — HPACK 標頭壓縮（RFC 7541）
;
; HTTP/2.0 使用的標頭壓縮格式。本實作為純 Nolang，不依賴 FFI。
; 簡化策略：
;   - 字串編碼用 literal（H bit=0），不支援 Huffman 壓縮
;   - 靜態表 61 項（RFC 7541 Appendix A）
;   - 動態表最多 64 項
;   - 編碼優先使用 indexed 表示（完全匹配），其次 literal with incremental indexing
;
; 用法：
;   t = tables{}
;   t.init()
;   out, n = t.encode-header(':method', 'GET')
;   names, values, cnt = t.decode-headers(data)  // cnt=-1 表示失敗

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

HPACK-STATIC-COUNT = 61
HPACK-DYN-MAX = 64
HPACK-OUT-BUF = 4096

; ═══════════════════════════════════════════════
; 結構體
; ═══════════════════════════════════════════════

; tables: HPACK 編解碼狀態（含靜態表 + 動態表）
tables {
    static-names [61]str
    static-values [61]str
    static-init bool
    dyn-names [64]str
    dyn-values [64]str
    dyn-count i64
    dyn-size i64
    dyn-max i64
}

; ═══════════════════════════════════════════════
; 初始化
; ═══════════════════════════════════════════════

; init: 初始化 HPACK 表（靜態表 + 動態表）
tables.init = () {
    .dyn-count = 0
    .dyn-size = 0
    .dyn-max = 4096
    i <- [0..HPACK-DYN-MAX): {

        #{index-out=0}
        .dyn-names[i] = ''

        #{index-out=0}
        .dyn-values[i] = ''
    }
    .static-init -> return
    .static-init = true

    ; RFC 7541 Appendix A 靜態表（61 項）
    ; 索引 0 保留，1-61 為靜態表項
    #{index-out=0}
    .static-names[0] = ':authority'

    #{index-out=0}
    .static-values[0] = ''

    #{index-out=0}
    .static-names[1] = ':method'

    #{index-out=0}
    .static-values[1] = 'GET'

    #{index-out=0}
    .static-names[2] = ':method'

    #{index-out=0}
    .static-values[2] = 'POST'

    #{index-out=0}
    .static-names[3] = ':path'

    #{index-out=0}
    .static-values[3] = '/'

    #{index-out=0}
    .static-names[4] = ':path'

    #{index-out=0}
    .static-values[4] = '/index.html'

    #{index-out=0}
    .static-names[5] = ':scheme'

    #{index-out=0}
    .static-values[5] = 'http'

    #{index-out=0}
    .static-names[6] = ':scheme'

    #{index-out=0}
    .static-values[6] = 'https'

    #{index-out=0}
    .static-names[7] = ':status'

    #{index-out=0}
    .static-values[7] = '200'

    #{index-out=0}
    .static-names[8] = ':status'

    #{index-out=0}
    .static-values[8] = '204'

    #{index-out=0}
    .static-names[9] = ':status'

    #{index-out=0}
    .static-values[9] = '206'

    #{index-out=0}
    .static-names[10] = ':status'

    #{index-out=0}
    .static-values[10] = '304'

    #{index-out=0}
    .static-names[11] = ':status'

    #{index-out=0}
    .static-values[11] = '400'

    #{index-out=0}
    .static-names[12] = ':status'

    #{index-out=0}
    .static-values[12] = '404'

    #{index-out=0}
    .static-names[13] = ':status'

    #{index-out=0}
    .static-values[13] = '500'

    #{index-out=0}
    .static-names[14] = 'accept-charset'

    #{index-out=0}
    .static-values[14] = ''

    #{index-out=0}
    .static-names[15] = 'accept-encoding'

    #{index-out=0}
    .static-values[15] = 'gzip, deflate'

    #{index-out=0}
    .static-names[16] = 'accept-language'

    #{index-out=0}
    .static-values[16] = ''

    #{index-out=0}
    .static-names[17] = 'accept-ranges'

    #{index-out=0}
    .static-values[17] = ''

    #{index-out=0}
    .static-names[18] = 'accept'

    #{index-out=0}
    .static-values[18] = ''

    #{index-out=0}
    .static-names[19] = 'access-control-allow-origin'

    #{index-out=0}
    .static-values[19] = ''

    #{index-out=0}
    .static-names[20] = 'age'

    #{index-out=0}
    .static-values[20] = ''

    #{index-out=0}
    .static-names[21] = 'allow'

    #{index-out=0}
    .static-values[21] = ''

    #{index-out=0}
    .static-names[22] = 'authorization'

    #{index-out=0}
    .static-values[22] = ''

    #{index-out=0}
    .static-names[23] = 'cache-control'

    #{index-out=0}
    .static-values[23] = ''

    #{index-out=0}
    .static-names[24] = 'content-disposition'

    #{index-out=0}
    .static-values[24] = ''

    #{index-out=0}
    .static-names[25] = 'content-encoding'

    #{index-out=0}
    .static-values[25] = ''

    #{index-out=0}
    .static-names[26] = 'content-language'

    #{index-out=0}
    .static-values[26] = ''

    #{index-out=0}
    .static-names[27] = 'content-length'

    #{index-out=0}
    .static-values[27] = ''

    #{index-out=0}
    .static-names[28] = 'content-location'

    #{index-out=0}
    .static-values[28] = ''

    #{index-out=0}
    .static-names[29] = 'content-range'

    #{index-out=0}
    .static-values[29] = ''

    #{index-out=0}
    .static-names[30] = 'content-type'

    #{index-out=0}
    .static-values[30] = ''

    #{index-out=0}
    .static-names[31] = 'cookie'

    #{index-out=0}
    .static-values[31] = ''

    #{index-out=0}
    .static-names[32] = 'date'

    #{index-out=0}
    .static-values[32] = ''

    #{index-out=0}
    .static-names[33] = 'etag'

    #{index-out=0}
    .static-values[33] = ''

    #{index-out=0}
    .static-names[34] = 'expect'

    #{index-out=0}
    .static-values[34] = ''

    #{index-out=0}
    .static-names[35] = 'expires'

    #{index-out=0}
    .static-values[35] = ''

    #{index-out=0}
    .static-names[36] = 'from'

    #{index-out=0}
    .static-values[36] = ''

    #{index-out=0}
    .static-names[37] = 'host'

    #{index-out=0}
    .static-values[37] = ''

    #{index-out=0}
    .static-names[38] = 'if-match'

    #{index-out=0}
    .static-values[38] = ''

    #{index-out=0}
    .static-names[39] = 'if-modified-since'

    #{index-out=0}
    .static-values[39] = ''

    #{index-out=0}
    .static-names[40] = 'if-none-match'

    #{index-out=0}
    .static-values[40] = ''

    #{index-out=0}
    .static-names[41] = 'if-range'

    #{index-out=0}
    .static-values[41] = ''

    #{index-out=0}
    .static-names[42] = 'if-unmodified-since'

    #{index-out=0}
    .static-values[42] = ''

    #{index-out=0}
    .static-names[43] = 'last-modified'

    #{index-out=0}
    .static-values[43] = ''

    #{index-out=0}
    .static-names[44] = 'link'

    #{index-out=0}
    .static-values[44] = ''

    #{index-out=0}
    .static-names[45] = 'location'

    #{index-out=0}
    .static-values[45] = ''

    #{index-out=0}
    .static-names[46] = 'max-forwards'

    #{index-out=0}
    .static-values[46] = ''

    #{index-out=0}
    .static-names[47] = 'proxy-authenticate'

    #{index-out=0}
    .static-values[47] = ''

    #{index-out=0}
    .static-names[48] = 'proxy-authorization'

    #{index-out=0}
    .static-values[48] = ''

    #{index-out=0}
    .static-names[49] = 'range'

    #{index-out=0}
    .static-values[49] = ''

    #{index-out=0}
    .static-names[50] = 'referer'

    #{index-out=0}
    .static-values[50] = ''

    #{index-out=0}
    .static-names[51] = 'refresh'

    #{index-out=0}
    .static-values[51] = ''

    #{index-out=0}
    .static-names[52] = 'retry-after'

    #{index-out=0}
    .static-values[52] = ''

    #{index-out=0}
    .static-names[53] = 'server'

    #{index-out=0}
    .static-values[53] = ''

    #{index-out=0}
    .static-names[54] = 'set-cookie'

    #{index-out=0}
    .static-values[54] = ''

    #{index-out=0}
    .static-names[55] = 'strict-transport-security'

    #{index-out=0}
    .static-values[55] = ''

    #{index-out=0}
    .static-names[56] = 'transfer-encoding'

    #{index-out=0}
    .static-values[56] = ''

    #{index-out=0}
    .static-names[57] = 'user-agent'

    #{index-out=0}
    .static-values[57] = ''

    #{index-out=0}
    .static-names[58] = 'vary'

    #{index-out=0}
    .static-values[58] = ''

    #{index-out=0}
    .static-names[59] = 'via'

    #{index-out=0}
    .static-values[59] = ''

    #{index-out=0}
    .static-names[60] = 'www-authenticate'

    #{index-out=0}
    .static-values[60] = ''
}

; ═══════════════════════════════════════════════
; 動態表操作
; ═══════════════════════════════════════════════

; dyn-add: 新增標頭到動態表（FIFO，新項在索引 0）
tables.dyn-add = (name str, value str) {

    #{overflow=wrap}
    .dyn-count >= HPACK-DYN-MAX -> return

    ; 向後移動（從尾部開始避免覆蓋）
    i = .dyn-count
    (i > 0) {

        ; 用 slice 複製（CallExpression 正確載入 str-long value）
        #{index-out=0, overflow=wrap}
        prev-name-len = .dyn-names[i - 1].len-bytes()

        #{index-out=0, overflow=wrap}
        prev-val-len = .dyn-values[i - 1].len-bytes()

        ; 逐 byte 複製 name
        dn-tmp str = ''.with-len(prev-name-len)
        j <- [0..prev-name-len): {

            #{index-out=0, overflow=wrap}
            dn-tmp[j] = .dyn-names[i - 1][j]
        }

        #{index-out=0}
        .dyn-names[i] = dn-tmp

        ; 逐 byte 複製 value
        dv-tmp str = ''.with-len(prev-val-len)
        j <- [0..prev-val-len): {

            #{index-out=0, overflow=wrap}
            dv-tmp[j] = .dyn-values[i - 1][j]
        }

        #{index-out=0}
        .dyn-values[i] = dv-tmp

        #{overflow=wrap}
        i = i - 1
    }

    ; 新項放索引 0
    dn0-tmp str = ''.with-len(name.len-bytes())
    j <- [0..name.len-bytes()): {

        #{index-out=0, overflow=wrap}
        dn0-tmp[j] = name[j]
    }

    #{index-out=0}
    .dyn-names[0] = dn0-tmp
    dv0-tmp str = ''.with-len(value.len-bytes())
    j <- [0..value.len-bytes()): {

        #{index-out=0, overflow=wrap}
        dv0-tmp[j] = value[j]
    }

    #{index-out=0}
    .dyn-values[0] = dv0-tmp

    #{overflow=wrap}
    .dyn-count = .dyn-count + 1

    #{overflow=wrap}
    .dyn-size = .dyn-size + name.len-bytes() + value.len-bytes() + 32
}

; ═══════════════════════════════════════════════
; 查詢
; ═══════════════════════════════════════════════

; find: 完全匹配（name+value），返回全局索引（靜態 1-61，動態 62+）
; 返回 idx=0=未找到，idx>0=索引
tables.find = (name str, value str) (idx i64) {
    idx = 0

    ; 查靜態表（1-61，靜態表內部從 0 開始存）
    nm-len = name.len-bytes()
    vm-len = value.len-bytes()
    i <- [0..HPACK-STATIC-COUNT): {

        #{index-out=0}
        sn-len = .static-names[i].len-bytes()
        sn-len == nm-len -> {
            matched = 1
            j <- [0..nm-len): {
                .static-names[i][j] != name[j] -> {
                    matched = 0
                    break
                }
            }
            matched == 1 -> {

                #{index-out=0}
                sv-len = .static-values[i].len-bytes()
                sv-len == vm-len -> {
                    v-matched = 1
                    j <- [0..vm-len): {
                        .static-values[i][j] != value[j] -> {
                            v-matched = 0
                            break
                        }
                    }
                    v-matched == 1 -> {

                        #{overflow=wrap}
                        idx = i + 1
                        return
                    }
                }
            }
        }
    }

    ; 查動態表（索引從 62 開始）
    i <- [0...dyn-count): {

        #{index-out=0}
        dn-len = .dyn-names[i].len-bytes()
        dn-len == nm-len -> {
            matched = 1
            j <- [0..nm-len): {
                .dyn-names[i][j] != name[j] -> {
                    matched = 0
                    break
                }
            }
            matched == 1 -> {

                #{index-out=0}
                dv-len = .dyn-values[i].len-bytes()
                dv-len == vm-len -> {
                    v-matched = 1
                    j <- [0..vm-len): {
                        .dyn-values[i][j] != value[j] -> {
                            v-matched = 0
                            break
                        }
                    }
                    v-matched == 1 -> {

                        #{overflow=wrap}
                        idx = HPACK-STATIC-COUNT + i + 1
                        return
                    }
                }
            }
        }
    }
}

; find-name: 只匹配 name，返回全局索引
; 返回 idx=0=未找到，idx>0=索引
tables.find-name = (name str) (idx i64) {
    idx = 0
    nm-len = name.len-bytes()
    i <- [0..HPACK-STATIC-COUNT): {

        #{index-out=0}
        sn-len = .static-names[i].len-bytes()
        sn-len == nm-len -> {
            matched = 1
            j <- [0..nm-len): {
                .static-names[i][j] != name[j] -> {
                    matched = 0
                    break
                }
            }
            matched == 1 -> {

                #{overflow=wrap}
                idx = i + 1
                return
            }
        }
    }
    i <- [0...dyn-count): {

        #{index-out=0}
        dn-len = .dyn-names[i].len-bytes()
        dn-len == nm-len -> {
            matched = 1
            j <- [0..nm-len): {
                .dyn-names[i][j] != name[j] -> {
                    matched = 0
                    break
                }
            }
            matched == 1 -> {

                #{overflow=wrap}
                idx = HPACK-STATIC-COUNT + i + 1
                return
            }
        }
    }
}

; lookup: 根據索引取得 name/value
; idx 1-61=靜態表，62+=動態表
; 返回 name, value, ok=true=找到
tables.lookup = (idx i64) (name str, value str, ok bool) {

    #{overflow=wrap}
    ok = false

    #{overflow=wrap}
    {
        idx <= 0 -> return

        idx <= HPACK-STATIC-COUNT -> {

            ; 靜態表（內部從 0 開始）
            #{overflow=wrap}
            arr-idx = idx - 1

            #{index-out=0}
            n-len = .static-names[arr-idx].len-bytes()

            #{index-out=0}
            v-len = .static-values[arr-idx].len-bytes()

            #{index-out=0}
            name = .static-names[arr-idx].slice-bytes(0, n-len)
            v-len > 0 -> {

                #{index-out=0}
                value = .static-values[arr-idx].slice-bytes(0, v-len)
            }
            ok = true
            return
        }
    }

    #{overflow=wrap}
    dyn-idx = idx - HPACK-STATIC-COUNT - 1
    dyn-idx < .dyn-count -> {

        #{index-out=0}
        n-len = .dyn-names[dyn-idx].len-bytes()

        #{index-out=0}
        v-len = .dyn-values[dyn-idx].len-bytes()

        #{index-out=0}
        name = .dyn-names[dyn-idx].slice-bytes(0, n-len)
        v-len > 0 -> {

            #{index-out=0}
            value = .dyn-values[dyn-idx].slice-bytes(0, v-len)
        }
        ok = true
        return
    }
}

; ═══════════════════════════════════════════════
; 變長整數編解碼（RFC 7541 §5.1）
; ═══════════════════════════════════════════════

; encode-int: 編碼變長整數到 out
; val: 要編碼的值
; prefix-bits: 前綴位數（1-8）
; prefix-byte: 已填好的前綴 byte（高 8-prefix-bits 位已設置）
; 返回 out=編碼後的字串
encode-int = (val i64, prefix-bits i64, prefix-byte i64) (out str) {
    r-val = val

    #{overflow=wrap}
    out = with-cap(10)

    #{overflow=wrap}
    max-prefix = (1 << prefix-bits) - 1
    val < max-prefix -> {

        #{index-out=0}
        out[0] = prefix-byte | val
        return
    }

    ; 第一個 byte: prefix 全 1
    #{index-out=0}
    out[0] = prefix-byte | max-prefix
    n = 1

    #{overflow=wrap}
    r-val = r-val - max-prefix
    (r-val >= 128) {

        #{index-out=0, overflow=wrap}
        out[n] = (r-val & 127) | 128

        #{overflow=wrap}
        n = n + 1
        r-val = r-val >> 7
    }

    #{index-out=0}
    out[n] = r-val
}

; decode-int: 從 data 的 pos 位置解碼變長整數
; prefix-bits: 前綴位數
; 返回 val=解碼值, next-pos=下一個未讀位置（-1=錯誤）
decode-int = (data str, pos i64, prefix-bits i64) (val i64, next-pos i64) {

    #{overflow=wrap}
    val = 0
    next-pos = pos
    pos >= data.len-bytes() -> {
        next-pos = -1
        return
    }

    #{overflow=wrap}
    max-prefix = (1 << prefix-bits) - 1

    #{index-out=0}
    first = data[pos] & max-prefix
    val = first

    #{overflow=wrap}
    next-pos = pos + 1
    first < max-prefix -> return

    ; 多 byte 編碼
    m = 0
    !! {

        #{overflow=wrap}
        next-pos >= data.len-bytes() -> {
            next-pos = -1
            *
        }

        #{index-out=0}
        b = data[next-pos]

        #{overflow=wrap}
        next-pos = next-pos + 1

        #{overflow=wrap}
        val = val + ((b & 127) << m)

        #{overflow=wrap}
        m = m + 7
        (b & 128) == 0 -> *
        m >= 35 -> {
            next-pos = -1
            *
        }
    }
}

; ═══════════════════════════════════════════════
; 字串編解碼（RFC 7541 §5.2，不支援 Huffman）
; ═══════════════════════════════════════════════

; encode-str: 編碼字串（literal，H=0）
; 返回 out=編碼後字串
encode-str = (s str) (out str) {

    #{overflow=wrap}
    out = with-cap(s.len-bytes() + 8)

    ; H bit=0, 長度用 7-bit prefix 編碼
    len-out = ' '
    len-out = encode-int(s.len-bytes(), 7, 0)

    ; 複製長度編碼到 out
    i <- [0..len-out.len-bytes()): {

        #{index-out=0, overflow=wrap}
        out[i] = len-out[i]
    }
    out-n = len-out.len-bytes()

    ; 複製字串內容
    i <- [0..s.len-bytes()): {

        #{index-out=0, overflow=wrap}
        out[out-n + i] = s[i]
    }
}

; decode-str: 從 data 的 pos 位置解碼字串
; 返回 out=解碼字串, next-pos=下一個位置（-1=錯誤）
decode-str = (data str, pos i64) (out str, next-pos i64) {

    #{overflow=wrap}
    pos >= data.len-bytes() -> {
        next-pos = -1
        return
    }

    #{index-out=0}
    first = data[pos]

    ; H bit = first & 128，本實作不支援 Huffman
    ; 長度用 7-bit prefix
    len = 0
    p = 0
    len, p = decode-int(data, pos, 7)

    #{overflow=wrap}
    {
        p < 0 -> {
            next-pos = -1
            return
        }

        p + len > data.len-bytes() -> {
            next-pos = -1
            return
        }
    }

    ; 複製字串內容
    out = with-cap(len)
    i <- [0..len): {

        #{index-out=0, overflow=wrap}
        out[i] = data[p + i]
    }

    #{overflow=wrap}
    next-pos = p + len
}

; ═══════════════════════════════════════════════
; 標頭編解碼
; ═══════════════════════════════════════════════

; encode-header: 編碼單個標頭
; 策略：完全匹配→indexed；name 匹配→literal with indexing（用 name 索引）；
;       否則→literal with indexing（新 name）
; 返回 out=編碼字串
tables.encode-header = (name str, value str) (out str) {

    ; 1. 完全匹配 → Indexed Header Field（6.1）
    #{overflow=wrap}
    full-idx = 0
    full-idx = .find(name, value)
    full-idx > 0 -> {

        ; 格式：1xxxxxxx（高 1 位為 1，7-bit 索引）
        out = encode-int(full-idx, 7, 128)
        return
    }

    #{overflow=wrap}
    out = with-cap(name.len-bytes() + value.len-bytes() + 8)

    ; 2. name 匹配 → Literal with Incremental Indexing（6.2.1），name 用索引
    name-idx = 0
    name-idx = .find-name(name)

    #{overflow=wrap}
    name-idx > 0 -> {

        ; 格式：01xxxxxx（高 2 位為 01，6-bit 索引）
        idx-out = ' '
        idx-out = encode-int(name-idx, 6, 64)

        ; 複製到 out
        i <- [0..idx-out.len-bytes()): {

            #{index-out=0}
            out[i] = idx-out[i]
        }
        out-n = idx-out.len-bytes()

        ; 編碼 value
        val-out = ' '
        val-out = encode-str(value)
        i <- [0..val-out.len-bytes()): {

            #{index-out=0, overflow=wrap}
            out[out-n + i] = val-out[i]
        }

        ; 加入動態表
        .dyn-add(name, value)
        return
    }

    ; 3. 全新標頭 → Literal with Incremental Indexing（6.2.1），新 name
    ; 格式：01000000（索引 0 = 新 name）
    #{index-out=0}
    out[0] = 64
    out-n = 1

    ; 編碼 name
    name-out = ' '
    name-out = encode-str(name)
    i <- [0..name-out.len-bytes()): {

        #{index-out=0, overflow=wrap}
        out[out-n + i] = name-out[i]
    }

    #{overflow=wrap}
    out-n = out-n + name-out.len-bytes()

    ; 編碼 value
    val-out = ' '
    val-out = encode-str(value)
    i <- [0..val-out.len-bytes()): {

        #{index-out=0, overflow=wrap}
        out[out-n + i] = val-out[i]
    }

    ; 加入動態表
    .dyn-add(name, value)
}

; decode-headers: 解碼標頭塊
; data: 二進位資料
; 返回 names/values 陣列, count=標頭數, ok=true=成功
tables.decode-headers = (data str) (names [128]str, values [128]str, count i64, ok bool) {
    ok = false
    count = 0

    ; 初始化輸出陣列
    i <- [0..128): {

        #{index-out=0}
        names[i] = ''

        #{index-out=0}
        values[i] = ''
    }
    n = data.len-bytes()
    n == 0 -> {
        ok = true
        return
    }
    pos = 0
    !! {
        pos >= n -> *
        count >= 128 -> *

        #{index-out=0}
        b = data[pos]

        ; Indexed Header Field（6.1）：1xxxxxxx
        {
            (b & 128) != 0 -> {

                #{overflow=wrap}
                idx = 0
                next = 0
                idx, next = decode-int(data, pos, 7)
                next < 0 -> return
                lk-name = ''
                lk-val = ''
                found = false
                lk-name, lk-val, found = .lookup(idx)
                found == false -> return

                ; 複製到輸出
                ln-tmp str = ''.with-len(lk-name.len-bytes())
                j <- [0..lk-name.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    ln-tmp[j] = lk-name[j]
                }

                #{index-out=0}
                names[count] = ln-tmp
                lv-tmp str = ''.with-len(lk-val.len-bytes())
                j <- [0..lk-val.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    lv-tmp[j] = lk-val[j]
                }

                #{index-out=0}
                values[count] = lv-tmp

                #{overflow=wrap}
                count = count + 1
                pos = next
            }

            (b & 192) == 64 -> {

                ; Literal with Incremental Indexing（6.2.1）：01xxxxxx

                #{overflow=wrap}
                name-idx = 0
                next = 0
                name-idx, next = decode-int(data, pos, 6)
                next < 0 -> return
                pos = next
                name = ''
                value = ''
                {
                    name-idx == 0 -> {
                        name, pos = decode-str(data, pos)
                        pos < 0 -> return
                    }

                    -> {
                        lk-name = ''
                        lk-val = ''
                        found = false
                        lk-name, lk-val, found = .lookup(name-idx)
                        found == false -> return
                        name = lk-name
                    }
                }
                value, pos = decode-str(data, pos)
                pos < 0 -> return

                ; 複製到輸出
                nb-tmp str = ''.with-len(name.len-bytes())
                j <- [0..name.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    nb-tmp[j] = name[j]
                }

                #{index-out=0}
                names[count] = nb-tmp
                vb-tmp str = ''.with-len(value.len-bytes())
                j <- [0..value.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    vb-tmp[j] = value[j]
                }

                #{index-out=0}
                values[count] = vb-tmp

                #{overflow=wrap}
                count = count + 1

                ; 加入動態表
                .dyn-add(name, value)
            }

            (b & 240) == 0 -> {

                ; Literal without Indexing（6.2.2）：0000xxxx

                #{overflow=wrap}
                name-idx = 0
                next = 0
                name-idx, next = decode-int(data, pos, 4)
                next < 0 -> return
                pos = next
                name = ''
                value = ''
                {
                    name-idx == 0 -> {
                        name, pos = decode-str(data, pos)
                        pos < 0 -> return
                    }

                    -> {
                        lk-name = ''
                        lk-val = ''
                        found = false
                        lk-name, lk-val, found = .lookup(name-idx)
                        found == false -> return
                        name = lk-name
                    }
                }
                value, pos = decode-str(data, pos)
                pos < 0 -> return
                nb-tmp str = ''.with-len(name.len-bytes())
                j <- [0..name.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    nb-tmp[j] = name[j]
                }

                #{index-out=0}
                names[count] = nb-tmp
                vb-tmp str = ''.with-len(value.len-bytes())
                j <- [0..value.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    vb-tmp[j] = value[j]
                }

                #{index-out=0}
                values[count] = vb-tmp

                #{overflow=wrap}
                count = count + 1
            }

            (b & 240) == 16 -> {

                ; Literal Never Indexed（6.2.3）：0001xxxx

                #{overflow=wrap}
                name-idx = 0
                next = 0
                name-idx, next = decode-int(data, pos, 4)
                next < 0 -> return
                pos = next
                name = ''
                value = ''
                {
                    name-idx == 0 -> {
                        name, pos = decode-str(data, pos)
                        pos < 0 -> return
                    }

                    -> {
                        lk-name = ''
                        lk-val = ''
                        found = false
                        lk-name, lk-val, found = .lookup(name-idx)
                        found == false -> return
                        name = lk-name
                    }
                }
                value, pos = decode-str(data, pos)
                pos < 0 -> return
                nb-tmp str = ''.with-len(name.len-bytes())
                j <- [0..name.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    nb-tmp[j] = name[j]
                }

                #{index-out=0}
                names[count] = nb-tmp
                vb-tmp str = ''.with-len(value.len-bytes())
                j <- [0..value.len-bytes()): {

                    #{index-out=0, overflow=wrap}
                    vb-tmp[j] = value[j]
                }

                #{index-out=0}
                values[count] = vb-tmp

                #{overflow=wrap}
                count = count + 1
            }

            -> return
        }
        ; 未知表示類型
    }
    ok = true
}
