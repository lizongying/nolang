// cookie — HTTP Cookie 處理
//
// 提供 Cookie 的解析、建構與管理（Cookie Jar）功能。
// 支援 Set-Cookie 標頭解析、Cookie 標頭建構、Cookie 存儲與檢索。
// 支援基於 HMAC-SHA256 的簽名 Cookie，防止篡改。
//
// 用法：
//   // 解析 Set-Cookie 標頭
//   c = cookie-parse-set('sessionid=abc123; Path=/; HttpOnly; Secure')
//   c.valid -> {
//       print(c.name)        // 'sessionid'
//       print(c.value)       // 'abc123'
//       print(c.path)        // '/'
//       print(c.http-only)   // true
//       print(c.secure)      // true
//

//
//   // 建構 Cookie 標頭
//   jar = cookie-jar{}
//   jar.set('sessionid', 'abc123', '/', '', 0)
//   header = jar.build-header('example.com', '/api')  // 'sessionid=abc123'
//
//   // 簽名 Cookie
//   signed = cookie-sign('sessionid=abc123', secret-key)
//   // signed = 'sessionid=abc123.hmac-hex-signature'
//   ok = cookie-verify(signed, secret-key)
//   // ok = true 表示簽名驗證通過

// ═══════════════════════════════════════════════
// 常量
// ═══════════════════════════════════════════════

// Cookie Jar 最大容量
COOKIE-JAR-MAX = 64

// ═══════════════════════════════════════════════
// 結構體
// ═══════════════════════════════════════════════

// cookie: 單個 Cookie
// valid bool: 是否有效
// name str: Cookie 名稱
// value str: Cookie 值
// domain str: 域名
// path str: 路徑
// expires i64: 過期時間（Unix 毫秒，0=會話 Cookie）
// max-age i64: 最大存活秒數（-1=未設定）
// secure bool: 是否僅 HTTPS
// http-only bool: 是否禁止 JS 存取
// same-site str: SameSite 策略（'Strict', 'Lax', 'None'）
cookie {
    valid bool
    name str
    value str
    domain str
    path str
    expires i64
    max-age i64
    secure bool
    http-only bool
    same-site str
}

// cookie-jar: Cookie 存儲
// names [64]str: Cookie 名稱陣列
// values [64]str: Cookie 值陣列
// domains [64]str: 域名陣列
// paths [64]str: 路徑陣列
// count i64: 已存儲的 Cookie 數量
cookie-jar {
    names [64]str
    values [64]str
    domains [64]str
    paths [64]str
    count i64
}

// ═══════════════════════════════════════════════
// Cookie 解析
// ═══════════════════════════════════════════════

// cookie-parse-set: 解析 Set-Cookie 標頭值
// set-cookie-str str: Set-Cookie 標頭值（如 'name=value; Path=/; HttpOnly'）
// 返回 c cookie: 解析結果
cookie-parse-set = (set-cookie-str str) (c cookie) {
    c.valid = false
    c.name = ''
    c.value = ''
    c.domain = ''
    c.path = '/'
    c.expires = 0
    c.max-age = -1
    c.secure = false
    c.http-only = false
    c.same-site = ''

    set-cookie-str.len == 0 -> return

    // 第一個分號前為 name=value
    semi-pos = set-cookie-str.index(';')
    first-pair = set-cookie-str
    rest = ''
    semi-pos >= 0 -> {
        first-pair = set-cookie-str.slice(0, semi-pos)
        rest = set-cookie-str.slice(semi-pos + 1, set-cookie-str.len)
    }

    // 解析 name=value
    eq-pos = first-pair.index('=')
    eq-pos < 0 -> return
    c.name = first-pair.slice(0, eq-pos)

    // 去除前後空格
    c.name = c.name.trim()
    c.value = first-pair.slice(eq-pos + 1, first-pair.len)
    c.value = c.value.trim()

    c.name.len == 0 -> return
    c.valid = true

    // 解析屬性
    pos = 0
    !! {
        // 跳過前導空格
        for pos < rest.len && rest[pos] == 32 {
            pos = pos + 1
        }
        pos >= rest.len -> *
        // 找下一個分號
        next-semi = rest.index-from(';', pos)
        attr-end = next-semi
        attr-end < 0 -> attr-end = rest.len
        attr = rest.slice(pos, attr-end)
        attr = attr.trim()
        // 解析屬性
        attr-eq = attr.index('=')
        {
            attr-eq >= 0 -> {
                attr-name = attr.slice(0, attr-eq)
                attr-name = attr-name.trim()
                attr-name-lower = attr-name.to-lower()
                attr-val = attr.slice(attr-eq + 1, attr.len)
                attr-val = attr-val.trim()

                {
                    attr-name-lower == 'path' -> c.path = attr-val
                    attr-name-lower == 'domain' -> c.domain = attr-val
                    attr-name-lower == 'max-age' -> {
                        ma = 0
                        valid = true
                        j <- [0..attr-val.len): {
                            ch = attr-val[j]
                            ch < 48 || ch > 57 -> {
                                valid = false
                                break
                            }
                            ma = ma * 10 + ch - 48
                        }
                        valid -> c.max-age = ma
                    }
                    attr-name-lower == 'expires' -> {
                        // 簡化：不解析日期格式，記錄為已設定
                        c.expires = -1
                    }
                    attr-name-lower == 'samesite' -> c.same-site = attr-val
                    ->
                }
            }
            -> {
                attr-lower = attr.to-lower()
                {
                    attr-lower == 'secure' -> c.secure = true
                    attr-lower == 'httponly' -> c.http-only = true
                    ->
                }
            }
        }
        next-semi < 0 -> *
        pos = next-semi + 1
    }
}

// cookie-parse-header: 解析 Cookie 請求標頭
// cookie-header str: Cookie 標頭值（如 'name1=val1; name2=val2'）
// names [16]str: 輸出名稱陣列
// values [16]str: 輸出值陣列
// 返回 count i64: 解析出的 Cookie 數量
cookie-parse-header = (cookie-header str) (names [16]str, values [16]str, count i64) {
    count = 0
    cookie-header.len == 0 -> return
    pos = 0
    !! {
        // 跳過空格
        for pos < cookie-header.len && cookie-header[pos] == 32 {
            pos = pos + 1
        }
        pos >= cookie-header.len -> *
        // 找下一個分號
        next-semi = cookie-header.index-from(';', pos)
        pair-end = next-semi
        pair-end < 0 -> pair-end = cookie-header.len
        pair = cookie-header.slice(pos, pair-end)
        pair = pair.trim()
        eq-pos = pair.index('=')
        eq-pos >= 0 && count < 16 -> {
            names[count] = pair.slice(0, eq-pos)
            values[count] = pair.slice(eq-pos + 1, pair.len)
            count = count + 1
        }
        next-semi < 0 -> *
        pos = next-semi + 1
    }
}

// ═══════════════════════════════════════════════
// Cookie 建構
// ═══════════════════════════════════════════════

// cookie-build-set: 建構 Set-Cookie 標頭值
// c cookie: Cookie 結構體
// 返回 out str: Set-Cookie 標頭值
cookie-build-set = (c cookie) (out str) {
    out = c.name - '=' - c.value
    c.path.len > 0 -> out = out - '; Path=' - c.path
    c.domain.len > 0 -> out = out - '; Domain=' - c.domain
    c.max-age >= 0 -> {
        ma-s = c.max-age.to-str()
        out = out - '; Max-Age=' - ma-s
    }
    c.secure -> out = out - '; Secure'
    c.http-only -> out = out - '; HttpOnly'
    c.same-site.len > 0 -> out = out - '; SameSite=' - c.same-site
}

// cookie-build-header: 建構 Cookie 請求標頭
// names [16]str: Cookie 名稱陣列
// values [16]str: Cookie 值陣列
// count i64: Cookie 數量
// 返回 out str: Cookie 標頭值（如 'name1=val1; name2=val2'）
cookie-build-header = (names [16]str, values [16]str, count i64) (out str) {
    out = ''
    i <- [0..count): {
        out.len > 0 -> out = out - '; '
        out = out - names[i] - '=' - values[i]
    }
}

// ═══════════════════════════════════════════════
// Cookie Jar
// ═══════════════════════════════════════════════

// set: 設定 Cookie
// name str: Cookie 名稱
// value str: Cookie 值
// domain str: 域名
// path str: 路徑
// max-age i64: 最大存活秒數
cookie-jar.set = (name str, value str, domain str, path str, max-age i64) {
    // 檢查是否已存在同名 Cookie
    i <- [0...count): {
        .names[i] == name && .domains[i] == domain && .paths[i] == path -> {
            .values[i] = value
            return
        }
    }

    // 新增 Cookie
    .count < COOKIE-JAR-MAX -> {
        .names[.count] = name
        .values[.count] = value
        .domains[.count] = domain
        .paths[.count] = path
        .count = .count + 1
    }
}

// get: 取得 Cookie 值
// name str: Cookie 名稱
// domain str: 域名
// path str: 路徑
// 返回 val ?str: ok=Cookie 值, nil=未找到
cookie-jar.get = (name str, domain str, path str) (val ?str) {
    val = nil
    i <- [0...count): {
        .names[i] == name -> {
            // 域名匹配（簡化：精確匹配或子域名匹配）
            domain-match = false
            {
                .domains[i] == domain -> domain-match = true
                .domains[i].len > 0 -> {
                    domain.ends-with('.' - .domains[i]) -> domain-match = true
                }
                .domains[i].len == 0 -> domain-match = true
            }

            // 路徑匹配（簡化：前綴匹配）
            path-match = false
            {
                .paths[i] == '/' -> path-match = true
                path.starts-with(.paths[i]) -> path-match = true
            }
            domain-match && path-match -> {
                val = .values[i]
                return
            }
        }
    }
}

// delete: 刪除 Cookie
// name str: Cookie 名稱
// domain str: 域名
// path str: 路徑
cookie-jar.delete = (name str, domain str, path str) {
    i <- [0...count): {
        .names[i] == name && .domains[i] == domain && .paths[i] == path -> {
            // 將最後一個移到當前位置
            last = .count - 1
            i != last -> {
                .names[i] = .names[last]
                .values[i] = .values[last]
                .domains[i] = .domains[last]
                .paths[i] = .paths[last]
            }
            .count = .count - 1
            return
        }
    }
}

// build-header: 建構符合條件的 Cookie 請求標頭
// domain str: 請求目標域名
// path str: 請求目標路徑
// 返回 out str: Cookie 標頭值
cookie-jar.build-header = (domain str, path str) (out str) {
    out = ''
    i <- [0...count): {
        // 域名匹配
        domain-match = false
        {
            .domains[i].len == 0 -> domain-match = true
            .domains[i] == domain -> domain-match = true
            domain.ends-with('.' - .domains[i]) -> domain-match = true
        }
        // 路徑匹配
        path-match = false
        {
            .paths[i] == '/' -> path-match = true
            path.starts-with(.paths[i]) -> path-match = true
        }
        domain-match && path-match -> {
            out.len > 0 -> out = out - '; '
            out = out - .names[i] - '=' - .values[i]
        }
    }
}

// parse-response: 從 HTTP 回應的 Set-Cookie 標頭解析並存儲 Cookie
// set-cookie-str str: Set-Cookie 標頭值
// domain str: 回應來源的域名
// path str: 回應來源的路徑
cookie-jar.parse-response = (set-cookie-str str, domain str, path str) {
    c cookie
    c = cookie-parse-set(set-cookie-str)
    c.valid == false -> return

    // 如果 Cookie 未指定 domain，使用回應的 domain
    c.domain.len == 0 -> c.domain = domain

    // 如果 Cookie 未指定 path，使用回應的 path 的目錄
    c.path.len == 0 -> {
        slash-pos = -1
        i = path.len - 1
        for i >= 0 {
            path[i] == 47 -> {
                slash-pos = i
                break
            }
            i = i - 1
        }
        {
            slash-pos >= 0 -> c.path = path.slice(0, slash-pos + 1)
            -> c.path = '/'
        }
    }
    .set(c.name, c.value, c.domain, c.path, c.max-age)
}

// clear: 清空 Cookie Jar
cookie-jar.clear = () {
    .count = 0
}

// count-of: 取得 Cookie 數量
// 返回 n i64: Cookie 數量
cookie-jar.count-of = () (n i64) {
    n = .count
}

// ═══════════════════════════════════════════════
// 簽名 Cookie（HMAC-SHA256）
// ═══════════════════════════════════════════════

// cookie-sign: 對 Cookie 值進行 HMAC-SHA256 簽名
// name str: Cookie 名稱
// value str: Cookie 值
// key []byte: 簽名金鑰
// 返回 signed str: 簽名後的值（格式: value.hex-hmac）
cookie-sign = (name str, value str, key []byte) (signed str) {
    // 簽名內容 = name=value
    msg-str = name - '=' - value
    msg []byte = msg-str.to-bytes()
    mac [32]byte = hmac.hmac-sha256(key, msg)

    // 轉為 hex 字串
    hex-chars = '0123456789abcdef'
    space = ' '
    hex-str = space.repeat(64)
    i <- [0..32): {
        hex-str[i * 2] = hex-chars[(mac[i] >> 4) & 15]
        hex-str[i * 2 + 1] = hex-chars[mac[i] & 15]
    }
    signed = value - '.' - hex-str
}

// cookie-verify: 驗證簽名 Cookie
// name str: Cookie 名稱
// signed-value str: 簽名後的值（格式: value.hex-hmac）
// key []byte: 簽名金鑰
// 返回 ok bool: true=驗證通過
// 返回 value str: 原始 Cookie 值（驗證失敗時為空）
cookie-verify = (name str, signed-value str, key []byte) (ok bool, value str) {
    ok = false
    value = ''

    // 尋找最後一個 '.'
    dot-pos = -1
    i = signed-value.len - 1
    for i >= 0 {
        signed-value[i] == 46 -> {
            dot-pos = i
            break
        }
        i = i - 1
    }
    dot-pos < 0 -> return

    // 提取原始值和簽名
    value = signed-value.slice(0, dot-pos)
    provided-hex = signed-value.slice(dot-pos + 1, signed-value.len)

    // 計算期望的簽名
    expected-signed = cookie-sign(name, value, key)

    // 提取期望的 hex 部分
    expected-hex = expected-signed.slice(value.len + 1, expected-signed.len)

    // 比較簽名（常數時間比較）
    provided-hex.len != expected-hex.len -> {
        value = ''
        return
    }
    diff = 0
    i <- [0..provided-hex.len): {
        diff = diff | (provided-hex[i] ^ expected-hex[i])
    }
    {
        diff == 0 -> ok = true
        -> value = ''
    }
}

// cookie-jar.set-signed: 設定簽名 Cookie
// name str: Cookie 名稱
// value str: Cookie 值
// domain str: 域名
// path str: 路徑
// max-age i64: 最大存活秒數
// key []byte: 簽名金鑰
cookie-jar.set-signed = (name str, value str, domain str, path str, max-age i64, key []byte) {
    signed-value = cookie-sign(name, value, key)
    .set(name, signed-value, domain, path, max-age)
}

// cookie-jar.get-verified: 取得並驗證簽名 Cookie
// name str: Cookie 名稱
// domain str: 域名
// path str: 路徑
// key []byte: 簽名金鑰
// 返回 val ?str: ok=原始 Cookie 值, nil=未找到或驗證失敗
cookie-jar.get-verified = (name str, domain str, path str, key []byte) (val ?str) {
    val = nil
    signed-val ?str = .get(name, domain, path)
    signed-val: {
        nil -> return
        err -> return
        ok -> {
            verified-ok = false
            verified-val = ''
            verified-ok, verified-val = cookie-verify(name, it, key)
            {
                verified-ok -> val = verified-val
                -> val = nil
            }
        }
    }
}