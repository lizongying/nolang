// multipart — Multipart/form-data 編解碼（RFC 2046）
//
// 提供 HTTP multipart/form-data 的編碼（用於檔案上傳）與解析功能。
// 支援文字欄位和檔案欄位，自動生成邊界（boundary）。
// 支援 AES-256-GCM 加密檔案上傳，保護敏感資料。
//
// 用法：
//   // 建構 multipart 請求體
//   w = multipart-create()
//   w.write-field('name', 'Alice')
//   w.write-file('avatar', 'photo.jpg', 'image/jpeg', file-data)
//   w.close-form()
//   body = w.body()
//   ct = w.content-type()
//   // 設定 HTTP 標頭
//   req.add-header('Content-Type', ct)
//   resp = http-post('http://example.com/upload', body)
//
//   // 加密檔案上傳
//   w = multipart-create()
//   w.write-encrypted-file('secret', 'data.bin', 'application/octet-stream', file-data, key, iv)
//   w.close-form()
//   // 接收端使用 multipart-reader 解析後，用 aes-256-gcm-open 解密
//
//   // 解析 multipart 回應
//   r = multipart-parse(boundary, body)
//   r: {
//       nil -> print('parse failed')
//       -> {
//           r: {
//               ok -> {
//                   name = r.field-name()
//                   data = r.field-data()
//               }
//               -> break
//           }
//       }
//   }

// ═══════════════════════════════════════════════
// 常量
// ═══════════════════════════════════════════════

// 邊界前綴
MULTIPART-BOUNDARY-PREFIX = '----NolangBoundary'

// 最大欄位數
MULTIPART-MAX-FIELDS = 32

// 邊界長度
MULTIPART-BOUNDARY-LEN = 32

// ═══════════════════════════════════════════════
// 工具函數
// ═══════════════════════════════════════════════

// multipart-gen-boundary: 生成隨機邊界字串
// seed i64: 隨機種子（輸入/輸出）
// 返回 boundary str: 邊界字串
multipart-gen-boundary = (seed i64) (boundary str) {
    boundary = MULTIPART-BOUNDARY-PREFIX
    chars = 'abcdefghijklmnopqrstuvwxyz0123456789'
    prefix-len = boundary.len
    i <- [0..16): {
        seed, r = rand.rand(seed)
        boundary[prefix-len + i] = chars[r % 36]
    }
}

// ═══════════════════════════════════════════════
// multipart-writer 結構體
// ═══════════════════════════════════════════════

// multipart-writer: Multipart 表單編碼器
// boundary str: 邊界字串
// body str: 已建構的請求體
// closed bool: 是否已關閉（已寫入結束邊界）
// seed i64: 隨機種子
multipart-writer {
    boundary str
    body str
    closed bool
    seed i64
}

// init: 初始化編碼器（自動生成邊界）
// 返回 ok=true=成功
multipart-writer.init = () (ok bool) {
    ok = true
    .seed = 123456789
    .boundary = multipart-gen-boundary(.seed)
    .body = ''
    .closed = false
}

// init-boundary: 使用指定邊界初始化
// boundary str: 邊界字串
multipart-writer.init-boundary = (boundary str) {
    .boundary = boundary
    .body = ''
    .closed = false
    .seed = 0
}

// write-field: 寫入文字欄位
// name str: 欄位名稱
// value str: 欄位值
// 返回 ok=true=成功
multipart-writer.write-field = (name str, value str) (ok bool) {
    ok = false
    .closed -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    .body = .body - '--' - .boundary - crlf
    .body = .body - 'Content-Disposition: form-data; name="' - name - '"' - crlf
    .body = .body - crlf
    .body = .body - value - crlf
    ok = true
}

// write-file: 寫入檔案欄位
// name str: 欄位名稱
// filename str: 檔案名稱
// content-type str: 內容類型（如 'image/jpeg'）
// content str: 檔案內容
// 返回 ok=true=成功
multipart-writer.write-file = (name str, filename str, content-type str, content str) (ok bool) {
    ok = false
    .closed -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    .body = .body - '--' - .boundary - crlf
    .body = .body - 'Content-Disposition: form-data; name="' - name - '"; filename="' - filename - '"' - crlf
    .body = .body - 'Content-Type: ' - content-type - crlf
    .body = .body - crlf
    .body = .body - content - crlf
    ok = true
}

// close-form: 寫入結束邊界，完成表單
// 返回 ok=true=成功
multipart-writer.close-form = () (ok bool) {
    ok = false
    .closed -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    .body = .body - '--' - .boundary - '--' - crlf
    .closed = true
    ok = true
}

// body-of: 取得已建構的請求體
// 返回 body str
multipart-writer.body-of = () (body str) {
    body = .body
}

// boundary-of: 取得邊界字串
// 返回 boundary str
multipart-writer.boundary-of = () (boundary str) {
    boundary = .boundary
}

// content-type: 取得 Content-Type 標頭值
// 返回 ct str: 如 'multipart/form-data; boundary=----NolangBoundary...'
multipart-writer.content-type = () (ct str) {
    ct = 'multipart/form-data; boundary=' - .boundary
}

// ═══════════════════════════════════════════════
// multipart-reader 結構體（解析）
// ═══════════════════════════════════════════════

// multipart-part: 單個 multipart 部分
// name str: 欄位名稱
// filename str: 檔案名稱（空=非檔案）
// content-type str: 內容類型（空=未指定）
// data str: 部分資料
multipart-part {
    name str
    filename str
    content-type str
    data str
}

// multipart-reader: Multipart 表單解析器
// boundary str: 邊界字串
// data str: 原始資料
// pos i64: 當前解析位置
// end i64: 資料總長度
// current multipart-part: 當前部分
// has-current bool: 是否有當前部分
multipart-reader {
    boundary str
    data str
    pos i64
    end i64
    current multipart-part
    has-current bool
}

// init: 初始化解析器
// boundary str: 邊界字串（不含 '--' 前綴）
// data str: 原始資料
multipart-reader.init = (boundary str, data str) {
    .boundary = boundary
    .data = data
    .end = data.len
    .pos = 0
    .has-current = false
}

// parse-headers: 解析部分標頭
// header-block str: 標頭區塊（不含結尾 CRLFCRLF）
// part multipart-part: 輸出，解析結果
multipart-reader.parse-headers = (header-block str, part multipart-part) {
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    pos = 0
    !! {
        // 找到下一個 CRLF
        next-crlf = header-block.index-from(crlf, pos)
        next-crlf < 0 -> {
            // 最後一行
            line = header-block.slice(pos, header-block.len)
            .parse-header-line(line, part)
            break
        }
        line = header-block.slice(pos, next-crlf)
        .parse-header-line(line, part)
        pos = next-crlf + 2
        pos >= header-block.len -> break
    }
}

// parse-header-line: 解析單個標頭行
// line str: 標頭行
// part multipart-part: 輸出，解析結果
multipart-reader.parse-header-line = (line str, part multipart-part) {
    // Content-Disposition: form-data; name="field"; filename="file.txt"
    line.starts-with('Content-Disposition:') -> {
        // 提取 name
        name-marker = 'name="'
        name-pos = line.index(name-marker)
        name-pos >= 0 -> {
            name-start = name-pos + name-marker.len
            name-end = line.index-from('"', name-start)
            name-end >= 0 -> part.name = line.slice(name-start, name-end)
        }

        // 提取 filename
        file-marker = 'filename="'
        file-pos = line.index(file-marker)
        file-pos >= 0 -> {
            file-start = file-pos + file-marker.len
            file-end = line.index-from('"', file-start)
            file-end >= 0 -> part.filename = line.slice(file-start, file-end)
        }
    }

    line.starts-with('Content-Type:') -> {
        ct-start = 13
        part.content-type = line.slice(ct-start, line.len)
        part.content-type = part.content-type.trim()
    }
}

// next: 前進到下一個部分
// 返回 has-part bool: true=有下一個部分, false=已到結尾
multipart-reader.next = () (has-part bool) {
    has-part = false
    .has-current = false

    .pos >= .end -> return
    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    // 尋找邊界行: --boundary
    boundary-marker = '--' - .boundary
    marker-pos = .data.index-from(boundary-marker, .pos)
    marker-pos < 0 -> return

    // 檢查是否為結束邊界: --boundary--
    after-marker = marker-pos + boundary-marker.len
    after-marker + 1 < .end -> .data[after-marker] == 45 && .data[after-marker + 1] == 45 -> {
        // '--' = 結束邊界
        .pos = .end
        return
    }

    // 跳過邊界行後的 CRLF
    header-start = after-marker
    header-start + 1 < .end -> .data[header-start] == 13 && .data[header-start + 1] == 10 -> header-start = header-start + 2

    // 尋找標頭結束（CRLFCRLF）
    header-end-marker = crlf - crlf
    header-end = .data.index-from(header-end-marker, header-start)
    header-end < 0 -> return

    // 解析標頭
    header-block = .data.slice(header-start, header-end)
    part multipart-part
    .parse-headers(header-block, part)

    // 資料起始 = 標頭結束 + CRLFCRLF
    data-start = header-end + 4

    // 尋找下一個邊界（資料結束位置）
    next-boundary = .data.index-from(boundary-marker, data-start)
    next-boundary < 0 -> return

    // 資料結束 = 下一個邊界前 - CRLF
    data-end = next-boundary - 2
    data-end < data-start -> data-end = data-start
    part.data = .data.slice(data-start, data-end)
    .current = part
    .has-current = true
    .pos = next-boundary
    has-part = true
}

// field-name: 取得當前欄位名稱
// 返回 name str
multipart-reader.field-name = () (name str) {
    name = .current.name
}

// field-filename: 取得當前檔案名稱
// 返回 filename str: 空=非檔案欄位
multipart-reader.field-filename = () (filename str) {
    filename = .current.filename
}

// field-content-type: 取得當前內容類型
// 返回 ct str: 空=未指定
multipart-reader.field-content-type = () (ct str) {
    ct = .current.content-type
}

// field-data: 取得當前欄位資料
// 返回 data str
multipart-reader.field-data = () (data str) {
    data = .current.data
}

// is-file: 判斷當前部分是否為檔案
// 返回 yes bool: true=檔案
multipart-reader.is-file = () (yes bool) {
    yes = false
    .current.filename.len > 0 -> yes = true
}

// has-current-part: 判斷是否有當前部分
// 返回 yes bool
multipart-reader.has-current-part = () (yes bool) {
    yes = .has-current
}

// ═══════════════════════════════════════════════
// 便捷函數
// ═══════════════════════════════════════════════

// multipart-create: 建立新的 multipart 編碼器
// 返回 w ?multipart-writer: ok=編碼器, nil=失敗
multipart-create = () (w ?multipart-writer) {
    w = nil
    writer = multipart-writer{}
    ok = false
    ok = writer.init()
    ok -> w = writer
}

// multipart-create-boundary: 使用指定邊界建立編碼器
// boundary str: 邊界字串
// 返回 w multipart-writer
multipart-create-boundary = (boundary str) (w multipart-writer) {
    w.init-boundary(boundary)
}

// multipart-parse: 從 Content-Type 標頭和請求體解析 multipart
// content-type str: Content-Type 標頭值（含 boundary=...）
// body str: 請求體
// 返回 r ?multipart-reader: ok=解析器, nil=失敗
multipart-parse = (content-type str, body str) (r ?multipart-reader) {
    r = nil

    // 從 Content-Type 提取 boundary
    boundary-marker = 'boundary='
    bpos = content-type.index(boundary-marker)
    bpos < 0 -> return
    bstart = bpos + boundary-marker.len

    // 處理可能的引號
    {
        bstart < content-type.len -> {
            content-type[bstart] == 34 -> {
                // 引號開始，找結束引號
                bstart = bstart + 1
                bend = content-type.index-from('"', bstart)
                bend < 0 -> return
                boundary = content-type.slice(bstart, bend)
            }
            -> {
                // 無引號，取到行尾或分號
                bend = content-type.index-from(';', bstart)
                bend < 0 -> bend = content-type.len
                boundary = content-type.slice(bstart, bend)
                boundary = boundary.trim()
            }
        }
        -> return
    }

    reader = multipart-reader{}
    reader.init(boundary, body)
    r = reader
}

// multipart-extract-boundary: 從 Content-Type 提取 boundary 值
// content-type str: Content-Type 標頭值
// 返回 boundary str: 邊界字串（空=未找到）
multipart-extract-boundary = (content-type str) (boundary str) {
    boundary = ''
    boundary-marker = 'boundary='
    bpos = content-type.index(boundary-marker)
    bpos < 0 -> return
    bstart = bpos + boundary-marker.len
    bstart < content-type.len -> {
        content-type[bstart] == 34 -> {
            bstart = bstart + 1
            bend = content-type.index-from('"', bstart)
            bend < 0 -> return
            boundary = content-type.slice(bstart, bend)
        }
        -> {
            bend = content-type.index-from(';', bstart)
            bend < 0 -> bend = content-type.len
            boundary = content-type.slice(bstart, bend)
            boundary = boundary.trim()
        }
    }
}

// ═══════════════════════════════════════════════
// 加密檔案上傳（AES-256-GCM）
// ═══════════════════════════════════════════════

// multipart-writer.write-encrypted-file: 寫入 AES-256-GCM 加密檔案欄位
// name str: 欄位名稱
// filename str: 檔案名稱
// content-type str: 內容類型
// content str: 檔案明文內容
// key [32]byte: AES-256 金鑰
// iv [12]byte: GCM IV（nonce）
// 返回 ok=true=成功
multipart-writer.write-encrypted-file = (name str, filename str, content-type str, content str, key [32]byte, iv [12]byte) (ok bool) {
    ok = false
    .closed -> return

    // 加密內容（AAD 為空，檔案加密不需要額外認證資料）
    plain []byte = content.to-bytes()
    aad []byte
    sealed []byte = aes-256-gcm.aes-256-gcm-seal(key, iv, aad, plain)

    // 將 IV + 密文轉為 Base64 字串
    // 格式: base64(iv || sealed)
    combined []byte
    i <- [0..12): {
        combined[i] = iv[i]
    }
    sealed-n = sealed.len
    i <- [0..sealed-n): {
        combined[12 + i] = sealed[i]
    }
    combined-n = 12 + sealed-n
    enc-str = base64.encode-std(combined)

    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    .body = .body - '--' - .boundary - crlf
    .body = .body - 'Content-Disposition: form-data; name="' - name - '"; filename="' - filename - '"' - crlf
    .body = .body - 'Content-Type: ' - content-type - crlf
    .body = .body - 'X-Encryption: aes-256-gcm' - crlf
    .body = .body - crlf
    .body = .body - enc-str - crlf
    ok = true
}

// multipart-writer.write-encrypted-field: 寫入 AES-256-GCM 加密文字欄位
// name str: 欄位名稱
// value str: 明文值
// key [32]byte: AES-256 金鑰
// iv [12]byte: GCM IV
// 返回 ok=true=成功
multipart-writer.write-encrypted-field = (name str, value str, key [32]byte, iv [12]byte) (ok bool) {
    ok = false
    .closed -> return

    // 加密值
    plain []byte = value.to-bytes()
    aad []byte = name.to-bytes()
    sealed []byte = aes-256-gcm.aes-256-gcm-seal(key, iv, aad, plain)

    // 將 IV + 密文轉為 Base64
    combined []byte
    i <- [0..12): {
        combined[i] = iv[i]
    }
    sealed-n = sealed.len
    i <- [0..sealed-n): {
        combined[12 + i] = sealed[i]
    }
    combined-n = 12 + sealed-n
    enc-str = base64.encode-std(combined)

    cr = char-to-str(13)
    lf = char-to-str(10)
    crlf = cr - lf

    .body = .body - '--' - .boundary - crlf
    .body = .body - 'Content-Disposition: form-data; name="' - name - '"' - crlf
    .body = .body - 'X-Encryption: aes-256-gcm' - crlf
    .body = .body - crlf
    .body = .body - enc-str - crlf
    ok = true
}

// multipart-decrypt-field: 解密加密的 multipart 欄位資料
// encrypted-data str: Base64 編碼的加密資料（含 12 byte IV 前綴）
// key [32]byte: AES-256 金鑰
// aad []byte: 額外認證資料（欄位名稱）
// 返回 plain ?str: ok=解密後明文, nil=解密失敗
multipart-decrypt-field = (encrypted-data str, key [32]byte, aad []byte) (plain ?str) {
    plain = nil

    // Base64 解碼
    raw []byte
    dec = base64.decode(encrypted-data, base64.BASE64-STD)
    dec: {
        ok -> raw = it
        nil -> return
        err -> return
    }
    raw.len < 12 -> return

    // 提取 IV（前 12 位元組）
    iv [12]byte
    i <- [0..12): {
        iv[i] = raw[i]
    }

    // 提取密文+tag
    sealed []byte
    sealed-n = raw.len - 12
    i <- [0..sealed-n): {
        sealed[i] = raw[12 + i]
    }

    // 解密
    opened []byte = aes-256-gcm.aes-256-gcm-open(key, iv, aad, sealed)
    opened.len == 0 -> {
        plain = err('decryption failed')
        return
    }
    plain = opened.to-str()
}