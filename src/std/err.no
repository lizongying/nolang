; err — 錯誤處理
;
; 提供結構化的錯誤型別與工具函式。
; err 結構體封裝錯誤碼、訊息與發生位置（file / line / col），code 枚舉定義常見錯誤類別。
;
; 用法：
;   e = err.new('disk full', code.io)
;   yes = e.is(err.code.io)
;   s = e.format()     ; => 'code.io: disk full'（含錯誤碼與位置）

; ═══════════════════════════════════════════════
; 錯誤碼枚舉
; ═══════════════════════════════════════════════

; code: 錯誤類別
code {
    ok,
    not-found,
    permission,
    io,
    timeout,
    parse,
    invalid,
    overflow,
    unknown,
}

; 取得錯誤碼變體名（不帶 code. 前綴）
; 返回 s: 變體名（如 'ok' / 'not-found' / 'io'）
; 用法：
;   n = code.io.to-name()     ; => 'io'
; [to-name](#err.code.to-name)
code.to-name = () (s str) {
    .: {
        ok -> s = 'ok'

        not-found -> s = 'not-found'

        permission -> s = 'permission'

        io -> s = 'io'

        timeout -> s = 'timeout'

        parse -> s = 'parse'

        invalid -> s = 'invalid'

        overflow -> s = 'overflow'

        -> s = 'unknown'
    }
}

; ═══════════════════════════════════════════════
; 錯誤結構體
; ═══════════════════════════════════════════════

; err: 結構化錯誤
; code: 錯誤碼（code 枚舉值）
; msg: 人類可讀的錯誤描述文本
; file / line / col: 錯誤發生位置（由編譯器在構造點自動注入；手動建構時留空字串與 0）
err {
    code code
    msg str
    file str
    line i64
    col i64
}

; ═══════════════════════════════════════════════
; 建構函式
; ═══════════════════════════════════════════════

; 建立錯誤
; msg: 寫入錯誤實例的描述文本
; ec: 錯誤碼（code 枚舉值，如 code.io；省略時為 code.unknown）
; e: 構造出的錯誤實例（位置字段留空）
; [new](#err.new)
new = (msg str, ec code = code.unknown) (e err) {
    e = err {
        code: ec
        msg: msg
        file: ''
        line: 0
        col: 0
    }
}

; 建立帶位置的錯誤（位置由呼叫方明確提供）
; msg: 寫入錯誤實例的描述文本
; ec: 要附著的錯誤碼（code 枚舉值）
; file: 錯誤發生的源檔名
; line: 錯誤發生的行號
; col: 錯誤發生的列號
; e: 帶完整位置資訊的錯誤實例
; [new-at](#err.new-at)
new-at = (msg str, ec code, file str, line i64, col i64) (e err) {
    e = err {
        code: ec
        msg: msg
        file: file
        line: line
        col: col
    }
}

; 將 C errno 對映為 code 列舉（模組內私有，僅 from-errno 使用）
; errno: 待對映的 C errno 數值（如 2=ENOENT、13=EACCES）
; ec: 對應的 code 枚舉值（未收錄的 errno 一律落到 code.unknown）
; [_errno-to-code](#err._errno-to-code)
_errno-to-code = (errno i64) (ec code) {
    {
        errno == 0 -> ec = code.ok

        errno == 2 -> ec = code.not-found

        errno == 1 || errno == 13 || errno == 30 || errno == 79 -> ec = code.permission

        errno == 5 || errno == 32 || errno == 100 || errno == 104 || errno == 112 || errno == 113 -> ec = code.io

        errno == 11 || errno == 35 || errno == 110 -> ec = code.timeout

        errno == 84 -> ec = code.parse

        errno == 12 || errno == 28 || errno == 34 || errno == 75 -> ec = code.overflow

        -> ec = code.unknown
    }
}

; 從 C errno 建立錯誤
; errno: C 標準錯誤碼（如 13 = EACCES）
; e: 錯誤實例（msg 取自 os.strerror(errno)、code 經 _errno-to-code 對映，無位置資訊）
; [from-errno](#err.from-errno)
from-errno = (errno i64) (e err) {
    msg = os.strerror(errno)
    e = err {
        code: _errno-to-code(errno)
        msg: msg
        file: ''
        line: 0
        col: 0
    }
}

; ═══════════════════════════════════════════════
; 查詢函式
; ═══════════════════════════════════════════════

; 檢查錯誤碼是否匹配
; ec: 要匹配的錯誤碼
; 返回 yes: 是否匹配
; [is](#err.is)
err.is = (ec code) (yes bool) {
    .code == ec -> yes = true
}

; 取得錯誤訊息
; 返回 msg str: 錯誤物件攜帶的訊息文字；非錯誤值時為空串
; [msg](#err.msg)
err.msg = () (msg str) {
    msg = .msg
}

; 取得錯誤碼
; 返回 ec: 錯誤碼
; [code](#err.code)
err.code = () (ec code) {
    ec = .code
}

; ═══════════════════════════════════════════════
; 格式化
; ═══════════════════════════════════════════════

; 格式化錯誤為完整資訊字串
; 返回 s: 'code.<變體名>: <msg>'，有位置資訊時附加 ' at <file>:<line>:<col>'
; 用法：
;   s = err.new('disk full', code.io).format()   ; => 'code.io: disk full'
;   e = err('no such file', code.not-found)      ; 位置由編譯器注入
;   t = e.format()                               ; => 'code.not-found: no such file at main.no:12:3'
; 純訊息請用 err.msg()，只要錯誤碼請用 err.code()
; [format](#err.format)
err.format = () (s str) {
    cn = .code.to-name()

    ; format() 的 {…} 欄位目前只認「簡單標識符」，不解析接收者的 `.field`
    ; 存取（MIR lowerFormatField 會對 `{.file}` 報 unresolved format field）。
    ; 故先把接收者欄位绑到局部變量，再以簡單名插值；cn/loc 已示範簡單名可用。
    fn = .file
    ln = .line
    cl = .col
    mt = .msg
    loc = ''
    .file != '' -> {
        loc = format(' at {fn}:{ln}:{cl}')
    }
    s = format('code.{cn}: {mt}{loc}')
}
