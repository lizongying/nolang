; err — 錯誤處理
;
; 提供結構化的錯誤型別與工具函式。
; error 結構體封裝錯誤碼與訊息，code 枚舉定義常見錯誤類別。
;
; 用法：
;   e = err.new(code.io, 'disk full')
;   yes = e.is(code.io)
;   s = e.format()

; ═══════════════════════════════════════════════
; 錯誤碼枚舉
; ═══════════════════════════════════════════════

; code: 錯誤類別
code {
    ok,
    not-found,
    permission,
    io,
    timeout,
    parse,
    invalid,
    overflow,
}

; ═══════════════════════════════════════════════
; 錯誤結構體
; ═══════════════════════════════════════════════

; error: 結構化錯誤
; code: 錯誤碼（code 枚舉值）
; msg: 錯誤訊息
error {
    code code
    msg str
}

; ═══════════════════════════════════════════════
; 建構函式
; ═══════════════════════════════════════════════

; new: 建立錯誤
; ec: 錯誤碼（code 枚舉值，如 code.io）
; msg: 錯誤訊息
new = (ec code, msg str) (e error) {
    e = error{
        code: ec
        msg: msg
    }
}

; errno-to-code: 將 C errno 對映為 code 列舉
errno-to-code = (errno i64) (ec code) {
    ec = code.invalid
    {
        errno == 0 -> ec = code.ok
        errno == 2 -> ec = code.not-found
        errno == 1 || errno == 13 || errno == 30 || errno == 79 -> ec = code.permission
        errno == 5 || errno == 32 || errno == 100 || errno == 104 || errno == 112 || errno == 113 -> ec = code.io
        errno == 11 || errno == 35 || errno == 110 -> ec = code.timeout
        errno == 84 -> ec = code.parse
        errno == 12 || errno == 28 || errno == 34 || errno == 75 -> ec = code.overflow
    }
}

; err-from-errno: 從 C errno 建立錯誤
; errno: C 標準錯誤碼（如 13 = EACCES）
err-from-errno = (errno i64) (e error) {
    msg = os.strerror(errno)
    e = error{
        code: errno-to-code(errno)
        msg: msg
    }
}

; ═══════════════════════════════════════════════
; 查詢函式
; ═══════════════════════════════════════════════

; error.is: 檢查錯誤碼是否匹配
; ec: 要匹配的錯誤碼
; 返回 yes: 是否匹配
error.is = (ec code) (yes bool) {
    .code == ec -> yes = true
}

; error.msg: 取得錯誤訊息
; 返回 msg: 錯誤訊息
error.msg = () (msg str) {
    msg = .msg
}

; error.code: 取得錯誤碼
; 返回 ec: 錯誤碼
error.code = () (ec code) {
    ec = .code
}

; ═══════════════════════════════════════════════
; 格式化
; ═══════════════════════════════════════════════

; error.format: 格式化錯誤為字串
; 返回 s: 錯誤訊息
error.format = () (s str) {
    s = .msg
}
