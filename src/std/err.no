// err — 錯誤處理
//
// 提供結構化的錯誤型別與工具函式。
// error 結構體封裝錯誤碼與訊息，err-code 枚舉定義常見錯誤類別。
//
// 用法：
//   e = err-new(err-code.io, 'disk full')
//   yes = err-is(e, err-code.io)
//   s, n = err-format(e)

// ═══════════════════════════════════════════════
// 錯誤碼枚舉
// ═══════════════════════════════════════════════

// err-code: 錯誤類別
err-code {
    ok,
    not-found,
    permission,
    io,
    timeout,
    parse,
    invalid,
    overflow,
}

// ═══════════════════════════════════════════════
// 錯誤結構體
// ═══════════════════════════════════════════════

// error: 結構化錯誤
// code: 錯誤碼（err-code 枚舉值）
// msg: 錯誤訊息
error {
    code err-code
    msg str
}

// ═══════════════════════════════════════════════
// 建構函式
// ═══════════════════════════════════════════════

// err-new: 建立錯誤
// code: 錯誤碼（err-code 枚舉值，如 err-code.io）
// msg: 錯誤訊息
err-new = (code err-code, msg str) (e error) {
    e = error{
        code: code
        msg: msg
    }
}

// errno-to-code: 將 C errno 對映為 err-code 列舉
errno-to-code = (errno i64) (code err-code) {
    code = err-code.invalid
    {
        errno == 0 -> code = err-code.ok
        errno == 2 -> code = err-code.not-found
        errno == 1 || errno == 13 || errno == 30 || errno == 79 -> code = err-code.permission
        errno == 5 || errno == 32 || errno == 100 || errno == 104 || errno == 112 || errno == 113 -> code = err-code.io
        errno == 11 || errno == 35 || errno == 110 -> code = err-code.timeout
        errno == 84 -> code = err-code.parse
        errno == 12 || errno == 28 || errno == 34 || errno == 75 -> code = err-code.overflow
    }
}

// err-from-errno: 從 C errno 建立錯誤
// errno: C 標準錯誤碼（如 13 = EACCES）
err-from-errno = (errno i64) (e error) {
    msg = strerror(errno)
    e = error{
        code: errno-to-code(errno)
        msg: msg
    }
}

// ═══════════════════════════════════════════════
// 查詢函式
// ═══════════════════════════════════════════════

// err-is: 檢查錯誤碼是否匹配
err-is = (e error, code err-code) (yes bool) {
    yes = false
    e.code == code -> yes = true
}

// err-msg: 取得錯誤訊息
err-msg = (e error) (msg str) {
    msg = e.msg
}

// err-code-of: 取得錯誤碼
err-code-of = (e error) (code err-code) {
    code = e.code
}

// ═══════════════════════════════════════════════
// 格式化
// ═══════════════════════════════════════════════

// err-format: 格式化錯誤為字串
// 輸出: s 為錯誤訊息，n 為字串長度
err-format = (e error) (s str, n i64) {
    s = e.msg
    n = s.len
}
