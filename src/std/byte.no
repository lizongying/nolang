; byte — 位元組操作
;
; 提供 int64 與 []byte 之間的轉換。
;
; 用法：
;   v = 0x1234
;   out = v.to-bytes-be()       // out = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x12, 0x34]
;   out = v.to-bytes-le()       // out = [0x34, 0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
;
;   data = [0x12, 0x34]
;   v = data.to-i64-be()        // v = 0x1234
;   v = data.to-i64-le()        // v = 0x3412
;
;   [n]byte 與 []byte 互轉請使用 arr.to-vec() / []byte.to-arr()

; []byte.len: 回傳位元組切片長度
; byte 是獨立類型，非 u8 別名，因此 []byte.len 不會從 []t.len 自動實例化。
[]byte.len = () (out i64) {
    out = .len()
}

; i64.to-bytes-be: 將 int64 轉為大端序 8 位元組
i64.to-bytes-be = () (out [?]byte) {
    out[0] = (. >> 56) & 255
    out[1] = (. >> 48) & 255
    out[2] = (. >> 40) & 255
    out[3] = (. >> 32) & 255
    out[4] = (. >> 24) & 255
    out[5] = (. >> 16) & 255
    out[6] = (. >> 8) & 255
    out[7] = . & 255
}

; i64.to-bytes-le: 將 int64 轉為小端序 8 位元組
i64.to-bytes-le = () (out [?]byte) {
    out[0] = . & 255
    out[1] = (. >> 8) & 255
    out[2] = (. >> 16) & 255
    out[3] = (. >> 24) & 255
    out[4] = (. >> 32) & 255
    out[5] = (. >> 40) & 255
    out[6] = (. >> 48) & 255
    out[7] = (. >> 56) & 255
}

; []byte.to-i64-be: 將大端序位元組轉為 int64（1~8 位元組）
[]byte.to-i64-be = () (v i64) {
    v = 0
    n = .len()
    i <- [0..n): {
        v = (v << 8) | (.[i])
    }
}

; []byte.to-i64-le: 將小端序位元組轉為 int64（1~8 位元組）
[]byte.to-i64-le = () (v i64) {
    v = 0
    n = .len()
    i <- [0..n): {

        #{overflow=wrap}
        v = v | ((.[i]) << (i * 8))
    }
}

; []byte.to-chars: 将字节切片转为字符切片（每个字节当作一个 char 码点，0~255）
; 返回 []char。char 在 nolang 中是 32 位码点类型；byte（0~255）被当作单字节码点，
; 故推送前用 &0xff 拓宽为 0~255 的码点值，保证 []char 槽被完整填充。
;
; ⚠️ 编译器限制：当前 legacy 与 MIR 后端对 []char（i32 元素）切片的支持均不完整
; （与 []byte / []i64 不同，[]char 的 len/cap/stride 在 codegen 中存在隐性错误，
; 构造成的 []char 运行期会越界损坏），故本方法暂不可用。
; 若只需要「byte→码点→UTF-8 字符串」的最终结果，直接用 b.to-str() 即可——
; []byte.to-str 已内联本语义（每个 byte 当 0~255 码点重新 UTF-8 编码），无需经过 []char。
[]byte.to-chars = () (out []char) {
    n = .len()
    cs []char = with-cap(n)
    i <- [0..n): {
        cs.push(.[i] & 0xff)
    }
    out = cs
}

; []byte.to-str: 将字节切片按「先 to-chars 再 to-str」语义转成字符串。
; 每个字节被当作一个 0~255 的 Unicode 码点，再按 UTF-8 编码成 1~4 字节。
; 即本方法等价于 b.to-chars().to-str()：byte 0xC3 → 码点 0xC3 → UTF-8 字节 0xC3 0x83。
;
; 实现说明（2026-09-06）：legacy 后端对「返回字符串 out 做变量下标赋值 out[pos]=」不会
; 维护字符串长度（会带出尾部空字节），但对「字面下标 s[0]/s[1]/…」会正确维护长度（见
; char.to-str：with-cap(4) + 字面下标，返回长度正确）。故本实现逐字节构造一个
; with-cap(4) 的局部 seg（用字面下标写入 UTF-8 字节），再用字符串拼接 out = out - seg
; 累积（拼接模式与 vec.no 的 []t.to-str 一致，已验证可靠）。不使用变量下标，规避长度 bug。
;
; ⚠️ 语义变更（2026-09-06，应需求方要求）：此前本方法是「1:1 逐字节拷贝」，是
; buf.to-str()（读取文件 / 子进程输出，buf 已是合法 UTF-8 字节流）所依赖的契约。
; 改为「byte→码点→UTF-8 重新编码」后，对合法的多字节 UTF-8 字节流会做二次编码而损坏
; （例如磁盘上读到的 0xC3 0xA9 会被当成码点 0xC3、0xA9 各自重编码）。若需「原样拷贝
; 合法 UTF-8 字节流」（文件 / 子进程读取场景），请改用保留了 1:1 拷贝语义的
; b.to-bytes-str()（见下方），或直接使用底层切片。
[]byte.to-str = () (out ?str) {
    n = .len()
    r str = with-len(0)
    i <- [0..n): {
        #{overflow=wrap}
        cp = .[i] & 0xff
        seg str = with-cap(4)
        cp < 0x80 -> seg[0] = cp

        -> cp < 0x800 -> {
            seg[0] = 0xc0 | ((cp >> 6) & 0x1f)
            seg[1] = 0x80 | (cp & 0x3f)
        } -> cp < 0x10000 -> {
            seg[0] = 0xe0 | ((cp >> 12) & 0x0f)
            seg[1] = 0x80 | ((cp >> 6) & 0x3f)
            seg[2] = 0x80 | (cp & 0x3f)
        } -> {
            seg[0] = 0xf0 | ((cp >> 18) & 0x07)
            seg[1] = 0x80 | ((cp >> 12) & 0x3f)
            seg[2] = 0x80 | ((cp >> 6) & 0x3f)
            seg[3] = 0x80 | (cp & 0x3f)
        }

        #{overflow=wrap}
        r = r - seg
    }
    out = r
}

; []byte.to-bytes-str: 1:1 逐字节拷贝（保留原 []byte.to-str 语义）。
; 用于 buf 已经是合法 UTF-8 字节流的场景（读取文件 / 子进程输出），不需要按码点重编码。
; 该函数等价于旧版 []byte.to-str。
[]byte.to-bytes-str = () (out str) {
    n = .len()
    out = with-len(n)
    i <- [0..n): {
        out[i] = .[i]
    }
}

; []byte.index: 在 []byte 中查找 target 子串
; 返回首次出现的位置，未找到返回 -1
[]byte.index = (target str) (pos i64) {
    #{overflow=wrap}
    pos = -1
    tn = target.len-bytes()
    tn == 0 -> {
        pos = 0
        return
    }
    n = .len()

    #{overflow=wrap}
    limit = n - tn
    i = 0
    {
        #{overflow=wrap}
        matched = 1
        j <- [0..tn): {

            #{overflow=wrap}
            sj = .[i + j]
            tj = target[j]
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
        #{overflow=wrap}
        i = i + 1
    } (i <= limit)
}

; []byte.index-from: 在 []byte 中從 from 位置開始查找 target 子串
; 返回首次出現的位置，未找到返回 -1
[]byte.index-from = (target str, from i64) (pos i64) {
    #{overflow=wrap}
    pos = -1
    tn = target.len-bytes()
    tn == 0 -> {
        n = .len()
        from <= n -> pos = from
        return
    }
    from < 0 -> from = 0
    n = .len()

    #{overflow=wrap}
    limit = n - tn
    i = from
    {
        #{overflow=wrap}
        matched = 1
        j <- [0..tn): {

            #{overflow=wrap}
            sj = .[i + j]
            tj = target[j]
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }
        #{overflow=wrap}
        i = i + 1
    } (i <= limit)
}

; []byte.slice: 截取子切片 [start, end)
; 返回新切片
[]byte.slice = (start i64, end i64) (val []byte) {
    #{overflow=wrap}
    start < 0 -> start = 0
    end > .len() -> end = .len()
    start >= end -> return

    #{overflow=wrap}
    n = end - start
    val = with-len(n)
    i <- [0..n): {

        #{overflow=wrap}
        val[i] = .[start + i]
    }
}

; ─── 十六進制編碼 ─────────────────────────────

; HEX-UPPER: 大寫十六進制字元表
HEX-UPPER = '0123456789ABCDEF'

; HEX-LOWER: 小寫十六進制字元表
HEX-LOWER = '0123456789abcdef'

; []byte.to-hex: 將 []byte 編碼為大寫十六進制字串
[]byte.to-hex = () (out str) {
    #{overflow=wrap}
    n = .len()

    #{overflow=wrap}
    out = with-len(n * 2)
    i <- [0..n): {
        #{overflow=wrap}
        b = .[i]
        #{overflow=wrap}
        out[i * 2] = HEX-UPPER[b >> 4]
        #{overflow=wrap}
        out[i * 2 + 1] = HEX-UPPER[b & 15]
    }
}

; []byte.to-hex-lower: 將 []byte 編碼為小寫十六進制字串
[]byte.to-hex-lower = () (out str) {
    #{overflow=wrap}
    n = .len()

    #{overflow=wrap}
    out = with-len(n * 2)
    i <- [0..n): {
        #{overflow=wrap}
        b = .[i]
        #{overflow=wrap}
        out[i * 2] = HEX-LOWER[b >> 4]
        #{overflow=wrap}
        out[i * 2 + 1] = HEX-LOWER[b & 15]
    }
}

; byte.to-str: 將 byte 轉為字串（"65" → "65"）
; build-in (CLibCall: sprintf "%hhu")
; byte.to-str = () (out str) {  // LLVM: zext i8 to i64 → sprintf(buf, "%hhu", .)
; }

; ═══════════════════════════════════════════════
; txt 转换
; ═══════════════════════════════════════════════

; []byte.to-txt: 将 []byte 转换为 txt（截断至 255 字节）
; 返回 out txt: 固定 256 字节的 txt 结构
[]byte.to-txt = () (out txt) {
    n = .len()
    n > 255 -> n = 255
    i <- [0..n): {
        out[i] = .[i]
    }
    out.len = n
}
