; byte — 位元組操作
;
; 提供 int64 與 []byte 之間的轉換。
;
; 用法：
;   v = 0x1234
;   out = v.to-bytes-be()       // out = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x12, 0x34]
;   out = v.to-bytes-le()       // out = [0x34, 0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
;
;   data = [0x12, 0x34]
;   v = data.to-i64-be()        // v = 0x1234
;   v = data.to-i64-le()        // v = 0x3412
;
;   [n]byte 與 []byte 互轉請使用 arr.to-vec() / []byte.to-arr()

; []byte.len: 回傳位元組切片長度
; byte 是獨立類型，非 u8 別名，因此 []byte.len 不會從 []t.len 自動實例化。
; [len](#bytes.len)
[]byte.len = () (out i64) {
    out = .len()
}

; []byte.to-i64-be: 將大端序位元組轉為 int64（1~8 位元組）
; [to-i64-be](#bytes.to-i64-be)
[]byte.to-i64-be = () (v i64) {
    v = 0
    n = .len()
    i <- [0..n): {
        v = (v << 8) | (.[i])
    }
}

; []byte.to-i64-le: 將小端序位元組轉為 int64（1~8 位元組）
; [to-i64-le](#bytes.to-i64-le)
[]byte.to-i64-le = () (v i64) {
    v = 0
    n = .len()
    i <- [0..n): {

        v = v | ((.[i]) << (i * 8))
    }
}

; []byte.to-chars: 將字節切片轉為字符切片（每個字節當作一個 char 碼點，0~255）
; 返回 []char。char 在 nolang 中是 32 位碼點類型；byte（0~255）被當作單字節碼點，
; 故推送前用 &0xff 拓寬為 0~255 的碼點值，保證 []char 槽被完整填充。
;
; ⚠️ 編譯器限制：當前 legacy 與 MIR 後端對 []char（i32 元素）切片的支持均不完整
; （與 []byte / []i64 不同，[]char 的 len/cap/stride 在 codegen 中存在隱性錯誤，
; 構造成的 []char 運行期會越界損壞），故本方法暂不可用。
; 若只需要「byte→碼點→UTF-8 字符串」的最終結果，直接用 b.to-str() 即可——
; []byte.to-str 已內聯本語義（每個 byte 當 0~255 碼點重新 UTF-8 編碼），無需經過 []char。
; [to-chars](#bytes.to-chars)
[]byte.to-chars = () (out []char) {
    n = .len()
    cs []char = with-cap(n)
    i <- [0..n): {
        cs.push(.[i] & 0xff)
    }
    out = cs
}

; []byte.to-str: 將字節切片按「先 to-chars 再 to-str」語義轉成字符串。
; 每個字節被當作一個 0~255 的 Unicode 碼點，再按 UTF-8 編碼成 1~4 字節。
; 即本方法等價於 b.to-chars().to-str()：byte 0xC3 → 碼點 0xC3 → UTF-8 字節 0xC3 0x83。
;
; 實現说明（2026-09-06）：legacy 後端對「返回字符串 out 做變量下標賦值 out[pos]=」不會
; 维護字符串長度（會帶出尾部空字節），但對「字面下標 s[0]/s[1]/…」會正確维護長度（見
; char.to-str：with-cap(4) + 字面下標，返回長度正確）。故本實現逐字節構造一個
; with-cap(4) 的局部 seg（用字面下標寫入 UTF-8 字節），再用字符串拼接 out = out - seg
; 累积（拼接模式與 vec.no 的 []t.to-str 一致，已驗證可靠）。不使用變量下標，規避長度 bug。
;
; ⚠️ 語義變更（2026-09-06，應需求方要求）：此前本方法是「1:1 逐字節拷貝」，是
; buf.to-str()（讀取文件 / 子進程输出，buf 已是合法 UTF-8 字節流）所依赖的契約。
; 改為「byte→碼點→UTF-8 重新編碼」後，對合法的多字節 UTF-8 字節流會做二次編碼而損壞
; （例如磁盘上讀到的 0xC3 0xA9 會被當成碼點 0xC3、0xA9 各自重編碼）。若需「原樣拷貝
; 合法 UTF-8 字節流」（文件 / 子進程讀取場景），請改用保留了 1:1 拷貝語義的
; b.to-bytes-str()（見下方），或直接使用底層切片。
; [to-str](#bytes.to-str)
[]byte.to-str = () (out ?str) {
    n = .len()
    r str = with-len(0)
    i <- [0..n): {

        cp = .[i] & 0xff
        seg str = with-cap(4)

        ; 注意：seg 是 with-cap 出來的 len=0 緩衝，不可用 `seg[0]: { ok -> it = v }`
        ; 這種 D9 place-match 寫入——它以「讀」作閘門，len=0 時讀 seg[0] 越界回 nil，
        ; ok 臂永不執行，seg 永遠是空串（曾使本方法靜默回空字串）。
        ; with-cap 基底被 idxwrite lint 豁免，可直接下標寫入。
        cp < 0x80 -> {

            seg[0] = cp
        }

        -> cp < 0x800 -> {

            seg[0] = 0xc0 | ((cp >> 6) & 0x1f)

            seg[1] = 0x80 | (cp & 0x3f)
        } -> cp < 0x10000 -> {

            seg[0] = 0xe0 | ((cp >> 12) & 0x0f)

            seg[1] = 0x80 | ((cp >> 6) & 0x3f)

            seg[2] = 0x80 | (cp & 0x3f)
        } -> {

            seg[0] = 0xf0 | ((cp >> 18) & 0x07)

            seg[1] = 0x80 | ((cp >> 12) & 0x3f)

            seg[2] = 0x80 | ((cp >> 6) & 0x3f)

            seg[3] = 0x80 | (cp & 0x3f)
        }

        r = r - seg
    }
    out = r
}

; []byte.to-bytes-str: 1:1 逐字節拷貝（保留原 []byte.to-str 語義）。
; 用於 buf 已經是合法 UTF-8 字節流的場景（讀取文件 / 子進程输出），不需要按碼點重編碼。
; 該函數等價於舊版 []byte.to-str。
; [to-bytes-str](#bytes.to-bytes-str)
[]byte.to-bytes-str = () (out str) {
    n = .len()
    out = with-len(n)
    i <- [0..n): {

        out[i] = .[i]
    }
}

; []byte.index: 在 []byte 中查找 target 子串
; 返回首次出現的位置，未找到返回 -1
; [index](#bytes.index)
[]byte.index = (target str) (pos i64) {

    pos = -1
    tn = target.len-bytes()
    tn == 0 -> {
        pos = 0
        return
    }
    n = .len()

    #{overflow=wrap}
    limit = n - tn
    i = 0
    (i <= limit) {

        matched = 1
        j <- [0..tn): {

            #{overflow=wrap}
            sj = .[i + j]

            tj = target.byte(j)
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; []byte.index-from: 在 []byte 中從 from 位置開始查找 target 子串
; 返回首次出現的位置，未找到返回 -1
; [index-from](#bytes.index-from)
[]byte.index-from = (target str, from i64) (pos i64) {

    pos = -1
    tn = target.len-bytes()
    tn == 0 -> {
        n = .len()
        from <= n -> pos = from
        return
    }
    from < 0 -> from = 0
    n = .len()

    #{overflow=wrap}
    limit = n - tn
    i = from
    (i <= limit) {

        matched = 1
        j <- [0..tn): {

            #{overflow=wrap}
            sj = .[i + j]

            tj = target.byte(j)
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; []byte.slice: 截取子切片 [start, end)
; 返回新切片
; [slice](#bytes.slice)
[]byte.slice = (start i64, end i64) (val []byte) {

    start < 0 -> start = 0
    end > .len() -> end = .len()
    start >= end -> return

    #{overflow=wrap}
    n = end - start
    val = with-len(n)
    i <- [0..n): {

        #{overflow=wrap}
        val[i] = .[start + i]
    }
}

; ─── 十六進制編碼 ─────────────────────────────

; 大寫十六進制字元表
HEX-UPPER = '0123456789ABCDEF'

; 小寫十六進制字元表
HEX-LOWER = '0123456789abcdef'

; []byte.to-hex: 將 []byte 編碼為大寫十六進制字串
; [to-hex](#bytes.to-hex)
[]byte.to-hex = () (out str) {

    n = .len()

    #{overflow=wrap}
    out = with-len(n * 2)
    i <- [0..n): {

        b = .[i]

        #{overflow=wrap}
        out[i * 2] = HEX-UPPER[b >> 4]

        #{overflow=wrap}
        out[i * 2 + 1] = HEX-UPPER[b & 15]
    }
}

; []byte.to-hex-lower: 將 []byte 編碼為小寫十六進制字串
; [to-hex-lower](#bytes.to-hex-lower)
[]byte.to-hex-lower = () (out str) {

    n = .len()

    #{overflow=wrap}
    out = with-len(n * 2)
    i <- [0..n): {

        b = .[i]

        #{overflow=wrap}
        out[i * 2] = HEX-LOWER[b >> 4]

        #{overflow=wrap}
        out[i * 2 + 1] = HEX-LOWER[b & 15]
    }
}

; byte.to-str: 將 byte 轉為字串（"65" → "65"）
; build-in (CLibCall: sprintf "%hhu")
; byte.to-str = () (out str) {  // LLVM: zext i8 to i64 → sprintf(buf, "%hhu", .)
; }

; ═══════════════════════════════════════════════
; txt 轉換
; ═══════════════════════════════════════════════

; []byte.to-txt: 將 []byte 轉換為 txt（截斷至 255 字節）
; 返回 out txt: 固定 256 字節的 txt 結構
; [to-txt](#bytes.to-txt)
[]byte.to-txt = () (out txt) {
    n = .len()
    n > 255 -> n = 255
    i <- [0..n): {
        out.set-byte(i, .[i])
    }
    out.len = n
}
