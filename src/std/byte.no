; byte — 位元組操作
;
; 提供 int64 與 []byte 之間的轉換。
;
; 用法：
;   v = 0x1234
;   out = v.to-bytes-be()       // out = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x12, 0x34]
;   out = v.to-bytes-le()       // out = [0x34, 0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
;
;   data = [0x12, 0x34]
;   v = data.to-i64-be()        // v = 0x1234
;   v = data.to-i64-le()        // v = 0x3412
;
;   [n]byte 與 []byte 互轉請使用 arr.to-vec() / []byte.to-arr()
; [byte](#byte)

; []byte.len: 回傳位元組切片長度
; byte 是獨立類型，非 u8 別名，因此 []byte.len 不會從 []t.len 自動實例化。
; [len](#bytes.len)
[]byte.len = () (out i64) {
    out = .len()
}

; []byte.to-i64-be: 將大端序位元組轉為 int64（1~8 位元組）
; [to-i64-be](#bytes.to-i64-be)
[]byte.to-i64-be = () (v i64) {
    v = 0
    n = .len()
    i <- [0..n): {
        v = (v << 8) | (.[i])
    }
}

; []byte.to-i64-le: 將小端序位元組轉為 int64（1~8 位元組）
; [to-i64-le](#bytes.to-i64-le)
[]byte.to-i64-le = () (v i64) {
    v = 0
    n = .len()
    i <- [0..n): {
        v = v | ((.[i]) << (i * 8))
    }
}

; []byte.to-chars: 將字節切片轉為字符切片（每個字節當作一個 char 碼點，0~255）
; 返回 []char。char 在 nolang 中是 32 位碼點類型；byte（0~255）被當作單字節碼點，
; 故推送前用 &0xff 拓寬為 0~255 的碼點值，保證 []char 槽被完整填充。
;
; ⚠️ 編譯器限制：當前 legacy 與 MIR 後端對 []char（i32 元素）切片的支持均不完整
; （與 []byte / []i64 不同，[]char 的 len/cap/stride 在 codegen 中存在隱性錯誤，
; 構造成的 []char 運行期會越界損壞），故本方法暂不可用。
; 若只需要把 byte 序列原樣轉成 str，直接用 b.to-str() 即可——
; []byte.to-str 是 1:1 byte 拷貝，不重新做 UTF-8 編碼，也無需經過 []char。
; [to-chars](#bytes.to-chars)
[]byte.to-chars = () (out []char) {
    n = .len()
    cs []char = with-cap(n)
    i <- [0..n): {
        cs.push(.[i] & 0xff)
    }
    out = cs
}

; []byte.to-str: 1:1 逐字節拷貝成 str。
; 每個 byte 原樣成為 str 的一個字節，不按 Unicode 碼點重新編碼；因此對合法 UTF-8
; 字節流（文件 / 子進程輸出 / 網絡 payload）結果保持原樣。若結果並非合法 UTF-8，
; 本方法仍原樣返回，由呼叫方決定如何解讀。
;
; 返回 ?str 是歷史簽名：1:1 拷貝按構造不會失敗，但呼叫點仍須明確解包，避免
; option 被靜默當作 plain str 使用。推薦寫法：
;   s-opt = buf.to-str()
;   s = s-opt: {
;       ok -> it
;
;       nil || err -> ''
;   }
;
; 實現走 str.from-chars：把每個字節當成 0~255 的碼點塞進 []char，再由內建
; 一次建成 len=cap=n 的 str（每 char 只取低 8 位，正好是 1:1 位元組拷貝）。
; str 的下標寫入已全域禁用，這是唯一不碰私有 _set-byte 的公開路徑。
; [to-str](#bytes.to-str)
[]byte.to-str = () (out ?str) {
    n = .len()
    cs []char
    i <- [0..n): {
        cs.push(.[i] & 0xff)
    }
    r str = str.from-chars(cs)
    out = r
}

; []byte.pretty: 字面量風格的位元組列表，如 [0xc3, 0xa9]。
; 空切片輸出 []。small hex、0x 前綴、", " 分隔。
; [pretty](#bytes.pretty)
[]byte.pretty = () (out str) {
    n = .len()
    out = '['
    i <- [0..n): {
        i > 0 -> out = out - ', '
        b = .[i]
        one []byte = [b]
        out = out - '0x' - one.to-hex-lower()
    }
    out = out - ']'
}

; []byte.index: 在 []byte 中查找 target 子串
; 返回首次出現的位置，未找到返回 -1
; [index](#bytes.index)
[]byte.index = (target str) (pos i64) {
    pos = -1
    tn = target.len-bytes()
    tn == 0 -> {
        pos = 0
        return
    }
    n = .len()

    #{overflow=wrap}
    limit = n - tn
    i = 0
    (i <= limit) {
        matched = 1
        j <- [0..tn): {

            #{overflow=wrap}
            sj = .[i + j]

            tj = target.byte(j)
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; []byte.index-from: 在 []byte 中從 from 位置開始查找 target 子串
; 返回首次出現的位置，未找到返回 -1
; [index-from](#bytes.index-from)
[]byte.index-from = (target str, from i64) (pos i64) {
    pos = -1
    tn = target.len-bytes()
    tn == 0 -> {
        n = .len()
        from <= n -> pos = from
        return
    }
    from < 0 -> from = 0
    n = .len()

    #{overflow=wrap}
    limit = n - tn
    i = from
    (i <= limit) {
        matched = 1
        j <- [0..tn): {

            #{overflow=wrap}
            sj = .[i + j]

            tj = target.byte(j)
            sj != tj -> {
                matched = 0
                break
            }
        }
        matched == 1 -> {
            pos = i
            return
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; []byte.slice: 截取子切片 [start, end)
; 返回新切片
; [slice](#bytes.slice)
[]byte.slice = (start i64, end i64) (val []byte) {
    start < 0 -> start = 0
    end > .len() -> end = .len()
    start >= end -> return

    #{overflow=wrap}
    n = end - start
    val = with-len(n)
    i <- [0..n): {

        #{overflow=wrap}
        val[i] = .[start + i]
    }
}

; 十六進制編碼
...

; 大寫十六進制字元表
; [HEX-UPPER](#byte.hex-upper)
HEX-UPPER = '0123456789ABCDEF'

; 小寫十六進制字元表
; [HEX-LOWER](#byte.hex-lower)
HEX-LOWER = '0123456789abcdef'

; []byte.to-hex: 將 []byte 編碼為大寫十六進制字串
; [to-hex](#bytes.to-hex)
[]byte.to-hex = () (out str) {
    n = .len()

    #{overflow=wrap}
    m = n * 2
    buf []byte = with-cap-len(m, m)
    i <- [0..n): {
        b = .[i]

        #{overflow=wrap}
        buf[i * 2] = HEX-UPPER[b >> 4]

        #{overflow=wrap}
        buf[i * 2 + 1] = HEX-UPPER[b & 15]
    }
    tb0o = buf.to-str()
    tb0v = tb0o: {
        ok -> it
    
        nil || err -> ''
    }
    out = tb0v
}

; []byte.to-hex-lower: 將 []byte 編碼為小寫十六進制字串
; [to-hex-lower](#bytes.to-hex-lower)
[]byte.to-hex-lower = () (out str) {
    n = .len()

    #{overflow=wrap}
    m = n * 2
    buf []byte = with-cap-len(m, m)
    i <- [0..n): {
        b = .[i]

        #{overflow=wrap}
        buf[i * 2] = HEX-LOWER[b >> 4]

        #{overflow=wrap}
        buf[i * 2 + 1] = HEX-LOWER[b & 15]
    }
    tb1o = buf.to-str()
    tb1v = tb1o: {
        ok -> it
    
        nil || err -> ''
    }
    out = tb1v
}

; byte.to-str: 將 byte 轉為字串（"65" → "65"）
; build-in (CLibCall: sprintf "%hhu")
; byte.to-str = () (out str) {  // LLVM: zext i8 to i64 → sprintf(buf, "%hhu", .)
; }

; txt 轉換
...

; []byte.to-txt: 將 []byte 轉換為 txt（截斷至 255 字節）
; 返回 out: 固定 256 字節的 txt 結構
; [to-txt](#bytes.to-txt)
[]byte.to-txt = () (out txt) {

    ; 委派 txt.from-bytes：clamp 到 255 + 逐位元組拷入內聯緩衝 + 設 len，
    ; 與原本手寫的迴圈等價。txt._set-byte 已私有（raqvyltn 擋跨模組），
    ; 這裡走公開構造器即可。
    ; 歷史：`txt.from-bytes(.)` / `(self)` 曾讓 codegen 段錯誤（2026-11-11），
    ; 根因與 str.to-txt 相同（hir2mir 的隱式 self 出參錯位），已修並由
    ; tests/bare-self-arg.no 覆蓋；裸 `.` 現在可直傳，`b = self` 保留無害。
    b = .
    out = txt.from-bytes(b)
}
