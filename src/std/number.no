; number — 數字操作（方法形式 API）
;
; std 數字系全部「方法形式」API 集中於本模組：具體型別 to-str
; （i64/i32/i16/i8/u64/u32/u16/u8/byte/f64/f32）、f64/f32 數學方法
; （sqrt, cbrt, 三角/雙曲, ceil/floor/round/trunc, exp/log, degrees/radians）、
; 整數 sqrt / is-prime。
; 「函數形式」API（max, min, pow, hypot, atan2, fmod, clamp, even, odd, gcd,
; lcm, div, mod, swap, arr-zero, 型別轉換, 數字轉字串底層函數, 位元操作）
; 全部在 math 模組（std/math.no）；唯一例外：整數冪 pow（int 泛型）與
; math 的 pow（f64）同名衝突，留在本模組。
; 聯合型別別名與成員方法：num → std/num.no, int → std/int.no,
; float → std/float.no。
; 範圍常數（用於範圍檢查，如 str.to-i8 等）：i8/i16/i32/i64/u8/u16/u32/u64
; 的 MIN/MAX 與 INF 保留在本模組。

; ═══════════════════════════════════════════════
; 數值範圍常數（用於範圍檢查，如 str.to-i8 等）
; ═══════════════════════════════════════════════

; i8: -128 ~ 127
i8.MIN = -128
i8.MAX = 127

; i16: -32768 ~ 32767
i16.MIN = -32768
i16.MAX = 32767

; i32: -2147483648 ~ 2147483647
i32.MIN = -2147483648
i32.MAX = 2147483647

; i64: -9223372036854775808 ~ 9223372036854775807
; MIN 不可直接寫為字面量（解析器不支援），用 -MAX - 1 表達
i64.MAX = 9223372036854775807

#{overflow=wrap}
i64.MIN = 0 - 9223372036854775807 - 1

; u8: 0 ~ 255
u8.MIN = 0
u8.MAX = 255

; u16: 0 ~ 65535
u16.MIN = 0
u16.MAX = 65535

; u32: 0 ~ 4294967295
u32.MIN = 0
u32.MAX = 4294967295

; u64: 0 ~ 18446744073709551615
; MAX 無法用整數字面量表示（超過 i64 上限），可透過 0 - 1 間接取得
u64.MIN = 0

#{overflow=wrap}
u64.MAX = 0 - 1

; i128: -170141183460469231731687303715884105728 ~ 170141183460469231731687303715884105727
; 型別層常量取值經 hir2mir 的 typeConstantText128 常數表（i128 lane 走
; 全精度十進位文字），以下定義為 API/文件用（與其他寬度一致）
i128.MAX = 170141183460469231731687303715884105727
i128.MIN = -170141183460469231731687303715884105728

; u128: 0 ~ 340282366920938463463374607431768211455
u128.MIN = 0
u128.MAX = 340282366920938463463374607431768211455

INF = 1.0 / 0.0

; int.to-str 聯合方法已移至 std/int.no（此處保留具體型別 i64.to-str 等方法）

; i64.to-str: i64 轉字串
i64.to-str = () (out str) {
    out = math.i64-to-str(.)
}

; i32.to-str: i32 轉字串（隱式拓寬至 i64）
i32.to-str = () (out str) {
    out = math.i64-to-str(.)
}

; i16.to-str: i16 轉字串
i16.to-str = () (out str) {
    out = math.i64-to-str(.)
}

; i8.to-str: i8 轉字串
i8.to-str = () (out str) {
    out = math.i64-to-str(.)
}

; u64.to-str: u64 轉字串
u64.to-str = () (out str) {
    out = math.u64-to-str(.)
}

; u32.to-str: u32 轉字串（隱式拓寬至 u64）
u32.to-str = () (out str) {
    out = math.u64-to-str(.)
}

; u16.to-str: u16 轉字串
u16.to-str = () (out str) {
    out = math.u64-to-str(.)
}

; u8.to-str: u8 轉字串
u8.to-str = () (out str) {
    out = math.u64-to-str(.)
}

; byte.to-str: byte 轉字串（無號，等同 u8）
byte.to-str = () (out str) {
    out = math.u64-to-str(.)
}

; f64.to-str: f64 轉字串（方法）
f64.to-str = () (out str) {
    out = math.f64-to-str(.)
}

; f32.to-str: f32 轉字串（方法）
; 透過 f32-to-f64 拓寬後委託 f64-to-str，取代 sprintf %g CLibCall
f32.to-str = () (out str) {
    d = math.f32-to-f64(.)
    out = math.f64-to-str(d)
}

; ═══════════════════════════════════════════════
; 數值寬度轉換方法（取代已棄用的 math 函數形式）
;   f64-to-i64(.) -> .to-i64()   i64-to-f64(.) -> .to-f64()
;   f32-to-f64(.) -> .to-f64()   f64-to-f32(.) -> .to-f32()
; 底層仍委託 #{buildin} 的 math.* 內在函數。
; ═══════════════════════════════════════════════

; f64.to-i64: 浮點轉整數（截斷）
f64.to-i64 = () (out i64) {
    out = math.f64-to-i64(.)
}

; i64.to-f64: 整數轉浮點
i64.to-f64 = () (out f64) {
    out = math.i64-to-f64(.)
}

; f32.to-f64: 將 f32 提升為 f64
f32.to-f64 = () (out f64) {
    out = math.f32-to-f64(.)
}

; f64.to-f32: 將 f64 降為 f32（可能損失精度）
f64.to-f32 = () (out f32) {
    out = math.f64-to-f32(.)
}

; 注意：不定義 float.to-str 聯合方法（原因見 std/float.no 末尾說明）。

; int.div / int.mod 已移至 std/int.no；float.div 已移至 std/float.no

; float.is-nan / float.is-inf 已移至 std/float.no

; f32 同名方法：以下所有 f64 方法均配 f32 版本，方法體統一
; 「f32-to-f64 拓寬 → 調 f64 方法 → f64-to-f32 收窄」（同上方
; f32.to-str 先例），以 double 精度計算後收窄。不寫成 float
; union 泛型方法：#{buildin} 空體樁沒有函數體可供 monomorphizeUnions
; 單態化複製；純 .no 方法（degrees/radians/cbrt）的 f32 實例體內
; f32*f64 混合算術會被提升成 f64，破壞「接收者 f32 → 返回 f32」。
; 故具體雙套（f64./f32.）是唯一穩定形態。

; 幂与根（f64/f32 方法）
#{buildin}
f64.sqrt = () (res f64) {
}

f32.sqrt = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.sqrt().to-f32()
}

; cbrt: 立方根（f64 方法）
; 使用 exp(log(|x|) / 3) 實現；方法體不调 pow（整數冪 pow 見本模組，f64 pow 見 std/math.no）
f64.cbrt = () (res f64) {
    . == 0.0 -> {
        res = 0.0
        return
    }
    {
        . < 0.0 -> {
            ax f64 = 0.0 - .
            l f64 = ax.log()
            t f64 = l / 3.0
            res = 0.0 - exp-f64(t)
        }

        -> {
            l f64 = .log()
            t f64 = l / 3.0
            res = exp-f64(t)
        }
    }
}

f32.cbrt = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.cbrt().to-f32()
}

; pow: 整數冪 base^n（n ≥ 0，i64）—— 供 number.pow 呼叫（模組前綴）。
; 與 math.no 的 f64 pow 同名但不同模組，構建期加 number. 前綴；
; 與 math.pow-int（int 泛型快速冪）同義，但明確 i64 簽名以符合
; test/std/number.no 的 number.pow(2, 10) 等斷言。
pow = (base i64, n i64) (res i64) {
    rn = n
    res = 1
    b = base
    (rn > 0) {

        #{overflow=wrap}
        rn & 1 == 1 -> res = res * b

        #{overflow=wrap}
        b = b * b
        rn = rn >> 1
    }
}

; 三角函数（弧度；f64/f32 方法）
f64.sin = () (res f64) {
    twopi = 6.283185307179586
    pi = 3.141592653589793
    ax = .
    ax < 0.0 -> {
        ax = 0.0 - ax
    }
    q = (ax / twopi).to-i64()
    y = ax - q.to-f64() * twopi
    sgn = 1.0
    . < 0.0 -> {
        sgn = -1.0
    }
    y > pi -> {
        y = y - pi
        sgn = 0.0 - sgn
    }
    y > pi / 2.0 -> {
        y = pi - y
    }
    y2 = y * y
    y3 = y2 * y
    y5 = y3 * y2
    y7 = y5 * y2
    y9 = y7 * y2
    y11 = y9 * y2
    y13 = y11 * y2
    s = y - y3 / 6.0 + y5 / 120.0 - y7 / 5040.0 + y9 / 362880.0 - y11 / 39916800.0 + y13 / 6227020800.0
    res = sgn * s
}

f32.sin = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.sin().to-f32()
}

f64.cos = () (res f64) {
    res = (. + 1.5707963267948966).sin()
}

f32.cos = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.cos().to-f32()
}

; tan: tangent（libm tan，等价于 sin/cos）
f64.tan = () (res f64) {
    s = .sin()
    c = .cos()
    res = s / c
}

f32.tan = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.tan().to-f32()
}

f64.asin = () (res f64) {
    s = . * .
    one = 1.0 - s
    res = math.atan2(., one.sqrt())
}

f32.asin = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.asin().to-f32()
}

f64.acos = () (res f64) {
    s = . * .
    one = 1.0 - s
    res = math.atan2(one.sqrt(), .)
}

f32.acos = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.acos().to-f32()
}

f64.atan = () (res f64) {
    res = math.atan2(., 1.0)
}

f32.atan = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.atan().to-f32()
}

; 雙曲函數（f64/f32 方法）
f64.sinh = () (res f64) {
    e = .exp()
    ei = 1.0 / e
    res = (e - ei) / 2.0
}

f32.sinh = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.sinh().to-f32()
}

f64.cosh = () (res f64) {
    e = .exp()
    ei = 1.0 / e
    res = (e + ei) / 2.0
}

f32.cosh = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.cosh().to-f32()
}

f64.tanh = () (res f64) {
    e = .exp()

    ; tanh(x) = (e^2 - 1) / (e^2 + 1)
    res = (e * e - 1.0) / (e * e + 1.0)
}

f32.tanh = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.tanh().to-f32()
}

; 取整（f64/f32 方法；整數型別上取整為恆等，故不提供泛型版本）
f64.ceil = () (res f64) {
    t = math.i64-to-f64(math.f64-to-i64(.))
    . == t -> {
        res = t
    }
    . > 0.0 -> {
        res = t + 1.0
    }

    -> {
        res = t
    }
}

f32.ceil = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.ceil().to-f32()
}

f64.floor = () (res f64) {
    t = math.i64-to-f64(math.f64-to-i64(.))
    . == t -> {
        res = t
    }
    . < 0.0 -> {
        res = t - 1.0
    }

    -> {
        res = t
    }
}

f32.floor = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.floor().to-f32()
}

f64.round = () (res f64) {
    t = math.i64-to-f64(math.f64-to-i64(.))
    f = . - t
    . >= 0.0 -> {
        f >= 0.5 -> {
            res = t + 1.0
        }

        -> {
            res = t
        }
    }

    -> {
        f <= -0.5 -> {
            res = t - 1.0
        }

        -> {
            res = t
        }
    }
}

f32.round = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.round().to-f32()
}

f64.trunc = () (res f64) {
    res = math.i64-to-f64(math.f64-to-i64(.))
}

f32.trunc = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.trunc().to-f32()
}

; 指数对数（f64/f32 方法）
; exp-f64: 自由函數形式（接受參數 x，而非方法接收者）。
; 作為 f64.exp / cbrt / sinh / cosh / f32.exp 的單一實現來源。
; 注意：Nolang 當前對「具名區域變數上的方法呼叫」(如 t.exp()) 有
; codegen bug，會誤用外層接收者；故所有對 exp 的間接呼叫都走本
; 自由函數，避開該問題。
exp-f64 = (x f64) (res f64) {
    x > 709.0 -> {
        res = 1.0 / 0.0
        return
    }
    x < -745.0 -> {
        res = 0.0
        return
    }
    ln2 = 0.6931471805599453
    k = (x / ln2).to-i64()
    r = x - k.to-f64() * ln2
    r2 = r * r
    e = 1.0 + r + r2 / 2.0 + r2 * r / 6.0 + r2 * r2 / 24.0 + r2 * r2 * r / 120.0 + r2 * r2 * r2 / 720.0 + r2 * r2 * r2 * r / 5040.0 + r2 * r2 * r2 * r2 / 40320.0
    res = e
    ki = k
    ki > 0 -> {
        i <- [0..ki): {
            res = res * 2.0
        }
    }

    #{overflow=wrap}
    ni = 0 - ki
    ni > 0 -> {
        i <- [0..ni): {
            res = res / 2.0
        }
    }
}

f64.exp = () (res f64) {
    res = exp-f64(.)
}

f32.exp = () (res f32) {
    d = math.f32-to-f64(.)
    res = exp-f64(d).to-f32()
}

f64.log = () (res f64) {
    x = .
    x <= 0.0 -> {
        res = 0.0 / 0.0
        return
    }
    k = 0
    i <- [0..2000): {
        x < 2.0 -> break
        x = x / 2.0

        #{overflow=wrap}
        k = k + 1
    }
    i <- [0..2000): {
        x >= 1.0 -> break
        x = x * 2.0

        #{overflow=wrap}
        k = k - 1
    }
    i <- [0..20): {
        x <= 1.414213562373095 -> break
        x = x / 2.0

        #{overflow=wrap}
        k = k + 1
    }
    z = (x - 1.0) / (x + 1.0)
    z2 = z * z
    z3 = z2 * z
    z5 = z3 * z2
    z7 = z5 * z2
    z9 = z7 * z2
    lnf = 2.0 * (z + z3 / 3.0 + z5 / 5.0 + z7 / 7.0 + z9 / 9.0)
    ln2 = 0.6931471805599453
    res = k.to-f64() * ln2 + lnf
}

f32.log = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.log().to-f32()
}

f64.log10 = () (res f64) {
    res = .log() / 2.302585092994046
}

f32.log10 = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.log10().to-f32()
}

f64.log2 = () (res f64) {
    res = .log() / 0.6931471805599453
}

f32.log2 = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.log2().to-f32()
}

; degrees: 弧度轉角度（f64/f32 方法）
f64.degrees = () (res f64) {
    res = . * 180.0 / math.PI
}

f32.degrees = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.degrees().to-f32()
}

; radians: 角度轉弧度（f64/f32 方法）
f64.radians = () (res f64) {
    res = . * math.PI / 180.0
}

f32.radians = () (res f32) {
    d = math.f32-to-f64(.)
    res = d.radians().to-f32()
}

; sqrt: 整數平方根 floor(√n)——i64 方法
; n < 0 時整數域無解，返回 0；二分搜尋 O(log n)，比較用 n/mid 而非
; mid*mid，無溢出（同 math.no gcd/even 的 wrap 註解慣例）。
; 不用 int 聯合接收者（本可全寬度通用）：int 別名定義在 std/int.no，
; 跨模組声明 `int.X` 方法會被 prefixMethodNames 雙重加前綴成
; `int.int.X`，呼叫點單態化匹配不到，報 unknown callee。
i64.sqrt = () (r i64) {
    n = .
    n < 0 -> {
        r = 0
        return
    }
    n < 2 -> {
        r = n
        return
    }
    lo = 1

    #{overflow=wrap}
    hi = n / 2
    r = 1
    (lo <= hi) {

        #{overflow=wrap}
        mid = (lo + hi) / 2

        #{overflow=wrap}
        q = n / mid
        {
            mid <= q -> {
                r = mid

                #{overflow=wrap}
                lo = mid + 1
            }

            -> {

                #{overflow=wrap}
                hi = mid - 1
            }
        }
    }
}

; is-prime: 是否為質數——i64 方法
; 試除法 O(√n)：先排除偶數，再試除奇因數；終止條件用 d <= n/d
; 避免 d*d 溢出，除數恆 ≥ 1 不會 trap（同樣不用 int 聯合接收者，見上）
i64.is-prime = () (yes bool) {
    n = .
    n < 2 -> {
        yes = false
        return
    }

    #{overflow=wrap}
    m2 = n % 2
    m2 == 0 -> {
        yes = (n == 2)
        return
    }
    d = 3

    #{overflow=wrap}
    lim = n / d
    (d <= lim) {

        #{overflow=wrap}
        md = n % d
        md == 0 -> {
            yes = false
            return
        }

        #{overflow=wrap}
        d = d + 2

        #{overflow=wrap}
        lim = n / d
    }
    yes = true
}

; ── 全寬度整數方法副本 ──
; sqrt / is-prime 對 i8 i16 i32 u8 u16 u32 u64 各配具體型別版本
; （int 聯合接收者不可用：別名定義在 std/int.no，跨模組声明雙重前綴，
; 見上方 i64.sqrt 註解）。也不能經 i64 委託：u64 值域超出 i64，
; 且無整數縮窄轉換內建可把 i64 結果歸還具體窄型。
; i8/u64 曾因編譯器缺口（i8 拓寬按無符號、比較恒用有符號謂詞）暫缺，
; 修復 hir2mir 無符號比較/除法路由（含嵌套子表達式遞迴探測、接收者綁定
; `n T = .` 的 localRaw 回退記錄）與 codegen coerceIntSigned（i8 按宣告型
; sext）後已補齊。
; i128/u128 除範圍常數與 .to-str() 外，亦提供 sqrt/is-prime（見下方
; 「128 位整數方法副本」小節的標型與溢出註解要點）。
; 128 位算術本身沒壞——把運算元顯式宣告為 i128/u128（帶型區域變數），
; + − × ÷ % 在完整 128 位值域上結果正確（二分搜尋 sqrt 於 1e24、
; i128.MAX、u128.MAX 上均得精確 ⌊√n⌋）。先前診斷出的兩處缺口皆已修通：
; ① 溢出策略與 128 位交會——迴圈內整數算術需 `#{overflow=wrap}`，早期 i128
;   位的 wrap 註解 lowering 會 derail 呼叫端 codegen（合成 main 丟棄頂層敘述），
;   現以「顯式標型區域變數 + 註解獨立成行」的形式落地，既過 vet 又執行期正確。
; ② u128 比較/除法誤走有符號謂詞——codegen isUnsignedRaw 漏列 u128，修正後
;   u128.MAX 值域（≥ 2^127）不再誤序。
; （範圍常數經 hir2mir 的 typeConstantText128 常數表（i128 lane，全精度十進位
; 文字走 Inst.IntBig）取值；128 位字面量直接宣告給帶型區域變數、其 .to-str()
; （經 int.to-str 或原生 @str_from_i128/@str_from_u128）、以及對合法 128 位值
; 的比較，均已驗證。）

; i8（有符號：保留負數守衛）
i8.sqrt = () (r i8) {
    n = .
    n < 0 -> {
        r = 0
        return
    }
    n < 2 -> {
        r = n
        return
    }
    lo i8 = 1

    #{overflow=wrap}
    hi = n / 2
    r = 1
    (lo <= hi) {

        #{overflow=wrap}
        mid i8 = (lo + hi) / 2

        #{overflow=wrap}
        q i8 = n / mid
        {
            mid <= q -> {
                r = mid

                #{overflow=wrap}
                lo = mid + 1
            }

            -> {

                #{overflow=wrap}
                hi = mid - 1
            }
        }
    }
}

i8.is-prime = () (yes bool) {
    n = .
    n < 2 -> {
        yes = false
        return
    }

    #{overflow=wrap}
    m2 i8 = n % 2
    m2 == 0 -> {
        yes = (n == 2)
        return
    }
    d i8 = 3

    #{overflow=wrap}
    lim = n / d
    (d <= lim) {

        #{overflow=wrap}
        md i8 = n % d
        md == 0 -> {
            yes = false
            return
        }

        #{overflow=wrap}
        d = d + 2

        #{overflow=wrap}
        lim = n / d
    }
    yes = true
}

