; number — 數字操作
;
; 泛型數字函數，支援 i64、f64 等數值型別。
; 包含：max, min, abs, clamp, sign, even, odd,
; gcd, lcm, pow, div, mod, swap, is-nan, is-inf
; 範圍常數：i8/i16/i32/i64/u8/u16/u32/u64 的 MIN/MAX

; max: 回傳最大值（variadic，支援 num 所有成員）

int = i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64
float = f32 | f64
num = int | float

; ═══════════════════════════════════════════════
; 數值範圍常數（用於範圍檢查，如 str.to-i8 等）
; ═══════════════════════════════════════════════

; i8: -128 ~ 127
i8.MIN = -128
i8.MAX = 127

; i16: -32768 ~ 32767
i16.MIN = -32768
i16.MAX = 32767

; i32: -2147483648 ~ 2147483647
i32.MIN = -2147483648
i32.MAX = 2147483647

; i64: -9223372036854775808 ~ 9223372036854775807
; MIN 不可直接寫為字面量（解析器不支援），用 -MAX - 1 表達
i64.MAX = 9223372036854775807

#{overflow=wrap}
i64.MIN = 0 - 9223372036854775807 - 1

; u8: 0 ~ 255
u8.MIN = 0
u8.MAX = 255

; u16: 0 ~ 65535
u16.MIN = 0
u16.MAX = 65535

; u32: 0 ~ 4294967295
u32.MIN = 0
u32.MAX = 4294967295

; u64: 0 ~ 18446744073709551615
; MAX 無法用整數字面量表示（超過 i64 上限），可透過 0 - 1 間接取得
u64.MIN = 0

#{overflow=wrap}
u64.MAX = 0 - 1

max = (a ..num) (r num) {

    #{index-out=0}
    r = a[0]
    n = len(a)
    i <- [1..n): {
        a[i] > r -> {

            #{index-out=0}
            r = a[i]
        }
    }
}

min = (a ..num) (r num) {

    #{index-out=0}
    r = a[0]
    n = len(a)
    i <- [1..n): {
        a[i] < r -> {

            #{index-out=0}
            r = a[i]
        }
    }
}

abs = (a num) (r num) {
    {
        a < 0 -> {

            #{overflow=wrap}
            r = 0 - a
        }

        -> r = a
    }
}

; clamp: 限制在 [lo, hi] 範圍內
; 用法：x.clamp(lo, hi, r)
num.clamp = (lo num, hi num) (r num) {
    {
        . < lo -> r = lo

        . > hi -> r = hi

        -> r = .
    }
}

; sign: 符號（-1, 0, 1）— 對所有 num 型別（整數與浮點）通用
num.sign = () (r num) {
    {
        . > 0 -> r = 1

        . < 0 -> {

            #{overflow=wrap}
            r = 0 - 1
        }

        -> r = 0
    }
}

; even: 是否為偶數 — 對所有整數型別（含無符號）通用
even = (a int) (yes bool) {
    r = a % 2
    yes = (r == 0)
}

; odd: 是否為奇數 — 對所有整數型別（含無符號）通用
odd = (a int) (yes bool) {
    r = a % 2
    yes = (r != 0)
}

; gcd: 最大公因數（輾轉相除法）
gcd = (a int, b int) (r int) {
    ra = a
    rb = b

    #{overflow=wrap}
    ra < 0 -> ra = 0 - ra

    #{overflow=wrap}
    rb < 0 -> rb = 0 - rb
    (rb != 0) {

        #{overflow=wrap}
        t = rb
        rb = ra % rb
        ra = t
    }
    r = ra
}

; lcm: 最小公倍數
lcm = (a int, b int) (r int) {

    #{overflow=wrap}
    a == 0 || b == 0 -> {
        r = 0
        return
    }
    g = gcd(a, b)

    #{overflow=wrap}
    r = a / g * b
}

; pow: 整數冪 a^n（n ≥ 0）— 對所有整數型別通用
; 使用快速冪算法 O(log n)
pow = (a int, n int) (r int) {
    rn = n
    r = 1
    base = a
    (rn > 0) {

        #{overflow=wrap}
        rn & 1 == 1 -> r = r * base

        #{overflow=wrap}
        base = base * base
        rn = rn >> 1
    }
}

; i64-to-f64: 整數轉浮點
#{buildin}
i64-to-f64 = (a i64) (r f64) {
}

;     r = a
; }

; f64-to-i64: 浮點轉整數（截斷）
#{buildin}
f64-to-i64 = (a f64) (r i64) {
}

;     r = a
; }

; f32-to-f64: 將 f32 提升為 f64
#{buildin}
f32-to-f64 = (a f32) (r f64) {
}

; f64-to-f32: 將 f64 降為 f32（可能損失精度）
#{buildin}
f64-to-f32 = (a f64) (r f32) {
}

; ═══════════════════════════════════════════════
; 整數轉字串（Nolang 實現，取代 sprintf CLibCall）
; ═══════════════════════════════════════════════

; i64-to-str: 將 i64 轉為字串
; 處理 0、正數、負數。負數的絕對值以 u64 表示（2's 補數 0 - (u64)n），
; 避免 n = 0 - n 在 i64.MIN 時溢出（i64.MIN 的絕對值 2^63 超出 i64 範圍）。
i64-to-str = (n i64) (out str) {

    #{overflow=wrap}
    n == 0 -> {
        out = with-cap(1)

        #{index-out=0}
        out[0] = 48
        return
    }
    neg = 0
    mag u64 = 0

    ; 負數：以 u64 取絕對值，避開 i64.MIN 溢出。
    ; 隱式 i64 -> u64（位元組重新詮釋）後做 0 - mag（u64 回繞）即得絕對值。
    #{overflow=wrap}
    n < 0 -> {

        #{overflow=wrap}
        neg = 1
        mag = n
        mag = 0 - mag
    }

    -> {
        mag = n
    }
    digits = 0
    tmp = mag
    (tmp != 0) {

        #{overflow=wrap}
        digits = digits + 1

        #{overflow=wrap}
        tmp = tmp / 10
    }
    total = digits

    #{overflow=wrap}
    neg == 1 -> total = total + 1
    out = with-cap(total)

    #{overflow=wrap}
    pos = digits - 1
    neg == 1 -> pos = digits
    (mag != 0) {

        #{overflow=wrap}
        d = mag % 10

        #{overflow=wrap}
        ascii = d + 48

        #{index-out=0}
        out[pos] = ascii

        #{overflow=wrap}
        mag = mag / 10

        #{overflow=wrap}
        pos = pos - 1
    }
    neg == 1 -> {

        #{index-out=0}
        out[0] = 45
    }
}

; u64-to-str: 將 u64 轉為字串
u64-to-str = (u u64) (out str) {
    ru = u

    #{overflow=wrap}
    u == 0 -> {
        out = with-cap(1)

        #{index-out=0}
        out[0] = 48
        return
    }
    tmp u64 = ru
    digits = 0
    (tmp > 0) {

        #{overflow=wrap}
        digits = digits + 1

        #{overflow=wrap}
        tmp = tmp / 10
    }
    out = with-cap(digits)

    #{overflow=wrap}
    pos = digits - 1
    (ru > 0) {

        #{overflow=wrap}
        d = ru % 10

        #{overflow=wrap}
        ascii = d + 48

        #{index-out=0}
        out[pos] = ascii

        #{overflow=wrap}
        ru = ru / 10

        #{overflow=wrap}
        pos = pos - 1
    }
}

; char-to-str: 將 char（i64 Unicode 碼點）轉為 UTF-8 編碼字串
; 取代舊版 sprintf %c（僅能處理單位元組 ASCII）
char-to-str = (c i64) (out str) {
    out = with-cap(4)
    {
        c < 0x80 -> {

            #{index-out=0}
            out[0] = c
        }

        c < 0x800 -> {

            #{index-out=0}
            out[0] = 0xc0 | ((c >> 6) & 0x1f)

            #{index-out=0}
            out[1] = 0x80 | (c & 0x3f)
        }

        c < 0x10000 -> {

            #{index-out=0}
            out[0] = 0xe0 | ((c >> 12) & 0x0f)

            #{index-out=0}
            out[1] = 0x80 | ((c >> 6) & 0x3f)

            #{index-out=0}
            out[2] = 0x80 | (c & 0x3f)
        }

        -> {

            #{index-out=0}
            out[0] = 0xf0 | ((c >> 18) & 0x07)

            #{index-out=0}
            out[1] = 0x80 | ((c >> 12) & 0x3f)

            #{index-out=0}
            out[2] = 0x80 | ((c >> 6) & 0x3f)

            #{index-out=0}
            out[3] = 0x80 | (c & 0x3f)
        }
    }
}

; int.to-str: 整數轉字串（聯合類型方法，涵蓋所有整數類型）
; transpiler 會將 i64.to-str() 等解析為 int.to-str()
; 直接使用算術運算，避免 int → u64 的類型轉換問題
; 注意：不對負數取絕對值（0 - n 在 n = i64.MIN 時會溢出），
; 改為直接對負數做 srem/sdiv（向零截斷），再將負餘數映射到 [0, 9]。
int.to-str = () (out str) {

    #{overflow=wrap}
    . == 0 -> {
        out = with-cap(1)

        #{index-out=0}
        out[0] = 48
        return
    }
    neg = 0
    n = .
    n < 0 -> neg = 1
    digits = 0
    tmp = n
    (tmp != 0) {

        #{overflow=wrap}
        digits = digits + 1

        #{overflow=wrap}
        tmp = tmp / 10
    }
    total = digits

    #{overflow=wrap}
    neg == 1 -> total = total + 1
    out = with-cap(total)

    #{overflow=wrap}
    pos = digits - 1
    neg == 1 -> pos = digits
    (n != 0) {

        #{overflow=wrap}
        d = n % 10

        #{overflow=wrap}
        neg == 1 -> d = 0 - d

        #{overflow=wrap}
        ascii = d + 48

        #{index-out=0}
        out[pos] = ascii

        #{overflow=wrap}
        n = n / 10

        #{overflow=wrap}
        pos = pos - 1
    }
    neg == 1 -> {

        #{index-out=0}
        out[0] = 45
    }
}

; i64.to-str: i64 轉字串
i64.to-str = () (out str) {
    out = i64-to-str(.)
}

; i32.to-str: i32 轉字串（隱式拓寬至 i64）
i32.to-str = () (out str) {
    out = i64-to-str(.)
}

; i16.to-str: i16 轉字串
i16.to-str = () (out str) {
    out = i64-to-str(.)
}

; i8.to-str: i8 轉字串
i8.to-str = () (out str) {
    out = i64-to-str(.)
}

; u64.to-str: u64 轉字串
u64.to-str = () (out str) {
    out = u64-to-str(.)
}

; u32.to-str: u32 轉字串（隱式拓寬至 u64）
u32.to-str = () (out str) {
    out = u64-to-str(.)
}

; u16.to-str: u16 轉字串
u16.to-str = () (out str) {
    out = u64-to-str(.)
}

; u8.to-str: u8 轉字串
u8.to-str = () (out str) {
    out = u64-to-str(.)
}

; byte.to-str: byte 轉字串（無號，等同 u8）
byte.to-str = () (out str) {
    out = u64-to-str(.)
}

; ═══════════════════════════════════════════════
; 浮點轉字串（Nolang 實現，取代 sprintf %g CLibCall）
; ═══════════════════════════════════════════════

LN10 = 2.302585092994046

; f64-to-str: 將 f64 轉為字串（模擬 C %g 格式）
; 6 位有效數字，去除尾隨零，指數 < -4 或 >= 6 時使用科學記號
f64-to-str = (x f64) (out str) {

    ; 特殊值處理
    ; 注意：必須使用 .copy() 建立堆副本，避免字串字面量的全局常量資料被 emitHeapFree 釋放
    #{overflow=wrap}
    {
        x != x -> {
            out = 'nan'.copy()
            return
        }

        x == 0.0 -> {
            out = '0'.copy()
            return
        }

        x + x == x -> {
            x < 0.0 -> {
                out = '-inf'.copy()
                return
            }
            out = 'inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax = x

    #{overflow=wrap}
    x < 0.0 -> {

        #{overflow=wrap}
        neg = 1
        ax = 0.0 - x
    }

    ; 計算指數 e = floor(log10(ax))
    e = f64-to-i64(math.floor(math.log10(ax)))

    ; 邊界調整：若 ax >= 10^(e+1)，則 e++
    #{overflow=wrap}
    upper f64 = math.exp(i64-to-f64(e + 1) * LN10)

    #{overflow=wrap}
    ax >= upper -> e = e + 1

    ; 計算 6 位有效數字的整數尾數
    ; m = round(ax / 10^e * 100000)
    #{overflow=wrap}
    base f64 = math.exp(i64-to-f64(e) * LN10)

    #{overflow=wrap}
    ax < base -> {

        #{overflow=wrap}
        e = e - 1
        base = math.exp(i64-to-f64(e) * LN10)
    }

    #{overflow=wrap}
    m = f64-to-i64(ax / base * 100000.0 + 0.5)

    ; 四捨五入溢出處理
    #{overflow=wrap}
    m >= 1000000 -> {

        #{overflow=wrap}
        m = m / 10
        e = e + 1
    }

    ; 將 m 轉為 6 位數字字串（補前導零）
    digits str = with-cap(6)
    tmp = m
    i = 5
    (i >= 0) {

        #{index-out=0, overflow=wrap}
        digits[i] = (tmp % 10) + 48

        #{overflow=wrap}
        tmp = tmp / 10

        #{overflow=wrap}
        i = i - 1
    }

    ; 找最後一個非零位（用於去尾隨零）
    last-nz = 0
    i = 5
    (i >= 0) {

        #{overflow=wrap}
        digits[i] != 48 -> {
            last-nz = i
            i = -1
        }

        #{overflow=wrap}
        i = i - 1
    }

    ; 決定格式
    use-sci = 0
    {
        e < -4 -> use-sci = 1

        e >= 6 -> use-sci = 1
    }

    #{overflow=wrap}
    use-sci == 1 -> {

        ; 科學記號：d.ddddde±NN
        #{overflow=wrap}
        out = with-cap(20)
        pos = 0
        neg == 1 -> {

            #{index-out=0, overflow=wrap}
            out[pos] = 45
            pos = pos + 1
        }

        #{index-out=0}
        out[pos] = digits[0]
        pos = pos + 1
        last-nz >= 1 -> {

            #{index-out=0, overflow=wrap}
            out[pos] = 46
            pos = pos + 1
            j = 1
            (j <= last-nz) {

                #{index-out=0, overflow=wrap}
                out[pos] = digits[j]
                pos = pos + 1
                j = j + 1
            }
        }

        #{index-out=0}
        out[pos] = 101
        pos = pos + 1
        ae i64 = e
        {
            ae < 0 -> {

                #{index-out=0, overflow=wrap}
                out[pos] = 45
                pos = pos + 1
                ae = 0 - ae
            }

            -> {

                #{index-out=0, overflow=wrap}
                out[pos] = 43
                pos = pos + 1
            }
        }
        estr = i64-to-str(ae)
        estr.len-bytes() == 1 -> {

            #{index-out=0, overflow=wrap}
            out[pos] = 48
            pos = pos + 1
        }
        j = 0
        (j < estr.len-bytes()) {

            #{index-out=0, overflow=wrap}
            out[pos] = estr[j]
            pos = pos + 1
            j = j + 1
        }
        return
    }

    ; 固定記號
    #{overflow=wrap}
    e >= 0 -> {

        #{overflow=wrap}
        int-digits = e + 1
        total = int-digits
        neg == 1 -> total = total + 1
        last-nz >= int-digits -> {

            #{overflow=wrap}
            total = total + 1
            total = total + (last-nz - int-digits + 1)
        }
        out = with-cap(total)
        pos = 0
        neg == 1 -> {

            #{index-out=0, overflow=wrap}
            out[pos] = 45
            pos = pos + 1
        }
        j = 0
        (j < int-digits) {

            #{index-out=0, overflow=wrap}
            out[pos] = digits[j]
            pos = pos + 1
            j = j + 1
        }
        last-nz >= int-digits -> {

            #{index-out=0, overflow=wrap}
            out[pos] = 46
            pos = pos + 1
            j = int-digits
            (j <= last-nz) {

                #{index-out=0, overflow=wrap}
                out[pos] = digits[j]
                pos = pos + 1
                j = j + 1
            }
        }
        return
    }

    ; e < 0: 0.00dddd
    #{overflow=wrap}
    lead-zeros = 0 - e - 1

    #{overflow=wrap}
    total = 2 + lead-zeros + last-nz + 1

    #{overflow=wrap}
    neg == 1 -> total = total + 1
    out = with-cap(total)
    pos = 0

    #{overflow=wrap}
    neg == 1 -> {

        #{index-out=0, overflow=wrap}
        out[pos] = 45
        pos = pos + 1
    }

    #{index-out=0}
    out[pos] = 48

    #{overflow=wrap}
    pos = pos + 1

    #{index-out=0}
    out[pos] = 46

    #{overflow=wrap}
    pos = pos + 1
    j = 0
    (j < lead-zeros) {

        #{index-out=0, overflow=wrap}
        out[pos] = 48

        #{overflow=wrap}
        pos = pos + 1

        #{overflow=wrap}
        j = j + 1
    }
    j = 0
    (j <= last-nz) {

        #{index-out=0, overflow=wrap}
        out[pos] = digits[j]

        #{overflow=wrap}
        pos = pos + 1

        #{overflow=wrap}
        j = j + 1
    }
}

; f64.to-str: f64 轉字串（方法）
f64.to-str = () (out str) {
    out = f64-to-str(.)
}

; f32.to-str: f32 轉字串（方法）
; 透過 f32-to-f64 拓寬後委託 f64-to-str，取代 sprintf %g CLibCall
f32.to-str = () (out str) {
    d = f32-to-f64(.)
    out = f64-to-str(d)
}

; 注意：不定義 float.to-str 聯合方法。原因：
; union 方法的 codegen 分派在無法推斷局部變數型別時會回退到非單態化名稱，
; 導致 undefined @float.to-str 錯誤。改為依賴 codegen 的 fallback 機制：
; 當變數 LLVM 型別為 double 時，自動分派到 f64.to-str。

; div: 整數除法，回傳商（a ÷ b）
; b 為 0 時行為未定義（執行時期錯誤）
div = (a int, b int) (q int) {

    #{overflow=wrap}
    q = a / b
}

; mod: 整數取模，回傳餘數（a % b）
; b 為 0 時行為未定義（執行時期錯誤）
mod = (a int, b int) (r int) {
    r = a % b
}

; swap: 交換兩個值
swap = () (a t, b t) {
    tmp = a
    a = b
    b = tmp
}

; is-nan: 判斷是否為 NaN
float.is-nan = () (yes bool) {
    yes = . != .
}

; is-inf: 判斷是否為無窮大
float.is-inf = () (yes bool) {

    #{overflow=wrap}
    yes = . + . == .
}

; [n]num.zero / []num.zero — 使用 llvm.memset 置零
; 定長陣列：總位元組 = n * sizeof(num) 編譯期常量
; 堆切片：運行時取 .len() * sizeof(num) 傳入 llvm.memset
#{buildin}
arr-zero = () {
}

;     i = 0
;     for i < n {
;         .[i] = 0
;         i = i + 1
;     }
; }
;
; []num.zero = () {
;     i = 0
;     for i < .len() {
;         .[i] = 0
;         i = i + 1
;     }
; }
; ═══════════════════════════════════════════════
; 位元操作（內建）
; ═══════════════════════════════════════════════
; rotate-left: 整數左旋 n 位元（映射到 ARM64 ROR via llvm.fshl）
#{buildin}
rotate-left = (x i64, n i64) (r i64) {
}

; rotate-right: 整數右旋 n 位元（映射到 ARM64 ROR via llvm.fshr）
#{buildin}
rotate-right = (x i64, n i64) (r i64) {
}

; store-le-u32: 將 u32 值以小端序寫入位元組陣列指定偏移位置
#{buildin}
store-le-u32 = (arr i64, offset i64, val u32) {
}
