; ── 128 位整數方法副本（i128 / u128）──
; 128 位算術本身可用（運算元走 LLVM i128 道），但兩點必須兼顧：
; ① 區域變數需顯式標型（`n i128 = .`、`lo i128 = 1` …）。不標型時
;   checker 把與字面量混算的中間值推斷為 i64，迴圈會收敛於錯誤值甚至
;   懸死（i128.MAX 的二分搜尋實測如此）。u128 不標型還會 i64→u128 賦值報錯。
; ② 溢出註解佈局：i128（有符號，除法可能 INT_MIN/-1 溢出）對每條算術加
;   `#{overflow=wrap}`；u128（無符號，÷/% 不會溢出）只對 + − 及「除以字面量」
;   的運算加註解，對變數間 ÷/% 不加（否則 overflow-ineffective 告警）。
;   註解須獨立成行、置於目標陳述前（單行 `;` 串接的 guard 會觸發
;   128 位 codegen 丟棄整段 main）。
;   同時修復 codegen isUnsignedRaw 漏列 u128：u128 的比較/除法之前誤走有符
;   號謂詞，u128.MAX 值域（≥ 2^127）會誤序；修正後 u128.sqrt(u128.MAX)=2^64-1 精確。
i128.sqrt = () (r i128) {
    n = .
    n < 0 -> {
        r = 0
        return
    }
    n < 2 -> {
        r = n
        return
    }
    lo i128 = 1

    #{overflow=wrap}
    hi = n / 2
    r i128 = 1
    (lo <= hi) {

        #{overflow=wrap}
        mid i128 = (lo + hi) / 2

        #{overflow=wrap}
        q i128 = n / mid
        {
            mid <= q -> {
                r = mid

                #{overflow=wrap}
                lo = mid + 1
            }

            -> {

                #{overflow=wrap}
                hi = mid - 1
            }
        }
    }
}

i128.is-prime = () (yes bool) {
    n = .
    n < 2 -> {
        yes = false
        return
    }

    #{overflow=wrap}
    m2 i128 = n % 2
    m2 == 0 -> {
        yes = (n == 2)
        return
    }
    d i128 = 3

    #{overflow=wrap}
    lim = n / d
    (d <= lim) {

        #{overflow=wrap}
        md i128 = n % d
        md == 0 -> {
            yes = false
            return
        }

        #{overflow=wrap}
        d = d + 2

        #{overflow=wrap}
        lim = n / d
    }
    yes = true
}

u128.sqrt = () (r u128) {
    n = .
    n < 2 -> {
        r = n
        return
    }
    lo u128 = 1

    #{overflow=wrap}
    hi = n / 2
    r u128 = 1
    (lo <= hi) {

        #{overflow=wrap}
        mid u128 = (lo + hi) / 2
        q u128 = n / mid
        {
            mid <= q -> {
                r = mid

                #{overflow=wrap}
                lo = mid + 1
            }

            -> {

                #{overflow=wrap}
                hi = mid - 1
            }
        }
    }
}

u128.is-prime = () (yes bool) {
    n = .
    n < 2 -> {
        yes = false
        return
    }

    #{overflow=wrap}
    m2 u128 = n % 2
    m2 == 0 -> {
        yes = (n == 2)
        return
    }
    d u128 = 3
    lim = n / d
    (d <= lim) {
        md u128 = n % d
        md == 0 -> {
            yes = false
            return
        }

        #{overflow=wrap}
        d = d + 2
        lim = n / d
    }
    yes = true
}
