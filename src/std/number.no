; u64（值域超出 i64，必須獨立同寬實現）
u64.sqrt = () (r u64) {
    n = .
    n < 2 -> {
        r = n
        return
    }
    lo u64 = 1

    #{overflow=wrap}
    hi = n / 2
    r = 1
    (lo <= hi) {

        #{overflow=wrap}
