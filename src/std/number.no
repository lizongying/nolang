; number — 數字操作（方法形式 API）
;
; std 數字系全部「方法形式」API 集中於本模組：具體型別 to-str
; （i64/i32/i16/i8/u64/u32/u16/u8/byte/f64/f32）、f64 可配置精度 to-str
; （f64.to-str-fixed / f64.to-str-sci / f64.to-str-general，原 str.f64-to-str-*
; 函數已遷入本模組並改為方法形式）、數值寬度轉換方法
; （f64.to-i64、i64.to-f64、f32.to-f64 等 #{buildin}）、f64/f32 數學方法
; （sqrt, cbrt, 三角/雙曲, ceil/floor/round/trunc, exp/log, degrees/radians）、
; 整數 sqrt / is-prime。
; 「函數形式」API（max, min, pow, hypot, atan2, fmod, clamp, even, odd, gcd,
; lcm, div, mod, swap, arr-zero, char-to-str, 位元操作）
; 在 math 模組（std/math.no）；唯一例外：整數冪 pow（int 泛型）與
; math 的 pow（f64）同名衝突，留在本模組。
; 注：舊函數形式的型別寬度轉換（math.i64-to-f64 等）與整數/浮點 to-str
; （math.i64/u64/f64-to-str）已刪除——改由上述本模組方法直接承載。
; 聯合型別別名與成員方法：num → std/num.no, int → std/int.no,
; float → std/float.no。
; 範圍常數（用於範圍檢查，如 str.to-i8 等）：i8/i16/i32/i64/u8/u16/u32/u64
; 的 MIN/MAX 與 INF 保留在本模組。

; ═══════════════════════════════════════════════
; 數值範圍常數（用於範圍檢查，如 str.to-i8 等）
; ═══════════════════════════════════════════════

; i8: -128 ~ 127
i8.MIN = -128
i8.MAX = 127

; i16: -32768 ~ 32767
i16.MIN = -32768
i16.MAX = 32767

; i32: -2147483648 ~ 2147483647
i32.MIN = -2147483648
i32.MAX = 2147483647

; i64: -9223372036854775808 ~ 9223372036854775807
; MIN 不可直接寫為字面量（解析器不支援），用 -MAX - 1 表達
i64.MAX = 9223372036854775807

#{overflow=wrap}
i64.MIN = 0 - 9223372036854775807 - 1

; u8: 0 ~ 255
u8.MIN = 0
u8.MAX = 255

; u16: 0 ~ 65535
u16.MIN = 0
u16.MAX = 65535

; u32: 0 ~ 4294967295
u32.MIN = 0
u32.MAX = 4294967295

; u64: 0 ~ 18446744073709551615
; MAX 無法用整數字面量表示（超過 i64 上限），可透過 0 - 1 間接取得
u64.MIN = 0

#{overflow=wrap}
u64.MAX = 0 - 1

; i128: -170141183460469231731687303715884105728 ~ 170141183460469231731687303715884105727
; 型別層常量取值經 hir2mir 的 typeConstantText128 常數表（i128 lane 走
; 全精度十進位文字），以下定義為 API/文件用（與其他寬度一致）
i128.MAX = 170141183460469231731687303715884105727
i128.MIN = -170141183460469231731687303715884105728

; u128: 0 ~ 340282366920938463463374607431768211455
u128.MIN = 0
u128.MAX = 340282366920938463463374607431768211455

INF = 1.0 / 0.0

; int.to-str 聯合方法已移至 std/int.no（此處保留具體型別 i64.to-str 等方法）

; i64.to-str: i64 轉字串
; #{buildin}：底層走原生 @str_from_i64（builtin strconv.go 註冊 ForwardFunc "i64-to-str"，
; 由 codegen 按名命中原生內聯路徑）。i64 有原生格式化器，故直接 builtin、不再包裝 Nolang 迴圈。
#{buildin}
i64.to-str = () (out str) {
}

; i32.to-str: i32 轉字串（隱式拓寬至 i64 後複用 i64.to-str 原生路徑）
i32.to-str = () (out str) {
    v i64 = .
    out = v.to-str()
}

; i16.to-str: i16 轉字串（拓寬至 i64 複用）
i16.to-str = () (out str) {
    v i64 = .
    out = v.to-str()
}

; i8.to-str: i8 轉字串（拓寬至 i64 複用）
i8.to-str = () (out str) {
    v i64 = .
    out = v.to-str()
}

; u64.to-str: u64 轉字串（直接 Nolang 實現：後端無原生 u64 格式化器，
; 故把原 math.u64-to-str 的十進位迴圈內聯進方法本體，取代已刪除的函數）
u64.to-str = () (out str) {

    ru u64 = .
    ru == 0 -> {
        out = with-cap(1)

        out[0] = 48
        return
    }
    tmp = ru
    digits = 0
    (tmp > 0) {

        #{overflow=wrap}
        digits = digits + 1

        #{overflow=wrap}
        tmp = tmp / 10
    }
    out = with-cap(digits)

    #{overflow=wrap}
    pos = digits - 1
    (ru > 0) {

        #{overflow=wrap}
        d = ru % 10

        #{overflow=wrap}
        ascii = d + 48

        out[pos] = ascii

        #{overflow=wrap}
        ru = ru / 10

        #{overflow=wrap}
        pos = pos - 1
    }
}

; u32.to-str: u32 轉字串（隱式拓寬至 u64 後複用 u64.to-str）
u32.to-str = () (out str) {
    v u64 = .
    out = v.to-str()
}

; u16.to-str: u16 轉字串（拓寬至 u64 複用）
u16.to-str = () (out str) {
    v u64 = .
    out = v.to-str()
}

; u8.to-str: u8 轉字串（拓寬至 u64 複用）
u8.to-str = () (out str) {
    v u64 = .
    out = v.to-str()
}

; byte.to-str: byte 轉字串（無號，拓寬至 u64 複用）
byte.to-str = () (out str) {
    v u64 = .
    out = v.to-str()
}

; f64.to-str: f64 轉字串（直接 Nolang 實現，模擬 C %g 格式）
; 6 位有效數字，去除尾隨零，指數 < -4 或 >= 6 時使用科學記號。
; 後端無原生 f64 格式化器（sprintf CLibCall 已移除），故把原 math.f64-to-str
; 的 %g 例程內聯進方法本體，取代已刪除的函數。LN10 仍沿用 math 模組常量。
f64.to-str = () (out str) {

    x f64 = .

    ; 特殊值處理
    ; 注意：必須使用 .copy() 建立堆副本，避免字串字面量的全局常量資料被 emitHeapFree 釋放
    {
        x != x -> {
            out = 'NaN'.copy()
            return
        }
        x == 0.0 -> {
            ; Go strconv.FormatFloat(-0.0,'g',-1,64) 亦回傳 "0"，故不區分 -0
            out = '0'.copy()
            return
        }
        x + x == x -> {
            x < 0.0 -> {
                out = '-Inf'.copy()
                return
            }
            out = '+Inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax = x

    x < 0.0 -> {

        neg = 1
        ax = 0.0 - x
    }

    ; 位元分解：value = M * 2^e2（M 為整數有效數，含隱含位；e2 使得 value 精確等於此式）
    one64 u64 = 1
    mask11 u64 = (one64 << 11) - 1
    mask52 u64 = (one64 << 52) - 1
    bit52 u64 = (one64 << 52)
    bits = ax.to-bits()
    exp-bits u64 = (bits >> 52) & mask11
    frac u64 = bits & mask52
    exp-i i64 = exp-bits

    Mval u64 = 0
    e2 i64 = 0
    exp-bits == 0 -> {
        ; 非規約：M = frac, e2 = -1022 - 52 = -1074
        Mval = frac
        e2 = -1074
    }
    -> {
        ; 規約：M = (1<<52) | frac, e2 = exp-bits - 1023 - 52 = exp-bits - 1075
        Mval = bit52 | frac
        e2 = exp-i - 1075
    }

    ; base = M * 2^max(e2,0)；den = 2^max(-e2,0)；value = base / den
    one = bigint.one()
    Mval-i i64 = Mval
    bM = bigint.from-i64(Mval-i)
    base = bM
    den = one
    e2 >= 0 -> {
        base = bigint.shl(bM, e2)
    }
    e2 < 0 -> {
        #{overflow=wrap}
        ne = 0 - e2
        den = bigint.shl(one, ne)
    }

    ; hd = 2^e2 * den（整數）：e2>=0 → 2^e2；否則 1
    hd = one
    e2 >= 0 -> {
        hd = bigint.shl(one, e2)
    }

    ; M 是否偶數（邊界 tie-to-even 判定用）
    m-even = 0
    (Mval & 1) == 0 -> {
        m-even = 1
    }

    ; 最短往返搜尋：找最小 K 使 N = round(value * 10^K) 落在 [v-h, v+h] 內
    ; （h = 2^(e2-1) 為半 ulp；N×10^(-K) 即候選十進位值）
    ten = bigint.from-i64(10)
    pow10 = one
    K = 0
    found = 0
    best-N = one
    best-K = 0
    (K <= 350) {
        found == 1 -> { K = 351 }
        found == 0 -> {
            ; N = (2*base*pow10 + den) / (2*den) = round(base*pow10/den)
            t1 = base._mul(pow10)
            t2 = t1._add(t1)
            t3 = t2._add(den)
            den2 = den._add(den)
            N = t3._div(den2)

            ; Nchk = 2*N*den；A=(2*base-hd)*pow10；B=(2*base+hd)*pow10
            twoN = N._add(N)
            Nchk = twoN._mul(den)
            twoBase = base._add(base)
            Am = twoBase._sub(hd)
            Bm = twoBase._add(hd)
            A = Am._mul(pow10)
            B = Bm._mul(pow10)

            c1 = A.cmp(Nchk)
            c2 = Nchk.cmp(B)
            valid = 0
            c1 <= 0 -> {
                c2 <= 0 -> {
                    bound = 0
                    c1 == 0 -> bound = 1
                    c2 == 0 -> bound = 1
                    bound == 1 -> {
                        m-even == 1 -> valid = 1
                    }
                    bound == 0 -> valid = 1
                }
            }
            valid == 1 -> {
                found = 1
                best-N = N
                best-K = K
            }
            found == 0 -> {
                #{overflow=wrap}
                K = K + 1
                pow10 = pow10._mul(ten)
            }
        }
    }

    Nstr = best-N.to-str()
    k = Nstr.len-bytes()
    #{overflow=wrap}
    E = k - best-K - 1

    ; 科學記號閾值（與 Go %g 對齊）：E <= -5 或 E >= 6
    use-sci = 0
    E <= -5 -> use-sci = 1
    E >= 6 -> use-sci = 1

    use-sci == 1 -> {
        ; 科學記號：剝離尾隨零（僅調整顯示長度 sk，E 不變）→ 1e+06 而非 1.000000e+06
        sk = k
        stz = 1
        (stz == 1) {
            sk <= 1 -> { stz = 0 }
            sk > 1 -> {
                slb = Nstr[sk - 1]
                slb == 48 -> { sk = sk - 1 }
                slb != 48 -> { stz = 0 }
            }
        }
        exp-abs = E
        exp-abs < 0 -> exp-abs = 0 - exp-abs
        expstr = exp-abs.to-str()
        elen = expstr.len-bytes()
        elen < 2 -> elen = 2
        cap = 1
        sk > 1 -> cap = cap + 1 + (sk - 1)
        cap = cap + 1 + 1 + elen
        neg == 1 -> cap = cap + 1
        out = with-len(cap)
        pos = 0
        neg == 1 -> {
            out[pos]: {
                ok -> it = 45
                -> _
            }
            pos = pos + 1
        }
        out[pos]: {
            ok -> it = Nstr[0]
            -> _
        }
        pos = pos + 1
        sk > 1 -> {
            out[pos]: {
                ok -> it = 46
                -> _
            }
            pos = pos + 1
            j = 1
            (j < sk) {
                out[pos]: {
                    ok -> it = Nstr[j]
                    -> _
                }
                pos = pos + 1
                j = j + 1
            }
        }
        out[pos]: {
            ok -> it = 101
            -> _
        }
        pos = pos + 1
        E >= 0 -> {
            out[pos]: {
                ok -> it = 43
                -> _
            }
            pos = pos + 1
        }
        E < 0 -> {
            out[pos]: {
                ok -> it = 45
                -> _
            }
            pos = pos + 1
        }
        ; 指數補零至 2 位
        elen > expstr.len-bytes() -> {
            out[pos]: {
                ok -> it = 48
                -> _
            }
            pos = pos + 1
        }
        e = 0
        (e < expstr.len-bytes()) {
            out[pos]: {
                ok -> it = expstr[e]
                -> _
            }
            pos = pos + 1
            e = e + 1
        }
        return
    }

    ; 固定記號
    E >= 0 -> {
        int-digits = E + 1
        cap = int-digits
        best-K > 0 -> cap = int-digits + 1 + best-K
        neg == 1 -> cap = cap + 1
        out = with-len(cap)
        pos = 0
        neg == 1 -> {
            out[pos]: {
                ok -> it = 45
                -> _
            }
            pos = pos + 1
        }
        i = 0
        (i < int-digits) {
            out[pos]: {
                ok -> it = Nstr[i]
                -> _
            }
            pos = pos + 1
            i = i + 1
        }
        best-K > 0 -> {
            out[pos]: {
                ok -> it = 46
                -> _
            }
            pos = pos + 1
            j = int-digits
            (j < k) {
                out[pos]: {
                    ok -> it = Nstr[j]
                    -> _
                }
                pos = pos + 1
                j = j + 1
            }
        }
        return
    }

    ; E < 0：0.00...d
    zeros = 0 - E - 1
    cap = 2 + zeros + k
    neg == 1 -> cap = cap + 1
    out = with-len(cap)
    pos = 0
    neg == 1 -> {
        out[pos]: {
            ok -> it = 45
            -> _
        }
        pos = pos + 1
    }
    out[pos]: {
        ok -> it = 48
        -> _
    }
    pos = pos + 1
    out[pos]: {
        ok -> it = 46
        -> _
    }
    pos = pos + 1
    z = 0
    (z < zeros) {
        out[pos]: {
            ok -> it = 48
            -> _
        }
        pos = pos + 1
        z = z + 1
    }
    i = 0
    (i < k) {
        out[pos]: {
            ok -> it = Nstr[i]
            -> _
        }
        pos = pos + 1
        i = i + 1
    }
    return
}

; f32.to-str: f32 轉字串（方法）
; 透過 f32.to-f64（#{buildin} 拓寬）後複用 f64.to-str 的 Nolang %g 實現。
f32.to-str = () (out str) {
    d = .to-f64()
    out = d.to-str()
}

; ═══════════════════════════════════════════════
; f64 轉字串（可配置精度，方法形式；原 str.f64-to-str-* 函數遷入本模組）
; ═══════════════════════════════════════════════

; f64.to-str-fixed: 定點格式轉換
; precision i64: 小數位數（>= 0，建議 <= 17 以避免 i64 溢出）
; 返回 out str: 字串表示（如 "3.14"、"-0.005"、"100"）
f64.to-str-fixed = (precision i64) (out str) {

    x f64 = .

    ; NaN
    ! (x == x) -> {
        out = 'nan'.copy()
        return
    }

    ; 零（包括 +0.0 和 -0.0）
    #{overflow=wrap}
    {
        x == 0.0 -> {
            neg = 0
            check f64 = 1.0 / x
            check < 0.0 -> neg = 1
            total = 1
            neg == 1 -> total = total + 1
            precision > 0 -> total = total + 1 + precision
            out = with-cap(total)
            pos = 0
            neg == 1 -> {
                out[pos] = 45
                pos = pos + 1
            }
            out[pos] = 48
            pos = pos + 1
            precision > 0 -> {
                out[pos] = 46
                pos = pos + 1
                i <- [0..precision): {
                    out[pos] = 48
                    pos = pos + 1
                }
            }
            return
        }

        x + x == x -> {

            ; 無限
            x < 0.0 -> {
                out = '-inf'.copy()
                return
            }
            out = 'inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax = x
    x < 0.0 -> {
        neg = 1
        ax = 0.0 - x
    }

    ; m = round(ax * 10^precision)
    scale = 1.0
    pi <- [0..precision): {
        scale = scale * 10.0
    }
    scaled = ax * scale

    m i64 = (scaled + 0.5).to-i64()

    ; 將 m 轉為字串
    mstr = m.to-str()
    mn = mstr.len-bytes()

    ; 補零到至少 precision+1 位（保證整數部分至少一位）
    pad = 0

    #{overflow=wrap}
    mn <= precision -> pad = precision + 1 - mn

    ; 計算長度

    #{overflow=wrap}
    digits-len = mn + pad

    #{overflow=wrap}
    int-len = digits-len - precision
    total = digits-len

    #{overflow=wrap}
    neg == 1 -> total = total + 1

    #{overflow=wrap}
    precision > 0 -> total = total + 1
    out = with-cap(total)
    pos = 0

    #{overflow=wrap}
    neg == 1 -> {
        out[pos] = 45
        pos = pos + 1
    }

    ; 整數部分
    j <- [0..int-len): {

        #{overflow=wrap}
        {
            j < pad -> {
                out[pos] = 48
            }

            -> {
                out[pos] = mstr.byte(j - pad)
            }
        }

        #{overflow=wrap}
        pos = pos + 1
    }

    ; 小數部分
    #{overflow=wrap}
    precision > 0 -> {
        out[pos] = 46
        pos = pos + 1
        j <- [0..precision): {

            #{overflow=wrap}
            idx = int-len + j
            {
                idx < pad -> {
                    out[pos] = 48
                }

                -> {
                    out[pos] = mstr.byte(idx - pad)
                }
            }
            pos = pos + 1
        }
    }
}

; f64.to-str-sci: 科學記號格式
; precision i64: 小數部分位數（>= 0）
; 返回 out str: 字串表示（如 "3.14e+2"、"-5.0e-3"）
f64.to-str-sci = (precision i64) (out str) {

    x f64 = .

    ; NaN
    ! (x == x) -> {
        out = 'nan'.copy()
        return
    }

    ; 零
    #{overflow=wrap}
    {
        x == 0.0 -> {
            neg = 0
            check f64 = 1.0 / x
            check < 0.0 -> neg = 1
            total = 5
            neg == 1 -> total = total + 1
            precision > 0 -> total = total + 1 + precision
            out = with-cap(total)
            pos = 0
            neg == 1 -> {
                out[pos] = 45
                pos = pos + 1
            }
            out[pos] = 48
            pos = pos + 1
            precision > 0 -> {
                out[pos] = 46
                pos = pos + 1
                i <- [0..precision): {
                    out[pos] = 48
                    pos = pos + 1
                }
            }
            out[pos] = 101
            pos = pos + 1
            out[pos] = 43
            pos = pos + 1
            out[pos] = 48
            pos = pos + 1
            out[pos] = 48
            return
        }

        x + x == x -> {

            ; 無限
            x < 0.0 -> {
                out = '-inf'.copy()
                return
            }
            out = 'inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax = x
    x < 0.0 -> {
        neg = 1
        ax = 0.0 - x
    }

    ; 計算指數 e = floor(log10(ax))
    ln10 = 2.302585092994046
    lg10 = ax.log10()
    flr = lg10.floor()
    e = flr.to-i64()
    epw f64 = (e + 1).to-f64() * ln10
    upper = epw.exp()

    #{overflow=wrap}
    ax >= upper -> e = e + 1
    bpw = e.to-f64() * ln10
    base = bpw.exp()

    #{overflow=wrap}
    ax < base -> {

        #{overflow=wrap}
        e = e - 1
        bpw2 f64 = e.to-f64() * ln10
        base = bpw2.exp()
    }

    ; m = round(ax / base * 10^precision)
    scale = 1.0
    pi <- [0..precision): {
        scale = scale * 10.0
    }

    m i64 = (ax / base * scale + 0.5).to-i64()

    ; 四捨五入溢出處理（m 變成 10^(precision+1)）
    overflow = 1

    #{overflow=wrap}
    i <- [0..precision + 1): {

        #{overflow=wrap}
        overflow = overflow * 10
    }

    #{overflow=wrap}
    m >= overflow -> {

        #{overflow=wrap}
        m = m / 10
        e = e + 1
    }

    ; 構建 mantissa 字串
    mstr = m.to-str()
    mn = mstr.len-bytes()

    ; 指數位數
    ae = e

    #{overflow=wrap}
    e < 0 -> ae = 0 - ae
    elen = 1
    {
        ae >= 100 -> elen = 3

        ae >= 10 && ae < 100 -> elen = 2
    }

    ; 總長度
    total = mn

    #{overflow=wrap}
    neg == 1 -> total = total + 1

    #{overflow=wrap}
    precision > 0 -> total = total + 1

    #{overflow=wrap}
    total = total + 2 + elen

    #{overflow=wrap}
    elen < 2 -> total = total + 1
    out = with-cap(total)
    pos = 0

    #{overflow=wrap}
    neg == 1 -> {
        out[pos] = 45
        pos = pos + 1
    }

    ; 第一位數字
    out[pos] = mstr.byte(0)

    #{overflow=wrap}
    pos = pos + 1

    ; 小數部分
    #{overflow=wrap}
    precision > 0 -> {
        out[pos] = 46
        pos = pos + 1
        j <- [0..precision): {

            #{overflow=wrap}
            idx = j + 1
            {
                idx < mn -> {
                    out[pos] = mstr.byte(idx)
                }

                -> {
                    out[pos] = 48
                }
            }
            pos = pos + 1
        }
    }

    ; 'e' 和符號
    out[pos] = 101

    #{overflow=wrap}
    pos = pos + 1
    {
        e < 0 -> {
            out[pos] = 45
        }

        -> {
            out[pos] = 43
        }
    }

    #{overflow=wrap}
    pos = pos + 1

    ; 指數位數（至少 2 位，前導補零）
    estr = ae.to-str()
    elen2 = estr.len-bytes()

    #{overflow=wrap}
    elen2 == 1 -> {
        out[pos] = 48
        pos = pos + 1
    }
    j <- [0..elen2): {

        out[pos] = estr.byte(j)

        #{overflow=wrap}
        pos = pos + 1
    }
}

; f64.to-str-general: 通用格式（自動選擇定點或科學記號）
; precision i64: 最大有效數字位數（>= 1）
; 返回 out str: 字串表示（自動去尾隨零）
f64.to-str-general = (precision i64) (out str) {

    x f64 = .

    ; NaN
    ! (x == x) -> {
        out = 'nan'.copy()
        return
    }

    ; 零
    #{overflow=wrap}
    {
        x == 0.0 -> {
            neg = 0
            check f64 = 1.0 / x
            check < 0.0 -> neg = 1
            out = with-cap(2)
            pos = 0
            neg == 1 -> {
                out[pos] = 45
                pos = pos + 1
            }
            out[pos] = 48
            return
        }

        x + x == x -> {

            ; 無限
            x < 0.0 -> {
                out = '-inf'.copy()
                return
            }
            out = 'inf'.copy()
            return
        }
    }

    ; 符號處理
    neg = 0
    ax = x
    x < 0.0 -> {
        neg = 1
        ax = 0.0 - x
    }

    ; 計算指數
    ln10 = 2.302585092994046
    lg10 = ax.log10()
    flr = lg10.floor()
    e = flr.to-i64()
    epw f64 = (e + 1).to-f64() * ln10
    upper = epw.exp()

    #{overflow=wrap}
    ax >= upper -> e = e + 1
    bpw = e.to-f64() * ln10
    base = bpw.exp()

    #{overflow=wrap}
    ax < base -> {

        #{overflow=wrap}
        e = e - 1
        bpw2 f64 = e.to-f64() * ln10
        base = bpw2.exp()
    }

    ; m = round(ax / base * 10^(precision-1))
    #{overflow=wrap}
    p-1 = precision - 1
    scale = 1.0
    pi <- [0..p-1): {
        scale = scale * 10.0
    }
    m i64 = (ax / base * scale + 0.5).to-i64()

    ; 四捨五入溢出處理
    overflow = 1
    i <- [0..precision): {

        #{overflow=wrap}
        overflow = overflow * 10
    }

    #{overflow=wrap}
    m >= overflow -> {

        #{overflow=wrap}
        m = m / 10
        e = e + 1
    }

    ; mantissa 字串
    mstr = m.to-str()
    mn = mstr.len-bytes()
    pad = 0

    #{overflow=wrap}
    mn < precision -> {
        tmp-pad = precision - mn
        pad = tmp-pad: {
            ok -> it
            -> 0
        }
    }

    ; 找最後一個非零位（用於去尾隨零）
    last-nz = 0

    ; D1：`-` 的結果恆為 `?i64`，`i` 全程當普通整數用 → 兩段式 match 解包。
    #{overflow=wrap}
    i-opt = precision - 1
    i = 0
    i-opt: {
        ok -> i = it
        -> i = 0
    }
    (i >= 0) {

        #{overflow=wrap}
        idx = i - pad
        idx >= 0 -> mstr.byte(idx) != 48 -> {
            last-nz = i
            i = -1
        }

        #{overflow=wrap}
        i = i - 1
    }

    ; 決定格式：%g 規則
    use-sci = 0
    {
        e < -4 -> use-sci = 1

        e >= precision -> use-sci = 1
    }

    #{overflow=wrap}
    use-sci == 1 -> {

        ; 科學記號
        ae i64 = e
        e < 0 -> ae = 0 - ae
        elen = 1
        ae >= 100 -> elen = 3
        ae >= 10 && ae < 100 -> elen = 2
        total = 1
        neg == 1 -> total = total + 1
        last-nz >= 1 -> total = total + 1 + last-nz
        total = total + 2 + elen
        elen < 2 -> total = total + 1
        out = with-cap(total)
        pos = 0
        neg == 1 -> {
            out[pos] = 45
            pos = pos + 1
        }

        ; 第一位數字
        {
            pad > 0 -> out[pos] = 48
            -> out[pos] = mstr.byte(0)
        }
        pos = pos + 1

        ; 小數部分
        last-nz >= 1 -> {
            out[pos] = 46
            pos = pos + 1
            j <- [1..last-nz + 1): {

                #{overflow=wrap}
                idx = j - pad
                {
                    idx >= 0 && idx < mn -> out[pos] = mstr.byte(idx)
                    -> out[pos] = 48
                }
                pos = pos + 1
            }
        }

        ; 'e' 和符號
        out[pos] = 101
        pos = pos + 1
        {
            e < 0 -> out[pos] = 45
            -> out[pos] = 43
        }
        pos = pos + 1

        ; 指數位數（至少 2 位）
        estr = ae.to-str()
        elen2 = estr.len-bytes()
        elen2 == 1 -> {
            out[pos] = 48
            pos = pos + 1
        }
        j <- [0..elen2): {
            out[pos] = estr.byte(j)
            pos = pos + 1
        }
        return
    }

    ; 定點格式（e >= 0）：委託 f64.to-str-fixed 後去除尾隨零（%g 語意）
    #{overflow=wrap}
    e >= 0 -> {
        ; e 為普通 i64（非 option），直接參與運算；`-` 結果為 ?i64 → 兩段式解包
        #{overflow=wrap}
        dp-opt = precision - 1 - e
        dec-places i64 = 0
        dp-opt: {
            ok -> dec-places = it
            -> dec-places = 0
        }
        dec-places < 0 -> dec-places = 0
        s str = x.to-str-fixed(dec-places)
        n = s.len-bytes()
        dot-pos = -1
        i <- [0..n): {
            s.byte(i) == 46 -> dot-pos = i
        }
        dot-pos >= 0 -> {
            end = n
            (end > dot-pos + 1) {
                s.byte(end - 1) == 48 -> end = end - 1
                -> break
            }
            end > dot-pos + 1 -> {
                s.byte(end - 1) == 46 -> end = end - 1
            }
            out = s.slice-bytes(0, end)
            return
        }
        out = s
        return
    }

    ; 定點格式（e < 0: 0.00dddd）

    #{overflow=wrap}
    lead-zeros = 0 - e - 1

    #{overflow=wrap}
    total = 2 + lead-zeros + last-nz + 1

    #{overflow=wrap}
    neg == 1 -> total = total + 1
    out = with-cap(total)
    pos = 0

    #{overflow=wrap}
    neg == 1 -> {
        out[pos] = 45
        pos = pos + 1
    }
    out[pos] = 48

    #{overflow=wrap}
    pos = pos + 1
    out[pos] = 46

    #{overflow=wrap}
    pos = pos + 1
    j <- [0..lead-zeros): {
        out[pos] = 48

        #{overflow=wrap}
        pos = pos + 1
    }

    #{overflow=wrap}
    j <- [0..last-nz + 1): {

        #{overflow=wrap}
        idx = j - pad
        {
            idx >= 0 && idx < mn -> out[pos] = mstr.byte(idx)
            -> out[pos] = 48
        }

        #{overflow=wrap}
        pos = pos + 1
    }
}

; ═══════════════════════════════════════════════
; 數值寬度轉換方法（已取代、刪除舊的 math 函數形式）
;   f64-to-i64(.) -> .to-i64()   i64-to-f64(.) -> .to-f64()
;   f32-to-f64(.) -> .to-f64()   f64-to-f32(.) -> .to-f32()
; 每個方法即 #{buildin}：無 Nolang 包裝、也不委託 math.* 內在函數——
; 底層直接走 builtin.LLVMConv（strconv.go 以 Receiver<型別> + "<型別>.to-<目標>"
; 註冊，浮點轉整數一律用 saturating intrinsic）。上方 to-str 方法同理：
; 有原生格式化器（i64）者走 #{buildin}，僅有 Nolang 例程（u64/f64）者直接在
; 方法本體以 Nolang 實現，窄整型則拓寬複用上述方法。
; ═══════════════════════════════════════════════

; f64.to-i64: 浮點轉整數（截斷）
#{buildin}
f64.to-i64 = () (out i64) {
}

; i64.to-f64: 整數轉浮點
#{buildin}
i64.to-f64 = () (out f64) {
}

; f32.to-f64: 將 f32 提升為 f64
#{buildin}
f32.to-f64 = () (out f64) {
}

; f64.to-f32: 將 f64 降為 f32（可能損失精度）
#{buildin}
f64.to-f32 = () (out f32) {
}

; u64.to-f64: 無號整數轉浮點
#{buildin}
u64.to-f64 = () (out f64) {
}

; f64.to-bits: 以 u64 取出 f64 的 64 位元 IEEE-754 位元模式（bitcast double→i64）。
; 由 src/builtin/bits.go 註冊 ForwardFunc "f64-to-bits"，原生 LLVM bitcast 實作，
; 不依賴 libm。f64.to-str 最短往返展開前先取位元模式，再拆 sign/exp/frac。
#{buildin}
f64.to-bits = () (out u64) {
}

; u64.from-bits: f64.to-bits 的逆運算（bitcast i64→double），由原生 LLVM 實作。
#{buildin}
u64.from-bits = () (out f64) {
}

; i128.to-f64: 128 位有號整數轉浮點
#{buildin}
i128.to-f64 = () (out f64) {
}

; u128.to-f64: 128 位無號整數轉浮點
#{buildin}
u128.to-f64 = () (out f64) {
}

; f64.to-u64: 浮點轉 64 位無號整數（饱和）
#{buildin}
f64.to-u64 = () (out u64) {
}

; f64.to-u32: 浮點轉 32 位無號整數（饱和）
#{buildin}
f64.to-u32 = () (out u32) {
}

; f64.to-i32: 浮點轉 32 位有號整數（饱和）
#{buildin}
f64.to-i32 = () (out i32) {
}

; i64.to-i32: 整數位寬收窄（低 32 位截斷）
#{buildin}
i64.to-i32 = () (out i32) {
}

; i64.to-bytes-be: 將 int64 轉為大端序 8 位元組
; 用法：
;   v = 0x1234
;   out = v.to-bytes-be()   // out = [0x00,0x00,0x00,0x00,0x00,0x00,0x12,0x34]
i64.to-bytes-be = () (out [?]byte) {

    out[0] = (. >> 56) & 255

    out[1] = (. >> 48) & 255

    out[2] = (. >> 40) & 255

    out[3] = (. >> 32) & 255

    out[4] = (. >> 24) & 255

    out[5] = (. >> 16) & 255

    out[6] = (. >> 8) & 255

    out[7] = . & 255
}

; i64.to-bytes-le: 將 int64 轉為小端序 8 位元組
; 用法：
;   v = 0x1234
;   out = v.to-bytes-le()   // out = [0x34,0x12,0x00,0x00,0x00,0x00,0x00,0x00]
i64.to-bytes-le = () (out [?]byte) {

    out[0] = . & 255

    out[1] = (. >> 8) & 255

    out[2] = (. >> 16) & 255

    out[3] = (. >> 24) & 255

    out[4] = (. >> 32) & 255

    out[5] = (. >> 40) & 255

    out[6] = (. >> 48) & 255

    out[7] = (. >> 56) & 255
}

; 注意：不定義 float.to-str 聯合方法（原因見 std/float.no 末尾說明）。

; int.div / int.mod 已移至 std/int.no；float.div 已移至 std/float.no

; float.is-nan / float.is-inf 已移至 std/float.no

; f32 同名方法：以下所有 f64 方法均配 f32 版本，方法體統一
; 「f32-to-f64 拓寬 → 調 f64 方法 → f64-to-f32 收窄」（同上方
; f32.to-str 先例），以 double 精度計算後收窄。不寫成 float
; union 泛型方法：#{buildin} 空體樁沒有函數體可供 monomorphizeUnions
; 單態化複製；純 .no 方法（degrees/radians/cbrt）的 f32 實例體內
; f32*f64 混合算術會被提升成 f64，破壞「接收者 f32 → 返回 f32」。
; 故具體雙套（f64./f32.）是唯一穩定形態。

; 幂与根（f64/f32 方法）
#{buildin}
f64.sqrt = () (res f64) {
}

f32.sqrt = () (res f32) {
    d = .to-f64()
    res = d.sqrt().to-f32()
}

; cbrt: 立方根（f64 方法）
; 使用 exp(log(|x|) / 3) 實現；方法體不调 pow（整數冪 pow 見本模組，f64 pow 見 std/math.no）
f64.cbrt = () (res f64) {
    . == 0.0 -> {
        res = 0.0
        return
    }
    {
        . < 0.0 -> {
            ax f64 = 0.0 - .
            l f64 = ax.log()
            t f64 = l / 3.0
            res = 0.0 - exp-f64(t)
        }

        -> {
            l f64 = .log()
            t f64 = l / 3.0
            res = exp-f64(t)
        }
    }
}

f32.cbrt = () (res f32) {
    d = .to-f64()
    res = d.cbrt().to-f32()
}

; pow: 整數冪 base^n（n ≥ 0，i64）—— 供 number.pow 呼叫（模組前綴）。
; 與 math.no 的 f64 pow 同名但不同模組，構建期加 number. 前綴；
; 與 math.pow-int（int 泛型快速冪）同義，但明確 i64 簽名以符合
; test/std/number.no 的 number.pow(2, 10) 等斷言。
pow = (base i64, n i64) (res i64) {
    rn = n
    res = 1
    b = base
    (rn > 0) {

        #{overflow=wrap}
        rn & 1 == 1 -> res = res * b

        #{overflow=wrap}
        b = b * b
        rn = rn >> 1
    }
}

; 三角函数（弧度；f64/f32 方法）
f64.sin = () (res f64) {
    twopi = 6.283185307179586
    pi = 3.141592653589793
    ax = .
    ax < 0.0 -> {
        ax = 0.0 - ax
    }
    q = (ax / twopi).to-i64()
    y = ax - q.to-f64() * twopi
    sgn = 1.0
    . < 0.0 -> {
        sgn = -1.0
    }
    y > pi -> {
        y = y - pi
        sgn = 0.0 - sgn
    }
    y > pi / 2.0 -> {
        y = pi - y
    }
    y2 = y * y
    y3 = y2 * y
    y5 = y3 * y2
    y7 = y5 * y2
    y9 = y7 * y2
    y11 = y9 * y2
    y13 = y11 * y2
    s = y - y3 / 6.0 + y5 / 120.0 - y7 / 5040.0 + y9 / 362880.0 - y11 / 39916800.0 + y13 / 6227020800.0
    res = sgn * s
}

f32.sin = () (res f32) {
    d = .to-f64()
    res = d.sin().to-f32()
}

f64.cos = () (res f64) {
    res = (. + 1.5707963267948966).sin()
}

f32.cos = () (res f32) {
    d = .to-f64()
    res = d.cos().to-f32()
}

; tan: tangent（libm tan，等价于 sin/cos）
f64.tan = () (res f64) {
    s = .sin()
    c = .cos()
    res = s / c
}

f32.tan = () (res f32) {
    d = .to-f64()
    res = d.tan().to-f32()
}

f64.asin = () (res f64) {
    s = . * .
    one = 1.0 - s
    res = math.atan2(., one.sqrt())
}

f32.asin = () (res f32) {
    d = .to-f64()
    res = d.asin().to-f32()
}

f64.acos = () (res f64) {
    s = . * .
    one = 1.0 - s
    res = math.atan2(one.sqrt(), .)
}

f32.acos = () (res f32) {
    d = .to-f64()
    res = d.acos().to-f32()
}

f64.atan = () (res f64) {
    res = math.atan2(., 1.0)
}

f32.atan = () (res f32) {
    d = .to-f64()
    res = d.atan().to-f32()
}

; 雙曲函數（f64/f32 方法）
f64.sinh = () (res f64) {
    e = .exp()
    ei = 1.0 / e
    res = (e - ei) / 2.0
}

f32.sinh = () (res f32) {
    d = .to-f64()
    res = d.sinh().to-f32()
}

f64.cosh = () (res f64) {
    e = .exp()
    ei = 1.0 / e
    res = (e + ei) / 2.0
}

f32.cosh = () (res f32) {
    d = .to-f64()
    res = d.cosh().to-f32()
}

f64.tanh = () (res f64) {
    e = .exp()

    ; tanh(x) = (e^2 - 1) / (e^2 + 1)
    res = (e * e - 1.0) / (e * e + 1.0)
}

f32.tanh = () (res f32) {
    d = .to-f64()
    res = d.tanh().to-f32()
}

; 取整（f64/f32 方法；整數型別上取整為恆等，故不提供泛型版本）
f64.ceil = () (res f64) {
    t = (.to-i64()).to-f64()
    . == t -> {
        res = t
    }
    . > 0.0 -> {
        res = t + 1.0
    }

    -> {
        res = t
    }
}

f32.ceil = () (res f32) {
    d = .to-f64()
    res = d.ceil().to-f32()
}

f64.floor = () (res f64) {
    t = (.to-i64()).to-f64()
    . == t -> {
        res = t
    }
    . < 0.0 -> {
        res = t - 1.0
    }

    -> {
        res = t
    }
}

f32.floor = () (res f32) {
    d = .to-f64()
    res = d.floor().to-f32()
}

f64.round = () (res f64) {
    t = (.to-i64()).to-f64()
    f = . - t
    . >= 0.0 -> {
        f >= 0.5 -> {
            res = t + 1.0
        }

        -> {
            res = t
        }
    }

    -> {
        f <= -0.5 -> {
            res = t - 1.0
        }

        -> {
            res = t
        }
    }
}

f32.round = () (res f32) {
    d = .to-f64()
    res = d.round().to-f32()
}

f64.trunc = () (res f64) {
    res = (.to-i64()).to-f64()
}

f32.trunc = () (res f32) {
    d = .to-f64()
    res = d.trunc().to-f32()
}

; 指数对数（f64/f32 方法）
; exp-f64: 自由函數形式（接受參數 x，而非方法接收者）。
; 作為 f64.exp / cbrt / sinh / cosh / f32.exp 的單一實現來源。
; 注意：Nolang 當前對「具名區域變數上的方法呼叫」(如 t.exp()) 有
; codegen bug，會誤用外層接收者；故所有對 exp 的間接呼叫都走本
; 自由函數，避開該問題。
exp-f64 = (x f64) (res f64) {
    x > 709.0 -> {
        res = 1.0 / 0.0
        return
    }
    x < -745.0 -> {
        res = 0.0
        return
    }
    ln2 = 0.6931471805599453
    k = (x / ln2).to-i64()
    r = x - k.to-f64() * ln2
    r2 = r * r
    e = 1.0 + r + r2 / 2.0 + r2 * r / 6.0 + r2 * r2 / 24.0 + r2 * r2 * r / 120.0 + r2 * r2 * r2 / 720.0 + r2 * r2 * r2 * r / 5040.0 + r2 * r2 * r2 * r2 / 40320.0
    res = e
    ki = k
    ki > 0 -> {
        i <- [0..ki): {
            res = res * 2.0
        }
    }

    #{overflow=wrap}
    ni = 0 - ki
    ni > 0 -> {
        i <- [0..ni): {
            res = res / 2.0
        }
    }
}

f64.exp = () (res f64) {
    res = exp-f64(.)
}

f32.exp = () (res f32) {
    d = .to-f64()
    res = exp-f64(d).to-f32()
}

f64.log = () (res f64) {
    x = .
    x <= 0.0 -> {
        res = 0.0 / 0.0
        return
    }
    k = 0
    i <- [0..2000): {
        x < 2.0 -> break
        x = x / 2.0

        #{overflow=wrap}
        k = k + 1
    }
    i <- [0..2000): {
        x >= 1.0 -> break
        x = x * 2.0

        #{overflow=wrap}
        k = k - 1
    }
    i <- [0..20): {
        x <= 1.414213562373095 -> break
        x = x / 2.0

        #{overflow=wrap}
        k = k + 1
    }
    z = (x - 1.0) / (x + 1.0)
    z2 = z * z
    z3 = z2 * z
    z5 = z3 * z2
    z7 = z5 * z2
    z9 = z7 * z2
    lnf = 2.0 * (z + z3 / 3.0 + z5 / 5.0 + z7 / 7.0 + z9 / 9.0)
    ln2 = 0.6931471805599453
    res = k.to-f64() * ln2 + lnf
}

f32.log = () (res f32) {
    d = .to-f64()
    res = d.log().to-f32()
}

f64.log10 = () (res f64) {
    res = .log() / 2.302585092994046
}

f32.log10 = () (res f32) {
    d = .to-f64()
    res = d.log10().to-f32()
}

f64.log2 = () (res f64) {
    res = .log() / 0.6931471805599453
}

f32.log2 = () (res f32) {
    d = .to-f64()
    res = d.log2().to-f32()
}

; degrees: 弧度轉角度（f64/f32 方法）
f64.degrees = () (res f64) {
    res = . * 180.0 / math.PI
}

f32.degrees = () (res f32) {
    d = .to-f64()
    res = d.degrees().to-f32()
}

; radians: 角度轉弧度（f64/f32 方法）
f64.radians = () (res f64) {
    res = . * math.PI / 180.0
}

f32.radians = () (res f32) {
    d = .to-f64()
    res = d.radians().to-f32()
}

; sqrt: 整數平方根 floor(√n)——i64 方法
; n < 0 時整數域無解，返回 0；二分搜尋 O(log n)，比較用 n/mid 而非
; mid*mid，無溢出（同 math.no gcd/even 的 wrap 註解慣例）。
; 不用 int 聯合接收者（本可全寬度通用）：int 別名定義在 std/int.no，
; 跨模組声明 `int.X` 方法會被 prefixMethodNames 雙重加前綴成
; `int.int.X`，呼叫點單態化匹配不到，報 unknown callee。
i64.sqrt = () (r i64) {
    n = .
    n < 0 -> {
        r = 0
        return
    }
    n < 2 -> {
        r = n
        return
    }
    lo = 1

    #{overflow=wrap}
    hi = n / 2
    r = 1
    (lo <= hi) {

        #{overflow=wrap}
        mid = (lo + hi) / 2

        #{overflow=wrap}
        q = n / mid
        {
            mid <= q -> {
                r = mid

                #{overflow=wrap}
                lo = mid + 1
            }

            -> {

                #{overflow=wrap}
                hi = mid - 1
            }
        }
    }
}

; is-prime: 是否為質數——i64 方法
; 試除法 O(√n)：先排除偶數，再試除奇因數；終止條件用 d <= n/d
; 避免 d*d 溢出，除數恆 ≥ 1 不會 trap（同樣不用 int 聯合接收者，見上）
i64.is-prime = () (yes bool) {
    n = .
    n < 2 -> {
        yes = false
        return
    }

    #{overflow=wrap}
    m2 = n % 2
    m2 == 0 -> {
        yes = (n == 2)
        return
    }
    d = 3

    #{overflow=wrap}
    lim = n / d
    (d <= lim) {

        #{overflow=wrap}
        md = n % d
        md == 0 -> {
            yes = false
            return
        }

        #{overflow=wrap}
        d = d + 2

        #{overflow=wrap}
        lim = n / d
    }
    yes = true
}

; ── 全寬度整數方法副本 ──
; sqrt / is-prime 對 i8 i16 i32 u8 u16 u32 u64 各配具體型別版本
; （int 聯合接收者不可用：別名定義在 std/int.no，跨模組声明雙重前綴，
; 見上方 i64.sqrt 註解）。也不能經 i64 委託：u64 值域超出 i64，
; 且無整數縮窄轉換內建可把 i64 結果歸還具體窄型。
; i8/u64 曾因編譯器缺口（i8 拓寬按無符號、比較恒用有符號謂詞）暫缺，
; 修復 hir2mir 無符號比較/除法路由（含嵌套子表達式遞迴探測、接收者綁定
; `n T = .` 的 localRaw 回退記錄）與 codegen coerceIntSigned（i8 按宣告型
; sext）後已補齊。
; i128/u128 除範圍常數與 .to-str() 外，亦提供 sqrt/is-prime（見下方
; 「128 位整數方法副本」小節的標型與溢出註解要點）。
; 128 位算術本身沒壞——把運算元顯式宣告為 i128/u128（帶型區域變數），
; + − × ÷ % 在完整 128 位值域上結果正確（二分搜尋 sqrt 於 1e24、
; i128.MAX、u128.MAX 上均得精確 ⌊√n⌋）。先前診斷出的兩處缺口皆已修通：
; ① 溢出策略與 128 位交會——迴圈內整數算術需 `#{overflow=wrap}`，早期 i128
;   位的 wrap 註解 lowering 會 derail 呼叫端 codegen（合成 main 丟棄頂層敘述），
;   現以「顯式標型區域變數 + 註解獨立成行」的形式落地，既過 vet 又執行期正確。
; ② u128 比較/除法誤走有符號謂詞——codegen isUnsignedRaw 漏列 u128，修正後
;   u128.MAX 值域（≥ 2^127）不再誤序。
; （範圍常數經 hir2mir 的 typeConstantText128 常數表（i128 lane，全精度十進位
; 文字走 Inst.IntBig）取值；128 位字面量直接宣告給帶型區域變數、其 .to-str()
; （經 int.to-str 或原生 @str_from_i128/@str_from_u128）、以及對合法 128 位值
; 的比較，均已驗證。）

; i8（有符號：保留負數守衛）
i8.sqrt = () (r i8) {
    n = .
    n < 0 -> {
        r = 0
        return
    }
    n < 2 -> {
        r = n
        return
    }
    lo i8 = 1

    #{overflow=wrap}
    hi = n / 2
    r = 1
    (lo <= hi) {

        mid i8 = 0

        #{overflow=wrap}
        mid = (lo + hi) / 2
        q i8 = 0

        #{overflow=wrap}
        q = n / mid
        {
            mid <= q -> {
                r = mid

                #{overflow=wrap}
                lo = mid + 1
            }

            -> {

                #{overflow=wrap}
                hi = mid - 1
            }
        }
    }
}

i8.is-prime = () (yes bool) {
    n = .
    n < 2 -> {
        yes = false
        return
    }
    m2 i8 = 0

    #{overflow=wrap}
    m2 = n % 2
    m2 == 0 -> {
        yes = (n == 2)
        return
    }
    d i8 = 3

    #{overflow=wrap}
    lim = n / d
    (d <= lim) {
        md i8 = 0

        #{overflow=wrap}
        md = n % d
        md == 0 -> {
            yes = false
            return
        }

        #{overflow=wrap}
        d = d + 2

        #{overflow=wrap}
        lim = n / d
    }
    yes = true
}

