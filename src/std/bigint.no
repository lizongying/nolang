; bigint — 任意精度整數
;
; 使用 base 2^32 little-endian []i64 切片表示。
; 每個 i64 元素儲存一個 32-bit limb，高位在前導位置。
; 負數以 sign 欄位標記（符號-絕對值表示）。
;
; 與 crypto/rsa.no 共用相同的底層 []i64 表示，
; 本模組提供完整的大數運算庫。

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; MASK: 32-bit 遮罩
MASK = 4294967295

; BASE: 2^32
BASE = 4294967296

; ═══════════════════════════════════════════════
; 型別定義
; ═══════════════════════════════════════════════

; bigint: 任意精度整數
bigint {
    sign i64
    limbs []i64
    len i64
}

; ═══════════════════════════════════════════════
; 建構與初始化
; ═══════════════════════════════════════════════

; from-i64: 從 i64 建立 bigint
from-i64 = (v i64) (out bigint) {
    r-v = v
    {
        r-v < 0 -> {
            out.sign = -1

            #{overflow=wrap}
            r-v = 0 - r-v
        }

        -> out.sign = 1
    }

    ; i64 需要最多 2 個 32-bit limb；原本只寫單一 limb，
    ; |v| >= 2^32 時後續運算會把它當 32-bit 遮罩而截斷（如 from-i64(2^52) 變 0）。
    lo-v = r-v & MASK
    hi-v = r-v >> 32
    hi-v > 0 -> {
        out.limbs = with-len(2)
        out.limbs[0] = lo-v
        out.limbs[1] = hi-v
        out.len = 2
    }
    -> {
        out.limbs = with-len(1)
        out.limbs[0] = lo-v
        out.len = 1
    }
}

; from-u64: 從無號 i64 建立 bigint（永遠正數）
from-u64 = (v i64) (out bigint) {
    out.sign = 1

    ; 同 from-i64：需拆成 32-bit limb，避免 >= 2^32 截斷
    u-lo = v & MASK
    u-hi = v >> 32
    u-hi > 0 -> {
        out.limbs = with-len(2)
        out.limbs[0] = u-lo
        out.limbs[1] = u-hi
        out.len = 2
    }
    -> {
        out.limbs = with-len(1)
        out.limbs[0] = u-lo
        out.len = 1
    }
}

; zero: 建立零值 bigint
zero = () (out bigint) {
    out.limbs = with-len(1)
    out.sign = 1

    out.limbs[0] = 0
    out.len = 1
}

; one: 建立壹值 bigint
one = () (out bigint) {
    out.limbs = with-len(1)
    out.sign = 1

    out.limbs[0] = 1
    out.len = 1
}

; bigint.copy: 深度複製 bigint
; ⚠️ 不棄用（與 str/txt.copy 不同）：賦值 `b = a` 只複製 {sign,limbs,len} 描述符、
; 與 a 共享同一條 limbs 緩衝區（實測 a.limbs[0] = 99 後 b.limbs[0] 同為 99），
; 不具深拷貝語義。需要獨立快照時必須使用本方法。
bigint.copy = () (out bigint) {
    out.limbs = with-len(.len)
    out.sign = .sign
    out.len = .len
    i <- [0...len): {

        out.limbs[i] = .limbs[i]
    }
}

; ═══════════════════════════════════════════════
; 比較運算
; ═══════════════════════════════════════════════

; bigint.cmp: 比較 self 和 b（1=大, 0=等, -1=小）
bigint.cmp = (b bigint) (r i64) {

    .sign != b.sign -> {
        r = .sign
        return
    }
    result = .abs-cmp(b)

    #{overflow=wrap}
    r = result * .sign
}

; bigint.abs-cmp: 比較 |self| 和 |b|（1=大, 0=等, -1=小）
bigint.abs-cmp = (b bigint) (r i64) {

    {
        .len > b.len -> {
            r = 1
            return
        }

        .len < b.len -> {
            r = -1
            return
        }
    }

    i <- [.len - 1..0]: {

        .limbs[i] > b.limbs[i] -> {
            r = 1
            return
        }
        .limbs[i] < b.limbs[i] -> {
            r = -1
            return
        }
    }
    r = 0
}

; bigint.is-zero: 是否為零
bigint.is-zero = () (r bool) {

    r = .len == 1 && .limbs[0] == 0
}

; bigint.is-neg: 是否為負數
bigint.is-neg = () (r bool) {
    r = .sign == -1
}

; bigint.is-pos: 是否為正數
bigint.is-pos = () (r bool) {
    r = .sign == 1 && ! .is-zero()
}

; bigint.eq: self == b ?
bigint.eq = (b bigint) (r bool) {

    r = false
    .sign != b.sign -> return
    .len != b.len -> return

    i <- [.len - 1..0]: {

        .limbs[i] & MASK != b.limbs[i] & MASK -> {

            return
        }
    }
    r = true
}

; ═══════════════════════════════════════════════
; 加法與減法
; ═══════════════════════════════════════════════

; _add: a + b（運算符重載；書寫 ?bigint，編譯器視作 bigint）
; 註：`b.abs-sub(s)` 的實參須為具名變數——裸 `.` 作「方法呼叫」實參存在
; 既有降級缺口（實參被降成 zeroinitializer 傳值 → 段錯誤），故先 `s = .` 捕获。
bigint._add = (b bigint) (c ?bigint) {
    s = .
    .sign == b.sign -> {
        c = .abs-add(b)
        c.sign = .sign
        return
    }
    ac = .abs-cmp(b)
    {
        ac >= 0 -> {
            c = .abs-sub(b)
            c.sign = .sign
        }

        -> {
            c = b.abs-sub(s)
            c.sign = -.sign
        }
    }
}

; _sub: a - b（運算符重載；實參具名化理由同 _add）
bigint._sub = (b bigint) (c ?bigint) {
    s = .
    .sign != b.sign -> {
        c = .abs-add(b)
        c.sign = .sign
        return
    }
    ac = .abs-cmp(b)
    {
        ac >= 0 -> {
            c = .abs-sub(b)
            c.sign = .sign
        }

        -> {
            c = b.abs-sub(s)
            c.sign = -.sign
        }
    }
}

; _mul: a * b（運算符重載）
bigint._mul = (b bigint) (c ?bigint) {

    al = .len
    bl = b.len

    #{overflow=wrap}
    c.limbs = with-len(al + bl)

    #{overflow=wrap}
    c.len = al + bl

    i <- [0..al + bl): {

        c.limbs[i] = 0
    }
    i <- [0..al): {

        ; av*bv 可達 (2^32-1)^2 ≈ 2^64，超過 i64 上限會溢出成負數、
        ; 而 i64 的 >> 是算術（符號擴展）移位，會把高位全部污染。
        ; 因此產品運算全部走 u64（邏輯 >>、乾淨 &）。limb 值本身仍落在
        ; [0,2^32)，可安全存回 []i64。
        carry u64 = 0
        av u64 = (.limbs[i] & MASK) u64
        j <- [0..bl): {

            ; 累積順序：先 av*bv（< 2^64），再加既有 limb（< 2^32），最後加 carry
            ; （< 2^32）。三者之和嚴格小於 2^64，故全程不會回繞，carry 正確落在
            ; [0, 2^32)。Nolang 的 u64 乘法是 mod 2^64 正確、>> 為邏輯移位、& 低位乾淨。
            bv u64 = (b.limbs[j] & MASK) u64
            p u64 = av * bv
            p = p + (c.limbs[i + j] & MASK) u64
            p = p + carry
            c.limbs[i + j] = (p & 4294967295) i64
            carry = p >> 32
        }

        #{overflow=wrap}
        c.limbs[i + bl] = carry i64
    }

    #{overflow=wrap}
    c.sign = .sign * b.sign
    c.normalize()
}

; _div: a / b（運算符重載；除零依 div-mod 回傳零；`.` 作自由函数實參為安全模式）
bigint._div = (b bigint) (q ?bigint) {
    r = bigint {}
    q, r = div-mod(., b)
}

; _mod: a % b（運算符重載；除零依 div-mod 回傳零）
bigint._mod = (b bigint) (r ?bigint) {
    q = bigint {}
    q, r = div-mod(., b)
}

; abs-add: |self| + |b|（忽略正負號）
bigint.abs-add = (b bigint) (c bigint) {

    carry = 0
    al = .len
    bl = b.len
    cl = al
    bl > al -> cl = bl

    #{overflow=wrap}
    c.limbs = with-len(cl + 1)

    #{overflow=wrap}
    c.len = cl + 1
    i <- [0..cl): {

        av = 0
        i < al -> {

            av = .limbs[i]
        }
        bv = 0
        i < bl -> {

            bv = b.limbs[i]
        }

        #{overflow=wrap}
        s = av + bv + carry

        c.limbs[i] = s & MASK
        carry = s >> 32
    }

    c.limbs[cl] = carry
    c.normalize()
}

; bigint.abs-sub: |self| - |b|（假設 |self| >= |b|，忽略正負號）
bigint.abs-sub = (b bigint) (c bigint) {
    borrow = 0
    al = .len
    bl = b.len
    c.limbs = with-len(al)
    c.len = al
    i <- [0..al): {

        av = .limbs[i]
        bv = 0
        i < bl -> {

            bv = b.limbs[i]
        }

        #{overflow=wrap}
        d = av - borrow - bv

        #{overflow=wrap}
        {
            d < 0 -> {

                #{overflow=wrap}
                d = d + BASE
                borrow = 1
            }

            -> borrow = 0
        }

        c.limbs[i] = d & MASK
    }
    c.normalize()
}

; ═══════════════════════════════════════════════
; 乘法
; ═══════════════════════════════════════════════

; mul-i64: a * v（小整數乘法）
mul-i64 = (a bigint, v i64) (c bigint) {
    r-v = v
    sign = a.sign

    #{overflow=wrap}
    r-v < 0 -> {

        sign = -sign
        r-v = 0 - r-v
    }

    ; 把 r-v（完整 64-bit 無號值）拆成至多 2 個 32-bit limb，再交給 mul 處理。
    ; 原實作用 (r-v & MASK) 只取低 32 位，當 |v| >= 2^32（如 10^10）時會錯誤截斷。
    lo-v = r-v & MASK
    hi-v = r-v >> 32
    b = bigint {}
    hi-v > 0 -> {
        b.limbs = with-len(2)
        b.limbs[0] = lo-v
        b.limbs[1] = hi-v
        b.len = 2
    } -> {
        b.limbs = with-len(1)
        b.limbs[0] = lo-v
        b.len = 1
    }
    b.sign = 1
    c = a._mul(b)
    c.sign = sign
}

; ═══════════════════════════════════════════════
; 除法
; ═══════════════════════════════════════════════

; div-mod: a / b, 同時傳回商和餘數
div-mod = (a bigint, b bigint) (q bigint, r bigint) {

    b.len == 1 && b.limbs[0] == 0 -> {
        q = zero()
        r = zero()
        return
    }
    ac = a.abs-cmp(b)

    #{overflow=wrap}
    {
        ac < 0 -> {
            q = zero()
            r = a.copy()
            return
        }

        ac == 0 -> {
            q = one()
            q.sign = a.sign * b.sign
            r = zero()
            return
        }
    }

    ; 單 limb 除數：使用簡單的 div-i64/mod-i64
    #{overflow=wrap}
    b.len == 1 -> {

        v = b.limbs[0] & MASK
        q = div-i64(a, v)
        r.limbs = with-len(1)

        r.limbs[0] = mod-i64(a, v)
        r.len = 1
        q.sign = a.sign * b.sign
        r.sign = a.sign
        return
    }

    #{overflow=wrap}
    q.len = a.len - b.len + 1
    q.limbs = with-len(q.len)
    i <- [0..q.len): {

        q.limbs[i] = 0
    }
    bl = b.len

    ; 正規化位移：讓除數最高 limb >= BASE/2。
    ; 用 u64 與 (bt >> 31 == 0) 判斷，避免 i64 有符號比較把 [2^31,2^32) 誤判為負數而過度位移。
    bt u64 = (b.limbs[bl - 1] & MASK) u64
    shift = 0
    (bt >> 31 == 0) {
        bt = bt << 1
        shift = shift + 1
    }

    ; 正規化除數 norm-b = b << shift
    ; Knuth D 要求「估商」與「乘減/加回」使用同一個正規化除數；
    ; 原實作估商用正規化的 bt，乘減卻用未正規化的 b.limbs，兩者不一致導致商與餘數皆錯。
    norm-b []i64 = with-len(bl)
    nb-carry = 0
    nbi <- [0..bl): {

        nbv = (b.limbs[nbi] & MASK) << shift | nb-carry
        norm-b[nbi]: {
            ok -> it = nbv & MASK
            -> _
        }
        nb-carry = nbv >> 32
    }

    #{overflow=wrap}
    norm-a-len = a.len + 1
    norm-a = bigint {}
    norm-a.limbs = with-len(norm-a-len)
    norm-a.len = norm-a-len
    norm-a.sign = 1
    i <- [0..norm-a-len): {

        av = 0
        i < a.len -> {

            av = a.limbs[i]
        }

        norm-a.limbs[i] = av
    }
    shift > 0 -> {
        carry = 0
        i <- [0..norm-a-len): {

            v = (norm-a.limbs[i] & MASK) << shift | carry

            norm-a.limbs[i] = v & MASK
            carry = v >> 32
        }
    }

    #{overflow=wrap}
    qi = q.len - 1
    (qi >= 0) {

        an u64 = (norm-a.limbs[qi + bl] & MASK) u64
        an1 u64 = (norm-a.limbs[qi + bl - 1] & MASK) u64
        an2 u64 = (norm-a.limbs[qi + bl - 2] & MASK) u64

        BASE u64 = 4294967296
        bt-u u64 = (norm-b[bl - 1] & MASK) u64
        bt1 u64 = 0
        bl >= 2 -> bt1 = (norm-b[bl - 2] & MASK) u64

        ; qhat = floor((an*BASE + an1) / bt)，全程 u64 避免 an*BASE 溢出 i64
        qhat u64 = (an * BASE + an1) / bt-u
        ; 極端情形 qhat 可能 == BASE，壓回 BASE-1
        qhat >> 32 > 0 -> { qhat = BASE - 1 }
        ; Knuth 修正：檢查 qhat*bt1 是否超過 (rhat*BASE + an2)，超過則 qhat 偏大，減 1（至多 2 次）。
        ; 無號比較拆成高/低 32-bit（各半皆 < 2^32，作為 i64 為正數，故可用有符號比較）。
        ; 注意：rhat += bt-u 後可能 >= BASE，此時 c2 = rhat*BASE + an2 在 u64 中溢出；
        ; 但該情形下不等式必為假（c1 < BASE^2 ≤ c1 真值），跳過判定即可，不進位減。
        rhat u64 = (an * BASE + an1) - qhat * bt-u
        c1 u64 = qhat * bt1
        c2 u64 = rhat * BASE + an2
        dec = 0
        (rhat >> 32 == 0) -> {
            c1h = c1 >> 32
            c2h = c2 >> 32
            c1h > c2h -> dec = 1
            c1h == c2h -> {
                c1l = c1 & 4294967295
                c2l = c2 & 4294967295
                c1l > c2l -> dec = 1
            }
        }
        dec == 1 -> {
            qhat = qhat - 1
            rhat = rhat + bt-u
            c1 = qhat * bt1
            c2 = rhat * BASE + an2
            dec = 0
            (rhat >> 32 == 0) -> {
                c1h = c1 >> 32
                c2h = c2 >> 32
                c1h > c2h -> dec = 1
                c1h == c2h -> {
                    c1l = c1 & 4294967295
                    c2l = c2 & 4294967295
                    c1l > c2l -> dec = 1
                }
            }
            dec == 1 -> {
                qhat = qhat - 1
                rhat = rhat + bt-u
            }
        }

        ; 乘減：norm-a[qi..qi+bl] -= qhat * norm-b[0..bl-1]
        borrow u64 = 0
        bj <- [0..bl): {
            p u64 = qhat * (norm-b[bj] & MASK) u64
            p = p + borrow
            pl = p & 4294967295
            limb u64 = (norm-a.limbs[qi + bj] & MASK) u64
            (limb >= pl) -> {
                norm-a.limbs[qi + bj] = (limb - pl) i64
                borrow = p >> 32
            } -> {
                sub-limb u64 = limb + BASE - pl
                norm-a.limbs[qi + bj] = (sub-limb & 4294967295) i64
                borrow = (p >> 32) + 1
            }
        }

        ; 最高 limb 減最終 borrow；若過減則 qhat 偏大，加回 norm-b
        top u64 = (norm-a.limbs[qi + bl] & MASK) u64
        (top >= borrow) -> {
            norm-a.limbs[qi + bl] = (top - borrow) i64
            q.limbs[qi] = qhat i64
        } -> {
            sub-top u64 = top + BASE - borrow
            norm-a.limbs[qi + bl] = (sub-top & 4294967295) i64
            qhat = qhat - 1
            carry2 u64 = 0
            bj2 <- [0..bl): {
                s u64 = (norm-a.limbs[qi + bj2] & MASK) u64 + (norm-b[bj2] & MASK) u64 + carry2
                norm-a.limbs[qi + bj2] = (s & 4294967295) i64
                carry2 = s >> 32
            }
            carry2-i i64 = carry2 i64
            norm-a.limbs[qi + bl] = norm-a.limbs[qi + bl] + carry2-i
            q.limbs[qi] = qhat i64
        }

        #{overflow=wrap}
        qi = qi - 1
    }

    #{overflow=wrap}
    q.sign = a.sign * b.sign
    q.normalize()

    r.limbs = with-len(b.len)
    r.len = b.len
    r.sign = a.sign

    ; 餘數取自正規化後的 norm-a，必須右移 shift 還原（原本直接複製，導致 r 可能 >= b）
    rc = 0
    ri = b.len - 1
    (ri >= 0) {

        rcur = norm-a.limbs[ri] & MASK
        r.limbs[ri] = ((rcur >> shift) | rc) & MASK
        rc = ((rcur & ((1 << shift) - 1)) << (32 - shift)) & MASK
        ri = ri - 1
    }
    r.normalize()
}

; div-i64: q = a / v（小整數除法）
div-i64 = (a bigint, v i64) (q bigint) {
    r-v = v

    #{overflow=wrap}
    r-v < 0 -> r-v = 0 - r-v
    q.sign = a.sign
    q.limbs = with-len(a.len)
    q.len = a.len
    rem = 0

    #{overflow=wrap}
    i <- [a.len - 1..0]: {

        cur = (rem << 32) | (a.limbs[i] & MASK)

        #{overflow=wrap}
        q.limbs[i] = cur / r-v
        rem = cur % r-v
    }
    q.normalize()
}

; mod-i64: r = a % v（小整數取模）
mod-i64 = (a bigint, v i64) (r i64) {
    r-v = v

    #{overflow=wrap}
    r-v < 0 -> r-v = 0 - r-v
    rem = 0

    #{overflow=wrap}
    i <- [a.len - 1..0]: {

        cur = (rem << 32) | (a.limbs[i] & MASK)
        rem = cur % r-v
    }
    r = rem
}

; ═══════════════════════════════════════════════
; 冪運算
; ═══════════════════════════════════════════════

; pow: c = a^n（n >= 0，非負整數冪）
pow = (a bigint, n i64) (c bigint) {
    c = one()
    n == 0 -> return
    base = bigint {}
    base = a.copy()
    i = n
    (i > 0) {
        i & 1 == 1 -> c = c._mul(base)
        base = base._mul(base)
        i = i >> 1
    }
}

; mod-pow: r = base^exp mod modulus
mod-pow = (base bigint, exp bigint, modulus bigint) (r bigint) {

    mz = modulus.is-zero()
    mz -> {
        r = zero()
        return
    }
    r = one()
    b = bigint {}
    b = base.copy()

    #{overflow=wrap}
    top = exp.limbs[exp.len - 1] & MASK
    lead = 0
    tmp = top
    (tmp != 0) {

        tmp = tmp >> 1

        #{overflow=wrap}
        lead = lead + 1
    }

    #{overflow=wrap}
    bits = (exp.len - 1) * 32 + lead
    bits == 0 -> return

    #{overflow=wrap}
    i <- [bits - 1..0]: {

        r = r._mul(r)

        #{overflow=wrap}
        elimb = i / 32
        ebit = i % 32
        (exp.limbs[elimb] >> ebit) & 1 == 1 -> {

            r = r._mul(b)
        }
    }
}

; ═══════════════════════════════════════════════
; 最大公因數與最小公倍數
; ═══════════════════════════════════════════════

; gcd: g = gcd(a, b)（歐幾里得演算法）
gcd = (a bigint, b bigint) (g bigint) {
    x = bigint {}
    x = a.copy()
    y = bigint {}
    y = b.copy()
    x.sign = 1
    y.sign = 1
    yz = y.is-zero()
    (! yz) {
        x = x._mod(y)
        tmp = bigint {}
        tmp = y.copy()
        y = x.copy()
        x = tmp.copy()
        yz = y.is-zero()
    }
    g = x.copy()
}

; lcm: l = lcm(a, b)
lcm = (a bigint, b bigint) (l bigint) {
    az = a.is-zero()
    bz = b.is-zero()
    az || bz -> {
        l = zero()
        return
    }
    g = gcd(a, b)
    q, r = div-mod(a, g)
    l = q._mul(b)
}

; ═══════════════════════════════════════════════
; 移位運算
; ═══════════════════════════════════════════════

; bigint.shl1: self = self << 1
bigint.shl1 = () {
    carry = 0
    i <- [0...len): {

        v = (.limbs[i] & MASK) << 1 | carry
        carry = v >> 32

        .limbs[i] = v & MASK
    }
    carry > 0 -> {

        .limbs[.len] = carry

        #{overflow=wrap}
        .len = .len + 1
    }
}

; bigint.shr1: self = self >> 1
bigint.shr1 = () {

    ; 高位→低位逐 limb 右移；进入当前 limb 的进位（来自更高 limb 的最低位）
    ; 必须在当前 limb 移位「之后」放到 bit31，否则会被本 limb 的 >>1 再次右移到 bit30。
    inb = 0

    i <- [.len - 1..0]: {
        outb = .limbs[i] & 1
        .limbs[i] = ((.limbs[i] >> 1) | (inb << 31)) & MASK
        inb = outb
    }
    .normalize()
}

; shl: c = a << n
shl = (a bigint, n i64) (c bigint) {
    c = a.copy()
    i <- [0..n): {
        c.shl1()
    }
}

; shr: c = a >> n
shr = (a bigint, n i64) (c bigint) {
    c = a.copy()
    i <- [0..n): {
        c.shr1()
    }
}

; ═══════════════════════════════════════════════
; 雜項
; ═══════════════════════════════════════════════

; bigint.normalize: 移除前導零，確保 len >= 1
bigint.normalize = () {

    #{overflow=wrap}
    (.len > 1 && .limbs[.len - 1] == 0) {

        #{overflow=wrap}
        .len = .len - 1
    }
}

; bigint.to-str: 將 bigint 轉為十進制字串
; 返回 out str: 十進制字串
bigint.to-str = () (out str) {
    out = with-cap(256)
    z = .is-zero()
    z -> {
        out[0] = 48
        return
    }
    out-n = 0
    .sign == -1 -> {
        out[0] = 45
        out-n = 1
    }
    tmp = bigint {}
    tmp = .copy()
    tmp.sign = 1
    buf [256]byte
    bufn = 0
    (bufn < 256) {

        ; 注意：不可寫成 tmp.is-zero()。
        ; 編譯器在「方法內對同型別區域變數呼叫方法」時，被呼叫方法體內的
        ; 裸 `.` 會解析到「外層方法（to-str）的接收者」而非 tmp，
        ; 導致 is-zero 永遠檢查錯誤的物件 → 迴圈不會在零值停住（bus error / 前導零）。
        ; 因此這裡用顯式欄位存取來判斷 tmp 是否為零。
        tz = tmp.len == 1 && tmp.limbs[0] == 0
        tz -> break
        d = mod-i64(tmp, 10)

        #{overflow=wrap}
        buf[bufn]: {
            ok -> it = d + 48
            -> _
        }

        #{overflow=wrap}
        bufn = bufn + 1
        next = div-i64(tmp, 10)
        tmp = next
    }

    #{overflow=wrap}
    j = bufn - 1
    (j >= 0) {

        #{index-out=zero}
        out[out-n] = buf[j]

        #{overflow=wrap}
        out-n = out-n + 1

        #{overflow=wrap}
        j = j - 1
    }
}

; bigint.add-i64: c = self + v（小整數加法）
bigint.add-i64 = (v i64) (c bigint) {
    tmp = bigint {}
    tmp = from-i64(v)
    c = ._add(tmp)
}

; ═══════════════════════════════════════════════
; 十六進制轉換
; ═══════════════════════════════════════════════

; bigint.to-hex: 將 bigint 轉為十六進制字串（小寫）
; 返回 out str: 十六進制字串
bigint.to-hex = () (out str) {
    out = with-cap(256)
    hex = '0123456789abcdef'
    out-n = 0
    .sign == -1 -> {
        out[0] = 45
        out-n = 1
    }

    #{overflow=wrap}
    i <- [.len - 1..0]: {
        limb = .limbs[i] & MASK

        #{overflow=wrap}
        {
            i == .len - 1 -> {
                limb != 0 -> {
                    done = 0
                    shift = 28
                    (shift >= 0) {
                        nibble = (limb >> shift) & 15
                        done == 1 || nibble != 0
                        done = 1
                        out[out-n] = hex[nibble]
                        out-n = out-n + 1
                    }
                    shift = shift - 4
                }
            }
        }
        shift = 28
        (shift >= 0) {
            nibble = (limb >> shift) & 15
            out[out-n] = hex[nibble]

            #{overflow=wrap}
            out-n = out-n + 1

            #{overflow=wrap}
            shift = shift - 4
        }
    }
}
