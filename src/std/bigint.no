; bigint — 任意精度整數
;
; 使用 base 2^32 little-endian []i64 切片表示。
; 每個 i64 元素儲存一個 32-bit limb，高位在前導位置。
; 負數以 sign 欄位標記（符號-絕對值表示）。
;
; 與 crypto/rsa.no 共用相同的底層 []i64 表示，
; 本模組提供完整的大數運算庫。

; ═══════════════════════════════════════════════
; 常量
; ═══════════════════════════════════════════════

; MASK: 32-bit 遮罩
MASK = 4294967295

; BASE: 2^32
BASE = 4294967296

; ═══════════════════════════════════════════════
; 型別定義
; ═══════════════════════════════════════════════

; bigint: 任意精度整數
bigint {
    sign i64
    limbs []i64
    len i64
}

; ═══════════════════════════════════════════════
; 建構與初始化
; ═══════════════════════════════════════════════

; from-i64: 從 i64 建立 bigint
from-i64 = (v i64) (out bigint) {
    r-v = v
    out.limbs = with-len(1)
    {
        r-v < 0 -> {
            #{overflow=wrap}
            out.sign = -1
            #{overflow=wrap}
            r-v = 0 - r-v
        }

        -> out.sign = 1
    }
    #{index-out = 0}
    out.limbs[0] = r-v
    out.len = 1
}

; from-u64: 從無號 i64 建立 bigint（永遠正數）
from-u64 = (v i64) (out bigint) {
    out.limbs = with-len(1)
    out.sign = 1
    #{index-out = 0}
    out.limbs[0] = v
    out.len = 1
}

; zero: 建立零值 bigint
zero = () (out bigint) {
    out.limbs = with-len(1)
    out.sign = 1
    #{index-out = 0}
    out.limbs[0] = 0
    out.len = 1
}

; one: 建立壹值 bigint
one = () (out bigint) {
    out.limbs = with-len(1)
    out.sign = 1
    #{index-out = 0}
    out.limbs[0] = 1
    out.len = 1
}

; bigint.copy: 深度複製 bigint
bigint.copy = () (out bigint) {
    out.limbs = with-len(.len)
    out.sign = .sign
    out.len = .len
    i <- [0...len): {
        #{index-out = 0}
        out.limbs[i] = .limbs[i]
    }
}

; ═══════════════════════════════════════════════
; 比較運算
; ═══════════════════════════════════════════════

; bigint.cmp: 比較 self 和 b（1=大, 0=等, -1=小）
bigint.cmp = (b bigint) (r i64) {
    #{overflow=wrap}
    .sign != b.sign -> {
        r = .sign
        return
    }
    result = .abs-cmp(b)
    #{overflow=wrap}
    r = result * .sign
}

; bigint.abs-cmp: 比較 |self| 和 |b|（1=大, 0=等, -1=小）
bigint.abs-cmp = (b bigint) (r i64) {
    #{overflow=wrap}
    {
        .len > b.len -> {
            r = 1
            return
        }

        .len < b.len -> {
            r = -1
            return
        }
    }
    #{overflow=wrap}
    i <- [.len - 1..0]: {
        #{overflow=wrap}
        .limbs[i] > b.limbs[i] -> {
            r = 1
            return
        }
        .limbs[i] < b.limbs[i] -> {
            r = -1
            return
        }
    }
    r = 0
}

; bigint.is-zero: 是否為零
bigint.is-zero = () (r bool) {
    #{index-out = 0}
    r = .len == 1 && .limbs[0] == 0
}

; bigint.is-neg: 是否為負數
bigint.is-neg = () (r bool) {
    r = .sign == -1
}

; bigint.is-pos: 是否為正數
bigint.is-pos = () (r bool) {
    r = .sign == 1 && ! .is-zero()
}

; bigint.eq: self == b ?
bigint.eq = (b bigint) (r bool) {
    #{overflow=wrap}
    r = false
    .sign != b.sign -> return
    .len != b.len -> return
    #{overflow=wrap}
    i <- [.len - 1..0]: {
        #{overflow=wrap}
                .limbs[i] & MASK != b.limbs[i] & MASK -> {
            #{index-out = 0}
            return
        }
    }
    r = true
}

; ═══════════════════════════════════════════════
; 加法與減法
; ═══════════════════════════════════════════════

; add: a + b
add = (a bigint, b bigint) (c bigint) {
    a.sign == b.sign -> {
        c = abs-add(a, b)
        c.sign = a.sign
        return
    }
    ac = a.abs-cmp(b)
    {
        ac >= 0 -> {
            c = abs-sub(a, b)
            c.sign = a.sign
        }

        -> {
            c = abs-sub(b, a)
            c.sign = b.sign
        }
    }
}

; abs-add: |a| + |b|（忽略正負號）
abs-add = (a bigint, b bigint) (c bigint) {
    #{overflow=wrap}
    carry = 0
    al = a.len
    bl = b.len
    cl = al
    bl > al -> cl = bl
    #{overflow=wrap}
    c.limbs = with-len(cl + 1)
    #{overflow=wrap}
    c.len = cl + 1
    i <- [0..cl): {
        #{overflow=wrap}
        av = 0
                i < al -> {
            #{index-out = 0}
            av = a.limbs[i]
        }
        bv = 0
                i < bl -> {
            #{index-out = 0}
            bv = b.limbs[i]
        }
        #{overflow=wrap}
        s = av + bv + carry
        #{index-out = 0}
        c.limbs[i] = s & MASK
        carry = s >> 32
    }
    #{index-out = 0}
    c.limbs[cl] = carry
    c.normalize()
}

; sub: a - b
sub = (a bigint, b bigint) (c bigint) {
    a.sign != b.sign -> {
        c = abs-add(a, b)
        c.sign = a.sign
        return
    }
    ac = a.abs-cmp(b)
    {
        ac >= 0 -> {
            c = abs-sub(a, b)
            c.sign = a.sign
        }

        -> {
            c = abs-sub(b, a)
            c.sign = -a.sign
        }
    }
}

; abs-sub: |a| - |b|（假設 |a| >= |b|）
abs-sub = (a bigint, b bigint) (c bigint) {
    borrow = 0
    al = a.len
    bl = b.len
    c.limbs = with-len(al)
    c.len = al
    i <- [0..al): {
        #{overflow=wrap}
        #{index-out = 0}
        av = a.limbs[i]
        bv = 0
                i < bl -> {
            #{index-out = 0}
            bv = b.limbs[i]
        }
        #{overflow=wrap}
        d = av - borrow - bv
        #{overflow=wrap}
        {
            d < 0 -> {
                #{overflow=wrap}
                d = d + BASE
                borrow = 1
            }

            -> borrow = 0
        }
        #{index-out = 0}
        c.limbs[i] = d & MASK
    }
    c.normalize()
}

; ═══════════════════════════════════════════════
; 乘法
; ═══════════════════════════════════════════════

; mul: a * b
mul = (a bigint, b bigint) (c bigint) {
    #{overflow=wrap}
    al = a.len
    bl = b.len
    #{overflow=wrap}
    c.limbs = with-len(al + bl)
    #{overflow=wrap}
    c.len = al + bl
    #{overflow=wrap}
    i <- [0..al + bl): {
        #{overflow=wrap}
        #{index-out = 0}
        c.limbs[i] = 0
    }
    i <- [0..al): {
        #{overflow=wrap}
        carry = 0
        #{index-out = 0}
        av = a.limbs[i] & MASK
        j <- [0..bl): {
            #{overflow=wrap}
            #{index-out = 0}
            bv = b.limbs[j] & MASK
            #{overflow=wrap}
            #{index-out = 0}
            p = av * bv + c.limbs[i + j] + carry
            #{overflow=wrap}
            #{index-out = 0}
            c.limbs[i + j] = p & MASK
            carry = p >> 32
        }
        #{overflow=wrap}
        #{index-out = 0}
        c.limbs[i + bl] = carry
    }
    #{overflow=wrap}
    c.sign = a.sign * b.sign
    c.normalize()
}

; mul-i64: a * v（小整數乘法）
mul-i64 = (a bigint, v i64) (c bigint) {
    r-v = v
    #{overflow=wrap}
    c.sign = a.sign
    #{overflow=wrap}
    r-v < 0 -> {
        #{overflow=wrap}
        c.sign = -c.sign
        r-v = 0 - r-v
    }
    #{overflow=wrap}
    c.limbs = with-len(a.len + 1)
    #{overflow=wrap}
    c.len = a.len + 1
    carry = 0
    i <- [0..a.len): {
        #{overflow=wrap}
        #{index-out = 0}
        p = (a.limbs[i] & MASK) * (r-v & MASK) + carry
        #{index-out = 0}
        c.limbs[i] = p & MASK
        carry = p >> 32
    }
    #{index-out = 0}
    c.limbs[a.len] = carry
    c.normalize()
}

; ═══════════════════════════════════════════════
; 除法
; ═══════════════════════════════════════════════

; div-mod: a / b, 同時傳回商和餘數
div-mod = (a bigint, b bigint) (q bigint, r bigint) {
    #{overflow=wrap}
    b.len == 1 && b.limbs[0] == 0 -> {
        q = zero()
        r = zero()
        return
    }
    ac = a.abs-cmp(b)
    #{overflow=wrap}
    {
        ac < 0 -> {
            q = zero()
            r = a.copy()
            return
        }

        ac == 0 -> {
            #{overflow=wrap}
            q = one()
            q.sign = a.sign * b.sign
            r = zero()
            return
        }
    }

    ; 單 limb 除數：使用簡單的 div-i64/mod-i64
    #{overflow=wrap}
    b.len == 1 -> {
        #{overflow=wrap}
        #{index-out = 0}
        v = b.limbs[0] & MASK
        q = div-i64(a, v)
        r.limbs = with-len(1)
        #{index-out = 0}
        r.limbs[0] = mod-i64(a, v)
        r.len = 1
        q.sign = a.sign * b.sign
        r.sign = a.sign
        return
    }
    #{overflow=wrap}
    q.len = a.len - b.len + 1
    q.limbs = with-len(q.len)
    i <- [0..q.len): {
        #{overflow=wrap}
        #{index-out = 0}
        q.limbs[i] = 0
    }
    bl = b.len
    #{overflow=wrap}
    #{index-out = 0}
    bt = b.limbs[bl - 1] & MASK
    shift = 0
    tmp = bt
    #{overflow=wrap}
    {
        #{overflow=wrap}
        tmp = tmp << 1
        #{overflow=wrap}
        shift = shift + 1
    } (tmp < 4294967296 / 2)
    shift > 0 -> bt = bt << shift
    #{overflow=wrap}
    norm-a-len = a.len + 1
    norm-a = bigint {}
    norm-a.limbs = with-len(norm-a-len)
    norm-a.len = norm-a-len
    norm-a.sign = 1
    i <- [0..norm-a-len): {
        #{overflow=wrap}
        av = 0
                i < a.len -> {
            #{index-out = 0}
            av = a.limbs[i]
        }
        #{index-out = 0}
        norm-a.limbs[i] = av
    }
    shift > 0 -> {
        carry = 0
        i <- [0..norm-a-len): {
            #{index-out = 0}
            v = (norm-a.limbs[i] & MASK) << shift | carry
            #{index-out = 0}
            norm-a.limbs[i] = v & MASK
            carry = v >> 32
        }
    }
    #{overflow=wrap}
    qi = q.len - 1
    {
        #{overflow=wrap}
        #{index-out = 0}
        an = norm-a.limbs[qi + bl] & MASK
        #{overflow=wrap}
        #{index-out = 0}
        an1 = norm-a.limbs[qi + bl - 1] & MASK
        #{overflow=wrap}
        #{index-out = 0}
        an2 = norm-a.limbs[qi + bl - 2] & MASK
        #{overflow=wrap}
        qd = an * BASE + an1
        #{overflow=wrap}
        bt != 0 -> qd = qd / bt
        qd = qd & 4294967295
        #{overflow=wrap}
        qd > BASE / 2 -> qd = BASE / 2
        carry = 0
        bj <- [0..bl): {
            #{overflow=wrap}
            #{index-out = 0}
            bv = b.limbs[bj] & MASK
            #{overflow=wrap}
            p = qd * bv
            #{overflow=wrap}
            #{index-out = 0}
            subval = (norm-a.limbs[qi + bj] & MASK) - (p & MASK) - carry
            #{overflow=wrap}
            #{index-out = 0}
            norm-a.limbs[qi + bj] = subval & MASK
            #{overflow=wrap}
            carry = (p >> 32) - (subval >> 32)
        }
        #{overflow=wrap}
        #{index-out = 0}
        subval = (norm-a.limbs[qi + bl] & MASK) - carry
        #{overflow=wrap}
        #{index-out = 0}
        norm-a.limbs[qi + bl] = subval & MASK

        #{overflow=wrap}
        subval < 0 -> {
            #{overflow=wrap}
            qd = qd - 1
            carry = 0
            bj <- [0..bl): {
                #{overflow=wrap}
                #{index-out = 0}
                s = (norm-a.limbs[qi + bj] & MASK) + (b.limbs[bj] & MASK) + carry
                #{index-out = 0}
                norm-a.limbs[qi + bj] = s & MASK
                carry = s >> 32
            }
            #{index-out = 0}
            norm-a.limbs[qi + bl] = norm-a.limbs[qi + bl] + carry
        }
        #{index-out = 0}
        q.limbs[qi] = qd
        #{overflow=wrap}
        qi = qi - 1
    } (qi >= 0)
    #{overflow=wrap}
    q.sign = a.sign * b.sign
    q.normalize()

    r.limbs = with-len(b.len)
    r.len = b.len
    r.sign = a.sign
    i <- [0..b.len): {
        #{overflow=wrap}
        #{index-out = 0}
        r.limbs[i] = norm-a.limbs[i]
    }
    r.normalize()
}

; div: q = a / b（整數除法，只返回商）
div = (a bigint, b bigint) (q bigint) {
    r = bigint {}
    q, r = div-mod(a, b)
}

; mod: r = a % b
mod = (a bigint, b bigint) (r bigint) {
    q = bigint {}
    q, r = div-mod(a, b)
}

; div-i64: q = a / v（小整數除法）
div-i64 = (a bigint, v i64) (q bigint) {
    r-v = v
    #{overflow=wrap}
    r-v < 0 -> r-v = 0 - r-v
    q.sign = a.sign
    q.limbs = with-len(a.len)
    q.len = a.len
    rem = 0
    #{overflow=wrap}
    i <- [a.len - 1..0]: {
        #{overflow=wrap}
        #{index-out = 0}
        cur = (rem << 32) | (a.limbs[i] & MASK)
        #{overflow=wrap}
        #{index-out = 0}
        q.limbs[i] = cur / r-v
        rem = cur % r-v
    }
    q.normalize()
}

; mod-i64: r = a % v（小整數取模）
mod-i64 = (a bigint, v i64) (r i64) {
    r-v = v
    #{overflow=wrap}
    r-v < 0 -> r-v = 0 - r-v
    rem = 0
    #{overflow=wrap}
    i <- [a.len - 1..0]: {
        #{overflow=wrap}
        #{index-out = 0}
        cur = (rem << 32) | (a.limbs[i] & MASK)
        rem = cur % r-v
    }
    r = rem
}

; ═══════════════════════════════════════════════
; 冪運算
; ═══════════════════════════════════════════════

; pow: c = a^n（n >= 0，非負整數冪）
pow = (a bigint, n i64) (c bigint) {
    c = one()
    n == 0 -> return
    base = bigint {}
    base = a.copy()
    i = n
    {
        i & 1 == 1 -> c = mul(c, base)
        base = mul(base, base)
        i = i >> 1
    } (i > 0)
}

; mod-pow: r = base^exp mod modulus
mod-pow = (base bigint, exp bigint, modulus bigint) (r bigint) {
    #{overflow=wrap}
    mz = modulus.is-zero()
    mz -> {
        r = zero()
        return
    }
    r = one()
    b = bigint {}
    b = base.copy()
    #{overflow=wrap}
    #{index-out = 0}
    top = exp.limbs[exp.len - 1] & MASK
    lead = 0
    tmp = top
    {
        #{overflow=wrap}
        tmp = tmp >> 1
        #{overflow=wrap}
        lead = lead + 1
    } (tmp != 0)
    #{overflow=wrap}
    bits = (exp.len - 1) * 32 + lead
    bits == 0 -> return
    #{overflow=wrap}
    i <- [bits - 1..0]: {
        #{overflow=wrap}
        r = mul(r, r)
        #{overflow=wrap}
        elimb = i / 32
        ebit = i % 32
                (exp.limbs[elimb] >> ebit) & 1 == 1 -> {
            #{index-out = 0}
            r = mul(r, b)
        }
    }
}

; ═══════════════════════════════════════════════
; 最大公因數與最小公倍數
; ═══════════════════════════════════════════════

; gcd: g = gcd(a, b)（歐幾里得演算法）
gcd = (a bigint, b bigint) (g bigint) {
    x = bigint {}
    x = a.copy()
    y = bigint {}
    y = b.copy()
    x.sign = 1
    y.sign = 1
    yz = y.is-zero()
    {
        x = bigint.mod(x, y)
        tmp = bigint {}
        tmp = y.copy()
        y = x.copy()
        x = tmp.copy()
        yz = y.is-zero()
    } (! yz)
    g = x.copy()
}

; lcm: l = lcm(a, b)
lcm = (a bigint, b bigint) (l bigint) {
    az = a.is-zero()
    bz = b.is-zero()
    az || bz -> {
        l = zero()
        return
    }
    g = gcd(a, b)
    q, r = div-mod(a, g)
    l = mul(q, b)
}

; ═══════════════════════════════════════════════
; 移位運算
; ═══════════════════════════════════════════════

; bigint.shl1: self = self << 1
bigint.shl1 = () {
    carry = 0
    i <- [0...len): {
        #{index-out = 0}
        v = (.limbs[i] & MASK) << 1 | carry
        carry = v >> 32
        #{index-out = 0}
        .limbs[i] = v & MASK
    }
    carry > 0 -> {
        #{overflow=wrap}
        #{index-out = 0}
        .limbs[.len] = carry
        #{overflow=wrap}
        .len = .len + 1
    }
}

; bigint.shr1: self = self >> 1
bigint.shr1 = () {
    #{overflow=wrap}
    i <- [.len - 1..0]: {
        #{overflow=wrap}
        #{index-out = 0}
        carry = .limbs[i] & 1
        #{index-out = 0}
        .limbs[i] = (.limbs[i] >> 1) & MASK
        #{overflow=wrap}
                i > 0 && carry > 0 -> {
            #{index-out = 0}
            .limbs[i - 1] = .limbs[i - 1] | (1 << 31)
        }
    }

    #{overflow=wrap}
    .normalize()
}

; shl: c = a << n
shl = (a bigint, n i64) (c bigint) {
    c = a.copy()
    i <- [0..n): {
        c.shl1()
    }
}

; shr: c = a >> n
shr = (a bigint, n i64) (c bigint) {
    c = a.copy()
    i <- [0..n): {
        c.shr1()
    }
}

; ═══════════════════════════════════════════════
; 雜項
; ═══════════════════════════════════════════════

; bigint.normalize: 移除前導零，確保 len >= 1
bigint.normalize = () {
    #{overflow=wrap}
    {
        #{overflow=wrap}
        .len = .len - 1
    #{index-out = 0}
    } (.len > 1 && .limbs[.len - 1] == 0)
}

; bigint.to-str: 將 bigint 轉為十進制字串
; 返回 out str: 十進制字串
bigint.to-str = () (out str) {
    #{overflow=wrap}
    out = with-cap(256)
    z = .is-zero()
    z -> {
        #{index-out = 0}
        out[0] = 48
        return
    }
    out-n = 0
    .sign == -1 -> {
        #{index-out = 0}
        out[0] = 45
        out-n = 1
    }
    tmp = bigint {}
    tmp = .copy()
    tmp.sign = 1
    buf [256]byte
    bufn = 0
    {
        #{overflow=wrap}
        tz = tmp.is-zero()
        tz -> break
        d = mod-i64(tmp, 10)
        #{overflow=wrap}
        #{index-out = 0}
        buf[bufn] = d + 48
        #{overflow=wrap}
        bufn = bufn + 1
        tmp = div-i64(tmp, 10)
    } (true)
    #{overflow=wrap}
    j = bufn - 1
    {
        #{overflow=wrap}
        #{index-out = 0}
        out[out-n] = buf[j]
        #{overflow=wrap}
        out-n = out-n + 1
        #{overflow=wrap}
        j = j - 1
    } (j >= 0)
}

; from-str: 從十進制字串建立 bigint
; s str: 十進制字串
; out bigint: 輸出
from-str = (s str) (out bigint) {
    out.limbs = with-len(1)
    out.sign = 1
    #{index-out = 0}
    out.limbs[0] = 0
    out.len = 1
    pos = 0
    tmp-bigint = bigint {}
    {
        #{overflow=wrap}
        #{index-out = 0}
        c = s[pos]
        c != 32 && c != 9 && c != 10 && c != 13 -> break
        #{overflow=wrap}
        pos = pos + 1
    } (pos < s.len-bytes())
    pos < s.len-bytes() -> {
        #{overflow=wrap}
        s[pos] == 45 -> {
            #{overflow=wrap}
            out.sign = -1
            pos = pos + 1
        }
        #{overflow=wrap}
                s[pos] == 43 -> {
            #{index-out = 0}
            pos = pos + 1
        }
    }
    {
        #{index-out = 0}
        c = s[pos]
        {
            c >= 48 && c <= 57 -> {
                #{overflow=wrap}
                tmp-bigint = mul-i64(out, 10)
                out = tmp-bigint
                #{overflow=wrap}
                out = out.add-i64(c - 48)
                #{overflow=wrap}
                pos = pos + 1
            }

            -> {
                #{overflow=wrap}
                pos = pos + 1
            }
        }
    } (pos < s.len-bytes())
    out.normalize()
}

; bigint.add-i64: c = self + v（小整數加法）
bigint.add-i64 = (v i64) (c bigint) {
    tmp = bigint {}
    tmp = from-i64(v)
    c = add(., tmp)
}

; ═══════════════════════════════════════════════
; 十六進制轉換
; ═══════════════════════════════════════════════

; bigint.to-hex: 將 bigint 轉為十六進制字串（小寫）
; 返回 out str: 十六進制字串
bigint.to-hex = () (out str) {
    #{overflow=wrap}
    out = with-cap(256)
    hex = '0123456789abcdef'
    out-n = 0
    .sign == -1 -> {
        #{index-out = 0}
        out[0] = 45
        out-n = 1
    }
    #{overflow=wrap}
    i <- [.len - 1..0]: {
        #{overflow=wrap}
        #{index-out = 0}
        limb = .limbs[i] & MASK
        #{overflow=wrap}
        {
            i == .len - 1 -> {
                limb != 0 -> {
                    #{overflow=wrap}
                    done = 0
                    shift = 28
                    {
                        #{overflow=wrap}
                        nibble = (limb >> shift) & 15
                        done == 1 || nibble != 0
                        done = 1
                        #{index-out = 0}
                        out[out-n] = hex[nibble]
                        out-n = out-n + 1
                    } (shift >= 0)
                    shift = shift - 4
                }
            }
        }
        shift = 28
        {
            #{overflow=wrap}
            nibble = (limb >> shift) & 15
            #{index-out = 0}
            out[out-n] = hex[nibble]
            #{overflow=wrap}
            out-n = out-n + 1
            #{overflow=wrap}
            shift = shift - 4
        } (shift >= 0)
    }
}

; from-hex: 從十六進制字串建立 bigint
; s str: 十六進制字串
; out bigint: 輸出
from-hex = (s str) (out bigint) {
    out.limbs = with-len(1)
    out.sign = 1
    #{index-out = 0}
    out.limbs[0] = 0
    out.len = 1
    tmp-bigint = bigint {}
    i <- [0..s.len-bytes()): {
        #{index-out = 0}
        c = s[i]
        {
            c >= 48 && c <= 57 -> {
                #{overflow=wrap}
                tmp-bigint = mul-i64(out, 16)
                out = tmp-bigint
                #{overflow=wrap}
                out = out.add-i64(c - 48)
            }

            c >= 97 && c <= 102 -> {
                #{overflow=wrap}
                tmp-bigint = mul-i64(out, 16)
                out = tmp-bigint
                #{overflow=wrap}
                out = out.add-i64(c - 87)
            }

            c >= 65 && c <= 70 -> {
                #{overflow=wrap}
                tmp-bigint = mul-i64(out, 16)
                out = tmp-bigint
                #{overflow=wrap}
                out = out.add-i64(c - 55)
            }
        }
    }
    out.normalize()
}
