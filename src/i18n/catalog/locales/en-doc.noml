  'yaml.parser.skip-blank-lines': 'skips blank lines and full-line comments, stopping at the start of the next line of content'
  'yaml.parser.skip-doc-preamble': 'Skip blank lines, comments, and directive lines'
  'yaml.parser.skip-flow-ws': 'Whitespace in flow context - inline spaces, newlines, and comments'
  'yaml.parser.skip-spaces': 'skips inline spaces and tabs'
  'yaml.parser.skip-to-doc-boundary': 'Skip the remaining content of the current document, stopping at the next --- or end of input'
  'yaml.parser.skip-to-eol': 'skip trailing whitespace and line comments (does not consume the newline)'
  'yaml.plain-safe': `
Whether text can be output verbatim as a plain scalar
