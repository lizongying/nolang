  'unix.unix-conn.close': 'Close the connection'
  'unix.unix-conn.dial': `
Connect to a Unix domain socket server
path str: socket file path (e.g. '/tmp/myapp.sock')
ok bool: true=connected, false=syscall failed (fd stays -1)
`
  'unix.unix-conn.fd-of': `
Get the connection socket's file descriptor
fd fd: file descriptor of the connected socket (-1 when not connected)
`
  'unix.unix-conn.recv': `
Receive data into a buffer
buf str: receive buffer
n i64: maximum bytes to receive
returns read-n i64: bytes actually received (-1 = error, 0 = connection closed)
`
  'unix.unix-conn.recv-all': `
Receive all data until the connection closes
content str: all data accumulated so far (concatenated chunk by chunk until the peer closes or an error occurs)
total i64: total number of bytes received (0 when not connected)
`
  'unix.unix-conn.recv-with-timeout': `
Receive with a timeout
buf str: receive buffer
n i64: maximum bytes to receive
timeout-ms i64: timeout in milliseconds
returns read-n i64: bytes actually received (-1 = error, 0 = timeout or connection closed)
`
  'unix.unix-conn.send': `
Send string data
data str: string to send
returns written i64: bytes actually sent (-1 = error)
`
  'unix.unix-conn.set-recv-timeout': `
Set the receive timeout
timeout-ms i64: timeout in milliseconds (0 = block, >0 = timeout)
returns ok bool: true = success
`
  'unix.unix-conn.set-timeout': `
Set the receive timeout (alias, same semantics as set-recv-timeout)
timeout-ms i64: timeout in milliseconds
returns ok bool: true = success
`
  'unix.unix-dial': `
Connect to a Unix domain socket
Performs socket(AF_UNIX) + connect
path str: target socket file path
fd fd: connected descriptor; -1 on failure
`
  'unix.unix-dial-timeout': `
Dial a Unix domain socket with a timeout
path str: socket file path
timeout-ms i64: receive timeout after connecting
returns c ?unix-conn: ok = connection, nil = failure
`
  'unix.unix-dial-to': `
Create a Unix domain socket connection and dial
path str: socket file path
returns c ?unix-conn: ok = connection, nil = failure
`
  'unix.unix-listen': `
Start listening on a Unix domain socket
Performs unlink + socket(AF_UNIX) + bind + listen (unlink first so an old path can be reused)
path str: socket file path; length limited by UNIX-MAX-PATH
fd fd: descriptor in listening state; -1 on failure
`
  'unix.unix-listen-on': `
Create a Unix domain socket listener and start listening
path str: socket file path
returns l ?unix-listener: ok = listener, nil = failure
`
  'unix.unix-listener.accept': `
Accept a new Unix domain socket connection
returns c ?unix-conn: ok = connection struct, nil = failure
`
  'unix.unix-listener.accept-with-timeout': `
Accept with a timeout
timeout-ms i64: timeout in milliseconds
returns c ?unix-conn: ok = connection, nil = timeout or failure
`
  'unix.unix-listener.close': 'Close the listening socket (does not delete the socket file automatically)'
  'unix.unix-listener.fd-of': `
Get the listening socket's file descriptor
fd fd: file descriptor of the listening socket (-1 when not open)
`
  'unix.unix-listener.listen': `
Start listening on a Unix domain socket
path str: socket file path (e.g. '/tmp/myapp.sock')
ok bool: true=socket created and bound for listening, false=syscall failed (fd stays -1)
`
  'unix.unix-listener.path-of': `
Get the socket file path
path str: socket file path passed in when the listener was created
`
  'unix.unix-listener.set-timeout': `
Set the accept timeout
timeout-ms i64: timeout in milliseconds
returns ok bool: true = success
`
