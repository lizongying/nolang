  'dom.append-child': '附加（或移动）子节点到 parent 尾端'
  'dom.attribute-count': '属性数量'
  'dom.attribute-name': '第 i 个属性名（按文档顺序，越界返回 nil）'
  'dom.attribute-value': '第 i 个属性值（越界返回 nil）'
  'dom.blob-has': '在空格补齐的词表 blob 中查找整词 name'
  'dom.child-at': '第 i 个子节点（越界返回 nil）'
  'dom.child-count': '子节点数'
  'dom.class-has': 'class 值（空白分隔多词）是否含词 cls'
  'dom.cp-append': '把码点 cp 以 UTF-8 追加到 out（返回新字符串）'
  'dom.create-comment': '建立注释节点'
  'dom.create-element': '建立游离元素节点（尚未附加）'
  'dom.create-text-node': '建立文本节点'
  'dom.decode-entities': `
解码 s[from..to) 的实体（命名实体查 DOM-ENTITY-BLOB，数字实体 &#NN; 或 &#xHH;）
html=true：未知或未闭合实体按原文保留；html=false：未知实体判为错误
返回 out=解码结果, ok=是否成功（XML 模式下非法实体 ok=false）
`
  'dom.document-element': '根元素（第一个 ELEMENT 子节点）'
  'dom.dom-closers-of': '打开标签 t 时应先闭合的开放标签词表（空串=无规则）'
  'dom.dom-pool.alloc': '分配新节点（附带平行 names/vals 槽位），返回索引'
  'dom.dom-pool.append': '将 child 附加到 parent 子链表尾端（已有父节点先摘除）'
  'dom.dom-pool.attr-edge-at': '取节点第 i 条属性边索引（按文档顺序），-1=越界'
  'dom.dom-pool.collect-class': '收集 node 子树中 class 属性含 cls 词的元素索引'
  'dom.dom-pool.collect-tag': '收集 node 子树中标签名为 want（star=true 时所有元素）的元素索引'
  'dom.dom-pool.detach': '从父节点摘除 child（保持子链表完整）'
  'dom.dom-pool.find-attr': '查找节点 name 属性对应的边索引，返回 -1 表示不存在'
  'dom.dom-pool.find-id-node': '在 node 子树中递归查找 id 属性等于 id 的元素，-1=未找到'
  'dom.dom-pool.html-add-text': '把 s[from..to) 按 HTML 实体规则解码为文本节点附加到 parent'
  'dom.dom-pool.html-bogus-comment': '以 \'<!\' 开头的其他内容，直到 \'>\'，作为注释保存'
  'dom.dom-pool.html-parse-attr': '解析 HTML 属性（支持无引号值），重复属性首个为准'
  'dom.dom-pool.html-parse-close-name': '解析 \'</name\'，返回 \'>\' 之后的位置与小写标签名'
  'dom.dom-pool.html-parse-comment': '解析 <!--...-->，EOF 容错'
  'dom.dom-pool.html-parse-doc': '解析整份 HTML 文档（永不失败），返回 document 根索引'
  'dom.dom-pool.html-parse-open': `
解析开始标签并附加元素到 cur
返回 np=下一位置、el=元素索引、mode：
0=非法 '<'（已作文字）、1=普通元素（调用方入栈）、2=void/自闭合、3=raw-text 已吞内容
`
  'dom.dom-pool.html-parse-pi': '\'<?...>\'（HTML 中按 bogus comment 处理，此处保存为 PI 节点）'
  'dom.dom-pool.html-set-attr-once': '仅当属性不存在时设置（HTML 重复属性首个为准）'
  'dom.dom-pool.init': '初始化节点池（堆 vec 需先初始化方能安全 push）'
  'dom.dom-pool.insert-before': '将 node 插入 parent 的 ref 之前（ref 非法或非 parent 之子时附加到尾端）'
