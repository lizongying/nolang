  'yaml.yaml-parser.skip-blank-lines': 'pula linhas em branco e comentários de linha inteira, parando no início da próxima linha de conteúdo'
  'yaml.yaml-parser.skip-doc-preamble': 'pula linhas em branco, comentários e linhas de diretiva'
  'yaml.yaml-parser.skip-flow-ws': 'Espaços em branco dentro de contextos de fluxo — espaços na linha, novas linhas e comentários'
  'yaml.yaml-parser.skip-spaces': 'pula espaços e tabs na linha'
  'yaml.yaml-parser.skip-to-doc-boundary': 'pula o resto do documento atual, parando no próximo --- ou fim da entrada'
  'yaml.yaml-parser.skip-to-eol': 'pula espaços e comentários finais da linha (não consome a nova linha)'
  'yaml.yaml-plain-safe': `
Informa se o texto pode ser emitido como está como um escalar simples
