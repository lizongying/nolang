`
  'yaml.yaml': 'yaml: documento analisado (pode conter múltiplos documentos)'
  'yaml.yaml-chomp-clip': 'modo chomping'
  'yaml.yaml-kind-null': `
tipo de nó

`
  'yaml.yaml-max-depth': 'profundidade máxima de recursão para serialização (protege contra âncoras auto-referenciadas)'
  'yaml.yaml-style-block': 'estilo de coleção'
