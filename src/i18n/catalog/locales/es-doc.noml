  'toml.get-f64': 'Devuelve un flotante (soporta notación con exponente)'
  'toml.get-i64': 'Devuelve un entero decimal (se permiten separadores de subrayado de TOML)'
  'toml.get-str': 'Devuelve y decodifica un valor de cadena'
