  'str-set.str-set.add': 'Añade un elemento; devuelve si se insertó'
  'str-set.str-set.clear': 'Vacía el conjunto'
  'str-set.str-set.contains': 'Indica si un elemento existe'
  'str-set.str-set.for-each': 'Recorre todos los elementos'
  'str-set.str-set.hash': 'Hash FNV-1a de cadena'
  'str-set.str-set.init': 'Inicializa el conjunto'
  'str-set.str-set.is-empty': 'Indica si el conjunto está vacío'
  'str-set.str-set.len': 'Devuelve el número de elementos'
  'str-set.str-set.remove': 'Elimina un elemento'
