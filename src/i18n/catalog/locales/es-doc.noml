  'number.f64.degrees': 'radianes a grados (método f64/f32)'
  'number.f64.radians': 'grados a radianes (método f64/f32)'
  'number.f64.sin': 'Funciones trigonométricas (radianes; métodos f64/f32)'
  'number.f64.sinh': 'Funciones hiperbólicas (métodos f64/f32)'
