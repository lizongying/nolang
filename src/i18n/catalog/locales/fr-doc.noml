  'tree-map.tree-map.put': `
Insère ou met à jour key→value
key i64: clé de tri
val i64: valeur entière à écrire (écrase l'ancienne valeur si la clé existe déjà)
Renvoie ok bool: true = inséré, false = une clé existante a été mise à jour ou le pool est plein
`
  'tree-map.tree-map.rebalance': `
Vérifie et répare l'équilibre au nœud idx
idx i64: l'indice du nœud
Renvoie nr i64: l'indice de la racine du sous-arbre après rééquilibrage

`
  'tree-map.tree-map.rebalance-up': `
Rééquilibre niveau par niveau vers le haut depuis idx
idx i64: l'indice du nœud de départ

`
  'tree-map.tree-map.remove': `
Supprime une clé
key i64: la clé
Renvoie ok bool: true = supprimée, false = introuvable

`
  'tree-map.tree-map.rot-left': `
Rotation à gauche
x                y
/ \              / \
a   y     =>     x   c
/ \          / \
b   c        a   b
x i64: le nœud pivot

`
  'tree-map.tree-map.rot-right': `
Rotation à droite
x              y
/ \            / \
y   c   =>     a   x
/ \                / \
a   b              b   c
x i64: le nœud pivot

`
  'tree-map.tree-map.size': `
Renvoie le nombre d'éléments
Renvoie sz i64: le nombre d'éléments

`
  'tree-map.tree-map.successor': `
Trouve le successeur en ordre infixe d'un nœud
idx i64: l'indice du nœud
Renvoie succ i64: l'indice du successeur, ou -1 s'il n'y en a pas

`
  'tree-map.tree-map.update-ht': `
Recalcule la hauteur du nœud
idx i64: l'indice du nœud

`
  'tree-map.tree-map.upper-bound': `
Trouve la première clé > target
target i64: la clé cible
Renvoie key ?i64: ok = trouvée, nil = aucune clé de ce type

`
  'tree-set.tree-set.add': `
Ajoute un élément
key i64: la valeur à ajouter
Renvoie ok bool: true = inséré, false = déjà présent ou le pool est plein

`
  'tree-set.tree-set.alloc-node': `
Alloue un nœud depuis le pool libre
Renvoie idx i64: l'indice du nœud, ou -1 quand le pool est plein

`
  'tree-set.tree-set.bf': `
Renvoie le facteur d'équilibre (hauteur gauche moins hauteur droite)
idx i64: l'indice du nœud
Renvoie b i64: le facteur d'équilibre

`
  'tree-set.tree-set.clear': 'Supprime tous les éléments et reconstruit le pool libre'
  'tree-set.tree-set.contains': `
Indique si une valeur est présente
key i64: la valeur à vérifier
Renvoie yes bool: true = présente, false = absente

`
  'tree-set.tree-set.empty': `
Indique si l'ensemble est vide
Renvoie yes bool: true = vide, false = non vide

`
  'tree-set.tree-set.first': `
Renvoie la plus petite valeur
Renvoie val ?i64: ok = la plus petite valeur, nil = l'ensemble est vide

`
  'tree-set.tree-set.for-each': `
Parcourt tous les éléments par ordre croissant
val i64: la valeur de sortie (mise à jour à chaque élément)

`
  'tree-set.tree-set.free-node': `
Rend un nœud au pool libre
idx i64: l'indice du nœud à libérer

`
  'tree-set.tree-set.full': `
Indique si le pool de nœuds est plein
Renvoie yes bool: true = plein, false = non plein

`
  'tree-set.tree-set.ht': `
Renvoie la hauteur du nœud (NIL = 0)
idx i64: l'indice du nœud
Renvoie h i64: la hauteur

`
  'tree-set.tree-set.init': 'Initialise un arbre vide et son pool de nœuds libres'
  'tree-set.tree-set.last': `
Renvoie la plus grande valeur
Renvoie val ?i64: ok = la plus grande valeur, nil = l'ensemble est vide

`
  'tree-set.tree-set.lower-bound': `
Trouve le premier élément >= target
target i64: la valeur cible
Renvoie val ?i64: ok = trouvé, nil = aucun élément de ce type

`
  'tree-set.tree-set.rebalance': `
Vérifie et répare l'équilibre au nœud idx
idx i64: l'indice du nœud
Renvoie nr i64: l'indice de la racine du sous-arbre après rééquilibrage

`
  'tree-set.tree-set.rebalance-up': `
Rééquilibre niveau par niveau vers le haut depuis idx
idx i64: l'indice du nœud de départ

`
  'tree-set.tree-set.remove': `
Supprime un élément
key i64: la valeur à supprimer
Renvoie ok bool: true = supprimé, false = introuvable

`
  'tree-set.tree-set.rot-left': `
Rotation à gauche
x                y
/ \              / \
a   y     =>     x   c
/ \          / \
b   c        a   b
x i64: le nœud pivot

`
  'tree-set.tree-set.rot-right': `
Rotation à droite
x              y
/ \            / \
y   c   =>     a   x
/ \                / \
a   b              b   c
x i64: le nœud pivot

`
  'tree-set.tree-set.size': `
Renvoie le nombre d'éléments
Renvoie sz i64: le nombre d'éléments

`
  'tree-set.tree-set.successor': `
Trouve le successeur en ordre infixe d'un nœud
idx i64: l'indice du nœud
Renvoie succ i64: l'indice du successeur, ou -1 s'il n'y en a pas

`
  'tree-set.tree-set.update-ht': `
Recalcule la hauteur du nœud
idx i64: l'indice du nœud

`
  'tree-set.tree-set.upper-bound': `
Trouve le premier élément > target
target i64: la valeur cible
Renvoie val ?i64: ok = trouvé, nil = aucun élément de ce type

`
  'txt._txt-dig-val': `
convertit un caractère de chiffre unique (0-15) en sa valeur; un caractère invalide renvoie -1
c : point de code d'un caractère chiffre
d : 0~15 ; les caractères invalides renvoient -1
`
  'txt.append': `
Ajoute un octet (sans jamais dépasser la limite de 255)
b : octet à ajouter (ignoré s'il dépasse la limite de 255)
`
  'txt.append-str': `
ajoute un str (sans dépasser la limite de 255)
s: le str à ajouter (tronqué si la limite de 255 est dépassée)
`
  'txt.append-txt': `
ajoute un txt (sans dépasser la limite de 255)
t: le txt à ajouter (tronqué si la limite de 255 est dépassée)
`
  'txt.at': `
[obsolète] txt.at: lecture indexée par caractère (point de code) — utilisez plutôt t[idx] (indexation native, renvoie ?char)
txt.at: obtient la valeur du point de code à une position de caractère (pour un décalage d'octet, utilisez t.byte(i))
renvoie b ?byte: nil hors bornes; un point de code au-delà de la plage d'un octet est tronqué
idx: index de point de code (caractère)
b : ok=le point de code (tronqué s'il dépasse la plage byte), nil=hors limites
`
  'txt.byte': `
renvoie la valeur d'octet brute au décalage d'OCTET i (une lecture d'octet brute)
À la différence de l'indexation par point de code de txt[i]; destiné au code qui construit le tampon octet par octet
Renvoie ?byte: nil hors bornes (i < 0 ou i >= len-bytes()), et l'appelant doit gérer l'option
Géré par le compilateur comme builtin (#{buildin}): le codegen l'intercepte et développe une vérification de bornes plus GEP+load, sans
corps de fonction std; la signature est enregistrée dans BuiltinMethodList de src/builtin/str.go
(Intercepted, partageant une entrée avec str.byte via le repli par nom nu)
i: index octet (pas un point de code)
c : ok=valeur brute de l'octet à cette position, nil=i hors limites
`
  'txt.clear': 'vide le texte (len=0)'
  'txt.compare': `
Comparaison lexicographique
renvoie -1 (a<b), 0 (égal), 1 (a>b)
b : txt à comparer
r: ordre lexicographique -1 (récepteur<b) / 0 (égal) / 1 (>)
`
  'txt.contains': `
indique si la sous-chaîne est présente
sub: le sous-txt à trouver
yes: si cela contient sub
`
  'txt.copy': `
Copie un txt
⚠️ DÉPRÉCIÉ : l'affectation `a = b` a déjà une sémantique de copie — txt est un type valeur (256 sur
tampon inline d'octets, data[255] + len) ; affecter vaut copier octet par octet. Utilisez l'affectation directe ; conservé seulement pour la compatibilité.
dst : la copie (déprécié : txt est un type valeur, affecter copie déjà octet à octet)
`
  'txt.count': `
compte les points de code
cnt : nombre de points de code (chars)
`
  'txt.decode-cp': `
décode un point de code UTF-8 à partir de la position i
renvoie cp = la valeur du point de code, clen = la longueur de la séquence en octets (1-4)
i: index octet où commencer le décodage
cp : le point de code décodé
clen : longueur en octets de la séquence UTF-8 de ce point de code (1~4)
`
  'txt.empty': `
Détermine si c'est vide.
yes: si la longueur réelle len est 0
`
  'txt.ends-with': `
S'il finit par le suffixe donné
sub: le sous-txt suffixe
yes: si cela se termine par sub
`
  'txt.eq': `
Compare l'égalité de deux txt
⚠️ Réécrit le 2026-09-21. L'ancienne implémentation utilisait un seul pipeline `->` (`.byte(k) - b.byte(k); c != 0 -> ok = 0;
k == an - 1 -> ok == 0 -> eq = false; k = k + 1`) ne revient juger qu'au **dernier octet**,
c'est pourquoi `t('hello').eq('world')` — « même longueur, contenu différent » — renvoyait toujours true
—— la ligne `neq:` de `tests/txt.no` n'a cessé d'imprimer 1, et elle a été figée dans le golden baseline.
txt.compare compare déjà octet par octet et diverge correctement quand les longueurs diffèrent, autant le réutiliser tel quel.
b : txt cible de la comparaison
eq : true=les deux côtés identiques octet à octet
`
  'txt.eq-full': `
égalité exacte de deux valeurs txt (longueur plus comparaison octet par octet)
b : txt à comparer
yes: si la longueur et chaque octet sont tous égaux
`
  'txt.fields': `
découpe sur les espaces blanches en []txt (des espaces blanches consécutives comptent pour un seul séparateur)
out: tranche des txt enfants non vides divisés sur les suites d'espaces
`
  'txt.fill': `
Remplit toute la zone de données avec une valeur de byte
val: la valeur d'octet utilisée pour remplir toute la zone de données
`
  'txt.from-bytes': `
Crée un txt depuis []byte (tronqué à 255 octets)
Renvoie un txt, tronqué si le []byte dépasse 255 octets
b : octet source
out: contenu copié dans le txt (au-delà de 255 octets, tronqué)
`
  'txt.from-chars': `
construit un nouveau txt à partir d'une tranche de char (écrit point de code par point de code, encodé en UTF-8; tout ce qui dépasse 255 octets est abandonné)
⚠️ impossible d'écrire les points de code un par un avec `val[i]: { ok -> it = cs[i] }`: la place-match de D9 est conditionnée par une
LECTURE, et lire `val[0]` sur un txt neuf de len=0 sort des bornes et renvoie nil, l'arm ok ne s'exécute donc jamais et
la fonction entière renvoie une chaîne vide (txt.from-chars perdait silencieusement des données à cause de cela).
txt.new (ForwardFunc: chars-new) existe précisément pour cela: il écrit tous les points de code d'un coup et fixe la longueur en octets.
cs : tranche de points de code ([]char)
t: ok=nouveau txt encodé par point de code en UTF-8, nil=le résultat encodé dépasse 255 octets (l'excédent est jeté)
`
  'txt.from-hex': `
décode un texte hexadécimal en txt
renvoie Option: ok(txt) / nil (vide) / err('msg')
out: ok=le txt décodé, nil=vide, err=caractères hex illégaux ou longueur impaire
`
  'txt.from-str': `
Crée un txt depuis str (tronqué à 255 octets)
Renvoie un txt, tronqué si la str dépasse 255 octets
s: le str source
out: contenu copié dans le txt (au-delà de 255 octets, tronqué)
`
  'txt.index': `
trouve la position d'une sous-chaîne (en partant de 0)
sub: le sous-txt à trouver
pos: position du point de code de la première apparition, -1 si non trouvé
`
  'txt.index-from': `
recherche une sous-chaîne à partir de from
Renvoie la position de la première occurrence, ou -1 si absente
target: le sous-txt à trouver
from: position de départ en points de code (inclusive)
pos: position du point de code de la première apparition, -1 si non trouvé
`
  'txt.join': `
[]txt.join: joint une tranche de txt avec un séparateur (tronqué au-delà de 255 octets)
sep txt: le séparateur
renvoie out txt: le résultat joint

`
  'txt.last-index': `
un alias de rindex
target: le sous-txt à trouver
pos: position du point de code de la dernière apparition, -1 si non trouvé (alias de rindex)
`
  'txt.len': `
Renvoie le nombre de caractères (points de code) (aligné sur str.len ; pour la longueur en octets utiliser txt.len-bytes())
n: nombre de points de code (caractères), aligné sur str.len (pour la longueur en octets utiliser len-bytes())
`
  'txt.lines': `
découpe sur les sauts de ligne en []txt (prend en charge \n et \r\n)
out: tranche de lignes divisées sur les sauts de ligne (gère \n et \r\n ; un saut final ne produit pas de ligne vide)
`
  'txt.new': `
txt.new: construit un txt depuis une tranche de char (constructeur de niveau module, renvoie un txt concret)
Intégré de compilation (ForwardFunc: chars-new) : []char est converti octet par octet en bytes avec la longueur écrite d'un coup,
Pas de boucle .no octet par octet. txt est un type intégré dont les octets/longueur ne sont pas manipulables dans le code utilisateur, donc la conversion entière est émise par le compilateur en IR.
Au-delà de 255 octets, le surplus est jeté automatiquement (l'octet de longueur est borné à 255).
cs : tranche de points de code ([]char)
t: le txt après réencodage octet par octet (au-delà de 255 octets, jeté automatiquement)
`
  'txt.repeat': `
répète le contenu times fois (plafonné à 255 octets)
renvoie un nouveau txt
times: nombre de répétitions
val: le nouveau txt après concatenation de times exemplaires (tronqué au-delà de 255 octets)
`
  'txt.replace-char': `
remplace chaque old-ch par new-ch (points de code UTF-8)
renvoie un nouveau txt (tronqué au-delà de 255 octets)
old-ch: le point de code remplacé
new-ch: le point de code après remplacement
val: le nouveau txt après remplacement point de code par point de code (tronqué au-delà de 255 octets)
`
  'txt.replace-n': `
remplacement avec un nombre borné
old txt, new txt, n i64: le nombre maximal de remplacements (n<=0 ne remplace rien)
old: le txt enfant qui a été remplacé
new: le txt fils après remplacement
n: nombre maximal de remplacements (n <= 0 = aucun remplacement)
val: le nouveau txt après remplacement à nombre limité de fois (tronqué au-delà de 255 octets)
`
  'txt.replace-str': `
remplace chaque occurrence de la sous-chaîne old par new
renvoie un nouveau txt (tronqué au-delà de 255 octets)
old: le txt enfant qui a été remplacé
new: le txt fils après remplacement
val: le nouveau txt après remplacement (tronqué au-delà de 255 octets)
`
  'txt.reverse': `
Inverse le contenu du texte
out: un nouveau txt avec les octets inversés
`
  'txt.rindex': `
recherche inverse de la dernière occurrence d'une sous-chaîne
renvoie la position, ou -1 si absente
target: le sous-txt à trouver
pos: position du point de code de la dernière apparition, -1 si non trouvé
`
  'txt.rindex-from': `
recherche inverse d'une sous-chaîne à partir de from (renvoie la dernière occurrence à une position >= from)
target: le sous-txt à trouver
from: borne inférieure de recherche inverse (inclusive, points de code)
pos: position du point de code de la dernière apparition (>= from), -1 si non trouvé
`
  'txt.set-byte': `
Renvoie ?bool (peut échouer): nil hors bornes (i < 0 ou i >= la capacité physique de 255 octets), et l'écriture est IGNORÉE;
some(true) en cas de succès. La borne est la capacité physique (un txt est un tampon fixe de 255 octets) plutôt que
len, donc les constructeurs qui « remplissent le tampon puis règlent len » (fill / from-str / to-hex / join) restent utilisables tels quels.
Un appelant peut ignorer le ?bool en instruction nue (optunuse ne couvre que les noms liés).
i: index octet
b : valeur d'octet à écrire
ok: ok=true=écriture réussie, nil=i hors plage (écriture sautée)
`
  'txt.slice': `
prend la sous-chaîne [start, end) et renvoie un nouveau txt
start: index de départ du point de code (inclusif)
end : index final de point de code (exclusif)
out: nouveau txt découpé selon la plage de points de code [start,end)
`
  'txt.split': `
découpe sur un séparateur en []txt
sep: le txt séparateur
out: tranche des txt enfants après division
`
  'txt.split-n': `
découpage avec un nombre borné
sep txt, maxsplit i64: le nombre maximal de découpages (<=0 signifie illimité)
sep: le txt séparateur
maxsplit: nombre maximal de découpages (<= 0 sans limite)
out: tranche des résultats de division (au plus maxsplit+1 parts)
`
  'txt.starts-with': `
S'il commence par le préfixe donné
sub: le sous-txt préfixe
yes: si cela commence par sub
`
  'txt.to-bigint': `
analyse le texte en bigint, en détectant la base automatiquement
Préfixes 0b/0B -> binaire, 0o/0O -> octal, 0x/0X -> hexadécimal; sans préfixe -> décimal
Accepte des espaces blanches de début facultatives et un signe (+ / -)
renvoie ?bigint: ok(bigint) en cas de succès / nil pour une chaîne vide / err('msg') quand il n'y a aucun chiffre
out: ok=bigint analysé selon la base du préfixe (0b/0o/0x ou décimal), nil=vide, err=aucun chiffre valide
`
  'txt.to-bool': `
analyse "true"/"false" en bool
val: ok=true/false (ne reconnaît que «true»/«false»), nil=vide, err=tout le reste
`
  'txt.to-byte': `
analyse en byte (équivalent à u8)
val: ok=un byte dans la plage (0~255), nil=vide, err=illégal ou hors plage
`
  'txt.to-bytes': `
Convertit un txt en []byte
out: copie des len premiers octets ([]byte)
`
  'txt.to-f32': `
analyse le texte en f32
val: ok=f32 simple précision, nil=vide, err=contient des caractères non chiffres
`
  'txt.to-f64': `
analyse le texte en f64 (renvoie ?f64; chaîne vide -> nil, non numérique -> err)
Réutilise l'analyse de str (convertir en str d'abord, puis appeler str.to-f64)
val: ok=le f64 analysé, nil=vide, err=contient des caractères non chiffres
`
  'txt.to-hex': `
Convertit un txt en chaîne hexadécimale
out: str où chaque octet devient deux caractères hex minuscules
`
  'txt.to-i16': `
analyse en i16 (plage -32768 à 32767)
val: ok=un i16 dans la plage (-32768~32767), nil=vide, err=illégal ou hors plage
`
  'txt.to-i32': `
analyse en i32 (plage -2147483648 à 2147483647)
val: ok=un i32 dans la plage, nil=vide, err=illégal ou hors plage
`
  'txt.to-i64': `
analyse le texte en entier signé 64 bits
renvoie Option: ok(n) / nil (vide) / err('msg')
val: ok=le i64 analysé, nil=vide, err=caractères non chiffres / +/- isolé / hors plage
`
  'txt.to-i8': `
analyse en i8 (plage -128 à 127)
val: ok=un i8 dans la plage (-128~127), nil=vide, err=illégal ou hors plage
`
  'txt.to-lower': `
convertit le texte en minuscules (ASCII)
renvoie un nouveau txt
val: nouveau txt avec les majuscules ASCII converties en minuscules (les autres octets conservés tels quels)
`
  'txt.to-str': `
Convertit un txt en str
out: str au même contenu (nouveau tampon tas dimensionné à la longueur réelle en octets)
`
  'txt.to-u16': `
analyse en u16 (plage 0 à 65535)
val: ok=un u16 dans la plage (0~65535), nil=vide, err=illégal ou hors plage
`
  'txt.to-u32': `
analyse en u32 (plage 0 à 4294967295)
val: ok=un u32 dans la plage, nil=vide, err=illégal ou hors plage
`
  'txt.to-u64': `
analyse en u64 (rejette le signe moins)
val: ok=entier non négatif (refuse le signe), nil=vide, err=contient des caractères non chiffres
`
  'txt.to-u8': `
analyse en u8 (plage 0 à 255)
val: ok=un u8 dans la plage (0~255), nil=vide, err=illégal ou hors plage
`
  'txt.to-upper': `
convertit le texte en majuscules (ASCII)
renvoie un nouveau txt
val: nouveau txt avec les minuscules ASCII converties en majuscules (les autres octets conservés tels quels)
`
  'txt.trim': `
supprime les espaces blanches de début et de fin
renvoie un nouveau txt
val: le nouveau txt avec les blancs de tête et de queue retirés
`
  'txt.trim-char': `
supprime le caractère donné (point de code UTF-8) des deux extrémités
renvoie un nouveau txt
ch : le point de code à retirer des deux extrémités
val: le nouveau txt avec ch de tête et de queue retirés
`
  'txt.truncate': `
Tronque à la longueur donnée
n: longueur en octets à conserver après troncature (s'applique quand n est inférieur à la longueur actuelle)
`
  'txt.txt-hex-val': `
convertit un caractère hexadécimal unique en sa valeur (un caractère invalide renvoie -1)
c : point de code d'un caractère hexadécimal
v: 0~15 ; les caractères invalides renvoient -1
`
  'unix.unix-conn.close': 'Ferme la connexion'
  'unix.unix-conn.dial': `
Se connecte au serveur Unix Domain Socket
path : chemin du fichier socket (p. ex. '/tmp/myapp.sock')
Retour ok = true = succès
`
  'unix.unix-conn.fd-of': `
Obtient le descripteur de fichier du socket de la connexion
Retour fd fd
`
  'unix.unix-conn.recv': `
Reçoit des données dans le tampon
buf str : tampon de réception
n i64 : nombre maximum d'octets reçus
Retour read-n i64 : nombre réel d'octets reçus (-1 = erreur, 0 = connexion fermée)
`
  'unix.unix-conn.recv-all': `
Reçoit toutes les données jusqu'à la fermeture de la connexion
Retour content str : contenu reçu, total i64 : nombre total d'octets
`
  'unix.unix-conn.recv-with-timeout': `
Réception avec délai expiré
buf str : tampon de réception
n i64 : nombre maximum d'octets reçus
timeout-ms i64 : délai d'expiration en millisecondes
Retour read-n i64 : nombre réel d'octets reçus (-1 = erreur, 0 = délai expiré ou connexion fermée)
`
  'unix.unix-conn.send': `
Envoie des données chaîne
data str : chaîne à envoyer
Retour written i64 : nombre réel d'octets envoyés (-1 = erreur)
`
  'unix.unix-conn.set-recv-timeout': `
Configure le délai d'expiration de réception
timeout-ms i64 : délai en millisecondes (0 = bloquant, >0 = expiration)
Retour ok bool : true = succès
`
  'unix.unix-conn.set-timeout': `
Configure le délai d'expiration de réception (alias, même sémantique que set-recv-timeout)
timeout-ms i64 : délai en millisecondes
Retour ok bool : true = succès
`
  'unix.unix-dial': `
Se connecte à un Unix Domain Socket
Exécute socket(AF_UNIX) + connect
path str : chemin du fichier socket cible
fd fd : descripteur déjà connecté ; -1 en cas d'échec
`
  'unix.unix-dial-timeout': `
Appel Unix Domain Socket avec délai expiré
path str : chemin du fichier socket
timeout-ms i64 : expiration de réception après connexion
Retour c ?unix-conn : ok = connexion, nil = échec
`
  'unix.unix-dial-to': `
Crée une connexion Unix Domain Socket et appelle
path str : chemin du fichier socket
Retour c ?unix-conn : ok = connexion, nil = échec
`
  'unix.unix-listen': `
Crée une écoute Unix Domain Socket
Exécute unlink + socket(AF_UNIX) + bind + listen (unlink d'abord pour réutiliser un ancien chemin)
path str : chemin du fichier socket ; longueur limitée par UNIX-MAX-PATH
fd fd : descripteur entré en état d'écoute ; -1 en cas d'échec
`
  'unix.unix-listen-on': `
Crée un écouteur Unix Domain Socket et commence à écouter
path str : chemin du fichier socket
Retour l ?unix-listener : ok = écouteur, nil = échec
`
  'unix.unix-listener.accept': `
Accepte une nouvelle connexion Unix Domain Socket
Retour c ?unix-conn : ok = structure de connexion, nil = échec
`
  'unix.unix-listener.accept-with-timeout': `
accept avec délai expiré
timeout-ms i64 : délai en millisecondes
Retour c ?unix-conn : ok = connexion, nil = expiration ou échec
`
  'unix.unix-listener.close': 'Ferme le socket d\'écoute (ne supprime pas automatiquement le fichier socket)'
  'unix.unix-listener.fd-of': `
Obtient le descripteur de fichier du socket d'écoute
Retour fd fd
`
  'unix.unix-listener.listen': `
Commence à écouter un Unix Domain Socket
path : chemin du fichier socket (p. ex. '/tmp/myapp.sock')
Retour ok = true = succès
`
  'unix.unix-listener.path-of': `
Obtient le chemin du fichier socket
Retour path str
`
  'unix.unix-listener.set-timeout': `
Configure le délai d'expiration d'accept
timeout-ms i64 : délai en millisecondes
Retour ok bool : true = succès
`
  'url.url-basic-auth': `
Produit une valeur d'en-tête d'authentification HTTP Basic
user : nom d'utilisateur
password : mot de passe
Retour out str : valeur d'en-tête (p. ex. 'Basic dXNlcjpwYXNz')
`
  'url.url-build-query': `
Construit une chaîne de requête à partir de paires clé-valeur
keys : tableau de clés (les count premiers éléments sont valides)
values : tableau de valeurs (en correspondance un-à-un avec keys)
count : nombre de paires clé-valeur valides
Retour out str : chaîne de requête (p. ex. key1=val1&key2=val2)
`
  'url.url-decode': `
Décodage URL (décodage en pourcent)
s : chaîne encodée en pourcent à décoder
Retour out str : chaîne brute décodée
`
  'url.url-encode': `
Encodage URL (encodage en pourcent)
s : chaîne brute à encoder
Retour out str : chaîne encodée en pourcent
`
  'url.url-encode-component': `
Encodage URL (mode composant, encode aussi / et ?)
s : chaîne brute à encoder
Retour out str : chaîne encodée en pourcent
`
  'url.url-info.get-query': `
Obtient la valeur d'un paramètre de requête
key : nom du paramètre de requête à lire
Retour val ?str : ok = valeur du paramètre, nil = non trouvé
`
  'url.url-info.set-query': `
Définit la valeur d'un paramètre de requête
key : nom du paramètre de requête à définir
value : nouvelle valeur de ce paramètre
`
  'url.url-info.to-str': `
Réassemble l'URL en chaîne
Retour out str : URL complète assemblée
`
  'url.url-join': `
Concatène l'URL de base et le chemin
base : URL de base
path-str : chemin à ajouter à la fin
Retour out str : URL complète concaténée
`
  'url.url-parse': `
Analyse une chaîne URL
url-str : chaîne URL complète à analyser
Retour u url-info : résultat de l'analyse (u.ok = true = succès)
`
  'url.url-parse-basic-auth': `
Analyse l'en-tête d'authentification HTTP Basic
header : valeur de l'en-tête Authorization (p. ex. 'Basic dXNlcjpwYXNz')
Retour user str : nom d'utilisateur (vide = analyse échouée)
Retour password str : mot de passe
`
  'uuid.cmp': `
Compare deux UUID lexicographiquement
b : l'autre UUID à comparer
r: résultat de comparaison lexicographique (-1=self<b, 0=égal, 1=self>b ; octet par octet jusqu'à la première différence)
`
  'uuid.eq': `
Indique si deux UUID sont égaux
b : l'autre UUID à comparer
yes: true=les 16 octets des deux UUID sont égaux un à un
`
  'uuid.from-str': `
Analyse un UUID à partir d'une chaîne
Accepte la forme avec traits d'union (36 caractères) et la forme simple (32 caractères)
s str: la chaîne UUID
out uuid: l'UUID résultant
Renvoie ok bool: true = analyse réussie
s: chaîne UUID (36 caractères avec tirets ou 32 sans tirets)
out: paramètre de sortie, écrit 16 octets quand l'analyse réussit (le contenu initial est écrasé)
ok: true=format valide et écrit, false=longueur/caractères invalides
`
  'uuid.hex-byte': `
Écrit un octet sous forme de deux caractères hexadécimaux à la position pos de out
b byte: octet à encoder (le demi-octet fort est écrit en premier, le faible ensuite)
pos i64: décalage dans out où le premier caractère hex est écrit (le second caractère s'écrit à pos+1)
out str: chaîne cible, écrit deux cases en place (une écriture hors plage est ignorée par l'indexage sûr)
`
  'uuid.hex-byte-upper': `
Écrit un octet en hexadécimal majuscule
b : octet à convertir en deux caractères hex majuscules
pos: position octet de départ écrite dans out
out: paramètre de sortie, écrit deux caractères hex en place (les écritures hors plage sont ignorées par l'indexation sûre)
table: table des chiffres hex en majuscules (ex. '0123...ABCDEF')
`
  'uuid.hex-val': `
Convertit un caractère hexadécimal unique en sa valeur
c : point de code d'un seul caractère hex
v: la valeur 0~15 correspondante (caractères non hex donnent 0)
`
  'uuid.is-nil': `
Indique s'il s'agit de l'UUID nil (tout à zéro)
yes: si c'est l'UUID nul (16 octets tous zéro)
`
  'uuid.new-v4': `
Génère un UUID v4 aléatoire
state: l'état xorshift32 (entrée/sortie; l'initialiser avec une valeur non nulle)
out: UUID v4 aléatoire généré (l'état avance via xorshift32)
`
  'uuid.nil-uuid': `
Construit l'UUID nil (tout à zéro)
out: paramètre de sortie, rempli comme un UUID vide de 16 octets tous à zéro
`
  'uuid.parse-hex-byte': `
Analyse deux caractères hexadécimaux d'une chaîne en un octet
s: chaîne source contenant des caractères hex
pos: index du premier caractère hex à lire (prend la paire s[pos], s[pos+1])
v: la valeur d'octet synthétisée 0~255 (caractères illégaux comptés comme 0)
`
  'uuid.parse-no-dashes': `
Analyse un UUID sans traits d'union
s: la chaîne UUID complète à analyser
pos: index de départ de ce segment de 32 caractères dans s
out: paramètre de sortie, écrit les 16 octets analysés en cas de succès
ok: true=section analysée avec succès (tous caractères hex)
`
  'uuid.parse-with-dashes': `
Analyse un UUID avec traits d'union
s: la chaîne UUID complète à analyser
pos: index de départ de ce segment de 36 caractères dans s
out: paramètre de sortie, écrit les 16 octets analysés en cas de succès
ok: true=section analysée avec succès (positions des tirets et caractères hex tous valides)
`
  'uuid.to-str': `
Formate un UUID en chaîne standard
Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx (minuscules)
Renvoie out str: la chaîne UUID

`
  'uuid.to-str-upper': `
Formate un UUID en chaîne majuscule
Renvoie out str: la chaîne UUID majuscule

`
  'uuid.validate': `
Valide le format d'un UUID
ok: true=bits de variante valides (les 2 bits de poids fort de byte8 valent 10b, la variante RFC 4122) ; le numéro de version est lu à titre informatif seul et 4 n'est pas imposé
`
  'uuid.variant': `
Renvoie la variante de l'UUID
v: l'identifiant de variante (les 2 bits de poids fort de byte8, 2 selon RFC 4122)
`
  'uuid.version': `
Renvoie la version de l'UUID
v: le numéro de version de l'UUID (les 4 bits de poids fort de byte6, 4 pour v4)
`
  'vec.at': `
[]t.at: accès indexé sûr; nil hors bornes
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr

`
  'vec.clone': '[]t.clone: copie la tranche'
  'vec.contains': `
[]t.contains: indique si la valeur val est présente
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr
Remarque: la borne du range-for doit utiliser len (le champ .len), et non la variable locale sz, sinon le compilateur émet une condition de boucle erronée i < 0 et la boucle ne s'exécute jamais

`
  'vec.eq': `
[]t.eq : compare deux tranches pour égalité (élément par élément ; capacité et origine non comparées)
b []t : l'autre tranche ; renvoie false immédiatement si les longueurs diffèrent
eq bool : true=même longueur et tous les éléments correspondants égaux (éléments comparés avec !=)
`
  'vec.extend': `
[]t.extend: ajoute tous les éléments d'une autre tranche
Remarque: la logique de push est intégrée sur place pour contourner un bug LLVM préexistant sur l'appel à .push() depuis l'intérieur d'une méthode.
L'appelant doit garantir une capacité suffisante.

`
  'vec.fill': '[]t.fill: remplit avec val'
  'vec.first': `
[]t.first: le premier élément; une tranche vide renvoie nil
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr

`
  'vec.index-of': `
[]t.index-of: renvoie l'indice d'une valeur, ou -1
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr
Remarque: la borne du range-for doit utiliser len (le champ .len), et non la variable locale sz

`
  'vec.insert': `
[]t.insert: insère val à la position i
i >= .len() se comporte comme un push
Remarque: la logique de push est intégrée sur place (.len = cur + 1; .[cur] = val) pour contourner un bug LLVM préexistant
(_LB__RB_t.push undefined) déclenché par un appel à .push() dans une méthode. L'appelant doit garantir une capacité suffisante.

`
  'vec.last': `
[]t.last: le dernier élément; une tranche vide renvoie nil
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr

`
  'vec.len': `
[]t.len : renvoie le nombre d'éléments de la tranche (sans distinguer le type, indépendant du nombre d'octets)
out i64: longueur courante, dans la plage 0..cap
`
  'vec.max': `
[]t.max: la valeur maximale; une tranche vide renvoie nil
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr
Remarque: la borne du range-for doit utiliser len (le champ .len), et non la variable locale sz

`
  'vec.min': `
[]t.min: la valeur minimale; une tranche vide renvoie nil
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr
Remarque: la borne du range-for doit utiliser len (le champ .len), et non la variable locale sz

`
  'vec.pop': `
[]t.pop: retire l'élément en fin de tranche
Une tranche vide renvoie nil

`
  'vec.remove': `
[]t.remove: retire l'élément à la position i et le renvoie
Hors bornes renvoie nil

`
  'vec.reverse': '[]t.reverse: inverse sur place'
  'vec.sum': `
[]t.sum: la somme
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr
Remarque: la borne du range-for doit utiliser len (le champ .len), et non la variable locale sz

`
  'vec.swap': `
[]t.swap: échange les éléments de deux positions
Remarque: sz = .len() force le type self vec, pour que la méthode ne soit pas spécialisée par erreur en méthode arr

`
  'vec.to-arr': '[]t.to-arr: une méthode de tranche qui convertit en tableau [n]t'
  'vec.to-str': `
[]t.to-str: la forme chaîne
Formatée comme '[1, 2, 3]'
Les éléments sont convertis en chaîne en appelant leur propre .to-str() (voir number.no pour les types concrets)

`
  'vec.truncate': '[]t.truncate: tronque à cnt éléments; cnt < 0 est traité comme 0, et cnt >= .len ne fait rien'
  'vec.vec-clear': `
[]t.clear : vide la tranche (longueur 0 sur place) — builtin, le corps est déroulé par codegen
Ne libère pas le tas et ne réduit pas la capacité, le pointeur de données reste donc inchangé
Seule une écriture de contenu nouveau de longueur non nulle passe par la logique de croissance
Sans paramètre ni valeur de retour : vider est une modification en place du récepteur lui-même
`
  'vec.vec-push': `
[]t.push : ajoute un élément à la fin (croît automatiquement) — builtin, le corps est déroulé par codegen
Politique de croissance:
cap == 0 -> new-cap = 4
cap < 1024 -> new-cap = cap * 2
cap >= 1024 -> new-cap = cap * 5 / 4
val t: l'élément à ajouter ; le type est décidé par le type d'élément de la tranche réceptrice
Après ajout, .len croît de 1 ; lors de la croissance les éléments existants passent dans le nouveau tampon et l'ancien est libéré
`
  'ws.build-frame': `
Assemble une trame WebSocket
opcode i64 : type de message
data str : contenu du message
mask bool : appliquer un mask ou non (client doit être true, server doit être false)
mask-key str : clé de mask de 4 octets (utilisée quand mask=true)
Retour frame str : chaîne de trame complète
`
  'ws.client.close': 'Ferme la connexion'
  'ws.client.is-connected': `
Vérifie l'état de la connexion
Retour yes bool : true = connecté
`
  'ws.client.recv': `
Lit en bloquant un message WebSocket complet
le serveur n'applique pas de mask, pas besoin de demask (mais vérifie tout de même le bit de mask)
Retour msg ?message :
ok = message
nil = connexion fermée
err = erreur
`
  'ws.client.send': `
Envoie une trame WebSocket (le client doit appliquer un mask)
opcode i64 : type de message
data str : contenu du message
Retour ok bool : true = succès
`
  'ws.client.send-binary': `
Envoie un message binaire
data : contenu binaire (séquence d'octets)
ok : true = envoi réussi
`
  'ws.client.send-close': `
Envoie une trame close
close-code i64 : code d'état de fermeture
reason str : raison de la fermeture
Retour ok bool : true = succès
`
  'ws.client.send-ping': `
Envoie un ping
data : charge du ping (l'autre partie renverra pong tel quel)
ok : true = envoi réussi
`
  'ws.client.send-pong': `
Envoie un pong
data : charge du pong (renvoie habituellement la charge du ping reçu telle quelle)
ok : true = envoi réussi
`
  'ws.client.send-text': `
Envoie un message texte
data : contenu texte
ok : true = envoi réussi
`
  'ws.compute-accept': `
Calcule la valeur Sec-WebSocket-Accept
key str : Sec-WebSocket-Key envoyé par le client
Retour accept str : base64(sha1(key - WS-GUID))
`
  'ws.connect': `
Se connecte à un point de terminaison WebSocket
url str : URL du point de terminaison WS/WSS (ws://host:port/path ou wss://host:port/path)
Retour c ?client :
ok = client connecté
nil = échec de connexion
err = message d'erreur
`
  'ws.gen-client-key': `
Génère une Sec-WebSocket-Key de 16 octets et l'encode en base64
seed i64 : valeur de graine
Retour key str : chaîne encodée en base64 (24 caractères avec remplissage)
`
  'ws.gen-mask-key': `
Génère une chaîne de clé de mask de 4 octets
seed i64 : valeur de graine
Retour key str : chaîne de 4 caractères
`
  'ws.listen-on': `
Crée le côté serveur WebSocket et commence à écouter
host str : adresse IP à lier (p. ex. '0.0.0.0')
port i64 : numéro de port à écouter
Retour s ?server : ok = côté serveur, nil = échec
`
  'ws.next-rand': `
Produit le prochain i64 pseudoaléatoire
Combine un compteur global et un simple LCG
r : nouveau nombre pseudoaléatoire (compteur global + sortie LCG, de qualité non cryptographique)
`
  'ws.server-conn.close': 'Ferme la connexion client'
  'ws.server-conn.handshake': `
Termine le handshake HTTP WebSocket
Lit la requête de mise à niveau HTTP du client, vérifie les en-têtes requis, et envoie la réponse 101.
Définit .connected = true en cas de succès.
`
  'ws.server-conn.is-connected': `
Vérifie l'état de la connexion
Retour yes bool : true = connecté
`
  'ws.server-conn.recv': `
Lit en bloquant un message WebSocket complet
Gère la collecte des messages fragmentés (opcode de continuation).
Reçoit un ping → répond automatiquement pong ; reçoit un close → met connected=false et renvoie nil.
Retour msg ?message :
ok = message
nil = connexion fermée
err = erreur
`
  'ws.server-conn.recv-nb': `
Note : pour s'adapter au balayage non bloquant, cette méthode n'accumule pas la fragmentation sur plusieurs appels ;
un message text/binary d'une seule trame (usage du frontend nowork) devient directement un message.
Quand une réassemblage complet des fragments est nécessaire, utilisez tout de même la version bloquante recv.
`
  'ws.server-conn.send': `
Envoie une trame WebSocket (le serveur n'applique pas de mask)
opcode i64 : type de message (WS-OP-TEXT / WS-OP-BINARY / ...)
data str : contenu du message
Retour ok bool : true = succès
`
  'ws.server-conn.send-binary': `
Envoie un message binaire
data str : contenu du message
Retour ok bool : true = succès
`
  'ws.server-conn.send-close': `
Envoie une trame close
close-code i64 : code d'état de fermeture (p. ex. 1000)
reason str : raison de la fermeture
Retour ok bool : true = succès
`
  'ws.server-conn.send-ping': `
Envoie un ping
data str : contenu du ping
Retour ok bool : true = succès
`
  'ws.server-conn.send-pong': `
Envoie un pong
data str : contenu du pong
Retour ok bool : true = succès
`
  'ws.server-conn.send-text': `
Envoie un message texte
data str : contenu du message
Retour ok bool : true = succès
`
  'ws.server.accept': `
Accepte une nouvelle connexion client WebSocket et termine le handshake
Retour c ?server-conn : ok = client ayant fait le handshake, nil = échec
`
  'ws.server.close': 'Ferme le côté serveur WebSocket'
  'ws.server.listen': `
Commence à écouter
host str : adresse IP à lier (p. ex. '0.0.0.0')
port i64 : numéro de port à écouter
Retour ok bool : true = succès
`
  'x25519.fe-add': `
Addition d'éléments de corps h = f + g
h : résultat ajouté limb par limb (sans propagation de retenue, l'équivalence est garantie par la multiplication/sérialisation ultérieure)
f : premier terme à ajouter
g : second terme à ajouter
`
  'x25519.fe-add-v': `
Renvoie a + b
a : premier terme à ajouter
b : second terme à ajouter
h : nouvel élément de corps somme créé
`
  'x25519.fe-copy': `
Copie un élément de corps
h : élément de corps destination (rempli sur place avec les 10 limb de f)
f : élément de corps source
`
  'x25519.fe-cswap': `
Échange conditionnel (utilisé par l'échelle de Montgomery)
masque b : 0 = pas d'échange, 1 = échange
a : premier élément de corps (participe à l'échange sur place)
b : second élément de corps (participe à l'échange sur place)
mask : 0 = pas d'échange, 1 = échange (étendu en interne en un masque tous bits à 1, maintenant le temps constant)
`
  'x25519.fe-frombytes': `
Charge un élément de corps depuis 32 octets (little-endian)
Utilise le style ref10 : charge d'abord les limb non masqués par décalage, puis fait la propagation de retenue
La propagation de retenue utilise la constante d'arrondi (1<<(bits-1)), produisant une forme « demi-réduite » (les limb peuvent être légèrement négatifs)
Cette forme correspond à l'entrée attendue de fe-tobytes, garantissant un aller-retour correct
h : élément de corps chargé (10 limb, propagation de retenue demi-réduite effectuée)
s : codage little-endian de 32 octets (le bit de poids fort bit255 est masqué)
`
  'x25519.fe-frombytes-v': `
Renvoie un élément de corps depuis 32 octets (little-endian)
s : codage little-endian de 32 octets (bit255 ignoré)
h : nouvel élément de corps créé
`
  'x25519.fe-invert': `
Calcule a^(-1) mod p
Utilise une chaîne d'additions ref10 pour calculer a^(p-2) = a^(2^255-21)
Aligne entièrement la chaîne d'additions de libsodium fe25519_invert
out : élément de corps écrivant le résultat (10 limb)
a : élément de corps à inverser (ne peut pas être l'élément nul)
`
  'x25519.fe-invert-v': `
Renvoie a^(-1) mod p
a : élément de corps à inverser
h : nouvel inverse créé (a^(p-2))
`
  'x25519.fe-mul': `
Multiplication d'éléments de corps h = f * g mod p
Utilise le déploiement en croix ref10
Note : utilise le tableau t[] pour stocker les résultats intermédiaires afin d'éviter les problèmes d'optimisation du compilateur
h : élément de corps produit (f × g mod p)
f : facteur (10 limb)
g : facteur (10 limb)
`
  'x25519.fe-mul-v': `
Renvoie a * b mod p
a : facteur
b : facteur
h : nouvel élément de corps produit créé (a × b mod p)
`
  'x25519.fe-mul121665': `
Multiplie l'élément de corps par la constante 121665 (= (A-2)/4, A=486662)
Dans la formule de duplication d'échelle de Montgomery z2 = E*(AA + a24*E), a24 doit être 121665,
pas 121666. 121666 rend la duplication de l'échelle erronée (sortie toute zéros/erronée sous certains scalaires).
Utilise un tableau pour stocker les résultats intermédiaires afin d'éviter les problèmes d'optimisation du compilateur
h : élément de corps après multiplication par 121665
f : élément de corps à multiplier
`
  'x25519.fe-one': `
Élement unité
h : élément de corps écrit comme l'identité (limb0=1, le reste 0)
`
  'x25519.fe-one-v': `
Renvoie l'élément de corps unité
h : nouvel élément de corps identité créé (longueur 10)
`
  'x25519.fe-sq': `
Carré d'élément de corps h = f^2 mod p
Utilise directement fe-mul
h : résultat du carré (f² mod p)
f : élément de corps à élever au carré
`
  'x25519.fe-sq-v': `
Renvoie a^2 mod p
a : élément de corps à élever au carré
h : nouveau résultat de carré créé
`
  'x25519.fe-sub': `
Soustraction d'éléments de corps h = f - g
h : résultat soustrait limb par limb (les limb peuvent être négatifs, la réduction ultérieure les ramène à une représentation positive)
f : diminué
g : diminuant
`
  'x25519.fe-sub-v': `
Renvoie a - b
a : diminué
b : diminuant
h : nouvel élément de corps différence créé
`
  'x25519.fe-tobytes': `
Sérialise un élément de corps en 32 octets (little-endian)
Utilise la propagation de retenue par division plancher sans constante d'arrondi
Réduit d'abord les limb à [0, 2^bits-1], puis teste le >= p avec +19
s : tampon de 32 octets écrivant le résultat sérialisé
h : élément de corps à sérialiser (réduit d'abord à [0,p) puis émis)
`
  'x25519.fe-tobytes-v': `
Sérialise un élément de corps en 32 octets (little-endian) et le renvoie
[32]byte est passé par valeur, un simple fe-tobytes(s, h) n'écrit pas dans l'emplacement de retour ;
on écrit donc d'abord dans un tableau local puis affecte l'ensemble à la valeur de retour s.
h : élément de corps à sérialiser
s : nouveau codage little-endian de 32 octets créé
`
  'x25519.fe-zero': `
Élément nul
h : élément de corps écrit comme l'élément nul (les 10 limb mis à 0)
`
  'x25519.fe-zero-v': `
Renvoie l'élément de corps nul
h : nouvel élément de corps nul créé (longueur 10)
`
  'x25519.x25519-gen-keypair': `
Génère une paire de clés aléatoire
seed i64 : graine aléatoire
Retour priv [32]byte : clé privée
Retour pub [32]byte : clé publique
seed : graine rand (détermine la clé privée ; en situation réelle, injecter une source d'aléa système)
priv : clé privée (déjà bridée : bits 0-2 remis à zéro, bit254 mis à 1, bit255 remis à zéro)
pub : clé publique correspondante (priv × point de base)
`
  'x25519.x25519-get-basepoint': `
Renvoie la coordonnée u du point de base (9, 0, 0, ..., 0)
base : codage little-endian de 32 octets du point de base u=9
`
  'x25519.x25519-scalarmult': `
Multiplication scalaire X25519
scalar [32]byte : scalaire (clé privée)
point [32]byte : coordonnée du point (clé publique)
Retour out [32]byte : résultat
`
  'x25519.x25519-scalarmult-base': `
Calcule scalaire * point de base
scalar [32]byte : scalaire (clé privée)
Retour out [32]byte : clé publique
`
  'x25519.x25519-scalarmult-base-bytes': `
Calcule scalaire * point de base (version []byte)
scalar []byte : scalaire (clé privée, longueur 32)
Retour out []byte : clé publique (longueur 32)
`
  'x25519.x25519-scalarmult-bytes': `
Multiplication scalaire X25519 (version []byte)
scalar []byte : scalaire (clé privée, longueur 32)
point []byte : coordonnée du point (clé publique, longueur 32)
Retour out []byte : résultat (longueur 32)
`
  'x509.alg-id-rsa-encryption': `
AlgorithmIdentifier pour rsaEncryption (1.2.840.113549.1.1.1)
Retour out []byte : SEQUENCE { OID rsaEncryption, NULL }
`
  'x509.alg-id-sha256-with-rsa': `
AlgorithmIdentifier pour sha256WithRSAEncryption (1.2.840.113549.1.1.11)
Retour out []byte : SEQUENCE { OID sha256WithRSAEncryption, NULL }
`
  'x509.der-enc-bitstring': `
Emballé en BIT STRING
data []byte : données d'octets
Retour out []byte : DER BIT STRING
data : contenu de la chaîne de bits (aligné sur les octets, la fonction ajoute automatiquement l'octet initial « bits non utilisés » = 0)
out : DER BIT STRING de tag=0x03 (longueur de contenu supérieure de 1 à data)
`
  'x509.der-enc-explicit': `
Context tag EXPLICIT [n]
tag-num i64 : numéro d'étiquette (0, 1, 2, ...), prend les 5 bits de poids faible puis compose le tag avec 0xA0
content []byte : codage DER interne à envelopper dans ce context tag
Retour out []byte : DER [n] EXPLICIT (tag de structure + longueur + content)
`
  'x509.der-enc-integer-bytes': `
Encode un tableau d'octets big-endian en DER INTEGER
data []byte : octets big-endian (entier positif)
Retour out []byte : DER INTEGER (avec tag+length)
`
  'x509.der-enc-integer-i64': `
Encode un i64 en DER INTEGER
val i64 : valeur entière
Retour out []byte : DER INTEGER
`
  'x509.der-enc-len': `
Encode une longueur DER
val i64 : valeur de la longueur
Retour out []byte : octets de longueur DER
`
  'x509.der-enc-null': `
Encode un DER NULL (contenu toujours vide)
out : deux octets 05 00
`
  'x509.der-enc-octetstring': `
Emballé en OCTET STRING
data : octets bruts à envelopper (p. ex. paramètres d'algorithme, empreinte, etc.)
out : DER OCTET STRING de tag=0x04
`
  'x509.der-enc-oid-raw': `
Encode depuis les octets de contenu OID bruts (sans tag+length)
raw []byte : octets de contenu OID (par exemple rsaEncryption = [0x2A, 0x86, 0x48, ...])
Retour out []byte : DER OBJECT IDENTIFIER (avec tag+length)
`
  'x509.der-enc-printablestring': `
Encode un DER PrintableString (prend directement les octets de la chaîne comme contenu)
s : texte à encoder (l'appelant doit garantir un ASCII imprimable dans le jeu de caractères PrintableString)
out : DER TLV de tag=0x13
`
  'x509.der-enc-sequence': `
Emballé en SEQUENCE
content : concaténation dans l'ordre des codages DER de chaque sous-nœud (chacun déjà avec tag+length)
out : DER SEQUENCE de tag=0x30
`
  'x509.der-enc-set': `
Emballé en SET
content : concaténation des codages DER de chaque nœud membre
out : DER SET de tag=0x31
`
  'x509.der-enc-tlv': `
Emballé en TLV
tag i64 : octet d'étiquette (p. ex. 0x02 INTEGER, 0x17 UTCTime)
content []byte : octets de contenu à emballer (peut être vide, le champ de longueur est écrit même quand la longueur est 0)
Retour out []byte : TLV complet (tag + longueur DER + content)
`
  'x509.der-enc-utctime': `
Encode un DER UTCTime
s : texte d'heure, au format YYMMDDHHMMSSZ (p. ex. "240101000000Z")
out : DER TLV de tag=0x17
`
  'x509.der-len': `
Décode une longueur DER
data : données encodées DER, pos : position (pointe sur les octets de longueur)
len : valeur de longueur en sortie, adv : nombre d'octets consommés en sortie (1 ou plus)
`
  'x509.der-skip': `
Saute un élément TLV DER
data : données encodées DER
pos : position courante (pointe sur l'octet d'étiquette)
next : position du prochain élément en sortie
`
  'x509.der-tag': `
Lit l'octet d'étiquette DER
data : données encodées DER, pos : position
tag : valeur d'étiquette en sortie
pos : décalage de l'octet d'étiquette (lit seulement data[pos], n'avance pas ; c'est à l'appelant de faire avancer sa position)
`
  'x509.rsa-pkcs1-sign-sha256': `
Signe des données avec RSA PKCS#1 v1.5
data []byte : données à signer
n []byte : module (big-endian)
d []byte : exposant privé (big-endian)
Retour sig []byte : signature (longueur du module)
`
  'x509.sha256-compress': `
Compression d'un seul bloc SHA-256
Exécute 64 tours de compression sur 16 mots de message de 32 bits et additionne le résultat à l'état d'entrée.
w0..w15 i64 : les 16 mots big-endian de 32 bits du bloc de 512 bits courant (seuls les 32 bits de poids faible de chaque mot sont utilisés)
hin0..hin7 i64 : les 8 mots d'état de hachage de 32 bits avant l'entrée dans ce bloc (valeurs initiales de a..h)
h0..h7 i64 : les 8 mots d'état de 32 bits après compression (hin + variables de travail, déjà avec & 0xFFFFFFFF)
`
  'x509.x509-build-name-cn': `
Construit un Name (CN uniquement)
cn str : commonName
Retour out []byte : RDNSequence
`
  'x509.x509-build-rsa-public-key': `
Construit le DER RSAPublicKey
n []byte : module (big-endian, sans 0x00 de tête)
e i64 : exposant public
Retour out []byte : SEQUENCE { INTEGER n, INTEGER e }
`
  'x509.x509-build-self-signed-cert': `
Construit un certificat X.509 auto-signé
n []byte : module RSA (big-endian)
e i64 : exposant public
d []byte : exposant privé RSA (big-endian)
cn str : Common Name
Retour cert []byte : certificat complet encodé DER
`
  'x509.x509-build-spki': `
Construit un SubjectPublicKeyInfo
n []byte : module
e i64 : exposant public
Retour out []byte : SEQUENCE { AlgorithmIdentifier, BIT STRING RSAPublicKey }
`
  'x509.x509-build-tbs': `
Construit un TBSCertificate
n []byte : module RSA
e i64 : exposant public
cn str : CN du certificat
not-before str : heure de début
not-after str : heure de fin
Retour out []byte : TBSCertificate DER
`
  'x509.x509-build-validity': `
Construit un Validity
not-before str : chaîne UTCTime (p. ex. "240101000000Z")
not-after str : chaîne UTCTime
Retour out []byte : SEQUENCE { UTCTime, UTCTime }
`
  'x509.x509-bytes-to-bn': `
Tableau d'octets big-endian → []i64 (little-endian base 2^32)
Copie locale, pour éviter une dépendance circulaire avec net/tls.no
data []byte : octets big-endian
Retour out []i64 : grand entier (chaque élément est un limb de 32 bits)
`
  'x509.x509-fingerprint': `
x509-fingerprint : calcule l'empreinte SHA-256 d'un certificat X.509
C'est la valeur de hachage SHA-256 de la sous-structure TBSCertificate du certificat (et non le hachage du DER entier).
Localise d'abord les octets du TBSCertificate via x509-tbs-range, puis les confie à sha256.sha256 pour le calcul,
enfin combine les 32 octets du résultat de hachage en 8 mots big-endian de 32 bits et les renvoie.
data : octets DER complets du certificat
h0 i64 : mot de 32 bits le plus élevé de l'empreinte (big-endian, 0 si le TBSCertificate n'est pas localisable)
h1 i64 : second mot de 32 bits en ordre décroissant
h2 i64 : troisième mot de 32 bits en ordre décroissant
h3 i64 : quatrième mot de 32 bits en ordre décroissant
h4 i64 : cinquième mot de 32 bits en ordre décroissant
h5 i64 : sixième mot de 32 bits en ordre décroissant
h6 i64 : septième mot de 32 bits en ordre décroissant
h7 i64 : mot de 32 bits le plus faible (tous à 0 signifie que ce certificat n'a pas de TBSCertificate analysable)
`
  'x509.x509-rsa-e': `
Extrait l'exposant public RSA (habituellement 65537)
data : certificat encodé DER
e : valeur d'exposant en sortie (0 = non-RSA ou analyse échouée)
`
  'x509.x509-rsa-n': `
Extrait le module de la clé publique RSA (tableau d'octets big-endian)
data []byte : certificat encodé DER
Retour out []byte : octets du module (big-endian, sans 0x00 de tête)
`
  'x509.x509-serial': `
Extrait le numéro de série du certificat (s'il tient dans un i64)
data : certificat encodé DER
serial : numéro de série en sortie (0 = extraction impossible)
`
  'x509.x509-tbs-range': `
Trouve la plage d'octets du TBSCertificate
data : certificat encodé DER
start : position initiale TBS en sortie (avec l'étiquette SEQUENCE)
end : position finale TBS en sortie (exclusive, c'est-à-dire le début de l'élément suivant)
`
  'xz.lzma-decoder.decode': `
Boucle principale du décodeur LZMA
data : données compressées, start-pos : position initiale des données
unpacked-size : taille de décompression attendue (-1 = inconnue)
start-pos : décalage de début de décodage du flux LZMA dans data
`
  'xz.lzma-decoder.decode-distance': `
Décode la distance de correspondance
length : longueur de la correspondance (pour déterminer le mode d'encodage de la distance)
dist : distance de la correspondance (décalage en octets en arrière depuis la position d'écriture courante)
`
  'xz.lzma-decoder.decode-length': `
Décode la longueur de correspondance
probs : tableau de probabilités, renvoie la longueur
length : longueur de correspondance décodée (combinaison du sélecteur et des bits bas/alignement)
`
  'xz.lzma-decoder.decode-literal': 'Décode un littéral'
  'xz.lzma-decoder.init-probs': 'Initialise toutes les valeurs de probabilité à 0x400 (probabilité d\'un demi)'
  'xz.lzma-decoder.update-state-literal': 'Met à jour l\'état (après un littéral)'
  'xz.lzma-decoder.update-state-match': 'Met à jour l\'état (après une correspondance)'
  'xz.lzma-decoder.update-state-rep': 'Met à jour l\'état (après une correspondance répétée)'
  'xz.lzma-decoder.update-state-shortrep': 'Met à jour l\'état (après une courte répétition)'
  'xz.lzma-decompress': `
Format .lzma :
- 1 octet : propriétés (encodage lc, lp, pb)
- 4 octets : taille du dictionnaire (little-endian)
- 8 octets : taille non compressée (little-endian, 0xFFFFFFFFFFFFFFFF = inconnue)
- données compressées
`
  'xz.lzma-rd.decode-bit': `
Décode un bit
prob : valeur de probabilité (0-0x7FFF), renvoie le bit et la prob mise à jour
bit : bit décodé (0 ou 1)
new-prob : valeur de probabilité après mise à jour adaptative (réutilisée au décodage suivant)
`
  'xz.lzma-rd.decode-bit-tree': `
Décode un arbre de bits
num-bits : profondeur de l'arbre, probs : tableau de probabilités, renvoie le symbole
probs : tableau de probabilités de chaque nœud de l'arbre de bits
sym : valeur du symbole décodée en parcourant l'arbre bit par bit jusqu'à la feuille
`
  'xz.lzma-rd.decode-direct-bits': `
Décode n bits directs
num-bits : nombre de bits directs à décoder (sans passer par le modèle de probabilité)
res : valeur entière brute formée par num-bits bits
`
  'xz.lzma-rd.decode-reverse-bit-tree': `
Décode un arbre de bits inverse
probs : tableau de probabilités de chaque nœud de l'arbre de bits
num-bits : profondeur de l'arbre (nombre de bits du symbole décodé)
sym : valeur du symbole décodée en parcourant l'arbre en inverse (des bits bas vers les hauts)
`
  'xz.lzma-rd.init': `
Initialise le décodeur à plage
data : flux d'octets compressés LZMA à décoder
start-pos : décalage en octets où commencer le décodage dans les données
`
  'xz.lzma-rd.normalize': 'Normalisation du décodeur à plage'
  'xz.lzma2-decompress-stream': `
Décompresse un flux LZMA2
LZMA2 utilise des octets de contrôle pour découper les blocs de données :
0x00 = fin
0x01 = réinitialisation de dictionnaire non compressée (avec un ID de dictionnaire de 4 octets)
0x02 = non compressé sans réinitialisation de dictionnaire
0x80-0xBF = compressé LZMA (réinitialisation de dictionnaire possible)
out est un paramètre de résultat nommé (sucre syntaxique out-parameter) : le point d'appel lie la variable réceptrice via le LHS.
Le corps de la fonction accumule d'abord dans le res local, puis livre out = res à la fin (même motif que inflate-decompress de gzip.no) ;
déclarer out comme un simple paramètre d'entrée rendrait une référence en lecture seule, et le résultat du push ne reviendrait pas à l'appelant.
data : flux LZMA2 contenant les octets de contrôle
start-pos : décalage initial du flux
out : flux d'octets en clair décompressé (paramètre de sortie nommé, livré en une fois en fin de fonction)
`
  'xz.xz-compress': `
Compresse des données au format xz (implémentation de base)
data : données brutes ([]byte)
out : données compressées en xz ([]byte)
Note : utilise actuellement une implémentation de base à bloc stocké (stored block),
la compression LZMA2 complète reste à implémenter ultérieurement.
`
  'xz.xz-decompress': `
Format .xz :
- En-tête de flux : 6 octets de magie + 2 octets d'attributs de flux
- Blocs : En-tête de bloc + Données compressées + Remplissage de bloc + Contrôle
- Index
- Pied de flux : 12 octets
`
  'yaml.anchor': `
Le nom d'ancre du nœud courant
a : nom de l'ancre du nœud (chaîne vide = aucune)
`
  'yaml.at': `
Obtient un élément de séquence / la i-ème valeur d'un mapping
i: index de séquence / la ième paire clé/valeur d'un mapping (à partir de 0)
out: le nœud de valeur correspondant (nil=hors plage ou type non conforme)
`
  'yaml.bool': `
Obtient la valeur booléenne
val: la valeur booléenne (nil=pas un nœud booléen)
`
  'yaml.doc': `
Obtient le i-ème document
Note : les vues de nœuds enfants sont renvoyées en ?yaml pour que l'appelant les dépaquette avec match.
i: numéro de document (à partir de 0)
out: handle du document i (nil=hors plage)
`
  'yaml.doc-count': `
Le nombre de documents
n: nombre de documents contenus dans cet ensemble de documents
`
  'yaml.error': `
L'erreur de parse de ce document (toujours chaîne vide quand le parse a réussi)
Note : en cas d'échec de parse, yaml.parse renvoie err et aucune valeur yaml n'est obtenue ;
Pour la cause de l'échec, utilisez yaml.error-of(source).
msg: message d'erreur (toujours vide quand l'analyse réussit)
`
  'yaml.error-of': `
Parse le texte source et renvoie le message d'erreur (chaîne vide en cas de succès)
source: texte source YAML
msg: message d'erreur d'analyse (chaîne vide=succès)
`
  'yaml.f64': `
Obtient la valeur flottante
val: la valeur flottante (nil=pas un nœud flottant)
`
  'yaml.find': `
Recherche par chemin pointé (les séquences acceptent des indices numériques)
path: chemin séparé par des points, ex. 'a.b.0' (les segments numériques indexent des séquences)
out: le nœud atteint par le chemin (nil=chemin inexistant)
`
  'yaml.find-bool': `
Obtient un booléen par chemin
path: chemin séparé par des points
out: valeur booléenne en bout de chemin (nil=absente ou non booléenne)
`
  'yaml.find-f64': `
Obtient un flottant par chemin
path: chemin séparé par des points
out: valeur flottante en bout de chemin (nil=absente ou non flottante)
`
  'yaml.find-i64': `
Obtient un entier par chemin
path: chemin séparé par des points
out: valeur entière en bout de chemin (nil=absente ou non entière)
`
  'yaml.find-str': `
Lit une chaîne à un chemin
path: chemin séparé par des points
out: valeur chaîne en bout de chemin (nil=absente ou non chaîne)
`
  'yaml.get': `
Obtient une valeur de mapping par clé scalaire
key: texte de clé scalaire à chercher
out: le nœud de valeur correspondant (nil=clé absente ou pas un mapping)
`
  'yaml.get-bool': `
Obtient un booléen par clé scalaire
key: texte de clé scalaire à chercher
out: booléen de la valeur correspondante (nil=clé absente ou valeur non booléenne)
`
  'yaml.get-f64': `
Obtient un flottant par clé scalaire
key: texte de clé scalaire à chercher
out: flottant de la valeur correspondante (nil=clé absente ou valeur non flottante)
`
  'yaml.get-i64': `
Obtient un entier par clé scalaire
key: texte de clé scalaire à chercher
out: entier de la valeur correspondante (nil=clé absente ou valeur non entière)
`
  'yaml.get-str': `
Obtient une chaîne par clé scalaire
key: texte de clé scalaire à chercher
out: forme chaîne de la valeur correspondante (nil=clé absente ou valeur non chaîne)
`
  'yaml.i64': `
Obtient la valeur entière
val: la valeur entière (nil=pas un nœud entier)
`
  'yaml.is-bool': `
S'il est booléen
yes: le nœud est un booléen (true/false et les orthographes alias YAML)
`
  'yaml.is-int': `
S'il est entier
