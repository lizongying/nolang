  'yaml.parse-all': 'Analyse tous les documents'
  'yaml.scalar-text': 'Le texte scalaire du nœud courant (un conteneur renvoie ok=false)'
  'yaml.source-of': 'Le texte d\'entrée d\'origine'
  'yaml.str': 'Renvoie une valeur chaîne (les nombres et les booléens renvoient leur texte source)'
  'yaml.stringify': 'Alias de to-yaml'
  'yaml.strip-bom': 'Supprime un BOM UTF-8 en tête'
  'yaml.style': 'Le style du nœud courant'
