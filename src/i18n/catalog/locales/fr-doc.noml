  'yaml.to-json': 'Convertit le document courant en JSON'
  'yaml.to-json-all': 'Convertit tous les documents en un tableau JSON'
  'yaml.to-yaml': 'Ré-émet le document courant en YAML'
  'yaml.valid': 'Indique si ce document a été analysé avec succès (obtenir une valeur yaml signifie un succès)'
  'yaml.valid-of': 'Indique si le texte source peut être analysé (aucun document n\'est construit)'
  'yaml.value': 'Renvoie le nœud valeur de la i-ème clé d\'un mapping'
