  'tree-map.tree-map.contains': `
Indique si une clé existe
key i64: la clé
Renvoie yes bool: true = présente, false = absente

`
  'tree-map.tree-map.empty': `
Indique si l'arbre est vide
Renvoie yes bool: true = vide, false = non vide

`
  'tree-map.tree-map.first': `
Renvoie la plus petite clé
Renvoie key ?i64: ok = la plus petite clé, nil = l'arbre est vide

`
