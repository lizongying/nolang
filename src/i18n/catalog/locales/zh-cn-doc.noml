  'map.hashmap-str-tmpl.hash': 'FNV-1a 字符串哈希'
  'map.hashmap-str-tmpl.init': '初始化'
  'map.hashmap-str-tmpl.is-empty': '是否为空'
  'map.hashmap-str-tmpl.len': '返回元素数量'
