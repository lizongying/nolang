  'multipart.multipart-writer.boundary-of': `
取得边界字串
返回 boundary: 编码器目前使用的边界（不含 -- 前缀）
`
  'multipart.multipart-writer.close-form': `
写入结束边界，完成表单
返回 ok: true=写入成功
`
  'multipart.multipart-writer.content-type': `
取得 Content-Type 标头值
返回 ct: 如 'multipart/form-data; boundary=----NolangBoundary...'
`
