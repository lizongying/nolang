  'uuid.to-str-upper': `
将 UUID 格式化为大写字符串
返回 out: UUID 大写字符串
`
  'uuid.uuid': 'uuid: 128-bit 通用唯一标识符'
  'uuid.validate': '验证 UUID 格式是否合法'
  'uuid.variant': '获取 UUID 变体'
  'uuid.variant-rfc4122': 'RFC 4122 变体'
