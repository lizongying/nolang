  'yaml.yaml-parser.parse-flow-map': 'Parses {k: v, ...}'
  'yaml.yaml-parser.parse-flow-node': 'Parses a flow-context node'
  'yaml.yaml-parser.parse-flow-seq': 'Parses [a, b, ...]'
  'yaml.yaml-parser.parse-plain': 'Parses a plain scalar (including cross-line folding)'
  'yaml.yaml-parser.parse-props': 'Parses a node\'s leading anchor and tag (in either order)'
  'yaml.yaml-parser.parse-single': 'Parses a single-quoted scalar'
  'yaml.yaml-parser.push-node': 'Appends a node and returns its index'
  'yaml.yaml-parser.push-null': 'Appends a null node'
  'yaml.yaml-parser.push-scalar': 'Builds a scalar node from its style and tag'
  'yaml.yaml-parser.read-line-content': 'Reads from the current position to end of line (trailing whitespace and comments removed)'
  'yaml.yaml-parser.read-tag': 'Reads a tag (!!name, !name, !<verbatim>, or !)'
  'yaml.yaml-parser.read-token': 'Reads a bare token containing no separator'
  'yaml.yaml-parser.register-anchor': 'Registers an anchor'
  'yaml.yaml-parser.set-props': 'Attaches a tag and anchor to a node (and registers the anchor)'
