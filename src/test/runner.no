; runner — 測試執行器
;
; 提供測試計數與結果彙總，簡化測試檔案結構。
;
; 用法：
;   # github.com/lizongying/nolang/test/runner
;   # github.com/lizongying/nolang/test/assert
;
;   passed = 0
;   failed = 0
;   ok = assert-eq(1, 1, 'test 1')
;   ok == false -> failed = runner.fail(failed)
;   -> passed = runner.pass(passed)
;   runner.summary(passed, failed)
;   failed > 0 -> 1
;   0

; ═══════════════════════════════════════════════
; 輔助函數
; ═══════════════════════════════════════════════

; pass: 記錄一筆測試通過
pass = (passed i64) (new-passed i64) {
    new-passed = passed + 1
}

; fail: 記錄一筆測試失敗
fail = (failed i64) (new-failed i64) {
    new-failed = failed + 1
}

; summary: 輸出測試結果彙總
summary = (passed i64, failed i64) (total i64) {
    print('--- Test Summary ---')
    print('passed:', passed)
    print('failed:', failed)
    total = passed + failed
    print('total:', total)
    {
        failed == 0 -> print('ALL TESTS PASSED')
        -> print('SOME TESTS FAILED')
    }
}

; cb: 具名函式型別（無參無返回）
cb = ()

; test-run: 執行一個無參數回呼函式並計數
; 印出 'RUN:' + name，呼叫 cb()，若執行完成則 passed=1, failed=0
test-run = (name str, cb test-cb) (passed i64, failed i64) {
    print('RUN:', name)
    cb()
    passed = 1
    failed = 0
}
