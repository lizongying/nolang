; assert — 測試斷言庫
;
; 提供常用的斷言函數，用於測試 .no 檔案。
; 每個斷言返回 ok bool（true=通過, false=失敗）。
;
; 用法：
;   # github.com/lizongying/nolang/test/assert
;   ok = assert.eq(a, b, 'msg')
;   ok == false -> return 1

; ═══════════════════════════════════════════════
; 泛型斷言
; ═══════════════════════════════════════════════

; eq: a == b
eq = (a t, b t, msg str) (ok bool) {
    ok = true
    a != b -> {
        ok = false
        print('FAIL: eq')
        print(msg)
    }
}

; ne: a != b
ne = (a t, b t, msg str) (ok bool) {
    ok = true
    a == b -> {
        ok = false
        print('FAIL: ne')
        print(msg)
    }
}

; true: val == true
true = (val bool, msg str) (ok bool) {
    ok = true
    val == false -> {
        ok = false
        print('FAIL: true')
        print(msg)
    }
}

; false: val == false
false = (val bool, msg str) (ok bool) {
    ok = true
    val == true -> {
        ok = false
        print('FAIL: false')
        print(msg)
    }
}

; gt: a > b
gt = (a t, b t, msg str) (ok bool) {
    ok = true
    a <= b -> {
        ok = false
        print('FAIL: gt')
        print(msg)
    }
}

; ge: a >= b
ge = (a t, b t, msg str) (ok bool) {
    ok = true
    a < b -> {
        ok = false
        print('FAIL: ge')
        print(msg)
    }
}

; lt: a < b
lt = (a t, b t, msg str) (ok bool) {
    ok = true
    a >= b -> {
        ok = false
        print('FAIL: lt')
        print(msg)
    }
}

; le: a <= b
le = (a t, b t, msg str) (ok bool) {
    ok = true
    a > b -> {
        ok = false
        print('FAIL: le')
        print(msg)
    }
}

; ═══════════════════════════════════════════════
; 浮點斷言
; ═══════════════════════════════════════════════

; f64-eq: |a - b| < eps
f64-eq = (a f64, b f64, eps f64, msg str) (ok bool) {
    ok = true
    diff = a - b
    diff < 0.0 -> diff = 0.0 - diff
    diff >= eps -> {
        ok = false
        print('FAIL: f64-eq')
        print(msg)
    }
}

; f64-ne: 浮點不相等
f64-ne = (a f64, b f64, eps f64, msg str) (ok bool) {
    ok = true
    diff = a - b
    diff < 0.0 -> diff = 0.0 - diff
    diff < eps -> {
        ok = false
        print('FAIL: f64-ne')
        print(msg)
    }
}

; ═══════════════════════════════════════════════
; 字串斷言
; ═══════════════════════════════════════════════

; str-eq: 字串相等（比較前 n 個字節）
str-eq = (a str, b str, n i64, msg str) (ok bool) {
    ok = true
    a.eq(b, n) == false -> {
        ok = false
        print('FAIL: str-eq')
        print(msg)
    }
}

; str-ne: 字串不相等
str-ne = (a str, b str, n i64, msg str) (ok bool) {
    ok = true
    a.eq(b, n) == true -> {
        ok = false
        print('FAIL: str-ne')
        print(msg)
    }
}

; str-empty: 字串為空（n == 0）
str-empty = (s str, n i64, msg str) (ok bool) {
    ok = true
    n != 0 -> {
        ok = false
        print('FAIL: str-empty')
        print(msg)
    }
}

; str-not-empty: 字串非空
str-not-empty = (s str, n i64, msg str) (ok bool) {
    ok = true
    n == 0 -> {
        ok = false
        print('FAIL: str-not-empty')
        print(msg)
    }
}

; ═══════════════════════════════════════════════
; 指標斷言
; ═══════════════════════════════════════════════

; nil: 指標為空
nil = (p i64, msg str) (ok bool) {
    ok = true
    p != 0 -> {
        ok = false
        print('FAIL: nil')
        print(msg)
    }
}

; not-nil: 指標非空
not-nil = (p i64, msg str) (ok bool) {
    ok = true
    p == 0 -> {
        ok = false
        print('FAIL: not-nil')
        print(msg)
    }
}
