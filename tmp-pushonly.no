// Test: just push words, no compare
words []str = with-cap(256)
word [64]byte
wlen i64 = 0
n i64 = 0
c i64 = 0
tmp-word str = ''
lower i64 = 0
total-words i64 = 0

{
    line str = ''
    ok = false
    line, ok = get-line()
    ok == false -> break
    bs []byte = line.to-bytes()
    j <- [0..bs.len): {
        c = bs[j]
        (c >= 65 && c <= 90) || (c >= 97 && c <= 122) -> {
            lower = c
            c >= 65 && c <= 90 -> lower = c + 32
            wlen < 64 -> {
                word[wlen] = lower
                wlen = wlen + 1
            }
        }
        !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) -> {
            wlen >= 3 -> {
                total-words = total-words + 1
                tmp-word = with-cap(64)
                k <- [0..wlen): {
                    tmp-word[k] = word[k]
                }
                words.push(tmp-word)
                n = n + 1
            }
            wlen = 0
        }
    }
} ()

print('total words: ' + total-words.to-str())
print('pushed: ' + n.to-str())
