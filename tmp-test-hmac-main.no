; 測試: hmac 在 main 函數內
main = () {
    print('start')
    key []byte = with-cap(2)
    key[0] = 1
    key[1] = 2
    msg []byte = with-cap(2)
    msg[0] = 0xAA
    msg[1] = 0xBB
    print('before hmac')
    a [32]byte
    a = hmac.hmac-sha256(key, msg)
    print('after hmac')
    print(a[0])
    print('done')
}
