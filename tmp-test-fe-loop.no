; Test a^992 with explicit squarings (no loop)
main = () {
    ; a = 9
    base [32]byte
    i <- [0..32): {
        base[i] = 0
    }
    base[0] = 9

    a []i64 = with-len(10)
    x25519.fe-frombytes(a, base)

    ; Build up to a^31 (same as before)
    t0 []i64 = with-len(10)
    t1 []i64 = with-len(10)
    t2 []i64 = with-len(10)

    x25519.fe-sq(t0, a)        ; a^2
    x25519.fe-sq(t1, t0)       ; a^4
    x25519.fe-sq(t1, t1)       ; a^8
    x25519.fe-mul(t1, a, t1)   ; a^9
    x25519.fe-mul(t0, t0, t1)  ; a^11
    x25519.fe-sq(t2, t0)       ; a^22
    x25519.fe-mul(t1, t1, t2)  ; a^31

    ; Now test a^992 two ways:
    ; Way 1: Using loop (5 squarings)
    t2-loop []i64 = with-len(10)
    x25519.fe-copy(t2-loop, t1)
    x25519.fe-sq(t2-loop, t2-loop)
    j <- [0..4): {
        x25519.fe-sq(t2-loop, t2-loop)
    }

    t2-loop-bytes [32]byte
    i <- [0..32): {
        t2-loop-bytes[i] = 0
    }
    x25519.fe-tobytes(t2-loop-bytes, t2-loop)
    print('=== a^992 via loop (expect 155, 79, 49, ...) ===')
    i <- [0..8): {
        print(t2-loop-bytes[i] & 255)
    }

    ; Way 2: Explicit squarings (no loop)
    t2-explicit []i64 = with-len(10)
    x25519.fe-copy(t2-explicit, t1)
    x25519.fe-sq(t2-explicit, t2-explicit)   ; 1
    x25519.fe-sq(t2-explicit, t2-explicit)   ; 2
    x25519.fe-sq(t2-explicit, t2-explicit)   ; 3
    x25519.fe-sq(t2-explicit, t2-explicit)   ; 4
    x25519.fe-sq(t2-explicit, t2-explicit)   ; 5

    t2-explicit-bytes [32]byte
    i <- [0..32): {
        t2-explicit-bytes[i] = 0
    }
    x25519.fe-tobytes(t2-explicit-bytes, t2-explicit)
    print('=== a^992 via explicit (expect 155, 79, 49, ...) ===')
    i <- [0..8): {
        print(t2-explicit-bytes[i] & 255)
    }

    ; Way 3: Loop with different variable name
    t2-loop2 []i64 = with-len(10)
    x25519.fe-copy(t2-loop2, t1)
    x25519.fe-sq(t2-loop2, t2-loop2)
    k <- [0..4): {
        x25519.fe-sq(t2-loop2, t2-loop2)
    }

    t2-loop2-bytes [32]byte
    i <- [0..32): {
        t2-loop2-bytes[i] = 0
    }
    x25519.fe-tobytes(t2-loop2-bytes, t2-loop2)
    print('=== a^992 via loop2 (expect 155, 79, 49, ...) ===')
    i <- [0..8): {
        print(t2-loop2-bytes[i] & 255)
    }
}
