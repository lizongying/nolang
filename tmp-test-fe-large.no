; Test fe-mul with multi-limb values
main = () {
    ; Test: load 2^26, check round-trip
    ; 2^26 in little-endian bytes: [0,0,0,4,0,...]
    v26 [32]byte
    i <- [0..32): {
        v26[i] = 0
    }
    v26[3] = 4

    a []i64 = with-len(10)
    x25519.fe-frombytes(a, v26)
    print('2^26 limbs (expect: 0, 1, 0, ...):')
    i <- [0..10): {
        print(a[i])
    }

    ; Round-trip
    out [32]byte
    x25519.fe-tobytes(out, a)
    print('2^26 round-trip bytes (expect: 0,0,0,4,0,...):')
    i <- [0..8): {
        print(out[i] & 255)
    }

    ; Square: (2^26)^2 = 2^52
    ; 2^52 in little-endian: byte 6 = 16, rest 0
    r []i64 = with-len(10)
    x25519.fe-sq(r, a)
    x25519.fe-tobytes(out, r)
    print('2^52 bytes (expect: 0,0,0,0,0,0,16,0):')
    i <- [0..8): {
        print(out[i] & 255)
    }

    ; Test: load 2^100, square it -> 2^200
    ; 2^100 in little-endian: byte 12 = 16, rest 0
    v100 [32]byte
    i <- [0..32): {
        v100[i] = 0
    }
    v100[12] = 16

    b []i64 = with-len(10)
    x25519.fe-frombytes(b, v100)
    print('2^100 limbs:')
    i <- [0..10): {
        print(b[i])
    }

    ; (2^100)^2 = 2^200
    ; 2^200 in little-endian: byte 25 = 1, rest 0
    x25519.fe-sq(r, b)
    x25519.fe-tobytes(out, r)
    print('2^200 bytes (expect: 0,...,0,1,0,0,0,0,0,0):')
    i <- [0..32): {
        print(out[i] & 255)
    }

    ; Test: 2^100 * 2^100 = 2^200
    x25519.fe-mul(r, b, b)
    x25519.fe-tobytes(out, r)
    print('2^100 * 2^100 bytes (expect same as 2^200):')
    i <- [0..32): {
        print(out[i] & 255)
    }

    ; Test: load p-1 = 2^255 - 20
    ; p-1 in little-endian: 0xFF*31, 0x7F (last byte has bit 255 cleared)
    ; Actually p = 2^255 - 19, so p-1 = 2^255 - 20
    ; 2^255 - 20 = 2^255 - 16 - 4 = ...
    ; In little-endian bytes: all 0xFF except byte 0 = 0xEC (256-20=236) and byte 31 = 0x7F
    vp [32]byte
    i <- [0..32): {
        vp[i] = 255
    }
    vp[0] = 236  ; 256 - 20 = 236
    vp[31] = 127  ; 0x7F

    c []i64 = with-len(10)
    x25519.fe-frombytes(c, vp)
    print('p-1 limbs:')
    i <- [0..10): {
        print(c[i])
    }

    ; (p-1)^2 mod p = 1 (since p-1 = -1 mod p, and (-1)^2 = 1)
    x25519.fe-sq(r, c)
    x25519.fe-tobytes(out, r)
    print('(p-1)^2 mod p bytes (expect: 1,0,0,...):')
    i <- [0..8): {
        print(out[i] & 255)
    }
    (out[0] & 255) == 1 -> print('PASS: (p-1)^2 = 1')
    (out[0] & 255) != 1 -> print('FAIL: (p-1)^2 != 1')
}
