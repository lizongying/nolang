; entity — Entity 注册表（i64 句柄 + 平行数组池 + observe/emit）
; 对齐 GPUI 的 Entity 概念：状态由框架持有，外部只能通过句柄访问。
; Nolang 无 Arc/defer，MIR 后端不支持 vec-of-struct，故用平行数组（SoA）。
; 池与 dom.no 的做法一致：i64 索引即句柄，索引在注册表生命周期内有效。

; 实体槽的平行数组（每个索引是一个实体）
G-KIND []i64 = with-len(0)
G-I0 []i64 = with-len(0)
G-I1 []i64 = with-len(0)
G-S0 []str = with-len(0)
G-DIRTY []i64 = with-len(0)

; 订阅表的平行数组
G-SUB-TARGET []i64 = with-len(0)
G-SUB-OBSERVER []i64 = with-len(0)
G-SUB-EVENT []i64 = with-len(0)
G-SUB-ACTIVE []i64 = with-len(0)

; 实体种类常量
ENTITY-COUNTER = 1
ENTITY-BUTTON = 2
ENTITY-VIEW = 3

; 事件常量
EVENT-CHANGED = 1
EVENT-CLICK = 2

; 创建一个实体，返回句柄（索引）
entity-new = (kind i64) (h i64) {
    G-KIND.push(kind)
    G-I0.push(0)
    G-I1.push(0)
    G-S0.push('')
    G-DIRTY.push(1)
    h = G-KIND.len() - 1
}

; 句柄是否有效
entity-valid = (h i64) (ok bool) {
    ok = h >= 0 && h < G-KIND.len()
}

; 读取 i0 载荷
entity-i0 = (h i64) (v i64) {
    v = 0
    entity-valid(h) -> {
        v = G-I0[h]: {
            ok -> it

            -> 0
        }
    }
}

; 读取 i1 载荷
entity-i1 = (h i64) (v i64) {
    v = 0
    entity-valid(h) -> {
        v = G-I1[h]: {
            ok -> it

            -> 0
        }
    }
}

; 读取 str 载荷
entity-s0 = (h i64) (v str) {
    v = ''
    entity-valid(h) -> {
        v = G-S0[h]: {
            ok -> it

            -> ''
        }
    }
}

; 设置 i0 载荷（不触发通知）
entity-set-i0 = (h i64, v i64) {
    entity-valid(h) -> {
        G-I0[h] = v
        G-DIRTY[h] = 1
    }
}

; 设置 i1 载荷
entity-set-i1 = (h i64, v i64) {
    entity-valid(h) -> {
        G-I1[h] = v
        G-DIRTY[h] = 1
    }
}

; 设置 str 载荷
entity-set-s0 = (h i64, v str) {
    entity-valid(h) -> {
        G-S0[h] = v
        G-DIRTY[h] = 1
    }
}

; 标记实体为脏（需要重新渲染）
entity-notify = (h i64) {
    entity-valid(h) -> {
        G-DIRTY[h] = 1
    }
}

; 实体是否脏（bool 返回值）
entity-is-dirty = (h i64) (dirty bool) {
    dirty = false
    entity-valid(h) -> {
        dirty = G-DIRTY[h] == 1
    }
}

; 清除脏标记
entity-clear-dirty = (h i64) {
    entity-valid(h) -> {
        G-DIRTY[h] = 0
    }
}

; 订阅：observer 关注 target 的 event 事件
entity-observe = (target i64, observer i64, event i64) {
    G-SUB-TARGET.push(target)
    G-SUB-OBSERVER.push(observer)
    G-SUB-EVENT.push(event)
    G-SUB-ACTIVE.push(1)
}

; 发出事件：遍历订阅表，把事件写到观察者的 i0 载荷（回调的 Nolang 简化）
; 返回被通知的观察者数量
entity-emit = (target i64, event i64) (n i64) {
    n = 0
    i <- [0..G-SUB-TARGET.len()): {
        (G-SUB-ACTIVE[i] == 1 && G-SUB-TARGET[i] == target && G-SUB-EVENT[i] == event) -> {
            entity-set-i0(G-SUB-OBSERVER[i], event)
            n = n + 1: {
                ok -> it

                -> n
            }
        }
    }
}
