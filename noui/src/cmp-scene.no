; ============================================================================
; noui 组件渲染层（阶段 8）—— 组件树 → 布局 → Scene 指令 → 命中测试
;
; 命令式写法：大写全局 SoA 池 + 函数封装 + 定点 i64 坐标（值 = 像素 * 100）。
; 只调用 components.no 的公开 API（cmp-*），不直接写它的池；
; 布局结果与 Scene 指令放在本模块自有池里。
;
; 对外 API：
;   cs-clear()                 清空 Scene 指令池
;   cs-layout(root,x,y,w,h)   自顶向下递归布局（同时写 CMP bounds）
;   cs-paint(root)             把组件树摊平成 Scene 指令
;   cs-hit(px,py)             命中测试，返回最深层组件句柄（-1 无）
;   cs-measure(h)             测算组件 intrinsic 尺寸
;   cs-scene-count()           Scene 指令条数
;   cs-scene-kind/x/y/w/h/c/t  Scene 指令只读 getter
;
; 设计约束（实测）：
;   - `+` / `-` 产生 ?i64（溢出检查），一律走 cs-add / cs-sub / cs-inc 解包；
;   - 全局数组下标读是 ?i64，走 match 解包（见 cs-rect / cs-scene-*）；
;   - guard 用 `(cond) -> { }`；短路分支组用 `{ cond -> {} ... -> {} }`。
; ============================================================================
# /noui/src/components

; ---------- 布局常量（定点：值 = 像素 * 100）----------
CS-PAD = 1200          ; 容器内边距 12.0
CS-GAP = 800           ; 兄弟间距 8.0
CS-CHAR-W = 800        ; 每字符宽 8.0
CS-LINE-H = 2400       ; 单行高 24.0
CS-BTN-W = 9600        ; 按钮最小宽 96.0
CS-BTN-H = 4000        ; 控件高 40.0
CS-SMALL = 3200        ; 小方块 32.0
CS-SEP-H = 100         ; 分隔线粗 1.0
CS-MIN-LEAF-W = 6400   ; 叶子最小宽 64.0
CS-PROGRESS-H = 800    ; 进度条高 8.0

; ---------- 布局结果池（按组件句柄索引）----------
CS-LX []i64 = with-len(0)
CS-LY []i64 = with-len(0)
CS-LW []i64 = with-len(0)
CS-LH []i64 = with-len(0)

; ---------- Scene 指令池 ----------
CS-KIND []i64 = with-len(0)     ; 1=rect 2=text 3=fill
CS-SX []i64 = with-len(0)
CS-SY []i64 = with-len(0)
CS-SW []i64 = with-len(0)
CS-SH []i64 = with-len(0)
CS-SC []i64 = with-len(0)       ; 颜色 0xRRGGBBAA
CS-ST []str = with-len(0)       ; 文本
; 阶段23：每条指令的裁剪（滚动视口）。CF=0 表示不裁剪；否则 CX/CY/CW/CH 是定点矩形。
CS-CF []i64 = with-len(0)
CS-CX []i64 = with-len(0)
CS-CY []i64 = with-len(0)
CS-CW []i64 = with-len(0)
CS-CH []i64 = with-len(0)
; 「当前裁剪」：cs-paint 递归时设置，emit 时记录进上面五个数组（嵌套靠调用方存/取）
CS-CLIP []i64 = with-len(5)     ; [0]=on [1]=x [2]=y [3]=w [4]=h
CS-CLIP[0] = 0
CS-CLIP[1] = 0
CS-CLIP[2] = 0
CS-CLIP[3] = 0
CS-CLIP[4] = 0

CS-RECT = 1
CS-TEXT = 2
CS-FILL = 3

CS-HOVER = 0x5AA0F2FF
CS-WHITE = 0xFFFFFFFF
CS-FIELD = 0x1E1E28FF
CS-TRACK = 0x3A3A4AFF
CS-GREEN = 0x50C878FF
CS-GREY = 0x9AA0B4FF
CS-TIP = 0x2A2A38FF        ; tooltip / 浮层底色
CS-THUMB-SZ = 1600         ; slider 拇指边长 16.0

; ---- 主题色板（声明式样式的落点）----
; 默认值逐一复刻上面的 CS-* 常量，所以「不写主题」时渲染逐位不变。
; 槽位语义：BG 窗口底 / FG 默认前景 / ACCENT hover·焦点·选中 / FIELD 输入底色 /
; TRACK 轨道·骨架 / MUTED 次要文本 / TIP 浮层底 / OK 勾选 / DANGER 破坏性变体。
CS-TH []i64 = with-len(9)
CS-TH-INIT []i64 = [0]     ; 0 = 还没填默认值（见 cs-theme-init）
CS-TH-BG = 0
CS-TH-FG = 1
CS-TH-ACCENT = 2
CS-TH-FIELD = 3
CS-TH-TRACK = 4
CS-TH-MUTED = 5
CS-TH-TIP = 6
CS-TH-OK = 7
CS-TH-DANGER = 8

; 默认值延迟填充：被导入模块的「顶层下标写入」不会执行（main 作用域才执行），
; 所以默认值在第一次读 / 写主题时由本函数铺好。
cs-theme-init = () {
    v = CS-TH-INIT[0]: {
        ok -> it

        -> 0
    }
    (v == 0) -> {
        CS-TH[0] = 0x1E1E28FF
        CS-TH[1] = 0xFFFFFFFF
        CS-TH[2] = 0x5AA0F2FF
        CS-TH[3] = 0x1E1E28FF
        CS-TH[4] = 0x3A3A4AFF
        CS-TH[5] = 0x9AA0B4FF
        CS-TH[6] = 0x2A2A38FF
        CS-TH[7] = 0x50C878FF
        CS-TH[8] = 0xE05560FF
        CS-TH-INIT[0] = 1
    }
}

; 主题读 / 写 / 复位（声明式：调色板也是数据）
cs-theme = (slot i64) (c i64) {
    cs-theme-init()
    v = CS-TH[slot]: {
        ok -> it

        -> 0
    }
    c = v
}
cs-theme-set = (slot i64, c i64) {
    cs-theme-init()
    (slot >= 0 && slot < CS-TH.len()) -> { CS-TH[slot] = c }
}
cs-theme-reset = () {
    cs-theme-init()
    CS-TH[0] = 0x1E1E28FF
    CS-TH[1] = 0xFFFFFFFF
    CS-TH[2] = 0x5AA0F2FF
    CS-TH[3] = 0x1E1E28FF
    CS-TH[4] = 0x3A3A4AFF
    CS-TH[5] = 0x9AA0B4FF
    CS-TH[6] = 0x2A2A38FF
    CS-TH[7] = 0x50C878FF
    CS-TH[8] = 0xE05560FF
}

; 变体 -> 主题语义色（0 = 默认，不做映射；1 主色 / 2 次要 / 3 幽灵 / 4 危险）
cs-var-color = (h i64, kind i64) (c i64) {
    c = 0
    v = cmp-var(h)
    (v == 1) -> { c = cs-theme(CS-TH-ACCENT) }
    (v == 2) -> { c = cs-theme(CS-TH-MUTED) }
    (v == 3) -> { c = cs-theme(CS-TH-FG) }
    (v == 4) -> { c = cs-theme(CS-TH-DANGER) }
}

; ============================================================================
; 算术辅助（解包溢出 option）
; ============================================================================
cs-add = (a i64, b i64) (r i64) {
    x = a + b: {
        ok -> it

        -> a
    }
    r = x
}
cs-sub = (a i64, b i64) (r i64) {
    x = a - b: {
        ok -> it

        -> a
    }
    r = x
}
cs-inc = (a i64) (r i64) {
    x = a + 1: {
        ok -> it

        -> a
    }
    r = x
}
cs-div = (a i64, b i64) (r i64) {
    (b == 0) -> {
        r = 0
        return
    }
    x = a / b: {
        ok -> it

        -> 0
    }
    r = x
}
cs-mul = (a i64, b i64) (r i64) {
    x = a * b: {
        ok -> it

        -> 0
    }
    r = x
}

; ============================================================================
; 布局提示（声明式视图层同步进来的 CMP-LAY / CMP-GAP / CMP-PAD）
; 命令式用法：cmp-set-lay(h, L-H | L-GROW) / cmp-set-gap(h, 1600) / cmp-set-pad(h, 2400)
; ============================================================================
cs-gap-of = (h i64) (g i64) {
    g = cmp-gap(h)
    (g <= 0) -> { g = CS-GAP }
}
cs-pad-of = (h i64) (p i64) {
    p = cmp-pad(h)
    (p <= 0) -> { p = CS-PAD }
}
; 横向容器：C-GRID 或带 L-H 提示的容器
cs-is-h = (h i64) (yes i64) {
    yes = 0
    kd = cmp-kind(h)
    (kd == C-GRID) -> { yes = 1 }
    ly = cmp-lay(h)
    b = ly & L-H
    (b != 0) -> { yes = 1 }
}
cs-grow = (h i64) (yes i64) {
    yes = 0
    ly = cmp-lay(h)
    b = ly & L-GROW
    (b != 0) -> { yes = 1 }
}
cs-aend = (h i64) (yes i64) {
    yes = 0
    ly = cmp-lay(h)
    b = ly & L-AE
    (b != 0) -> { yes = 1 }
}
cs-acenter = (h i64) (yes i64) {
    yes = 0
    ly = cmp-lay(h)
    b = ly & L-AC
    (b != 0) -> { yes = 1 }
}

; ============================================================================
; 布局结果读写
; ============================================================================
cs-ensure = (h i64) {
    !! {
        n = CS-LX.len()
        (n > h) -> { ** }
        CS-LX.push(0)
        CS-LY.push(0)
        CS-LW.push(0)
        CS-LH.push(0)
    }
}

cs-rect = (h i64) (x i64, y i64, w i64, ht i64) {
    x = CS-LX[h]: {
        ok -> it

        -> 0
    }
    y = CS-LY[h]: {
        ok -> it

        -> 0
    }
    w = CS-LW[h]: {
        ok -> it

        -> 0
    }
    ht = CS-LH[h]: {
        ok -> it

        -> 0
    }
}

cs-set-layout = (h i64, x i64, y i64, w i64, ht i64) {
    cs-ensure(h)
    CS-LX[h] = x
    CS-LY[h] = y
    CS-LW[h] = w
    CS-LH[h] = ht
    cmp-set-bounds(h, x, y, w, ht)
}

; ============================================================================
; 尺寸测算
; ============================================================================
cs-leaf-size = (kind i64, tlen i64) (w i64, ht i64) {
    w = cs-add(cs-mul(tlen, CS-CHAR-W), cs-mul(CS-PAD, 2))
    ht = CS-LINE-H
    {
        kind == C-BUTTON -> {
            (w < CS-BTN-W) -> { w = CS-BTN-W }
            ht = CS-BTN-H
        }
        kind == C-INPUT -> { ht = CS-BTN-H }
        kind == C-TEXTAREA -> { ht = cs-mul(CS-BTN-H, 2) }
        kind == C-SEARCH -> { ht = CS-BTN-H }
        kind == C-SELECT -> { ht = CS-BTN-H }
        kind == C-COMBOBOX -> { ht = CS-BTN-H }
        kind == C-NUMBER-INPUT -> { ht = CS-BTN-H }
        kind == C-STEPPER -> { ht = CS-BTN-H }
        kind == C-OTP-INPUT -> { ht = CS-BTN-H }
        kind == C-SWITCH -> {
            ht = CS-BTN-H
            w = cs-add(w, 5600)
            (w < CS-BTN-W) -> { w = CS-BTN-W }
        }
        kind == C-SEPARATOR -> { ht = CS-SEP-H }
        kind == C-SPINNER -> {
            w = CS-SMALL
            ht = CS-SMALL
        }
        kind == C-PROGRESS -> { ht = CS-PROGRESS-H }
        kind == C-SLIDER -> { ht = CS-LINE-H }
        kind == C-CHECKBOX -> { w = cs-add(w, 2000) }
        kind == C-RADIO -> { w = cs-add(w, 2000) }
        ; 阶段44：提示族 —— 宽 = 左色条 + level 字形格 + 文本宽（+ 关闭钮）+ 右内边距
        ; 注意：本函数只收 (kind, tlen)，没有句柄 —— 文本宽必须用 tlen，
        ; 不能像别处那样 cmp-text(h)（h 在这里不是参数）。
        kind == C-MESSAGE -> {
            w = cs-add(cs-mul(tlen, CS-CHAR-W), 1200)
            w = cs-add(w, lv-glyph-w())
            w = cs-add(w, lv-bar-w())
            (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
            ht = CS-LINE-H
        }
        ; 阶段44：alert 的关闭钮宽度必须加在最小宽度夹紧**之前**（否则 'hi' 这种
        ; 短文本会先被夹到 6400 再长到 9600，把关闭钮挤出固有宽）。
        ; 整个 C-ALERT 因此**不走 cs-leaf-size**（那里没有句柄 h，读不到
        ; alert-closable），改在 cs-measure 的兜底分支里算。
        kind == C-NOTIFICATION -> {
            w = cs-add(cs-mul(tlen, CS-CHAR-W), 1200)
            w = cs-add(w, lv-glyph-w())
            w = cs-add(w, lv-bar-w())
            (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
            ht = cs-add(CS-LINE-H, lv-progress-h())
        }
        ; 阶段45：会话气泡 —— 宽 = 文本宽 + 左右内边距，高 = 行高 + 上下内边距
        kind == C-BUBBLE -> {
            w = cs-add(cs-mul(tlen, CS-CHAR-W), cs-mul(CS-PAD, 2))
            (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
            ht = cs-add(CS-LINE-H, cs-mul(CS-PAD, 2))
        }
        -> { }
    }
    (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
}

cs-child-count = (h i64) (n i64) {
    n = 0
    i = 0
    !! {
        c = cmp-child(h, i)
        (c < 0) -> { ** }
        n = cs-inc(n)
        i = cs-inc(i)
    }
}

; 视觉容器白名单：只有这些 kind 的子节点参与布局 / 绘制 / 命中递归。
; 复合组件（select / tab / combobox）的选项存在 CHILD-IDX 里，属「数据」而非视觉子节点，
; 由各自的绘制分支单独处理，避免被当成纵向堆叠的子控件。
cs-is-container = (kind i64) (yes i64) {
    yes = 0
    {
        kind == C-ROOT -> { yes = 1 }
        kind == C-GRID -> { yes = 1 }
        kind == C-FORM -> { yes = 1 }
        kind == C-QUESTIONNAIRE -> { yes = 1 }
        kind == C-GROUP-BOX -> { yes = 1 }
        kind == C-COLLAPSIBLE -> { yes = 1 }
        kind == C-DESCRIPTION-LIST -> { yes = 1 }
        kind == C-TOOLBAR -> { yes = 1 }
        kind == C-TITLE-BAR -> { yes = 1 }
        kind == C-STATUS-BAR -> { yes = 1 }
        kind == C-SIDEBAR -> { yes = 1 }
        kind == C-MENU -> { yes = 1 }
        kind == C-BREADCRUMB -> { yes = 1 }
        kind == C-HISTORY -> { yes = 1 }
        kind == C-COMMAND -> { yes = 1 }
        kind == C-LIST -> { yes = 1 }
        kind == C-VIRTUAL-LIST -> { yes = 1 }
        kind == C-SEARCHABLE-LIST -> { yes = 1 }
        kind == C-TREE -> { yes = 1 }
        kind == C-ACCORDION -> { yes = 1 }
        kind == C-CAROUSEL -> { yes = 1 }
        kind == C-TABLE -> { yes = 1 }
        kind == C-SCROLL -> { yes = 1 }
        kind == C-MESSAGE-SCROLLER -> { yes = 1 }
        kind == C-RESIZABLE -> { yes = 1 }
        kind == C-DOCK -> { yes = 1 }
        kind == C-DIALOG -> { yes = 1 }
        kind == C-POPOVER -> { yes = 1 }
        kind == C-HOVER-CARD -> { yes = 1 }
        kind == C-SHEET -> { yes = 1 }
        kind == C-INSPECTOR -> { yes = 1 }
        kind == C-WINDOW-BORDER -> { yes = 1 }
        kind == C-SIZING -> { yes = 1 }
        kind == C-STYLED -> { yes = 1 }
        -> { }
    }
}
; 阶段43：C-PAGINATION 从白名单里拿掉了 —— 它的页码按钮是**数据**不是视觉子节点
; （同 C-SELECT / C-COMBOBOX / C-TAB 一路），画 / 点 / 量都读 VALUE / VALUE2，
; 混进白名单会让「给分页挂真子节点」和「虚拟页码」两套语义打架。

; 叠加层判定：dv-overlay 打在节点上的标记（F-OVERLAY）。
; 叠加层不参与父级的流布局与测量，改为在父矩形内居中；命中时先于其它子节点（模态）。
cs-is-overlay = (h i64) (yes i64) {
    yes = cmp-has(h, F-OVERLAY)
}

; 第 j 个「参与流布局」的子节点（跳过叠加层），越界返回 -1。
; 父级的测量 / 布局循环都走这个视图，叠加层在布局末尾单独居中。
cs-child-flow = (h i64, j i64) (c i64) {
    c = -1
    k = 0
    i = 0
    !! {
        ch = cmp-child(h, i)
        (ch < 0) -> { ** }
        (cmp-has(ch, F-OVERLAY) == 0) -> {
            (k == j) -> {
                c = ch
                **
            }
            k = cs-inc(k)
        }
        i = cs-inc(i)
    }
}

; 按声明式 key 反查活组件句柄（线性扫 CMP-KEY），未找到返回 -1。
; 锚定浮层用它找锚点：视图层只带 key，活池里才有矩形。
cs-find-key = (k i64) (h i64) {
    h = -1
    n = CMP-KIND.len()
    i = 0
    !! {
        (i >= n) -> { ** }
        x = CMP-KEY[i]: {
            ok -> it

            -> -1
        }
        (x == k) -> {
            h = i
            **
        }
        i = cs-inc(i)
    }
}

cs-measure = (h i64) (w i64, ht i64) {
    kind = cmp-kind(h)
    n = cs-child-count(h)
    cont = cs-is-container(kind)
    {
        ((cont == 1) && (n > 0) && (kind == C-DIALOG)) -> {
        ; 标题占顶部一行：内容高度另算
        w = 0
        ht = cs-add(CS-BTN-H, CS-GAP)
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            cw, ch = cs-measure(c)
            (cw > w) -> { w = cw }
            ht = cs-add(ht, cs-add(ch, CS-GAP))
            i = cs-inc(i)
        }
        ht = cs-sub(ht, CS-GAP)
        w = cs-add(w, cs-mul(CS-PAD, 2))
    }
    ((cont == 1) && (n > 0)) -> {
        gap = cs-gap-of(h)
        pad = cs-pad-of(h)
        (cs-is-h(h) == 1) -> {
            ; 横向：宽求和，高取最大
            w = cs-mul(pad, 2)
            ht = 0
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                cw, ch = cs-measure(c)
                w = cs-add(w, cs-add(cw, gap))
                (ch > ht) -> { ht = ch }
                i = cs-inc(i)
            }
            w = cs-sub(w, gap)
            ht = cs-add(ht, cs-mul(pad, 2))
        }
        (cs-is-h(h) == 0) -> {
            ; 纵向：宽取最大，高求和
            w = 0
            ht = cs-mul(pad, 2)
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                cw, ch = cs-measure(c)
                (cw > w) -> { w = cw }
                ht = cs-add(ht, cs-add(ch, gap))
                i = cs-inc(i)
            }
            ht = cs-sub(ht, gap)
            w = cs-add(w, cs-mul(pad, 2))
        }
    }
    ((cont == 0) && (kind == C-TAB) && (n > 0)) -> {
        ; tab 条：标题横向求和
        w = 0
        ht = 0
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            cw, ch = cs-measure(c)
            w = cs-add(w, cw)
            (ch > ht) -> { ht = ch }
            i = cs-inc(i)
        }
    }
    ((cont == 0) && (kind == C-SELECT) && (n > 0)) -> {
        ; 字段宽由 cs-layout 拉伸；面板宽取最宽选项
        w = 0
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            cw, _ = cs-measure(c)
            (cw > w) -> { w = cw }
            i = cs-inc(i)
        }
        w = cs-add(w, cs-mul(CS-PAD, 2))
        ht = CS-BTN-H
    }
    ((cont == 0) && (kind == C-COMBOBOX) && (cmp-has(h, F-OPEN))) -> {
        ; combobox 展开：宽取**匹配项**里最宽的（不是全部选项），高仍是字段高
        mn = combobox-match-count(h)
        w = 0
        i = 0
        !! {
            (i >= mn) -> { ** }
            c = combobox-match(h, i)
            (c >= 0) -> {
                cw, _ = cs-measure(c)
                (cw > w) -> { w = cw }
            }
            i = cs-inc(i)
        }
        w = cs-add(w, cs-mul(CS-PAD, 2))
        (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
        ht = CS-BTN-H
    }
    ; 阶段43：页码是**虚拟叶子**（页码按钮是数据不是视觉子节点），
    ; 宽 = 左右钮 + 「页/总数」标签，高 = 控件高
    (kind == C-PAGINATION) -> {
        bw = pagination-btn-w()
        lb = pagination-label(h)
        lw = cs-add(cs-mul(lb.len(), CS-CHAR-W), cs-mul(CS-PAD, 2))
        w = cs-add(cs-add(bw, lw), bw)
        (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
        ht = CS-BTN-H
    }
    ; 阶段43：星级 —— 宽 = 满分 * 星格宽（星格宽 = 行高），高 = 行高
    (kind == C-RATING) -> {
        m = rating-max(h)
        (m < 0) -> { m = 0 }
        w = cs-mul(m, rating-cell())
        (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
        ht = CS-LINE-H
    }
    ; 阶段43：空态 —— 有描述时两行高，宽取标题 / 描述里更宽的
    (kind == C-EMPTY) -> {
        tt = cmp-text(h)
        d = cmp-text2(h)
        wt = cs-add(cs-mul(tt.len(), CS-CHAR-W), cs-mul(CS-PAD, 2))
        wd = cs-add(cs-mul(d.len(), CS-CHAR-W), cs-mul(CS-PAD, 2))
        w = wt
        (wd > wt) -> { w = wd }
        (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
        (d.len() > 0) -> { ht = cs-mul(CS-LINE-H, 2) }
        (d.len() == 0) -> { ht = CS-LINE-H }
    }
    -> {
        t = cmp-text(h)
        w, ht = cs-leaf-size(kind, t.len())
        ; OTP：宽度 = 槽数 * 格宽 + (槽数-1) * 格距（格宽 = 控件高），
        ; 否则 6 位验证码只有一个 24 宽的「输入框」样子
        (kind == C-OTP-INPUT) -> {
            ht = CS-BTN-H
            n = otp-slots(h)
            w = cs-add(cs-mul(n, ht), cs-mul(cs-sub(n, 1), CS-GAP))
        }
        ; 阶段44：alert 多一个关闭钮（这里才有句柄 h，cs-leaf-size 只收 tlen）。
        ; 整个宽度在这里重算：关闭钮必须加在最小宽度夹紧**之前**，否则 'hi' 这种
        ; 短文本会先被夹到 6400 再长到 9600，把关闭钮挤出固有宽。
        (kind == C-ALERT) -> {
            w = cs-add(cs-mul(t.len(), CS-CHAR-W), 1200)
            w = cs-add(w, lv-glyph-w())
            w = cs-add(w, lv-bar-w())
            (alert-closable(h) == 1) -> {
                w = cs-add(w, 800)
                w = cs-add(w, alert-close-w())
            }
            (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
            ht = CS-LINE-H
        }
        ; 阶段45：语音气泡 —— 宽取「文本宽 / 语言标签宽」里更宽的 + 左右内边距；
        ; 有语言标签时多一行（细分隔线 + 间隙 + 标签行）。同 alert 的理由：
        ; 这里才有句柄 h 可读 speech-lang。
        (kind == C-SPEECH) -> {
            lw = cs-text-w(speech-lang(h))
            w = cs-mul(t.len(), CS-CHAR-W)
            (lw > w) -> { w = lw }
            w = cs-add(w, cs-mul(CS-PAD, 2))
            (w < CS-MIN-LEAF-W) -> { w = CS-MIN-LEAF-W }
            ht = cs-add(CS-LINE-H, cs-mul(CS-PAD, 2))
            (speech-lang(h).len() > 0) -> {
                ht = cs-add(ht, CS-SEP-H)
                ht = cs-add(ht, CS-GAP)
                ht = cs-add(ht, CS-LINE-H)
            }
        }
    }
    }
    ; 固定尺寸覆盖：0 = 自动，非 0 直接采用（容器也认 —— 定宽侧栏 / 定高工具条）
    fw = cmp-sw(h)
    (fw > 0) -> { w = fw }
    fh = cmp-sh(h)
    (fh > 0) -> { ht = fh }
}

; 单个子节点的 intrinsic 尺寸（布局时按需取一个分量）
cs-w-of = (h i64) (w i64) {
    w, _ = cs-measure(h)
}
cs-h-of = (h i64) (ht i64) {
    _, ht = cs-measure(h)
}

; ============================================================================
; 布局：自顶向下递归，容器纵向堆叠（C-GRID / L-H 横向）
; ============================================================================
cs-layout = (h i64, x i64, y i64, w i64, ht i64) {
    ; 固定尺寸优先于父级给出的提议（声明式 dv-size 的落点）
    fw = cmp-sw(h)
    (fw > 0) -> { w = fw }
    fh = cmp-sh(h)
    (fh > 0) -> { ht = fh }
    cs-set-layout(h, x, y, w, ht)
    kind = cmp-kind(h)
    n = cs-child-count(h)
    cont = cs-is-container(kind)
    ; dialog：标题占顶部一行，内容从标题下方起排
    ((cont == 1) && (n > 0) && (kind == C-DIALOG)) -> {
        cx = cs-add(x, CS-PAD)
        cy = cs-add(cs-add(y, CS-BTN-H), CS-GAP)
        cw = cs-sub(w, cs-mul(CS-PAD, 2))
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            _, ch = cs-measure(c)
            cs-layout(c, cx, cy, cw, ch)
            cy = cs-add(cy, cs-add(ch, CS-GAP))
            i = cs-inc(i)
        }
    }
    ; 阶段23：滚动容器 —— 子节点按内容自然排，起点上移 off（CMP-VALUE，声明式
    ; dv-scroll 从状态读出来），视口高就是节点高；off 夹紧到「内容高 - 视口高」。
    ; 注意：夹紧只影响本次布局，**不写回状态** —— 偏移的真源是状态槽。
    ; 阶段24：内容高可以是**声明**的（CMP-SCROLL-CONTENT > 0，虚拟列表）——
    ; 这时子节点只是可见窗口那几行，位置必须由内容坐标（i * 行距）决定，
    ; 不能靠累加实测高；行距 = 首行实测高 + gap。
    ((cont == 1) && (kind == C-SCROLL)) -> {
        pad = cs-pad-of(h)
        gap = cs-gap-of(h)
        cw = cs-sub(w, cs-mul(pad, 2))
        decl = cmp-scroll-content(h)
        ; 第一遍：内容高 —— 声明了就用声明值，否则实测子节点（含 padding，去掉末尾 gap）
        ; 阶段25：n == 0 也要进来 —— 过滤列表的命中数可以是 0，此时内容高就是
        ; 上下 padding（没有子节点可实测）。否则整个分支被跳过，cmp-scroll-max
        ; 留着上一次的旧值，滚轮会按旧上限夹紧。
        total = decl
        (decl <= 0) -> {
            total = cs-mul(pad, 2)
            (n > 0) -> {
                i = 0
                !! {
                    c = cs-child-flow(h, i)
                    (c < 0) -> { ** }
                    _, ch = cs-measure(c)
                    total = cs-add(total, cs-add(ch, gap))
                    i = cs-inc(i)
                }
                total = cs-sub(total, gap)
            }
        }
        maxoff = cs-sub(total, ht)
        (maxoff < 0) -> { maxoff = 0 }
        cmp-set-scroll-max(h, maxoff)
        off = cmp-value(h)
        (off > maxoff) -> { off = maxoff }
        (off < 0) -> { off = 0 }
        cx = cs-add(x, pad)
        ; 第二遍：按夹紧后的 off 排版（子节点不拉伸）
        ; 阶段25：n == 0 时没有子节点要排（cs-child-flow(h,0) 会是 -1），跳过。
        ((decl > 0) && (n > 0)) -> {
            c0 = cs-child-flow(h, 0)
            _, ch0 = cs-measure(c0)
            st = cs-add(ch0, gap)
            rh = cs-sub(st, gap)
            (rh <= 0) -> { rh = ch0 }
            ; 虚拟列表：子节点只是可见窗口那几行，第 j 个儿子的绝对行号是 i0+j，
            ; 所以起点要再往下挪 i0*行距（否则会全被排到窗口顶部）。
            i0 = cmp-scroll-start(h)
            cy = cs-add(cs-sub(cs-add(y, pad), off), cs-mul(i0, st))
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                cs-layout(c, cx, cy, cw, rh)
                cy = cs-add(cy, st)
                i = cs-inc(i)
            }
        }
        (decl <= 0) -> {
            cy = cs-sub(cs-add(y, pad), off)
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                _, ch = cs-measure(c)
                cs-layout(c, cx, cy, cw, ch)
                cy = cs-add(cy, cs-add(ch, gap))
                i = cs-inc(i)
            }
        }
    }
    ; 注意：-> 链不是互斥的 —— 前面的 scroll 分支跑完，这里还会再跑一遍，后跑的赢。
    ; 所以通用分支必须显式排除 C-SCROLL，否则偏移被当成 0 重新排一次（dialog 保持
    ; 原有的「通用分支覆盖」行为，不在本阶段改动）。
    ((cont == 1) && (n > 0) && (kind != C-SCROLL)) -> {
        (cs-is-h(h) == 1) -> {
            ; 横向：主轴 = X。grow 子节点分掉剩余宽，交叉轴（Y）可按提示对齐
            pad = cs-pad-of(h)
            gap = cs-gap-of(h)
            cx = cs-add(x, pad)
            cy = cs-add(y, pad)
            ch = cs-sub(ht, cs-mul(pad, 2))
            fix = 0
            ngrow = 0
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                cw, _ = cs-measure(c)
                (cs-grow(c) == 1) -> { ngrow = cs-inc(ngrow) }
                (cs-grow(c) == 0) -> { fix = cs-add(fix, cs-add(cw, gap)) }
                i = cs-inc(i)
            }
            gw = 0
            (ngrow > 0) -> {
                avail = cs-sub(cs-sub(w, cs-mul(pad, 2)), fix)
                gw = cs-div(avail, ngrow)
            }
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                cw, _ = cs-measure(c)
                (cs-grow(c) == 1) -> { cw = gw }
                ; 默认：保持 intrinsic 高、顶对齐（与提示出现前的行为一致）
                ay = cy
                ah = cs-h-of(c)
                (ah > ch) -> { ah = ch }
                (cs-aend(c) == 1) -> { ay = cs-sub(cs-add(cy, ch), ah) }
                (cs-acenter(c) == 1) -> { ay = cs-add(cy, cs-div(cs-sub(ch, ah), 2)) }
                cs-layout(c, cx, ay, cw, ah)
                cx = cs-add(cx, cs-add(cw, gap))
                i = cs-inc(i)
            }
        }
        (cs-is-h(h) == 0) -> {
            ; 纵向：主轴 = Y。grow 子节点分掉剩余高，交叉轴（X）可按提示对齐
            pad = cs-pad-of(h)
            gap = cs-gap-of(h)
            cx = cs-add(x, pad)
            cy = cs-add(y, pad)
            cw = cs-sub(w, cs-mul(pad, 2))
            fix = 0
            ngrow = 0
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                _, ch = cs-measure(c)
                (cs-grow(c) == 1) -> { ngrow = cs-inc(ngrow) }
                (cs-grow(c) == 0) -> { fix = cs-add(fix, cs-add(ch, gap)) }
                i = cs-inc(i)
            }
            gh = 0
            (ngrow > 0) -> {
                avail = cs-sub(cs-sub(ht, cs-mul(pad, 2)), fix)
                gh = cs-div(avail, ngrow)
            }
            i = 0
            !! {
                c = cs-child-flow(h, i)
                (c < 0) -> { ** }
                _, ch = cs-measure(c)
                (cs-grow(c) == 1) -> { ch = gh }
                ax = cx
                aw = cw
                iw = cs-w-of(c)
                (iw > cw) -> { iw = cw }
                (cs-aend(c) == 1) -> {
                    aw = iw
                    ax = cs-sub(cs-add(cx, cw), aw)
                }
                (cs-acenter(c) == 1) -> {
                    aw = iw
                    ax = cs-add(cx, cs-div(cs-sub(cw, aw), 2))
                }
                cs-layout(c, ax, cy, aw, ch)
                cy = cs-add(cy, cs-add(ch, gap))
                i = cs-inc(i)
            }
        }
        ; 叠加层：不参与上面的流布局。默认在父矩形内居中（模态弹层）；
        ; 挂了锚点（CMP-ANCHOR >= 0）则锚定：放在锚点矩形下方，下方放不下就翻到上方，
        ; 最后夹紧在父矩形内（左右同理）。锚点找不到 -> 保持上面的居中结果。
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            (cmp-has(c, F-OVERLAY)) -> {
                cw, ch = cs-measure(c)
                (cw > w) -> { cw = w }
                (ch > ht) -> { ch = ht }
                ax = cs-add(x, cs-div(cs-sub(w, cw), 2))
                ay = cs-add(y, cs-div(cs-sub(ht, ch), 2))
                ak = cmp-anchor(c)
                (ak >= 0) -> {
                    a = cs-find-key(ak)
                    (a >= 0) -> {
                        arx, ary, aw, ah = cs-rect(a)
                        ax = arx
                        ay = cs-add(ary, cs-add(ah, CS-GAP))
                        ; 下方超出父矩形 -> 翻到锚点上方
                        (cs-add(ay, ch) > cs-add(y, ht)) -> {
                            ay = cs-sub(ary, cs-add(ch, CS-GAP))
                        }
                        ; 夹紧（上下）：先顶到父顶，再底到父底
                        (ay < y) -> { ay = y }
                        (cs-add(ay, ch) > cs-add(y, ht)) -> { ay = cs-sub(cs-add(y, ht), ch) }
                        ; 夹紧（左右）
                        (ax < x) -> { ax = x }
                        (cs-add(ax, cw) > cs-add(x, w)) -> { ax = cs-sub(cs-add(x, w), cw) }
                    }
                }
                cs-layout(c, ax, ay, cw, ch)
            }
            i = cs-inc(i)
        }
    }
    ; tab 条：标题横向排列
    ((cont == 0) && (kind == C-TAB) && (n > 0)) -> {
        cx = x
        cy = y
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            cw, ch = cs-measure(c)
            cs-layout(c, cx, cy, cw, ch)
            cx = cs-add(cx, cw)
            i = cs-inc(i)
        }
    }
    ; select 展开：选项在字段下方纵向排列（收起时不动子节点）
    ((cont == 0) && (kind == C-SELECT) && (n > 0) && (cmp-has(h, F-OPEN))) -> {
        cx = x
        cy = cs-add(cs-add(y, ht), CS-GAP)
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            _, ch = cs-measure(c)
            cs-layout(c, cx, cy, w, ch)
            cy = cs-add(cy, cs-add(ch, CS-GAP))
            i = cs-inc(i)
        }
    }
    ; combobox 展开：只排**匹配**项（查询过滤后的那批），几何与绘制 / 命中同源
    ((cont == 0) && (kind == C-COMBOBOX) && (cmp-has(h, F-OPEN))) -> {
        mn = combobox-match-count(h)
        cx = x
        cy = cs-add(cs-add(y, ht), CS-GAP)
        i = 0
        !! {
            (i >= mn) -> { ** }
            c = combobox-match(h, i)
            (c < 0) -> { ** }
            _, ch = cs-measure(c)
            cs-layout(c, cx, cy, w, ch)
            cy = cs-add(cy, cs-add(ch, CS-GAP))
            i = cs-inc(i)
        }
    }
}

; ============================================================================
; Scene 指令发射
; ============================================================================
cs-emit-rect = (x i64, y i64, w i64, ht i64, color i64) {
    CS-KIND.push(CS-RECT)
    CS-SX.push(x)
    CS-SY.push(y)
    CS-SW.push(w)
    CS-SH.push(ht)
    CS-SC.push(color)
    CS-ST.push('')
    cs-emit-clip()
}

cs-emit-fill = (x i64, y i64, w i64, ht i64, color i64) {
    CS-KIND.push(CS-FILL)
    CS-SX.push(x)
    CS-SY.push(y)
    CS-SW.push(w)
    CS-SH.push(ht)
    CS-SC.push(color)
    CS-ST.push('')
    cs-emit-clip()
}

; 记录当前裁剪（阶段23）：每条指令都带上，绘制侧按需 noui_clip
cs-emit-clip = () {
    CS-CF.push(CS-CLIP[0])
    CS-CX.push(CS-CLIP[1])
    CS-CY.push(CS-CLIP[2])
    CS-CW.push(CS-CLIP[3])
    CS-CH.push(CS-CLIP[4])
}

cs-emit-text = (x i64, y i64, color i64, t str) {
    CS-KIND.push(CS-TEXT)
    CS-SX.push(x)
    CS-SY.push(y)
    CS-SW.push(0)
    CS-SH.push(0)
    CS-SC.push(color)
    CS-ST.push(t)
    cs-emit-clip()
}

cs-text-w = (t str) (w i64) {
    w = cs-mul(t.len(), CS-CHAR-W)
}

; 文本在矩形内水平居中、垂直居中
cs-emit-text-center = (x i64, y i64, w i64, ht i64, t str, color i64) {
    tw = cs-text-w(t)
    tx = cs-add(x, cs-div(cs-sub(w, tw), 2))
    ty = cs-add(y, cs-div(cs-sub(ht, CS-LINE-H), 2))
    cs-emit-text(tx, ty, color, t)
}

; 文本左对齐、垂直居中
cs-emit-text-left = (x i64, y i64, w i64, ht i64, t str, color i64) {
    ty = cs-add(y, cs-div(cs-sub(ht, CS-LINE-H), 2))
    cs-emit-text(x, ty, color, t)
}

; 声明式对齐（CMP-ALIGN）：0 = 按 kind 默认，1 左 / 2 中 / 3 右。
; 默认值复刻现有渲染：button / badge / tag / kbd / marker / avatar 居中，其余左对齐。
cs-align-of = (h i64, kind i64) (al i64) {
    al = cmp-align(h)
    (al == 0) -> {
        al = A-LEFT
        (kind == C-BUTTON) -> { al = A-CENTER }
        (kind == C-BADGE) -> { al = A-CENTER }
        (kind == C-TAG) -> { al = A-CENTER }
        (kind == C-KBD) -> { al = A-CENTER }
        (kind == C-MARKER) -> { al = A-CENTER }
        (kind == C-AVATAR) -> { al = A-CENTER }
    }
}

; 文本起点的 x：声明式对齐后的实际落点（右对齐时用于下划线等跟随物）
cs-text-origin-x = (x i64, w i64, t str, al i64) (tx i64) {
    tx = x
    (al == A-CENTER) -> { tx = cs-add(x, cs-div(cs-sub(w, cs-text-w(t)), 2)) }
    (al == A-RIGHT) -> { tx = cs-sub(cs-add(x, w), cs-text-w(t)) }
}

; 按对齐提示绘制文本（垂直一律居中，与 cs-emit-text-center 一致）
cs-emit-text-align = (x i64, y i64, w i64, ht i64, t str, color i64, al i64) {
    tx = cs-text-origin-x(x, w, t, al)
    ty = cs-add(y, cs-div(cs-sub(ht, CS-LINE-H), 2))
    cs-emit-text(tx, ty, color, t)
}

; 星级（阶段43）：VALUE = 当前星数，VALUE2 = 满分。星格宽 = 行高，
; 填满的星用组件色、没填的用 CS-TH-MUTED。星形用 ASCII `*`（同 select 的 `v` /
; search 的 `x` 一路子：不依赖非 ASCII 字形的字体覆盖）。
cs-paint-rating = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    m = rating-max(h)
    v = rating-value(h)
    cw = rating-cell()
    i = 0
    !! {
        (i >= m) -> { ** }
        cx = cs-add(x, cs-mul(i, cw))
        (i < v) -> {
            cs-emit-text-center(cx, y, cw, ht, '*', color)
        }
        (i >= v) -> {
            cs-emit-text-center(cx, y, cw, ht, '*', cs-theme(CS-TH-MUTED))
        }
        i = cs-inc(i)
    }
}

; 页码（阶段43）：左钮 `<` / 中间「页/总数」/ 右钮 `>`。
; 到顶 / 到底时对应钮画成 CS-TH-MUTED（语义提示，不是禁用 —— 禁用仍走 F-DISABLED）。
cs-paint-pagination = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    bw = pagination-btn-w()
    p = pagination-page(h)
    n = pagination-total(h)
    ac = color
    (p <= 1) -> { ac = cs-theme(CS-TH-MUTED) }
    bc = color
    (p >= n) -> { bc = cs-theme(CS-TH-MUTED) }
    cs-emit-text-center(x, y, bw, ht, '<', ac)
    cs-emit-text-center(cs-sub(cs-add(x, w), bw), y, bw, ht, '>', bc)
    lw = cs-sub(cs-sub(w, bw), bw)
    (lw > 0) -> {
        cs-emit-text-center(cs-add(x, bw), y, lw, ht, pagination-label(h), color)
    }
}

; 空态（阶段43）：标题一行 + 描述一行，各在半个矩形里居中；没有描述就只画标题。
; 描述走 CMP-TEXT2（cmp-empty 只收标题，描述由应用 `cmp-set-text2` 给）。
cs-paint-empty = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    d = cmp-text2(h)
    (d.len() > 0) -> {
        hh = cs-div(ht, 2)
        cs-emit-text-center(x, y, w, hh, t, color)
        cs-emit-text-center(x, cs-add(y, hh), w, hh, d, cs-theme(CS-TH-MUTED))
    }
    (d.len() == 0) -> {
        cs-emit-text-center(x, y, w, ht, t, color)
    }
}

; ============================================================================
; 提示族（阶段44）：message / alert / notification 共用一套 level 视觉
; ============================================================================
; warning 没有主题槽，用琥珀常量（同 dv.no 的 DV-C-NUM 先例：换主题时只有这一档
; 不跟着变，是有意的折中，避免为一行颜色动主题表）
cs-level-warn = () (c i64) { c = 0xf2c14eff }
; level -> 颜色：0 info -> ACCENT、1 success -> OK、2 warning -> 琥珀、
; 3 danger -> DANGER，其它值按 info 画
cs-level-color = (lv i64) (c i64) {
    s = lv-slot(lv)
    (s < 0) -> { c = cs-level-warn() }
    (s >= 0) -> { c = cs-theme(s) }
    c = c
}
; level -> ASCII 字形（同 select 的 `v` / search 的 `x` 一路，
; 不依赖非 ASCII 字形的字体覆盖）
cs-level-glyph = (lv i64) (g str) {
    g = 'i'
    (lv == LV-OK) -> { g = 'v' }
    (lv == LV-WARN) -> { g = '!' }
    (lv == LV-ERR) -> { g = 'x' }
    g = g
}

; message（阶段44）：左色条 + level 字形 + 文本一行
cs-paint-message = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    lc = cs-level-color(msg-level(h))
    bw = lv-bar-w()
    gw = lv-glyph-w()
    cs-emit-fill(x, y, bw, ht, lc)
    cs-emit-text-center(cs-add(x, bw), y, gw, ht, cs-level-glyph(msg-level(h)), lc)
    tw = cs-sub(w, cs-add(bw, gw))
    (tw > 0) -> {
        cs-emit-text-left(cs-add(cs-add(x, bw), gw), y, tw, ht, t, cs-theme(CS-TH-FG))
    }
}

; alert（阶段44）：message + 右端关闭钮（closable 时才画）
cs-paint-alert = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    lc = cs-level-color(msg-level(h))
    bw = lv-bar-w()
    gw = lv-glyph-w()
    cw = 0
    (alert-closable(h) == 1) -> { cw = alert-close-w() }
    cs-emit-fill(x, y, bw, ht, lc)
    cs-emit-text-center(cs-add(x, bw), y, gw, ht, cs-level-glyph(msg-level(h)), lc)
    tw = cs-sub(cs-sub(w, cs-add(bw, gw)), cw)
    (tw > 0) -> {
        cs-emit-text-left(cs-add(cs-add(x, bw), gw), y, tw, ht, t, cs-theme(CS-TH-FG))
    }
    (cw > 0) -> {
        cx = alert-close-x(x, w)
        cs-emit-text-center(cx, y, cw, ht, 'x', cs-theme(CS-TH-MUTED))
    }
}

; notification（阶段44）：message 一行 + 剩余时间条一行。
; 条的长短 = ntf-ratio（VALUE3 / VALUE2），单位任意，渲染只用比值。
cs-paint-notification = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    lc = cs-level-color(msg-level(h))
    bw = lv-bar-w()
    gw = lv-glyph-w()
    ph = lv-progress-h()
    th = cs-sub(ht, ph)
    cs-emit-fill(x, y, bw, ht, lc)
    cs-emit-text-center(cs-add(x, bw), y, gw, th, cs-level-glyph(msg-level(h)), lc)
    tw = cs-sub(w, cs-add(bw, gw))
    (tw > 0) -> {
        cs-emit-text-left(cs-add(cs-add(x, bw), gw), y, tw, th, t, cs-theme(CS-TH-FG))
        cs-emit-rect(cs-add(cs-add(x, bw), gw), cs-add(y, th), tw, ph, cs-theme(CS-TH-TRACK))
        r = ntf-ratio(h)
        (r > 0) -> {
            fw = cs-div(cs-mul(r, tw), 10000)
            cs-emit-fill(cs-add(cs-add(x, bw), gw), cs-add(y, th), fw, ph, lc)
        }
    }
}

; 尾巴方块的左缘：朝 position 那一边（0 左 / 1 右）
cs-bubble-tail-x = (h i64, x i64, w i64) (tx i64) {
    tx = cs-add(x, bb-pad())
    (bubble-pos(h) == 1) -> {
        tx = cs-sub(cs-sub(cs-add(x, w), bb-pad()), bb-tail())
    }
    tx = tx
}

; 阶段45：会话气泡 —— 底色方块 + 内边距里的文本（按 position 左对齐 / 右对齐）
; + 底边上的小尾巴方块。文本用 CS-TH-BG：气泡底色是组件色（默认深蓝），
; 配背景色比配 FG 对比度高。
cs-paint-bubble = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, color)
    p = bb-pad()
    tw = cs-text-w(t)
    tx = cs-add(x, p)
    (bubble-pos(h) == 1) -> { tx = cs-sub(cs-sub(cs-add(x, w), p), tw) }
    ty = cs-add(y, cs-div(cs-sub(ht, CS-LINE-H), 2))
    (tw > 0) -> { cs-emit-text(tx, ty, cs-theme(CS-TH-BG), t) }
    ts = bb-tail()
    txx = cs-bubble-tail-x(h, x, w)
    cs-emit-fill(txx, cs-sub(cs-add(y, ht), cs-div(ts, 2)), ts, ts, color)
}

; 阶段45：语音气泡 —— 文本行 + （有语言标签时）细分隔线 + 标签行。
; 与 bubble 的区别只在「多一条语言标签行」，形状语言保持一致。
cs-paint-speech = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, color)
    p = bb-pad()
    lang = speech-lang(h)
    tw = cs-text-w(t)
    ty = cs-add(y, p)
    (tw > 0) -> { cs-emit-text(cs-add(x, p), ty, cs-theme(CS-TH-BG), t) }
    (lang.len() > 0) -> {
        lh = cs-add(ty, CS-LINE-H)
        iw = cs-sub(cs-sub(w, p), p)
        cs-emit-rect(cs-add(x, p), lh, iw, CS-SEP-H, cs-theme(CS-TH-BG))
        lw = cs-text-w(lang)
        (lw > 0) -> { cs-emit-text(cs-add(x, p), cs-add(cs-add(lh, CS-SEP-H), CS-GAP), cs-theme(CS-TH-BG), lang) }
    }
}

; ============================================================================
; 绘制：组件树 → Scene
; ============================================================================
cs-paint-leaf = (h i64, kind i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    al = cs-align-of(h, kind)
    {
        kind == C-BUTTON -> {
            bc = color
            (cmp-has(h, F-HOVERED)) -> { bc = cs-theme(CS-TH-ACCENT) }
            cs-emit-rect(x, y, w, ht, bc)
            cs-emit-text-align(x, y, w, ht, t, cs-theme(CS-TH-FG), al)
        }
        kind == C-LABEL -> cs-emit-text-align(x, y, w, ht, t, color, al)
        kind == C-TEXT -> cs-emit-text-align(x, y, w, ht, t, color, al)
        kind == C-LINK -> {
            cs-emit-text-align(x, y, w, ht, t, color, al)
            tx = cs-text-origin-x(x, w, t, al)
            cs-emit-rect(tx, cs-sub(cs-add(y, ht), CS-SEP-H), cs-text-w(t), CS-SEP-H, color)
        }
        kind == C-BADGE -> {
            cs-emit-rect(x, y, w, ht, color)
            cs-emit-text-align(x, y, w, ht, t, cs-theme(CS-TH-FG), al)
        }
        kind == C-TAG -> {
            cs-emit-rect(x, y, w, ht, color)
            cs-emit-text-align(x, y, w, ht, t, cs-theme(CS-TH-FG), al)
        }
        kind == C-KBD -> {
            cs-emit-rect(x, y, w, ht, color)
            cs-emit-text-align(x, y, w, ht, t, cs-theme(CS-TH-FG), al)
        }
        kind == C-MARKER -> {
            cs-emit-rect(x, y, w, ht, color)
            cs-emit-text-align(x, y, w, ht, t, cs-theme(CS-TH-FG), al)
        }
        kind == C-AVATAR -> {
            cs-emit-rect(x, y, w, ht, color)
            cs-emit-text-align(x, y, w, ht, t, cs-theme(CS-TH-FG), al)
        }
        kind == C-ICON -> cs-emit-text-align(x, y, w, ht, t, color, al)
        kind == C-SEPARATOR -> cs-emit-rect(x, y, w, ht, color)
        kind == C-PROGRESS -> {
            cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-TRACK))
            m = cmp-value2(h)
            (m > 0) -> {
                fw = cs-div(cs-mul(cmp-value(h), w), m)
                cs-emit-fill(x, y, fw, ht, color)
            }
        }
        kind == C-SLIDER -> {
            cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-TRACK))
            lo = slider-min(h)
            hi = slider-max(h)
            (hi > lo) -> {
                p = cs-sub(cmp-value(h), lo)
                r = cs-sub(hi, lo)
                fw = cs-div(cs-mul(p, w), r)
                cs-emit-fill(x, y, fw, ht, color)
                ; 拇指：细高方块，落在填充末端
                tx = cs-sub(cs-add(x, fw), cs-div(CS-THUMB-SZ, 2))
                ty = cs-sub(y, 400)
                cs-emit-rect(tx, ty, CS-THUMB-SZ, cs-add(ht, 800), cs-theme(CS-TH-FG))
            }
        }
        kind == C-CHECKBOX -> {
            cs-emit-rect(x, y, 2000, 2000, color)
            (cmp-has(h, F-CHECKED)) -> {
                cs-emit-fill(cs-add(x, 400), cs-add(y, 400), 1200, 1200, cs-theme(CS-TH-OK))
            }
            cs-emit-text-left(cs-add(x, 2800), y, w, ht, t, color)
        }
        kind == C-RADIO -> {
            cs-emit-rect(x, y, 2000, 2000, color)
            (cmp-has(h, F-SELECTED)) -> {
                cs-emit-fill(cs-add(x, 400), cs-add(y, 400), 1200, 1200, cs-theme(CS-TH-OK))
            }
            cs-emit-text-left(cs-add(x, 2800), y, w, ht, t, color)
        }
        kind == C-SWITCH -> {
            cs-emit-rect(x, y, 4800, 2400, cs-theme(CS-TH-TRACK))
            (cmp-has(h, F-CHECKED)) -> {
                cs-emit-fill(cs-add(x, 2400), y, 2400, 2400, cs-theme(CS-TH-OK))
            }
            (!cmp-has(h, F-CHECKED)) -> {
                cs-emit-fill(x, y, 2400, 2400, cs-theme(CS-TH-MUTED))
            }
            (t.len() > 0) -> {
                cs-emit-text-left(cs-add(x, 5600), y, w, ht, t, color)
            }
        }
        kind == C-INPUT -> cs-paint-input(h, x, y, w, ht, color, t)
        kind == C-TEXTAREA -> cs-paint-textarea(h, x, y, w, ht, color, t)
        kind == C-SEARCH -> cs-paint-search(h, x, y, w, ht, color, t)
        kind == C-NUMBER-INPUT -> cs-paint-number-input(h, x, y, w, ht, color, t)
        kind == C-OTP-INPUT -> cs-paint-otp(h, x, y, w, ht, color, t)
        kind == C-STEPPER -> cs-paint-stepper(h, x, y, w, ht, color, t)
        kind == C-COMBOBOX -> cs-paint-combobox(h, x, y, w, ht, color, t)
        kind == C-RATING -> cs-paint-rating(h, x, y, w, ht, color, t)
        kind == C-PAGINATION -> cs-paint-pagination(h, x, y, w, ht, color, t)
        kind == C-EMPTY -> cs-paint-empty(h, x, y, w, ht, color, t)
        kind == C-MESSAGE -> cs-paint-message(h, x, y, w, ht, color, t)
        kind == C-ALERT -> cs-paint-alert(h, x, y, w, ht, color, t)
        kind == C-NOTIFICATION -> cs-paint-notification(h, x, y, w, ht, color, t)
        kind == C-BUBBLE -> cs-paint-bubble(h, x, y, w, ht, color, t)
        kind == C-SPEECH -> cs-paint-speech(h, x, y, w, ht, color, t)
        kind == C-SELECT -> cs-paint-select(h, x, y, w, ht, color, t)
        kind == C-TAB -> cs-paint-tab(h, x, y, w, ht)
        kind == C-TOOLTIP -> {
            (cmp-has(h, F-VISIBLE)) -> {
                cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-TIP))
                cs-emit-text-center(x, y, w, ht, t, cs-theme(CS-TH-FG))
            }
        }
        kind == C-SKELETON -> cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-TRACK))
        kind == C-SHIMMER -> {
            cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-TRACK))
            ph = cmp-value(h)
            (ph > 0) -> { cs-emit-fill(x, y, cs-div(w, 2), ht, cs-theme(CS-TH-MUTED)) }
        }
        kind == C-SPINNER -> {
            cs-emit-rect(x, y, w, ht, color)
            ph = cmp-value(h)
            k = cs-div(ph, 2)
            cs-emit-fill(cs-add(x, k), y, cs-sub(cs-div(w, 2), k), CS-SEP-H, cs-theme(CS-TH-FG))
        }
        -> {
            cs-emit-rect(x, y, w, ht, color)
            cs-emit-text-left(x, y, w, ht, t, cs-theme(CS-TH-FG))
        }
    }
}

; 输入类字段：底色 + 焦点描边 + 文本（值优先，空则 placeholder）+ 光标
cs-paint-field = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    (cmp-has(h, F-FOCUSED)) -> {
        cs-emit-rect(x, y, w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(cs-sub(cs-add(x, w), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
    }
    ph = input-placeholder(h)
    (t.len() > 0) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, t, color)
    }
    ((t.len() == 0) && (ph.len() > 0)) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, ph, cs-theme(CS-TH-MUTED))
    }
    (cmp-has(h, F-FOCUSED)) -> {
        cw = cs-text-w(t)
        cx = cs-add(cs-add(x, CS-PAD), cw)
        (cx > cs-sub(cs-add(x, w), CS-PAD)) -> { cx = cs-sub(cs-add(x, w), CS-PAD) }
        cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
    }
}

; 数字输入（阶段40）：字段底 + 焦点描边 + 右对齐数值 + 贴右端光标。
; 值由组件模块的 num-* 维护并同步进 CMP-TEXT，这里只负责画。
cs-paint-number-input = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    (cmp-has(h, F-FOCUSED)) -> {
        cs-emit-rect(x, y, w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(cs-sub(cs-add(x, w), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
    }
    ph = input-placeholder(h)
    (t.len() > 0) -> {
        cs-emit-text-align(x, y, w, ht, t, color, A-RIGHT)
        (cmp-has(h, F-FOCUSED)) -> {
            car = input-caret(h)
            suf = t.slice-bytes(car, t.len-bytes())
            cx = cs-sub(cs-sub(cs-add(x, w), CS-PAD), cs-text-w(suf))
            (cx < cs-add(x, CS-PAD)) -> { cx = cs-add(x, CS-PAD) }
            cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
        }
    }
    ((t.len() == 0) && (ph.len() > 0)) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, ph, cs-theme(CS-TH-MUTED))
    }
    ((t.len() == 0) && (cmp-has(h, F-FOCUSED))) -> {
        cs-emit-fill(cs-add(x, CS-PAD), cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
    }
}

; 步进器（阶段40）：[−] 值 [+]。按钮宽 = ht（控件太窄时对半分），中间画值。
cs-paint-stepper = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    (cmp-has(h, F-FOCUSED)) -> {
        cs-emit-rect(x, y, w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(cs-sub(cs-add(x, w), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
    }
    bw = ht
    (w < cs-mul(bw, 2)) -> { bw = cs-div(w, 2) }
    hy = cs-add(y, cs-div(cs-sub(ht, 200), 2))
    vy = cs-add(y, cs-div(cs-sub(ht, 1200), 2))
    lx = cs-add(x, cs-div(cs-sub(bw, 1200), 2))
    rx = cs-sub(cs-add(x, w), bw)
    rpx = cs-add(rx, cs-div(cs-sub(bw, 1200), 2))
    cs-emit-fill(lx, hy, 1200, 200, cs-theme(CS-TH-FG))
    cs-emit-fill(rpx, hy, 1200, 200, cs-theme(CS-TH-FG))
    cs-emit-fill(cs-add(rpx, 500), vy, 200, 1200, cs-theme(CS-TH-FG))
    mx = cs-add(x, bw)
    mw = cs-sub(cs-sub(w, bw), bw)
    (mw > 0) -> {
        cs-emit-text-center(mx, y, mw, ht, t, color)
    }
}

; 搜索框（阶段40）：字段底 + 焦点描边 + 文本 / placeholder + 光标 + 右端清除钮。
; 清除钮用 ASCII 'x' 字形（与 cs-paint-select 拿 'v' 当箭头是同一路子），
; 不依赖非 ASCII 字形的字体覆盖；仅有文本时才是清除钮。
cs-paint-search = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    (cmp-has(h, F-FOCUSED)) -> {
        cs-emit-rect(x, y, w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(cs-sub(cs-add(x, w), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
    }
    ph = input-placeholder(h)
    tw = cs-sub(w, ht)
    (tw < 0) -> { tw = 0 }
    (t.len() > 0) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, tw, ht, t, color)
        (cmp-has(h, F-FOCUSED)) -> {
            car = input-caret(h)
            cx = cs-add(cs-add(x, CS-PAD), cs-text-w(t.slice-bytes(0, car)))
            (cx > cs-sub(cs-add(x, tw), CS-PAD)) -> { cx = cs-sub(cs-add(x, tw), CS-PAD) }
            cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
        }
    }
    ((t.len() == 0) && (ph.len() > 0)) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, tw, ht, ph, cs-theme(CS-TH-MUTED))
    }
    ((t.len() == 0) && (cmp-has(h, F-FOCUSED))) -> {
        cs-emit-fill(cs-add(x, CS-PAD), cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
    }
    (t.len() > 0) -> {
        gx = cs-sub(cs-add(x, w), ht)
        cs-emit-text-center(gx, y, ht, ht, 'x', cs-theme(CS-TH-MUTED))
    }
}

; OTP 输入（阶段41）：整块字段底 + 每槽一个格子；数字居中。
; 聚焦时活动槽描强调边，空槽再画一条竖光标。槽格几何走组件模块的
; otp-slot-w / otp-slot-x，保证「画的」与「点的」（otp-hit）同源。
cs-paint-otp = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    n = otp-slots(h)
    c = otp-code(h)
    cur = otp-cur(h)
    i = 0
    !! {
        (i >= n) -> { ** }
        sx = otp-slot-x(h, i, x, w, ht)
        sw = otp-slot-w(h, w, ht)
        cs-emit-rect(sx, y, sw, ht, cs-theme(CS-TH-TRACK))
        ch = c.slice-bytes(i, cs-add(i, 1))
        (ch != ' ') -> {
            cs-emit-text-center(sx, y, sw, ht, ch, color)
        }
        (i == cur) -> {
            (cmp-has(h, F-FOCUSED)) -> {
                cs-emit-rect(sx, y, sw, CS-SEP-H, cs-theme(CS-TH-ACCENT))
                cs-emit-rect(sx, cs-sub(cs-add(y, ht), CS-SEP-H), sw, CS-SEP-H, cs-theme(CS-TH-ACCENT))
                cs-emit-rect(sx, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
                cs-emit-rect(cs-sub(cs-add(sx, sw), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
                (ch == ' ') -> {
                    cx = cs-add(sx, cs-div(cs-sub(sw, 200), 2))
                    cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
                }
            }
        }
        i = cs-inc(i)
    }
}

; 输入框（阶段38）：字段底 + 焦点描边 + 值 / placeholder + 光标。
; 光标是**字节**下标（INP-CAR）：纯文本模式按前缀宽定位；语法高亮模式
; （input-syntax-mode != 0）先让组件模块建好 token 段，再逐段上色，
; 光标落在段边界上（和 cmp-editor 的行内光标同构）。
cs-paint-input = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    (cmp-has(h, F-FOCUSED)) -> {
        cs-emit-rect(x, y, w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(cs-sub(cs-add(x, w), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
    }
    ph = input-placeholder(h)
    (t.len() > 0) -> {
        {
            (input-syntax-mode(h) != 0) -> {
                cs-paint-input-lex(h, x, y, w, ht)
            }
            -> {
                cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, t, color)
                (cmp-has(h, F-FOCUSED)) -> {
                    cx = cs-add(cs-add(x, CS-PAD), cs-text-w(t.slice-bytes(0, input-caret(h))))
                    (cx > cs-sub(cs-add(x, w), CS-PAD)) -> { cx = cs-sub(cs-add(x, w), CS-PAD) }
                    cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
                }
            }
        }
    }
    ((t.len() == 0) && (ph.len() > 0)) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, ph, cs-theme(CS-TH-MUTED))
    }
    ; 空值 + 聚焦：没有文本也画光标（保持原字段行为）
    ((t.len() == 0) && (cmp-has(h, F-FOCUSED))) -> {
        cs-emit-fill(cs-add(x, CS-PAD), cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
    }
}

; 高亮模式：段由组件模块的 input-lex-build 建好（模块内 push），这里只读
cs-paint-input-lex = (h i64, x i64, y i64, w i64, ht i64) () {
    n = input-lex-build(h)
    cx = cs-add(x, CS-PAD)
    acc = 0
    j = 0
    car = input-caret(h)
    focused = cmp-has(h, F-FOCUSED)
    !! {
        (j >= n) -> { ** }
        tok = input-lex-seg(h, j)
        c = input-lex-color(h, j)
        tl = tok.len-bytes()
        {
            ((focused) && (car >= acc) && (car <= cs-add(acc, tl))) -> {
                pre = tok.slice-bytes(0, cs-sub(car, acc))
                suf = tok.slice-bytes(cs-sub(car, acc), tl)
                (pre.len() > 0) -> {
                    cs-emit-text-left(cx, y, w, ht, pre, c)
                    cx = cs-add(cx, cs-text-w(pre))
                }
                cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
                (suf.len() > 0) -> {
                    cs-emit-text-left(cx, y, w, ht, suf, c)
                    cx = cs-add(cx, cs-text-w(suf))
                }
            }
            -> {
                (tok.len() > 0) -> {
                    cs-emit-text-left(cx, y, w, ht, tok, c)
                    cx = cs-add(cx, cs-text-w(tok))
                }
            }
        }
        acc = cs-add(acc, tl)
        j = cs-inc(j)
    }
    ; 光标落在所有段之后（空段串 / 正好在末尾）也要画
    ((focused) && (car >= acc)) -> {
        cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
    }
}

; 多行文本域（阶段39）：字段底 + 焦点描边 + 视口内逐行文本 + 行内光标。
; 行几何 / 视口在组件模块（ta-*），这里只负责「画哪几行、画在哪、裁到哪」。
cs-paint-textarea = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    (cmp-has(h, F-FOCUSED)) -> {
        cs-emit-rect(x, y, w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(cs-sub(cs-add(x, w), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
    }
    ph = input-placeholder(h)
    ((t.len() == 0) && (ph.len() > 0)) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), cs-add(y, CS-PAD), w, CS-LINE-H, ph, cs-theme(CS-TH-MUTED))
    }
    ((t.len() == 0) && (cmp-has(h, F-FOCUSED))) -> {
        cs-emit-fill(cs-add(x, CS-PAD), cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
    }
    (t.len() > 0) -> {
        lines = ta-line-count(h)
        cap = cs-div(ht, CS-LINE-H)
        (cap < 1) -> { cap = 1 }
        ta-follow(h, cap)
        off = ta-off(h)
        ocl = CS-CLIP[0]
        ocx = CS-CLIP[1]
        ocy = CS-CLIP[2]
        ocw = CS-CLIP[3]
        och = CS-CLIP[4]
        CS-CLIP[0] = 1
        CS-CLIP[1] = x
        CS-CLIP[2] = y
        CS-CLIP[3] = w
        CS-CLIP[4] = ht
        cl = ta-caret-line(h)
        cc = ta-caret-col(h)
        end = cs-add(off, cap)
        (end > lines) -> { end = lines }
        l = off
        !! {
            (l >= end) -> { ** }
            row = cs-sub(l, off)
            ly = cs-add(y, cs-mul(row, CS-LINE-H))
            s = ta-line-text(h, l)
            cs-emit-text-left(cs-add(x, CS-PAD), ly, w, CS-LINE-H, s, color)
            ((cmp-has(h, F-FOCUSED)) && (l == cl)) -> {
                cx = cs-add(cs-add(x, CS-PAD), cs-text-w(s.slice-bytes(0, cc)))
                (cx > cs-sub(cs-add(x, w), CS-PAD)) -> { cx = cs-sub(cs-add(x, w), CS-PAD) }
                cs-emit-fill(cx, cs-add(ly, 600), 200, cs-sub(CS-LINE-H, 1200), cs-theme(CS-TH-FG))
            }
            l = cs-inc(l)
        }
        CS-CLIP[0] = ocl
        CS-CLIP[1] = ocx
        CS-CLIP[2] = ocy
        CS-CLIP[3] = ocw
        CS-CLIP[4] = och
    }
}

; 下拉：字段 + 右侧箭头 + 展开时的选项面板
cs-paint-select = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    ph = input-placeholder(h)
    (t.len() > 0) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, t, color)
    }
    ((t.len() == 0) && (ph.len() > 0)) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, ph, cs-theme(CS-TH-MUTED))
    }
    ax = cs-sub(cs-add(x, w), cs-add(CS-PAD, 800))
    ay = cs-add(y, cs-div(cs-sub(ht, 1200), 2))
    cs-emit-text-left(ax, ay, 1600, 1200, 'v', cs-theme(CS-TH-MUTED))
    (cmp-has(h, F-OPEN)) -> {
        n = select-option-count(h)
        sel = select-selected(h)
        i = 0
        !! {
            (i >= n) -> { ** }
            c = select-option(h, i)
            (c < 0) -> { ** }
            ox, oy, ow, oh = cs-rect(c)
            bc = cs-theme(CS-TH-FIELD)
            (sel == i) -> { bc = cs-theme(CS-TH-ACCENT) }
            cs-emit-rect(ox, oy, ow, oh, bc)
            ct = cmp-text(c)
            cs-emit-text-left(cs-add(ox, CS-PAD), oy, ow, oh, ct, cs-theme(CS-TH-FG))
            i = cs-inc(i)
        }
    }
}

; combobox（阶段42）：字段 + 查询文本（光标复用输入框的 INP-CAR）+ 右端箭头，
; 展开时下方只列**匹配**项，高亮项用强调色。槽位 / 匹配表都在组件模块里维护，
; 这里只读。
cs-paint-combobox = (h i64, x i64, y i64, w i64, ht i64, color i64, t str) {
    cs-emit-rect(x, y, w, ht, cs-theme(CS-TH-FIELD))
    (cmp-has(h, F-FOCUSED)) -> {
        cs-emit-rect(x, y, w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(x, y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
        cs-emit-rect(cs-sub(cs-add(x, w), CS-SEP-H), y, CS-SEP-H, ht, cs-theme(CS-TH-ACCENT))
    }
    ph = input-placeholder(h)
    (t.len() > 0) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, t, color)
    }
    ((t.len() == 0) && (ph.len() > 0)) -> {
        cs-emit-text-left(cs-add(x, CS-PAD), y, w, ht, ph, cs-theme(CS-TH-MUTED))
    }
    ; 右端箭头（与 cs-paint-select 同字形 'v'）
    ax = cs-sub(cs-add(x, w), cs-add(CS-PAD, 800))
    ay = cs-add(y, cs-div(cs-sub(ht, 1200), 2))
    cs-emit-text-left(ax, ay, 1600, 1200, 'v', cs-theme(CS-TH-MUTED))
    ; 光标：位置由 input-caret（字节下标）决定，与输入框同一套语义
    (cmp-has(h, F-FOCUSED)) -> {
        car = input-caret(h)
        (car > t.len-bytes()) -> { car = t.len-bytes() }
        pre = t.slice-bytes(0, car)
        cx = cs-add(cs-add(x, CS-PAD), cs-text-w(pre))
        (cx > cs-sub(cs-add(x, w), cs-add(CS-PAD, 2400))) -> {
            cx = cs-sub(cs-add(x, w), cs-add(CS-PAD, 2400))
        }
        cs-emit-fill(cx, cs-add(y, 600), 200, cs-sub(ht, 1200), cs-theme(CS-TH-FG))
    }
    (cmp-has(h, F-OPEN)) -> {
        mn = combobox-match-count(h)
        mcur = combobox-highlight(h)
        i = 0
        !! {
            (i >= mn) -> { ** }
            c = combobox-match(h, i)
            (c < 0) -> { ** }
            ox, oy, ow, oh = cs-rect(c)
            bc = cs-theme(CS-TH-FIELD)
            (i == mcur) -> { bc = cs-theme(CS-TH-ACCENT) }
            cs-emit-rect(ox, oy, ow, oh, bc)
            lab = combobox-match-label(h, i)
            cs-emit-text-left(cs-add(ox, CS-PAD), oy, ow, oh, lab, cs-theme(CS-TH-FG))
            i = cs-inc(i)
        }
    }
}

; tab 条：横向标题，选中项高亮；底部一条分隔线
cs-paint-tab = (h i64, x i64, y i64, w i64, ht i64) {
    n = tab-count(h)
    act = tab-active(h)
    i = 0
    !! {
        (i >= n) -> { ** }
        c = select-option(h, i)
        (c < 0) -> { ** }
        ox, oy, ow, oh = cs-rect(c)
        bc = cs-theme(CS-TH-TRACK)
        (act == i) -> { bc = cs-theme(CS-TH-ACCENT) }
        cs-emit-rect(ox, oy, ow, oh, bc)
        tt = tab-title(h, i)
        cs-emit-text-center(ox, oy, ow, oh, tt, cs-theme(CS-TH-FG))
        i = cs-inc(i)
    }
    cs-emit-rect(x, cs-sub(cs-add(y, ht), CS-SEP-H), w, CS-SEP-H, cs-theme(CS-TH-TRACK))
}

cs-paint = (h i64) {
    x, y, w, ht = cs-rect(h)
    kind = cmp-kind(h)
    color = cmp-color(h)
    (color == 0) -> { color = cs-theme(CS-TH-TRACK) }
    ; 变体覆盖：声明式「主色 / 次要 / 幽灵 / 危险」映射到主题语义色
    vc = cs-var-color(h, kind)
    (vc != 0) -> { color = vc }
    n = cs-child-count(h)
    cont = cs-is-container(kind)
    ; dialog：关闭时整棵不画；开启时画面板 + 标题 + 内容
    (kind == C-DIALOG) -> {
        (cmp-has(h, F-OPEN)) -> {
            cs-emit-rect(x, y, w, ht, color)
            cs-emit-text-left(cs-add(x, CS-PAD), cs-add(y, CS-PAD), w, CS-LINE-H, cmp-text(h), cs-theme(CS-TH-FG))
            cs-emit-rect(x, cs-add(y, CS-BTN-H), w, CS-SEP-H, cs-theme(CS-TH-TRACK))
            i = 0
            !! {
                c = cmp-child(h, i)
                (c < 0) -> { ** }
                cs-paint(c)
                i = cs-inc(i)
            }
        }
    }
    ; 阶段23：滚动容器 —— 先画面板，再把「当前裁剪」设为视口矩形后画子节点，
    ; 画完恢复（嵌套滚动靠这次存/取）。子节点顺序与通用分支一致：先流、后叠加层。
    (kind == C-SCROLL) -> {
        cs-emit-rect(x, y, w, ht, color)
        ocl = CS-CLIP[0]
        ocx = CS-CLIP[1]
        ocy = CS-CLIP[2]
        ocw = CS-CLIP[3]
        och = CS-CLIP[4]
        CS-CLIP[0] = 1
        CS-CLIP[1] = x
        CS-CLIP[2] = y
        CS-CLIP[3] = w
        CS-CLIP[4] = ht
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            (cmp-has(c, F-OVERLAY) == 0) -> { cs-paint(c) }
            i = cs-inc(i)
        }
        i = 0
        !! {
            c = cmp-child(h, i)
            (c < 0) -> { ** }
            (cmp-has(c, F-OVERLAY)) -> { cs-paint(c) }
            i = cs-inc(i)
        }
        CS-CLIP[0] = ocl
        CS-CLIP[1] = ocx
        CS-CLIP[2] = ocy
        CS-CLIP[3] = ocw
        CS-CLIP[4] = och
    }
    (kind != C-DIALOG) -> {
        {
            ((cont == 1) && (n > 0)) -> {
                cs-emit-rect(x, y, w, ht, color)
                ; 先画参与流布局的子节点
                i = 0
                !! {
                    c = cmp-child(h, i)
                    (c < 0) -> { ** }
                    (cmp-has(c, F-OVERLAY) == 0) -> { cs-paint(c) }
                    i = cs-inc(i)
                }
                ; 叠加层最后画 —— 永远盖在最上面
                i = 0
                !! {
                    c = cmp-child(h, i)
                    (c < 0) -> { ** }
                    (cmp-has(c, F-OVERLAY)) -> { cs-paint(c) }
                    i = cs-inc(i)
                }
            }
            -> {
                t = cmp-text(h)
                cs-paint-leaf(h, kind, x, y, w, ht, color, t)
            }
        }
    }
}

; ============================================================================
; 命中测试：后序遍历，返回最深层命中的组件句柄
; ============================================================================
; 命中遍历用的「第 i 个子节点」：combobox 展开时走**匹配表**（查询过滤后的那批），
; 其余情况与布局一致走 CHILD-IDX。收起时 walk=0，匹配表根本不参与。
cs-hit-child = (h i64, i i64) (c i64) {
    c = cmp-child(h, i)
    (cmp-kind(h) == C-COMBOBOX) -> { c = combobox-match(h, i) }
}

cs-hit-inner = (h i64, px i64, py i64) (found i64) {
    found = -1
    kind = cmp-kind(h)
    ; 收起的 select / combobox：选项不可点（避免残留布局被误命中）
    walk = 1
    modal = 0
    (((kind == C-SELECT) || (kind == C-COMBOBOX)) && (!cmp-has(h, F-OPEN))) -> { walk = 0 }
    (walk == 1) -> {
        ; 叠加层先命中。两档语义：
        ;   模态（对话框 / 菜单）：竖起屏障 —— 命中就直接返回；全都没命中则 found=-2，
        ;     向上传播且不再做自身矩形兜底（点不穿）；
        ;   非模态（F-PASS，tooltip / hover-card / 通知）：照常参与命中，但不竖屏障 ——
        ;     没命中就当没事发生，继续找下面的兄弟（点得穿），也不挡父矩形兜底。
        i = 0
        !! {
            c = cs-hit-child(h, i)
            (c < 0) -> { ** }
            (cmp-has(c, F-OVERLAY)) -> {
                (!cmp-has(c, F-PASS)) -> { modal = 1 }
                r = cs-hit(c, px, py)
                (r >= 0) -> {
                    found = r
                    **
                }
                (r == -2) -> {
                    found = -2
                    **
                }
            }
            i = cs-inc(i)
        }
        ; 模态弹层存在但谁都没接住：-2 向上传播
        (found == -1) -> {
            (modal == 1) -> { found = -2 }
        }
        ; 没有模态屏障（或屏障被上面接住了）才轮到流子节点：叠加层没接住的点要能落到
        ; 下面的内容上（非模态浮层的「点得穿」就是靠这条）
        (found == -1) -> {
            (modal == 0) -> {
                i = 0
                !! {
                    c = cs-hit-child(h, i)
                    (c < 0) -> { ** }
                    r = cs-hit(c, px, py)
                    (r >= 0) -> {
                        found = r
                        **
                    }
                    (r == -2) -> {
                        found = -2
                        **
                    }
                    i = cs-inc(i)
                }
            }
        }
    }
    ; 自身矩形兜底（-2 被挡住时不再兜底，否则点空白也算命中父容器）
    (found == -1) -> {
        x, y, w, ht = cs-rect(h)
        (px >= x && px <= cs-add(x, w) && py >= y && py <= cs-add(y, ht)) -> { found = h }
    }
}
; 阶段23：滚动容器的命中包装 —— 视口外的点直接不命中（与裁剪一致）；
; 视口内的点**按原样**走子节点命中：子节点的矩形本来就带 -off 的偏移，
; 坐标空间与 cs-rect 一致（都是全局），不需要再换算一次。
; 嵌套滚动靠递归各自判自己的视口矩形。
cs-hit = (h i64, px i64, py i64) (found i64) {
    found = -1
    (cmp-kind(h) == C-SCROLL) -> {
        x, y, w, ht = cs-rect(h)
        (px >= x && px <= cs-add(x, w) && py >= y && py <= cs-add(y, ht)) -> {
            found = cs-hit-inner(h, px, py)
        }
    }
    (cmp-kind(h) != C-SCROLL) -> { found = cs-hit-inner(h, px, py) }
}

; ============================================================================
; Scene 清理与只读 getter
; ============================================================================
cs-clear = () {
    CS-KIND.clear()
    CS-SX.clear()
    CS-SY.clear()
    CS-SW.clear()
    CS-SH.clear()
    CS-SC.clear()
    CS-ST.clear()
    CS-CF.clear()
    CS-CX.clear()
    CS-CY.clear()
    CS-CW.clear()
    CS-CH.clear()
}

cs-scene-count = () (n i64) {
    n = CS-KIND.len()
}
cs-scene-kind = (i i64) (v i64) {
    x = CS-KIND[i]: {
        ok -> it

        -> 0
    }
    v = x
}
cs-scene-x = (i i64) (v i64) {
    x = CS-SX[i]: {
        ok -> it

        -> 0
    }
    v = x
}
cs-scene-y = (i i64) (v i64) {
