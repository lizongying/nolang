        ok -> it

        -> 0
    }
    v = x
}
cs-scene-w = (i i64) (v i64) {
    x = CS-SW[i]: {
        ok -> it

        -> 0
    }
    v = x
}
cs-scene-h = (i i64) (v i64) {
