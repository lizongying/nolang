        ok -> it

        -> 0
    }
    v = x
}
cs-scene-c = (i i64) (v i64) {
    x = CS-SC[i]: {
        ok -> it

        -> 0
    }
    v = x
}
cs-scene-t = (i i64) (v str) {
    x = CS-ST[i]: {
        ok -> it

        -> ''
    }
    v = x
}
; 阶段23：指令裁剪（CF=0 不裁剪；否则 CX/CY/CW/CH 为定点矩形）
cs-scene-cf = (i i64) (v i64) {
    x = CS-CF[i]: {
        ok -> it

        -> 0
    }
    v = x
}
cs-scene-cx = (i i64) (v i64) {
