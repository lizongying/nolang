; ============================================================================
; noui 声明式视图层（dv = declarative view）
;
; 思想：UI = f(state)。用户每帧用 dv-* 构造器把「当前状态对应的视图」描述成
; 一棵纯数据树（本模块的 SoA 池），再调用 dv-render 把它调和进命令式的
; components.no 组件池。调和按 (key, kind) 匹配：同 key 同 kind 的组件对象
; 跨帧复用（输入框文本 / 焦点不丢），只对变化的部分做 props 更新；
; 新增 / 删除 / 重排都走最小操作。
;
; 与命令式层的边界：dv 不替代 components.no / cmp-scene.no。
;   - 组件对象、布局、绘制、命中仍然是命令式的；
;   - dv 只负责「视图描述 → 组件池」的映射与增量同步；
;   - 事件由应用层用 cs-hit + cmp-key 拿 key，再 dv-dispatch(key) 取视图自带的
;     (act, payload) 分派；要动活组件对象时用 dv-live-by-key(live, key)。
;
; 行为也是数据：dv-act(node, act, payload) 把「点了意味着什么」挂到视图节点上。
;   dv-act 与 dv-node 同生命周期 —— dv-clear() 会清空动作池，所以每帧重建视图
;   时都要重新挂一次（载荷因此可以携带当前状态）。
;
; 重复原语：dv-repeat（同形状 n 份）/ dv-repeat-labels（全量）/
;   dv-repeat-labels-n（前 n 份）。key 从 key0 递增，跨帧稳定 -> 列表长度变化只发差量。
;
; 布局也是数据：dv-lay(node, bits, gap, pad) 把「怎么排」挂到视图节点上，
; 随 props 一起同步进组件（CMP-LAY / CMP-GAP / CMP-PAD），由 cmp-scene 的
;   cs-measure / cs-layout 消费 —— 容器方向、拉伸、交叉轴对齐、间距 / 内边距覆盖。
;   bits 复用 components.no 的 L-H / L-GROW / L-AE / L-AC。
;
; 用法：
;   dv-clear()
;   r = dv-form(1, -1)                 ; key=1，父=-1（顶层）
;   dv-label(2, '名字', r)
;   b = dv-button(3, '确定', r)
;   dv-act(b, DV-A-CLICK, DEMO-CMD-OK)  ; 动作 + 应用层自定义载荷
;   dv-repeat-labels-n(r, 80, ROWS, n) ; 列表：行数由状态决定
;   dv-render(app-root(), r)           ; 调和进活组件树
;   ; 事件侧：hit = cs-hit(root, x, y) -> dv-dispatch(cmp-key(hit))
;
; 命名约束：模块级数据一律大写；计数器走数组槽，规避标量全局写回缺陷。
; ============================================================================
# /noui/src/components
# /noui/src/cmp-scene

; ---------- 视图节点 SoA 池 ----------
DV-KIND []i64 = with-len(0)
DV-KEY []i64 = with-len(0)
DV-TEXT []str = with-len(0)
DV-TEXT2 []str = with-len(0)
DV-COLOR []i64 = with-len(0)
DV-VALUE []i64 = with-len(0)
DV-VALUE2 []i64 = with-len(0)
DV-FLAGS []i64 = with-len(0)
DV-PARENT []i64 = with-len(0)
; 声明式行为：DV-ACT[view 节点] = 动作 id（0 = 无），DV-ACT2 = 载荷
; 视图因此不只描述「长什么样」，也描述「点了意味着什么」；
; 应用层只需按 (act, payload) 分派，不必把 key 硬编码成 if-else 链。
DV-ACT []i64 = with-len(0)
DV-ACT2 []i64 = with-len(0)

; 布局提示：让「怎么排」也变成数据。bits 复用 components.no 的 L-* 位
; （L-H 横向 / L-GROW 吃掉主轴剩余 / L-AE 交叉轴末端 / L-AC 交叉轴居中），
; gap / pad = 0 表示用 cmp-scene 的默认 CS-GAP / CS-PAD。
DV-LAY []i64 = with-len(0)
DV-GAP []i64 = with-len(0)
DV-PAD []i64 = with-len(0)
; 尺寸提示（0 = 自动）+ 文本对齐（0 = 按 kind 默认）
DV-SW []i64 = with-len(0)
DV-SH []i64 = with-len(0)
DV-ALIGN []i64 = with-len(0)
; 变体（0 = 默认；非 0 时由 cmp-scene 的 cs-var-color 映射到主题语义色）
DV-VAR []i64 = with-len(0)
; 锚定浮层：DV-ANCHOR[view 节点] = 锚点视图 key（-1 = 无锚点 -> 父矩形内居中）。
; 调和时同步到活节点的 CMP-ANCHOR，cmp-scene 布局时按 key 反查锚点矩形。
DV-ANCHOR []i64 = with-len(0)
; 阶段24 虚拟列表：DV-SCROLL-CONTENT[view 节点] = 声明内容高（含 padding）。
; 0 = 没声明 -> 布局实测子节点；> 0 -> 布局按声明值算可滚范围，子节点只挂可见窗口。
; 调和时同步到活节点的 CMP-SCROLL-CONTENT。
DV-SCROLL-CONTENT []i64 = with-len(0)
; 阶段24 虚拟列表：DV-SCROLL-START[view 节点] = 首个挂载子的绝对行号。
; 0 = 顺序排（实测模式不变）；> 0 -> 布局把第 j 个儿子排在 (i0+j)*行距 上。
DV-SCROLL-START []i64 = with-len(0)
; hover（声明式）：DV-HOVER[view 节点] = 状态槽 + 1（0 = 未声明）。
; 装配层每帧按「当前命中 key 是否等于本节点 key」把 1/0 写进那个状态槽，
; 于是「鼠标停在谁身上」也进得了 UI = f(state) —— 视图再用 dv-cond 决定
; 是否建一个锚在该节点上的 tooltip / hover-card。
DV-HOVER []i64 = with-len(0)
; 标签页（阶段 19）：DV-TAB-ACT[视图节点] = 当前页下标（-1 = 不是标签条）。
; 声明式层用 dv-on-sel() 表达选中（绘制 / 命中都认），但 C-TAB 组件本身
; 画高亮时读的是自己的 CMP-VALUE，所以调和时按这个池调 tab-select 同步过去。
DV-TAB-ACT []i64 = with-len(0)
; 绑定（受控输入）：DV-BIND[view 节点] = 字符串状态槽 + 1（0 = 未绑定），
; DV-BIND-MAX = 该槽允许的最大字符数（0 = 不限）。装配层每帧做双向同步：
; 组件文本变了 -> 写回状态；状态被（归约器 / reset）改了 -> 推回组件。
DV-BIND []i64 = with-len(0)
DV-BIND-MAX []i64 = with-len(0)
; 快捷键：键码 -> (动作, 载荷, 视图 key)。与 dv-act 同生命周期（每帧重挂）。
; 语义：无输入焦点时按键，命中就当作「点了那个节点」走同一条归约路径。
; 阶段30 代码编辑器：编辑槽 / 光标 / 着色器与行切分的临时池（声明在前，
; dv-node / dv-clear 要按同一下标 push / truncate）
DV-EDIT []i64 = with-len(0)
DV-EDIT-L []i64 = with-len(0)
DV-EDIT-C []i64 = with-len(0)
DV-RUN-T []str = with-len(0)
DV-RUN-C []i64 = with-len(0)
DV-ED-LINES []str = with-len(0)
DV-ED-KEEP []str = with-len(0)
DV-ED-SEEN []i64 = with-len(0)

DV-HOT-KEY []i64 = with-len(0)
DV-HOT-ACT []i64 = with-len(0)
DV-HOT-PAY []i64 = with-len(0)
DV-HOT-VKEY []i64 = with-len(0)

; 命令面板（阶段 32）：与 DV-EDIT-* 同性质 —— 按**面板 key**（不是视图节点）存，
; 所以 dv-clear() 不清（清了等于每帧把面板游标弹回 0）。
;   DV-PAL-KEYS  登记过的面板 key（装配层每帧找「哪个面板开着」）
;   DV-PAL-ROOT  view 节点 -> 面板 key（0 = 不是面板），装配层顺父链上溯用
;   DV-PAL-OPEN  面板 key -> 开关状态槽
;   DV-PAL-Q     面板 key -> 查询字符串槽
;   DV-PAL-CMD   面板 key -> 命令码状态槽
;   DV-PAL-CUR   面板 key -> 游标行（-1 = 没有命中行）
;   DV-PAL-M     面板 key -> 命中行数
;   DV-PAL-WAS   面板 key -> 上一帧的开关值（翻转 = 刚打开/刚关上 -> 重置游标与滚动）
;   DV-PAL-KEY0  面板 key -> 行 key 基数
DV-PAL-KEYS []i64 = with-len(0)
DV-PAL-ROOT []i64 = with-len(0)
DV-PAL-OPEN []i64 = with-len(0)
DV-PAL-Q []i64 = with-len(0)
DV-PAL-CMD []i64 = with-len(0)
DV-PAL-CUR []i64 = with-len(0)
DV-PAL-M []i64 = with-len(0)
DV-PAL-WAS []i64 = with-len(0)
DV-PAL-KEY0 []i64 = with-len(0)
; 命中表（源行号）的**扁平只增副本**：DV-PAL-SB[面板 key] = 该面板在 DV-PAL-SRC
; 里的基址。游标移动不重建视图，dv-pal-cur-key 靠它即时算出「游标 -> 行 key」。
DV-PAL-SB []i64 = with-len(0)
DV-PAL-SRC []i64 = with-len(0)

; 空的 flags 平行数组：给「不关心每项 flags」的原语当默认值用（阶段 20）。
; 与 DV-EMPTY-F 同语义的空数组只能有一个实例，否则每次传参都白占一个池对象。
DV-EMPTY-F []i64 = with-len(0)

; 动作 id（应用层自定义语义，这里只约定常用几个）
DV-A-CLICK = 1   ; 点击
DV-A-CHANGE = 2  ; 值变化（滑杆 / 输入）
DV-A-SUBMIT = 3  ; 提交
DV-A-OPEN = 4    ; 展开
DV-A-CLOSE = 5   ; 收起
; 状态归约类动作（配合 dv-apply）：payload = 状态池下标，value / value2 = 操作数
DV-A-SET = 6     ; S[payload] = value
DV-A-TOGGLE = 7  ; S[payload] = 1 - S[payload]
DV-A-DELTA = 8   ; S[payload] = clamp(S[payload] + value, 0, value2)
DV-A-ITEM = 9    ; 列表项被点（dv-repeat-items 的载荷 = 行号，语义由应用层定）
; 选中并收起：S[payload] = value（选中下标），S[value2] = 0（展开槽）。
; 一个动作要写两个槽（select 选中 + 关下拉），单槽的 SET 表达不了，所以单独开一个码。
DV-A-CHOOSE = 10
; 区间填充：把 S[payload .. payload+value2) 全写成 value。树的「全部展开 / 全部收起」
; 只是一个动作 —— 不需要应用层写循环，也不需要为树单独开一个动作码。
DV-A-FILL = 11
; 执行命令并收起面板（阶段32）：S[payload] = value（命令码），S[value2] = 0（开关槽）。
; 形状和 CHOOSE 一样是「一个动作写两个槽」，语义不同 —— CHOOSE 是「选中 + 关下拉」，
; RUN 是「执行 + 关面板」，命令码本身由应用层解释（比如把它当子视图号写进另一个槽）。
DV-A-RUN = 12
; 阶段84：拖放完成。dv-app 走同一条 dv-app-click 出口，载荷槽 = 落点 key；
; 被拖的文件 / 文本用 app-drop() 取（读完即空）。
DV-A-DROP = 13

; 调和状态：DV-MATCH[view 节点] = 活组件句柄（-1 = 未匹配）
;           DV-USED[活句柄] = 帧号（帧号不同即视为未认领）
DV-MATCH []i64 = with-len(0)
DV-USED []i64 = with-len(0)
; 帧计数从 1 起：0 留给「从未标记过 / 没有通知」当哨兵（dv-is-used 比的就是它）。
DV-FRAME []i64 = with-len(1)
DV-FRAME[0] = 1

; 视图 flags 位（描述期望状态，映射到 CMP 的 F-* 位）
; 注意这是 dv 自己的紧凑编码，与 CMP 的 F-* 数值不同；组合用字面量或函数内位或，
; 不要写「顶层变量 = 位或表达式」（main 作用域有编译器缺陷，见 ARCHITECTURE §5.4）。
DV-F-VIS = 1    ; 可见
DV-F-EN = 2     ; 可用（清除时置 DISABLED）
DV-F-CHK = 4    ; 勾选（checkbox / switch / radio）
DV-F-SEL = 8    ; 选中（tab / menu / list 项）
DV-F-ACT = 16   ; 激活（当前页 / 当前项）
DV-F-OPEN = 32  ; 展开（折叠面板 / 下拉 / 弹层）
DV-F-OVL = 64   ; 叠加层（不参与父级流布局，改为在父矩形内居中 / 锚定）
DV-F-PASS = 128 ; 非模态叠加层（tooltip / hover-card / 通知）：仍最后画、仍可命中，
                 ; 但没命中时不设模态屏障，点得穿到下面的内容

; ============================================================================
; 算术 / 数组辅助
; ============================================================================
dv-inc = (a i64) (r i64) {
    x = a + 1: {
        ok -> it

        -> a
    }
    r = x
}
dv-add = (a i64, b i64) (r i64) {
    x = a + b: {
        ok -> it

        -> a
    }
    r = x
}
; 注意：填充值必须是 -1（「未匹配」哨兵），不能是 0 —— 否则被推出来的空槽
; 会被 dv-arr-getm 读成「匹配到句柄 0」。
dv-ensure = (a []i64, n i64) () {
    !! {
        (a.len() >= n) -> { ** }
        a.push(-1)
    }
}
dv-arr-set = (a []i64, i i64, v i64) () {
    ni = dv-inc(i)
    dv-ensure(a, ni)
    a[i]: {
        ok -> it = v
        -> _
    }
}
dv-arr-get = (a []i64, i i64) (v i64) {
    v = 0
    (i >= 0) -> {
        (i < a.len()) -> {
            x = a[i]: {
                ok -> it

                -> 0
            }
            v = x
        }
    }
}
; 默认 -1 的读法：专供 DV-MATCH（「未匹配」必须与「句柄 0」区分开）
dv-arr-getm = (a []i64, i i64) (v i64) {
    v = -1
    (i >= 0) -> {
        (i < a.len()) -> {
            x = a[i]: {
                ok -> it

                -> -1
            }
            v = x
        }
    }
}
dv-arr-get-s = (a []str, i i64) (v str) {
    v = ''
    (i >= 0) -> {
        (i < a.len()) -> {
            x = a[i]: {
                ok -> it

                -> ''
            }
            v = x
        }
    }
}

; ============================================================================
; 视图节点读写
; ============================================================================
dv-kind = (v i64) (k i64) {
    k = dv-arr-get(DV-KIND, v)
}
dv-key = (v i64) (k i64) {
    k = dv-arr-get(DV-KEY, v)
}
dv-text = (v i64) (s str) {
    s = dv-arr-get-s(DV-TEXT, v)
}
dv-text2 = (v i64) (s str) {
    s = dv-arr-get-s(DV-TEXT2, v)
}
dv-color = (v i64) (c i64) {
    c = dv-arr-get(DV-COLOR, v)
}
dv-value = (v i64) (x i64) {
    x = dv-arr-get(DV-VALUE, v)
}
dv-value2 = (v i64) (x i64) {
    x = dv-arr-get(DV-VALUE2, v)
}
dv-flags = (v i64) (f i64) {
    f = dv-arr-get(DV-FLAGS, v)
}
dv-parent = (v i64) (p i64) {
    p = dv-arr-get(DV-PARENT, v)
}
dv-lay-of = (v i64) (f i64) {
    f = dv-arr-get(DV-LAY, v)
}
dv-gap-of = (v i64) (g i64) {
    g = dv-arr-get(DV-GAP, v)
}
dv-pad-of = (v i64) (p i64) {
    p = dv-arr-get(DV-PAD, v)
}
dv-sw-of = (v i64) (w i64) {
    w = dv-arr-get(DV-SW, v)
}
dv-sh-of = (v i64) (h i64) {
    h = dv-arr-get(DV-SH, v)
}
dv-align-of = (v i64) (a i64) {
    a = dv-arr-get(DV-ALIGN, v)
}
dv-var-of = (v i64) (a i64) {
    a = dv-arr-get(DV-VAR, v)
}
; 锚点 key：-1 = 无锚点（用 getm，越界 / 未匹配也返回 -1）
dv-anchor-of = (v i64) (k i64) {
    k = dv-arr-getm(DV-ANCHOR, v)
}
; hover 槽位：-1 = 未声明，>= 0 = 状态池下标（装配层每帧写 1/0）
dv-hover-of = (v i64) (s i64) {
    s = dv-arr-get(DV-HOVER, v)
    s = dv-add(s, -1)
}
; 标签条当前页：-1 = 不是标签条
dv-tab-active-of = (v i64) (a i64) {
    a = dv-arr-get(DV-TAB-ACT, v)
}
; 绑定槽位：-1 = 未绑定，>= 0 = 字符串状态池下标
dv-bind-of = (v i64) (s i64) {
    s = dv-arr-get(DV-BIND, v)
    s = dv-add(s, -1)
}
dv-bind-max-of = (v i64) (m i64) {
    m = dv-arr-get(DV-BIND-MAX, v)
}
; 视图节点总数（绑定同步按池下标遍历用）
dv-node-count = () (n i64) {
    n = DV-KIND.len()
}

; ============================================================================
; 建树
; ============================================================================
dv-clear = () () {
    DV-KIND.truncate(0)
    DV-KEY.truncate(0)
    DV-TEXT.truncate(0)
    DV-TEXT2.truncate(0)
    DV-COLOR.truncate(0)
    DV-VALUE.truncate(0)
    DV-VALUE2.truncate(0)
    DV-FLAGS.truncate(0)
    DV-PARENT.truncate(0)
    DV-ACT.truncate(0)
    DV-ACT2.truncate(0)
    DV-LAY.truncate(0)
    DV-GAP.truncate(0)
    DV-PAD.truncate(0)
    DV-SW.truncate(0)
    DV-SH.truncate(0)
    DV-ALIGN.truncate(0)
    DV-VAR.truncate(0)
    DV-ANCHOR.truncate(0)
    DV-SCROLL-CONTENT.truncate(0)
    DV-SCROLL-START.truncate(0)
    DV-HOVER.truncate(0)
    DV-TAB-ACT.truncate(0)
    DV-BIND.truncate(0)
    DV-BIND-MAX.truncate(0)
    DV-EDIT.truncate(0)
    ; 阶段32 命令面板：DV-PAL-ROOT 是「view 节点 -> 面板 key」的映射，按帧清；
    ; 其余 DV-PAL-* 按**面板 key**存，跨帧存活（清了就等于每帧把游标弹回 0）。
    DV-PAL-ROOT.truncate(0)
    ; 光标池**不按帧清**：它按文本槽存（不是按视图节点），清了就等于每帧把光标
    ; 弹回行首。DV-EDIT 是「节点 -> 编辑槽」的映射，必须按帧清。
    DV-HOT-KEY.truncate(0)
    DV-HOT-ACT.truncate(0)
    DV-HOT-PAY.truncate(0)
    DV-HOT-VKEY.truncate(0)
    DV-MATCH.truncate(0)
}

; 追加一个视图节点，返回节点 id
dv-node = (kind i64, key i64, text str, text2 str, color i64, value i64, value2 i64, flags i64, parent i64) (h i64) {
    h = DV-KIND.len()
    DV-KIND.push(kind)
    DV-KEY.push(key)
    DV-TEXT.push(text)
    DV-TEXT2.push(text2)
    DV-COLOR.push(color)
    DV-VALUE.push(value)
    DV-VALUE2.push(value2)
    DV-FLAGS.push(flags)
    DV-PARENT.push(parent)
    DV-ACT.push(0)
    DV-ACT2.push(0)
    DV-LAY.push(0)
    DV-GAP.push(0)
    DV-PAD.push(0)
    DV-SW.push(0)
    DV-SH.push(0)
    DV-ALIGN.push(0)
    DV-VAR.push(0)
    DV-ANCHOR.push(-1)
    DV-SCROLL-CONTENT.push(0)
    DV-SCROLL-START.push(0)
    DV-HOVER.push(0)
    DV-TAB-ACT.push(-1)
    DV-BIND.push(0)
    DV-BIND-MAX.push(0)
    DV-EDIT.push(0)
    DV-PAL-ROOT.push(0)
}

; 给视图节点挂一个动作（builder 返回节点 id，随后 dv-act 挂行为）
dv-act = (h i64, act i64, payload i64) () {
    (h >= 0) -> {
        dv-arr-set(DV-ACT, h, act)
        dv-arr-set(DV-ACT2, h, payload)
    }
}
dv-act-of = (v i64) (a i64) {
    a = dv-arr-get(DV-ACT, v)
}
dv-act-payload = (v i64) (p i64) {
    p = dv-arr-get(DV-ACT2, v)
}

; 布局提示写入：bits 复用 components.no 的 L-* 位，gap / pad 为 0 表示用默认。
; 与 dv-act 同生命周期（dv-clear 会清空），每帧重建视图时一起重挂。
dv-lay = (h i64, bits i64, gap i64, pad i64) () {
    (h >= 0) -> {
        dv-arr-set(DV-LAY, h, bits)
        dv-arr-set(DV-GAP, h, gap)
        dv-arr-set(DV-PAD, h, pad)
    }
}

; 布局位组合子（函数内位或，数值稳定 —— 顶层位或初始化有编译器缺陷）
dv-lay-h = () (f i64) { f = L-H }
dv-lay-grow = () (f i64) { f = L-GROW }
dv-lay-end = () (f i64) { f = L-AE }
dv-lay-center = () (f i64) { f = L-AC }
dv-lay-h-grow = () (f i64) { f = L-H | L-GROW }
dv-lay-h-end = () (f i64) { f = L-H | L-AE }
dv-lay-grow-end = () (f i64) { f = L-GROW | L-AE }

; 尺寸提示：0 = 自动（走 intrinsic 测算），非 0 覆盖。容器同样生效 ——
; 「定宽侧栏 / 定高工具条」也是纯数据。
dv-size = (h i64, w i64, ht i64) () {
    (h >= 0) -> {
        dv-arr-set(DV-SW, h, w)
        dv-arr-set(DV-SH, h, ht)
    }
}

; 阶段24 虚拟列表：声明滚动容器的内容高（含 padding）。0 = 不声明，布局实测子节点；
; > 0 = 内容高由 n * 行高 + 间隙 + padding 算出来，子节点只挂可见窗口那几行。
dv-scroll-content = (h i64, ch i64) () {
    (h >= 0) -> { dv-arr-set(DV-SCROLL-CONTENT, h, ch) }
}
dv-scroll-content-of = (v i64) (ch i64) {
    ch = dv-arr-get(DV-SCROLL-CONTENT, v)
}
; 阶段24 虚拟列表：首个挂载子的绝对行号（0 = 顺序排）
dv-scroll-start = (h i64, i0 i64) () {
    (h >= 0) -> { dv-arr-set(DV-SCROLL-START, h, i0) }
}
dv-scroll-start-of = (v i64) (i0 i64) {
    i0 = dv-arr-get(DV-SCROLL-START, v)
}

; 文本对齐提示：复用 components.no 的 A-LEFT / A-CENTER / A-RIGHT，0 = 按 kind 默认
dv-align = (h i64, al i64) () {
    (h >= 0) -> { dv-arr-set(DV-ALIGN, h, al) }
}
dv-align-left = () (a i64) { a = A-LEFT }
dv-align-center = () (a i64) { a = A-CENTER }
dv-align-right = () (a i64) { a = A-RIGHT }

; 变体：把「主色 / 次要 / 幽灵 / 危险」写成视图数据，绘制时映射到主题语义色
; （cs-var-color：1 ACCENT / 2 MUTED / 3 FG / 4 DANGER）。0 = 默认，渲染逐位不变。
; 与 dv-act / dv-lay / dv-size 同生命周期：dv-clear() 会清空 DV-VAR，每帧重建视图时重挂。
dv-variant = (h i64, v i64) () {
    (h >= 0) -> { dv-arr-set(DV-VAR, h, v) }
}
dv-var-primary = () (v i64) { v = 1 }
dv-var-secondary = () (v i64) { v = 2 }
dv-var-ghost = () (v i64) { v = 3 }
dv-var-danger = () (v i64) { v = 4 }

; 主题：调色板也是数据。槽位复用 cmp-scene 的 CS-TH-*（BG / FG / ACCENT / FIELD /
; TRACK / MUTED / TIP / OK / DANGER）。主题是全局的，不随 dv-clear() 清空，
; 所以在 dva-run 之前设一次即可。
dv-theme-set = (slot i64, c i64) () {
    cs-theme-set(slot, c)
}
dv-theme-reset = () {
    cs-theme-reset()
}

; ============================================================================
; 受控输入（绑定）与快捷键
; ============================================================================
; 绑定：把输入类节点的文本与「字符串状态池」的一个槽位连起来，双向同步由装配层做
; （dv-app 的 dva-sync-binds，每帧一次）：组件文本变了 -> 写回状态；状态被归约器
; 改了 -> 推回组件。于是「输入框里写了什么」也是状态，视图可以读它、reset 可以清它。
; max = 该槽允许的最大字符数（0 = 不限）。
; 与 dv-act 同生命周期：dv-clear() 会清空 DV-BIND，每帧重建视图时重挂。
dv-bind = (h i64, slot i64, max i64) () {
    (h >= 0) -> {
        dv-arr-set(DV-BIND, h, dv-add(slot, 1))
        dv-arr-set(DV-BIND-MAX, h, max)
    }
}

; 字符串状态池：绑定的归约目标。与主题一样是全局的，不随 dv-clear() 清空
; （dv-clear 只清「视图描述」，状态不是视图的一部分）。
; 数组参数只能 place-match 写，这里直接操作模块全局，读写都走 match 解包。
DV-BIND-T []str = with-len(0)
dv-bound = (slot i64) (s str) {
    s = DV-BIND-T[slot]: {
        ok -> it

        -> ''
    }
}
dv-bound-set = (slot i64, s str) () {
    DV-BIND-T[slot]: {
        ok -> it = s

        -> _
    }
}
dv-bind-t-count = () (n i64) {
    n = DV-BIND-T.len()
}
; 给字符串池补槽（应用声明「我要用 N 个文本槽」）
dv-bind-t-ensure = (n i64) () {
    !! {
        (DV-BIND-T.len() >= n) -> { ** }
        DV-BIND-T.push('')
    }
}
; 把组件文本截到 max（超长返回截断后的串）
dv-bound-cap = (s str, max i64) (r str) {
    r = s
    (max > 0) -> {
        (s.len() > max) -> { r = s.slice(0, max) }
    }
}

; 快捷键：键码 keycode 命中 = 「点了这个节点」，走与点击完全相同的归约路径。
; 语义：只在没有输入焦点时生效（正在敲字时按键不该触发全局动作）。
dv-hotkey = (h i64, keycode i64, act i64, pay i64) () {
    (h >= 0) -> {
        DV-HOT-KEY.push(keycode)
        DV-HOT-ACT.push(act)
        DV-HOT-PAY.push(pay)
        DV-HOT-VKEY.push(dv-key(h))
    }
}
; 命中返回 (act, pay, vkey)；没命中 act = 0
dv-hot-dispatch = (keycode i64) (act i64, pay i64, vkey i64) {
    act = 0
    pay = 0
    vkey = -1
    i = 0
    n = DV-HOT-KEY.len()
    !! {
        (i >= n) -> { ** }
        (act != 0) -> { ** }
        k = DV-HOT-KEY[i]: {
            ok -> it

            -> -1
        }
        (k == keycode) -> {
            a = DV-HOT-ACT[i]: {
                ok -> it

                -> 0
            }
            p = DV-HOT-PAY[i]: {
                ok -> it

                -> 0
            }
            vk = DV-HOT-VKEY[i]: {
                ok -> it

                -> -1
            }
            ; 目标节点被禁用 -> 不触发（阶段 18）。
            ; 注意 DV-HOT-VKEY 存的是**声明式 key**（dva-run 要拿它当动作目标），
            ; 所以先反查视图节点再看 flags —— dv-disabled-of 吃的是视图句柄。
            tv = dv-node-by-key(vk)
            (tv >= 0) -> {
                (dv-disabled-of(tv) == 0) -> {
                    act = a
                    pay = p
                    vkey = vk
                }
            }
            (tv < 0) -> {
                act = a
                pay = p
                vkey = vk
            }
        }
        i = dv-inc(i)
    }
}
dv-hot-count = () (n i64) {
    n = DV-HOT-KEY.len()
}

; 按 key 找视图节点（key 在全树唯一；线性扫描，树很小）
dv-node-by-key = (k i64) (v i64) {
    v = -1
    i = 0
    n = DV-KIND.len()
    !! {
        (i >= n) -> { ** }
        kk = dv-key(i)
        (kk == k) -> {
            v = i
            **
        }
        i = dv-inc(i)
    }
}

; key -> 视图父节点 id / 父节点 kind（-1 = 无）。供应用层做「结构相关的组件侧动作」
; （例：选中下拉项后收起弹层），而不必把 key 硬编码进主循环。
dv-parent-of-key = (k i64) (p i64) {
    v = dv-node-by-key(k)
    p = -1
    (v >= 0) -> { p = dv-parent(v) }
}
dv-parent-kind-of-key = (k i64) (kd i64) {
    p = dv-parent-of-key(k)
    kd = -1
    (p >= 0) -> { kd = dv-kind(p) }
}

; 事件分发：命中句柄 -> key -> 视图动作。返回 (act, payload)，无动作时 (0, 0)
; 事件命中 -> 视图动作的反向查找。禁用的节点**不出动作**（阶段 18）：
; 命中仍然有效（hover / tooltip 该照常工作，禁用原因往往就要靠 tooltip 解释），
; 但点击不该产生任何归约。
dv-dispatch = (k i64) (act i64, payload i64) {
    v = dv-node-by-key(k)
    act = 0
    payload = 0
    (v >= 0) -> {
        (dv-disabled-of(v) == 0) -> {
            act = dv-act-of(v)
            payload = dv-act-payload(v)
        }
    }
}

; ============================================================================
; 状态归约：把「点击」直接表述成对状态池的赋值，主循环不再写 key 链
; ============================================================================
; 语义（act 决定操作，payload 是状态池下标，节点的 value / value2 是操作数）：
;   DV-A-SET    S[payload] = value
;   DV-A-TOGGLE S[payload] = 1 - S[payload]（0/1 翻转）
;   DV-A-DELTA  S[payload] = clamp(S[payload] + value, 0, value2)（value2=0 表示无上限）
; 返回写过的状态槽个数（0 = 这个 key 不归约器管，调用方自行处理）。
; 状态池由应用层给（这里是 []i64），dv 不绑定任何具体状态数组。
dv-clamp = (v i64, lo i64, hi i64) (r i64) {
    r = v
    (v < lo) -> { r = lo }
    (hi > 0) -> {
        (v > hi) -> { r = hi }
    }
}

dv-apply = (S []i64, k i64) (n i64) {
    n = 0
    v = dv-node-by-key(k)
    (v >= 0) -> {
        a = dv-act-of(v)
        pl = dv-act-payload(v)
        val = dv-value(v)
        (a == DV-A-SET) -> {
            S[pl]: {
                ok -> it = val
                -> _
            }
            n = dv-inc(n)
        }
        (a == DV-A-TOGGLE) -> {
            cur = S[pl]: {
                ok -> it
                -> 0
            }
            nv = 0
            (cur == 0) -> { nv = 1 }
            S[pl]: {
                ok -> it = nv
                -> _
            }
            n = dv-inc(n)
        }
        (a == DV-A-DELTA) -> {
            cur = S[pl]: {
                ok -> it
                -> 0
            }
            hi = dv-value2(v)
            nv = dv-clamp(dv-add(cur, val), 0, hi)
            S[pl]: {
                ok -> it = nv
                -> _
            }
            n = dv-inc(n)
        }
        ; 选中并收起（阶段 21）：一次要写两个槽 —— 选中下标 + 清展开槽。
        ; value = 选中下标，value2 = 展开槽（< 0 = 没有展开槽，只写选中）。
        (a == DV-A-CHOOSE) -> {
            S[pl]: {
                ok -> it = val
                -> _
            }
            n = dv-inc(n)
            c2 = dv-value2(v)
            (c2 >= 0) -> {
                S[c2]: {
                    ok -> it = 0
                    -> _
                }
                n = dv-inc(n)
            }
        }
        ; 区间填充（阶段31）：把 S[payload .. payload+value2) 全写成 value。
        ; 树的「全部展开 / 全部收起」只是同一个动作的两个操作数，不需要应用层写循环。
        (a == DV-A-FILL) -> {
            cnt = dv-value2(v)
            (cnt > 0) -> {
                i = 0
                !! {
                    (i >= cnt) -> { ** }
                    S[dv-add(pl, i)]: {
                        ok -> it = val
                        -> _
                    }
                    i = dv-inc(i)
                }
                n = dv-add(n, cnt)
            }
        }
        ; 执行命令并收起面板（阶段32）：S[payload] = value（命令码），S[value2] = 0（开关槽）。
        (a == DV-A-RUN) -> {
            S[pl]: {
                ok -> it = val
                -> _
            }
            n = dv-inc(n)
            c2 = dv-value2(v)
            (c2 >= 0) -> {
                S[c2]: {
                    ok -> it = 0
                    -> _
                }
                n = dv-inc(n)
            }
        }
    }
}

; 可见 + 可用（默认）
dv-on = () (f i64) {
    f = DV-F-VIS | DV-F-EN
}
; 可见 + 可用 + 勾选（checkbox / switch 用）
dv-on-chk = () (f i64) {
    f = DV-F-VIS | DV-F-EN | DV-F-CHK
}

; ============================================================================
; 禁用态（阶段 18）：可见，但不可交互
; ============================================================================
; 「禁用」在声明式里就是 flags 少一个 DV-F-EN —— 视图每帧读状态重建，所以
; 「未勾选同意时提交按钮禁用」这类派生天然成立，不需要额外的状态槽。
; 与 dv-off() 的区别：dv-off 把 flags 清零（连可见一起没了），是「隐藏」；
; dv-disabled 保留 DV-F-VIS，控件还在原地、只是点不动。
; 绘制层早就消费 F-DISABLED（components.no 的按钮 / 开关 / 输入框分支会画成灰色），
; 阶段 18 补的是行为语义：命中 / 焦点 / 快捷键 / 动作派发都要尊重它。
dv-disabled = () (f i64) {
    f = DV-F-VIS
}
; dv-on() 的显式别名（语义对照用）
dv-enabled = () (f i64) {
    f = DV-F-VIS | DV-F-EN
}
; 视图节点当前是否禁用（1 = 禁用）。派发 / 焦点用它在动作生效前拦一道
dv-disabled-of = (v i64) (d i64) {
    d = 0
    (v >= 0) -> {
        ((dv-flags(v) & DV-F-EN) == 0) -> { d = 1 }
    }
}

dv-label = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-LABEL, key, text, '', 0, 0, 0, f, parent)
}
dv-button = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-BUTTON, key, text, '', 0, 0, 0, f, parent)
}
dv-badge = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-BADGE, key, text, '', 0, 0, 0, f, parent)
}
dv-tag = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-TAG, key, text, '', 0, 0, 0, f, parent)
}
dv-link = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-LINK, key, text, '', 0, 0, 0, f, parent)
}
dv-separator = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-SEPARATOR, key, '', '', 0, 0, 0, f, parent)
}
dv-empty = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-EMPTY, key, text, '', 0, 0, 0, f, parent)
}
dv-spinner = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-SPINNER, key, '', '', 0, 0, 0, f, parent)
}
dv-checkbox = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-CHECKBOX, key, text, '', 0, 0, 0, f, parent)
}
dv-switch = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-SWITCH, key, '', '', 0, 0, 0, f, parent)
}
dv-input = (key i64, placeholder str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-INPUT, key, '', placeholder, 0, 0, 0, f, parent)
}
dv-textarea = (key i64, placeholder str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-TEXTAREA, key, '', placeholder, 0, 0, 0, f, parent)
}
dv-select = (key i64, placeholder str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-SELECT, key, '', placeholder, 0, 0, 0, f, parent)
}
dv-slider = (key i64, lo i64, hi i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-SLIDER, key, '', '', 0, lo, hi, f, parent)
}
dv-progress = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-PROGRESS, key, '', '', 0, 0, 0, f, parent)
}
dv-option = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-LABEL, key, text, '', 0, 0, 0, f, parent)
}
dv-tab-item = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-LABEL, key, text, '', 0, 0, 0, f, parent)
}

; ---------- 容器 ----------
dv-root = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-ROOT, key, '', '', 0, 0, 0, f, parent)
}
dv-form = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-FORM, key, '', '', 0, 0, 0, f, parent)
}
; 横向容器（等价 C-GRID 的默认行为；要 L-H 的话用 dv-lay 加在任意容器上）
dv-row = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-GRID, key, '', '', 0, 0, 0, f, parent)
}
; 拉伸容器：纵向堆叠 + 吃掉父容器主轴剩余空间（配合父容器的 L-GROW 使用）
dv-fill = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-FORM, key, '', '', 0, 0, 0, f, parent)
    dv-lay(h, dv-lay-grow(), 0, 0)
}
dv-list = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-LIST, key, '', '', 0, 0, 0, f, parent)
}
dv-group-box = (key i64, title str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-GROUP-BOX, key, title, '', 0, 0, 0, f, parent)
}
dv-grid = (key i64, cols i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-GRID, key, '', '', 0, cols, 0, f, parent)
}
; 滚动容器（阶段23）：偏移的真源是状态槽 offslot —— 视图每帧把 S[offslot] 读出来
; 当组件 value，布局据此把内容上移。step 是滚轮每格步长（放 value2），
; 事件侧拿「最大偏移」（cmp-scroll-max）夹紧后写回同一个槽。
dv-scroll = (S []i64, key i64, offslot i64, step i64, parent i64) (h i64) {
    f = dv-on()
    off = dv-arr-get(S, offslot)
    h = dv-node(C-SCROLL, key, '', '', 0, off, step, f, parent)
    dv-act(h, DV-A-CHANGE, offslot)
}
dv-toolbar = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-TOOLBAR, key, '', '', 0, 0, 0, f, parent)
}
dv-status-bar = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-STATUS-BAR, key, '', '', 0, 0, 0, f, parent)
}
dv-title-bar = (key i64, title str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-TITLE-BAR, key, title, '', 0, 0, 0, f, parent)
}
dv-dialog = (key i64, title str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-DIALOG, key, title, '', 0, 0, 0, f, parent)
}

; 可见 + 可用 + 选中（tab / menu / list 项）
dv-on-sel = () (f i64) {
    f = DV-F-VIS | DV-F-EN | DV-F-SEL
}
; 可见 + 可用 + 激活（当前页 / 当前项）
dv-on-act = () (f i64) {
    f = DV-F-VIS | DV-F-EN | DV-F-ACT
}
; 可见 + 可用 + 展开（折叠面板 / 下拉 / 弹层）
dv-on-open = () (f i64) {
    f = DV-F-VIS | DV-F-EN | DV-F-OPEN
}

; ---------- 其余组件：命名构造器（全目录） ----------
dv-icon = (key i64, name str, parent i64) (h i64) {
    f = dv-on()
