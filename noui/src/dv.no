dv-rating = (key i64, max i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-RATING, key, '', '', 0, 0, max, f, parent)
}
dv-description-list = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-DESCRIPTION-LIST, key, '', '', 0, 0, 0, f, parent)
}
dv-collapsible = (key i64, title str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-COLLAPSIBLE, key, title, '', 0, 0, 0, f, parent)
}
dv-diff = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-DIFF, key, '', '', 0, 0, 0, f, parent)
}
dv-highlighter = (key i64, code str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-HIGHLIGHTER, key, code, '', 0, 0, 0, f, parent)
}
dv-clipboard = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-CLIPBOARD, key, '', '', 0, 0, 0, f, parent)
}
dv-resizable = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-RESIZABLE, key, '', '', 0, 0, 0, f, parent)
}
dv-dock = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-DOCK, key, '', '', 0, 0, 0, f, parent)
}
dv-text-node = (key i64, text str, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-TEXT, key, text, '', 0, 0, 0, f, parent)
}
dv-theme = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-THEME, key, '', '', 0, 0, 0, f, parent)
}
dv-sizing = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-SIZING, key, '', '', 0, 0, 0, f, parent)
}
dv-styled = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-STYLED, key, '', '', 0, 0, 0, f, parent)
}
dv-window-ext = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-WINDOW-EXT, key, '', '', 0, 0, 0, f, parent)
}
dv-searchable-list = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-SEARCHABLE-LIST, key, '', '', 0, 0, 0, f, parent)
}
dv-index-path = (key i64, parent i64) (h i64) {
    f = dv-on()
    h = dv-node(C-INDEX-PATH, key, '', '', 0, 0, 0, f, parent)
}

; 条件节点：cond 为 0 时返回 -1，调用方据此跳过子树
dv-cond = (key i64, cond i64, parent i64) (h i64) {
    h = -1
    (cond != 0) -> {
        f = dv-on()
        h = dv-node(C-FORM, key, '', '', 0, 0, 0, f, parent)
    }
}

; 重复节点：同一形状造 n 份，key 从 key0 递增（key 稳定 -> 跨帧复用，不重建）
; 返回首个节点 id（n=0 时 -1）。列表类 UI 的声明式原语。
dv-repeat = (parent i64, key0 i64, n i64, kind i64, text str, text2 str, color i64, value i64, value2 i64, flags i64) (h i64) {
    h = -1
    i = 0
    !! {
        (i >= n) -> { ** }
        nh = dv-node(kind, dv-add(key0, i), text, text2, color, value, value2, flags, parent)
        (i == 0) -> { h = nh }
        i = dv-inc(i)
    }
}

; 重复标签（限量）：texts 的前 n 个各造一个 label，key 从 key0 递增。
; n 超出长度按长度算，负数按 0 算 —— 列表长度由状态决定时用这个。
dv-repeat-labels-n = (parent i64, key0 i64, texts []str, n i64) (h i64) {
    h = -1
    i = 0
    m = texts.len()
    lim = n
    (lim > m) -> { lim = m }
    (lim < 0) -> { lim = 0 }
    !! {
        (i >= lim) -> { ** }
        t = texts[i]: {
            ok -> it

            -> ''
        }
        f = dv-on()
        nh = dv-node(C-LABEL, dv-add(key0, i), t, '', 0, 0, 0, f, parent)
        (i == 0) -> { h = nh }
        i = dv-inc(i)
    }
}

; 重复标签（全量）：texts 里每个字符串一个 label
dv-repeat-labels = (parent i64, key0 i64, texts []str) (h i64) {
    m = texts.len()
    h = dv-repeat-labels-n(parent, key0, texts, m)
}

; 重复列表项：把「平行数组」映射成 n 个同 kind 节点 —— 列表项也是纯数据。
; 第 i 项：文案 texts[i]（不足补 ''）、value = values[i]、动作 acts[i]（0 = 不挂）、
; 载荷 pays[i]（不足补 0）。于是「第 i 行点了 = 动作 acts[i]，payload = pays[i]」
; 不用再手写 key 的 if-else 链。key 从 key0 递增 -> 跨帧稳定，长度变化只发差量。
; n 超出 texts 长度按长度算，负数按 0 算（与 dv-repeat-labels-n 同语义）。
dv-repeat-items-f = (parent i64, key0 i64, n i64, kind i64, texts []str, values []i64, acts []i64, pays []i64, flags []i64) (h i64) {
    h = -1
    i = 0
    m = texts.len()
    mv = values.len()
    ma = acts.len()
    mp = pays.len()
    mf = flags.len()
    lim = n
    (lim > m) -> { lim = m }
    (lim < 0) -> { lim = 0 }
    !! {
        (i >= lim) -> { ** }
        t = texts[i]: {
            ok -> it

            -> ''
        }
        v = 0
        (i < mv) -> { v = dv-arr-get(values, i) }
        a = 0
        (i < ma) -> { a = dv-arr-get(acts, i) }
        p = 0
        (i < mp) -> { p = dv-arr-get(pays, i) }
        ; 每项 flags 也是数据：不足（或传 DV-EMPTY-F）补 dv-on()，
        ; 于是「哪些行选中 / 禁用」能由状态推导 —— 声明式多选列表的地基。
        f = dv-on()
        (i < mf) -> { f = dv-arr-get(flags, i) }
        nh = dv-node(kind, dv-add(key0, i), t, '', 0, v, 0, f, parent)
        (a != 0) -> { dv-act(nh, a, p) }
        (i == 0) -> { h = nh }
        i = dv-inc(i)
    }
}

; 重复列表项（无 flags 参数）：签名保持不变，内部转调 dv-repeat-items-f。
; 这样既有的调用方 / 测试一个字都不用改。
dv-repeat-items = (parent i64, key0 i64, n i64, kind i64, texts []str, values []i64, acts []i64, pays []i64) (h i64) {
    h = dv-repeat-items-f(parent, key0, n, kind, texts, values, acts, pays, DV-EMPTY-F)
}

; 从状态槽推导每项 flags（阶段 20 的常用形态）：S[slot0+i] 非 0 -> dv-on-sel()，
; 否则 dv-on()。返回与 n 等长的数组，直接喂给 dv-repeat-items-f。
; 于是「选中的行」完全是状态的函数，不需要每帧手写 if。
; n 负数 / 超槽一律按 0 / 实际槽位算（dv-arr-get 越界返回 0 -> dv-on()）。
dv-sel-flags = (S []i64, slot0 i64, n i64) (f []i64) {
    f = with-len(0)
    i = 0
    !! {
        (i >= n) -> { ** }
        v = dv-arr-get(S, dv-add(slot0, i))
        x = dv-on()
        (v != 0) -> { x = dv-on-sel() }
        f.push(x)
        i = dv-inc(i)
    }
}

; 删掉列表第 i 项：把 i 之后的项前移一格，返回新长度（数组本身不变长）。
; i 越界 / 负数 / n <= 0 一律原样返回 n —— 调用方（dv-app-click）只需比较返回值。
; 与 dv-repeat-items 配套：视图侧给 (DV-A-ITEM, 行号)，应用侧按行号删。
dv-rows-del = (texts []str, n i64, i i64) (nn i64) {
    nn = n
    good = (n > 0) && (i >= 0) && (i < n)
    (good) -> {
        j = i
        !! {
            (j >= dv-add(n, -1)) -> { ** }
            nx = texts[dv-add(j, 1)]: {
                ok -> it

                -> ''
            }
            texts[j]: {
                ok -> it = nx

                -> _
            }
            j = dv-inc(j)
        }
        nn = dv-add(n, -1)
    }
}

; ---------------------------------------------------------------------------
; 标签页（阶段 19）：一条 C-TAB 标题条 + 一个内容容器，返回**内容容器**句柄。
;   active = 当前页下标（视图函数从状态读出来后传进来）
;   slot   = 「当前页」状态槽；点第 i 个标题 = SET slot = i（复用现有归约）
;   labels = 标题文案（平行数组）
;   base   = 标题条的 key；标题用 base+1+i，内容容器用 base+1+n
; 页面内容由应用往返回的容器里按 active 条件挂 —— 视图每帧重建，所以「切页」
; 就是条件分支建不同的子树，容器本身同 key 复用（不增删组件）。
; 选中态用 flags 表达（dv-on-sel，绘制 / 命中都认）；调和时再把 active 同步到
; C-TAB 自己的 CMP-VALUE（cs-paint-tab 画高亮读的是它）。
dv-tabs = (parent i64, active i64, slot i64, labels []str, base i64) (page i64) {
    n = labels.len()
    ; 越界收敛到最后一页：让「视图说的当前页」和 flags / 活树永远一致。
    ; 否则 cmp-set-value 会先把 CMP-VALUE 打成 0，tab-select 又因越界忽略，
    ; 标题条就悄悄跳回第 0 页了。
    a = active
    (n <= 0) -> { a = 0 }
    (n > 0) -> {
        (a < 0) -> { a = 0 }
        (a >= n) -> { a = dv-add(n, -1) }
    }
    bar = dv-node(C-TAB, base, '', '', 0, 0, 0, dv-on(), parent)
    dv-arr-set(DV-TAB-ACT, bar, a)
    i = 0
    !! {
        (i >= n) -> { ** }
        lt = labels[i]: {
            ok -> it

            -> ''
        }
        f = dv-on()
        (i == a) -> { f = dv-on-sel() }
        ; SET 的载荷 = 状态槽，值 = 页号（dv-node 的第 6 个参数 value；
        ; 注意第 5 个是 color，别把页号塞进 color 里）
        hi = dv-node(C-LABEL, dv-add(base, dv-add(i, 1)), lt, '', 0, i, 0, f, bar)
        dv-act(hi, DV-A-SET, slot)
        i = dv-inc(i)
    }
    page = dv-node(C-FORM, dv-add(base, dv-add(n, 1)), '', '', 0, 0, 0, dv-on(), parent)
}

; 声明式下拉（阶段 21）：把「选项数组 / 选中 / 展开」三样都接回状态。
;   S        状态池（选中下标 / 展开标志都是它的槽）
;   parent   父节点
;   key      字段节点 key（= base）
;   selslot  选中下标槽（-1 / 越界 = 未选）
;   openslot 展开槽（非 0 = 展开）
;   labels   选项文案数组（选项 key = base+1+i）
;   ph       占位符（未选中时显示，落到 text2）
;   base     选项 key 起点
; 返回字段节点句柄。语义：
;   - 字段本身挂 DV-A-TOGGLE(openslot) —— 点字段 = 展开 / 收起；
;   - 每个选项挂 DV-A-CHOOSE(selslot) —— 选中并收起（dv-apply 一次写两个槽，
;     选项的 value = 下标、value2 = 展开槽，正是 CHOOSE 需要的两个操作数）；
;   - 选项**常驻**（不条件挂载），收起时不可命中 —— cs-hit 的 C-SELECT 分支
;     已有这条语义（未 OPEN 时不动子节点），所以展开 / 收起零结构操作；
;   - 字段文案 = labels[S[selslot]]（未选 / 越界 = 空 -> 绘制回退到占位符），
;     选中下标走 value -> CMP-VALUE（cs-paint-select 的选项高亮读它）。
dv-select-from = (S []i64, parent i64, key i64, selslot i64, openslot i64, labels []str, ph str, base i64) (h i64) {
    n = labels.len()
    sel = S[selslot]: {
        ok -> it

        -> -1
    }
    opn = S[openslot]: {
        ok -> it

        -> 0
    }
    ; 越界 / 未选都当「空文案」，别让字段显示成莫名的一项
    t = ''
    (sel >= 0) -> {
        (sel < n) -> {
            t = labels[sel]: {
                ok -> it

                -> ''
            }
        }
    }
    f = dv-on()
    (opn != 0) -> { f = dv-on-open() }
    h = dv-node(C-SELECT, key, t, ph, 0, sel, 0, f, parent)
    dv-act(h, DV-A-TOGGLE, openslot)
    i = 0
    !! {
        (i >= n) -> { ** }
        lt = labels[i]: {
            ok -> it

            -> ''
        }
        hi = dv-node(C-LABEL, dv-add(base, dv-add(i, 1)), lt, '', 0, i, openslot, dv-on(), h)
        dv-act(hi, DV-A-CHOOSE, selslot)
        i = dv-inc(i)
    }
}

; ============================================================================
; 通知（阶段 22）：让「时间」进状态
; ============================================================================
; 通知的存活不是布尔开关，而是「触发于哪一帧」—— 视图每帧拿当前帧和它比，
; 过期就整棵子树不建（和 dv-cond 同一个思路）。触发帧从视图节点的 value 进来
; （视图算好 dv-frame() 再交给 dv-apply），所以「何时触发」也是 UI = f(state)。
; 槽里存触发时的 dv-frame()；0 = 没有通知（帧计数从 1 起，不会假活）。
dv-toast-alive = (S []i64, slot i64, ttl i64) (yes i64) {
    yes = 0
    t = dv-arr-get(S, slot)
    (t > 0) -> {
        (dv-frame() < dv-add(t, ttl)) -> { yes = 1 }
    }
}
; 通知本体：活着才建，非模态叠加层（dv-on-tip）—— 不参与流布局、在窗口矩形内居中、
; 绘制最后，但不挡点击（点得穿）。关闭按钮把触发帧写回 0 = 立即过期。
dv-toast = (S []i64, parent i64, key i64, slot i64, text str, ttl i64, base i64) (h i64) {
    h = -1
    (dv-toast-alive(S, slot, ttl) != 0) -> {
        h = dv-node(C-POPOVER, key, '', '', 0, 0, 0, dv-on-tip(), parent)
        dv-node(C-LABEL, base, text, '', 0, 0, 0, dv-on(), h)
        cb = dv-node(C-BUTTON, dv-add(base, 1), 'dismiss', '', 0, 0, 0, dv-on(), h)
        dv-act(cb, DV-A-SET, slot)
    }
}

; ============================================================================
; 视图树遍历（线性扫描：树很小，避免再维护一套子链表）
; ============================================================================
dv-child-count = (view i64) (n i64) {
    n = 0
    i = 0
    cnt = DV-KIND.len()
    !! {
        (i >= cnt) -> { ** }
        p = dv-parent(i)
        (p == view) -> { n = dv-inc(n) }
        i = dv-inc(i)
    }
}
dv-child = (view i64, want i64) (c i64) {
    c = -1
    seen = 0
    i = 0
    cnt = DV-KIND.len()
    !! {
        (i >= cnt) -> { ** }
        p = dv-parent(i)
        (p == view) -> {
            (seen == want) -> {
                c = i
                **
            }
            seen = dv-inc(seen)
        }
        i = dv-inc(i)
    }
}

; ============================================================================
; 调和状态
; ============================================================================
dv-frame = () (f i64) {
    f = dv-arr-get(DV-FRAME, 0)
}
dv-bump-frame = () () {
    f = dv-frame()
    dv-arr-set(DV-FRAME, 0, dv-inc(f))
}
dv-is-used = (h i64) (yes i64) {
    f = dv-frame()
    v = dv-arr-get(DV-USED, h)
    yes = 0
    (v == f) -> { yes = 1 }
}
dv-mark-used = (h i64) () {
    f = dv-frame()
    dv-arr-set(DV-USED, h, f)
}

; ============================================================================
; 视图节点 -> 活组件
; ============================================================================
; 全目录分派：每个 kind 走自己的构造器（保留组件库的默认配色 / 初始值）。
; 未列出的 kind 落到 cmp-alloc 兵底 —— 声明式层对组件目录是「全函数」，
; 新增组件 kind 时不必同步改这里也能用 dv-node(kind, ...) 表达。
dv-create = (v i64) (h i64) {
    h = -1
    kd = dv-kind(v)
    t = dv-text(v)
    t2 = dv-text2(v)
    val = dv-value(v)
    val2 = dv-value2(v)
    {
        ; --- A 基础 ---
        kd == C-LABEL -> { h = cmp-label(t) }
        kd == C-BUTTON -> { h = cmp-button(t) }
        kd == C-BADGE -> { h = cmp-badge(t) }
        kd == C-TAG -> { h = cmp-tag(t) }
        kd == C-ICON -> { h = cmp-icon(t) }
        kd == C-KBD -> { h = cmp-kbd(t) }
        kd == C-LINK -> { h = cmp-link(t) }
        kd == C-SEPARATOR -> { h = cmp-separator() }
        kd == C-AVATAR -> { h = cmp-avatar(t) }
        kd == C-EMPTY -> { h = cmp-empty(t) }
        kd == C-SPINNER -> { h = cmp-spinner() }
        kd == C-MARKER -> { h = cmp-marker(t) }
        ; --- B 表单 ---
        kd == C-CHECKBOX -> { h = cmp-checkbox(t) }
        kd == C-RADIO -> { h = cmp-radio(t) }
        kd == C-SWITCH -> { h = cmp-switch() }
        kd == C-INPUT -> { h = cmp-input(t2) }
        kd == C-TEXTAREA -> { h = cmp-textarea(t2) }
        kd == C-NUMBER-INPUT -> { h = cmp-number-input() }
        kd == C-OTP-INPUT -> { h = cmp-otp-input(val) }
        kd == C-SEARCH -> { h = cmp-search() }
        kd == C-SELECT -> { h = cmp-select(t2) }
        kd == C-COMBOBOX -> { h = cmp-combobox() }
        kd == C-SLIDER -> { h = cmp-slider(val, val2) }
        kd == C-STEPPER -> { h = cmp-stepper() }
        kd == C-COLOR-PICKER -> { h = cmp-color-picker() }
        kd == C-DATE-PICKER -> { h = cmp-date-picker() }
        kd == C-FORM -> { h = cmp-form() }
        kd == C-QUESTIONNAIRE -> { h = cmp-questionnaire() }
        ; --- C 导航 ---
        kd == C-TAB -> { h = cmp-tab() }
        kd == C-BREADCRUMB -> { h = cmp-breadcrumb() }
        kd == C-SIDEBAR -> { h = cmp-sidebar() }
        kd == C-MENU -> { h = cmp-menu() }
        kd == C-PAGINATION -> { h = cmp-pagination(val2) }
        kd == C-TOOLBAR -> { h = cmp-toolbar() }
        kd == C-TITLE-BAR -> { h = cmp-title-bar(t) }
        kd == C-STATUS-BAR -> { h = cmp-status-bar() }
        kd == C-COMMAND -> { h = cmp-command() }
        kd == C-HISTORY -> { h = cmp-history() }
        ; --- D 覆盖层 / 反馈 ---
        kd == C-DIALOG -> { h = cmp-dialog(t) }
        kd == C-POPOVER -> { h = cmp-popover() }
        kd == C-TOOLTIP -> { h = cmp-tooltip(t) }
        kd == C-HOVER-CARD -> { h = cmp-hover-card() }
        kd == C-NOTIFICATION -> { h = cmp-notification(t) }
        kd == C-ALERT -> { h = cmp-alert(t) }
        kd == C-MESSAGE -> { h = cmp-message(t) }
        kd == C-MESSAGE-SCROLLER -> { h = cmp-message-scroller() }
        kd == C-SHEET -> { h = cmp-sheet(t) }
        kd == C-PROGRESS -> { h = cmp-progress() }
        kd == C-SKELETON -> { h = cmp-skeleton() }
        kd == C-SHIMMER -> { h = cmp-shimmer() }
        kd == C-BUBBLE -> { h = cmp-bubble(t) }
        kd == C-SPEECH -> { h = cmp-speech(t) }
        kd == C-INSPECTOR -> { h = cmp-inspector() }
        kd == C-WINDOW-BORDER -> { h = cmp-window-border() }
        kd == C-NATIVE-MENU -> { h = cmp-native-menu() }
        kd == C-ATTACHMENT -> { h = cmp-attachment(t) }
        ; --- E 数据展示 ---
        kd == C-TABLE -> { h = cmp-table(val, val2) }
        kd == C-LIST -> { h = cmp-list() }
        kd == C-VIRTUAL-LIST -> { h = cmp-virtual-list(val) }
        kd == C-TREE -> { h = cmp-tree() }
        kd == C-ACCORDION -> { h = cmp-accordion() }
        kd == C-CAROUSEL -> { h = cmp-carousel() }
        kd == C-CHART -> { h = cmp-chart() }
        kd == C-PLOT -> { h = cmp-plot() }
        kd == C-RATING -> { h = cmp-rating(val2) }
        kd == C-DESCRIPTION-LIST -> { h = cmp-description-list() }
        kd == C-GROUP-BOX -> { h = cmp-group-box(t) }
        kd == C-COLLAPSIBLE -> { h = cmp-collapsible(t) }
        kd == C-DIFF -> { h = cmp-diff() }
        kd == C-HIGHLIGHTER -> { h = cmp-highlighter(t) }
        kd == C-CLIPBOARD -> { h = cmp-clipboard() }
        kd == C-SCROLL -> { h = cmp-scroll() }
        ; --- F 布局 / 容器 ---
        kd == C-RESIZABLE -> { h = cmp-resizable() }
        kd == C-DOCK -> { h = cmp-dock() }
        kd == C-GRID -> { h = cmp-grid(val, val2) }
        kd == C-TEXT -> { h = cmp-text-node(t) }
        kd == C-THEME -> { h = cmp-theme() }
        kd == C-SIZING -> { h = cmp-sizing() }
        kd == C-STYLED -> { h = cmp-styled() }
        kd == C-ROOT -> { h = cmp-root() }
        kd == C-WINDOW-EXT -> { h = cmp-window-ext() }
        ; --- G 其他 ---
        kd == C-SEARCHABLE-LIST -> { h = cmp-searchable-list() }
        kd == C-INDEX-PATH -> { h = cmp-index-path() }
        ; --- 兵底：未列出的 kind 也能声明式表达 ---
        -> { h = cmp-alloc(kd, t, t2, 0, val) }
    }
    (h >= 0) -> { cmp-set-key(h, dv-key(v)) }
}

; flags 同步：DV-F-VIS / DV-F-EN / DV-F-CHK / DV-F-SEL / DV-F-ACT / DV-F-OPEN
dv-apply-flags = (L i64, f i64) {
    vis = f & 1
    (vis != 0) -> { cmp-flag-set(L, F-VISIBLE) }
    (vis == 0) -> { cmp-flag-clear(L, F-VISIBLE) }
    en = f & 2
    (en != 0) -> {
        cmp-flag-set(L, F-ENABLED)
        cmp-flag-clear(L, F-DISABLED)
    }
    (en == 0) -> {
        cmp-flag-clear(L, F-ENABLED)
        cmp-flag-set(L, F-DISABLED)
    }
    chk = f & 4
    (chk != 0) -> { cmp-flag-set(L, F-CHECKED) }
    (chk == 0) -> { cmp-flag-clear(L, F-CHECKED) }
    sel = f & 8
    (sel != 0) -> { cmp-flag-set(L, F-SELECTED) }
    (sel == 0) -> { cmp-flag-clear(L, F-SELECTED) }
    act = f & 16
    (act != 0) -> { cmp-flag-set(L, F-ACTIVE) }
    (act == 0) -> { cmp-flag-clear(L, F-ACTIVE) }
    opn = f & 32
    (opn != 0) -> { cmp-flag-set(L, F-OPEN) }
    (opn == 0) -> { cmp-flag-clear(L, F-OPEN) }
    ovl = f & 64
    (ovl != 0) -> { cmp-flag-set(L, F-OVERLAY) }
    (ovl == 0) -> { cmp-flag-clear(L, F-OVERLAY) }
    pas = f & 128
    (pas != 0) -> { cmp-flag-set(L, F-PASS) }
    (pas == 0) -> { cmp-flag-clear(L, F-PASS) }
}

dv-apply-props = (L i64, v i64) {
    cmp-set-key(L, dv-key(v))
    kd = dv-kind(v)
    ; 输入类组件是「非受控」的：文本缓冲与焦点归组件自己所有，
    ; 视图只给 placeholder（text2）。若这里把 dv-text 同步进去，
    ; 每帧都会把用户刚敲的字清掉。要受控就在事件里改写组件文本，
    ; 并让 dv-input 的 text 携带该状态（此时别再依赖组件内缓冲）。
    (kd != C-INPUT && kd != C-TEXTAREA) -> { cmp-set-text(L, dv-text(v)) }
    cmp-set-text2(L, dv-text2(v))
    cmp-set-color(L, dv-color(v))
    cmp-set-value(L, dv-value(v))
    ; VALUE2 的语义按 kind 而定：只有「构造参数落在 VALUE2」的组件才同步
    ; （slider 上限 / grid 行数 / table 行数 / pagination 总数 / rating 满分）
    (kd == C-SLIDER) -> { cmp-set-value2(L, dv-value2(v)) }
    (kd == C-GRID) -> { cmp-set-value2(L, dv-value2(v)) }
    (kd == C-TABLE) -> { cmp-set-value2(L, dv-value2(v)) }
    (kd == C-PAGINATION) -> { cmp-set-value2(L, dv-value2(v)) }
    (kd == C-RATING) -> { cmp-set-value2(L, dv-value2(v)) }
    dv-apply-flags(L, dv-flags(v))
    ; 布局提示（bits / gap / pad）：0 = 默认，所以每帧无条件同步是安全的
    cmp-set-lay(L, dv-lay-of(v))
    cmp-set-gap(L, dv-gap-of(v))
    cmp-set-pad(L, dv-pad-of(v))
    ; 尺寸 / 对齐提示：0 = 默认，所以每帧无条件同步是安全的
    cmp-set-sw(L, dv-sw-of(v))
    cmp-set-sh(L, dv-sh-of(v))
    cmp-set-align(L, dv-align-of(v))
    ; 变体：0 = 默认，所以每帧无条件同步是安全的
    cmp-set-var(L, dv-var-of(v))
    ; 锚点：-1 = 无锚点，所以每帧无条件同步是安全的
    cmp-set-anchor(L, dv-anchor-of(v))
}

; 叠加层（模态弹层）：把视图节点标成 DV-F-OVL —— 调和时经 dv-apply-flags 落到活节点的
; F-OVERLAY：不参与父级流布局，改为在父矩形内居中；命中时先于其它子节点，点不穿。
; 注意视图池（DV-*）与活组件池（CMP-*）是两套下标，所以这里写 DV-FLAGS 而不是
; cmp-flag-set（后者写的是活池，视图句柄会被误解成组件下标）。
dv-overlay = (h i64) () {
    dv-arr-set(DV-FLAGS, h, dv-flags(h) | DV-F-OVL)
}

; 声明式写法：开 + 叠加层（弹层可见，且作为模态层挂在父矩形中央）
dv-on-overlay = () (f i64) {
    f = DV-F-VIS | DV-F-EN | DV-F-OPEN | DV-F-OVL
}

; 锚定浮层（阶段 16）：在 dv-overlay 之上再给一个锚点 key —— 调和时经 dv-apply-props
; 落到活节点的 CMP-ANCHOR，cmp-scene 布局时按 key 反查锚点矩形，把浮层放在锚点下方
; （贴边时翻到上方）并夹紧在父矩形内。锚点找不到就退化为父矩形内居中。
dv-overlay-anchor = (h i64, anchor-key i64) () {
    dv-overlay(h)
    dv-arr-set(DV-ANCHOR, h, anchor-key)
}

; 非模态叠加层（阶段 17）：在 dv-overlay 之上加 DV-F-PASS —— 调和时落到活节点 F-PASS。
; 语义：不参与流布局、仍最后画、仍可被命中，但**不设模态屏障**：
; 浮层自己没接住点击时，命中继续往下面的兄弟找（点得穿），也不会让父节点返回 -2。
; tooltip / hover-card / 通知用这一档；模态弹层（对话框 / 菜单）保持 dv-on-overlay()。
dv-pass = (h i64) () {
    dv-arr-set(DV-FLAGS, h, dv-flags(h) | DV-F-PASS)
}

; 声明式写法：开 + 非模态叠加层（tooltip：可见、可命中、点得穿）
dv-on-tip = () (f i64) {
    f = DV-F-VIS | DV-F-EN | DV-F-PASS | DV-F-OVL
}

; hover 声明（阶段 17）：把「本节点是否被 hover」写进状态槽 slot。
; 装配层每帧按当前命中 key 是否等于本节点 key 写 1/0，视图再据此建 tooltip。
; 与 dv-act 同生命周期（dv-clear 清掉，每帧重建视图时重挂）。
dv-hover = (h i64, slot i64) () {
    dv-arr-set(DV-HOVER, h, dv-add(slot, 1))
}

; ============================================================================
; 调和器
; ============================================================================
; 在 live 的子节点里按 key 找句柄（事件命中 -> 视图节点 的反向查找）
dv-live-by-key = (live i64, k i64) (h i64) {
    h = -1
    n = cmp-children(live)
    i = 0
    !! {
        (i >= n) -> { ** }
        c = cmp-child(live, i)
        ck = cmp-key(c)
        (ck == k) -> {
            h = c
            **
        }
        i = dv-inc(i)
    }
}

; ============================================================================
; 深度查找：跨任意层级按 key 找活组件
; 两栏 / 嵌套容器之后，事件侧的 key 不再是 root 的直接子节点。
; 用显式队列做 BFS（语言没有可用的递归 fn 值，就不冒递归的险）。
; 必须在 dv-live-by-key 之后定义（定义顺序会影响解析）。
; ============================================================================
DV-QUEUE []i64 = with-len(0)
dv-live-deep = (live i64, k i64) (h i64) {
    h = -1
    done = 0
    DV-QUEUE.truncate(0)
    DV-QUEUE.push(live)
    qi = 0
    !! {
        (qi >= DV-QUEUE.len()) -> { ** }
        (done != 0) -> { ** }
        cur = DV-QUEUE[qi]: {
            ok -> it

            -> -1
        }
        (cur >= 0) -> {
            f = dv-live-by-key(cur, k)
            (f >= 0) -> {
                h = f
                done = 1
            }
            cn = cmp-children(cur)
            j = 0
            !! {
                (j >= cn) -> { ** }
                DV-QUEUE.push(cmp-child(cur, j))
                j = dv-inc(j)
            }
        }
        qi = dv-inc(qi)
    }
}

; 在 live 的子节点里找一个 (key, kind) 匹配且本帧未认领的组件
dv-find-free = (live i64, k i64, kd i64) (h i64) {
    h = -1
    n = cmp-children(live)
    i = 0
    !! {
        (i >= n) -> { ** }
        c = cmp-child(live, i)
        ck = cmp-key(c)
        ckk = cmp-kind(c)
        used = dv-is-used(c)
        ((ck == k) && (ckk == kd) && (used == 0)) -> {
            h = c
            **
        }
        i = dv-inc(i)
    }
}

dv-sync = (live i64, view i64) (ops i64) {
    ops = 0
    vn = dv-child-count(view)

    ; --- 1. 按 (key, kind) 认领活组件 ---
    i = 0
    !! {
        (i >= vn) -> { ** }
        v = dv-child(view, i)
        k = dv-key(v)
        kd = dv-kind(v)
        lf = dv-find-free(live, k, kd)
        (lf >= 0) -> {
            dv-mark-used(lf)
            dv-arr-set(DV-MATCH, v, lf)
        }
        i = dv-inc(i)
    }

    ; --- 2. 删除未被认领的活子节点 ---
    j = 0
    !! {
        cn = cmp-children(live)
        (j >= cn) -> { ** }
        ldel = cmp-child(live, j)
        (ldel < 0) -> { ** }
        used = dv-is-used(ldel)
        (used != 0) -> { j = dv-inc(j) }
        (used == 0) -> {
            okd = cmp-detach(live, ldel)
            (okd == true) -> { ops = dv-inc(ops) }
            (okd == false) -> { j = dv-inc(j) }
        }
    }

    ; --- 3. 为未匹配的视图节点新建组件 ---
    i = 0
    !! {
        (i >= vn) -> { ** }
        v = dv-child(view, i)
        m = dv-arr-getm(DV-MATCH, v)
        (m < 0) -> {
            lnew = dv-create(v)
            (lnew >= 0) -> {
                dv-arr-set(DV-MATCH, v, lnew)
                ops = dv-inc(ops)
            }
        }
        i = dv-inc(i)
    }

    ; --- 4. 属性同步 + 递归 ---
    i = 0
    !! {
        (i >= vn) -> { ** }
        v = dv-child(view, i)
        m = dv-arr-getm(DV-MATCH, v)
        (m >= 0) -> {
            dv-apply-props(m, v)
            o2 = dv-sync(m, v)
            ops = dv-add(ops, o2)
        }
        i = dv-inc(i)
    }

    ; --- 5. 重排：让活子节点顺序 == 视图顺序 ---
    ordered = 1
    i = 0
    !! {
        (i >= vn) -> { ** }
        v = dv-child(view, i)
        m = dv-arr-getm(DV-MATCH, v)
        (m >= 0) -> {
            cur = cmp-child(live, i)
            (cur != m) -> {
                ordered = 0
                **
            }
        }
        i = dv-inc(i)
    }
    (ordered == 0) -> {
        !! {
            lrm = cmp-child(live, 0)
            (lrm < 0) -> { ** }
            cmp-detach(live, lrm)
        }
        i = 0
        !! {
            (i >= vn) -> { ** }
            v = dv-child(view, i)
            m = dv-arr-getm(DV-MATCH, v)
            (m >= 0) -> { cmp-add-child(live, m) }
            i = dv-inc(i)
        }
    }
    ; 标签条当前页（阶段 19）：必须放在**最后** —— CMP-COUNT 要等子节点挂好才准，
    ; 而 dv-apply-props 跑在递归之前，那时容器可能还没孩子（tab-select 会因越界被吞）。
    ; cs-paint-tab 画高亮读的是 tab-active(h)（= CMP-VALUE），cmp-set-value 又会把
    ; dv-value（标题条是 0）写进去，所以这里按 DV-TAB-ACT 再覆盖一次。
    ta = dv-tab-active-of(view)
    (ta >= 0) -> { tab-select(live, ta) }
}

; 顶层入口：换帧号（让上一帧的认领标记失效），再调和
dv-render = (live i64, view i64) (ops i64) {
    dv-bump-frame()
    ops = dv-sync(live, view)
}
