; ============================================================================
; noui 声明式应用装配层（阶段 11）—— src/dv-app.no
;
; 把「轮询 → 命中 → 归约 → 重建视图 → 调和 → 布局 → 上屏」这条主循环收进框架，
; 应用侧只剩三样东西：状态池 + 视图函数 + 事件回调。命令式内核（components /
; cmp-scene / app）一行没改 —— 这一层只是把「装配」也变成数据驱动的最终产物。
;
; 应用必须按名提供三个回调（语言没有可用的 fn 值，只能按名调用）：
;   dv-app-view   = () (page i64)                                  每帧：状态 -> 视图树
;   dv-app-reduce = (S []i64, k i64) (nw i64)                      点击：把视图动作归约进状态池
;   dv-app-click  = (S []i64, k i64, act i64, pay i64, nw i64) ()  归约之外的事件侧动作
;
; 计数器（模块全局，dva-run 结束后应用可打印）：
;   dva-frames() / dva-ops() / dva-clicks()
;
; 主指针语义（阶段83）：dva-press(S, root, px, py) 是「按下」的唯一入口，
; 鼠标左键 / 手指 / 压感笔共用；接触方式用 dva-touch()（1 = 手指或笔按着）
; 与 app-pressure() 暴露给组件。
;
; 拖放（阶段84）：放置区用 cmp-drop-zone(h, 1) 标记（F-DROP）。
;   dva-drop-active()  是否处于拖放会话（DROP_BEGIN..COMPLETE）
;   dva-drop-target()  当前落点 key（-1 = 悬空在放置区外）
;   dva-drop-hits()    POS 命中放置区的次数；dva-drops() 完成派发次数
; 放下时走 dv-app-click(S, k, DV-A-DROP, 0, nw)：视图据 act 区分点击与拖放，
; 文件 / 文本用 app-drop() 取（读完即空）。
;
; 受控输入（阶段13）：视图用 dv-bind(node, slot, max) 把输入类组件的文本绑到
; dv 侧的字符串状态池 DV-BIND-T[slot]（应用用 dv-bound / dv-bound-set 读写）；
; 装配层每帧双向同步（dva-sync-binds），签名与阶段 11 完全一致。
; 快捷键（阶段13）：视图用 dv-hotkey(node, keycode, act, pay) 声明全局键；
; 无输入焦点时按键命中 -> 走与点击相同的归约路径。
;
; 运行：# /noui/src/dv-app  然后  dva-run(S, 'title', 900)
; ============================================================================
# /noui/src/app
# /noui/src/dv

DVA-FRAMES []i64 = [0]
DVA-OPS []i64 = [0]
DVA-CLICKS []i64 = [0]
DVA-FOCUS []i64 = [-1]
DVA-PX []i64 = [0]
DVA-PY []i64 = [0]
; 是否收到过鼠标事件（0 = 还没有，此时不猜命中，避免开局在 (0,0) 误报 hover）
DVA-MOUSE []i64 = [0]
; 最近一次布局后算出的命中句柄（-1 无命中，-2 被模态层挡住），供 hover 状态同步用
DVA-HIT []i64 = [-1]
; 代码编辑器（阶段30）的键盘焦点：存的是**编辑器根的声明式 key**，不是活句柄 ——
; 活句柄每帧随调和变，key 不变。dva-edit-find 顺着活父链上溯到 dv-edit 声明处。
DVA-EDIT-FOCUS []i64 = [-1]
; 命令面板（阶段32）的键盘焦点：存的是**面板的声明式 key**（-1 = 没有面板开着）。
; 与编辑器同一个理由 —— 活句柄每帧随调和变，key 不变；而且面板要跨帧记住
; 「游标在第几行」，那些状态本来就存在 dv 侧的 DV-PAL-* 池里。
DVA-PAL-FOCUS []i64 = [-1]
; 阶段83：手指 / 压感笔是否正处于接触状态（1 = 按着，0 = 没有）。触摸与笔走
; 和鼠标左键完全相同的「命中 -> 归约」路径，这个标记只区分接触方式本身。
DVA-TOUCH []i64 = [0]
; 阶段84：拖放会话与落点。POS 事件把「当前悬停的放置区 key」记在
; DVA-DROP-TARGET；COMPLETE 时用它派发，随后清会话。DVA-DROP-HITS 统计
; 「POS 命中放置区」的次数（视图可据此做高亮反馈）。
DVA-DROP-ACTIVE []i64 = [0]
DVA-DROP-TARGET []i64 = [-1]
DVA-DROP-HITS []i64 = [0]
DVA-DROPS []i64 = [0]

DVA-AZ = 'abcdefghijklmnopqrstuvwxyz'
DVA-DIG = '0123456789'

dva-frames = () (n i64) {
    n = DVA-FRAMES[0]: {
        ok -> it

        -> 0
    }
}
dva-ops = () (n i64) {
    n = DVA-OPS[0]: {
        ok -> it

        -> 0
    }
}
dva-clicks = () (n i64) {
    n = DVA-CLICKS[0]: {
        ok -> it

        -> 0
    }
}
; 事件回调里要拿活组件树根（配合 dv-live-deep）
dva-root = () (h i64) {
    h = app-root()
}
; 阶段83：当前接触方式是不是手指 / 笔（1 = 是，0 = 普通指针或没按）。
; 与 dva-press 配对使用：按下置位、抬起清零。
dva-touch = () (yes i64) {
    yes = DVA-TOUCH[0]: {
        ok -> it

        -> 0
    }
}
; ---- 阶段84：拖放状态只读 getter（视图渲染时可直接查）----
dva-drop-active = () (yes i64) {
    yes = DVA-DROP-ACTIVE[0]: {
        ok -> it

        -> 0
    }
}
dva-drop-target = () (k i64) {
    k = DVA-DROP-TARGET[0]: {
        ok -> it

        -> -1
    }
}
dva-drop-hits = () (n i64) {
    n = DVA-DROP-HITS[0]: {
        ok -> it

        -> 0
    }
}
dva-drops = () (n i64) {
    n = DVA-DROPS[0]: {
        ok -> it

        -> 0
    }
}
; 最近一次点击 / 移动的定点坐标（事件回调里做几何换算用）
dva-px = () (x i64) {
    x = DVA-PX[0]: {
        ok -> it

        -> 0
    }
}
dva-py = () (y i64) {
    y = DVA-PY[0]: {
        ok -> it

        -> 0
    }
}
; 状态池写入：S 是数组参数，只能 place-match（同 dv-apply 的写法）
dva-set = (S []i64, i i64, v i64) () {
    S[i]: {
        ok -> it = v
        -> _
    }
}

; ---------------------------------------------------------------------------
; 输入类组件：点击后持续拥有键盘（焦点不是「动作」，是组件的持有状态）
; ---------------------------------------------------------------------------
dva-is-input-kind = (kd i64) (yes i64) {
    yes = 0
    (kd == C-INPUT) -> { yes = 1 }
    (kd == C-TEXTAREA) -> { yes = 1 }
    (kd == C-SEARCH) -> { yes = 1 }
    (kd == C-NUMBER-INPUT) -> { yes = 1 }
    (kd == C-OTP-INPUT) -> { yes = 1 }
}

; 代码编辑器（阶段30）：从命中句柄顺活父链上溯，找 dv-edit 声明过的最近祖先。
; 返回它的**声明式 key**（-1 = 不在任何编辑器里）。活句柄 -> key -> 视图节点 ->
; dv-edit-of 查编辑槽，两层间接是因为 dv-edit 记在视图描述上、命中给的是活句柄。
dva-edit-find = (hit i64) (k i64) {
    k = -1
    (hit >= 0) -> {
        v = hit
        guard = 0
        !! {
            (guard >= 64) -> { ** }
            (v < 0) -> { ** }
            kk = cmp-key(v)
            d = dv-node-by-key(kk)
            (d >= 0) -> {
                s = dv-edit-of(d)
                (s >= 0) -> {
                    k = kk
                    **
                }
            }
            v = cmp-parent-of(v)
            guard = dv-inc(guard)
        }
    }
    k
}

; 命令面板（阶段32）：从命中句柄顺活父链上溯，找 dv-command-palette 声明过的最近祖先。
; 返回面板 key（-1 = 不在任何面板里）—— 和 dva-edit-find 同一形状。
; 用途：点击落在面板里时不该把键盘焦点交给面板内的输入框（面板自己收键盘）。
dva-pal-find = (hit i64) (pk i64) {
    pk = -1
    (hit >= 0) -> {
        v = hit
        guard = 0
        !! {
            (guard >= 64) -> { ** }
            (v < 0) -> { ** }
            kk = cmp-key(v)
            d = dv-node-by-key(kk)
            (d >= 0) -> {
                q = dv-pal-of(d)
                (q >= 0) -> {
                    pk = q
                    **
                }
            }
            v = cmp-parent-of(v)
            guard = dv-inc(guard)
        }
    }
    pk
}

; 点击命中后的焦点移交：输入类接管，其余（含点空白）释放
; 焦点交接（阶段 18 起尊重禁用）：禁用的节点不接焦点 —— 尤其禁用输入框，
; 点了不该开始编辑。命中本身仍然有效（hover / tooltip 照常），只是不交互。
; 阶段30：代码编辑器与输入类**互斥** —— 点在编辑器里就交出输入焦点，
; 反之点进输入框就交出编辑器焦点（否则两处都在改文本）。
dva-focus = (hit i64) () {
    ; 阶段32：命中在命令面板里 -> 面板自己收键盘，不把焦点交给面板内的输入框
    pk = dva-pal-find(hit)
    (pk >= 0) -> {
        fh0 = DVA-FOCUS[0]: {
            ok -> it

            -> -1
        }
        (fh0 >= 0) -> { input-focus(fh0, false) }
        DVA-FOCUS[0] = -1
        DVA-EDIT-FOCUS[0] = -1
    }
    (pk < 0) -> { dva-focus-raw(hit) }
}

dva-focus-raw = (hit i64) () {
    fh = DVA-FOCUS[0]: {
        ok -> it

        -> -1
    }
    h = hit
    (cmp-has(h, F-DISABLED)) -> { h = -1 }
    ek = dva-edit-find(h)
    (ek >= 0) -> {
        (fh >= 0) -> { input-focus(fh, false) }
        DVA-FOCUS[0] = -1
        DVA-EDIT-FOCUS[0] = ek
    }
    (ek < 0) -> {
        DVA-EDIT-FOCUS[0] = -1
        (h >= 0) -> {
            kd = cmp-kind(h)
            (dva-is-input-kind(kd) == 1) -> {
                (fh >= 0 && fh != h) -> { input-focus(fh, false) }
                DVA-FOCUS[0] = h
                input-focus(h, true)
            }
            (dva-is-input-kind(kd) == 0) -> {
                (fh >= 0) -> { input-focus(fh, false) }
                DVA-FOCUS[0] = -1
            }
        }
        (h < 0) -> {
            (fh >= 0) -> { input-focus(fh, false) }
            DVA-FOCUS[0] = -1
        }
    }
}

; ---------------------------------------------------------------------------
; 阶段77：Tab / Shift-Tab 焦点遍历
;
; 顺序 = 视图节点创建序（dv-node-count 扫描），只收「输入类 + 已挂载 + 未禁用」。
; 编辑器聚焦时 Tab 保持既有缩进语义（dv.no 的 kk==9），不参与遍历；命令面板
; 开着时整段键盘归面板。交接复用现成机制（input-focus + DVA-FOCUS）。
; ---------------------------------------------------------------------------
dva-focus-cand = (root i64, v i64) (h i64) {
    h = -1
    kd = dv-kind(v)
    (dva-is-input-kind(kd) == 1) -> {
        hh = dv-live-deep(root, dv-key(v))
        (hh >= 0) -> {
            (cmp-has(hh, F-DISABLED) == 0) -> { h = hh }
        }
    }
    h
}

; dir=1 正向（Tab）、-1 反向（Shift-Tab）。无焦点时正向取第一个、反向取最后一个。
; 阶段81：默认按钮 / Enter 提交。语义与命令面板的回车一致 —— 有焦点组件且
; 它带视图动作（dv-act）时，Enter 等价于鼠标点击它，走**完全相同**的
; 派发 -> 归约 -> 事件回调路径。输入框 / 编辑器等无 dv-act 的组件不受影响
; （Enter 不误触发布局外的东西）。无焦点时什么都不做。
dva-default-submit = (S []i64, root i64) () {
    fh = DVA-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (fh < 0) -> return
    k = cmp-key(fh)
    act, pay = dv-dispatch(k)
    (act == 0) -> return
    nw = dv-app-reduce(S, k)
    (nw > 0) -> { DVA-CLICKS[0] = dv-add(DVA-CLICKS[0], 1) }
    dv-app-click(S, k, act, pay, nw)
}

dva-focus-step = (root i64, dir i64) () {
    pk = DVA-PAL-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (pk >= 0) -> return
    ek = DVA-EDIT-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (ek >= 0) -> return
    fh = DVA-FOCUS[0]: {
        ok -> it

        -> -1
    }
    n = dv-node-count()
    ; 当前焦点在候选序列里的序号（找不到 = -1）
    cur = -1
    cnt = 0
    i = 0
    !! {
        (i >= n) -> { ** }
        h = dva-focus-cand(root, i)
        (h >= 0) -> {
            (h == fh) -> { cur = cnt }
            cnt = dv-inc(cnt)
        }
        i = cs-inc(i)
    }
    (cnt <= 0) -> return
    ; 环形走一步；用有界 guard 兜底（delta 只有 ±1，正常两轮内收敛）
    pos = cs-add(cur, dir)
    guard = 0
    !! {
        ((pos >= 0) && (pos < cnt)) -> { ** }
        (guard > 8) -> { ** }
        (pos < 0) -> { pos = cs-add(pos, cnt) }
        (pos >= cnt) -> { pos = cs-sub(pos, cnt) }
        guard = dv-inc(guard)
    }
    ; 定位第 pos 个候选并交接
    nh = -1
    j = 0
    i = 0
    !! {
        (i >= n) -> { ** }
        h = dva-focus-cand(root, i)
        (h >= 0) -> {
            (j == pos) -> {
                nh = h
                **
            }
            j = dv-inc(j)
        }
        i = cs-inc(i)
    }
    (nh >= 0) -> {
        (fh >= 0 && fh != nh) -> { input-focus(fh, false) }
        DVA-FOCUS[0] = nh
        input-focus(nh, true)
    }
}

; 键盘喂给当前焦点输入框：退格 / 空格 / 数字 / 小写字母
dva-keyboard = (kk i64) () {
    fh = DVA-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (fh >= 0) -> {
        (cmp-has(fh, F-FOCUSED)) -> {
            (kk == 8) -> { input-backspace(fh) }
            (kk == 32) -> { input-append(fh, ' ') }
            (kk >= 48) -> {
                (kk <= 57) -> {
                    i0 = cs-sub(kk, 48)
                    ch = DVA-DIG.slice(i0, cs-inc(i0))
                    input-append(fh, ch)
                }
            }
            (kk >= 97) -> {
                (kk <= 122) -> {
                    i0 = cs-sub(kk, 97)
                    ch = DVA-AZ.slice(i0, cs-inc(i0))
                    input-append(fh, ch)
                }
            }
        }
    }
}

; 键盘喂给当前打开的命令面板（阶段32）：
;   上 / 下 = 游标在命中行之间移动；回车 = 执行游标行的命令
;           （走与点击**完全相同**的派发 -> 归约 -> 事件回调路径）；
;   ESC = 关面板；退格 = 查询串退一格；可打印 ASCII = 追加进查询串。
; 语义（游标 / 查询串 / 关面板）全在 dv 侧，装配层只做按键归类。
dva-pal-keyboard = (S []i64, kk i64) () {
    pk = DVA-PAL-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (pk >= 0) -> {
        (kk == ED-K-UP) -> { dv-pal-move(pk, -1) }
        (kk == ED-K-DOWN) -> { dv-pal-move(pk, 1) }
        (kk == 13) -> {
            ck = dv-pal-cur-key(pk)
            (ck >= 0) -> {
                act, pay = dv-dispatch(ck)
                nw = dv-app-reduce(S, ck)
                (nw > 0) -> { DVA-CLICKS[0] = dv-add(DVA-CLICKS[0], 1) }
                dv-app-click(S, ck, act, pay, nw)
            }
        }
        (kk == 27) -> { dv-pal-close(S, pk) }
        (kk == 8) -> { dv-pal-backspace(pk) }
        (kk >= 32) -> {
            (kk <= 126) -> {
                i0 = cs-sub(kk, 32)
                ch = ED-PRINT.slice(i0, dv-inc(i0))
                dv-pal-type(pk, ch)
            }
        }
    }
}

; 键盘喂给焦点代码编辑器（阶段30）：key -> 视图节点 -> 编辑槽 -> dv-edit-key。
; 语义（退格 / 回车 / Tab / 方向键 / 可打印 ASCII）全在 dv 侧，装配层只做寻址。
dva-edit-keyboard = (kk i64) () {
    ek = DVA-EDIT-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (ek >= 0) -> {
        v = dv-node-by-key(ek)
        (v >= 0) -> {
            slot = dv-edit-of(v)
            (slot >= 0) -> { dv-edit-key(slot, kk) }
        }
    }
}

; ============================================================================
; 阶段76：文本输入事件（t==7）—— 把 SDL 给的整段 UTF-8 拆成码点喂给焦点
;
; 为什么不用按键码：SDL_EVENT_KEY_DOWN 只有键位，没有字符 —— 死键、输入法组字、
; 非 ASCII 全都拿不到。这里按**码点**切片（str.slice 是码点索引），所以中文 /
; emoji 不会被切成半个字节。优先级与按键一致：命令面板 > 输入框 > 编辑器。
; ============================================================================
dva-type = (s str) () {
    n = s.len()
    (n == 0) -> return
    pk = DVA-PAL-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (pk >= 0) -> {
        i = 0
        !! {
            (i >= n) -> { ** }
            dv-pal-type(pk, s.slice(i, cs-inc(i)))
            i = cs-inc(i)
        }
    }
    (pk < 0) -> {
        fh = DVA-FOCUS[0]: {
            ok -> it

            -> -1
        }
        (fh >= 0) -> {
            i = 0
            !! {
                (i >= n) -> { ** }
                input-append(fh, s.slice(i, cs-inc(i)))
                i = cs-inc(i)
            }
        }
        (fh < 0) -> {
            ek = DVA-EDIT-FOCUS[0]: {
                ok -> it

                -> -1
            }
            (ek >= 0) -> {
                v = dv-node-by-key(ek)
                (v >= 0) -> {
                    slot = dv-edit-of(v)
                    (slot >= 0) -> {
                        i = 0
                        !! {
                            (i >= n) -> { ** }
                            dv-edit-insert(slot, s.slice(i, cs-inc(i)))
                            i = cs-inc(i)
                        }
                    }
                }
            }
        }
    }
}

; 阶段76：剪贴板组件右端的「复制方块」命中检测 + 复制。
; 几何与 cs-paint-clipboard 逐字对齐（内边距 1200、方块 2400），命中就把该
; 组件的文本写进系统剪贴板并回报 1（调用方据此跳过普通派发）。
dva-clipboard-hit = (h i64, px i64, py i64) (used i64) {
    used = 0
    (h < 0) -> return
    (cmp-kind(h) != C-CLIPBOARD) -> return
    x = CMP-X[h]: {
        ok -> it

        -> -1
    }
    y = CMP-Y[h]: {
        ok -> it

        -> -1
    }
    w = CMP-W[h]: {
        ok -> it

        -> -1
    }
    ht = CMP-H[h]: {
        ok -> it

        -> -1
    }
    ((x < 0) || (y < 0) || (w <= 0) || (ht <= 0)) -> return
    cw = 2400
    bx = cs-sub(cs-sub(cs-add(x, w), 1200), cw)
    by = cs-add(y, cs-div(cs-sub(ht, cw), 2))
    ((px >= bx) && (py >= by) && (px < cs-add(bx, cw)) && (py < cs-add(by, cw))) -> {
        app-clipboard-copy(clip-content(h))
        used = 1
    }
    used = used
}

; ============================================================================
; 受控输入：字符串状态池 <-> 输入类组件的双向同步
; ============================================================================
; 视图侧用 dv-bind(node, slot, max) 声明「这个输入框的文本 = T[slot]」。
; 每帧一次：组件文本变了 -> 写回 DV-BIND-T[slot]；该槽被归约器 / reset 改了 -> 推回组件。
; shadow（DVA-BIND-LAST）记住上一次同步值，用来分辨「谁改了谁」，避免互相覆盖。
DVA-BIND-LAST []str = with-len(0)

dva-last-ensure = (slot i64) () {
    !! {
        (DVA-BIND-LAST.len() > slot) -> { ** }
        DVA-BIND-LAST.push('')
    }
}
dva-last-get = (slot i64) (s str) {
    s = DVA-BIND-LAST[slot]: {
        ok -> it

        -> ''
    }
}

; 字符串池就是 dv 侧的 DV-BIND-T（应用用 dv-bound / dv-bound-set 读写）
dva-str-get = (i i64) (s str) {
    s = dv-bound(i)
}
dva-str-set = (i i64, s str) () {
    dv-bound-set(i, s)
}

dva-sync-binds = (root i64) () {
    n = dv-node-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        slot = dv-bind-of(i)
        (slot >= 0) -> {
            live = dv-live-deep(root, dv-key(i))
            (live >= 0) -> {
                (dva-is-input-kind(cmp-kind(live)) == 1) -> {
                    dva-last-ensure(slot)
                    mx = dv-bind-max-of(i)
                    ; 用「原始组件文本」与 shadow 比：超长被截断后仍能和上次区分开
                    raw = input-value(live)
                    last = dva-last-get(slot)
                    (raw != last) -> {
                        ; 组件侧变了（含用户敲字）：截到 max，写回状态与组件
                        capped = dv-bound-cap(raw, mx)
                        dva-str-set(slot, capped)
                        cmp-set-text(live, capped)
                        DVA-BIND-LAST[slot] = capped
                    }
                    (raw == last) -> {
                        ; 组件没动：状态侧被归约器 / reset 改了就推回组件
                        tv = dva-str-get(slot)
                        capped = dv-bound-cap(tv, mx)
                        (tv != capped) -> { dva-str-set(slot, capped) }
                        (capped != last) -> {
                            cmp-set-text(live, capped)
                            DVA-BIND-LAST[slot] = capped
                        }
                    }
                }
            }
        }
        i = dv-inc(i)
    }
}

; ---------------------------------------------------------------------------
; hover 状态同步（阶段 17）：把「鼠标停在哪个视图节点上」写进状态池
; ---------------------------------------------------------------------------
; 视图节点用 dv-hover(node, slot) 声明「我被 hover 时把 1 写进 S[slot]」。
; 这里每帧按最近一次布局算出的命中 key（DVA-HIT）写 1/0 —— 于是 hover 也进得了
; UI = f(state)，视图再据此决定是否建一个锚在该节点上的 tooltip / hover-card。
; 值没变就不写，避免无谓的状态变更（写状态 = 通知应用「状态变了」）。
dva-sync-hover = (S []i64) () {
    hk = DVA-HIT[0]: {
        ok -> it

        -> -1
    }
    n = dv-node-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        slot = dv-hover-of(i)
        (slot >= 0) -> {
            v = 0
            (hk >= 0) -> {
                (cmp-key(hk) == dv-key(i)) -> { v = 1 }
            }
            cur = S[slot]: {
                ok -> it

                -> 0
            }
            (cur != v) -> { dva-set(S, slot, v) }
        }
        i = dv-inc(i)
    }
}

; ============================================================================
; 滚轮（阶段23）：让空间进状态
; ============================================================================
; 视图侧 dv-scroll 声明「偏移 = S[offslot]，步长 = value2」；这里只做几何：
; 光标命中 -> 顺着父链找到滚动容器 -> 读它的动作载荷（= 偏移槽）和最大偏移
; （布局阶段算好的 cmp-scroll-max）-> 夹紧后写回状态池。返回是否真的动了。
; 与滑杆同一模式：语义在视图上，换算在事件侧。
dva-wheel = (S []i64, root i64) (moved i64) {
    moved = 0
    dy = app-wheel()
    hit = cs-hit(root, dva-px(), dva-py())
    sh = hit
    !! {
        (sh < 0) -> { ** }
        (cmp-kind(sh) == C-SCROLL) -> { ** }
        sh = cmp-parent-of(sh)
    }
    (sh >= 0) -> {
        a5, p5 = dv-dispatch(cmp-key(sh))
        (a5 == DV-A-CHANGE) -> {
            lim = cmp-scroll-max(sh)
            cur = S[p5]: {
                ok -> it

                -> 0
            }
            st = cmp-value2(sh)
            nv = dv-clamp(dv-add(cur, cs-mul(dy, st)), 0, lim)
            (nv != cur) -> {
                dva-set(S, p5, nv)
                moved = 1
            }
        }
    }
}

; ============================================================================
; 拖分栏（阶段29）：间隙就是拖杆 —— 按下抓住 -> 移动写状态 -> 松开放手
; ============================================================================
; 视图侧 dv-dock-split 声明「左屏宽 = S[slot]，夹紧在 [value, value2]」；这里只做几何：
; 抓住时记下容器句柄，移动时按光标换算成左屏宽写回同一个槽。
; 与滚轮同一模式：语义在视图上，换算在事件侧。
;
; 为什么不用新增节点：两块面板之间的 gap 不属于任何子节点，cs-hit 的
; 「自身矩形兜底」会把它算到容器头上 —— 间隙自己就是拖杆的命中区。
; 只有落在 gap 里才算抓住（容器内边距不算，否则点空白就开始拖）。
DVA-DRAG []i64 = [-1]

; 点下：命中可拆面板的间隙 -> 抓住。返回 1 = 抓住了（调用方据此跳过点击路径）。
dva-drag-down = (S []i64, root i64, px i64, py i64) (grabbed i64) {
    grabbed = 0
    hit = cs-hit(root, px, py)
    (hit >= 0) -> {
        kd = cmp-kind(hit)
        ((kd == C-DOCK) || (kd == C-RESIZABLE)) -> {
            a6, p6 = dv-dispatch(cmp-key(hit))
            (a6 == DV-A-CHANGE) -> {
                c0 = cs-child-flow(hit, 0)
                (c0 >= 0) -> {
                    x0, y0, w0, h0 = cs-rect(c0)
                    g6 = cs-gap-of(hit)
                    ingap = 0
                    (cs-is-h(hit) == 1) -> {
                        bx = cs-add(x0, w0)
                        ((px >= bx) && (px <= cs-add(bx, g6))) -> { ingap = 1 }
                    }
                    (cs-is-h(hit) == 0) -> {
                        by = cs-add(y0, h0)
                        ((py >= by) && (py <= cs-add(by, g6))) -> { ingap = 1 }
                    }
                    (ingap == 1) -> {
                        DVA-DRAG[0] = hit
                        grabbed = 1
                    }
                }
            }
        }
    }
    grabbed
}

; 移动：把光标换算成左屏宽（横向 = px - 左屏左边；竖向 = py - 上屏上边），
; 夹紧到视图声明的 [value, value2]，写回状态槽。返回是否真的动了。
dva-drag-move = (S []i64, px i64, py i64) (moved i64) {
    moved = 0
    d = DVA-DRAG[0]: {
        ok -> it

        -> -1
    }
    (d >= 0) -> {
        a7, p7 = dv-dispatch(cmp-key(d))
        (a7 == DV-A-CHANGE) -> {
            c0 = cs-child-flow(d, 0)
            (c0 >= 0) -> {
                x0, y0, _, _ = cs-rect(c0)
                nv = 0
                (cs-is-h(d) == 1) -> { nv = cs-sub(px, x0) }
                (cs-is-h(d) == 0) -> { nv = cs-sub(py, y0) }
                nv = dv-clamp(nv, cmp-value(d), cmp-value2(d))
                cur = S[p7]: {
                    ok -> it

                    -> 0
                }
                (nv != cur) -> {
                    dva-set(S, p7, nv)
                    moved = 1
                }
            }
        }
    }
    moved
}

; 松开：清掉抓握。拖拽结束后鼠标继续移动不再改分栏。
dva-drag-up = () () {
    DVA-DRAG[0] = -1
}
; 当前抓握的容器句柄（-1 = 没在拖）。测试与调试用。
dva-drag-of = () (h i64) {
    h = DVA-DRAG[0]: {
        ok -> it

        -> -1
    }
}

; ============================================================================
; 阶段83：主指针按下 —— 鼠标左键 / 手指 / 压感笔共用这一条路径。
;
; 「按下去意味着什么」仍然由视图的 dv-act 决定，这里只做几何与派发：
; 拖分栏优先（间隙命中不算点击），否则命中 -> 焦点 -> 视图动作 -> 归约。
; 接触方式（压力、触摸标记）不改变语义，只通过 dva-touch / app-pressure()
; 让组件有机会区分「手写笔在画」和「鼠标在点」。
; ============================================================================
dva-press = (S []i64, root i64, px i64, py i64) () {
    DVA-PX[0] = px
    DVA-PY[0] = py
    DVA-MOUSE[0] = 1
    grab = dva-drag-down(S, root, px, py)
    (grab == 0) -> {
        hit = cs-hit(root, px, py)
        k = cmp-key(hit)
        dva-focus(hit)
        ; 剪贴板组件（阶段76）：点右端复制方块 = 内容进系统剪贴板，
        ; 该组件没有 dv-act，命中后就不再往下派发。
        clip = dva-clipboard-hit(hit, px, py)
        (clip == 0) -> {
            act, pay = dv-dispatch(k)
            nw = dv-app-reduce(S, k)
            (nw > 0) -> { DVA-CLICKS[0] = dv-add(DVA-CLICKS[0], 1) }
            dv-app-click(S, k, act, pay, nw)
        }
    }
}

; ============================================================================
; 声明式主循环
; ============================================================================
dva-run = (S []i64, title str, max-frames i64) () {
    r = app-init(title)
    root = app-root()
    ; 主题底色接上窗口（声明式主题的最后一块：连窗口背景也是数据）
    app-set-bg(cs-theme(CS-TH-BG))
    run = r == 0
    fr = 0
    !! {
        (run == 0) -> { ** }
        (fr >= max-frames) -> { ** }

        t, mx, my = app-poll()

        ; ---- 鼠标移动：hover 高亮 + 拖分栏（阶段29）----
        (t == 3) -> {
            px = fx(mx)
            py = fx(my)
            DVA-PX[0] = px
            DVA-PY[0] = py
            DVA-MOUSE[0] = 1
            app-hover(root, px, py)
            dva-drag-move(S, px, py)
        }

        ; ---- 主指针按下：鼠标左键 / 手指 / 压感笔共用一条路径（阶段83）----
        ; 「点击意味着什么」由视图节点的 dv-act 数据决定，循环里没有 key 的
        ; if-else 链；接触方式只通过 DVA-TOUCH / app-pressure() 暴露给组件。
        (t == 2) -> {
            dva-press(S, root, fx(mx), fx(my))
        }
        (t == 13 || t == 16) -> {
            DVA-TOUCH[0] = 1
            dva-press(S, root, fx(mx), fx(my))
        }

        ; ---- 主指针抬起：松开拖拽 + 清触摸标记 ----
        (t == 6 || t == 14 || t == 17) -> {
            px = fx(mx)
            py = fx(my)
            DVA-PX[0] = px
            DVA-PY[0] = py
            DVA-MOUSE[0] = 1
            dva-drag-up()
            DVA-TOUCH[0] = 0
        }

        ; ---- 手指 / 笔移动：与鼠标移动同语义（hover + 拖分栏）----
        (t == 15 || t == 18) -> {
            px = fx(mx)
            py = fx(my)
            DVA-PX[0] = px
            DVA-PY[0] = py
            DVA-MOUSE[0] = 1
            app-hover(root, px, py)
            dva-drag-move(S, px, py)
        }

        ; ---- 笔轴（阶段83）：压力 / 角度变化。只更新悬停位置与压力读数，
        ;      不产生点击语义 —— 手写笔在板上移动时笔尖未必接触。 ----
        (t == 23) -> {
            px = fx(mx)
            py = fx(my)
            DVA-PX[0] = px
            DVA-PY[0] = py
            DVA-MOUSE[0] = 1
            app-hover(root, px, py)
        }

        ; ---- 拖放（阶段84）：BEGIN 开会话；POS 记落点；COMPLETE 派发 ----
        ; 放置区 = 带 F-DROP flag 的组件（cmp-drop-zone）。语义走同一条
        ; dv-app-click 出口，动作码 DV-A-DROP，载荷槽 = 落点 key；被拖的
        ; 文件 / 文本由视图在回调里用 app-drop() 取。
        (t == 21) -> {
            DVA-DROP-ACTIVE[0] = 1
            DVA-DROP-TARGET[0] = -1
        }
        (t == 20) -> {
            px = fx(mx)
            py = fx(my)
            DVA-PX[0] = px
            DVA-PY[0] = py
            app-hover(root, px, py)
            hit = cs-hit(root, px, py)
            z = cmp-is-drop(hit)
            k = cmp-key(hit)
            (z) -> {
                DVA-DROP-TARGET[0] = k
                (k >= 0) -> { DVA-DROP-HITS[0] = dv-inc(DVA-DROP-HITS[0]) }
            }
            (!z) -> { DVA-DROP-TARGET[0] = -1 }
        }
        (t == 22) -> {
            k = DVA-DROP-TARGET[0]
            DVA-DROP-ACTIVE[0] = 0
            DVA-DROP-TARGET[0] = -1
            (k >= 0) -> {
                s = app-drop()
                nw = dv-app-reduce(S, k)
                DVA-DROPS[0] = dv-inc(DVA-DROPS[0])
                dv-app-click(S, k, DV-A-DROP, 0, nw)
            }
        }

        ; ---- 滚轮（阶段23）：命中 -> 顺着父链找滚动容器 -> 偏移进状态池 ----
        ; 语义仍在视图上：dv-scroll 声明「偏移 = S[offslot]，步长 = value2」；
        ; 几何（命中换算、最大偏移夹紧）留在事件侧，与滑杆同一模式。
        (t == 5) -> {
            px = fx(mx)
            py = fx(my)
            DVA-PX[0] = px
            DVA-PY[0] = py
            DVA-MOUSE[0] = 1
            dva-wheel(S, root)
        }

        ; ---- 文本输入（阶段76）：IME / Unicode。整段 UTF-8 交给焦点侧拆码点 ----
        (t == 7) -> {
            s = app-text()
            dva-type(s)
        }

        ; ---- 键盘：有面板焦点 -> 喂面板；有输入焦点 -> 喂输入框；有编辑器焦点 ->
        ;      喂编辑器；都没有 -> q 退出 + 全局快捷键 ----
        ; 快捷键语义：正在敲字时按键不触发全局动作（否则打不出 'r'）。阶段30：
        ; 编辑器也算「正在敲字」—— 否则打不出 'q'。阶段32：命令面板也算，
        ; 而且它排在最前 —— 面板开着时整段键盘归它（过滤、导航、执行、ESC 关闭）。
        (t == 4) -> {
            kk = mx.to-i64()
            pk = DVA-PAL-FOCUS[0]: {
                ok -> it

                -> -1
            }
            (pk >= 0) -> { dva-pal-keyboard(S, kk) }
            (pk < 0) -> {
                ; 阶段77：Tab / Shift-Tab 焦点遍历。编辑器聚焦时保留 Tab 缩进语义，
                ; 所以只在「非编辑器」时拦截；Shift 标记来自 app-shift()。
                (kk == 9) -> {
                    ek0 = DVA-EDIT-FOCUS[0]: {
                        ok -> it

                        -> -1
                    }
                    (ek0 < 0) -> {
                        dir = 1
                        (app-shift() == 1) -> { dir = -1 }
                        dva-focus-step(root, dir)
                    }
                }
                (kk != 9) -> {
                    ; 阶段81：Enter = 激活当前焦点的默认按钮（提交），优先于喂字符
                    (kk == 13) -> { dva-default-submit(S, root) }
                    (kk != 13) -> {
                    fh = DVA-FOCUS[0]: {
                        ok -> it

                        -> -1
                    }
                    (fh >= 0) -> { dva-keyboard(kk) }
                    (fh < 0) -> {
                        ek = DVA-EDIT-FOCUS[0]: {
                            ok -> it

                            -> -1
                        }
                        (ek >= 0) -> { dva-edit-keyboard(kk) }
                        (ek < 0) -> {
                            (kk == 113) -> { APP-QUIT[0] = 1 }
                            ha, hp, hk = dv-hot-dispatch(kk)
                            (ha != 0) -> {
                                nw2 = dv-app-reduce(S, hk)
                                (nw2 > 0) -> { DVA-CLICKS[0] = dv-add(DVA-CLICKS[0], 1) }
                                dv-app-click(S, hk, ha, hp, nw2)
                            }
                        }
                    }
                    }
                }
            }
        }

        ; ---- 退出 ----
        (app-quit()) -> { ** }
        (app-should-quit()) -> { ** }

        ; ---- hover -> 状态（必须在建视图之前，本帧就能看到 tooltip）----
        dva-sync-hover(S)

        ; ---- 状态 -> 视图 -> 活组件树（调和）----
        page = dv-app-view()
        ; 命令面板（阶段32）：哪个面板开着，键盘就归谁。必须在建视图**之后**问 ——
        ; 面板 key 是视图构建时才登记的。面板是模态的，它开着的时候输入框 /
        ; 编辑器都不该继续吃键盘（点面板里的输入框也不会抢走焦点，见 dva-focus）。
        pk2 = dv-pal-open-key(S)
        DVA-PAL-FOCUS[0] = pk2
        (pk2 >= 0) -> {
            fh2 = DVA-FOCUS[0]: {
                ok -> it

                -> -1
            }
            (fh2 >= 0) -> { input-focus(fh2, false) }
            DVA-FOCUS[0] = -1
            DVA-EDIT-FOCUS[0] = -1
        }
        ops = dv-render(root, page)
        DVA-OPS[0] = dv-add(DVA-OPS[0], ops)
        ; 受控输入：字符串状态 <-> 组件文本（必须在布局之前，文本影响宽度）
        dva-sync-binds(root)

        ; ---- 布局 -> 摊平 -> 上屏 ----
        cs-layout(root, 0, 0, app-win-wf(), app-win-hf())
        ; 布局已定：重算命中并缓存，供下一帧的 hover 状态同步（鼠标没动也要刷新，
        ; 因为布局可能变了 —— 例如 tooltip 出现把别的东西挤开）
        (DVA-MOUSE[0] == 1) -> {
            DVA-HIT[0] = cs-hit(root, dva-px(), dva-py())
        }
        cs-clear()
        cs-paint(root)
        app-frame()
        app-delay(16)

        fr = dv-inc(fr)
        DVA-FRAMES[0] = fr
    }

    ; 收尾：释放焦点、松手（阶段29）、关窗
    fh = DVA-FOCUS[0]: {
        ok -> it

        -> -1
    }
    (fh >= 0) -> { input-focus(fh, false) }
    DVA-FOCUS[0] = -1
    DVA-EDIT-FOCUS[0] = -1
    DVA-PAL-FOCUS[0] = -1
    dva-drag-up()
    app-shutdown()
}
