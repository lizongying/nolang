; ============================================================================
; noui 组件库 —— gpui-kit 86 模块的 Nolang API 层
; 单文件收敛：规避跨 # 模块的函数内 vec.push 限制（见 ARCHITECTURE.md §5.1）。
; 全部组件实例存于大写全局 SoA 池；不支持 vec-of-struct，字段一律平行数组。
; 组件清单见 components-catalog.md。
;
; 写法约束（均已实测）：
;   - 大写顶层数据，函数内读写合法；
;   - 计数自增用 `n + 1: { ok -> it  -> n }` 解包 option；
;   - guard 用 `(cond) -> { }`，`(cond) { }` 是 while；
;   - 字符串用单引号，追加用插值 `s = '{s}{x}'`。
; ============================================================================

; ---------- 组件 kind 常量（对应 components-catalog.md 的 83 项）----------
; A 基础
C-LABEL = 1
C-BUTTON = 2
C-BADGE = 3
C-TAG = 4
C-ICON = 5
C-KBD = 6
C-LINK = 7
C-SEPARATOR = 8
C-AVATAR = 9
C-EMPTY = 10
C-SPINNER = 11
C-MARKER = 12
; B 表单
C-CHECKBOX = 20
C-RADIO = 21
C-SWITCH = 22
C-INPUT = 23
C-TEXTAREA = 24
C-NUMBER-INPUT = 25
C-OTP-INPUT = 26
C-SEARCH = 27
C-SELECT = 28
C-COMBOBOX = 29
C-SLIDER = 30
C-STEPPER = 31
C-COLOR-PICKER = 32
C-DATE-PICKER = 33
C-FORM = 34
C-QUESTIONNAIRE = 35
; C 导航
C-TAB = 40
C-BREADCRUMB = 41
C-SIDEBAR = 42
C-MENU = 43
C-PAGINATION = 44
C-TOOLBAR = 45
C-TITLE-BAR = 46
C-STATUS-BAR = 47
C-COMMAND = 48
C-HISTORY = 49
; D 覆盖层/反馈
C-DIALOG = 50
C-POPOVER = 51
C-TOOLTIP = 52
C-HOVER-CARD = 53
C-NOTIFICATION = 54
C-ALERT = 55
C-MESSAGE = 56
C-MESSAGE-SCROLLER = 57
C-SHEET = 58
C-PROGRESS = 59
C-SKELETON = 60
C-SHIMMER = 61
C-BUBBLE = 62
C-SPEECH = 63
C-INSPECTOR = 64
C-WINDOW-BORDER = 65
C-NATIVE-MENU = 66
C-ATTACHMENT = 67
; E 数据展示
C-TABLE = 70
C-LIST = 71
C-VIRTUAL-LIST = 72
C-TREE = 73
C-ACCORDION = 74
C-CAROUSEL = 75
C-CHART = 76
C-PLOT = 77
C-RATING = 78
C-DESCRIPTION-LIST = 79
C-GROUP-BOX = 80
C-COLLAPSIBLE = 81
C-DIFF = 82
C-HIGHLIGHTER = 83
C-CLIPBOARD = 84
C-SCROLL = 85
; F 布局/容器
C-RESIZABLE = 90
C-DOCK = 91
C-GRID = 92
C-TEXT = 93
C-THEME = 94
C-SIZING = 95
C-STYLED = 96
C-ROOT = 97
C-WINDOW-EXT = 98
; G 其他
C-SEARCHABLE-LIST = 99
C-INDEX-PATH = 100

; ---------- flag 位（CMP-FLAGS 用位或组合）----------
F-VISIBLE = 1
F-ENABLED = 2
F-FOCUSED = 4
F-HOVERED = 8
F-CHECKED = 16
F-OPEN = 32
F-DISABLED = 64
F-SELECTED = 128
F-ACTIVE = 256
F-OVERLAY = 512 ; 叠加层：不参与父级流布局，改为在父矩形内居中，命中时先于兄弟（模态）
F-PASS = 1024    ; 非模态叠加层（tooltip / hover-card / 通知）：仍最后画、仍可命中，
                 ; 但不设模态屏障 —— 没命中就继续找下面的兄弟（点得穿）

; ---------- 布局提示位（CMP-LAY 用位或组合；声明式视图层同步过来）----------
; 让「怎么排」也变成数据：容器方向 / 子节点拉伸 / 交叉轴对齐。
; 0 = 无提示（走 cmp-scene 的默认：容器纵向堆叠，C-GRID 横向）。
L-H = 1        ; 容器：横向排列（等价 C-GRID 的行为）
L-GROW = 2     ; 子节点：吃掉主轴剩余空间（容器给它多余的那份）
L-AE = 4       ; 子节点：交叉轴末端对齐（纵向容器靠右 / 横向容器靠下）
L-AC = 8       ; 子节点：交叉轴居中

; ---------- 尺寸 / 文本对齐提示（CMP-SW / CMP-SH / CMP-ALIGN）----------
; 让「多大」「字怎么对齐」也变成数据。0 = 自动（走 cs-measure 的 intrinsic 尺寸），
; 非 0 = 覆盖：cs-layout 直接按这个尺寸摆，cs-measure 也按这个尺寸报。
; 对齐：0 = 按 kind 的默认（label/text 左对齐，button/badge 等居中），
; 1 = 左，2 = 中，3 = 右。
A-LEFT = 1
A-CENTER = 2
A-RIGHT = 3

; ---------- 组件实例 SoA 池 ----------
CMP-KIND []i64 = with-len(0)
CMP-TEXT []str = with-len(0)        ; 主文本 / 标题 / 输入缓冲
CMP-TEXT2 []str = with-len(0)       ; 副文本 / placeholder / 副标题
CMP-COLOR []i64 = with-len(0)       ; 打包颜色 0xRRGGBBAA
CMP-VALUE []i64 = with-len(0)       ; 主数值（value / count / page）
CMP-VALUE2 []i64 = with-len(0)      ; 次数值（max / total / active）
CMP-VALUE3 []i64 = with-len(0)      ; 第三数值
CMP-X []i64 = with-len(0)           ; 布局盒，定点坐标（值*100）
CMP-Y []i64 = with-len(0)
CMP-W []i64 = with-len(0)
CMP-H []i64 = with-len(0)
CMP-FLAGS []i64 = with-len(0)
CMP-PARENT []i64 = with-len(0)
CMP-HEAD []i64 = with-len(0)        ; 子节点表起始
CMP-COUNT []i64 = with-len(0)       ; 子节点数
CMP-KEY []i64 = with-len(0)         ; 声明式视图层的稳定 key（-1 = 无）
CMP-LAY []i64 = with-len(0)         ; 布局提示位（L-*），0 = 默认行为
CMP-GAP []i64 = with-len(0)         ; 容器兄弟间距覆盖（0 = 默认 CS-GAP）
CMP-PAD []i64 = with-len(0)         ; 容器内边距覆盖（0 = 默认 CS-PAD）
CMP-SW []i64 = with-len(0)          ; 固定宽覆盖（0 = 自动 / intrinsic）
CMP-SH []i64 = with-len(0)          ; 固定高覆盖（0 = 自动 / intrinsic）
CMP-ALIGN []i64 = with-len(0)       ; 文本对齐（0 = 按 kind 默认，A-LEFT/CENTER/RIGHT）
CMP-VAR []i64 = with-len(0)         ; 变体（0 = 默认；非 0 时取主题语义色，见 cmp-scene cs-var-color）
CMP-ANCHOR []i64 = with-len(0)      ; 锚定浮层的锚点 key（-1 = 无锚点 -> 退化为父矩形内居中）
CHILD-IDX []i64 = with-len(0)

; ============================================================================
; 通用基础设施
; ============================================================================

; 内部：追加一个组件槽，返回句柄（所有构造函数共用）
cmp-alloc = (kind i64, text str, text2 str, color i64, value i64) (h i64) {
    CMP-KIND.push(kind)
    CMP-TEXT.push(text)
    CMP-TEXT2.push(text2)
    CMP-COLOR.push(color)
    CMP-VALUE.push(value)
    CMP-VALUE2.push(0)
    CMP-VALUE3.push(0)
    CMP-X.push(0)
    CMP-Y.push(0)
    CMP-W.push(0)
    CMP-H.push(0)
    CMP-FLAGS.push(F-VISIBLE | F-ENABLED)
    CMP-PARENT.push(-1)
    CMP-HEAD.push(-1)
    CMP-COUNT.push(0)
    CMP-KEY.push(-1)
    CMP-LAY.push(0)
    CMP-GAP.push(0)
    CMP-PAD.push(0)
    CMP-SW.push(0)
    CMP-SH.push(0)
    CMP-ALIGN.push(0)
    CMP-VAR.push(0)
    CMP-ANCHOR.push(-1)
    h = CMP-KIND.len() - 1
}

; 组件总数
cmp-count = () (n i64) {
    n = CMP-KIND.len()
}

; getter：类型 / 文本 / 数值 / flag
cmp-kind = (h i64) (k i64) {
    v = CMP-KIND[h]: {
        ok -> it

        -> 0
    }
    k = v
}
cmp-text = (h i64) (s str) {
    s = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
}
cmp-text2 = (h i64) (s str) {
    s = CMP-TEXT2[h]: {
        ok -> it

        -> ''
    }
}
cmp-value = (h i64) (v i64) {
    x = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-value2 = (h i64) (v i64) {
    x = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-flags = (h i64) (f i64) {
    x = CMP-FLAGS[h]: {
        ok -> it

        -> 0
    }
    f = x
}
cmp-valid = (h i64) (ok bool) {
    ok = h >= 0 && h < CMP-KIND.len()
}

; flag 查询
cmp-has = (h i64, bit i64) (yes bool) {
    yes = (CMP-FLAGS[h] & bit) != 0
}
; 渲染层用的只读 getter（下标读统一走 match 解包，保持 vet 干净）
cmp-color = (h i64) (c i64) {
    v = CMP-COLOR[h]: {
        ok -> it

        -> 0
    }
    c = v
}
cmp-children = (h i64) (n i64) {
    v = CMP-COUNT[h]: {
        ok -> it

        -> 0
    }
    n = v
}
; 子链表在 CHILD-IDX 中的起始槽位（声明式调和器做 key→slot 映射时用）
cmp-head = (h i64) (v i64) {
    x = CMP-HEAD[h]: {
        ok -> it

        -> -1
    }
    v = x
}
; 声明式 key 读写（调和器据此跨帧复用组件对象）
cmp-key = (h i64) (v i64) {
    x = CMP-KEY[h]: {
        ok -> it

        -> -1
    }
    v = x
}
cmp-set-key = (h i64, k i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-KEY[h] = k }
}
cmp-value3 = (h i64) (v i64) {
    x = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
    v = x
}

; 布局提示读写（声明式视图层 dv-lay 的落点；cmp-scene 布局时消费）
cmp-lay = (h i64) (v i64) {
    x = CMP-LAY[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-gap = (h i64) (v i64) {
    x = CMP-GAP[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-pad = (h i64) (v i64) {
    x = CMP-PAD[h]: {
        ok -> it

        -> 0
    }
    v = x
}

; 尺寸 / 文本对齐提示读写（dv-size / dv-align 的落点）
cmp-sw = (h i64) (v i64) {
    x = CMP-SW[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-sh = (h i64) (v i64) {
    x = CMP-SH[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-align = (h i64) (v i64) {
    x = CMP-ALIGN[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-var = (h i64) (v i64) {
    x = CMP-VAR[h]: {
        ok -> it

        -> 0
    }
    v = x
}

; 通用 setter
cmp-set-text = (h i64, s str) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-TEXT[h] = s }
}
cmp-set-text2 = (h i64, s str) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-TEXT2[h] = s }
}
cmp-set-color = (h i64, c i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-COLOR[h] = c }
}
cmp-set-value = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-VALUE[h] = v }
}
cmp-set-value2 = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-VALUE2[h] = v }
}
cmp-set-lay = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-LAY[h] = v }
}
cmp-set-gap = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-GAP[h] = v }
}
cmp-set-pad = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-PAD[h] = v }
}
cmp-set-sw = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-SW[h] = v }
}
cmp-set-sh = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-SH[h] = v }
}
cmp-set-align = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-ALIGN[h] = v }
}
cmp-set-var = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-VAR[h] = v }
}
; 锚定浮层的锚点 key（-1 = 无锚点）。cmp-scene 布局时按 key 反查锚点活节点矩形，
; 把浮层放在锚点下方（贴边时翻到上方）并夹紧在父矩形内；锚点找不到则退化为居中。
cmp-anchor = (h i64) (v i64) {
    x = CMP-ANCHOR[h]: {
        ok -> it

        -> -1
    }
    v = x
}
cmp-set-anchor = (h i64, k i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-ANCHOR[h] = k }
}
cmp-set-bounds = (h i64, x i64, y i64, w i64, ht i64) {
    (h >= 0 && h < CMP-KIND.len()) -> {
        CMP-X[h] = x
        CMP-Y[h] = y
        CMP-W[h] = w
        CMP-H[h] = ht
    }
}
cmp-flag-set = (h i64, bit i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-FLAGS[h] = CMP-FLAGS[h] | bit }
}
cmp-flag-clear = (h i64, bit i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ bit) }
}

; 父子挂载（用于容器类组件）
cmp-add-child = (parent i64, child i64) {
    (parent < 0 || child < 0) -> return
    cnt = CMP-COUNT[parent]
    (cnt == 0) -> { CMP-HEAD[parent] = CHILD-IDX.len() }
    CHILD-IDX.push(child)
    nc = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-COUNT[parent] = nc
    CMP-PARENT[child] = parent
}
cmp-child = (parent i64, i i64) (c i64) {
    c = -1
    cnt = CMP-COUNT[parent]: {
        ok -> it

        -> 0
    }
    (i >= 0 && i < cnt) -> {
        hd = CMP-HEAD[parent]: {
            ok -> it

            -> -1
        }
        s = hd + i: {
            ok -> it

            -> -1
        }
        v = CHILD-IDX[s]: {
            ok -> it

            -> -1
        }
        c = v
    }
}

; 从父组件上摘除子组件（保留子树本身，仅解除挂载关系）
; 供声明式视图层的调和器做「删除」操作：把 CHILD-IDX 中该槽左移压实，
; 并修正所有 head 落在被删槽之后的父组件。返回是否真的摘掉了。
cmp-detach = (parent i64, child i64) (ok bool) {
    ok = false
    (parent >= 0 && child >= 0) -> {
        cnt = CMP-COUNT[parent]: {
            ok -> it

            -> 0
        }
        hd = CMP-HEAD[parent]: {
            ok -> it

            -> -1
        }
        (cnt > 0 && hd >= 0) -> {
            pos = -1
            i = 0
            !! {
                (i >= cnt) -> { ** }
                s = hd + i: {
                    ok -> it

                    -> -1
                }
                v = CHILD-IDX[s]: {
                    ok -> it

                    -> -1
                }
                (v == child) -> {
                    pos = s
                    **
                }
                ni = i + 1: {
                    ok -> it

                    -> i
                }
                i = ni
            }
            (pos >= 0) -> {
                ; CHILD-IDX 是全局扁平数组：删掉一槽后，其后所有元素（包括别的父的子链）
                ; 都要整体左移一格，否则后续父的 head 会指错位置。
                last = CHILD-IDX.len()
                j = pos
                !! {
                    nj = j + 1: {
                        ok -> it

                        -> j
                    }
                    (nj >= last) -> { ** }
                    v = CHILD-IDX[nj]: {
                        ok -> it

                        -> -1
                    }
                    CHILD-IDX[j] = v
                    j = nj
                }
                nl = CHILD-IDX.len()
                keep = nl - 1: {
                    ok -> it

                    -> nl
                }
                CHILD-IDX.truncate(keep)
                nc = cnt - 1: {
                    ok -> it

                    -> 0
                }
                CMP-COUNT[parent] = nc
                CMP-PARENT[child] = -1
                n = CMP-KIND.len()
                p = 0
                !! {
                    (p >= n) -> { ** }
                    hp = CMP-HEAD[p]: {
                        ok -> it

                        -> -1
                    }
                    (hp > pos) -> {
                        nh = hp - 1: {
                            ok -> it

                            -> hp
                        }
                        CMP-HEAD[p] = nh
                    }
                    np = p + 1: {
                        ok -> it

                        -> p
                    }
                    p = np
                }
                ok = true
            }
        }
    }
}

; ============================================================================
; 全目录构造函数（83 个）—— 每个返回组件句柄，核心属性走 cmp-set-*
; 统一走 cmp-alloc(kind, 主文本, 副文本, 颜色, 主数值)
; ============================================================================

; A 基础
cmp-label = (text str) (h i64) {
    h = cmp-alloc(C-LABEL, text, '', 0xE8E8F0FF, 0)
}
cmp-button = (text str) (h i64) {
    h = cmp-alloc(C-BUTTON, text, '', 0x4A90E2FF, 0)
}
cmp-badge = (text str) (h i64) {
    h = cmp-alloc(C-BADGE, text, '', 0x4A90E2FF, 0)
}
cmp-tag = (text str) (h i64) {
    h = cmp-alloc(C-TAG, text, '', 0x2A2A3AFF, 0)
}
cmp-icon = (name str) (h i64) {
    h = cmp-alloc(C-ICON, name, '', 0xE8E8F0FF, 0)
}
cmp-kbd = (key str) (h i64) {
    h = cmp-alloc(C-KBD, key, '', 0x9AA0B4FF, 0)
}
cmp-link = (text str) (h i64) {
    h = cmp-alloc(C-LINK, text, '', 0x4A90E2FF, 0)
}
cmp-separator = () (h i64) {
    h = cmp-alloc(C-SEPARATOR, '', '', 0x3A3A4AFF, 0)
}
cmp-avatar = (name str) (h i64) {
    h = cmp-alloc(C-AVATAR, name, '', 0x4A90E2FF, 0)
}
cmp-empty = (text str) (h i64) {
    h = cmp-alloc(C-EMPTY, text, '', 0x9AA0B4FF, 0)
}
cmp-spinner = () (h i64) {
    h = cmp-alloc(C-SPINNER, '', '', 0x4A90E2FF, 0)
}
cmp-marker = (text str) (h i64) {
    h = cmp-alloc(C-MARKER, text, '', 0x50C878FF, 0)
}

; B 表单
cmp-checkbox = (text str) (h i64) {
    h = cmp-alloc(C-CHECKBOX, text, '', 0xE8E8F0FF, 0)
}
cmp-radio = (text str) (h i64) {
    h = cmp-alloc(C-RADIO, text, '', 0xE8E8F0FF, 0)
}
cmp-switch = () (h i64) {
    h = cmp-alloc(C-SWITCH, '', '', 0x3A3A4AFF, 0)
}
cmp-input = (placeholder str) (h i64) {
    h = cmp-alloc(C-INPUT, '', placeholder, 0xE8E8F0FF, 0)
}
cmp-textarea = (placeholder str) (h i64) {
    h = cmp-alloc(C-TEXTAREA, '', placeholder, 0xE8E8F0FF, 0)
}
cmp-number-input = () (h i64) {
    h = cmp-alloc(C-NUMBER-INPUT, '', '', 0xE8E8F0FF, 0)
}
cmp-otp-input = (slots i64) (h i64) {
    h = cmp-alloc(C-OTP-INPUT, '', '', 0xE8E8F0FF, slots)
}
cmp-search = () (h i64) {
    h = cmp-alloc(C-SEARCH, '', 'Search...', 0xE8E8F0FF, 0)
}
cmp-select = (placeholder str) (h i64) {
    h = cmp-alloc(C-SELECT, '', placeholder, 0xE8E8F0FF, 0)
}
cmp-combobox = () (h i64) {
    h = cmp-alloc(C-COMBOBOX, '', '', 0xE8E8F0FF, 0)
}
cmp-slider = (min i64, max i64) (h i64) {
    h = cmp-alloc(C-SLIDER, '', '', 0x4A90E2FF, min)
    CMP-VALUE2[h] = max
}
cmp-stepper = () (h i64) {
    h = cmp-alloc(C-STEPPER, '', '', 0xE8E8F0FF, 0)
}
cmp-color-picker = () (h i64) {
    h = cmp-alloc(C-COLOR-PICKER, '', '', 0x4A90E2FF, 0)
}
cmp-date-picker = () (h i64) {
    h = cmp-alloc(C-DATE-PICKER, '', '', 0xE8E8F0FF, 0)
}
cmp-form = () (h i64) {
    h = cmp-alloc(C-FORM, '', '', 0x1E1E28FF, 0)
}
cmp-questionnaire = () (h i64) {
