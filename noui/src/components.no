TLB-N []i64 = with-len(0)
TLB-CUR []i64 = with-len(0)

; 阶段69：sidebar 的分组 / 条目池（都是扁平只增）+ 每句柄基址与计数 + 折叠位
;   SDB-GROUP   组标题（扁平，每次 sdb-add-group 一条）
;   SDB-GSBASE  每句柄组基址
;   SDB-GNC     每句柄组数
;   SDB-ITEM    条目标签（扁平，每次 sdb-add-item 一条）
;   SDB-ITOG    每条条目属于哪个组（与 SDB-ITEM 平行）
;   SDB-ISBASE  每句柄条目基址
;   SDB-IN      每句柄条目数
;   SDB-COLL    每句柄折叠位（0 展开 / 1 折叠）
SDB-GROUP []str = with-len(0)
SDB-GSBASE []i64 = with-len(0)
SDB-GNC []i64 = with-len(0)
SDB-ITEM []str = with-len(0)
SDB-ITOG []i64 = with-len(0)
SDB-ISBASE []i64 = with-len(0)
SDB-IN []i64 = with-len(0)
SDB-COLL []i64 = with-len(0)

; 阶段70：sheet 的展开位 / 停靠边（每句柄）
;   side: 0=左 1=右 2=上 3=下
SHT-OPEN []i64 = with-len(0)
SHT-SIDE []i64 = with-len(0)

; 阶段71：text-node 的样式片段池（扁平只增）+ 每句柄基址 / 片段数
;   片段颜色 -1 = 继承组件自身 CMP-COLOR[h]
TXN-RUN []str = with-len(0)
TXN-COL []i64 = with-len(0)
TXN-SBASE []i64 = with-len(0)
TXN-N []i64 = with-len(0)
INP-C-KW = 0x4A90E2FF              ; 关键字 / 标识符强调

; 阶段72：sizing（尺寸约束盒）的目标 / 下限 / 上限（每句柄）
;   0 一律表示「未指定」：目标 0 = 跟随内容，下限 0 = 无下限，
;   上限 0 = 无上限（下限 / 上限仍受通用叶子下限兜底）。
SZG-W []i64 = with-len(0)
SZG-H []i64 = with-len(0)
SZG-MINW []i64 = with-len(0)
SZG-MINH []i64 = with-len(0)
SZG-MAXW []i64 = with-len(0)
SZG-MAXH []i64 = with-len(0)

; 阶段73：styled（基础样式容器）的底色 / 边框色 / 边框厚度（每句柄）
;   STY-BG = -1 表示继承组件自身 CMP-COLOR[h]；
;   STY-BC = -1 或 STY-BW = 0 表示不画框。
STY-BG []i64 = with-len(0)
STY-BC []i64 = with-len(0)
STY-BW []i64 = with-len(0)

; 阶段74：shimmer（扫光占位）的周期 / 高光带宽 / 高光色（每句柄）
;   SHM-DUR  = 一次扫光时长（毫秒），0 = 默认 1200；
;   SHM-BAND = 高光带宽（占宽度百分比 0..100），0 = 默认 30；
;   SHM-COL  = 高光色，-1 = 用主题 MUTED（旧行为）。
;   相位仍走 CMP-VALUE[h]（0..100，0 = 不扫），与既有渲染分支一致。
SHM-DUR []i64 = with-len(0)
SHM-BAND []i64 = with-len(0)
SHM-COL []i64 = with-len(0)

; 阶段75：window-border（窗口描边容器）的圆角半径 / 边框厚度（每句柄）
;   WB-RAD = 四角统一圆角半径（px*100），0 = 直角；
;   WB-W   = 边框厚度（px*100），0 = 不画框。
;   边框色沿用组件自身 CMP-COLOR[h]，面板底固定用主题 FIELD。
WB-RAD []i64 = with-len(0)
WB-W []i64 = with-len(0)
INP-C-STR = 0x50C878FF             ; 字符串
INP-C-COM = 0x9AA0B4FF             ; 注释（nolang 的 `;` 到行尾）

; ============================================================================
; 通用基础设施
; ============================================================================

; 内部：追加一个组件槽，返回句柄（所有构造函数共用）
cmp-alloc = (kind i64, text str, text2 str, color i64, value i64) (h i64) {
    CMP-KIND.push(kind)
    CMP-TEXT.push(text)
    CMP-TEXT2.push(text2)
    CMP-COLOR.push(color)
    CMP-VALUE.push(value)
    CMP-VALUE2.push(0)
    CMP-VALUE3.push(0)
    CMP-VALUE4.push(0)
    CMP-X.push(0)
    CMP-Y.push(0)
    CMP-W.push(0)
    CMP-H.push(0)
    CMP-FLAGS.push(F-VISIBLE | F-ENABLED)
    CMP-PARENT.push(-1)
    CMP-HEAD.push(-1)
    CMP-COUNT.push(0)
    CMP-KEY.push(-1)
    CMP-LAY.push(0)
    CMP-GAP.push(0)
    CMP-PAD.push(0)
    CMP-SW.push(0)
    CMP-SH.push(0)
    CMP-ALIGN.push(0)
    CMP-VAR.push(0)
    CMP-ANCHOR.push(-1)
    CMP-SCROLL-MAX.push(0)
    CMP-SCROLL-CONTENT.push(0)
    CMP-SCROLL-START.push(0)
    ; 阶段33：树模型池随每个组件槽一起长（下标 = 句柄）
    TR-PAR.push(-1)
    TR-FIRST.push(-1)
    TR-NEXT.push(-1)
    TR-OPEN.push(0)
    TR-ROW-NODE.push(-1)
    TR-ARROW.push(-1)
    TR-TSTART.push(0)
    TR-TCOUNT.push(0)
    ; 阶段34：编辑器状态池随每个组件槽一起长（下标 = 句柄）
    ED-L.push(0)
    ED-C.push(0)
    ED-SEEN.push(-1)
    ED-ROW.push(0)
    ; 阶段35：表格状态池随每个组件槽一起长（下标 = 句柄）
    TB-OFF.push(0)
    TB-SEL.push(-1)
    TB-HEAD-H.push(-1)
    TB-SCR-H.push(-1)
    TB-ROW-SRC.push(-1)
    TB-CELL-SRC.push(-1)
    TB-CELL-COL.push(-1)
    ; 阶段36：可拆面板标记 / 分栏位置随每个组件槽一起长
    DK-SPLIT.push(0)
    DK-SPLIT-V.push(0)
    ; 阶段37：命令面板状态池随每个组件槽一起长（下标 = 句柄）
    CP-CUR.push(-1)
    CP-OFF.push(0)
    CP-SB.push(0)
    CP-INP-H.push(-1)
    CP-SCR-H.push(-1)
    CP-ROW-SRC.push(-1)
    ; 阶段38：输入框光标 / 高亮开关 / 段基址（下标 = 句柄；段池本身只增）
    INP-CAR.push(0)
    INP-SY.push(0)
    INP-SGO.push(0)
    INP-SGN.push(0)
    ; 阶段39：文本域视口首行
    TA-OFF.push(0)
    ; 阶段41：OTP 定长码 + 活动槽
    OT-CODE.push('')
    OT-CUR.push(0)
    ; 阶段42：combobox 过滤匹配表
    CB-MBASE.push(0)
    CB-MN.push(0)
    CB-MCUR.push(-1)
    ; 阶段46：index-path 段池随每个组件槽一起长
    IP-SBASE.push(0)
    IP-SN.push(0)
    ; 阶段53：breadcrumb 条目池随每个组件槽一起长（分隔符默认「 / 」）
    BC-SBASE.push(0)
    BC-N.push(0)
    BC-SEP.push(' / ')
    ; 阶段55：description-list 行池随每个组件槽一起长
    DL-SBASE.push(0)
    DL-N.push(0)
    ; 阶段56：accordion 组池随每个组件槽一起长
    AC-SBASE.push(0)
    AC-N.push(0)
    ; 阶段57：carousel 幻灯片池随每个组件槽一起长
    CR-SBASE.push(0)
    CR-N.push(0)
    ; 阶段58：collapsible 正文行池随每个组件槽一起长
    CL-SBASE.push(0)
    CL-N.push(0)
    ; 阶段60：history 条目池随每个组件槽一起长（条目池本身只增）
    HST-SBASE.push(0)
    HST-N.push(0)
    ; 阶段61：inspector 字段池随每个组件槽一起长（字段池本身只增）
    IN-SBASE.push(0)
    IN-N.push(0)
    ; 阶段62：message-scroller 消息池随每个组件槽一起长（消息池本身只增）
    MS-SBASE.push(0)
    MS-N.push(0)
    ; 阶段63：status-bar 分段池随每个组件槽一起长（分段池本身只增）
    SB-SBASE.push(0)
    SB-N.push(0)
    ; 阶段64：popover 正文行池随每个组件槽一起长（行池本身只增）
    PV-SBASE.push(0)
    PV-N.push(0)
    ; 阶段65：questionnaire 题池随每个组件槽一起长（题池本身只增）
    QA-SBASE.push(0)
    QA-N.push(0)
    ; 阶段66：searchable-list 的条目池 / 匹配表随每个组件槽一起长（池本身只增）
    SL-SBASE.push(0)
    SL-N.push(0)
    SL-MBASE.push(0)
    SL-MN.push(0)
    SL-CUR.push(-1)
    ; 阶段67：title-bar 按钮池随每个组件槽一起长（池本身只增）
    TTB-SBASE.push(0)
    TTB-N.push(0)
    ; 阶段68：toolbar 条目池随每个组件槽一起长（池本身只增）
    TLB-SBASE.push(0)
    TLB-N.push(0)
    TLB-CUR.push(-1)
    ; 阶段69：sidebar 分组 / 条目池随每个组件槽一起长（池本身只增）
    SDB-GSBASE.push(0)
    SDB-GNC.push(0)
    SDB-ISBASE.push(0)
    SDB-IN.push(0)
    SDB-COLL.push(0)
    ; 阶段70：sheet 展开位 / 停靠边随每个组件槽一起长
    SHT-OPEN.push(0)
    SHT-SIDE.push(0)
    ; 阶段71：text-node 片段池随每个组件槽一起长（池本身只增）
    TXN-SBASE.push(0)
    TXN-N.push(0)
    ; 阶段72：sizing 的目标 / 下限 / 上限随每个组件槽一起长
    SZG-W.push(0)
    SZG-H.push(0)
    SZG-MINW.push(0)
    SZG-MINH.push(0)
    SZG-MAXW.push(0)
    SZG-MAXH.push(0)
    ; 阶段73：styled 的底色 / 边框色 / 边框厚度随每个组件槽一起长
    ;   （-1 / -1 / 0 = 「无覆写」的默认语义，与 sty-* getter 一致）
    STY-BG.push(-1)
    STY-BC.push(-1)
    STY-BW.push(0)
    ; 阶段74：shimmer 的周期 / 带宽 / 高光色随每个组件槽一起长
    SHM-DUR.push(0)
    SHM-BAND.push(0)
    SHM-COL.push(-1)
    ; 阶段75：window-border 的圆角半径 / 边框厚度随每个组件槽一起长
    WB-RAD.push(0)
    WB-W.push(0)
    h = CMP-KIND.len() - 1
}

; 组件总数
cmp-count = () (n i64) {
    n = CMP-KIND.len()
}

; getter：类型 / 文本 / 数值 / flag
cmp-kind = (h i64) (k i64) {
    v = CMP-KIND[h]: {
        ok -> it

        -> 0
    }
    k = v
}
cmp-text = (h i64) (s str) {
    s = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
}
cmp-text2 = (h i64) (s str) {
    s = CMP-TEXT2[h]: {
        ok -> it

        -> ''
    }
}
cmp-value = (h i64) (v i64) {
    x = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-value2 = (h i64) (v i64) {
    x = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-flags = (h i64) (f i64) {
    x = CMP-FLAGS[h]: {
        ok -> it

        -> 0
    }
    f = x
}
; 阶段23：父句柄（滚轮命中要顺着链向外找滚动容器）；-1 = 没有父
cmp-parent-of = (h i64) (v i64) {
    x = CMP-PARENT[h]: {
        ok -> it

        -> -1
    }
    v = x
}
cmp-valid = (h i64) (ok bool) {
    ok = h >= 0 && h < CMP-KIND.len()
}

; flag 查询
cmp-has = (h i64, bit i64) (yes bool) {
    yes = (CMP-FLAGS[h] & bit) != 0
}
; 渲染层用的只读 getter（下标读统一走 match 解包，保持 vet 干净）
cmp-color = (h i64) (c i64) {
    v = CMP-COLOR[h]: {
        ok -> it

        -> 0
    }
    c = v
}
cmp-children = (h i64) (n i64) {
    v = CMP-COUNT[h]: {
        ok -> it

        -> 0
    }
    n = v
}
; 子链表在 CHILD-IDX 中的起始槽位（声明式调和器做 key→slot 映射时用）
cmp-head = (h i64) (v i64) {
    x = CMP-HEAD[h]: {
        ok -> it

        -> -1
    }
    v = x
}
; 声明式 key 读写（调和器据此跨帧复用组件对象）
cmp-key = (h i64) (v i64) {
    x = CMP-KEY[h]: {
        ok -> it

        -> -1
    }
    v = x
}
cmp-set-key = (h i64, k i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-KEY[h] = k }
}
cmp-value3 = (h i64) (v i64) {
    x = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
    v = x
}

; 布局提示读写（声明式视图层 dv-lay 的落点；cmp-scene 布局时消费）
cmp-lay = (h i64) (v i64) {
    x = CMP-LAY[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-gap = (h i64) (v i64) {
    x = CMP-GAP[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-pad = (h i64) (v i64) {
    x = CMP-PAD[h]: {
        ok -> it

        -> 0
    }
    v = x
}

; 尺寸 / 文本对齐提示读写（dv-size / dv-align 的落点）
cmp-sw = (h i64) (v i64) {
    x = CMP-SW[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-sh = (h i64) (v i64) {
    x = CMP-SH[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-align = (h i64) (v i64) {
    x = CMP-ALIGN[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-var = (h i64) (v i64) {
    x = CMP-VAR[h]: {
        ok -> it

        -> 0
    }
    v = x
}

; 通用 setter
cmp-set-text = (h i64, s str) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-TEXT[h] = s }
}
cmp-set-text2 = (h i64, s str) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-TEXT2[h] = s }
}
cmp-set-color = (h i64, c i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-COLOR[h] = c }
}
cmp-set-value = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-VALUE[h] = v }
}
cmp-set-value2 = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-VALUE2[h] = v }
}
cmp-set-lay = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-LAY[h] = v }
}
cmp-set-gap = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-GAP[h] = v }
}
cmp-set-pad = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-PAD[h] = v }
}
cmp-set-sw = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-SW[h] = v }
}
cmp-set-sh = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-SH[h] = v }
}
cmp-set-align = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-ALIGN[h] = v }
}
cmp-set-var = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-VAR[h] = v }
}
; 锚定浮层的锚点 key（-1 = 无锚点）。cmp-scene 布局时按 key 反查锚点活节点矩形，
; 把浮层放在锚点下方（贴边时翻到上方）并夹紧在父矩形内；锚点找不到则退化为居中。
cmp-anchor = (h i64) (v i64) {
    x = CMP-ANCHOR[h]: {
        ok -> it

        -> -1
    }
    v = x
}
cmp-set-anchor = (h i64, k i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-ANCHOR[h] = k }
}
; 阶段23：滚动容器的最大偏移（布局阶段算，事件侧拿它夹紧滚轮）
cmp-scroll-max = (h i64) (v i64) {
    x = CMP-SCROLL-MAX[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-set-scroll-max = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-SCROLL-MAX[h] = v }
}
; 阶段24：声明内容高的读写（虚拟列表用；0 = 没声明 -> 布局实测子节点）
cmp-scroll-content = (h i64) (v i64) {
    x = CMP-SCROLL-CONTENT[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-set-scroll-content = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-SCROLL-CONTENT[h] = v }
}
; 阶段24：首个挂载子的**绝对行号**（虚拟列表用；0 = 顺序排，兼容实测模式）
cmp-scroll-start = (h i64) (v i64) {
    x = CMP-SCROLL-START[h]: {
        ok -> it

        -> 0
    }
    v = x
}
cmp-set-scroll-start = (h i64, v i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-SCROLL-START[h] = v }
}
cmp-set-bounds = (h i64, x i64, y i64, w i64, ht i64) {
    (h >= 0 && h < CMP-KIND.len()) -> {
        CMP-X[h] = x
        CMP-Y[h] = y
        CMP-W[h] = w
        CMP-H[h] = ht
    }
}
cmp-flag-set = (h i64, bit i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-FLAGS[h] = CMP-FLAGS[h] | bit }
}
cmp-flag-clear = (h i64, bit i64) {
    (h >= 0 && h < CMP-KIND.len()) -> { CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ bit) }
}

; 父子挂载（用于容器类组件）
cmp-add-child = (parent i64, child i64) {
    (parent < 0 || child < 0) -> return
    cnt = CMP-COUNT[parent]
    (cnt == 0) -> { CMP-HEAD[parent] = CHILD-IDX.len() }
    CHILD-IDX.push(child)
    nc = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-COUNT[parent] = nc
    CMP-PARENT[child] = parent
}
cmp-child = (parent i64, i i64) (c i64) {
    c = -1
    cnt = CMP-COUNT[parent]: {
        ok -> it

        -> 0
    }
    (i >= 0 && i < cnt) -> {
        hd = CMP-HEAD[parent]: {
            ok -> it

            -> -1
        }
        s = hd + i: {
            ok -> it

            -> -1
        }
        v = CHILD-IDX[s]: {
            ok -> it

            -> -1
        }
        c = v
    }
}

; 从父组件上摘除子组件（保留子树本身，仅解除挂载关系）
; 供声明式视图层的调和器做「删除」操作：把 CHILD-IDX 中该槽左移压实，
; 并修正所有 head 落在被删槽之后的父组件。返回是否真的摘掉了。
cmp-detach = (parent i64, child i64) (ok bool) {
    ok = false
    (parent >= 0 && child >= 0) -> {
        cnt = CMP-COUNT[parent]: {
            ok -> it

            -> 0
        }
        hd = CMP-HEAD[parent]: {
            ok -> it

            -> -1
        }
        (cnt > 0 && hd >= 0) -> {
            pos = -1
            i = 0
            !! {
                (i >= cnt) -> { ** }
                s = hd + i: {
                    ok -> it

                    -> -1
                }
                v = CHILD-IDX[s]: {
                    ok -> it

                    -> -1
                }
                (v == child) -> {
                    pos = s
                    **
                }
                ni = i + 1: {
                    ok -> it

                    -> i
                }
                i = ni
            }
            (pos >= 0) -> {
                ; CHILD-IDX 是全局扁平数组：删掉一槽后，其后所有元素（包括别的父的子链）
                ; 都要整体左移一格，否则后续父的 head 会指错位置。
                last = CHILD-IDX.len()
                j = pos
                !! {
                    nj = j + 1: {
                        ok -> it

                        -> j
                    }
                    (nj >= last) -> { ** }
                    v = CHILD-IDX[nj]: {
                        ok -> it

                        -> -1
                    }
                    CHILD-IDX[j] = v
                    j = nj
                }
                nl = CHILD-IDX.len()
                keep = nl - 1: {
                    ok -> it

                    -> nl
                }
                CHILD-IDX.truncate(keep)
                nc = cnt - 1: {
                    ok -> it

                    -> 0
                }
                CMP-COUNT[parent] = nc
                CMP-PARENT[child] = -1
                n = CMP-KIND.len()
                p = 0
                !! {
                    (p >= n) -> { ** }
                    hp = CMP-HEAD[p]: {
                        ok -> it

                        -> -1
                    }
                    (hp > pos) -> {
                        nh = hp - 1: {
                            ok -> it

                            -> hp
                        }
                        CMP-HEAD[p] = nh
                    }
                    np = p + 1: {
                        ok -> it

                        -> p
                    }
                    p = np
                }
                ok = true
            }
        }
    }
}

; ============================================================================
; 全目录构造函数（83 个）—— 每个返回组件句柄，核心属性走 cmp-set-*
