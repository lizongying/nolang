AC-TITLE []str = with-len(0)
AC-BODY []str = with-len(0)
AC-EXP []i64 = with-len(0)
AC-BBASE []i64 = with-len(0)
AC-BN []i64 = with-len(0)
AC-SBASE []i64 = with-len(0)
AC-N []i64 = with-len(0)

; 阶段57：carousel 的幻灯片池（扁平只增）+ 每句柄基址 / 张数
