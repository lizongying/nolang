; ============================================================================
; 核心 10 组件 —— 完整状态机（hover/click/focus/键盘/值变更）
; 全部用 flag 位 + VALUE/VUE2 表达状态，避免函数内多标量全局写回缺陷。
; ============================================================================
; 核心 10 组件 —— 完整状态机
; 🔴 关键约束（实测）：本段函数体内**不得调用任何辅助函数**（cmp-has / cmp-flag-set 等），
;    否则调用者的全局数组写回会丢失（记忆「辅助函式嵌套调用缺陷」）。全部内联位运算。
;    字符串插值里不得放数组下标表达式（会变字面量），先存局部变量再插值。

; ---- 1. Button ----
button-hover = (h i64, on bool) {
    (on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] | F-HOVERED }
    (!on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-HOVERED) }
}
button-press = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-FOCUSED
}
button-release = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-FOCUSED)
}
button-click = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cnt = CMP-VALUE[h]
    n = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-VALUE[h] = n
}
button-clicks = (h i64) (n i64) {
    x = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    n = x
}

; ---- 2. Input ----
input-focus = (h i64, on bool) {
    (on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] | F-FOCUSED }
    (!on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-FOCUSED) }
}
input-clear = (h i64) {
    CMP-TEXT[h] = ''
    ct-set(INP-CAR, h, 0)
}
input-value = (h i64) (s str) {
    s = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
}
; ---- 阶段38：光标（字节下标）与定点编辑 ----
input-caret = (h i64) (i i64) {
    i = ct-get(INP-CAR, h)
}
input-set-caret = (h i64, i i64) () {
    n = CMP-TEXT[h].len-bytes()
    (i < 0) -> { i = 0 }
    (i > n) -> { i = n }
    ct-set(INP-CAR, h, i)
}
input-move = (h i64, d i64) () {
    input-set-caret(h, ct-add(input-caret(h), d))
}
; 在光标处插入（append 是它在「光标在末尾」时的特例）
input-insert = (h i64, ch str) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    txt = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
    car = input-caret(h)
    n = txt.len-bytes()
    (car < 0) -> { car = 0 }
    (car > n) -> { car = n }
    pre = txt.slice-bytes(0, car)
    suf = txt.slice-bytes(car, n)
    pre.push-str(ch)
    pre.push-str(suf)
    CMP-TEXT[h] = pre
    input-set-caret(h, ct-add(car, ch.len-bytes()))
}
input-append = (h i64, ch str) {
    ; 旧语义是「追加到末尾」：先把光标推到末尾，再走同一条插入路径
    input-set-caret(h, CMP-TEXT[h].len-bytes())
    input-insert(h, ch)
}
input-backspace = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    car = input-caret(h)
    (car > 0) -> {
        txt = CMP-TEXT[h]: {
            ok -> it

            -> ''
        }
        n = txt.len-bytes()
        (car <= n) -> {
            pre = txt.slice-bytes(0, ct-sub(car, 1))
            suf = txt.slice-bytes(car, n)
            pre.push-str(suf)
            CMP-TEXT[h] = pre
            ct-set(INP-CAR, h, ct-sub(car, 1))
        }
    }
}
; 向前删（光标处往后一个字节）
input-delete = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    car = input-caret(h)
    txt = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
    n = txt.len-bytes()
    (car < n) -> {
        pre = txt.slice-bytes(0, car)
        suf = txt.slice-bytes(ct-add(car, 1), n)
        pre.push-str(suf)
        CMP-TEXT[h] = pre
    }
}

; ---- 阶段38：语法高亮（复用编辑器的 ed-lex-line，颜色按 nolang 语感取）----
input-syntax = (h i64, on bool) {
    (on) -> { ct-set(INP-SY, h, 1) }
    (!on) -> { ct-set(INP-SY, h, 0) }
}
input-syntax-mode = (h i64) (m i64) {
    m = ct-get(INP-SY, h)
}
; 把当前文本 token 化并摊平进只增段池（在组件模块内 push）
input-lex-build = (h i64) (n i64) {
    ts []str = with-len(0)
    tc []i64 = with-len(0)
    t = input-value(h)
    n = ed-lex-line(t, ts, tc, INP-C-KW, INP-C-STR, INP-C-COM, cmp-color(h))
    ct-set(INP-SGO, h, INP-SG.len())
    ct-set(INP-SGN, h, n)
    j = 0
    !! {
        (j >= n) -> { ** }
        INP-SG.push(ed-arr-get-s(ts, j))
        INP-SGC.push(ct-get(tc, j))
        j = ct-inc(j)
    }
    n = n
}
input-lex-count = (h i64) (n i64) {
    n = ct-get(INP-SGN, h)
}
input-lex-seg = (h i64, j i64) (s str) {
    s = ed-arr-get-s(INP-SG, ct-add(ct-get(INP-SGO, h), j))
}
input-lex-color = (h i64, j i64) (c i64) {
    c = ct-get(INP-SGC, ct-add(ct-get(INP-SGO, h), j))
}

; ---- 阶段39：多行文本域（C-TEXTAREA）行几何 + 视口 ----
; 文本 / 光标仍走 CMP-TEXT + INP-CAR（字节下标，和阶段38 的编辑原语同构），
; 这里只加「行」的算法：行 = '\n' 分隔，换行符归上一行的行尾（空文本算 1 行）。
; 换行 / 退格 / 前删直接复用 input-insert / input-backspace / input-delete。
ta-line-count = (h i64) (n i64) {
    t = input-value(h)
    nb = t.len-bytes()
    n = 1
    i = 0
    !! {
        (i >= nb) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}
; 第 l 行（0 基）起始字节下标；l 越界夹到最后一行
ta-line-start = (h i64, l i64) (b i64) {
    t = input-value(h)
    nb = t.len-bytes()
    b = 0
    i = 0
    seen = 0
    !! {
        (seen >= l) -> { ** }
        (i >= nb) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> {
            seen = ct-inc(seen)
            b = ct-inc(i)
        }
        i = ct-inc(i)
    }
    b = b
}
; 第 l 行内容长度（**不含**结尾的 '\n'，按字节）
ta-line-len = (h i64, l i64) (n i64) {
    t = input-value(h)
    nb = t.len-bytes()
    n = 0
    i = ta-line-start(h, l)
    !! {
        (i >= nb) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> { ** }
        n = ct-inc(n)
        i = ct-inc(i)
    }
    n = n
}
; 第 l 行的文本（不含换行符）
ta-line-text = (h i64, l i64) (s str) {
    t = input-value(h)
    b = ta-line-start(h, l)
    s = t.slice-bytes(b, ct-add(b, ta-line-len(h, l)))
}
ta-caret-line = (h i64) (l i64) {
    t = input-value(h)
    car = input-caret(h)
    l = 0
    i = 0
    !! {
        (i >= car) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> { l = ct-inc(l) }
        i = ct-inc(i)
    }
    l = l
}
; 光标在第 l 行内的字节列
ta-caret-col = (h i64) (c i64) {
    c = ct-sub(input-caret(h), ta-line-start(h, ta-caret-line(h)))
}
; 上移一行：保持列，夹到上一行长度；已在首行不动
ta-move-up = (h i64) () {
    l = ta-caret-line(h)
    (l <= 0) -> return
    c = ta-caret-col(h)
    pl = ct-sub(l, 1)
    n = ta-line-len(h, pl)
    (c > n) -> { c = n }
    input-set-caret(h, ct-add(ta-line-start(h, pl), c))
}
; 下移一行：保持列，夹到下一行长度；已在末行不动
ta-move-down = (h i64) () {
    l = ta-caret-line(h)
    nl = ct-inc(l)
    (nl >= ta-line-count(h)) -> return
    c = ta-caret-col(h)
    n = ta-line-len(h, nl)
    (c > n) -> { c = n }
    input-set-caret(h, ct-add(ta-line-start(h, nl), c))
}
; 视口首行（行号）读 / 写
ta-off = (h i64) (v i64) {
    v = ct-get(TA-OFF, h)
}
ta-set-off = (h i64, v i64) () {
    (v < 0) -> { v = 0 }
    ct-set(TA-OFF, h, v)
}
; 让光标行落进 [off, off+cap)：不够就滚，且不滚过「最后 cap 行」
ta-follow = (h i64, cap i64) () {
    (cap <= 0) -> { cap = 1 }
    lines = ta-line-count(h)
    l = ta-caret-line(h)
    off = ct-get(TA-OFF, h)
    (off < 0) -> { off = 0 }
    maxoff = ct-sub(lines, cap)
    (maxoff < 0) -> { maxoff = 0 }
    (l < off) -> { off = l }
    (l >= ct-add(off, cap)) -> { off = ct-sub(l, ct-sub(cap, 1)) }
    (off > maxoff) -> { off = maxoff }
    (off < 0) -> { off = 0 }
    ct-set(TA-OFF, h, off)
}

; ---- 阶段40：数字输入 / 步进器 / 搜索框 ----
; 槽位沿用 slider 的约定：VALUE = 当前值，VALUE3 = 下限，VALUE2 = 上限；
; VALUE4 = 步长（<= 0 一律按 1）。文本在 CMP-TEXT，光标复用 INP-CAR。
num-range = (h i64, lo i64, hi i64) () {
    CMP-VALUE3[h] = lo
    CMP-VALUE2[h] = hi
}
num-step-set = (h i64, s i64) () {
    (s <= 0) -> { s = 1 }
    CMP-VALUE4[h] = s
}
num-step = (h i64) (s i64) {
    s = ct-get(CMP-VALUE4, h)
    (s <= 0) -> { s = 1 }
}
num-min = (h i64) (v i64) {
    v = ct-get(CMP-VALUE3, h)
}
num-max = (h i64) (v i64) {
    v = ct-get(CMP-VALUE2, h)
}
; 夹紧到 [lo, hi]（hi <= 0 = 不设上限，与 ct-clamp 同语义）
num-clamp = (h i64, v i64) (r i64) {
    r = ct-clamp(v, ct-get(CMP-VALUE3, h), ct-get(CMP-VALUE2, h))
}
; 先夹紧，再吸附到 lo + k*step（四舍五入到最近的一格），最后再夹一次
num-snap = (h i64, v i64) (r i64) {
    r = num-clamp(h, v)
    st = num-step(h)
    lo = ct-get(CMP-VALUE3, h)
    q = ct-div(ct-add(ct-sub(r, lo), ct-div(st, 2)), st)
    r = ct-add(lo, ct-mul(q, st))
    r = num-clamp(h, r)
}
num-value = (h i64) (v i64) {
    v = ct-get(CMP-VALUE, h)
}
; 写值：吸附 + 写 VALUE + 同步 CMP-TEXT（渲染层据此画右对齐数值）
num-set = (h i64, v i64) () {
    x = num-snap(h, v)
    CMP-VALUE[h] = x
    cmp-set-text(h, x.to-str())
}
num-bump = (h i64, dir i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    st = num-step(h)
    cur = ct-get(CMP-VALUE, h)
    num-set(h, ct-add(cur, ct-mul(dir, st)))
}
; 把 CMP-TEXT 解析成数字写回；解析失败不动值，返回 0
; 注意：to-i64 的 ok 臂标签本身是个 bool 变量，返回值不能也叫 ok（会撞名）
num-commit = (h i64) (done bool) {
    done = false
    t = input-value(h)
    parsed = 0
    pv = 0
    t.to-i64(): {
        ok -> {
            parsed = 1
            pv = it
        }

        -> {
            parsed = 0
        }
    }
    (parsed == 1) -> {
        num-set(h, pv)
        done = true
    }
}
; 搜索框：值就是文本，另给「清除」
search-query = (h i64) (s str) {
    s = input-value(h)
}
search-clear = (h i64) () {
    input-clear(h)
}
; 命中右端清除区（宽 = ht 的正方形）；返回 1 = 命中
search-hit = (h i64, px i64, py i64, x i64, y i64, w i64, ht i64) (r i64) {
    r = 0
    cx = ct-sub(ct-add(x, w), ht)
    ((px >= cx) && (px < ct-add(x, w)) && (py >= y) && (py < ct-add(y, ht))) -> { r = 1 }
    r = r
}
; 命中：-1 = 左（减），1 = 右（加），0 = 中间值区
stepper-hit = (h i64, px i64, py i64, x i64, y i64, w i64, ht i64) (r i64) {
    r = 0
    bw = ht
    (w < ct-mul(bw, 2)) -> { bw = ct-div(w, 2) }
    iny = ((py >= y) && (py < ct-add(y, ht)))
    ((iny) && (px >= x) && (px < ct-add(x, bw))) -> { r = -1 }
    rx = ct-sub(ct-add(x, w), bw)
    ((iny) && (px >= rx) && (px < ct-add(x, w))) -> { r = 1 }
    r = r
}

; ---- 阶段41：OTP 输入（C-OTP-INPUT）----
; 槽数 = CMP-VALUE（构造参数 cmp-otp-input(len)）；每位一个数字存 OT-CODE
; （**定长**字符串，空格 = 空槽），活动槽 = OT-CUR。写操作一律先查 F-DISABLED。
; 槽格几何：格宽 = 控件高（正方格），格距 800 —— 与 cmp-scene 的 CS-GAP 同值；
; components.no 看不到 CS-GAP，只能写字面量（同 §5.31 的写法）。
otp-slots = (h i64) (n i64) {
    n = ct-get(CMP-VALUE, h)
    (n <= 0) -> { n = 1 }
}
otp-cur = (h i64) (i i64) {
    i = ct-get(OT-CUR, h)
}
otp-cur-set = (h i64, i i64) () {
    n = otp-slots(h)
    (i < 0) -> { i = 0 }
    (i >= n) -> { i = ct-sub(n, 1) }
    ct-set(OT-CUR, h, i)
}
; 取定长码：短了补空格，长了截断（渲染 / 命中都按这个长度算）
otp-code = (h i64) (s str) {
    n = otp-slots(h)
    s = OT-CODE[h]: {
        ok -> it

        -> ''
    }
    nb = s.len-bytes()
    !! {
        (nb >= n) -> { ** }
        s.push-str(' ')
        nb = ct-inc(nb)
    }
    (nb > n) -> { s = s.slice-bytes(0, n) }
    s = s
}
; 单个字符 -> 数字；不是数字返回 -1
otp-char-digit = (ch str) (d i64) {
    d = -1
    ch.to-i64(): {
        ok -> {
            (it >= 0) -> {
                (it <= 9) -> { d = it }
            }
        }

        -> { d = -1 }
    }
    d = d
}
; 第 i 槽的数字；空槽 / 越界返回 -1
otp-digit = (h i64, i i64) (d i64) {
    d = -1
    n = otp-slots(h)
    ((i < 0) || (i >= n)) -> { d = -1 }
    ((i >= 0) && (i < n)) -> {
        c = otp-code(h)
        ch = c.slice-bytes(i, ct-add(i, 1))
        d = otp-char-digit(ch)
    }
    d = d
}
; 写第 i 槽（d 不在 0..9 = 清空），并把活动槽移到第 i 槽
otp-set-digit = (h i64, i i64, d i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = otp-slots(h)
    ((i < 0) || (i >= n)) -> return
    c = otp-code(h)
    ch = ' '
    ((d >= 0) && (d <= 9)) -> { ch = d.to-str() }
    pre = c.slice-bytes(0, i)
    pre.push-str(ch)
    pre.push-str(c.slice-bytes(ct-add(i, 1), c.len-bytes()))
    OT-CODE[h] = pre
    ct-set(OT-CUR, h, i)
}
otp-clear-slot = (h i64, i i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = otp-slots(h)
    ((i < 0) || (i >= n)) -> return
    c = otp-code(h)
    pre = c.slice-bytes(0, i)
    pre.push-str(' ')
    pre.push-str(c.slice-bytes(ct-add(i, 1), c.len-bytes()))
    OT-CODE[h] = pre
}
otp-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = otp-slots(h)
    pre = ''
    i = 0
    !! {
        (i >= n) -> { ** }
        pre.push-str(' ')
        i = ct-inc(i)
    }
    OT-CODE[h] = pre
    ct-set(OT-CUR, h, 0)
}
; 已填槽数
otp-filled = (h i64) (n i64) {
    c = otp-code(h)
    nb = c.len-bytes()
    n = 0
    i = 0
    !! {
        (i >= nb) -> { ** }
        ch = c.slice-bytes(i, ct-add(i, 1))
        (ch != ' ') -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}
; 去掉空格的「已输入码」（给状态栏 / 表单提交用）
otp-digits = (h i64) (s str) {
    c = otp-code(h)
    nb = c.len-bytes()
    s = ''
    i = 0
    !! {
        (i >= nb) -> { ** }
        ch = c.slice-bytes(i, ct-add(i, 1))
        (ch != ' ') -> { s.push-str(ch) }
        i = ct-inc(i)
    }
    s = s
}
; 值 = 已输入码（不含空格）
otp-value = (h i64) (s str) {
    s = otp-digits(h)
}
otp-complete = (h i64) (yes bool) {
    yes = otp-filled(h) == otp-slots(h)
}
; 在活动槽写一位，然后跳到**下一个空槽**（没有空槽就停在末槽）
otp-put = (h i64, d i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = otp-slots(h)
    cur = ct-get(OT-CUR, h)
    (cur < 0) -> { cur = 0 }
    (cur >= n) -> { cur = ct-sub(n, 1) }
    otp-set-digit(h, cur, d)
    c = otp-code(h)
    nx = -1
    i = 0
    !! {
        (i >= n) -> { ** }
        ch = c.slice-bytes(i, ct-add(i, 1))
        ((ch == ' ') && (nx < 0)) -> { nx = i }
        i = ct-inc(i)
    }
    (nx >= 0) -> { ct-set(OT-CUR, h, nx) }
    (nx < 0) -> { ct-set(OT-CUR, h, ct-sub(n, 1)) }
}
; 退格：活动槽有数字就清它；否则回退一格清上一格
otp-backspace = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = otp-slots(h)
    cur = ct-get(OT-CUR, h)
    (cur < 0) -> { cur = 0 }
    (cur >= n) -> { cur = ct-sub(n, 1) }
    d = otp-digit(h, cur)
    (d >= 0) -> {
        otp-clear-slot(h, cur)
        ct-set(OT-CUR, h, cur)
    }
    (d < 0) -> {
        (cur > 0) -> {
            pv = ct-sub(cur, 1)
            otp-clear-slot(h, pv)
            ct-set(OT-CUR, h, pv)
        }
    }
}
; 前删：只清活动槽，不移动
otp-delete = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cur = ct-get(OT-CUR, h)
    otp-clear-slot(h, cur)
}
otp-left = (h i64) () {
    otp-cur-set(h, ct-sub(ct-get(OT-CUR, h), 1))
}
otp-right = (h i64) () {
    otp-cur-set(h, ct-add(ct-get(OT-CUR, h), 1))
}
; 从字符串灌入：只取数字字符，按槽序填，多余的忽略；活动槽回到 0
otp-set = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    otp-clear(h)
    n = otp-slots(h)
    nb = s.len-bytes()
    i = 0
    k = 0
    !! {
        (i >= nb) -> { ** }
        (k >= n) -> { ** }
        ch = s.slice-bytes(i, ct-add(i, 1))
        d = otp-char-digit(ch)
        (d >= 0) -> {
            otp-set-digit(h, k, d)
            k = ct-inc(k)
        }
        i = ct-inc(i)
    }
    ct-set(OT-CUR, h, 0)
}
; ---- 槽格几何（渲染层也调这两个，保证「画的」和「点的」一致）----
otp-slot-w = (h i64, w i64, ht i64) (sw i64) {
    n = otp-slots(h)
    sw = ht
    need = ct-add(ct-mul(n, ht), ct-mul(ct-sub(n, 1), 800))
    (w < need) -> {
        sw = ct-div(ct-sub(w, ct-mul(ct-sub(n, 1), 800)), n)
        (sw < 1200) -> { sw = 1200 }
    }
    (sw <= 0) -> { sw = 1200 }
    sw = sw
}
otp-slot-x = (h i64, i i64, x i64, w i64, ht i64) (sx i64) {
    sw = otp-slot-w(h, w, ht)
    sx = ct-add(x, ct-mul(i, ct-add(sw, 800)))
}
; 命中第几槽；没命中返回 -1
otp-hit = (h i64, px i64, py i64, x i64, y i64, w i64, ht i64) (r i64) {
    r = -1
    n = otp-slots(h)
    ((py < y) || (py >= ct-add(y, ht))) -> { r = -1 }
    ((py >= y) && (py < ct-add(y, ht))) -> {
        i = 0
        !! {
            (i >= n) -> { ** }
            (r >= 0) -> { ** }
            sx = otp-slot-x(h, i, x, w, ht)
            sw = otp-slot-w(h, w, ht)
            ((px >= sx) && (px < ct-add(sx, sw))) -> { r = i }
            i = ct-inc(i)
        }
    }
    r = r
}

; ---- 3. Checkbox ----
checkbox-toggle = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    checked = CMP-FLAGS[h] & F-CHECKED
    (checked != 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-CHECKED)
    }
    (checked == 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] | F-CHECKED
    }
}
checkbox-checked = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-CHECKED) != 0
}

; ---- 4. Radio ----
radio-select = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-SELECTED
}
radio-deselect = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-SELECTED)
}
radio-selected = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-SELECTED) != 0
}

; ---- 5. Switch ----
switch-toggle = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    checked = CMP-FLAGS[h] & F-CHECKED
    (checked != 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-CHECKED)
    }
    (checked == 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] | F-CHECKED
    }
}
switch-on = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-CHECKED) != 0
}

; ---- 6. Select ----
select-open = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-OPEN
}
select-close = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
}
select-add-option = (h i64, label str) (idx i64) {
    opt = cmp-label(label)
    cnt = CMP-COUNT[h]
    (cnt == 0) -> { CMP-HEAD[h] = CHILD-IDX.len() }
    CHILD-IDX.push(opt)
    nc = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-COUNT[h] = nc
    idx = CMP-COUNT[h] - 1
}
select-choose = (h i64, idx i64) {
    (idx >= 0 && idx < CMP-COUNT[h]) -> {
        CMP-VALUE[h] = idx
        CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
        c = CHILD-IDX[CMP-HEAD[h] + idx]
        CMP-TEXT[h] = CMP-TEXT[c]: {
            ok -> it

            -> ''
        }
    }
}
select-selected = (h i64) (idx i64) {
    x = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    idx = x
}


; ---- 7. Tab ----
tab-add = (h i64, title str) (idx i64) {
    t = cmp-label(title)
    cnt = CMP-COUNT[h]
    (cnt == 0) -> { CMP-HEAD[h] = CHILD-IDX.len() }
    CHILD-IDX.push(t)
    nc = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-COUNT[h] = nc
    idx = CMP-COUNT[h] - 1
    (CMP-VALUE[h] < 0) -> { CMP-VALUE[h] = 0 }
}
tab-active = (h i64) (idx i64) {
    x = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    idx = x
}
tab-select = (h i64, idx i64) {
    (idx >= 0 && idx < CMP-COUNT[h]) -> { CMP-VALUE[h] = idx }
}
tab-next = (h i64) {
    n = CMP-COUNT[h]
    (n > 0) -> {
        v = CMP-VALUE[h]: {
            ok -> it

            -> 0
        }
        i = v + 1: {
            ok -> it

            -> 0
        }
        (i >= n) -> { i = 0 }
        CMP-VALUE[h] = i
    }
}
tab-prev = (h i64) {
    n = CMP-COUNT[h]
    (n > 0) -> {
        i = CMP-VALUE[h] - 1
        (i < 0) -> {
            m = n - 1: {
                ok -> it

                -> 0
            }
            i = m
        }
        CMP-VALUE[h] = i
    }
}

; ---- 8. Dialog ----
dialog-open = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-OPEN
}
dialog-close = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
}
dialog-confirm = (h i64) {
    CMP-VALUE[h] = 1
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
}
dialog-is-open = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-OPEN) != 0
}

; ---- 9. Tooltip ----
tooltip-show = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-VISIBLE
}
tooltip-hide = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-VISIBLE)
}
tooltip-visible = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-VISIBLE) != 0
}

; ---- 10. Progress / Slider ----
progress-set = (h i64, v i64, max i64) {
    x = v
    (x < 0) -> { x = 0 }
    (x > max) -> { x = max }
    CMP-VALUE[h] = x
    CMP-VALUE2[h] = max
}
progress-percent = (h i64) (pct i64) {
    m = CMP-VALUE2[h]
    pct = 0
    (m > 0) -> {
        pct = CMP-VALUE[h] * 100 / m
    }
}
slider-range = (h i64, lo i64, hi i64) {
    CMP-VALUE3[h] = lo
    CMP-VALUE2[h] = hi
}
slider-set = (h i64, v i64) {
    lo = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
    hi = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
    x = v
    (x < lo) -> { x = lo }
    (x > hi) -> { x = hi }
    CMP-VALUE[h] = x
}
slider-step = (h i64, dir i64) {
    lo = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
    hi = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
    cur = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    x = cur + dir: {
        ok -> it

        -> 0
    }
    (x < lo) -> { x = lo }
    (x > hi) -> { x = hi }
    CMP-VALUE[h] = x
}
slider-value = (h i64) (v i64) {
    x = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    v = x
}

; ============================================================================
; 11. 树（阶段33：命令式侧功能对等）
; ============================================================================
; 节点本身也是组件（cmp-label），但**不是树的视觉子节点** —— 节点表存在 TR-ALL 里
; （按树分段，TR-TSTART / TR-TCOUNT 记段界），兄弟关系是 first-child / next-sibling
; 链。树的**视觉子节点**是 cmp-tree-sync 重建出来的「行」（横向 C-FORM 行 + 右对齐
; 「缩进 + 箭头」标签 + 文本标签），所以 C-TREE 仍是普通纵向容器：布局 / 绘制 / 命中
; 全走通用路径，渲染层不需要新分支（和阶段 28 的表格同一个思路）。
;
; 命令式层没有每帧调和器 —— 展开 / 选中之后由应用调一次 cmp-tree-sync 重建行。
; 颜色不写死在组件库里（components.no 不 import cmp-scene，拿不到 cs-theme），
; 由调用方把主题色当参数传进来。

CT-INDENT = 2400   ; 每层缩进 24px
CT-ARROW-W = 1600  ; 箭头槽宽 16px（叶子留空但仍占位，文本起点因此对齐）
CT-ROW-H = 2400    ; 行高 24px
CT-OPEN = 'v'      ; 展开态箭头（ASCII —— 字体一定画得出来）
CT-SHUT = '>'      ; 收起态箭头

; 树里用的小工具：数组读写（下标越界给零值 / 不写）与解包算术
ct-get = (a []i64, i i64) (v i64) {
    v = 0
    (i >= 0) -> {
        (i < a.len()) -> {
            x = a[i]: {
                ok -> it

                -> 0
            }
            v = x
        }
    }
}
ct-set = (a []i64, i i64, v i64) () {
    (i >= 0) -> {
        (i < a.len()) -> {
            a[i]: {
                ok -> it = v
                -> _
            }
        }
    }
}
ct-add = (a i64, b i64) (v i64) {
    x = a + b: {
        ok -> it

        -> 0
    }
    v = x
}
ct-sub = (a i64, b i64) (v i64) {
    x = a - b: {
        ok -> it

        -> 0
    }
    v = x
}
ct-inc = (a i64) (v i64) {
    x = a + 1: {
        ok -> it

        -> a
    }
    v = x
}
ct-mul = (a i64, b i64) (v i64) {
    x = a * b: {
        ok -> it

        -> 0
    }
    v = x
}
; 整数除法（components.no 不能 import cmp-scene，所以自己带一份；除数 <= 0 给 0）
ct-div = (a i64, b i64) (v i64) {
    v = 0
    (b > 0) -> {
        x = a / b: {
            ok -> it

            -> 0
        }
        v = x
    }
    v = v
}
; 非负余数（阶段47 color-picker / date-picker 用）：a 可以是负数，
; 结果恒在 [0, b)；b <= 0 给 0。除法向零截断，所以负数要先补一个 b。
ct-rem = (a i64, b i64) (r i64) {
    r = 0
    (b > 0) -> {
        q = ct-div(a, b)
        r = ct-sub(a, ct-mul(q, b))
        (r < 0) -> { r = ct-add(r, b) }
    }
    r = r
}
; 夹紧（阶段36 可拆面板用；语义与声明式 dv-clamp 一致：hi <= 0 = 不夹上限）
ct-clamp = (v i64, lo i64, hi i64) (r i64) {
    r = v
    (v < lo) -> { r = lo }
    (hi > 0) -> {
        (v > hi) -> { r = hi }
    }
    r = r
}
; 位运算（阶段52 C-WINDOW-EXT 的 flags 池用）：`|` / `&` 直接作用于 i64，
; 取反用 `ct-not`（`~x == -1 - x`，避开会产生 ?i64 的 `-`）。
ct-or = (a i64, b i64) (v i64) {
    v = a | b
}
ct-and = (a i64, b i64) (v i64) {
    v = a & b
}
ct-not = (a i64) (v i64) {
    v = ct-sub(-1, a)
}

; ============================================================================
; 值域型展示控件（阶段43）—— slider 下限读取器 + rating / pagination / empty
; ============================================================================
; 审计发现：组件目录给 C-RATING 承诺「value, max」、C-PAGINATION 承诺「page, total」、
; C-EMPTY 承诺「title, description」，但命令式侧三者都只有一个构造函数 ——
; rating / pagination 连值都没有 API，empty 的描述（CMP-TEXT2）更是没人画。
; 这里补读数 / 写值（夹紧）/ 命中，渲染落 cmp-scene.no。
;
; 槽位沿用既有约定：VALUE = 当前值，VALUE2 = 上限 / 满分 / 总页数，VALUE3 = 下限。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-LINE-H = 2400（星格宽 = 行高）、CS-GAP = 800、CS-PAD = 1200、CS-BTN-H = 4000。

; ---- slider：对称的 min / max 读取器（渲染层改走它们，别再直读 CMP-VALUE3/2）----
slider-min = (h i64) (lo i64) {
    lo = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
}
slider-max = (h i64) (hi i64) {
    hi = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
}

; ---- rating：VALUE = 当前星数，VALUE2 = 满分 ----
rating-max = (h i64) (m i64) {
    m = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
}
rating-value = (h i64) (v i64) {
    v = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
}
rating-set = (h i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    m = rating-max(h)
    (v < 0) -> { v = 0 }
    (v > m) -> { v = m }
    CMP-VALUE[h] = v
}
; 星格宽 = 行高 2400（= CS-LINE-H）
rating-cell = () (w i64) {
    w = 2400
}
; 命中第几颗星（0 起）；没命中返回 -1
rating-hit = (h i64, px i64, py i64, x i64, y i64, w i64, ht i64) (r i64) {
    r = -1
    m = rating-max(h)
    cw = rating-cell()
    (m > 0) -> {
        ((py >= y) && (py < ct-add(y, ht))) -> {
            ((px >= x) && (px < ct-add(x, ct-mul(m, cw)))) -> {
                r = ct-div(ct-sub(px, x), cw)
            }
        }
    }
    r = r
}

; ---- pagination：VALUE = 当前页（1 起），VALUE2 = 总页数 ----
pagination-total = (h i64) (n i64) {
    n = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
}
pagination-page = (h i64) (p i64) {
    p = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
}
; 页码夹到 [1, total]（total <= 0 按 1 页）
pagination-clamp = (h i64, p i64) (v i64) {
    n = pagination-total(h)
    (n <= 0) -> { n = 1 }
    (p < 1) -> { p = 1 }
    (p > n) -> { p = n }
    v = p
}
pagination-set = (h i64, p i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-VALUE[h] = pagination-clamp(h, p)
}
pagination-prev = (h i64) () {
    pagination-set(h, ct-sub(pagination-page(h), 1))
}
pagination-next = (h i64) () {
    pagination-set(h, ct-add(pagination-page(h), 1))
}
; 左右钮各一个 CS-BTN-H（4000）方钮
pagination-btn-w = () (w i64) {
    w = 4000
}
; 中间标签文案 = 「页/总数」
pagination-label = (h i64) (s str) {
    s = ''
    s.push-str(pagination-page(h).to-str())
    s.push-str('/')
    s.push-str(pagination-total(h).to-str())
}
; 命中：-1 没命中 / 0 上一页 / 1 页码标签 / 2 下一页
pagination-hit = (h i64, px i64, py i64, x i64, y i64, w i64, ht i64) (r i64) {
    r = -1
    bw = pagination-btn-w()
    (w >= ct-add(bw, bw)) -> {
        ((py >= y) && (py < ct-add(y, ht))) -> {
            ((px >= x) && (px < ct-add(x, bw))) -> { r = 0 }
            ((px >= ct-sub(ct-add(x, w), bw)) && (px < ct-add(x, w))) -> { r = 2 }
            ((px >= ct-add(x, bw)) && (px < ct-sub(ct-add(x, w), bw))) -> { r = 1 }
        }
    }
    r = r
}

; ---- empty：CMP-TEXT = 标题，CMP-TEXT2 = 描述（渲染层两行都画）----

; ============================================================================
; 提示族（阶段44）—— message / alert / notification 的 level 语义
; ============================================================================
; 审计发现：组件目录给 C-MESSAGE 承诺「level」、C-ALERT 承诺「level, closable」、
; C-NOTIFICATION 承诺「level, timeout」，但命令式侧三者都只有一个构造函数 ——
; 连 level 都没有 API，渲染还落在通用 `rect + text` 兜底里。这里补 level 读写、
; alert 的关闭钮、notification 的剩余时间条，渲染落 cmp-scene.no。
;
; 槽位沿用既有约定：VALUE = level，VALUE2 = 总时长，VALUE3 = 剩余 / closable。
; level 的四档与主题槽对应：0 info -> ACCENT、1 success -> OK、
; 2 warning -> 琥珀常量（主题里没有警告槽，同 dv.no 的 DV-C-NUM 先例）、
; 3 danger -> DANGER；其它值按 info 画。
;
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、
;   CS-PROGRESS-H=800、CS-MIN-LEAF-W=6400。

LV-INFO = 0
LV-OK = 1
LV-WARN = 2
LV-ERR = 3

; level -> 主题槽下标（抄 CS-TH-* 的字面量：2 = ACCENT、7 = OK、8 = DANGER；
; -1 = 没有对应主题槽，渲染层用琥珀常量）。表驱动而不是在渲染层写一串 `==`，
; 顺带让 LV-* 四个常量都有真源。
lv-slot = (lv i64) (s i64) {
    s = 2
    (lv == LV-INFO) -> { s = 2 }
    (lv == LV-OK) -> { s = 7 }
    (lv == LV-WARN) -> { s = -1 }
    (lv == LV-ERR) -> { s = 8 }
    s = s
}

; 左侧色条粗 4px
lv-bar-w = () (w i64) {
    w = 400
}
; level 字形格 = 行高（2400 = CS-LINE-H）
lv-glyph-w = () (w i64) {
    w = 2400
}
; notification 的剩余时间条高（800 = CS-PROGRESS-H）
lv-progress-h = () (h i64) {
    h = 800
}

; ---- message：VALUE = level ----
msg-level = (h i64) (lv i64) {
    lv = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
}
msg-set-level = (h i64, lv i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-VALUE[h] = lv
}

; ---- alert：VALUE = level，VALUE3 = closable（1 = 画关闭钮）----
alert-closable = (h i64) (c i64) {
    c = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
}
alert-set-closable = (h i64, c i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-VALUE3[h] = c
}
; 关闭钮格 = 行高见方
alert-close-w = () (w i64) {
    w = 2400
}
; 关闭钮左缘（右端留一个 CS-PAD）
alert-close-x = (x i64, w i64) (cx i64) {
    cx = ct-sub(ct-sub(ct-add(x, w), 1200), alert-close-w())
}
; 命中：-1 没命中 / 0 主体 / 1 关闭钮
alert-hit = (h i64, px i64, py i64, x i64, y i64, w i64, ht i64) (r i64) {
    r = -1
    ((py >= y) && (py < ct-add(y, ht))) -> {
        ((px >= x) && (px < ct-add(x, w))) -> {
            r = 0
            cw = alert-close-w()
            cx = alert-close-x(x, w)
            ((alert-closable(h) == 1) && (px >= cx) && (px < ct-add(cx, cw))) -> { r = 1 }
        }
    }
    r = r
}

; ---- notification：VALUE = level，VALUE2 = 总时长，VALUE3 = 剩余 ----
; 时长单位任意（渲染只用比值），demo 里按「秒」用
ntf-timeout = (h i64) (t i64) {
    t = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
}
ntf-remain = (h i64) (t i64) {
    t = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
}
ntf-set-timeout = (h i64, t i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-VALUE2[h] = t
    CMP-VALUE3[h] = t
}
ntf-set-remain = (h i64, t i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-VALUE3[h] = t
}
; 剩余占比（0..10000 定点百分数；total <= 0 或 remain <= 0 -> 0）
ntf-ratio = (h i64) (r i64) {
    t = ntf-timeout(h)
    v = ntf-remain(h)
    r = 0
    (t > 0) -> {
        (v < 0) -> { v = 0 }
        (v > t) -> { v = t }
        r = ct-div(ct-mul(v, 10000), t)
    }
    r = r
}

; ============================================================================
; 阶段45：会话族 bubble / speech
; ============================================================================
; 目录第 53 / 54 行承诺 bubble「text, position」、speech「text, lang」，
; 但命令式侧只有构造函数（连 position / lang 都没有 API）。这里补：
;   bubble：CMP-VALUE = position（0 左 / 1 右 —— 尾巴朝哪一边、文本怎么对齐），
;           CMP-TEXT = 文本，CMP-COLOR = 气泡底色。
;   speech：CMP-TEXT = 文本，CMP-TEXT2 = 语言标签（空 = 不画标签行）。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-LINE-H=2400、CS-GAP=800、CS-SEP-H=100、
;   CS-MIN-LEAF-W=6400、尾巴方块 1200。

; 气泡内边距（= CS-PAD）
bb-pad = () (p i64) { p = 1200 }
; 尾巴方块边长
bb-tail = () (s i64) { s = 1200 }

bubble-pos = (h i64) (p i64) {
    p = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
}
bubble-set-pos = (h i64, p i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (p < 0) -> { p = 0 }
    (p > 1) -> { p = 1 }
    CMP-VALUE[h] = p
}

speech-lang = (h i64) (l str) {
    l = CMP-TEXT2[h]: {
        ok -> it

        -> ''
    }
}
speech-set-lang = (h i64, l str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT2[h] = l
}

; ============================================================================
; 阶段46：元数据族 attachment / clipboard / index-path
; ============================================================================
; 目录第 58 行承诺 attachment「name, size」、第 73 行承诺 clipboard「content」、
; 第 86 行承诺 index-path「path segments」，但命令式侧三者都只有一个构造函数。
; 槽位沿用既有约定：
;   attachment：CMP-TEXT = 文件名，CMP-VALUE = 字节数（>= 0）。
;   clipboard ：CMP-TEXT = 内容。
;   index-path：段池 IP-SEG（扁平只增）+ 每句柄基址 / 段数。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-BTN-H=4000、CS-LINE-H=2400。

; ---- attachment：图标方块 32px、内边距 12px、间隙 8px ----
att-icon = () (w i64) { w = 3200 }
att-pad = () (p i64) { p = 1200 }
att-gap = () (g i64) { g = 800 }

att-name = (h i64) (s str) {
    s = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
}
att-set-name = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
}
att-size = (h i64) (n i64) {
    n = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
}
att-set-size = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (n < 0) -> { n = 0 }
    CMP-VALUE[h] = n
}
; 字节数 → 「12 B」/「3 KB」/「2 MB」（1024 进位，整数部分）
att-size-text = (h i64) (s str) {
    n = att-size(h)
    s = ''
    (n < 1024) -> {
        s.push-str(n.to-str())
        s.push-str(' B')
    }
    (n >= 1024) -> {
        (n < 1048576) -> {
            s.push-str(ct-div(n, 1024).to-str())
            s.push-str(' KB')
        }
        (n >= 1048576) -> {
            s.push-str(ct-div(n, 1048576).to-str())
            s.push-str(' MB')
        }
    }
    s = s
}

; ---- clipboard：字段 + 右端复制方块（24px）----
clip-pad = () (p i64) { p = 1200 }
clip-gap = () (g i64) { g = 800 }
clip-copy-w = () (w i64) { w = 2400 }

clip-content = (h i64) (s str) {
    s = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
}
clip-set-content = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
}
clip-len = (h i64) (n i64) {
    n = clip-content(h).len()
}

; ---- index-path：段池（扁平只增）+ 每句柄基址 / 段数 ----
ip-count = (h i64) (n i64) {
    n = ct-get(IP-SN, h)
}
ip-seg = (h i64, i i64) (s str) {
    s = ''
    n = ip-count(h)
    ((i >= 0) && (i < n)) -> {
        b = ct-get(IP-SBASE, h)
        s = IP-SEG[ct-add(b, i)]: {
            ok -> it

            -> ''
        }
    }
    s = s
}
ip-add-seg = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(IP-SBASE, h)
    n = ct-get(IP-SN, h)
    (n == 0) -> { b = IP-SEG.len() }
    IP-SEG.push(s)
    ct-set(IP-SBASE, h, b)
    ct-set(IP-SN, h, ct-inc(n))
}
ip-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(IP-SBASE, h, 0)
    ct-set(IP-SN, h, 0)
}
; 分隔符文案与宽度（渲染层也抄一份字面量）
ip-sep = () (s str) { s = ' / ' }

; ---- breadcrumb：条目池（扁平只增）+ 每句柄基址 / 条目数 / 分隔符 ----
; 语义与 index-path 同源，但区分「祖先 / 当前页」：除最后一项外的条目是
; 可回退的祖先（muted），最后一项是当前页（前景色）。分隔符每句柄可改。
bc-count = (h i64) (n i64) {
    n = ct-get(BC-N, h)
}
bc-item = (h i64, i i64) (s str) {
    s = ''
    n = bc-count(h)
    ((i >= 0) && (i < n)) -> {
        b = ct-get(BC-SBASE, h)
        s = ed-arr-get-s(BC-ITEM, ct-add(b, i))
    }
    s = s
}
; 追加一项；扁平池只增，基址只在空的时候记一次
bc-add-item = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(BC-SBASE, h)
    n = ct-get(BC-N, h)
    (n == 0) -> { b = BC-ITEM.len() }
    BC-ITEM.push(s)
    ct-set(BC-SBASE, h, b)
    ct-set(BC-N, h, ct-inc(n))
}
bc-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(BC-SBASE, h, 0)
    ct-set(BC-N, h, 0)
}
bc-sep = (h i64) (s str) {
    s = ed-arr-get-s(BC-SEP, h)
    (s.len() == 0) -> { s = ' / ' }
    s = s
}
bc-set-sep = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ed-arr-set-s(BC-SEP, h, s)
}
; 最后一项的下标（空 = -1）
bc-last = (h i64) (i i64) {
    n = bc-count(h)
    i = -1
    (n > 0) -> { i = ct-sub(n, 1) }
}
; 整条路径文案（「a / b / c」）
bc-join = (h i64) (s str) {
    s = ''
    n = bc-count(h)
    sep = bc-sep(h)
    i = 0
    !! {
        (i >= n) -> { ** }
        (i > 0) -> { s.push-str(sep) }
        it = bc-item(h, i)
        s.push-str(it)
        i = ct-inc(i)
    }
    s = s
}

; ---- skeleton：占位条行数 / 行距 / 扫光相位 ----
; 目录第 51 行承诺 skeleton「lines, animated」。槽位：
;   CMP-VALUE  = 扫光相位 0..100（0 = 不扫）
;   CMP-VALUE2 = 占位条行数（夹 0..8）
;   CMP-VALUE3 = 行距（下限 800，与场景的 CS-GAP 同源，这里抄字面量）
sk-lines = (h i64) (n i64) {
    n = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
    (n < 0) -> { n = 0 }
}
sk-set-lines = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-clamp(n, 0, 8)
    CMP-VALUE2[h] = n
}
sk-gap = (h i64) (g i64) {
    g = CMP-VALUE3[h]: {
        ok -> it

        -> 800
    }
    (g < 800) -> { g = 800 }
}
sk-set-gap = (h i64, g i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (g < 800) -> { g = 800 }
    CMP-VALUE3[h] = g
}
sk-phase = (h i64) (p i64) {
    p = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    (p < 0) -> { p = 0 }
    (p > 100) -> { p = 100 }
}
sk-set-phase = (h i64, p i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    p = ct-clamp(p, 0, 100)
    CMP-VALUE[h] = p
}

; ============================================================================
; 输入族 color-picker / date-picker（阶段47）
; ============================================================================
; 目录第 25 行承诺 color-picker「rgba, hue」、第 26 行承诺 date-picker
; 「year, month, day」，但命令式侧两者都只有一个构造函数。槽位沿用既有约定：
;   color-picker：CMP-COLOR = 0xRRGGBBAA，CMP-VALUE = hue 0..360。
;   date-picker ：CMP-VALUE = 年，VALUE2 = 月（1..12），VALUE3 = 日。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-BTN-H=4000、CS-LINE-H=2400。
; 打包色拆通道只用移位 + 掩码；合成色用**加法**（位段不重叠，不会进位），
; 不用按位或 —— 与既有 ct-* 助手保持同一套写法。

; ---- color-picker：色板 32px、内边距 12px、间隙 8px ----
cp-swatch = () (w i64) { w = 3200 }
cp-pad = () (p i64) { p = 1200 }
cp-gap = () (g i64) { g = 800 }

cp-color = (h i64) (c i64) {
    c = CMP-COLOR[h]: {
        ok -> it

        -> 0
    }
}
cp-red = (h i64) (n i64) { n = (cp-color(h) >> 24) & 0xFF }
cp-green = (h i64) (n i64) { n = (cp-color(h) >> 16) & 0xFF }
cp-blue = (h i64) (n i64) { n = (cp-color(h) >> 8) & 0xFF }
cp-alpha = (h i64) (n i64) { n = cp-color(h) & 0xFF }

; 写单通道：清掉对应字节再或上新值（用加法，位段不重叠）
cp-set-red = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-clamp(n, 0, 255)
    c = ct-add((cp-color(h) & 0x00FFFFFF), (n << 24))
    CMP-COLOR[h] = c
    CMP-VALUE[h] = cp-hue-of(cp-red(h), cp-green(h), cp-blue(h))
}
cp-set-green = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-clamp(n, 0, 255)
    c = ct-add((cp-color(h) & 0xFF00FFFF), (n << 16))
    CMP-COLOR[h] = c
    CMP-VALUE[h] = cp-hue-of(cp-red(h), cp-green(h), cp-blue(h))
}
cp-set-blue = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-clamp(n, 0, 255)
    c = ct-add((cp-color(h) & 0xFFFF00FF), (n << 8))
    CMP-COLOR[h] = c
    CMP-VALUE[h] = cp-hue-of(cp-red(h), cp-green(h), cp-blue(h))
}
cp-set-alpha = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-clamp(n, 0, 255)
    c = ct-add((cp-color(h) & 0xFFFFFF00), n)
    CMP-COLOR[h] = c
}
; 整色写入：顺手把 hue 重算出来（hue 是派生量，真源是 RGBA）
cp-set-color = (h i64, c i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-COLOR[h] = c
    r = (c >> 24) & 0xFF
    g = (c >> 16) & 0xFF
    b = (c >> 8) & 0xFF
    CMP-VALUE[h] = cp-hue-of(r, g, b)
}
cp-hue = (h i64) (n i64) {
    n = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
}
; 由 RGB 反算 hue（0..359）。max == min 时给 0。
; 整数算法避开负数截断：负的差值走「基数 - 量」那一支。
cp-hue-of = (r i64, g i64, b i64) (hu i64) {
    mx = r
    (g > mx) -> { mx = g }
    (b > mx) -> { mx = b }
    mn = r
    (g < mn) -> { mn = g }
    (b < mn) -> { mn = b }
    d = ct-sub(mx, mn)
    hu = 0
    (d > 0) -> {
        {
            (mx == r) -> {
                q = ct-sub(g, b)
                (q < 0) -> { hu = ct-sub(360, ct-div(ct-mul(ct-sub(0, q), 60), d)) }
                (q >= 0) -> { hu = ct-div(ct-mul(q, 60), d) }
            }
            (mx == g) -> {
                q = ct-sub(b, r)
                (q < 0) -> { hu = ct-sub(120, ct-div(ct-mul(ct-sub(0, q), 60), d)) }
                (q >= 0) -> { hu = ct-add(120, ct-div(ct-mul(q, 60), d)) }
            }
            -> {
                q = ct-sub(r, g)
                (q < 0) -> { hu = ct-sub(240, ct-div(ct-mul(ct-sub(0, q), 60), d)) }
                (q >= 0) -> { hu = ct-add(240, ct-div(ct-mul(q, 60), d)) }
            }
        }
    }
    hu = hu
}
; 由 hue 正算 RGB：固定 S = 191/255、V = 235/255（饱和度 / 明度是控件的外观
; 选择，不额外占槽位）。返回 0..255 的三个通道。
cp-hsv = (hh i64) (r i64, g i64, b i64) {
    s = 191
    v = 235
    c = ct-div(ct-mul(v, s), 255)
    f = ct-rem(hh, 60)
    t = ct-sub(ct-mul(f, 2), 60)
    (t < 0) -> { t = ct-sub(0, t) }
    x = ct-div(ct-mul(c, ct-sub(60, t)), 60)
    m = ct-sub(v, c)
    seg = ct-div(hh, 60)
    r = m
    g = m
    b = m
    {
        (seg == 0) -> {
            r = ct-add(c, m)
            g = ct-add(x, m)
        }
        (seg == 1) -> {
            r = ct-add(x, m)
            g = ct-add(c, m)
        }
        (seg == 2) -> {
            g = ct-add(c, m)
            b = ct-add(x, m)
        }
        (seg == 3) -> {
            g = ct-add(x, m)
            b = ct-add(c, m)
        }
        (seg == 4) -> {
            r = ct-add(x, m)
            b = ct-add(c, m)
        }
        -> {
            r = ct-add(c, m)
            b = ct-add(x, m)
        }
    }
}
cp-set-hue = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-clamp(n, 0, 360)
    CMP-VALUE[h] = n
    r, g, b = cp-hsv(n)
    a = cp-alpha(h)
    CMP-COLOR[h] = ct-add(ct-add((r << 24), (g << 16)), ct-add((b << 8), a))
}
; 十六进制文案「#RRGGBB」
CP-HEX-DIGITS = '0123456789ABCDEF'
cp-hex2 = (n i64) (s str) {
    s = ''
    s.push(CP-HEX-DIGITS[ct-div(n, 16)])
    s.push(CP-HEX-DIGITS[ct-rem(n, 16)])
    s = s
}
cp-hex = (h i64) (s str) {
    c = cp-color(h)
    r = (c >> 24) & 0xFF
    g = (c >> 16) & 0xFF
    b = (c >> 8) & 0xFF
    s = '#'
    s.push-str(cp-hex2(r))
    s.push-str(cp-hex2(g))
    s.push-str(cp-hex2(b))
    s = s
}

; ---- date-picker：VALUE = 年，VALUE2 = 月（1..12），VALUE3 = 日 ----
dp-year = (h i64) (n i64) {
    n = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
}
dp-month = (h i64) (n i64) {
    n = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
}
dp-day = (h i64) (n i64) {
    n = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
}
; 闰年：是 = 1，否 = 0
dp-leap = (y i64) (n i64) {
    n = 0
    (ct-rem(y, 4) == 0) -> {
        (ct-rem(y, 100) == 0) -> {
            (ct-rem(y, 400) == 0) -> { n = 1 }
        }
        (ct-rem(y, 100) != 0) -> { n = 1 }
    }
    n = n
}
dp-days = (h i64) (n i64) {
    m = dp-month(h)
    y = dp-year(h)
    n = 30
    {
        (m == 1) -> { n = 31 }
        (m == 2) -> {
            n = 28
            (dp-leap(y) == 1) -> { n = 29 }
        }
        (m == 3) -> { n = 31 }
        (m == 4) -> { n = 30 }
        (m == 5) -> { n = 31 }
        (m == 6) -> { n = 30 }
        (m == 7) -> { n = 31 }
        (m == 8) -> { n = 31 }
        (m == 9) -> { n = 30 }
        (m == 10) -> { n = 31 }
        (m == 11) -> { n = 30 }
        -> { n = 31 }
    }
    n = n
}
; 内部：把日夹到当月天数内（改年 / 月之后调用）
dp-fix-day = (h i64) () {
    n = dp-days(h)
    d = dp-day(h)
    (d > n) -> { CMP-VALUE3[h] = n }
    (d < 1) -> { CMP-VALUE3[h] = 1 }
}
dp-set-year = (h i64, y i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (y < 1) -> { y = 1 }
    CMP-VALUE[h] = y
    dp-fix-day(h)
}
dp-set-month = (h i64, m i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    m = ct-clamp(m, 1, 12)
    CMP-VALUE2[h] = m
    dp-fix-day(h)
}
dp-set-day = (h i64, d i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = dp-days(h)
    CMP-VALUE3[h] = ct-clamp(d, 1, n)
}
dp-set-date = (h i64, y i64, m i64, d i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (y < 1) -> { y = 1 }
    m = ct-clamp(m, 1, 12)
    CMP-VALUE[h] = y
    CMP-VALUE2[h] = m
    n = dp-days(h)
    CMP-VALUE3[h] = ct-clamp(d, 1, n)
}
; 翻下一个月（12 月回绕到 1 月）；走 dp-set-month，所以同样受 F-DISABLED 约束
dp-next-month = (h i64) () {
    m = dp-month(h)
    (m >= 12) -> { dp-set-month(h, 1) }
    (m < 12) -> { dp-set-month(h, ct-add(m, 1)) }
}
; 两位补零
dp-pad2 = (n i64) (s str) {
    s = ''
    (n < 10) -> { s.push-str('0') }
    s.push-str(n.to-str())
    s = s
}
; 「YYYY-MM-DD」
dp-label = (h i64) (s str) {
    s = ''
    s.push-str(dp-year(h).to-str())
    s.push-str('-')
    s.push-str(dp-pad2(dp-month(h)))
    s.push-str('-')
    s.push-str(dp-pad2(dp-day(h)))
    s = s
}

; ---- highlighter：TEXT = 代码，TEXT2 = 语言，VALUE = 缩进（每级空格数）----
; 着色直接复用编辑器的 ed-lex-line（阶段38 起就是它给输入框 / 编辑器上色），
; 行几何复用 textarea 的「'\n' 分行」算法（阶段39），这里只加缩进折算。
hl-pad = () (p i64) { p = 1200 }
hl-gutter = () (g i64) { g = 4000 }
hl-gap = () (g i64) { g = 800 }

hl-code = (h i64) (s str) { s = cmp-text(h) }
hl-set-code = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cmp-set-text(h, s)
}
hl-lang = (h i64) (s str) { s = cmp-text2(h) }
hl-set-lang = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cmp-set-text2(h, s)
}
hl-tab = (h i64) (n i64) { n = CMP-VALUE[h]: { ok -> it

-> 0 } }
hl-set-tab = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-clamp(n, 0, 8)
    CMP-VALUE[h] = n
}
; 行数：'\n' 个数 + 1（空文本算 1 行）
hl-lines = (h i64) (n i64) {
    t = hl-code(h)
    nb = t.len-bytes()
    n = 1
    i = 0
    !! {
        (i >= nb) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}
; 第 l 行（0 基）起始字节下标
hl-line-start = (h i64, l i64) (b i64) {
    t = hl-code(h)
    nb = t.len-bytes()
    b = 0
    i = 0
    seen = 0
    !! {
        (seen >= l) -> { ** }
        (i >= nb) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> {
            seen = ct-inc(seen)
            b = ct-inc(i)
        }
        i = ct-inc(i)
    }
    b = b
}
; 第 l 行的字节长度（不含 '\n'）
hl-line-len-b = (h i64, l i64) (n i64) {
    t = hl-code(h)
    nb = t.len-bytes()
    n = 0
    i = hl-line-start(h, l)
    !! {
        (i >= nb) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> { ** }
        n = ct-inc(n)
        i = ct-inc(i)
    }
    n = n
}
hl-line = (h i64, l i64) (s str) {
    t = hl-code(h)
    b = hl-line-start(h, l)
    s = t.slice-bytes(b, ct-add(b, hl-line-len-b(h, l)))
}
; 展开长度：tab 折算成 hl-tab 个空格（其余字符按 1 计）
hl-expand-len = (h i64, l i64) (n i64) {
    t = hl-code(h)
    nb = t.len-bytes()
    n = 0
    i = hl-line-start(h, l)
    !! {
        (i >= nb) -> { ** }
        ch = t.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> { ** }
        (ch == '\t') -> { n = ct-add(n, hl-tab(h)) }
        (ch != '\t') -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}
hl-max-len = (h i64) (m i64) {
    n = hl-lines(h)
    m = 0
    i = 0
    !! {
        (i >= n) -> { ** }
        el = hl-expand-len(h, i)
        (el > m) -> { m = el }
        i = ct-inc(i)
    }
    m = m
}

; ---- theme：TEXT = 名字，VALUE = 模式（0 亮 / 1 暗），VALUE2 = 密度（0/1/2），COLOR = 强调色 ----
th-pad = () (p i64) { p = 1200 }
th-gap = () (g i64) { g = 800 }
th-label-h = () (n i64) { n = 1600 }

th-name = (h i64) (s str) { s = cmp-text(h) }
th-set-name = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cmp-set-text(h, s)
}
th-mode = (h i64) (n i64) { n = CMP-VALUE[h]: { ok -> it

-> 0 } }
th-set-mode = (h i64, m i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-VALUE[h] = ct-clamp(m, 0, 1)
}
th-density = (h i64) (n i64) { n = CMP-VALUE2[h]: { ok -> it

-> 1 } }
th-set-density = (h i64, d i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-VALUE2[h] = ct-clamp(d, 0, 2)
}
th-accent = (h i64) (c i64) { c = CMP-COLOR[h]: { ok -> it

-> 0 } }
th-set-accent = (h i64, c i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-COLOR[h] = c
}
; 密度 -> 色板边长（紧凑 / 标准 / 宽松）
th-swatch = (h i64) (n i64) {
    n = 4800
    (th-density(h) == 0) -> { n = 3600 }
    (th-density(h) == 2) -> { n = 6000 }
    n = n
}
th-mode-name = (h i64) (s str) {
    s = 'light'
    (th-mode(h) == 1) -> { s = 'dark' }
    s = s
}
th-bg = (h i64) (c i64) {
    c = 0xFFFFFFFF
    (th-mode(h) == 1) -> { c = 0x1E1E28FF }
    c = c
}
th-fg = (h i64) (c i64) {
    c = 0x22222AFF
    (th-mode(h) == 1) -> { c = 0xE8E8F0FF }
    c = c
}
th-muted = (h i64) (c i64) {
    c = 0x666670FF
    (th-mode(h) == 1) -> { c = 0x9AA0B4FF }
    c = c
}
; 四个色板：0 = 底，1 = 前景，2 = 强调，3 = 次要
th-swatch-color = (h i64, i i64) (c i64) {
    c = th-bg(h)
    (i == 1) -> { c = th-fg(h) }
    (i == 2) -> { c = th-accent(h) }
    (i == 3) -> { c = th-muted(h) }
    c = c
}
th-swatch-label = (i i64) (s str) {
    s = 'BG'
    (i == 1) -> { s = 'FG' }
    (i == 2) -> { s = 'ACCENT' }
    (i == 3) -> { s = 'MUTED' }
    s = s
}

; ============================================================================
; 阶段49：diff —— CMP-TEXT = old，CMP-TEXT2 = new。
; 目录第 71 行承诺「old, new, hunks」，此前只有一个 cmp-diff() 构造函数。
; 这里补：行切分（照抄阶段39 的 '\n' 算法）+ LCS 动态规划 + 回溯成行。
; 行级别：0 上下文 / 1 新增 / 2 删除；hunk = 连续非上下文行段。
; 缓存：模块级 DF-* 只存「最近一次」的那份 diff，df-build 发现 old/new 变了就重算
; （单次调用内 paint 会连续读 rows / row-op / row-text，只有第一次真算）。
; ============================================================================
DF-CACHE-H = -1
DF-CACHE-OLD = ''
DF-CACHE-NEW = ''
DF-CACHE-ROWS = 0
DF-CACHE-HUNKS = 0
DF-OP []i64 = with-len(0)
DF-TXT []str = with-len(0)
DF-ONO []i64 = with-len(0)
DF-NNO []i64 = with-len(0)
DF-HSTART []i64 = with-len(0)

df-pad = () (p i64) { p = 1200 }
df-gutter = () (g i64) { g = 4800 }

df-old = (h i64) (s str) { s = cmp-text(h) }
df-set-old = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cmp-set-text(h, s)
}
df-new = (h i64) (s str) { s = cmp-text2(h) }
df-set-new = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cmp-set-text2(h, s)
}

; 行切分：照抄阶段39 的「'\n' 分行」算法（保留末尾空行）
df-split = (s str) (out []str) {
    out = with-len(0)
    nb = s.len-bytes()
    start = 0
    i = 0
    !! {
        (i >= nb) -> {
            out.push(s.slice-bytes(start, nb))
            **
        }
        ch = s.slice-bytes(i, ct-add(i, 1))
        (ch == '\n') -> {
            out.push(s.slice-bytes(start, i))
            start = ct-inc(i)
        }
        i = ct-inc(i)
    }
    out = out
}

df-rev-i = (a []i64) (b []i64) {
    b = with-len(0)
    i = ct-sub(a.len(), 1)
    !! {
        (i < 0) -> { ** }
        b.push(ct-get(a, i))
        i = ct-sub(i, 1)
    }
    b = b
}

; LCS 长度表：dp[i][j] = LCS(a[0..i), b[0..j))，i/j 从 0 起，宽 = m+1
df-lcs = (a []str, b []str) (dp []i64) {
    n = a.len()
    m = b.len()
    w = ct-inc(m)
    dp = with-len(ct-mul(ct-inc(n), w))
    i = 0
    !! {
        (i >= n) -> { ** }
        j = 0
        !! {
            (j >= m) -> { ** }
            ai = ed-arr-get-s(a, i)
            bj = ed-arr-get-s(b, j)
            idx = ct-add(ct-mul(ct-inc(i), w), ct-inc(j))
            (ai == bj) -> {
                v = ct-add(ct-get(dp, ct-add(ct-mul(i, w), j)), 1)
                ct-set(dp, idx, v)
            }
            (ai != bj) -> {
                x = ct-get(dp, ct-add(ct-mul(ct-inc(i), w), j))
                y = ct-get(dp, ct-add(ct-mul(i, w), ct-inc(j)))
                (x >= y) -> { ct-set(dp, idx, x) }
                (x < y) -> { ct-set(dp, idx, y) }
            }
            j = ct-inc(j)
        }
        i = ct-inc(i)
    }
    dp = dp
}

; 回溯：从 (n, m) 倒着走，产出反序 ops，最后翻转
df-backtrack = (a []str, b []str, dp []i64) (ops []i64) {
    n = a.len()
    m = b.len()
    w = ct-inc(m)
    ops = with-len(0)
    i = n
    j = m
    k = 0
    tot = ct-add(n, m)
    !! {
        (k >= tot) -> { ** }
        {
            (i > 0 && j > 0) -> {
                ai = ed-arr-get-s(a, ct-sub(i, 1))
                bj = ed-arr-get-s(b, ct-sub(j, 1))
                (ai == bj) -> {
                    ops.push(0)
                    i = ct-sub(i, 1)
                    j = ct-sub(j, 1)
                }
                (ai != bj) -> {
                    x = ct-get(dp, ct-add(ct-mul(i, w), ct-sub(j, 1)))
                    y = ct-get(dp, ct-add(ct-mul(ct-sub(i, 1), w), j))
                    (x >= y) -> {
                        ops.push(1)
                        j = ct-sub(j, 1)
                    }
                    (x < y) -> {
                        ops.push(2)
                        i = ct-sub(i, 1)
                    }
                }
            }
            (i > 0 && j <= 0) -> {
                ops.push(2)
                i = ct-sub(i, 1)
            }
            (i <= 0 && j > 0) -> {
                ops.push(1)
                j = ct-sub(j, 1)
            }
        }
        k = ct-inc(k)
    }
    ops = df-rev-i(ops)
}

; 重算：切行 -> LCS -> 回溯 -> 生成行 + hunk 起点
df-build = (h i64) () {
    fresh = (DF-CACHE-H == h) && (DF-CACHE-OLD == cmp-text(h)) && (DF-CACHE-NEW == cmp-text2(h))
    (!fresh) -> {
        a = df-split(cmp-text(h))
        b = df-split(cmp-text2(h))
        dp = df-lcs(a, b)
        ops = df-backtrack(a, b, dp)
        DF-OP.truncate(0)
        DF-TXT.truncate(0)
        DF-ONO.truncate(0)
        DF-NNO.truncate(0)
        DF-HSTART.truncate(0)
        n = ops.len()
        ono = 1
        nno = 1
        rows = 0
        hunks = 0
        i = 0
        !! {
            (i >= n) -> { ** }
            op = ct-get(ops, i)
            DF-OP.push(op)
            (op == 0) -> {
                DF-TXT.push(ed-arr-get-s(a, ct-sub(ono, 1)))
                DF-ONO.push(ono)
                DF-NNO.push(nno)
                ono = ct-inc(ono)
                nno = ct-inc(nno)
            }
            (op == 1) -> {
                DF-TXT.push(ed-arr-get-s(b, ct-sub(nno, 1)))
                DF-ONO.push(0)
                DF-NNO.push(nno)
                nno = ct-inc(nno)
            }
            (op == 2) -> {
                DF-TXT.push(ed-arr-get-s(a, ct-sub(ono, 1)))
                DF-ONO.push(ono)
                DF-NNO.push(0)
                ono = ct-inc(ono)
            }
            (op != 0) -> {
                prev = 0
                (i > 0) -> { prev = ct-get(ops, ct-sub(i, 1)) }
                (prev == 0) -> {
                    DF-HSTART.push(i)
                    hunks = ct-inc(hunks)
                }
            }
            rows = ct-inc(rows)
            i = ct-inc(i)
        }
        DF-CACHE-H = h
        DF-CACHE-OLD = cmp-text(h)
        DF-CACHE-NEW = cmp-text2(h)
        DF-CACHE-ROWS = rows
        DF-CACHE-HUNKS = hunks
    }
}

df-rows = (h i64) (n i64) {
    df-build(h)
    n = DF-CACHE-ROWS
}
df-row-op = (h i64, i i64) (v i64) {
    df-build(h)
    v = ct-get(DF-OP, i)
}
df-row-text = (h i64, i i64) (s str) {
    df-build(h)
    s = ed-arr-get-s(DF-TXT, i)
}
df-row-old-no = (h i64, i i64) (v i64) {
    df-build(h)
    v = ct-get(DF-ONO, i)
}
df-row-new-no = (h i64, i i64) (v i64) {
    df-build(h)
    v = ct-get(DF-NNO, i)
}
df-hunks = (h i64) (n i64) {
    df-build(h)
    n = DF-CACHE-HUNKS
}
df-hunk-start = (h i64, k i64) (v i64) {
    df-build(h)
    v = ct-get(DF-HSTART, k)
}

df-count-add = (h i64) (n i64) {
    df-build(h)
    n = 0
    i = 0
    !! {
        (i >= DF-CACHE-ROWS) -> { ** }
        (ct-get(DF-OP, i) == 1) -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}
df-count-del = (h i64) (n i64) {
    df-build(h)
    n = 0
    i = 0
    !! {
        (i >= DF-CACHE-ROWS) -> { ** }
        (ct-get(DF-OP, i) == 2) -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}
df-max-len = (h i64) (m i64) {
    df-build(h)
    m = 0
    i = 0
    !! {
        (i >= DF-CACHE-ROWS) -> { ** }
        s = ed-arr-get-s(DF-TXT, i)
        (s.len() > m) -> { m = s.len() }
        i = ct-inc(i)
    }
    m = m
}
df-summary = (h i64) (s str) {
    df-build(h)
    a = df-count-add(h)
    d = df-count-del(h)
    s = '+'
    s.push-str(a.to-str())
    s.push-str(' ')
    s.push-str('-')
    s.push-str(d.to-str())
    s = s
}

; ============================================================================
; 图表 / 绘图（阶段50）
; ============================================================================
; 目录第 65 行承诺 chart「series, axes」、第 66 行承诺 plot「points, scale」，
; 但命令式侧两者都只有一个构造函数。槽位沿用既有约定：
;   chart：CMP-TEXT = 图表标题；值轴上限 CMP-VALUE2；序列名 / 值走池子。
;   plot ：CMP-TEXT = 图表标题；坐标范围 CMP-VALUE2；点坐标走池子。
; 数据池按句柄扁平索引（同阶段46 的 IP-* / 阶段38 的 INP-SG 段池思路）：
;   CH-NAME 每句柄 CH-SERIES-MAX 格（序列名）
;   CH-VAL  每句柄 CH-STRIDE 格（序列 * 点数 → 值）
;   CH-SN / CH-PN 每句柄 1 格（序列数 / 每条序列点数）
;   PL-X / PL-Y 每句柄 PL-PTS-MAX 格（点坐标）
;   PL-CN / PL-SC 每句柄 1 格（点数 / 坐标范围）
; 池子**懒增长**（ch-ensure / pl-ensure）：句柄只增，首次访问某句柄时把池子补到
; 该句柄所需长度，cmp-alloc 不动。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-CHAR-W=800、CS-LINE-H=2400、CS-MIN-LEAF-W=6400。

CH-SERIES-MAX = 3
CH-PTS-MAX = 8
CH-STRIDE = 24
PL-PTS-MAX = 16
CH-NAME []str = with-len(0)
CH-VAL []i64 = with-len(0)
CH-SN []i64 = with-len(0)
CH-PN []i64 = with-len(0)
PL-X []i64 = with-len(0)
PL-Y []i64 = with-len(0)
PL-CN []i64 = with-len(0)
PL-SC []i64 = with-len(0)

ch-ensure = (h i64) () {
    need = ct-mul(ct-inc(h), CH-STRIDE)
    !! {
        (CH-VAL.len() >= need) -> { ** }
        CH-VAL.push(0)
    }
    need = ct-mul(ct-inc(h), CH-SERIES-MAX)
    !! {
        (CH-NAME.len() >= need) -> { ** }
        CH-NAME.push('')
    }
    need = ct-inc(h)
    !! {
        (CH-SN.len() >= need) -> { ** }
        CH-SN.push(0)
    }
    !! {
        (CH-PN.len() >= need) -> { ** }
        CH-PN.push(0)
    }
}

pl-ensure = (h i64) () {
    need = ct-mul(ct-inc(h), PL-PTS-MAX)
    !! {
        (PL-X.len() >= need) -> { ** }
        PL-X.push(0)
    }
    !! {
        (PL-Y.len() >= need) -> { ** }
        PL-Y.push(0)
    }
    need = ct-inc(h)
    !! {
        (PL-CN.len() >= need) -> { ** }
        PL-CN.push(0)
    }
    !! {
        (PL-SC.len() >= need) -> { ** }
        PL-SC.push(100)
    }
}

; ---- 池内下标 ----
ch-nidx = (h i64, s i64) (v i64) { v = ct-add(ct-mul(h, CH-SERIES-MAX), s) }
ch-vidx = (h i64, s i64, i i64) (v i64) {
    v = ct-add(ct-mul(h, CH-STRIDE), ct-add(ct-mul(s, CH-PTS-MAX), i))
}
pl-idx = (h i64, i i64) (v i64) { v = ct-add(ct-mul(h, PL-PTS-MAX), i) }

; ---- chart：序列数 / 点数 ----
ch-series = (h i64) (n i64) {
    ch-ensure(h)
    n = ct-get(CH-SN, h)
}
ch-set-series = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ch-ensure(h)
    (n < 0) -> { n = 0 }
    (n > CH-SERIES-MAX) -> { n = CH-SERIES-MAX }
    ct-set(CH-SN, h, n)
}
ch-points = (h i64) (n i64) {
    ch-ensure(h)
    n = ct-get(CH-PN, h)
}
ch-set-points = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ch-ensure(h)
    (n < 0) -> { n = 0 }
    (n > CH-PTS-MAX) -> { n = CH-PTS-MAX }
    ct-set(CH-PN, h, n)
}

; ---- chart：序列名 ----
ch-name = (h i64, s i64) (t str) {
    ch-ensure(h)
    t = ''
    ((s >= 0) && (s < ct-get(CH-SN, h))) -> {
        t = ed-arr-get-s(CH-NAME, ch-nidx(h, s))
    }
    t = t
}
ch-set-name = (h i64, s i64, v str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ch-ensure(h)
    ((s >= 0) && (s < ct-get(CH-SN, h))) -> {
        ed-arr-set-s(CH-NAME, ch-nidx(h, s), v)
    }
}

; ---- chart：值轴上限（CMP-VALUE2）----
ch-max = (h i64) (m i64) {
    raw = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
    ; 0 = 没设过（构造函数给的就是 0）→ 默认 100
    (raw <= 0) -> { raw = 100 }
    (raw < 1) -> { raw = 1 }
    m = raw
}
ch-set-max = (h i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (v < 1) -> { v = 1 }
    CMP-VALUE2[h] = v
}

; ---- chart：值 ----
ch-value = (h i64, s i64, i i64) (v i64) {
    ch-ensure(h)
    v = 0
    ((s >= 0) && (s < ct-get(CH-SN, h)) && (i >= 0) && (i < ct-get(CH-PN, h))) -> {
        v = ct-get(CH-VAL, ch-vidx(h, s, i))
    }
    v = v
}
ch-set-value = (h i64, s i64, i i64, val i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ch-ensure(h)
    ((s >= 0) && (s < ct-get(CH-SN, h)) && (i >= 0) && (i < ct-get(CH-PN, h))) -> {
        m = ch-max(h)
        (val < 0) -> { val = 0 }
        (val > m) -> { val = m }
        ct-set(CH-VAL, ch-vidx(h, s, i), val)
    }
}
ch-total = (h i64, s i64) (v i64) {
    ch-ensure(h)
    v = 0
    pn = ct-get(CH-PN, h)
    ((s >= 0) && (s < ct-get(CH-SN, h))) -> {
        i = 0
        !! {
            (i >= pn) -> { ** }
            v = ct-add(v, ct-get(CH-VAL, ch-vidx(h, s, i)))
            i = ct-inc(i)
        }
    }
    v = v
}
ch-peak = (h i64) (v i64) {
    ch-ensure(h)
    v = 0
    sn = ct-get(CH-SN, h)
    pn = ct-get(CH-PN, h)
    s = 0
    !! {
        (s >= sn) -> { ** }
        i = 0
        !! {
            (i >= pn) -> { ** }
            x = ct-get(CH-VAL, ch-vidx(h, s, i))
            (x > v) -> { v = x }
            i = ct-inc(i)
        }
        s = ct-inc(s)
    }
    v = v
}

; ---- plot：点数 / 坐标范围（CMP-VALUE2）----
pl-count = (h i64) (n i64) {
    pl-ensure(h)
    n = ct-get(PL-CN, h)
}
pl-set-count = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    pl-ensure(h)
    (n < 0) -> { n = 0 }
    (n > PL-PTS-MAX) -> { n = PL-PTS-MAX }
    ct-set(PL-CN, h, n)
}
pl-scale = (h i64) (v i64) {
    pl-ensure(h)
    v = ct-get(PL-SC, h)
    (v < 1) -> { v = 1 }
    v = v
}
pl-set-scale = (h i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    pl-ensure(h)
    (v < 1) -> { v = 1 }
    ct-set(PL-SC, h, v)
}

; ---- plot：点坐标 ----
pl-x = (h i64, i i64) (v i64) {
    pl-ensure(h)
    v = 0
    ((i >= 0) && (i < ct-get(PL-CN, h))) -> {
        v = ct-get(PL-X, pl-idx(h, i))
    }
    v = v
}
pl-y = (h i64, i i64) (v i64) {
    pl-ensure(h)
    v = 0
    ((i >= 0) && (i < ct-get(PL-CN, h))) -> {
        v = ct-get(PL-Y, pl-idx(h, i))
    }
    v = v
}
pl-set-x = (h i64, i i64, val i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    pl-ensure(h)
    ((i >= 0) && (i < ct-get(PL-CN, h))) -> {
        m = pl-scale(h)
        (val < cs-neg(m)) -> { val = cs-neg(m) }
        (val > m) -> { val = m }
        ct-set(PL-X, pl-idx(h, i), val)
    }
}
pl-set-y = (h i64, i i64, val i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    pl-ensure(h)
    ((i >= 0) && (i < ct-get(PL-CN, h))) -> {
        m = pl-scale(h)
        (val < cs-neg(m)) -> { val = cs-neg(m) }
        (val > m) -> { val = m }
        ct-set(PL-Y, pl-idx(h, i), val)
    }
}
cs-neg = (a i64) (v i64) {
    x = 0 - a: {
        ok -> it

        -> 0
    }
    v = x
}

; ---- plot：数据包围盒 ----
pl-min-x = (h i64) (v i64) {
    pl-ensure(h)
    n = ct-get(PL-CN, h)
    v = 0
    (n > 0) -> {
        v = ct-get(PL-X, pl-idx(h, 0))
        i = 1
        !! {
            (i >= n) -> { ** }
            x = ct-get(PL-X, pl-idx(h, i))
            (x < v) -> { v = x }
            i = ct-inc(i)
        }
    }
    v = v
}
pl-max-x = (h i64) (v i64) {
    pl-ensure(h)
    n = ct-get(PL-CN, h)
    v = 0
    (n > 0) -> {
        v = ct-get(PL-X, pl-idx(h, 0))
        i = 1
        !! {
            (i >= n) -> { ** }
            x = ct-get(PL-X, pl-idx(h, i))
            (x > v) -> { v = x }
            i = ct-inc(i)
        }
    }
    v = v
}
pl-min-y = (h i64) (v i64) {
    pl-ensure(h)
    n = ct-get(PL-CN, h)
    v = 0
    (n > 0) -> {
        v = ct-get(PL-Y, pl-idx(h, 0))
        i = 1
        !! {
            (i >= n) -> { ** }
            x = ct-get(PL-Y, pl-idx(h, i))
            (x < v) -> { v = x }
            i = ct-inc(i)
        }
    }
    v = v
}
pl-max-y = (h i64) (v i64) {
    pl-ensure(h)
    n = ct-get(PL-CN, h)
    v = 0
    (n > 0) -> {
        v = ct-get(PL-Y, pl-idx(h, 0))
        i = 1
        !! {
            (i >= n) -> { ** }
            x = ct-get(PL-Y, pl-idx(h, i))
            (x > v) -> { v = x }
            i = ct-inc(i)
        }
    }
    v = v
}

; ---- 几何常量（渲染层抄同一份字面量）----
ch-pad = () (p i64) { p = 1200 }
ch-title-h = () (v i64) { v = 2400 }
ch-plot-h = () (v i64) { v = 32000 }
ch-slot = () (v i64) { v = 7200 }
ch-bar-gap = () (v i64) { v = 200 }
pl-slot = () (v i64) { v = 4800 }
pl-dot = () (v i64) { v = 500 }
pl-line = () (v i64) { v = 200 }

; ==========================================================================
; 阶段51：C-NATIVE-MENU —— 自绘下拉菜单（按钮 + 弹层列表）
;   槽位：TEXT = 按钮文案；VALUE = 项数；VALUE2 = 选中项 + 1（0 = 未选）；
;         COLOR = 强调色。弹层展开用 F-OPEN。
;   数据池按句柄定步长：NM-LABEL 步长 NM-MAX，NM-CN / NM-SEL 各一格。
;   「原生」在这里是自绘的：框架没有平台菜单图元，按钮 / 弹层都用
;   rect + text 画（同 C-CHART / C-PLOT 的做法），命中测试走 cs-menu-hit。
; ==========================================================================
NM-MAX = 8
NM-LABEL []str = with-len(0)
NM-CN []i64 = with-len(0)
NM-SEL []i64 = with-len(0)

nm-ensure = (h i64) () {
    need = ct-mul(ct-inc(h), NM-MAX)
    !! {
        (NM-LABEL.len() >= need) -> { ** }
        NM-LABEL.push('')
    }
    need = ct-inc(h)
    !! {
        (NM-CN.len() >= need) -> { ** }
        NM-CN.push(0)
    }
    need = ct-mul(ct-inc(h), NM-MAX)
    !! {
        (NM-SEL.len() >= need) -> { ** }
        NM-SEL.push(0)
    }
}

nm-count = (h i64) (v i64) {
    nm-ensure(h)
    v = ct-get(NM-CN, h)
}
nm-set-count = (h i64, n i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    nm-ensure(h)
    (n < 0) -> { n = 0 }
    (n > NM-MAX) -> { n = NM-MAX }
    ct-set(NM-CN, h, n)
    CMP-VALUE[h] = n
    raw = nm-raw-sel(h)
    (raw > n) -> { CMP-VALUE2[h] = 0 }
}
nm-raw-sel = (h i64) (v i64) {
    v = ct-get(CMP-VALUE2, h)
}
nm-label = (h i64, i i64) (v str) {
    v = ''
    nm-ensure(h)
    ((i >= 0) && (i < ct-get(NM-CN, h))) -> {
        v = ed-arr-get-s(NM-LABEL, ct-add(ct-mul(h, NM-MAX), i))
    }
    v = v
}
nm-set-label = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    nm-ensure(h)
    ((i >= 0) && (i < ct-get(NM-CN, h))) -> {
        ed-arr-set-s(NM-LABEL, ct-add(ct-mul(h, NM-MAX), i), s)
    }
}
nm-index = (h i64) (v i64) {
    v = ct-sub(nm-raw-sel(h), 1)
    (v < -1) -> { v = -1 }
    v = v
}
nm-set-index = (h i64, i i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = nm-count(h)
    (i < -1) -> { i = -1 }
    (i >= n) -> { i = ct-sub(n, 1) }
    (i < 0) -> { CMP-VALUE2[h] = 0 }
    (i >= 0) -> { CMP-VALUE2[h] = ct-inc(i) }
}
nm-item-off = (h i64, i i64) (v i64) {
    v = 0
    ((i >= 0) && (i < ct-get(NM-CN, h))) -> {
        v = ct-get(NM-SEL, ct-add(ct-mul(h, NM-MAX), i))
    }
    v = v
}
nm-set-item-off = (h i64, i i64, b i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    nm-ensure(h)
    ((i >= 0) && (i < ct-get(NM-CN, h))) -> {
        ct-set(NM-SEL, ct-add(ct-mul(h, NM-MAX), i), b)
    }
}
nm-open = (h i64) () {
    cmp-flag-set(h, F-OPEN)
}
nm-close = (h i64) () {
    cmp-flag-clear(h, F-OPEN)
}
nm-toggle = (h i64) () {
    ; `->` 链不互斥：先取到局部 was，再分支（否则关掉后第二条又开回来）
    was = cmp-has(h, F-OPEN)
    (was) -> { nm-close(h) }
    (!was) -> { nm-open(h) }
}

; ==========================================================================
; 阶段52：C-WINDOW-EXT —— 窗口选项
;   槽位：TEXT = 标题；VALUE = flags（1 可缩放 / 2 全屏 / 4 置顶 / 8 边框）；
;         VALUE2 = 总开关（1 = 接管，0 = 只存状态不动窗口）；COLOR = 强调色。
;   数据池每句柄一格（WE-MIN / WE-MAX / WE-SIZE 每句柄两格），we-ensure 按需补格。
;   真源在组件里；「推到真窗口」那一步在装配层（app.no 的 app-window-apply），
;   因为组件层看不到 app 层 —— 同 cs-dock-* 的分工。
; ==========================================================================
WE-TITLE []str = with-len(0)
WE-FLAGS []i64 = with-len(0)
WE-OP []i64 = with-len(0)
WE-MIN []i64 = with-len(0)
WE-MAX []i64 = with-len(0)
WE-SIZE []i64 = with-len(0)
WE-ROWS = 8

WE-F-RES = 1
WE-F-FS = 2
WE-F-TOP = 4
WE-F-BRD = 8

we-ensure = (h i64) () {
    need = ct-inc(h)
    !! {
        (WE-TITLE.len() >= need) -> { ** }
        WE-TITLE.push('')
    }
    !! {
        (WE-FLAGS.len() >= need) -> { ** }
        WE-FLAGS.push(ct-or(WE-F-RES, WE-F-BRD))
    }
    !! {
        (WE-OP.len() >= need) -> { ** }
        WE-OP.push(100)
    }
    need = ct-mul(need, 2)
    !! {
        (WE-MIN.len() >= need) -> { ** }
        WE-MIN.push(0)
    }
    !! {
        (WE-MAX.len() >= need) -> { ** }
        WE-MAX.push(0)
    }
    !! {
        (WE-SIZE.len() >= need) -> { ** }
        WE-SIZE.push(0)
    }
}

we-title = (h i64) (v str) {
    we-ensure(h)
    v = ed-arr-get-s(WE-TITLE, h)
}
we-set-title = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    we-ensure(h)
    ed-arr-set-s(WE-TITLE, h, s)
    CMP-TEXT[h] = s
}
we-flags = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-FLAGS, h)
}
we-set-flags = (h i64, f i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    we-ensure(h)
    ct-set(WE-FLAGS, h, f)
    CMP-VALUE[h] = f
}
we-resizable = (h i64) (v i64) {
    v = 0
    ((ct-get(WE-FLAGS, h) & WE-F-RES) != 0) -> { v = 1 }
}
we-set-resizable = (h i64, yes i64) () {
    f = we-flags(h)
    (yes != 0) -> { f = ct-or(f, WE-F-RES) }
    (yes == 0) -> { f = ct-and(f, ct-not(WE-F-RES)) }
    we-set-flags(h, f)
}
we-fullscreen = (h i64) (v i64) {
    v = 0
    ((ct-get(WE-FLAGS, h) & WE-F-FS) != 0) -> { v = 1 }
}
we-set-fullscreen = (h i64, yes i64) () {
    f = we-flags(h)
    (yes != 0) -> { f = ct-or(f, WE-F-FS) }
    (yes == 0) -> { f = ct-and(f, ct-not(WE-F-FS)) }
    we-set-flags(h, f)
}
we-always-on-top = (h i64) (v i64) {
    v = 0
    ((ct-get(WE-FLAGS, h) & WE-F-TOP) != 0) -> { v = 1 }
}
we-set-always-on-top = (h i64, yes i64) () {
    f = we-flags(h)
    (yes != 0) -> { f = ct-or(f, WE-F-TOP) }
    (yes == 0) -> { f = ct-and(f, ct-not(WE-F-TOP)) }
    we-set-flags(h, f)
}
we-bordered = (h i64) (v i64) {
    v = 0
    ((ct-get(WE-FLAGS, h) & WE-F-BRD) != 0) -> { v = 1 }
}
we-set-bordered = (h i64, yes i64) () {
    f = we-flags(h)
    (yes != 0) -> { f = ct-or(f, WE-F-BRD) }
    (yes == 0) -> { f = ct-and(f, ct-not(WE-F-BRD)) }
    we-set-flags(h, f)
}
we-opacity = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-OP, h)
}
we-set-opacity = (h i64, p i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    we-ensure(h)
    (p < 0) -> { p = 0 }
    (p > 100) -> { p = 100 }
    ct-set(WE-OP, h, p)
}
we-min-x = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-MIN, ct-mul(h, 2))
}
we-min-y = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-MIN, ct-add(ct-mul(h, 2), 1))
}
we-set-min-size = (h i64, w i64, ht i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    we-ensure(h)
    (w < 0) -> { w = 0 }
    (ht < 0) -> { ht = 0 }
    ct-set(WE-MIN, ct-mul(h, 2), w)
    ct-set(WE-MIN, ct-add(ct-mul(h, 2), 1), ht)
}
we-max-x = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-MAX, ct-mul(h, 2))
}
we-max-y = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-MAX, ct-add(ct-mul(h, 2), 1))
}
we-set-max-size = (h i64, w i64, ht i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    we-ensure(h)
    (w < 0) -> { w = 0 }
    (ht < 0) -> { ht = 0 }
    ct-set(WE-MAX, ct-mul(h, 2), w)
    ct-set(WE-MAX, ct-add(ct-mul(h, 2), 1), ht)
}
we-w = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-SIZE, ct-mul(h, 2))
}
we-h = (h i64) (v i64) {
    we-ensure(h)
    v = ct-get(WE-SIZE, ct-add(ct-mul(h, 2), 1))
}
we-set-size = (h i64, w i64, ht i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    we-ensure(h)
    (w < 0) -> { w = 0 }
    (ht < 0) -> { ht = 0 }
    ct-set(WE-SIZE, ct-mul(h, 2), w)
    ct-set(WE-SIZE, ct-add(ct-mul(h, 2), 1), ht)
}
we-on = (h i64) (v i64) {
    v = ct-get(CMP-VALUE2, h)
}
we-set-on = (h i64, yes i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (yes != 0) -> { CMP-VALUE2[h] = 1 }
    (yes == 0) -> { CMP-VALUE2[h] = 0 }
}

; 追加节点（parent < 0 = 挂在根），返回节点句柄
cmp-tree-add = (h i64, parent i64, text str) (node i64) {
    node = cmp-label(text)
    ct-set(TR-PAR, node, parent)
    ct-set(TR-FIRST, node, -1)
    ct-set(TR-NEXT, node, -1)
    ct-set(TR-OPEN, node, 0)
    (parent >= 0) -> {
        ; 注意 `->` 链**不互斥**：第一个分支改了 TR-FIRST，第二个分支的条件
        ; 会跟着变真，两个都会跑（实测把 NEXT[节点] 写成了节点自己 -> 死循环）。
        ; 所以条件先取到局部 has 里，再分支。
        has = 0
        (ct-get(TR-FIRST, parent) >= 0) -> { has = 1 }
        (has == 0) -> { ct-set(TR-FIRST, parent, node) }
        (has != 0) -> {
            s = ct-get(TR-FIRST, parent)
            !! {
                (ct-get(TR-NEXT, s) < 0) -> { ** }
                s = ct-get(TR-NEXT, s)
            }
            ct-set(TR-NEXT, s, node)
        }
    }
    n = ct-get(TR-TCOUNT, h)
    (n == 0) -> { ct-set(TR-TSTART, h, TR-ALL.len()) }
    TR-ALL.push(node)
    ct-set(TR-TCOUNT, h, ct-inc(n))
    node = node
}

cmp-tree-nodes = (h i64) (n i64) { n = ct-get(TR-TCOUNT, h) }
cmp-tree-open-of = (h i64, node i64) (v i64) { v = ct-get(TR-OPEN, node) }
cmp-tree-set-open = (h i64, node i64, v i64) { ct-set(TR-OPEN, node, v) }
cmp-tree-toggle = (h i64, node i64) (v i64) {
    ; 同上：条件先取局部，否则第一个分支把值改成 0 之后第二个分支又会把它改回 1
    open = ct-get(TR-OPEN, node)
    (open != 0) -> { ct-set(TR-OPEN, node, 0) }
    (open == 0) -> { ct-set(TR-OPEN, node, 1) }
    v = ct-get(TR-OPEN, node)
}
cmp-tree-has-kids = (h i64, node i64) (yes i64) {
    yes = 0
    (ct-get(TR-FIRST, node) >= 0) -> { yes = 1 }
}
cmp-tree-kids = (h i64, node i64) (n i64) {
    n = 0
    c = ct-get(TR-FIRST, node)
    !! {
        (c < 0) -> { ** }
        n = ct-inc(n)
        c = ct-get(TR-NEXT, c)
    }
}
; 选中的节点存在 CMP-VALUE[树]（-1 = 没选中）
cmp-tree-selected = (h i64) (node i64) { node = ct-get(CMP-VALUE, h) }
cmp-tree-select = (h i64, node i64) { ct-set(CMP-VALUE, h, node) }

; 层级（0 = 根）：顺着 TR-PAR 往上走
cmp-tree-depth = (h i64, node i64) (d i64) {
    d = 0
    p = ct-get(TR-PAR, node)
    !! {
        (p < 0) -> { ** }
        d = ct-inc(d)
        p = ct-get(TR-PAR, p)
    }
}

; 整棵树统一展开 / 收起（reset 这类操作要用的「一把梭」）
cmp-tree-open-all = (h i64, v i64) () {
    n = ct-get(TR-TCOUNT, h)
    (n > 0) -> {
        base = ct-get(TR-TSTART, h)
        i = 0
        !! {
            (i >= n) -> { ** }
            ct-set(TR-OPEN, ct-get(TR-ALL, ct-add(base, i)), v)
            i = ct-inc(i)
        }
    }
}

; 拍平：可见节点按**先序**写进 out，层级写进 deps，返回可见行数。
; 迭代式先序（显式栈）—— 语言没有可用的递归，深度也不该由数据决定。
; 根倒着入栈、孩子也倒着入栈，弹出顺序才是正序。栈深上限就是节点数。
cmp-tree-flat = (h i64, out []i64, deps []i64) (m i64) {
    m = 0
    n = ct-get(TR-TCOUNT, h)
    (n > 0) -> {
        st []i64 = with-len(n)
        sd []i64 = with-len(n)
        sp = 0
        base = ct-get(TR-TSTART, h)
        i = ct-sub(n, 1)
        !! {
            (i < 0) -> { ** }
            v = ct-get(TR-ALL, ct-add(base, i))
            (ct-get(TR-PAR, v) < 0) -> {
                ct-set(st, sp, v)
                ct-set(sd, sp, 0)
                sp = ct-inc(sp)
            }
            i = ct-sub(i, 1)
        }
        !! {
            (sp <= 0) -> { ** }
            sp = ct-sub(sp, 1)
            d = ct-get(sd, sp)
            v = ct-get(st, sp)
            out.push(v)
            deps.push(d)
            m = ct-inc(m)
            ; 只有「有孩子 且 展开」才把整块孩子压进去；收起 = 子树整块不出现。
            ; 兄弟是单向链表，不能倒着走 —— 先正序收进 ks，再**倒着**压栈，
            ; 弹出顺序才是正序（同 dv-tree-flat 的 j = k-1 .. 0）。
            c = ct-get(TR-FIRST, v)
            (c >= 0) -> {
                (ct-get(TR-OPEN, v) != 0) -> {
                    ks []i64 = with-len(0)
                    !! {
                        (c < 0) -> { ** }
                        ks.push(c)
                        c = ct-get(TR-NEXT, c)
                    }
                    j = ct-sub(ks.len(), 1)
                    !! {
                        (j < 0) -> { ** }
                        ct-set(st, sp, ct-get(ks, j))
                        ct-set(sd, sp, ct-inc(d))
                        sp = ct-inc(sp)
                        j = ct-sub(j, 1)
                    }
                }
            }
        }
    }
    m = m
}

; 命中链上溯到「行」（cs-hit 返回最深节点，可能命中的是行里的文本标签）
cmp-tree-row-of = (h i64, c i64) (row i64) {
    row = -1
    p = c
    !! {
        (p < 0) -> { ** }
        (row >= 0) -> { ** }
        (ct-get(TR-ROW-NODE, p) >= 0) -> { row = p }
        p = ct-get(CMP-PARENT, p)
    }
}
cmp-tree-node-of = (h i64, row i64) (node i64) { node = ct-get(TR-ROW-NODE, row) }
cmp-tree-arrow-of = (h i64, row i64) (a i64) { a = ct-get(TR-ARROW, row) }

; 一行的「壳」：横向 C-FORM + 选中态（底色 / flags），挂到树上并登记 TR-ROW-NODE。
; 单独把壳拆出来是因为 CHILD-IDX 是**全局扁平数组**：一个父的子节点必须
; 连续挂载（cmp-child 按 HEAD + i 取），所以 cmp-tree-sync 要先把所有行壳
; 一口气挂到树上，再逐行填内容 —— 边建行边填内容会让行的标签插进树的子链里。
cmp-tree-row-head = (h i64, node i64, selbg i64) (row i64) {
    f = F-VISIBLE | F-ENABLED
    bg = 0
    (ct-get(CMP-VALUE, h) == node) -> {
        f = f | F-SELECTED
        bg = selbg
    }
    row = cmp-form()
    cmp-set-lay(row, L-H)
    cmp-set-pad(row, 0)
    cmp-set-gap(row, 0)
    cmp-set-sh(row, CT-ROW-H)
    ct-set(CMP-COLOR, row, bg)
    ct-set(CMP-FLAGS, row, f)
    cmp-add-child(h, row)
    ct-set(TR-ROW-NODE, row, node)
    row = row
}

; 一行的「内容」：右对齐「缩进 + 箭头」标签 + 文本标签（都挂在行上）。
; 选中态从行自己的 F-SELECTED 读（壳已经记下），文本主色跟着变 accent。
; 箭头标签只在有孩子时给真箭头 —— 叶子那一格是空的定宽占位，层级因此仍然对齐。
cmp-tree-row-body = (row i64, node i64, d i64, fg i64, muted i64, accent i64) () {
    f = F-VISIBLE | F-ENABLED
    tc = fg
    (cmp-has(row, F-SELECTED)) -> {
        f = f | F-SELECTED
        tc = accent
    }
    at = ''
    ac = muted
    (ct-get(TR-FIRST, node) >= 0) -> {
        ac = fg
        at = CT-SHUT
        (ct-get(TR-OPEN, node) != 0) -> { at = CT-OPEN }
    }
    an = cmp-alloc(C-LABEL, at, '', ac, 0)
    cmp-set-sw(an, ct-add(ct-mul(d, CT-INDENT), CT-ARROW-W))
    cmp-set-align(an, A-RIGHT)
    ct-set(CMP-FLAGS, an, f)
    cmp-add-child(row, an)
    ct-set(TR-ARROW, row, an)
    t = cmp-alloc(C-LABEL, cmp-text(node), '', tc, 0)
    ct-set(CMP-FLAGS, t, f)
    cmp-add-child(row, t)
}

; 单行 convenience（只建一行时用；批量重建走 cmp-tree-sync 的两段式）
cmp-tree-row = (h i64, node i64, d i64, selbg i64, fg i64, muted i64, accent i64) (row i64) {
    row = cmp-tree-row-head(h, node, selbg)
    cmp-tree-row-body(row, node, d, fg, muted, accent)
    row = row
}

; 重建视觉行：先摘掉上一轮的旧行（顺手清 TR-ROW-NODE / TR-ARROW），再按当前
; 展开态拍平、逐行重建。返回可见行数。
cmp-tree-sync = (h i64, selbg i64, fg i64, muted i64, accent i64) (n i64) {
    rows []i64 = with-len(0)
    cnt = ct-get(CMP-COUNT, h)
    hd = ct-get(CMP-HEAD, h)
    i = 0
    !! {
        (i >= cnt) -> { ** }
        c = ct-get(CHILD-IDX, ct-add(hd, i))
        (ct-get(TR-ROW-NODE, c) >= 0) -> {
            rows.push(c)
            ct-set(TR-ROW-NODE, c, -1)
            ct-set(TR-ARROW, c, -1)
        }
        i = ct-inc(i)
    }
    i = 0
    !! {
        (i >= rows.len()) -> { ** }
        cmp-detach(h, ct-get(rows, i))
        i = ct-inc(i)
    }
    flat []i64 = with-len(0)
    deps []i64 = with-len(0)
    m = cmp-tree-flat(h, flat, deps)
    ; 两段式：先挂全部行壳（树的子链连续），再逐行填内容（行的子链连续）
    i = 0
    !! {
        (i >= m) -> { ** }
        cmp-tree-row-head(h, ct-get(flat, i), selbg)
        i = ct-inc(i)
    }
    i = 0
    !! {
        (i >= m) -> { ** }
        r = cmp-child(h, i)
        cmp-tree-row-body(r, ct-get(flat, i), ct-get(deps, i), fg, muted, accent)
        i = ct-inc(i)
    }
    n = m
}

; ============================================================================
; 12. 代码编辑器（阶段34：命令式侧功能对等）
; ============================================================================
; 根就是 C-SCROLL（构造器 cmp-editor），可见行**直接挂在滚动容器上** —— 不走
; 声明式 dv-code-editor 那层 body C-FORM 中转。内容高 / 起始行号由
; cmp-editor-sync 声明给布局（CMP-SCROLL-CONTENT / CMP-SCROLL-START），
; 于是 cs-layout 的 C-SCROLL 虚拟列表分支给出：行 i 的内容顶 =
; y + pad - off + i*行距，和 cmp-win-range 的窗口算式严格对齐。
;
; 文本模型是全局单份 ED-LINES（和声明式 DV-ED-LINES 同构：一层缓冲区，多个
; 编辑器句柄可以各自带光标看同一份文本）。光标按句柄存 ED-L / ED-C。
; 滚动偏移的真源是 CMP-VALUE[根]（cs-layout 读它、事件侧滚轮也写它），
; 不另开池 —— 和内核滚动容器同一套约定。
; 颜色不写死在组件库里（components.no 不 import cmp-scene，拿不到 cs-theme），
; 由调用方把主题色当参数传进来。

ED-CARET-W = 200       ; 光标宽 2px
ED-TAB = '    '        ; Tab = 4 空格（等宽字体下才对齐）

; SDL 键码（事件侧把 e.key.key 原样传进来）：方向键在 0x40000000 段
ED-K-LEFT = 1073741904
ED-K-RIGHT = 1073741903
ED-K-UP = 1073741906
ED-K-DOWN = 1073741905

; 可打印 ASCII 32..126（按键码 -> 字符的唯一查表来源，省掉 char<->int 转换）
ED-PRINT = ' !\"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~'

; 数字 token 的颜色：主题里没有「琥珀色」语义槽，先用常量（关键字 / 字符串 / 注释
; 都走主题，换主题时只有数字不跟着变 —— 这是有意的折中，避免动 cmp-scene）
ED-C-NUM = 0xF2C14EFF

; ---- 小工具：字节 / []str 读写 ----
; 字节读取：s.byte(i) 是 ?byte，越界给 0
ed-byte-at = (s str, i i64) (b i64) {
    b = 0
    (i >= 0) -> {
        x = s.byte(i): {
            ok -> it

            -> 0
        }
        b = x
    }
    b = b
}

ed-arr-get-s = (a []str, i i64) (v str) {
    v = ''
    (i >= 0) -> {
        (i < a.len()) -> {
            x = a[i]: {
                ok -> it

                -> ''
            }
            v = x
        }
    }
    v = v
}

; []str 下标写（place-match 是唯一的合法写法，见编译器 idxwrite 诊断）
ed-arr-set-s = (a []str, i i64, v str) () {
    ni = ct-inc(i)
    !! {
        (a.len() >= ni) -> { ** }
        a.push('')
    }
    (i >= 0) -> {
        a[i]: {
            ok -> it = v
            -> _
        }
    }
}

; 标识符字符：字母 / 数字 / 下划线（数字开头会先被数字分支吃掉）
ed-word-byte = (b i64) (yes i64) {
    yes = 0
    ((b >= 65) && (b <= 90)) -> { yes = 1 }
    ((b >= 97) && (b <= 122)) -> { yes = 1 }
    ((b >= 48) && (b <= 57)) -> { yes = 1 }
    (b == 95) -> { yes = 1 }
    yes = yes
}

; 关键字表：',kw,' 包夹后查 haystack。每次调用重建 haystack —— 关键字表很短，
; 而建表语句不能出现在模块层（没有 `+` 连接 str，模块层也跑不了语句）。
ed-is-kw = (w str) (yes i64) {
    yes = 0
    (w.len-bytes() > 0) -> {
        hay = ''
        hay.push-str(',let,var,fn,if,else,while,for,return,break,continue,')
        hay.push-str('match,case,struct,enum,impl,trait,type,use,with,where,')
        hay.push-str('import,export,module,pub,const,static,class,new,self,')
        hay.push-str('this,super,and,or,not,in,is,as,do,loop,yield,async,')
        hay.push-str('await,ref,mut,priv,get,set,value,component,props,state,')
        pat = ','
        pat.push-str(w)
        pat.push-str(',')
        (hay.index(pat) >= 0) -> { yes = 1 }
    }
    yes = yes
}

; 引号配对：从 i（引号本身）找到闭合引号，返回闭合引号之后的位置
ed-lex-quote = (line str, i i64, qb i64) (j i64) {
    len = line.len-bytes()
    j = ct-inc(i)
    !! {
        (j >= len) -> { ** }
        (ed-byte-at(line, j) == qb) -> {
            j = ct-inc(j)
            **
        }
        j = ct-inc(j)
    }
    j = j
}

; token 入池：与上一个同色就并进去（少挂节点）
ed-run-push = (ts []str, tc []i64, t str, c i64) () {
    n = ts.len()
    (n > 0) -> {
        pc = ct-get(tc, ct-sub(n, 1))
        (pc == c) -> {
            pt = ed-arr-get-s(ts, ct-sub(n, 1))
            pt.push-str(t)
            ts.truncate(ct-sub(n, 1))
            tc.truncate(ct-sub(n, 1))
            ts.push(pt)
            tc.push(c)
        }
        (pc != c) -> {
            ts.push(t)
            tc.push(c)
        }
    }
    (n == 0) -> {
        ts.push(t)
        tc.push(c)
    }
}

; 一行 -> token 序列（写进调用方给的 ts / tc，返回 token 数）
; 分类：字符串 / 数字 / 标识符（含关键字）/ 空白 / 单字符标点。
; 注释按 nolang 的 `;` 算 —— 从分号到行尾整段灰色。
; 颜色由调用方传：kwc 关键字 / strc 字符串 / comc 注释 / defc 默认（数字用常量）。
ed-lex-line = (line str, ts []str, tc []i64, kwc i64, strc i64, comc i64, defc i64) (n i64) {
    ts.truncate(0)
    tc.truncate(0)
    len = line.len-bytes()
    i = 0
    (len > 0) -> {
        ; 分支链写成「纯臂 if-group」（兜底臂是裸 `->`）—— nolang 要求兜底臂
        ; 必须待在 if-group 里，且 group 里不能有前置语句，所以 b 在外面取。
        !! {
            (i >= len) -> { ** }
            b = ed-byte-at(line, i)
            {
                ; 注释：; 到行尾
                (b == 59) -> {
                    ed-run-push(ts, tc, line.slice-bytes(i, len), comc)
                    i = len
                }
                ; 字符串
                ((b == 34) || (b == 39)) -> {
                    j = ed-lex-quote(line, i, b)
                    ed-run-push(ts, tc, line.slice-bytes(i, j), strc)
                    i = j
                }
                ; 数字
                ((b >= 48) && (b <= 57)) -> {
                    j = i
                    !! {
                        (j >= len) -> { ** }
                        (ed-byte-at(line, j) < 48) -> { ** }
                        (ed-byte-at(line, j) > 57) -> { ** }
                        j = ct-inc(j)
                    }
                    ed-run-push(ts, tc, line.slice-bytes(i, j), ED-C-NUM)
                    i = j
                }
                ; 标识符 / 关键字
                (ed-word-byte(b) == 1) -> {
                    j = i
                    !! {
                        (j >= len) -> { ** }
                        (ed-word-byte(ed-byte-at(line, j)) == 0) -> { ** }
                        j = ct-inc(j)
                    }
                    w = line.slice-bytes(i, j)
                    c = defc
                    (ed-is-kw(w) == 1) -> { c = kwc }
                    ed-run-push(ts, tc, w, c)
                    i = j
                }
                ; 空白（合并成一段，token 数少一半）
                (b == 32) -> {
                    j = i
                    !! {
                        (j >= len) -> { ** }
                        (ed-byte-at(line, j) != 32) -> { ** }
                        j = ct-inc(j)
                    }
                    ed-run-push(ts, tc, line.slice-bytes(i, j), defc)
                    i = j
                }
                ; 其余：单字符（标点 / 运算符）
                -> {
                    ed-run-push(ts, tc, line.slice-bytes(i, ct-inc(i)), defc)
                    i = ct-inc(i)
                }
            }
        }
    }
    n = ts.len()
}

; ---- 可见窗口 [i0, i1) ----
; 行 i 的内容顶 = pad + i*行距；屏幕顶 = y + pad - off。可见 <=> 屏幕底 > 内容顶
; 且 屏幕顶 < 内容顶 + 行高。行距 = 行高 + 间距（800 = CS-GAP 的字面量，
; components.no 看不到 CS-GAP）。out 由调用方给（长度 >= 2）。
cmp-win-range = (off i64, viewh i64, rowh i64, n i64, out []i64) () {
    i0 = 0
    i1 = 0
    st = ct-add(rowh, 800)
    (n > 0) -> {
        (st > 0) -> {
            i0 = ct-add(ct-div(ct-sub(ct-sub(off, 1200), rowh), st), 1)
            (i0 < 0) -> { i0 = 0 }
            (i0 >= n) -> { i0 = ct-sub(n, 1) }
            i1 = ct-div(ct-add(ct-sub(off, 1200), ct-add(viewh, ct-sub(st, 1))), st)
            (i1 > n) -> { i1 = n }
            (i1 < ct-inc(i0)) -> { i1 = ct-inc(i0) }
        }
    }
    ct-set(out, 0, i0)
    ct-set(out, 1, i1)
}

; ---- 文本模型 ----
; 夹紧光标（每次改完行数组后调用；行数组此时已是新内容）
cmp-editor-clamp = (h i64) () {
    n = ED-LINES.len()
    l = ct-get(ED-L, h)
    c = ct-get(ED-C, h)
    (l < 0) -> { l = 0 }
    (l >= n) -> { l = ct-sub(n, 1) }
    (l < 0) -> { l = 0 }
    ln = ''
    (l < n) -> {
        ln = ED-LINES[l]: {
            ok -> it

            -> ''
        }
    }
    (c < 0) -> { c = 0 }
    (c > ln.len-bytes()) -> { c = ln.len-bytes() }
    ct-set(ED-L, h, l)
    ct-set(ED-C, h, c)
}

cmp-editor-set-text = (h i64, t str) (n i64) {
    ED-LINES.truncate(0)
    cur = ''
    i = 0
    nb = t.len-bytes()
    !! {
        (i >= nb) -> { ** }
        b = ed-byte-at(t, i)
        (b == 10) -> {
            ED-LINES.push(cur)
            cur = ''
        }
        (b != 10) -> {
            cur.push-str(t.slice-bytes(i, ct-inc(i)))
        }
        i = ct-inc(i)
    }
    ED-LINES.push(cur)
    n = ED-LINES.len()
    cmp-editor-clamp(h)
    n = n
}

cmp-editor-text = () (s str) {
    s = ''
    i = 0
    n = ED-LINES.len()
    !! {
        (i >= n) -> { ** }
        (i > 0) -> { s.push-str('\n') }
        x = ED-LINES[i]: {
            ok -> it

            -> ''
        }
        s.push-str(x)
        i = ct-inc(i)
    }
    s = s
}

cmp-editor-lines = () (n i64) { n = ED-LINES.len() }
cmp-editor-line = (i i64) (s str) { s = ed-arr-get-s(ED-LINES, i) }
cmp-editor-set-line = (i i64, s str) () { ed-arr-set-s(ED-LINES, i, s) }

cmp-editor-line-of = (h i64) (l i64) { l = ct-get(ED-L, h) }
cmp-editor-col-of = (h i64) (c i64) { c = ct-get(ED-C, h) }
cmp-editor-set-cur = (h i64, l i64, c i64) () {
    ct-set(ED-L, h, l)
    ct-set(ED-C, h, c)
    cmp-editor-clamp(h)
}

; 删掉第 at 行 / 在第 at 行前插入一行（重建数组 —— []str 没有 remove）
cmp-editor-del-line = (at i64) () {
    ED-KEEP.truncate(0)
    i = 0
    n = ED-LINES.len()
    !! {
        (i >= n) -> { ** }
        (i != at) -> {
            x = ED-LINES[i]: {
                ok -> it

                -> ''
            }
            ED-KEEP.push(x)
        }
        i = ct-inc(i)
    }
    ED-LINES.truncate(0)
    j = 0
    m = ED-KEEP.len()
    !! {
        (j >= m) -> { ** }
        y = ED-KEEP[j]: {
            ok -> it

            -> ''
        }
        ED-LINES.push(y)
        j = ct-inc(j)
    }
}

cmp-editor-ins-line = (at i64, s str) () {
    ED-KEEP.truncate(0)
    i = 0
    n = ED-LINES.len()
    !! {
        (i >= n) -> { ** }
        (i == at) -> { ED-KEEP.push(s) }
        x = ED-LINES[i]: {
            ok -> it

            -> ''
        }
        ED-KEEP.push(x)
        i = ct-inc(i)
    }
    (at >= n) -> { ED-KEEP.push(s) }
    ED-LINES.truncate(0)
    j = 0
    m = ED-KEEP.len()
    !! {
        (j >= m) -> { ** }
        y = ED-KEEP[j]: {
            ok -> it

            -> ''
        }
        ED-LINES.push(y)
        j = ct-inc(j)
    }
}

; ---- 编辑原语（都只改全局行数组 + 本句柄的光标）----
cmp-editor-insert = (h i64, ch str) () {
    l = ct-get(ED-L, h)
    c = ct-get(ED-C, h)
    n = ED-LINES.len()
    (l >= 0) -> {
        (l < n) -> {
            a = ED-LINES[l]: {
                ok -> it

                -> ''
            }
            (c < 0) -> { c = 0 }
            (c > a.len-bytes()) -> { c = a.len-bytes() }
            pre = a.slice-bytes(0, c)
            suf = a.slice-bytes(c, a.len-bytes())
            pre.push-str(ch)
            pre.push-str(suf)
            ed-arr-set-s(ED-LINES, l, pre)
            ; 光标前进**插入串的长度**（Tab 是 4 个空格，不是 1）
            ct-set(ED-C, h, ct-add(c, ch.len-bytes()))
        }
    }
    cmp-editor-clamp(h)
}

; 退格：行内删前一个字符；行首则并入上一行（光标落到拼接处）
cmp-editor-backspace = (h i64) () {
    l = ct-get(ED-L, h)
    c = ct-get(ED-C, h)
    n = ED-LINES.len()
    (l >= 0) -> {
        (l < n) -> {
            a = ED-LINES[l]: {
                ok -> it

                -> ''
            }
            (c > 0) -> {
                pre = a.slice-bytes(0, ct-sub(c, 1))
                suf = a.slice-bytes(c, a.len-bytes())
                pre.push-str(suf)
                ed-arr-set-s(ED-LINES, l, pre)
                ct-set(ED-C, h, ct-sub(c, 1))
            }
            (c <= 0) -> {
                (l > 0) -> {
                    pa = ED-LINES[ct-sub(l, 1)]: {
                        ok -> it

                        -> ''
                    }
                    pl = pa.len-bytes()
                    pa.push-str(a)
                    ed-arr-set-s(ED-LINES, ct-sub(l, 1), pa)
                    cmp-editor-del-line(l)
                    ct-set(ED-L, h, ct-sub(l, 1))
                    ct-set(ED-C, h, pl)
                }
            }
        }
    }
    cmp-editor-clamp(h)
}

; 回车：在光标处把一行拆成两行
cmp-editor-enter = (h i64) () {
    l = ct-get(ED-L, h)
    c = ct-get(ED-C, h)
    n = ED-LINES.len()
    (l >= 0) -> {
        (l < n) -> {
            a = ED-LINES[l]: {
                ok -> it

                -> ''
            }
            (c < 0) -> { c = 0 }
            (c > a.len-bytes()) -> { c = a.len-bytes() }
            pre = a.slice-bytes(0, c)
            suf = a.slice-bytes(c, a.len-bytes())
            ed-arr-set-s(ED-LINES, l, pre)
            cmp-editor-ins-line(ct-inc(l), suf)
            ct-set(ED-L, h, ct-inc(l))
            ct-set(ED-C, h, 0)
        }
    }
    cmp-editor-clamp(h)
}

; 光标移动（dl / dc 只有一个非 0）；跨行时列夹到新行长度
cmp-editor-move = (h i64, dl i64, dc i64) () {
    n = ED-LINES.len()
    l = ct-get(ED-L, h)
    c = ct-get(ED-C, h)
    (l < 0) -> { l = 0 }
    (l >= n) -> { l = ct-sub(n, 1) }
    (l < 0) -> { l = 0 }
    (dc != 0) -> {
        nc = ct-add(c, dc)
        (nc < 0) -> {
            ; 跨到上一行末尾；已经在第一行才夹到 0。
            ; 夹取必须发生在 l 自减**之前**判断，否则「从第 1 行行首左移」会被
            ; 误判成「已经在第一行」而吞掉。
            back = 0
            (l > 0) -> {
                l = ct-sub(l, 1)
                pl = ED-LINES[l]: {
                    ok -> it

                    -> ''
                }
                nc = pl.len-bytes()
                back = 1
            }
            (back == 0) -> { nc = 0 }
        }
        ; 前进检查必须用**当前行**的长度：上面 back 分支可能已经把 l 减了一行，
        ; 还拿旧行的 ln 比就会把「跨到上一行末尾」误判成「越过行尾」又跳回去
        ; （声明式 dv-edit-move 有同样的存量缺陷，见 §5.28）。
        cln = ED-LINES[l]: {
            ok -> it

            -> ''
        }
        (nc > cln.len-bytes()) -> {
            ; 跨到下一行行首；已经在最后一行才夹到行尾。
            adv = 0
            (l < ct-sub(n, 1)) -> {
                l = ct-inc(l)
                nc = 0
                adv = 1
            }
            (adv == 0) -> { nc = cln.len-bytes() }
        }
        c = nc
    }
    (dl != 0) -> {
        nl = ct-add(l, dl)
        (nl < 0) -> { nl = 0 }
        (nl >= n) -> { nl = ct-sub(n, 1) }
        (nl >= 0) -> {
            nln = ED-LINES[nl]: {
                ok -> it

                -> ''
            }
            (c > nln.len-bytes()) -> { c = nln.len-bytes() }
            l = nl
        }
    }
    ct-set(ED-L, h, l)
    ct-set(ED-C, h, c)
}

; 键盘入口：事件侧解析出「焦点编辑器」后调它，语义全在这里
cmp-editor-key = (h i64, kk i64) () {
    ; 光标池按句柄存，从没写过就是 -1 —— 归零，否则第一次按键会因为
    ; l < 0 被当成「没有光标」而吞掉。
    l0 = ct-get(ED-L, h)
    (l0 < 0) -> {
        ct-set(ED-L, h, 0)
        ct-set(ED-C, h, 0)
    }
    (kk == 8) -> { cmp-editor-backspace(h) }
    (kk == 13) -> { cmp-editor-enter(h) }
    (kk == 9) -> { cmp-editor-insert(h, ED-TAB) }
    (kk == ED-K-LEFT) -> { cmp-editor-move(h, 0, -1) }
    (kk == ED-K-RIGHT) -> { cmp-editor-move(h, 0, 1) }
    (kk == ED-K-UP) -> { cmp-editor-move(h, -1, 0) }
    (kk == ED-K-DOWN) -> { cmp-editor-move(h, 1, 0) }
    (kk >= 32) -> {
        (kk <= 126) -> {
            i0 = ct-sub(kk, 32)
            ch = ED-PRINT.slice(i0, ct-inc(i0))
            cmp-editor-insert(h, ch)
        }
    }
}

; ---- 光标跟随：只有光标**动了**才重排窗口 ----
; 滚轮把窗口推走时不动光标，此时不许把窗口拽回来 —— 否则滚轮一滚就被弹回。
; 偏移写回 CMP-VALUE[根]（cs-layout 读它）。
cmp-editor-follow = (h i64, viewh i64, rowh i64) (off i64) {
    off = cmp-value(h)
    l = ct-get(ED-L, h)
    seen = ct-get(ED-SEEN, h)
    (l != seen) -> {
        st = ct-add(rowh, 800)
        r []i64 = with-len(2)
        cmp-win-range(off, viewh, rowh, ED-LINES.len(), r)
        i0 = ct-get(r, 0)
        i1 = ct-get(r, 1)
        (l < i0) -> { off = ct-sub(ct-mul(l, st), 1200) }
        (l >= i1) -> {
            off = ct-sub(ct-add(ct-mul(l, st), st), ct-sub(viewh, 1200))
        }
        (off < 0) -> { off = 0 }
        cmp-set-value(h, off)
    }
    ct-set(ED-SEEN, h, l)
    off = off
}

cmp-editor-off = (h i64) (v i64) { v = cmp-value(h) }
cmp-editor-set-off = (h i64, v i64) () { cmp-set-value(h, v) }

; ---- 行渲染：行号 + 着色 token + 光标 ----
; 行壳是横向 C-FORM（定高 rowh、无内边距 / 间距），挂在滚动容器上并登记 ED-ROW。
; 行内：右对齐行号标签（定宽 gutter）+ token 标签 + 定宽 2px 的 C-SEPARATOR 光标。
;
; 🔴 和树同一个坑：CHILD-IDX 是**全局扁平数组**，一个父的子节点必须连续挂载
; （cmp-child 按 HEAD + i 取）。所以必须**先把所有行壳一口气挂到滚动容器上，
; 再逐行填内容** —— 边建行边填内容会把行里的标签插进滚动容器的子链里
; （cmp-children(根) 会数错、cmp-child(根,1) 拿到上一行的行号标签）。
cmp-editor-row-head = (h i64, rowh i64) (row i64) {
    row = cmp-form()
    cmp-set-lay(row, L-H)
    cmp-set-pad(row, 0)
    cmp-set-gap(row, 0)
    cmp-set-sh(row, rowh)
    cmp-add-child(h, row)
    ct-set(ED-ROW, row, 1)
    row = row
}

cmp-editor-row-body = (h i64, row i64, i i64, gutter i64, rowh i64, fg i64, muted i64, accent i64, okc i64) () {
    f = F-VISIBLE | F-ENABLED
    ; 行号：右对齐在定宽槽里（等宽数字 -> 视觉对齐）
    ns = i.to-str()
    g = cmp-alloc(C-LABEL, ns, '', muted, 0)
    cmp-set-sw(g, gutter)
    cmp-set-align(g, A-RIGHT)
    ct-set(CMP-FLAGS, g, f)
    cmp-add-child(row, g)
    ; 文本
    line = ''
    (i < ED-LINES.len()) -> {
        line = ED-LINES[i]: {
            ok -> it

            -> ''
        }
    }
    cur = 0
    (ct-get(ED-L, h) == i) -> { cur = 1 }
    col = ct-get(ED-C, h)
    ts []str = with-len(0)
    tc []i64 = with-len(0)
    nt = ed-lex-line(line, ts, tc, accent, okc, muted, fg)
    ll = line.len-bytes()
    cc = col
    (cc < 0) -> { cc = 0 }
    (cc > ll) -> { cc = ll }
    ; 光标落在哪个 token（token 覆盖整行，所以必然命中）
    cj = -1
    cin = 0
    acc = 0
    j = 0
    !! {
        (j >= nt) -> { ** }
        t = ed-arr-get-s(ts, j)
        tl = t.len-bytes()
        ((cc >= acc) && (cc <= ct-add(acc, tl))) -> {
            cj = j
            cin = ct-sub(cc, acc)
            **
        }
        acc = ct-add(acc, tl)
        j = ct-inc(j)
    }
    ; 逐 token 挂 label；光标所在 token 拆成 前缀 / 光标 / 后缀
    j = 0
    !! {
        (j >= nt) -> { ** }
        t = ed-arr-get-s(ts, j)
        c = ct-get(tc, j)
        tl = t.len-bytes()
        ((cur != 0) && (j == cj)) -> {
            (tl > 0) -> {
                pre = t.slice-bytes(0, cin)
                suf = t.slice-bytes(cin, tl)
                (pre.len-bytes() > 0) -> {
                    lb = cmp-alloc(C-LABEL, pre, '', c, 0)
                    ct-set(CMP-FLAGS, lb, f)
                    cmp-add-child(row, lb)
                }
                car = cmp-alloc(C-SEPARATOR, '', '', accent, 0)
                cmp-set-sw(car, ED-CARET-W)
                cmp-set-sh(car, rowh)
                ct-set(CMP-FLAGS, car, f)
                cmp-add-child(row, car)
                (suf.len-bytes() > 0) -> {
                    lb2 = cmp-alloc(C-LABEL, suf, '', c, 0)
                    ct-set(CMP-FLAGS, lb2, f)
                    cmp-add-child(row, lb2)
                }
            }
            (tl <= 0) -> {
                car2 = cmp-alloc(C-SEPARATOR, '', '', accent, 0)
                cmp-set-sw(car2, ED-CARET-W)
                cmp-set-sh(car2, rowh)
                ct-set(CMP-FLAGS, car2, f)
                cmp-add-child(row, car2)
            }
        }
        ((cur == 0) || (j != cj)) -> {
            (tl > 0) -> {
                lb3 = cmp-alloc(C-LABEL, t, '', c, 0)
                ct-set(CMP-FLAGS, lb3, f)
                cmp-add-child(row, lb3)
            }
        }
        j = ct-inc(j)
    }
    ; 空行：没有 token 也要有光标
    ((cur != 0) && (nt <= 0)) -> {
        car3 = cmp-alloc(C-SEPARATOR, '', '', accent, 0)
        cmp-set-sw(car3, ED-CARET-W)
        cmp-set-sh(car3, rowh)
        ct-set(CMP-FLAGS, car3, f)
        cmp-add-child(row, car3)
    }
}

; 单行 convenience（只建一行时用；批量重建走 cmp-editor-sync 的两段式）
cmp-editor-row = (h i64, i i64, gutter i64, rowh i64, fg i64, muted i64, accent i64, okc i64) (row i64) {
    row = cmp-editor-row-head(h, rowh)
    cmp-editor-row-body(h, row, i, gutter, rowh, fg, muted, accent, okc)
    row = row
}

; 命中链上溯到「行」（cs-hit 返回最深节点，可能命中的是行里的标签 / 光标）
cmp-editor-row-of = (h i64, c i64) (row i64) {
    row = -1
    p = c
    !! {
        (p < 0) -> { ** }
        (row >= 0) -> { ** }
        (ct-get(ED-ROW, p) > 0) -> { row = p }
        p = ct-get(CMP-PARENT, p)
    }
    row = row
}

; 重建可见行：先摘掉上一轮的旧行（顺手清 ED-ROW），再跟随光标、算窗口、
; 声明内容高 / 起始行号，最后逐行重建。返回可见行数。
cmp-editor-sync = (h i64, viewh i64, gutter i64, rowh i64, fg i64, muted i64, accent i64, okc i64) (m i64) {
    rows []i64 = with-len(0)
    cnt = ct-get(CMP-COUNT, h)
    hd = ct-get(CMP-HEAD, h)
    i = 0
    !! {
        (i >= cnt) -> { ** }
        c = ct-get(CHILD-IDX, ct-add(hd, i))
        (ct-get(ED-ROW, c) > 0) -> {
            rows.push(c)
            ct-set(ED-ROW, c, 0)
        }
        i = ct-inc(i)
    }
    i = 0
    !! {
        (i >= rows.len()) -> { ** }
        cmp-detach(h, ct-get(rows, i))
        i = ct-inc(i)
    }
    off = cmp-editor-follow(h, viewh, rowh)
    n = ED-LINES.len()
    r []i64 = with-len(2)
    cmp-win-range(off, viewh, rowh, n, r)
    i0 = ct-get(r, 0)
    i1 = ct-get(r, 1)
    ; 内容高 = n*rowh + (n-1)*间距 + 2*内边距（1200 / 800 = CS-PAD / CS-GAP 字面量）
    ch = ct-mul(1200, 2)
    (n > 0) -> {
        ch = ct-add(ct-mul(n, rowh), ct-mul(ct-sub(n, 1), 800))
        ch = ct-add(ch, ct-mul(1200, 2))
    }
    cmp-set-scroll-content(h, ch)
    cmp-set-scroll-start(h, i0)
    ; 两段式：先挂全部行壳（滚动容器的子链连续），再逐行填内容（行的子链连续）
    i = i0
    !! {
        (i >= i1) -> { ** }
        cmp-editor-row-head(h, rowh)
        i = ct-inc(i)
    }
    j = 0
    i = i0
    !! {
        (i >= i1) -> { ** }
        cmp-editor-row-body(h, cmp-child(h, j), i, gutter, rowh, fg, muted, accent, okc)
        j = ct-inc(j)
        i = ct-inc(i)
    }
    m = ct-sub(i1, i0)
}

; ============================================================================
; 阶段 35：命令式虚拟表格（DataTable）
; ============================================================================
; 语义与声明式 dv-table-list 对齐：表头（不滚）+ 滚动体 + 任意时刻只挂可见行 +
; 内容高**声明**给布局。差别只是「声明」换成「应用直接调」：
;   cmp-table(cols, rows)         根 = C-TABLE（纵向：表头 + 滚动体）
;   cmp-table-set-head(i, s)      表头文案（逐列，表头定义列数）
;   cmp-table-set-col-w(i, w)     列宽（0 = 自适应）
;   cmp-table-set-cell(r, c, s)   单元格文案（行主序）
;   cmp-table-set-key(r, k)       排序键（数字，缺省 0）
;   cmp-table-sort(desc)          按 TB-ORDER 稳定插入排序
;   cmp-table-reset-order()       恢复源顺序
;   cmp-table-select(h, r)        选中行（-1 = 取消）
;   cmp-table-sync(...)           重建表头 + 可见行
;   cmp-table-row-of / -cell-of / -cell-rc   命中上溯
; 和编辑器一样，**数据模型全局单份**（一张表的数据）；句柄级的偏移 / 选中 /
; 表头行 / 滚动体 / 行->源行号 / 单元格->行列都按句柄存，所以多张表能共存
; （各自的光标状态独立，共享同一份数据 —— 与 cmp-editor 的文本共享同构）。
;
; 内容高 = m*rowh + (m-1)*800 + 2*1200（m = 当前顺序的行数），声明给布局，
; 于是 cmp-scroll-max 不依赖「所有行都挂出来」。
; 1200 / 800 是字面量：components.no 看不到 CS-PAD / CS-GAP。

TB-HEAD []str = with-len(0)     ; 表头文案（列，同时定义列数）
TB-COLW []i64 = with-len(0)     ; 列宽（0 = 自适应）
TB-CELL []str = with-len(0)     ; 单元格文案（行主序，长度 = 行数*列数）
TB-KEY []i64 = with-len(0)      ; 每行排序键（源行号 -> 键，缺省 0）
TB-ORDER []i64 = with-len(0)    ; 当前显示顺序（源行号表）

; 句柄级池（随 cmp-alloc 一起长，下标 = 句柄）
TB-OFF []i64 = with-len(0)      ; 滚动偏移（真源）
TB-SEL []i64 = with-len(0)      ; 选中行（-1 = 无）
TB-HEAD-H []i64 = with-len(0)   ; 表头行句柄（-1 = 没有）
TB-SCR-H []i64 = with-len(0)    ; 滚动体句柄（-1 = 没有）
TB-ROW-SRC []i64 = with-len(0)  ; 行句柄 -> 源行号（-1 = 不是表格行）
TB-CELL-SRC []i64 = with-len(0) ; 单元格句柄 -> 源行号
TB-CELL-COL []i64 = with-len(0) ; 单元格句柄 -> 列号

; ---- 阶段36：可拆面板 ----
DK-SPLIT []i64 = with-len(0)    ; 1 = 可拖分栏（cmp-dock-split 标记，随 cmp-alloc 长）
DK-SPLIT-V []i64 = with-len(0)  ; 分栏位置真源（左屏宽 / 上屏高），随 cmp-alloc 长
DK-GRAB = [-1]                  ; 当前抓握的 dock 句柄（-1 = 没在拖；全局单份）

; ---- 阶段37：命令面板 ----
; 命令表是**全局单份**（应用写、面板读）：CP-TEXT 命令名 / CP-ACT 命令码，
; 源行主序。查询串按面板存 CP-Q（和编辑器的 ED-LINES 同一个路子：一层状态，
; 多个面板句柄可以各自带查询看同一张命令表）。
CP-TEXT []str = with-len(0)     ; 命令名（源行主序）
CP-ACT []i64 = with-len(0)      ; 命令码（源行主序）
CP-Q []str = with-len(0)        ; 每面板查询串（随 cmp-alloc 长）
CP-CUR []i64 = with-len(0)      ; 每面板游标 = 命中表下标（-1 = 无）
CP-OFF []i64 = with-len(0)      ; 每面板滚动偏移（真源，和 TB-OFF 同构）
CP-SB []i64 = with-len(0)       ; 每面板命中表在 CP-SRC 里的基址
CP-SRC []i64 = with-len(0)      ; 命中源行号扁平表（只增，和 DV-PAL-SRC 同构）
CP-INP-H []i64 = with-len(0)    ; 每面板输入框句柄（-1 = 没有）
CP-SCR-H []i64 = with-len(0)    ; 每面板滚动体句柄（-1 = 没有）
CP-ROW-SRC []i64 = with-len(0)  ; 行句柄 -> 源行号（-1 = 不是面板行）

; []i64 下标写：先按需补 0，再 place-match 写（越界 / 负数什么都不做）
tb-arr-set = (a []i64, i i64, v i64) () {
    ni = ct-inc(i)
    !! {
        (a.len() >= ni) -> { ** }
        a.push(0)
    }
    (i >= 0) -> {
        a[i]: {
            ok -> it = v
            -> _
        }
    }
}

cmp-table-cols = () (n i64) { n = TB-HEAD.len() }
cmp-table-rows = () (n i64) {
    n = 0
    cols = TB-HEAD.len()
    (cols > 0) -> { n = ct-div(TB-CELL.len(), cols) }
}

cmp-table-set-head = (i i64, s str) () {
    ed-arr-set-s(TB-HEAD, i, s)
    tb-arr-set(TB-COLW, i, 0)
}
cmp-table-head = (i i64) (s str) { s = ed-arr-get-s(TB-HEAD, i) }
cmp-table-set-col-w = (i i64, w i64) () { tb-arr-set(TB-COLW, i, w) }
cmp-table-col-w = (i i64) (w i64) { w = ct-get(TB-COLW, i) }
cmp-table-set-cell = (r i64, c i64, s str) () {
    cols = TB-HEAD.len()
    (cols > 0) -> {
        (r >= 0) -> {
            (c >= 0) -> {
                (c < cols) -> {
                    need = ct-mul(ct-add(r, 1), cols)
                    !! {
                        (TB-CELL.len() >= need) -> { ** }
                        TB-CELL.push('')
                    }
                    i = ct-add(ct-mul(r, cols), c)
                    TB-CELL[i]: {
                        ok -> it = s
                        -> _
                    }
                }
            }
        }
    }
}
cmp-table-cell = (r i64, c i64) (s str) {
    s = ''
    cols = TB-HEAD.len()
    (cols > 0) -> {
        (r >= 0) -> {
            (c >= 0) -> {
                (c < cols) -> { s = ed-arr-get-s(TB-CELL, ct-add(ct-mul(r, cols), c)) }
            }
        }
    }
}
cmp-table-set-key = (r i64, k i64) () { tb-arr-set(TB-KEY, r, k) }
cmp-table-key = (r i64) (k i64) { k = ct-get(TB-KEY, r) }

; 恢复源顺序（0..rows-1）
cmp-table-reset-order = () () {
    TB-ORDER.truncate(0)
    n = 0
    rows = cmp-table-rows()
    !! {
        (n >= rows) -> { ** }
        TB-ORDER.push(n)
        n = ct-inc(n)
    }
}

; 按 TB-KEY 对 TB-ORDER 做**稳定**插入排序（和 dv-sort-run 同一形状）：
; desc = 0 升序，非 0 降序。键缺省 0，所以没设键的行彼此保持源序。
cmp-table-sort = (desc i64) () {
    n = TB-ORDER.len()
    i = 1
    !! {
        (i >= n) -> { ** }
        cur = ct-get(TB-ORDER, i)
        ck = ct-get(TB-KEY, cur)
        j = i
        !! {
            (j <= 0) -> { ** }
            pv = ct-get(TB-ORDER, ct-sub(j, 1))
            pk = ct-get(TB-KEY, pv)
            mv = 0
            (desc == 0) -> { (ck < pk) -> { mv = 1 } }
            (desc != 0) -> { (ck > pk) -> { mv = 1 } }
            (mv == 0) -> { ** }
            tb-arr-set(TB-ORDER, j, pv)
            j = ct-sub(j, 1)
        }
        tb-arr-set(TB-ORDER, j, cur)
        i = ct-inc(i)
    }
}

cmp-table-select = (h i64, r i64) () { ct-set(TB-SEL, h, r) }
cmp-table-selected = (h i64) (r i64) { r = ct-get(TB-SEL, h) }
cmp-table-scroll = (h i64) (s i64) { s = ct-get(TB-SCR-H, h) }
cmp-table-off = (h i64) (v i64) { v = ct-get(TB-OFF, h) }
cmp-table-set-off = (h i64, v i64) () { ct-set(TB-OFF, h, v) }

; 命中上溯：cs-hit 给的是最深节点（单元格标签 / 行 / 表头），要沿 CMP-PARENT 找回
; 行号 = **源行号**（排序后依然对，因为行壳上记的是源行号）。
cmp-table-row-of = (h i64, c i64) (row i64) {
    row = -1
    p = c
    !! {
        (p < 0) -> { ** }
        (p == h) -> { ** }
        (row >= 0) -> { ** }
        (ct-get(TB-ROW-SRC, p) >= 0) -> { row = ct-get(TB-ROW-SRC, p) }
        p = cmp-parent-of(p)
    }
}
cmp-table-cell-of = (h i64, c i64) (cell i64) {
    cell = -1
    p = c
    !! {
        (p < 0) -> { ** }
        (p == h) -> { ** }
        (cell >= 0) -> { ** }
        (ct-get(TB-CELL-SRC, p) >= 0) -> { cell = p }
        p = cmp-parent-of(p)
    }
}
cmp-table-cell-rc = (h i64, c i64, out []i64) () {
    ct-set(out, 0, -1)
    ct-set(out, 1, -1)
    cell = cmp-table-cell-of(h, c)
    (cell >= 0) -> {
        ct-set(out, 0, ct-get(TB-CELL-SRC, cell))
        ct-set(out, 1, ct-get(TB-CELL-COL, cell))
    }
}

; 清掉旧滚动体里所有行 / 单元格的句柄标记（行壳摘掉后就再也命中不到它们，
; 但标记留着会误导下一次「是不是表格行」的判断）
tb-clear-marks = (scr i64) () {
    n = ct-get(CMP-COUNT, scr)
    i = 0
    !! {
        (i >= n) -> { ** }
        r = cmp-child(scr, i)
        ct-set(TB-ROW-SRC, r, -1)
        nc = ct-get(CMP-COUNT, r)
        j = 0
        !! {
            (j >= nc) -> { ** }
            c = cmp-child(r, j)
            ct-set(TB-CELL-SRC, c, -1)
            ct-set(TB-CELL-COL, c, -1)
            j = ct-inc(j)
        }
        i = ct-inc(i)
    }
}

; 行壳：L-H 的 C-GRID，定高 rowh，零内边距零间距（和声明式 dv-table-rows 一致）
cmp-table-row-head = (scr i64, cols i64, rowh i64) (row i64) {
    row = cmp-grid(cols, 1)
    cmp-set-lay(row, L-H)
    cmp-set-pad(row, 0)
    cmp-set-gap(row, 0)
    cmp-set-sh(row, rowh)
    cmp-add-child(scr, row)
    row = row
}

; 行内容：底色 / 文字色随选中态；逐列一个 C-LABEL 单元格（定宽就 cmp-set-sw）
cmp-table-row-body = (h i64, row i64, src i64, cols i64, fg i64, accent i64, selbg i64) () {
    f = F-VISIBLE | F-ENABLED
    tc = fg
    bg = 0
    (ct-get(TB-SEL, h) == src) -> {
        f = f | F-SELECTED
        bg = selbg
        tc = accent
    }
    ct-set(CMP-FLAGS, row, f)
    ct-set(CMP-COLOR, row, bg)
    ct-set(TB-ROW-SRC, row, src)
    c = 0
    !! {
        (c >= cols) -> { ** }
        cell = cmp-label(ed-arr-get-s(TB-CELL, ct-add(ct-mul(src, cols), c)))
        cmp-set-color(cell, tc)
        cw = ct-get(TB-COLW, c)
        (cw > 0) -> { cmp-set-sw(cell, cw) }
        cmp-add-child(row, cell)
        ct-set(TB-CELL-SRC, cell, src)
        ct-set(TB-CELL-COL, cell, c)
        c = ct-inc(c)
    }
}

; 重建：表头（根的第 0 个子）+ 滚动体（第 1 个子）+ 可见行（滚动体的子）。
; 两段式：先挂全部行壳，再逐行填单元格 —— CHILD-IDX 是全局扁平数组，
; 一个父的孩子必须连续挂载。
cmp-table-sync = (h i64, viewh i64, rowh i64, fg i64, accent i64, selbg i64, hcolor i64) (m i64) {
    cols = TB-HEAD.len()
    (TB-ORDER.len() != cmp-table-rows()) -> { cmp-table-reset-order() }
    m = TB-ORDER.len()
    ; 表宽 = 2*内边距 + 列宽之和 + (列数-1)*间距
    tw = ct-mul(1200, 2)
    c = 0
    !! {
        (c >= cols) -> { ** }
        tw = ct-add(tw, ct-add(ct-get(TB-COLW, c), 800))
        c = ct-inc(c)
    }
    (cols > 0) -> { tw = ct-sub(tw, 800) }
    ; 摘掉旧的表头 / 滚动体（行标记一并清掉，否则下一次 sync 会去摘死行）
    oh = ct-get(TB-HEAD-H, h)
    (oh >= 0) -> {
        cmp-detach(h, oh)
        ct-set(TB-HEAD-H, h, -1)
    }
    os = ct-get(TB-SCR-H, h)
    (os >= 0) -> {
        tb-clear-marks(os)
        cmp-detach(h, os)
        ct-set(TB-SCR-H, h, -1)
    }
    ; 表头：一行 C-GRID，高 = 内边距 + 一行（交叉轴顶对齐，标签落在 y+pad..y+pad+行高）
    hg = cmp-grid(cols, 1)
    cmp-set-lay(hg, L-H)
    cmp-set-pad(hg, 0)
    cmp-set-gap(hg, 0)
    cmp-set-sh(hg, ct-add(1200, rowh))
    cmp-add-child(h, hg)
    ct-set(TB-HEAD-H, h, hg)
    ; 滚动体：**先挂**（CHILD-IDX 是全局扁平数组，一个父的直接子必须连续挂载，
    ; 否则先填表头会把表头的子插进「表头 + 滚动体」中间，滚动体就挂在错位置）
    scr = cmp-alloc(C-SCROLL, '', '', 0x1E1E28FF, ct-get(TB-OFF, h))
    cmp-set-lay(scr, L-GROW)
    cmp-set-sh(scr, viewh)
    cmp-set-pad(scr, 1200)
    cmp-set-gap(scr, 800)
    cmp-add-child(h, scr)
    ct-set(TB-SCR-H, h, scr)
    ; 再填表头
    c = 0
    !! {
        (c >= cols) -> { ** }
        lab = cmp-label(ed-arr-get-s(TB-HEAD, c))
        cmp-set-color(lab, hcolor)
        cw = ct-get(TB-COLW, c)
        (cw > 0) -> { cmp-set-sw(lab, cw) }
        cmp-add-child(hg, lab)
        c = ct-inc(c)
    }
    off = ct-get(TB-OFF, h)
    r []i64 = with-len(2)
    cmp-win-range(off, viewh, rowh, m, r)
    i0 = ct-get(r, 0)
    i1 = ct-get(r, 1)
    ch = ct-mul(1200, 2)
    (m > 0) -> {
        ch = ct-add(ct-mul(m, rowh), ct-mul(ct-sub(m, 1), 800))
        ch = ct-add(ch, ct-mul(1200, 2))
    }
    cmp-set-scroll-content(scr, ch)
    cmp-set-scroll-start(scr, i0)
    i = i0
    !! {
        (m <= 0) -> { ** }
        (i >= i1) -> { ** }
        cmp-table-row-head(scr, cols, rowh)
        i = ct-inc(i)
    }
    j = 0
    i = i0
    !! {
        (m <= 0) -> { ** }
        (i >= i1) -> { ** }
        cmp-table-row-body(h, cmp-child(scr, j), ct-get(TB-ORDER, i), cols, fg, accent, selbg)
        j = ct-inc(j)
        i = ct-inc(i)
    }
    m = m
}

; ============================================================================
; 12b. 可拆面板（阶段36：命令式侧功能对等）
; ============================================================================
; 两块面板 + 中间一条可拖的间隙。**间隙本身就是拖杆**：它不属于任何子节点，
; cs-hit 的「自身矩形兜底」（cs-hit-inner 末尾）会把它算到容器头上，
; 事件侧再用光标位置判断是不是落在那条间隙里（cs-dock-down / cs-dock-move）。
; 所以不新增节点种类、也不给布局引擎加分支 —— C-DOCK 只是一台通了电的
; 横向容器（cs-is-container 早就有 C-DOCK 分支）。
;
; 宽度是**声明**的：左屏宽的真源是 DK-SPLIT-V[dock]（命令式侧的状态槽，
; 对应声明式 dv-dock-split 的 slot）。cmp-dock-split 把 minw / maxw 写进
; value / value2 当夹紧界，并把 DK-SPLIT-V 初始化成 minw；事件侧换算出新的
; 左屏宽写回 DK-SPLIT-V，主循环再把它同步到首子的固定宽（cmp-set-sw）——
; 和 cmp-table-sync 同一模式：状态在应用手里，每帧同步。
; 注意 value 不能拿来存当前位置：它是夹紧的下界，写掉就丢了 minw。
;
; 拖拽的几何（cs-hit / cs-rect / cs-child-flow / cs-gap-of）在 cmp-scene.no，
; 那里也是这些函数的家（components.no 没有 # import，看不到 cs-*）；
; 本模块只管配置、可拖标记和抓握状态。
;
; 1200 是字面量：components.no 看不到 CS-PAD。
; gap 必须 > 0：cs-gap-of 把 <= 0 的 gap 兜底成 CS-GAP，拖杆命中区会跟着变大。
; maxw 传 0 = 不夹上限（ct-clamp 的约定，与 dv-clamp 一致）。

cmp-dock-split = (h i64, minw i64, maxw i64, gw i64) (r i64) {
    cmp-set-lay(h, L-H)
    cmp-set-gap(h, gw)
    cmp-set-pad(h, 1200)
    cmp-set-value(h, minw)
    cmp-set-value2(h, maxw)
    ct-set(DK-SPLIT, h, 1)
    ct-set(DK-SPLIT-V, h, minw)
    r = h
}

; 竖着拆：把 L-H 抹掉（回到默认纵向），状态槽存的是**上屏高**
cmp-dock-split-v = (h i64, minw i64, maxw i64, gw i64) (r i64) {
    cmp-set-lay(h, 0)
    cmp-set-gap(h, gw)
    cmp-set-pad(h, 1200)
    cmp-set-value(h, minw)
    cmp-set-value2(h, maxw)
    ct-set(DK-SPLIT, h, 1)
    ct-set(DK-SPLIT-V, h, minw)
    r = h
}

; 这个容器是不是可拖分栏（普通 C-DOCK 容器 = 0）
cmp-dock-splittable = (h i64) (yes i64) {
    yes = ct-get(DK-SPLIT, h)
}

; 当前分栏位置（横向 = 左屏宽；竖向 = 上屏高）。真源：
; 事件侧拖完写这里，应用每帧把它同步到首子的固定宽 / 高。
cmp-dock-split-val = (h i64) (v i64) {
    v = ct-get(DK-SPLIT-V, h)
}

cmp-dock-set-split = (h i64, v i64) () {
    ct-set(DK-SPLIT-V, h, v)
}

; 当前抓握的容器（-1 = 没在拖）。全局单份：鼠标只有一只，同时只能拖一条缝。
cmp-dock-grab = () (h i64) {
    h = ct-get(DK-GRAB, 0)
}

; 松开：清掉抓握。拖拽结束后鼠标继续移动不再改分栏。
cmp-dock-up = () () {
    DK-GRAB[0] = -1
}

; ============================================================================
; 13. 渲染支撑（供 cmp-scene 渲染层读取复合组件的子项 / 状态）
; ============================================================================
; select / tab 的选项存在 CHILD-IDX（CMP-HEAD 起、CMP-COUNT 个），
; 渲染层要遍历它们画下拉面板 / tab 条，故在此开只读窗口。

; 选项个数
select-option-count = (h i64) (n i64) {
    x = CMP-COUNT[h]: {
        ok -> it

        -> 0
    }
    n = x
}

; 第 i 个选项的组件句柄（越界返回 -1）
select-option = (h i64, i i64) (c i64) {
    head = CMP-HEAD[h]: {
        ok -> it

        -> -1
    }
    hi = head + i: {
        ok -> it

        -> -1
    }
    x = CHILD-IDX[hi]: {
        ok -> it

        -> -1
    }
    c = x
}

; 反查：给定选项句柄，返回它的下标（不存在返回 -1）
; 供命中测试把「点到的选项组件」翻译回 select-choose 需要的下标。
select-index-of = (h i64, c i64) (idx i64) {
    n = select-option-count(h)
    idx = -1
    i = 0
    !! {
        (i >= n) -> { ** }
        o = select-option(h, i)
        (o == c) -> {
            idx = i
            **
        }
        ni = i + 1: {
            ok -> it

            -> i
        }
        i = ni
    }
}

; tab 标题数 / 第 i 个标题文本
tab-count = (h i64) (n i64) {
    n = select-option-count(h)
}
tab-title = (h i64, i i64) (s str) {
    c = select-option(h, i)
    (c < 0) -> {
        s = ''
        return
    }
    s = cmp-text(c)
}

; ---- 阶段42：combobox（可输入的下拉）----
; 查询串就是 CMP-TEXT（单行输入缓冲，复用 INP-CAR 光标池；编辑走 input-insert /
; input-backspace / input-delete）。选项与 select 同构，存 CHILD-IDX（cmp-child 可读），
; 另存一份「匹配表」：CB-MBASE / CB-MN / CB-MLIST（扁平只增）+ CB-MCUR 高亮。
; 匹配规则：查询为空 = 全选；否则选项文本 to-lower 后 contains 查询 to-lower
; （大小写不敏感）。所有写操作先查 F-DISABLED。
combobox-refresh = (h i64) () {
    q = cmp-text(h).to-lower()
    n = select-option-count(h)
    base = CB-MLIST.len()
    ct-set(CB-MBASE, h, base)
    ct-set(CB-MN, h, 0)
    i = 0
    !! {
        (i >= n) -> { ** }
        c = select-option(h, i)
        (c >= 0) -> {
            lab = cmp-text(c).to-lower()
            ok = (q.len() == 0) || lab.contains(q)
            (ok) -> {
                CB-MLIST.push(c)
                ct-set(CB-MN, h, ct-inc(ct-get(CB-MN, h)))
            }
        }
        i = ct-inc(i)
    }
    ; 高亮夹紧：没匹配 = -1；有高亮但越界就收回末尾
    mn = ct-get(CB-MN, h)
    cur = ct-get(CB-MCUR, h)
    (mn <= 0) -> { ct-set(CB-MCUR, h, -1) }
    ((mn > 0) && (cur < 0)) -> { ct-set(CB-MCUR, h, 0) }
    ((mn > 0) && (cur >= mn)) -> { ct-set(CB-MCUR, h, ct-sub(mn, 1)) }
}
combobox-query = (h i64) (s str) {
    s = cmp-text(h)
}
combobox-set-query = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
    input-set-caret(h, s.len-bytes())
    combobox-refresh(h)
}
combobox-add-option = (h i64, label str) (idx i64) {
    idx = select-add-option(h, label)
    combobox-refresh(h)
}
combobox-option-count = (h i64) (n i64) {
    n = select-option-count(h)
}
combobox-option = (h i64, i i64) (c i64) {
    c = select-option(h, i)
}
combobox-selected = (h i64) (idx i64) {
    idx = select-selected(h)
}
combobox-choose = (h i64, idx i64) () {
    select-choose(h, idx)
    combobox-refresh(h)
}
combobox-match-count = (h i64) (n i64) {
    n = ct-get(CB-MN, h)
}
combobox-match = (h i64, i i64) (c i64) {
    c = -1
    n = ct-get(CB-MN, h)
    ((i < 0) || (i >= n)) -> { c = -1 }
    ((i >= 0) && (i < n)) -> {
        base = ct-get(CB-MBASE, h)
        c = ct-get(CB-MLIST, ct-add(base, i))
    }
    c = c
}
combobox-match-label = (h i64, i i64) (s str) {
    s = ''
    c = combobox-match(h, i)
    (c >= 0) -> { s = cmp-text(c) }
    s = s
}
combobox-match-index = (h i64, i i64) (idx i64) {
    idx = -1
    c = combobox-match(h, i)
    (c >= 0) -> { idx = select-index-of(h, c) }
    idx = idx
}
; 反查：给定选项句柄，返回它在匹配表里的下标（不存在返回 -1）
combobox-match-index-of = (h i64, c i64) (idx i64) {
    idx = -1
    n = ct-get(CB-MN, h)
    i = 0
    !! {
        (i >= n) -> { ** }
        (idx >= 0) -> { ** }
        (combobox-match(h, i) == c) -> { idx = i }
        i = ct-inc(i)
    }
    idx = idx
}
combobox-highlight = (h i64) (i i64) {
    i = ct-get(CB-MCUR, h)
}
combobox-highlight-set = (h i64, i i64) () {
    n = ct-get(CB-MN, h)
    (n <= 0) -> {
        ct-set(CB-MCUR, h, -1)
        return
    }
    (i < 0) -> { i = -1 }
    (i >= n) -> { i = ct-sub(n, 1) }
    ct-set(CB-MCUR, h, i)
}
combobox-highlight-move = (h i64, d i64) () {
    n = ct-get(CB-MN, h)
    (n <= 0) -> return
    k = ct-get(CB-MCUR, h)
    (k < 0) -> { k = 0 }
    k = ct-add(k, d)
    (k < 0) -> { k = 0 }
    (k >= n) -> { k = ct-sub(n, 1) }
    ct-set(CB-MCUR, h, k)
}
combobox-choose-match = (h i64, i i64) () {
    idx = combobox-match-index(h, i)
    (idx >= 0) -> { combobox-choose(h, idx) }
}
combobox-apply = (h i64) () {
    i = ct-get(CB-MCUR, h)
    (i >= 0) -> { combobox-choose-match(h, i) }
}
; ---- 编辑查询：都先改 CMP-TEXT / INP-CAR（复用输入框光标语义），再 refresh ----
combobox-insert = (h i64, ch str) () {
    input-insert(h, ch)
    combobox-refresh(h)
}
combobox-backspace = (h i64) () {
    input-backspace(h)
    combobox-refresh(h)
}
combobox-delete = (h i64) () {
    input-delete(h)
    combobox-refresh(h)
}
combobox-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = ''
    input-set-caret(h, 0)
    combobox-refresh(h)
}

; input / textarea：placeholder 在 CMP-TEXT2，值在 CMP-TEXT
input-placeholder = (h i64) (s str) {
    s = cmp-text2(h)
}
; 整段替换输入值（渲染层据此画光标位置）；光标随之落到末尾
input-set = (h i64, s str) {
    CMP-TEXT[h] = s
    input-set-caret(h, s.len-bytes())
}

; slider：给定像素 x（组件内局部坐标）反算值域上的取值
; lo/hi 取自 CMP-VALUE3 / CMP-VALUE2，与 slider-range 一致
slider-value-at = (h i64, px i64, x i64, w i64) (v i64) {
    lo = CMP-VALUE3[h]: {
        ok -> it

        -> 0
    }
    hi = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
    (hi <= lo) -> {
        v = lo
        return
    }
    (w <= 0) -> {
        v = lo
        return
    }
    d = px - x: {
        ok -> it

        -> 0
    }
    (d < 0) -> { d = 0 }
    (d > w) -> { d = w }
    r = hi - lo: {
        ok -> it

        -> 0
    }
    m = d * r: {
        ok -> it

        -> 0
    }
    q = m / w: {
        ok -> it

        -> 0
    }
    a = lo + q: {
        ok -> it

        -> lo
    }
    v = a
}

; ============================================================================
; 12c. 命令面板（阶段37：命令式侧功能对等）
; ============================================================================
; 根就是 C-COMMAND（普通竖排容器）：输入框 + 滚动体两个直接子节点，滚动体里是
; cmp-command-sync 重建出来的「行」（横向 C-FORM 行 + 文本标签）。和树 / 表格 /
; 编辑器同一个路子 —— 内核没有 C-COMMAND 的专用绘制分支，面板完全由应用调出来的
; 真组件拼出来，渲染层只走通用容器路径。
;
; 声明式 dv-command-palette 的四件事在这里的落点：
;   查询过滤   cp-filter（大小写不敏感子串，空查询命中全部）
;   虚拟列表   cmp-win-range + CMP-SCROLL-CONTENT / CMP-SCROLL-START
;   键盘导航   cmp-command-move / cmp-command-run（游标存 CP-CUR）
;   执行       行挂源行号（CP-ROW-SRC），点行 / 回车都取 CP-ACT[源行号]
;
; 游标是**命中表下标**而不是源行号 —— 查询一变命中表就变，拿源行号当游标会指错行。
; 命中表抄一份只增的扁平副本（CP-SRC + 每面板基址 CP-SB），于是 cmp-command-move
; 不重建视图也能立刻把「游标 -> 源行号」算出来（和 dv-pal-cur-key 同一个理由）。
; 代价：CP-SRC 只增不减，长会话里会随每次 sync 变长（和 DV-PAL-SRC 一样，有界）。
;
; 面板是模态的：应用自己 `cmp-flag-set(root, F-OVERLAY)`（components.no 不写死
; 模态行为，和 cmp-dialog 一样交给调用方）。面板内边距 / 间距也要应用自己设
; （pad 1200 / gap 800 与滚动体的 pad / gap 对齐，窗口算式才成立）。

; 行高由调用方按帧传（声明式侧 PAL-ROWH=2800）；滚轮步长不在 sync 里 ——
; 步长是应用的事（demo 用 3200，和声明式 PAL-STEP 一致），sync 只按偏移摆行。

; ---- 命令表（应用写）----
cmp-command-count = () (n i64) { n = CP-TEXT.len() }
cmp-command-add = (text str, act i64) () {
    CP-TEXT.push(text)
    CP-ACT.push(act)
}

; ---- 查询串（每面板一份）----
cmp-command-query = (h i64) (s str) { s = ed-arr-get-s(CP-Q, h) }
cmp-command-set-query = (h i64, s str) () { ed-arr-set-s(CP-Q, h, s) }
cmp-command-type = (h i64, ch str) () {
    s = ed-arr-get-s(CP-Q, h)
    s.push-str(ch)
    ed-arr-set-s(CP-Q, h, s)
}
cmp-command-backspace = (h i64) () {
    s = ed-arr-get-s(CP-Q, h)
    n = s.len-bytes()
    (n > 0) -> { ed-arr-set-s(CP-Q, h, s.slice-bytes(0, ct-sub(n, 1))) }
}

; ---- 滚动 ----
cmp-command-off = (h i64) (v i64) { v = ct-get(CP-OFF, h) }
cmp-command-set-off = (h i64, v i64) () { ct-set(CP-OFF, h, v) }
cmp-command-scroll = (h i64) (s i64) { s = ct-get(CP-SCR-H, h) }
cmp-command-input = (h i64) (i i64) { i = ct-get(CP-INP-H, h) }

; 查询串 -> 命中的**源行号**表（大小写不敏感子串；空查询命中全部）
cp-filter = (h i64, out []i64) (m i64) {
    ql = ed-arr-get-s(CP-Q, h).to-lower()
    m = 0
    n = CP-TEXT.len()
    i = 0
    !! {
        (i >= n) -> { ** }
        (ed-arr-get-s(CP-TEXT, i).to-lower().index(ql) >= 0) -> {
            out.push(i)
            m = ct-inc(m)
        }
        i = ct-inc(i)
    }
    m = m
}

; 一行的「壳」：横向 C-FORM + 选中态（底色 / flags），挂到滚动体上。
; 单独拆出来是因为 CHILD-IDX 是全局扁平数组：一个父的直接子必须连续挂载
; （cmp-child 按 HEAD + i 取），所以要先一口气挂完所有行壳，再逐行填内容。
cp-row-head = (scr i64, isel i64, rowh i64, selbg i64) (row i64) {
    f = F-VISIBLE | F-ENABLED
    bg = 0
    (isel != 0) -> {
        f = f | F-SELECTED
        bg = selbg
    }
    row = cmp-form()
    cmp-set-lay(row, L-H)
    cmp-set-pad(row, 0)
    cmp-set-gap(row, 0)
    cmp-set-sh(row, rowh)
    ct-set(CMP-COLOR, row, bg)
    ct-set(CMP-FLAGS, row, f)
    cmp-add-child(scr, row)
    row = row
}

; 一行的「内容」：文本标签（挂在行上，选中态从行自己的 F-SELECTED 读）。
cp-row-body = (row i64, src i64, fg i64, accent i64) () {
    f = F-VISIBLE | F-ENABLED
    tc = fg
    (cmp-has(row, F-SELECTED)) -> {
        f = f | F-SELECTED
        tc = accent
    }
    t = cmp-alloc(C-LABEL, ed-arr-get-s(CP-TEXT, src), '', tc, 0)
    ct-set(CMP-FLAGS, t, f)
    cmp-add-child(row, t)
    ct-set(CP-ROW-SRC, row, src)
}

; 重建可见行：过滤 -> 夹游标 -> 全摘旧行 -> 声明内容高 / 起始行号 ->
; 两段式重挂行壳 -> 逐行填内容。输入框 / 滚动体第一次建好就复用。返回命中数 m。
cmp-command-sync = (h i64, viewh i64, rowh i64, fg i64, accent i64, selbg i64) (m i64) {
    ; 输入框 / 滚动体：第一次建，之后**复用**（每次重建输入框会丢焦点）。
    ; 两个都挂在面板上、之后不再摘 —— 摘一个留一个的话，cmp-add-child 会把
    ; 新子节点追加到 CHILD-IDX 末尾，和面板既有的子链不连续（全局扁平数组的
    ; 固有权衡：一个父的直接子必须占一段连续槽位）。
    inp = ct-get(CP-INP-H, h)
    (inp < 0) -> {
        inp = cmp-input('type a command')
        cmp-add-child(h, inp)
        ct-set(CP-INP-H, h, inp)
        scr = cmp-scroll()
        cmp-set-lay(scr, L-GROW)
        cmp-add-child(h, scr)
        ct-set(CP-SCR-H, h, scr)
    }
    scr = ct-get(CP-SCR-H, h)
    cmp-set-sh(inp, rowh)
    cmp-set-sh(scr, viewh)
    cmp-set-pad(scr, 1200)
    cmp-set-gap(scr, 800)
    cmp-set-text(inp, ed-arr-get-s(CP-Q, h))
    ; 命中表：抄一份只增的扁平副本（CP-SRC + 每面板基址 CP-SB）
    idxs []i64 = with-len(0)
    m = cp-filter(h, idxs)
    base = CP-SRC.len()
    ct-set(CP-SB, h, base)
    j = 0
    !! {
        (j >= m) -> { ** }
        CP-SRC.push(ct-get(idxs, j))
        j = ct-inc(j)
    }
    ; 游标夹到命中区间内（查询一变，旧的游标可能就越界了）
    cur = ct-get(CP-CUR, h)
    (m <= 0) -> { cur = -1 }
    (m > 0) -> {
        (cur < 0) -> { cur = 0 }
        (cur >= m) -> { cur = ct-sub(m, 1) }
    }
    ct-set(CP-CUR, h, cur)
    ; 摘掉旧行（顺手清 CP-ROW-SRC，否则下一次 sync 会去摘死行）。
    ; **全摘**是关键：全摘后 COUNT[scr] 归零，下一轮 cmp-add-child 会重设
    ; HEAD[scr]，新挂的行才是连续的一段（和 cmp-tree-sync 同一个理由）。
    rows []i64 = with-len(0)
    cnt = ct-get(CMP-COUNT, scr)
    hd = ct-get(CMP-HEAD, scr)
    i = 0
    !! {
        (i >= cnt) -> { ** }
        rows.push(ct-get(CHILD-IDX, ct-add(hd, i)))
        i = ct-inc(i)
    }
    i = 0
    !! {
        (i >= rows.len()) -> { ** }
        rw = ct-get(rows, i)
        ct-set(CP-ROW-SRC, rw, -1)
        cmp-detach(scr, rw)
        i = ct-inc(i)
    }
    off = ct-get(CP-OFF, h)
    r []i64 = with-len(2)
    cmp-win-range(off, viewh, rowh, m, r)
    i0 = ct-get(r, 0)
    i1 = ct-get(r, 1)
    ch = ct-mul(1200, 2)
    (m > 0) -> {
        ch = ct-add(ct-mul(m, rowh), ct-mul(ct-sub(m, 1), 800))
        ch = ct-add(ch, ct-mul(1200, 2))
    }
    cmp-set-scroll-content(scr, ch)
    cmp-set-scroll-start(scr, i0)
    ; 两段式：先挂全部行壳（滚动体的子链连续），再逐行填内容（行的子链连续）
    i = i0
    !! {
        (i >= i1) -> { ** }
        sel = 0
        (i == cur) -> { sel = 1 }
        cp-row-head(scr, sel, rowh, selbg)
        i = ct-inc(i)
    }
    j = 0
    i = i0
    !! {
        (i >= i1) -> { ** }
        cp-row-body(cmp-child(scr, j), ct-get(CP-SRC, ct-add(base, i)), fg, accent)
        j = ct-inc(j)
        i = ct-inc(i)
    }
    m = m
}

; ---- 导航 / 执行 ----
cmp-command-cur = (h i64) (c i64) { c = ct-get(CP-CUR, h) }
cmp-command-set-cur = (h i64, c i64) () { ct-set(CP-CUR, h, c) }
cmp-command-move = (h i64, d i64) () {
    idxs []i64 = with-len(0)
    m = cp-filter(h, idxs)
    (m > 0) -> {
        cur = ct-get(CP-CUR, h)
        (cur < 0) -> { cur = 0 }
        cur = ct-add(cur, d)
        (cur < 0) -> { cur = 0 }
        (cur >= m) -> { cur = ct-sub(m, 1) }
        ct-set(CP-CUR, h, cur)
    }
}
; 游标行的源行号（-1 = 没有命中行）
cmp-command-cur-src = (h i64) (src i64) {
    src = -1
    cur = ct-get(CP-CUR, h)
    (cur >= 0) -> {
        base = ct-get(CP-SB, h)
        (cur < ct-sub(CP-SRC.len(), base)) -> {
            src = ct-get(CP-SRC, ct-add(base, cur))
        }
    }
    src = src
}
; 执行游标行的命令码（-1 = 没有命中行）
cmp-command-run = (h i64) (act i64) {
    act = -1
    src = cmp-command-cur-src(h)
    (src >= 0) -> { act = ct-get(CP-ACT, src) }
    act = act
}
; 命中链上溯到「行」（cs-hit 返回最深节点，可能命中的是行里的文本标签）
cmp-command-row-of = (h i64, c i64) (row i64) {
    row = -1
    p = c
    !! {
        (p < 0) -> { ** }
        (row >= 0) -> { ** }
        (ct-get(CP-ROW-SRC, p) >= 0) -> { row = p }
        p = ct-get(CMP-PARENT, p)
    }
    row = row
}
cmp-command-row-src = (row i64) (src i64) { src = ct-get(CP-ROW-SRC, row) }

; ============================================================================
; description-list：label / value 行族（阶段55）
; ============================================================================
; 目录第 68 行承诺 description-list「pairs」，但命令式侧只有一个构造函数，
; 而且它原本在 cs-is-container 白名单里 —— 没有子节点时走通用兜底，画成一个
; 0×0 的 FIELD 矩形（同阶段 54 的 skeleton）。行是**数据**不是视觉子节点
; （同 C-PAGINATION / C-SELECT / C-TAB 一路），所以本阶段把它从白名单里拿掉，
; 画 / 量都读 DL-* 池。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、CS-SEP-H=100、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、标签列 120px、列间隙 8px、值列下限 64px ----
dl-pad = () (p i64) { p = 1200 }
dl-lab-w = () (w i64) { w = 12000 }
dl-gap = () (g i64) { g = 800 }
dl-val-min = () (w i64) { w = 6400 }

dl-count = (h i64) (n i64) { n = ct-get(DL-N, h) }
dl-label = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(DL-N, h)
    ((i >= 0) && (i < n)) -> {
        b = ct-get(DL-SBASE, h)
        s = ed-arr-get-s(DL-LAB, ct-add(b, i))
    }
    s = s
}
dl-value = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(DL-N, h)
    ((i >= 0) && (i < n)) -> {
        b = ct-get(DL-SBASE, h)
        s = ed-arr-get-s(DL-VAL, ct-add(b, i))
    }
    s = s
}
dl-add = (h i64, lab str, val str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(DL-SBASE, h)
    n = ct-get(DL-N, h)
    (n == 0) -> { b = DL-LAB.len() }
    DL-LAB.push(lab)
    DL-VAL.push(val)
    ct-set(DL-SBASE, h, b)
    ct-set(DL-N, h, ct-inc(n))
}
dl-set-label = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(DL-N, h)
    ((i >= 0) && (i < n)) -> {
        b = ct-get(DL-SBASE, h)
        ed-arr-set-s(DL-LAB, ct-add(b, i), s)
    }
}
dl-set-value = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(DL-N, h)
    ((i >= 0) && (i < n)) -> {
        b = ct-get(DL-SBASE, h)
        ed-arr-set-s(DL-VAL, ct-add(b, i), s)
    }
}
dl-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(DL-SBASE, h, 0)
    ct-set(DL-N, h, 0)
}

; ============================================================================
; accordion：组（section）族（阶段56）
; ============================================================================
; 目录第 63 行承诺 accordion「sections, expanded」，但命令式侧只有一个构造函数，
; 而且它原本在 cs-is-container 白名单里 —— 没有子节点时走通用兜底，画成一个
; 0×0 的 FIELD 矩形（同阶段 54 的 skeleton / 阶段 55 的 description-list）。
; 组是**数据**不是视觉子节点（同 C-PAGINATION / C-SELECT / C-TAB / C-DESCRIPTION-LIST
; 一路），所以本阶段把它从白名单里拿掉，画 / 量都读 AC-* 池。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、CS-SEP-H=100、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、组头高 40px、展开符宽 8px、符后间隙 8px ----
ac-pad = () (p i64) { p = 1200 }
ac-head-h = () (v i64) { v = 4000 }
ac-glyph-w = () (v i64) { v = 800 }
ac-gap = () (v i64) { v = 800 }

ac-count = (h i64) (n i64) { n = ct-get(AC-N, h) }

ac-title = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(AC-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(AC-TITLE, ct-add(ct-get(AC-SBASE, h), i))
    }
    s = s
}

ac-body-count = (h i64, i i64) (n i64) {
    n = 0
    nn = ct-get(AC-N, h)
    ((i >= 0) && (i < nn)) -> {
        n = ct-get(AC-BN, ct-add(ct-get(AC-SBASE, h), i))
    }
    n = n
}

ac-body-line = (h i64, i i64, j i64) (s str) {
    s = ''
    nn = ct-get(AC-N, h)
    ((i >= 0) && (i < nn)) -> {
        si = ct-add(ct-get(AC-SBASE, h), i)
        cnt = ct-get(AC-BN, si)
        ((j >= 0) && (j < cnt)) -> {
            s = ed-arr-get-s(AC-BODY, ct-add(ct-get(AC-BBASE, si), j))
        }
    }
    s = s
}

ac-expanded = (h i64, i i64) (v i64) {
    v = 0
    n = ct-get(AC-N, h)
    ((i >= 0) && (i < n)) -> { v = ct-get(AC-EXP, ct-add(ct-get(AC-SBASE, h), i)) }
    v = v
}

; 展开中的组数
ac-open-count = (h i64) (n i64) {
    n = 0
    cnt = ct-get(AC-N, h)
    b = ct-get(AC-SBASE, h)
    i = 0
    !! {
        (i >= cnt) -> { ** }
        (ct-get(AC-EXP, ct-add(b, i)) != 0) -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}

; 追加一个**收起**的组（基址补种到组池尾，同 dl-add）
ac-add = (h i64, title str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(AC-SBASE, h)
    n = ct-get(AC-N, h)
    (n == 0) -> { b = AC-TITLE.len() }
    AC-TITLE.push(title)
    AC-BBASE.push(AC-BODY.len())
    AC-BN.push(0)
    AC-EXP.push(0)
    ct-set(AC-SBASE, h, b)
    ct-set(AC-N, h, ct-inc(n))
}

; 追加一个**展开**的组
ac-add-open = (h i64, title str) () {
    ac-add(h, title)
    n = ct-get(AC-N, h)
    (n > 0) -> {
        ct-set(AC-EXP, ct-add(ct-get(AC-SBASE, h), ct-sub(n, 1)), 1)
    }
}

; 给第 i 组追加一行正文
ac-add-body = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(AC-N, h)
    ((i >= 0) && (i < n)) -> {
        si = ct-add(ct-get(AC-SBASE, h), i)
        AC-BODY.push(s)
        ct-set(AC-BN, si, ct-inc(ct-get(AC-BN, si)))
    }
}

ac-set-title = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(AC-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(AC-TITLE, ct-add(ct-get(AC-SBASE, h), i), s)
    }
}

ac-set-expanded = (h i64, i i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (v != 0) -> { v = 1 }
    n = ct-get(AC-N, h)
    ((i >= 0) && (i < n)) -> {
        ct-set(AC-EXP, ct-add(ct-get(AC-SBASE, h), i), v)
    }
}

ac-expand = (h i64, i i64) () { ac-set-expanded(h, i, 1) }
ac-collapse = (h i64, i i64) () { ac-set-expanded(h, i, 0) }
ac-toggle = (h i64, i i64) () {
    v = ac-expanded(h, i)
    (v != 0) -> { ac-collapse(h, i) }
    (v == 0) -> { ac-expand(h, i) }
}

ac-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(AC-SBASE, h, 0)
    ct-set(AC-N, h, 0)
}

; ============================================================================
; carousel：幻灯片（slide）族（阶段57）
; ============================================================================
; 目录第 64 行承诺 carousel「slides, current」，但命令式侧只有一个构造函数，
; 而且它原本在 cs-is-container 白名单里 —— 没有子节点时走通用兜底，画成一个
; 0×0 的 FIELD 矩形（同阶段 54 的 skeleton / 阶段 55 的 description-list /
; 阶段 56 的 accordion）。幻灯片是**数据**不是视觉子节点
; （同 C-PAGINATION / C-SELECT / C-TAB / C-DESCRIPTION-LIST / C-ACCORDION
; 一路），所以本阶段把它从白名单里拿掉，画 / 量都读 CR-* 池。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、CS-SEP-H=100、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、左右箭头宽 8px、箭头与正文间隙 8px、圆点 8px / 点距 8px ----
cr-pad = () (p i64) { p = 1200 }
cr-arrow-w = () (w i64) { w = 800 }
cr-gap = () (g i64) { g = 800 }
cr-dot-w = () (w i64) { w = 800 }
cr-dot-gap = () (g i64) { g = 800 }

cr-count = (h i64) (n i64) { n = ct-get(CR-N, h) }

cr-slide = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(CR-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(CR-SLIDE, ct-add(ct-get(CR-SBASE, h), i))
    }
    s = s
}

; 追加一张，返回新下标（disabled 时返回 -1）
cr-add = (h i64, s str) (idx i64) {
    idx = -1
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(CR-SBASE, h)
    n = ct-get(CR-N, h)
    (n == 0) -> { b = CR-SLIDE.len() }
    CR-SLIDE.push(s)
    ct-set(CR-SBASE, h, b)
    ct-set(CR-N, h, ct-inc(n))
    idx = ct-sub(ct-get(CR-N, h), 1)
}

cr-set-slide = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(CR-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(CR-SLIDE, ct-add(ct-get(CR-SBASE, h), i), s)
    }
}

; 当前张（越界回落 0）
cr-current = (h i64) (idx i64) {
    idx = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    n = ct-get(CR-N, h)
    ((idx < 0) || (idx >= n)) -> { idx = 0 }
    idx = idx
}

cr-set-current = (h i64, i i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(CR-N, h)
    ((i < 0) || (i >= n)) -> return
    CMP-VALUE[h] = i
}

cr-select = (h i64, i i64) () { cr-set-current(h, i) }

cr-next = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(CR-N, h)
    (n <= 0) -> return
    i = ct-inc(cr-current(h))
    (i >= n) -> { i = 0 }
    CMP-VALUE[h] = i
}

cr-prev = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(CR-N, h)
    (n <= 0) -> return
    i = ct-sub(cr-current(h), 1)
    (i < 0) -> { i = ct-sub(n, 1) }
    CMP-VALUE[h] = i
}

cr-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(CR-SBASE, h, 0)
    ct-set(CR-N, h, 0)
    CMP-VALUE[h] = 0
}

; ============================================================================
; collapsible：折叠面板族（阶段58）
; ============================================================================
; 目录第 70 行承诺 collapsible「open, title」，但命令式侧只有一个构造函数，
; 而且它原本在 cs-is-container 白名单里 —— 没有子节点时走通用兜底，画成一个
; 0×0 的 FIELD 矩形（同阶段 54 的 skeleton / 阶段 55 的 description-list /
; 阶段 56 的 accordion / 阶段 57 的 carousel）。目录把 group_box 标成
; 「title, children」而 collapsible 只标「open, title」，所以正文走数据池
; （CL-LINE），不占视觉子节点。展开态复用既有 F-OPEN 位（声明式
; dv-on-open 已经这么编码）。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、CS-SEP-H=100、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、展开符宽 8px、符与标题间隙 8px ----
cl-pad = () (p i64) { p = 1200 }
cl-head-h = () (v i64) { v = 4000 }
cl-glyph-w = () (v i64) { v = 800 }
cl-gap = () (v i64) { v = 800 }

cl-title = (h i64) (s str) { s = cmp-text(h) }

cl-set-title = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
}

; 展开态读 F-OPEN 位（与 select / combobox / 声明式一致）
cl-open = (h i64) (v i64) {
    v = 0
    (cmp-has(h, F-OPEN)) -> { v = 1 }
}

cl-set-open = (h i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (v != 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] | F-OPEN
    }
    (v == 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
    }
}

cl-expand = (h i64) () { cl-set-open(h, 1) }
cl-collapse = (h i64) () { cl-set-open(h, 0) }
cl-toggle = (h i64) () {
    ; 先取一次快照：-> 链不是互斥的，直接读两次会「翻过去又翻回来」
    v = cl-open(h)
    (v != 0) -> { cl-collapse(h) }
    (v == 0) -> { cl-expand(h) }
}

cl-count = (h i64) (n i64) { n = ct-get(CL-N, h) }

cl-body-line = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(CL-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(CL-LINE, ct-add(ct-get(CL-SBASE, h), i))
    }
    s = s
}

cl-add-body = (h i64, s str) (idx i64) {
    idx = -1
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(CL-SBASE, h)
    n = ct-get(CL-N, h)
    (n == 0) -> { b = CL-LINE.len() }
    CL-LINE.push(s)
    ct-set(CL-SBASE, h, b)
    ct-set(CL-N, h, ct-inc(n))
    idx = ct-sub(ct-get(CL-N, h), 1)
}

cl-set-body-line = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(CL-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(CL-LINE, ct-add(ct-get(CL-SBASE, h), i), s)
    }
}

cl-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(CL-SBASE, h, 0)
    ct-set(CL-N, h, 0)
}

; ============================================================================
; group-box：标题容器族（阶段59）
; ============================================================================
; 目录第 70 行承诺 group_box「title, children」—— 和 collapsible 的
; 「open, title」不同，它是真容器：标题走 CMP-TEXT，子节点是视觉节点，
; 走通用容器布局（cs-is-container 白名单保留）。所以本阶段只补标题读写，
; 不新增数据池。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-SEP-H=100、CS-BTN-H=4000。

; ---- 标题行高 40px（与 CS-BTN-H 同高，作头部行）----
gb-title-h = () (v i64) { v = 4000 }

gb-title = (h i64) (s str) { s = cmp-text(h) }

gb-set-title = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
}

; ============================================================================
; history：历史条目族（阶段60）
; ============================================================================
; 目录第 38 行承诺 history「entries, index」—— 和 carousel 的「slides,
; current」同型：条目是 HST-ENTRY 数据、不是视觉子节点，所以从
; cs-is-container 白名单里拿掉，补 measure / paint。当前下标走 CMP-VALUE。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、CS-SEP-H=100、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、当前行左侧标记条宽 8px、标记与文本间隙 8px ----
hst-pad = () (p i64) { p = 1200 }
hst-marker-w = () (w i64) { w = 800 }
hst-gap = () (g i64) { g = 800 }

hst-count = (h i64) (n i64) { n = ct-get(HST-N, h) }

hst-entry = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(HST-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(HST-ENTRY, ct-add(ct-get(HST-SBASE, h), i))
    }
    s = s
}

; 追加一条，返回新下标（disabled 时返回 -1）
hst-add = (h i64, s str) (idx i64) {
    idx = -1
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(HST-SBASE, h)
    n = ct-get(HST-N, h)
    (n == 0) -> { b = HST-ENTRY.len() }
    HST-ENTRY.push(s)
    ct-set(HST-SBASE, h, b)
    ct-set(HST-N, h, ct-inc(n))
    idx = ct-sub(ct-get(HST-N, h), 1)
}

hst-set-entry = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(HST-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(HST-ENTRY, ct-add(ct-get(HST-SBASE, h), i), s)
    }
}

; 当前下标（越界回落 0；空池也是 0）
hst-index = (h i64) (idx i64) {
    idx = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    n = ct-get(HST-N, h)
    ((idx < 0) || (idx >= n)) -> { idx = 0 }
    idx = idx
}

hst-set-index = (h i64, i i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(HST-N, h)
    ((i < 0) || (i >= n)) -> return
    CMP-VALUE[h] = i
}

hst-jump = (h i64, i i64) () { hst-set-index(h, i) }

; 相对后退 / 前进：夹紧在 [0, n-1]，不环绕（历史不是循环的）
hst-back = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(HST-N, h)
    (n <= 0) -> return
    i = ct-sub(hst-index(h), 1)
    (i < 0) -> { i = 0 }
    CMP-VALUE[h] = i
}

hst-forward = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(HST-N, h)
    (n <= 0) -> return
    i = ct-inc(hst-index(h))
    (i >= n) -> { i = ct-sub(n, 1) }
    CMP-VALUE[h] = i
}

hst-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(HST-SBASE, h, 0)
    ct-set(HST-N, h, 0)
    CMP-VALUE[h] = 0
}

; ============================================================================
; inspector：目标 + 字段族（阶段61）
; ============================================================================
; 目录第 55 行承诺 inspector「target, fields」，但命令式侧只有一个构造函数，
; 而且它原本在 cs-is-container 白名单里 —— 没有子节点时走通用兜底，画成一个
; 0×0 的 FIELD 矩形（同阶段 55 的 description-list / 阶段 60 的 history）。
; 字段是**数据**不是视觉子节点（同 C-PAGINATION / C-SELECT / C-TAB /
; C-DESCRIPTION-LIST / C-ACCORDION / C-CAROUSEL / C-HISTORY 一路），所以本阶段
; 把它从白名单里拿掉，画 / 量都读 IN-* 池。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、CS-SEP-H=100、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、目标前标记条 8px、标记与文字间隙 8px ----
in-pad = () (p i64) { p = 1200 }
in-marker-w = () (w i64) { w = 800 }
in-gap = () (g i64) { g = 800 }

in-target = (h i64) (s str) { s = cmp-text(h) }

in-set-target = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
}

in-count = (h i64) (n i64) { n = ct-get(IN-N, h) }

in-label = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(IN-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(IN-LAB, ct-add(ct-get(IN-SBASE, h), i))
    }
    s = s
}

in-value = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(IN-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(IN-VAL, ct-add(ct-get(IN-SBASE, h), i))
    }
    s = s
}

in-add = (h i64, lab str, val str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(IN-SBASE, h)
    n = ct-get(IN-N, h)
    (n == 0) -> { b = IN-LAB.len() }
    IN-LAB.push(lab)
    IN-VAL.push(val)
    ct-set(IN-SBASE, h, b)
    ct-set(IN-N, h, ct-inc(n))
}

in-set-label = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(IN-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(IN-LAB, ct-add(ct-get(IN-SBASE, h), i), s)
    }
}

in-set-value = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(IN-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(IN-VAL, ct-add(ct-get(IN-SBASE, h), i), s)
    }
}

in-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(IN-SBASE, h, 0)
    ct-set(IN-N, h, 0)
}

; ============================================================================
; message-scroller：消息 + 输入中（阶段62）
; ============================================================================
; 目录第 60 行承诺 message-scroller「messages, typing」，但命令式侧只有一个构造
; 函数，而且它原本在 cs-is-container 白名单里 —— 没有子节点时走通用兜底，画成
; 一个 0×0 的 FIELD 矩形（同阶段 60 的 history / 阶段 61 的 inspector）。
; 消息是**数据**不是视觉子节点（同 C-PAGINATION / C-SELECT / C-TAB /
; C-DESCRIPTION-LIST / C-ACCORDION / C-CAROUSEL / C-HISTORY / C-INSPECTOR
; 一路），所以本阶段把它从白名单里拿掉，画 / 量都读 MS-* 池。
; 「输入中」走 CMP-VALUE（0 / 1），渲染层据此在末尾补一行「typing...」。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-CHAR-W=800、CS-LINE-H=2400、CS-SEP-H=100、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、消息行间距 1px ----
ms-pad = () (p i64) { p = 1200 }
ms-gap = () (g i64) { g = 100 }

ms-count = (h i64) (n i64) { n = ct-get(MS-N, h) }

ms-text = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(MS-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(MS-MSG, ct-add(ct-get(MS-SBASE, h), i))
    }
    s = s
}

ms-author = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(MS-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(MS-AUTH, ct-add(ct-get(MS-SBASE, h), i))
    }
    s = s
}

ms-add = (h i64, auth str, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(MS-SBASE, h)
    n = ct-get(MS-N, h)
    (n == 0) -> { b = MS-MSG.len() }
    MS-MSG.push(s)
    MS-AUTH.push(auth)
    ct-set(MS-SBASE, h, b)
    ct-set(MS-N, h, ct-inc(n))
}

ms-set-text = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(MS-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(MS-MSG, ct-add(ct-get(MS-SBASE, h), i), s)
    }
}

ms-set-author = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(MS-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(MS-AUTH, ct-add(ct-get(MS-SBASE, h), i), s)
    }
}

ms-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(MS-SBASE, h, 0)
    ct-set(MS-N, h, 0)
    CMP-VALUE[h] = 0
}

; ---- 「输入中」标记（夹 0 / 1，负数归 0）----
ms-typing = (h i64) (v i64) {
    v = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    (v != 0) -> { v = 1 }
    v = v
}

ms-set-typing = (h i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (v > 0) -> { v = 1 }
    (v <= 0) -> { v = 0 }
    CMP-VALUE[h] = v
}

; ============================================================================
; status-bar：分段条（阶段63）
; ============================================================================
; 目录第 65 行承诺 status-bar「segments」，但命令式侧只有一个构造函数，而且它
; 原本在 cs-is-container 白名单里 —— 没有子节点时走通用兜底，画成一个 0×0 的
; FIELD 矩形（同阶段 60 的 history / 阶段 61 的 inspector / 阶段 62 的
; message-scroller）。段是**数据**不是视觉子节点（同 C-PAGINATION / C-SELECT /
; C-TAB / C-DESCRIPTION-LIST / C-ACCORDION / C-CAROUSEL / C-HISTORY /
; C-INSPECTOR / C-MESSAGE-SCROLLER 一路），所以本阶段把它从白名单里拿掉，
; 画 / 量都读 SB-* 池。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-SEP-H=100、CS-CHAR-W=800、CS-LINE-H=2400、
;   CS-BTN-H=4000、CS-MIN-LEAF-W=6400。

; ---- 内边距 12px、段间分隔条 1px ----
sb-pad = () (p i64) { p = 1200 }
sb-div-w = () (w i64) { w = 100 }

sb-count = (h i64) (n i64) { n = ct-get(SB-N, h) }

sb-seg = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(SB-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(SB-SEG, ct-add(ct-get(SB-SBASE, h), i))
    }
    s = s
}

sb-add = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(SB-SBASE, h)
    n = ct-get(SB-N, h)
    (n == 0) -> { b = SB-SEG.len() }
    SB-SEG.push(s)
    ct-set(SB-SBASE, h, b)
    ct-set(SB-N, h, ct-inc(n))
}

sb-set-seg = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(SB-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(SB-SEG, ct-add(ct-get(SB-SBASE, h), i), s)
    }
}

sb-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SB-SBASE, h, 0)
    ct-set(SB-N, h, 0)
}

; ============================================================================
; popover（阶段64）—— 锚在某个组件上的小弹层
;   标题走 CMP-TEXT；展开态走 CMP-VALUE（0 / 1，负数归 0）；
;   锚定边走 CMP-VALUE2（0 下 / 1 上 / 2 左 / 3 右，夹紧 0..3）；
;   正文行走扁平池 PV-LINE + 每句柄基址 / 行数。
;   关闭时不画任何东西（measure 只给最小的叶片尺寸）。
; ============================================================================

; ---- 内边距 12px、箭头方块 8px、间隙 8px ----
pv-pad = () (p i64) { p = 1200 }
pv-arrow-w = () (w i64) { w = 800 }
pv-gap = () (g i64) { g = 800 }

pv-open = (h i64) (v i64) {
    v = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    (v != 0) -> { v = 1 }
    v = v
}

pv-set-open = (h i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (v > 0) -> { v = 1 }
    (v <= 0) -> { v = 0 }
    CMP-VALUE[h] = v
}

pv-side = (h i64) (s i64) {
    s = CMP-VALUE2[h]: {
        ok -> it

        -> 0
    }
}

pv-set-side = (h i64, s i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (s < 0) -> { s = 0 }
    (s > 3) -> { s = 3 }
    CMP-VALUE2[h] = s
}

pv-title = (h i64) (s str) { s = cmp-text(h) }

pv-set-title = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
}

pv-count = (h i64) (n i64) { n = ct-get(PV-N, h) }

pv-line = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(PV-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(PV-LINE, ct-add(ct-get(PV-SBASE, h), i))
    }
    s = s
}

pv-add = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(PV-SBASE, h)
    n = ct-get(PV-N, h)
    (n == 0) -> { b = PV-LINE.len() }
    PV-LINE.push(s)
    ct-set(PV-SBASE, h, b)
    ct-set(PV-N, h, ct-inc(n))
}

pv-set-line = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(PV-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(PV-LINE, ct-add(ct-get(PV-SBASE, h), i), s)
    }
}

pv-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(PV-SBASE, h, 0)
    ct-set(PV-N, h, 0)
}

; ============================================================================
; 阶段65：questionnaire（C-QUESTIONNAIRE）—— 题池 + 每题「题干 FG + 答案 ACCENT」
;
; 组件目录第 28 行写着「questions container」，但命令式侧只有 cmp-questionnaire()
; 一个构造函数，而且它还在 cs-is-container 白名单里（没有子节点时走通用兜底画成
; 一个 0×0 的 FIELD 矩形）。题是**数据**不是视觉子节点，所以本阶段把它从白名单
; 拿掉，量 / 画都读 QA-* 池。
; 几何常量与 cmp-scene.no 同源（组件模块不能 import 渲染层，抄字面量）：
;   CS-PAD=1200、CS-GAP=800、CS-LINE-H=2400、CS-MIN-LEAF-W=6400、CS-BTN-H=4000。

; ---- 内边距 12px、题间距 8px、最小宽 64px ----
qa-pad = () (p i64) { p = 1200 }
qa-gap = () (g i64) { g = 800 }
qa-min-w = () (w i64) { w = 6400 }

qa-count = (h i64) (n i64) { n = ct-get(QA-N, h) }

qa-prompt = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(QA-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(QA-PROMPT, ct-add(ct-get(QA-SBASE, h), i))
    }
    s = s
}

qa-answer = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(QA-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(QA-ANS, ct-add(ct-get(QA-SBASE, h), i))
    }
    s = s
}

qa-required = (h i64, i i64) (v i64) {
    v = 0
    n = ct-get(QA-N, h)
    ((i >= 0) && (i < n)) -> { v = ct-get(QA-REQ, ct-add(ct-get(QA-SBASE, h), i)) }
    v = v
}

; 已作答题数（答案非空）
qa-answered = (h i64) (n i64) {
    n = 0
    cnt = ct-get(QA-N, h)
    b = ct-get(QA-SBASE, h)
    i = 0
    !! {
        (i >= cnt) -> { ** }
        (ed-arr-get-s(QA-ANS, ct-add(b, i)).len() > 0) -> {
            nn = n + 1: {
                ok -> it

                -> n
            }
            n = nn
        }
        ni = i + 1: {
            ok -> it

            -> i
        }
        i = ni
    }
    n = n
}

; 进度百分比 0..100（无题时 0）
qa-progress = (h i64) (p i64) {
    cnt = ct-get(QA-N, h)
    (cnt <= 0) -> { p = 0 }
    (cnt > 0) -> {
        a = qa-answered(h)
        t1 = a * 100: {
            ok -> it

            -> 0
        }
        t2 = t1 / cnt: {
            ok -> it

            -> 0
        }
        p = t2
    }
    p = p
}

; 必答题是否都已作答（无题或无必答题都算过）
qa-complete = (h i64) (v i64) {
    v = 1
    cnt = ct-get(QA-N, h)
    b = ct-get(QA-SBASE, h)
    i = 0
    !! {
        (i >= cnt) -> { ** }
        (ct-get(QA-REQ, ct-add(b, i)) != 0) -> {
            (ed-arr-get-s(QA-ANS, ct-add(b, i)).len() == 0) -> { v = 0 }
        }
        ni = i + 1: {
            ok -> it

            -> i
        }
        i = ni
    }
    v = v
}

qa-add = (h i64, prompt str, answer str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(QA-N, h)
    ; 三个池始终同步增长（每次 qa-add 各 push 一条），所以基址只记一个就够
    b = QA-PROMPT.len()
    (n != 0) -> { b = ct-get(QA-SBASE, h) }
    QA-PROMPT.push(prompt)
    QA-ANS.push(answer)
    QA-REQ.push(0)
    ct-set(QA-SBASE, h, b)
    ct-set(QA-N, h, ct-inc(n))
}

qa-set-prompt = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(QA-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(QA-PROMPT, ct-add(ct-get(QA-SBASE, h), i), s)
    }
}

qa-set-answer = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(QA-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(QA-ANS, ct-add(ct-get(QA-SBASE, h), i), s)
    }
}

qa-set-required = (h i64, i i64, v i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(QA-N, h)
    ((i >= 0) && (i < n)) -> {
        ct-set(QA-REQ, ct-add(ct-get(QA-SBASE, h), i), v)
    }
}

qa-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(QA-SBASE, h, 0)
    ct-set(QA-N, h, 0)
}

; ============================================================================
; 阶段66：searchable-list（可搜索列表）—— 目录第 85 行写着「query, items,
; filtered」，实际只有一个构造函数。条目是**数据**不是视觉子节点，所以从
; cs-is-container 白名单里拿掉，测量 / 绘制 / 命中都读池子。
; 结构仿 combobox：条目标签走扁平池 SL-ITEM，查询串就是 CMP-TEXT[h]，
; 过滤结果走另一张扁平池 SL-MATCH（存的是条目下标），高亮存 SL-CUR。
; 匹配规则：查询空 = 全选；否则条目标签 to-lower 后 contains 查询 to-lower。
; ============================================================================

sl-pad = () (p i64) { p = 1200 }
sl-gap = () (g i64) { g = 800 }
sl-min-w = () (w i64) { w = 6400 }

sl-count = (h i64) (n i64) {
    n = ct-get(SL-N, h)
}

sl-item = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(SL-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(SL-ITEM, ct-add(ct-get(SL-SBASE, h), i))
    }
    s = s
}

sl-add = (h i64, label str) (idx i64) {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(SL-N, h)
    b = SL-ITEM.len()
    (n != 0) -> { b = ct-get(SL-SBASE, h) }
    SL-ITEM.push(label)
    ct-set(SL-SBASE, h, b)
    ct-set(SL-N, h, ct-inc(n))
    idx = n
    sl-refresh(h)
}

sl-set-item = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(SL-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(SL-ITEM, ct-add(ct-get(SL-SBASE, h), i), s)
    }
    sl-refresh(h)
}

sl-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SL-SBASE, h, 0)
    ct-set(SL-N, h, 0)
    ct-set(SL-MBASE, h, 0)
    ct-set(SL-MN, h, 0)
    ct-set(SL-CUR, h, -1)
}

; 查询串：直接读写 CMP-TEXT（同 combobox）
sl-query = (h i64) (s str) {
    s = cmp-text(h)
}

sl-set-query = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    CMP-TEXT[h] = s
    sl-refresh(h)
}

; 按当前查询重建匹配段（追加到扁平池尾部，只增）
sl-refresh = (h i64) () {
    q = cmp-text(h).to-lower()
    n = ct-get(SL-N, h)
    base = SL-MATCH.len()
    ct-set(SL-MBASE, h, base)
    ct-set(SL-MN, h, 0)
    b = ct-get(SL-SBASE, h)
    i = 0
    !! {
        (i >= n) -> { ** }
        lab = ed-arr-get-s(SL-ITEM, ct-add(b, i)).to-lower()
        ok = (q.len() == 0) || lab.contains(q)
        (ok) -> {
            SL-MATCH.push(i)
            ct-set(SL-MN, h, ct-inc(ct-get(SL-MN, h)))
        }
        ni = i + 1: {
            ok -> it

            -> i
        }
        i = ni
    }
    ; 高亮夹紧：没匹配 = -1；越界收回末尾
    mn = ct-get(SL-MN, h)
    cur = ct-get(SL-CUR, h)
    (mn <= 0) -> { ct-set(SL-CUR, h, -1) }
    ((mn > 0) && (cur < 0)) -> { ct-set(SL-CUR, h, 0) }
    ((mn > 0) && (cur >= mn)) -> { ct-set(SL-CUR, h, ct-sub(mn, 1)) }
}

sl-match-count = (h i64) (n i64) {
    n = ct-get(SL-MN, h)
}

; 第 j 个匹配对应的条目下标（越界给 -1）
sl-match = (h i64, j i64) (i i64) {
    i = -1
    mn = ct-get(SL-MN, h)
    ((j >= 0) && (j < mn)) -> {
        v = SL-MATCH[ct-add(ct-get(SL-MBASE, h), j)]: {
            ok -> it

            -> -1
        }
        i = v
    }
    i = i
}

; 高亮行的条目下标（-1 = 没有）
sl-selected = (h i64) (i i64) {
    i = -1
    cur = ct-get(SL-CUR, h)
    (cur >= 0) -> { i = sl-match(h, cur) }
    i = i
}

; 高亮行号（匹配表里的第几行；-1 = 没有）
sl-highlight = (h i64) (j i64) {
    j = ct-get(SL-CUR, h)
}

sl-select = (h i64, j i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    mn = ct-get(SL-MN, h)
    (j < 0) -> { ct-set(SL-CUR, h, -1) }
    ((j >= 0) && (j < mn)) -> { ct-set(SL-CUR, h, j) }
}

sl-select-next = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    mn = ct-get(SL-MN, h)
    (mn <= 0) -> { ct-set(SL-CUR, h, -1) }
    (mn > 0) -> {
        cur = ct-get(SL-CUR, h)
        (cur < 0) -> { ct-set(SL-CUR, h, 0) }
        (cur >= 0) -> {
            nc = cur + 1: {
                ok -> it

                -> cur
            }
            (nc >= mn) -> { nc = ct-sub(mn, 1) }
            ct-set(SL-CUR, h, nc)
        }
    }
}

sl-select-prev = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    mn = ct-get(SL-MN, h)
    (mn <= 0) -> { ct-set(SL-CUR, h, -1) }
    (mn > 0) -> {
        cur = ct-get(SL-CUR, h)
        (cur < 0) -> { ct-set(SL-CUR, h, ct-sub(mn, 1)) }
        (cur >= 0) -> {
            pc = cur - 1: {
                ok -> it

                -> cur
            }
            (pc < 0) -> { pc = 0 }
            ct-set(SL-CUR, h, pc)
        }
    }
}

; ============================================================================
; title-bar（阶段67）—— 目录第 73 行写着「title, buttons」。
;   标题走 CMP-TEXT[h]（构造函数已经把 title 存进去，读写用 cmp-text /
;   cmp-set-text）；按钮是扁平只增的 TTB-BTN 数据池 + 每句柄基址 / 计数。
;   几何（渲染层算）：左标题 FG + 右端一排按钮，按钮盒宽 = 文案宽 + 2*800。
; ============================================================================

tb-pad = () (p i64) { p = 1200 }
tb-gap = () (g i64) { g = 800 }
tb-btn-pad = () (q i64) { q = 800 }
tb-head-h = () (hh i64) { hh = 4000 }

tb-count = (h i64) (n i64) { n = ct-get(TTB-N, h) }

tb-title = (h i64) (s str) {
    s = cmp-text(h)
    s = s
}

tb-set-title = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cmp-set-text(h, s)
}

tb-button = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(TTB-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(TTB-BTN, ct-add(ct-get(TTB-SBASE, h), i))
    }
    s = s
}

tb-add = (h i64, label str) (idx i64) {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(TTB-SBASE, h)
    n = ct-get(TTB-N, h)
    (n == 0) -> { b = TTB-BTN.len() }
    TTB-BTN.push(label)
    ct-set(TTB-SBASE, h, b)
    ct-set(TTB-N, h, ct-inc(n))
    idx = n
}

tb-set-button = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(TTB-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(TTB-BTN, ct-add(ct-get(TTB-SBASE, h), i), s)
    }
}

tb-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(TTB-SBASE, h, 0)
    ct-set(TTB-N, h, 0)
}

; ============================================================================
; toolbar（阶段68）—— 目录第 72 行写着「items」。
;   一条横排条目（chip），其中一个高亮为当前项。条目是扁平只增的 TLB-ITEM
;   数据池 + 每句柄基址 / 计数 / 当前选中，不是视觉子节点。
;   几何（渲染层算）：每个 chip 盒宽 = 文案宽 + 2*800，间距 800。
; ============================================================================

tlb-pad = () (p i64) { p = 1200 }
tlb-gap = () (g i64) { g = 800 }
tlb-chip-pad = () (q i64) { q = 800 }
tlb-bar-h = () (hh i64) { hh = 4000 }

tlb-count = (h i64) (n i64) { n = ct-get(TLB-N, h) }

tlb-item = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(TLB-N, h)
    ((i >= 0) && (i < n)) -> {
        s = ed-arr-get-s(TLB-ITEM, ct-add(ct-get(TLB-SBASE, h), i))
    }
    s = s
}

tlb-add = (h i64, label str) (idx i64) {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(TLB-SBASE, h)
    n = ct-get(TLB-N, h)
    (n == 0) -> { b = TLB-ITEM.len() }
    TLB-ITEM.push(label)
    ct-set(TLB-SBASE, h, b)
    ct-set(TLB-N, h, ct-inc(n))
    ; 首次有条目时自动高亮第 0 项
    ((n == 0) & (ct-get(TLB-CUR, h) < 0)) -> { ct-set(TLB-CUR, h, 0) }
    idx = n
}

tlb-set-item = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(TLB-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(TLB-ITEM, ct-add(ct-get(TLB-SBASE, h), i), s)
    }
}

tlb-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(TLB-SBASE, h, 0)
    ct-set(TLB-N, h, 0)
    ct-set(TLB-CUR, h, -1)
}

tlb-selected = (h i64) (i i64) { i = ct-get(TLB-CUR, h) }

tlb-select = (h i64, i i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(TLB-N, h)
    (n <= 0) -> { ct-set(TLB-CUR, h, -1) }
    ((i >= 0) && (i < n)) -> { ct-set(TLB-CUR, h, i) }
    ((i < 0) || (i >= n)) -> {
        ; 越界：夹紧到最近一端
        (i < 0) -> { ct-set(TLB-CUR, h, 0) }
        (i >= n) -> { ct-set(TLB-CUR, h, ct-sub(n, 1)) }
    }
}

tlb-select-next = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(TLB-N, h)
    (n <= 0) -> return
    cur = ct-get(TLB-CUR, h)
    (cur < 0) -> { ct-set(TLB-CUR, h, 0) }
    (cur >= 0) -> {
        nc = ct-inc(cur)
        (nc >= n) -> { nc = 0 }
        ct-set(TLB-CUR, h, nc)
    }
}

tlb-select-prev = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(TLB-N, h)
    (n <= 0) -> return
    cur = ct-get(TLB-CUR, h)
    (cur < 0) -> { ct-set(TLB-CUR, h, ct-sub(n, 1)) }
    (cur >= 0) -> {
        pc = cur - 1: {
            ok -> it

            -> cur
        }
        (pc < 0) -> { pc = ct-sub(n, 1) }
        ct-set(TLB-CUR, h, pc)
    }
}

; ============================================================================
; sidebar（阶段69）—— 目录第 69 行写着「groups, collapsed」。
;   分组标题走扁平池 SDB-GROUP + 每句柄基址 / 组数；条目走扁平池 SDB-ITEM
;   并配一条平行的「属于哪个组」SDB-ITOG（这样往任意组追加条目都不用搬移数组）。
;   折叠位走每句柄 SDB-COLL。几何（渲染层算）：组头 2400、条目行 2400、
;   条目比组头多缩进 1600。
; ============================================================================

sdb-pad = () (p i64) { p = 1200 }
sdb-gap = () (g i64) { g = 800 }
sdb-indent = () (d i64) { d = 1600 }
sdb-line-h = () (lh i64) { lh = 2400 }

sdb-group-count = (h i64) (n i64) { n = ct-get(SDB-GNC, h) }

sdb-group = (h i64, g i64) (s str) {
    s = ''
    n = ct-get(SDB-GNC, h)
    ((g >= 0) & (g < n)) -> {
        s = ed-arr-get-s(SDB-GROUP, ct-add(ct-get(SDB-GSBASE, h), g))
    }
    s = s
}

sdb-add-group = (h i64, title str) (idx i64) {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(SDB-GSBASE, h)
    n = ct-get(SDB-GNC, h)
    (n == 0) -> { b = SDB-GROUP.len() }
    SDB-GROUP.push(title)
    ct-set(SDB-GSBASE, h, b)
    ct-set(SDB-GNC, h, ct-inc(n))
    idx = n
}

sdb-set-group = (h i64, g i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(SDB-GNC, h)
    ((g >= 0) & (g < n)) -> {
        ed-arr-set-s(SDB-GROUP, ct-add(ct-get(SDB-GSBASE, h), g), s)
    }
}

sdb-clear-groups = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SDB-GSBASE, h, 0)
    ct-set(SDB-GNC, h, 0)
}

sdb-item-count = (h i64) (n i64) { n = ct-get(SDB-IN, h) }

sdb-item = (h i64, i i64) (s str) {
    s = ''
    n = ct-get(SDB-IN, h)
    ((i >= 0) & (i < n)) -> {
        s = ed-arr-get-s(SDB-ITEM, ct-add(ct-get(SDB-ISBASE, h), i))
    }
    s = s
}

sdb-item-group = (h i64, i i64) (g i64) {
    g = -1
    n = ct-get(SDB-IN, h)
    ((i >= 0) & (i < n)) -> {
        g = ct-get(SDB-ITOG, ct-add(ct-get(SDB-ISBASE, h), i))
    }
    g = g
}

sdb-add-item = (h i64, g i64, label str) (idx i64) {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ng = ct-get(SDB-GNC, h)
    ((g < 0) | (g >= ng)) -> {
        ; 组号越界：当作写空操作，直接返回
        idx = -1
        return
    }
    b = ct-get(SDB-ISBASE, h)
    n = ct-get(SDB-IN, h)
    (n == 0) -> {
        b = SDB-ITEM.len()
        ct-set(SDB-ISBASE, h, b)
    }
    SDB-ITEM.push(label)
    SDB-ITOG.push(g)
    ct-set(SDB-IN, h, ct-inc(n))
    idx = n
}

sdb-set-item = (h i64, i i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    n = ct-get(SDB-IN, h)
    ((i >= 0) & (i < n)) -> {
        ed-arr-set-s(SDB-ITEM, ct-add(ct-get(SDB-ISBASE, h), i), s)
    }
}

sdb-clear-items = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SDB-ISBASE, h, 0)
    ct-set(SDB-IN, h, 0)
}

sdb-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    sdb-clear-groups(h)
    sdb-clear-items(h)
}

sdb-collapsed = (h i64) (v i64) { v = ct-get(SDB-COLL, h) }

sdb-set-collapsed = (h i64, on i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SDB-COLL, h, on)
}

; 某组的条目数（用于测算 / 渲染按组聚合）
sdb-group-size = (h i64, g i64) (n i64) {
    n = 0
    m = ct-get(SDB-IN, h)
    i = 0
    !! {
        (i >= m) -> { ** }
        ig = sdb-item-group(h, i)
        (ig == g) -> { n = ct-inc(n) }
        i = ct-inc(i)
    }
    n = n
}

; ============================================================================
; 阶段70：命令式 sheet（C-SHEET）—— 可停靠四边的抽屉 / 面板
;   标题走 CMP-TEXT[h]（构造函数已经把 title 存进去）；展开位与停靠边各一个
;   per-handle 池。side: 0=左 1=右 2=上 3=下。
; ============================================================================
sht-pad = () (p i64) { p = 1200 }
sht-gap = () (g i64) { g = 800 }
sht-bar-w = () (bw i64) { bw = 1200 }      ; 停靠边那条 ACCENT 抓杆宽
sht-min-w = () (mw i64) { mw = 2400 }      ; 内容区最小宽
sht-body-h = () (bh i64) { bh = 8000 }     ; 展开时正文区高

sht-open = (h i64) (v i64) {
    v = ct-get(SHT-OPEN, h)
}

sht-set-open = (h i64, on i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SHT-OPEN, h, on)
}

sht-show = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SHT-OPEN, h, 1)
}

sht-hide = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SHT-OPEN, h, 0)
}

sht-toggle = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    v = ct-get(SHT-OPEN, h)
    (v != 0) -> { ct-set(SHT-OPEN, h, 0) }
    (v == 0) -> { ct-set(SHT-OPEN, h, 1) }
}

sht-side = (h i64) (v i64) {
    v = ct-get(SHT-SIDE, h)
}

; 标题读写（sheet 专属，写操作看 F-DISABLED；底层仍是 CMP-TEXT[h]）
sht-title = (h i64) (s str) { s = cmp-text(h) }

sht-set-title = (h i64, s str) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cmp-set-text(h, s)
}

; 越界值夹到 [0,3]
sht-set-side = (h i64, s i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ((s >= 0) && (s <= 3)) -> { ct-set(SHT-SIDE, h, s) }
    (s < 0) -> { ct-set(SHT-SIDE, h, 0) }
    (s > 3) -> { ct-set(SHT-SIDE, h, 3) }
}

; ============================================================================
; 阶段71：命令式 text-node（C-TEXT）—— 单行多段样式文本
;   没有片段时退化成「组件标题走 CMP-TEXT[h]、颜色走 CMP-COLOR[h]」的一条
;   文本，和补全前行为完全一致。片段池扁平只增：TXN-RUN 存文案、TXN-COL
;   存颜色（-1 = 继承组件自身 CMP-COLOR[h]）。
; ============================================================================
txn-count = (h i64) (n i64) {
    n = ct-get(TXN-N, h)
}

txn-run-text = (h i64, i i64) (s str) {
    s = ''
    b = ct-get(TXN-SBASE, h)
    n = ct-get(TXN-N, h)
    ((i >= 0) && (i < n)) -> { s = ed-arr-get-s(TXN-RUN, ct-add(b, i)) }
    s = s
}

txn-run-color = (h i64, i i64) (c i64) {
    c = -1
    b = ct-get(TXN-SBASE, h)
    n = ct-get(TXN-N, h)
    ((i >= 0) && (i < n)) -> { c = ct-get(TXN-COL, ct-add(b, i)) }
    c = c
}

txn-add = (h i64, s str, c i64) (idx i64) {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(TXN-SBASE, h)
    n = ct-get(TXN-N, h)
    (n == 0) -> { b = TXN-RUN.len() }
    TXN-RUN.push(s)
    TXN-COL.push(c)
    ct-set(TXN-SBASE, h, b)
    ct-set(TXN-N, h, ct-inc(n))
    idx = n
}

txn-set-run = (h i64, i i64, s str, c i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-get(TXN-SBASE, h)
    n = ct-get(TXN-N, h)
    ((i >= 0) && (i < n)) -> {
        ed-arr-set-s(TXN-RUN, ct-add(b, i), s)
        ct-set(TXN-COL, ct-add(b, i), c)
    }
}

txn-clear = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(TXN-SBASE, h, 0)
    ct-set(TXN-N, h, 0)
}

; ============================================================================
; 阶段72：sizing —— 尺寸约束盒（C-SIZING）
;   六条 per-handle 槽：目标宽高 SZG-W / SZG-H、下限 SZG-MINW / SZG-MINH、
;   上限 SZG-MAXW / SZG-MAXH。0 一律「未指定」。
;   `szg-clamp` 是纯函数：把任意宽高按该句柄的 min/max 夹紧，供渲染层测算
;   与外部（布局器 / demo）复用同一套语义。
; ============================================================================
szg-w = (h i64) (v i64) { v = ct-get(SZG-W, h) }
szg-h = (h i64) (v i64) { v = ct-get(SZG-H, h) }
szg-minw = (h i64) (v i64) { v = ct-get(SZG-MINW, h) }
szg-minh = (h i64) (v i64) { v = ct-get(SZG-MINH, h) }
szg-maxw = (h i64) (v i64) { v = ct-get(SZG-MAXW, h) }
szg-maxh = (h i64) (v i64) { v = ct-get(SZG-MAXH, h) }

szg-set-size = (h i64, w i64, ht i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SZG-W, h, w)
    ct-set(SZG-H, h, ht)
}
szg-set-min = (h i64, mw i64, mh i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SZG-MINW, h, mw)
    ct-set(SZG-MINH, h, mh)
}
szg-set-max = (h i64, mw i64, mh i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SZG-MAXW, h, mw)
    ct-set(SZG-MAXH, h, mh)
}
; 一键回到「全未指定」（跟随内容 / 父级）
szg-reset = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SZG-W, h, 0)
    ct-set(SZG-H, h, 0)
    ct-set(SZG-MINW, h, 0)
    ct-set(SZG-MINH, h, 0)
    ct-set(SZG-MAXW, h, 0)
    ct-set(SZG-MAXH, h, 0)
}

; 纯夹紧：先上限后下限（上限 0 = 不限；若上限比下限还小则**下限优先**）。
szg-clamp = (h i64, w i64, ht i64) (cw i64, ch i64) {
    cw = w
    ch = ht
    mw = ct-get(SZG-MINW, h)
    mh = ct-get(SZG-MINH, h)
    xw = ct-get(SZG-MAXW, h)
    xh = ct-get(SZG-MAXH, h)
    (xw > 0) -> { (cw > xw) -> { cw = xw } }
    (xh > 0) -> { (ch > xh) -> { ch = xh } }
    (mw > 0) -> { (cw < mw) -> { cw = mw } }
    (mh > 0) -> { (ch < mh) -> { ch = mh } }
    cw = cw
    ch = ch
}

; ============================================================================
; 阶段73：styled（C-STYLED）—— 基础样式容器
;   「base style container」：给子树提供一层可覆写的底子（底色 / 边框）。
;   三条 per-handle 槽：STY-BG（底色，-1 = 继承组件色）、STY-BC（边框色，
;   -1 = 不画）、STY-BW（边框厚度，0 = 不画；负数夹到 0）。
;   布局仍走通用容器分支（cs-is-container 白名单保留），渲染层只在通用
;   容器臂上换底色、并在装饰位置补四条边框，**不新增节点种类**。
; ============================================================================
sty-bg = (h i64) (v i64) { v = ct-get(STY-BG, h) }
sty-border = (h i64) (v i64) { v = ct-get(STY-BC, h) }
sty-border-w = (h i64) (v i64) { v = ct-get(STY-BW, h) }

sty-set-bg = (h i64, c i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(STY-BG, h, c)
}
sty-set-border = (h i64, c i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(STY-BC, h, c)
}
sty-set-border-w = (h i64, w i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (w < 0) -> { w = 0 }
    ct-set(STY-BW, h, w)
}
; 一键回到「无覆写」（继承组件色 / 不画框）
sty-reset = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(STY-BG, h, -1)
    ct-set(STY-BC, h, -1)
    ct-set(STY-BW, h, 0)
}

; ============================================================================
; 阶段74：shimmer（C-SHIMMER）—— 扫光占位
;   目录第 52 行承诺 shimmer「duration」。槽位沿用既有约定：
;   CMP-VALUE[h] = 扫光相位 0..100（0 = 不扫，与旧渲染分支一致）；
;   另加三个 per-handle 池 SHM-DUR（周期 ms，0 = 默认 1200）、
;   SHM-BAND（高光带宽百分比 0..100，0 = 默认 30）、SHM-COL（-1 = MUTED）。
;   相位本身没有时钟源，由应用按帧调 `shm-advance` 推进（时长在此生效）。
; ============================================================================
shm-duration = (h i64) (d i64) {
    d = ct-get(SHM-DUR, h)
}
shm-set-duration = (h i64, d i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (d < 0) -> { d = 0 }
    ct-set(SHM-DUR, h, d)
}
shm-band = (h i64) (b i64) {
    b = ct-get(SHM-BAND, h)
}
shm-set-band = (h i64, b i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    b = ct-clamp(b, 0, 100)
    ct-set(SHM-BAND, h, b)
}
shm-color = (h i64) (c i64) {
    c = ct-get(SHM-COL, h)
}
shm-set-color = (h i64, c i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SHM-COL, h, c)
}
; 相位 0..100（getter 夹紧；0 = 不扫，与 sk-phase 同语义）
shm-phase = (h i64) (p i64) {
    p = CMP-VALUE[h]: {
        ok -> it

        -> 0
    }
    (p < 0) -> { p = 0 }
    (p > 100) -> { p = 100 }
}
shm-set-phase = (h i64, p i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    p = ct-clamp(p, 0, 100)
    CMP-VALUE[h] = p
}
; 按经过的毫秒数推进相位：步进 = dt * 100 / duration（duration 0 = 1200），
; 走完一圈（>=100）绕回 0。写操作同样先查 F-DISABLED（禁用时不走）。
shm-advance = (h i64, dt i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    d = shm-duration(h)
    (d <= 0) -> { d = 1200 }
    p = shm-phase(h)
    step = ct-div(ct-mul(dt, 100), d)
    np = ct-add(p, step)
    (np >= 100) -> { np = ct-sub(np, 100) }
    CMP-VALUE[h] = np
}
; 一键回到「不扫光」（时长 / 带宽 / 颜色同时归零）
shm-reset = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(SHM-DUR, h, 0)
    ct-set(SHM-BAND, h, 0)
    ct-set(SHM-COL, h, -1)
    CMP-VALUE[h] = 0
}

; ============================================================================
; 阶段75：window-border（C-WINDOW-BORDER）—— 窗口描边容器
;   目录第 56 行承诺 window_border「radii, width」。槽位：
;   WB-RAD = 四角统一圆角半径（px*100），0 = 直角；
;   WB-W   = 边框厚度（px*100），0 = 不画框。
;   边框色沿用组件自身 CMP-COLOR[h]，面板底固定用主题 FIELD（渲染层处理）。
; ============================================================================
wb-radius = (h i64) (r i64) {
    r = ct-get(WB-RAD, h)
}
wb-set-radius = (h i64, r i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (r < 0) -> { r = 0 }
    ct-set(WB-RAD, h, r)
}
wb-width = (h i64) (w i64) {
    w = ct-get(WB-W, h)
}
wb-set-width = (h i64, w i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    (w < 0) -> { w = 0 }
    ct-set(WB-W, h, w)
}
; 一键回到「直角 + 不画框」
wb-reset = (h i64) () {
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    ct-set(WB-RAD, h, 0)
    ct-set(WB-W, h, 0)
}
