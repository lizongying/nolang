; ============================================================================
; 核心 10 组件 —— 完整状态机（hover/click/focus/键盘/值变更）
; 全部用 flag 位 + VALUE/VUE2 表达状态，避免函数内多标量全局写回缺陷。
; ============================================================================
; 核心 10 组件 —— 完整状态机
; 🔴 关键约束（实测）：本段函数体内**不得调用任何辅助函数**（cmp-has / cmp-flag-set 等），
;    否则调用者的全局数组写回会丢失（记忆「辅助函式嵌套调用缺陷」）。全部内联位运算。
;    字符串插值里不得放数组下标表达式（会变字面量），先存局部变量再插值。

; ---- 1. Button ----
button-hover = (h i64, on bool) {
    (on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] | F-HOVERED }
    (!on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-HOVERED) }
}
button-press = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-FOCUSED
}
button-release = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-FOCUSED)
}
button-click = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    cnt = CMP-VALUE[h]
    n = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-VALUE[h] = n
}
button-clicks = (h i64) (n i64) {
    n = CMP-VALUE[h]
}

; ---- 2. Input ----
input-focus = (h i64, on bool) {
    (on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] | F-FOCUSED }
    (!on) -> { CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-FOCUSED) }
}
; 追加：str 数组下标是 ?str，先解包；用 push-str 原地追加（插值 + option 有 optunuse bug）
input-append = (h i64, ch str) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    txt = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
    txt.push-str(ch)
    CMP-TEXT[h] = txt
}
input-clear = (h i64) {
    CMP-TEXT[h] = ''
}
input-value = (h i64) (s str) {
    s = CMP-TEXT[h]: {
        ok -> it

        -> ''
    }
}
input-backspace = (h i64) {
    n = CMP-TEXT[h].len()
    (n > 0) -> {
        txt = CMP-TEXT[h]: {
            ok -> it

            -> ''
        }
        CMP-TEXT[h] = txt.slice(0, n - 1)
    }
}

; ---- 3. Checkbox ----
checkbox-toggle = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    checked = CMP-FLAGS[h] & F-CHECKED
    (checked != 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-CHECKED)
    }
    (checked == 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] | F-CHECKED
    }
}
checkbox-checked = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-CHECKED) != 0
}

; ---- 4. Radio ----
radio-select = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-SELECTED
}
radio-deselect = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-SELECTED)
}
radio-selected = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-SELECTED) != 0
}

; ---- 5. Switch ----
switch-toggle = (h i64) {
    #{overflow=wrap}
    disabled = CMP-FLAGS[h] & F-DISABLED
    (disabled != 0) -> return
    checked = CMP-FLAGS[h] & F-CHECKED
    (checked != 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-CHECKED)
    }
    (checked == 0) -> {
        CMP-FLAGS[h] = CMP-FLAGS[h] | F-CHECKED
    }
}
switch-on = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-CHECKED) != 0
}

; ---- 6. Select ----
select-open = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-OPEN
}
select-close = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
}
select-add-option = (h i64, label str) (idx i64) {
    opt = cmp-label(label)
    cnt = CMP-COUNT[h]
    (cnt == 0) -> { CMP-HEAD[h] = CHILD-IDX.len() }
    CHILD-IDX.push(opt)
    nc = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-COUNT[h] = nc
    idx = CMP-COUNT[h] - 1
}
select-choose = (h i64, idx i64) {
    (idx >= 0 && idx < CMP-COUNT[h]) -> {
        CMP-VALUE[h] = idx
        CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
        c = CHILD-IDX[CMP-HEAD[h] + idx]
        CMP-TEXT[h] = CMP-TEXT[c]: {
            ok -> it

            -> ''
        }
    }
}
select-selected = (h i64) (idx i64) {
    idx = CMP-VALUE[h]
}

; ---- 7. Tab ----
tab-add = (h i64, title str) (idx i64) {
    t = cmp-label(title)
    cnt = CMP-COUNT[h]
    (cnt == 0) -> { CMP-HEAD[h] = CHILD-IDX.len() }
    CHILD-IDX.push(t)
    nc = cnt + 1: {
        ok -> it

        -> cnt
    }
    CMP-COUNT[h] = nc
    idx = CMP-COUNT[h] - 1
    (CMP-VALUE[h] < 0) -> { CMP-VALUE[h] = 0 }
}
tab-active = (h i64) (idx i64) {
    idx = CMP-VALUE[h]
}
tab-select = (h i64, idx i64) {
    (idx >= 0 && idx < CMP-COUNT[h]) -> { CMP-VALUE[h] = idx }
}
tab-next = (h i64) {
    n = CMP-COUNT[h]
    (n > 0) -> {
        i = CMP-VALUE[h] + 1
        (i >= n) -> { i = 0 }
        CMP-VALUE[h] = i
    }
}
tab-prev = (h i64) {
    n = CMP-COUNT[h]
    (n > 0) -> {
        i = CMP-VALUE[h] - 1
        (i < 0) -> { i = n - 1 }
        CMP-VALUE[h] = i
    }
}

; ---- 8. Dialog ----
dialog-open = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-OPEN
}
dialog-close = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
}
dialog-confirm = (h i64) {
    CMP-VALUE[h] = 1
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-OPEN)
}
dialog-is-open = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-OPEN) != 0
}

; ---- 9. Tooltip ----
tooltip-show = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] | F-VISIBLE
}
tooltip-hide = (h i64) {
    CMP-FLAGS[h] = CMP-FLAGS[h] & (0xFFFFFFFF ^ F-VISIBLE)
}
tooltip-visible = (h i64) (yes bool) {
    yes = (CMP-FLAGS[h] & F-VISIBLE) != 0
}

; ---- 10. Progress / Slider ----
progress-set = (h i64, v i64, max i64) {
    x = v
    (x < 0) -> { x = 0 }
    (x > max) -> { x = max }
    CMP-VALUE[h] = x
    CMP-VALUE2[h] = max
}
progress-percent = (h i64) (pct i64) {
    m = CMP-VALUE2[h]
    pct = 0
    (m > 0) -> {
        pct = CMP-VALUE[h] * 100 / m
    }
}
slider-range = (h i64, lo i64, hi i64) {
    CMP-VALUE3[h] = lo
    CMP-VALUE2[h] = hi
}
slider-set = (h i64, v i64) {
    lo = CMP-VALUE3[h]
    hi = CMP-VALUE2[h]
    x = v
    (x < lo) -> { x = lo }
    (x > hi) -> { x = hi }
    CMP-VALUE[h] = x
}
slider-step = (h i64, dir i64) {
    lo = CMP-VALUE3[h]
    hi = CMP-VALUE2[h]
    x = CMP-VALUE[h] + dir
    (x < lo) -> { x = lo }
    (x > hi) -> { x = hi }
    CMP-VALUE[h] = x
}
slider-value = (h i64) (v i64) {
    v = CMP-VALUE[h]
}
