; 语言能力探针：vec-of-struct 字段写入、struct 返回值、with-len 索引赋值

node {
    x i64
    y i64
}

mk = (a i64, b i64) (n node) {
    n.x = a
    n.y = b
}

nodes []node = with-len(0)

n = mk(3, 4)
print('mk: {n.x},{n.y}')

v node
v.x = 10
v.y = 20
nodes.push(v)

nodes[0].x = 99
print('pool[0]: {nodes[0].x},{nodes[0].y}')

p []i64 = with-len(2)
p[0] = 7
print('arr: {p[0]}')
