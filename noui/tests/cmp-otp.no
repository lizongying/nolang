; ============================================================================
; noui OTP 输入测试（阶段 41）—— src/components.no + src/cmp-scene.no
;
; 缺口：组件目录写着 C-OTP-INPUT「digits, slots」，但命令式侧它只有 cmp-otp-input
; 一个空壳构造（CMP-VALUE 存槽数），没有逐槽数字、没有活动槽、没有退格 / 前删 /
; 灌入，渲染也还落在单行 cs-paint-field。阶段 41 补：
;   - 模型（组件模块）：OT-CODE 定长码（空格 = 空槽）+ OT-CUR 活动槽，
;     otp-slots / otp-cur(-set) / otp-code / otp-digit / otp-set-digit /
;     otp-clear-slot / otp-clear / otp-filled / otp-digits / otp-value /
;     otp-complete / otp-put / otp-backspace / otp-delete / otp-left /
;     otp-right / otp-set。
;   - 几何与命中：otp-slot-w / otp-slot-x / otp-hit（渲染层共用前两个，
;     保证「画的」和「点的」一致）。
;   - 渲染层新增 cs-paint-otp（每槽一格 + 数字居中 + 聚焦活动槽描边 + 空槽光标），
;     cs-measure 给 OTP 算「槽数 * 格宽 + (槽数-1) * 格距」的宽度。
;
; 运行：cd noui && ../bin/no build -cc ./ccwrap.sh -o dist/cmp-otp tests/cmp-otp.no
;       ./dist/cmp-otp
; ============================================================================
# /noui/src/cmp-scene

cs-theme-init()

; Scene 里是否有某段文本
cs-has-text = (t str) (yes bool) {
    yes = false
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (yes) -> { ** }
        (cs-scene-t(i) == t) -> { yes = true }
        i = cs-inc(i)
    }
    yes = yes
}

; Scene 里是否有某段文本落在给定 x
cs-text-at = (t str, x i64) (yes bool) {
    yes = false
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (yes) -> { ** }
        ((cs-scene-t(i) == t) && (cs-scene-x(i) == x)) -> { yes = true }
        i = cs-inc(i)
    }
    yes = yes
}

; Scene 里是否有给定几何的矩形（实心块 / 描边条都算）
cs-rect-at = (x i64, y i64, w i64, ht i64) (yes bool) {
    yes = false
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (yes) -> { ** }
        ((cs-scene-kind(i) == CS-RECT) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht)) -> { yes = true }
        i = cs-inc(i)
    }
    yes = yes
}

; 同上，但要求颜色也一致（用来钉「这条是强调色描边」）
cs-rect-color-at = (x i64, y i64, w i64, ht i64, c i64) (yes bool) {
    yes = false
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (yes) -> { ** }
        ((cs-scene-kind(i) == CS-RECT) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht) && (cs-scene-c(i) == c)) -> { yes = true }
        i = cs-inc(i)
    }
    yes = yes
}

; 文本居中时的落点 x
cs-center-x = (sx i64, sw i64, t str) (cx i64) {
    cx = cs-add(sx, cs-div(cs-sub(sw, cs-text-w(t)), 2))
}

; ---- 1. 构造 ----
ot = cmp-otp-input(6)
t1 = cmp-kind(ot) == C-OTP-INPUT && otp-slots(ot) == 6
t2 = otp-code(ot) == '      ' && otp-cur(ot) == 0
t3 = otp-filled(ot) == 0 && otp-value(ot) == '' && otp-digits(ot) == ''
t4 = otp-complete(ot) == false
; 槽数 <= 0 一律按 1
ot0 = cmp-otp-input(0)
t5 = otp-slots(ot0) == 1 && otp-code(ot0) == ' '

; ---- 2. 写数字 ----
otp-set-digit(ot, 0, 7)
t6 = otp-digit(ot, 0) == 7 && otp-code(ot) == '7     ' && otp-cur(ot) == 0
otp-set-digit(ot, 2, 3)
t7 = otp-digit(ot, 2) == 3 && otp-code(ot) == '7 3   ' && otp-cur(ot) == 2
; 空槽读 -1；越界也 -1
t8 = otp-digit(ot, 1) == -1 && otp-digit(ot, 6) == -1 && otp-digit(ot, -1) == -1
; d 不在 0..9 = 清空该槽
otp-set-digit(ot, 2, 99)
t9 = otp-digit(ot, 2) == -1 && otp-code(ot) == '7     '

; ---- 3. put：写活动槽并跳到下一个空槽 ----
otp-clear(ot)
t10 = otp-cur(ot) == 0 && otp-code(ot) == '      '
otp-put(ot, 1)
t11 = otp-code(ot) == '1     ' && otp-cur(ot) == 1
otp-put(ot, 2)
t12 = otp-code(ot) == '12    ' && otp-cur(ot) == 2
; 直接跳到第 4 槽写，再 put 会回填第 2 槽（下一个空槽）
otp-cur-set(ot, 4)
otp-put(ot, 9)
t13 = otp-code(ot) == '12  9 ' && otp-cur(ot) == 2
otp-put(ot, 4)
t14 = otp-code(ot) == '124 9 ' && otp-cur(ot) == 3
; 填满后停在末槽
otp-put(ot, 5)
otp-put(ot, 6)
t15 = otp-code(ot) == '124596' && otp-cur(ot) == 5

; ---- 4. filled / complete / digits ----
t16 = otp-filled(ot) == 6 && otp-complete(ot) == true
t17 = otp-digits(ot) == '124596' && otp-value(ot) == '124596'
otp-clear-slot(ot, 0)
t18 = otp-code(ot) == ' 24596' && otp-filled(ot) == 5 && otp-complete(ot) == false
t19 = otp-digits(ot) == '24596'

; ---- 5. clear ----
otp-clear(ot)
t20 = otp-code(ot) == '      ' && otp-cur(ot) == 0 && otp-filled(ot) == 0

; ---- 6. backspace：有数字清自己；空槽回退清上一格 ----
otp-set(ot, '12')
t21 = otp-code(ot) == '12    ' && otp-cur(ot) == 0
; 活动槽 0 是 '1' -> 清掉它
otp-backspace(ot)
t22 = otp-code(ot) == ' 2    ' && otp-cur(ot) == 0
; 活动槽 0 已空 -> 回退到上一格（没有）不动
otp-backspace(ot)
t23 = otp-code(ot) == ' 2    ' && otp-cur(ot) == 0
; 活动槽在 1（'2'）-> 清掉
otp-cur-set(ot, 1)
otp-backspace(ot)
t24 = otp-code(ot) == '      ' && otp-cur(ot) == 1
; 空槽在 0，回退无路 -> 不动
otp-backspace(ot)
t25 = otp-cur(ot) == 0

; ---- 7. delete：只清活动槽，不移动 ----
otp-set(ot, '456')
otp-cur-set(ot, 1)
otp-delete(ot)
t26 = otp-code(ot) == '4 6   ' && otp-cur(ot) == 1

; ---- 8. 左右移动：夹紧 ----
otp-cur-set(ot, 0)
otp-left(ot)
t27 = otp-cur(ot) == 0
otp-right(ot)
t28 = otp-cur(ot) == 1
otp-cur-set(ot, 5)
otp-right(ot)
t29 = otp-cur(ot) == 5

; ---- 9. otp-set：只取数字，超长截断，非数字忽略 ----
otp-set(ot, 'a1b2c3d4e5f6g7')
t30 = otp-value(ot) == '123456' && otp-cur(ot) == 0
otp-set(ot, '9')
t31 = otp-value(ot) == '9' && otp-code(ot) == '9     '
otp-set(ot, '')
t32 = otp-value(ot) == '' && otp-filled(ot) == 0

; ---- 10. disabled：写操作全无效 ----
ot2 = cmp-otp-input(4)
otp-set(ot2, '12')
cmp-flag-set(ot2, F-DISABLED)
otp-put(ot2, 3)
otp-set-digit(ot2, 0, 5)
otp-backspace(ot2)
otp-delete(ot2)
otp-clear(ot2)
t33 = otp-value(ot2) == '12' && otp-cur(ot2) == 0 && otp-filled(ot2) == 2

; ---- 11. 槽格几何（4 槽：需要 4*4000 + 3*800 = 18400）----
ot4 = cmp-otp-input(4)
t34 = otp-slot-w(ot4, 18400, 4000) == 4000
t35 = otp-slot-x(ot4, 0, 1000, 18400, 4000) == 1000 && otp-slot-x(ot4, 1, 1000, 18400, 4000) == 5800
; 宽不够 -> 缩格宽，但不下于 1200
t36 = otp-slot-w(ot4, 12000, 4000) == 2400
t37 = otp-slot-w(ot4, 1000, 4000) == 1200

; ---- 12. 命中 ----
; 4 个槽、x=0、w=18400、ht=4000：格 0 [0,4000)、格 1 [4800,8800) …
t38 = otp-hit(ot4, 100, 100, 0, 0, 18400, 4000) == 0
t39 = otp-hit(ot4, 5000, 100, 0, 0, 18400, 4000) == 1
t40 = otp-hit(ot4, 15000, 100, 0, 0, 18400, 4000) == 3
; 落在格间空隙 -> 不命中
t41 = otp-hit(ot4, 4400, 100, 0, 0, 18400, 4000) == -1
; 纵向越界 -> 不命中
t42 = otp-hit(ot4, 100, 5000, 0, 0, 18400, 4000) == -1

; ---- 13. 渲染：宽度 / 槽格 / 数字居中 / 聚焦描边 ----
root = cmp-root()
otp-clear(ot4)
cmp-add-child(root, ot4)
otp-set(ot4, '12')
mw, mh = cs-measure(ot4)
t43 = mh == 4000 && mw == 18400
otp-cur-set(ot4, 2)
input-focus(ot4, true)
cs-clear()
cs-layout(root, 0, 0, 40000, 12000)
cs-paint(root)
ox, oy, ow, oh = cs-rect(ot4)
sw = otp-slot-w(ot4, ow, oh)
sx2 = otp-slot-x(ot4, 2, ox, ow, oh)
; 槽格：第 0 / 1 / 2 槽各一个正方格
t44 = cs-rect-at(ox, oy, sw, oh) && cs-rect-at(cs-add(ox, cs-add(sw, 800)), oy, sw, oh) && cs-rect-at(sx2, oy, sw, oh)
; 数字居中：格 0 放 '1'，格 1 放 '2'
t45 = cs-text-at('1', cs-center-x(ox, sw, '1')) && cs-text-at('2', cs-center-x(cs-add(ox, cs-add(sw, 800)), sw, '2'))
; 聚焦活动槽（第 2 槽）的四条强调描边
ac = cs-theme(CS-TH-ACCENT)
t46 = cs-rect-color-at(sx2, oy, sw, 100, ac) && cs-rect-color-at(sx2, cs-sub(cs-add(oy, oh), 100), sw, 100, ac)
t47 = cs-rect-color-at(sx2, oy, 100, oh, ac) && cs-rect-color-at(cs-sub(cs-add(sx2, sw), 100), oy, 100, oh, ac)
; 未聚焦的控件不描边
ot5 = cmp-otp-input(2)
cmp-add-child(root, ot5)
cs-clear()
cs-layout(root, 0, 0, 40000, 12000)
cs-paint(root)
u5x, u5y, u5w, u5h = cs-rect(ot5)
t48 = (!cs-rect-at(u5x, u5y, u5w, 100)) && (!cs-rect-at(u5x, u5y, 100, u5h))

all-ok = t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13 && t14 && t15 && t16 && t17 && t18 && t19 && t20 && t21 && t22 && t23 && t24 && t25 && t26 && t27 && t28 && t29 && t30 && t31 && t32 && t33 && t34 && t35 && t36 && t37 && t38 && t39 && t40 && t41 && t42 && t43 && t44 && t45 && t46 && t47 && t48
print('ctor={t1}{t2}{t3}{t4}{t5}')
print('write={t6}{t7}{t8}{t9}')
print('put={t10}{t11}{t12}{t13}{t14}{t15}')
print('agg={t16}{t17}{t18}{t19}{t20}')
print('bksp={t21}{t22}{t23}{t24}{t25}')
print('del={t26} move={t27}{t28}{t29} set={t30}{t31}{t32}')
print('dis={t33} geom={t34}{t35}{t36}{t37}')
print('hit={t38}{t39}{t40}{t41}{t42}')
print('paint={t43}{t44}{t45}{t46}{t47}{t48}')
print('all-ok={all-ok}')
(all-ok) -> { print('ALL OTP TESTS PASSED') }
(!all-ok) -> { print('SOME TESTS FAILED') exit(1) }
