; ============================================================================
; noui 声明式「代码编辑器」测试（阶段 30）—— src/dv.no + src/dv-app.no
;
; 缺口：命令式内核里 C-HIGHLIGHTER / C-TEXTAREA 只有 API + 最小状态（cs-paint-leaf
; 没有 C-HIGHLIGHTER 分支，cs-paint-field 只画一行），所以「多行 + 行号 + 语法高亮 +
; 光标」没法靠单个 kind 通吃。阶段 30 把它做成**组合**：一行 = 行号 + 若干着色
; token + 光标，全部是既有 kind（C-FORM / C-LABEL / C-SEPARATOR），零内核改动。
;
; 阶段 30 补：
;   - dv-lex-line：一行 -> token 序列（关键字 / 字符串 / 注释 / 数字 / 标识符 /
;     空白 / 单字符标点），颜色映射到主题语义槽；
;   - dv-edit-split / dv-edit-join：文本 <-> 行数组（**保留末尾空行**）；
;   - dv-edit-insert / backspace / enter / move / key：光标与文本编辑，语义全在 dv 侧；
;   - dv-edit-follow：光标动了才重排窗口（滚轮推走的窗口不被拽回）；
;   - dv-code-editor：滚动容器 + 虚拟窗口 + 行渲染；
;   - dv-app：dva-edit-find / dva-edit-keyboard / DVA-EDIT-FOCUS，编辑器与输入类
;     焦点互斥；'q' 不再全局退出（否则打不出 q）。
;
; 场景钉住：
;   T 着色  ：token 切分 / 颜色 / 关键字表 / 引号配对 / 字节读取
;   E 行模型：split / join 往返，尤其末尾换行保不保留
;   K 编辑  ：喂键 -> 文本与光标（含退格并入上行、回车拆行、Tab、方向键、'q'）
;   W 窗口  ：dv-win-range 的三种 offset
;   F 跟随  ：光标动才重排；滚轮偏移不被覆盖
;   A 装配  ：dv-code-editor 的结构 / 命中上溯 / 焦点交接 / 喂字 / 重建
;
; 运行：../bin/no run -cc ./ccwrap.sh tests/dva-editor.no
; ============================================================================
# /noui/src/dv-app

print('=== dva-editor tests ===')

ED-TEXT = 4        ; 文本槽（DV-BIND-T[4]）
ED-OFF = 5         ; 滚动偏移状态槽（ST[5]）
ED-KEY = 900       ; 编辑器根（C-SCROLL）的 key
ED-KEY0 = 1000     ; 行 key 基数
ED-ROW = 2400      ; 行高 24px
ED-VIEWH = 14400   ; 视口高 144px（4 行 + 3 间隙 + 2 内边距）
ED-GUTTER = 5600   ; 行号槽宽 56px
ED-STEP = 3200     ; 滚轮每格 32px

ST []i64 = with-len(8)

; 重置文本 + 光标（编辑原语只认这两个池）
ed-reset = (s str) () {
    dv-bind-t-ensure(8)
    dv-bound-set(ED-TEXT, s)
    dv-arr-set(DV-EDIT-L, ED-TEXT, 0)
    dv-arr-set(DV-EDIT-C, ED-TEXT, 0)
}

; 编辑器页：外层 form + 一个 dv-code-editor
mk-page = () (p i64) {
    dv-clear()
    t = dv-form(1, -1)
    e = dv-code-editor(ST, ED-KEY, ED-TEXT, ED-OFF, ED-STEP, ED-VIEWH, ED-ROW, ED-GUTTER, ED-KEY0, t)
    dv-size(e, 0, ED-VIEWH)
    p = t
}

; ============================================================================
; 场景 T：着色 —— dv-lex-line 的切分与颜色
; ============================================================================
r1 = dv-lex-line('') == 0
r2 = dv-lex-line(';abc') == 1
r3 = dv-arr-get-s(DV-RUN-T, 0) == ';abc'
r4 = dv-arr-get(DV-RUN-C, 0) == cs-theme(CS-TH-MUTED)
r5 = dv-lex-line('"hi"') == 1 && dv-arr-get-s(DV-RUN-T, 0) == '"hi"'
r6 = dv-arr-get(DV-RUN-C, 0) == cs-theme(CS-TH-OK)
r7 = dv-lex-line('42') == 1 && dv-arr-get-s(DV-RUN-T, 0) == '42'
r8 = dv-arr-get(DV-RUN-C, 0) == DV-C-NUM
r9 = dv-lex-line('let') == 1 && dv-arr-get(DV-RUN-C, 0) == cs-theme(CS-TH-ACCENT)
r10 = dv-lex-line('x') == 1 && dv-arr-get(DV-RUN-C, 0) == cs-theme(CS-TH-FG)
r11 = dv-lex-line('  ') == 1 && dv-arr-get-s(DV-RUN-T, 0) == '  '
r12 = dv-lex-line('let x') == 2 && dv-arr-get-s(DV-RUN-T, 1) == ' x'
r13 = dv-lex-line('42 43') == 3 && dv-arr-get-s(DV-RUN-T, 2) == '43'
r14 = dv-lex-line('a;b') == 2 && dv-arr-get-s(DV-RUN-T, 1) == ';b'
r15 = dv-lex-line('"a" "b"') == 3
r16 = dv-is-kw('let') == 1 && dv-is-kw('foo') == 0 && dv-is-kw('') == 0
r17 = dv-lex-quote('"ab"cd', 0, 34) == 4 && dv-lex-quote('"ab', 0, 34) == 3
r18 = dv-byte-at('A', 0) == 65 && dv-byte-at('A', 5) == 0

; ============================================================================
; 场景 E：行模型 —— split / join 往返（末尾空行必须保留）
; ============================================================================
r19 = dv-edit-split('a\nb') == 2
r20 = dv-edit-join() == 'a\nb'
r21 = dv-edit-split('a\nb\n') == 3
r22 = dv-edit-join() == 'a\nb\n'
r23 = dv-edit-split('') == 1 && dv-edit-join() == ''
r24 = dv-edit-split('x') == 1 && dv-edit-join() == 'x'

; ============================================================================
; 场景 K：编辑 —— dv-edit-key 的文本与光标语义
; ============================================================================
ed-reset('let x = 1')
dv-edit-key(ED-TEXT, ED-K-RIGHT)
r25 = dv-edit-col-of(ED-TEXT) == 1
dv-edit-key(ED-TEXT, 90)
r26 = dv-bound(ED-TEXT) == 'lZet x = 1' && dv-edit-col-of(ED-TEXT) == 2
dv-edit-key(ED-TEXT, 8)
r27 = dv-bound(ED-TEXT) == 'let x = 1' && dv-edit-col-of(ED-TEXT) == 1
dv-edit-key(ED-TEXT, 13)
r28 = dv-bound(ED-TEXT) == 'l\net x = 1' && dv-edit-line-of(ED-TEXT) == 1 && dv-edit-col-of(ED-TEXT) == 0
dv-edit-key(ED-TEXT, ED-K-UP)
r29 = dv-edit-line-of(ED-TEXT) == 0 && dv-edit-col-of(ED-TEXT) == 0
dv-edit-key(ED-TEXT, ED-K-DOWN)
r30 = dv-edit-line-of(ED-TEXT) == 1 && dv-edit-col-of(ED-TEXT) == 0
; Tab = 4 空格，插在行首
dv-edit-key(ED-TEXT, 9)
r31 = dv-bound(ED-TEXT) == 'l\n    et x = 1' && dv-edit-col-of(ED-TEXT) == 4
; 连按四次左移到行首，再按一次并入上行
dv-edit-key(ED-TEXT, ED-K-LEFT)
dv-edit-key(ED-TEXT, ED-K-LEFT)
dv-edit-key(ED-TEXT, ED-K-LEFT)
dv-edit-key(ED-TEXT, ED-K-LEFT)
r32 = dv-edit-line-of(ED-TEXT) == 1 && dv-edit-col-of(ED-TEXT) == 0
dv-edit-key(ED-TEXT, ED-K-LEFT)
r33 = dv-edit-line-of(ED-TEXT) == 0 && dv-edit-col-of(ED-TEXT) == 1
dv-edit-key(ED-TEXT, 8)
r34 = dv-bound(ED-TEXT) == '\n    et x = 1' && dv-edit-col-of(ED-TEXT) == 0
; 'q' 必须打得出来 —— 装配层不再把它当全局退出键
dv-edit-key(ED-TEXT, 113)
r35 = dv-bound(ED-TEXT) == 'q\n    et x = 1'
; 退格跨行并入上行：光标落到拼接处
ed-reset('ab\ncd')
dv-edit-key(ED-TEXT, ED-K-DOWN)
dv-edit-key(ED-TEXT, 8)
r36 = dv-bound(ED-TEXT) == 'abcd' && dv-edit-line-of(ED-TEXT) == 0 && dv-edit-col-of(ED-TEXT) == 2
; 行首退格到顶不再吞字符（先把光标移到行尾）
ed-reset('ab')
dv-edit-key(ED-TEXT, ED-K-RIGHT)
dv-edit-key(ED-TEXT, ED-K-RIGHT)
dv-edit-key(ED-TEXT, 8)
dv-edit-key(ED-TEXT, 8)
dv-edit-key(ED-TEXT, 8)
r37 = dv-bound(ED-TEXT) == '' && dv-edit-col-of(ED-TEXT) == 0

; ============================================================================
; 场景 W：窗口 —— dv-win-range
; ============================================================================
WR []i64 = with-len(2)
dv-win-range(0, ED-VIEWH, ED-ROW, 10, WR)
r38 = dv-arr-get(WR, 0) == 0 && dv-arr-get(WR, 1) == 5
dv-win-range(0, ED-VIEWH, ED-ROW, 0, WR)
r39 = dv-arr-get(WR, 0) == 0 && dv-arr-get(WR, 1) == 0
dv-win-range(100000, ED-VIEWH, ED-ROW, 10, WR)
r40 = dv-arr-get(WR, 0) == 9 && dv-arr-get(WR, 1) == 10

; ============================================================================
; 场景 F：跟随 —— 光标动才重排；滚轮偏移不被覆盖
; ============================================================================
ST[ED-OFF] = 0
dv-arr-set(DV-EDIT-L, ED-TEXT, 0)
dv-arr-set(DV-ED-SEEN, ED-TEXT, 0)
o1 = dv-edit-follow(ST, ED-TEXT, ED-OFF, 10, ED-VIEWH, ED-ROW)
r41 = o1 == 0 && ST[ED-OFF] == 0
dv-arr-set(DV-EDIT-L, ED-TEXT, 8)
o2 = dv-edit-follow(ST, ED-TEXT, ED-OFF, 10, ED-VIEWH, ED-ROW)
r42 = o2 == 15600 && ST[ED-OFF] == 15600
o3 = dv-edit-follow(ST, ED-TEXT, ED-OFF, 10, ED-VIEWH, ED-ROW)
r43 = o3 == 15600
ST[ED-OFF] = 0
o4 = dv-edit-follow(ST, ED-TEXT, ED-OFF, 10, ED-VIEWH, ED-ROW)
r44 = o4 == 0

; ============================================================================
; 场景 A：装配 —— 结构 / 命中上溯 / 焦点交接 / 喂字 / 重建
; ============================================================================
root-a = cmp-root()
ST[ED-OFF] = 0
ed-reset('let x = 1\nlet y = 2')
pa = mk-page()
dv-render(root-a, pa)
cs-layout(root-a, 0, 0, 40000, 40000)
de = dv-live-deep(root-a, ED-KEY)
r45 = de >= 0 && cmp-kind(de) == C-SCROLL
r46 = dv-edit-of(dv-node-by-key(ED-KEY)) == ED-TEXT
r47 = dv-scroll-content-of(de) == 8000
r48 = dv-scroll-start-of(de) == 0
r49 = dv-live-deep(root-a, 1001) >= 0
r50 = dv-live-deep(root-a, 10001001) >= 0
g0 = dv-live-deep(root-a, 1001)
r51 = cmp-text(g0) == '0'
; 命中上溯：命中编辑器内部任意节点 -> 编辑器 key；根 / -1 不是
dx, dy, dw, dh = cs-rect(de)
hit = cs-hit(root-a, cs-add(dx, 3000), cs-add(dy, 2400))
r52 = dva-edit-find(hit) == ED-KEY
r53 = dva-edit-find(de) == ED-KEY
r54 = dva-edit-find(root-a) == -1 && dva-edit-find(-1) == -1
; 焦点交接：点进去 -> 编辑器拿到键盘焦点
dva-focus(hit)
r55 = dv-arr-get(DVA-EDIT-FOCUS, 0) == ED-KEY
dva-edit-keyboard(122)
r56 = dv-bound(ED-TEXT) == 'zlet x = 1\nlet y = 2'
; 重建：编辑器根还在（光标换 token 会增删「前缀 / 后缀」子节点，所以这一帧
; 不要求 0 操作；再重建一次结构就必须稳定）
pa2 = mk-page()
dv-render(root-a, pa2)
cs-layout(root-a, 0, 0, 40000, 40000)
de2 = dv-live-deep(root-a, ED-KEY)
r57 = de2 >= 0 && cmp-kind(de2) == C-SCROLL
pa2b = mk-page()
r58 = dv-render(root-a, pa2b) == 0
; 重建后焦点仍在，继续喂字
dva-edit-keyboard(8)
r59 = dv-bound(ED-TEXT) == 'let x = 1\nlet y = 2'
; 点空白 -> 编辑器焦点释放
dva-focus(-1)
r60 = dv-arr-get(DVA-EDIT-FOCUS, 0) == -1
; 空文本也有光标（不崩）
ed-reset('')
pa3 = mk-page()
dv-render(root-a, pa3)
cs-layout(root-a, 0, 0, 40000, 40000)
r61 = dv-live-deep(root-a, ED-KEY) >= 0

; ============================================================================
; 汇总
; ============================================================================
ok = r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && r9 && r10 && r11 && r12 && r13 && r14 && r15 && r16 && r17 && r18 && r19 && r20 && r21 && r22 && r23 && r24 && r25 && r26 && r27 && r28 && r29 && r30 && r31 && r32 && r33 && r34 && r35 && r36 && r37 && r38 && r39 && r40 && r41 && r42 && r43 && r44 && r45 && r46 && r47 && r48 && r49 && r50 && r51 && r52 && r53 && r54 && r55 && r56 && r57 && r58 && r59 && r60 && r61

print('T lex={r1}{r2}{r3}{r4}{r5}{r6}{r7}{r8}{r9}{r10}{r11}{r12}{r13}{r14}{r15}{r16}{r17}{r18}')
print('E lines={r19}{r20}{r21}{r22}{r23}{r24}')
print('K edit={r25}{r26}{r27}{r28}{r29}{r30}{r31}{r32}{r33}{r34}{r35}{r36}{r37}')
print('W window={r38}{r39}{r40}')
print('F follow={r41}{r42}{r43}{r44}')
print('A assemble={r45}{r46}{r47}{r48}{r49}{r50}{r51}{r52}{r53}{r54}{r55}{r56}{r57}{r58}{r59}{r60}{r61}')
print('all-ok={ok}')
(ok) -> { print('ALL DVA-EDITOR TESTS PASSED') }
(!ok) -> { print('DVA-EDITOR FAILURES') }
