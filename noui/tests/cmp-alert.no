; ============================================================================
; noui 提示族测试（阶段 44）—— src/components.no + src/cmp-scene.no
;
; 缺口：组件目录给 C-MESSAGE 承诺「level」、C-ALERT 承诺「level, closable」、
; C-NOTIFICATION 承诺「level, timeout」，但命令式侧三者都只有一个构造函数 ——
; 连 level 都没有 API，渲染还落在通用 `rect + text` 兜底里。
; 阶段 44 补：
;   - 共用的 level 语义：LV-INFO/OK/WARN/ERR + lv-slot（level -> 主题槽）、
;     msg-level / msg-set-level（disabled 写无效）。
;   - alert：alert-closable / -set-closable / alert-close-w / alert-close-x /
;     alert-hit（-1 没命中 / 0 主体 / 1 关闭钮）。
;   - notification：ntf-timeout / ntf-remain / ntf-set-timeout / ntf-set-remain /
;     ntf-ratio（0..10000 定点百分数，remain 夹进 [0,total]，total<=0 -> 0）。
;   - 渲染层 cs-level-color / cs-level-glyph / cs-paint-message /
;     cs-paint-alert / cs-paint-notification，cs-measure 给三者各自 intrinsic。
;
; 槽位沿用既有约定：VALUE = level，VALUE2 = 总时长，VALUE3 = 剩余 / closable。
;
; 运行：cd noui && ../bin/no build -cc ./ccwrap.sh -o dist/cmp-alert tests/cmp-alert.no
;       ./dist/cmp-alert
; ============================================================================
# /noui/src/cmp-scene

cs-theme-init()

; Scene 里是否有某段文本
cs-has-text = (t str) (yes bool) {
    yes = false
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (yes) -> { ** }
        (cs-scene-t(i) == t) -> { yes = true }
        i = cs-inc(i)
    }
    yes = yes
}

; Scene 里给定文本 + 给定左上角的那条文字指令的颜色（找不到 -1）
cs-text-color-at = (t str, x i64, y i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-TEXT) && (cs-scene-t(i) == t) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

; 给定 rect 的填充色（找不到 -1）
cs-fill-color-at = (x i64, y i64, w i64, ht i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-FILL) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

; 给定 rect 的描边 / 轨道色（CS-RECT，找不到 -1）
cs-rect-color-at = (x i64, y i64, w i64, ht i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-RECT) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

; 给定 rect 的填充条数（断言「没画」用）
cs-fill-count = (x i64, y i64, w i64, ht i64) (n i64) {
    n = 0
    c = cs-scene-count()
    i = 0
    !! {
        (i >= c) -> { ** }
        ((cs-scene-kind(i) == CS-FILL) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht)) -> { n = cs-inc(n) }
        i = cs-inc(i)
    }
    n = n
}

; ============================================================================
; 1. level 语义：LV-* / lv-slot / msg-level
; ============================================================================
msg = cmp-message('hello')
t1 = cmp-kind(msg) == C-MESSAGE
t2 = msg-level(msg) == 0
msg-set-level(msg, LV-WARN)
t3 = msg-level(msg) == 2
msg-set-level(msg, 9)
t4 = msg-level(msg) == 9
; 未知 level 在渲染层按 info 画（不夹紧写入，颜色映射兜底）
t5 = lv-slot(LV-INFO) == 2 && lv-slot(LV-OK) == 7 && lv-slot(LV-WARN) == -1 && lv-slot(LV-ERR) == 8
t6 = cs-level-color(LV-INFO) == cs-theme(CS-TH-ACCENT)
t7 = cs-level-color(LV-OK) == cs-theme(CS-TH-OK)
t8 = cs-level-color(LV-WARN) == 0xf2c14eff
t9 = cs-level-color(LV-ERR) == cs-theme(CS-TH-DANGER)
t10 = cs-level-color(9) == cs-theme(CS-TH-ACCENT)
t11 = cs-level-glyph(LV-INFO) == 'i' && cs-level-glyph(LV-OK) == 'v' && cs-level-glyph(LV-WARN) == '!' && cs-level-glyph(LV-ERR) == 'x'
; disabled 写不动
cmp-flag-set(msg, F-DISABLED)
msg-set-level(msg, LV-ERR)
t12 = msg-level(msg) == 9
cmp-flag-clear(msg, F-DISABLED)

; ============================================================================
; 2. alert：closable / 关闭钮几何 / 命中
; ============================================================================
al = cmp-alert('hello')
t13 = cmp-kind(al) == C-ALERT
t14 = alert-closable(al) == 0
alert-set-closable(al, 1)
t15 = alert-closable(al) == 1
t16 = alert-close-w() == 2400
t17 = alert-close-x(1200, 11200) == 8800

ax = 1200
ay = 1200
aw = 11200
ah = 2400
t18 = alert-hit(al, 1300, 1300, ax, ay, aw, ah) == 0
t19 = alert-hit(al, 8800, 1300, ax, ay, aw, ah) == 1
t20 = alert-hit(al, 11199, 1300, ax, ay, aw, ah) == 1
t21 = alert-hit(al, 11200, 1300, ax, ay, aw, ah) == 0 && alert-hit(al, 12400, 1300, ax, ay, aw, ah) == -1
t22 = alert-hit(al, 1300, 3600, ax, ay, aw, ah) == -1
t23 = alert-hit(al, 1300, 1100, ax, ay, aw, ah) == -1
; 不可关闭 -> 整个矩形都是主体
alert-set-closable(al, 0)
t24 = alert-hit(al, 8800, 1300, ax, ay, aw, ah) == 0
; disabled 写不动
cmp-flag-set(al, F-DISABLED)
alert-set-closable(al, 1)
t25 = alert-closable(al) == 0
cmp-flag-clear(al, F-DISABLED)
alert-set-closable(al, 1)

; ============================================================================
; 3. notification：timeout / remain / ratio
; ============================================================================
nt = cmp-notification('hello')
t26 = cmp-kind(nt) == C-NOTIFICATION
t27 = ntf-timeout(nt) == 0 && ntf-remain(nt) == 0
t28 = ntf-ratio(nt) == 0
ntf-set-timeout(nt, 100)
t29 = ntf-timeout(nt) == 100 && ntf-remain(nt) == 100
t30 = ntf-ratio(nt) == 10000
ntf-set-remain(nt, 25)
t31 = ntf-remain(nt) == 25 && ntf-ratio(nt) == 2500
ntf-set-remain(nt, 0)
t32 = ntf-ratio(nt) == 0
ntf-set-remain(nt, 200)
t33 = ntf-ratio(nt) == 10000
ntf-set-remain(nt, -5)
t34 = ntf-ratio(nt) == 0
ntf-set-timeout(nt, 0)
t35 = ntf-ratio(nt) == 0
ntf-set-timeout(nt, -5)
t36 = ntf-ratio(nt) == 0
; disabled 写不动
ntf-set-timeout(nt, 100)
cmp-flag-set(nt, F-DISABLED)
ntf-set-remain(nt, 10)
t37 = ntf-remain(nt) == 100
ntf-set-timeout(nt, 7)
t38 = ntf-timeout(nt) == 100
cmp-flag-clear(nt, F-DISABLED)

; ============================================================================
; 4. 测算：宽 = 左色条 + 字形格 + 文本宽 + 内边距（+ 关闭钮），高 = 行高（+ 时间条）
; ============================================================================
m1w, m1h = cs-measure(msg)
t39 = m1w == 8000 && m1h == 2400
m2 = cmp-message('hi')
m2w, m2h = cs-measure(m2)
t40 = m2w == 6400 && m2h == 2400
a1w, a1h = cs-measure(al)
t41 = a1w == 11200 && a1h == 2400
a2 = cmp-alert('hi')
a2w, a2h = cs-measure(a2)
t42 = a2w == 6400 && a2h == 2400
alert-set-closable(a2, 1)
a2w, a2h = cs-measure(a2)
t43 = a2w == 8800 && a2h == 2400
n1w, n1h = cs-measure(nt)
t44 = n1w == 8000 && n1h == 3200
n2 = cmp-notification('hi')
n2w, n2h = cs-measure(n2)
t45 = n2w == 6400 && n2h == 3200

; ============================================================================
; 5. 渲染 message：左色条 + level 字形 + 文本一行
; ============================================================================
msg-set-level(msg, LV-OK)
root = cmp-root()
cmp-add-child(root, msg)
cs-clear()
cs-layout(root, 0, 0, 40000, 20000)
cs-paint(root)
mx, my, mw3, mh3 = cs-rect(msg)
lc = cs-level-color(LV-OK)
; 叶子在容器里会被拉到内容宽（40000 - 2*1200 = 37600），所以断言「至少固有宽」
t46 = mh3 == 2400 && mw3 >= 8000
t47 = cs-fill-color-at(mx, my, 400, mh3) == lc
t48 = cs-text-color-at('v', cs-add(mx, 1200), my) == lc
t49 = cs-text-color-at('hello', cs-add(mx, 2800), my) == cs-theme(CS-TH-FG)

; ============================================================================
; 6. 渲染 alert：message + 右端关闭钮（closable 时才画）
; ============================================================================
root2 = cmp-root()
cmp-add-child(root2, al)
cs-clear()
cs-layout(root2, 0, 0, 40000, 20000)
cs-paint(root2)
bx, by, bw3, bh3 = cs-rect(al)
lc2 = cs-level-color(msg-level(al))
t50 = bh3 == 2400 && bw3 >= 11200
t51 = cs-fill-color-at(bx, by, 400, bh3) == lc2
t52 = cs-text-color-at('i', cs-add(bx, 1200), by) == lc2
t53 = cs-text-color-at('hello', cs-add(bx, 2800), by) == cs-theme(CS-TH-FG)
t54 = cs-text-color-at('x', cs-add(cs-sub(cs-sub(cs-add(bx, bw3), 1200), 2400), 800), by) == cs-theme(CS-TH-MUTED)
; 不可关闭时没有 'x'
alert-set-closable(al, 0)
cs-clear()
cs-layout(root2, 0, 0, 40000, 20000)
cs-paint(root2)
t55 = cs-has-text('x') == false
alert-set-closable(al, 1)

; ============================================================================
; 7. 渲染 notification：文本一行 + 剩余时间条（条长 = ratio）
; ============================================================================
ntf-set-timeout(nt, 100)
ntf-set-remain(nt, 25)
root3 = cmp-root()
cmp-add-child(root3, nt)
cs-clear()
cs-layout(root3, 0, 0, 40000, 20000)
cs-paint(root3)
nx, ny, nw3, nh3 = cs-rect(nt)
lc3 = cs-level-color(msg-level(nt))
tw = cs-sub(nw3, 2800)
fw = cs-div(cs-mul(2500, tw), 10000)
t56 = nh3 == 3200 && nw3 >= 8000
t57 = cs-fill-color-at(nx, ny, 400, nh3) == lc3
t58 = cs-text-color-at('i', cs-add(nx, 1200), ny) == lc3
t59 = cs-text-color-at('hello', cs-add(nx, 2800), ny) == cs-theme(CS-TH-FG)
t60 = cs-rect-color-at(cs-add(nx, 2800), cs-add(ny, 2400), tw, 800) == cs-theme(CS-TH-TRACK)
t61 = cs-fill-color-at(cs-add(nx, 2800), cs-add(ny, 2400), fw, 800) == lc3
; remain = 0 -> 只剩轨道，没有进度条
ntf-set-remain(nt, 0)
cs-clear()
cs-layout(root3, 0, 0, 40000, 20000)
cs-paint(root3)
t62 = cs-fill-count(cs-add(nx, 2800), cs-add(ny, 2400), fw, 800) == 0

; ============================================================================
; 汇总
; ============================================================================
all-ok = t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13 && t14 && t15 && t16 && t17 && t18 && t19 && t20 && t21 && t22 && t23 && t24 && t25 && t26 && t27 && t28 && t29 && t30 && t31 && t32 && t33 && t34 && t35 && t36 && t37 && t38 && t39 && t40 && t41 && t42 && t43 && t44 && t45 && t46 && t47 && t48 && t49 && t50 && t51 && t52 && t53 && t54 && t55 && t56 && t57 && t58 && t59 && t60 && t61 && t62

print('level=...')
print(t1)
print(t2)
print(t3)
print(t4)
print(t5)
print(t6)
print(t7)
print(t8)
print(t9)
print(t10)
print(t11)
print(t12)
print('alert-api=...')
print(t13)
print(t14)
print(t15)
print(t16)
print(t17)
print('alert-hit=...')
print(t18)
print(t19)
print(t20)
print(t21)
print(t22)
print(t23)
print(t24)
print(t25)
print('ntf-api=...')
print(t26)
print(t27)
print(t28)
print(t29)
print(t30)
print(t31)
print(t32)
print(t33)
print(t34)
print(t35)
print(t36)
print(t37)
print(t38)
print('measure=...')
print(t39)
print(t40)
print(t41)
print(t42)
print(t43)
print(t44)
print(t45)
print('render-msg=...')
print(t46)
print(t47)
print(t48)
print(t49)
print('render-alert=...')
print(t50)
print(t51)
print(t52)
print(t53)
print(t54)
print(t55)
print('render-ntf=...')
print(t56)
print(t57)
print(t58)
print(t59)
print(t60)
print(t61)
print(t62)
print('---')
print(all-ok)
(all-ok) -> {
    print('ALL ALERT TESTS PASSED')
}
(!all-ok) -> {
    print('SOME TESTS FAILED')
    exit(1)
}
