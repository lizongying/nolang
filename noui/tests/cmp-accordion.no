; 阶段56：C-ACCORDION（手风琴）无窗口断言
; 纯逻辑：构造默认 / 组池（扁平只增 + 基址）/ 正文行 / 展开切换 / 多句柄隔离 /
;          disabled 空操作 / 测算 intrinsic / 渲染几何（FIELD 底、展开符 ACCENT、
;          组标题 FG、展开组正文 MUTED、组间 TRACK 分隔线）
; ============================================================================
# /noui/src/cmp-scene

; ============================================================================
; 辅助：场景遍历
; ============================================================================
cs-rect-color-at = (x i64, y i64, w i64, ht i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-RECT) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

cs-text-color-at = (t str, x i64, y i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-TEXT) && (cs-scene-t(i) == t) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

cs-text-count = () (n i64) {
    n = 0
    m = cs-scene-count()
    i = 0
    !! {
        (i >= m) -> { ** }
        (cs-scene-kind(i) == CS-TEXT) -> { n = cs-inc(n) }
        i = cs-inc(i)
    }
    n = n
}

cs-text-n = (t str) (n i64) {
    n = 0
    m = cs-scene-count()
    i = 0
    !! {
        (i >= m) -> { ** }
        ((cs-scene-kind(i) == CS-TEXT) && (cs-scene-t(i) == t)) -> { n = cs-inc(n) }
        i = cs-inc(i)
    }
    n = n
}

; ============================================================================
; 1. 构造默认
;    空组 / 越界读空串 / 未被 disabled
; ============================================================================
ac = cmp-accordion()

t1 = cmp-kind(ac) == C-ACCORDION
t2 = ac-count(ac) == 0
t3 = ac-title(ac, 0) == ''
t4 = ac-expanded(ac, 0) == 0
t5 = ac-body-count(ac, 0) == 0
t6 = ac-body-line(ac, 0, 0) == ''
t7 = ac-open-count(ac) == 0

; ============================================================================
; 2. 组池：追加（收起 / 展开）+ 正文行
;    sec0 'alpha' 收起无正文
;    sec1 'beta'  展开 + 1 行正文
;    sec2 'gamma' 收起 + 1 行正文（收起时不画）
; ============================================================================
ac-add(ac, 'alpha')
t8 = ac-count(ac) == 1
t9 = ac-title(ac, 0) == 'alpha'
t10 = ac-expanded(ac, 0) == 0
t11 = ac-body-count(ac, 0) == 0

ac-add-open(ac, 'beta')
t12 = ac-count(ac) == 2
t13 = ac-title(ac, 1) == 'beta'
t14 = ac-expanded(ac, 1) == 1

ac-add-body(ac, 1, 'beta line one')
t15 = ac-body-count(ac, 1) == 1
t16 = ac-body-line(ac, 1, 0) == 'beta line one'

ac-add(ac, 'gamma')
t17 = ac-count(ac) == 3
ac-add-body(ac, 2, 'gamma hidden')
t18 = ac-body-count(ac, 2) == 1
t19 = ac-body-line(ac, 2, 0) == 'gamma hidden'
t20 = ac-open-count(ac) == 1
t21 = ac-expanded(ac, 2) == 0

; 越界读：空串 / 0
t22 = ac-title(ac, 3) == ''
t23 = ac-body-count(ac, 3) == 0
t24 = ac-body-line(ac, 1, 1) == ''
t25 = ac-body-line(ac, 1, -1) == ''

; ============================================================================
; 3. 改写 / 展开切换
; ============================================================================
ac-set-title(ac, 0, 'alpha2')
t26 = ac-title(ac, 0) == 'alpha2'
ac-toggle(ac, 0)
t27 = ac-expanded(ac, 0) == 1
ac-toggle(ac, 0)
t28 = ac-expanded(ac, 0) == 0
ac-expand(ac, 2)
t29 = ac-expanded(ac, 2) == 1
ac-collapse(ac, 2)
t30 = ac-expanded(ac, 2) == 0
ac-set-expanded(ac, 1, 5)
t31 = ac-expanded(ac, 1) == 1
ac-set-expanded(ac, 1, 0)
t32 = ac-expanded(ac, 1) == 0
; 越界写不影响
ac-set-title(ac, 9, 'x')
t33 = ac-title(ac, 2) == 'gamma'
ac-add-body(ac, 9, 'x')
t34 = ac-body-count(ac, 2) == 1
t35 = ac-open-count(ac) == 0

; ============================================================================
; 4. 多句柄隔离（扁平池 + 每句柄基址）
; ============================================================================
a2 = cmp-accordion()
a3 = cmp-accordion()
ac-add(a2, 'one')
ac-add(a2, 'two')
ac-add-open(a3, 'three')
ac-add-body(a3, 0, 'body3')

t36 = ac-count(a2) == 2
t37 = ac-count(a3) == 1
t38 = ac-title(a2, 1) == 'two'
t39 = ac-expanded(a3, 0) == 1
t40 = ac-body-line(a3, 0, 0) == 'body3'

ac-clear(a2)
t41 = ac-count(a2) == 0
t42 = ac-count(a3) == 1
t43 = ac-title(a3, 0) == 'three'
ac-add(a2, 'again')
t44 = ac-count(a2) == 1
t45 = ac-title(a2, 0) == 'again'

; ============================================================================
; 5. disabled：写操作一律空操作
; ============================================================================
cmp-flag-set(a3, F-DISABLED)
ac-add(a3, 'no')
ac-add-body(a3, 0, 'no')
ac-set-title(a3, 0, 'no')
ac-toggle(a3, 0)
ac-clear(a3)
t46 = ac-count(a3) == 1
t47 = ac-title(a3, 0) == 'three'
t48 = ac-body-count(a3, 0) == 1
cmp-flag-clear(a3, F-DISABLED)
t49 = cmp-has(a3, F-DISABLED) == 0

; ============================================================================
; 6. 测算 intrinsic
;    宽 = 2*CS-PAD + 展开符宽 800 + 符后间隙 800 + 内容列
;        （内容列 = max(最长组标题, 展开组里最长正文行)，下限 CS-MIN-LEAF-W）
;    高 = 2*CS-PAD + Σ(组头 4000 + 展开组正文行数*2400) + (N-1)*100，
;        下限 CS-BTN-H
;    m：3 组，标题 5000/3200/5000，正文 'beta line one' 13 字 = 10400
;       → 宽 2400+800+800+10400 = 14400
;       → 高 2400 + (4000) + (4000+2400) + (4000) + 2*100 = 17000
; ============================================================================
m = cmp-accordion()
ac-add(m, 'alpha')
ac-add-open(m, 'beta')
ac-add-body(m, 1, 'beta line one')
ac-add(m, 'gamma')
ac-add-body(m, 2, 'gamma hidden')
m1w, m1h = cs-measure(m)
t50 = m1w == 14400
t51 = m1h == 17000

; 收起 sec1：正文不再计入宽高 → 宽 8000、高 14600
ac-collapse(m, 1)
m2w, m2h = cs-measure(m)
t52 = m2w == 8000
t53 = m2h == 14600

; 空：宽 4000 → 夹 6400；高 2400 → 夹 4000
e1 = cmp-accordion()
m3w, m3h = cs-measure(e1)
t54 = m3w == 6400
t55 = m3h == 4000

; 单组展开 + 2 行正文：内容列 max(800, 3200, 1600) = 3200 → 宽 7200；
; 高 2400 + 4000 + 4800 = 11200
e2 = cmp-accordion()
ac-add-open(e2, 'x')
ac-add-body(e2, 0, 'aaaa')
ac-add-body(e2, 0, 'bb')
m4w, m4h = cs-measure(e2)
t56 = m4w == 7200
t57 = m4h == 11200

; 固定尺寸覆盖仍然生效
cmp-set-sw(m, 20000)
cmp-set-sh(m, 9000)
m5w, m5h = cs-measure(m)
t58 = m5w == 20000
t59 = m5h == 9000
cmp-set-sw(m, 0)
cmp-set-sh(m, 0)

; ============================================================================
; 7. 渲染
;     外层 16800 → 内容宽 14400（正好等于 intrinsic）
;     面板 (1200,1200,14400,17000) FIELD
;     组头高 4000、文字垂直居中（ty = 组头顶 + 800）
;     sec0 顶 2400：'>' (2400,3200) ACCENT、'alpha' (4000,3200) FG
;     分隔线 (1200,6400,14400,100)
;     sec1 顶 6500：'-' (2400,7300)、'beta' (4000,7300)；
;       正文顶 10500 → 'beta line one' (4000,10500) MUTED
;     分隔线 (1200,12900,14400,100)
;     sec2 顶 13000：'>' (2400,13800)、'gamma' (4000,13800)
; ============================================================================
cs-clear()
r = cmp-accordion()
ac-add(r, 'alpha')
ac-add-open(r, 'beta')
ac-add-body(r, 1, 'beta line one')
ac-add(r, 'gamma')
ac-add-body(r, 2, 'gamma hidden')
r1 = cmp-root()
cmp-add-child(r1, r)
cs-layout(r1, 0, 0, 16800, 20000)
cs-paint(r1)

t60 = cs-rect-color-at(1200, 1200, 14400, 17000) == cs-theme(CS-TH-FIELD)
t61 = cs-text-color-at('>', 2400, 3200) == cs-theme(CS-TH-ACCENT)
t62 = cs-text-color-at('alpha', 4000, 3200) == cs-theme(CS-TH-FG)
t63 = cs-rect-color-at(1200, 6400, 14400, 100) == cs-theme(CS-TH-TRACK)
t64 = cs-text-color-at('-', 2400, 7300) == cs-theme(CS-TH-ACCENT)
t65 = cs-text-color-at('beta', 4000, 7300) == cs-theme(CS-TH-FG)
t66 = cs-text-color-at('beta line one', 4000, 10500) == cs-theme(CS-TH-MUTED)
t67 = cs-rect-color-at(1200, 12900, 14400, 100) == cs-theme(CS-TH-TRACK)
t68 = cs-text-color-at('>', 2400, 13800) == cs-theme(CS-TH-ACCENT)
t69 = cs-text-color-at('gamma', 4000, 13800) == cs-theme(CS-TH-FG)
t70 = cs-text-n('gamma hidden') == 0
t71 = cs-text-n('beta line one') == 1
t72 = cs-text-count() == 7

; 空组：只有底色，没有任何文本
cs-clear()
e3 = cmp-accordion()
r2 = cmp-root()
cmp-add-child(r2, e3)
cs-layout(r2, 0, 0, 20800, 40000)
cs-paint(r2)
t73 = cs-text-count() == 0
t74 = cs-rect-color-at(1200, 1200, 18400, 4000) == cs-theme(CS-TH-FIELD)

; ============================================================================
; 8. 汇总
; ============================================================================
ok = 1
ok = ok & t1 & t2 & t3 & t4 & t5 & t6 & t7
ok = ok & t8 & t9 & t10 & t11 & t12 & t13 & t14 & t15 & t16 & t17 & t18 & t19 & t20
ok = ok & t21 & t22 & t23 & t24 & t25 & t26 & t27 & t28 & t29 & t30
ok = ok & t31 & t32 & t33 & t34 & t35 & t36 & t37 & t38 & t39 & t40
ok = ok & t41 & t42 & t43 & t44 & t45 & t46 & t47 & t48 & t49
ok = ok & t50 & t51 & t52 & t53 & t54 & t55 & t56 & t57 & t58 & t59
ok = ok & t60 & t61 & t62 & t63 & t64 & t65 & t66 & t67 & t68 & t69 & t70 & t71 & t72 & t73 & t74

(ok == 1) -> {
    print('ALL ACCORDION TESTS PASSED')
}
(ok == 0) -> {
    print('SOME ACCORDION TESTS FAILED')
    exit(1)
}
