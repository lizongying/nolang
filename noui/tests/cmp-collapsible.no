; 阶段58：C-COLLAPSIBLE（折叠面板）无窗口断言
; 纯逻辑：构造默认 / 标题 + 展开态 / 正文行池（扁平只增 + 基址）/ 多句柄隔离 /
;          disabled 空操作 / 测算 intrinsic（收起只看头部，展开加正文行）/
;          渲染几何（FIELD 底、头部展开符 + 标题、TRACK 分隔线、正文行）
; ============================================================================
# /noui/src/cmp-scene

; ============================================================================
; 辅助：场景遍历
; ============================================================================
cs-rect-color-at = (x i64, y i64, w i64, ht i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-RECT) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

cs-text-color-at = (t str, x i64, y i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-TEXT) && (cs-scene-t(i) == t) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

cs-text-count = () (n i64) {
    n = 0
    m = cs-scene-count()
    i = 0
    !! {
        (i >= m) -> { ** }
        (cs-scene-kind(i) == CS-TEXT) -> { n = cs-inc(n) }
        i = cs-inc(i)
    }
    n = n
}

cs-text-n = (t str) (n i64) {
    n = 0
    m = cs-scene-count()
    i = 0
    !! {
        (i >= m) -> { ** }
        ((cs-scene-kind(i) == CS-TEXT) && (cs-scene-t(i) == t)) -> { n = cs-inc(n) }
        i = cs-inc(i)
    }
    n = n
}

; ============================================================================
; 1. 构造默认
;    标题 'settings' / 收起 / 无正文 / 未被 disabled
; ============================================================================
cl = cmp-collapsible('settings')

t1 = cmp-kind(cl) == C-COLLAPSIBLE
t2 = cl-title(cl) == 'settings'
t3 = cl-open(cl) == 0
t4 = cl-count(cl) == 0
t5 = cl-body-line(cl, 0) == ''
t6 = cmp-has(cl, F-DISABLED) == 0

; ============================================================================
; 2. 标题 + 展开态
; ============================================================================
cl-set-title(cl, 'profile')
t7 = cl-title(cl) == 'profile'
cl-set-title(cl, 'settings')
t8 = cl-title(cl) == 'settings'

cl-expand(cl)
t9 = cl-open(cl) == 1
cl-collapse(cl)
t10 = cl-open(cl) == 0
cl-toggle(cl)
t11 = cl-open(cl) == 1
cl-toggle(cl)
t12 = cl-open(cl) == 0
cl-set-open(cl, 5)
t13 = cl-open(cl) == 1
cl-set-open(cl, 0)
t14 = cl-open(cl) == 0

; ============================================================================
; 3. 正文行池
;    l0 'line one' / l1 'line two' / l2 'longer line here'
; ============================================================================
i0 = cl-add-body(cl, 'line one')
t15 = i0 == 0
i1 = cl-add-body(cl, 'line two')
t16 = i1 == 1
i2 = cl-add-body(cl, 'longer line here')
t17 = i2 == 2
t18 = cl-count(cl) == 3
t19 = cl-body-line(cl, 0) == 'line one'
t20 = cl-body-line(cl, 2) == 'longer line here'
t21 = cl-body-line(cl, 3) == ''
t22 = cl-body-line(cl, -1) == ''

cl-set-body-line(cl, 1, 'LINE TWO')
t23 = cl-body-line(cl, 1) == 'LINE TWO'
cl-set-body-line(cl, 9, 'x')
t24 = cl-body-line(cl, 2) == 'longer line here'

; ============================================================================
; 4. 多句柄隔离（扁平池 + 每句柄基址）
; ============================================================================
c2 = cmp-collapsible('a')
c3 = cmp-collapsible('bb')
cl-add-body(c2, 'x')
cl-add-body(c3, 'yy')
cl-add-body(c3, 'zzz')
t25 = cl-count(c2) == 1
t26 = cl-count(c3) == 2
t27 = cl-body-line(c3, 1) == 'zzz'

cl-clear(c3)
t28 = cl-count(c3) == 0
t29 = cl-count(c2) == 1
t30 = cl-body-line(c2, 0) == 'x'
cl-add-body(c3, 'again')
t31 = cl-count(c3) == 1
t32 = cl-body-line(c3, 0) == 'again'

; ============================================================================
; 5. disabled：写操作一律空操作
; ============================================================================
cmp-flag-set(c3, F-DISABLED)
r1 = cl-add-body(c3, 'no')
cl-set-body-line(c3, 0, 'no')
cl-set-title(c3, 'no')
cl-set-open(c3, 1)
cl-clear(c3)
t33 = r1 == -1
t34 = cl-count(c3) == 1
t35 = cl-body-line(c3, 0) == 'again'
t36 = cl-title(c3) == 'bb'
t37 = cl-open(c3) == 0
cmp-flag-clear(c3, F-DISABLED)
t38 = cmp-has(c3, F-DISABLED) == 0

; ============================================================================
; 6. 测算 intrinsic
;    头部内容 = 展开符 800 + 间隙 800 + 标题 6400（'settings' 8 字）= 8000
;    收起：宽 2*1200 + 8000 = 10400，高 2*1200 + 4000 = 6400
;    展开 3 行：最长正文 12800（16 字）> 8000 → 宽 2400+12800 = 15200；
;              高 2400 + 4000 + 3*2400 = 13600
; ============================================================================
m = cmp-collapsible('settings')
cl-add-body(m, 'line one')
cl-add-body(m, 'line two')
cl-add-body(m, 'longer line here')
cl-collapse(m)
m1w, m1h = cs-measure(m)
t39 = m1w == 10400
t40 = m1h == 6400

cl-expand(m)
m2w, m2h = cs-measure(m)
t41 = m2w == 15200
t42 = m2h == 13600

; 空 + 展开：没有正文行，高仍是头部
e1 = cmp-collapsible('settings')
cl-expand(e1)
m3w, m3h = cs-measure(e1)
t43 = m3w == 10400
t44 = m3h == 6400

; 展开 1 行 'x'（800 < 8000）：宽不变，高 2400+4000+2400 = 8800
e2 = cmp-collapsible('settings')
cl-add-body(e2, 'x')
cl-expand(e2)
m4w, m4h = cs-measure(e2)
t45 = m4w == 10400
t46 = m4h == 8800

; 长标题 'very long title'（15 字 = 12000）：头部内容 800+800+12000 = 13600
; 收起宽 2400+13600 = 16000，高 6400
e3 = cmp-collapsible('very long title')
m5w, m5h = cs-measure(e3)
t47 = m5w == 16000
t48 = m5h == 6400

; 固定尺寸覆盖仍然生效
cmp-set-sw(m, 20000)
cmp-set-sh(m, 9000)
m6w, m6h = cs-measure(m)
t49 = m6w == 20000
t50 = m6h == 9000
cmp-set-sw(m, 0)
cmp-set-sh(m, 0)

; ============================================================================
; 7. 渲染
;     外层 17600 → 内容宽 15200（正好等于 intrinsic）
;     面板 (1200,1200,15200,13600) FIELD
;     头部顶 2400、高 4000，文字垂直居中（ty = 2400+800 = 3200）
;     展开符 'v' (2400,3200) ACCENT、标题 'settings' (4000,3200) FG
;     分隔线 (1200,6400,15200,100) TRACK
;     正文行顶 6500，逐行 +2400：(4000,6500) / (4000,8900) / (4000,11300)
; ============================================================================
cs-clear()
r = cmp-collapsible('settings')
cl-add-body(r, 'line one')
cl-add-body(r, 'line two')
cl-add-body(r, 'longer line here')
cl-expand(r)
r1 = cmp-root()
cmp-add-child(r1, r)
cs-layout(r1, 0, 0, 17600, 20000)
cs-paint(r1)

t51 = cs-rect-color-at(1200, 1200, 15200, 13600) == cs-theme(CS-TH-FIELD)
t52 = cs-text-color-at('v', 2400, 3200) == cs-theme(CS-TH-ACCENT)
t53 = cs-text-color-at('settings', 4000, 3200) == cs-theme(CS-TH-FG)
t54 = cs-rect-color-at(1200, 6400, 15200, 100) == cs-theme(CS-TH-TRACK)
t55 = cs-text-color-at('line one', 4000, 6500) == cs-theme(CS-TH-MUTED)
t56 = cs-text-color-at('line two', 4000, 8900) == cs-theme(CS-TH-MUTED)
t57 = cs-text-color-at('longer line here', 4000, 11300) == cs-theme(CS-TH-MUTED)
t58 = cs-text-n('line one') == 1
t59 = cs-text-count() == 5

; 收起：只剩 FIELD + '>' + 标题，没有分隔线 / 正文
cl-collapse(r)
cs-clear()
cs-layout(r1, 0, 0, 17600, 20000)
cs-paint(r1)
t60 = cs-rect-color-at(1200, 1200, 15200, 6400) == cs-theme(CS-TH-FIELD)
t61 = cs-text-color-at('>', 2400, 3200) == cs-theme(CS-TH-ACCENT)
t62 = cs-text-color-at('settings', 4000, 3200) == cs-theme(CS-TH-FG)
t63 = cs-rect-color-at(1200, 6400, 15200, 100) == -1
t64 = cs-text-n('line one') == 0
t65 = cs-text-count() == 2

; ============================================================================
; 8. 汇总
; ============================================================================
ok = 1
ok = ok & t1 & t2 & t3 & t4 & t5 & t6
ok = ok & t7 & t8 & t9 & t10 & t11 & t12 & t13 & t14
ok = ok & t15 & t16 & t17 & t18 & t19 & t20 & t21 & t22 & t23 & t24
ok = ok & t25 & t26 & t27 & t28 & t29 & t30 & t31 & t32
ok = ok & t33 & t34 & t35 & t36 & t37 & t38
ok = ok & t39 & t40 & t41 & t42 & t43 & t44 & t45 & t46 & t47 & t48 & t49 & t50
ok = ok & t51 & t52 & t53 & t54 & t55 & t56 & t57 & t58 & t59
ok = ok & t60 & t61 & t62 & t63 & t64 & t65

(ok == 1) -> {
    print('ALL COLLAPSIBLE TESTS PASSED')
}
(ok == 0) -> {
    print('SOME COLLAPSIBLE TESTS FAILED')
    exit(1)
}
