; ============================================================================
; noui 组件渲染层测试（阶段 8）—— cmp-scene.no 纯逻辑验证
; 布局 / Scene 发射 / 命中测试 / 尺寸测算，无窗口依赖，no run 直接跑。
; ============================================================================
# /noui/src/cmp-scene

print('=== cmp-scene tests ===')

; ---- 构造组件树 ----
root = cmp-root()
title = cmp-label('noui cmp-scene')
btn = cmp-button('OK')
prog = cmp-progress()
cmp-set-value(prog, 30)
cmp-set-value2(prog, 100)
sld = cmp-slider(0, 100)
cmp-set-value(sld, 50)
chk = cmp-checkbox('on')
cmp-flag-set(chk, F-CHECKED)
sw = cmp-switch()
cmp-flag-set(sw, F-CHECKED)
inp = cmp-input('name')
sep = cmp-separator()

cmp-add-child(root, title)
cmp-add-child(root, btn)
cmp-add-child(root, prog)
cmp-add-child(root, sld)
cmp-add-child(root, chk)
cmp-add-child(root, sw)
cmp-add-child(root, inp)
cmp-add-child(root, sep)

; ---- 布局 ----
cs-layout(root, 0, 0, 80000, 60000)

; 容器内第一个子元素：x=PAD, y=PAD, w=根宽-2*PAD, h=行高
tx, ty, tw, th = cs-rect(title)
r1 = tx == CS-PAD && ty == CS-PAD && tw == 77600 && th == 2400

; 按钮：y 在 label 之下（+gap），容器内拉伸到内容宽，高 = CS-BTN-H
bx, by, bw, bh = cs-rect(btn)
r2 = bx == CS-PAD && by == 4400 && bw == 77600 && bh == CS-BTN-H

; 进度条：y=9200，高 800；滑杆 y=10800 高 2400
px, py, pw, ph = cs-rect(prog)
sx, sy, swd, sh = cs-rect(sld)
r3 = py == 9200 && ph == CS-PROGRESS-H && sy == 10800 && sh == 2400

; checkbox / switch / input / separator 依次排布
cx, cy, cw, ch = cs-rect(chk)
kx, ky, kw, kh = cs-rect(sw)
ix, iy, iw, ih = cs-rect(inp)
ex, ey, ew, eh = cs-rect(sep)
r4 = cy == 14000 && ch == 2400
r5 = ky == 17200 && kh == CS-BTN-H
r6 = iy == 22000 && ih == CS-BTN-H
r7 = ey == 26800 && eh == CS-SEP-H

; ---- 尺寸测算 ----
mw, mh = cs-measure(title)
r8 = mw == 13600 && mh == 2400
bw2, bh2 = cs-measure(btn)
r9 = bw2 == CS-BTN-W && bh2 == CS-BTN-H
rw, rh = cs-measure(root)
r10 = rw == 16000 && rh == 28100

; ---- C-GRID 横向测算 ----
grid = cmp-grid(2, 1)
g1 = cmp-label('aa')
g2 = cmp-label('aa')
cmp-add-child(grid, g1)
cmp-add-child(grid, g2)
gw, gh = cs-measure(grid)
r11 = gw == 16000 && gh == 4800

; ---- Scene 发射 ----
cs-clear()
cs-paint(root)
n = cs-scene-count()
r12 = n == 17
k0 = cs-scene-kind(0)
c0 = cs-scene-c(0)
r13 = k0 == CS-RECT && c0 == 0x1E1E28FF
k1 = cs-scene-kind(1)
t1 = cs-scene-t(1)
r14 = k1 == CS-TEXT && t1 == 'noui cmp-scene'

; 按钮 hover 变色：置 hover 后重绘，按钮 rect 用 CS-HOVER
cmp-flag-set(btn, F-HOVERED)
cs-clear()
cs-paint(root)
k2 = cs-scene-kind(2)
c2 = cs-scene-c(2)
r15 = k2 == CS-RECT && c2 == CS-HOVER

; ---- 命中测试 ----
h1 = cs-hit(root, 40000, 5000)
h2 = cs-hit(root, 40000, 15000)
h3 = cs-hit(root, 1000, 1000)
h4 = cs-hit(root, 90000, 50000)
r16 = h1 == btn
r17 = h2 == chk
r18 = h3 == root
r19 = h4 == -1

; ============================================================================
; 复合组件：select 下拉 / tab 条 / dialog / tooltip / input 焦点
; ============================================================================

; ---- select：收起时选项不参与布局，展开时排在字段下方 ----
sel = cmp-select('pick')
select-add-option(sel, 'alpha')
select-add-option(sel, 'beta')
select-add-option(sel, 'gamma')
o0 = select-option(sel, 0)
o1 = select-option(sel, 1)
o2 = select-option(sel, 2)
smw, smh = cs-measure(sel)
r20 = smw == 8800 && smh == CS-BTN-H

cs-layout(sel, 1000, 1000, 20000, 4000)
q0x, q0y, _, _ = cs-rect(o0)
r21 = q0x == 0 && q0y == 0

select-open(sel)
cs-layout(sel, 1000, 1000, 20000, 4000)
a0x, a0y, a0w, a0h = cs-rect(o0)
_, a1y, _, _ = cs-rect(o1)
_, a2y, _, _ = cs-rect(o2)
r22 = a0x == 1000 && a0y == 5800 && a0w == 20000 && a0h == 2400
r23 = a1y == 9000 && a2y == 12200

; 展开后选项可命中
ho = cs-hit(sel, 5000, 6000)
r24 = ho == o0

; 收起后选项不可命中，字段本身可命中
select-close(sel)
cs-layout(sel, 1000, 1000, 20000, 4000)
hc = cs-hit(sel, 5000, 2000)
r25 = hc == sel

; 展开绘制：字段 3 条 + 每选项 2 条
select-open(sel)
cs-layout(sel, 1000, 1000, 20000, 4000)
cs-clear()
cs-paint(sel)
r26 = cs-scene-count() == 9
; 选中项高亮：先选第 2 项（choose 会收起，再展开看高亮）
select-choose(sel, 1)
select-open(sel)
cs-clear()
cs-paint(sel)
r27 = cs-scene-c(5) == CS-HOVER

; ---- tab：标题横向排列 ----
tab = cmp-tab()
tab-add(tab, 'one')
tab-add(tab, 'two')
tb0 = select-option(tab, 0)
tb1 = select-option(tab, 1)
tmw, tmh = cs-measure(tab)
r28 = tmw == 12800 && tmh == 2400
cs-layout(tab, 0, 0, 12800, 2400)
b0x, b0y, b0w, _ = cs-rect(tb0)
b1x, _, _, _ = cs-rect(tb1)
r29 = b0x == 0 && b0y == 0 && b0w == 6400 && b1x == 6400
cs-clear()
cs-paint(tab)
r30 = cs-scene-count() == 5

; ---- dialog：关闭不画，开启画面板 + 标题 ----
dlg = cmp-dialog('Confirm')
cmp-add-child(dlg, cmp-label('really?'))
dmw, dmh = cs-measure(dlg)
r31 = dmw == 10400 && dmh == 7200
cs-clear()
cs-paint(dlg)
r32 = cs-scene-count() == 0
cs-layout(dlg, 0, 0, 10400, 7200)
dialog-open(dlg)
cs-clear()
cs-paint(dlg)
r33 = cs-scene-count() == 4

; ---- tooltip：仅可见时绘制 ----
tip = cmp-tooltip('hi')
tooltip-hide(tip)
cs-layout(tip, 0, 0, 4000, 2400)
cs-clear()
cs-paint(tip)
r34 = cs-scene-count() == 0
tooltip-show(tip)
cs-clear()
cs-paint(tip)
r35 = cs-scene-count() == 2

; ---- input 焦点：描边 + 光标 ----
inp2 = cmp-input('x')
cs-layout(inp2, 0, 0, 20000, 4000)
cs-clear()
cs-paint(inp2)
r36 = cs-scene-count() == 2
input-focus(inp2, true)
cs-clear()
cs-paint(inp2)
r37 = cs-scene-count() == 7

; ---- slider 命中反算取值 ----
cmp-set-value(sld, 50)
r38 = slider-value-at(sld, 5000, 0, 10000) == 50
r39 = slider-value-at(sld, 0, 0, 10000) == 0
r40 = slider-value-at(sld, 10000, 0, 10000) == 100

; ---- 汇总 ----
all-ok = r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && r9 && r10 && r11 && r12
all-ok = all-ok && r13 && r14 && r15 && r16 && r17 && r18 && r19
all-ok = all-ok && r20 && r21 && r22 && r23 && r24 && r25 && r26 && r27
all-ok = all-ok && r28 && r29 && r30 && r31 && r32 && r33 && r34 && r35
all-ok = all-ok && r36 && r37 && r38 && r39 && r40
print('layout={r1}{r2}{r3}{r4}{r5}{r6}{r7}')
print('measure={r8}{r9}{r10} grid={r11}')
print('scene={r12}{r13}{r14} hover={r15}')
print('hit={r16}{r17}{r18}{r19}')
print('select={r20}{r21}{r22}{r23}{r24}{r25}{r26}{r27}')
print('tab={r28}{r29}{r30} dialog={r31}{r32}{r33}')
print('tooltip={r34}{r35} input={r36}{r37} slider={r38}{r39}{r40}')
print('scene-count={n} all-ok={all-ok}')
(all-ok) -> { print('ALL CMP-SCENE TESTS PASSED') }
(!all-ok) -> { print('SOME CMP-SCENE TESTS FAILED') }
