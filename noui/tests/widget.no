; ============================================================================
; noui L4 widget 库 + 主题 —— Tailwind 风格样式 API
; 自包含：内嵌最小 Element 池 + widget 构造层。大写全局池 + 函数封装。
; 纯 Nolang 逻辑，no run 验证。
; ============================================================================

; ---------- 主题（Tailwind 风格调色板 + 尺寸） ----------
C-BG = 0x1E1E28FF
C-SURFACE = 0x2A2A3AFF
C-PRIMARY = 0x4A90E2FF
C-PRIMARY-HOVER = 0x6AA5F5FF
C-TEXT = 0xE8E8F0FF
C-MUTED = 0x9AA0B4FF
C-SUCCESS = 0x50C878FF
C-DANGER = 0xE2575AFF

SP-1 = 400      ; 4px（定点 *100）
SP-2 = 800
SP-3 = 1200
SP-4 = 1600
RADIUS-SM = 400
RADIUS-MD = 800

WIDGET-TEXT = 3
WIDGET-RECT = 2
WIDGET-ROW = 1
WIDGET-COL = 1

; ---------- 最小 Element 池（SoA，i64 句柄） ----------
EL-KIND []i64 = with-len(0)
EL-COLOR []i64 = with-len(0)
EL-PARENT []i64 = with-len(0)
EL-TEXT []str = with-len(0)
EL-GROW []i64 = with-len(0)
CHILD []i64 = with-len(0)
EL-COUNT []i64 = with-len(0)
EL-HEAD []i64 = with-len(0)

el-alloc = (kind i64, color i64, txt str, parent i64, grow i64) (h i64) {
    EL-KIND.push(kind)
    EL-COLOR.push(color)
    EL-PARENT.push(parent)
    EL-TEXT.push(txt)
    EL-GROW.push(grow)
    EL-COUNT.push(0)
    EL-HEAD.push(-1)
    h = EL-KIND.len() - 1
}

el-attach = (parent i64, child i64) {
    cnt = EL-COUNT[parent]
    (cnt == 0) -> {
        EL-HEAD[parent] = CHILD.len()
    }
    CHILD.push(child)
    nc = cnt + 1: {
        ok -> it
        err -> cnt
    }
    EL-COUNT[parent] = nc
}

; ---------- widget 构造器（Tailwind 风格：简洁参数 + 主题默认值） ----------
wd-text = (txt str, color i64) (h i64) {
    h = el-alloc(WIDGET-TEXT, color, txt, -1, 0)
}

wd-text-muted = (txt str) (h i64) {
    h = wd-text(txt, C-MUTED)
}

wd-button = (txt str, color i64) (h i64) {
    h = el-alloc(WIDGET-RECT, color, txt, -1, 1)
}

wd-button-primary = (txt str) (h i64) {
    h = wd-button(txt, C-PRIMARY)
}

wd-card = (color i64) (h i64) {
    h = el-alloc(WIDGET-RECT, color, '', -1, 1)
}

wd-row = (grow i64) (h i64) {
    h = el-alloc(WIDGET-ROW, 0, '', -1, grow)
}

wd-col = (grow i64) (h i64) {
    h = el-alloc(WIDGET-COL, 0, '', -1, grow)
}

; ---------- 主题应用：theme-tint 批量改一个 element 的颜色 ----------
; 用全局数组槽写入规避独立全局写回缺陷
TINT-CUR = 0
theme-tint = (h i64, color i64) {
    EL-COLOR[h] = color
}

; ---------- 测试 ----------
print('=== L4 widget/theme tests ===')

root = wd-col(1)
title = wd-text('Dashboard', C-TEXT)
el-attach(root, title)

card = wd-card(C-SURFACE)
el-attach(root, card)
label = wd-text-muted('stats')
el-attach(card, label)
btn = wd-button-primary('OK')
el-attach(card, btn)
theme-tint(btn, C-SUCCESS)

row = wd-row(0)
b1 = wd-button('-', C-DANGER)
b2 = wd-button('+', C-PRIMARY)
el-attach(row, b1)
el-attach(row, b2)
el-attach(root, row)

; 校验
kc = EL-KIND.len()
rcc = EL-COUNT[root]
ccc = EL-COUNT[card]
r0c = EL-COUNT[row]
h0 = EL-HEAD[root]
c0 = CHILD[h0]
btn-color = EL-COLOR[btn]
btn-txt = EL-TEXT[btn]
label-color = EL-COLOR[label]

r1 = kc == 8
r2 = rcc == 3 && ccc == 2 && r0c == 2
r3 = c0 == title
r4 = btn-color == C-SUCCESS
r5 = btn-txt == 'OK'
r6 = label-color == C-MUTED

all-ok = r1 && r2 && r3 && r4 && r5 && r6
print('elements={kc} root-children={rcc} card-children={ccc}')
print('theme: btn-color={r4} label-color={r6} tree={r2}{r3} txt={r5}')
print('all-ok={all-ok}')
(all-ok) -> { print('ALL WIDGET TESTS PASSED') }
(!all-ok) -> { print('SOME TESTS FAILED'); exit(1) }
