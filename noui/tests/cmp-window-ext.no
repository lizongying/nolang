; 阶段52：C-WINDOW-EXT（窗口选项）无窗口断言
; 纯逻辑：构造默认 / 写入与夹紧 / disabled 空操作 / 总开关 /
;         测算 intrinsic / 渲染几何（面板、标题、分隔线、8 行标签与右对齐数值）
; ============================================================================
# /noui/src/cmp-scene

; ============================================================================
; 辅助：场景遍历
; ============================================================================
cs-rect-color-at = (x i64, y i64, w i64, ht i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-RECT) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y) && (cs-scene-w(i) == w) && (cs-scene-h(i) == ht)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

cs-text-color-at = (t str, x i64, y i64) (c i64) {
    c = -1
    n = cs-scene-count()
    i = 0
    !! {
        (i >= n) -> { ** }
        (c >= 0) -> { ** }
        ((cs-scene-kind(i) == CS-TEXT) && (cs-scene-t(i) == t) && (cs-scene-x(i) == x) && (cs-scene-y(i) == y)) -> { c = cs-scene-c(i) }
        i = cs-inc(i)
    }
    c = c
}

; ============================================================================
; 1. 构造默认
;    默认 flags = 可缩放 | 有边框 = 9；总开关 = 1（接管）；不透明度 100
; ============================================================================
W = cmp-window-ext()

t1 = cmp-kind(W) == C-WINDOW-EXT
t2 = we-title(W) == ''
t3 = cmp-text(W) == ''
t4 = we-flags(W) == 9
t5 = we-resizable(W) == 1
t6 = we-fullscreen(W) == 0
t7 = we-always-on-top(W) == 0
t8 = we-bordered(W) == 1
t9 = we-opacity(W) == 100
t10 = we-min-x(W) == 0
t11 = we-min-y(W) == 0
t12 = we-max-x(W) == 0
t13 = we-max-y(W) == 0
t14 = we-w(W) == 0
t15 = we-h(W) == 0
t16 = we-on(W) == 1
t17 = cmp-has(W, F-DISABLED) == 0

; ============================================================================
; 2. 写入 + 夹紧
; ============================================================================
we-set-title(W, 'hello')
t18 = we-title(W) == 'hello'
t19 = cmp-text(W) == 'hello'

we-set-resizable(W, 0)
t20 = we-resizable(W) == 0
t21 = we-flags(W) == 8
we-set-resizable(W, 1)
t22 = we-resizable(W) == 1
t23 = we-flags(W) == 9

we-set-fullscreen(W, 1)
t24 = we-fullscreen(W) == 1
t25 = we-flags(W) == 11
we-set-always-on-top(W, 1)
t26 = we-always-on-top(W) == 1
t27 = we-flags(W) == 15
we-set-bordered(W, 0)
t28 = we-bordered(W) == 0
t29 = we-flags(W) == 7
we-set-bordered(W, 1)
we-set-always-on-top(W, 0)
we-set-fullscreen(W, 0)
t30 = we-flags(W) == 9

we-set-opacity(W, 250)
t31 = we-opacity(W) == 100
we-set-opacity(W, -5)
t32 = we-opacity(W) == 0
we-set-opacity(W, 40)
t33 = we-opacity(W) == 40

we-set-min-size(W, 100, 80)
t34 = we-min-x(W) == 100
t35 = we-min-y(W) == 80
we-set-min-size(W, -1, 5)
t36 = we-min-x(W) == 0
t37 = we-min-y(W) == 5

we-set-max-size(W, 2000, 1000)
t38 = we-max-x(W) == 2000
t39 = we-max-y(W) == 1000
we-set-max-size(W, -3, -4)
t40 = we-max-x(W) == 0
t41 = we-max-y(W) == 0

we-set-size(W, 640, 480)
t42 = we-w(W) == 640
t43 = we-h(W) == 480
we-set-size(W, -1, 10)
t44 = we-w(W) == 0
t45 = we-h(W) == 10

we-set-flags(W, 2)
t46 = we-flags(W) == 2
t47 = cmp-value(W) == 2
we-set-flags(W, 9)

we-set-on(W, 0)
t48 = we-on(W) == 0
we-set-on(W, 1)
t49 = we-on(W) == 1

; ============================================================================
; 3. disabled：写操作一律空操作
; ============================================================================
cmp-flag-set(W, F-DISABLED)
we-set-title(W, 'nope')
we-set-flags(W, 2)
we-set-opacity(W, 0)
we-set-min-size(W, 999, 999)
we-set-max-size(W, 888, 888)
we-set-size(W, 777, 777)
we-set-on(W, 0)
t50 = we-title(W) == 'hello'
t51 = we-flags(W) == 9
t52 = we-opacity(W) == 40
t53 = we-min-x(W) == 0
t54 = we-max-x(W) == 0
t55 = we-w(W) == 0
t56 = we-on(W) == 1
cmp-flag-clear(W, F-DISABLED)

; ============================================================================
; 4. 测算 intrinsic
;    宽 = 2*ch-pad() + 16000 = 2400 + 16000 = 18400
;    高 = 2*ch-pad() + ch-title-h() + 8*CS-LINE-H = 2400 + 2400 + 19200 = 24000
;    标题长短不影响宽（标题不是测算项）
; ============================================================================
mw, mh = cs-measure(W)
t57 = mw == 18400
t58 = mh == 24000

we-set-title(W, 'a much longer title than before')
mw2, mh2 = cs-measure(W)
t59 = mw2 == 18400
t60 = mh2 == 24000

E = cmp-window-ext()
mw3, mh3 = cs-measure(E)
t61 = mw3 == 18400
t62 = mh3 == 24000

; 固定尺寸覆盖仍然生效
cmp-set-sw(W, 30000)
cmp-set-sh(W, 10000)
mw4, mh4 = cs-measure(W)
t63 = mw4 == 30000
t64 = mh4 == 10000
cmp-set-sw(W, 0)
cmp-set-sh(W, 0)

; ============================================================================
; 5. 渲染
;     外层 20800 → 根内容宽 18400 = intrinsic，rect (1200,1200,18400,24000)
;     标题 (2400,2400)；分隔线 (1200,4800,18400,100)
;     行 i 的 y = 4800 + i*2400；标签列 x=2400 宽 12000（MUTED）
;     数值列右对齐：vx=16000 宽 2400 → tx = 18400 - 文本宽
; ============================================================================
cs-clear()
W2 = cmp-window-ext()
we-set-title(W2, 'win')
we-set-size(W2, 640, 480)
R1 = cmp-root()
cmp-add-child(R1, W2)
cs-layout(R1, 0, 0, 20800, 40000)
cs-paint(R1)

t65 = cs-rect-color-at(1200, 1200, 18400, 24000) == cs-theme(CS-TH-FIELD)
t66 = cs-text-color-at('win', 2400, 2400) == cs-theme(CS-TH-FG)
t67 = cs-rect-color-at(1200, 4800, 18400, 100) == cs-theme(CS-TH-TRACK)

t68 = cs-text-color-at('on', 2400, 4800) == cs-theme(CS-TH-MUTED)
t69 = cs-text-color-at('title', 2400, 7200) == cs-theme(CS-TH-MUTED)
t70 = cs-text-color-at('resizable', 2400, 9600) == cs-theme(CS-TH-MUTED)
t71 = cs-text-color-at('fullscreen', 2400, 12000) == cs-theme(CS-TH-MUTED)
t72 = cs-text-color-at('always on top', 2400, 14400) == cs-theme(CS-TH-MUTED)
t73 = cs-text-color-at('bordered', 2400, 16800) == cs-theme(CS-TH-MUTED)
t74 = cs-text-color-at('opacity', 2400, 19200) == cs-theme(CS-TH-MUTED)
t75 = cs-text-color-at('size', 2400, 21600) == cs-theme(CS-TH-MUTED)

; 数值列右对齐：'on' 2 字 → 16800；'win' 3 字 → 16000；'1'/'0' 1 字 → 17600；
; '100' 3 字 → 16000；'640x480' 6 字 → 13600
t76 = cs-text-color-at('on', 16800, 4800) == cs-theme(CS-TH-FG)
t77 = cs-text-color-at('win', 16000, 7200) == cs-theme(CS-TH-FG)
t78 = cs-text-color-at('1', 17600, 9600) == cs-theme(CS-TH-FG)
t79 = cs-text-color-at('0', 17600, 12000) == cs-theme(CS-TH-FG)
t80 = cs-text-color-at('0', 17600, 14400) == cs-theme(CS-TH-FG)
t81 = cs-text-color-at('1', 17600, 16800) == cs-theme(CS-TH-FG)
t82 = cs-text-color-at('100', 16000, 19200) == cs-theme(CS-TH-FG)
t83 = cs-text-color-at('640x480', 12800, 21600) == cs-theme(CS-TH-FG)

; 关总开关后 'on' 行显示 'off'（3 字 → 16000）
cs-clear()
we-set-on(W2, 0)
cs-paint(R1)
t84 = cs-text-color-at('off', 16000, 4800) == cs-theme(CS-TH-FG)
t85 = cs-text-color-at('on', 16800, 4800) == -1

; size = 0 x 0 → 'auto'
cs-clear()
we-set-on(W2, 1)
we-set-size(W2, 0, 0)
cs-paint(R1)
t86 = cs-text-color-at('auto', 15200, 21600) == cs-theme(CS-TH-FG)

; 聚焦描边（四边 ACCENT）
cs-clear()
cmp-flag-set(W2, F-FOCUSED)
cs-paint(R1)
t87 = cs-rect-color-at(1200, 1200, 18400, 100) == cs-theme(CS-TH-ACCENT)
t88 = cs-rect-color-at(1200, 25100, 18400, 100) == cs-theme(CS-TH-ACCENT)
t89 = cs-rect-color-at(1200, 1200, 100, 24000) == cs-theme(CS-TH-ACCENT)
t90 = cs-rect-color-at(19500, 1200, 100, 24000) == cs-theme(CS-TH-ACCENT)

; ============================================================================
; 6. 汇总
; ============================================================================
ok = 1
ok = ok & t1 & t2 & t3 & t4 & t5 & t6 & t7 & t8 & t9 & t10 & t11 & t12 & t13 & t14 & t15 & t16 & t17
ok = ok & t18 & t19 & t20 & t21 & t22 & t23 & t24 & t25 & t26 & t27 & t28 & t29 & t30
ok = ok & t31 & t32 & t33 & t34 & t35 & t36 & t37 & t38 & t39 & t40 & t41 & t42 & t43 & t44 & t45
ok = ok & t46 & t47 & t48 & t49 & t50 & t51 & t52 & t53 & t54 & t55 & t56
ok = ok & t57 & t58 & t59 & t60 & t61 & t62 & t63 & t64
ok = ok & t65 & t66 & t67 & t68 & t69 & t70 & t71 & t72 & t73 & t74 & t75
ok = ok & t76 & t77 & t78 & t79 & t80 & t81 & t82 & t83 & t84 & t85 & t86 & t87 & t88 & t89 & t90

(ok == 1) -> {
    print('ALL WINDOW-EXT TESTS PASSED')
}
(ok == 0) -> {
    print('SOME WINDOW-EXT TESTS FAILED')
    exit(1)
}
