; ============================================================================
; noui 拖放落点反馈测试（阶段 84）—— src/components.no + src/dv-app.no
;
; 钉住：
;   1) 放置区标记（F-DROP / cmp-drop-zone）可查可清；
;   2) DROP_BEGIN/POS/COMPLETE 在主循环里形成会话与落点，COMPLETE 走
;      dv-app-click(DV-A-DROP) 出口并归约状态池；
;   3) POS 没命中放置区就清空落点；没有会话时 COMPLETE 不派发。
;
; 事件靠 _noui-event-push 注入（dummy 驱动无真实拖放）。第 1 帧还没组件树，
; 所以每条序列先用一条无害的移动事件占位。
;
; 运行：../bin/no run -cc ./ccwrap.sh tests/dva-drop.no
; ============================================================================
# /noui/src/dv-app

; 观察回调出口：记录收到的 DV-A-DROP 次数与落点 key
DVA-TST []i64 = [0, 0]

dv-app-view = () (page i64) {
    p = dv-form(1, -1)
    z = dv-node(C-BUTTON, 8, 'drop here', '', 0, 0, 0, dv-on(), p)
    dv-lay(z, dv-lay-grow(), 0, 0)
    cmp-drop-zone(z, 1)
    dv-act(z, DV-A-TOGGLE, 4)
    page = p
}
dv-app-reduce = (S []i64, k i64) (nw i64) {
    nw = dv-apply(S, k)
}
dv-app-click = (S []i64, k i64, act i64, pay i64, nw i64) () {
    (act == DV-A-DROP) -> {
        DVA-TST[0] = dv-inc(DVA-TST[0])
        DVA-TST[1] = k
    }
}

B256 = 256
B32 = 4294967296
B56 = 72057594037927936
ONE = 1
ZERO = 0

print('=== dva-drop tests ===')

; ---- 1) 放置区标记（纯组件层）----
root = cmp-root()
n = cmp-button('zone')
cmp-add-child(root, n)
cmp-drop-zone(n, 1)
r1 = cmp-is-drop(n)
r2 = cmp-has(n, F-DROP)
cmp-drop-zone(n, 0)
r3 = !cmp-is-drop(n)

; ---- 2) 默认状态 ----
r4 = dva-drop-active() == ZERO
r5 = dva-drop-target() == -1
r6 = dva-drops() == ZERO && dva-drop-hits() == ZERO

; ---- 3) 端到端：BEGIN -> POS(命中) -> POS(命中) -> FILE -> COMPLETE ----
S []i64 = [0, 0, 0, 0, 0]
app-event-push(15 + 280 * B256 + 210 * B32)   ; finger motion（占位）
app-event-push(21)                            ; DROP_BEGIN
app-event-push(20 + 280 * B256 + 210 * B32)   ; DROP_POSITION 命中
app-event-push(20 + 280 * B256 + 210 * B32)   ; DROP_POSITION 再命中
app-event-push(19 + 280 * B256 + 210 * B32)   ; DROP_FILE（文本载荷在 shim 缓冲，这里为空串）
app-event-push(22)                            ; DROP_COMPLETE
dva-run(S, 'drop-e2e', 8)
r7 = DVA-TST[0] == ONE
r8 = DVA-TST[1] == 8
r9 = dva-drops() == ONE
r10 = S[4] == ONE
r11 = dva-drop-hits() >= ONE
r12 = dva-drop-active() == ZERO && dva-drop-target() == -1

; ---- 4) 没有会话时 COMPLETE 不派发 ----
S2 []i64 = [0, 0, 0, 0, 0]
c0 = dva-drops()
app-event-push(15 + 280 * B256 + 210 * B32)   ; 占位
app-event-push(22)                            ; 只有 COMPLETE，没有 BEGIN
dva-run(S2, 'drop-bare', 3)
r13 = dva-drops() == c0 && DVA-TST[0] == ONE

all-ok = r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && r9 && r10 && r11 &&
         r12 && r13
print('zone={r1}{r2}{r3} idle={r4}{r5}{r6} e2e={r7}{r8}{r9}{r10}{r11}{r12} bare={r13}')
print('all-ok={all-ok}')
(all-ok) -> { print('ALL DVA-DROP TESTS PASSED') }
(!all-ok) -> { print('DVA-DROP TESTS FAILED'); exit(1) }
