; 測試 [N]byte 傳給 []byte 參數
helper = (data []byte, n i64) (out i64) {
    out = 0
    i <- [0..n): {
        out = out + data[i]
    }
}

main = () {
    ; test 1: pass []byte
    s []byte = with-len(32)
    i <- [0..32): { s[i] = i + 1 }
    r1 = helper(s, 32)
    print('test1 []byte: ' - r1.to-str())

    ; test 2: pass [32]byte
    a [32]byte
    i <- [0..32): { a[i] = i + 1 }
    r2 = helper(a, 32)
    print('test2 [32]byte: ' - r2.to-str())

    print('done')
}
