; 測試: 用元素拷貝代替 [32]byte 重賦值
helper = () (out [32]byte) {
    i <- [0..32): {
        out[i] = i + 1
    }
}

caller = () {
    t-tmp [32]byte
    tmp-ret [32]byte
    tmp-ret = helper()      ; 這裡會 abort
    i <- [0..32): {
        t-tmp[i] = tmp-ret[i]
    }
    print('t-tmp[0]=' - t-tmp[0].to-str())
}

main = () {
    print('before')
    caller()
    print('after')
    print('done')
}
