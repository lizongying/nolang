; 測試 nil slice 寫入行為
main = () {
    print('test1: writing to nil slice')
    s []byte
    s[0] = 65
    print('test1: ok len=' - s.len.to-str())

    print('test2: writing to with-len slice')
    t []byte = with-len(10)
    t[0] = 66
    print('test2: ok len=' - t.len.to-str())

    print('done')
}
