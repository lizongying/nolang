; This is optional — if there's no ambiguity, explicit import is not needed
; # std/math

; 導入本地包（相對於 workspace 根目錄的路徑形式）
# /example/test2/src/utils.greet greet2

greet2('World')
print()

; f64 method form (sin/cos/tan 已改為 f64 方法，x.sin() 形式调用):
x = 1.0
b = x.sin()

; Both produce identical LLVM IR
print('a:', b)
print('b:', b)

; Constants pi and e are also available:
print('pi:', math.PI)
print('e:', math.E)

; f64 math methods work too:
rad = 3.141592653589793
c = rad.degrees()
print('degrees(pi):', c)
