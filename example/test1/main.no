; This is optional — if there's no ambiguity, explicit import is not needed
; # std/math

; 導入本地包（相對於 workspace 根目錄的路徑形式）
# /example/test2/utils.greet greet2

greet2('World')
print()

; Module.function style (works even without explicit # std/math):
b = math.sin(1.0)

; Both produce identical LLVM IR
print('a:', b)
print('b:', b)

; Constants pi and e are also available:
print('pi:', math.PI)
print('e:', math.E)

; Module functions like degrees/radians work too:
c = math.degrees(3.141592653589793)
print('degrees(pi):', c)
