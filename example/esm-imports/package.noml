#{name = 'package-manifest'}
{
  name: 'esm-imports'
  description: 'Third-party ESM (npm) imports with the Nolang JS backend'
  keywords: ['nolang', 'js', 'esm']
  author: 'lizongying'
  email: 'lizongying@msn.com'
  organization: 'nolang'
  repository: 'https://github.com/lizongying/nolang'
  homepage: 'https://lizongying.github.io/nolang'
  license: 'Apache-2.0'
  mirrors: [] #{type = '[]str'}
  dependencies: ['lodash:^4.17.21'] #{type = '[]str'}
  compiler: {
    version: 'v0.1.0'
    link-libs: [] #{type = '[]str'}
    anonymous-fn-type: false
    emit: 'js'
  }
  output: '/dist'
  ignore: [] #{type = '[]str'}
}
