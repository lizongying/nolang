; main.no — Browser-focused Nolang example
;
; Demonstrates the Nolang JS backend's browser capabilities:
;   1. #{js-browser} platform branch — browser-only code
;   2. DOM manipulation — create elements, set text, append to body
;   3. Canvas drawing — filled rectangles and a stroked path
;   4. Event handling — button click callback
;   5. localStorage — set and get items
;   6. New-style iteration — i <- arr: and i <- [0..n):
;   7. String concatenation — using the - operator
;   8. print() output — redirected to the #nolang-output div
;
; Build: no build --js --browser example/js-test/main.no
; Open:  dist/js-test.html

# js/dom
# js/canvas
# js/events
# js/storage

; === print() is redirected to #nolang-output in browser mode ===
print('=== Nolang Browser Demo ===')

; === DOM: create a heading and append to body ===
heading = dom.create-element('h2')
heading.set-text('Hello from Nolang!')
body = dom.body()
body.append-child(heading)

; === DOM: create a button with inline style ===
btn = dom.create-element('button')
btn.set-text('Click me')
btn.set-style('margin', '8px')
body.append-child(btn)

; === Events: button click handler (anonymous callback) ===
events.on-click(btn, () {
    print('button was clicked!')
})

; === Canvas: draw filled rectangles and a triangle path ===
canvasEl = dom.create-element('canvas')
canvasEl.set-attr('width', '240')
canvasEl.set-attr('height', '140')
body.append-child(canvasEl)

ctx = canvas.get-context-2d(canvasEl)
ctx.set-fill('red')
ctx.fill-rect(10, 10, 60, 60)
ctx.set-fill('blue')
ctx.fill-rect(80, 10, 60, 60)
ctx.set-fill('green')
ctx.fill-rect(150, 10, 60, 60)

; draw a filled and stroked triangle
ctx.set-fill('yellow')
ctx.set-stroke('orange')
ctx.begin-path()
ctx.move-to(120, 80)
ctx.line-to(80, 130)
ctx.line-to(160, 130)
ctx.line-to(120, 80)
ctx.fill()
ctx.stroke()

; === localStorage: save and load a value ===
storage.set-item('greeting', 'Hello from localStorage')
g = storage.get-item('greeting')
print('stored:', g)

; === New-style iteration over an array ===
nums = [10, 20, 30]
i <- nums: {
    print('elem:', i)
}

; === Range-for iteration ===
i <- [0..3): {
    print('range:', i)
}

; === String concatenation using the - operator ===
name = 'World'
greeting = 'Hello, ' - name - '!'
print(greeting)

; === Platform branch: kept only in browser mode ===

#{js-browser}
print('running in browser mode')

#{linux-amd64}
print('running on linux (filtered out in browser)')

print('=== done ===')
