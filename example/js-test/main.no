; main.no — JS backend demonstration
;
; This file demonstrates the Nolang JS backend features:
;   1. Type erasure — all type annotations stripped in JS output
;   2. # js/console-log import — JS compat layer
;   3. #{js} platform branch — preserved only when target is JS
;   4. #{linux-amd64} platform branch — filtered out when target is JS
;   5. Loops — range-for and iterator
;   6. Match expression — becomes if/elif/else in JS
;   7. Struct with method — becomes JS class
;   8. Out-parameters — named result parameters

# js/console-log

; === Type-erased variables (annotations stripped in JS) ===
x i64 = 5
name str = 'Alice'
pi f64 = 3.14
flag bool = true

print('=== type-erased variables ===')
print('x:', x)
print('name:', name)
print('pi:', pi)
print('flag:', flag)

; === Function with out-parameter ===
add = (a i64, b i64) (r i64) {
    r = a + b
}

print('=== function with out-param ===')
sum = add(3, 4)
print('add(3, 4):', sum)

; === Struct with method (becomes JS class) ===
Point {
    x i64
    y i64
}

Point.distance = () (r f64) {
    r = math.sqrt(self.x * self.x + self.y * self.y)
}

print('=== struct with method ===')
p = Point {
    x: 3
    y: 4
}
d = p.distance()
print('distance:', d)

; === Platform branches ===
print('=== platform branches ===')
#{js}
print('running on JS backend')
#{linux-amd64}
print('running on Linux x86_64')

; === Range-for loop ===
print('=== range-for loop ===')
i <- [0..3): {
    print('range:', i)
}

; === Iterator loop ===
print('=== iterator loop ===')
nums = [10, 20, 30]
for n in nums {
    print('elem:', n)
}

; === Match expression ===
print('=== match expression ===')
m = 2
m: {
    1 -> print('one')
    2 -> print('two')
    3 -> print('three')
    -> print('other')
}

; === String concatenation (uses - operator) ===
print('=== string concatenation ===')
greeting = 'Hello, ' - name - '!'
print(greeting)

; === Math module ===
print('=== math module ===')
print('sin(0):', math.sin(0.0))
print('pi:', math.PI)

; === JS compat layer ===
; The # js/console-log import provides console-log under the JS platform.
; Under the JS backend, print() already maps to console.log, so we use it
; here to demonstrate the compat layer's behavior without producing
; invalid JS identifiers (console-log has a hyphen, which is not a valid
; JS identifier — a known v1 limitation of the JS backend).
print('=== js compat layer ===')
print('from js compat layer')

print('done')
