# /example/nosql/src/test-support test-support
# /example/nosql/src/ast
# /example/nosql/src/parser

CTX = test-support.new()

select-program = parser.parse-sql('SELECT a, b + 2 * c AS x FROM main.t AS t WHERE a >= 10 AND b IS NOT NULL ORDER BY x DESC LIMIT 5 OFFSET 1;')
CTX.check(select-program.error-message == '', 'valid SELECT parses: ' - select-program.error-message)
CTX.check(select-program.statement-count() == 1, 'SELECT produces one statement')
select-id = select-program.statement(0)
CTX.check(select-program.kind-of(select-id) == sql-select, 'SELECT root kind')
projections = select-program.child(select-id, 1)
projection-node = select-program.node(projections)
CTX.check(projection-node.kind == sql-list, 'projections are a list')
CTX.check(projection-node.kids.len() == 2, 'two projection expressions')
first-projection = select-program.node(select-program.child(projections, 0))
CTX.check(first-projection.kind == sql-projection, 'projection wrapper is retained')
second-projection = select-program.node(select-program.child(projections, 1))
CTX.check(second-projection.text == 'x', 'explicit projection alias is retained')
second-expr = select-program.node(second-projection.a)
CTX.check(second-expr.kind == sql-binary && second-expr.text == '+', 'projection expression root')
times-expr = select-program.node(second-expr.b)
CTX.check(times-expr.kind == sql-binary && times-expr.text == '*', 'multiplication binds before addition')
from-list = select-program.child(select-id, 2)
from-node = select-program.node(select-program.child(from-list, 0))
CTX.check(from-node.kind == sql-from-table, 'FROM item is retained')
CTX.check(from-node.text == 'main.t', 'qualified table name is retained')
CTX.check(from-node.a >= 0, 'table alias node is retained')
where-id = select-program.child(select-id, 3)
where-node = select-program.node(where-id)
CTX.check(where-node.kind == sql-binary && where-node.text.to-upper() == 'AND', 'WHERE root is AND')
left-where = select-program.node(where-node.a)
CTX.check(left-where.text == '>=', 'comparison is retained')
right-where = select-program.node(where-node.b)
CTX.check(right-where.kind == sql-is, 'IS NOT NULL is a dedicated node')
CTX.check(right-where.flags == 1, 'IS NOT NULL negation flag is retained')
order-list = select-program.child(select-id, 6)
order-node = select-program.node(select-program.child(order-list, 0))
CTX.check(order-node.kind == sql-order-item, 'ORDER BY item is retained')
CTX.check(order-node.flags == 1, 'DESC flag is retained')
CTX.check(select-program.child(select-id, 7) >= 0, 'LIMIT expression is retained')
CTX.check(select-program.child(select-id, 8) >= 0, 'OFFSET expression is retained')

case-program = parser.parse-sql('SELECT CASE WHEN x BETWEEN 1 AND 3 THEN \'mid\' ELSE \'other\' END, x IN (1, 2), x IS NOT NULL FROM t;')
CTX.check(case-program.error-message == '', 'CASE, BETWEEN, and IN parse: ' - case-program.error-message)
case-root = case-program.statement(0)
case-projection-list = case-program.child(case-root, 1)
case-projections = case-program.node(case-projection-list)
case-item = case-program.node(case-program.child(case-projection-list, 0))
case-expr = case-program.node(case-item.a)
CTX.check(case-expr.kind == sql-case, 'CASE expression is retained')
case-when-id = case-expr.kids[0]: {
    ok -> it

    -> -1
}
case-when = case-program.node(case-when-id)
CTX.check(case-when.kind == sql-when, 'CASE WHEN arm is retained')
in-item = case-program.node(case-program.child(case-projection-list, 1))
in-expr = case-program.node(in-item.a)
CTX.check(in-expr.kind == sql-in, 'IN expression is retained')
in-list = case-program.node(in-expr.b)
CTX.check(in-list.kind == sql-list && in-list.kids.len() == 2, 'IN list retains both values')

ddl-program = parser.parse-sql('CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY, name TEXT NOT NULL, score REAL DEFAULT 0, payload BLOB, UNIQUE(name));')
CTX.check(ddl-program.error-message == '', 'CREATE TABLE parses: ' - ddl-program.error-message)
ddl-id = ddl-program.statement(0)
CTX.check(ddl-program.kind-of(ddl-id) == sql-create-table, 'CREATE TABLE root kind')
CTX.check(ddl-program.node(ddl-id).text == 'items', 'table name is retained')
ddl-list-id = ddl-program.node(ddl-id).a
ddl-list = ddl-program.node(ddl-list-id)
CTX.check(ddl-list.kids.len() == 5, 'column and table definitions are retained')
id-column = ddl-program.node(ddl-program.child(ddl-list-id, 0))
CTX.check(id-column.kind == sql-column-def, 'column definition kind')
CTX.check(id-column.text == 'id', 'column name is retained')
CTX.check(id-column.flags & 1 == 1, 'PRIMARY KEY flag is retained')
name-column = ddl-program.node(ddl-program.child(ddl-list-id, 1))
CTX.check(name-column.flags & 2 == 2, 'NOT NULL flag is retained')
score-column = ddl-program.node(ddl-program.child(ddl-list-id, 2))
CTX.check(score-column.a >= 0, 'DEFAULT expression is retained')
CTX.check(id-column.b >= 0, 'declared type node is retained')
CTX.check(ddl-program.node(id-column.b).kind == sql-literal-string, 'declared type has its own arena node')
CTX.check(ddl-program.node(id-column.b).text == 'INTEGER', 'declared type text is retained')
unique-constraint = ddl-program.node(ddl-program.child(ddl-list-id, 4))
CTX.check(unique-constraint.kind == sql-table-constraint, 'table constraint kind is retained')
CTX.check(unique-constraint.text == 'UNIQUE', 'UNIQUE constraint name is retained')
CTX.check(ddl-program.node(unique-constraint.a).kids.len() == 1, 'UNIQUE column list is retained')

star-program = parser.parse-sql('SELECT *, t.* FROM t')
CTX.check(star-program.error-message == '', 'star projections parse without a trailing semicolon: ' - star-program.error-message)
star-root = star-program.statement(0)
star-list = star-program.child(star-root, 1)
star-item = star-program.node(star-program.child(star-list, 0))
qualified-star = star-program.node(star-program.child(star-list, 1))
CTX.check(star-program.node(star-item.a).kind == sql-star, 'bare star has an expression node')
CTX.check(star-program.node(qualified-star.a).kind == sql-star, 'qualified star has an expression node')
CTX.check(star-program.node(qualified-star.a).text == 't', 'qualified star retains its table name')
CTX.check(star-program.node(star-root).offset == 0, 'OFFSET clause does not overwrite SELECT source offset')

index-program = parser.parse-sql('CREATE UNIQUE INDEX IF NOT EXISTS idx ON t(a, b);')
CTX.check(index-program.error-message == '', 'CREATE INDEX parses: ' - index-program.error-message)
index-node = index-program.node(index-program.statement(0))
CTX.check(index-node.kind == sql-create-index, 'CREATE INDEX root kind')
CTX.check(index-node.text == 'idx' && index-node.flags & 1 == 1, 'index name and UNIQUE flag are retained')
CTX.check(index-node.flags & 2 == 2, 'IF NOT EXISTS flag is retained')
CTX.check(index-program.node(index-node.b).text == 't', 'indexed table name is retained')
CTX.check(index-program.node(index-node.a).kids.len() == 2, 'indexed expression list is retained')

cte-program = parser.parse-sql('WITH c(x) AS (SELECT 1) SELECT x FROM c;')
CTX.check(cte-program.error-message == '', 'CTE column list parses: ' - cte-program.error-message)
cte-root = cte-program.statement(0)
cte-list-id = cte-program.child(cte-root, 0)
cte-list = cte-program.node(cte-list-id)
cte-node-id = cte-program.child(cte-list-id, 0)
cte-node = cte-program.node(cte-node-id)
CTX.check(cte-program.node(cte-program.child(cte-node-id, 0)).kids.len() == 1, 'CTE column names are retained')

dml-program = parser.parse-sql('INSERT INTO items(id, name) VALUES (1, \'a\'), (2, \'b\') RETURNING id; UPDATE items SET name = \'c\', score = 2.5 WHERE id = 1; DELETE FROM items WHERE id = 2;')
CTX.check(dml-program.error-message == '', 'INSERT/UPDATE/DELETE parse: ' - dml-program.error-message)
CTX.check(dml-program.statement-count() == 3, 'multiple SQL statements are retained')
CTX.check(dml-program.kind-of(dml-program.statement(0)) == sql-insert, 'INSERT root kind')
CTX.check(dml-program.kind-of(dml-program.statement(1)) == sql-update, 'UPDATE root kind')
CTX.check(dml-program.kind-of(dml-program.statement(2)) == sql-delete, 'DELETE root kind')
insert-node = dml-program.node(dml-program.statement(0))
insert-values = dml-program.node(insert-node.b)
CTX.check(insert-values.kind == sql-list && insert-values.kids.len() == 2, 'multi-row VALUES are retained')
update-node = dml-program.node(dml-program.statement(1))
update-assignments = dml-program.node(update-node.a)
CTX.check(update-assignments.kids.len() == 2, 'UPDATE assignments are retained')
update-where = dml-program.node(update-node.b)
CTX.check(update-where.kind == sql-binary && update-where.text == '=', 'UPDATE WHERE predicate is retained in field b')
delete-node = dml-program.node(dml-program.statement(2))
delete-where = dml-program.node(delete-node.b)
CTX.check(delete-where.kind == sql-binary && delete-where.text == '=', 'DELETE WHERE predicate is retained in field b')

bad-program = parser.parse-sql('SELECT (1 + )
')
CTX.check(bad-program.error-message != '', 'malformed expression reports an error')
CTX.check(bad-program.error-offset >= 0, 'parse error retains a source offset')
CTX.check(bad-program.statement-count() == 0, 'failed statement is not committed')
CTX.done()
