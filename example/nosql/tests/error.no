ctx.check-code(codes.lookup-code('BUSY_SNAPSHOT'), 517, 5)
ctx.check-code(codes.lookup-code('BUSY_TIMEOUT'), 773, 5)
ctx.check-code(codes.lookup-code('CANTOPEN_NOTEMPDIR'), 270, 14)
ctx.check-code(codes.lookup-code('CANTOPEN_ISDIR'), 526, 14)
