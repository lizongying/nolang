ctx.check-code(codes.lookup-code('READONLY_CANTINIT'), 1288, 8)
ctx.check-code(codes.lookup-code('READONLY_DIRECTORY'), 1544, 8)
ctx.check-code(codes.lookup-code('ABORT_ROLLBACK'), 516, 4)
ctx.check-code(codes.lookup-code('AUTH_USER'), 279, 23)
ctx.check-code(codes.lookup-code('NOTICE_RECOVER_WAL'), 283, 27)
ctx.check-code(codes.lookup-code('NOTICE_RECOVER_ROLLBACK'), 539, 27)
ctx.check-code(codes.lookup-code('WARNING_AUTOINDEX'), 284, 28)
ctx.check-code(codes.lookup-code('OK_LOAD_PERMANENTLY'), 256, 0)
ctx.check(codes.lookup-code('NOT_A_RESULT_CODE') == 1, 'unknown result code fallback')
ctx.check(codes.lookup-code('') == 1, 'empty result code fallback')
ctx.check(codes.lookup-code('ok') == 1, 'result code names are case sensitive')

ok = codes.ok-result()
ctx.check(ok.is-ok(), 'OK result')
ctx.check(ok.code == codes.lookup-code('OK'), 'OK code')
ctx.check(ok.sql-offset == -1, 'unknown SQL offset')

unique-code = codes.lookup-code('CONSTRAINT_UNIQUE')
r = codes.make-result(unique-code, 'duplicate value')
ctx.check(r.is-error(), 'error result')
ctx.check(r.code == codes.lookup-code('CONSTRAINT'), 'primary result code')
ctx.check(r.extended-code == unique-code, 'extended result code')
ctx.check(r.message == 'duplicate value', 'error message')
ctx.check(codes.base-code(codes.lookup-code('IOERR_READ')) == codes.lookup-code('IOERR'), 'extended I/O code mask')

load-result = codes.make-result(codes.lookup-code('OK_LOAD_PERMANENTLY'), 'loaded')
ctx.check(load-result.is-ok(), 'extended OK result remains successful')
ctx.check(load-result.code == 0, 'extended OK primary code')
ctx.check(load-result.extended-code == 256, 'extended OK code retained')

ctx.check(ctx.checks == 224, 'exhaustive result-code check count')
ctx.check(ctx.failures == 0, 'no result-code failures before exit')
ctx.done()
