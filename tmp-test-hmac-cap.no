; 測試 hmac with with-cap (像現有測試一樣)
main = () {
    print('start')
    key []byte = with-cap(32)
    i <- [0..32): { key[i] = i }
    msg []byte = with-cap(11)
    i <- [0..11): { msg[i] = i }
    print('before hmac')
    a [32]byte
    a = hmac.hmac-sha256(key, msg)
    print('after hmac')
    print(a[0])
    print('done')
}
