; runner — 測試執行器
;
; 提供測試計數與結果彙總，簡化測試檔案結構。
;
; 使用全局計數器記錄斷言結果。跨模組全局變量共享已修復，
; 因此全局計數器可正常工作。
;
; 用法（全局計數器模式）：
;   # /test/runner
;
;   runner.eq(1, 1, 'test 1')
;   p, f = runner.test('name', t-func)
;   runner.summary()
;   f-count = runner.failed-count()
;   f-count > 0 -> exit(1)
;   exit(0)
;
; 用法（顯式參數模式）：
;   runner.summary(passed, failed)

; ═══════════════════════════════════════════════
; 全局計數器
; ═══════════════════════════════════════════════

count-passed = 0
count-failed = 0

; ═══════════════════════════════════════════════
; i64 斷言
; ═══════════════════════════════════════════════

; i64 相等斷言 a == b
; a: 實際值（i64）
; b: 期望值（與 a 相等才通過）
; msg: 斷言失敗時列印的說明
eq = (a i64, b i64, msg str) {
    {
        a != b -> {

            count-failed = fail(count-failed)
            print('FAIL: eq -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; i64 不等斷言 a != b
; a: 第一運算值（i64）
; b: 第二運算值（與 a 不等才通過）
; msg: 斷言失敗時列印的說明
ne = (a i64, b i64, msg str) {
    {
        a == b -> {

            count-failed = fail(count-failed)
            print('FAIL: ne -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; 大於斷言 a > b
; a: 比較左值（i64）
; b: 比較右值（a 大於 b 才通過）
; msg: 斷言失敗時列印的說明
gt = (a i64, b i64, msg str) {
    {
        a <= b -> {

            count-failed = fail(count-failed)
            print('FAIL: gt -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; 小於斷言 a < b
; a: 比較左值（i64）
; b: 比較右值（a 小於 b 才通過）
; msg: 斷言失敗時列印的說明
lt = (a i64, b i64, msg str) {
    {
        a >= b -> {

            count-failed = fail(count-failed)
            print('FAIL: lt -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; ═══════════════════════════════════════════════
; 布林斷言
; ═══════════════════════════════════════════════

; 布林值為 true
; val: 被斷言的布林值（為 true 才通過）
; msg: 斷言失敗時列印的說明
is-true = (val bool, msg str) {
    {
        val == false -> {

            count-failed = fail(count-failed)
            print('FAIL: is-true -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; 布林值為 false
; val: 被斷言的布林值（為 false 才通過）
; msg: 斷言失敗時列印的說明
is-false = (val bool, msg str) {
    {
        val == true -> {

            count-failed = fail(count-failed)
            print('FAIL: is-false -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; ═══════════════════════════════════════════════
; 字串斷言
; ═══════════════════════════════════════════════

; 字串相等（比較前 n 個字節）
; a: 第一條字串
; b: 第二條字串
; n: 參與比較的頭部位元組數
; msg: 斷言失敗時列印的說明
str-eq = (a str, b str, n i64, msg str) {
    {
        a.eq(b, n) == false -> {

            count-failed = fail(count-failed)
            print('FAIL: str-eq -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; ═══════════════════════════════════════════════
; 浮點斷言
; ═══════════════════════════════════════════════

; 浮點近似相等 |a - b| < eps
; a: 第一個浮點值
; b: 第二個浮點值
; eps: 容差（絕對差值小於此即視為相等）
; msg: 斷言失敗時列印的說明
f64-eq = (a f64, b f64, eps f64, msg str) {
    diff = a - b
    diff < 0.0 -> diff = 0.0 - diff
    {
        diff >= eps -> {

            count-failed = fail(count-failed)
            print('FAIL: f64-eq -', msg)
        }

        -> {

            count-passed = pass(count-passed)
        }
    }
}

; ═══════════════════════════════════════════════
; 計數與彙總
; ═══════════════════════════════════════════════

; 返回失敗計數
; n: 迄今累計的全域失敗計數
failed-count = () (n i64) {
    n = count-failed
}

; 輸出測試結果彙總
; 不帶參數時使用全局計數器，帶參數時使用傳入的值
; total: 通過與失敗計數之和（取自全域計數器）
summary = () (total i64) {
    print('--- Test Summary ---')
    print('passed:', count-passed)
    print('failed:', count-failed)

    #{overflow=wrap}
    total = count-passed + count-failed
    print('total:', total)
    {
        count-failed == 0 -> print('ALL TESTS PASSED')

        -> print('SOME TESTS FAILED')
    }
}

; ═══════════════════════════════════════════════
; 具名回呼測試
; ═══════════════════════════════════════════════

; 具名函式型別（無參無返回）
callback = ()

; 執行一個無參數回呼函式並計數
; name: 測試案例名稱（執行前列印）
; cb: 待執行的無參回呼函式（其內部斷言累加至全域計數）
; passed: 本案例通過計數（名義恆為 1）
; failed: 本案例失敗計數（名義恆為 0）
test = (name str, cb callback) (passed i64, failed i64) {
    print('TEST:', name)
    cb()
    passed = 1
    failed = 0
}

; 記錄一筆測試通過（兼容舊用法）
; passed: 傳入的當前通過計數
; new-passed: 其值加一後的結果（舊用法相容助手）
pass = (passed i64) (new-passed i64) {

    #{overflow=wrap}
    new-passed = passed + 1
}

; 記錄一筆測試失敗（兼容舊用法）
; failed: 傳入的當前失敗計數
; new-failed: 其值加一後的結果（舊用法相容助手）
fail = (failed i64) (new-failed i64) {

    #{overflow=wrap}
    new-failed = failed + 1
}
