; runner — 測試執行器
;
; 提供測試計數與結果彙總，簡化測試檔案結構。
;
; 使用全局計數器記錄斷言結果。跨模組全局變量共享已修復，
; 因此全局計數器可正常工作。
;
; 用法（全局計數器模式）：
;   # /test/runner
;
;   runner.eq(1, 1, 'test 1')
;   p, f = runner.test('name', t-func)
;   runner.summary()
;   f-count = runner.failed-count()
;   f-count > 0 -> os.exit(1)
;   os.exit(0)
;
; 用法（顯式參數模式）：
;   runner.summary(passed, failed)

; ═══════════════════════════════════════════════
; 全局計數器
; ═══════════════════════════════════════════════

count-passed = 0
count-failed = 0

; ═══════════════════════════════════════════════
; i64 斷言
; ═══════════════════════════════════════════════

; eq: i64 相等斷言 a == b
eq = (a i64, b i64, msg str) {
    {
        a != b -> {
            count-failed = count-failed + 1
            print('FAIL: eq -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; ne: i64 不等斷言 a != b
ne = (a i64, b i64, msg str) {
    {
        a == b -> {
            count-failed = count-failed + 1
            print('FAIL: ne -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; gt: 大於斷言 a > b
gt = (a i64, b i64, msg str) {
    {
        a <= b -> {
            count-failed = count-failed + 1
            print('FAIL: gt -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; lt: 小於斷言 a < b
lt = (a i64, b i64, msg str) {
    {
        a >= b -> {
            count-failed = count-failed + 1
            print('FAIL: lt -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; ═══════════════════════════════════════════════
; 布林斷言
; ═══════════════════════════════════════════════

; is-true: 布林值為 true
is-true = (val bool, msg str) {
    {
        val == false -> {
            count-failed = count-failed + 1
            print('FAIL: is-true -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; is-false: 布林值為 false
is-false = (val bool, msg str) {
    {
        val == true -> {
            count-failed = count-failed + 1
            print('FAIL: is-false -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; ═══════════════════════════════════════════════
; 字串斷言
; ═══════════════════════════════════════════════

; str-eq: 字串相等（比較前 n 個字節）
str-eq = (a str, b str, n i64, msg str) {
    {
        a.eq(b, n) == false -> {
            count-failed = count-failed + 1
            print('FAIL: str-eq -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; ═══════════════════════════════════════════════
; 浮點斷言
; ═══════════════════════════════════════════════

; f64-eq: 浮點近似相等 |a - b| < eps
f64-eq = (a f64, b f64, eps f64, msg str) {
    diff = a - b
    diff < 0.0 -> diff = 0.0 - diff
    {
        diff >= eps -> {
            count-failed = count-failed + 1
            print('FAIL: f64-eq -', msg)
        }
        -> count-passed = count-passed + 1
    }
}

; ═══════════════════════════════════════════════
; 計數與彙總
; ═══════════════════════════════════════════════

; failed-count: 返回失敗計數
failed-count = () (n i64) {
    n = count-failed
}

; summary: 輸出測試結果彙總
; 不帶參數時使用全局計數器，帶參數時使用傳入的值
summary = () (total i64) {
    print('--- Test Summary ---')
    print('passed:', count-passed)
    print('failed:', count-failed)
    total = count-passed + count-failed
    print('total:', total)
    {
        count-failed == 0 -> print('ALL TESTS PASSED')
        -> print('SOME TESTS FAILED')
    }
}

; ═══════════════════════════════════════════════
; 具名回呼測試
; ═══════════════════════════════════════════════

; callback: 具名函式型別（無參無返回）
callback = ()

; test: 執行一個無參數回呼函式並計數
test = (name str, cb callback) (passed i64, failed i64) {
    print('TEST:', name)
    cb()
    passed = 1
    failed = 0
}

; pass: 記錄一筆測試通過（兼容舊用法）
pass = (passed i64) (new-passed i64) {
    new-passed = passed + 1
}

; fail: 記錄一筆測試失敗（兼容舊用法）
fail = (failed i64) (new-failed i64) {
    new-failed = failed + 1
}
