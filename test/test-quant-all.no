main = () {
    // 測試所有量詞
    println('=== quantifier tests ===')

    // * 測試
    m1 = regexp-match('a*', 'aaa')
    println('a* vs aaa:', m1)

    m1b = regexp-match('a*', 'bbb')
    println('a* vs bbb (empty match):', m1b)

    // + 測試
    m2 = regexp-match('a+', 'aaa')
    println('a+ vs aaa:', m2)

    m2b = regexp-match('a+', 'bbb')
    println('a+ vs bbb (no match):', m2b)

    // ? 測試
    m3 = regexp-match('a?', 'a')
    println('a? vs a:', m3)

    m3b = regexp-match('a?', 'b')
    println('a? vs b (empty match):', m3b)

    // .+ 測試
    m4 = regexp-match('.+', 'abc')
    println('.+ vs abc:', m4)

    // .* 測試
    m5 = regexp-match('.*', 'abc')
    println('.* vs abc:', m5)

    // dump a? 的指令
    println('')
    println('=== a? compiled ===')
    re3 = regexp{ pattern: 'a?' }
    re3.compile()
    println('n =', re3.n)
    i <- [0..re3.n): {
        op = re3.op[i]
        a1 = re3.arg1[i]
        a2 = re3.arg2[i]
        op == 1 -> println(i, ': CHAR', a1)
        op == 2 -> println(i, ': ANY')
        op == 3 -> println(i, ': CLASS', a1)
        op == 7 -> println(i, ': JUMP', a1)
        op == 8 -> println(i, ': SPLIT', a1, ',', a2)
        op == 9 -> println(i, ': MATCH')
    }

    println('')
    println('=== .* compiled ===')
    re5 = regexp{ pattern: '.*' }
    re5.compile()
    println('n =', re5.n)
    i <- [0..re5.n): {
        op = re5.op[i]
        a1 = re5.arg1[i]
        a2 = re5.arg2[i]
        op == 1 -> println(i, ': CHAR', a1)
        op == 2 -> println(i, ': ANY')
        op == 3 -> println(i, ': CLASS', a1)
        op == 7 -> println(i, ': JUMP', a1)
        op == 8 -> println(i, ': SPLIT', a1, ',', a2)
        op == 9 -> println(i, ': MATCH')
    }
}

main()
