; std-str.no — str 模組測試
;
; 執行：no run test/std/str.no
; 覆蓋：len / index / index-from / contains / starts-with / ends-with /
;       to-upper / to-lower / trim / repeat / slice / to-bytes / to-i64 /
;       eq / copy / fill

# /test/runner

passed = 0
failed = 0

; ── 基礎操作 ──────────────────────────────────

; 驗證 len-bytes 對非空字串與空字串皆回傳正確的位元組數
t-len = () {
    s = 'hello'
    runner.eq(s.len-bytes(), 5, 'str.len() hello == 5')
    e = ''
    runner.eq(e.len-bytes(), 0, 'str.len() empty == 0')
}

; 驗證 index 回傳子串首次出現的位移；未找到回傳 -1、空子串回傳 0
t-index = () {
    s = 'hello world'
    runner.eq(s.index('world'), 6, 'index world == 6')
    runner.eq(s.index('xyz'), -1, 'index xyz == -1')
    runner.eq(s.index(''), 0, 'index empty == 0')
    runner.eq(s.index('l'), 2, 'index l first occurrence')
}

; 驗證 index-from 由指定位移起尋找子串，其後無匹配時回傳 -1
t-index-from = () {
    s = 'abcabc'
    runner.eq(s.index-from('b', 0), 1, 'index-from b@0 == 1')
    runner.eq(s.index-from('b', 2), 4, 'index-from b@2 == 4')
    runner.eq(s.index-from('z', 0), -1, 'index-from z == -1')
}

; 驗證 contains 判斷子串是否存在，含頭部、中段與完全不存在的子串
t-contains = () {
    s = 'hello world'
    runner.is-true(s.contains('world'), 'contains world')
    runner.is-false(s.contains('xyz'), 'not contains xyz')
    runner.is-true(s.contains('lo wo'), 'contains middle substring')
}

; 驗證 starts-with 與 ends-with 分別正確判定字串的前綴與後綴
t-starts-ends = () {
    s = 'hello world'
    runner.is-true(s.starts-with('hello'), 'starts-with hello')
    runner.is-false(s.starts-with('world'), 'not starts-with world')
    runner.is-true(s.ends-with('world'), 'ends-with world')
    runner.is-false(s.ends-with('hello'), 'not ends-with hello')
}

; ── 轉換 ──────────────────────────────────────

; 驗證 to-upper / to-lower 只轉換字母大小寫、不影響數字
t-case = () {
    s = 'Hello42'
    up = s.to-upper()
    runner.str-eq(up, 'HELLO42', 7, 'to-upper')
    low = s.to-lower()
    runner.str-eq(low, 'hello42', 7, 'to-lower')
}

; 驗證 trim 去除首尾空白，且無首尾空白的字串保持不變
t-trim = () {
    s1 = '  hi  '
    t1 = s1.trim()
    runner.eq(t1.len(), 2, 'trim both sides len')
    runner.str-eq(t1, 'hi', 2, 'trim both sides content')
    s2 = 'hi'
    t2 = s2.trim()
    runner.eq(t2.len(), 2, 'trim no-space unchanged')
}

; 驗證 repeat 依重複次數串接字串，長度與內容皆符合預期
t-repeat = () {
    space = ' '
    buf = space.repeat(8)
    runner.eq(buf.len(), 8, 'repeat len')
    ab = 'ab'
    r = ab.repeat(3)
    runner.eq(r.len(), 6, 'repeat ab x3 len')
    runner.str-eq(r, 'ababab', 6, 'repeat ab x3 content')
}

; 驗證 slice(start, end) 取出子字串檢視，其長度與內容正確
t-slice = () {
    s = 'hello world'
    v = s.slice(6, 11)
    runner.eq(v.len(), 5, 'slice len')
    runner.str-eq(v, 'world', 5, 'slice content')
    v2 = s.slice(0, 5)
    runner.str-eq(v2, 'hello', 5, 'slice from 0')
}

; 驗證 to-bytes 將字串轉為位元組陣列，首尾位元組值與來源對應
t-to-bytes = () {
    s = 'hello'
    b = s.to-bytes()
    runner.eq(b.len(), 5, 'to-bytes len')
    b0 i64 = b[0]
    runner.eq(b0, 104, 'to-bytes 0 == h')
    b4 i64 = b[4]
    runner.eq(b4, 111, 'to-bytes 4 == o')
}

; 驗證 to-i64 解析正負整數字串，非數字字串則得到 err
t-to-i64 = () {

    ; 注意：option 值需在 match 分支內比較
    ok = false
    v = '123'.to-i64()
    v: {
        nil -> ok = false

        -> ok = v == 123
    }
    runner.is-true(ok, 'to-i64 123 == 123')

    ok2 = false
    n = '-45'.to-i64()
    n: {
        nil -> ok2 = false

        -> ok2 = n == -45
    }
    runner.is-true(ok2, 'to-i64 -45 == -45')

    ; 非數字 → err
    bad-state = 0
    bad = 'abc'.to-i64()
    bad: {
        nil -> bad-state = 1

        err -> bad-state = 2

        -> bad-state = 3
    }
    runner.eq(bad-state, 2, 'to-i64 abc == err')
}

; ── 比較與複製 ────────────────────────────────

; 驗證 eq 比對前 n 位元組：相同為真、不同為假、僅比對前綴亦為真
t-eq = () {
    a = 'nolang'
    b = 'nolang'
    c = 'golang'
    runner.is-true(a.eq(b, 6), 'eq same')
    runner.is-false(a.eq(c, 6), 'eq different')
    runner.is-true(a.eq('nol', 3), 'eq first 3 bytes')
}

; 驗證 copy 產出與原字串內容相等且獨立的副本（改副本不影響原字串）
t-copy = () {
    s = 'abc'
    d = s.copy()
    runner.eq(d.len(), 3, 'copy len')
    runner.is-true(d.eq(s, 3), 'copy content equal')
    d[0]: {
        ok -> it = 120

        -> _
    }
    runner.eq(s[0], 97, 'copy is independent (source unchanged)')
}

; 驗證 fill 以指定位元組原地填滿整個字串且長度不變
t-fill = () {
    s = 'abc'
    s.fill(122)
    runner.eq(s.len-bytes(), 3, 'fill keeps len')
    runner.str-eq(s, 'zzz', 3, 'fill with z')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('str.len()', t-len)

#{overflow=wrap}
passed = passed + p1

#{overflow=wrap}
failed = failed + f1
p2, f2 = runner.test('str.index', t-index)

#{overflow=wrap}
passed = passed + p2

#{overflow=wrap}
failed = failed + f2
p3, f3 = runner.test('str.index-from', t-index-from)

#{overflow=wrap}
passed = passed + p3

#{overflow=wrap}
failed = failed + f3
p4, f4 = runner.test('str.contains', t-contains)

#{overflow=wrap}
passed = passed + p4

#{overflow=wrap}
failed = failed + f4
p5, f5 = runner.test('str.starts-with/ends-with', t-starts-ends)

#{overflow=wrap}
passed = passed + p5

#{overflow=wrap}
failed = failed + f5
p6, f6 = runner.test('str.to-upper/to-lower', t-case)

#{overflow=wrap}
passed = passed + p6

#{overflow=wrap}
failed = failed + f6
p7, f7 = runner.test('str.trim', t-trim)

#{overflow=wrap}
passed = passed + p7

#{overflow=wrap}
failed = failed + f7
p8, f8 = runner.test('str.repeat', t-repeat)

#{overflow=wrap}
passed = passed + p8

#{overflow=wrap}
failed = failed + f8
p9, f9 = runner.test('str.slice', t-slice)

#{overflow=wrap}
passed = passed + p9

#{overflow=wrap}
failed = failed + f9
p10, f10 = runner.test('str.to-bytes', t-to-bytes)

#{overflow=wrap}
passed = passed + p10

#{overflow=wrap}
failed = failed + f10
p11, f11 = runner.test('str.to-i64', t-to-i64)

#{overflow=wrap}
passed = passed + p11

#{overflow=wrap}
failed = failed + f11
p12, f12 = runner.test('str.eq', t-eq)

#{overflow=wrap}
passed = passed + p12

#{overflow=wrap}
failed = failed + f12
p13, f13 = runner.test('str.copy', t-copy)

#{overflow=wrap}
passed = passed + p13

#{overflow=wrap}
failed = failed + f13
p14, f14 = runner.test('str.fill', t-fill)

#{overflow=wrap}
passed = passed + p14

#{overflow=wrap}
failed = failed + f14

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
