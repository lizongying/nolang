; std-sha1.no — crypto/sha1 模組測試
;
; 執行：no test test/std/sha1.no
; 覆蓋：sha1（[20]byte）、sha1-hex（str）
; 向量與 shasum -a 1 交叉核對

# /test/runner

EMPTY = ''
ABC = 'abc'
TWOBLOCK = 'abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq'

t-len = () {
    h = sha1.sha1(ABC.to-bytes())
    runner.eq(h.len(), 20, 'sha1 digest is 20 bytes')
}

t-hex-empty = () {
    h = sha1.sha1-hex(EMPTY.to-bytes())
    runner.str-eq(h, 'da39a3ee5e6b4b0d3255bfef95601890afd80709', 40, 'sha1-hex empty')
}

t-hex-abc = () {
    h = sha1.sha1-hex(ABC.to-bytes())
    runner.str-eq(h, 'a9993e364706816aba3e25717850c26c9cd0d89d', 40, 'sha1-hex abc')
}

t-hex-twoblock = () {
    h = sha1.sha1-hex(TWOBLOCK.to-bytes())
    runner.str-eq(h, '84983e441c3bd26ebaae4aa1f95129e5e54670f1', 40, 'sha1-hex two-block')
}

t-bytes-match-hex = () {
    h = sha1.sha1(ABC.to-bytes())
    runner.eq(h[0], 0xa9, 'sha1 byte[0]')
    runner.eq(h[1], 0x99, 'sha1 byte[1]')
    runner.eq(h[19], 0x9d, 'sha1 byte[19] == 0x9d')
}

p1 = runner.test('sha1.digest-len', t-len)
p2 = runner.test('sha1.hex.empty', t-hex-empty)
p3 = runner.test('sha1.hex.abc', t-hex-abc)
p4 = runner.test('sha1.hex.two-block', t-hex-twoblock)
p5 = runner.test('sha1.bytes-match-hex', t-bytes-match-hex)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)

    -> os.exit(0)
}
