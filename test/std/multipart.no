; test/std/multipart.no — net/multipart 模組測試（表單編碼／解析／加密欄位）
;
; 執行：no test test/std/multipart.no
; 覆蓋：multipart-gen-boundary（前綴/長度/種子確定性）、
;       multipart-extract-boundary（未加引號/引號/trim/無 boundary）、
;       multipart-writer（write-field/write-file/close-form/重複關閉/
;       body golden/content-type）、multipart-reader（next 迭代、文字/檔案
;       欄位屬性、解析失敗）、write-encrypted-field + multipart-decrypt-field
;       回環、篡改密文/錯誤 AAD — 認證失敗回 err('decryption failed')、
;       格式不良回 nil
; 註：回归點——(1) multipart-extract-boundary 原將未加引號分支誤掛在外層
;     群組 default 臂，正常 'boundary=XYZ' 返回空字串，已修正；(2) 原
;     parse-headers 的 `!!` 循環在群組臂內退出且臂內呼叫其他方法時觸發
;     BPT trap（codegen 缺陷，reader.next 完全不可用），已改為條件循環
;     結構（行為等價）。工具鏈限制：[n]str 陣列 out-param 多指派崩潰與
;     本測試無關，未觸及。

# /test/runner

; 斷言兩個字串等長且等內容，失敗訊息附帶 [len] 標記
; got str: 實際字串
; want str: 期望字串（長度與內容都以它為準）
; msg str: 斷言描述，長度不符時自動加 ' [len]' 後綴
eq-str = (got str, want str, msg str) {
    runner.eq(got.len-bytes(), want.len-bytes(), msg - ' [len]')
    runner.str-eq(got, want, want.len-bytes(), msg)
}

; 產生 CRLF 序列（本檔多處用它拼 multipart 協定文字）
; crlf str: 兩字元的 '\r\n'
crlf-of = () (crlf str) {
    crlf = '\r' - '\n'
}

; 造一個空的 multipart-part（結果參數是未初始化記憶體，[N]str 型欄位要先 zero）
mk-part = () (p multipart.multipart-part) {
    p.zero()
}

; 造一個空的 multipart-reader（同上，欄位裡有 str 與巢狀 part）
mk-reader = () (r multipart.multipart-reader) {
    r.zero()
}

; boundary 擷取：未加引號與加引號（'Q-B'）兩種形式都要取對；無 boundary 參數時回空字串；
; 另驗證 multipart-create 生成的 boundary 前綴與長度
t-boundary = () {
    b1 = multipart.multipart-extract-boundary('multipart/form-data; boundary=XYZ-abc')
    eq-str(b1, 'XYZ-abc', 'unquoted boundary (regression)')
    b2 = multipart.multipart-extract-boundary('multipart/form-data; boundary="Q-B"')
    eq-str(b2, 'Q-B', 'quoted boundary')
    b3 = multipart.multipart-extract-boundary('text/plain')
    runner.eq(b3.len-bytes(), 0, 'no boundary empty')
    b4 = multipart.multipart-extract-boundary('multipart/form-data; boundary= ABC ;x')
    eq-str(b4, 'ABC', 'trim to semicolon')
    g = multipart.multipart-gen-boundary(123456789)
    runner.eq(g.len-bytes(), 34, 'gen len')
    runner.is-true(g.starts-with('----NolangBoundary'), 'gen prefix')
    g2 = multipart.multipart-gen-boundary(123456789)
    eq-str(g2, g, 'gen deterministic same seed')
    c = multipart.multipart-create()
    made = false
    cv = ''
    c: {
        ok -> {
            made = true
            w2 = it
            cv = w2.boundary-of()
        }

        nil -> made = false

        err -> made = false
    }
    runner.is-true(made, 'multipart-create ok')
    runner.eq(cv.len-bytes(), 34, 'created boundary len')
}

; 寫入器：write-field / write-file 成功、close 成功；關閉後再寫入與重複 close 都應被拒
t-writer = () {
    w = multipart.multipart-create-boundary('BD')
    ok1 = w.write-field('title', 'hello')
    runner.is-true(ok1, 'write-field ok')
    ok2 = w.write-file('doc', 'a.txt', 'text/plain', 'FILEDATA')
    runner.is-true(ok2, 'write-file ok')
    ck = w.close-form()
    runner.is-true(ck, 'close ok')
    after = w.write-field('late', 'x')
    runner.is-false(after, 'write after close rejected')
    ck2 = w.close-form()
    runner.is-false(ck2, 'double close rejected')
    crlf = crlf-of()
    want = '--BD' - crlf - 'Content-Disposition: form-data; name="title"' - crlf - crlf - 'hello' - crlf
    want = want - '--BD' - crlf - 'Content-Disposition: form-data; name="doc"; filename="a.txt"' - crlf - 'Content-Type: text/plain' - crlf - crlf - 'FILEDATA' - crlf - '--BD--' - crlf
    eq-str(w.body-of(), want, 'body golden')
    eq-str(w.content-type(), 'multipart/form-data; boundary=BD', 'content-type')
    eq-str(w.boundary-of(), 'BD', 'boundary-of')
}

; 解析器：文字 part 與檔案 part 都能取出，is-file / has-current-part 狀態正確；
; 缺 boundary 參數時解析回 nil
t-reader = () {
    w = multipart.multipart-create-boundary('BD')
    w.write-field('title', 'hello')
    w.write-file('doc', 'a.txt', 'text/plain', 'FILEDATA')
    w.close-form()
    body = w.body-of()
    ct = w.content-type()
    r = multipart.multipart-parse(ct, body)
    rd multipart-reader
    got = false
    r: {
        ok -> {
            rd = it
            got = true
        }

        nil -> got = false

        err -> got = false
    }
    runner.is-true(got, 'parse ok')
    n1 = rd.next()
    runner.is-true(n1, 'part 1 exists (regression: was BPT trap)')
    runner.is-true(rd.has-current-part(), 'has-current p1')
    eq-str(rd.field-name(), 'title', 'p1 name')
    eq-str(rd.field-data(), 'hello', 'p1 data')
    eq-str(rd.field-filename(), '', 'p1 no filename')
    eq-str(rd.field-content-type(), '', 'p1 no ct')
    runner.is-false(rd.is-file(), 'p1 not file')
    n2 = rd.next()
    runner.is-true(n2, 'part 2 exists')
    eq-str(rd.field-name(), 'doc', 'p2 name')
    eq-str(rd.field-filename(), 'a.txt', 'p2 filename')
    eq-str(rd.field-content-type(), 'text/plain', 'p2 content-type')
    eq-str(rd.field-data(), 'FILEDATA', 'p2 data')
    runner.is-true(rd.is-file(), 'p2 is file')
    n3 = rd.next()
    runner.is-false(n3, 'no part 3 (closing boundary)')
    runner.is-false(rd.has-current-part(), 'no current after end')
    bad = multipart.multipart-parse('text/plain', body)
    bad: {
        ok -> runner.is-true(false, 'missing boundary must not be ok')

        nil -> runner.is-true(true, 'parse without boundary nil')

        err -> runner.is-true(false, 'parse err arm')
    }
}

; 加密欄位：寫入後取出需解密成功（密文長度與明文不同）；
; 換錯 AAD、錯 key、截斷密文都應認證失敗並回 err
t-encrypted = () {
    key [32]byte
    iv [12]byte
    i <- [0..32): {
        key[i]: {
            ok -> it = 65 + (i % 26)

            -> _
        }
    }
    i <- [0..12): {
        iv[i]: {
            ok -> it = 48 + i

            -> _
        }
    }
    w = multipart.multipart-create-boundary('ENC')
    okw = w.write-encrypted-field('secret', 'pw123', key, iv)
    runner.is-true(okw, 'enc write ok')
    w.close-form()
    r = multipart.multipart-parse('multipart/form-data; boundary=ENC', w.body-of())
    rd multipart-reader
    got = false
    d = ''
    r: {
        ok -> {
            rd = it
            got = rd.next()
            d = rd.field-data()
        }

        nil -> got = false

        err -> got = false
    }
    runner.is-true(got, 'enc part found')
    runner.gt(d.len-bytes(), 0, 'enc data nonempty')
    neq = false
    d.len-bytes() != 5 -> neq = true
    runner.is-true(neq, 'ciphertext != plaintext len')
    pt = multipart.multipart-decrypt-field(d, key, 'secret'.to-bytes())
    hit = false
    hv = ''
    pt: {
        ok -> {
            hit = true
            hv = it
        }

        nil -> hit = false

        err -> hit = false
    }
    runner.is-true(hit, 'decrypt ok')
    eq-str(hv, 'pw123', 'decrypt golden')
    wrong = multipart.multipart-decrypt-field(d, key, 'other'.to-bytes())
    wrong: {
        ok -> runner.is-true(false, 'wrong aad must fail')

        nil -> runner.is-true(false, 'wrong aad should be err not nil')

        err -> runner.is-true(true, 'wrong aad err (auth fail)')
    }
    key2 [32]byte
    i <- [0..32): {
        key2[i]: {
            ok -> it = 66 + (i % 26)

            -> _
        }
    }
    kbad = multipart.multipart-decrypt-field(d, key2, 'secret'.to-bytes())
    kbad: {
        ok -> runner.is-true(false, 'wrong key must fail')

        nil -> runner.is-true(false, 'wrong key should be err not nil')

        err -> runner.is-true(true, 'wrong key err (auth fail)')
    }
    trunc = d.slice(0, 6)
    tbad = multipart.multipart-decrypt-field(trunc, key, 'secret'.to-bytes())
    tbad: {
        ok -> runner.is-true(false, 'truncated must fail')

        nil -> runner.is-true(true, 'truncated nil')

        err -> runner.is-true(false, 'truncated err arm')
    }
}

; 內部入口白盒：writer.init / init-boundary、reader.init / parse-headers /
; parse-header-line。這幾支原本只被 create/next 間接走到，缺陷（例如引號分支的
; 丟寫）正是藏在這裡，所以要直接驅動。
t-internals = () {
    w = multipart.multipart-create-boundary('BD')
    eq-str(w.boundary-of(), 'BD', 'pre-init boundary')
    ok = w.init()
    runner.is-true(ok, 'writer.init ok')
    nb = w.boundary-of()
    runner.eq(nb.len-bytes(), 34, 'writer.init regenerated boundary len')
    runner.is-true(nb.starts-with('----NolangBoundary'), 'writer.init prefix')
    nbody = w.body-of()
    runner.eq(nbody.len-bytes(), 0, 'writer.init clears body')

    w.init-boundary('XY')
    eq-str(w.boundary-of(), 'XY', 'init-boundary sets boundary')
    bb = w.body-of()
    runner.eq(bb.len-bytes(), 0, 'init-boundary clears body')

    ; parse-headers：多行標頭區塊（無結尾 CRLF）
    p = mk-part()
    rd = mk-reader()
    rd.init('BD', 'x')
    crlf = crlf-of()
    hdr = 'Content-Disposition: form-data; name="title"' - crlf - 'Content-Type: text/plain'
    rd.parse-headers(hdr, p)
    eq-str(p.name, 'title', 'parse-headers name')
    eq-str(p.content-type, 'text/plain', 'parse-headers content-type')
    eq-str(p.filename, '', 'parse-headers no filename')

    ; parse-header-line：name 與 filename 同一行
    p2 = mk-part()
    rd.parse-header-line('Content-Disposition: form-data; name="doc"; filename="a.txt"', p2)
    eq-str(p2.name, 'doc', 'parse-header-line name')
    eq-str(p2.filename, 'a.txt', 'parse-header-line filename')

    ; 無關標頭行不得改動 part
    p3 = mk-part()
    rd.parse-header-line('X-Ignored: 1', p3)
    eq-str(p3.name, '', 'ignored line keeps name empty')
    eq-str(p3.content-type, '', 'ignored line keeps ct empty')
}

; 加密檔案欄位：與加密文字欄位同格式（base64(iv || sealed)，AAD 為空），
; 因此可用 multipart-decrypt-field 加空 AAD 解回原文
t-encrypted-file = () {
    key [32]byte
    iv [12]byte
    i <- [0..32): {
        key[i]: {
            ok -> it = 65 + (i % 26)

            -> _
        }
    }
    i <- [0..12): {
        iv[i]: {
            ok -> it = 48 + i

            -> _
        }
    }
    w = multipart.multipart-create-boundary('EF')
    okw = w.write-encrypted-file('doc', 'a.txt', 'text/plain', 'FILEDATA', key, iv)
    runner.is-true(okw, 'enc file write ok')
    w.close-form()
    body = w.body-of()
    runner.is-true(body.index('X-Encryption: aes-256-gcm') >= 0, 'enc file has X-Encryption')
    r = multipart.multipart-parse('multipart/form-data; boundary=EF', body)
    rd multipart-reader
    got = false
    d = ''
    r: {
        ok -> {
            rd = it
            got = rd.next()
            d = rd.field-data()
        }

        nil -> got = false

        err -> got = false
    }
    runner.is-true(got, 'enc file part found')
    eq-str(rd.field-filename(), 'a.txt', 'enc file filename')
    eq-str(rd.field-content-type(), 'text/plain', 'enc file content-type')
    runner.is-true(rd.is-file(), 'enc file is-file')
    runner.gt(d.len-bytes(), 8, 'enc file data looks like base64')

    empty []byte
    pt = multipart.multipart-decrypt-field(d, key, empty)
    hit = false
    hv = ''
    pt: {
        ok -> {
            hit = true
            hv = it
        }

        nil -> hit = false

        err -> hit = false
    }
    runner.is-true(hit, 'enc file decrypt ok')
    eq-str(hv, 'FILEDATA', 'enc file decrypt golden')
}

; 回歸 §5.2 #88：明文含 >= 0x80 位元組時，解密必須 1:1 還原。
; 舊實作 opened.to-str() 把每個 byte 當碼點重新 UTF-8 編碼，3 位元組的
; UTF-8 中文字會膨脹成 6 位元組，長度與內容都錯。
t-enc-non-ascii = () {
    key [32]byte
    iv [12]byte
    i <- [0..32): {
        key[i]: {
            ok -> it = 65 + (i % 26)

            -> _
        }
    }
    i <- [0..12): {
        iv[i]: {
            ok -> it = 48 + i

            -> _
        }
    }
    want = 'pw' - '中文'
    w = multipart.multipart-create-boundary('ENC8')
    okw = w.write-encrypted-field('secret', want, key, iv)
    runner.is-true(okw, 'non-ascii enc write ok')
    w.close-form()
    r = multipart.multipart-parse('multipart/form-data; boundary=ENC8', w.body-of())
    rd multipart-reader
    got = false
    d = ''
    r: {
        ok -> {
            rd = it
            got = rd.next()
            d = rd.field-data()
        }

        nil -> got = false

        err -> got = false
    }
    runner.is-true(got, 'non-ascii part found')
    pt = multipart.multipart-decrypt-field(d, key, 'secret'.to-bytes())
    hit = false
    hv = ''
    pt: {
        ok -> {
            hit = true
            hv = it
        }

        nil -> hit = false

        err -> hit = false
    }
    runner.is-true(hit, 'non-ascii decrypt ok')
    eq-str(hv, want, 'non-ascii decrypt 1:1')
}

runner.test('boundary', t-boundary)
runner.test('writer', t-writer)
runner.test('reader', t-reader)
runner.test('internals', t-internals)
runner.test('encrypted field', t-encrypted)
runner.test('encrypted file', t-encrypted-file)
runner.test('encrypted non-ascii', t-enc-non-ascii)
runner.summary()
f = runner.failed-count()
f > 0 -> exit(1)
-> exit(0)
