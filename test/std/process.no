; std-process.no — process 模組測試
;
; 執行：no test test/std/process.no
; 覆蓋：process.new / process.start / process.wait /
;       process.output / process.parent-pid / process.shell
; 注意：fork/exec 測試需要 POSIX 環境

# /test/runner

; ── process.new ───────────────────────────────

; 新建進程：初始 pid 為 0、running 為 false（尚未啟動）
t-new = () {
    p = process.new()
    runner.eq(p.pid, 0, 'new process pid == 0')
    yes = p.is-running()
    runner.is-false(yes, 'new process not running')
}

; ── process.shell ────────────────────────────

; shell 直譯器：'true' 退出碼 0、'false' 退出碼非 0
t-shell = () {
    code = process.shell('true')
    runner.eq(code, 0, 'shell true exit 0')
    code2 = process.shell('false')
    runner.ne(code2, 0, 'shell false exit != 0')
}

; ── process.spawn + wait ─────────────────────

; spawn + wait：子進程 pid 為正，'true' 的等待狀態為 0
t-spawn-wait = () {
    pid = process.spawn('true')
    runner.gt(pid, 0, 'spawn pid > 0')
    status = process.wait(pid)
    runner.eq(status, 0, 'wait true status == 0')
}

; ── process.parent-pid ───────────────────────

; parent-pid 應為正整數（當前進程的父進程號）
t-parent-pid = () {
    pid = process.parent-pid()
    runner.gt(pid, 0, 'parent-pid > 0')
}

; ── process.cmd (替代 output，因 output 有 codegen bug) ──

; cmd：執行 echo 退出碼 0，且擷取到的標準輸出非空
t-cmd = () {
    args = ['hello']
    out, stderr, code, err = process.cmd('echo', args, '', '', [], 0, false)
    runner.eq(code, 0, 'cmd echo exit 0')
    runner.gt(out.len(), 0, 'cmd echo out len > 0')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('process.new', t-new)
p2, f2 = runner.test('process.shell', t-shell)
p3, f3 = runner.test('process.spawn-wait', t-spawn-wait)
p4, f4 = runner.test('process.parent-pid', t-parent-pid)
p5, f5 = runner.test('process.cmd', t-cmd)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
