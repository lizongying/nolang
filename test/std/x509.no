; test/std/x509.no — crypto/x509 模組測試
;
; 執行：no test test/std/x509.no
; 覆蓋：憑證解析（x509-tbs-range / x509-serial / x509-rsa-e / x509-rsa-n /
;       x509-fingerprint）、DER 讀取原語（der-tag / der-len / der-skip）、
;       DER 編碼原語（der-enc-*）、大數打包（x509-bytes-to-bn）、
;       sha256-compress、PKCS#1 簽章（rsa-pkcs1-sign-sha256）與整條
;       自簽憑證建構鏈（x509-build-* / x509-build-self-signed-cert）。
; 向量來源：
;   1. OpenSSL 產生之 RSA-1024 自簽憑證（DER, 512 bytes）；
;   2. 本檔末端另一個 RSA-1024 金鑰，其自簽憑證經 `openssl verify` 驗證通過，
;      並以 `openssl dgst -sha256 -sign` 交叉驗證 PKCS#1 簽章；
;   3. 各 DER 原語的期望值以 Python 按 X.690 規則獨立算出。

# /test/runner

hex-chars = '0123456789abcdef'

; 位元組陣列 → hex 字串（逐字元建構，小寫、每 byte 兩位）
; data []byte: 待格式化的位元組，可為空
; hex str: 長度為 data.len()*2 的 hex 字串，每 2 字元對應一個 byte
bhex = (data []byte) (hex str) {
    n = data.len()

    #{overflow=wrap}
    hex = with-len(n * 2)
    i <- [0..n): {
        ixout25c33 = data[i]: {
            ok -> it

            -> _
        }

        ixout25c22 = hex-chars[(ixout25c33 >> 4) & 15]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hex[i * 2] = ixout25c22

        ixout28c36 = data[i]: {
            ok -> it

            -> _
        }

        ixout28c26 = hex-chars[ixout28c36 & 15]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hex[i * 2 + 1] = ixout28c26
    }
}

; [32]byte → hex 字串
; a [32]byte: 待格式化的摘要
; s str: 64 字元 hex
hx32 = (a [32]byte) (s str) {
    v []byte = a.slice(0, 32)
    s = bhex(v)
}

; hex 字串 → []byte
; h str: 偶數長度的 hex
; b []byte: 解出的位元組
mkb = (h str) (b []byte) {
    opt = h.from-hex()
    b = opt: {
        ok -> it

        -> b
    }
}

; 讀 []i64 的第 i 個元素（越界回 -999999 以便在斷言中暴露）
; v []i64: 大整數 limb 陣列
; i i64: 索引
; x i64: limb 值
limb = (v []i64, i i64) (x i64) {
    x = v[i]: {
        ok -> it

        -> -999999
    }
}

; 8 個 32-bit 大端字 → 32 位元組 hex（供 sha256 類回傳值比較）
; h0..h7 i64: 8 個大端 32-bit 字（高位在前）
; s str: 64 字元 hex
w8hex = (h0 i64, h1 i64, h2 i64, h3 i64, h4 i64, h5 i64, h6 i64, h7 i64) (s str) {
    buf []byte = with-len(32)
    ws [8]i64 = [h0, h1, h2, h3, h4, h5, h6, h7]
    wi <- [0..8): {
        w = ws[wi]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        base = wi * 4

        #{overflow=wrap}
        buf[base + 0] = (w >> 24) & 255

        #{overflow=wrap}
        buf[base + 1] = (w >> 16) & 255

        #{overflow=wrap}
        buf[base + 2] = (w >> 8) & 255

        #{overflow=wrap}
        buf[base + 3] = w & 255
    }
    s = bhex(buf)
}

; 固定 [512]byte → []byte 檢視（每次複製到新 vec，避免全域 slice 突變）
; a [512]byte: 來源固定陣列（DER 憑證原始位元組）
; v []byte: 長度 512、內容逐位元組複製的切片
arr512 = (a [512]byte) (v []byte) {
    v = with-len(512)
    i <- [0..512): {
        ixout40c16 = a[i]: {
            ok -> it

            -> _
        }

        v[i] = ixout40c16
    }
}

; OpenSSL 產生之 RSA-1024 自簽 DER 憑證（大端序原始位元組）
DER [512]byte = [
    0x30, 0x82, 0x01, 0xfc, 0x30, 0x82, 0x01, 0x65,
    0xa0, 0x03, 0x02, 0x01, 0x02, 0x02, 0x02, 0x12,
    0x34, 0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48,
    0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0b, 0x05, 0x00,
    0x30, 0x19, 0x31, 0x17, 0x30, 0x15, 0x06, 0x03,
    0x55, 0x04, 0x03, 0x0c, 0x0e, 0x4e, 0x6f, 0x6c,
    0x61, 0x6e, 0x67, 0x58, 0x35, 0x30, 0x39, 0x54,
    0x65, 0x73, 0x74, 0x30, 0x1e, 0x17, 0x0d, 0x32,
    0x36, 0x31, 0x30, 0x30, 0x35, 0x30, 0x38, 0x30,
    0x39, 0x31, 0x30, 0x5a, 0x17, 0x0d, 0x33, 0x36,
    0x31, 0x30, 0x30, 0x32, 0x30, 0x38, 0x30, 0x39,
    0x31, 0x30, 0x5a, 0x30, 0x19, 0x31, 0x17, 0x30,
    0x15, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0c, 0x0e,
    0x4e, 0x6f, 0x6c, 0x61, 0x6e, 0x67, 0x58, 0x35,
    0x30, 0x39, 0x54, 0x65, 0x73, 0x74, 0x30, 0x81,
    0x9f, 0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48,
    0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01, 0x05, 0x00,
    0x03, 0x81, 0x8d, 0x00, 0x30, 0x81, 0x89, 0x02,
    0x81, 0x81, 0x00, 0xcb, 0xac, 0x4e, 0x71, 0xd8,
    0xa8, 0x7e, 0x75, 0x52, 0x82, 0x3c, 0xa6, 0x54,
    0x44, 0x81, 0x8e, 0x46, 0xb8, 0x66, 0xc0, 0x24,
    0xbf, 0x88, 0x65, 0x79, 0xf3, 0xca, 0x50, 0x7c,
    0x82, 0xd3, 0x59, 0x48, 0x8d, 0x7b, 0xa2, 0x03,
