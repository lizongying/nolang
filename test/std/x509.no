    0x84, 0x2c, 0xa3, 0x78, 0x2a, 0x85, 0x96, 0x7e,
    0x8d, 0x39, 0x2d, 0xf0, 0x77, 0x4c, 0x48, 0xfa,
    0xf3, 0x9a, 0xf3, 0xb9, 0x33, 0x73, 0x9a, 0xd2,
    0x7b, 0xb3, 0x0a, 0x5c, 0xc0, 0x20, 0x16, 0x61,
    0xbc, 0xc3, 0xff, 0x9e, 0x4b, 0x0b, 0xcb, 0x17,
    0x9c, 0xe8, 0x69, 0x35, 0x26, 0x58, 0x04, 0x26,
    0x98, 0xae, 0xd2, 0x16, 0xde, 0x53, 0x05, 0x3c,
    0xf7, 0x71, 0xe6, 0x89, 0xaa, 0x60, 0xf3, 0xc4,
    0x2f, 0x13, 0x6d, 0x0a, 0xa1, 0x34, 0x41, 0x48,
    0xd7, 0x25, 0xd0, 0xb0, 0xfe, 0x41, 0x18, 0xe9,
    0x38, 0x00, 0x11, 0x6c, 0x28, 0xbe, 0x2d, 0x2f,
]

; OpenSSL 導出之期望值
MOD_HEX str = 'cbac4e71d8a87e7552823ca65444818e46b866c024bf886579f3ca507c82d359488d7ba203ad5cd3ff8a3f9b3eb49b31c32a1126685175a8cf256e385912d2b0d90f9aa77e4fead03cf28b1a847fe359da40b6bf6c9b53ef7cc777d1f424d7bff1dd0d9b2cad35c25f6c5569b8058232dbe9ba07425d5dba96e5f09dfc35f5c5'

; TBSCertificate 之 SHA-256（openssl dgst），以 8 個大端 32-bit 字表示
FP str = 'feed7a6de5a9a299ba84ada12e2a157d04de84ead0db84d596058a84712f043f'

; TBS 範圍應指向內層 SEQUENCE（跳過外層 SEQUENCE 標籤+長度）
t-tbs-range = () {
    start, end = x509.x509-tbs-range(arr512(DER))
    runner.eq(start, 4, 'tbs start = 4')
    runner.eq(end, 365, 'tbs end = 365')
}

; 序號 = 0x1234 = 4660
t-serial = () {
    s = x509.x509-serial(arr512(DER))
    runner.eq(s, 4660, 'serial = 4660')
}

; RSA 公開指數 = 65537
t-rsa-e = () {
    e = x509.x509-rsa-e(arr512(DER))
    runner.eq(e, 65537, 'rsa exponent = 65537')
}

; RSA 模數（大端序、去前導 0x00）必須逐位元組匹配 OpenSSL
t-rsa-n = () {
    n = x509.x509-rsa-n(arr512(DER))
    runner.eq(n.len(), 128, 'modulus length = 128')
    runner.str-eq(bhex(n), MOD_HEX, 256, 'modulus matches OpenSSL')
}

; 指紋（TBS 之 SHA-256）必須匹配 OpenSSL；以 hex 重组 8 個字後比較
t-fingerprint = () {
    h0, h1, h2, h3, h4, h5, h6, h7 = x509.x509-fingerprint(arr512(DER))
    buf []byte = with-len(32)
    ws [8]i64 = [h0, h1, h2, h3, h4, h5, h6, h7]
    wi <- [0..8): {

        #{overflow=wrap}
        base = wi * 4
        w = ws[wi]

        #{index-out=zero, overflow=wrap}
        buf[base + 0] = (w >> 24) & 255

        #{index-out=zero, overflow=wrap}
        buf[base + 1] = (w >> 16) & 255

        #{index-out=zero, overflow=wrap}
        buf[base + 2] = (w >> 8) & 255

        #{index-out=zero, overflow=wrap}
        buf[base + 3] = w & 255
    }
    runner.str-eq(bhex(buf), FP, 64, 'fingerprint matches OpenSSL sha256(tbs)')
}

; 非憑證輸入應安全回傳預設值（不外洬、不崩潰）
t-invalid = () {
    junk []byte = with-len(4)
    junk[0] = 0x01
    junk[1] = 0x02
    junk[2] = 0x03
    junk[3] = 0x04
    runner.eq(x509.x509-serial(junk), 0, 'serial on non-cert = 0')
    runner.eq(x509.x509-rsa-e(junk), 0, 'rsa-e on non-cert = 0')
    start, end = x509.x509-tbs-range(junk)
    runner.eq(start, 0, 'tbs-range start on non-cert = 0')
    runner.eq(end, 0, 'tbs-range end on non-cert = 0')
}
p1 = runner.test('x509.tbs-range', t-tbs-range)
p2 = runner.test('x509.serial', t-serial)
p3 = runner.test('x509.rsa-e', t-rsa-e)
p4 = runner.test('x509.rsa-n', t-rsa-n)
p5 = runner.test('x509.fingerprint', t-fingerprint)
p6 = runner.test('x509.invalid', t-invalid)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)

    -> os.exit(0)
}
