; test/std/tdes.no — crypto/tdes 模組測試
;
; 執行：no test test/std/tdes.no
; 覆蓋：tdes.tdes-enc / tdes-dec（3DES-EDE 單區塊）
; 向量來源：pycryptodome DES3 ECB 交叉核對（K1 != K3，避免退化為單 DES）
;   key=0123456789ABCDEF|FEDCBA9876543210|0123456789ABCDEE, pt=0123456789ABCDEF
;   → ct=1a4d672dca6cb335

# /test/runner

; 把位元組序列格式化成小寫十六進位字串（供 runner.str-eq 逐字元比對）
; data []byte: 待格式化的位元組，可為空
; hex str: 長度為 data.len()*2 的 hex 字串，每 2 字元對應一個位元組
bhex = (data []byte) (hex str) {
    hex-chars = '0123456789abcdef'
    n = data.len()

    #{overflow=wrap}
    hex str = with-len(n * 2)
    i <- [0..n): {
        ixout23c37 = data[i]: {
            ok -> it

            -> _
        }

        ixout28c1f = hex-chars[(ixout23c37 >> 4) & 15]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hex[i * 2] = ixout28c1f

        ixout26c40 = data[i]: {
            ok -> it

            -> _
        }

        ixout37c23 = hex-chars[ixout26c40 & 15]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        hex[i * 2 + 1] = ixout37c23
    }
}

; 3DES-EDE 加密 KAT：24 位元組金鑰 + 一個 8 位元組區塊 → 1a4d672dca6cb335
; （K1 != K3，排除退化成單 DES 的可能）
t-enc = () {
    key [24]byte = [
        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
        0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10,
        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xee,
    ]
    pt []byte = [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef]
    ct = tdes.tdes-enc(pt, 8, key)
    runner.str-eq(bhex(ct), '1a4d672dca6cb335', 16, '3des enc KAT')

    ; n 不是 8 的倍數時只處理完整區塊（輸出長度 = (n/8)*8）
    two = mkb('0123456789abcdef0123456789abcdef')
    ct20 = tdes.tdes-enc(two, 20, key)
    runner.eq(ct20.len(), 16, 'tdes-enc n=20 → 16 位元組（丟棄尾部 4 位元組）')
    ct16 = tdes.tdes-enc(two, 16, key)
    runner.str-eq(bhex(ct20), bhex(ct16), 32, 'tdes-enc n=20 與 n=16 結果一致')

    ; 空輸入 ⇒ 空輸出
    runner.eq(tdes.tdes-enc(zeros(0), 0, key).len(), 0, 'tdes-enc 空輸入 → 空')
}

; 3DES-EDE 解密：同一金鑰對密文解密應還原出明文 0123456789abcdef
t-dec = () {
    key [24]byte = [
        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
        0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10,
        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xee,
    ]
    pt []byte = [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef]
    ct = tdes.tdes-enc(pt, 8, key)
    back = tdes.tdes-dec(ct, 8, key)
    runner.str-eq(bhex(back), '0123456789abcdef', 16, '3des dec round-trip')
}

; ---- 助手 ----

; hex → []byte
mkb = (h str) (b []byte) {
    opt = h.from-hex()
    b = opt: {
        ok -> it

        -> b
    }
}

; 長度 n 的全零 []byte
zeros = (n i64) (v []byte) {
    v = with-len(n)
    i <- [0..n): {
        v[i]: {
            ok -> it = 0

            -> _
        }
    }
}

; hex → [8]byte
mk8 = (h str) (a [8]byte) {
    raw = mkb(h)
    i <- [0..8): {
        a[i]: {
            ok -> it = 0

            -> _
        }
    }
    m = raw.len()
    m > 8 -> m = 8
    i <- [0..m): {
        v = raw[i]: {
            ok -> it

            -> 0
        }

        a[i]: {
            ok -> it = v

            -> _
        }
    }
}

; hex → [24]byte
mk24 = (h str) (a [24]byte) {
    raw = mkb(h)
    i <- [0..24): {
        a[i]: {
            ok -> it = 0

            -> _
        }
    }
    m = raw.len()
    m > 24 -> m = 24
    i <- [0..m): {
        v = raw[i]: {
            ok -> it

            -> 0
        }

        a[i]: {
            ok -> it = v

            -> _
        }
    }
}

; ---- CBC 模式 ----

t-cbc = () {
    key [24]byte = mk24('0123456789abcdef23456789abcdef01456789abcdef0123')
    iv [8]byte = mk8('0000000000000000')
    pt = mkb('4e6f77206973207468652074696d6520666f7220616c6c20')

    ct = tdes.tdes-cbc-enc(pt, key, iv)
    runner.eq(ct.len(), 24, 'tdes-cbc-enc 長度 = 24（3 塊）')
    runner.str-eq(bhex(ct), '314f8327fa7a09a8fd9b21da8f3732775351c9f385748c81', 48, '3DES-CBC 3 塊')

    back = tdes.tdes-cbc-dec(ct, key, iv)
    runner.eq(back.len(), 24, 'tdes-cbc-dec 長度')
    runner.str-eq(bhex(back), bhex(pt), 48, '3DES-CBC 往返還原')

    ; 不足一塊的尾部被丟棄（11 位元組 → 8 位元組輸出）
    c11 = tdes.tdes-cbc-enc(mkb('4e6f772069732074686520'), key, iv)
    runner.eq(c11.len(), 8, 'tdes-cbc-enc 丟棄不足一塊的尾部')
    runner.str-eq(bhex(c11), '314f8327fa7a09a8', 16, 'tdes-cbc-enc 11B → 1 塊')

    ; 剛好越過一塊邊界的 9 位元組 ⇒ 仍只輸出 1 塊
    c9 = tdes.tdes-cbc-enc(mkb('4e6f77206973207468'), key, iv)
    runner.eq(c9.len(), 8, 'tdes-cbc-enc 9B → 1 塊')
    runner.str-eq(bhex(c9), bhex(c11), 16, 'tdes-cbc-enc 9B 與 11B 首塊一致')

    ; 解密同樣只處理完整區塊：11 位元組密文 → 8 位元組明文
    d11 = tdes.tdes-cbc-dec(c11, key, iv)
    runner.eq(d11.len(), 8, 'tdes-cbc-dec 丟棄不足一塊的尾部')
    runner.str-eq(bhex(d11), '4e6f772069732074', 16, 'tdes-cbc-dec 11B → 1 塊')

    ; 空輸入 ⇒ 空輸出
    e = tdes.tdes-cbc-enc(zeros(0), key, iv)
    runner.eq(e.len(), 0, 'tdes-cbc-enc 空輸入 → 空')
    d = tdes.tdes-cbc-dec(zeros(0), key, iv)
    runner.eq(d.len(), 0, 'tdes-cbc-dec 空輸入 → 空')

    ; 非零 IV 會改變首塊密文
    iv3 [8]byte = mk8('0123456789abcdef')
    c8 = tdes.tdes-cbc-enc(mkb('4e6f772069732074'), key, iv3)
    runner.str-eq(bhex(c8), '81ffbcbe6280ae10', 16, '3DES-CBC 非零 IV')

    ; K1=K2=K3 ⇒ EDE 退化成單 DES，CBC 結果應等於 DES-CBC
    kk [24]byte = mk24('0123456789abcdef0123456789abcdef0123456789abcdef')
    ct2 = tdes.tdes-cbc-enc(pt, kk, iv)
    runner.str-eq(bhex(ct2), '3fa40e8a984d48150b2e73f88dc5856a70a30640cc76dd8b', 48, 'K1=K2=K3 退化為單 DES-CBC')
    back2 = tdes.tdes-cbc-dec(ct2, kk, iv)
    runner.str-eq(bhex(back2), bhex(pt), 48, '退化金鑰也能正確解密')

    ; IV 只影響第一塊的「輸入異或」，故第二塊起不同 IV 仍會分岔（鏈式擴散）
    s1 = bhex(ct)
    s2 = bhex(tdes.tdes-cbc-enc(pt, key, iv3))
    runner.is-false(s1.eq(s2, 48), 'tdes-cbc-enc IV 有生效')
}

p1 = runner.test('tdes.enc', t-enc)
p2 = runner.test('tdes.dec', t-dec)
p3 = runner.test('tdes.cbc', t-cbc)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
