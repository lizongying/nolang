; test/std/linked-hash-map.no — collection/linked-hash-map 模組測試
;
; 執行：no test test/std/linked-hash-map.no
; 覆蓋：init / put / get / contains / remove / len / is-empty / clear /
;       hash / for-each

# /test/runner

; 初始狀態：init() 後容量歸零且 is-empty() 為真（尚未插入任何鍵）
t-init = () {
    m = linked-hash-map{}
    m.init()
    runner.eq(m.len(), 0, 'init len == 0')
    e bool = m.is-empty()
    runner.is-true(e, 'init is-empty')
}

; put 回報是否新鍵（1/2 皆為 true）、len 計數，get 以 ?i64 回傳值，
; contains 對不存在鍵回 false
t-put-get = () {
    m = linked-hash-map{}
    m.init()
    n1 bool = m.put(1, 100)
    runner.is-true(n1, 'put 1 is-new')
    n2 bool = m.put(2, 200)
    runner.is-true(n2, 'put 2 is-new')
    runner.eq(m.len(), 2, 'len == 2')

    r = m.get(2)
    hit = false
    val = -1
    r: {
        ok -> {
            hit = true
            val = it
        }

        err ->

        nil ->
    }
    runner.is-true(hit, 'get 2 found')
    runner.eq(val, 200, 'get 2 == 200')

    yes bool = m.contains(1)
    runner.is-true(yes, 'contains 1')
    no bool = m.contains(99)
    runner.is-false(no, 'not contains 99')
}

; 同鍵重覆 put：不新增節點（回 false）、len 不變，但值被更新為 20
t-overwrite = () {
    m = linked-hash-map{}
    m.init()
    m.put(5, 10)
    n bool = m.put(5, 20)
    runner.is-false(n, 're-put not new')
    runner.eq(m.len(), 1, 'len stays 1')
    r = m.get(5)
    got = -1
    r: {
        ok -> got = it

        err ->

        nil ->
    }
    runner.eq(got, 20, 'overwrite updates value')
}

; remove 既有鍵回 true 且該鍵不再被 contains，其餘鍵不受影響；
; remove 不存在的鍵回 false（不報錯）
t-remove = () {
    m = linked-hash-map{}
    m.init()
    m.put(1, 10)
    m.put(2, 20)
    m.put(3, 30)
    rm bool = m.remove(2)
    runner.is-true(rm, 'remove 2 ok')
    runner.eq(m.len(), 2, 'len == 2 after remove')
    no bool = m.contains(2)
    runner.is-false(no, 'removed key gone')
    yes1 bool = m.contains(1)
    runner.is-true(yes1, 'key 1 still present')
    yes3 bool = m.contains(3)
    runner.is-true(yes3, 'key 3 still present')
    rm2 bool = m.remove(999)
    runner.is-false(rm2, 'remove non-existent false')
}

; clear() 清掉所有鍵值：len 歸零且 is-empty() 回 true
t-clear = () {
    m = linked-hash-map{}
    m.init()
    m.put(1, 1)
    m.put(2, 2)
    m.clear()
    runner.eq(m.len(), 0, 'clear => len 0')
    e bool = m.is-empty()
    runner.is-true(e, 'clear => is-empty')
}

p1 = runner.test('linked-hash-map.init', t-init)
p2 = runner.test('linked-hash-map.put/get', t-put-get)
p3 = runner.test('linked-hash-map.overwrite', t-overwrite)
p4 = runner.test('linked-hash-map.remove', t-remove)
p5 = runner.test('linked-hash-map.clear', t-clear)
p6 = runner.test('linked-hash-map.hash', t-hash)
p7 = runner.test('linked-hash-map.for-each', t-for-each)

; hash：槽位 = key & (cap-1)，cap 固定 64
t-hash = () {
    m = linked-hash-map{}
    m.init()
    runner.eq(m.hash(0), 0, 'hash 0 -> slot 0')
    runner.eq(m.hash(9), 9, 'hash 9 -> slot 9')
    runner.eq(m.hash(63), 63, 'hash 63 -> slot 63')
    runner.eq(m.hash(64), 0, 'hash 64 wraps to slot 0')
    runner.eq(m.hash(70), 6, 'hash 70 -> slot 6')
}

; for-each：順 head -> tail 走鏈表，回傳最後插入的那對（插入序，非槽位序）
t-for-each = () {
    m = linked-hash-map{}
    m.init()
    m.put(1, 100)
    m.put(2, 200)
    k, v = m.for-each()
    runner.eq(k, 2, 'tail key == last inserted')
    runner.eq(v, 200, 'tail value == last inserted')

    ; 覆寫既有鍵不改變鏈表位置，尾節點仍是 2
    m.put(1, 111)
    k2, v2 = m.for-each()
    runner.eq(k2, 2, 'overwrite keeps tail at 2')
    runner.eq(v2, 200, 'tail value unchanged')
}

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
