; ── 補齊的轉換 / 內建位元組寫入 ────────────────
;
; 這一組原本被列在檔頭「已知未測」裡。其中 to-bool 當年是因為「`?bool` 的 match
; 取值恆為 false」而整族放棄，本輪實測該問題已不存在（`x: { ok(b) -> … }` 取得
; 真值），故全部補上。

; 码点原位写入：`s[i] = <char>` 是 txt 目前**唯一**公开的原位写入形态。
;
; 這裡原本測的是 `txt.set-byte(i, b)`（回 `?bool`、以實體容量 255 為界、
; 越界回 nil 並跳過寫入的可失敗寫入器）。該內建已於 2026-11-11 私有化為
; `_set-byte`，只供 std 內部（txt._from-bytes / txt.fill 等）使用，用戶代碼
; 無法再呼叫 ⇒ 本組改測碼點寫，保留其中仍可觀測的語義：
;   - ASCII 碼點原位覆蓋（碼點值 == 位元組值），長度不變；
;   - 超出 255 位元組實體容量的寫入被丟棄，既有內容不被破壞。
t-cp-write = () {
    s txt = 'abc'

    ; ASCII 碼點原位覆蓋：X = 0x58 = 88。
    ; 注意：函數內的 `s[i] = v` 直寫會被 idxwrite 拒絕（與 str 同規則；只有
    ; 頂層語句放行），因此一律寫成 place-match —— 它同樣是「碼點原位寫」，
    ; 只是以「讀」作閘門：i >= len 時整條寫入靜默跳過。
    s[0]: {
        ok -> it = "X"

        -> _
    }
    runner.str-eq(s.to-str(), 'Xbc', 3, 'txt[0] = "X" ⇒ Xbc')
    runner.eq(s.len(), 3, '碼點原位寫入不改長度')

    ; 尾端原位覆蓋（仍在 len 之內）
    s[2]: {
        ok -> it = "Z"

        -> _
    }
    runner.str-eq(s.to-str(), 'XbZ', 3, 'txt[2] = "Z" ⇒ XbZ')
    runner.eq(s.len(), 3, '尾端覆蓋不改長度')

    ; 超界：i >= len（此處 == 255 == 實體容量）的寫入被跳過，
    ; 長度與尾端位元組都不變（不野寫、不越界）
    big txt = ''
    k <- [0..255): {
        big.push("a")
    }
    big[255]: {
        ok -> it = "Z"

        -> _
    }
    runner.eq(big.len(), 255, '超界碼點寫入不改變長度')
    runner.is-true(big[254] == 97, '超界碼點寫入不破壞尾端位元組')
}

; new：編譯期內建，[]char 逐位元組轉成 txt（超過 255 位元組自動截斷）
t-new = () {
    cs []char
    cs.push("a")
    cs.push("b")
    cs.push("c")
    v = txt.new(cs)
    runner.eq(v.len(), 3, 'txt.new([]char) len == 3')
    runner.str-eq(v.to-str(), 'abc', 3, 'txt.new([]char) 內容')

    ; ⚠️ 現狀（本輪釘住，未修）：非 ASCII 碼點只取**低 8 位元**，不做 UTF-8 編碼。
    ;    '中' (U+4E2D) ⇒ 1 位元組 0x2D（'-'），而不是 3 位元組 E4 B8 AD。
    ;    同一條 codegen 路徑（builtin chars-new）也承載 str.new / txt.from-chars，
    ;    三者行為一致 ⇒ 屬 codegen 缺陷，見 test/README.md §5.2 #64。
    one []char
    one.push("中")
    w = txt.new(one)
    runner.eq(w.len(), 1, 'txt.new 對非 ASCII 碼點只取低 8 位元（現狀，非 UTF-8）')
    runner.str-eq(w.to-str(), '-', 1, 'txt.new(中) 得到 0x2D ⇒ 連字符')
}

; to-u16 / to-u32：範圍檢查 + 負號/非數字/空字串分流
t-to-unsigned = () {
    a txt = '65535'
    v = a.to-u16()
    v: {
        ok(x) -> runner.eq(x, 65535, 'to-u16 65535 命中上界')

        -> runner.is-true(false, 'to-u16 65535 不該失敗')
    }

    b txt = '65536'
    w = b.to-u16()
    w: {
        ok -> runner.is-true(false, 'to-u16 65536 應越界')

        err -> runner.is-true(true, 'to-u16 65536 ⇒ err(out of range)')

        nil -> runner.is-true(false, 'to-u16 65536 應回 err 而非 nil')
    }

    c txt = '+7'
    y = c.to-u16()
    y: {
        ok(z) -> runner.eq(z, 7, 'to-u16 +7 ⇒ 7（允許前導加號）')

        -> runner.is-true(false, 'to-u16 +7 不該失敗')
    }

    d txt = '0'
    d0 = d.to-u16()
    d0: {
        ok(z0) -> runner.eq(z0, 0, 'to-u16 0 ⇒ 0')

        -> runner.is-true(false, 'to-u16 0 不該失敗')
    }

    e txt = '4294967295'
    u32 = e.to-u32()
    u32: {
        ok(x32) -> runner.eq(x32, 4294967295, 'to-u32 命中上界')

        -> runner.is-true(false, 'to-u32 上界不該失敗')
    }

    f txt = '4294967296'
    over = f.to-u32()
    over: {
        ok -> runner.is-true(false, 'to-u32 越界應報錯')

        err -> runner.is-true(true, 'to-u32 越界 ⇒ err')

        nil -> runner.is-true(false, 'to-u32 越界應回 err 而非 nil')
    }
}

; to-u64 / to-byte：u64 不做範圍檢查（負號/非數字才報錯），byte 走 0~255
t-to-u64-byte = () {
    max-t txt = '18446744073709551615'
    want u64 = 18446744073709551615
    v = max-t.to-u64()
    v: {
        ok(x) -> runner.is-true(x == want, 'to-u64 命中 2^64-1')

        -> runner.is-true(false, 'to-u64 上界不該失敗')
    }

    neg txt = '-1'
    n = neg.to-u64()
    n: {
        ok -> runner.is-true(false, 'to-u64 負號應報錯')

        err -> runner.is-true(true, 'to-u64 負號 ⇒ err')

        nil -> runner.is-true(false, 'to-u64 負號應回 err 而非 nil')
    }

    bad txt = '12x'
    b = bad.to-u64()
    b: {
        ok -> runner.is-true(false, 'to-u64 非數字應報錯')

        err -> runner.is-true(true, 'to-u64 非數字 ⇒ err')

        nil -> runner.is-true(false, 'to-u64 非數字應回 err 而非 nil')
    }

    bmax txt = '255'
    bv = bmax.to-byte()
    bv: {
        ok(xb) -> runner.eq(xb, 255, 'to-byte 255 命中上界')

        -> runner.is-true(false, 'to-byte 255 不該失敗')
    }

    bover txt = '256'
    ov = bover.to-byte()
    ov: {
        ok -> runner.is-true(false, 'to-byte 256 應越界')

        err -> runner.is-true(true, 'to-byte 256 ⇒ err')

        nil -> runner.is-true(false, 'to-byte 256 應回 err 而非 nil')
    }
}

; to-f32：回 f32（不是 f64 位元 — 檔頭舊 bug 5 已不再復現）
t-to-f32 = () {
    t txt = '42'
    v = t.to-f32()
    v: {
        ok(x) -> {
            runner.f64-eq(x, 42.0, 0.0001, 'to-f32 42 ⇒ 42.0')
            runner.f64-eq(x + x, 84.0, 0.0001, 'to-f32 的值可參與 f32 算術')
        }

        nil -> runner.is-true(false, 'to-f32 42 == nil')

        err -> runner.is-true(false, 'to-f32 42 == err')
    }

    h txt = '3.5'
    hf = h.to-f32()
    hf: {
        ok(y) -> runner.f64-eq(y, 3.5, 0.0001, 'to-f32 3.5 ⇒ 3.5')

        -> runner.is-true(false, 'to-f32 3.5 失敗')
    }

    bad txt = 'abc'
    bf = bad.to-f32()
    bf: {
        ok -> runner.is-true(false, 'to-f32 abc 應報錯')

        err -> runner.is-true(true, 'to-f32 abc ⇒ err')

        nil -> runner.is-true(false, 'to-f32 abc 應回 err 而非 nil')
    }
}

; to-bool：只認「true」/「false」，其餘 err，空字串 nil
t-to-bool = () {
    t txt = 'true'
    v = t.to-bool()
    v: {
        ok(x) -> runner.is-true(x, 'to-bool true ⇒ true')

        -> runner.is-true(false, 'to-bool true 失敗')
    }

    f txt = 'false'
    fv = f.to-bool()
    fv: {
        ok(y) -> runner.is-false(y, 'to-bool false ⇒ false')

        -> runner.is-true(false, 'to-bool false 失敗')
    }

    ; 大小寫敏感：'TRUE' 不是合法輸入
    up txt = 'TRUE'
    uv = up.to-bool()
    uv: {
        ok -> runner.is-true(false, 'to-bool 對 TRUE 應報錯')

        err -> runner.is-true(true, 'to-bool TRUE ⇒ err(大小寫敏感)')

        nil -> runner.is-true(false, 'to-bool TRUE 應回 err 而非 nil')
    }

    ; 長度對但內容不對（'truf'）也走 err
    near txt = 'truf'
    nv = near.to-bool()
    nv: {
        ok -> runner.is-true(false, 'to-bool truf 應報錯')

        err -> runner.is-true(true, 'to-bool truf ⇒ err')

        nil -> runner.is-true(false, 'to-bool truf 應回 err 而非 nil')
    }

    e txt = ''
    ev = e.to-bool()
    ev: {
        ok -> runner.is-true(false, 'to-bool 空字串應回 nil')

        nil -> runner.is-true(true, 'to-bool 空字串 ⇒ nil')

        err -> runner.is-true(false, 'to-bool 空字串應回 nil 而非 err')
    }
}

; txt-hex-val：十六進位字元的數值（A-F / a-f / 0-9）
t-hex-val = () {
    runner.eq(txt.txt-hex-val(48), 0, 'hex-val(0) == 0')
    runner.eq(txt.txt-hex-val(57), 9, 'hex-val(9) == 9')
    runner.eq(txt.txt-hex-val(65), 10, 'hex-val(A) == 10')
    runner.eq(txt.txt-hex-val(70), 15, 'hex-val(F) == 15')
    runner.eq(txt.txt-hex-val(97), 10, 'hex-val(a) == 10（大小寫等價）')
    runner.eq(txt.txt-hex-val(102), 15, 'hex-val(f) == 15')
}

; to-bigint 的攤平助手：?bigint → 十進位字串（nil / err 各給哨兵字串）
; ⚠️ 不能在函數體內定義函數（`'dig' is not defined`），必須提到頂層。
bigint-str = (t txt) (out str) {
    out = 'nil'
    v = t.to-bigint()
    v: {
        ok(b) -> out = b.to-str()

        err -> out = 'err'

        nil -> out = 'nil'
    }
}

; to-bigint：十進位/帶前綴/帶符號/前導空白，以及 nil（空）與 err（無有效數字）
;
; ⚠️ 本函數原本對**任何有效數字都回 0**：累加器那行 `d = _txt-dig-val(...)` 沒標註
;    i64，於是 `acc + d` 的運算符重載被派到 bigint 臂。str.to-bigint 早就標註過，
;    txt 這份漏了（本輪補上，見 src/std/txt.no 的註解）。
t-to-bigint = () {
    a txt = '42'
    runner.str-eq(bigint-str(a), '42', 2, 'to-bigint 42')

    b txt = '0x10'
    runner.str-eq(bigint-str(b), '16', 2, 'to-bigint 0x10 ⇒ 16')

    c txt = '0b1010'
    runner.str-eq(bigint-str(c), '10', 2, 'to-bigint 0b1010 ⇒ 10')

    d txt = '-5'
    runner.str-eq(bigint-str(d), '-5', 2, 'to-bigint -5')

    e txt = '  7'
    runner.str-eq(bigint-str(e), '7', 1, 'to-bigint 跳過前導空白')

    f txt = '123456789012345678901234567890'
    runner.str-eq(bigint-str(f), '123456789012345678901234567890', 30, 'to-bigint 30 位數不被截斷')

    g txt = 'abc'
    runner.str-eq(bigint-str(g), 'err', 3, 'to-bigint 無有效數字 ⇒ err')

    h txt = ''
    runner.str-eq(bigint-str(h), 'nil', 3, 'to-bigint 空字串 ⇒ nil')
}

p16, f16 = runner.test('txt.hex/eq-full', t-hex-and-eq)

#{overflow=wrap}
passed = passed + p16

#{overflow=wrap}
failed = failed + f16

