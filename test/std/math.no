p15, f15 = runner.test('i64.sqrt/is-prime', t-i64-math)
p16, f16 = runner.test('int-width methods', t-int-methods)
p17, f17 = runner.test('math.pow-int', t-pow-int)
p18, f18 = runner.test('math.atan-kernel', t-atan-kernel)
p19, f19 = runner.test('math.atan2', t-atan2)
p20, f20 = runner.test('math.char-to-str', t-char-to-str)
p21, f21 = runner.test('math.rotate-left/right', t-rotate)
p22, f22 = runner.test('math.arr-zero', t-arr-zero)
p23, f23 = runner.test('math.store-le-u32', t-store-le-u32)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
