p7, f7 = runner.test('f64.degrees/radians', t-deg-rad)
p9, f9 = runner.test('f64.cbrt', t-cbrt)
p10, f10 = runner.test('f64.ceil/floor/round/trunc', t-rounding)
p11, f11 = runner.test('math.clamp', t-clamp)
p12, f12 = runner.test('f64.sinh/cosh/tanh', t-hyperbolic)
p13, f13 = runner.test('f64.exp/log/log10/log2', t-exp-log)
