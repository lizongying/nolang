; test/std/str-set.no — collection/str-set 模組測試
;
; 執行：no test test/std/str-set.no
; 覆蓋：init / add / contains / remove / len / is-empty / clear /
;       hash / str-eq / for-each

# /test/runner

; 初始狀態：init() 後 len 為 0 且 is-empty() 為真
t-init = () {
    s = str-set{}
    s.init()
    runner.eq(s.len(), 0, 'init len == 0')
    e = s.is-empty()
    runner.is-true(e, 'init is-empty')
}

; add 回報是否新成員：hello / world 為 true、重複加入 hello 為 false，
; len 只計唯一字串，contains 對未加入的 zzz 回 false
t-add-contains = () {
    s = str-set{}
    s.init()
    n1 = s.add('hello')
    runner.is-true(n1, 'add hello is-new')
    n2 = s.add('world')
    runner.is-true(n2, 'add world is-new')
    n3 = s.add('hello')
    runner.is-false(n3, 'add hello again not new')
    runner.eq(s.len(), 2, 'len == 2')
    yes = s.contains('hello')
    runner.is-true(yes, 'contains hello')
    no = s.contains('zzz')
    runner.is-false(no, 'not contains zzz')
}

; remove 既有成員回 true 且該成員不再被 contains，其餘成員保留；
; remove 不存在的成員回 false
t-remove = () {
    s = str-set{}
    s.init()
    s.add('a')
    s.add('bb')
    s.add('ccc')
    rm = s.remove('bb')
    runner.is-true(rm, 'remove bb ok')
    runner.eq(s.len(), 2, 'len == 2 after remove')
    no = s.contains('bb')
    runner.is-false(no, 'removed bb not found')
    rm2 = s.remove('missing')
    runner.is-false(rm2, 'remove non-existent false')
}

; clear() 清空集合：len 歸零、is-empty() 為真
t-clear = () {
    s = str-set{}
    s.init()
    s.add('x')
    s.add('y')
    s.clear()
    runner.eq(s.len(), 0, 'clear => len 0')
    e = s.is-empty()
    runner.is-true(e, 'clear => is-empty')
}

p1 = runner.test('str-set.init', t-init)
p2 = runner.test('str-set.add/contains', t-add-contains)
p3 = runner.test('str-set.remove', t-remove)
p4 = runner.test('str-set.clear', t-clear)
p5 = runner.test('str-set.hash', t-hash)
p6 = runner.test('str-set.str-eq', t-str-eq)
p7 = runner.test('str-set.for-each', t-for-each)

; hash：FNV-1a 之後 & (cap-1)，cap 固定 256；下表是實測出的槽位
t-hash = () {
    s = str-set{}
    s.init()
    runner.eq(s.hash('hello'), 11, 'hash hello -> 11')
    runner.eq(s.hash('world'), 243, 'hash world -> 243')
    runner.eq(s.hash('abc'), 75, 'hash abc -> 75')
    runner.eq(s.hash(''), 37, 'hash empty -> 37')
    runner.is-true(s.hash('hello') != s.hash('world'), 'hello != world slot')
}

; str-eq：逐位元組比較，長度不同直接不等
t-str-eq = () {
    s = str-set{}
    s.init()
    runner.is-true(s.str-eq('abc', 'abc'), 'abc == abc')
    runner.is-false(s.str-eq('abc', 'abd'), 'abc != abd')
    runner.is-false(s.str-eq('a', 'ab'), 'length mismatch')
    runner.is-true(s.str-eq('', ''), 'empty == empty')
}

; for-each：回傳「槽位下標最大的已佔用元素」
; 'hello' -> 槽 11、'world' -> 槽 243，因此最後停在 'world'
t-for-each = () {
    s = str-set{}
    s.init()
    s.add('hello')
    s.add('world')
    v = s.for-each()
    runner.str-eq(v, 'world', 5, 'higher slot (world) wins')

    s2 = str-set{}
    s2.init()
    s2.add('solo')
    runner.str-eq(s2.for-each(), 'solo', 4, 'single element returned as-is')
}

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
