; test/std/str-set.no — collection/str-set 模組測試
;
; 執行：no test test/std/str-set.no
; 覆蓋：init / add / contains / remove / len / is-empty / clear

# /test/runner

; 初始狀態：init() 後 len 為 0 且 is-empty() 為真
t-init = () {
    s = str-set {}
    s.init()
    runner.eq(s.len(), 0, 'init len == 0')
    e = s.is-empty()
    runner.is-true(e, 'init is-empty')
}

; add 回報是否新成員：hello / world 為 true、重複加入 hello 為 false，
; len 只計唯一字串，contains 對未加入的 zzz 回 false
t-add-contains = () {
    s = str-set {}
    s.init()
    n1 = s.add('hello')
    runner.is-true(n1, 'add hello is-new')
    n2 = s.add('world')
    runner.is-true(n2, 'add world is-new')
    n3 = s.add('hello')
    runner.is-false(n3, 'add hello again not new')
    runner.eq(s.len(), 2, 'len == 2')
    yes = s.contains('hello')
    runner.is-true(yes, 'contains hello')
    no = s.contains('zzz')
    runner.is-false(no, 'not contains zzz')
}

; remove 既有成員回 true 且該成員不再被 contains，其餘成員保留；
; remove 不存在的成員回 false
t-remove = () {
    s = str-set {}
    s.init()
    s.add('a')
    s.add('bb')
    s.add('ccc')
    rm = s.remove('bb')
    runner.is-true(rm, 'remove bb ok')
    runner.eq(s.len(), 2, 'len == 2 after remove')
    no = s.contains('bb')
    runner.is-false(no, 'removed bb not found')
    rm2 = s.remove('missing')
    runner.is-false(rm2, 'remove non-existent false')
}

; clear() 清空集合：len 歸零、is-empty() 為真
t-clear = () {
    s = str-set {}
    s.init()
    s.add('x')
    s.add('y')
    s.clear()
    runner.eq(s.len(), 0, 'clear => len 0')
    e = s.is-empty()
    runner.is-true(e, 'clear => is-empty')
}

p1 = runner.test('str-set.init', t-init)
p2 = runner.test('str-set.add/contains', t-add-contains)
p3 = runner.test('str-set.remove', t-remove)
p4 = runner.test('str-set.clear', t-clear)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
