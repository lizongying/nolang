; test/std/aes.no — crypto/aes 模組測試
;
; 執行：no test test/std/aes.no
; 覆蓋：aes.enc-128 / dec-128 / enc-256 / dec-256（單區塊 ECB KAT + round-trip）
; 向量來源：FIPS-197 Appendix C，並與 pycryptodome ECB 交叉核對

# /test/runner

; 把單一 16 位元組 AES 區塊格式化成 32 字元小寫 hex（供 KAT 比對）
; a [16]byte: 區塊的位元組內容（加密輸出或解密還原值）
; h str: 固定 32 字元的小寫 hex 字串
hex16 = (a [16]byte) (h str) {
    hc = '0123456789abcdef'
    h str = with-len(32)
    i <- [0..16): {

        #{overflow=wrap}
        h[i * 2] = hc[(a[i] >> 4) & 15]

        #{overflow=wrap}
        h[i * 2 + 1] = hc[a[i] & 15]
    }
}

; FIPS-197 附錄 C.1 已知答案測試：key 與明文均為 000102..0f
; 單一區塊加密結果必須是 69c4e0d86a7b0430d8cdb78070b4c55a
t-enc-128 = () {
    key [16]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    ]
    blk [16]byte = [
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
        0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
    ]
    out = aes.enc-128(blk, key)
    runner.str-eq(hex16(out), '69c4e0d86a7b0430d8cdb78070b4c55a', 32, 'aes-128 enc KAT')
}

; AES-128 單區塊往返：加密後解密還原原始 16 位元組
t-dec-128 = () {
    key [16]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    ]
    pt [16]byte = [
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
        0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
    ]
    ct = aes.enc-128(pt, key)
    back = aes.dec-128(ct, key)
    runner.str-eq(hex16(back), '00112233445566778899aabbccddeeff', 32, 'aes-128 dec round-trip')
}

; FIPS-197 附錄 C.3 已知答案測試：32 位元組金鑰的 AES-256 單區塊加密
t-enc-256 = () {
    key [32]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
        0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
    ]
    blk [16]byte = [
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
        0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
    ]
    out = aes.enc-256(blk, key)
    runner.str-eq(hex16(out), '8ea2b7ca516745bfeafc49904b496089', 32, 'aes-256 enc KAT')
}

; AES-256 單區塊往返：驗證 14 輪子金鑰逆序使用的正確性
t-dec-256 = () {
    key [32]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
        0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
    ]
    pt [16]byte = [
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
        0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
    ]
    ct = aes.enc-256(pt, key)
    back = aes.dec-256(ct, key)
    runner.str-eq(hex16(back), '00112233445566778899aabbccddeeff', 32, 'aes-256 dec round-trip')
}
p1 = runner.test('aes.enc128', t-enc-128)
p2 = runner.test('aes.dec128', t-dec-128)
p3 = runner.test('aes.enc256', t-enc-256)
p4 = runner.test('aes.dec256', t-dec-256)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
