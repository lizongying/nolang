; std-set.no — set 模組測試（runner harness）
;
; 執行：no test test/std/set.no
;
; 泛型 set 現已採用具 `[]t` 欄位的常規形式：實例由工廠 `set.init(data)` 建立，
; 元素型別 `t` 由傳入的具體 `[N]E` 緩衝區推斷，經 monomorphizeSliceStructs 單態化。
; 覆蓋：set.init / add / contains / remove / size / is-empty。

# /test/runner

; add / contains：唯一元素使 size 遞增，重複加入不變；contains 命中 2、不含 99
t-add-contains = () {
    buf [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0]
    s = set.init(buf)
    n1 = s.add(1)
    runner.eq(n1, 1, 'add 1 -> size 1')
    n2 = s.add(2)
    runner.eq(n2, 2, 'add 2 -> size 2')
    n3 = s.add(1)
    runner.eq(n3, 2, 'add duplicate -> size 2')
    yes = s.contains(2)
    runner.is-true(yes, 'contains 2')
    no = s.contains(99)
    runner.is-false(no, 'not contains 99')
}

; remove：刪除後 size 減一、再查為 false；size 欄位與 empty 狀態同步
t-remove-size = () {
    buf [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0]
    s = set.init(buf)
    s.add(1)
    s.add(2)
    s.add(3)
    n = s.remove(2)
    runner.eq(n, 2, 'remove -> size 2')
    yes = s.contains(2)
    runner.is-false(yes, 'removed 2 gone')
    sz = s.size()
    runner.eq(sz, 2, 'size reflects field')
    empty = s.is-empty()
    runner.is-false(empty, 'non-empty == false')
}

; is-empty：新集合為 true 且 size 為 0
t-is-empty = () {
    buf [4]i64 = [0, 0, 0, 0]
    s = set.init(buf)
    yes = s.is-empty()
    runner.is-true(yes, 'empty set == true')
    sz = s.size()
    runner.eq(sz, 0, 'empty size == 0')
}

; union：把 other 裡自身沒有的元素追加進來（無序），size 遞增；重複呼叫不變
t-union = () {
    buf [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0]
    s = set.init(buf)
    s.add(1)
    s.add(2)
    other [3]i64 = [2, 9, 5]
    n = s.union(other, 3)
    runner.eq(n, 4, 'union size == 4')
    runner.is-true(s.contains(9), 'union picked up 9')
    runner.is-true(s.contains(5), 'union picked up 5')
    runner.eq(s.size(), 4, 'size matches union result')
    n2 = s.union(other, 3)
    runner.eq(n2, 4, 'union of same set is idempotent')
}

; intersection：命中元素寫進呼叫者提供的 out 緩衝區，回傳命中數
t-intersection = () {
    buf [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0]
    s = set.init(buf)
    s.add(1)
    s.add(2)
    s.add(3)
    other [3]i64 = [2, 3, 7]
    out [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0]
    n = s.intersection(other, 3, out)
    runner.eq(n, 2, 'intersection count == 2')
    o0 = out[0]: {
        ok -> it

        -> -1
    }
    o1 = out[1]: {
        ok -> it

        -> -1
    }
    runner.eq(o0 + o1, 5, 'intersection elements are 2 and 3')
    runner.eq(s.size(), 3, 'intersection does not mutate self')
}

; difference：在自身但不在 other 的元素寫進 out
t-difference = () {
    buf [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0]
    s = set.init(buf)
    s.add(1)
    s.add(2)
    s.add(3)
    other [2]i64 = [2, 9]
    out [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0]
    n = s.difference(other, 2, out)
    runner.eq(n, 2, 'difference count == 2')
    d0 = out[0]: {
        ok -> it

        -> -1
    }
    d1 = out[1]: {
        ok -> it

        -> -1
    }
    runner.eq(d0 + d1, 4, 'difference elements are 1 and 3')
}

; to-vec：回傳長度 = size 的新切片，內容與集合一致
t-to-vec = () {
    buf [4]i64 = [0, 0, 0, 0]
    s = set.init(buf)
    s.add(4)
    s.add(6)
    v = s.to-vec()
    runner.eq(v.len(), 2, 'to-vec len == size')
    runner.is-true(v.contains(4), 'to-vec has 4')
    runner.is-true(v.contains(6), 'to-vec has 6')

    buf2 [2]i64 = [0, 0]
    empty = set.init(buf2)
    v2 = empty.to-vec()
    runner.eq(v2.len(), 0, 'empty set -> empty slice')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('set.add/contains', t-add-contains)
p2, f2 = runner.test('set.remove/size', t-remove-size)
p3, f3 = runner.test('set.is-empty', t-is-empty)
p4, f4 = runner.test('set.union', t-union)
p5, f5 = runner.test('set.intersection', t-intersection)
p6, f6 = runner.test('set.difference', t-difference)
p7, f7 = runner.test('set.to-vec', t-to-vec)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
