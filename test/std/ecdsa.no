; test/std/ecdsa.no — crypto/ecdsa 模組測試（NIST P-256 金標向量）
;
; 執行：no test test/std/ecdsa.no
; 覆蓋：ecdsa-publickey / ecdsa-verify / ecdsa-sign
;       （含 Jacobian 點運算、模 p/模 n 大整數、bn-invmod 費馬求逆）
; 向量來源：OpenSSL (prime256v1 / P-256) 實際產生之金鑰與 SHA-256 簽名
;   本模組先前 P256-P 常數以「大端位元組」儲存，卻被小端 bn-* 引擎直接使用，
;   導致所有模 p 規約使用錯誤模數；已更正為小端序並通過 OpenSSL 官方向量。

# /test/runner

hex-chars str = '0123456789abcdef'

; 位元組陣列 → hex 字串（逐字元建構，避免格式化補零問題）
bhex = (data []byte) (hex str) {
    n = data.len()

    #{overflow=wrap}
    hex = with-len(n * 2)
    i <- [0..n): {

        #{index-out=zero, overflow=wrap}
        hex[i * 2] = hex-chars[(data[i] >> 4) & 15]

        #{index-out=zero, overflow=wrap}
        hex[i * 2 + 1] = hex-chars[data[i] & 15]
    }
}

arr65 = (a [65]byte) (v []byte) {
    v = with-len(65)
    i <- [0..65): {

        #{index-out=zero}
        v[i] = a[i]
    }
}

arr64 = (a [64]byte) (v []byte) {
    v = with-len(64)
    i <- [0..64): {

        #{index-out=zero}
        v[i] = a[i]
    }
}

; OpenSSL prime256v1 私鑰 d（大端序）
priv [32]byte = [
    0x3e, 0x77, 0x54, 0xe7, 0xb5, 0x4e, 0x37, 0xce,
    0x13, 0x4f, 0x27, 0x15, 0x3c, 0x04, 0x49, 0xdd,
    0xc8, 0x6c, 0xcd, 0x6a, 0xd6, 0x22, 0xb3, 0xd6,
    0xc7, 0x36, 0xae, 0x94, 0x42, 0x3e, 0x15, 0x22,
]

; 對應未壓縮公鑰 04 || Gx || Gy（OpenSSL 產生）
PUB_HEX str = '04a3061cc2ace0dffeccad1f68f19db8c6bbd76665d55e0a5f7994f21cdf30d5ac9aa1c6e9fa2acaa67bd77f63e546070f7a7417b860f2d999dd03ff6f731898a8'

; 訊息 'Nolang ECDSA P-256 vector'（固定陣列，測試內轉為 vec 傳入）
MSG25 [25]byte = [
    0x4e, 0x6f, 0x6c, 0x61, 0x6e, 0x67, 0x20, 0x45,
    0x43, 0x44, 0x53, 0x41, 0x20, 0x50, 0x2d, 0x32,
    0x35, 0x36, 0x20, 0x76, 0x65, 0x63, 0x74, 0x6f,
    0x72,
]
arr25 = (a [25]byte) (v []byte) {
    v = with-len(25)
    i <- [0..25): {

        #{index-out=zero}
        v[i] = a[i]
    }
}

; OpenSSL dgst -sha256 -sign 產生之 DER 簽名解析出的 r || s（大端序）
sig [64]byte = [
    0xd4, 0x1a, 0x30, 0x23, 0x2d, 0x83, 0x75, 0x4d,
    0x65, 0xb7, 0x28, 0x92, 0xe9, 0x51, 0x5b, 0x8c,
    0x91, 0x98, 0xa8, 0xe5, 0x25, 0x9b, 0x51, 0xcb,
    0x1f, 0x21, 0x03, 0xa6, 0xac, 0x19, 0x52, 0x14,
    0xfa, 0x65, 0x9c, 0xc7, 0xc9, 0xa5, 0x4e, 0x8a,
    0x07, 0x8f, 0x91, 0x95, 0xc2, 0x4a, 0x33, 0x77,
    0xd2, 0xb3, 0x06, 0x77, 0x52, 0xf3, 0x3b, 0x25,
    0x4b, 0x09, 0x4c, 0x20, 0x16, 0x36, 0x3a, 0x69,
]

; ═══ P-256 ECDH 已知答案向量（Go crypto/elliptic 作為 oracle）═══
; SHARED = x(dA * pubB) = x(dB * pubA)
; 覆蓋 ecdh-p256 的「對任意對端點做標量乘法」路徑（TLS ECDHE 用的正是此路徑，
; 而非 ecdsa-publickey 的「僅對基點 G 乘法」），驗證 ec-bytes-to-point 解碼、
; ec-scalar-mult（任意點倍加）、ec-point-to-bytes 與 x 座標提取。
DA [32]byte = [
    0x3e, 0x77, 0x54, 0xe7, 0xb5, 0x4e, 0x37, 0xce,
    0x13, 0x4f, 0x27, 0x15, 0x3c, 0x04, 0x49, 0xdd,
    0xc8, 0x6c, 0xcd, 0x6a, 0xd6, 0x22, 0xb3, 0xd6,
    0xc7, 0x36, 0xae, 0x94, 0x42, 0x3e, 0x15, 0x22,
]
DB [32]byte = [
    0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88,
    0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff, 0x00,
    0x0f, 0x1e, 0x2d, 0x3c, 0x4b, 0x5a, 0x69, 0x78,
    0x87, 0x96, 0xa5, 0xb4, 0xc3, 0xd2, 0xe1, 0xf0,
]
PUBA [65]byte = [
    0x04, 0xa3, 0x06, 0x1c, 0xc2, 0xac, 0xe0, 0xdf, 0xfe, 0xcc, 0xad, 0x1f, 0x68, 0xf1, 0x9d, 0xb8,
    0xc6, 0xbb, 0xd7, 0x66, 0x65, 0xd5, 0x5e, 0x0a, 0x5f, 0x79, 0x94, 0xf2, 0x1c, 0xdf, 0x30, 0xd5,
    0xac, 0x9a, 0xa1, 0xc6, 0xe9, 0xfa, 0x2a, 0xca, 0xa6, 0x7b, 0xd7, 0x7f, 0x63, 0xe5, 0x46, 0x07,
    0x0f, 0x7a, 0x74, 0x17, 0xb8, 0x60, 0xf2, 0xd9, 0x99, 0xdd, 0x03, 0xff, 0x6f, 0x73, 0x18, 0x98,
    0xa8,
]
PUBB [65]byte = [
    0x04, 0xad, 0x1a, 0xae, 0x5f, 0x1e, 0x9c, 0x16, 0x5d, 0xdd, 0x10, 0x3b, 0xfd, 0x71, 0xc2, 0xda,
    0x49, 0x01, 0x29, 0x2c, 0xbc, 0x2c, 0x3d, 0xfe, 0x31, 0x8c, 0xae, 0x60, 0x3e, 0x6a, 0x76, 0x24,
    0x77, 0x55, 0xcb, 0x00, 0x6a, 0x3a, 0x99, 0x9f, 0x04, 0x84, 0x58, 0xa8, 0x92, 0x96, 0x00, 0xb5,
    0x1f, 0x9f, 0x9d, 0x4a, 0xd1, 0xf7, 0xea, 0x53, 0x0b, 0xf0, 0x39, 0x05, 0xab, 0x10, 0x4b, 0x6f,
    0x86,
]
SHARED_HEX str = '1a2f302d6abd7412640912417406ce0496a94c59103e390dd76a336631438dbf'

; P-256 ECDH 已知答案：dA * pubB 共享秘密必須等於 SHARED
t-ecdh-a = () {
    shared = ecdsa.ecdh-p256(DA, PUBB)
    runner.str-eq(bhex(shared), SHARED_HEX, 64, 'ecdh-p256 dA*pubB == SHARED')
}

; P-256 ECDH 已知答案（對稱）：dB * pubA 必須等於同一 SHARED
t-ecdh-b = () {
    shared = ecdsa.ecdh-p256(DB, PUBA)
    runner.str-eq(bhex(shared), SHARED_HEX, 64, 'ecdh-p256 dB*pubA == SHARED')
}

; 由私鑰推導公鑰，必須等於 OpenSSL 產生之未壓縮公鑰
t-publickey = () {
    pub = ecdsa.ecdsa-publickey(priv)
    runner.str-eq(bhex(arr65(pub)), PUB_HEX, 130, 'publickey matches OpenSSL')
}

; 驗證 OpenSSL 產生之外部簽名（金標）
t-verify-golden = () {
    pub = ecdsa.ecdsa-publickey(priv)
    ok = ecdsa.ecdsa-verify(pub, arr25(MSG25), sig)
    runner.eq(ok, 1, 'verify OpenSSL golden signature')
}

; 自簽自驗往返（k 為隨機，故僅斷言自身可驗通）
t-roundtrip = () {
    pub = ecdsa.ecdsa-publickey(priv)
    s = ecdsa.ecdsa-sign(priv, arr25(MSG25))
    ok = ecdsa.ecdsa-verify(pub, arr25(MSG25), s)
    runner.eq(ok, 1, 'verify own signature round-trip')
}

; 竄改偵測：改動簽名末位元組 → 驗證必須失敗（回 0）
t-tamper = () {
    pub = ecdsa.ecdsa-publickey(priv)
    bad [64]byte
    i <- [0..64): {

        #{index-out=zero}
        bad[i] = sig[i]
    }
    bad[63] = bad[63] ^ 0x01
    ok = ecdsa.ecdsa-verify(pub, arr25(MSG25), bad)
    runner.eq(ok, 0, 'tampered signature rejected')

    ; 改動訊息也必須導致驗證失敗
    mb2 [25]byte
    i <- [0..25): {

        #{index-out=zero}
        mb2[i] = MSG25[i]
    }
    mb2[0] = mb2[0] ^ 0x01
    ok2 = ecdsa.ecdsa-verify(pub, arr25(mb2), sig)
    runner.eq(ok2, 0, 'wrong message rejected')
}
p1 = runner.test('ecdsa.publickey', t-publickey)
p2 = runner.test('ecdsa.verify-golden', t-verify-golden)
p3 = runner.test('ecdsa.roundtrip', t-roundtrip)
p4 = runner.test('ecdsa.tamper', t-tamper)
p5 = runner.test('ecdsa.ecdh-a', t-ecdh-a)
p6 = runner.test('ecdsa.ecdh-b', t-ecdh-b)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)

    -> os.exit(0)
}
