; test/std/xz.no — archive/xz（XZ / LZMA2）模組測試
;
; 執行：no test test/std/xz.no
; 覆蓋：xz-compress / xz-decompress / lzma-decompress / lzma2-decompress-stream、
;       lzma-rd.{init,normalize,decode-bit,decode-direct-bits,decode-bit-tree,
;                decode-reverse-bit-tree}、
;       lzma-decoder.{init-probs,update-state-literal,update-state-match,
;                     update-state-rep,update-state-shortrep,decode-literal,
;                     decode-length,decode-distance,decode}
;
; 判準：範圍解碼器（range coder）的初始狀態依 LZMA 規格驗證
;       （跳過首個標記位元組、讀 4 位元組進 code、range=0xFFFFFFFF）。
;
; 已知缺陷（test/README.md §5.2 #14）：
;   1. xz-compress 產出的流缺乏正確的 Stream Header / Block Header / Index CRC32，
;      真實 `xz -d` 會判為 corrupt（本模組自己的 xz-decompress 可讀）。
;   2. 真實 .xz（LZMA2 壓縮區塊）解不出來：lzma-decoder 的狀態機與
;      prob 表初始化尚未完成（len-coder 是長度 0 的切片）。
;   故此檔對內部解碼器只驗「可被呼叫且回傳形狀正確」，語意斷言待解碼器補完。

# /test/runner

; ── 1. 範圍解碼器（range coder）初始狀態 ─────────────────────────────
t-range-init = () {
    rd = lzma-rd{}
    ; 首位元組為標記（跳過），其後 4 位元組進 code
    rd.init([0x00, 0x12, 0x34, 0x56, 0x78], 0)

    runner.eq(rd.pos, 5, 'init 後 pos = start-pos + 1 + 4')
    runner.eq(rd.range, 0xFFFFFFFF, 'range 初始化為 0xFFFFFFFF')
    runner.eq(rd.code, 0x12345678, 'code 由 4 位元組大端序拼成')

    ; range 已足夠大，normalize 不應推進 pos
    rd.normalize()
    runner.eq(rd.pos, 5, 'range 足夠時 normalize 不消耗位元組')
    runner.eq(rd.range, 0xFFFFFFFF, 'range 不變')
}

; ── 2. decode-bit / decode-direct-bits ───────────────────────────────
; code=0 且 prob=0x400 時，bound = (0xFFFFFFFF >> 11) * 0x400 > 0，
; 故 code < bound 恆成立 → bit = 0（LZMA 規格）
t-range-bits = () {
    rd = lzma-rd{}
    rd.init([0x00, 0x00, 0x00, 0x00, 0x00], 0)

    bit, npro = rd.decode-bit(0x400)
    runner.eq(bit, 0, 'code=0 時 decode-bit 解出 0')
    runner.lt(rd.range, 0xFFFFFFFF, 'decode-bit 後 range 收窄')

    ; 直接位元：code=0 → 全 0
    res = rd.decode-direct-bits(3)
    runner.eq(res, 0, 'code=0 時 decode-direct-bits(3) = 0')
}

; ── 3. 位元樹解碼 ────────────────────────────────────────────────────
t-bit-tree = () {
    rd = lzma-rd{}
    rd.init([0x00, 0x00, 0x00, 0x00, 0x00], 0)

    probs []i64 = with-len(16)
    i <- [0..16): {
        probs[i] = 0x400
    }

    s1 = rd.decode-bit-tree(probs, 4)
    runner.eq(s1, 0, '全 0 位元流：位元樹解出符號 0')
    runner.lt(s1, 16, '位元樹符號落在 4 位元範圍')

    rd2 = lzma-rd{}
    rd2.init([0x00, 0x00, 0x00, 0x00, 0x00], 0)
    s2 = rd2.decode-reverse-bit-tree(probs, 4)
    runner.eq(s2, 0, '全 0 位元流：反向位元樹解出符號 0')
    runner.lt(s2, 16, '反向位元樹符號落在 4 位元範圍')
}

; ── 4. 解碼器機率表初始化 ────────────────────────────────────────────
t-init-probs = () {
    d = lzma-decoder{}
    d.init-probs()

    ; 固定長度陣列部分必須被填成 0x400（LZMA 的初始機率 1/2）
    runner.eq(d.is-match[0], 0x400, 'is-match[0] 初始化為 0x400')
    runner.eq(d.is-rep[15], 0x400, 'is-rep[15] 初始化為 0x400')
    runner.eq(d.spec-pos[127], 0x400, 'spec-pos[127] 初始化為 0x400')
    runner.eq(d.align[15], 0x400, 'align[15] 初始化為 0x400')
    runner.eq(d.literal[0x2ff], 0x400, 'literal[0x2ff] 初始化為 0x400')
}

; ── 5. 狀態機（僅驗可呼叫、狀態維持在合法 12 態內）─────────────────
; LZMA 狀態機有 12 個狀態；此處只保證不會跑出範圍（語意待 §5.2 #14 補完）
t-state = () {
    d = lzma-decoder{}
    d.init-probs()
    d.state = 0
    d.update-state-literal()
    runner.lt(d.state, 12, 'update-state-literal 後 state < 12')

    d.state = 0
    d.update-state-match()
    runner.eq(d.state, 7, 'state 0 + match → 7（LZMA 規格）')

    d.state = 0
    d.update-state-rep()
    runner.eq(d.state, 8, 'state 0 + rep → 8（LZMA 規格）')

    d.state = 0
    d.update-state-shortrep()
    runner.eq(d.state, 9, 'state 0 + shortrep → 9（LZMA 規格）')
}

; ── 6. 內部解碼入口（形狀驗證；語意見 §5.2 #14）────────────────────
t-decoder-entries = () {
    d = lzma-decoder{}
    d.init-probs()
    d.rd.init([0x00, 0x00, 0x00, 0x00, 0x00], 0)

    d.decode-literal()
    runner.gt(len(d.out), 0, 'decode-literal 產出至少 1 位元組')
    runner.lt(d.out[0], 256, 'decode-literal 產出為位元組')

    lens []i64 = with-len(0x200)
    i <- [0..0x200): {
        lens[i] = 0x400
    }
    d2 = lzma-decoder{}
    d2.init-probs()
    d2.rd.init([0x00, 0x00, 0x00, 0x00, 0x00], 0)
    ln = d2.decode-length(lens)
    runner.lt(ln, 273, 'decode-length 回傳 < 273（LZMA 最大匹配長）')

    d3 = lzma-decoder{}
    d3.init-probs()
    d3.rd.init([0x00, 0x00, 0x00, 0x00, 0x00], 0)
    dist = d3.decode-distance(2)
    runner.lt(dist, 0x100000000, 'decode-distance 回傳在 32 位元範圍')
}

; ── 7. 壓縮 / 解壓 round-trip（本模組自產自解）─────────────────────
t-roundtrip = () {
    src = 'hello hello hello world'.to-bytes()

    xo = xz.xz-compress(src)
    runner.gt(len(xo), 12, 'xz-compress 產出非空流')
    head = xo.slice(0, 6)
    runner.str-eq(head.to-hex(), 'FD377A585A00', 12, 'xz magic = FD 37 7A 58 5A 00')

    back = xz.xz-decompress(xo)
    runner.eq(len(back), 23, 'xz round-trip 長度')
    runner.str-eq(back.to-str(), 'hello hello hello world', 23, 'xz round-trip 內容')

    ; lzma2-decompress-stream：從 Block Header 之後（偏移 24）解 LZMA2 區塊
    s2 = xz.lzma2-decompress-stream(xo, 24)
    runner.eq(len(s2), 23, 'lzma2-decompress-stream 還原長度')
    runner.str-eq(s2.to-str(), 'hello hello hello world', 23, 'lzma2-decompress-stream 內容')

    ; lzma-decompress 走 LZMA1（props + dict + unpacked-size 共 13 位元組頭），
    ; 與 .xz 容器不同；短於 13 位元組時應直接回空（解碼器本身尚未完成，#14）
    s3 = xz.lzma-decompress('abc'.to-bytes())
    runner.eq(len(s3), 0, 'lzma-decompress 對短輸入回空')
}

p1 = runner.test('xz.range-init', t-range-init)
p2 = runner.test('xz.range-bits', t-range-bits)
p3 = runner.test('xz.bit-tree', t-bit-tree)
p4 = runner.test('xz.init-probs', t-init-probs)
p5 = runner.test('xz.state', t-state)
p6 = runner.test('xz.decoder-entries', t-decoder-entries)
p7 = runner.test('xz round-trip', t-roundtrip)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
