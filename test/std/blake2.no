; test/std/blake2.no — crypto/blake2 模組測試
;
; 執行：no test test/std/blake2.no
; 覆蓋：blake2.b（BLAKE2b-512）、blake2.b-256（BLAKE2b-256）、blake2.s（BLAKE2s-256）
;
; 測試向量取自 Python hashlib（hashlib.blake2b / blake2s，RFC 7693 參考實作的
; 公認向量），逐位元組對拍。
;
; ⚠️ 為何需要這份測試（2026-10-30）：blake2 過去完全沒有測試，而
; b-compress/s-compress 的工作向量 `v []u64` 未分配 ⇒ option 下標寫靜默丟失
; ⇒ 壓縮結果恆等輸入狀態 ⇒ **所有輸入得到同一個雜湊**。因為沒測試，這個
; 「雜湊退化成常數」的 bug 一直潛伏，直到 argon2 的「換 salt 輸出不變」才暴露。
; 這裡同時鎖住「不同輸入必須給出不同雜湊」，防止同類退化再發生。

# /test/runner

; 把位元組序列格式化成小寫十六進位字串（供 runner.str-eq 逐字元比對）
; data []byte: 待格式化的位元組，可為空
; hex str: 長度為 data.len()*2 的 hex 字串，每 2 字元對應一個位元組
bhex = (data []byte) (hex str) {
    hex-chars = '0123456789abcdef'
    n = data.len()

    #{overflow=wrap}
    hex str = with-len(n * 2)
    i <- [0..n): {
        ixout29c37 = data[i]: {
            ok -> it

            -> _
        }

        {

            #{overflow=wrap}
            hex[i * 2] ?= hex-chars[(ixout29c37 >> 4) & 15]
        }: {
            err -> _

            -> _
        }

        ixout32c40 = data[i]: {
            ok -> it

            -> _
        }

        {

            #{overflow=wrap}
            hex[i * 2 + 1] ?= hex-chars[ixout32c40 & 15]
        }: {
            err -> _

            -> _
        }
    }
}

; 產生固定內容的測試資料：第 i 個位元組為 i 的低 8 位
; n i64: 要產生的位元組數，為 0 時得空切片
; out []byte: 長度 n 的位元組切片（0, 1, 2, ..., 255, 0, 1, ...）
seq-bytes = (n i64) (out []byte) {
    out = with-len(n)
    i <- [0..n): {
        out[i] = i & 255
    }
}

; 空輸入：在函式內局部建（全域零長 vec 傳參會踩到 MIR 已知問題）
; out []byte: 長度 0 的位元組切片
empty-bytes = () (out []byte) {
    out = with-len(0)
}

; ---- 內部構成（狀態 / G / 旋轉 / 壓縮）的助手 ----

; u64 → 16 字元大端 hex（供 rotr64 / b-g 之類回傳純量者比對）
; x u64: 待輸出的值
; s str: 16 字元 hex
u64-hex = (x u64) (s str) {
    b []byte = with-len(8)
    j <- [0..8): {
        v = (x >> ((7 - j) * 8)) & 255
        b[j]: {
            ok -> it = v

            -> _
        }
    }
    s = bhex(b)
}

; u32 → 8 字元大端 hex
; x u32: 待輸出的值
; s str: 8 字元 hex
u32-hex = (x u32) (s str) {
    b []byte = with-len(4)
    j <- [0..4): {
        v = (x >> ((3 - j) * 8)) & 255
        b[j]: {
            ok -> it = v

            -> _
        }
    }
    s = bhex(b)
}

; []u64 的第 i 項（裸下標讀是 option，這裡收斂成純量）
; v []u64: 來源
; i i64: 索引
; x u64: 該項的值（越界時 0）
at64 = (v []u64, i i64) (x u64) {
    x = v[i]: {
        ok -> it

        -> 0
    }
}

; []u32 的第 i 項
; v []u32: 來源
; i i64: 索引
; x u32: 該項的值（越界時 0）
at32 = (v []u32, i i64) (x u32) {
    x = v[i]: {
        ok -> it

        -> 0
    }
}

; []u64 狀態 → 小端序列化 hex（BLAKE2 的輸出慣例：每個字低位在前）
; h []u64: 狀態
; n i64: 取前 n 個字
; s str: n*16 字元 hex
state64-hex = (h []u64, n i64) (s str) {
    b []byte = with-len(n * 8)
    i <- [0..n): {
        w = at64(h, i)
        j <- [0..8): {
            v = (w >> (j * 8)) & 255
            b[i * 8 + j]: {
                ok -> it = v

                -> _
            }
        }
    }
    s = bhex(b)
}

; []u32 狀態 → 小端序列化 hex
; h []u32: 狀態
; n i64: 取前 n 個字
; s str: n*8 字元 hex
state32-hex = (h []u32, n i64) (s str) {
    b []byte = with-len(n * 4)
    i <- [0..n): {
        w = at32(h, i)
        j <- [0..4): {
            v = (w >> (j * 8)) & 255
            b[i * 4 + j]: {
                ok -> it = v

                -> _
            }
        }
    }
    s = bhex(b)
}

; 長度 n 的全零位元組切片
blk = (n i64) (out []byte) {
    out = with-len(n)
    i <- [0..n): {
        out[i] = 0
    }
}

; 把 b[i] 設成 v（直接對下標賦值被 checker 擋，統一走 place-match）
setb = (b []byte, i i64, v i64) {
    b[i]: {
        ok -> it = v

        -> _
    }
}

; 空輸入向量：BLAKE2b-512 對空字串的標準雜湊
; [RFC 7693 附錄 A]
t-b-empty = () {
    runner.str-eq(bhex(blake2.b(empty-bytes())), '786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce', 128, 'blake2b-512 empty')
}

; 'abc' 向量：BLAKE2b-512 對 3 位元組輸入的標準雜湊
t-b-abc = () {
    runner.str-eq(bhex(blake2.b('abc'.to-bytes())), 'ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923', 128, 'blake2b-512 abc')
}

; 200 位元組：跨滿區塊（128）+ 尾塊，覆蓋多區塊路徑
t-b-multiblock = () {
    runner.str-eq(bhex(blake2.b(seq-bytes(200))), 'fb3c1f0f56a56f8e316fdf5d853c8c872c39635d083634c3904fc3ac07d1b578e85ff0e480e92d44ade33b62e893ee32343e79ddf6ef292e89b582d312502314', 128, 'blake2b-512 200B multiblock')
}

; 截斷輸出：BLAKE2b-256（參數化輸出長度）對 'abc' 的向量
t-b-256 = () {
    runner.str-eq(bhex(blake2.b-256('abc'.to-bytes())), 'bddd813c634239723171ef3fee98579b94964e3bb1cb3e427262c8c068d52319', 64, 'blake2b-256 abc')
}

; 'abc' 向量：BLAKE2s-256（32 位元字版本）對 3 位元組輸入的標準雜湊
t-s-abc = () {
    runner.str-eq(bhex(blake2.s('abc'.to-bytes())), '508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982', 64, 'blake2s-256 abc')
}

; 空輸入向量：BLAKE2s-256 對空字串的標準雜湊
t-s-empty = () {
    runner.str-eq(bhex(blake2.s(empty-bytes())), '69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9', 64, 'blake2s-256 empty')
}

; 輸入敏感性：不同輸入必須給出不同雜湊（防止「壓縮退化成常數」回歸）
t-input-sensitive = () {
    h0 = bhex(blake2.b(empty-bytes()))
    h1 = bhex(blake2.b('a'.to-bytes()))
    h2 = bhex(blake2.b('b'.to-bytes()))
    runner.is-false(h0.eq(h1, 128), 'blake2b differs: empty vs a')
    runner.is-false(h1.eq(h2, 128), 'blake2b differs: a vs b')
}

; hex 便利函式與位元組輸出一致
t-hex-api = () {
    runner.str-eq(blake2.b-hex('abc'.to-bytes()), 'ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923', 128, 'blake2.b-hex abc')
    runner.str-eq(blake2.s-hex('abc'.to-bytes()), '508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982', 64, 'blake2.s-hex abc')
}

; ---- 內部構成 ----

; 64-bit / 32-bit 循環右移：BLAKE2b 用 32/24/16/63，BLAKE2s 用 16/12/8/7
t-rotr64 = () {
    runner.str-eq(u64-hex(blake2.rotr64(0x0123456789abcdef, 8)), 'ef0123456789abcd', 16, 'rotr64 8')
    runner.str-eq(u64-hex(blake2.rotr64(0x0123456789abcdef, 32)), '89abcdef01234567', 16, 'rotr64 32')
    runner.str-eq(u64-hex(blake2.rotr64(0x0123456789abcdef, 63)), '02468acf13579bde', 16, 'rotr64 63 = 左轉 1')
    runner.str-eq(u64-hex(blake2.rotr64(0xffffffffffffffff, 63)), 'ffffffffffffffff', 16, 'rotr64 63 全 1')

    ; ⚠️ 已知語言陷阱（2026-11-10 實測）：把 > i64.MAX 的字面量**直接**當 u64 實參傳，
    ; 位元樣式雖然正確，但移位/比較仍按 i64 求值 ⇒ `x >> 1` 變成算術右移
    ; （rotr64(0x8000000000000000, 1) 得 c000000000000000 而非 4000000000000000），
    ; `0x8000000000000000 > 0` 也回 false。先落 `u64` 區域變數即恢復正確語意。
    top u64 = 0x8000000000000000
    runner.str-eq(u64-hex(top), '8000000000000000', 16, 'u64 高位字面量')
    runner.str-eq(u64-hex(blake2.rotr64(top, 1)), '4000000000000000', 16, 'rotr64 1 最高位')
    runner.str-eq(u64-hex(blake2.rotr64(0x0000000000000001, 1)), '8000000000000000', 16, 'rotr64 1 最低位回捲')
}

t-rotr32 = () {
    runner.str-eq(u32-hex(blake2.rotr32(0x01234567, 16)), '45670123', 8, 'rotr32 16')
    runner.str-eq(u32-hex(blake2.rotr32(0x01234567, 12)), '56701234', 8, 'rotr32 12')
    runner.str-eq(u32-hex(blake2.rotr32(0x01234567, 8)), '67012345', 8, 'rotr32 8')
    runner.str-eq(u32-hex(blake2.rotr32(0x00000001, 1)), '80000000', 8, 'rotr32 1 最低位回捲')
    runner.str-eq(u32-hex(blake2.rotr32(0x80000000, 1)), '40000000', 8, 'rotr32 1 最高位')
}

; G 混合函數：v = 1..16，對 (0,4,8,12) 做一次 b-g。
; 金標由 python 依 RFC 7693 G 定義（加法 mod 2^64 + 右轉 32/24/16/63）算出。
t-b-g = () {
    v []u64 = with-len(16)
    i <- [0..16): {
        v[i]: {
            ok -> it = i + 1

            -> _
        }
    }
    blake2.b-g(v, 0, 4, 8, 12, 0x0123456789abcdef, 0xfedcba9876543210)

    runner.str-eq(u64-hex(at64(v, 0)), '23457589abcdf806', 16, 'b-g v[a]')
    runner.str-eq(u64-hex(at64(v, 4)), 'c8901ade24b210be', 16, 'b-g v[b]')
    runner.str-eq(u64-hex(at64(v, 8)), '470d78e6b994f05e', 16, 'b-g v[c]')
    runner.str-eq(u64-hex(at64(v, 12)), 'bd61aaeeb871aaee', 16, 'b-g v[d]')

    ; 未參與的槽必須原封不動
    runner.str-eq(u64-hex(at64(v, 1)), '0000000000000002', 16, 'b-g 不動 v[1]')
    runner.str-eq(u64-hex(at64(v, 15)), '0000000000000010', 16, 'b-g 不動 v[15]')
}

; G 混合函數（32 位元版）：右轉 16/12/8/7
t-s-g = () {
    v []u32 = with-len(16)
    i <- [0..16): {
        v[i]: {
            ok -> it = i + 1

            -> _
        }
    }
    blake2.s-g(v, 0, 4, 8, 12, 0x01234567, 0xfedcba98)

    runner.str-eq(u32-hex(at32(v, 0)), '12945605', 8, 's-g v[a]')
    runner.str-eq(u32-hex(at32(v, 4)), '06f24747', 8, 's-g v[b]')
    runner.str-eq(u32-hex(at32(v, 8)), '6bb7f583', 8, 's-g v[c]')
    runner.str-eq(u32-hex(at32(v, 12)), '2657f457', 8, 's-g v[d]')

    runner.str-eq(u32-hex(at32(v, 1)), '00000002', 8, 's-g 不動 v[1]')
    runner.str-eq(u32-hex(at32(v, 15)), '00000010', 8, 's-g 不動 v[15]')
}

; 初始狀態：必須是 IV 的**獨立拷貝**（改動回傳值不得污染常數表）
t-b-state = () {
    h = blake2.b-state()
    runner.eq(h.len(), 8, 'b-state 長度 8')
    runner.str-eq(u64-hex(at64(h, 0)), '6a09e667f3bcc908', 16, 'b-state[0] = IV[0]')
    runner.str-eq(u64-hex(at64(h, 7)), '5be0cd19137e2179', 16, 'b-state[7] = IV[7]')

    h[0]: {
        ok -> it = 0

        -> _
    }
    h2 = blake2.b-state()
    runner.str-eq(u64-hex(at64(h2, 0)), '6a09e667f3bcc908', 16, 'b-state 每次回新拷貝')
}

t-s-state = () {
    h = blake2.s-state()
    runner.eq(h.len(), 8, 's-state 長度 8')
    runner.str-eq(u32-hex(at32(h, 0)), '6a09e667', 8, 's-state[0] = IV[0]')
    runner.str-eq(u32-hex(at32(h, 7)), '5be0cd19', 8, 's-state[7] = IV[7]')

    h[0]: {
        ok -> it = 0

        -> _
    }
    h2 = blake2.s-state()
    runner.str-eq(u32-hex(at32(h2, 0)), '6a09e667', 8, 's-state 每次回新拷貝')
}

; 壓縮函數：手動複製 b() 的序言（h[0] ^= 0x01010040），壓一個 'abc' 尾塊。
; 終態按小端序列化後應等於 BLAKE2b-512("abc") 的雜湊值。
t-b-compress = () {
    h = blake2.b-state()
    w = at64(h, 0)
    h[0]: {
        ok -> it = w ^ 16842816

        -> _
    }
    b = blk(128)
    setb(b, 0, 97)
    setb(b, 1, 98)
    setb(b, 2, 99)
    blake2.b-compress(h, b, 3, 1)
    runner.str-eq(state64-hex(h, 8), 'ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923', 128, 'b-compress abc 終態 = blake2b-512')

    ; last 旗標（v[14] ^= ~0）必須真的改變結果
    h2 = blake2.b-state()
    w2 = at64(h2, 0)
    h2[0]: {
        ok -> it = w2 ^ 16842816

        -> _
    }
    blake2.b-compress(h2, b, 3, 0)
    s-notlast = state64-hex(h2, 8)
    s-last = state64-hex(h, 8)
    runner.is-false(s-notlast.eq(s-last, 128), 'b-compress last 旗標有生效')

    ; 計數器 t 進入 v[12]，改變它必須改變結果
    h3 = blake2.b-state()
    w3 = at64(h3, 0)
    h3[0]: {
        ok -> it = w3 ^ 16842816

        -> _
    }
    blake2.b-compress(h3, b, 4, 1)
    s-t4 = state64-hex(h3, 8)
    runner.is-false(s-t4.eq(s-last, 128), 'b-compress 計數器 t 有生效')
}

t-s-compress = () {
    h = blake2.s-state()
    w = at32(h, 0)
    h[0]: {
        ok -> it = w ^ 16842784

        -> _
    }
    b = blk(64)
    setb(b, 0, 97)
    setb(b, 1, 98)
    setb(b, 2, 99)
    blake2.s-compress(h, b, 3, 1)
    runner.str-eq(state32-hex(h, 8), '508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982', 64, 's-compress abc 終態 = blake2s-256')

    h2 = blake2.s-state()
    w2 = at32(h2, 0)
    h2[0]: {
        ok -> it = w2 ^ 16842784

        -> _
    }
    blake2.s-compress(h2, b, 3, 0)
    s-notlast = state32-hex(h2, 8)
    s-last = state32-hex(h, 8)
    runner.is-false(s-notlast.eq(s-last, 64), 's-compress last 旗標有生效')
}

; b-256-hex：BLAKE2b 參數化輸出 32 位元組的 hex 便利函式
t-b-256-hex = () {
    runner.str-eq(blake2.b-256-hex('abc'.to-bytes()), 'bddd813c634239723171ef3fee98579b94964e3bb1cb3e427262c8c068d52319', 64, 'b-256-hex abc')
    runner.str-eq(blake2.b-256-hex(empty-bytes()), '0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8', 64, 'b-256-hex empty')
}
p1 = runner.test('blake2.b-empty', t-b-empty)
p2 = runner.test('blake2.b-abc', t-b-abc)
p3 = runner.test('blake2.b-multiblock', t-b-multiblock)
p4 = runner.test('blake2.b-256', t-b-256)
p5 = runner.test('blake2.s-abc', t-s-abc)
p6 = runner.test('blake2.s-empty', t-s-empty)
p7 = runner.test('blake2.input-sensitive', t-input-sensitive)
p8 = runner.test('blake2.hex-api', t-hex-api)
p9 = runner.test('blake2.rotr64', t-rotr64)
p10 = runner.test('blake2.rotr32', t-rotr32)
p11 = runner.test('blake2.b-g', t-b-g)
p12 = runner.test('blake2.s-g', t-s-g)
p13 = runner.test('blake2.b-state', t-b-state)
p14 = runner.test('blake2.s-state', t-s-state)
p15 = runner.test('blake2.b-compress', t-b-compress)
p16 = runner.test('blake2.s-compress', t-s-compress)
p17 = runner.test('blake2.b-256-hex', t-b-256-hex)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
