; test/std/ed25519.no — crypto/ed25519 模組測試（RFC 8032 §7.1 金標向量）
;
; 執行：no test test/std/ed25519.no
; 覆蓋：ed25519-publickey / ed25519-sign / ed25519-verify
;       （含 sc-reduce、sc-muladd mod L、extended 座標純量乘法、點壓縮/解壓）
; 向量來源：RFC 8032 §7.1 TEST 1（空訊息）、TEST 2（訊息 0x72）
;   本模組先前為未完成 stub（點緩衝未預配置、基點/d 常數錯誤、sc-reduce 不正確），
;   已依 RFC 重寫並通過全部官方向量。

# /test/runner

hex-chars str = '0123456789abcdef'

; 小端位元組陣列 → hex 字串（逐字元建構，避免格式化補零問題）
bhex = (data []byte) (hex str) {
    n = data.len()

    #{overflow=wrap}
    hex = with-len(n * 2)
    i <- [0..n): {

        #{index-out=zero, overflow=wrap}
        hex[i * 2] = hex-chars[(data[i] >> 4) & 15]

        #{index-out=zero, overflow=wrap}
        hex[i * 2 + 1] = hex-chars[data[i] & 15]
    }
}

arr64 = (a [64]byte) (v []byte) {
    v = with-len(64)
    i <- [0..64): {

        #{index-out=zero}
        v[i] = a[i]
    }
}

arr32 = (a [32]byte) (v []byte) {
    v = with-len(32)
    i <- [0..32): {

        #{index-out=zero}
        v[i] = a[i]
    }
}
seed1 [32]byte = [
    0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60,
    0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4,
    0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19,
    0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60,
]

; TEST 1：空訊息
t-test1 = () {
    msg []byte = with-len(0)
    pub = ed25519.ed25519-publickey(seed1)
    runner.str-eq(bhex(arr32(pub)), 'd75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a', 64, 'T1 publickey')
    sig = ed25519.ed25519-sign(seed1, msg)
    runner.str-eq(bhex(arr64(sig)), 'e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b', 128, 'T1 signature')
    ok = ed25519.ed25519-verify(pub, msg, sig)
    runner.eq(ok, 1, 'T1 verify own signature')
}
seed2 [32]byte = [
    0x4c, 0xcd, 0x08, 0x9b, 0x28, 0xff, 0x96, 0xda,
    0x9d, 0xb6, 0xc3, 0x46, 0xec, 0x11, 0x4e, 0x0f,
    0x5b, 0x8a, 0x31, 0x9f, 0x35, 0xab, 0xa6, 0x24,
    0xda, 0x8c, 0xf6, 0xed, 0x4f, 0xb8, 0xa6, 0xfb,
]

; TEST 2：訊息 = 0x72
t-test2 = () {
    msg []byte = with-len(1)
    msg[0] = 0x72
    pub = ed25519.ed25519-publickey(seed2)
    runner.str-eq(bhex(arr32(pub)), '3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c', 64, 'T2 publickey')
    sig = ed25519.ed25519-sign(seed2, msg)
    runner.str-eq(bhex(arr64(sig)), '92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00', 128, 'T2 signature')

    ok = ed25519.ed25519-verify(pub, msg, sig)
    runner.eq(ok, 1, 'T2 verify own signature')
}

; 竄改偵測：改動簽名末位元組 → 驗證必須失敗（回 0）
t-tamper = () {
    msg []byte = with-len(0)
    pub = ed25519.ed25519-publickey(seed1)
    sig = ed25519.ed25519-sign(seed1, msg)

    bad [64]byte
    i <- [0..64): {

        #{index-out=zero}
        bad[i] = sig[i]
    }
    bad[63] = bad[63] ^ 0x01
    ok = ed25519.ed25519-verify(pub, msg, bad)
    runner.eq(ok, 0, 'tampered signature rejected')

    ; 改動訊息也必須導致驗證失敗
    msg2 []byte = with-len(1)
    msg2[0] = 0x00
    ok2 = ed25519.ed25519-verify(pub, msg2, sig)
    runner.eq(ok2, 0, 'wrong message rejected')
}

p1 = runner.test('ed25519.rfc8032.test1', t-test1)
p2 = runner.test('ed25519.rfc8032.test2', t-test2)
p3 = runner.test('ed25519.tamper', t-tamper)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)

    -> os.exit(0)
}
