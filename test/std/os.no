; std-os.no — os 模組測試
;
; 執行：no test test/std/os.no
; 覆蓋：get-env / set-env / get-wd / ch-dir / mkdir / get-pid / host-name /
;       get-arch / strerror / get-errno / ch-mod / chown /
;       getuid / getgid / geteuid / getegid / getgroups / sysconf / num-cpu /
;       uname / signal / ttyname / stat-mode / stat-uid / stat-gid / stat-mtime /
;       get-login / get-host-id / get-priority / set-priority / flock / sysctl /
;       get-domain-name / now / now-ms / now-us / now-ns / sleep / sleep-us / sleep-ns
;
; ⚠ 刻意不測（環境/安全性理由，非遺漏）：
;   chroot   —— 非 root 必失敗；若哪天以 root 跑測試會真的改根目錄，太危險。
;   set-sid  —— setsid() 會讓測試進程脫離終端與原 session，影響跑測器的終端。
;   syslog   —— 每次跑測試都往系統日誌寫垃圾。
;   win-find-first-file / win-find-next-file / win-find-close / win-wsa-startup
;            —— 非 Windows 平台連編譯都過不了（`EmitLLVM: unsupported builtin`）。
;
; 只有 sleep 系與 ch-dir 會動到進程狀態：sleep 用毫秒級，ch-dir 測完立刻切回原 wd。

# /test/runner

OS-FILE = '/tmp/nolang_os_test_file.txt'
OS-DIR = '/tmp/nolang_os_test_dir'

; ── 環境變數 ──────────────────────────────────

; set-env 之後 get-env 應讀回剛寫入的 'xyz'
t-get-env = () {
    os.set-env('NOLANG_OS_TEST', 'xyz')
    val = os.get-env('NOLANG_OS_TEST')
    got = ''
    val: {
        ok -> got = it

        nil -> got = ''

        err -> got = ''
    }
    runner.str-eq(got, 'xyz', 3, 'get-env after set-env')
}

; 未設定的變數應回 nil（而非空字串）
t-get-env-unset = () {
    val = os.get-env('NOLANG_NONEXISTENT_GETENV')
    is-nil = false
    val: {
        ok -> is-nil = false

        nil -> is-nil = true

        err -> is-nil = false
    }
    runner.is-true(is-nil, 'get-env unset == nil')
}

; ── 工作目錄 ──────────────────────────────────

; get-wd 應回非空的工作目錄路徑
t-get-wd = () {
    dir = os.get-wd()
    runner.gt(dir.len(), 0, 'get-wd len > 0')
}

; ── 進程 ──────────────────────────────────────

; get-pid 應為正整數（當前進程號）
t-get-pid = () {
    pid = os.get-pid()
    runner.gt(pid, 0, 'get-pid > 0')
}

; ── 系統資訊 ──────────────────────────────────

; host-name 應回非空主機名
t-host-name = () {
    name = os.host-name()
    runner.gt(name.len(), 0, 'host-name len > 0')
}

; num-cpu 應回可用的 CPU 數，至少為 1
t-num-cpu = () {
    n = os.num-cpu()
    runner.gt(n, 0, 'num-cpu > 0')
}

; ── 行程優先級（?i64 option）──────────────────

; get-priority：應解出 ok，且 nice 值落在合法範圍 -20..19
t-get-priority = () {
    prio-opt = os.get-priority(0, 0)
    found = false
    prio = 0
    prio-opt: {
        ok -> {
            found = true
            prio = it
        }

        -> found = false
    }
    runner.is-true(found, 'get-priority returns ok')
    runner.is-true(prio >= -20 && prio <= 19, 'get-priority in nice range')
}

; ── 輔助 ──────────────────────────────────────

; ?str 解包：非 ok 回空串
; o: 待解包的可選字串
; v: 解包值
str-of = (o ?str) (v str) {
    v = ''
    v = o: {
        ok -> it

        -> ''
    }
}

; ?i64 解包：非 ok 回 -999
; o: 待解包的可選整數
; v: 解包值
num-of = (o ?i64) (v i64) {
    v = -999
    v = o: {
        ok -> it

        -> -999
    }
}

; i64 乘法（避開 a * b 回 ?i64 的賦值限制）
; a: 被乘數
; b: 乘數
; v: 乘積（溢出時回 0）
mul = (a i64, b i64) (v i64) {
    v = 0
    p = a * b
    v = p: {
        ok -> it

        -> 0
    }
}

; ── 身份 / 系統資訊 ──────────────────────────

t-ids = () {
    runner.is-true(os.getuid() >= 0, 'getuid 非負')
    runner.is-true(os.getgid() >= 0, 'getgid 非負')
    runner.eq(os.geteuid(), os.getuid(), 'geteuid == getuid（無 setuid 時）')
    runner.eq(os.getegid(), os.getgid(), 'getegid == getgid')

    gids, n = os.getgroups()
    runner.is-true(n > 0, 'getgroups 至少 1 個群組')
    runner.is-true(gids.len() >= n, 'getgroups 回傳的 vec 至少 n 個')
}

t-sysinfo = () {
    a = os.get-arch()
    runner.is-true(a.len() > 0, 'get-arch 非空')

    u = os.uname()
    runner.is-true(u.sysname.len() > 0, 'uname.sysname 非空')
    runner.is-true(u.release.len() > 0, 'uname.release 非空')
    runner.is-true(u.machine.eq-full(a), 'uname.machine == get-arch')

    ; _SC_NPROCESSORS_ONLN：macOS=58 / Linux=84，兩邊都應 > 0
    cpu = 58
    u.sysname.eq-full('Linux') -> cpu = 84
    runner.is-true(os.sysconf(cpu) > 0, 'sysconf(NPROCESSORS_ONLN) > 0')
    runner.eq(os.sysconf(9999), -1, 'sysconf 未知項目回 -1')

    ; 名稱類：只要不崩、型別正確即可（內容依環境而異）
    runner.is-true(os.get-login().len() >= 0, 'get-login 可呼叫')
    runner.is-true(os.get-host-id() >= 0, 'get-host-id 非負')
    runner.is-true(os.get-domain-name().len() >= 0, 'get-domain-name 可呼叫')

    ; ttyname：fd 99 一定不是終端 ⇒ 空字串
    runner.eq(os.ttyname(99).len(), 0, 'ttyname(99) 回空字串')
}

t-strerror-errno = () {
    runner.is-true(os.strerror(2).len() > 0, 'strerror(2) 非空（ENOENT）')
    runner.is-true(os.get-errno() >= 0, 'get-errno 非負')
    runner.is-true(os.strerror(0).len() > 0, 'strerror(0) 非空')
}

t-signal = () {

    ; SIGPIPE(13)：Linux 與 Darwin 同值；先設 IGN 再還原，回傳前值
    prev = os.signal(13, 1)
    runner.is-true(prev >= 0, 'signal(13, IGN) 回前值')
    back = os.signal(13, 0)
    runner.is-true(back >= 0, 'signal(13, DFL) 還原成功')
}

t-sysctl = () {
    u = os.uname()
    u.sysname.eq-full('Darwin') -> {
        runner.is-true(str-of(os.sysctl('kern.osrelease')).len() > 0, 'sysctl kern.osrelease 有值')
    }
    runner.eq(str-of(os.sysctl('no.such.key')).len(), 0, 'sysctl 不存在的 key 回 nil')
}

; ── 時間 ──────────────────────────────────────

t-clock = () {
    s = os.now()
    ms = os.now-ms()
    us = os.now-us()
    ns = os.now-ns()
    runner.is-true(s > 1000000000, 'now 在 2001 年之後')
    runner.is-true(ms >= mul(s, 1000), 'now-ms 是 epoch 毫秒')
    runner.is-true(ms < mul(s + 5, 1000), 'now-ms 與 now 同秒級')
    runner.is-true(us >= mul(ms, 1000), 'now-us 是 epoch 微秒')
    runner.is-true(us < mul(ms + 5, 1000), 'now-us 與 now-ms 同毫秒級')
    runner.is-true(ns >= mul(us, 1000), 'now-ns 是 epoch 奈秒')
    runner.is-true(ns < mul(us + 5, 1000), 'now-ns 與 now-us 同微秒級')
}

t-sleep = () {
    runner.eq(os.sleep(0), 0, 'sleep(0) 立即返回')
    os.sleep-us(1000)
    os.sleep-ns(1000000)
    runner.is-true(true, 'sleep-us / sleep-ns 可呼叫')
}

; ── 檔案屬性 / 權限 ──────────────────────────

t-stat = () {
    fs.remove(OS-FILE)
    fs.write-file(OS-FILE, 'x')
    runner.eq(num-of(os.stat-uid(OS-FILE)), os.getuid(), 'stat-uid == getuid')
    runner.is-true(num-of(os.stat-gid(OS-FILE)) >= 0, 'stat-gid 非負')
    runner.eq(num-of(os.stat-mode(OS-FILE)), 33188, 'stat-mode == 0o100644')
    runner.is-true(num-of(os.stat-mtime(OS-FILE)) > 1600000000, 'stat-mtime 是 epoch 秒')
    runner.eq(num-of(os.stat-mode('/tmp/nolang_os_no_such')), -999, 'stat-mode 不存在回 nil')

    runner.is-true(os.ch-mod(OS-FILE, 384), 'ch-mod 改成 0600')
    runner.eq(num-of(os.stat-mode(OS-FILE)), 33152, 'ch-mod 後 stat-mode == 0o100600')
    runner.is-true(os.chown(OS-FILE, os.getuid(), os.getgid()), 'chown 給自己成功')
    runner.is-false(os.chown(OS-FILE, 99999999, 99999999), 'chown 給不存在 uid 失敗')

    fd = fs.open-read(OS-FILE)
    runner.is-true(fd >= 0, 'open-read 取 fd')
    runner.is-true(os.flock(fd, 2), 'flock 加排他鎖')
    runner.is-true(os.flock(fd, 8), 'flock 解鎖')
    fd >= 0 -> fs.close(fd)

    runner.is-true(os.set-priority(0, 0, 0), 'set-priority 設回預設 nice')
    fs.remove(OS-FILE)
}

; ── 目錄 / 工作目錄 ──────────────────────────

t-dir-ops = () {
    fs.rmdir(OS-DIR)
    runner.is-true(os.mkdir(OS-DIR, 493), 'mkdir 建立目錄')
    runner.is-false(os.mkdir(OS-DIR, 493), 'mkdir 已存在回 false')
    runner.is-true(fs.is-dir(OS-DIR), 'mkdir 結果是目錄')

    wd = os.get-wd()
    runner.is-true(wd.len() > 0, 'get-wd 非空')
    runner.is-true(os.ch-dir(OS-DIR), 'ch-dir 切換成功')
    runner.is-true(os.get-wd().eq-full(fs.realpath(OS-DIR)), 'ch-dir 後 wd 是目標目錄')
    runner.is-true(os.ch-dir(wd), 'ch-dir 切回原 wd')
    runner.is-false(os.ch-dir('/no/such/dir'), 'ch-dir 不存在路徑回 false')

    fs.rmdir(OS-DIR)
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('os.get-env', t-get-env)
p2, f2 = runner.test('os.get-wd', t-get-wd)
p3, f3 = runner.test('os.get-pid', t-get-pid)
p4, f4 = runner.test('os.host-name', t-host-name)
p5, f5 = runner.test('os.num-cpu', t-num-cpu)
p6, f6 = runner.test('os.get-env-unset', t-get-env-unset)
p7, f7 = runner.test('os.get-priority', t-get-priority)
p8, f8 = runner.test('os.ids', t-ids)
p9, f9 = runner.test('os.sysinfo', t-sysinfo)
p10, f10 = runner.test('os.strerror-errno', t-strerror-errno)
p11, f11 = runner.test('os.signal', t-signal)
p12, f12 = runner.test('os.sysctl', t-sysctl)
p13, f13 = runner.test('os.clock', t-clock)
p14, f14 = runner.test('os.sleep', t-sleep)
p15, f15 = runner.test('os.stat', t-stat)
p16, f16 = runner.test('os.dir-ops', t-dir-ops)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
