; std-number.no — number / num 模組測試（含 math 的 max/min 泛型入口）
;
; 執行：no test test/std/number.no
; 覆蓋：max / min（math 模組）/ abs（num 模組，方法）/ even / odd / gcd / lcm / pow / div / mod /
;       i64-to-str / u64-to-str / f64-to-str / swap
; 未測：sign / clamp / is-nan / is-inf / swap（num/float 泛型特化問題，預存 codegen bug；
;       num 零參方法僅能以裸函數形式 abs(x)/sign(x) 調用，`x.abs()` 點式尚未支持）

# /test/runner

; ── 基本數值操作 ──────────────────────────────

; max / min 是變參泛型（`a ..num`），兩種調用形態都要對：
;   - LHS 形態 `v = math.max(p, q)`：每個引數都是 spread 元素
;   - 語句形態 `math.max(1, 2, r)`：尾隨引數是輸出參數（見 tests/number.no）
;  尾隨引數為 ident 時特別關鍵：曾被誤判成輸出參數，
;  害 spread 少一個元素、結果又被寫進調用方的變數。
t-max-min = () {
    a i64 = math.max(3, 7)
    runner.eq(a, 7, 'max(3,7) == 7')
    b i64 = math.min(3, 7)
    runner.eq(b, 3, 'min(3,7) == 3')

    ; 尾隨引數為 ident 的 LHS 形態
    p = 3
    q = 7
    c i64 = math.max(p, q)
    runner.eq(c, 7, 'max(p,q) == 7')
    d i64 = math.min(p, q)
    runner.eq(d, 3, 'min(p,q) == 3')

    ; q 必須還是 7：結果不得被寫回尾隨 spread 元素
    runner.eq(q, 7, 'max(p,q) leaves q untouched')

    ; 多於兩個元素
    e i64 = math.max(3, 1, 4, 1, 5)
    runner.eq(e, 5, 'max(3,1,4,1,5) == 5')
    g i64 = math.min(3, 1, 4, 1, 5)
    runner.eq(g, 1, 'min(3,1,4,1,5) == 1')

    ; f64 單態化：比較不得退化成整數截斷
    x = 1.5
    y = 2.25
    fx f64 = math.max(x, y)
    runner.f64-eq(fx, 2.25, 0.000001, 'max(1.5,2.25) == 2.25')
    fy f64 = math.min(x, y)
    runner.f64-eq(fy, 1.5, 0.000001, 'min(1.5,2.25) == 1.5')
    fz f64 = math.max(0.1, 0.3, 0.2)
    runner.f64-eq(fz, 0.3, 0.000001, 'max(0.1,0.3,0.2) == 0.3')
}

; 驗證 abs：負數取正、零與正數原樣（裸函數形式調用，點式 x.abs() 尚未支持）
t-abs = () {

    #{overflow=wrap}
    a i64 = abs(0 - 5)
    runner.eq(a, 5, 'abs(-5) == 5')
    b i64 = abs(3)
    runner.eq(b, 3, 'abs(3) == 3')
    c i64 = abs(0)
    runner.eq(c, 0, 'abs(0) == 0')
}

; 驗證 math.even / math.odd：偶數對 even 回 true、奇數對 odd 回 true，兩者互斥
t-even-odd = () {
    yes1 = math.even(4)
    runner.is-true(yes1, 'even(4) == true')
    no1 = math.even(3)
    runner.is-false(no1, 'even(3) == false')
    yes2 = math.odd(3)
    runner.is-true(yes2, 'odd(3) == true')
    no2 = math.odd(4)
    runner.is-false(no2, 'odd(4) == false')
}

; 驗證 math.gcd：12 與 8 的最大公因數為 4，互質數對回 1，gcd(0, n) 等於 n
t-gcd = () {
    g i64 = math.gcd(12, 8)
    runner.eq(g, 4, 'gcd(12,8) == 4')
    g2 i64 = math.gcd(7, 5)
    runner.eq(g2, 1, 'gcd(7,5) == 1')
    g3 i64 = math.gcd(0, 5)
    runner.eq(g3, 5, 'gcd(0,5) == 5')
}

; 驗證 math.lcm：4 與 6 的最小公倍數為 12，互質數對得兩數之積，任一為 0 則結果為 0
t-lcm = () {
    l i64 = math.lcm(4, 6)
    runner.eq(l, 12, 'lcm(4,6) == 12')
    l2 i64 = math.lcm(3, 5)
    runner.eq(l2, 15, 'lcm(3,5) == 15')
    l3 i64 = math.lcm(0, 5)
    runner.eq(l3, 0, 'lcm(0,5) == 0')
}

; 驗證 number.pow：整數冪運算（2^10=1024、3^3=27），任意數的 0 次方回 1
t-pow = () {
    r = number.pow(2, 10)
    runner.eq(r, 1024, 'pow(2,10) == 1024')
    r2 = number.pow(3, 3)
    runner.eq(r2, 27, 'pow(3,3) == 27')
    r3 = number.pow(5, 0)
    runner.eq(r3, 1, 'pow(5,0) == 1')
}

; 驗證 math.div / math.mod：負運算元服從向零截斷語義（-7 div 2 = -3、-7 mod 2 = -1）
t-div-mod = () {
    q i64 = math.div(7, 3)
    runner.eq(q, 2, 'div(7,3) == 2')
    r i64 = math.mod(7, 3)
    runner.eq(r, 1, 'mod(7,3) == 1')
    q2 i64 = math.div(-7, 2)
    runner.eq(q2, -3, 'div(-7,2) == -3')
    r2 i64 = math.mod(-7, 2)
    runner.eq(r2, -1, 'mod(-7,2) == -1')
}

; ── 整數轉字串 ────────────────────────────────
t-i64-to-str = () {
    v42 = 42
    s = v42.to-str()
    runner.eq(s.len-bytes(), 2, 'i64-to-str 42 len')
    runner.str-eq(s, '42', 2, 'i64-to-str 42 content')
    vn = -456
    n = vn.to-str()
    runner.eq(n.len-bytes(), 4, 'i64-to-str -456 len')
    runner.str-eq(n, '-456', 4, 'i64-to-str -456 content')
    v0 = 0
    z = v0.to-str()
    runner.eq(z.len-bytes(), 1, 'i64-to-str 0 len')
    runner.str-eq(z, '0', 1, 'i64-to-str 0 content')
}

; 驗證 i64 變數.to-str() 方法形態：正數、負數（帶負號）與零都轉出精確十進位字串
t-i64-method-to-str = () {
    v = 123
    s = v.to-str()
    runner.eq(s.len-bytes(), 3, 'i64.to-str 123 len')
    runner.str-eq(s, '123', 3, 'i64.to-str 123 content')

    #{overflow=wrap}
    n = 0 - 789
    ns = n.to-str()
    runner.eq(ns.len-bytes(), 4, 'i64.to-str -789 len')
    runner.str-eq(ns, '-789', 4, 'i64.to-str -789 content')
}

; 驗證 u64.to-str()：255 與 0 轉十進位字串，無符號故永不帶負號
t-u64-to-str = () {
    u255 u64 = 255
    s = u255.to-str()
    runner.eq(s.len(), 3, 'u64-to-str 255 len')
    runner.str-eq(s, '255', 3, 'u64-to-str 255 content')
    u0 u64 = 0
    z = u0.to-str()
    runner.eq(z.len(), 1, 'u64-to-str 0 len')
    runner.str-eq(z, '0', 1, 'u64-to-str 0 content')
}

; ── 浮點轉字串 ────────────────────────────────
t-f64-to-str = () {
    f314 = 3.14
    s = f314.to-str()
    runner.str-eq(s, '3.14', 4, 'f64-to-str 3.14')
    f0 = 0.0
    z = f0.to-str()
    runner.str-eq(z, '0', 1, 'f64-to-str 0.0')
}

; 驗證 f64 變數.to-str()：2.5 轉為最短十進位表示的字串 2.5
t-f64-method-to-str = () {
    v = 2.5
    s = v.to-str()
    runner.str-eq(s, '2.5', 3, 'f64.to-str 2.5')
}

; ── 128 位範圍常數（i128/u128）──────────────────
; 取值經 hir2mir 的 typeConstantText128 常數表（i128 lane 全精度十進位），
; 以 .to-str() 斷言精確位元組長度與內容。128 位算術已打通（見下方 sqrt/is-prime 測試）。
t-int128-range-const = () {
    a = i128.MAX
    runner.str-eq(a.to-str(), '170141183460469231731687303715884105727', 39, 'i128.MAX')
    b = i128.MIN
    runner.str-eq(b.to-str(), '-170141183460469231731687303715884105728', 40, 'i128.MIN')
    c = u128.MAX
    runner.str-eq(c.to-str(), '340282366920938463463374607431768211455', 39, 'u128.MAX')
    d = u128.MIN
    runner.str-eq(d.to-str(), '0', 1, 'u128.MIN')

    ; 邊界比較（已打通能力）
    x i128 = i128.MAX
    y i128 = i128.MIN
    runner.eq(x > y ? 1 : 0, 1, 'i128 MAX > MIN')
}

; ── 128 位 sqrt / is-prime（i128/u128）──────────
; 區區要點：運算元顯式標型、溢出註解獨立成行、多行 guard（單行 `;` 串接
; 會觸發 128 位 codegen 丟棄 main）。結果常超 i64 值域，以 .to-str() 斷言。
t-int128-sqrt = () {
    imax i128 = i128.MAX
    s1 = imax.sqrt()
    runner.str-eq(s1.to-str(), '13043817825332782212', 20, 'i128.MAX.sqrt')

    imin i128 = i128.MIN
    s2 = imin.sqrt()
    runner.str-eq(s2.to-str(), '0', 1, 'i128.MIN.sqrt (負數 -> 0)')

    t124 i128 = 1000000000000000000000000
    s3 = t124.sqrt()
    runner.str-eq(s3.to-str(), '1000000000000', 13, 'i128.1e24.sqrt')

    umax u128 = u128.MAX
    s4 = umax.sqrt()
    runner.str-eq(s4.to-str(), '18446744073709551615', 20, 'u128.MAX.sqrt (= 2^64-1)')

    u124 u128 = 1000000000000000000000000
    s5 = u124.sqrt()
    runner.str-eq(s5.to-str(), '1000000000000', 13, 'u128.1e24.sqrt')
}

; 驗證 i128/u128 .is-prime()：97 與 1000003 判為質數，100 與 1e18 判為合數
t-int128-is-prime = () {
    p97 i128 = 97
    runner.is-true(p97.is-prime(), 'i128.is-prime(97)')

    c100 i128 = 100
    runner.is-false(c100.is-prime(), 'i128.is-prime(100)')

    bp u128 = 1000003
    runner.is-true(bp.is-prime(), 'u128.is-prime(1000003)')

    bc u128 = 1000000000000000000
    runner.is-false(bc.is-prime(), 'u128.is-prime(1e18)')
}

; 取負值助手：Nolang 對「一元負號前綴 + 方法呼叫」（`-2.9.to-i64()`）會
; 把 `sub void 0, x` emit 出來（IR 驗證失敗），故負運算元一律先經本函數成形。
neg-f = (x f64) (out f64) {
    out = 0.0 - x
}

; ── 浮點格式化 ────────────────────────────────
; 三個格式化入口都以 Go 的 strconv.FormatFloat 對應格式為契約：
;   to-str-fixed   ↔ 'f'（定點，小數點後 n 位）
;   to-str-sci     ↔ 'e'（科學記數，指數至少兩位、帶正負號）
;   to-str-general ↔ 'g'（有效位數 n，必要時退成指數形式並剝除尾隨零）
; 覆蓋到三處曾修好的缺陷：進位到整數位（9.99@1 → 10.0）、負指數（e--04）、
; 剝零後留下裸小數點（10.）。
t-fmt-fixed = () {
    f1 = 1.23456
    runner.str-eq(f1.to-str-fixed(3), '1.235', 5, 'fixed 1.23456@3')

    ; 進位跨越整數位：小數點後的 0 必須保留
    f2 = 9.99
    runner.str-eq(f2.to-str-fixed(1), '10.0', 4, 'fixed 9.99@1 = 10.0')
    f3 = 9.999
    runner.str-eq(f3.to-str-fixed(2), '10.00', 5, 'fixed 9.999@2 = 10.00')
    f4 = 9.9
    runner.str-eq(f4.to-str-fixed(0), '10', 2, 'fixed 9.9@0 = 10')

    ; 負值與 .5 邊界（二進位無法精確表示 0.005 / 2.675，按實際 double 值捨入）
    f5 = -0.005
    runner.str-eq(f5.to-str-fixed(2), '-0.01', 5, 'fixed -0.005@2 = -0.01')
    f6 = 1.005
    runner.str-eq(f6.to-str-fixed(2), '1.00', 4, 'fixed 1.005@2 = 1.00')
    f7 = 2.675
    runner.str-eq(f7.to-str-fixed(2), '2.68', 4, 'fixed 2.675@2 = 2.68')
    f8 = 2.5
    runner.str-eq(f8.to-str-fixed(0), '3', 1, 'fixed 2.5@0 = 3')
    f9 = 0.5
    runner.str-eq(f9.to-str-fixed(0), '1', 1, 'fixed 0.5@0 = 1')

    ; 負零：捨入結果為 -0 時保留符號（與 Go 一致）
    fa = -0.4
    runner.str-eq(fa.to-str-fixed(0), '-0', 2, 'fixed -0.4@0 = -0')
    fb = 0.0
    runner.str-eq(fb.to-str-fixed(2), '0.00', 4, 'fixed 0.0@2 = 0.00')
    fc = -1.7
    runner.str-eq(fc.to-str-fixed(1), '-1.7', 4, 'fixed -1.7@1 = -1.7')
}

; 驗證 f64.to-str-sci：指數形式 `d.ddde±NN`，指數恆帶符號且至少兩位
t-fmt-sci = () {
    s1 = 0.0001234
    runner.str-eq(s1.to-str-sci(2), '1.23e-04', 8, 'sci 0.0001234@2')

    ; 負指數不得渲染成 `e--04`（曾因區塊形式的取絕對值不生效而出錯）
    s2 = -0.0001234
    runner.str-eq(s2.to-str-sci(2), '-1.23e-04', 9, 'sci -0.0001234@2')

    s3 = 1234.5
    runner.str-eq(s3.to-str-sci(2), '1.23e+03', 8, 'sci 1234.5@2')

    ; 進位跨越指數（9.99@1 → 1.0e+01，而非 10.0e+00）
    s4 = 9.99
    runner.str-eq(s4.to-str-sci(1), '1.0e+01', 7, 'sci 9.99@1 = 1.0e+01')
    s5 = 9.9
    runner.str-eq(s5.to-str-sci(0), '1e+01', 5, 'sci 9.9@0 = 1e+01')

    ; 精度 0 與整數值
    s6 = 1.0
    runner.str-eq(s6.to-str-sci(3), '1.000e+00', 9, 'sci 1.0@3')
    s7 = 0.0
    runner.str-eq(s7.to-str-sci(0), '0e+00', 5, 'sci 0.0@0')

    ; 非有限值：走 inf / nan 字面，不進桁架
    s8 = 1.0 / 0.0
    runner.str-eq(s8.to-str-sci(2), 'inf', 3, 'sci +Inf')
    s9 = 0.0 / 0.0
    runner.str-eq(s9.to-str-sci(2), 'nan', 3, 'sci NaN')
}

; 驗證 f64.to-str-general：有效位數 n，常規量級用定點、極端量級退指數並剝尾隨零
t-fmt-general = () {
    g1 = 9.99
    runner.str-eq(g1.to-str-general(2), '10', 2, 'general 9.99@2 = 10')
    g2 = 9.9
    runner.str-eq(g2.to-str-general(1), '1e+01', 5, 'general 9.9@1 = 1e+01')
    g3 = 999.9
    runner.str-eq(g3.to-str-general(3), '1e+03', 5, 'general 999.9@3 = 1e+03')
    g4 = 123456.789
    runner.str-eq(g4.to-str-general(5), '1.2346e+05', 10, 'general 123456.789@5')
    g5 = 0.000999
    runner.str-eq(g5.to-str-general(3), '0.000999', 8, 'general 0.000999@3')
    g6 = 1.0
    runner.str-eq(g6.to-str-general(4), '1', 1, 'general 1.0@4 = 1')
    g7 = 0.0
    runner.str-eq(g7.to-str-general(3), '0', 1, 'general 0.0@3 = 0')
    g8 = -1.5
    runner.str-eq(g8.to-str-general(3), '-1.5', 4, 'general -1.5@3')
}

; ── 數值轉換 ──────────────────────────────────
; f64 → 整數：向零截斷；無號目標對負值飽和為 0（llvm.fptoui.sat）。
; 註：u64 沒有 `.to-i64`（拓寬矩陣只到 to-u64），故 u64 結果一律以 .to-str() 斷言。
t-conv-f64-int = () {
    runner.eq(2.9.to-i64(), 2, '2.9.to-i64 = 2')
    runner.eq(neg-f(2.9).to-i64(), -2, '-2.9.to-i64 = -2')
    runner.eq(300.0.to-u32().to-i64(), 300, '300.0.to-u32')
    runner.eq(300.0.to-i32().to-i64(), 300, '300.0.to-i32')
    runner.str-eq(1.5.to-u64().to-str(), '1', 1, '1.5.to-u64 = 1')
    runner.str-eq(neg-f(1.5).to-u64().to-str(), '0', 1, '-1.5.to-u64 飽和為 0')
    runner.eq(neg-f(1.5).to-u32().to-i64(), 0, '-1.5.to-u32 飽和為 0')
    runner.eq(neg-f(1.5).to-i32().to-i64(), -1, '-1.5.to-i32 = -1')
}

; 整數 → 浮點 / 浮點寬度互轉 / 128 位轉浮點
t-conv-int-f64 = () {
    runner.f64-eq(42.to-f64(), 42.0, 0.000001, 'i64 42 -> f64')
    u42 u64 = 42
    runner.f64-eq(u42.to-f64(), 42.0, 0.000001, 'u64 42 -> f64')

    ; f64 ↔ f32：1.5 / 2.5 皆為二進位精確值，往返無誤差
    f32a f32 = 1.5.to-f32()
    runner.f64-eq(f32a.to-f64(), 1.5, 0.000001, 'f64 1.5 -> f32 -> f64')
    f32b = 2.5.to-f32()
    runner.f64-eq(f32b.to-f64(), 2.5, 0.000001, 'f32 2.5 -> f64')

    b128 i128 = 1234567890
    runner.f64-eq(b128.to-f64(), 1234567890.0, 0.000001, 'i128 -> f64')
    ub128 u128 = 1234567890
    runner.f64-eq(ub128.to-f64(), 1234567890.0, 0.000001, 'u128 -> f64')

    ; i64 → i32 截斷：低 32 位保留，高位丟棄
    i32a = 300.to-i32()
    runner.eq(i32a.to-i64(), 300, 'i64 300 -> i32')

    #{overflow=wrap}
    big = 4294967296 + 7
    i32b = big.to-i32()
    runner.eq(i32b.to-i64(), 7, 'i64 2^32+7 -> i32 = 7')
}

; 窄整數拓寬矩陣（byte/u8/i8/u16/i16/u32/i32 → i64 / u64）
; 負值一律經帶型別參數的助手傳入：`v i8 = -100` 這種宣告會丟失標註型別
; （見 test/README.md §5.2 的負字面量條目），參數入口不受影響。
narrow-i8 = (x i8) (out i64) {
    out = x.to-i64()
}

narrow-i16 = (x i16) (out i64) {
    out = x.to-i64()
}

narrow-i32 = (x i32) (out i64) {
    out = x.to-i64()
}

t-conv-width = () {
    b byte = 200
    runner.eq(b.to-i64(), 200, 'byte 200 -> i64')
    runner.str-eq(b.to-u64().to-str(), '200', 3, 'byte 200 -> u64')

    u8v u8 = 250
    runner.eq(u8v.to-i64(), 250, 'u8 250 -> i64')
    runner.str-eq(u8v.to-u64().to-str(), '250', 3, 'u8 250 -> u64')

    ; 有號窄型別必須符號擴展：-100 / -30000 / -2e9 皆原樣帶出
    runner.eq(narrow-i8(-100), -100, 'i8 -100 -> i64 符號擴展')
    runner.eq(narrow-i16(-30000), -30000, 'i16 -30000 -> i64 符號擴展')
    runner.eq(narrow-i32(-2000000000), -2000000000, 'i32 -2e9 -> i64 符號擴展')

    u16v u16 = 60000
    runner.eq(u16v.to-i64(), 60000, 'u16 60000 -> i64 零擴展')
    runner.str-eq(u16v.to-u64().to-str(), '60000', 5, 'u16 60000 -> u64')

    u32v u32 = 4000000000
    runner.eq(u32v.to-i64(), 4000000000, 'u32 4e9 -> i64 零擴展')
    runner.str-eq(u32v.to-u64().to-str(), '4000000000', 10, 'u32 4e9 -> u64')
}

; 取出 []byte 元素值必須經帶 byte 參數的助手：`v byte = be[i]` 這種宣告
; 會丟失標註型別，`.to-i64()` 因而解析成不存在的 `i64.to-i64`（同 §5.2 負字面量條目）。
byte-of = (b byte) (out i64) {
    out = b.to-i64()
}

; f64 位模式互轉與 i64 大端/小端位元組序列
t-bits = () {

    ; 1.5 = 0x3FF8000000000000
    bits = 1.5.to-bits()
    runner.str-eq(bits.to-str(), '4609434218613702656', 19, '1.5.to-bits')

    back = bits.from-bits()
    runner.f64-eq(back, 1.5, 0.000001, 'to-bits/from-bits 往返')

    ; 258 = 0x0102：大端在尾端、小端在首端
    be = 258.to-bytes-be()
    runner.eq(be.len(), 8, 'to-bytes-be 長度 8')
    runner.eq(byte-of(be[6]), 1, 'be b6 = 0x01')
    runner.eq(byte-of(be[7]), 2, 'be b7 = 0x02')

    le = 258.to-bytes-le()
    runner.eq(le.len(), 8, 'to-bytes-le 長度 8')
    runner.eq(byte-of(le[0]), 2, 'le b0 = 0x02')
    runner.eq(byte-of(le[1]), 1, 'le b1 = 0x01')
}

; ── f64 數學函式 ──────────────────────────────
; 全部為手寫級數／牛頓迭代實作，容差取 1e-6（實測最大誤差 ~2e-9）
t-math-f64 = () {
    runner.f64-eq(2.0.sqrt(), 1.4142135623730951, 0.000001, 'sqrt(2)')
    runner.f64-eq(8.0.cbrt(), 2.0, 0.000001, 'cbrt(8)')
    runner.f64-eq(27.0.cbrt(), 3.0, 0.000001, 'cbrt(27)')
    runner.f64-eq(neg-f(8.0).cbrt(), -2.0, 0.000001, 'cbrt(-8)')

    runner.f64-eq(0.0.sin(), 0.0, 0.000001, 'sin(0)')
    runner.f64-eq(1.5707963267948966.sin(), 1.0, 0.000001, 'sin(π/2)')
    runner.f64-eq(0.0.cos(), 1.0, 0.000001, 'cos(0)')
    runner.f64-eq(3.141592653589793.cos(), -1.0, 0.000001, 'cos(π)')
    runner.f64-eq(0.0.tan(), 0.0, 0.000001, 'tan(0)')
    runner.f64-eq(0.7853981633974483.tan(), 1.0, 0.000001, 'tan(π/4)')

    runner.f64-eq(1.0.asin(), 1.5707963267948966, 0.000001, 'asin(1)')
    runner.f64-eq(1.0.acos(), 0.0, 0.000001, 'acos(1)')
    runner.f64-eq(1.0.atan(), 0.7853981633974483, 0.000001, 'atan(1)')

    runner.f64-eq(0.0.sinh(), 0.0, 0.000001, 'sinh(0)')
    runner.f64-eq(1.0.sinh(), 1.1752011936438014, 0.000001, 'sinh(1)')
    runner.f64-eq(0.0.cosh(), 1.0, 0.000001, 'cosh(0)')
    runner.f64-eq(1.0.cosh(), 1.5430806348152437, 0.000001, 'cosh(1)')
    runner.f64-eq(0.0.tanh(), 0.0, 0.000001, 'tanh(0)')
    runner.f64-eq(1.0.tanh(), 0.7615941559557649, 0.000001, 'tanh(1)')

    runner.f64-eq(1.2.ceil(), 2.0, 0.000001, 'ceil(1.2)')
    runner.f64-eq(neg-f(1.2).ceil(), -1.0, 0.000001, 'ceil(-1.2)')
    runner.f64-eq(1.8.floor(), 1.0, 0.000001, 'floor(1.8)')
    runner.f64-eq(neg-f(1.2).floor(), -2.0, 0.000001, 'floor(-1.2)')
    runner.f64-eq(1.5.round(), 2.0, 0.000001, 'round(1.5)')
    runner.f64-eq(2.5.round(), 3.0, 0.000001, 'round(2.5) 半進位')
    runner.f64-eq(neg-f(2.5).round(), -3.0, 0.000001, 'round(-2.5) 對稱進位')
    runner.f64-eq(1.7.trunc(), 1.0, 0.000001, 'trunc(1.7)')
    runner.f64-eq(neg-f(1.7).trunc(), -1.0, 0.000001, 'trunc(-1.7) 向零截斷')

    runner.f64-eq(0.0.exp(), 1.0, 0.000001, 'exp(0)')
    runner.f64-eq(1.0.exp(), 2.718281828459045, 0.000001, 'exp(1)')
    runner.f64-eq(neg-f(1.0).exp(), 0.36787944117144233, 0.000001, 'exp(-1)')

    runner.f64-eq(1.0.log(), 0.0, 0.000001, 'log(1)')
    runner.f64-eq(2.718281828459045.log(), 1.0, 0.000001, 'log(e)')
    runner.f64-eq(100.0.log10(), 2.0, 0.000001, 'log10(100)')
    runner.f64-eq(8.0.log2(), 3.0, 0.000001, 'log2(8)')

    runner.f64-eq(3.141592653589793.degrees(), 180.0, 0.000001, 'degrees(π)')
    runner.f64-eq(1.5707963267948966.degrees(), 90.0, 0.000001, 'degrees(π/2)')
    runner.f64-eq(180.0.radians(), 3.141592653589793, 0.000001, 'radians(180)')
    runner.f64-eq(90.0.radians(), 1.5707963267948966, 0.000001, 'radians(90)')
}

; 驗證 number.exp-f64 自由函數：範圍遞減 + 泰勒級數，x>709 溢出為 +Inf
t-exp-f64-fn = () {
    runner.f64-eq(number.exp-f64(0.0), 1.0, 0.000001, 'exp-f64(0)')
    runner.f64-eq(number.exp-f64(1.0), 2.718281828459045, 0.000001, 'exp-f64(1)')
    runner.f64-eq(number.exp-f64(-1.0), 0.36787944117144233, 0.000001, 'exp-f64(-1)')
    runner.f64-eq(number.exp-f64(10.0), 22026.465794806718, 0.001, 'exp-f64(10)')

    ; x > 709 直接返回 +Inf（1.0/0.0）—— Nolang 沒有科學記數字面量，
    ; 故先比大小再比字串（Inf 的格式化走 inf 字面）
    inf = number.exp-f64(1000.0)
    runner.is-true(inf > 1000000000000000.0, 'exp-f64(1000) 遠大於有限值')
    runner.str-eq(inf.to-str-sci(2), 'inf', 3, 'exp-f64(1000) = +Inf')
}

; f32 方法：全部拓寬至 f64 計算後收窄，容差放寬到 1e-5
as-f32 = (x f64) (out f32) {
    out = x.to-f32()
}

f32-near = (x f32, want f64, eps f64, msg str) {
    d = x.to-f64()
    runner.f64-eq(d, want, eps, msg)
}

t-math-f32 = () {
    f32-near(as-f32(8.0).cbrt(), 2.0, 0.00001, 'f32 cbrt(8)')

    f32-near(as-f32(1.5707963).sin(), 1.0, 0.00001, 'f32 sin(π/2)')
    f32-near(as-f32(0.0).cos(), 1.0, 0.00001, 'f32 cos(0)')
    f32-near(as-f32(0.7853982).tan(), 1.0, 0.00001, 'f32 tan(π/4)')
    f32-near(as-f32(1.0).asin(), 1.5707964, 0.00001, 'f32 asin(1)')
    f32-near(as-f32(1.0).acos(), 0.0, 0.00001, 'f32 acos(1)')
    f32-near(as-f32(1.0).atan(), 0.7853982, 0.00001, 'f32 atan(1)')

    f32-near(as-f32(1.0).sinh(), 1.1752012, 0.00001, 'f32 sinh(1)')
    f32-near(as-f32(1.0).cosh(), 1.5430806, 0.00001, 'f32 cosh(1)')
    f32-near(as-f32(1.0).tanh(), 0.7615942, 0.00001, 'f32 tanh(1)')

    f32-near(as-f32(1.2).ceil(), 2.0, 0.00001, 'f32 ceil(1.2)')
    f32-near(as-f32(1.8).floor(), 1.0, 0.00001, 'f32 floor(1.8)')
    f32-near(as-f32(1.5).round(), 2.0, 0.00001, 'f32 round(1.5)')
    f32-near(as-f32(1.7).trunc(), 1.0, 0.00001, 'f32 trunc(1.7)')

    f32-near(as-f32(1.0).exp(), 2.7182817, 0.00001, 'f32 exp(1)')
    f32-near(as-f32(1.0).log(), 0.0, 0.00001, 'f32 log(1)')
    f32-near(as-f32(100.0).log10(), 2.0, 0.00001, 'f32 log10(100)')
    f32-near(as-f32(8.0).log2(), 3.0, 0.00001, 'f32 log2(8)')
    f32-near(as-f32(3.1415927).degrees(), 180.0, 0.00005, 'f32 degrees(π)')
    f32-near(as-f32(180.0).radians(), 3.1415927, 0.00001, 'f32 radians(180)')
}

; ── 執行 ──────────────────────────────────────
p1, f1 = runner.test('math.max/min', t-max-min)
p2, f2 = runner.test('num.abs', t-abs)
p3, f3 = runner.test('math.even/odd', t-even-odd)
p4, f4 = runner.test('math.gcd', t-gcd)
p5, f5 = runner.test('math.lcm', t-lcm)
p6, f6 = runner.test('number.pow', t-pow)
p7, f7 = runner.test('math.div/mod', t-div-mod)
p8, f8 = runner.test('i64.to-str', t-i64-to-str)
p9, f9 = runner.test('number.i64.to-str', t-i64-method-to-str)
p10, f10 = runner.test('u64.to-str', t-u64-to-str)
p11, f11 = runner.test('f64.to-str', t-f64-to-str)
p12, f12 = runner.test('number.f64.to-str', t-f64-method-to-str)
p13, f13 = runner.test('number.i128/u128 range const', t-int128-range-const)
p14, f14 = runner.test('number.i128/u128 sqrt', t-int128-sqrt)
p15, f15 = runner.test('number.i128/u128 is-prime', t-int128-is-prime)
p16, f16 = runner.test('number.f64.to-str-fixed', t-fmt-fixed)
p17, f17 = runner.test('number.f64.to-str-sci', t-fmt-sci)
p18, f18 = runner.test('number.f64.to-str-general', t-fmt-general)
p19, f19 = runner.test('number.f64 -> int', t-conv-f64-int)
p20, f20 = runner.test('number.int -> f64 / 位宽互转', t-conv-int-f64)
p21, f21 = runner.test('number 窄整数拓寬', t-conv-width)
p22, f22 = runner.test('number 位模式 / to-bytes', t-bits)
p23, f23 = runner.test('number f64 數學函式', t-math-f64)
p24, f24 = runner.test('number.exp-f64', t-exp-f64-fn)
p25, f25 = runner.test('number f32 數學函式', t-math-f32)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
