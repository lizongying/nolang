; std-number.no — number / num 模組測試（含 math 的 max/min 泛型入口）
;
; 執行：no test test/std/number.no
; 覆蓋：max / min（math 模組）/ abs（num 模組，方法）/ even / odd / gcd / lcm / pow / div / mod /
;       i64-to-str / u64-to-str / f64-to-str / swap
; 未測：sign / clamp / is-nan / is-inf / swap（num/float 泛型特化問題，預存 codegen bug；
;       num 零參方法僅能以裸函數形式 abs(x)/sign(x) 調用，`x.abs()` 點式尚未支持）

# /test/runner

; ── 基本數值操作 ──────────────────────────────

; max / min 是變參泛型（`a ..num`），兩種調用形態都要對：
;   - LHS 形態 `v = math.max(p, q)`：每個引數都是 spread 元素
;   - 語句形態 `math.max(1, 2, r)`：尾隨引數是輸出參數（見 tests/number.no）
;  尾隨引數為 ident 時特別關鍵：曾被誤判成輸出參數，
;  害 spread 少一個元素、結果又被寫進調用方的變數。
t-max-min = () {
    a i64 = math.max(3, 7)
    runner.eq(a, 7, 'max(3,7) == 7')
    b i64 = math.min(3, 7)
    runner.eq(b, 3, 'min(3,7) == 3')

    ; 尾隨引數為 ident 的 LHS 形態
    p i64 = 3
    q i64 = 7
    c i64 = math.max(p, q)
    runner.eq(c, 7, 'max(p,q) == 7')
    d i64 = math.min(p, q)
    runner.eq(d, 3, 'min(p,q) == 3')

    ; q 必須還是 7：結果不得被寫回尾隨 spread 元素
    runner.eq(q, 7, 'max(p,q) leaves q untouched')

    ; 多於兩個元素
    e i64 = math.max(3, 1, 4, 1, 5)
    runner.eq(e, 5, 'max(3,1,4,1,5) == 5')
    g i64 = math.min(3, 1, 4, 1, 5)
    runner.eq(g, 1, 'min(3,1,4,1,5) == 1')

    ; f64 單態化：比較不得退化成整數截斷
    x f64 = 1.5
    y f64 = 2.25
    fx f64 = math.max(x, y)
    runner.f64-eq(fx, 2.25, 0.000001, 'max(1.5,2.25) == 2.25')
    fy f64 = math.min(x, y)
    runner.f64-eq(fy, 1.5, 0.000001, 'min(1.5,2.25) == 1.5')
    fz f64 = math.max(0.1, 0.3, 0.2)
    runner.f64-eq(fz, 0.3, 0.000001, 'max(0.1,0.3,0.2) == 0.3')
}

t-abs = () {

    #{overflow=wrap}
    a i64 = abs(0 - 5)
    runner.eq(a, 5, 'abs(-5) == 5')
    b i64 = abs(3)
    runner.eq(b, 3, 'abs(3) == 3')
    c i64 = abs(0)
    runner.eq(c, 0, 'abs(0) == 0')
}

t-even-odd = () {
    yes1 bool = math.even(4)
    runner.is-true(yes1, 'even(4) == true')
    no1 bool = math.even(3)
    runner.is-false(no1, 'even(3) == false')
    yes2 bool = math.odd(3)
    runner.is-true(yes2, 'odd(3) == true')
    no2 bool = math.odd(4)
    runner.is-false(no2, 'odd(4) == false')
}

t-gcd = () {
    g i64 = math.gcd(12, 8)
    runner.eq(g, 4, 'gcd(12,8) == 4')
    g2 i64 = math.gcd(7, 5)
    runner.eq(g2, 1, 'gcd(7,5) == 1')
    g3 i64 = math.gcd(0, 5)
    runner.eq(g3, 5, 'gcd(0,5) == 5')
}

t-lcm = () {
    l i64 = math.lcm(4, 6)
    runner.eq(l, 12, 'lcm(4,6) == 12')
    l2 i64 = math.lcm(3, 5)
    runner.eq(l2, 15, 'lcm(3,5) == 15')
    l3 i64 = math.lcm(0, 5)
    runner.eq(l3, 0, 'lcm(0,5) == 0')
}

t-pow = () {
    r i64 = number.pow(2, 10)
    runner.eq(r, 1024, 'pow(2,10) == 1024')
    r2 i64 = number.pow(3, 3)
    runner.eq(r2, 27, 'pow(3,3) == 27')
    r3 i64 = number.pow(5, 0)
    runner.eq(r3, 1, 'pow(5,0) == 1')
}

t-div-mod = () {
    q i64 = math.div(7, 3)
    runner.eq(q, 2, 'div(7,3) == 2')
    r i64 = math.mod(7, 3)
    runner.eq(r, 1, 'mod(7,3) == 1')
    q2 i64 = math.div(-7, 2)
    runner.eq(q2, -3, 'div(-7,2) == -3')
    r2 i64 = math.mod(-7, 2)
    runner.eq(r2, -1, 'mod(-7,2) == -1')
}

; ── 整數轉字串 ────────────────────────────────
t-i64-to-str = () {
    s = math.i64-to-str(42)
    runner.eq(s.len-bytes(), 2, 'i64-to-str 42 len')
    runner.str-eq(s, '42', 2, 'i64-to-str 42 content')
    n = math.i64-to-str(-456)
    runner.eq(n.len-bytes(), 4, 'i64-to-str -456 len')
    runner.str-eq(n, '-456', 4, 'i64-to-str -456 content')
    z = math.i64-to-str(0)
    runner.eq(z.len-bytes(), 1, 'i64-to-str 0 len')
    runner.str-eq(z, '0', 1, 'i64-to-str 0 content')
}

t-i64-method-to-str = () {
    v = 123
    s = v.to-str()
    runner.eq(s.len-bytes(), 3, 'i64.to-str 123 len')
    runner.str-eq(s, '123', 3, 'i64.to-str 123 content')

    #{overflow=wrap}
    n = 0 - 789
    ns = n.to-str()
    runner.eq(ns.len-bytes(), 4, 'i64.to-str -789 len')
    runner.str-eq(ns, '-789', 4, 'i64.to-str -789 content')
}

t-u64-to-str = () {
    s = math.u64-to-str(255)
    runner.eq(s.len(), 3, 'u64-to-str 255 len')
    runner.str-eq(s, '255', 3, 'u64-to-str 255 content')
    z = math.u64-to-str(0)
    runner.eq(z.len(), 1, 'u64-to-str 0 len')
    runner.str-eq(z, '0', 1, 'u64-to-str 0 content')
}

; ── 浮點轉字串 ────────────────────────────────
t-f64-to-str = () {
    s = math.f64-to-str(3.14)
    runner.str-eq(s, '3.14', 4, 'f64-to-str 3.14')
    z = math.f64-to-str(0.0)
    runner.str-eq(z, '0', 1, 'f64-to-str 0.0')
}

t-f64-method-to-str = () {
    v = 2.5
    s = v.to-str()
    runner.str-eq(s, '2.5', 3, 'f64.to-str 2.5')
}

; ── 執行 ──────────────────────────────────────
p1, f1 = runner.test('math.max/min', t-max-min)
p2, f2 = runner.test('num.abs', t-abs)
p3, f3 = runner.test('math.even/odd', t-even-odd)
p4, f4 = runner.test('math.gcd', t-gcd)
p5, f5 = runner.test('math.lcm', t-lcm)
p6, f6 = runner.test('number.pow', t-pow)
p7, f7 = runner.test('math.div/mod', t-div-mod)
p8, f8 = runner.test('math.i64-to-str', t-i64-to-str)
p9, f9 = runner.test('number.i64.to-str', t-i64-method-to-str)
p10, f10 = runner.test('math.u64-to-str', t-u64-to-str)
p11, f11 = runner.test('math.f64-to-str', t-f64-to-str)
p12, f12 = runner.test('number.f64.to-str', t-f64-method-to-str)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)

    -> os.exit(0)
}
