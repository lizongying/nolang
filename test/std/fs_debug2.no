# /test/runner

t-open-file = () {
    fd = fs.open-file('/tmp/nolang_test_simple2.txt', 577, 420)
    runner.gt(fd, 0, 'open-file returned valid fd')
    fd > 0 -> {
        n = fs.write(fd, 'hello', 5)
        fs.close(fd)
    }
}

t-open-flags = () {
    ; O_WRONLY | O_CREAT | O_TRUNC on macOS = 1 | 512 | 1024 = 1537
    fd = fs.open-file('/tmp/nolang_test_simple3.txt', 1537, 420)
    runner.gt(fd, 0, 'open-file with write+creat+trunc')
    fd > 0 -> fs.close(fd)
}

p1, f1 = runner.test('fs.open-file', t-open-file)
p2, f2 = runner.test('fs.open-flags', t-open-flags)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)
    -> os.exit(0)
}
