; test/std/crc-64.no — crypto/crc-64 模組測試
;
; 執行：no test test/std/crc-64.no
; 覆蓋：crc-64.new / crc-64.hex（CRC-64/ECMA-182 反射：poly 0xC96C5795D7870F42, init 0, 無最終異或）
; 向量來源：check value「123456789」= 0x2B9C7EE4E2780C8A，並與 python 手算 CRC 交叉核對

# /test/runner

; CRC-64 檢查值（hex 介面）：'123456789' 應得 16 字元 '2b9c7ee4e2780c8a'
t-check-hex = () {
    h = crc-64.hex('123456789'.to-bytes())
    runner.str-eq(h, '2b9c7ee4e2780c8a', 16, 'crc64.hex("123456789") == "2b9c7ee4e2780c8a"')
}

; 空輸入回傳 0（初值與最終 XOR 相互抵消）
t-empty = () {
    crc = crc-64.new(''.to-bytes())
    runner.eq(crc, 0, 'crc64("") == 0 (init unchanged)')
}

p1 = runner.test('crc64.check-hex', t-check-hex)
p2 = runner.test('crc64.empty', t-empty)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
