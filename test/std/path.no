; std-path.no — path 模組測試
;
; 執行：no test test/std/path.no
; 覆蓋：path.base / path.dir / path.ext / path.is-abs / path.split
; 未測：path.join / path.clean（原地修改字串導致 BPT trap，預存 codegen bug）
;       path.current / path.exists / path.is-dir / path.is-file（依賴檔案系統）

# /test/runner

; ── path.base ─────────────────────────────────

; base：取最後一段，/a/b/c.txt → c.txt
t-base = () {
    p = path {
        p: '/a/b/c.txt'
    }
    b = p.base()
    runner.str-eq(b, 'c.txt', 5, 'base /a/b/c.txt == c.txt')
}

; 不含 '/' 的路徑應原樣回傳
t-base-no-slash = () {
    p = path {
        p: 'file.txt'
    }
    b = p.base()
    runner.str-eq(b, 'file.txt', 8, 'base file.txt == file.txt')
}

; 根目錄 '/' 的 base 應為空字串
t-base-root = () {
    p = path {
        p: '/'
    }
    b = p.base()
    runner.eq(b.len(), 0, 'base / len == 0')
}

; ── path.ext ──────────────────────────────────

; ext 回含點的副檔名：/a/b/c.txt → .txt
t-ext = () {
    p = path {
        p: '/a/b/c.txt'
    }
    e = p.ext()
    runner.str-eq(e, '.txt', 4, 'ext /a/b/c.txt == .txt')
}

; 無副檔名時回空字串（不把目錄分隔點當副檔名）
t-ext-no-ext = () {
    p = path {
        p: '/a/b/c'
    }
    e = p.ext()
    runner.eq(e.len(), 0, 'ext /a/b/c len == 0')
}

; ── path.is-abs ───────────────────────────────

; is-abs：以 '/' 開頭的路徑為絕對路徑
t-is-abs = () {
    p = path {
        p: '/a/b'
    }
    yes = p.is-abs()
    runner.is-true(yes, 'is-abs /a/b == true')
}

; 相對路徑 'a/b' 應回 false
t-is-abs-relative = () {
    p = path {
        p: 'a/b'
    }
    yes = p.is-abs()
    runner.is-false(yes, 'is-abs a/b == false')
}

; 空字串應回 false
t-is-abs-empty = () {
    p = path {
        p: ''
    }
    yes = p.is-abs()
    runner.is-false(yes, 'is-abs empty == false')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('path.base', t-base)
p2, f2 = runner.test('path.base-no-slash', t-base-no-slash)
p3, f3 = runner.test('path.base-root', t-base-root)
p4, f4 = runner.test('path.ext', t-ext)
p5, f5 = runner.test('path.ext-no-ext', t-ext-no-ext)
p6, f6 = runner.test('path.is-abs', t-is-abs)
p7, f7 = runner.test('path.is-abs-relative', t-is-abs-relative)
p8, f8 = runner.test('path.is-abs-empty', t-is-abs-empty)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
