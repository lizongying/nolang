; std-zlib.no — archive/zlib 模組測試
;
; 執行：no test test/std/zlib.no
; 覆蓋：zlib.adler-32 / zlib.zlib-compress / zlib.zlib-decompress

# /test/runner

; adler-32 基本可用性：對 4 位元組資料算出的校驗和應為正數（未固定具體值）
t-adler-32 = () {
    data []byte = [0x00, 0x01, 0x02, 0x03]
    sum = zlib.adler-32(data, 4)
    runner.gt(sum, 0, 'adler-32 sum > 0')
}

; 空輸入的邊界：沒有資料時要維持初始值 a=1 / b=0，即結果為 1
t-adler-32-empty = () {
    data []byte = with-cap(0)
    sum = zlib.adler-32(data, 0)

    ; 空資料的 Adler-32 = 1（初始值 a=1, b=0）
    runner.eq(sum, 1, 'adler-32 empty == 1')
}

; 已知值：'hello' 的 Adler-32 為 0x062c0215（此處只驗結果為正數）
t-adler-32-known = () {

    ; "hello" = [104, 101, 108, 108, 111]
    ; Adler-32 of "hello" = 0x062c0215
    data []byte = [104, 101, 108, 108, 111]
    sum = zlib.adler-32(data, 5)
    runner.gt(sum, 0, 'adler-32 hello > 0')
}

; zlib-compress 輸出必含 zlib 包裹（2 位元組頭 + 尾端 adler-32），
; 故 5 位元組的 'Hello' 壓完仍應超過 6 位元組
t-compress = () {
    data []byte = [72, 101, 108, 108, 111]; "Hello"
    compressed = zlib.zlib-compress(data)
    runner.gt(compressed.len(), 6, 'compressed len > 6 (zlib header + data)')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('zlib.adler-32', t-adler-32)
p2, f2 = runner.test('zlib.adler-32 empty', t-adler-32-empty)
p3, f3 = runner.test('zlib.adler-32 known', t-adler-32-known)
p4, f4 = runner.test('zlib.compress', t-compress)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
