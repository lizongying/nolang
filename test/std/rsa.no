; test/std/rsa.no — crypto/rsa 模組測試
;
; 執行：no test test/std/rsa.no
; 覆蓋：rsa.rsa-encrypt-bytes / rsa.rsa-decrypt-bytes（大端無符號 bytes ↔ base 2^32 little-endian limbs 模冪）
; 向量來源：
;   1) 教科書 RSA：p=61,q=53,n=3233,e=17,d=2753,m=65 → c=2790=0x0AE6（Wikipedia RSA 例）
;   2) 雙 limb（~64-bit）金鑰：p=4294967291,q=4294967279,e=65537，用 Python 生成 c

# /test/runner

; 教科書單 limb：m=65 → c=2790，再解密回 65
; （公開 bytes 介面：大端輸入、最短大端輸出）
t-textbook = () {
    m []byte = [65]
    e []byte = [17]
    n []byte = [12, 161]
    d []byte = [10, 193]
    ct = rsa.rsa-encrypt-bytes(m, e, n)
    runner.eq(ct.len(), 2, 'textbook ct bytes')
    ixout20c17 = ct[0]: {
        ok -> it

        -> _
    }

    runner.eq(ixout20c17, 10, 'textbook ct == 2790 (hi)')
    ixout21c17 = ct[1]: {
        ok -> it

        -> _
    }

    runner.eq(ixout21c17, 230, 'textbook ct == 2790 (lo)')
    pt = rsa.rsa-decrypt-bytes(ct, d, n)
    runner.eq(pt.len(), 1, 'textbook pt bytes')
    ixout24c17 = pt[0]: {
        ok -> it

        -> _
    }

    runner.eq(ixout24c17, 65, 'textbook round-trip == 65')
}

; 雙 limb 金鑰，ct 需與 Python 一致，並解密回原 m
t-multilimb = () {
    m []byte = [112, 72, 134, 13, 223, 121]
    e []byte = [1, 0, 1]
    n []byte = [255, 255, 255, 234, 0, 0, 0, 85]
    d []byte = [129, 129, 126, 114, 93, 93, 162, 217]
    ct = rsa.rsa-encrypt-bytes(m, e, n)
    ct-exp []byte = [14, 183, 65, 136, 140, 225, 19, 18]
    runner.eq(ct.len(), 8, 'multilimb ct bytes')
    a <- [0..8): {
        ixout37c21 = ct[a]: {
            ok -> it

            -> _
        }

        ixout37c32 = ct-exp[a]: {
            ok -> it

            -> _
        }

        runner.eq(ixout37c21, ixout37c32, 'multilimb ct byte')
    }
    pt = rsa.rsa-decrypt-bytes(ct, d, n)
    runner.eq(pt.len(), m.len(), 'multilimb pt bytes')
    b <- [0..pt.len()): {
        ixout42c21 = pt[b]: {
            ok -> it

            -> _
        }

        ixout42c27 = m[b]: {
            ok -> it

            -> _
        }

        runner.eq(ixout42c21, ixout42c27, 'multilimb pt byte')
    }
}

p1 = runner.test('rsa.textbook', t-textbook)
p2 = runner.test('rsa.multilimb', t-multilimb)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
