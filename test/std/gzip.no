; std-gzip.no — archive/gzip 模組測試
;
; 執行：no test test/std/gzip.no
; 覆蓋：gzip.gzip-compress / gzip.gzip-decompress / gzip.deflate-stored /
;       gzip.inflate-decompress

# /test/runner

t-compress = () {
    data []byte = [1, 2, 3, 4, 5]
    compressed = gzip.gzip-compress(data)
    runner.gt(compressed.len, 0, 'compressed len > 0')
}

t-compress-decompress = () {
    data []byte = [72, 101, 108, 108, 111]  ; "Hello"
    compressed = gzip.gzip-compress(data)
    runner.gt(compressed.len, 10, 'compressed len > 10 (gzip header)')

    decompressed = gzip.gzip-decompress(compressed)
    runner.eq(decompressed.len, 5, 'decompressed len == 5')
    runner.eq(decompressed[0], 72, 'decompressed[0] == H')
    runner.eq(decompressed[4], 111, 'decompressed[4] == o')
}

t-deflate-stored = () {
    data []byte = [10, 20, 30, 40, 50]
    deflated = gzip.deflate-stored(data)
    ; stored block: 1 (header) + 2 (LEN) + 2 (NLEN) + 5 (data) = 10
    runner.eq(deflated.len, 10, 'deflated len == 10')
    runner.eq(deflated[5], 10, 'deflated data[0] == 10')
    runner.eq(deflated[9], 50, 'deflated data[4] == 50')
}

t-inflate-stored = () {
    ; 手動構造一個 DEFLATE stored block：
    ; BFINAL=1, BTYPE=00, LEN=5, NLEN=~5, data=1,2,3,4,5
    ; 位元組：01 05 00 FA FF 01 02 03 04 05
    deflate-data []byte = [0x01, 0x05, 0x00, 0xFA, 0xFF, 1, 2, 3, 4, 5]
    inflated = gzip.inflate-decompress(deflate-data, 5)
    runner.eq(inflated.len, 5, 'inflated len == 5')
    runner.eq(inflated[0], 1, 'inflated[0] == 1')
    runner.eq(inflated[4], 5, 'inflated[4] == 5')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('gzip.compress', t-compress)
p2, f2 = runner.test('gzip.compress/decompress roundtrip', t-compress-decompress)
p3, f3 = runner.test('gzip.deflate-stored', t-deflate-stored)
p4, f4 = runner.test('gzip.inflate stored', t-inflate-stored)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)
    -> os.exit(0)
}
