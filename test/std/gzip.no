; std-gzip.no — archive/gzip 模組測試
;
; 執行：no test test/std/gzip.no
; 覆蓋：gzip.gzip-compress / gzip.gzip-decompress / gzip.deflate-stored /
;       gzip.inflate-decompress

# /test/runner

; 動態 Huffman 樣本：zlib（level 9）壓 2292 位元組「英文單詞串」的原始 deflate。
; 首 3 位元為 BFINAL=1 / BTYPE=10，其後為動態表頭；兩處測試共用同一份資料。
dynhex = ''

; 壓縮：'Hello' 應產生非空的 gzip 串流（含標頭與尾部 CRC/ISIZE）
t-compress = () {
    data []byte = [1, 2, 3, 4, 5]
    compressed = gzip.gzip-compress(data)
    runner.gt(compressed.len(), 0, 'compressed len > 0')
}

; 往返：gzip 串流長度應大於 10（固定標頭 10 位元組），解壓後還原 5 位元組 'Hello'
t-compress-decompress = () {
    data []byte = [72, 101, 108, 108, 111]; "Hello"
    compressed = gzip.gzip-compress(data)
    runner.gt(compressed.len(), 10, 'compressed len > 10 (gzip header)')

    decompressed = gzip.gzip-decompress(compressed)
    runner.eq(decompressed.len(), 5, 'decompressed len == 5')
    ixout24c27 = decompressed[0]: {
        ok -> it

        -> _
    }

    runner.eq(ixout24c27, 72, 'decompressed[0] == H')
    ixout25c27 = decompressed[4]: {
        ok -> it

        -> _
    }

    runner.eq(ixout25c27, 111, 'decompressed[4] == o')
}

; deflate 的 stored 區塊佈局：1 標頭 + 2 LEN + 2 NLEN + 5 資料 = 10 位元組，資料原樣複製
t-deflate-stored = () {
    data []byte = [10, 20, 30, 40, 50]
    deflated = gzip.deflate-stored(data)

    ; stored block: 1 (header) + 2 (LEN) + 2 (NLEN) + 5 (data) = 10
    runner.eq(deflated.len(), 10, 'deflated len == 10')
    ixout35c23 = deflated[5]: {
        ok -> it

        -> _
    }

    runner.eq(ixout35c23, 10, 'deflated data[0] == 10')
    ixout36c23 = deflated[9]: {
        ok -> it

        -> _
    }

    runner.eq(ixout36c23, 50, 'deflated data[4] == 50')
}

; ── 空輸入：仍須產生合法的 DEFLATE 主體 ─────────────────────────────
; 修復前 deflate-stored(空) 回 0 位元組，zlib/gzip 串流缺 DEFLATE 主體，
; 真實解壓端一律報 "incomplete or truncated stream"。此處同時以
; CPython gzip/zlib 交叉驗證（見 test/README.md §5.1）。
t-empty = () {
    none []byte = with-cap(0)

    d = gzip.deflate-stored(none)
    runner.eq(len(d), 5, '空輸入 deflate-stored = 5 位元組（1+2+2）')
    runner.str-eq(d.to-hex(), '010000FFFF', 10, '空輸入 = BFINAL=1 / LEN=0 / NLEN=0xFFFF')

    g = gzip.gzip-compress(none)
    runner.eq(len(g), 23, 'gzip 空串流 = 10(header) + 5(body) + 8(trailer)')

    back = gzip.gzip-decompress(g)
    runner.eq(len(back), 0, 'gzip 空串流可還原為 0 位元組')
}

; 手工構造的 DEFLATE stored 區塊（BFINAL=1、BTYPE=00）應解出 1..5 五個位元組
t-inflate-stored = () {

    ; 手動構造一個 DEFLATE stored block：
    ; BFINAL=1, BTYPE=00, LEN=5, NLEN=~5, data=1,2,3,4,5
    ; 位元組：01 05 00 FA FF 01 02 03 04 05
    deflate-data []byte = [
        0x01, 0x05, 0x00, 0xfa, 0xff, 1, 2, 3,
        4, 5,
    ]
    inflated = gzip.inflate-decompress(deflate-data, 5)
    runner.eq(inflated.len(), 5, 'inflated len == 5')
    ixout51c23 = inflated[0]: {
        ok -> it

        -> _
    }

    runner.eq(ixout51c23, 1, 'inflated[0] == 1')
    ixout52c23 = inflated[4]: {
        ok -> it

        -> _
    }

    runner.eq(ixout52c23, 5, 'inflated[4] == 5')
}

; ── 位元讀取器（LSB-first，DEFLATE 用）──────────────────────────────
t-bit-reader = () {
    br = bit-reader{}
    br.data = [0xb5, 0x01, 0x34, 0x12]
    br.pos = 0
    br.bit-buf = 0
    br.bit-cnt = 0

    ; 0xB5 = 1011_0101，LSB first：1,0,1,1,0,1,0,1
    b0 = br.read-bit()
    b1 = br.read-bit()
    b2 = br.read-bit()
    b3 = br.read-bit()
    runner.eq(b0, 1, 'read-bit：0xB5 的 bit0 = 1')
    runner.eq(b1, 0, 'read-bit：bit1 = 0')
    runner.eq(b2, 1, 'read-bit：bit2 = 1')
    runner.eq(b3, 0, 'read-bit：bit3 = 0（0xB5 = 1011_0101）')

    v = br.read-bits(4)
    runner.eq(v, 0x0b, 'read-bits(4) 續讀高位半字節 = 0x0B')

    ; 下一字節 0x01 → 讀 1 位後剩 7 位；skip-to-byte 丟掉餘位
    one = br.read-bits(1)
    runner.eq(one, 1, 'read-bits(1) = 1')
    br.skip-to-byte()
    u = br.read-u16-le()
    runner.eq(u, 0x1234, 'skip-to-byte 後 read-u16-le 讀到 0x1234')
}

; ── Huffman 固定碼表 + 解碼 KAT ──────────────────────────────────────
; DEFLATE 固定表：字面量 0x41（65）的 8 位元碼為 0x71，位元流依 MSB→LSB
; 逐位元填入，故位元組為 0b10001110 = 0x8E；其後 7 個 0 位元為 EOB(256)。
t-huffman = () {
    lc = huffman{}
    dc = huffman{}
    gzip.build-fixed(lc, dc)

    br = bit-reader{}
    br.data = [0x8e, 0x00]
    br.pos = 0
    br.bit-buf = 0
    br.bit-cnt = 0

    s1 = lc.decode(br)
    runner.eq(s1, 65, '固定表解出字面量 0x41（"A"）')

    s2 = lc.decode(br)
    runner.eq(s2, 256, '固定表解出區塊結束符 256')

    ; 直接以長度表建 canonical 表：兩符號各 1 位元 → 碼 0 與 1
    lens []i64 = with-len(2)
    lens[0]: {
        ok -> it = 1

        -> _
    }
    lens[1]: {
        ok -> it = 1

        -> _
    }
    h2 = huffman{}
    h2.build(lens, 2)

    br2 = bit-reader{}
    br2.data = [0x00]
    br2.pos = 0
    br2.bit-buf = 0
    br2.bit-cnt = 0
    s3 = h2.decode(br2)
    runner.eq(s3, 0, '自建表：位元 0 解出符號 0')
}

; ── 動態 Huffman 表建構（直接呼叫 build-dynamic）────────────────────
; 同一份 dynamic 樣本，前 3 位元為 BFINAL=1 / BTYPE=10；表建好後連續解出
; 'z','e','t','a' 四個字面量，即證明字面/長度表正確。
t-build-dynamic = () {
    opt = dynhex.from-hex()
    raw []byte = with-len(0)
    raw = opt: {
        ok -> it

        -> raw
    }

    br = bit-reader{}
    br.data = raw
    br.pos = 0
    br.bit-buf = 0
    br.bit-cnt = 0

    fin = br.read-bit()
    bt = br.read-bits(2)
    runner.eq(fin, 1, 'BFINAL = 1')
    runner.eq(bt, 2, 'BTYPE = 2（動態 Huffman）')

    lc = huffman{}
    dc = huffman{}
    gzip.build-dynamic(br, lc, dc)

    runner.eq(lc.decode(br), 122, '動態表解出 "z"')
    runner.eq(lc.decode(br), 101, '動態表解出 "e"')
    runner.eq(lc.decode(br), 116, '動態表解出 "t"')
    runner.eq(lc.decode(br), 97, '動態表解出 "a"')
}

; ── inflate：fixed Huffman 區塊（btype=1）───────────────────────────
; zlib（level 9, Z_FIXED）壓 'hello hello hello world hello' 的原始 deflate
t-inflate-fixed = () {
    hex = 'CB48CDC9C957C84022CBF38B7252206C00'
    opt = hex.from-hex()
    raw []byte = with-len(0)
    raw = opt: {
        ok -> it

        -> raw
    }
    runner.eq(len(raw), 17, 'fixed 樣本 17 位元組')

    out = inflate-decompress(raw, 29)
    runner.eq(len(out), 29, 'fixed 區塊還原 29 位元組')
    runner.str-eq(out.to-str(), 'hello hello hello world hello', 29, 'fixed 區塊內容')
}

; ── inflate：dynamic Huffman 區塊（btype=2）─────────────────────────
; zlib（level 9）壓 2292 位元組「英文單詞串」的原始 deflate；
; 期望值以長度 + Adler-32 校驗（避免在測試檔內複製 2KB 原文）
t-inflate-dynamic = () {
    opt = dynhex.from-hex()
    raw []byte = with-len(0)
    raw = opt: {
        ok -> it

        -> raw
    }
    runner.eq(len(raw), 376, 'dynamic 樣本 376 位元組')

    out = inflate-decompress(raw, 2292)
    runner.eq(len(out), 2292, 'dynamic 區塊還原 2292 位元組')

    head = out.slice(0, 10)
    runner.str-eq(head.to-str(), 'zeta gamma', 10, 'dynamic 區塊開頭內容')

    a = zlib.adler-32(out, len(out))
    runner.eq(a, 289291758, 'dynamic 區塊 Adler-32 與原文一致')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('gzip.compress', t-compress)
p2, f2 = runner.test('gzip.compress/decompress roundtrip', t-compress-decompress)
p3, f3 = runner.test('gzip.deflate-stored', t-deflate-stored)
p4, f4 = runner.test('gzip.empty input', t-empty)
p5, f5 = runner.test('gzip.inflate stored', t-inflate-stored)
p6, f6 = runner.test('gzip.bit-reader', t-bit-reader)
p7, f7 = runner.test('gzip.huffman', t-huffman)
p8, f8 = runner.test('gzip.build-dynamic', t-build-dynamic)
p9, f9 = runner.test('gzip.inflate fixed', t-inflate-fixed)
p10, f10 = runner.test('gzip.inflate dynamic', t-inflate-dynamic)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
