; test/std/scrypt.no — crypto/scrypt 模組測試
;
; 執行：no test test/std/scrypt.no
; 覆蓋：scrypt
; 向量來源：RFC 7914 附錄 A，並與 python hashlib.scrypt 交叉核對

# /test/runner

bhex = (data []byte) (hex str) {
    hex-chars = '0123456789abcdef'
    n = data.len()

    #{overflow=wrap}
    hex str = with-len(n * 2)
    i <- [0..n): {

        #{overflow=wrap}
        hex[i * 2] = hex-chars[(data[i] >> 4) & 15]

        #{overflow=wrap}
        hex[i * 2 + 1] = hex-chars[data[i] & 15]
    }
}

; RFC 7914 A.1: P="" S="" N=16 r=1 p=1 dkLen=64
t-scrypt-1 = () {
    p = ''.to-bytes()
    s = ''.to-bytes()
    out = scrypt.scrypt(p, s, 16, 1, 1, 64)
    runner.str-eq(bhex(out), '77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906', 128, 'scrypt N=16')
}

; RFC 7914 A.2: P="password" S="NaCl" N=1024 r=8 p=16 dkLen=64
t-scrypt-2 = () {
    out = scrypt.scrypt('password'.to-bytes(), 'NaCl'.to-bytes(), 1024, 8, 16, 64)
    runner.str-eq(bhex(out), 'fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640', 128, 'scrypt N=1024 r=8 p=16')
}
p1 = runner.test('scrypt.n16', t-scrypt-1)
p2 = runner.test('scrypt.n1024', t-scrypt-2)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)

    -> os.exit(0)
}
