; test/std/args.no — args 模組測試（命令列參數解析）
;
; 執行：no test test/std/args.no
;
; 覆蓋：count / get / program（委派至 os.args/os.arg）
;       has-flag / get-option / get-positional（在無附加參數下的否定路徑）
;
; 背景：args.count/get/program 原為空實作（以內建樁標記），實際回傳 0/空字串
;       （真實 bug），而底層 os.args()/os.arg() 可正常讀取 argv。現已改為
;       委派 os builtin。本測試驗證委派正確（count 不再為 0）。
;
; 註：no test 執行時，測試-binary 的 argv 固定為 1（僅含程式路徑），
;     故正向 flag/option 解析無法在 runner 情境注入；此處斷言 count==os.args().len()
;     的委派一致性，並驗證在僅有程式名時 has-flag 回傳 false、
;     get-option/get-positional 回傳 nil（否定路徑）。

# /test/runner

; args.count 應等於 os.args().len，且至少為 1（含程式名，回歸：曾誤回 0）
t-count = () {
    c i64 = args.count()
    o i64 = os.args().len()
    runner.eq(c, o, 'args.count == os.args().len (delegation)')
    runner.gt(c, 0, 'count >= 1 (regression: was 0)')
}

; get(0) 與 program 都應等於 os.arg(0)（即程式名）
t-get-program = () {
    opt-p = args.program()
    p str = ''
    opt-p: {
        ok -> p = it
        -> _
    }
    opt-g0 = args.get(0)
    g0 str = ''
    opt-g0: {
        ok -> g0 = it
        -> _
    }
    opt-o0 = os.arg(0)
    o0 str = ''
    opt-o0: {
        ok -> o0 = it
        -> _
    }
    runner.gt(p.len(), 0, 'program non-empty (was empty)')
    runner.eq(g0.len(), o0.len(), 'get(0).len == os.arg(0).len')
    n i64 = p.len()
    runner.str-eq(g0, o0, n, 'get(0) == os.arg(0)')
    runner.str-eq(p, o0, n, 'program == os.arg(0)')
}

; 無額外參數時 has-flag 對任意旗標都應為 false
t-has-flag-absent = () {

    ; argv 僅含程式名，[1..n) 迴圈不執行 => 任何 flag 皆不存在
    v bool = args.has-flag('--absent')
    runner.is-false(v, 'absent flag => false')
}

; 無 --k=v 形式的參數時 get-option 應為 nil
t-get-option-absent = () {
    ov = args.get-option('--absent')
    is-nil = false
    ov: {
        nil -> is-nil = true

        -> is-nil = false
    }
    runner.is-true(is-nil, 'absent option => nil')
}

; 只有程式名、沒有位置參數時 get-positional 應為 nil
t-get-positional-absent = () {
    pv = args.get-positional(0)
    is-nil = false
    pv: {
        nil -> is-nil = true

        -> is-nil = false
    }
    runner.is-true(is-nil, 'no positional => nil')
}
p1 = runner.test('args.count', t-count)
p2 = runner.test('args.get/program', t-get-program)
p3 = runner.test('args.has-flag(absent)', t-has-flag-absent)
p4 = runner.test('args.get-option(absent)', t-get-option-absent)
p5 = runner.test('args.get-positional(absent)', t-get-positional-absent)
total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
