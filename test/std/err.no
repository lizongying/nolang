; std-err.no — err 模組測試
;
; 執行：no test test/std/err.no
; 覆蓋：new / err.is / err.msg / err.format / new-at / from-errno / err.code
; 未測：code.to-name —— 使用者碼不可達。`code.io.to-name()` 報
;       `unknown callee code.io.to-name`，先落到變數 `c code = code.io` 再
;       `c.to-name()` 報 `unknown callee i64.to-name`（枚舉方法在 MIR 端沒有
;       按 i64 註冊）。已登記進 scripts/std_test_coverage.py 的 UNREACHABLE。

# /test/runner

; err.new：建立帶 code 的錯誤，is() 應匹配該 code，msg() 應保留原文
t-new = () {
    e = err.new('disk full', code.io)
    yes = e.is(code.io)
    runner.is-true(yes, 'err.is(code.io) matches')
    msg = e.msg()
    runner.str-eq(msg, 'disk full', 9, 'err.msg content')
}

; err.is：僅當錯誤碼相同時為 true
t-is = () {
    e = err.new('timed out', code.timeout)
    yes = e.is(code.timeout)
    runner.is-true(yes, 'is(timeout) matches')
}

; err.msg：回傳建立時傳入的訊息原文
t-msg = () {
    e = err.new('bad json', code.parse)
    msg = e.msg()
    runner.str-eq(msg, 'bad json', 8, 'msg content')
}

; err.format：輸出格式為 'code.<名稱>: <訊息>'，err.new 不帶位置故 loc 為空
t-format = () {
    e = err.new('read error', code.io)
    s = e.format()

    ; err.format() 產生 'code.<名稱>: <訊息>'（見 src/std/err.no 文件頭註解）；
    ; err.new 不注入位置，故 loc 為空。整串即 'code.io: read error'（19 位元組）。
    runner.str-eq(s, 'code.io: read error', 19, 'format content')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('err.new', t-new)
p2, f2 = runner.test('err.is', t-is)
p3, f3 = runner.test('err.msg', t-msg)
p4, f4 = runner.test('err.format', t-format)
p5, f5 = runner.test('err.new-at', t-new-at)
p6, f6 = runner.test('err.from-errno', t-from-errno)
p7, f7 = runner.test('err.code', t-code)

; new-at：位置由呼叫方明確給定，format() 會串成 'code.<v>: <msg> at <file>:<l>:<c>'
t-new-at = () {
    e = err.new-at('boom', code.parse, 'a.no', 12, 5)
    runner.str-eq(e.msg(), 'boom', 4, 'new-at msg')
    runner.is-true(e.is(code.parse), 'new-at code')
    exp = 'code.parse: boom at a.no:12:5'
    runner.str-eq(e.format(), exp, exp.len(), 'new-at format with location')
}

; from-errno：msg 取自 os.strerror（隨平台/語系變動，只驗非空），code 走 errno 映射
t-from-errno = () {
    e = err.from-errno(2)
    runner.is-true(e.is(code.not-found), 'errno 2 -> code.not-found')
    runner.is-true(e.msg().len() > 0, 'errno 2 msg from strerror')

    e2 = err.from-errno(12345)
    runner.is-true(e2.is(code.unknown), 'unmapped errno -> code.unknown')

    e3 = err.from-errno(0)
    runner.is-true(e3.is(code.ok), 'errno 0 -> code.ok')
}

; err.code：取出錯誤碼本身，回吐給 is() 應自洽
t-code = () {
    e = err.new('denied', code.permission)
    ec = e.code()
    runner.is-true(e.is(ec), 'code() roundtrips through is()')
    runner.is-false(e.is(code.io), 'code.permission is not code.io')
}

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
