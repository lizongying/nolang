; test/std/ip.no — net/ip 模組測試（IPv4 解析／分類／子網）
;
; 執行：no test test/std/ip.no
; 覆蓋：ip-addr.parse（合法/非法）、to-str、to-u32/from-u32 回環、equal、
;       is-loopback / is-private / is-zero / is-broadcast / is-multicast /
;       is-link-local / is-class-a|b|c / is-valid、in-subnet 遮罩矩陣、
;       ip-parse / ip-is-loopback / ip-is-private 便捷函數
; 註：回归點——(1) is-private 原實作 172/192 分支只計算布林未賦值、且預設臂把
;     所有非私網地址判為 private，已修正；(2) in-subnet 原對同型參數呼叫
;     base.to-u32() 被錯誤綁定到隱式接收者（恆等），已改用欄位直讀繞過。
;     方法呼叫前需一次 ip-parse 觸發跨模組實例化（工具鏈特性）。

# /test/runner

; 比較是否相等 str（先比位元組長度再逐字元比對）
; got str: 實測得到的字串（to-str 等方法的輸出）
; want str: 期望的字串，同時作為比對長度的基準
; msg str: 斷言訊息前綴，長度不符時會附加 ' [len]'
eq-str = (got str, want str, msg str) {
    runner.eq(got.len-bytes(), want.len-bytes(), msg - ' [len]')
    runner.str-eq(got, want, want.len-bytes(), msg)
}

; 方法呼叫前需一次 ip-parse 觸發跨模組實例化（工具鏈特性）。
; 結果本身用不到 → `_ =` 顯式丟棄（D2 的豁免路徑），避免 optunuse。
_ = ip.ip-parse('0.0.0.0')

; 解析：192.168.1.1 應拆成 4 個位元組；>255、段數不足/過多、空字串均應視為無效
t-parse = () {
    a = ip.ip-addr {}
    ok = a.parse('192.168.1.1')
    runner.is-true(ok, 'parse valid')
    runner.eq(a.a, 192, 'octet a')
    runner.eq(a.b, 168, 'octet b')
    runner.eq(a.c, 1, 'octet c')
    runner.eq(a.d, 1, 'octet d')
    eq-str(a.to-str(), '192.168.1.1', 'to-str')
    b = ip.ip-addr {}
    runner.is-false(b.parse('256.1.1.1'), 'octet>255 rejected')
    c = ip.ip-addr {}
    runner.is-false(c.parse('1.2.3'), '3 segments rejected')
    d = ip.ip-addr {}
    runner.is-false(d.parse(''), 'empty rejected')
    e = ip.ip-addr {}
    runner.is-false(e.parse('1.2.3.4.5'), '5 segments rejected')
    runner.is-true(e.is-valid(), 'zero addr is-valid')
}

; 位址分類：私有段（10/8、172.16–172.31、192.168）、回環、零位址、廣播、
; 多播（224–239）、鏈路本地（169.254）與 A/B/C 類判定
t-classify = () {
    priv = ip.ip-addr {
        a: 192
        b: 168
        c: 1
        d: 1
    }
    runner.is-true(priv.is-private(), '192.168 is private (regression)')
    s16 = ip.ip-addr {
        a: 172
        b: 16
        c: 0
        d: 1
    }
    s31 = ip.ip-addr {
        a: 172
        b: 31
        c: 255
        d: 255
    }
    s15 = ip.ip-addr {
        a: 172
        b: 15
        c: 0
        d: 0
    }
    s32 = ip.ip-addr {
        a: 172
        b: 32
        c: 0
        d: 0
    }
    runner.is-true(s16.is-private(), '172.16 is private')
    runner.is-true(s31.is-private(), '172.31 is private')
    runner.is-false(s15.is-private(), '172.15 not private')
    runner.is-false(s32.is-private(), '172.32 not private')
    ten = ip.ip-addr {
        a: 10
        b: 255
        c: 0
        d: 0
    }
    runner.is-true(ten.is-private(), '10/8 is private')
    pub = ip.ip-addr {
        a: 8
        b: 8
        c: 8
        d: 8
    }
    runner.is-false(pub.is-private(), '8.8.8.8 not private (regression)')
    lb = ip.ip-addr {
        a: 127
        b: 0
        c: 0
        d: 1
    }
    runner.is-true(lb.is-loopback(), '127 is loopback')
    runner.is-false(priv.is-loopback(), '192.168 not loopback')
    zz = ip.ip-addr {
        a: 0
        b: 0
        c: 0
        d: 0
    }
    bc = ip.ip-addr {
        a: 255
        b: 255
        c: 255
        d: 255
    }
    mc = ip.ip-addr {
        a: 224
        b: 0
        c: 0
        d: 1
    }
    ll = ip.ip-addr {
        a: 169
        b: 254
        c: 1
        d: 1
    }
    runner.is-true(zz.is-zero(), 'is-zero')
    runner.is-true(bc.is-broadcast(), 'is-broadcast')
    runner.is-true(mc.is-multicast(), '224 is multicast')
    non-mc = ip.ip-addr {
        a: 240
        b: 0
        c: 0
        d: 0
    }
    runner.is-false(non-mc.is-multicast(), '240 not multicast')
    runner.is-true(ll.is-link-local(), '169.254 link-local')
    runner.is-true(pub.is-class-a(), '8 is class A')
    runner.is-true(priv.is-class-c(), '192 is class C')
    b128 = ip.ip-addr {
        a: 128
        b: 0
        c: 0
        d: 0
    }
    runner.is-true(b128.is-class-b(), '128 is class B')
}

; 轉換與相等：192.168.1.1 的大端 u32 為 3232235777，u32 往返後仍相等
t-convert = () {
    t = ip.ip-addr {
        a: 192
        b: 168
        c: 1
        d: 1
    }
    runner.eq(t.to-u32(), 3232235777, 'to-u32 big-endian')
    f = ip.ip-addr {}
    f.from-u32(t.to-u32())
    eq-str(f.to-str(), '192.168.1.1', 'from-u32 roundtrip')
    runner.is-true(f.equal(t), 'equal after roundtrip')
    o = ip.ip-addr {
        a: 192
        b: 168
        c: 1
        d: 2
    }
    runner.is-false(t.equal(o), 'not equal')
}

; 子網判定：前綴 0 / 8 / 16 / 24 / 25 / 31 / 32 的邊界（含主機位不足的負例）
t-subnet = () {
    sub = ip.ip-addr {
        a: 10
        b: 1
        c: 2
        d: 3
    }
    base = ip.ip-addr {
        a: 10
        b: 1
        c: 0
        d: 0
    }
    runner.is-true(sub.in-subnet(base, 0), 'p0 all true')
    runner.is-true(sub.in-subnet(base, 8), 'p8 in 10/8')
    runner.is-true(sub.in-subnet(base, 16), 'p16 in 10.1/16')
    runner.is-false(sub.in-subnet(base, 24), 'p24 NOT in 10.1.0/24 (regression)')
    runner.is-false(sub.in-subnet(base, 25), 'p25 not in')
    runner.is-false(sub.in-subnet(base, 32), 'p32 not equal')
    same = ip.ip-addr {
        a: 10
        b: 1
        c: 0
        d: 0
    }
    runner.is-true(same.in-subnet(base, 32), 'p32 equal')
    a1 = ip.ip-addr {
        a: 192
        b: 168
        c: 5
        d: 6
    }
    a2 = ip.ip-addr {
        a: 192
        b: 168
        c: 5
        d: 0
    }
    runner.is-true(a1.in-subnet(a2, 24), '192.168.5.6 in 192.168.5.0/24')
    runner.is-true(a1.in-subnet(a2, 25), 'in /25 (host<128)')
    runner.is-false(a1.in-subnet(a2, 31), 'not in /31')
    a4 = ip.ip-addr {
        a: 10
        b: 0
        c: 0
        d: 0
    }
    runner.is-false(a1.in-subnet(a4, 8), '192 not in 10/8')
}

; 便捷介面：ip-parse 的 option 三分支，以及 ip-is-loopback / ip-is-private 直接吃字串
t-fast = () {
    r = ip.ip-parse('10.0.0.5')
    found = false
    fv = ''
    r: {
        ok -> {
            found = true
            fv = it.to-str()
        }

        nil -> found = false

        err -> found = false
    }
    runner.is-true(found, 'ip-parse ok')
    eq-str(fv, '10.0.0.5', 'ip-parse value')
    nr = ip.ip-parse('999.1.1.1')
    nr: {
        ok -> runner.is-true(false, 'invalid should not be ok')

        nil -> runner.is-true(true, 'ip-parse nil')

        err -> runner.is-true(false, 'ip-parse err arm')
    }
    runner.is-true(ip.ip-is-loopback('127.9.9.9'), 'fast loopback')
    runner.is-false(ip.ip-is-loopback('8.8.8.8'), 'fast loopback neg')
    runner.is-true(ip.ip-is-private('172.16.0.1'), 'fast private 172.16 (regression)')
    runner.is-true(ip.ip-is-private('192.168.0.1'), 'fast private 192.168 (regression)')
    runner.is-false(ip.ip-is-private('8.8.8.8'), 'fast public (regression)')
}
runner.test('parse', t-parse)
runner.test('classify', t-classify)
runner.test('convert', t-convert)
runner.test('in-subnet', t-subnet)
runner.test('fast helpers', t-fast)
runner.summary()
f = runner.failed-count()
f > 0 -> exit(1)
-> exit(0)
