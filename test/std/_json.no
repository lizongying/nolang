; ============================================================
; 過濾存檔（filtered copy）— 此檔不參與 vet / test / build
; ------------------------------------------------------------
; 檔名以 '_' 開頭：nolang 的 IsIgnoredSourcePath 慣例會忽略它，
; `no vet` / `no test` / `no build` 的目錄遍歷都跳過本檔。
;
; 來源：json.no 的原樣副本，未改動任何一行程式碼。
; 保留原因：p.nodes[oi].count 的 bare index 讀 是D11 之前的原始讀法，
; 依「不修改合法源碼」原則原樣保存，供日後對照向量來源。
;
; 實際執行且 `no vet` 0 error 的版本：json.no
; （識別字已改為 kebab-case / 已修掉診斷）。改向量時請兩份一起對照。
; ============================================================

; std-json.no — json 模組測試
;
; 執行：no test test/std/json.no
; 覆蓋：parse / stringify / is-null / is-obj / is-arr / is-str / is-num / is-bool /
;       get-str / get-num / get-i64 / get-bool / get / arr-len / arr-get /
;       set-str / set-num / set-bool / set-i64

# /test/runner

; ── 解析 ──────────────────────────────────────

; 解析 JSON 對象：parse 回 ok 且 is-obj 為真
t-parse-obj = () {
    j = json.parse('{"name":"Alice","age":30}')
    ok = false
    is-obj = false
    j: {
        ok -> {
            is-obj = it.is-obj()
            ok = true
        }

        nil -> ok = false

        err -> ok = false
    }
    runner.is-true(ok, 'parse obj ok')
    runner.is-true(is-obj, 'parsed is-obj')
}

; 解析 JSON 數組：parse 回 ok 且 is-arr 為真
t-parse-arr = () {
    j = json.parse('[1, 2, 3]')
    ok = false
    is-arr = false
    j: {
        ok -> {
            is-arr = it.is-arr()
            ok = true
        }

        nil -> ok = false

        err -> ok = false
    }
    runner.is-true(ok, 'parse arr ok')
    runner.is-true(is-arr, 'parsed is-arr')
}

; 解析 JSON 字符串字面量：is-str 為真
t-parse-str = () {
    j = json.parse('"hello"')
    ok = false
    j: {
        ok -> ok = it.is-str()

        nil -> ok = false

        err -> ok = false
    }
    runner.is-true(ok, 'parse str ok')
}

; 解析 JSON 數字字面量（含小數）：is-num 為真
t-parse-num = () {
    j = json.parse('42.5')
    ok = false
    j: {
        ok -> ok = it.is-num()

        nil -> ok = false

        err -> ok = false
    }
    runner.is-true(ok, 'parse num ok')
}

; 解析 JSON 布爾字面量 true：is-bool 為真
t-parse-bool = () {
    j = json.parse('true')
    ok = false
    j: {
        ok -> ok = it.is-bool()

        nil -> ok = false

        err -> ok = false
    }
    runner.is-true(ok, 'parse bool ok')
}

; 解析 JSON null 字面量：is-null 為真
t-parse-null = () {
    j = json.parse('null')
    ok = false
    j: {
        ok -> ok = it.is-null()

        nil -> ok = false

        err -> ok = false
    }
    runner.is-true(ok, 'parse null ok')
}

; 解析錯誤處理：空字串解析結果須為 err 變體
t-parse-error = () {
    j = json.parse('')
    is-err = false
    j: {
        ok -> is-err = false

        nil -> is-err = false

        err -> is-err = true
    }
    runner.is-true(is-err, 'parse empty -> err')
}

; ── 物件存取 ──────────────────────────────────

; get-str 取對象字符串字段：键存在時回 ok 且值與源文一致
t-get-str = () {
    j = json.parse('{"name":"Alice","age":30}')
    found = false
    val str
    j: {
        ok -> {
            so = it.get-str('name')
            so: {
                ok -> {
                    found = true
                    val = it
                }

                -> found = false
            }
        }

        nil -> found = false

        err -> found = false
    }
    runner.is-true(found, 'get-str ok')
    runner.str-eq(val, 'Alice', 5, 'get-str content')
}

; get-num 取對象浮點字段：值與 3.14 在誤差內相等
t-get-num = () {
    j = json.parse('{"pi":3.14}')
    found = false
    val = 0.0
    j: {
        ok -> {
            no = it.get-num('pi')
            no: {
                ok -> {
                    found = true
                    val = it
                }

                -> found = false
            }
        }

        nil -> found = false

        err -> found = false
    }
    runner.is-true(found, 'get-num ok')
    eps = 0.001 / 1000.0
    runner.f64-eq(val, 3.14, eps, 'get-num 3.14')
}

; get-i64 取對象整數字段：值為 42
t-get-i64 = () {
    j = json.parse('{"count":42}')
    found = false
    val = 0
    j: {
        ok -> {
            io = it.get-i64('count')
            io: {
                ok -> {
                    found = true
                    val = it
                }

                -> found = false
            }
        }

        nil -> found = false

        err -> found = false
    }
    runner.is-true(found, 'get-i64 ok')
    runner.eq(val, 42, 'get-i64 value')
}

; get-bool 取對象布爾字段：值為 true
t-get-bool = () {
    j = json.parse('{"active":true}')
    found = false
    val = false
    j: {
        ok -> {
            bo = it.get-bool('active')
            bo: {
                ok -> {
                    found = true
                    val = it
                }

                -> found = false
            }
        }

        nil -> found = false

        err -> found = false
    }
    runner.is-true(found, 'get-bool ok')
    runner.is-true(val, 'get-bool value')
}

; ── 陣列操作 ──────────────────────────────────

; arr-len 取數組長度：5 元素數組回 5
t-arr-len = () {
    j = json.parse('[1, 2, 3, 4, 5]')
    n = 0
    j: {
        ok -> n = it.arr-len()

        nil -> n = 0

        err -> n = 0
    }
    runner.eq(n, 5, 'arr-len == 5')
}

; arr-get 按下標取數組元素（回 ?json）：對元素呼叫 str() 解包取字符串值
t-arr-get = () {
    j = json.parse('["a", "b", "c"]')

    ; arr-get 返回 ?json，對 string 元素用 str() 取值（單次匹配內完成，避免重複消費 option）
    ok2 = false
    val2 str
    j: {
        ok -> {
            elem = it.arr-get(0)
            elem: {
                ok -> {
                    so2 = it.str()
                    so2: {
                        ok -> {
                            ok2 = true
                            val2 = it
                        }

                        -> ok2 = false
                    }
                }

                nil -> ok2 = false

                err -> ok2 = false
            }
        }

        nil -> ok2 = false

        err -> ok2 = false
    }
    runner.is-true(ok2, 'arr-get(0) str ok')
    runner.str-eq(val2, 'a', 1, 'arr-get(0) content')
}

; ── 序列化 ────────────────────────────────────

; stringify 序列化對象：输出與源文等價（键值對無多餘空白）
t-stringify-obj = () {
    j = json.parse('{"a":1}')
    s = ''
    j: {
        ok -> s = it.stringify()

        nil -> {
        }

        err -> {
        }
    }
    runner.gt(s.len-bytes(), 5, 'stringify obj len > 5')
    runner.str-eq(s, '{"a":1}', 7, 'stringify obj content')
}

; stringify 序列化數組：输出 [1,2,3]（元素間無空白）
t-stringify-arr = () {
    j = json.parse('[1, 2, 3]')
    s = ''
    j: {
        ok -> s = it.stringify()

        nil -> {
        }

        err -> {
        }
    }
    runner.str-eq(s, '[1,2,3]', 7, 'stringify arr content')
}

; ── 構建與設定 ────────────────────────────────

; 構建設置字符串字段：json.new 後 set-str，stringify 得 {"name":"Bob"}
t-set-str = () {
    j = json.new()
    j.set-str('name', 'Bob')
    s = j.stringify()
    runner.str-eq(s, '{"name":"Bob"}', 14, 'set-str stringify')
}

; 構建設置浮點字段：set-num 後 stringify 得 {"val":3.14}
t-set-num = () {
    j = json.new()
    j.set-num('val', 3.14)
    s = j.stringify()
    runner.str-eq(s, '{"val":3.14}', 11, 'set-num stringify')
}

; 構建設置整數字段：set-i64 後 stringify 得 {"count":42}
t-set-i64 = () {
    j = json.new()
    j.set-i64('count', 42)
    s = j.stringify()
    runner.str-eq(s, '{"count":42}', 12, 'set-i64 stringify')
}

; 構建設置布爾字段：set-bool 後 stringify 得 {"ok":true}
t-set-bool = () {
    j = json.new()
    j.set-bool('ok', true)
    s = j.stringify()
    runner.str-eq(s, '{"ok":true}', 10, 'set-bool true stringify')
}

; ── 往返測試 ──────────────────────────────────

; 解析再序列化往返：多類型混合對象的 stringify 與源文逐字一致
t-roundtrip = () {
    src = '{"x":1,"y":"abc","z":true}'
    j = json.parse(src)
    s = ''
    j: {
        ok -> s = it.stringify()

        nil -> {
        }

        err -> {
        }
    }
    runner.str-eq(s, '{"x":1,"y":"abc","z":true}', 25, 'roundtrip')
}

; ── 取值助手 ──────────────────────────────────

; ?i64 三態哨兵：9000001 = nil、9000002 = err
i64-of = (v ?i64) (out i64) {
    out = 9000002
    v: {
        ok -> out = it

        nil -> out = 9000001

        err -> out = 9000002
    }
}

; ?str 三態哨兵：'nil' / 'err' / 實際內容
str-of = (v ?str) (out str) {
    out = 'err'
    v: {
        ok -> out = it

        nil -> out = 'nil'

        err -> out = 'err'
    }
}

; ?f64 三態：n 哨兵 -9000001.0 = nil、-9000002.0 = err
f64-of = (v ?f64) (out f64) {
    out = -9000002.0
    v: {
        ok -> out = it

        nil -> out = -9000001.0

        err -> out = -9000002.0
    }
}

; ?bool 三態：2 = nil、3 = err，0/1 為實際值
bool-of = (v ?bool) (out i64) {
    out = 3
    v: {
        ok -> {
            bs i64 = 0
            {
                it -> bs = 1

                ! it -> bs = 0
            }
            out = bs
        }

        nil -> out = 2

        err -> out = 3
    }
}

; ?json 狀態碼：0 = nil、1 = ok、2 = err（取子句柄非標量，只能斷言取到與否）
json-state = (v ?json) (out i64) {
    out = 2
    v: {
        ok -> out = 1

        nil -> out = 0

        err -> out = 2
    }
}

; ── 池級 API（低級） ─────────────────────────

; 新建池為空；alloc 依序發號；init 可重置
t-pool-init-alloc = () {
    p = json.new-pool()
    runner.eq(p.count, 0, 'new-pool count == 0')
    runner.eq(p.nodes.len(), 0, 'new-pool nodes 為空')
    runner.is-false(p.overflowed, 'new-pool 未溢出')

    i0 = p.alloc()
    i1 = p.alloc()
    runner.eq(i0, 0, 'alloc 首個索引 == 0')
    runner.eq(i1, 1, 'alloc 第二個索引 == 1')
    runner.eq(p.count, 2, 'alloc 兩次後 count == 2')
    runner.eq(p.get-kind(i0), json.JSON-KIND-NULL, '新節點 kind 為 NULL')

    p.init()
    runner.eq(p.count, 0, 'init 重置 count')
    runner.eq(p.nodes.len(), 0, 'init 清空 nodes')
}

; skip-ws 跳過空格 / Tab / LF / CR
t-pool-skip-ws = () {
    p = json.new-pool()
    runner.eq(p.skip-ws('   x', 0), 3, 'skip-ws 跳過三個空格')
    runner.eq(p.skip-ws('\t\n\r x', 0), 4, 'skip-ws 跳過 Tab/LF/CR/空格')
    runner.eq(p.skip-ws('abc', 0), 0, 'skip-ws 無空白時停在原地')
}

; parse-str：需先把節點 kind 標成 STR（低級 API 的分工），成功回閉引號後位置
t-pool-parse-str = () {
    p = json.new-pool()
    si = p.alloc()
    p.nodes[si].kind = json.JSON-KIND-STR
    nxt = p.parse-str(si, '"plain"', 0)
    runner.eq(i64-of(nxt), 7, 'parse-str 回閉引號後位置 7')
    runner.str-eq(str-of(p.get-str(si)), 'plain', 5, 'parse-str 寫入字串值')

    ; 引號未閉合 → nil
    bi = p.alloc()
    p.nodes[bi].kind = json.JSON-KIND-STR
    bad = p.parse-str(bi, '"abc', 0)
    runner.eq(i64-of(bad), 9000001, 'parse-str 引號未閉合回 nil')
}

; parse-num：寫入 num-val，回數字結束位置
t-pool-parse-num = () {
    p = json.new-pool()
    ni = p.alloc()
    p.nodes[ni].kind = json.JSON-KIND-NUM
    nxt = p.parse-num(ni, '-12.25', 0)
    runner.eq(i64-of(nxt), 6, 'parse-num 回結束位置 6')
    eps = 0.0000001
    runner.f64-eq(f64-of(p.get-num(ni)), -12.25, eps, 'parse-num 值 -12.25')

    pos = p.alloc()
    p.nodes[pos].kind = json.JSON-KIND-NUM
    nxt2 = p.parse-num(pos, '7', 0)
    runner.eq(i64-of(nxt2), 1, 'parse-num 單數字回位置 1')
    runner.f64-eq(f64-of(p.get-num(pos)), 7.0, eps, 'parse-num 值 7')
}

; get-kind：越界索引回 NULL
t-pool-get-kind = () {
    p = json.new-pool()
    i = p.alloc()
    runner.eq(p.get-kind(i), json.JSON-KIND-NULL, 'alloc 節點 kind NULL')
    p.nodes[i].kind = json.JSON-KIND-ARR
    runner.eq(p.get-kind(i), json.JSON-KIND-ARR, '改寫後 kind ARR')
    runner.eq(p.get-kind(9999), json.JSON-KIND-NULL, '越界索引回 NULL')
    runner.eq(p.get-kind(-1), json.JSON-KIND-NULL, '負索引回 NULL')
}

; set-key / get-key / add-child：邊表掛子節點並按鍵取回
t-pool-set-get-key = () {
    p = json.new-pool()
    ci = p.alloc()
    p.nodes[ci].kind = json.JSON-KIND-NUM

    oi = p.alloc()
    p.nodes[oi].kind = json.JSON-KIND-OBJ
    runner.is-true(p.set-key(oi, 'a', ci), 'pool.set-key 掛子節點')
    runner.eq(p.get-key(oi, 'a'), ci, 'pool.get-key 取回子節點索引')
    runner.eq(i64-of(p.get-key(oi, 'zz')), 9000001, 'pool.get-key 未命中回 nil')
    runner.eq(p.nodes[oi].count, 1, 'set-key 後父節點 count == 1')

    ; add-child 直呼：空鍵邊（陣列語義）
    ai = p.alloc()
    p.nodes[ai].kind = json.JSON-KIND-ARR
    p.add-child(ai, ci, '')
    runner.eq(p.arr-len(ai), 1, 'add-child 後 arr-len == 1')
    runner.eq(p.nodes[ai].count, 1, 'add-child 更新父節點 count')
}

; copy-tree：把子樹深拷貝到另一池
t-pool-copy-tree = () {
    src = json.parse('{"a":1}')
    gv = json.new()
    src: {
        ok -> gv = it

        -> _
    }
    dst = json.new-pool()
    cp = dst.copy-tree(gv.pool, gv.root)
    runner.eq(cp, 0, 'copy-tree 在新池首次拷貝得根 0')
    runner.eq(dst.get-kind(cp), json.JSON-KIND-OBJ, 'copy-tree 保留 OBJ 類型')
    ci = i64-of(dst.get-key(cp, 'a'))
    runner.eq(dst.get-kind(ci), json.JSON-KIND-NUM, 'copy-tree 保留鍵 a 的值節點')
    runner.eq(dst.nodes.len(), 2, 'copy-tree 只拷貝可達節點（obj + num）')
}

; clone-tree：返回持有獨立池的新 json
t-clone-tree = () {
    g = json.parse('{"m":1,"n":[2,3]}')
    gv = json.new()
    g: {
        ok -> gv = it

        -> _
    }
    cl = json.clone-tree(gv.pool, gv.root)
    runner.eq(cl.kind(), json.JSON-KIND-OBJ, 'clone 根為物件')
    runner.str-eq(cl.stringify(), '{"m":1,"n":[2,3]}', 17, 'clone 內容一致')

    ; 深拷貝獨立性：改 clone 不得影響來源
    cl.set-str('extra', 'y')
    runner.str-eq(cl.stringify(), '{"m":1,"n":[2,3],"extra":"y"}', 29, 'clone 可獨立擴充')
    runner.str-eq(gv.stringify(), '{"m":1,"n":[2,3]}', 17, '來源未被 clone 改動')
}

; ── 高級 API：kind / overflowed / 取值 ────────

; kind() 對五種型別回對應常量
t-kind = () {
    j0 = json.parse('null')
    j0: {
        ok -> runner.eq(it.kind(), json.JSON-KIND-NULL, 'kind null == 0')

        -> runner.eq(-1, 0, 'parse null 失敗')
    }
    j1 = json.parse('true')
    j1: {
        ok -> runner.eq(it.kind(), json.JSON-KIND-BOOL, 'kind bool == 1')

        -> runner.eq(-1, 0, 'parse true 失敗')
    }
    j2 = json.parse('1.5')
    j2: {
        ok -> runner.eq(it.kind(), json.JSON-KIND-NUM, 'kind num == 2')

        -> runner.eq(-1, 0, 'parse num 失敗')
    }
    j3 = json.parse('"s"')
    j3: {
        ok -> runner.eq(it.kind(), json.JSON-KIND-STR, 'kind str == 3')

        -> runner.eq(-1, 0, 'parse str 失敗')
    }
    j4 = json.parse('[]')
    j4: {
        ok -> runner.eq(it.kind(), json.JSON-KIND-ARR, 'kind arr == 4')

        -> runner.eq(-1, 0, 'parse arr 失敗')
    }
    j5 = json.parse('{}')
    j5: {
        ok -> runner.eq(it.kind(), json.JSON-KIND-OBJ, 'kind obj == 5')

        -> runner.eq(-1, 0, 'parse obj 失敗')
    }
}

; overflowed()：堆 vec 版恆為 false（含多次 alloc 後）
t-overflowed = () {
    j = json.new()
    runner.is-false(j.overflowed(), 'new 後未溢出')
    i <- [0..8): {
        n = j.alloc-node()
        j.set-null('k')
    }
    runner.is-false(j.overflowed(), '多次 alloc 後仍未溢出')
}

; 標量取值：num / bool / i64 / str-val，型別不符一律 nil
t-scalar-getters = () {
    n = json.parse('42.9')
    n: {
        ok -> {
            eps = 0.0001
            runner.f64-eq(f64-of(it.num()), 42.9, eps, 'num() 取 42.9')
            runner.eq(i64-of(it.i64()), 42, 'i64() 截斷取 42')
            runner.eq(bool-of(it.bool()), 2, 'num 上 bool() 回 nil')
            runner.str-eq(it.str-val(), '', 0, 'num 上 str-val 回空字串')
        }

        -> runner.eq(-1, 0, 'parse 42.9 失敗')
    }
    b = json.parse('false')
    b: {
        ok -> {
            runner.eq(bool-of(it.bool()), 0, 'bool() 取 false')
            runner.eq(i64-of(it.i64()), 9000001, 'bool 上 i64() 回 nil')
        }

        -> runner.eq(-1, 0, 'parse false 失敗')
    }
    s = json.parse('"hi"')
    s: {
        ok -> {
            runner.str-eq(it.str-val(), 'hi', 2, 'str-val 取 hi')
            runner.eq(i64-of(it.i64()), 9000001, 'str 上 i64() 回 nil')
        }

        -> runner.eq(-1, 0, 'parse "hi" 失敗')
    }
}

; ── 高級 API：物件操作 ───────────────────────

; get()：取子節點為獨立深拷貝句柄；未命中或非物件回 nil
t-get = () {
    g = json.parse('{"a":{"b":2},"c":[7,8]}')
    g: {
        ok -> {
            c1 = it.get('a')
            c1: {
                ok -> {
                    runner.eq(it.kind(), json.JSON-KIND-OBJ, 'get(a) 為物件')
                    runner.str-eq(it.stringify(), '{"b":2}', 7, 'get(a) 內容')
                }

                -> runner.eq(-1, 0, 'get(a) 未命中')
            }
            runner.eq(json-state(it.get('zz')), 0, 'get 未命中回 nil')
            c2 = it.get('c')
            c2: {
                ok -> runner.eq(it.arr-len(), 2, 'get(c) 陣列長 2')

                -> runner.eq(-1, 0, 'get(c) 未命中')
            }
        }

        -> runner.eq(-1, 0, 'parse 物件失敗')
    }

    ; 非物件上取鍵一律 nil
    s = json.parse('"x"')
    s: {
        ok -> runner.eq(json-state(it.get('a')), 0, '非物件上 get 回 nil')

        -> runner.eq(-1, 0, 'parse "x" 失敗')
    }
}

; json.get-key（全域函式形式）
t-get-key-fn = () {
    g = json.parse('{"a":1}')
    gv = json.new()
    g: {
        ok -> gv = it

        -> _
    }
    runner.eq(json-state(json.get-key(gv, 'a')), 1, 'json.get-key 取到子句柄')
    runner.eq(json-state(json.get-key(gv, 'zz')), 0, 'json.get-key 未命中回 nil')
    runner.eq(json-state(json.get-key(json.new(), 'a')), 0, '空 json 上回 nil')
}

; obj-len / obj-key / obj-keys-str：依插入順序走訪鍵
t-obj-iter = () {
    j = json.parse('{"a":1,"b":2,"c":3}')
    j: {
        ok -> {
            runner.eq(it.obj-len(), 3, 'obj-len == 3')
            runner.str-eq(str-of(it.obj-key(0)), 'a', 1, 'obj-key(0) == a')
            runner.str-eq(str-of(it.obj-key(2)), 'c', 1, 'obj-key(2) == c')

            ; obj-key 回的是 ?str ⇒ 用 str-of 的 'nil' 哨兵斷言越界，
            ; i64-of 收的是 ?i64，兩者 option 佈局不同（見 test/README §5.2n）
            runner.str-eq(str-of(it.obj-key(3)), 'nil', 3, 'obj-key 越界回 nil')
            runner.str-eq(it.obj-keys-str(), 'a\nb\nc\n', 6, 'obj-keys-str 依序拼接')
        }

        -> runner.eq(-1, 0, 'parse 物件失敗')
    }

    ; 非物件：len 0、keys 空
    a = json.parse('[1]')
    a: {
        ok -> {
            runner.eq(it.obj-len(), 0, '陣列上 obj-len == 0')
            runner.str-eq(it.obj-keys-str(), '', 0, '陣列上 obj-keys-str 為空')
        }

        -> runner.eq(-1, 0, 'parse 陣列失敗')
    }
}

; delete-key：命中則摘除邊並遞減 count；未命中或非物件回 false
t-delete-key = () {
    j = json.parse('{"a":1,"b":2}')
    j: {
        ok -> {
            runner.is-true(it.delete-key('a'), 'delete-key 命中回 true')
            runner.str-eq(it.stringify(), '{"b":2}', 7, '刪除後剩 b')
            runner.eq(it.obj-len(), 1, '刪除後 obj-len == 1')
            runner.is-false(it.delete-key('zz'), 'delete-key 未命中回 false')
        }

        -> runner.eq(-1, 0, 'parse 物件失敗')
    }
    s = json.parse('"x"')
    s: {
        ok -> runner.is-false(it.delete-key('a'), '非物件上 delete-key 回 false')

        -> runner.eq(-1, 0, 'parse "x" 失敗')
    }
}

; ── 高級 API：構建 ───────────────────────────

; alloc-node + set(key, val-idx)：值為本池節點索引（此處為空節點 → null）
t-set = () {
    j = json.new()
    idx = j.alloc-node()
    runner.eq(idx, 0, 'alloc-node 首個索引 0')
    runner.is-true(j.set('k', idx), 'set 寫入節點索引')
    runner.str-eq(j.stringify(), '{"k":null}', 9, 'set 後序列化為 {"k":null}')

    ; root 為字串時拒絕寫入
    s = json.parse('"x"')
    s: {
        ok -> runner.is-false(it.set('k', idx), '非物件/非 null 上 set 回 false')

        -> runner.eq(-1, 0, 'parse "x" 失敗')
    }
}

; set-null：直接寫入 null 子節點
t-set-null = () {
    j = json.new()
    runner.is-true(j.set-null('n'), 'set-null 成功')
    runner.str-eq(j.stringify(), '{"n":null}', 9, 'set-null 序列化')
    runner.is-true(j.set-null('m'), 'set-null 第二個鍵')
    runner.eq(j.obj-len(), 2, '兩個 null 鍵 obj-len == 2')
}

; set-key(json)：跨池深拷貝後掛鍵，支援嵌套
t-set-key = () {
    outer = json.new()
    outer.set-str('name', 'top')
    inner = json.parse('[1,2]')
    inner: {
        ok -> runner.is-true(outer.set-key('list', it), 'set-key 掛入解析出的陣列')

        -> runner.eq(-1, 0, 'parse [1,2] 失敗')
    }
    runner.str-eq(outer.stringify(), '{"name":"top","list":[1,2]}', 27, '嵌套序列化')

    ; 無效來源（空 json，root < 0）→ false
    empty = json.new()
    runner.is-false(outer.set-key('bad', empty), 'set-key 對空 json 回 false')
}

; arr-push-idx：以本池節點索引向陣列追加
t-arr-push-idx = () {
    a = json.new()
    idx = a.alloc-node()
    runner.is-true(a.arr-push-idx(idx), 'arr-push-idx 成功')
    runner.eq(a.arr-len(), 1, 'arr-push-idx 後 arr-len == 1')
    runner.str-eq(a.stringify(), '[null]', 6, 'arr-push-idx 序列化')

    ; root 為物件時拒絕追加
    o = json.new()
    o.set-str('k', 'v')
    oi = o.alloc-node()
    runner.is-false(o.arr-push-idx(oi), '物件上 arr-push-idx 回 false')
}

; arr-push(json)：跨池深拷貝後追加（回歸：舊實作把來源根索引當本池索引，
; 在新池上撞號成自環 → stringify 無限遞迴 segfault）
t-arr-push = () {
    sub = json.parse('{"x":1}')
    out = json.new()
    sub: {
        ok -> runner.is-true(out.arr-push(it), 'arr-push 追加物件元素')

        -> runner.eq(-1, 0, 'parse {"x":1} 失敗')
    }
    runner.eq(out.arr-len(), 1, 'arr-push 後 arr-len == 1')
    runner.str-eq(out.stringify(), '[{"x":1}]', 9, 'arr-push 深拷貝元素內容')
    runner.eq(out.pool.count, 3, 'arr-push 把 2 個來源節點拷入本池')

    ; 再追加一個陣列元素，驗證多次追加不串位
    sub2 = json.parse('[7]')
    sub2: {
        ok -> runner.is-true(out.arr-push(it), 'arr-push 追加陣列元素')

        -> runner.eq(-1, 0, 'parse [7] 失敗')
    }
    runner.eq(out.arr-len(), 2, '兩次 arr-push 後 arr-len == 2')
    runner.str-eq(out.stringify(), '[{"x":1},[7]]', 13, '兩次 arr-push 序列化正確')
}

; arr-push-str / arr-push-num / arr-push-bool：標量元素
t-arr-push-scalars = () {
    a = json.new()
    runner.is-true(a.arr-push-str('s'), 'arr-push-str 成功')
    runner.is-true(a.arr-push-num(2.5), 'arr-push-num 成功')
    runner.is-true(a.arr-push-bool(true), 'arr-push-bool 成功')
    runner.eq(a.arr-len(), 3, '三個標量元素 arr-len == 3')
    runner.str-eq(a.stringify(), '["s",2.5,true]', 14, '標量元素序列化')

    a2 = json.new()
    a2.arr-push-bool(false)
    runner.str-eq(a2.stringify(), '[false]', 7, 'arr-push-bool false 序列化')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('json.parse-obj', t-parse-obj)
p2, f2 = runner.test('json.parse-arr', t-parse-arr)
p3, f3 = runner.test('json.parse-str', t-parse-str)
p4, f4 = runner.test('json.parse-num', t-parse-num)
p5, f5 = runner.test('json.parse-bool', t-parse-bool)
p6, f6 = runner.test('json.parse-null', t-parse-null)
p7, f7 = runner.test('json.parse-error', t-parse-error)
p8, f8 = runner.test('json.get-str', t-get-str)
p9, f9 = runner.test('json.get-num', t-get-num)
p10, f10 = runner.test('json.get-i64', t-get-i64)
p11, f11 = runner.test('json.get-bool', t-get-bool)
p12, f12 = runner.test('json.arr-len', t-arr-len)
p13, f13 = runner.test('json.arr-get', t-arr-get)
p14, f14 = runner.test('json.stringify-obj', t-stringify-obj)
p15, f15 = runner.test('json.stringify-arr', t-stringify-arr)
p16, f16 = runner.test('json.set-str', t-set-str)
p17, f17 = runner.test('json.set-num', t-set-num)
p18, f18 = runner.test('json.set-i64', t-set-i64)
p19, f19 = runner.test('json.set-bool', t-set-bool)
p20, f20 = runner.test('json.roundtrip', t-roundtrip)
p21, f21 = runner.test('json.pool.init / alloc', t-pool-init-alloc)
p22, f22 = runner.test('json.pool.skip-ws', t-pool-skip-ws)
p23, f23 = runner.test('json.pool.parse-str', t-pool-parse-str)
p24, f24 = runner.test('json.pool.parse-num', t-pool-parse-num)
p25, f25 = runner.test('json.pool.get-kind', t-pool-get-kind)
p26, f26 = runner.test('json.pool.set-key / get-key / add-child', t-pool-set-get-key)
p27, f27 = runner.test('json.pool.copy-tree', t-pool-copy-tree)
p28, f28 = runner.test('json.clone-tree', t-clone-tree)
p29, f29 = runner.test('json.kind', t-kind)
p30, f30 = runner.test('json.overflowed', t-overflowed)
p31, f31 = runner.test('json.num / bool / i64 / str-val', t-scalar-getters)
p32, f32 = runner.test('json.get', t-get)
p33, f33 = runner.test('json.get-key', t-get-key-fn)
p34, f34 = runner.test('json.obj-len / obj-key / obj-keys-str', t-obj-iter)
p35, f35 = runner.test('json.delete-key', t-delete-key)
p36, f36 = runner.test('json.alloc-node / set', t-set)
p37, f37 = runner.test('json.set-null', t-set-null)
p38, f38 = runner.test('json.set-key', t-set-key)
p39, f39 = runner.test('json.arr-push-idx', t-arr-push-idx)
p40, f40 = runner.test('json.arr-push', t-arr-push)
p41, f41 = runner.test('json.arr-push-str / -num / -bool', t-arr-push-scalars)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
