; std-io.no — io 模組測試
;
; 執行：no test test/std/io.no
; 覆蓋：io.out / io.outln / io.err / io.errln /
;       writer.from-stdout / writer.write-str /
;       writer.write-byte / writer.write-line /
;       reader.from-stdin (僅驗證建構)
; 注意：io.read-line 依賴 stdin，不在此測試

# /test/runner

; ── 標準輸出 ──────────────────────────────────

; 驗證 io.out：寫字串到 stdout，返回寫入位元組數應大於 0
t-out = () {
    n = io.out('A')
    runner.gt(n, 0, 'out returns > 0')
}

; 驗證 io.outln：寫字串並附換行到 stdout，返回寫入位元組數應大於 0
t-outln = () {
    n = io.outln('B')
    runner.gt(n, 0, 'outln returns > 0')
}

; ── 標準錯誤 ──────────────────────────────────

; 驗證 io.err：寫字串到 stderr，返回位元組數非負即算成功
t-err = () {
    n = io.err('E')
    ok = n >= 0
    runner.is-true(ok, 'err returns >= 0')
}

; 驗證 io.errln：寫字串並附換行到 stderr，返回寫入位元組數應大於 0
t-errln = () {
    n = io.errln('F')
    runner.gt(n, 0, 'errln returns > 0')
}

; ── writer ────────────────────────────────────

; 驗證 writer.from-stdout 建構的寫入器：write-str 輸出 hello 後返回位元組數應大於 0
t-writer-stdout = () {
    w = writer.from-stdout()
    n = w.write-str('hello')
    runner.gt(n, 0, 'writer.write-str returns > 0')
}

; 驗證 writer.write-byte：向 stdout 寫單一位元組 65（字符 A），返回位元組數應大於 0
t-writer-write-byte = () {
    w = writer.from-stdout()
    n = w.write-byte(65)
    runner.gt(n, 0, 'writer.write-byte(65) returns > 0')
}

; 驗證 writer.write-line：向 stdout 寫一行文字（自動附換行），返回位元組數應大於 0
t-writer-write-line = () {
    w = writer.from-stdout()
    n = w.write-line('test')
    runner.gt(n, 0, 'writer.write-line returns > 0')
}

; ── writer.stderr ─────────────────────────────

; 驗證 writer.from-stderr 建構的寫入器：write-str 輸出到 stderr 後返回位元組數應大於 0
t-writer-stderr = () {
    w = writer.from-stderr()
    n = w.write-str('error-msg')
    runner.gt(n, 0, 'writer.stderr write-str returns > 0')
}

; ── reader 建構 ───────────────────────────────

; 驗證 reader.from-stdin：只檢查建構出的讀取器 fd 為 0（STDIN），實際讀取不在測試範圍
t-reader-stdin = () {
    r = reader.from-stdin()

    ; 只驗證 fd 是否為 0 (STDIN)
    runner.eq(r.fd, 0, 'reader.from-stdin fd == 0')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('io.out', t-out)
p2, f2 = runner.test('io.outln', t-outln)
p3, f3 = runner.test('io.err', t-err)
p4, f4 = runner.test('io.errln', t-errln)
p5, f5 = runner.test('io.writer-stdout', t-writer-stdout)
p6, f6 = runner.test('io.writer-write-byte', t-writer-write-byte)
p7, f7 = runner.test('io.writer-write-line', t-writer-write-line)
p8, f8 = runner.test('io.writer-stderr', t-writer-stderr)
p9, f9 = runner.test('io.reader-stdin', t-reader-stdin)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
