; std-magic.no — magic 模組測試
;
; 執行：no test test/std/magic.no
; 覆蓋：get-extension / detect-by-extension / detect-type
; 注意：detect-by-magic 需要實際檔案，使用臨時檔案測試

# /test/runner

; ── get-extension ─────────────────────────────

; 副檔名取用：'file.txt' → 'txt'、'file.json' → 'json'；
; 無副檔名或路徑中含 '.' 的目錄名時回空字串
t-get-extension = () {
    ext = magic.get-extension('file.txt')
    runner.str-eq(ext, 'txt', 3, 'get-extension file.txt == txt')
    ext2 = magic.get-extension('/path/to/file.json')
    runner.str-eq(ext2, 'json', 4, 'get-extension file.json == json')
    ext3 = magic.get-extension('noext')
    runner.eq(ext3.len(), 0, 'get-extension noext len == 0')
    ext4 = magic.get-extension('/a/b.c/d')
    runner.eq(ext4.len(), 0, 'get-extension /a/b.c/d len == 0 (dir-like)')
}

; ── detect-by-extension ──────────────────────

; 依副檔名判定類型：txt → 'ASCII text'、json → 'JSON data'、no → 'Nolang source'，未知得空字串
t-detect-by-extension = () {
    kind = magic.detect-by-extension('txt')
    runner.str-eq(kind, 'ASCII text', 10, 'detect ext txt == ASCII text')
    kind2 = magic.detect-by-extension('json')
    runner.str-eq(kind2, 'JSON data', 9, 'detect ext json == JSON data')
    kind3 = magic.detect-by-extension('no')
    runner.str-eq(kind3, 'Nolang source', 13, 'detect ext no == Nolang source')
    kind4 = magic.detect-by-extension('unknown')
    runner.eq(kind4.len(), 0, 'detect ext unknown len == 0')
}

; ── detect-type (extension-based, via temp file) ──

; detect-type 綜合判定：暫時的 .txt 檔（含內容）應判定為 'ASCII text'
t-detect-type-txt = () {

    ; 使用 open/write 建立臨時檔案
    tmp = '/tmp/nolang_magic_test.txt'
    fs.remove(tmp)
    f = fs.open(tmp, {
        mode: file-mode.write
        perm: file-perm.perm-644
        excl: false
        truncate: false
        append: false
    })
    f: {
        err -> runner.is-true(false, 'detect-type-txt: open failed')

        nil -> runner.is-true(false, 'detect-type-txt: open nil')

        -> {
            it.write('hello', 5)
            it.close()
        }
    }
    kind = magic.detect-type(tmp)
    runner.str-eq(kind, 'ASCII text', 10, 'detect-type .txt == ASCII text')
    fs.remove(tmp)
}

; ── detect-type (directory) ──────────────────

; detect-type 對目錄應回 'directory'（目錄判斷優先於內容偵測）
t-detect-type-dir = () {
    kind = magic.detect-type('/tmp')
    runner.str-eq(kind, 'directory', 9, 'detect-type /tmp == directory')
}

; ── detect-type (nonexistent) ────────────────

; detect-type 對不存在的路徑應回 'unknown (not found)'
t-detect-type-nonexistent = () {
    kind = magic.detect-type('/nonexistent/path/xyz123')
    runner.str-eq(kind, 'unknown (not found)', 19, 'detect-type nonexistent')
}

; ── detect-by-magic ─────────────────────────

; detect-by-magic 只看前 64 字節的魔數：PNG 檔頭應判為 'PNG image'，
; 純文字內容不命中任何魔數回空串，檔案不存在也回空串
t-detect-by-magic = () {
    tmp = '/tmp/nolang_magic_magic.bin'
    fs.remove(tmp)
    data []byte = [137, 80, 78, 71, 13, 10, 26, 10]
    ok = fs.write-file(tmp, data)
    runner.is-true(ok, 'write png header file')
    kind = magic.detect-by-magic(tmp)
    runner.str-eq(kind, 'PNG image', 9, 'png magic -> PNG image')
    fs.remove(tmp)

    plain = '/tmp/nolang_magic_plain.txt'
    fs.remove(plain)
    txt []byte = [104, 101, 108, 108, 111]
    ok2 = fs.write-file(plain, txt)
    runner.is-true(ok2, 'write plain file')
    kind2 = magic.detect-by-magic(plain)
    runner.eq(kind2.len(), 0, 'no magic match -> empty')
    fs.remove(plain)

    kind3 = magic.detect-by-magic('/nonexistent/path/xyz123')
    runner.eq(kind3.len(), 0, 'missing file -> empty')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('magic.get-extension', t-get-extension)
p2, f2 = runner.test('magic.detect-by-extension', t-detect-by-extension)
p3, f3 = runner.test('magic.detect-type-txt', t-detect-type-txt)
p4, f4 = runner.test('magic.detect-type-dir', t-detect-type-dir)
p5, f5 = runner.test('magic.detect-type-nonexistent', t-detect-type-nonexistent)
p6, f6 = runner.test('magic.detect-by-magic', t-detect-by-magic)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
