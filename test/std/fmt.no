; std-fmt.no — fmt 模組測試
;
; 執行：no test test/std/fmt.no
; 覆蓋：fmt-parse-spec / fmt-apply-spec / fmt-int / fmt-uint /
;       fmt-uint-base / fmt-f64 / fmt-str / fmt-bool

# /test/runner

; 注意：fmt-parse-spec 已正確解析 fill/align/sign/zero/width/precision/typ。
t-parse-spec = () {
    fill, align, sign, alt, zero, width, grouping, precision, typ = fmt.fmt-parse-spec('<5')
    runner.eq(fill, 32, 'parse-spec fill default space')
    runner.eq(align, 60, 'parse-spec align <')
    runner.eq(width, 5, 'parse-spec width 5')

    fill2, align2, sign2, alt2, zero2, width2, grouping2, precision2, typ2 = fmt.fmt-parse-spec('05')
    runner.eq(width2, 5, 'parse-spec zero-leading width 5')

    fill3, align3, sign3, alt3, zero3, width3, grouping3, precision3, typ3 = fmt.fmt-parse-spec('')
    runner.eq(width3, 0, 'parse-spec empty width 0')
    runner.eq(precision3, -1, 'parse-spec empty precision -1')
}

t-apply-spec = () {
    ; 右對齊（預設）：'   42'
    r = fmt.fmt-apply-spec('42', 32, 0, 5)
    runner.str-eq(r, '   42', 5, 'apply-spec right align')
    ; 左對齊：'42   '
    l = fmt.fmt-apply-spec('42', 32, 60, 5)
    runner.str-eq(l, '42   ', 5, 'apply-spec left align')
    ; 置中：pad=3 → left=1, right=2 → ' 42  '
    c = fmt.fmt-apply-spec('42', 32, 94, 5)
    runner.str-eq(c, ' 42  ', 5, 'apply-spec center align')
    ; 寬度小於內容：原樣
    n = fmt.fmt-apply-spec('42', 32, 0, 1)
    runner.str-eq(n, '42', 2, 'apply-spec width < len unchanged')
}

t-int = () {
    a = fmt.fmt-int(42, '')
    runner.str-eq(a, '42', 2, 'fmt-int plain')
    b = fmt.fmt-int(42, '5')
    runner.str-eq(b, '   42', 5, 'fmt-int width 5 right')
    c = fmt.fmt-int(42, '<5')
    runner.str-eq(c, '42   ', 5, 'fmt-int left align')
    ; zero 旗標現在被正確解析，'05' 產生零填充
    d = fmt.fmt-int(42, '05')
    runner.str-eq(d, '00042', 5, 'fmt-int zero-leading width')
    e = fmt.fmt-int(-42, '5')
    runner.str-eq(e, '  -42', 5, 'fmt-int negative width')
    g = fmt.fmt-int(0, '')
    runner.str-eq(g, '0', 1, 'fmt-int zero')
}

t-uint = () {
    a = fmt.fmt-uint(42, '')
    runner.str-eq(a, '42', 2, 'fmt-uint plain')
    b = fmt.fmt-uint(7, '3')
    runner.str-eq(b, '  7', 3, 'fmt-uint width 3')
}

t-uint-base = () {
    a = fmt.fmt-uint-base(255, 16, false)
    runner.str-eq(a, 'ff', 2, 'uint-base hex lower')
    b = fmt.fmt-uint-base(255, 16, true)
    runner.str-eq(b, 'FF', 2, 'uint-base hex upper')
    c = fmt.fmt-uint-base(255, 2, false)
    runner.str-eq(c, '11111111', 8, 'uint-base binary')
    d = fmt.fmt-uint-base(255, 10, false)
    runner.str-eq(d, '255', 3, 'uint-base decimal')
    e = fmt.fmt-uint-base(255, 8, false)
    runner.str-eq(e, '377', 3, 'uint-base octal')
}

t-f64 = () {
    a = fmt.fmt-f64(3.14159, '.2f')
    runner.str-eq(a, '3.14', 4, 'fmt-f64 precision 2')
    b = fmt.fmt-f64(2.5, '')
    runner.str-eq(b, '2.5', 3, 'fmt-f64 default')
}

t-str = () {
    a = fmt.fmt-str('hi', '')
    runner.str-eq(a, 'hi', 2, 'fmt-str plain')
    b = fmt.fmt-str('hi', '<5')
    runner.str-eq(b, 'hi   ', 5, 'fmt-str left align width 5')
    c = fmt.fmt-str('hello', '.2')
    runner.str-eq(c, 'he', 2, 'fmt-str precision truncate')
}

t-bool = () {
    a = fmt.fmt-bool(true, '')
    runner.str-eq(a, 'true', 4, 'fmt-bool true')
    b = fmt.fmt-bool(false, '')
    runner.str-eq(b, 'false', 5, 'fmt-bool false')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('fmt.fmt-parse-spec', t-parse-spec)
p2, f2 = runner.test('fmt.fmt-apply-spec', t-apply-spec)
p3, f3 = runner.test('fmt.fmt-int', t-int)
p4, f4 = runner.test('fmt.fmt-uint', t-uint)
p5, f5 = runner.test('fmt.fmt-uint-base', t-uint-base)
p6, f6 = runner.test('fmt.fmt-f64', t-f64)
p7, f7 = runner.test('fmt.fmt-str', t-str)
p8, f8 = runner.test('fmt.fmt-bool', t-bool)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> os.exit(1)
    -> os.exit(0)
}
