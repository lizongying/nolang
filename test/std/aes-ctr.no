; test/std/aes-ctr.no — crypto/aes-ctr 模組測試
;
; 執行：no test test/std/aes-ctr.no
; 覆蓋：aes-ctr.crypt-128（counter 模式為對稱 XOR）
; 向量來源：pycryptodome CTR，initial counter = iv=000102..0f
; key=000102..0f, iv=000102..0f, pt=00112233445566778899aabbccddeeff → ct=0a852986053b9632795a3ee30a8e04a5

# /test/runner

; 把位元組序列格式化成小寫十六進位字串（供 runner.str-eq 逐字元比對）
; data: 待格式化的位元組，可為空
; hex: 長度為 data.len()*2 的 hex 字串，每 2 字元對應一個位元組
bhex = (data []byte) (hex str) {
    hex-chars = '0123456789abcdef'
    n = data.len()

    #{overflow=wrap}
    hex str = with-len(n * 2)
    i <- [0..n): {
        data-i = data[i]: {
            ok -> it

            -> _
        }

        {

            #{overflow=wrap}
            hex[i * 2] ?= hex-chars[(data-i >> 4) & 15]
        }: {
            err -> _

            -> _
        }

        data-i-2 = data[i]: {
            ok -> it

            -> _
        }

        {

            #{overflow=wrap}
            hex[i * 2 + 1] ?= hex-chars[data-i-2 & 15]
        }: {
            err -> _

            -> _
        }
    }
}

; 驗證 AES-128-CTR 的密文符合 NIST SP800-38A 向量
; CTR 是流式模式，不需要填充，16 位元組明文得 16 位元組密文
t-enc = () {
    key [16]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    ]
    iv [16]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    ]
    pt []byte = [
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
        0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
    ]
    ct = aes-ctr.crypt-128(pt, key, iv)
    runner.str-eq(bhex(ct), '0a852986053b9632795a3ee30a8e04a5', 32, 'aes-128-ctr enc')
}

; 往返測試：CTR 加解密是同一個操作，再套一次相同 key/計數器即還原明文
t-roundtrip = () {
    key [16]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    ]
    iv [16]byte = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    ]
    pt []byte = [
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
        0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
    ]
    ct = aes-ctr.crypt-128(pt, key, iv)
    back = aes-ctr.crypt-128(ct, key, iv)
    runner.str-eq(bhex(back), '00112233445566778899aabbccddeeff', 32, 'aes-128-ctr round-trip')
}

; ---- 助手 ----

; hex → []byte
mkb = (h str) (b []byte) {
    opt = h.from-hex()
    b = opt: {
        ok -> it

        -> b
    }
}

; 長度 n 的全零 []byte
zeros = (n i64) (v []byte) {
    v = with-len(n)
    i <- [0..n): {
        v[i]: {
            ok -> it = 0

            -> _
        }
    }
}

; hex → [16]byte
mk16 = (h str) (a [16]byte) {
    raw = mkb(h)
    i <- [0..16): {
        a[i]: {
            ok -> it = 0

            -> _
        }
    }
    m = raw.len()
    m > 16 -> m = 16
    i <- [0..m): {
        v = raw[i]: {
            ok -> it

            -> 0
        }

        a[i]: {
            ok -> it = v

            -> _
        }
    }
}

; hex → [32]byte
mk32 = (h str) (a [32]byte) {
    raw = mkb(h)
    i <- [0..32): {
        a[i]: {
            ok -> it = 0

            -> _
        }
    }
    m = raw.len()
    m > 32 -> m = 32
    i <- [0..m): {
        v = raw[i]: {
            ok -> it

            -> 0
        }

        a[i]: {
            ok -> it = v

            -> _
        }
    }
}

; SP 800-38A 的 4 區塊明文（128 / 256 位元金鑰共用）
PT-64 = '6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710'
IV-16 = 'f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff'

; ---- 計數器遞增 ----

t-ctr-inc = () {
    cb = mkb('00000000000000000000000000000000')
    aes-ctr.ctr-inc(cb)
    runner.str-eq(bhex(cb), '00000000000000000000000000000001', 32, 'ctr-inc 0 → 1')

    cb2 = mkb('0000000000000000000000000000000a')
    aes-ctr.ctr-inc(cb2)
    runner.str-eq(bhex(cb2), '0000000000000000000000000000000b', 32, 'ctr-inc 低字節')

    cbf = mkb('000000000000000000000000000000ff')
    aes-ctr.ctr-inc(cbf)
    runner.str-eq(bhex(cbf), '00000000000000000000000000000100', 32, 'ctr-inc 低字節溢位進位')

    cbm = mkb('000000000000000000000000ffffffff')
    aes-ctr.ctr-inc(cbm)
    runner.str-eq(bhex(cbm), '00000000000000000000000100000000', 32, 'ctr-inc 低 32 位溢位')

    cbh = mkb('0000000000000000ffffffffffffffff')
    aes-ctr.ctr-inc(cbh)
    runner.str-eq(bhex(cbh), '00000000000000010000000000000000', 32, 'ctr-inc 低 64 位溢位')

    cbw = mkb('ffffffffffffffffffffffffffffffff')
    aes-ctr.ctr-inc(cbw)
    runner.str-eq(bhex(cbw), '00000000000000000000000000000000', 32, 'ctr-inc 全 ff 回捲')

    ; 只動後 4 位元組：高位不變
    cbt = mkb('0123456789abcdef0123456789abcdef')
    aes-ctr.ctr-inc(cbt)
    runner.str-eq(bhex(cbt), '0123456789abcdef0123456789abcdf0', 32, 'ctr-inc 不動高位')
}

; ---- 核心 ctr-crypt ----

t-ctr-core = () {
    key [16]byte = mk16('2b7e151628aed2a6abf7158809cf4f3c')
    ek = aes.key-expand(key)
    iv [16]byte = mk16(IV-16)
    pt = mkb(PT-64)

    ct = aes-ctr.ctr-crypt(pt, iv, ek)
    runner.eq(ct.len(), 64, 'ctr-crypt 長度 = 輸入長度')
    runner.str-eq(bhex(ct), '874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff5ae4df3edbd5d35e5b4f09020db03eab1e031dda2fbe03d1792170a0f3009cee', 128, 'NIST F.5.1 AES-128-CTR 4 塊')

    back = aes-ctr.ctr-crypt(ct, iv, ek)
    runner.str-eq(bhex(back), bhex(pt), 128, 'ctr-crypt 為對合')

    ; 不完整尾塊：5 位元組
    c5 = aes-ctr.ctr-crypt(mkb('6bc1bee22e'), iv, ek)
    runner.eq(c5.len(), 5, 'ctr-crypt 尾塊長度')
    runner.str-eq(bhex(c5), '874d6191b6', 10, 'ctr-crypt 5 位元組')

    ; 17 位元組：跨兩個計數器（第 17 位元組用計數器 +1 的密鑰流）
    c17 = aes-ctr.ctr-crypt(mkb('6bc1bee22e409f96e93d7e117393172aae'), iv, ek)
    runner.eq(c17.len(), 17, 'ctr-crypt 跨塊長度')
    runner.str-eq(bhex(c17), '874d6191b620e3261bef6864990db6ce98', 34, 'ctr-crypt 跨塊')

    ; 空輸入 ⇒ 空輸出
    e = aes-ctr.ctr-crypt(zeros(0), iv, ek)
    runner.eq(e.len(), 0, 'ctr-crypt 空輸入 → 空輸出')

    ; 換 iv 必須換密文
    iv2 [16]byte = mk16('f0f1f2f3f4f5f6f7f8f9fafbfcfdfefe')
    ct2 = aes-ctr.ctr-crypt(pt, iv2, ek)
    s1 = bhex(ct)
    s2 = bhex(ct2)
    runner.is-false(s1.eq(s2, 128), 'ctr-crypt iv 有生效')
}

; ---- crypt-256 ----

t-crypt-256 = () {
    key [32]byte = mk32('603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4')
    iv [16]byte = mk16(IV-16)
    pt = mkb(PT-64)

    ct = aes-ctr.crypt-256(pt, key, iv)
    runner.eq(ct.len(), 64, 'crypt-256 長度 = 輸入長度')
    runner.str-eq(bhex(ct), '601ec313775789a5b7a7f504bbf3d228f443e3ca4d62b59aca84e990cacaf5c52b0930daa23de94ce87017ba2d84988ddfc9c58db67aada613c2dd08457941a6', 128, 'NIST F.5.5 AES-256-CTR 4 塊')

    back = aes-ctr.crypt-256(ct, key, iv)
    runner.str-eq(bhex(back), bhex(pt), 128, 'crypt-256 為對合')

    ; 與 AES-128 的結果必須不同
    k128 [16]byte = mk16('603deb1015ca71be2b73aef0857d7781')
    ct128 = aes-ctr.crypt-128(pt, k128, iv)
    s256 = bhex(ct)
    s128 = bhex(ct128)
    runner.is-false(s256.eq(s128, 128), 'crypt-256 與 crypt-128 結果不同')
}

p1 = runner.test('aesctr.enc', t-enc)
p2 = runner.test('aesctr.roundtrip', t-roundtrip)
p3 = runner.test('aesctr.ctr-inc', t-ctr-inc)
p4 = runner.test('aesctr.ctr-crypt', t-ctr-core)
p5 = runner.test('aesctr.crypt-256', t-crypt-256)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
