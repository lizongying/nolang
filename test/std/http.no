; std-http.no — net/http 模組測試
;
; 執行：no test test/std/http.no
;
; 覆蓋（12 / 25，全部是**不需要真連線**的部分）：
;   request.init / request.add-header / response.parse-headers / response.get-header /
;   set-basic-auth / set-bearer-auth / set-api-key /
;   http-dl-location / http-dl-resolve / http-write-ok / ping
;
; 未覆蓋（13 / 25，都需要真 socket，留給後續有網路的檔次）：
;   do / do-req / get / post / put / delete / patch / download / upload-put /
;   get-auth / post-auth / download-to-file / http-dl-open
;
; ✅ `http-dl-dechunk` 已修（2026-11-11）：原本多塊 chunked body 只解出第一塊
;   （迴圈內累加器的 option 寫回從第二輪起被靜默丟棄，見 test/README §5.2 #87）。
;   現在所有加減乘都過 `_dl-add` / `_dl-sub` / `_dl-mul` / `_dl-hex-acc`
;   這層函式邊界，下面的 `t-dechunk` 是回歸門檻。
;
; 歷史 bug（本輪修好）：
;   request.add-header 原本對 `.headers[idx]` 用 `?=`，而那在空槽上恆失敗、錯誤又被
;   `{ … }: { err -> _ }` 吞掉 ⇒ **恆回 false、header-count 永遠 0**，連帶
;   set-basic-auth / set-bearer-auth / set-api-key 全部失效。改成 place-match
;   （`self.headers[idx]: { ok -> it = … }`）後正常，本檔的斷言即為回歸門檻。
;
; 寫法約定（三條都踩過）：
;   1. std 結構體的變數**必須**有型別標註，但 `no fmt` 會把區域標註當多餘的刪掉 ⇒
;      把標註挪進**函式簽名**（`mk-req = (…) (r http.request)`），並在函式內先
;      `r.zero()`（結構體結果參數進來是未初始化記憶體，見 MEMORY-RISKS）。
;   2. 裸下標 `r.headers[i]` 是 `?T`，當實參用會被 `no vet` 判 `idxbruse` ⇒
;      一律經取值 helper（值位 match 掛在**表達式**上，別經中間變數）。

# /test/runner

; http-write-ok 的落盤目標
HT = '/tmp/nolang_http_test.bin'

; ── 構造器（型別標註放在簽名裡，見檔頭第 1 條）────

mk-req = (method str, url str, body str) (r http.request) {
    r.zero()
    r.init(method, url, body)
}

mk-resp = () (r http.response) {
    r.zero()
}

; 取值 helper：裸下標是 ?T，這裡用值位 match 收成裸 str
req-hdr = (r http.request, i i64) (s str) {
    s = r.headers[i]: {
        ok -> it

        -> ''
    }
}

res-name = (r http.response, i i64) (s str) {
    s = r.header-names[i]: {
        ok -> it

        -> ''
    }
}

res-val = (r http.response, i i64) (s str) {
    s = r.header-values[i]: {
        ok -> it

        -> ''
    }
}

; ── request.init ─────────────────────────────

; init 只寫 method/url/body 並把 header-count 歸零
t-request-init = () {
    r = mk-req('POST', 'http://example.com/a', 'body')

    runner.str-eq(r.method, 'POST', 4, 'init: method 入庫')
    runner.str-eq(r.url, 'http://example.com/a', 20, 'init: url 入庫')
    runner.str-eq(r.body, 'body', 4, 'init: body 入庫')
    runner.eq(r.header-count, 0, 'init: header-count 歸零')
}

; ── request.add-header ───────────────────────

; 追加 'Name: Value'、推進 header-count，滿 16 條後回 false 且不再推進
t-request-headers = () {
    r = mk-req('GET', 'http://x/', '')

    ok1 = r.add-header('X-A', '1')
    runner.is-true(ok1, 'add-header: 第一條回 true')
    runner.eq(r.header-count, 1, 'add-header: count 1')
    runner.str-eq(req-hdr(r, 0), 'X-A: 1', 6, 'add-header: 組出 Name: Value')

    ok2 = r.add-header('Accept', 'application/json')
    runner.is-true(ok2, 'add-header: 第二條回 true')
    runner.eq(r.header-count, 2, 'add-header: count 2')
    runner.str-eq(req-hdr(r, 1), 'Accept: application/json', 24, 'add-header: 第二條內容')

    ; 補到上限（16）：2 + 14 = 16
    i <- [0..14): {
        filled = r.add-header('X', 'y')
    }
    runner.eq(r.header-count, 16, 'add-header: 填滿 16 條')

    over = r.add-header('X-Last', 'z')
    runner.is-false(over, 'add-header: 第 17 條回 false')
    runner.eq(r.header-count, 16, 'add-header: 超限後 count 不動')
    runner.str-eq(req-hdr(r, 15), 'X: y', 4, 'add-header: 最後一格是第 16 條')
}

; ── 認證標頭 ─────────────────────────────────

; basic = Authorization: Basic base64(user:pass)；bearer / api-key 各走自己的前綴
t-auth = () {
    p = mk-req('GET', 'http://x/', '')
    b-ok = http.set-basic-auth(p, 'user', 'pass')
    runner.is-true(b-ok, 'set-basic-auth: 回 true')
    runner.str-eq(req-hdr(p, 0), 'Authorization: Basic dXNlcjpwYXNz', 33, 'set-basic-auth: base64(user:pass)')

    q = mk-req('GET', 'http://x/', '')
    t-ok = http.set-bearer-auth(q, 'tok')
    runner.is-true(t-ok, 'set-bearer-auth: 回 true')
    runner.str-eq(req-hdr(q, 0), 'Authorization: Bearer tok', 25, 'set-bearer-auth: 前綴 Bearer')

    k = mk-req('GET', 'http://x/', '')
    a-ok = http.set-api-key(k, 'X-API-Key', 'k1')
    runner.is-true(a-ok, 'set-api-key: 回 true')
    runner.str-eq(req-hdr(k, 0), 'X-API-Key: k1', 13, 'set-api-key: 自訂標頭名')
}

; ── response.parse-headers / get-header ──────

; 逐行拆 'Name: Value'；get-header 是**大小寫敏感**的線性搜尋
t-response = () {
    res = mk-resp()
    res.headers = 'Content-Type: text/plain\r\nX-A: 1\r\n'
    res.parse-headers()

    runner.eq(res.header-count, 2, 'parse-headers: 拆出 2 條')
    runner.str-eq(res-name(res, 0), 'Content-Type', 12, 'parse-headers: 第一條名')
    runner.str-eq(res-val(res, 0), 'text/plain', 10, 'parse-headers: 第一條值')
    runner.str-eq(res-name(res, 1), 'X-A', 3, 'parse-headers: 第二條名')
    runner.str-eq(res-val(res, 1), '1', 1, 'parse-headers: 第二條值')

    hit = res.get-header('Content-Type')
    hit: {
        ok -> runner.str-eq(it, 'text/plain', 10, 'get-header: 精確大小寫命中')

        -> runner.is-true(false, 'get-header: 精確大小寫應命中')
    }

    miss = res.get-header('X-Missing')
    miss: {
        ok -> runner.is-true(false, 'get-header: 不存在的標頭必須 nil')

        -> runner.is-true(true, 'get-header: 不存在的標頭回 nil')
    }

    ; ⚠️ 與 net/http3 的 get-header（不分大小寫）不同，這裡是大小寫敏感的；
    ; 目前行為如此，先斷言現狀，是否統一另議。
    lower = res.get-header('content-type')
    lower: {
        ok -> runner.is-true(false, 'get-header: 小寫查詢目前應為 nil（大小寫敏感）')

        -> runner.is-true(true, 'get-header: 小寫查詢回 nil（大小寫敏感）')
    }

    ; 空 headers：parse 後 count 必須是 0
    e = mk-resp()
    e.parse-headers()
    runner.eq(e.header-count, 0, 'parse-headers: 空 headers 得 count 0')
}

; ── http-dl-location ─────────────────────────

; 從標頭文字撈 Location（大小寫不敏感），沒有就 nil
t-dl-location = () {
    h1 = 'HTTP/1.1 302 Found\r\nLocation: /next\r\n'
    l1 = http.http-dl-location(h1)
    l1: {
        ok -> runner.str-eq(it, '/next', 5, 'dl-location: 撈到 /next')

        -> runner.is-true(false, 'dl-location: 應撈到 /next')
    }

    h2 = 'HTTP/1.1 301 Moved\r\nlocation: https://x/y\r\n'
    l2 = http.http-dl-location(h2)
    l2: {
        ok -> runner.str-eq(it, 'https://x/y', 11, 'dl-location: 小寫 location 也認')

        -> runner.is-true(false, 'dl-location: 小寫 location 應命中')
    }

    h3 = 'HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n'
    l3 = http.http-dl-location(h3)
    l3: {
        ok -> runner.is-true(false, 'dl-location: 沒有 Location 必須 nil')

        -> runner.is-true(true, 'dl-location: 沒有 Location 回 nil')
    }
}

; ── http-dl-resolve ──────────────────────────

; 絕對 URL 直接沿用；根相對接在 scheme+host(+port) 後；一般相對多補一個 '/'
t-dl-resolve = () {
    a = http.http-dl-resolve(false, 'example.com', 80, '/next')
    runner.str-eq(a, 'http://example.com/next', 22, 'dl-resolve: 根相對 + 預設埠省 :80')

    b = http.http-dl-resolve(false, 'example.com', 8080, '/next')
    runner.str-eq(b, 'http://example.com:8080/next', 27, 'dl-resolve: 非預設埠帶上 :8080')

    c = http.http-dl-resolve(true, 'example.com', 443, 'sub/x')
    runner.str-eq(c, 'https://example.com/sub/x', 25, 'dl-resolve: tls + 一般相對補 /')

    d = http.http-dl-resolve(false, 'example.com', 80, 'https://other/y')
    runner.str-eq(d, 'https://other/y', 15, 'dl-resolve: 絕對 URL 原樣返回')
}

; ── http-write-ok ────────────────────────────

; 把 ?bool 折成 bool，並真的落盤
t-write-ok = () {
    data = 'abc'.to-bytes()
    ok = http.http-write-ok(HT, data)
    runner.is-true(ok, 'http-write-ok: 回 true')

    back = fs.read-file(HT)
    runner.eq(back.len(), 3, 'http-write-ok: 落盤 3 位元組')
    runner.str-eq(back.to-bytes-str(), 'abc', 3, 'http-write-ok: 內容一致')

    fs.remove(HT)
}

; ── ping ─────────────────────────────────────

; 固定回 'pong'（原始碼註解稱它是辨識「載入來源檔還是內嵌 std」的探針，
;  但它被公開成 API，理應有測試釘住；若日後刪除，這裡會一起變紅）
t-ping = () {
    p = http.ping()
    runner.str-eq(p, 'pong', 4, 'ping: 固定回 pong')
}

; 回歸 §5.2 #87：兩塊 chunked body 必須完整解出 'wikipedia'（9 位元組）。
; 修復前只回 'wiki'（4 位元組），因為第二塊的 size 累加寫回被靜默丟棄。
t-dechunk = () {
    body = '4\r\nwiki\r\n5\r\npedia\r\n0\r\n\r\n'
    b = body.to-bytes()
    o = http.http-dl-dechunk(b)
    runner.eq(o.len(), 9, 'dechunk: 兩塊共 9 位元組')
    s = o.to-bytes-str()
    runner.str-eq(s, 'wikipedia', 9, 'dechunk: 內容還原')
}

; ── 需要真 socket 的 13 個入口 ─────────────────────────
;
; 為什麼要 fork：本語言的協程是**協作式**的，客戶端 recv 阻塞時不會讓出線程
; ⇒ 同一個進程裡「先 dial 再 accept」必然互鎖。fork 出子進程當伺服器，父子
; 各自阻塞互不影響。
; listen socket 必須在 fork **之前**建立：子進程直接繼承 fd，父進程不會搶在
; 子進程 accept 之前 connect（否則 ECONNREFUSED）。
; 伺服器是「極簡 HTTP/1.1」：讀一次請求（本檔的請求都很小，單次 net-send 就
; 一個 TCP 段），回固定的 200 + 12 位元組內文，然後 close（客戶端靠 EOF 收尾，
; download / http-dl-open 都是「讀到 EOF 為止」）。

; 候選埠：上一個進程若異常崩掉，子進程可能還占著埠（它要等 13 次 accept），
; 所以 listen 失敗時往下一個試。
HLIVE-PORTS-1 = 39361
HLIVE-PORTS-2 = 39362
HLIVE-PORTS-3 = 39363

; 子進程每一輪 sleep 500µs，HLIVE-SPIN 輪 ⇒ 約 10 秒的硬上限。
; 這是「父進程中途崩掉時，子進程不會把埠永久占住」的保底，正常情況走
; `served >= want` 立刻退出，根本到不了這裡。
HLIVE-SPIN = 20000

; 子進程要服務的連線數 = 下面父進程真正發起的 HTTP 請求數，逐條數：
;   do GET / do POST / do-req / get / post / put / delete / patch /
;   get-auth / post-auth / download / download-to-file / http-dl-open(depth 0) /
;   upload-put                                        ⇒ 14
; 另外三條「不占連線」的斷言（http-dl-open 的 depth 6、upload-put 的檔案不存在、
; port-busy 的探測）都在開 socket 之前就返回，所以不計入。
; ⚠️ 這個數少 1 就會有一個請求連得上卻沒有應答，整檔卡到 60 秒逾時。
HLIVE-REQS = 14

HLIVE-CR = '\r'
HLIVE-LF = '\n'

; 固定的 200 應答（內文 hello-nolang 共 12 位元組）
hlive-resp = () (s str) {
    body = 'hello-nolang'
    s = 'HTTP/1.1 200 OK' - HLIVE-CR - HLIVE-LF - 'Content-Type: text/plain' - HLIVE-CR - HLIVE-LF - 'Content-Length: 12' - HLIVE-CR - HLIVE-LF - 'Connection: close' - HLIVE-CR - HLIVE-LF - HLIVE-CR - HLIVE-LF - body
}

; 子進程主迴圈：非阻塞 accept。
;
; 兩個退出條件：
;  ① `served >= want`：父進程的請求全服務完了，馬上 break，waitpid 才不會等；
;  ② 迴圈上限 HLIVE-SPIN 輪（每輪 sleep 500µs ⇒ 約 10 秒）：父進程若中途崩掉，
;     子進程最多空轉 10 秒就自己退出，不會把埠永久占住。
;
; ⚠️ 不要用「算一個截止時刻再比大小」的寫法。原實作是
;     #{overflow=wrap}
;     dl-opt = start + HLIVE-TTL-US
;     dl-opt: { ok -> deadline = it  -> }
;     …
;     now >= deadline -> break
; 這個 `?i64` 的 match **時好時壞**：某些編譯下 `ok` 臂不命中，`deadline` 停在 0，
; 於是 `now >= deadline` 第一輪就成立 ⇒ 子進程一個請求都不服務就退出，
; 父進程那 11 條「回 ok」全紅，之後還 SIGSEGV。症狀看起來像「伺服器沒起來」，
; 其實是截止時刻算成了 0。用固定輪次當硬上限就沒有這個問題（沒有算術、沒有 match）。
;
; ⚠️ 也不能只把退出念頭放進 while 條件：那樣 served 滿了之後迴圈仍在
; `i <- [0..HLIVE-SPIN)` 裡空轉，而且 listen socket 還開著 —— 對端此時 connect
; 會被核心收進 backlog，但沒人去 accept，客戶端 recv 永遠等不到應答。
hlive-serve = (lfd fd, want i64) {
    served = 0
    i <- [0..HLIVE-SPIN): {
        served >= want -> break
        c = net.net-accept-nb(lfd)
        c >= 0 -> {
            net.net-set-recv-timeout(c, 3000)
            buf str = with-len(4096)
            n = net.net-recv(c, buf, 4096)
            s = hlive-resp()
            net.net-send(c, s, s.len-bytes())
            fs.close(c)
            {
                sn = served + 1
                sn: {
                    ok -> served = it

                    ->
                }
            }
        }
        os.sleep-us(500)
    }
}

; 埠是否已被占用（能 dial 上就代表有人在聽）
port-busy = (p i64) (busy bool) {
    busy = false
    f = net.net-dial('127.0.0.1', p)
    f >= 0 -> {
        busy = true
        fs.close(f)
    }
}

; 檢查 ?response：必須 ok、狀態 200、內文 hello-nolang
check-live = (v ?http.response, what str) {
    hit = false
    v: {
        ok -> {
            r = it
            runner.eq(r.status-code, 200, what - ': 狀態碼 200')
            runner.str-eq(r.body, 'hello-nolang', 12, what - ': 內文')
            hit = true
        }

        nil -> _

        err -> _
    }
    runner.is-true(hit, what - ': 回 ok')
}

t-live = () {

    ; 選一個沒人聽的埠（上一次執行的子進程可能還在 5 秒的收尾窗口內）
    live-port = HLIVE-PORTS-1
    b1 = port-busy(HLIVE-PORTS-1)
    b1 -> live-port = HLIVE-PORTS-2
    b2 = port-busy(live-port)
    b2 -> live-port = HLIVE-PORTS-3
    b3 = port-busy(live-port)
    b3 -> live-port = -1
    runner.eq(b3, false, 'live: 找到空閒埠')
    live-port < 0 -> return

    lfd = net.net-listen('127.0.0.1', live-port)
    opened = 0
    lfd >= 0 -> opened = 1
    runner.eq(opened, 1, 'live: 本機 listen 成功')
    lfd < 0 -> return

    pid = process.process-fork()
    pid == 0 -> {
        hlive-serve(lfd, HLIVE-REQS)
        exit(0)
    }

    ; ⚠️ 父進程必須**立刻**關掉自己那份 listen fd，讓子進程獨占。
    ; 否則子進程服務完退出後，父進程手上的 fd 仍讓核心監聽並把新連線收進
    ; backlog —— 收到的請求沒人 accept，客戶端就卡在 recv 等不到應答
    ; （只會看到「測試逾時」，看不到任何連線錯誤）。
    fs.close(lfd)
    port-str = live-port.to-str()
    url-ok = 'http://127.0.0.1:' - port-str - '/ok'

    ; ① do（method + url + body 三參數形態）
    check-live(http.do('GET', url-ok, ''), 'do GET')
    check-live(http.do('POST', url-ok, 'abc'), 'do POST 帶 body')

    ; ② do-req（走 request 結構體，含自訂標頭）
    rq = mk-req('GET', url-ok, '')
    h-ok = rq.add-header('X-Test', 'v')
    runner.is-true(h-ok, 'do-req: 自訂標頭入庫')
    check-live(http.do-req(rq), 'do-req')

    ; ③ 四個動詞門面
    check-live(http.get(url-ok), 'get')
    check-live(http.post(url-ok, 'abc'), 'post')
    check-live(http.put(url-ok, 'abc'), 'put')
    check-live(http.delete(url-ok), 'delete')
    check-live(http.patch(url-ok, 'abc'), 'patch')

    ; ④ 兩個帶 Basic 認證的門面（伺服器不驗，但授權標頭必須送出去）
    check-live(http.get-auth(url-ok, 'u', 'p'), 'get-auth')
    check-live(http.post-auth(url-ok, 'abc', 'u', 'p'), 'post-auth')

    ; ⑤ 三種「存到檔案」的下載路徑
    dl = http.download(url-ok, '/tmp/no_http_live_dl.txt')
    runner.is-true(dl, 'download: 回 true')
    dl-txt = ''
    dl-opt = fs.read-str('/tmp/no_http_live_dl.txt')
    dl-opt: {
        ok -> dl-txt = it

        -> _
    }
    runner.str-eq(dl-txt, 'hello-nolang', 12, 'download: 檔案內容正確')

    dtf = http.download-to-file(url-ok, '/tmp/no_http_live_dtf.txt')
    runner.is-true(dtf, 'download-to-file: 回 true')
    dtf-txt = ''
    dtf-opt = fs.read-str('/tmp/no_http_live_dtf.txt')
    dtf-opt: {
        ok -> dtf-txt = it

        -> _
    }
    runner.str-eq(dtf-txt, 'hello-nolang', 12, 'download-to-file: 檔案內容正確')

    dlo = http.http-dl-open(url-ok, '/tmp/no_http_live_dlo.txt', 0)
    runner.is-true(dlo, 'http-dl-open: depth 0 回 true')

    ; 重定向次數超限：depth 6 必須直接失敗（不打網路，故不占連線數）
    runner.is-false(http.http-dl-open(url-ok, '/tmp/no_http_live_dlo2.txt', 6), 'http-dl-open: depth > 5 直接失敗')

    ; ⑥ upload-put（PUT 原始二進位）
    _ = fs.write-str('/tmp/no_http_live_up.txt', 'upload-body')
    up = http.upload-put(url-ok, 'tok', '/tmp/no_http_live_up.txt')
    runner.is-true(up, 'upload-put: 回 true')

    ; 讀不到的檔案 → false（不占連線數）
    runner.is-false(http.upload-put(url-ok, 'tok', '/tmp/no_http_live_missing.txt'), 'upload-put: 檔案不存在 ⇒ false')

    ; 這裡**不能**再碰 lfd：父進程那份早在 fork 之後就關掉了，fd 號可能已被
    ; 後面的 socket 重用，再 close 一次會關掉別人的連線。
    code = process.process-waitpid(pid, 0)
    runner.eq(code, 0, 'live: 子進程正常退出')
    runner.is-false(port-busy(live-port), 'live: 子進程退出後埠已釋放')
    fs.remove('/tmp/no_http_live_dl.txt')
    fs.remove('/tmp/no_http_live_dtf.txt')
    fs.remove('/tmp/no_http_live_dlo.txt')
    fs.remove('/tmp/no_http_live_up.txt')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('http.request-init', t-request-init)
p2, f2 = runner.test('http.request-headers', t-request-headers)
p3, f3 = runner.test('http.auth', t-auth)
p4, f4 = runner.test('http.response', t-response)
p5, f5 = runner.test('http.dl-location', t-dl-location)
p6, f6 = runner.test('http.dl-resolve', t-dl-resolve)
p7, f7 = runner.test('http.write-ok', t-write-ok)
p8, f8 = runner.test('http.ping', t-ping)
p9, f9 = runner.test('http.dechunk', t-dechunk)
p10, f10 = runner.test('http.live', t-live)

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
