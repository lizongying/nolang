; std-env.no — env 模組測試
;
; 執行：no test test/std/env.no
; 覆蓋：get / lookup / is-set / get-with-default / set / unset
; 註：早期註記「set / unset 有預存 codegen bug」已於 2026-11-11 實測推翻，
;     兩者皆正常，見 t-set-unset。

# /test/runner

; ── get (使用已有的環境變數) ──────────────────

; env.get：讀取 PATH，變數存在且值不為空串
t-get = () {

    ; PATH 應該在大多數系統上都有設定
    val = env.get('PATH')
    n = 0
    val: {
        nil -> n = 0

        err -> n = 0

        ok -> n = it.len()
    }
    runner.gt(n, 0, 'get PATH len > 0')
}

; 未設定的變數名應回傳 nil（而非空字串）
t-get-nonexistent = () {
    val = env.get('NOLANG_NONEXISTENT_XYZ')
    is-nil = false
    is-nil = val: {
        nil -> true

        -> false
    }
    runner.is-true(is-nil, 'get nonexistent == nil')
}

; ── lookup ────────────────────────────────────

; env.lookup：回傳 (值, 是否設定) 二元組，PATH 應為存在
t-lookup-path = () {
    val = env.lookup('PATH')
    ok = false
    ok = val: {
        nil -> false

        -> true
    }
    runner.is-true(ok, 'lookup PATH != nil')
}

; env.lookup 對未設定變數應回傳 nil
t-lookup-nonexistent = () {
    val = env.lookup('NOLANG_NONEXISTENT_LOOKUP')
    is-nil = false
    is-nil = val: {
        nil -> true

        -> false
    }
    runner.is-true(is-nil, 'lookup nonexistent == nil')
}

; ── is-set ────────────────────────────────────

; is-set：已設定的 PATH 應為 true
t-is-set-path = () {
    yes = env.is-set('PATH')
    runner.is-true(yes, 'is-set PATH == true')
}

; is-set：未設定的變數名應為 false
t-is-set-nonexistent = () {
    yes = env.is-set('NOLANG_NONEXISTENT_ISSET')
    runner.is-false(yes, 'is-set nonexistent == false')
}

; ── get-with-default ──────────────────────────
; 未測：get-with-default unset（預存 codegen bug: 複製迴圈越界）

; get-with-default：變數存在時應回傳其值，而不是預設值
t-get-with-default-existing = () {
    val = env.get-with-default('PATH', 'fallback')
    runner.gt(val.len(), 0, 'get-with-default PATH len > 0')
}

; ── 執行 ──────────────────────────────────────

p1, f1 = runner.test('env.get', t-get)
p2, f2 = runner.test('env.get-nonexistent', t-get-nonexistent)
p3, f3 = runner.test('env.lookup-path', t-lookup-path)
p4, f4 = runner.test('env.lookup-nonexistent', t-lookup-nonexistent)
p5, f5 = runner.test('env.is-set-path', t-is-set-path)
p6, f6 = runner.test('env.is-set-nonexistent', t-is-set-nonexistent)
p7, f7 = runner.test('env.get-with-default-existing', t-get-with-default-existing)
p8, f8 = runner.test('env.set/unset', t-set-unset)

; set / unset：寫入後可讀回、覆寫立即生效；
; unset 的實作是寫入空字串（變數仍存在、值為空），不是真正 unset
t-set-unset = () {
    ok1 = env.set('NOLANG_TEST_VAR', 'first')
    runner.is-true(ok1, 'set returns true')

    val = env.get('NOLANG_TEST_VAR')
    got = 'miss'
    val: {
        ok -> got = it

        nil -> got = 'miss'

        err -> got = 'miss'
    }
    runner.str-eq(got, 'first', 5, 'set then get')

    ok2 = env.set('NOLANG_TEST_VAR', 'second')
    runner.is-true(ok2, 'overwrite returns true')
    v2 = env.get('NOLANG_TEST_VAR')
    got2 = 'miss'
    v2: {
        ok -> got2 = it

        nil -> got2 = 'miss'

        err -> got2 = 'miss'
    }
    runner.str-eq(got2, 'second', 6, 'overwrite visible')

    ok3 = env.unset('NOLANG_TEST_VAR')
    runner.is-true(ok3, 'unset returns true')
    v3 = env.get('NOLANG_TEST_VAR')
    n3 = -1
    v3: {
        ok -> n3 = it.len()

        nil -> n3 = -1

        err -> n3 = -2
    }
    runner.eq(n3, 0, 'after unset value is empty string')
    runner.is-true(env.is-set('NOLANG_TEST_VAR'), 'variable still set, value empty')
}

total = runner.summary()
f = runner.failed-count()
{
    f > 0 -> exit(1)

    -> exit(0)
}
