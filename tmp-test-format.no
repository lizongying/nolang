x i64 = 42
pi f64 = 3.14159
s str = 'hello'

; format returns a formatted string (replaces sprintf)
result = format('x={x} pi={pi:.2f} s={s}')
print(result)

; eprint to stderr with newline
eprint('err: x={x}')

; print with named format
print('id {x:06} pi {pi:.2f}')

; io.out for no-newline output (low-level)
io.out('no-newline ')
io.out('concatenated\n')

; io.err for stderr no-newline
io.err('err-no-newline ')
io.err('concatenated\n')
