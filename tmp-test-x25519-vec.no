; Verify X25519 with RFC 7748 test vector
; Section 6.1:
;   Alice's priv: 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
;   Alice's pub:  8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
;   Bob's priv:   5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb
;   Bob's pub:    de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f
;   Shared:       4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742

main = () {
    ; Alice's private key
    alice-priv [32]byte
    alice-priv-hex = [
        119, 7, 109, 10, 115, 24, 165, 125,
        60, 22, 193, 114, 81, 178, 102, 69,
        223, 76, 47, 135, 235, 192, 153, 42,
        177, 119, 251, 165, 29, 185, 44, 42,
    ]
    i <- [0..32): {
        alice-priv[i] = alice-priv-hex[i]
    }

    ; Alice's public key = scalarmult_base(alice-priv)
    alice-pub [32]byte
    alice-pub = x25519.x25519-scalarmult-base(alice-priv)

    ; Expected Alice's pub: 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
    expected-alice-pub = [
        133, 32, 240, 9, 137, 48, 167, 84,
        116, 139, 125, 220, 180, 62, 247, 90,
        13, 191, 58, 13, 38, 56, 26, 244,
        235, 164, 169, 142, 170, 155, 78, 106,
    ]

    print('Alice pub (got vs expected):')
    i <- [0..32): {
        v = alice-pub[i] & 255
        e = expected-alice-pub[i]
        print(v)
        print(e)
    }

    ; Check match
    alice-ok = true
    i <- [0..32): {
        (alice-pub[i] & 255) != expected-alice-pub[i] -> alice-ok = false
    }
    alice-ok -> print('PASS: Alice pub matches')
    alice-ok == false -> print('FAIL: Alice pub mismatch')

    ; Bob's private key
    bob-priv [32]byte
    bob-priv-hex = [
        93, 171, 8, 126, 98, 74, 138, 75,
        121, 225, 127, 139, 131, 128, 14, 230,
        111, 59, 177, 41, 38, 24, 182, 253,
        28, 47, 139, 39, 255, 136, 224, 235,
    ]
    i <- [0..32): {
        bob-priv[i] = bob-priv-hex[i]
    }

    ; Bob's public key
    bob-pub [32]byte
    bob-pub = x25519.x25519-scalarmult-base(bob-priv)

    ; Expected Bob's pub: de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f
    expected-bob-pub = [
        222, 158, 219, 125, 123, 125, 193, 180,
        211, 91, 97, 194, 236, 228, 53, 55,
        63, 131, 67, 200, 91, 120, 103, 77,
        173, 252, 126, 20, 111, 136, 43, 79,
    ]

    bob-ok = true
    i <- [0..32): {
        (bob-pub[i] & 255) != expected-bob-pub[i] -> bob-ok = false
    }
    bob-ok -> print('PASS: Bob pub matches')
    bob-ok == false -> print('FAIL: Bob pub mismatch')

    ; Shared secret = scalarmult(alice-priv, bob-pub)
    shared [32]byte
    shared = x25519.x25519-scalarmult(alice-priv, bob-pub)

    ; Expected shared: 4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742
    expected-shared = [
        74, 93, 157, 91, 164, 206, 45, 225,
        114, 142, 59, 244, 128, 53, 15, 37,
        224, 126, 33, 201, 71, 209, 158, 51,
        118, 240, 155, 60, 30, 22, 23, 66,
    ]

    shared-ok = true
    i <- [0..32): {
        (shared[i] & 255) != expected-shared[i] -> shared-ok = false
    }
    shared-ok -> print('PASS: shared secret matches')
    shared-ok == false -> print('FAIL: shared secret mismatch')

    ; Print first few bytes of shared for debugging
    print('shared first 8 bytes:')
    i <- [0..8): {
        print(shared[i] & 255)
    }
    print('expected first 8 bytes:')
    i <- [0..8): {
        print(expected-shared[i])
    }
}
