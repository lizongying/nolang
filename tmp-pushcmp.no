// Test: push then compare immediately
words []str = with-cap(256)
tmp-word str = with-cap(64)
tmp-word[0] = 104
tmp-word[1] = 101
tmp-word[2] = 108
tmp-word[3] = 108
tmp-word[4] = 111
words.push(tmp-word)
; Now compare tmp-word with words[0]
r i64 = tmp-word.compare(words[0])
print('after push, compare tmp-word with words[0]: ' + r.to-str())
; Create another str and compare
tmp2 str = with-cap(64)
tmp2[0] = 104
tmp2[1] = 101
tmp2[2] = 108
tmp2[3] = 108
tmp2[4] = 111
r = tmp2.compare(words[0])
print('compare new str with words[0]: ' + r.to-str())
r = tmp2.compare(tmp-word)
print('compare new str with tmp-word: ' + r.to-str())
