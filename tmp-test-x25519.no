; 測試 X25519 是否符合 RFC 7748 測試向量
main = () {
    ; RFC 7748 Section 6.1 測試向量
    ; Alice's private key: 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
    ; Alice's public key:  8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
    ; Bob's private key:   5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb
    ; Bob's public key:    de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f
    ; Shared secret:       4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742

    alice-priv [32]byte
    alice-priv-hex = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42]
    i <- [0..32): {
        alice-priv[i] = alice-priv-hex[i]
    }

    alice-pub-exp [32]byte
    alice-pub-hex = [133, 32, 240, 9, 137, 48, 167, 84, 116, 139, 125, 220, 180, 62, 247, 90, 13, 191, 58, 13, 38, 56, 26, 244, 235, 164, 169, 142, 170, 155, 78, 106]
    i <- [0..32): {
        alice-pub-exp[i] = alice-pub-hex[i]
    }

    ; 計算 Alice 的公鑰
    alice-pub [32]byte
    alice-pub = x25519.x25519-scalarmult-base(alice-priv)
    print('Alice pub (computed):')
    i <- [0..32): {
        printf((alice-pub[i] & 255).to-str() - ' ')
    }
    print('')
    print('Alice pub (expected):')
    i <- [0..32): {
        printf((alice-pub-exp[i] & 255).to-str() - ' ')
    }
    print('')

    ; 比對
    pub-ok = true
    i <- [0..32): {
        (alice-pub[i] & 255) != (alice-pub-exp[i] & 255) -> {
            pub-ok = false
            print('mismatch at ' - i.to-str() - ': got ' - (alice-pub[i] & 255).to-str() - ' expect ' - (alice-pub-exp[i] & 255).to-str())
        }
    }
    pub-ok -> print('PASS: Alice pub matches')
    pub-ok == false -> print('FAIL: Alice pub mismatch')

    ; 計算共享金鑰: Alice 用 Bob 的公鑰
    bob-pub [32]byte
    bob-pub-hex = [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97, 194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120, 103, 77, 173, 252, 126, 20, 111, 136, 43, 79]
    i <- [0..32): {
        bob-pub[i] = bob-pub-hex[i]
    }

    shared [32]byte
    shared = x25519.x25519-scalarmult(alice-priv, bob-pub)
    print('')
    print('Shared (computed):')
    i <- [0..32): {
        printf((shared[i] & 255).to-str() - ' ')
    }
    print('')

    shared-exp = [74, 93, 157, 91, 164, 206, 45, 225, 114, 142, 59, 244, 128, 53, 15, 37, 224, 126, 33, 201, 71, 209, 158, 51, 118, 240, 155, 60, 30, 22, 23, 66]
    print('Shared (expected):')
    i <- [0..32): {
        printf(shared-exp[i].to-str() - ' ')
    }
    print('')

    shared-ok = true
    i <- [0..32): {
        (shared[i] & 255) != shared-exp[i] -> {
            shared-ok = false
            print('mismatch at ' - i.to-str() - ': got ' - (shared[i] & 255).to-str() - ' expect ' - shared-exp[i].to-str())
        }
    }
    shared-ok -> print('PASS: shared secret matches')
    shared-ok == false -> print('FAIL: shared secret mismatch')
}
