; Detailed trace of simple carry pass
main = () {
    ; Reproduce state right before simple carry
    t []i64 = with-len(10)
    t[0] = 18751264
    t[1] = 8832775
    t[2] = -18676957  ; After first+second carry
    t[3] = 10528945
    t[4] = 4474956
    t[5] = 17698576
    t[6] = 17139206
    t[7] = 14745889
    t[8] = 4214880
    t[9] = 4227264

    print('=== Before +19 ===')
    print('t[0] =')
    print(t[0])
    print('t[2] =')
    print(t[2])

    ; +19
    t[0] = t[0] + 19
    print('After +19, t[0] =')
    print(t[0])

    ; Step 0->1
    c = t[0] >> 26
    print('c0 = t[0]>>26 =')
    print(c)
    t[0] = t[0] - (c << 26)
    t[1] = t[1] + c
    print('t[0] =')
    print(t[0])
    print('t[1] =')
    print(t[1])

    ; Step 1->2
    c = t[1] >> 25
    print('c1 = t[1]>>25 =')
    print(c)
    t[1] = t[1] - (c << 25)
    t[2] = t[2] + c
    print('t[1] =')
    print(t[1])
    print('t[2] =')
    print(t[2])

    ; Step 2->3 (THE CRITICAL STEP - t[2] is negative)
    c = t[2] >> 26
    print('c2 = t[2]>>26 =')
    print(c)
    print('c2 << 26 =')
    print(c << 26)
    t[2] = t[2] - (c << 26)
    t[3] = t[3] + c
    print('t[2] after =')
    print(t[2])
    print('t[3] after =')
    print(t[3])

    ; Step 3->4
    c = t[3] >> 25
    print('c3 = t[3]>>25 =')
    print(c)
    t[3] = t[3] - (c << 25)
    t[4] = t[4] + c
    print('t[3] after =')
    print(t[3])
    print('t[4] after =')
    print(t[4])
}
