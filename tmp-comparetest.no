// Test: word extraction + compare, NO push on new
words []str = with-cap(256)
counts []i64 = with-cap(256)
word [64]byte
wlen i64 = 0
n i64 = 0
c i64 = 0
found i64 = 0
k = 0
cmp-result i64 = 0
tmp-word str = ''
lower i64 = 0
total-words i64 = 0

; Pre-push a few words
word[0] = 104
word[1] = 101
word[2] = 108
word[3] = 108
word[4] = 111
wlen = 5
tmp-word = with-cap(64)
k <- [0..wlen): {
    tmp-word[k] = word[k]
}
words.push(tmp-word)
counts.push(1)
n = 1
wlen = 0

{
    line str = ''
    ok = false
    line, ok = get-line()
    ok == false -> break
    bs []byte = line.to-bytes()
    j <- [0..bs.len): {
        c = bs[j]
        (c >= 65 && c <= 90) || (c >= 97 && c <= 122) -> {
            lower = c
            c >= 65 && c <= 90 -> lower = c + 32
            wlen < 64 -> {
                word[wlen] = lower
                wlen = wlen + 1
            }
        }
        !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) -> {
            wlen >= 3 -> {
                total-words = total-words + 1
                tmp-word = with-cap(64)
                k <- [0..wlen): {
                    tmp-word[k] = word[k]
                }
                found = 0
                k <- [0..n): {
                    found == 0 -> {
                        cmp-result = tmp-word.compare(words[k])
                        cmp-result == 0 -> {
                            counts[k] = counts[k] + 1
                            found = 1
                        }
                    }
                }
            }
            wlen = 0
        }
    }
} ()

print('total words: ' + total-words.to-str())
print('unique: ' + n.to-str())
print('hello count: ' + counts[0].to-str())
