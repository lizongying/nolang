; Test repeated fe-sq to find accumulation errors
main = () {
    ; Start with a = 5
    a []i64 = with-len(10)
    a[0] = 5

    t []i64 = with-len(10)
    x25519.fe-copy(t, a)

    out [32]byte

    ; Square 10 times: a^(2^10) = 5^1024
    i <- [0..10): {
        x25519.fe-sq(t, t)
    }

    x25519.fe-tobytes(out, t)
    print('5^(2^10) = 5^1024 bytes:')
    i <- [0..16): {
        print(out[i] & 255)
    }

    ; 5^1024 mod p — compute expected via repeated squaring in simple arithmetic
    ; 5^1 = 5
    ; 5^2 = 25
    ; 5^4 = 625
    ; 5^8 = 390625
    ; 5^16 = 152587890625
    ; 5^32 = 23283064365386962890625
    ; 5^64 = ... (too large to compute by hand)
    ; Let's just print and compare with Python

    ; Also test: square 20 times = a^(2^20)
    x25519.fe-copy(t, a)
    i <- [0..20): {
        x25519.fe-sq(t, t)
    }
    x25519.fe-tobytes(out, t)
    print('5^(2^20) bytes:')
    i <- [0..16): {
        print(out[i] & 255)
    }

    ; Test fe-invert step by step
    ; t0 = a^2, t1 = a^4, t1 = a^8, t1 = a^9, t0 = a^11
    x25519.fe-sq(t, a); t = a^2 = 25
    x25519.fe-tobytes(out, t)
    print('5^2 = ?')
    print(out[0] & 255)
    print(out[1] & 255)

    t0 []i64 = with-len(10)
    t1 []i64 = with-len(10)
    x25519.fe-sq(t0, a); t0 = a^2
    x25519.fe-sq(t1, t0); t1 = a^4
    x25519.fe-sq(t1, t1); t1 = a^8
    x25519.fe-mul(t1, a, t1); t1 = a^9
    x25519.fe-mul(t0, t0, t1); t0 = a^11

    x25519.fe-tobytes(out, t0)
    print('5^11 = ?')

    ; 5^11 = 48828125
    ; bytes: 48828125 = 0x02E8D4A5
    ; little-endian: 0xA5, 0xD4, 0xE8, 0x02
    print(out[0] & 255)
    print(out[1] & 255)
    print(out[2] & 255)
    print(out[3] & 255)
    (out[0] & 255) == 165 -> print('byte 0 ok (165)')
    (out[1] & 255) == 212 -> print('byte 1 ok (212)')
    (out[2] & 255) == 232 -> print('byte 2 ok (232)')
    (out[3] & 255) == 2 -> print('byte 3 ok (2)')

    ; Continue: t2 = a^22, t1 = a^31
    t2 []i64 = with-len(10)
    x25519.fe-sq(t2, t0); t2 = a^22
    x25519.fe-mul(t1, t1, t2); t1 = a^31

    x25519.fe-tobytes(out, t1)
    print('5^31 = ?')
    i <- [0..8): {
        print(out[i] & 255)
    }
    ; 5^31 = 4656612873077392186130957847167778067776...  (too large)
    ; Just print for comparison with Python
}
