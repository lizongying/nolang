; 測試 fe-frombytes / fe-tobytes 往返轉換
main = () {
    ; 基點 [9, 0, 0, ..., 0]
    base [32]byte
    base[0] = 9
    i <- [1..32): {
        base[i] = 0
    }

    ; 載入到域元素
    h []i64 = with-len(10)
    x25519.fe-frombytes(h, base)

    print('After fe-frombytes:')
    i <- [0..10): {
        printf(h[i].to-str() - ' ')
    }
    print('')

    ; 序列化回 32 bytes
    out [32]byte
    x25519.fe-tobytes(out, h)

    print('After fe-tobytes:')
    i <- [0..32): {
        printf((out[i] & 255).to-str() - ' ')
    }
    print('')

    ; 驗證是否為 [9, 0, ..., 0]
    ok = true
    out[0] != 9 -> ok = false
    i <- [1..32): {
        (out[i] & 255) != 0 -> ok = false
    }
    ok -> print('PASS: roundtrip basepoint')
    ok == false -> print('FAIL: roundtrip basepoint')

    ; 測試 2: 載入 Alice 的公鑰並序列化
    print('')
    print('=== Test Alice pub roundtrip ===')
    alice-pub [32]byte
    alice-pub-hex = [133, 32, 240, 9, 137, 48, 167, 84, 116, 139, 125, 220, 180, 62, 247, 90, 13, 191, 58, 13, 38, 56, 26, 244, 235, 164, 169, 142, 170, 155, 78, 106]
    i <- [0..32): {
        alice-pub[i] = alice-pub-hex[i]
    }

    h2 []i64 = with-len(10)
    x25519.fe-frombytes(h2, alice-pub)
    print('After fe-frombytes:')
    i <- [0..10): {
        printf(h2[i].to-str() - ' ')
    }
    print('')

    out2 [32]byte
    x25519.fe-tobytes(out2, h2)
    print('After fe-tobytes:')
    i <- [0..32): {
        printf((out2[i] & 255).to-str() - ' ')
    }
    print('')

    ok2 = true
    i <- [0..32): {
        (out2[i] & 255) != (alice-pub[i] & 255) -> {
            ok2 = false
            print('mismatch at ' - i.to-str() - ': got ' - (out2[i] & 255).to-str() - ' expect ' - (alice-pub[i] & 255).to-str())
        }
    }
    ok2 -> print('PASS: roundtrip Alice pub')
    ok2 == false -> print('FAIL: roundtrip Alice pub')
}
